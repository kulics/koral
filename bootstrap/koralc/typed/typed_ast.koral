// Typed AST nodes produced by the type checker.
// Each node carries a resolved Type alongside the original source information.

// type_names maps DefId.id -> type name for display (struct/enum names)
public type ValueCategory {
    LValue(),
    RValue(),
}

public type TypedProgram(
    declarations List[* TypedDecl],
    type_names Dict[UInt, String],
)

public type TypedParam(
    name String,
    mutable Bool,
    param_type Type,
    named Bool,
)

public type TypedField(
    access AccessModifier,
    name String,
    mutable Bool,
    field_type Type,
    named Bool,
)

public type TypedEnumCaseField(
    name String,
    field_type Type,
    named Bool,
)

public type TypedEnumCase(
    name String,
    fields List[TypedEnumCaseField],
)

public type TypedTraitMember(
    name String,
    params List[TypedParam],
    return_type Type,
)

public type TypedGivenMember(
    def_id DefId,
    name String,
    params List[TypedParam],
    return_type Type,
    body Option[* TypedExpr],
)

public type TypedDecl {
    LetDecl(
        access AccessModifier,
        name String,
        mutable Bool,
        decl_type Type,
        initializer * TypedExpr,
        span SourceSpan,
        identifier * Symbol,
    ),
    FunctionDecl(
        access AccessModifier,
        name String,
        params List[TypedParam],
        return_type Type,
        body * TypedExpr,
        span SourceSpan,
        identifier * Symbol,
    ),
    IntrinsicFunctionDecl(
        access AccessModifier,
        name String,
        params List[TypedParam],
        return_type Type,
        span SourceSpan,
        identifier * Symbol,
    ),
    ForeignFunctionDecl(
        access AccessModifier,
        name String,
        params List[TypedParam],
        return_type Type,
        span SourceSpan,
        identifier * Symbol,
    ),
    ForeignLetDecl(
        access AccessModifier,
        name String,
        mutable Bool,
        decl_type Type,
        span SourceSpan,
        identifier * Symbol,
    ),
    TypeStructDecl(
        access AccessModifier,
        name String,
        fields List[TypedField],
        span SourceSpan,
        identifier * Symbol,
    ),
    TypeEnumDecl(
        access AccessModifier,
        name String,
        cases List[TypedEnumCase],
        span SourceSpan,
        identifier * Symbol,
    ),
    TypeAliasDecl(
        access AccessModifier,
        name String,
        target Type,
        span SourceSpan,
    ),
    IntrinsicTypeDecl(
        access AccessModifier,
        name String,
        span SourceSpan,
    ),
    ForeignTypeDecl(
        access AccessModifier,
        name String,
        fields Option[List[TypedField]],
        span SourceSpan,
        identifier * Symbol,
    ),
    UsingDecl(
        access AccessModifier,
        path_segments List[String],
        span SourceSpan,
    ),
    TraitDecl(
        access AccessModifier,
        name String,
        members List[TypedTraitMember],
        span SourceSpan,
    ),
    GivenDecl(
        target_type Type,
        members List[* TypedGivenMember],
        span SourceSpan,
    ),
    GivenTraitDecl(
        target_type Type,
        trait_name String,
        trait_args List[Type],
        members List[* TypedGivenMember],
        span SourceSpan,
    ),
    IntrinsicGivenDecl(
        target_type Type,
        members List[* TypedGivenMember],
        span SourceSpan,
    ),
    // Generic declarations in TypedProgram are placeholders only.
    // Template bodies/metadata live in GenericTemplateRegistry.
    GenericFunctionDecl(
        access AccessModifier,
        name String,
        span SourceSpan,
    ),
    GenericTypeStructDecl(
        access AccessModifier,
        name String,
        span SourceSpan,
    ),
    GenericTypeEnumDecl(
        access AccessModifier,
        name String,
        span SourceSpan,
    ),
}

public type TypedStatement {
    LetStmt(symbol * Symbol, value * TypedExpr, span SourceSpan),
    PairLetStmt(pair_type Type, first_symbol Option[* Symbol], second_symbol Option[* Symbol], value * TypedExpr, span SourceSpan),
    AssignmentStmt(target * TypedExpr, value * TypedExpr, span SourceSpan),
    ExprStmt(expr * TypedExpr, span SourceSpan),
    IfStmt(condition * TypedExpr, then_branch * TypedExpr, else_branch Option[* TypedExpr], span SourceSpan),
    WhileStmt(condition * TypedExpr, body * TypedExpr, span SourceSpan),
    WhenStmt(subject * TypedExpr, arms List[* TypedWhenArm], span SourceSpan),
    ReturnStmt(value Option[* TypedExpr], span SourceSpan),
    BreakStmt(span SourceSpan),
    ContinueStmt(span SourceSpan),
    DeferStmt(expr * TypedExpr, span SourceSpan),
    BranchBreakStmt(expr * TypedExpr, span SourceSpan),
}

public type TypedWhenArm(
    pattern * TypedPattern,
    body * TypedExpr,
    arm_type Type,
)

public type TypedExpr(
    expr_kind * TypedExprKind,
    expr_type Type,
)

public let make_typed_expr(kind TypedExprKind, t Type) TypedExpr = TypedExpr(box(kind), t)
public let make_typed_expr_ref(kind * TypedExprKind, t Type) TypedExpr = TypedExpr(kind, t)
public let retype_typed_expr(expr * TypedExpr, t Type) TypedExpr = TypedExpr(expr.expr_kind, t)

public type TypedExprKind {
    Variable(symbol * Symbol),
    IntegerLiteral(value String),
    FloatLiteral(value String),
    StringLiteral(value String),
    BoolLiteral(value Bool),
    CastExpr(target_type Type, expr * TypedExpr),
    Unary(op UnaryOperator, expr * TypedExpr),
    RefExpr(expr * TypedExpr),
    PtrExpr(expr * TypedExpr),
    DerefExpr(expr * TypedExpr),
    ArithmeticExpr(left * TypedExpr, op ArithmeticOperator, right * TypedExpr),
    WrappingArithmeticExpr(left * TypedExpr, op ArithmeticOperator, right * TypedExpr),
    WrappingShiftExpr(left * TypedExpr, op BitwiseOperator, right * TypedExpr),
    ComparisonExpr(left * TypedExpr, op ComparisonOperator, right * TypedExpr),
    BitwiseExpr(left * TypedExpr, op BitwiseOperator, right * TypedExpr),
    AndExpr(left * TypedExpr, right * TypedExpr),
    OrExpr(left * TypedExpr, right * TypedExpr),
    IsExpr(subject * TypedExpr, pattern * TypedPattern, negated Bool),
    Call(callee * TypedExpr, args List[* TypedExpr]),
    GenericCall(function_symbol * Symbol, type_args List[Type], args List[* TypedExpr]),
    IntrinsicCall(node TypedIntrinsic),
    MemberPath(base * TypedExpr, path List[String]),
    MethodReference(base * TypedExpr, receiver_type Type, method * Symbol, type_args List[Type], method_type_args List[Type], dispatch_callsite Option[DefId]),
    Block(statements List[* TypedStatement]),
    IfExpr(condition * TypedExpr, then_branch * TypedExpr, else_branch Option[* TypedExpr]),
    WhenExpr(subject * TypedExpr, arms List[* TypedWhenArm]),
    LambdaExpr(params List[TypedParam], return_type Type, body * TypedExpr),
    StaticMethodCall(receiver_type Type, method_name String, method * Symbol, type_args List[Type], method_type_args List[Type], args List[* TypedExpr]),
    TypeConstruction(identifier * Symbol, type_args List[Type], args List[* TypedExpr]),
    EnumConstruction(enum_type Type, case_name String, args List[* TypedExpr]),
    TraitMethodPlaceholder(base * TypedExpr, trait_type Type, method * Symbol, method_type_args List[Type], dispatch_callsite Option[DefId]),
    TraitObjectConversion(inner * TypedExpr, trait_type Type, concrete_type Type),
    TraitMethodCall(receiver * TypedExpr, trait_type Type, method_name String, method_index Int, args List[* TypedExpr]),
    GenericInstantiation(base_type Type, type_args List[Type]),
}

public type TypedPatternElement(
    label Option[String],
    pattern * TypedPattern,
)

public type TypedPattern {
    Wildcard(),
    Variable(symbol * Symbol),
    BoolLiteral(value Bool),
    IntegerLiteral(value String),
    NegativeIntegerLiteral(value String),
    StringLiteral(value String),
    RuneLiteral(value String),
    EnumCase(case_name String, tag_index UInt, elements List[* TypedPatternElement]),
    StructPattern(type_name String, elements List[* TypedPatternElement]),
    ComparisonPattern(op ComparisonPatternOperator, value String),
    AndPattern(left * TypedPattern, right * TypedPattern),
    OrPattern(left * TypedPattern, right * TypedPattern),
    NotPattern(pattern * TypedPattern),
}

public type TypedIntrinsic {
    IsUniqueMutable(ref_expr * TypedExpr),
    RefCount(ref_expr * TypedExpr),
    MakeRef(pointer_expr * TypedExpr, owner_expr * TypedExpr, result_type Type),
    MakeMutRef(pointer_expr * TypedExpr, owner_expr * TypedExpr, result_type Type),
    DowngradeRef(ref_expr * TypedExpr, result_type Type),
    DowngradeMutRef(ref_expr * TypedExpr, result_type Type),
    UpgradeRef(weak_expr * TypedExpr, result_type Type),
    UpgradeMutRef(weak_expr * TypedExpr, result_type Type),
    SpawnThread(out_handle * TypedExpr, out_tid * TypedExpr, closure * TypedExpr, stack_size * TypedExpr),
    AllocMemory(count * TypedExpr, result_type Type),
    DeallocMemory(pointer_expr * TypedExpr),
    CopyMemory(dest * TypedExpr, source * TypedExpr, count * TypedExpr),
    MoveMemory(dest * TypedExpr, source * TypedExpr, count * TypedExpr),
    InitMemory(pointer_expr * TypedExpr, value_expr * TypedExpr),
    DeinitMemory(pointer_expr * TypedExpr),
    TakeMemory(pointer_expr * TypedExpr, result_type Type),
    NullPtr(result_type Type),
}

private let typed_value_category_preserves_identity_cast(source_type Type, target_type Type) Bool = {
    if source_type == target_type then {
        return true
    }
    return when source_type in {
        .ReferenceType(_) then when target_type in {
            .ReferenceType(_) then true,
            .MutableReferenceType(_) then true,
            _ then false,
        },
        .MutableReferenceType(_) then when target_type in {
            .ReferenceType(_) then true,
            .MutableReferenceType(_) then true,
            _ then false,
        },
        _ then false,
    }
}

public let typed_expr_value_category(expr * TypedExpr) ValueCategory = {
    return when expr.expr_kind in {
        .Variable(_) then ValueCategory.LValue(),
        .MemberPath(source, _) then typed_expr_value_category(source),
        .DerefExpr(_) then ValueCategory.LValue(),
        .CastExpr(target_type, inner) then {
            break if typed_value_category_preserves_identity_cast(inner.expr_type, target_type)
                then typed_expr_value_category(inner)
                else ValueCategory.RValue()
        },
        _ then ValueCategory.RValue(),
    }
}

given TypedExprKind not Deref
given TypedStatement not Deref
given TypedPattern not Deref
