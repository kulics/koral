public type MIRLowerer(
    program *mutable MonomorphizedProgram,
    context * CompilerContext,
    mutable pending_work_items List[* MIRFunctionWorkItem],
    mutable streaming_nodes_prepared Bool,
)

given MIRLowerer {
    public new(program *mutable MonomorphizedProgram, context * CompilerContext) MIRLowerer =
        MIRLowerer(program, context, List[* MIRFunctionWorkItem].new(), false)

    public metadata_program(self) * MIRProgram = {
        let mutable globals_reversed = List[MIRGlobal].new()

        for request in self.program.vtable_requests then {
            globals_reversed.push(MIRGlobal.TraitVTable(self.make_trait_vtable(request)))
        }

        for node_ref in self.program.global_nodes then {
            when node_ref in {
                .ForeignFunctionDecl(_, _, params, return_type, _, identifier) then {
                    globals_reversed.push(MIRGlobal.ForeignFunction(identifier, params, return_type))
                },
                .ForeignLetDecl(_, _, mutable, decl_type, _, identifier) then {
                    globals_reversed.push(MIRGlobal.ForeignGlobalVariable(identifier, mutable, decl_type))
                },
                .ForeignTypeDecl(_, _, fields, _, identifier) then {
                    when fields in {
                        .Some(f) then globals_reversed.push(MIRGlobal.ForeignStruct(identifier, f)),
                        .None() then globals_reversed.push(MIRGlobal.ForeignType(identifier)),
                    }
                },
                .LetDecl(_, _, mutable, decl_type, initializer, _, identifier) then {
                    let init_function = self.make_global_initializer_symbol(identifier)
                    globals_reversed.push(MIRGlobal.GlobalVariable(identifier, init_function, mutable, decl_type))
                    let _ = initializer
                },
                .FunctionDecl(_, _, params, return_type, body, _, identifier) then {
                    let kind = MIRFunctionKind.Global()
                    globals_reversed.push(MIRGlobal.Function(identifier, params, return_type, kind))
                    let _ = body
                },
                .IntrinsicFunctionDecl(_, _, params, return_type, _, identifier) then {
                    globals_reversed.push(MIRGlobal.Function(identifier, params, return_type, MIRFunctionKind.Global()))
                },
                .TypeStructDecl(_, _, fields, _, identifier) then {
                    globals_reversed.push(MIRGlobal.StructDeclaration(identifier, fields))
                },
                .TypeEnumDecl(_, _, cases, _, identifier) then {
                    globals_reversed.push(MIRGlobal.EnumDeclaration(identifier, cases))
                },
                .GivenDecl(target_type, members, _) then {
                    let mutable method_symbols = List[* Symbol].new()
                    for member_ref in members then {
                        let symbol = self.make_given_member_symbol(member_ref)
                        if not self.context.contains_generic_parameter(symbol.symbol_type) then {
                            method_symbols.push(symbol)
                        }
                    }
                    if not self.context.contains_generic_parameter(target_type) then {
                        globals_reversed.push(MIRGlobal.Given(target_type, Option[String].None(), List[Type].new(), method_symbols))
                    }
                },
                .IntrinsicGivenDecl(target_type, members, _) then {
                    let mutable method_symbols = List[* Symbol].new()
                    for member_ref in members then {
                        let symbol = self.make_given_member_symbol(member_ref)
                        if not self.context.contains_generic_parameter(symbol.symbol_type) then {
                            method_symbols.push(symbol)
                        }
                    }
                    if not self.context.contains_generic_parameter(target_type) then {
                        globals_reversed.push(MIRGlobal.Given(target_type, Option[String].None(), List[Type].new(), method_symbols))
                    }
                },
                .GivenTraitDecl(target_type, trait_name, trait_args, members, _) then {
                    let mutable copied_trait_args = List[Type].new()
                    for arg in trait_args then { copied_trait_args.push(arg) }
                    let mutable method_symbols = List[* Symbol].new()
                    for member_ref in members then {
                        let symbol = self.make_given_member_symbol(member_ref)
                        if not self.context.contains_generic_parameter(symbol.symbol_type) then {
                            method_symbols.push(symbol)
                        }
                    }
                    let mutable trait_args_concrete = true
                    for arg in copied_trait_args then {
                        if self.context.contains_generic_parameter(arg) then {
                            trait_args_concrete = false
                        }
                    }
                    if not self.context.contains_generic_parameter(target_type) and trait_args_concrete then {
                        globals_reversed.push(MIRGlobal.Given(target_type, Option[String].Some(trait_name), copied_trait_args, method_symbols))
                    }
                },
                .GenericFunctionDecl(_, name, _) then globals_reversed.push(MIRGlobal.TemplatePlaceholder(name)),
                .GenericTypeStructDecl(_, name, _) then globals_reversed.push(MIRGlobal.TemplatePlaceholder(name)),
                .GenericTypeEnumDecl(_, name, _) then globals_reversed.push(MIRGlobal.TemplatePlaceholder(name)),
                .TraitDecl(_, _, _, _) then {},
                .TypeAliasDecl(_, _, _, _) then {},
                .IntrinsicTypeDecl(_, _, _) then {},
                .UsingDecl(_, _, _) then {},
            }
        }

        let mutable globals = List[MIRGlobal].new()
        while not globals_reversed.is_empty() then {
            globals.push(globals_reversed.pop().unwrap())
        }

        let program = box(MIRProgram(
            globals,
            List[* MIRFunction].new(),
            *(self.context),
            self.program.static_method_by_key,
            self.program.traits,
            self.program.receiver_method_dispatch,
            self.program.concrete_callables_by_def_id,
        ))
        return program
    }

    public lower_next_work_item(*mutable self) Option[* MIRFunction] = {
        self.prepare_streaming_nodes()

        while true then {
            when self.pending_work_items.pop() in {
                .Some(item) then {
                    return Option[* MIRFunction].Some(self.lower_work_item(item))
                },
                .None() then {},
            }

            let node_ref = self.program.global_nodes.pop() or else { return Option[* MIRFunction].None() }
            self.enqueue_node_work_items(node_ref)
        }
        return Option[* MIRFunction].None()
    }

    protected prepare_streaming_nodes(*mutable self) Void = {
        if self.streaming_nodes_prepared then {
            return
        }

        let mutable reversed = List[* TypedDecl].new()
        while not self.program.global_nodes.is_empty() then {
            reversed.push(self.program.global_nodes.pop().unwrap())
        }
        self.program.global_nodes = reversed
        self.streaming_nodes_prepared = true
    }

    protected enqueue_node_work_items(*mutable self, node_ref * TypedDecl) Void = {
        when node_ref in {
            .LetDecl(_, _, _, _, initializer, _, identifier) then {
                let init_function = self.make_global_initializer_symbol(identifier)
                let mutable context = self.context
                let source_initializer = context.take_concrete_global_initializer(identifier.def_id) or else initializer
                self.pending_work_items.push(box(MIRFunctionWorkItem(
                    init_function,
                    List[TypedParam].new(),
                    identifier.symbol_type,
                    MIRFunctionKind.Global(),
                    source_initializer,
                )))
            },
            .FunctionDecl(_, _, params, return_type, body, _, identifier) then {
                if self.should_lower_function(identifier) then {
                    let kind = when self.program.concrete_callables_by_def_id.get(identifier.def_id) in {
                        .Some(info) then when info.owner_type in {
                            .Some(owner_type) then MIRFunctionKind.Given(owner_type, info.trait_conformance, List[Type].new()),
                            .None() then MIRFunctionKind.Global(),
                        },
                        .None() then MIRFunctionKind.Global(),
                    }
                    let mutable context = self.context
                    let source_body = when context.take_concrete_function_body(identifier.def_id) in {
                        .Some(existing_body) then existing_body,
                        .None() then when context.take_concrete_function_source(identifier.def_id) in {
                            .Some(source) then {
                                let mutable checker = TypeChecker.new(self.program.global_scope, *(self.context), source.source_file)
                                let rechecked = checker.recheck_concrete_function_body(params, return_type, source, self.program.import_graph, self.program.generic_templates, self.program.method_table, self.program.trait_registry, self.program.conformance_index)
                                let resolved = Monomorphizer.resolve_program_body_expression(self.program, self.context, box(rechecked))
                                break resolved
                            },
                            .None() then body,
                        },
                    }
                    self.pending_work_items.push(box(MIRFunctionWorkItem(
                        identifier,
                        params,
                        return_type,
                        kind,
                        source_body,
                    )))
                }
            },
            .GivenDecl(target_type, members, _) then {
                let kind = MIRFunctionKind.Given(target_type, Option[String].None(), List[Type].new())
                let mutable methods_reversed = List[* MIRFunctionWorkItem].new()
                for member_ref in members then {
                    let symbol = self.make_given_member_symbol(member_ref)
                    let mutable context = self.context
                    when context.take_concrete_given_member_body(member_ref.def_id) in {
                        .Some(body) then {
                            if self.should_lower_function(symbol) then {
                                methods_reversed.push(box(MIRFunctionWorkItem(symbol, member_ref.params, member_ref.return_type, kind, body)))
                            }
                        },
                        .None() then when context.take_concrete_given_member_source(member_ref.def_id) in {
                            .Some(source) then {
                                if self.should_lower_function(symbol) then {
                                    let mutable checker = TypeChecker.new(self.program.global_scope, *(self.context), source.source_file)
                                    let rebuilt = checker.recheck_concrete_given_member_body(target_type, member_ref.params, member_ref.return_type, source, self.program.import_graph, self.program.generic_templates, self.program.method_table, self.program.trait_registry, self.program.conformance_index)
                                    let resolved_body = Monomorphizer.resolve_program_body_expression(self.program, self.context, box(rebuilt))
                                    methods_reversed.push(box(MIRFunctionWorkItem(symbol, member_ref.params, member_ref.return_type, kind, resolved_body)))
                                }
                            },
                            .None() then when member_ref.body in {
                                .Some(body) then {
                                    if self.should_lower_function(symbol) then {
                                        methods_reversed.push(box(MIRFunctionWorkItem(symbol, member_ref.params, member_ref.return_type, kind, body)))
                                    }
                                },
                                .None() then {},
                            },
                        },
                    }
                }
                while not methods_reversed.is_empty() then {
                    self.pending_work_items.push(methods_reversed.pop().unwrap())
                }
            },
            .GivenTraitDecl(target_type, trait_name, trait_args, members, _) then {
                let mutable copied_trait_args = List[Type].new()
                for arg in trait_args then { copied_trait_args.push(arg) }
                let kind = MIRFunctionKind.Given(target_type, Option[String].Some(trait_name), copied_trait_args)
                let mutable methods_reversed = List[* MIRFunctionWorkItem].new()
                for member_ref in members then {
                    let symbol = self.make_given_member_symbol(member_ref)
                    let mutable context = self.context
                    when context.take_concrete_given_member_body(member_ref.def_id) in {
                        .Some(body) then {
                            if self.should_lower_function(symbol) then {
                                methods_reversed.push(box(MIRFunctionWorkItem(symbol, member_ref.params, member_ref.return_type, kind, body)))
                            }
                        },
                        .None() then when context.take_concrete_given_member_source(member_ref.def_id) in {
                            .Some(source) then {
                                if self.should_lower_function(symbol) then {
                                    let mutable checker = TypeChecker.new(self.program.global_scope, *(self.context), source.source_file)
                                    let rebuilt = checker.recheck_concrete_given_member_body(target_type, member_ref.params, member_ref.return_type, source, self.program.import_graph, self.program.generic_templates, self.program.method_table, self.program.trait_registry, self.program.conformance_index)
                                    let resolved_body = Monomorphizer.resolve_program_body_expression(self.program, self.context, box(rebuilt))
                                    methods_reversed.push(box(MIRFunctionWorkItem(symbol, member_ref.params, member_ref.return_type, kind, resolved_body)))
                                }
                            },
                            .None() then when member_ref.body in {
                                .Some(body) then {
                                    if self.should_lower_function(symbol) then {
                                        methods_reversed.push(box(MIRFunctionWorkItem(symbol, member_ref.params, member_ref.return_type, kind, body)))
                                    }
                                },
                                .None() then {},
                            },
                        },
                    }
                }
                while not methods_reversed.is_empty() then {
                    self.pending_work_items.push(methods_reversed.pop().unwrap())
                }
            },
            .IntrinsicGivenDecl(target_type, members, _) then {
                let kind = MIRFunctionKind.Given(target_type, Option[String].None(), List[Type].new())
                let mutable methods_reversed = List[* MIRFunctionWorkItem].new()
                for member_ref in members then {
                    let symbol = self.make_given_member_symbol(member_ref)
                    let mutable context = self.context
                    when context.take_concrete_given_member_body(member_ref.def_id) in {
                        .Some(body) then {
                            if self.should_lower_function(symbol) then {
                                methods_reversed.push(box(MIRFunctionWorkItem(symbol, member_ref.params, member_ref.return_type, kind, body)))
                            }
                        },
                        .None() then when context.take_concrete_given_member_source(member_ref.def_id) in {
                            .Some(source) then {
                                if self.should_lower_function(symbol) then {
                                    let mutable checker = TypeChecker.new(self.program.global_scope, *(self.context), source.source_file)
                                    let rebuilt = checker.recheck_concrete_given_member_body(target_type, member_ref.params, member_ref.return_type, source, self.program.import_graph, self.program.generic_templates, self.program.method_table, self.program.trait_registry, self.program.conformance_index)
                                    let resolved_body = Monomorphizer.resolve_program_body_expression(self.program, self.context, box(rebuilt))
                                    methods_reversed.push(box(MIRFunctionWorkItem(symbol, member_ref.params, member_ref.return_type, kind, resolved_body)))
                                }
                            },
                            .None() then when member_ref.body in {
                                .Some(body) then {
                                    if self.should_lower_function(symbol) then {
                                        methods_reversed.push(box(MIRFunctionWorkItem(symbol, member_ref.params, member_ref.return_type, kind, body)))
                                    }
                                },
                                .None() then {},
                            },
                        },
                    }
                }
                while not methods_reversed.is_empty() then {
                    self.pending_work_items.push(methods_reversed.pop().unwrap())
                }
            },
            _ then {},
        }
    }

    public lower(*mutable self) * MIRProgram = {
        let program = self.metadata_program()
        let mutable functions = List[* MIRFunction].new()
        while true then {
            when self.lower_next_work_item() in {
                .Some(function) then functions.push(function),
                .None() then { break },
            }
        }
        let lowered = box(MIRProgram(
            program.globals,
            functions,
            program.context,
            program.static_method_lookup,
            program.traits,
            program.receiver_method_dispatch,
            program.concrete_callables_by_def_id,
        ))
        let mutable promoter = MIRReferenceAllocationPromoter.new(lowered)
        return promoter.promote()
    }

    public lower_work_item(self, item * MIRFunctionWorkItem) * MIRFunction = {
        return self.make_function(item.identifier, item.params, item.return_type, item.kind, item.body)
    }

    protected make_function(
        self,
        identifier * Symbol,
        params List[TypedParam],
        return_type Type,
        kind MIRFunctionKind,
        body * TypedExpr,
    ) * MIRFunction = {
        let mutable builder = MIRFunctionBuilder.new(
            self.program,
            identifier,
            params,
            List[* Symbol].new(),
            return_type,
            kind,
            body,
            self.context,
        )
        return (&mutable builder).lower()
    }

    protected should_lower_function(self, identifier * Symbol) Bool = {
        let _ = self
        return not self.context.contains_generic_parameter(identifier.symbol_type)
    }

    protected make_global_initializer_symbol(self, identifier * Symbol) * Symbol = {
        let function_type = Type.FunctionType(List[* FunctionParamEntry].new(), box(identifier.symbol_type))
        let mutable context = *(self.context)
        return box(context.create_symbol(
            "__mir_global_init_\(identifier.def_id.id)",
            self.context.get_module_path(identifier.def_id) or else List[String].new(),
            self.context.get_source_file(identifier.def_id) or else "<mir_global_init>",
            function_type,
            SymbolKind.Function(),
            MethodKind.Normal(),
            AccessModifier.Private(),
            unknown_span(),
            false,
        ))
    }

    protected make_given_member_symbol(self, member * TypedGivenMember) * Symbol = {
        let function_type = when self.context.get_function_type(member.def_id) in {
            .Some(t) then t,
            .None() then {
                let mutable param_types = List[* Type].new()
                for param in member.params then {
                    param_types.push(box(param.param_type))
                }
                break Type.FunctionType(types_to_param_entries(param_types), box(member.return_type))
            },
        }
        return box(Symbol(member.def_id, function_type, SymbolKind.Function()))
    }

    protected make_trait_vtable(self, request VtableRequest) MIRTraitVTable = {
        return MIRTraitVTable(
            request.concrete_type,
            request.trait_name,
            self.copy_type_ref_list(request.trait_type_args),
            self.make_trait_vtable_methods(request),
        )
    }

    protected copy_type_ref_list(self, values List[* Type]) List[Type] = {
        let mutable out = List[Type].new()
        for value in values then { out.push(*value) }
        return out
    }

    protected make_trait_vtable_methods(self, request VtableRequest) List[MIRTraitVTableMethod] = {
        // Collect trait members without ref mutable (ref mutable doesn't persist in bootstrap codegen).
        // Use iterative approach with explicit work list.
        let mutable ordered_members = List[TypedTraitMember].new()
        let mutable visited_traits = Set[String].new()
        let mutable seen_methods = Set[String].new()
        let mutable work_stack = List[String].new()
        work_stack.push(request.trait_name)
        while not work_stack.is_empty() then {
            let trait_name = work_stack.pop() or else { continue }
            if visited_traits.contains(trait_name) then { continue }
            visited_traits.insert(trait_name)
            when self.program.traits.get(trait_name) in {
                .Some(trait_info) then {
                    // Push parent traits in reverse order so we process them first
                    let mutable pi = trait_info.parent_traits.count()
                    while pi > 0(UInt) then {
                        pi -= 1(UInt)
                        work_stack.push(trait_info.parent_traits[pi].name)
                    }
                    for member in trait_info.members then {
                        if self.trait_member_has_receiver(member) and not seen_methods.contains(member.name) then {
                            seen_methods.insert(member.name)
                            ordered_members.push(member)
                        }
                    }
                },
                _ then {},
            }
        }

        let bindings = self.trait_member_type_bindings(request)
        let mutable methods = List[MIRTraitVTableMethod].new()
        for member in ordered_members then {
            methods.push(self.make_trait_vtable_method(self.apply_type_bindings_to_trait_member(member, bindings)))
        }
        return methods
    }

    protected trait_member_has_receiver(self, member TypedTraitMember) Bool = {
        let _ = self
        if member.params.is_empty() then { return false }
        let first_param = member.params[0]
        return first_param.name == "self"
    }

    protected trait_member_type_bindings(self, request VtableRequest) Dict[String, Type] = {
        let mutable bindings = Dict[String, Type].new()
        bindings.insert("Self", request.concrete_type)
        when self.program.traits.get(request.trait_name) in {
            .Some(trait_info) then {
                let mutable index UInt = 0
                while index < trait_info.type_params.count() and index < request.trait_type_args.count() then {
                    bindings.insert(trait_info.type_params[index].name, (*request.trait_type_args[index]))
                    index += 1
                }
            },
            .None() then {},
        }
        return bindings
    }

    protected apply_type_bindings(self, t Type, bindings Dict[String, Type]) Type = {
        let _ = self
        if bindings.is_empty() then { return t }
        return when t in {
            .GenericParameter(name) then when bindings.get(name) in { .Some(bound) then bound, .None() then t },
            .ReferenceType(inner) then Type.ReferenceType(box(self.apply_type_bindings(*inner, bindings))),
            .MutableReferenceType(inner) then Type.MutableReferenceType(box(self.apply_type_bindings(*inner, bindings))),
            .WeakReferenceType(inner) then Type.WeakReferenceType(box(self.apply_type_bindings(*inner, bindings))),
            .MutableWeakReferenceType(inner) then Type.MutableWeakReferenceType(box(self.apply_type_bindings(*inner, bindings))),
            .PointerType(inner) then Type.PointerType(box(self.apply_type_bindings(*inner, bindings))),
            .MutablePointerType(inner) then Type.MutablePointerType(box(self.apply_type_bindings(*inner, bindings))),
            .BorrowedReferenceType(inner) then Type.BorrowedReferenceType(box(self.apply_type_bindings(*inner, bindings))),
            .MutableBorrowedReferenceType(inner) then Type.MutableBorrowedReferenceType(box(self.apply_type_bindings(*inner, bindings))),
            .FunctionType(params, return_type) then {
                let mutable bound_params = List[* Type].new()
                for param in params then {
                    bound_params.push(box(self.apply_type_bindings(param.param_type, bindings)))
                }
                break make_function_type(bound_params, self.apply_type_bindings(*return_type, bindings))
            },
            .GenericStruct(template, args) then {
                let mutable bound_args = List[* Type].new()
                for arg in args then { bound_args.push(box(self.apply_type_bindings(*arg, bindings))) }
                break Type.GenericStruct(template, bound_args)
            },
            .GenericEnum(template, args) then {
                let mutable bound_args = List[* Type].new()
                for arg in args then { bound_args.push(box(self.apply_type_bindings(*arg, bindings))) }
                break Type.GenericEnum(template, bound_args)
            },
            .TraitObject(trait_name, args) then {
                let mutable bound_args = List[* Type].new()
                for arg in args then { bound_args.push(box(self.apply_type_bindings(*arg, bindings))) }
                break Type.TraitObject(trait_name, bound_args)
            },
            _ then t,
        }
    }

    protected apply_type_bindings_to_trait_member(self, member TypedTraitMember, bindings Dict[String, Type]) TypedTraitMember = {
        let mutable params = List[TypedParam].new()
        for param in member.params then {
            params.push(TypedParam(param.name, param.mutable, self.apply_type_bindings(param.param_type, bindings), param.named))
        }
        return TypedTraitMember(member.name, params, self.apply_type_bindings(member.return_type, bindings))
    }

    protected make_trait_vtable_method(self, member TypedTraitMember) MIRTraitVTableMethod = {
        let mutable params = List[MIRTraitVTableParameter].new()
        let mutable first = true
        let mutable self_by_value = false
        for param in member.params then {
            let is_self = param.name == "self"
            if first and is_self then {
                self_by_value = when param.param_type in {
                    .ReferenceType(_) then false,
                    .MutableReferenceType(_) then false,
                    .BorrowedReferenceType(_) then false,
                    .MutableBorrowedReferenceType(_) then false,
                    .WeakReferenceType(_) then false,
                    .MutableWeakReferenceType(_) then false,
                    .PointerType(_) then false,
                    .MutablePointerType(_) then false,
                    _ then true,
                }
            }
            params.push(MIRTraitVTableParameter(param.name, Option[Type].Some(param.param_type), is_self))
            first = false
        }
        return MIRTraitVTableMethod(member.name, Option[Type].Some(member.return_type), params, self_by_value)
    }
}

type MIRReferenceAllocationPromoter(
    program * MIRProgram,
)

type MIRReferenceAllocationFunctionPromoter(
    function * MIRFunction,
    parameter_types_by_def_id Dict[UInt, List[* FunctionParamEntry]],
    parameter_types_by_name Dict[String, List[* FunctionParamEntry]],
    context * CompilerContext,
    receiver_method_dispatch Dict[DefId, ReceiverMethodDispatchInfo],
    concrete_callables_by_def_id Dict[DefId, ConcreteCallableInfo],
    local_types_by_id Dict[UInt, Type],
    local_storages_by_id Dict[UInt, MIRStorage],
    escaping_locals Set[UInt],
    temporary_local_ids Set[UInt],
    temporary_value_sources_by_id Dict[UInt, MIRValue],
    escape_summaries_by_def_id Dict[UInt, MIREscapeSummary],
)

type MIREscapeSummary(
    returning_parameter_indices Set[UInt],
    direct_reference_escaping_parameter_indices Set[UInt],
)

private let mark_local_escape(value MIRValue, escaping *mutable Set[UInt]) Void = {
    when value in {
        .Operand(.Local(local_id)) then { escaping.insert(local_id.raw_value) },
        .PlaceRead(.Local(local_id), _) then { escaping.insert(local_id.raw_value) },
        .Ref(.Local(local_id), _, _) then { escaping.insert(local_id.raw_value) },
        _ then {},
    }
}

private let visit_local_escape_value(
    value MIRValue,
    summaries Dict[UInt, MIREscapeSummary],
    escaping *mutable Set[UInt]
) Void = {
    when value in {
        .Call(call) then {
            when call.callee in {
                .Function(callee_sym) then {
                    let callee_summary = summaries.get(callee_sym.def_id.id) or else MIREscapeSummary(Set[UInt].new(), Set[UInt].new())
                    let mutable ai = 0(UInt)
                    for arg in call.arguments then {
                        if callee_summary.direct_reference_escaping_parameter_indices.contains(ai) then {
                            mark_local_escape(*arg, escaping)
                        }
                        ai += 1
                    }
                },
                _ then {
                    for arg in call.arguments then {
                        mark_local_escape(*arg, escaping)
                    }
                },
            }
            for arg in call.arguments then {
                visit_local_escape_value(*arg, summaries, escaping)
            }
        },
        .TraitMethodCall(call) then {
            mark_local_escape(*call.receiver, escaping)
            visit_local_escape_value(*call.receiver, summaries, escaping)
            for arg in call.arguments then {
                mark_local_escape(*arg, escaping)
                visit_local_escape_value(*arg, summaries, escaping)
            }
        },
        .Aggregate(aggregate) then {
            for field in aggregate.fields then {
                mark_local_escape(*field, escaping)
                visit_local_escape_value(*field, summaries, escaping)
            }
        },
        .EnumCase(construction) then {
            for arg in construction.arguments then {
                mark_local_escape(*arg, escaping)
                visit_local_escape_value(*arg, summaries, escaping)
            }
        },
        .TraitObjectConversion(conversion) then {
            mark_local_escape(*conversion.inner, escaping)
            visit_local_escape_value(*conversion.inner, summaries, escaping)
        },
        .EnumTag(tag) then visit_local_escape_value(*tag.subject, summaries, escaping),
        .Intrinsic(node) then {
            when node in {
                .MakeRef(_, owner, _) then { mark_local_escape(*owner, escaping) visit_local_escape_value(*owner, summaries, escaping) },
                .MakeMutRef(_, owner, _) then { mark_local_escape(*owner, escaping) visit_local_escape_value(*owner, summaries, escaping) },
                .DowngradeRef(v, _) then visit_local_escape_value(*v, summaries, escaping),
                .DowngradeMutRef(v, _) then visit_local_escape_value(*v, summaries, escaping),
                .UpgradeRef(v, _) then visit_local_escape_value(*v, summaries, escaping),
                .UpgradeMutRef(v, _) then visit_local_escape_value(*v, summaries, escaping),
                .IsUniqueMutable(v) then visit_local_escape_value(*v, summaries, escaping),
                .RefCount(v) then visit_local_escape_value(*v, summaries, escaping),
                .CopyMemory(d, s, c) then { visit_local_escape_value(*d, summaries, escaping) visit_local_escape_value(*s, summaries, escaping) visit_local_escape_value(*c, summaries, escaping) },
                .MoveMemory(d, s, c) then { visit_local_escape_value(*d, summaries, escaping) visit_local_escape_value(*s, summaries, escaping) visit_local_escape_value(*c, summaries, escaping) },
                .InitMemory(p, v) then { visit_local_escape_value(*p, summaries, escaping) mark_local_escape(*v, escaping) visit_local_escape_value(*v, summaries, escaping) },
                .DeallocMemory(p) then visit_local_escape_value(*p, summaries, escaping),
                .DeinitMemory(p) then visit_local_escape_value(*p, summaries, escaping),
                .TakeMemory(p, _) then visit_local_escape_value(*p, summaries, escaping),
                .SpawnThread(h, t, c, s) then { visit_local_escape_value(*h, summaries, escaping) visit_local_escape_value(*t, summaries, escaping) mark_local_escape(*c, escaping) visit_local_escape_value(*c, summaries, escaping) visit_local_escape_value(*s, summaries, escaping) },
                _ then {},
            }
        },
        .Lambda(lambda) then {
            for source in lambda.capture_sources then {
                when source in {
                    .Local(local_id) then { escaping.insert(local_id.raw_value) },
                    _ then {},
                }
            }
        },
        _ then {},
    }
}

private let compute_escaping_locals_for_function(function * MIRFunction, summaries Dict[UInt, MIREscapeSummary]) Set[UInt] = {
    let mutable escaping = Set[UInt].new()
    for block in function.blocks then {
        for statement in block.statements then {
            when statement in {
                .Assign(_, value) then visit_local_escape_value(value, summaries, &mutable escaping),
                .CompoundAssign(assignment) then visit_local_escape_value(assignment.value, summaries, &mutable escaping),
                .Evaluate(value) then visit_local_escape_value(value, summaries, &mutable escaping),
                .Retain(value) then visit_local_escape_value(value, summaries, &mutable escaping),
                .Release(value) then visit_local_escape_value(value, summaries, &mutable escaping),
                _ then {},
            }
        }
        when block.terminator in {
            .ReturnValue(.Some(.Local(local_id))) then { escaping.insert(local_id.raw_value) },
            _ then {},
        }
    }
    let mutable changed = true
    while changed then {
        changed = false
        for block in function.blocks then {
            for statement in block.statements then {
                when statement in {
                    .Assign(dest, value) then {
                        when dest in {
                            .Local(dest_id) then {
                                if escaping.contains(dest_id.raw_value) then {
                                    when value in {
                                        .Operand(.Local(src_id)) then {
                                            if not escaping.contains(src_id.raw_value) then {
                                                escaping.insert(src_id.raw_value)
                                                changed = true
                                            }
                                        },
                                        .PlaceRead(.Local(src_id), _) then {
                                            if not escaping.contains(src_id.raw_value) then {
                                                escaping.insert(src_id.raw_value)
                                                changed = true
                                            }
                                        },
                                        _ then {},
                                    }
                                }
                            },
                            _ then {},
                        }
                    },
                    _ then {},
                }
            }
        }
    }
    return escaping
}

private let compute_temporary_local_ids(function * MIRFunction) Set[UInt] = {
    let mutable temps = Set[UInt].new()
    for local in function.locals then {
        if local.storage is .Temporary() then {
            temps.insert(local.id.raw_value)
        }
    }
    return temps
}

private let build_temporary_value_sources(function * MIRFunction, temporary_local_ids Set[UInt]) Dict[UInt, MIRValue] = {
    let mutable sources = Dict[UInt, MIRValue].new()
    let mutable ambiguous = Set[UInt].new()
    for block in function.blocks then {
        for statement in block.statements then {
            when statement in {
                .Assign(place, value) then {
                    when place in {
                        .Local(local_id) then {
                            if not temporary_local_ids.contains(local_id.raw_value) then {
                                continue
                            }
                            if ambiguous.contains(local_id.raw_value) then {
                                continue
                            }
                            when sources.get(local_id.raw_value) in {
                                .Some(_) then {
                                    let _ = sources.remove(local_id.raw_value)
                                    ambiguous.insert(local_id.raw_value)
                                },
                                .None() then {
                                    sources.insert(local_id.raw_value, value)
                                },
                            }
                        },
                        _ then {},
                    }
                },
                _ then {},
            }
        }
    }
    return sources
}

private let build_param_local_map(function * MIRFunction) Dict[UInt, UInt] = {
    let mutable param_local_ids = List[UInt].new()
    for local in function.locals then {
        if local.storage is .Parameter() then {
            param_local_ids.push(local.id.raw_value)
        }
    }
    let mutable local_to_param = Dict[UInt, UInt].new()
    let mutable idx = 0(UInt)
    while idx < param_local_ids.count() and idx < function.params.count() then {
        local_to_param.insert(param_local_ids[idx], idx)
        idx += 1
    }
    return local_to_param
}

private let escape_mark(value MIRValue, param_map Dict[UInt, UInt], local_sources Dict[UInt, Set[UInt]], escaping *mutable Set[UInt]) Void = {
    collect_parameter_sources(value, param_map, local_sources, escaping)
}

private let collect_parameter_sources(
    value MIRValue,
    param_map Dict[UInt, UInt],
    local_sources Dict[UInt, Set[UInt]],
    out *mutable Set[UInt]
) Void = {
    when value in {
        .Operand(.Local(local_id)) then {
            when param_map.get(local_id.raw_value) in {
                .Some(pi) then { out.insert(pi) },
                .None() then {
                    let local_params = local_sources.get(local_id.raw_value) or else Set[UInt].new()
                    for pi in local_params then { out.insert(pi) }
                },
            }
        },
        .PlaceRead(.Local(local_id), _) then {
            when param_map.get(local_id.raw_value) in {
                .Some(pi) then { out.insert(pi) },
                .None() then {
                    let local_params = local_sources.get(local_id.raw_value) or else Set[UInt].new()
                    for pi in local_params then { out.insert(pi) }
                },
            }
        },
        .Ref(.Local(local_id), _, _) then {
            when param_map.get(local_id.raw_value) in {
                .Some(pi) then { out.insert(pi) },
                .None() then {
                    let local_params = local_sources.get(local_id.raw_value) or else Set[UInt].new()
                    for pi in local_params then { out.insert(pi) }
                },
            }
        },
        _ then {},
    }
}

private let merge_value_parameter_sources(
    target_local UInt,
    value MIRValue,
    param_map Dict[UInt, UInt],
    local_sources *mutable Dict[UInt, Set[UInt]]
) Bool = {
    let mutable collected = Set[UInt].new()
    collect_parameter_sources(value, param_map, *local_sources, &mutable collected)
    let mutable merged = local_sources.get(target_local) or else Set[UInt].new()
    let mutable changed = false
    for pi in collected then {
        if not merged.contains(pi) then {
            merged.insert(pi)
            changed = true
        }
    }
    if changed then {
        local_sources.insert(target_local, merged)
    }
    return changed
}

private let mark_returning_from_value(
    value MIRValue,
    param_map Dict[UInt, UInt],
    local_sources Dict[UInt, Set[UInt]],
    returning *mutable Set[UInt]
) Void = {
    collect_parameter_sources(value, param_map, local_sources, returning)
}

private let visit_escape_value(
    value MIRValue,
    param_map Dict[UInt, UInt],
    local_sources Dict[UInt, Set[UInt]],
    summaries Dict[UInt, MIREscapeSummary],
    returning *mutable Set[UInt],
    direct_escaping *mutable Set[UInt]
) Void = {
    when value in {
        .Call(call) then {
            when call.callee in {
                .Function(callee_sym) then {
                    let callee_summary = summaries.get(callee_sym.def_id.id) or else MIREscapeSummary(Set[UInt].new(), Set[UInt].new())
                    let mutable ai = 0(UInt)
                    for arg in call.arguments then {
                        if callee_summary.direct_reference_escaping_parameter_indices.contains(ai) then {
                            escape_mark(*arg, param_map, local_sources, direct_escaping)
                        }
                        if callee_summary.returning_parameter_indices.contains(ai) then {
                            mark_returning_from_value(*arg, param_map, local_sources, returning)
                        }
                        ai += 1
                    }
                },
                _ then {
                    for arg in call.arguments then {
                        escape_mark(*arg, param_map, local_sources, direct_escaping)
                    }
                },
            }
            for arg in call.arguments then {
                visit_escape_value(*arg, param_map, local_sources, summaries, returning, direct_escaping)
            }
        },
        .TraitMethodCall(call) then {
            visit_escape_value(*call.receiver, param_map, local_sources, summaries, returning, direct_escaping)
            for arg in call.arguments then {
                visit_escape_value(*arg, param_map, local_sources, summaries, returning, direct_escaping)
            }
            escape_mark(*call.receiver, param_map, local_sources, direct_escaping)
            for arg in call.arguments then {
                escape_mark(*arg, param_map, local_sources, direct_escaping)
            }
        },
        .Aggregate(aggregate) then {
            for field in aggregate.fields then {
                escape_mark(*field, param_map, local_sources, direct_escaping)
                visit_escape_value(*field, param_map, local_sources, summaries, returning, direct_escaping)
            }
        },
        .EnumCase(construction) then {
            for arg in construction.arguments then {
                escape_mark(*arg, param_map, local_sources, direct_escaping)
                visit_escape_value(*arg, param_map, local_sources, summaries, returning, direct_escaping)
            }
        },
        .TraitObjectConversion(conversion) then {
            escape_mark(*conversion.inner, param_map, local_sources, direct_escaping)
            visit_escape_value(*conversion.inner, param_map, local_sources, summaries, returning, direct_escaping)
        },
        .EnumTag(tag) then {
            visit_escape_value(*tag.subject, param_map, local_sources, summaries, returning, direct_escaping)
        },
        .Intrinsic(node) then {
            when node in {
                .MakeRef(_, owner, _) then { escape_mark(*owner, param_map, local_sources, direct_escaping) visit_escape_value(*owner, param_map, local_sources, summaries, returning, direct_escaping) },
                .MakeMutRef(_, owner, _) then { escape_mark(*owner, param_map, local_sources, direct_escaping) visit_escape_value(*owner, param_map, local_sources, summaries, returning, direct_escaping) },
                .DowngradeRef(v, _) then visit_escape_value(*v, param_map, local_sources, summaries, returning, direct_escaping),
                .DowngradeMutRef(v, _) then visit_escape_value(*v, param_map, local_sources, summaries, returning, direct_escaping),
                .UpgradeRef(v, _) then visit_escape_value(*v, param_map, local_sources, summaries, returning, direct_escaping),
                .UpgradeMutRef(v, _) then visit_escape_value(*v, param_map, local_sources, summaries, returning, direct_escaping),
                .IsUniqueMutable(v) then visit_escape_value(*v, param_map, local_sources, summaries, returning, direct_escaping),
                .RefCount(v) then visit_escape_value(*v, param_map, local_sources, summaries, returning, direct_escaping),
                .CopyMemory(d, s, c) then { visit_escape_value(*d, param_map, local_sources, summaries, returning, direct_escaping) visit_escape_value(*s, param_map, local_sources, summaries, returning, direct_escaping) visit_escape_value(*c, param_map, local_sources, summaries, returning, direct_escaping) },
                .MoveMemory(d, s, c) then { visit_escape_value(*d, param_map, local_sources, summaries, returning, direct_escaping) visit_escape_value(*s, param_map, local_sources, summaries, returning, direct_escaping) visit_escape_value(*c, param_map, local_sources, summaries, returning, direct_escaping) },
                .InitMemory(p, v) then { visit_escape_value(*p, param_map, local_sources, summaries, returning, direct_escaping) visit_escape_value(*v, param_map, local_sources, summaries, returning, direct_escaping) },
                .DeallocMemory(p) then visit_escape_value(*p, param_map, local_sources, summaries, returning, direct_escaping),
                .DeinitMemory(p) then visit_escape_value(*p, param_map, local_sources, summaries, returning, direct_escaping),
                .TakeMemory(p, _) then visit_escape_value(*p, param_map, local_sources, summaries, returning, direct_escaping),
                .SpawnThread(h, t, c, s) then { visit_escape_value(*h, param_map, local_sources, summaries, returning, direct_escaping) visit_escape_value(*t, param_map, local_sources, summaries, returning, direct_escaping) visit_escape_value(*c, param_map, local_sources, summaries, returning, direct_escaping) visit_escape_value(*s, param_map, local_sources, summaries, returning, direct_escaping) },
                _ then {},
            }
        },
        .Lambda(lambda) then {
            for source in lambda.capture_sources then {
                when source in {
                    .Local(local_id) then {
                        when param_map.get(local_id.raw_value) in { .Some(pi) then { direct_escaping.insert(pi) }, .None() then {} }
                    },
                    _ then {},
                }
            }
        },
        _ then {},
    }
}

private let visit_escape_statement(
    value MIRValue,
    param_map Dict[UInt, UInt],
    local_sources Dict[UInt, Set[UInt]],
    summaries Dict[UInt, MIREscapeSummary],
    returning *mutable Set[UInt],
    direct_escaping *mutable Set[UInt]
) Void = {
    visit_escape_value(value, param_map, local_sources, summaries, returning, direct_escaping)
}

private let compute_escape_summaries(program * MIRProgram) Dict[UInt, MIREscapeSummary] = {
    let mutable param_maps = Dict[UInt, Dict[UInt, UInt]].new()
    for function_ref in program.functions then {
        param_maps.insert(function_ref.identifier.def_id.id, build_param_local_map(function_ref))
    }
    let mutable summaries = Dict[UInt, MIREscapeSummary].new()
    for function_ref in program.functions then {
        summaries.insert(function_ref.identifier.def_id.id, MIREscapeSummary(Set[UInt].new(), Set[UInt].new()))
    }
    let mutable changed = true
    while changed then {
        changed = false
        for function_ref in program.functions then {
            let func_id = function_ref.identifier.def_id.id
            let param_map = param_maps.get(func_id) or else Dict[UInt, UInt].new()
            let mutable returning = Set[UInt].new()
            let mutable direct_escaping = Set[UInt].new()
            let mutable local_sources = Dict[UInt, Set[UInt]].new()
            for block in function_ref.blocks then {
                for statement in block.statements then {
                    when statement in {
                        .Assign(place, value) then {
                            visit_escape_statement(value, param_map, local_sources, summaries, &mutable returning, &mutable direct_escaping)
                            when place in {
                                .Local(local_id) then { let _ = merge_value_parameter_sources(local_id.raw_value, value, param_map, &mutable local_sources) },
                                _ then {},
                            }
                        },
                        .CompoundAssign(assignment) then visit_escape_statement(assignment.value, param_map, local_sources, summaries, &mutable returning, &mutable direct_escaping),
                        .Evaluate(value) then visit_escape_statement(value, param_map, local_sources, summaries, &mutable returning, &mutable direct_escaping),
                        .Retain(value) then visit_escape_statement(value, param_map, local_sources, summaries, &mutable returning, &mutable direct_escaping),
                        .Release(value) then visit_escape_statement(value, param_map, local_sources, summaries, &mutable returning, &mutable direct_escaping),
                        _ then {},
                    }
                }
                when block.terminator in {
                    .ReturnValue(.Some(.Local(local_id))) then {
                        let mutable returned_params = Set[UInt].new()
                        collect_parameter_sources(MIRValue.Operand(MIROperand.Local(local_id)), param_map, local_sources, &mutable returned_params)
                        for pi in returned_params then { returning.insert(pi) }
                    },
                    _ then {},
                }
            }
            let next = MIREscapeSummary(returning, direct_escaping)
            let current = summaries.get(func_id) or else MIREscapeSummary(Set[UInt].new(), Set[UInt].new())
            if not (sets_equal(current.returning_parameter_indices, next.returning_parameter_indices) and sets_equal(current.direct_reference_escaping_parameter_indices, next.direct_reference_escaping_parameter_indices)) then {
                summaries.insert(func_id, next)
                changed = true
            }
        }
    }
    return summaries
}

private let sets_equal(a Set[UInt], b Set[UInt]) Bool = {
    for item in a then {
        if not b.contains(item) then { return false }
    }
    for item in b then {
        if not a.contains(item) then { return false }
    }
    return true
}


private let mir_value_contains_stack_borrow_ref(value MIRValue) Bool = {
    return when value in {
        .Ref(_, _, allocation) then allocation is .StackBorrow(),
        .Call(call) then {
            for argument in call.arguments then {
                if mir_value_contains_stack_borrow_ref(*argument) then {
                    return true
                }
            }
            break false
        },
        .Aggregate(aggregate) then {
            for field in aggregate.fields then {
                if mir_value_contains_stack_borrow_ref(*field) then {
                    return true
                }
            }
            break false
        },
        .EnumCase(construction) then {
            for argument in construction.arguments then {
                if mir_value_contains_stack_borrow_ref(*argument) then {
                    return true
                }
            }
            break false
        },
        .TraitObjectConversion(conversion) then mir_value_contains_stack_borrow_ref(*(conversion.inner)),
        .TraitMethodCall(call) then {
            if mir_value_contains_stack_borrow_ref(*(call.receiver)) then {
                return true
            }
            for argument in call.arguments then {
                if mir_value_contains_stack_borrow_ref(*argument) then {
                    return true
                }
            }
            break false
        },
        .EnumTag(tag) then mir_value_contains_stack_borrow_ref(*(tag.subject)),
        .Intrinsic(node) then when node in {
            .InitMemory(_, value) then mir_value_contains_stack_borrow_ref(*value),
            .SpawnThread(_, _, closure, _) then mir_value_contains_stack_borrow_ref(*closure),
            _ then false,
        },
        _ then false,
    }
}

private let is_member_path_place(place MIRPlace) Bool = {
    return when place in {
        .Local(_) then false,
        .Global(_) then false,
        .Field(_, _) then true,
        .EnumPayload(_, _, _, _, _) then true,
        .Deref(_, _) then true,
        .PointerElement(_, _) then true,
    }
}

private let mir_statement_needs_reference_allocation_promotion(statement MIRStatement) Bool = {
    return when statement in {
        .Assign(_, value) then mir_value_contains_stack_borrow_ref(value),
        .CompoundAssign(assignment) then mir_value_contains_stack_borrow_ref(assignment.value),
        .Evaluate(value) then mir_value_contains_stack_borrow_ref(value),
        _ then false,
    }
}

private let mir_function_needs_reference_allocation_promotion(function * MIRFunction) Bool = {
    for block in function.blocks then {
        for statement in block.statements then {
            if mir_statement_needs_reference_allocation_promotion(*statement) then {
                return true
            }
        }
    }
    return false
}

given MIRReferenceAllocationPromoter {
    public new(program * MIRProgram) MIRReferenceAllocationPromoter = {
        return MIRReferenceAllocationPromoter(program)
    }

    public promote(*mutable self) * MIRProgram = {
        let mutable needs_promotion = false
        for function_ref in self.program.functions then {
            if mir_function_needs_reference_allocation_promotion(function_ref) then {
                needs_promotion = true
                break
            }
        }
        if not needs_promotion then {
            return self.program
        }

        let parameter_types_by_def_id = self.build_parameter_types_by_def_id()
        let parameter_types_by_name = self.build_parameter_types_by_name()
        let escape_summaries = compute_escape_summaries(self.program)

        let mutable functions = List[* MIRFunction].new()
        for function_ref in self.program.functions then {
            let escaping_locals = compute_escaping_locals_for_function(function_ref, escape_summaries)
            let temporary_ids = compute_temporary_local_ids(function_ref)
            let mutable promoter = MIRReferenceAllocationFunctionPromoter.new(
                function_ref,
                parameter_types_by_def_id,
                parameter_types_by_name,
                &self.program.context,
                self.program.receiver_method_dispatch,
                self.program.concrete_callables_by_def_id,
                escaping_locals,
                temporary_ids,
                escape_summaries,
            )
            functions.push(promoter.promote())
        }

        return box(MIRProgram(
            self.program.globals,
            functions,
            self.program.context,
            self.program.static_method_lookup,
            self.program.traits,
            self.program.receiver_method_dispatch,
            self.program.concrete_callables_by_def_id,
        ))
    }

    protected build_parameter_types_by_def_id(self) Dict[UInt, List[* FunctionParamEntry]] = {
        let mutable map = Dict[UInt, List[* FunctionParamEntry]].new()
        for function_ref in self.program.functions then {
            map.insert(function_ref.identifier.def_id.id, self.function_param_entries(function_ref))
        }
        return map
    }

    protected build_parameter_types_by_name(self) Dict[String, List[* FunctionParamEntry]] = {
        let mutable map = Dict[String, List[* FunctionParamEntry]].new()
        for function_ref in self.program.functions then {
            let param_types = self.function_param_entries(function_ref)
            for name in self.callable_name_aliases(function_ref.identifier) then {
                when map.get(name) in {
                    .Some(_) then {},
                    .None() then { map.insert(name, param_types) },
                }
            }
        }
        return map
    }

    protected callable_logical_name(self, symbol * Symbol) String = {
        if symbol.def_id.id > 0 then {
            when self.program.receiver_method_dispatch.get(symbol.def_id) in {
                .Some(info) then { return info.method_name },
                .None() then {},
            }
            when self.program.concrete_callables_by_def_id.get(symbol.def_id) in {
                .Some(info) then { return info.logical_name },
                .None() then {},
            }
            when self.program.context.get_name(symbol.def_id) in {
                .Some(name) then { return name },
                .None() then {},
            }
        }
        return self.program.context.symbol_name(*symbol)
    }

    protected callable_name_aliases(self, symbol * Symbol) List[String] = {
        let mutable names = List[String].new()
        let logical = self.callable_logical_name(symbol)
        if not logical.is_empty() then {
            names.push(logical)
        }
        let symbol_name = self.program.context.symbol_name(*symbol)
        if not symbol_name.is_empty() and not names.contains(symbol_name) then {
            names.push(symbol_name)
        }
        if symbol.def_id.id > 0 then {
            when self.program.context.get_name(symbol.def_id) in {
                .Some(name) then if not name.is_empty() and not names.contains(name) then {
                    names.push(name)
                },
                .None() then {},
            }
        }
        return names
    }

    protected function_param_entries(self, function * MIRFunction) List[* FunctionParamEntry] = {
        when function.identifier.symbol_type in {
            .FunctionType(params, _) then { return params },
            _ then {},
        }
        let mutable params = List[* FunctionParamEntry].new()
        for param in function.params then {
            params.push(box(make_function_param_entry(param.param_type)))
        }
        return params
    }
}

given MIRReferenceAllocationFunctionPromoter {
    public new(
        function * MIRFunction,
        parameter_types_by_def_id Dict[UInt, List[* FunctionParamEntry]],
        parameter_types_by_name Dict[String, List[* FunctionParamEntry]],
        context * CompilerContext,
        receiver_method_dispatch Dict[DefId, ReceiverMethodDispatchInfo],
        concrete_callables_by_def_id Dict[DefId, ConcreteCallableInfo],
        escaping_locals Set[UInt],
        temporary_local_ids Set[UInt],
        escape_summaries_by_def_id Dict[UInt, MIREscapeSummary],
    ) MIRReferenceAllocationFunctionPromoter = {
        let mutable local_types_by_id = Dict[UInt, Type].new()
        let mutable local_storages_by_id = Dict[UInt, MIRStorage].new()
        for local in function.locals then {
            local_types_by_id.insert(local.id.raw_value, local.local_type)
            local_storages_by_id.insert(local.id.raw_value, local.storage)
        }
        let temporary_value_sources_by_id = build_temporary_value_sources(function, temporary_local_ids)
        return MIRReferenceAllocationFunctionPromoter(
            function,
            parameter_types_by_def_id,
            parameter_types_by_name,
            context,
            receiver_method_dispatch,
            concrete_callables_by_def_id,
            local_types_by_id,
            local_storages_by_id,
            escaping_locals,
            temporary_local_ids,
            temporary_value_sources_by_id,
            escape_summaries_by_def_id,
        )
    }
    public promote(*mutable self) * MIRFunction = {
        if not mir_function_needs_reference_allocation_promotion(self.function) then {
            return self.function
        }

        let mutable blocks = List[* MIRBasicBlock].new()
        for block in self.function.blocks then {
            let mutable statements = List[* MIRStatement].new()
            for statement in block.statements then {
                statements.push(box(self.promote_statement(*statement)))
            }
            blocks.push(box(MIRBasicBlock(block.id, statements, block.terminator)))
        }
        return box(MIRFunction(
            self.function.identifier,
            self.function.params,
            self.function.return_type,
            self.function.kind,
            self.function.entry_block,
            self.function.locals,
            blocks,
        ))
    }

    protected promote_statement(*mutable self, statement MIRStatement) MIRStatement = {
        return when statement in {
            .Assign(place, value) then {
                let destination_type = self.destination_type_for_place(place)
                break MIRStatement.Assign(place, self.promote_value_with_place(value, destination_type, Option[MIRPlace].Some(place)))
            },
            .CompoundAssign(assignment) then {
                let destination_type = self.destination_type_for_place(assignment.target)
                break MIRStatement.CompoundAssign(MIRCompoundAssignment(assignment.target, assignment.operator_kind, self.promote_value(assignment.value, destination_type)))
            },
            .Evaluate(value) then MIRStatement.Evaluate(self.promote_value(value, Option[Type].None())),
            .Retain(value) then MIRStatement.Retain(self.promote_value(value, Option[Type].None())),
            .Release(value) then MIRStatement.Release(self.promote_value(value, Option[Type].None())),
            _ then statement,
        }
    }

    protected destination_type_for_place(*self, place MIRPlace) Option[Type] = {
        return when place in {
            .Local(local) then Option[Type].Some(self.local_type(local)),
            .Global(def_id) then self.context.get_symbol_type(def_id),
            .Field(_, field) then Option[Type].Some(field.symbol_type),
            .EnumPayload(_, _, _, _, field_type) then Option[Type].Some(field_type),
            _ then Option[Type].None(),
        }
    }

    protected promote_value(*mutable self, value MIRValue, destination_type Option[Type]) MIRValue = {
        return self.promote_value_with_place(value, destination_type, Option[MIRPlace].None())
    }

    protected promote_value_with_place(*mutable self, value MIRValue, destination_type Option[Type], destination_place Option[MIRPlace]) MIRValue = {
        let promoted = when value in {
            .Call(call) then MIRValue.Call(MIRCall(
                call.callee,
                self.promote_call_arguments(call.arguments, call.callee, call.result_type),
                call.argument_ownerships,
                call.result_type,
            )),
            .Intrinsic(node) then MIRValue.Intrinsic(self.promote_intrinsic(node)),
            .Aggregate(aggregate) then {
                let mutable fields = List[* MIRValue].new()
                for field in aggregate.fields then {
                    fields.push(box(self.promote_value(*field, Option[Type].None())))
                }
                break MIRValue.Aggregate(MIRAggregate(aggregate.aggregate_type, fields, aggregate.field_ownerships))
            },
            .EnumCase(construction) then {
                let mutable args = List[* MIRValue].new()
                for arg in construction.arguments then {
                    args.push(box(self.promote_value(*arg, Option[Type].None())))
                }
                break MIRValue.EnumCase(MIREnumConstruction(construction.enum_type, construction.case_name, args))
            },
            .TraitObjectConversion(conversion) then MIRValue.TraitObjectConversion(MIRTraitObjectConversion(box(self.promote_value(*(conversion.inner), Option[Type].None())), conversion.source_ownership, conversion.trait_name, conversion.trait_type_args, conversion.concrete_type, conversion.result_type)),
            .TraitMethodCall(call) then {
                let mutable args = List[* MIRValue].new()
                for arg in call.arguments then {
                    args.push(box(self.promote_value(*arg, Option[Type].None())))
                }
                break MIRValue.TraitMethodCall(MIRTraitMethodCall(box(self.promote_value(*(call.receiver), Option[Type].None())), call.receiver_ownership, call.trait_name, call.trait_type_args, call.method_name, call.method_index, args, call.argument_ownerships, call.result_type))
            },
            .EnumTag(tag) then MIRValue.EnumTag(MIREnumTag(box(self.promote_value(*(tag.subject), Option[Type].None())), tag.enum_type)),
            .Ref(place, kind, .StackBorrow()) then {
                if is_member_path_place(place) then {
                    return value
                }
                let keep_stack_borrow = when destination_place in {
                    .Some(dp) then when dp in {
                        .Local(local_id) then not self.escaping_locals.contains(local_id.raw_value),
                        _ then false,
                    },
                    _ then false,
                }
                if keep_stack_borrow then {
                    return value
                }
                break value
            },
            _ then value,
        }
        if destination_type is .Some(dt) then {
            if self.type_requires_owned_reference_storage(dt) then {
                when destination_place in {
                    .Some(dp) then when dp in {
                        .Local(local_id) then {
                            if not self.escaping_locals.contains(local_id.raw_value) then {
                                return promoted
                            }
                        },
                        _ then {},
                    },
                    _ then {},
                }
                return self.promote_direct_references(promoted)
            }
        }
        return promoted
    }

    protected promote_call_arguments(*mutable self, arguments List[* MIRValue], callee MIROperand, result_type Type) List[* MIRValue] = {
        let params = when callee in {
            .Function(symbol) then self.parameters_for_call(symbol),
            _ then List[* FunctionParamEntry].new(),
        }
        if params.is_empty() then {
            return arguments
        }
        let direct_ref_escaping = when callee in {
            .Function(symbol) then {
                let summary = self.escape_summaries_by_def_id.get(symbol.def_id.id) or else MIREscapeSummary(Set[UInt].new(), Set[UInt].new())
                break summary.direct_reference_escaping_parameter_indices
            },
            _ then {
                let mutable all_indices = Set[UInt].new()
                let mutable i = 0(UInt)
                while i < arguments.count() then {
                    all_indices.insert(i)
                    i += 1
                }
                break all_indices
            },
        }
        let mutable promoted = List[* MIRValue].new()
        let mutable index = 0(UInt)
        while index < arguments.count() then {
            let argument = (*arguments[index])
            let param_type = if index < params.count()
                then Option[Type].Some(self.promotion_destination_type_for_param(*params[index]))
                else Option[Type].None()
            let mutable arg_promoted = self.promote_value(argument, param_type)
            if direct_ref_escaping.contains(index) then {
                arg_promoted = self.promote_direct_references(arg_promoted)
            }
            promoted.push(box(arg_promoted))
            index += 1
        }
        return promoted
    }

    protected promotion_destination_type_for_param(*self, param FunctionParamEntry) Type = {
        let _ = self
        return when param.pass_kind in {
            .ByReference() then when param.param_type in {
                .ReferenceType(inner) then Type.BorrowedReferenceType(inner),
                .BorrowedReferenceType(_) then param.param_type,
                _ then Type.BorrowedReferenceType(box(param.param_type)),
            },
            .ByMutableReference() then when param.param_type in {
                .MutableReferenceType(inner) then Type.MutableBorrowedReferenceType(inner),
                .MutableBorrowedReferenceType(_) then param.param_type,
                _ then Type.MutableBorrowedReferenceType(box(param.param_type)),
            },
            .ByValue() then param.param_type,
        }
    }

    protected parameters_for_call(*self, symbol * Symbol) List[* FunctionParamEntry] = {
        when self.parameter_types_by_def_id.get(symbol.def_id.id) in {
            .Some(types) then {
                let mutable params = List[* FunctionParamEntry].new()
                for t in types then { params.push(box(*t)) }
                return params
            },
            .None() then {},
        }
        for name in self.callable_name_aliases(symbol) then {
            when self.parameter_types_by_name.get(name) in {
                .Some(types) then {
                    let mutable params = List[* FunctionParamEntry].new()
                    for t in types then { params.push(box(*t)) }
                    return params
                },
                .None() then {},
            }
        }
        let function_type = self.context.get_function_type(symbol.def_id) or else symbol.symbol_type
        when function_type in {
            .FunctionType(params, _) then {
                return params
            },
            _ then {},
        }
        return List[* FunctionParamEntry].new()
    }

    protected promote_intrinsic(*mutable self, node MIRIntrinsic) MIRIntrinsic = {
        return when node in {
            .AllocMemory(count, result_type) then MIRIntrinsic.AllocMemory(box(self.promote_value(*count, Option[Type].None())), result_type),
            .DeallocMemory(pointer) then MIRIntrinsic.DeallocMemory(box(self.promote_value(*pointer, Option[Type].None()))),
            .CopyMemory(dest, source, count) then MIRIntrinsic.CopyMemory(box(self.promote_value(*dest, Option[Type].None())), box(self.promote_value(*source, Option[Type].None())), box(self.promote_value(*count, Option[Type].None()))),
            .MoveMemory(dest, source, count) then MIRIntrinsic.MoveMemory(box(self.promote_value(*dest, Option[Type].None())), box(self.promote_value(*source, Option[Type].None())), box(self.promote_value(*count, Option[Type].None()))),
            .IsUniqueMutable(value) then MIRIntrinsic.IsUniqueMutable(box(self.promote_value(*value, Option[Type].None()))),
            .RefCount(value) then MIRIntrinsic.RefCount(box(self.promote_value(*value, Option[Type].None()))),
            .MakeRef(pointer, owner, result_type) then MIRIntrinsic.MakeRef(box(self.promote_value(*pointer, Option[Type].None())), box(self.promote_value(*owner, Option[Type].Some(result_type))), result_type),
            .MakeMutRef(pointer, owner, result_type) then MIRIntrinsic.MakeMutRef(box(self.promote_value(*pointer, Option[Type].None())), box(self.promote_value(*owner, Option[Type].Some(result_type))), result_type),
            .DowngradeRef(value, result_type) then MIRIntrinsic.DowngradeRef(box(self.promote_value(*value, Option[Type].None())), result_type),
            .DowngradeMutRef(value, result_type) then MIRIntrinsic.DowngradeMutRef(box(self.promote_value(*value, Option[Type].None())), result_type),
            .UpgradeRef(value, result_type) then MIRIntrinsic.UpgradeRef(box(self.promote_value(*value, Option[Type].None())), result_type),
            .UpgradeMutRef(value, result_type) then MIRIntrinsic.UpgradeMutRef(box(self.promote_value(*value, Option[Type].None())), result_type),
            .InitMemory(pointer, value) then MIRIntrinsic.InitMemory(box(self.promote_value(*pointer, Option[Type].None())), box(self.promote_value(*value, Option[Type].Some(self.type_of_value(*value))))),
            .DeinitMemory(pointer) then MIRIntrinsic.DeinitMemory(box(self.promote_value(*pointer, Option[Type].None()))),
            .TakeMemory(pointer, result_type) then MIRIntrinsic.TakeMemory(box(self.promote_value(*pointer, Option[Type].None())), result_type),
            .NullPtr(result_type) then MIRIntrinsic.NullPtr(result_type),
            .SpawnThread(out_handle, out_tid, closure, stack_size) then MIRIntrinsic.SpawnThread(box(self.promote_value(*out_handle, Option[Type].None())), box(self.promote_value(*out_tid, Option[Type].None())), box(self.promote_value(*closure, Option[Type].Some(self.type_of_value(*closure)))), box(self.promote_value(*stack_size, Option[Type].None()))),
        }
    }

    protected type_requires_owned_reference_storage(*self, t Type) Bool = {
        return when t in {
            .ReferenceType(_) then true,
            .MutableReferenceType(_) then true,
            .BorrowedReferenceType(_) then false,
            .MutableBorrowedReferenceType(_) then false,
            .WeakReferenceType(_) then true,
            .MutableWeakReferenceType(_) then true,
            .FunctionType(_, _) then true,
            .TraitObject(_, _) then true,
            .StructureType(def_id) then when self.context.get_struct_fields(def_id) in {
                .Some(fields) then {
                    for field in fields then {
                        if self.type_requires_owned_reference_storage(field.field_type) then { return true }
                    }
                    break false
                },
                .None() then false,
            },
            .EnumType(def_id) then when self.context.get_enum_cases(def_id) in {
                .Some(cases) then {
                    for case_info in cases then {
                        for param in case_info.params then {
                            if self.type_requires_owned_reference_storage(param.param_type) then { return true }
                        }
                    }
                    break false
                },
                .None() then false,
            },
            .GenericStruct(_, args) then {
                for arg in args then {
                    if self.type_requires_owned_reference_storage(*arg) then { return true }
                }
                break false
            },
            .GenericEnum(_, args) then {
                for arg in args then {
                    if self.type_requires_owned_reference_storage(*arg) then { return true }
                }
                break false
            },
            _ then false,
        }
    }

    protected resolve_temporary_ref_source(*self, value MIRValue) MIRValue = {
        let mutable seen = Set[UInt].new()
        return self.resolve_temporary_ref_source_with_seen(value, &mutable seen)
    }

    protected resolve_temporary_ref_local(*self, local_id UInt, original MIRValue, seen *mutable Set[UInt]) MIRValue = {
        if seen.contains(local_id) then {
            return original
        }
        when self.temporary_value_sources_by_id.get(local_id) in {
            .Some(source) then {
                seen.insert(local_id)
                let resolved = self.resolve_temporary_ref_source_with_seen(source, seen)
                let _ = seen.remove(local_id)
                return when resolved in {
                    .Ref(_, _, _) then resolved,
                    _ then original,
                }
            },
            .None() then { return original },
        }
    }

    protected resolve_temporary_ref_source_with_seen(*self, value MIRValue, seen *mutable Set[UInt]) MIRValue = {
        return when value in {
            .Ref(_, _, _) then value,
            .Operand(.Local(local_id)) then self.resolve_temporary_ref_local(local_id.raw_value, value, seen),
            .PlaceRead(.Local(local_id), _) then self.resolve_temporary_ref_local(local_id.raw_value, value, seen),
            _ then value,
        }
    }

    protected promote_direct_references(*mutable self, value MIRValue) MIRValue = {
        let resolved = self.resolve_temporary_ref_source(value)
        return when resolved in {
            .Ref(place, kind, allocation) then when allocation in {
                .StackBorrow() then MIRValue.Ref(place, kind, MIRReferenceAllocation.HeapOwned()),
                .HeapOwned() then resolved,
            },
            .Aggregate(aggregate) then {
                let mutable fields = List[* MIRValue].new()
                for field in aggregate.fields then {
                    fields.push(box(self.promote_direct_references(*field)))
                }
                break MIRValue.Aggregate(MIRAggregate(aggregate.aggregate_type, fields, aggregate.field_ownerships))
            },
            .EnumCase(construction) then {
                let mutable args = List[* MIRValue].new()
                for arg in construction.arguments then {
                    args.push(box(self.promote_direct_references(*arg)))
                }
                break MIRValue.EnumCase(MIREnumConstruction(construction.enum_type, construction.case_name, args))
            },
            .TraitObjectConversion(conversion) then MIRValue.TraitObjectConversion(MIRTraitObjectConversion(box(self.promote_direct_references(*(conversion.inner))), conversion.source_ownership, conversion.trait_name, conversion.trait_type_args, conversion.concrete_type, conversion.result_type)),
            .TraitMethodCall(call) then {
                let mutable args = List[* MIRValue].new()
                for arg in call.arguments then {
                    args.push(box(self.promote_direct_references(*arg)))
                }
                break MIRValue.TraitMethodCall(MIRTraitMethodCall(box(self.promote_direct_references(*(call.receiver))), call.receiver_ownership, call.trait_name, call.trait_type_args, call.method_name, call.method_index, args, call.argument_ownerships, call.result_type))
            },
            .EnumTag(tag) then MIRValue.EnumTag(MIREnumTag(box(self.promote_direct_references(*(tag.subject))), tag.enum_type)),
            _ then resolved,
        }
    }

    protected callable_logical_name(self, symbol * Symbol) String = {
        if symbol.def_id.id > 0 then {
            when self.receiver_method_dispatch.get(symbol.def_id) in {
                .Some(info) then { return info.method_name },
                .None() then {},
            }
            when self.concrete_callables_by_def_id.get(symbol.def_id) in {
                .Some(info) then { return info.logical_name },
                .None() then {},
            }
            when self.context.get_name(symbol.def_id) in {
                .Some(name) then { return name },
                .None() then {},
            }
        }
        return self.context.symbol_name(*symbol)
    }

    protected callable_name_aliases(self, symbol * Symbol) List[String] = {
        let mutable names = List[String].new()
        let logical = self.callable_logical_name(symbol)
        if not logical.is_empty() then {
            names.push(logical)
        }
        let symbol_name = self.context.symbol_name(*symbol)
        if not symbol_name.is_empty() and not names.contains(symbol_name) then {
            names.push(symbol_name)
        }
        if symbol.def_id.id > 0 then {
            when self.context.get_name(symbol.def_id) in {
                .Some(name) then if not name.is_empty() and not names.contains(name) then {
                    names.push(name)
                },
                .None() then {},
            }
        }
        return names
    }

    protected type_of_value(*self, value MIRValue) Type = {
        return when value in {
            .Operand(operand) then self.type_of_operand(operand),
            .PlaceRead(place, _) then self.type_of_place(place),
            .Binary(operation) then operation.result_type,
            .Unary(operation) then operation.result_type,
            .Call(call) then call.result_type,
            .Aggregate(aggregate) then aggregate.aggregate_type,
            .EnumCase(construction) then construction.enum_type,
            .EnumTag(_) then Type.IntType(),
            .TraitObjectConversion(conversion) then conversion.result_type,
            .TraitMethodCall(call) then call.result_type,
            .Ref(place, kind, _) then self.type_of_ref(place, kind),
            .Pointer(place) then Type.PointerType(box(self.type_of_place(place))),
            .Cast(_, target_type) then target_type,
            .Intrinsic(node) then when node in {
                .AllocMemory(_, result_type) then result_type,
                .IsUniqueMutable(_) then Type.BoolType(),
                .RefCount(_) then Type.UIntType(),
                .MakeRef(_, _, result_type) then result_type,
                .MakeMutRef(_, _, result_type) then result_type,
                .DowngradeRef(_, result_type) then result_type,
                .DowngradeMutRef(_, result_type) then result_type,
                .UpgradeRef(_, result_type) then result_type,
                .UpgradeMutRef(_, result_type) then result_type,
                .TakeMemory(_, result_type) then result_type,
                .NullPtr(result_type) then result_type,
                .SpawnThread(_, _, _, _) then Type.Int32Type(),
                _ then Type.VoidType(),
            },
            .Lambda(lambda) then lambda.lambda_type,
        }
    }

    protected type_of_place(*self, place MIRPlace) Type = {
        return when place in {
            .Local(local) then self.local_type(local),
            .Global(def_id) then self.context.get_symbol_type(def_id) or else Type.Unknown(),
            .Field(_, field) then field.symbol_type,
            .EnumPayload(_, _, _, _, field_type) then field_type,
            .Deref(_, pointee) then pointee,
            .PointerElement(_, element) then element,
        }
    }

    protected type_of_operand(*self, operand MIROperand) Type = {
        return when operand in {
            .Local(local) then self.local_type(local),
            .Function(symbol) then symbol.symbol_type,
            .Constant(constant) then when constant in {
                .Integer(_, t) then t,
                .Float(_, t) then t,
                .StringLiteral(_, t) then t,
                .Boolean(_) then Type.BoolType(),
                .Void() then Type.VoidType(),
            },
        }
    }

    protected type_of_ref(*self, place MIRPlace, kind MIRReferenceKind) Type = {
        let inner = self.type_of_place(place)
        return when kind in {
            .Mutable() then Type.MutableReferenceType(box(inner)),
            .Weak() then Type.WeakReferenceType(box(inner)),
            .MutableWeak() then Type.MutableWeakReferenceType(box(inner)),
            .Shared() then Type.ReferenceType(box(inner)),
        }
    }

    protected local_type(*self, local MIRLocalID) Type = {
        return self.local_types_by_id.get(local.raw_value) or else Type.Unknown()
    }

    protected local_storage(*self, local MIRLocalID) MIRStorage = {
        return self.local_storages_by_id.get(local.raw_value) or else MIRStorage.Local()
    }

}

