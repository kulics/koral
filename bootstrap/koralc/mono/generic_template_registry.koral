// GenericTemplateRegistry and related types for the monomorphization phase.
// Stores all generic templates collected during type-checking, and provides
// lookup helpers used by the Monomorphizer.

// ── TypeParameterDecl ─────────────────────────────────────────────────────────

// A single type-parameter declaration on a generic template (e.g. `T` in `[T Any]List`).
// Bounds are semantic (`Bound`), not raw type syntax: the kind is known at parse
// time and trait identity is resolved once in sema. Matching Swift's
// `TypeParameterDecl` shape but with the syntax layer removed.
public type TypeParameterDecl(
    name String,
    constraints List[Bound],
);

// ── MethodDeclaration ─────────────────────────────────────────────────────────

// A method declaration stored inside a generic extension template.
// Mirrors the source-level signature so monomorphization can resolve it
// against concrete type arguments at instantiation time.
public type MethodDeclaration(
    name String,
    access AccessModifier,
    type_params List[TypeParameterDecl],
    params List[TemplateParam],
    return_type TypeNode,
    span SourceSpan,
    // Declaration identity — see GivenMember.def_id. Assigned once at collection,
    // carried through every instantiation.
    def_id DefId,
);

// `given Trait { ... }` entity methods are looked up through trait constraints,
// independently from generic extension templates.
public type TraitToolBlock(
    trait_name String,
    type_params List[TypeParameterDecl],
    methods List[GivenMember],
    source_file String,
    module_path List[String],
    package_id String,
);

public type TraitToolMethodEntry(
    source_trait_name String,
    method GivenMember,
    type_params List[TypeParameterDecl],
    source_file String,
    module_path List[String],
    package_id String,
);

// ── Template field / case / param helpers ─────────────────────────────────────

// A field in a generic struct template (name + TypeNode so the type can be
// resolved against concrete type arguments at instantiation time).
// No `mutable` fields — per RFC 4.2 these are plain value types (Swift has them
// as ordinary structs). `is_mutable` below is a field NAME, not a mutable field.
public type TemplateField(
    access AccessModifier,
    name String,
    is_mutable Bool,
    field_type TypeNode,
    named Bool,
);

// A case in a generic enum template.
public type TemplateCase(
    name String,
    params List[TemplateParam],
);

// A parameter of a generic enum case or generic function.
public type TemplateParam(
    name String,
    is_mutable Bool,
    param_type TypeNode,
    named Bool,
);

// ── IntrinsicExtensionEntry ───────────────────────────────────────────────────

// Describes a single intrinsic extension method (e.g. methods on `Ptr`).
// The method signature is expressed in terms of TypeNode so it can be
// instantiated against concrete type arguments.
public type IntrinsicExtensionEntry(
    method_name String,
    type_params List[TypeParameterDecl],
    params List[TemplateParam],
    return_type TypeNode,
);

// ── TraitDeclInfo ─────────────────────────────────────────────────────────────

// Compact representation of a trait declaration, carried through the
// monomorphization phase and forwarded to CodeGen for vtable generation.
public type TraitDeclInfo(
    def_id DefId,
    name String,
    type_params List[TypeParameterDecl],
    parent_traits List[ParentTraitConstraint],
    raw_members List[TraitMember],
    members List[TypedTraitMember],
    module_path List[String],
);

// ── ReceiverMethodOwner ───────────────────────────────────────────────────────

// Identifies the owner of a receiver-dispatched method.
//
// `ConcreteType` carries the owner's TYPE, not its display name: "is this owner
// one of the reference/pointer wrapper constructors?" has a direct answer in the
// `Type` model and must not be asked by round-tripping a type through its
// printed name and comparing strings.
/// Identifies the owner of a receiver-dispatched method.
///
/// Carries DECLARATIONS, never spellings: `ConcreteType` holds the owner's
/// `Type` and `ExtensionTemplate` the template's `DefId`. Deriving identity from
/// a stored name is how two same-named types from different modules got
/// conflated -- rustc's `Ty::Adt(&AdtDef, _)` has no name to reach for.
public type ReceiverMethodOwner {
    ExtensionTemplate(owner_def_id DefId),
    ConcreteType(owner_type Type),
};

/// Whether `t` is one of the language's reference/pointer wrapper types.
/// Variant test -- no names involved.
public let is_ref_wrapper_type(t Type) Bool = {
    return when t in {
        .ReferenceType(_) then true,
        .MutableReferenceType(_) then true,
        .BorrowedReferenceType(_) then true,
        .MutableBorrowedReferenceType(_) then true,
        .WeakReferenceType(_) then true,
        .MutableWeakReferenceType(_) then true,
        .PointerType(_) then true,
        .MutablePointerType(_) then true,
        _ then false,
    };
};

/// Whether a receiver method's owner is one of the reference/pointer wrapper
/// types. Decided from the owner's TYPE -- the old version round-tripped the
/// type through its display name and compared the strings, which would also
/// have matched a user type named `Ref`.
public let is_ref_wrapper_owner(owner Option[ReceiverMethodOwner]) Bool = {
    return when owner in {
        .Some(o) then when o in {
            .ConcreteType(owner_type) then is_ref_wrapper_type(owner_type),
            // An extension template owner is keyed by name in the template
            // registry; a user type named `Ref` would be a different template
            // and is not one of the wrapper constructors.
            .ExtensionTemplate(_) then false,
        },
        .None() then false,
    };
};

// ── ReceiverMethodDispatchInfo ────────────────────────────────────────────────

// Metadata for a method that uses receiver-based dispatch (e.g. trait-object
// method calls resolved at monomorphization time).
public type ReceiverMethodDispatchInfo(
    method_def_id DefId,
    method_name String,
    owner Option[ReceiverMethodOwner],
    conformance_trait_name Option[String],
    // Definition identity of the trait this method belongs to (Swift
    // ReceiverMethodDispatchInfo.conformanceTraitDefId). Trait identity must be
    // matched by DefId, not by name — name matching is what forces the
    // `ends_with(".Drop")` suffix guessing and collapses two same-named traits.
    conformance_trait_def_id Option[DefId],
);

// ── Generic template types ────────────────────────────────────────────────────

public type GenericStructTemplate(
    def_id DefId,
    name String,
    type_parameters List[TypeParameterDecl],
    fields List[TemplateField],
);

public type GenericEnumTemplate(
    def_id DefId,
    name String,
    type_parameters List[TypeParameterDecl],
    cases List[TemplateCase],
);

public type mutable GenericFunctionTemplate(
    def_id DefId,
    name String,
    type_parameters List[TypeParameterDecl],
    parameters List[TemplateParam],
    return_type TypeNode,
    mutable checked_body Option[TypedExpr],
    mutable checked_parameters Option[List[Symbol]],
    mutable checked_return_type Option[Type],
);

public type mutable GenericExtensionMethodTemplate(
    type_params List[TypeParameterDecl],
    method MethodDeclaration,
    conformance_trait_name Option[String],
    // Swift GenericExtensionMethodTemplate.conformanceTraitDefId — the trait's
    // declaration identity. Use this for anything that decides "which trait does
    // this method belong to"; conformance_trait_name is display-only.
    conformance_trait_def_id Option[DefId],
    conformance_target_type Option[Type],
    conformance_trait_args List[Type],
    uses_trait_type_params Bool,
    source_file String,
    module_path List[String],
    package_id String,
    mutable checked_body Option[TypedExpr],
    mutable checked_parameters Option[List[Symbol]],
    mutable checked_return_type Option[Type],
    // The trait-tool block's OWN generic parameters, when this template is a
    // tool method materialized onto a conformance. `type_params` above is the
    // conformance's parameter list (what `type_args` binds to); the body was
    // written against the tool's parameters, whose constraints must still hold.
    // Parameter `i` binds to `conformance_trait_args[i]`. Empty for templates
    // registered directly from a `given` block.
    tool_type_params List[TypeParameterDecl],
);

// ── GenericTemplateRegistry ───────────────────────────────────────────────────

public type mutable GenericTemplateRegistry(
    mutable struct_templates Dict[String, GenericStructTemplate],
    // Templates indexed by DECLARATION. `struct_templates` is keyed by spelling
    // and is last-wins when two modules use the same name; anything that needs
    // identity must use these.
    mutable struct_templates_by_def_id Dict[UInt, GenericStructTemplate],
    mutable enum_templates Dict[String, GenericEnumTemplate],
    mutable enum_templates_by_def_id Dict[UInt, GenericEnumTemplate],
    mutable function_templates Dict[String, GenericFunctionTemplate],
    // Functions indexed by DECLARATION. `function_templates` is keyed by
    // spelling (bare and qualified), so identity must not depend on scanning it.
    mutable function_templates_by_def_id Dict[UInt, GenericFunctionTemplate],
    mutable extension_methods Dict[MethodOwner, List[GenericExtensionMethodTemplate]],
    mutable intrinsic_extension_methods Dict[MethodOwner, List[IntrinsicExtensionEntry]],
    mutable trait_tool_blocks Dict[String, List[TraitToolBlock]],
    mutable traits Dict[String, TraitDeclInfo],
    // Traits indexed by DECLARATION. `traits` above is keyed by spelling and
    // exists for name resolution only; any test of the form "is this identity a
    // trait?" must come from here.
    mutable trait_decls_by_def_id Dict[UInt, TraitDeclInfo],
    mutable concrete_extension_methods Dict[MethodOwner, Dict[String, Symbol]],
    mutable intrinsic_generic_types Set[String],
    mutable intrinsic_generic_functions Set[String],
    mutable concrete_struct_types Dict[String, Type],
    mutable concrete_enum_types Dict[String, Type],
    mutable receiver_method_dispatch Dict[DefId, ReceiverMethodDispatchInfo],

    // ── Ambient context for NAME RESOLUTION (never for identity) ──────────
    //
    // Which module is being checked, in which file, and what the compilation
    // imports. Same role as `DefIdMap.currentModulePath` /
    // `DefIdMap.sharedImportGraph` in the Swift compiler: a spelling is not a
    // global key, it resolves through THIS module's imports. Identity always
    // travels on the `DefId`.
    mutable current_module_path List[String],
    mutable current_source_file Option[String],
    mutable current_import_graph Option[ImportGraph],
);

given GenericTemplateRegistry {
    file_private select_extension_method(
        self,
        templates List[GenericExtensionMethodTemplate],
        method_name String,
        method_type_arg_count Option[UInt],
        extension_type_arg_count Option[UInt],
    ) Option[GenericExtensionMethodTemplate] = {
        // Swift Monomorphizer.selectExtensionTemplate: prefer a candidate whose
        // body has been checked, else the first candidate. The previous extra
        // "has a checked_return_type" tier existed only to rank entries that a
        // name-keyed registry could not tell apart.
        let mutable first_match = Option[GenericExtensionMethodTemplate].None();
        for template_ref in templates then {
            if template_ref.method.name <> method_name then {
                continue;
            };
            when method_type_arg_count in {
                .Some(count) then {
                    if template_ref.method.type_params.count() <> count then {
                        continue;
                    };
                },
                .None() then {},
            };
            when extension_type_arg_count in {
                .Some(count) then {
                    // Swift Monomorphizer.selectExtensionTemplate filters
                    // `ext.typeParams.count != extensionTypeArgCount` unconditionally.
                    if template_ref.type_params.count() <> count then {
                        continue;
                    };
                },
                .None() then {},
            };
            if template_ref.checked_body is .Some(_) then {
                return Option[GenericExtensionMethodTemplate].Some(template_ref);
            };
            when first_match in {
                .Some(_) then {},
                .None() then {
                    first_match = Option[GenericExtensionMethodTemplate].Some(template_ref);
                },
            };
        };
        return first_match;
    };

    // Create an empty registry.
    public new() GenericTemplateRegistry = {
        return GenericTemplateRegistry(
            Dict[String, GenericStructTemplate].new(),
            Dict[UInt, GenericStructTemplate].new(),
            Dict[String, GenericEnumTemplate].new(),
            Dict[UInt, GenericEnumTemplate].new(),
            Dict[String, GenericFunctionTemplate].new(),
            Dict[UInt, GenericFunctionTemplate].new(),
            Dict[MethodOwner, List[GenericExtensionMethodTemplate]].new(),
            Dict[MethodOwner, List[IntrinsicExtensionEntry]].new(),
            Dict[String, List[TraitToolBlock]].new(),
            Dict[String, TraitDeclInfo].new(),
            Dict[UInt, TraitDeclInfo].new(),
            Dict[MethodOwner, Dict[String, Symbol]].new(),
            Set[String].new(),
            Set[String].new(),
            Dict[String, Type].new(),
            Dict[String, Type].new(),
            Dict[DefId, ReceiverMethodDispatchInfo].new(),
            List[String].new(),
            Option[String].None(),
            Option[ImportGraph].None(),
        );
    };

    /// An import edge is scoped to the file its `using` appears in.
    file_private import_edge_visible(self, edge_source_file Option[String]) Bool = {
        return when edge_source_file in {
            .Some(f) then {
                when self.current_source_file in {
                    .Some(cur) then f == cur,
                    .None() then false,
                }
            },
            .None() then true,
        };
    };

    /// The (module, original name) a symbol import binds `spelling` to, or None.
    /// `using "m" { x }` spells `x` and declares `x`; `using "m" { x as y }` spells
    /// `y` and declares `x`.
    file_private symbol_import_target(self, graph ImportGraph, spelling String) Option[Pair[List[String], String]] = {
        let mutable found = Option[Pair[List[String], String]].None();
        when graph.symbol_import_candidates(spelling) in {
            .Some(candidates) then {
                for edge in candidates then {
                    if edge.symbol == spelling
                        and string_list_eq(edge.module, self.current_module_path)
                        and self.import_edge_visible(edge.source_file) then {
                        found = Option[Pair[List[String], String]].Some(Pair[List[String], String](edge.target, edge.original_symbol));
                    };
                };
            },
            .None() then {},
        };
        return found;
    };

    /// Candidate registry keys for `spelling`, in priority order:
    ///
    ///   1. this module's own declaration (its qualified key),
    ///   2. a symbol import,
    ///   3. a batch/module import (`using "m";`) -- no symbol
    ///      edge, so the spelling is the same in the imported module,
    ///   4. the unqualified key.
    ///
    /// (4) is last on purpose and is NOT a resolution: that key is last-wins
    /// across modules, so it cannot answer "which `Box`?". It is kept so a name
    /// that is declared somewhere but imported nowhere can still produce
    /// `... is defined in module 'M'. Import it explicitly`.
    /// (rustc_resolve resolves per module from that module's imports; there is
    /// no global name table to fall back on.)
    file_private candidate_keys(self, spelling String) List[String] = {
        let mutable keys = List[String].new();
        if not self.current_module_path.is_empty() then {
            keys.push(qualified_symbol_key(self.current_module_path, spelling));
        };
        when self.current_import_graph in {
            .Some(graph) then {
                when self.symbol_import_target(graph, spelling) in {
                    .Some(pair) then keys.push(qualified_symbol_key(pair.first, pair.second)),
                    .None() then {},
                };
                for edge in graph.edges then {
                    if string_list_eq(edge.source, self.current_module_path) and self.import_edge_visible(edge.source_file) then {
                        keys.push(qualified_symbol_key(edge.target, spelling));
                    };
                };
            },
            .None() then {},
        };
        keys.push(spelling);
        return keys;
    };

    // Resolve a trait name (consolidated from 8 duplicate sites).
    public resolve_trait_name(self, candidate String) Option[String] = {
        for key in self.candidate_keys(candidate) then {
            if self.traits.contains_key(key) then {
                return Option[String].Some(key);
            };
        };
        return Option[String].None();
    };

    // Resolve a struct template name through this module's imports.
    public resolve_struct_name(self, candidate String) Option[String] = {
        for key in self.candidate_keys(candidate) then {
            if self.struct_templates.contains_key(key) then {
                return Option[String].Some(key);
            };
        };
        return Option[String].None();
    };

    // Resolve an enum template name through this module's imports.
    public resolve_enum_name(self, candidate String) Option[String] = {
        for key in self.candidate_keys(candidate) then {
            if self.enum_templates.contains_key(key) then {
                return Option[String].Some(key);
            };
        };
        return Option[String].None();
    };

    // Resolve a function template name through this module's imports.
    public resolve_function_name(self, candidate String) Option[String] = {
        for key in self.candidate_keys(candidate) then {
            if self.function_templates.contains_key(key) then {
                return Option[String].Some(key);
            };
        };
        return Option[String].None();
    };

    public resolve_function_name_in_module(self, candidate String, module_path List[String]) Option[String] = {
        let qualified = qualified_symbol_key(module_path, candidate);
        if self.function_templates.contains_key(qualified) then {
            return Option[String].Some(qualified);
        };
        return self.resolve_function_name(candidate);
    };

    // Look up a generic struct template by name.
    /// The generic struct template with this DECLARATION.
    ///
    /// Reached by `DefId`, never by name: two modules may each declare `Box`, and
    /// a name lookup answers for whichever registered last. rustc's `Ty::Adt`
    /// carries `&AdtDef`, so the definition comes from the type itself.
    public struct_by_def_id(self, def_id DefId) Option[GenericStructTemplate] = {
        if not def_id.is_valid() then {
            return Option[GenericStructTemplate].None();
        };
        return when self.struct_templates_by_def_id.get(def_id.id) in {
            .Some(t) then Option[GenericStructTemplate].Some(t),
            .None() then Option[GenericStructTemplate].None(),
        };
    };

    /// The generic enum template with this DECLARATION. Same reason.
    public enum_by_def_id(self, def_id DefId) Option[GenericEnumTemplate] = {
        if not def_id.is_valid() then {
            return Option[GenericEnumTemplate].None();
        };
        return when self.enum_templates_by_def_id.get(def_id.id) in {
            .Some(t) then Option[GenericEnumTemplate].Some(t),
            .None() then Option[GenericEnumTemplate].None(),
        };
    };

    public lookup_struct(self, name String) Option[GenericStructTemplate] = {
        return when self.resolve_struct_name(name) in {
            .Some(resolved_name) then self.struct_templates.get(resolved_name),
            .None() then Option[GenericStructTemplate].None(),
        };
    };

    public lookup_struct_def_id(self, name String) DefId = {
        return when self.resolve_struct_name(name) in {
            .Some(resolved_name) then when self.struct_templates.get(resolved_name) in {
                .Some(template) then template.def_id,
                .None() then def_id_invalid(),
            },
            .None() then def_id_invalid(),
        };
    };

    // Look up a generic enum template by name.
    public lookup_enum(self, name String) Option[GenericEnumTemplate] = {
        return when self.resolve_enum_name(name) in {
            .Some(resolved_name) then self.enum_templates.get(resolved_name),
            .None() then Option[GenericEnumTemplate].None(),
        };
    };

    public lookup_enum_def_id(self, name String) DefId = {
        return when self.resolve_enum_name(name) in {
            .Some(resolved_name) then when self.enum_templates.get(resolved_name) in {
                .Some(template) then template.def_id,
                .None() then def_id_invalid(),
            },
            .None() then def_id_invalid(),
        };
    };

    // Look up a generic function template by name.
    public lookup_function(self, name String) Option[GenericFunctionTemplate] = {
        return self.function_templates.get(name);
    };

    public lookup_function_in_module(self, name String, module_path List[String]) Option[GenericFunctionTemplate] = {
        let qualified = qualified_symbol_key(module_path, name);
        return when self.function_templates.get(qualified) in {
            .Some(template) then Option[GenericFunctionTemplate].Some(template),
            .None() then self.function_templates.get(name),
        };
    };

    /// The trait declared at `def_id`. Uses `trait_decls_by_def_id`, not a scan
    /// of the spelling-keyed `traits`: that map is last-wins under a shared name,
    /// so a scan both costs O(n) and cannot see the entry that lost the race.
    /// rustc asks `tcx.trait_def(def_id)` -- identity in, declaration out.
    public lookup_trait_by_def_id(self, def_id DefId) Option[TraitDeclInfo] = {
        if not def_id.is_valid() then {
            return Option[TraitDeclInfo].None();
        };
        return self.trait_decls_by_def_id.get(def_id.id);
    };

    public lookup_trait_in_module(self, name String, module_path List[String]) Option[TraitDeclInfo] = {
        let qualified = qualified_symbol_key(module_path, name);
        return when self.traits.get(qualified) in {
            .Some(info) then Option[TraitDeclInfo].Some(info),
            .None() then self.traits.get(name),
        };
    };

    // Look up a generic function template by DECLARATION. Uses the DefId index;
    // a scan of the spelling-keyed map is both O(n) and blind to whatever lost
    // the bare-name race. rustc: `tcx.impl_of_method` / `DefId` in, decl out.
    public lookup_function_by_def_id(self, def_id DefId) Option[GenericFunctionTemplate] = {
        if not def_id.is_valid() then {
            return Option[GenericFunctionTemplate].None();
        };
        return self.function_templates_by_def_id.get(def_id.id);
    };

    /// Record a trait declaration so its identity can be tested without going
    /// through a spelling. Called wherever `traits` is written.
    public register_trait_decl(self, info TraitDeclInfo) Void = {
        self.trait_decls_by_def_id.insert(info.def_id.id, info);
    };

    /// Is `def_id` the declaration of a trait?
    public is_trait_def_id(self, def_id DefId) Bool = {
        return self.trait_decls_by_def_id.get(def_id.id) is .Some(_);
    };

    /// Is this owner identity a trait (as opposed to a type or a built-in)?
    public is_trait_owner(self, owner MethodOwner) Bool = {
        return when owner in {
            .Decl(def_id) then self.is_trait_def_id(def_id),
            .Builtin(_) then false,
        };
    };

    // Look up all generic extension method templates for an owner identity.
    public lookup_extension_methods(self, owner MethodOwner) Option[List[GenericExtensionMethodTemplate]] = {
        when self.extension_methods.get(owner) in {
            .Some(templates) then {
                return Option[List[GenericExtensionMethodTemplate]].Some(templates);
            },
            .None() then {},
        };
        // Exact key only. Swift looks up `extensionMethods[baseName]` directly;
        // there is no suffix sweep to paper over disagreeing keys.
        return Option[List[GenericExtensionMethodTemplate]].None();
    };

    public lookup_extension_method(
        self,
        owner MethodOwner,
        method_name String,
        method_type_arg_count Option[UInt],
        extension_type_arg_count Option[UInt],
    ) Option[GenericExtensionMethodTemplate] = {
        when self.extension_methods.get(owner) in {
            .Some(templates) then {
                return self.select_extension_method(
                    templates,
                    method_name,
                    method_type_arg_count,
                    extension_type_arg_count,
                );
            },
            .None() then {},
        };
        // Exact key only — see lookup_extension_methods.
        return Option[GenericExtensionMethodTemplate].None();
    };
};
