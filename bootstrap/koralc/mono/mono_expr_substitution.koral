// Expression, statement, and pattern type substitution for the monomorphization phase.
// Recursively traverses TypedExpr trees, replacing GenericParameter types with
// concrete types from the substitution map, and remapping generic function DefIds
// to their concrete instantiated counterparts.
//

// ── substitute_types_in_expression ───────────────────────────────────────────

// Recursively substitute generic type parameters in a TypedExpr tree.
//
// For each node:
//   - Substitute the node's expr_type via substitute_type
//   - Remap Variable symbols: if the symbol's def_id is in remapped_function_def_ids,
//     replace with the first matching concrete DefId
//   - Recurse into all sub-expressions, statements, and patterns
//
public let substitute_types_in_expression(
    mono * Monomorphizer,
    expr * TypedExpr,
    substitution Dict[String, Type],
) * TypedExpr = {
    let new_type = when expr.expr_kind in {
        .CastExpr(target_type, _) then when target_type in {
            .TraitObject(original_trait_name, original_type_args) then {
                let mut substituted_type_args = List[* Type].new()
                for original_type_arg in original_type_args then {
                    substituted_type_args.push(box(mono.substitute_type_impl(*original_type_arg, substitution)))
                }
                break Type.TraitObject(original_trait_name, substituted_type_args)
            },
            _ then mono.substitute_type_impl(expr.expr_type, substitution),
        },
        _ then mono.substitute_type_impl(expr.expr_type, substitution),
    }
    let new_kind = substitute_expr_kind(mono, expr.expr_kind, substitution, new_type)
    let final_type = when new_type in {
        .Unknown() then recover_unknown_expr_type(mono, new_kind, new_type),
        _ then new_type,
    }
    return box(TypedExpr(new_kind, final_type))
}

private let recover_unknown_expr_type(
    mono * Monomorphizer,
    kind * TypedExprKind,
    fallback Type,
) Type = {
    let recovered = when kind in {
        .Variable(symbol) then resolve_parameterized_type(mono, symbol.symbol_type),
        .CastExpr(target_type, _) then resolve_parameterized_type(mono, target_type),
        .RefExpr(inner) then Type.ReferenceType(box(resolve_parameterized_type(mono, inner.expr_type))),
        .PtrExpr(inner) then Type.PointerType(box(resolve_parameterized_type(mono, inner.expr_type))),
        .DerefExpr(inner) then when resolve_parameterized_type(mono, inner.expr_type) in {
            .ReferenceType(inner_type) then *inner_type,
            .MutableReferenceType(inner_type) then *inner_type,
            .PointerType(inner_type) then *inner_type,
            .MutablePointerType(inner_type) then *inner_type,
            .WeakReferenceType(inner_type) then *inner_type,
            .MutableWeakReferenceType(inner_type) then *inner_type,
            _ then fallback,
        },
        .Call(callee, _) then when resolve_parameterized_type(mono, callee.expr_type) in {
            .FunctionType(_, return_type) then resolve_parameterized_type(mono, *return_type),
            _ then fallback,
        },
        .MemberPath(base, path) then recover_member_path_type(mono, base.expr_type, path, fallback),
        .MethodReference(_, _, method, _, _, _) then resolve_parameterized_type(mono, method.symbol_type),
        .LambdaExpr(params, return_type, _) then {
            let mut param_entries = List[* FunctionParamEntry].new()
            for param in params then {
                param_entries.push(box(make_function_param_entry(resolve_parameterized_type(mono, param.param_type))))
            }
            break Type.FunctionType(param_entries, box(resolve_parameterized_type(mono, return_type)))
        },
        .StaticMethodCall(_, _, method, _, _, _) then recover_method_return_type(mono, method, fallback),
        .TypeConstruction(identifier, type_args, args) then recover_type_construction_type(mono, identifier, type_args, args, fallback),
        .EnumConstruction(enum_type, _, _) then resolve_parameterized_type(mono, enum_type),
        .TraitMethodPlaceholder(_, _, method, _, _) then resolve_parameterized_type(mono, method.symbol_type),
        .TraitMethodCall(_, _, _, _, _) then fallback,
        .TraitObjectConversion(_, trait_type, _) then resolve_parameterized_type(mono, trait_type),
        .IntrinsicCall(node) then when node in {
            .MakeRef(_, _, result_type) then resolve_parameterized_type(mono, result_type),
            .MakeMutRef(_, _, result_type) then resolve_parameterized_type(mono, result_type),
            .DowngradeRef(_, result_type) then resolve_parameterized_type(mono, result_type),
            .DowngradeMutRef(_, result_type) then resolve_parameterized_type(mono, result_type),
            .UpgradeRef(_, result_type) then resolve_parameterized_type(mono, result_type),
            .UpgradeMutRef(_, result_type) then resolve_parameterized_type(mono, result_type),
            .AllocMemory(_, result_type) then resolve_parameterized_type(mono, result_type),
            .TakeMemory(_, result_type) then resolve_parameterized_type(mono, result_type),
            .NullPtr(result_type) then resolve_parameterized_type(mono, result_type),
            _ then fallback,
        },
        .GenericInstantiation(base_type, type_args) then when resolve_parameterized_type(mono, base_type) in {
            .GenericStruct(template_name, _) then Type.GenericStruct(template_name, box_each_type(type_args)),
            .GenericEnum(template_name, _) then Type.GenericEnum(template_name, box_each_type(type_args)),
            resolved_base then resolved_base,
        },
        _ then fallback,
    }
    return resolve_parameterized_type(mono, recovered)
}

private let recover_type_construction_type(
    mono * Monomorphizer,
    identifier * Symbol,
    type_args List[Type],
    args List[* TypedExpr],
    fallback Type,
) Type = {
    let resolved_identifier_type = resolve_parameterized_type(mono, identifier.symbol_type)
    when resolved_identifier_type in {
        .StructureType(_) then { return resolved_identifier_type },
        .EnumType(_) then { return resolved_identifier_type },
        .GenericStruct(_, _) then { return resolved_identifier_type },
        .GenericEnum(_, _) then { return resolved_identifier_type },
        _ then {},
    }

    if not type_args.is_empty() then {
        let mut boxed_args = List[* Type].new()
        for type_arg in type_args then {
            boxed_args.push(box(resolve_parameterized_type(mono, type_arg)))
        }

        let template_name = when mono.storage.context.get_template_name(identifier.def_id) in {
            .Some(name) then name,
            .None() then mono.storage.context.get_name(identifier.def_id) or else "",
        }

        if not template_name.is_empty() then {
            when mono.storage.generic_templates.lookup_struct(template_name) in {
                .Some(template) then {
                    return resolve_parameterized_type(mono, mono.instantiate_struct_impl(template, boxed_args))
                },
                .None() then {},
            }
            when mono.storage.generic_templates.lookup_enum(template_name) in {
                .Some(template) then {
                    return resolve_parameterized_type(mono, mono.instantiate_enum_impl(template, boxed_args))
                },
                .None() then {},
            }
        }
    }

    when infer_type_construction_type_from_args(mono, identifier, args) in {
        .Some(inferred) then { return inferred },
        .None() then {},
    }

    return resolve_parameterized_type(mono, fallback)
}

private let infer_type_construction_type_from_args(
    mono * Monomorphizer,
    identifier * Symbol,
    args List[* TypedExpr],
) Option[Type] = {
    let template_name = when mono.storage.context.get_template_name(identifier.def_id) in {
        .Some(name) then name,
        .None() then mono.storage.context.get_name(identifier.def_id) or else "",
    }
    if template_name.is_empty() then {
        return Option[Type].None()
    }

    if args.count() == 2(UInt) and (template_name == "Pair" or template_name.ends_with(".Pair")) then {
        let mut pair_args = List[* Type].new()
        pair_args.push(box(resolve_parameterized_type(mono, args[0(UInt)].expr_type)))
        pair_args.push(box(resolve_parameterized_type(mono, args[1(UInt)].expr_type)))
        return Option[Type].Some(resolve_parameterized_type(mono, Type.GenericStruct("Pair", pair_args)))
    }

    let template_opt = when mono.storage.generic_templates.resolve_struct_name(template_name) in {
        .Some(resolved_name) then mono.storage.generic_templates.lookup_struct(resolved_name),
        .None() then Option[GenericStructTemplate].None(),
    }

    return when template_opt in {
        .Some(template) then {
            if template.fields.count() <> args.count() then {
                return Option[Type].None()
            }
            let mut bindings = Dict[String, Type].new()
            let empty_subst = Dict[String, Type].new()
            let mut i UInt = 0
            while i < args.count() then {
                let field_pattern = mono.resolve_type_node_impl(template.fields[i].field_type, empty_subst)
                infer_type_bindings_from_constructor_pattern(mono, field_pattern, resolve_parameterized_type(mono, args[i].expr_type), &mut bindings)
                i += 1
            }

            let mut inferred_args = List[* Type].new()
            for type_param in template.type_parameters then {
                inferred_args.push(box(bindings.get(type_param.name) or else Type.GenericParameter(type_param.name)))
            }
            break Option[Type].Some(resolve_parameterized_type(mono, Type.GenericStruct(template.name, inferred_args)))
        },
        .None() then Option[Type].None(),
    }
}

private let infer_type_bindings_from_constructor_pattern(
    mono * Monomorphizer,
    pattern Type,
    concrete Type,
    bindings *mut Dict[String, Type],
) Void = {
    let normalized_pattern = resolve_parameterized_type(mono, pattern)
    let normalized_concrete = resolve_parameterized_type(mono, concrete)
    when normalized_pattern in {
        .GenericParameter(name) then {
            if bindings.get(name) is .None() then {
                bindings.insert(name, normalized_concrete)
            }
        },
        .ReferenceType(inner) then when normalized_concrete in {
            .ReferenceType(concrete_inner) then infer_type_bindings_from_constructor_pattern(mono, *inner, *concrete_inner, bindings),
            .MutableReferenceType(concrete_inner) then infer_type_bindings_from_constructor_pattern(mono, *inner, *concrete_inner, bindings),
            _ then {},
        },
        .MutableReferenceType(inner) then when normalized_concrete in {
            .MutableReferenceType(concrete_inner) then infer_type_bindings_from_constructor_pattern(mono, *inner, *concrete_inner, bindings),
            _ then {},
        },
        .PointerType(inner) then when normalized_concrete in {
            .PointerType(concrete_inner) then infer_type_bindings_from_constructor_pattern(mono, *inner, *concrete_inner, bindings),
            .MutablePointerType(concrete_inner) then infer_type_bindings_from_constructor_pattern(mono, *inner, *concrete_inner, bindings),
            _ then {},
        },
        .MutablePointerType(inner) then when normalized_concrete in {
            .MutablePointerType(concrete_inner) then infer_type_bindings_from_constructor_pattern(mono, *inner, *concrete_inner, bindings),
            _ then {},
        },
        .WeakReferenceType(inner) then when normalized_concrete in {
            .WeakReferenceType(concrete_inner) then infer_type_bindings_from_constructor_pattern(mono, *inner, *concrete_inner, bindings),
            .MutableWeakReferenceType(concrete_inner) then infer_type_bindings_from_constructor_pattern(mono, *inner, *concrete_inner, bindings),
            _ then {},
        },
        .MutableWeakReferenceType(inner) then when normalized_concrete in {
            .MutableWeakReferenceType(concrete_inner) then infer_type_bindings_from_constructor_pattern(mono, *inner, *concrete_inner, bindings),
            _ then {},
        },
        .FunctionType(pattern_params, pattern_return) then when normalized_concrete in {
            .FunctionType(concrete_params, concrete_return) then {
                if pattern_params.count() == concrete_params.count() then {
                    let mut i UInt = 0
                    while i < pattern_params.count() then {
                        infer_type_bindings_from_constructor_pattern(mono, (*pattern_params[i]).param_type, (*concrete_params[i]).param_type, bindings)
                        i += 1
                    }
                    infer_type_bindings_from_constructor_pattern(mono, *pattern_return, *concrete_return, bindings)
                }
            },
            _ then {},
        },
        .GenericStruct(pattern_name, pattern_args) then when normalized_concrete in {
            .GenericStruct(concrete_name, concrete_args) then {
                if pattern_name == concrete_name and pattern_args.count() == concrete_args.count() then {
                    let mut i UInt = 0
                    while i < pattern_args.count() then {
                        infer_type_bindings_from_constructor_pattern(mono, (*pattern_args[i]), (*concrete_args[i]), bindings)
                        i += 1
                    }
                }
            },
            _ then {},
        },
        .GenericEnum(pattern_name, pattern_args) then when normalized_concrete in {
            .GenericEnum(concrete_name, concrete_args) then {
                if pattern_name == concrete_name and pattern_args.count() == concrete_args.count() then {
                    let mut i UInt = 0
                    while i < pattern_args.count() then {
                        infer_type_bindings_from_constructor_pattern(mono, (*pattern_args[i]), (*concrete_args[i]), bindings)
                        i += 1
                    }
                }
            },
            _ then {},
        },
        _ then {},
    }
}

private let box_each_type(types List[Type]) List[* Type] = {
    let mut out = List[* Type].with_capacity(types.count())
    for t in types then {
        out.push(box(t))
    }
    return out
}

private let make_expected_type_placeholder_expr(t Type) * TypedExpr = {
    return box(TypedExpr(box(TypedExprKind.BoolLiteral(false)), t))
}

private let synthetic_args_from_expected_method_type(
    mono * Monomorphizer,
    receiver_type Type,
    expected_method_type Type,
) List[* TypedExpr] = {
    let mut args = List[* TypedExpr].new()
    let resolved_receiver_type = resolve_parameterized_type(mono, receiver_type)
    when resolve_parameterized_type(mono, expected_method_type) in {
        .FunctionType(expected_params, _) then {
            let param_types = param_entry_types(expected_params)
            let mut start_idx UInt = 0
            if not param_types.is_empty() then {
                let first_param_type = resolve_parameterized_type(mono, (*param_types[0(UInt)]))
                let receiver_matches = if layout_key(first_param_type) == layout_key(resolved_receiver_type) then {
                    break true
                } else when first_param_type in {
                    .ReferenceType(lhs) then when resolved_receiver_type in {
                        .StructureType(_) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .EnumType(_) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .GenericStruct(_, _) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .GenericEnum(_, _) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .ReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        .MutableReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        .BorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        .MutableBorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        _ then false,
                    },
                    .MutableReferenceType(lhs) then when resolved_receiver_type in {
                        .StructureType(_) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .EnumType(_) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .GenericStruct(_, _) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .GenericEnum(_, _) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .MutableReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        .MutableBorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        _ then false,
                    },
                    .BorrowedReferenceType(lhs) then when resolved_receiver_type in {
                        .StructureType(_) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .EnumType(_) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .GenericStruct(_, _) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .GenericEnum(_, _) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .ReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        .MutableReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        .BorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        .MutableBorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        _ then false,
                    },
                    .MutableBorrowedReferenceType(lhs) then when resolved_receiver_type in {
                        .StructureType(_) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .EnumType(_) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .GenericStruct(_, _) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .GenericEnum(_, _) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolved_receiver_type),
                        .MutableReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        .MutableBorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        _ then false,
                    },
                    .WeakReferenceType(lhs) then when resolved_receiver_type in {
                        .WeakReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        .MutableWeakReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        _ then false,
                    },
                    .MutableWeakReferenceType(lhs) then when resolved_receiver_type in {
                        .MutableWeakReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                        _ then false,
                    },
                    _ then false,
                }
                if receiver_matches then {
                    start_idx = 1
                }
            }
            let mut idx = start_idx
            while idx < param_types.count() then {
                args.push(make_expected_type_placeholder_expr(resolve_parameterized_type(mono, (*param_types[idx]))))
                idx += 1
            }
        },
        _ then {},
    }
    return args
}

private let bind_receiver_method_symbol_for_expected_type(
    mono * Monomorphizer,
    receiver_type Type,
    method Symbol,
    expected_method_type Type,
) Symbol = {
    when lookup_exact_receiver_method_symbol(
        mono,
        receiver_type,
        method,
        Option[Type].Some(expected_method_type),
    ) in {
        .Some(bound) then { return bound },
        .None() then {},
    }
    let expected_return_type = when resolve_parameterized_type(mono, expected_method_type) in {
        .FunctionType(_, return_type) then resolve_parameterized_type(mono, *return_type),
        _ then resolve_parameterized_type(mono, method.symbol_type),
    }
    let rebound = *try_bind_generic_method_call(
        mono,
        receiver_type,
        method,
        synthetic_args_from_expected_method_type(mono, receiver_type, expected_method_type),
        expected_return_type,
    )
    if rebound.def_id.id <> method.def_id.id or not has_generic_parameter(resolve_parameterized_type(mono, rebound.symbol_type)) then {
        if not method_symbol_matches_expected_for_receiver_lookup(
            mono,
            receiver_type,
            rebound,
            Option[Type].Some(expected_method_type),
        ) then {
            return method
        }
        return rebound
    }
    return method
}

private let substitution_lookup_receiver_method_symbol(
    mono * Monomorphizer,
    receiver_type Type,
    method Symbol,
    expected_method_type_opt Option[Type],
) Option[Symbol] = {
    when lookup_exact_receiver_method_symbol(
        mono,
        receiver_type,
        method,
        expected_method_type_opt,
    ) in {
        .Some(bound) then { return Option[Symbol].Some(bound) },
        .None() then {},
    }
    let rebound = bind_receiver_method_symbol(mono, receiver_type, method, expected_method_type_opt)
    if rebound.def_id.id > 0 and (
        rebound.def_id.id <> method.def_id.id
        or not has_generic_parameter(resolve_parameterized_type(mono, rebound.symbol_type))
    ) then {
        if not method_symbol_matches_expected_for_receiver_lookup(
            mono,
            receiver_type,
            rebound,
            expected_method_type_opt,
        ) then {
            return Option[Symbol].None()
        }
        return Option[Symbol].Some(rebound)
    }
    return Option[Symbol].None()
}

private let substitution_method_lookup_base_type(
    mono * Monomorphizer,
    base * TypedExpr,
) Type = {
    when base.expr_kind in {
        .Variable(_) then { return resolve_parameterized_type(mono, base.expr_type) },
        .RefExpr(inner) then when inner.expr_kind in {
            .Variable(symbol) then {
                let symbol_type = resolve_parameterized_type(mono, symbol.symbol_type)
                return when symbol_type in {
                    .ReferenceType(_) then resolve_parameterized_type(mono, base.expr_type),
                    .MutableReferenceType(_) then resolve_parameterized_type(mono, base.expr_type),
                    .BorrowedReferenceType(_) then resolve_parameterized_type(mono, base.expr_type),
                    .MutableBorrowedReferenceType(_) then resolve_parameterized_type(mono, base.expr_type),
                    .WeakReferenceType(_) then resolve_parameterized_type(mono, base.expr_type),
                    .MutableWeakReferenceType(_) then resolve_parameterized_type(mono, base.expr_type),
                    .PointerType(_) then resolve_parameterized_type(mono, base.expr_type),
                    .MutablePointerType(_) then resolve_parameterized_type(mono, base.expr_type),
                    _ then resolve_parameterized_type(mono, inner.expr_type),
                }
            },
            _ then { return substitution_method_lookup_base_type(mono, inner) },
        },
        _ then {},
    }
    return when resolve_parameterized_type(mono, base.expr_type) in {
        .ReferenceType(inner) then resolve_parameterized_type(mono, *inner),
        .MutableReferenceType(inner) then resolve_parameterized_type(mono, *inner),
        .BorrowedReferenceType(inner) then resolve_parameterized_type(mono, *inner),
        .MutableBorrowedReferenceType(inner) then resolve_parameterized_type(mono, *inner),
        .WeakReferenceType(inner) then resolve_parameterized_type(mono, *inner),
        .MutableWeakReferenceType(inner) then resolve_parameterized_type(mono, *inner),
        _ then resolve_parameterized_type(mono, base.expr_type),
    }
}

private let normalize_method_symbol_type_for_base(
    mono * Monomorphizer,
    method_type Type,
    base_type Type,
) Type = {
    let resolved_method_type = resolve_parameterized_type(mono, method_type)
    let resolved_base_type = resolve_parameterized_type(mono, base_type)
    let base_is_nested_ref_like = when resolved_base_type in {
        .ReferenceType(inner) then when resolve_parameterized_type(mono, *inner) in {
            .ReferenceType(_) then true,
            .MutableReferenceType(_) then true,
            .BorrowedReferenceType(_) then true,
            .MutableBorrowedReferenceType(_) then true,
            .WeakReferenceType(_) then true,
            .MutableWeakReferenceType(_) then true,
            _ then false,
        },
        .MutableReferenceType(inner) then when resolve_parameterized_type(mono, *inner) in {
            .ReferenceType(_) then true,
            .MutableReferenceType(_) then true,
            .BorrowedReferenceType(_) then true,
            .MutableBorrowedReferenceType(_) then true,
            .WeakReferenceType(_) then true,
            .MutableWeakReferenceType(_) then true,
            _ then false,
        },
        .BorrowedReferenceType(inner) then when resolve_parameterized_type(mono, *inner) in {
            .ReferenceType(_) then true,
            .MutableReferenceType(_) then true,
            .BorrowedReferenceType(_) then true,
            .MutableBorrowedReferenceType(_) then true,
            .WeakReferenceType(_) then true,
            .MutableWeakReferenceType(_) then true,
            _ then false,
        },
        .MutableBorrowedReferenceType(inner) then when resolve_parameterized_type(mono, *inner) in {
            .ReferenceType(_) then true,
            .MutableReferenceType(_) then true,
            .BorrowedReferenceType(_) then true,
            .MutableBorrowedReferenceType(_) then true,
            .WeakReferenceType(_) then true,
            .MutableWeakReferenceType(_) then true,
            _ then false,
        },
        .WeakReferenceType(inner) then when resolve_parameterized_type(mono, *inner) in {
            .ReferenceType(_) then true,
            .MutableReferenceType(_) then true,
            .BorrowedReferenceType(_) then true,
            .MutableBorrowedReferenceType(_) then true,
            .WeakReferenceType(_) then true,
            .MutableWeakReferenceType(_) then true,
            _ then false,
        },
        .MutableWeakReferenceType(inner) then when resolve_parameterized_type(mono, *inner) in {
            .ReferenceType(_) then true,
            .MutableReferenceType(_) then true,
            .BorrowedReferenceType(_) then true,
            .MutableBorrowedReferenceType(_) then true,
            .WeakReferenceType(_) then true,
            .MutableWeakReferenceType(_) then true,
            _ then false,
        },
        _ then false,
    }
    if base_is_nested_ref_like then {
        return resolved_method_type
    }
    return when resolved_method_type in {
        .FunctionType(fn_params, return_type) then {
            let param_types = param_entry_types(fn_params)
            if param_types.is_empty() then {
                return resolved_method_type
            }
            let first_param_type = resolve_parameterized_type(mono, (*param_types[0(UInt)]))
            let normalized_first_param = when first_param_type in {
                .ReferenceType(inner) then if layout_key(resolve_parameterized_type(mono, *inner)) == layout_key(resolved_base_type) then resolved_base_type else first_param_type,
                .MutableReferenceType(inner) then if layout_key(resolve_parameterized_type(mono, *inner)) == layout_key(resolved_base_type) then resolved_base_type else first_param_type,
                .WeakReferenceType(inner) then if layout_key(resolve_parameterized_type(mono, *inner)) == layout_key(resolved_base_type) then resolved_base_type else first_param_type,
                .MutableWeakReferenceType(inner) then if layout_key(resolve_parameterized_type(mono, *inner)) == layout_key(resolved_base_type) then resolved_base_type else first_param_type,
                .PointerType(inner) then if layout_key(resolve_parameterized_type(mono, *inner)) == layout_key(resolved_base_type) then resolved_base_type else first_param_type,
                .MutablePointerType(inner) then if layout_key(resolve_parameterized_type(mono, *inner)) == layout_key(resolved_base_type) then resolved_base_type else first_param_type,
                _ then first_param_type,
            }
            if layout_key(normalized_first_param) == layout_key(first_param_type) then {
                return resolved_method_type
            }
            let mut normalized_params = List[* FunctionParamEntry].new()
            normalized_params.push(box(make_function_param_entry(normalized_first_param)))
            let mut idx UInt = 1(UInt)
            while idx < param_types.count() then {
                normalized_params.push(box(make_function_param_entry(resolve_parameterized_type(mono, (*param_types[idx])))))
                idx += 1(UInt)
            }
            break Type.FunctionType(normalized_params, box(resolve_parameterized_type(mono, *return_type)))
        },
        _ then resolved_method_type,
    }
}

private let substitution_method_has_compatible_ref_like_receiver(
    mono * Monomorphizer,
    method_type Type,
    base_type Type,
) Bool = {
    let resolved_method_type = resolve_parameterized_type(mono, method_type)
    let resolved_base_type = resolve_parameterized_type(mono, base_type)
    return when resolved_method_type in {
        .FunctionType(fn_params, _) then {
            let param_types = param_entry_types(fn_params)
            if param_types.is_empty() then {
                return false
            }
            let first_param_type = resolve_parameterized_type(mono, (*param_types[0(UInt)]))
            break when first_param_type in {
                .ReferenceType(lhs) then when resolved_base_type in {
                    .ReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    .MutableReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    .BorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    .MutableBorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    _ then false,
                },
                .MutableReferenceType(lhs) then when resolved_base_type in {
                    .MutableReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    .MutableBorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    _ then false,
                },
                .BorrowedReferenceType(lhs) then when resolved_base_type in {
                    .ReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    .MutableReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    .BorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    .MutableBorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    _ then false,
                },
                .MutableBorrowedReferenceType(lhs) then when resolved_base_type in {
                    .MutableReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    .MutableBorrowedReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    _ then false,
                },
                .WeakReferenceType(lhs) then when resolved_base_type in {
                    .WeakReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    .MutableWeakReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    _ then false,
                },
                .MutableWeakReferenceType(lhs) then when resolved_base_type in {
                    .MutableWeakReferenceType(rhs) then layout_key(resolve_parameterized_type(mono, *lhs)) == layout_key(resolve_parameterized_type(mono, *rhs)),
                    _ then false,
                },
                _ then false,
            }
        },
        _ then false,
    }
}

private let substitution_should_preserve_resolved_method_reference(
    mono * Monomorphizer,
    method * Symbol,
    base_type Type,
) Bool = {
    if method.def_id.id == 0 then {
        return false
    }
    let resolved_method_type = resolve_parameterized_type(mono, method.symbol_type)
    if not substitution_method_has_compatible_ref_like_receiver(mono, resolved_method_type, base_type) then {
        return false
    }
    if has_generic_parameter(resolved_method_type) then {
        return false
    }
    return when mono.receiver_method_dispatch_info(method.def_id) in {
        .Some(info) then when info.owner in {
            .Some(owner) then when owner in {
                .ExtensionTemplate(owner_name) then
                    owner_name == "Ref" or owner_name == "MutRef" or owner_name == "WeakRef" or owner_name == "MutWeakRef",
                .ConcreteType(type_name) then
                    type_name == "Ref" or type_name == "MutRef" or type_name == "WeakRef" or type_name == "MutWeakRef",
            },
            .None() then false,
        },
        .None() then false,
    }
}

private let recover_method_return_type(
    mono * Monomorphizer,
    method * Symbol,
    fallback Type,
) Type = {
    let method_type = resolve_parameterized_type(mono, method.symbol_type)
    let fallback_type = resolve_parameterized_type(mono, fallback)
    return when method_type in {
        .FunctionType(_, return_type) then resolve_parameterized_type(mono, *return_type),
        _ then fallback_type,
    }
}

private let recover_member_field_type(
    mono * Monomorphizer,
    base_type Type,
    member_name String,
    fallback Type,
) Type = {
    let resolved_base = resolve_parameterized_type(mono, base_type)
    when resolved_base in {
        .ReferenceType(inner) then {
            return recover_member_field_type(mono, *inner, member_name, fallback)
        },
        .MutableReferenceType(inner) then {
            return recover_member_field_type(mono, *inner, member_name, fallback)
        },
        .WeakReferenceType(inner) then {
            return recover_member_field_type(mono, *inner, member_name, fallback)
        },
        .MutableWeakReferenceType(inner) then {
            return recover_member_field_type(mono, *inner, member_name, fallback)
        },
        .PointerType(inner) then {
            return recover_member_field_type(mono, *inner, member_name, fallback)
        },
        .MutablePointerType(inner) then {
            return recover_member_field_type(mono, *inner, member_name, fallback)
        },
        .GenericStruct(template_name, args) then {
            if template_name == "Pair" and args.count() == 2(UInt) then {
                when member_name in {
                    "first" then {
                        return resolve_parameterized_type(mono, (*args[0(UInt)]))
                    },
                    "second" then {
                        return resolve_parameterized_type(mono, (*args[1(UInt)]))
                    },
                    _ then {},
                }
            }
            when mono.storage.generic_templates.lookup_struct(template_name) in {
                .Some(template) then {
                    let mut subst = Dict[String, Type].new()
                    let mut i UInt = 0
                    while i < template.type_parameters.count() and i < args.count() then {
                        subst.insert(template.type_parameters[i].name, (*args[i]))
                        i += 1
                    }
                    for field in template.fields then {
                        if field.name == member_name then {
                            return resolve_parameterized_type(mono, mono.resolve_type_node_impl(field.field_type, subst))
                        }
                    }
                },
                .None() then {},
            }
        },
        .StructureType(def_id) then {
            when mono.storage.context.get_struct_fields(def_id) in {
                .Some(fields) then {
                    for field in fields then {
                        if field.name == member_name then {
                            return resolve_parameterized_type(mono, field.field_type)
                        }
                    }
                },
                .None() then {},
            }
        },
        _ then {},
    }
    return resolve_parameterized_type(mono, fallback)
}

private let recover_member_path_type(
    mono * Monomorphizer,
    base_type Type,
    path List[String],
    fallback Type,
) Type = {
    let mut current = resolve_parameterized_type(mono, base_type)
    for member_name in path then {
        current = recover_member_field_type(mono, current, member_name, fallback)
    }
    return current
}

// ── substitute_expr_kind ──────────────────────────────────────────────────────

// Substitute types in a TypedExprKind, recursing into sub-expressions.
private let substitute_expr_kind(
    mono * Monomorphizer,
    kind * TypedExprKind,
    substitution Dict[String, Type],
    substituted_expr_type Type,
) * TypedExprKind = {
    return when kind in {
        // Variable: remap DefId if it's a generic function that was instantiated.
        .Variable(symbol) then box(TypedExprKind.Variable(box(substitute_symbol(mono, symbol, substitution)))),

        // Literals: no sub-expressions, just return as-is.
        .IntegerLiteral(value) then box(TypedExprKind.IntegerLiteral(value)),
        .FloatLiteral(value)   then box(TypedExprKind.FloatLiteral(value)),
        .StringLiteral(value)  then box(TypedExprKind.StringLiteral(value)),
        .BoolLiteral(value)    then box(TypedExprKind.BoolLiteral(value)),

        // CastExpr: substitute target type and inner expression.
        .CastExpr(target_type, e) then {
            let new_target = when target_type in {
                .TraitObject(original_trait_name, original_type_args) then {
                    let mut substituted_type_args = List[* Type].new()
                    for original_type_arg in original_type_args then {
                        substituted_type_args.push(box(mono.substitute_type_impl(*original_type_arg, substitution)))
                    }
                    break Type.TraitObject(original_trait_name, substituted_type_args)
                },
                _ then mono.substitute_type_impl(target_type, substitution),
            }
            break box(TypedExprKind.CastExpr(new_target, substitute_types_in_expression(mono, e, substitution)))
        },

        .TraitObjectConversion(inner, trait_type, concrete_type) then {
            let new_inner = substitute_types_in_expression(mono, inner, substitution)
            let substituted_trait_type = mono.substitute_type_impl(trait_type, substitution)
            let resolved_substituted_trait_type = resolve_parameterized_type(mono, substituted_trait_type)
            let mut new_trait_type = resolved_substituted_trait_type
            when trait_type in {
                .TraitObject(original_trait_name, original_type_args) then {
                    let mut substituted_type_args = List[* Type].new()
                    for original_type_arg in original_type_args then {
                        substituted_type_args.push(box(mono.substitute_type_impl(*original_type_arg, substitution)))
                    }
                    new_trait_type = Type.TraitObject(original_trait_name, substituted_type_args)
                },
                _ then {},
            }
            let new_concrete_type = resolve_parameterized_type(mono, mono.substitute_type_impl(concrete_type, substitution))
            when new_trait_type in {
                .TraitObject(trait_name, _) then collect_concrete_vtable_request(mono, new_concrete_type, trait_name),
                _ then {},
            }
            break box(TypedExprKind.TraitObjectConversion(new_inner, new_trait_type, new_concrete_type))
        },

        // Unary: substitute inner expression.
        .Unary(op, e) then {
            break box(TypedExprKind.Unary(op, substitute_types_in_expression(mono, e, substitution)))
        },

        // RefExpr / PtrExpr / DerefExpr: substitute inner expression.
        .RefExpr(e) then {
            break box(TypedExprKind.RefExpr(substitute_types_in_expression(mono, e, substitution)))
        },
        .PtrExpr(e) then {
            break box(TypedExprKind.PtrExpr(substitute_types_in_expression(mono, e, substitution)))
        },
        .DerefExpr(e) then {
            break box(TypedExprKind.DerefExpr(substitute_types_in_expression(mono, e, substitution)))
        },

        // ArithmeticExpr: substitute both sides.
        .ArithmeticExpr(left, op, right) then {
            let new_left  = substitute_types_in_expression(mono, left,  substitution)
            let new_right = substitute_types_in_expression(mono, right, substitution)
            break box(TypedExprKind.ArithmeticExpr(new_left, op, new_right))
        },

        .WrappingArithmeticExpr(left, op, right) then {
            let new_left  = substitute_types_in_expression(mono, left,  substitution)
            let new_right = substitute_types_in_expression(mono, right, substitution)
            break box(TypedExprKind.WrappingArithmeticExpr(new_left, op, new_right))
        },

        .WrappingShiftExpr(left, op, right) then {
            let new_left  = substitute_types_in_expression(mono, left,  substitution)
            let new_right = substitute_types_in_expression(mono, right, substitution)
            break box(TypedExprKind.WrappingShiftExpr(new_left, op, new_right))
        },

        // ComparisonExpr: substitute both sides.
        .ComparisonExpr(left, op, right) then {
            let new_left  = substitute_types_in_expression(mono, left,  substitution)
            let new_right = substitute_types_in_expression(mono, right, substitution)
            break box(TypedExprKind.ComparisonExpr(new_left, op, new_right))
        },

        // BitwiseExpr: substitute both sides.
        .BitwiseExpr(left, op, right) then {
            let new_left  = substitute_types_in_expression(mono, left,  substitution)
            let new_right = substitute_types_in_expression(mono, right, substitution)
            break box(TypedExprKind.BitwiseExpr(new_left, op, new_right))
        },

        // AndExpr / OrExpr: substitute both sides.
        .AndExpr(left, right) then {
            let new_left  = substitute_types_in_expression(mono, left,  substitution)
            let new_right = substitute_types_in_expression(mono, right, substitution)
            break box(TypedExprKind.AndExpr(new_left, new_right))
        },

        .IsExpr(subject, pattern, negated) then {
            let new_subject = substitute_types_in_expression(mono, subject, substitution)
            let new_pattern = substitute_pattern(mono, pattern, substitution)
            break box(TypedExprKind.IsExpr(new_subject, box(new_pattern), negated))
        },
        .OrExpr(left, right) then {
            let new_left  = substitute_types_in_expression(mono, left,  substitution)
            let new_right = substitute_types_in_expression(mono, right, substitution)
            break box(TypedExprKind.OrExpr(new_left, new_right))
        },

        // Call: substitute callee and all arguments.
        .Call(callee, args) then {
            let mut new_callee = substitute_types_in_expression(mono, callee, substitution)
            let mut new_args = List[* TypedExpr].new()
            for arg in args then {
                new_args.push(substitute_types_in_expression(mono, arg, substitution))
            }
            when new_callee.expr_kind in {
                .Variable(identifier) then when identifier.kind in {
                    .Function() then when mono.storage.remapped_function_def_ids.get(identifier.def_id.id) in {
                        .Some(candidates) then {
                            let original_method_name = when mono.storage.receiver_method_dispatch.get(identifier.def_id) in {
                                .Some(info) then Option[String].Some(info.method_name),
                                .None() then Option[String].None(),
                            }
                            let filtered_candidates = when original_method_name in {
                                .Some(method_name) then {
                                    let mut filtered = List[Pair[DefId, Type]].new()
                                    for candidate in candidates then {
                                        when mono.storage.receiver_method_dispatch.get(candidate.first) in {
                                            .Some(info) then {
                                                if info.method_name == method_name then {
                                                    filtered.push(candidate)
                                                }
                                            },
                                            .None() then {},
                                        }
                                    }
                                    break filtered
                                },
                                .None() then candidates,
                            }
                            let owner_compatible_candidates = if new_args.is_empty() then {
                                break filtered_candidates
                            } else {
                                let actual_receiver_type = resolve_parameterized_type(mono, new_args[0(UInt)].expr_type)
                                let mut owner_filtered = List[Pair[DefId, Type]].new()
                                for candidate in filtered_candidates then {
                                    let mut owner_matches_receiver = true
                                    when mono.concrete_callable_info(candidate.first) in {
                                        .Some(info) then {
                                            when info.owner_type in {
                                            .Some(owner_type) then {
                                                let resolved_owner_type = resolve_parameterized_type(mono, owner_type)
                                                owner_matches_receiver = if resolved_owner_type == actual_receiver_type then {
                                                    break true
                                                } else when actual_receiver_type in {
                                                    .ReferenceType(inner) then resolved_owner_type == resolve_parameterized_type(mono, *inner),
                                                    .MutableReferenceType(inner) then resolved_owner_type == resolve_parameterized_type(mono, *inner),
                                                    .BorrowedReferenceType(inner) then resolved_owner_type == resolve_parameterized_type(mono, *inner),
                                                    .MutableBorrowedReferenceType(inner) then resolved_owner_type == resolve_parameterized_type(mono, *inner),
                                                    .WeakReferenceType(inner) then resolved_owner_type == resolve_parameterized_type(mono, *inner),
                                                    .MutableWeakReferenceType(inner) then resolved_owner_type == resolve_parameterized_type(mono, *inner),
                                                    _ then false,
                                                }
                                            },
                                            .None() then {
                                                let candidate_type = resolve_parameterized_type(mono, substitute_type(mono, candidate.second, substitution))
                                                owner_matches_receiver = when candidate_type in {
                                                    .FunctionType(candidate_params, _) then if candidate_params.count() == 0 then false else strict_wrapper_receiver_param_matches(mono, (*candidate_params[0(UInt)]).param_type, actual_receiver_type),
                                                    _ then false,
                                                }
                                            },
                                            }
                                        },
                                        .None() then {
                                            let candidate_type = resolve_parameterized_type(mono, substitute_type(mono, candidate.second, substitution))
                                            owner_matches_receiver = when candidate_type in {
                                                .FunctionType(candidate_params, _) then if candidate_params.count() == 0 then false else strict_wrapper_receiver_param_matches(mono, (*candidate_params[0(UInt)]).param_type, actual_receiver_type),
                                                _ then false,
                                            }
                                        },
                                    }
                                    if owner_matches_receiver then {
                                        owner_filtered.push(candidate)
                                    }
                                }
                                break if owner_filtered.is_empty() then when original_method_name in {
                                    .Some(_) then owner_filtered,
                                    .None() then filtered_candidates,
                                } else owner_filtered
                            }
                            let symbol_type_filtered_candidates = if has_generic_parameter(resolve_parameterized_type(mono, identifier.symbol_type)) then {
                                break owner_compatible_candidates
                            } else {
                                let normalized_identifier_type = resolve_parameterized_type(mono, identifier.symbol_type)
                                let mut strict_filtered = List[Pair[DefId, Type]].new()
                                for candidate in owner_compatible_candidates then {
                                    let candidate_type = resolve_parameterized_type(mono, substitute_type(mono, candidate.second, substitution))
                                    if candidate_type == normalized_identifier_type then {
                                        strict_filtered.push(candidate)
                                    }
                                }
                                break if strict_filtered.is_empty() then owner_compatible_candidates else strict_filtered
                            }
                            let mut expected_call_param_types = List[* Type].new()
                            for arg in new_args then {
                                expected_call_param_types.push(box(resolve_parameterized_type(mono, arg.expr_type)))
                            }
                            let expected_call_type = Type.FunctionType(
                                types_to_param_entries(expected_call_param_types),
                                box(substituted_expr_type)
                            )
                            let skip_low_confidence_method_remap = when original_method_name in {
                                .Some(_) then {
                                    let identifier_type = resolve_parameterized_type(mono, identifier.symbol_type)
                                    break has_generic_parameter(expected_call_type) or has_generic_parameter(identifier_type)
                                },
                                .None() then false,
                            }
                            if not skip_low_confidence_method_remap then {
                                let mut matched = Option[Pair[DefId, Type]].None()
                                for candidate in symbol_type_filtered_candidates then {
                                    if substitute_type(mono, candidate.second, substitution) == expected_call_type then {
                                        matched = Option[Pair[DefId, Type]].Some(candidate)
                                        break
                                    }
                                }
                                when matched in {
                                    .None() then {
                                        for candidate in symbol_type_filtered_candidates then {
                                            let candidate_type = substitute_type(mono, candidate.second, substitution)
                                            when candidate_type in {
                                                .FunctionType(candidate_params, candidate_returns) then when expected_call_type in {
                                                    .FunctionType(expected_params, expected_returns) then {
                                                        if candidate_params.count() == expected_params.count()
                                                            and candidate_returns == expected_returns
                                                        then {
                                                            let mut all_match = true
                                                            let mut idx UInt = 0
                                                            while idx < candidate_params.count() then {
                                                                if (*candidate_params[idx]).param_type <> (*expected_params[idx]).param_type then {
                                                                    all_match = false
                                                                }
                                                                idx += 1
                                                            }
                                                            if all_match then {
                                                                matched = Option[Pair[DefId, Type]].Some(candidate)
                                                                break
                                                            }
                                                        }
                                                    },
                                                    _ then {},
                                                },
                                                _ then {},
                                            }
                                        }
                                    },
                                    .Some(_) then {},
                                }
                                when matched in {
                                    .Some(candidate) then {
                                        new_callee = box(TypedExpr(
                                            box(TypedExprKind.Variable(box(Symbol(candidate.first, substitute_type(mono, candidate.second, substitution), identifier.kind)))),
                                            substitute_type(mono, candidate.second, substitution)
                                        ))
                                    },
                                    .None() then {},
                                }
                            }
                        },
                        .None() then {},
                    },
                    _ then {},
                },
                _ then {},
            }
            when new_callee.expr_kind in {
                .TraitMethodPlaceholder(base, trait_type, method, method_type_args, dispatch_callsite) then {
                    let lookup_base_type = substitution_method_lookup_base_type(mono, base)
                    let base_is_trait_object = when lookup_base_type in {
                        .TraitObject(_, _) then true,
                        _ then false,
                    }
                    if not base_is_trait_object and not has_generic_parameter(lookup_base_type) then {
                        let method_name = substitution_semantic_method_name(mono, *method)
                        let mut resolved_method_type_args_ref = List[* Type].new()
                        for method_type_arg in method_type_args then {
                            resolved_method_type_args_ref.push(box(resolve_parameterized_type(mono, method_type_arg)))
                        }
                        instantiate_trait_placeholder_method(mono, lookup_base_type, method_name, resolved_method_type_args_ref)
                        let mut expected_call_param_types = List[* Type].new()
                        expected_call_param_types.push(box(lookup_base_type))
                        for arg in new_args then {
                            expected_call_param_types.push(box(resolve_parameterized_type(mono, arg.expr_type)))
                        }
                        let expected_call_type = Type.FunctionType(
                            types_to_param_entries(expected_call_param_types),
                            box(substituted_expr_type)
                        )
                        let rebound_method = bind_receiver_method_symbol_for_expected_type(
                            mono,
                            lookup_base_type,
                            *method,
                            expected_call_type,
                        )
                        let rebound_owner_matches_lookup_base = when mono.concrete_callable_info(rebound_method.def_id) in {
                            .Some(info) then when info.owner_type in {
                                .Some(owner_type) then {
                                    let owner_key = layout_key(resolve_parameterized_type(mono, owner_type))
                                    let lookup_key = layout_key(resolve_parameterized_type(mono, lookup_base_type))
                                    if owner_key == lookup_key then {
                                        break true
                                    }
                                    break when resolve_parameterized_type(mono, lookup_base_type) in {
                                        .ReferenceType(inner) then owner_key == layout_key(resolve_parameterized_type(mono, *inner)),
                                        .MutableReferenceType(inner) then owner_key == layout_key(resolve_parameterized_type(mono, *inner)),
                                        .BorrowedReferenceType(inner) then owner_key == layout_key(resolve_parameterized_type(mono, *inner)),
                                        .MutableBorrowedReferenceType(inner) then owner_key == layout_key(resolve_parameterized_type(mono, *inner)),
                                        .WeakReferenceType(inner) then owner_key == layout_key(resolve_parameterized_type(mono, *inner)),
                                        .MutableWeakReferenceType(inner) then owner_key == layout_key(resolve_parameterized_type(mono, *inner)),
                                        _ then false,
                                    }
                                },
                                .None() then false,
                            },
                            .None() then false,
                        }
                        let strict_eq_ord_owner_gate = method_name == "equals" or method_name == "compare"
                        let allow_placeholder_rebind = if strict_eq_ord_owner_gate then rebound_owner_matches_lookup_base else true
                        if allow_placeholder_rebind and rebound_method.def_id.id > 0 and (
                            rebound_method.def_id.id <> method.def_id.id
                            or not has_generic_parameter(resolve_parameterized_type(mono, rebound_method.symbol_type))
                        ) then {
                            let adjusted_base = align_method_reference_base_for_bound_method(mono, base, rebound_method)
                            new_callee = box(TypedExpr(
                                box(TypedExprKind.MethodReference(adjusted_base, adjusted_base.expr_type, box(rebound_method), List[Type].new(), method_type_args, dispatch_callsite)),
                                rebound_method.symbol_type,
                            ))
                        }
                    }
                },
                _ then {},
            }
            when new_callee.expr_kind in {
                .TraitMethodPlaceholder(base, trait_type, method, _, _) then {
                    let mut trait_object_type_opt Option[Type] = Option[Type].None()
                    let base_type = resolve_parameterized_type(mono, base.expr_type)
                    when base_type in {
                        .TraitObject(trait_name, trait_type_args) then {
                            trait_object_type_opt = Option[Type].Some(Type.TraitObject(trait_name, trait_type_args))
                        },
                        .ReferenceType(inner_ref) then when resolve_parameterized_type(mono, *inner_ref) in {
                            .TraitObject(trait_name, trait_type_args) then {
                                trait_object_type_opt = Option[Type].Some(Type.TraitObject(trait_name, trait_type_args))
                            },
                            _ then {},
                        },
                        .MutableReferenceType(inner_ref) then when resolve_parameterized_type(mono, *inner_ref) in {
                            .TraitObject(trait_name, trait_type_args) then {
                                trait_object_type_opt = Option[Type].Some(Type.TraitObject(trait_name, trait_type_args))
                            },
                            _ then {},
                        },
                        _ then {},
                    }
                    when trait_object_type_opt in {
                        .Some(trait_object_type) then when trait_object_type in {
                            .TraitObject(trait_name, _) then {
                                let method_name = substitution_semantic_method_name(mono, *method)
                                let method_index = substitution_vtable_method_index(mono, trait_name, method_name)
                                if method_index >= 0 then {
                                    let receiver = when base.expr_kind in {
                                        .DerefExpr(inner) then when resolve_parameterized_type(mono, inner.expr_type) in {
                                            .ReferenceType(ref_inner) then when resolve_parameterized_type(mono, *ref_inner) in {
                                                .TraitObject(_, _) then inner,
                                                _ then base,
                                            },
                                            .MutableReferenceType(ref_inner) then when resolve_parameterized_type(mono, *ref_inner) in {
                                                .TraitObject(_, _) then inner,
                                                _ then base,
                                            },
                                            _ then base,
                                        },
                                        _ then base,
                                    }
                                    return box(TypedExprKind.TraitMethodCall(receiver, trait_object_type, method_name, method_index, new_args))
                                }
                            },
                            _ then {},
                        },
                        .None() then {},
                    }
                },
                _ then {},
            }
            when new_callee.expr_kind in {
                .MethodReference(base, _, method, type_args, method_type_args, dispatch_callsite) then {
                    let base_type = resolve_parameterized_type(mono, base.expr_type)
                    if not has_generic_parameter(base_type) and not substitution_should_preserve_resolved_method_reference(mono, method, base_type) then {
                        let method_name = substitution_semantic_method_name(mono, *method)
                        let mut resolved_method_type_args = List[Type].new()
                        for method_type_arg in method_type_args then {
                            resolved_method_type_args.push(resolve_parameterized_type(mono, method_type_arg))
                        }
                        let expected_method_type = resolve_parameterized_type(mono, method.symbol_type)
                        let mut expected_call_param_types = List[* Type].new()
                        expected_call_param_types.push(box(base_type))
                        for arg in new_args then {
                            expected_call_param_types.push(box(resolve_parameterized_type(mono, arg.expr_type)))
                        }
                        let expected_call_type_with_receiver = Type.FunctionType(
                            types_to_param_entries(expected_call_param_types),
                            box(substituted_expr_type)
                        )
                        let mut expected_call_arg_types = List[* Type].new()
                        for arg in new_args then {
                            expected_call_arg_types.push(box(resolve_parameterized_type(mono, arg.expr_type)))
                        }
                        let expected_call_type_without_receiver = Type.FunctionType(
                            types_to_param_entries(expected_call_arg_types),
                            box(substituted_expr_type)
                        )
                        let preferred_expected_types = if resolved_method_type_args.is_empty() and has_generic_parameter(expected_method_type) then {
                            let mut expected_types = List[Type].new()
                            expected_types.push(expected_call_type_with_receiver)
                            expected_types.push(expected_method_type)
                            expected_types.push(expected_call_type_without_receiver)
                            break expected_types
                        } else {
                            let mut expected_types = List[Type].new()
                            expected_types.push(expected_method_type)
                            expected_types.push(expected_call_type_with_receiver)
                            expected_types.push(expected_call_type_without_receiver)
                            break expected_types
                        }
                        let mut rebound_method = *method
                        for expected_type in preferred_expected_types then {
                            when substitution_lookup_receiver_method_symbol(
                                mono,
                                base_type,
                                *method,
                                Option[Type].Some(expected_type),
                            ) in {
                                .Some(candidate) then {
                                    let candidate_type = resolve_parameterized_type(mono, candidate.symbol_type)
                                    let expected_type_resolved = resolve_parameterized_type(mono, expected_type)
                                    if candidate.def_id.id > 0
                                        and candidate_type == expected_type_resolved
                                        and (candidate.def_id.id <> method.def_id.id or not has_generic_parameter(candidate_type))
                                    then {
                                        rebound_method = candidate
                                        break
                                    }
                                },
                                .None() then {},
                            }
                        }
                        if rebound_method.def_id.id > 0 and rebound_method.def_id.id <> method.def_id.id then {
                            let adjusted_base = align_method_reference_base_for_bound_method(mono, base, rebound_method)
                            new_callee = box(TypedExpr(
                                box(TypedExprKind.MethodReference(adjusted_base, adjusted_base.expr_type, box(rebound_method), type_args, resolved_method_type_args, dispatch_callsite)),
                                rebound_method.symbol_type,
                            ))
                        }
                    }
                },
                _ then {},
            }

            break box(TypedExprKind.Call(new_callee, new_args))
        },
        .GenericCall(function_symbol, type_args, args) then {
            let new_function_symbol = substitute_symbol(mono, function_symbol, substitution)
            let mut new_type_args = List[Type].new()
            for type_arg in type_args then {
                new_type_args.push(mono.substitute_type_impl(type_arg, substitution))
            }
            let mut new_args = List[* TypedExpr].new()
            for arg in args then {
                new_args.push(substitute_types_in_expression(mono, arg, substitution))
            }
            let mut has_unresolved_type_arg = false
            for type_arg in new_type_args then {
                if has_generic_parameter(type_arg) then {
                    has_unresolved_type_arg = true
                }
            }
            if has_unresolved_type_arg then {
                let template = when mono.storage.generic_templates.lookup_function_by_def_id(function_symbol.def_id) in {
                    .Some(found) then Option[* GenericFunctionTemplate].Some(found),
                    .None() then Option[* GenericFunctionTemplate].None(),
                }
                when template in {
                    .Some(found_template) then {
                        let mut inferred = Dict[String, Type].new()
                        let mut i UInt = 0
                        while i < found_template.parameters.count() and i < new_args.count() then {
                            bind_generic_function_type_node(
                                mono,
                                found_template.parameters[i].param_type,
                                resolve_parameterized_type(mono, new_args[i].expr_type),
                                found_template.type_parameters,
                                &mut inferred,
                            )
                            i += 1
                        }

                        let mut boxed_type_args = List[* Type].new()
                        for type_param in found_template.type_parameters then {
                            let bound = when inferred.get(type_param.name) in {
                                .Some(t) then resolve_parameterized_type(mono, t),
                                .None() then Type.GenericParameter(type_param.name),
                            }
                            if has_generic_parameter(bound) then {
                                break box(TypedExprKind.GenericCall(box(new_function_symbol), new_type_args, new_args))
                            }
                            boxed_type_args.push(box(bound))
                        }

                        let instantiated = mono.instantiate_function_impl(found_template, boxed_type_args)
                        if not instantiated.mangled_name.is_empty() then when mono.storage.instantiated_function_symbols.get(instantiated.mangled_name) in {
                            .Some(instantiated_symbol) then {
                                let callee = box(TypedExpr(
                                    box(TypedExprKind.Variable(box(instantiated_symbol))),
                                    instantiated_symbol.symbol_type
                                ))
                                break box(TypedExprKind.Call(callee, new_args))
                            },
                            .None() then {
                                break box(TypedExprKind.GenericCall(box(new_function_symbol), new_type_args, new_args))
                            },
                        } else {
                            break box(TypedExprKind.GenericCall(box(new_function_symbol), new_type_args, new_args))
                        }
                    },
                    .None() then {
                        break box(TypedExprKind.GenericCall(box(new_function_symbol), new_type_args, new_args))
                    },
                }
            } else {
                let template = when mono.storage.generic_templates.lookup_function_by_def_id(function_symbol.def_id) in {
                    .Some(found) then Option[* GenericFunctionTemplate].Some(found),
                    .None() then Option[* GenericFunctionTemplate].None(),
                }
                when template in {
                    .Some(found_template) then {
                        let mut boxed_type_args = List[* Type].new()
                        for type_arg in new_type_args then {
                            boxed_type_args.push(box(resolve_parameterized_type(mono, type_arg)))
                        }
                        let instantiated = mono.instantiate_function_impl(found_template, boxed_type_args)
                        if not instantiated.mangled_name.is_empty() then when mono.storage.instantiated_function_symbols.get(instantiated.mangled_name) in {
                            .Some(instantiated_symbol) then {
                                let callee = box(TypedExpr(
                                    box(TypedExprKind.Variable(box(instantiated_symbol))),
                                    instantiated_symbol.symbol_type
                                ))
                                break box(TypedExprKind.Call(callee, new_args))
                            },
                            .None() then {
                                break box(TypedExprKind.GenericCall(box(new_function_symbol), new_type_args, new_args))
                            },
                        } else {
                            break box(TypedExprKind.GenericCall(box(new_function_symbol), new_type_args, new_args))
                        }
                    },
                    .None() then {
                        break box(TypedExprKind.GenericCall(box(new_function_symbol), new_type_args, new_args))
                    },
                }
            }
        },

        // MemberPath: substitute base.
        .MemberPath(base, path) then {
            break box(TypedExprKind.MemberPath(substitute_types_in_expression(mono, base, substitution), path))
        },
        .MethodReference(base, receiver_type, method, type_args, method_type_args, dispatch_callsite) then {
            let mut new_base = substitute_types_in_expression(mono, base, substitution)
            let mut new_receiver_type = mono.substitute_type_impl(receiver_type, substitution)
            let mut new_method = substitute_symbol(mono, method, substitution)
            let mut new_type_args = List[Type].new()
            for type_arg in type_args then {
                new_type_args.push(mono.substitute_type_impl(type_arg, substitution))
            }
            let mut new_method_type_args = List[Type].new()
            for method_type_arg in method_type_args then {
                new_method_type_args.push(mono.substitute_type_impl(method_type_arg, substitution))
            }
            let binding_receiver_type = resolve_parameterized_type(mono, new_base.expr_type)
            let lookup_seed_method = Symbol(
                method.def_id,
                normalize_method_symbol_type_for_base(mono, mono.substitute_type_impl(method.symbol_type, substitution), binding_receiver_type),
                method.kind,
            )
            new_method = Symbol(
                new_method.def_id,
                normalize_method_symbol_type_for_base(mono, new_method.symbol_type, binding_receiver_type),
                new_method.kind,
            )
            if not has_generic_parameter(binding_receiver_type) then {
                if substitution_should_preserve_resolved_method_reference(mono, box(new_method), binding_receiver_type) then {
                    new_method = lookup_seed_method
                } else {
                    when substitution_lookup_receiver_method_symbol(
                        mono,
                        binding_receiver_type,
                        lookup_seed_method,
                        Option[Type].Some(substituted_expr_type),
                    ) in {
                        .Some(bound_method) then {
                            new_method = bound_method
                            new_base = align_method_reference_base_for_bound_method(mono, new_base, new_method)
                            new_receiver_type = resolve_parameterized_type(mono, new_base.expr_type)
                        },
                        .None() then {},
                    }
                }
            }
            let trait_object_type_opt = when resolve_parameterized_type(mono, new_base.expr_type) in {
                .TraitObject(trait_name, trait_type_args) then Option[Type].Some(Type.TraitObject(trait_name, trait_type_args)),
                .ReferenceType(inner_ref) then when resolve_parameterized_type(mono, *inner_ref) in {
                    .TraitObject(trait_name, trait_type_args) then Option[Type].Some(Type.TraitObject(trait_name, trait_type_args)),
                    _ then Option[Type].None(),
                },
                .MutableReferenceType(inner_ref) then when resolve_parameterized_type(mono, *inner_ref) in {
                    .TraitObject(trait_name, trait_type_args) then Option[Type].Some(Type.TraitObject(trait_name, trait_type_args)),
                    _ then Option[Type].None(),
                },
                _ then Option[Type].None(),
            }
            when trait_object_type_opt in {
                .Some(trait_object_type) then {
                    break box(TypedExprKind.TraitMethodPlaceholder(new_base, trait_object_type, box(new_method), new_method_type_args, dispatch_callsite))
                },
                .None() then {},
            }
            break box(TypedExprKind.MethodReference(new_base, new_receiver_type, box(new_method), new_type_args, new_method_type_args, dispatch_callsite))
        },

        // Block: substitute all statements.
        .Block(statements) then {
            let mut new_stmts = List[* TypedStatement].new()
            for stmt_ref in statements then {
                new_stmts.push(box(substitute_statement(mono, stmt_ref, substitution)))
            }
            break box(TypedExprKind.Block(new_stmts))
        },

        // IfExpr: substitute condition, then-branch, and optional else-branch.
        .IfExpr(condition, then_branch, else_branch) then {
            let new_cond = substitute_types_in_expression(mono, condition, substitution)
            let new_then = substitute_types_in_expression(mono, then_branch, substitution)
            let new_else = when else_branch in {
                .Some(e) then {
                    break Option[* TypedExpr].Some(substitute_types_in_expression(mono, e, substitution))
                },
                .None() then Option[* TypedExpr].None(),
            }
            break box(TypedExprKind.IfExpr(new_cond, new_then, new_else))
        },

        // WhenExpr: substitute subject and all arms.
        .WhenExpr(subject, arms) then {
            let new_subject = substitute_types_in_expression(mono, subject, substitution)
            let mut new_arms = List[* TypedWhenArm].new()
            for arm_ref in arms then {
                let new_pattern  = substitute_pattern(mono, arm_ref.pattern, substitution)
                let new_body     = substitute_types_in_expression(mono, arm_ref.body, substitution)
                let new_arm_type = mono.substitute_type_impl(arm_ref.arm_type, substitution)
                new_arms.push(box(TypedWhenArm(box(new_pattern), new_body, new_arm_type)))
            }
            break box(TypedExprKind.WhenExpr(new_subject, new_arms))
        },

        // LambdaExpr: substitute param types, return type, and body.
        .LambdaExpr(params, return_type, body) then {
            let mut new_params = List[TypedParam].new()
            for p in params then {
                let new_pt = mono.substitute_type_impl(p.param_type, substitution)
                new_params.push(TypedParam(p.name, p.mutable, new_pt, p.named))
            }
            let new_return = mono.substitute_type_impl(return_type, substitution)
            let new_body   = substitute_types_in_expression(mono, body, substitution)
            break box(TypedExprKind.LambdaExpr(new_params, new_return, new_body))
        },

        // StaticMethodCall: substitute all args.
        .StaticMethodCall(receiver_type, method_name, method, type_args, method_type_args, args) then {
            let new_receiver_type = mono.substitute_type_impl(receiver_type, substitution)
            let mut method_after_subst = substitute_symbol(mono, method, substitution)
            let mut new_type_args = List[Type].new()
            for type_arg in type_args then {
                new_type_args.push(mono.substitute_type_impl(type_arg, substitution))
            }
            let mut new_method_type_args = List[Type].new()
            for method_type_arg in method_type_args then {
                new_method_type_args.push(mono.substitute_type_impl(method_type_arg, substitution))
            }
            let mut new_args = List[* TypedExpr].new()
            for arg in args then {
                new_args.push(substitute_types_in_expression(mono, arg, substitution))
            }
            if not has_generic_parameter(new_receiver_type) then {
                method_after_subst = bind_static_method_symbol(mono, new_receiver_type, method_after_subst)
            }
            break box(TypedExprKind.StaticMethodCall(new_receiver_type, method_name, box(method_after_subst), new_type_args, new_method_type_args, new_args))
        },

        .TraitMethodPlaceholder(base, trait_type, method, _, dispatch_callsite) then {
            let new_base = substitute_types_in_expression(mono, base, substitution)
            let mut new_trait_type = mono.substitute_type_impl(trait_type, substitution)
            when trait_type in {
                .TraitObject(original_trait_name, original_type_args) then {
                    let mut substituted_type_args = List[* Type].new()
                    for original_type_arg in original_type_args then {
                        substituted_type_args.push(box(mono.substitute_type_impl(*original_type_arg, substitution)))
                    }
                    new_trait_type = Type.TraitObject(original_trait_name, substituted_type_args)
                },
                _ then {},
            }
            let substituted_method = substitute_symbol(mono, method, substitution)
            let new_method = Symbol(substituted_method.def_id, substituted_method.symbol_type, substituted_method.kind)
            break box(TypedExprKind.TraitMethodPlaceholder(new_base, new_trait_type, box(new_method), List[Type].new(), dispatch_callsite))
        },

        .TraitMethodCall(receiver, trait_type, method_name, method_index, args) then {
            let new_receiver = substitute_types_in_expression(mono, receiver, substitution)
            let mut new_trait_type = mono.substitute_type_impl(trait_type, substitution)
            when trait_type in {
                .TraitObject(original_trait_name, original_type_args) then {
                    let mut substituted_type_args = List[* Type].new()
                    for original_type_arg in original_type_args then {
                        substituted_type_args.push(box(mono.substitute_type_impl(*original_type_arg, substitution)))
                    }
                    new_trait_type = Type.TraitObject(original_trait_name, substituted_type_args)
                },
                _ then {},
            }
            let mut new_args = List[* TypedExpr].new()
            for arg in args then {
                new_args.push(substitute_types_in_expression(mono, arg, substitution))
            }
            break box(TypedExprKind.TraitMethodCall(new_receiver, new_trait_type, method_name, method_index, new_args))
        },

        .IntrinsicCall(node) then {
            let new_node = when node in {
                .IsUniqueMutable(ref_expr) then TypedIntrinsic.IsUniqueMutable(substitute_types_in_expression(mono, ref_expr, substitution)),
                .RefCount(ref_expr) then TypedIntrinsic.RefCount(substitute_types_in_expression(mono, ref_expr, substitution)),
                .MakeRef(pointer_expr, owner_expr, result_type) then TypedIntrinsic.MakeRef(substitute_types_in_expression(mono, pointer_expr, substitution), substitute_types_in_expression(mono, owner_expr, substitution), mono.substitute_type_impl(result_type, substitution)),
                .MakeMutRef(pointer_expr, owner_expr, result_type) then TypedIntrinsic.MakeMutRef(substitute_types_in_expression(mono, pointer_expr, substitution), substitute_types_in_expression(mono, owner_expr, substitution), mono.substitute_type_impl(result_type, substitution)),
                .DowngradeRef(ref_expr, result_type) then TypedIntrinsic.DowngradeRef(substitute_types_in_expression(mono, ref_expr, substitution), mono.substitute_type_impl(result_type, substitution)),
                .DowngradeMutRef(ref_expr, result_type) then TypedIntrinsic.DowngradeMutRef(substitute_types_in_expression(mono, ref_expr, substitution), mono.substitute_type_impl(result_type, substitution)),
                .UpgradeRef(weak_expr, result_type) then TypedIntrinsic.UpgradeRef(substitute_types_in_expression(mono, weak_expr, substitution), mono.substitute_type_impl(result_type, substitution)),
                .UpgradeMutRef(weak_expr, result_type) then TypedIntrinsic.UpgradeMutRef(substitute_types_in_expression(mono, weak_expr, substitution), mono.substitute_type_impl(result_type, substitution)),
                .SpawnThread(out_handle, out_tid, closure, stack_size) then TypedIntrinsic.SpawnThread(substitute_types_in_expression(mono, out_handle, substitution), substitute_types_in_expression(mono, out_tid, substitution), substitute_types_in_expression(mono, closure, substitution), substitute_types_in_expression(mono, stack_size, substitution)),
                .AllocMemory(count, result_type) then TypedIntrinsic.AllocMemory(substitute_types_in_expression(mono, count, substitution), mono.substitute_type_impl(result_type, substitution)),
                .DeallocMemory(pointer_expr) then TypedIntrinsic.DeallocMemory(substitute_types_in_expression(mono, pointer_expr, substitution)),
                .CopyMemory(dest, source, count) then TypedIntrinsic.CopyMemory(substitute_types_in_expression(mono, dest, substitution), substitute_types_in_expression(mono, source, substitution), substitute_types_in_expression(mono, count, substitution)),
                .MoveMemory(dest, source, count) then TypedIntrinsic.MoveMemory(substitute_types_in_expression(mono, dest, substitution), substitute_types_in_expression(mono, source, substitution), substitute_types_in_expression(mono, count, substitution)),
                .InitMemory(pointer_expr, value_expr) then TypedIntrinsic.InitMemory(substitute_types_in_expression(mono, pointer_expr, substitution), substitute_types_in_expression(mono, value_expr, substitution)),
                .DeinitMemory(pointer_expr) then TypedIntrinsic.DeinitMemory(substitute_types_in_expression(mono, pointer_expr, substitution)),
                .TakeMemory(pointer_expr, result_type) then TypedIntrinsic.TakeMemory(substitute_types_in_expression(mono, pointer_expr, substitution), mono.substitute_type_impl(result_type, substitution)),
                .NullPtr(result_type) then TypedIntrinsic.NullPtr(mono.substitute_type_impl(result_type, substitution)),
            }
            break box(TypedExprKind.IntrinsicCall(new_node))
        },

        // GenericInstantiation: substitute each type arg.
        .GenericInstantiation(base_type, type_args) then {
            let new_base_type = mono.substitute_type_impl(base_type, substitution)
            let mut new_type_args = List[Type].new()
            for ta in type_args then {
                new_type_args.push(mono.substitute_type_impl(ta, substitution))
            }
            break box(TypedExprKind.GenericInstantiation(new_base_type, new_type_args))
        },
        .TypeConstruction(identifier, type_args, args) then {
            let substituted_identifier_type = resolve_parameterized_type(
                mono,
                mono.substitute_type_impl(identifier.symbol_type, substitution),
            )
            let mut new_type_args = List[Type].new()
            for ta in type_args then {
                new_type_args.push(mono.substitute_type_impl(ta, substitution))
            }
            let mut new_args = List[* TypedExpr].new()
            for arg in args then {
                new_args.push(substitute_types_in_expression(mono, arg, substitution))
            }
            let new_identifier = Symbol(identifier.def_id, substituted_identifier_type, identifier.kind)
            break box(TypedExprKind.TypeConstruction(box(new_identifier), new_type_args, new_args))
        },
        .EnumConstruction(enum_type, case_name, args) then {
            let mut new_args = List[* TypedExpr].new()
            for arg in args then {
                new_args.push(substitute_types_in_expression(mono, arg, substitution))
            }
            break box(TypedExprKind.EnumConstruction(mono.substitute_type_impl(enum_type, substitution), case_name, new_args))
        },
    }
}

// ── substitute_symbol ─────────────────────────────────────────────────────────

// Substitute the type in a Symbol and remap its DefId if it was a generic
// function that has been instantiated.
private let substitute_symbol(
    mono * Monomorphizer,
    symbol * Symbol,
    substitution Dict[String, Type],
) Symbol = {
    let substituted_type = mono.substitute_type_impl(symbol.symbol_type, substitution)
    let new_type = resolve_parameterized_type(mono, substituted_type)
    let has_symbol_metadata = mono.storage.context.get_module_path(symbol.def_id) is .Some(_)
        or mono.storage.context.get_source_file(symbol.def_id) is .Some(_)
    let remapped_def_id = remapped_function_def_id_for_type(mono, symbol, new_type, has_symbol_metadata)
    return Symbol(remapped_def_id, new_type, symbol.kind)
}

private let remapped_function_def_id_for_type(
    mono * Monomorphizer,
    symbol * Symbol,
    resolved_type Type,
    allow_function_shape_fallback Bool,
) DefId = {
    if symbol.kind is not .Function() then {
        return symbol.def_id
    }

    let dispatch_method_name_opt = when mono.receiver_method_dispatch_info(symbol.def_id) in {
        .Some(info) then Option[String].Some(info.method_name),
        .None() then Option[String].None(),
    }
    let source_dispatch_owner_opt = when mono.receiver_method_dispatch_info(symbol.def_id) in {
        .Some(info) then info.owner,
        .None() then Option[ReceiverMethodOwner].None(),
    }
    let source_owner_type_opt = when mono.concrete_callable_info(symbol.def_id) in {
        .Some(info) then info.owner_type,
        .None() then Option[Type].None(),
    }
    let mut had_candidates = false
    when mono.storage.remapped_function_def_ids.get(symbol.def_id.id) in {
        .Some(candidates) then {
            had_candidates = not candidates.is_empty()
            let normalized_type = resolve_parameterized_type(mono, resolved_type)
            let mut compatible_candidates = List[Pair[DefId, Type]].new()
            for candidate in candidates then {
                let candidate_type = resolve_parameterized_type(mono, candidate.second)
                if candidate_type <> normalized_type then {
                    continue
                }
                let name_compatible = when dispatch_method_name_opt in {
                    .Some(dispatch_method_name) then when mono.receiver_method_dispatch_info(candidate.first) in {
                        .Some(candidate_info) then candidate_info.method_name == dispatch_method_name,
                        .None() then false,
                    },
                    .None() then true,
                }
                let owner_compatible = when source_dispatch_owner_opt in {
                    .Some(source_owner) then when mono.receiver_method_dispatch_info(candidate.first) in {
                        .Some(candidate_info) then when candidate_info.owner in {
                            .Some(candidate_owner) then when source_owner in {
                                .ConcreteType(source_name) then when candidate_owner in {
                                    .ConcreteType(candidate_name) then candidate_name == source_name,
                                    _ then false,
                                },
                                .ExtensionTemplate(source_name) then when candidate_owner in {
                                    .ExtensionTemplate(candidate_name) then candidate_name == source_name,
                                    _ then false,
                                },
                            },
                            .None() then false,
                        },
                        .None() then false,
                    },
                    .None() then when source_owner_type_opt in {
                        .Some(source_owner_type) then {
                            let source_owner_key = layout_key(resolve_parameterized_type(mono, source_owner_type))
                            break when mono.concrete_callable_info(candidate.first) in {
                                .Some(candidate_info) then when candidate_info.owner_type in {
                                    .Some(candidate_owner_type) then layout_key(resolve_parameterized_type(mono, candidate_owner_type)) == source_owner_key,
                                    .None() then false,
                                },
                                .None() then false,
                            }
                        },
                        .None() then true,
                    },
                }
                if name_compatible and owner_compatible then {
                    compatible_candidates.push(candidate)
                }
            }
            if compatible_candidates.count() == 1(UInt) then {
                return compatible_candidates[0(UInt)].first
            }

            for candidate in compatible_candidates then {
                if resolve_parameterized_type(mono, candidate.second) == normalized_type then {
                    return candidate.first
                }
            }
        },
        .None() then {},
    }

    if had_candidates then {
        return symbol.def_id
    }

    let allow_shape_fallback_for_symbol = allow_function_shape_fallback and dispatch_method_name_opt is .None()
    if allow_shape_fallback_for_symbol then {
        let symbol_name = mono.storage.context.symbol_name(*symbol)
        let template_name = mono.storage.context.get_template_name(symbol.def_id) or else symbol_name
        let lookup_names = if template_name.is_empty() then {
            break List[String].new()
        } else {
            let mut names = List[String].new()
            names.push(template_name)
            when template_name.find("_") in {
                .Some(underscore_idx) then {
                    let suffix = template_name.substring(underscore_idx + 1..)
                    if not suffix.is_empty() then {
                        names.push(suffix)
                    }
                },
                .None() then {},
            }
            break names
        }
        for candidate_name in lookup_names then {
            let template_lookup = when mono.storage.generic_templates.resolve_function_name(candidate_name) in {
                .Some(resolved_name) then mono.storage.generic_templates.lookup_function(resolved_name),
                .None() then Option[* GenericFunctionTemplate].None(),
            }
            when template_lookup in {
                .Some(template) then {
                    if template.type_parameters.is_empty() then {
                        let concrete_type = resolve_parameterized_type(mono, resolved_type)
                        when mono.storage.context.get_function_type(template.def_id) in {
                            .Some(template_type) then {
                                if resolve_parameterized_type(mono, template_type) == concrete_type then {
                                    return template.def_id
                                }
                            },
                            .None() then {},
                        }
                        continue
                    }

                    let concrete_type = resolve_parameterized_type(mono, resolved_type)
                    when concrete_type in {
                        .FunctionType(fn_params, return_type) then {
                            let mut inferred = Dict[String, Type].new()
                            let param_types = param_entry_types(fn_params)
                            let mut i UInt = 0
                            while i < template.parameters.count() and i < param_types.count() then {
                                bind_generic_function_type_node(mono, template.parameters[i].param_type, (*param_types[i]), template.type_parameters, &mut inferred)
                                i += 1
                            }
                            bind_generic_function_type_node(mono, template.return_type, *return_type, template.type_parameters, &mut inferred)

                            let mut boxed_type_args = List[* Type].new()
                            for type_param in template.type_parameters then {
                                let bound = inferred.get(type_param.name) or else Type.GenericParameter(type_param.name)
                                if has_generic_parameter(bound) then {
                                    return symbol.def_id
                                }
                                boxed_type_args.push(box(bound))
                            }

                            let instantiated = mono.instantiate_function_impl(template, boxed_type_args)
                            if not instantiated.mangled_name.is_empty() then when mono.storage.instantiated_function_symbols.get(instantiated.mangled_name) in {
                                .Some(instantiated_symbol) then {
                                    return instantiated_symbol.def_id
                                },
                                .None() then {},
                            }
                        },
                        _ then {},
                    }
                },
                .None() then {},
            }
        }
    }

    return symbol.def_id
}

private let bind_generic_function_type_node(
    mono * Monomorphizer,
    expected_node TypeNode,
    actual Type,
    type_params List[TypeParameterDecl],
    bindings *mut Dict[String, Type],
) Void = {
    when expected_node in {
        .Identifier(name) then {
            if is_type_parameter_name(name, type_params) then {
                when bindings.get(name) in {
                    .Some(existing) then {
                        if is_placeholder_inferred_type(existing) and not is_placeholder_inferred_type(actual) then {
                            bindings.insert(name, actual)
                        }
                    },
                    .None() then {
                        bindings.insert(name, actual)
                    },
                }
            }
        },
        .Reference(inner, _) then when actual in {
            .ReferenceType(act_inner) then bind_generic_function_type_node(mono, *inner, *act_inner, type_params, bindings),
            .MutableReferenceType(act_inner) then bind_generic_function_type_node(mono, *inner, *act_inner, type_params, bindings),
            _ then {},
        },
        .BorrowedReference(inner, _) then when actual in {
            .BorrowedReferenceType(act_inner) then bind_generic_function_type_node(mono, *inner, *act_inner, type_params, bindings),
            .MutableBorrowedReferenceType(act_inner) then bind_generic_function_type_node(mono, *inner, *act_inner, type_params, bindings),
            _ then {},
        },
        .Pointer(inner, _) then when actual in {
            .PointerType(act_inner) then bind_generic_function_type_node(mono, *inner, *act_inner, type_params, bindings),
            .MutablePointerType(act_inner) then bind_generic_function_type_node(mono, *inner, *act_inner, type_params, bindings),
            _ then {},
        },
        .WeakReference(inner, _) then when actual in {
            .WeakReferenceType(act_inner) then bind_generic_function_type_node(mono, *inner, *act_inner, type_params, bindings),
            .MutableWeakReferenceType(act_inner) then bind_generic_function_type_node(mono, *inner, *act_inner, type_params, bindings),
            _ then {},
        },
        .Generic(base, args) then when actual in {
            .GenericStruct(act_base, act_args) then {
                if base == act_base then {
                    let mut i UInt = 0
                    while i < args.count() and i < act_args.count() then {
                        bind_generic_function_type_node(mono, (*args[i]), (*act_args[i]), type_params, bindings)
                        i += 1
                    }
                }
            },
            .GenericEnum(act_base, act_args) then {
                if base == act_base then {
                    let mut i UInt = 0
                    while i < args.count() and i < act_args.count() then {
                        bind_generic_function_type_node(mono, (*args[i]), (*act_args[i]), type_params, bindings)
                        i += 1
                    }
                }
            },
            _ then {},
        },
        .FunctionType(param_nodes, ret_node) then when actual in {
            .FunctionType(fn_params, ret_type) then {
                let param_types = param_entry_types(fn_params)
                let mut i UInt = 0
                while i < param_nodes.count() and i < param_types.count() then {
                    bind_generic_function_type_node(mono, (*param_nodes[i]), (*param_types[i]), type_params, bindings)
                    i += 1
                }
                bind_generic_function_type_node(mono, *ret_node, *ret_type, type_params, bindings)
            },
            _ then {},
        },
        _ then {},
    }
}

private let is_type_parameter_name(name String, type_params List[TypeParameterDecl]) Bool = {
    for type_param in type_params then {
        if type_param.name == name then {
            return true
        }
    }
    return false
}

private let static_method_receiver_key(t Type) String = {
    return when t in {
        .ReferenceType(inner) then static_method_receiver_key(*inner),
        .MutableReferenceType(inner) then static_method_receiver_key(*inner),
        .WeakReferenceType(inner) then static_method_receiver_key(*inner),
        .MutableWeakReferenceType(inner) then static_method_receiver_key(*inner),
        .PointerType(inner) then static_method_receiver_key(*inner),
        .MutablePointerType(inner) then static_method_receiver_key(*inner),
        _ then layout_key(t),
    }
}

private let push_static_method_receiver_alias(alias_list List[String], alias String) List[String] = {
    if alias.is_empty() then { return alias_list }
    for existing in alias_list then {
        if existing == alias then { return alias_list }
    }
    let mut updated = alias_list
    updated.push(alias)
    return updated
}

private let strict_wrapper_receiver_aliases(t Type) List[String] = {
    let mut aliases = List[String].new()
    when t in {
        .ReferenceType(_) then {
            aliases = push_static_method_receiver_alias(aliases, "Ref")
        },
        .MutableReferenceType(_) then {
            aliases = push_static_method_receiver_alias(aliases, "MutRef")
            aliases = push_static_method_receiver_alias(aliases, "Ref")
        },
        .BorrowedReferenceType(_) then {
            aliases = push_static_method_receiver_alias(aliases, "BorrowRef")
            aliases = push_static_method_receiver_alias(aliases, "Ref")
        },
        .MutableBorrowedReferenceType(_) then {
            aliases = push_static_method_receiver_alias(aliases, "BorrowMutRef")
            aliases = push_static_method_receiver_alias(aliases, "MutRef")
            aliases = push_static_method_receiver_alias(aliases, "BorrowRef")
            aliases = push_static_method_receiver_alias(aliases, "Ref")
        },
        .WeakReferenceType(_) then {
            aliases = push_static_method_receiver_alias(aliases, "WeakRef")
        },
        .MutableWeakReferenceType(_) then {
            aliases = push_static_method_receiver_alias(aliases, "MutWeakRef")
            aliases = push_static_method_receiver_alias(aliases, "WeakRef")
        },
        .PointerType(_) then {
            aliases = push_static_method_receiver_alias(aliases, "Ptr")
        },
        .MutablePointerType(_) then {
            aliases = push_static_method_receiver_alias(aliases, "MutPtr")
            aliases = push_static_method_receiver_alias(aliases, "Ptr")
        },
        _ then {},
    }
    return aliases
}

private let static_method_receiver_aliases(mono * Monomorphizer, t Type) List[String] = {
    let mut aliases = List[String].new()
    aliases = push_static_method_receiver_alias(aliases, static_method_receiver_key(t))

    when t in {
        .ReferenceType(inner) then {
            for alias in static_method_receiver_aliases(mono, *inner) then {
                aliases = push_static_method_receiver_alias(aliases, alias)
            }
        },
        .MutableReferenceType(inner) then {
            for alias in static_method_receiver_aliases(mono, *inner) then {
                aliases = push_static_method_receiver_alias(aliases, alias)
            }
        },
        .WeakReferenceType(inner) then {
            for alias in static_method_receiver_aliases(mono, *inner) then {
                aliases = push_static_method_receiver_alias(aliases, alias)
            }
        },
        .MutableWeakReferenceType(inner) then {
            for alias in static_method_receiver_aliases(mono, *inner) then {
                aliases = push_static_method_receiver_alias(aliases, alias)
            }
        },
        .PointerType(inner) then {
            for alias in static_method_receiver_aliases(mono, *inner) then {
                aliases = push_static_method_receiver_alias(aliases, alias)
            }
        },
        .MutablePointerType(inner) then {
            for alias in static_method_receiver_aliases(mono, *inner) then {
                aliases = push_static_method_receiver_alias(aliases, alias)
            }
        },
        .GenericStruct(template, _) then {
            aliases = push_static_method_receiver_alias(aliases, template)
        },
        .GenericEnum(template, _) then {
            aliases = push_static_method_receiver_alias(aliases, template)
        },
        .StructureType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(name) then {
                    aliases = push_static_method_receiver_alias(aliases, name)
                    when mono.storage.layout_to_template_info.get(name) in {
                        .Some(info) then {
                            aliases = push_static_method_receiver_alias(aliases, info.base_name)
                        },
                        .None() then {},
                    }
                },
                .None() then {},
            }
        },
        .EnumType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(name) then {
                    aliases = push_static_method_receiver_alias(aliases, name)
                    when mono.storage.layout_to_template_info.get(name) in {
                        .Some(info) then {
                            aliases = push_static_method_receiver_alias(aliases, info.base_name)
                        },
                        .None() then {},
                    }
                },
                .None() then {},
            }
        },
        _ then {},
    }

    return aliases
}

private let receiver_uses_strict_wrapper_dispatch(
    mono * Monomorphizer,
    t Type,
) Bool = {
    return when resolve_parameterized_type(mono, t) in {
        .ReferenceType(_) then true,
        .MutableReferenceType(_) then true,
        .BorrowedReferenceType(_) then true,
        .MutableBorrowedReferenceType(_) then true,
        .WeakReferenceType(_) then true,
        .MutableWeakReferenceType(_) then true,
        .PointerType(_) then true,
        .MutablePointerType(_) then true,
        _ then false,
    }
}

private let bind_static_method_symbol(
    mono * Monomorphizer,
    receiver_type Type,
    method Symbol,
) Symbol = {
    let receiver_aliases = static_method_receiver_aliases(mono, receiver_type)
    for receiver_key in receiver_aliases then {
        let lookup_key = "\(receiver_key).\(mono.storage.context.symbol_name(method))"
        when mono.storage.extension_method_def_ids.get(lookup_key) in {
            .Some(def_id) then {
                let bound_symbol_type = when mono.storage.context.get_function_type(def_id) in {
                    .Some(function_type) then function_type,
                    .None() then method.symbol_type,
                }
                return Symbol(def_id, bound_symbol_type, method.kind)
            },
            .None() then {},
        }
    }

    let method_name = mono.storage.context.symbol_name(method)
    instantiate_trait_placeholder_method(mono, receiver_type, method_name, List[* Type].new())

    let instantiated_aliases = static_method_receiver_aliases(mono, receiver_type)
    for receiver_key in instantiated_aliases then {
        let lookup_key = "\(receiver_key).\(method_name)"
        when mono.storage.extension_method_def_ids.get(lookup_key) in {
            .Some(def_id) then {
                let bound_symbol_type = when mono.storage.context.get_function_type(def_id) in {
                    .Some(function_type) then function_type,
                    .None() then method.symbol_type,
                }
                return Symbol(def_id, bound_symbol_type, method.kind)
            },
            .None() then {},
        }
    }

    return method
}

private let method_type_matches_expected_pattern(
    mono * Monomorphizer,
    actual Type,
    expected Type,
) Bool = {
    let normalized_actual = resolve_parameterized_type(mono, actual)
    let normalized_expected = resolve_parameterized_type(mono, expected)
    if layout_key(normalized_actual) == layout_key(normalized_expected) then {
        return true
    }
    return when normalized_expected in {
        .GenericParameter(_) then true,
        .ReferenceType(expected_inner) then when normalized_actual in {
            .ReferenceType(actual_inner) then method_type_matches_expected_pattern(mono, *actual_inner, *expected_inner),
            .MutableReferenceType(actual_inner) then method_type_matches_expected_pattern(mono, *actual_inner, *expected_inner),
            _ then false,
        },
        .WeakReferenceType(expected_inner) then when normalized_actual in {
            .WeakReferenceType(actual_inner) then method_type_matches_expected_pattern(mono, *actual_inner, *expected_inner),
            .MutableWeakReferenceType(actual_inner) then method_type_matches_expected_pattern(mono, *actual_inner, *expected_inner),
            _ then false,
        },
        .MutableWeakReferenceType(expected_inner) then when normalized_actual in {
            .MutableWeakReferenceType(actual_inner) then method_type_matches_expected_pattern(mono, *actual_inner, *expected_inner),
            _ then false,
        },
        .PointerType(expected_inner) then when normalized_actual in {
            .PointerType(actual_inner) then method_type_matches_expected_pattern(mono, *actual_inner, *expected_inner),
            .MutablePointerType(actual_inner) then method_type_matches_expected_pattern(mono, *actual_inner, *expected_inner),
            _ then false,
        },
        .FunctionType(expected_params, expected_return) then when normalized_actual in {
            .FunctionType(actual_params, actual_return) then {
                if actual_params.count() <> expected_params.count() then {
                    return false
                }
                let mut idx UInt = 0
                while idx < actual_params.count() then {
                    if not method_type_matches_expected_pattern(mono, (*actual_params[idx]).param_type, (*expected_params[idx]).param_type) then {
                        return false
                    }
                    idx += 1
                }
                return method_type_matches_expected_pattern(mono, *actual_return, *expected_return)
            },
            _ then false,
        },
        _ then false,
    }
}

private let method_type_matches_expected(
    mono * Monomorphizer,
    candidate Type,
    expected_opt Option[Type],
) Bool = {
    return when expected_opt in {
        .None() then true,
        .Some(expected) then {
            let normalized_candidate = resolve_parameterized_type(mono, candidate)
            let normalized_expected = resolve_parameterized_type(mono, expected)
            if layout_key(normalized_candidate) == layout_key(normalized_expected) then {
                return true
            }
            if not has_generic_parameter(normalized_expected) then {
                return false
            }
            return method_type_matches_expected_pattern(mono, normalized_candidate, normalized_expected)
        },
    }
}

private let method_type_matches_expected_strict(
    mono * Monomorphizer,
    candidate Type,
    expected_opt Option[Type],
) Bool = {
    return when expected_opt in {
        .None() then true,
        .Some(expected) then {
            let normalized_candidate = resolve_parameterized_type(mono, candidate)
            let normalized_expected = resolve_parameterized_type(mono, expected)
            return normalized_candidate == normalized_expected
        },
    }
}

private let strict_wrapper_receiver_param_matches(
    mono * Monomorphizer,
    receiver_param_type Type,
    receiver_type Type,
) Bool = {
    let normalized_param = resolve_parameterized_type(mono, receiver_param_type)
    let normalized_receiver = resolve_parameterized_type(mono, receiver_type)
    if normalized_param == normalized_receiver then {
        return true
    }
    return when normalized_param in {
        .ReferenceType(param_inner) then when normalized_receiver in {
            .ReferenceType(receiver_inner) then resolve_parameterized_type(mono, *param_inner) == resolve_parameterized_type(mono, *receiver_inner),
            .MutableReferenceType(receiver_inner) then resolve_parameterized_type(mono, *param_inner) == resolve_parameterized_type(mono, *receiver_inner),
            _ then false,
        },
        .MutableReferenceType(param_inner) then when normalized_receiver in {
            .MutableReferenceType(receiver_inner) then resolve_parameterized_type(mono, *param_inner) == resolve_parameterized_type(mono, *receiver_inner),
            .MutableBorrowedReferenceType(receiver_inner) then resolve_parameterized_type(mono, *param_inner) == resolve_parameterized_type(mono, *receiver_inner),
            _ then false,
        },
        .BorrowedReferenceType(param_inner) then when normalized_receiver in {
            .BorrowedReferenceType(receiver_inner) then resolve_parameterized_type(mono, *param_inner) == resolve_parameterized_type(mono, *receiver_inner),
            .ReferenceType(receiver_inner) then resolve_parameterized_type(mono, *param_inner) == resolve_parameterized_type(mono, *receiver_inner),
            .MutableBorrowedReferenceType(receiver_inner) then resolve_parameterized_type(mono, *param_inner) == resolve_parameterized_type(mono, *receiver_inner),
            .MutableReferenceType(receiver_inner) then resolve_parameterized_type(mono, *param_inner) == resolve_parameterized_type(mono, *receiver_inner),
            _ then false,
        },
        .MutableBorrowedReferenceType(param_inner) then when normalized_receiver in {
            .MutableBorrowedReferenceType(receiver_inner) then resolve_parameterized_type(mono, *param_inner) == resolve_parameterized_type(mono, *receiver_inner),
            .MutableReferenceType(receiver_inner) then resolve_parameterized_type(mono, *param_inner) == resolve_parameterized_type(mono, *receiver_inner),
            _ then false,
        },
        _ then false,
    }
}

private let wrapper_receiver_param_matches(
    mono * Monomorphizer,
    receiver_param_type Type,
    receiver_type Type,
) Bool = {
    let normalized_param = resolve_parameterized_type(mono, receiver_param_type)
    let normalized_receiver = resolve_parameterized_type(mono, receiver_type)
    if layout_key(normalized_param) == layout_key(normalized_receiver) then {
        return true
    }
    return when normalized_param in {
        .ReferenceType(param_inner) then layout_key(resolve_parameterized_type(mono, *param_inner)) == layout_key(normalized_receiver),
        .MutableReferenceType(param_inner) then layout_key(resolve_parameterized_type(mono, *param_inner)) == layout_key(normalized_receiver),
        .BorrowedReferenceType(param_inner) then when normalized_receiver in {
            .BorrowedReferenceType(receiver_inner) then layout_key(resolve_parameterized_type(mono, *param_inner)) == layout_key(resolve_parameterized_type(mono, *receiver_inner)),
            .ReferenceType(receiver_inner) then layout_key(resolve_parameterized_type(mono, *param_inner)) == layout_key(resolve_parameterized_type(mono, *receiver_inner)),
            .MutableBorrowedReferenceType(receiver_inner) then layout_key(resolve_parameterized_type(mono, *param_inner)) == layout_key(resolve_parameterized_type(mono, *receiver_inner)),
            .MutableReferenceType(receiver_inner) then layout_key(resolve_parameterized_type(mono, *param_inner)) == layout_key(resolve_parameterized_type(mono, *receiver_inner)),
            _ then false,
        },
        .MutableBorrowedReferenceType(param_inner) then when normalized_receiver in {
            .MutableBorrowedReferenceType(receiver_inner) then layout_key(resolve_parameterized_type(mono, *param_inner)) == layout_key(resolve_parameterized_type(mono, *receiver_inner)),
            .MutableReferenceType(receiver_inner) then layout_key(resolve_parameterized_type(mono, *param_inner)) == layout_key(resolve_parameterized_type(mono, *receiver_inner)),
            _ then false,
        },
        _ then false,
    }
}

private let method_type_matches_expected_for_wrapper_receiver(
    mono * Monomorphizer,
    candidate Type,
    expected_opt Option[Type],
    receiver_type Type,
) Bool = {
    let normalized_candidate = resolve_parameterized_type(mono, candidate)
    return when normalized_candidate in {
        .FunctionType(candidate_params, candidate_return) then {
            if candidate_params.count() == 0 then {
                return false
            }
            if not strict_wrapper_receiver_param_matches(mono, (*candidate_params[0(UInt)]).param_type, receiver_type) then {
                return false
            }
            return when expected_opt in {
                .None() then true,
                .Some(expected) then when resolve_parameterized_type(mono, expected) in {
                    .FunctionType(expected_params, expected_return) then {
                        if candidate_params.count() <> expected_params.count() then {
                            return false
                        }
                        let mut idx UInt = 1(UInt)
                        while idx < candidate_params.count() then {
                            let candidate_param_type = resolve_parameterized_type(mono, (*candidate_params[idx]).param_type)
                            let expected_param_type = resolve_parameterized_type(mono, (*expected_params[idx]).param_type)
                            if not method_type_matches_expected_pattern(mono, candidate_param_type, expected_param_type) then {
                                return false
                            }
                            idx += 1(UInt)
                        }
                        return method_type_matches_expected_pattern(mono, *candidate_return, *expected_return)
                    },
                    _ then false,
                },
            }
        },
        _ then when expected_opt in {
            .None() then true,
            .Some(_) then method_type_matches_expected(mono, candidate, expected_opt),
        },
    }
}

private let method_type_matches_expected_for_wrapper_receiver_strict(
    mono * Monomorphizer,
    candidate Type,
    expected_opt Option[Type],
    receiver_type Type,
) Bool = {
    let normalized_candidate = resolve_parameterized_type(mono, candidate)
    return when normalized_candidate in {
        .FunctionType(candidate_params, candidate_return) then {
            if candidate_params.count() == 0 then {
                return false
            }
            if not wrapper_receiver_param_matches(mono, (*candidate_params[0(UInt)]).param_type, receiver_type) then {
                return false
            }
            return when expected_opt in {
                .None() then true,
                .Some(expected) then when resolve_parameterized_type(mono, expected) in {
                    .FunctionType(expected_params, expected_return) then {
                        if candidate_params.count() <> expected_params.count() then {
                            return false
                        }
                        let mut idx UInt = 1(UInt)
                        while idx < candidate_params.count() then {
                            let candidate_param_type = resolve_parameterized_type(mono, (*candidate_params[idx]).param_type)
                            let expected_param_type = resolve_parameterized_type(mono, (*expected_params[idx]).param_type)
                            if candidate_param_type <> expected_param_type then {
                                return false
                            }
                            idx += 1(UInt)
                        }
                        return resolve_parameterized_type(mono, *candidate_return) == resolve_parameterized_type(mono, *expected_return)
                    },
                    _ then false,
                },
            }
        },
        _ then method_type_matches_expected_strict(mono, candidate, expected_opt),
    }
}

private let method_symbol_matches_expected_for_receiver_lookup(
    mono * Monomorphizer,
    receiver_type Type,
    method Symbol,
    expected_method_type_opt Option[Type],
) Bool = {
    let candidate_type = when mono.storage.context.get_function_type(method.def_id) in {
        .Some(function_type) then function_type,
        .None() then method.symbol_type,
    }
    let resolved_receiver_type = resolve_parameterized_type(mono, receiver_type)
    let strict_wrapper_dispatch = receiver_uses_strict_wrapper_dispatch(mono, resolved_receiver_type)
    return if strict_wrapper_dispatch
        then method_type_matches_expected_for_wrapper_receiver_strict(mono, candidate_type, expected_method_type_opt, resolved_receiver_type)
        else method_type_matches_expected_strict(mono, candidate_type, expected_method_type_opt)
}

private let semantic_receiver_method_name(
    mono * Monomorphizer,
    method Symbol,
) String = {
    if method.def_id.id > 0 then {
        when mono.receiver_method_dispatch_info(method.def_id) in {
            .Some(info) then { return info.method_name },
            .None() then {},
        }
        when mono.concrete_callable_info(method.def_id) in {
            .Some(info) then { return info.logical_name },
            .None() then {},
        }
        let symbol_name = mono.storage.context.symbol_name(method)
        if not symbol_name.is_empty() then {
            return symbol_name
        }
        when mono.storage.context.get_name(method.def_id) in {
            .Some(name) then { return name },
            .None() then {},
        }
    }
    return mono.storage.context.symbol_name(method)
}

private let semantic_receiver_method_name_for_def_id(
    mono * Monomorphizer,
    def_id DefId,
    fallback_name String,
) String = {
    when mono.receiver_method_dispatch_info(def_id) in {
        .Some(info) then { return info.method_name },
        .None() then {},
    }
    when mono.concrete_callable_info(def_id) in {
        .Some(info) then {
            if not info.logical_name.is_empty() then {
                return info.logical_name
            }
        },
        .None() then {},
    }
    when mono.storage.context.get_symbol(def_id) in {
        .Some(symbol) then {
            let symbol_name = mono.storage.context.symbol_name(symbol)
            if not symbol_name.is_empty() then {
                return symbol_name
            }
        },
        .None() then {},
    }
    return mono.storage.context.get_name(def_id) or else fallback_name
}

private let lookup_exact_receiver_method_symbol(
    mono * Monomorphizer,
    receiver_type Type,
    method Symbol,
    expected_method_type_opt Option[Type],
) Option[Symbol] = {
    let resolved_receiver_type = resolve_parameterized_type(mono, receiver_type)
    let strict_wrapper_dispatch = receiver_uses_strict_wrapper_dispatch(mono, resolved_receiver_type)
    let nested_ref_like_receiver = when resolved_receiver_type in {
        .ReferenceType(inner) then receiver_uses_strict_wrapper_dispatch(mono, resolve_parameterized_type(mono, *inner)),
        .MutableReferenceType(inner) then receiver_uses_strict_wrapper_dispatch(mono, resolve_parameterized_type(mono, *inner)),
        .BorrowedReferenceType(inner) then receiver_uses_strict_wrapper_dispatch(mono, resolve_parameterized_type(mono, *inner)),
        .MutableBorrowedReferenceType(inner) then receiver_uses_strict_wrapper_dispatch(mono, resolve_parameterized_type(mono, *inner)),
        .WeakReferenceType(inner) then receiver_uses_strict_wrapper_dispatch(mono, resolve_parameterized_type(mono, *inner)),
        .MutableWeakReferenceType(inner) then receiver_uses_strict_wrapper_dispatch(mono, resolve_parameterized_type(mono, *inner)),
        .PointerType(inner) then receiver_uses_strict_wrapper_dispatch(mono, resolve_parameterized_type(mono, *inner)),
        .MutablePointerType(inner) then receiver_uses_strict_wrapper_dispatch(mono, resolve_parameterized_type(mono, *inner)),
        _ then false,
    }
    let method_name = semantic_receiver_method_name(mono, method)
    let direct_lookup_key = "\(layout_key(resolved_receiver_type)).\(method_name)"
    if strict_wrapper_dispatch then {
        for receiver_alias in strict_wrapper_receiver_aliases(resolved_receiver_type) then {
            let alias_lookup_key = "\(receiver_alias).\(method_name)"
            when mono.storage.extension_method_def_ids.get(alias_lookup_key) in {
                .Some(def_id) then {
                    if nested_ref_like_receiver and method.def_id.id > 0 and def_id.id == method.def_id.id then {
                        continue
                    }
                    let owner_matches_receiver = when mono.concrete_callable_info(def_id) in {
                        .Some(info) then when info.owner_type in {
                            .Some(owner_type) then {
                                let resolved_owner_type = resolve_parameterized_type(mono, owner_type)
                                break if layout_key(resolved_owner_type) == layout_key(resolved_receiver_type) then {
                                    break true
                                } else when resolved_receiver_type in {
                                    .ReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    .MutableReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    .BorrowedReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    .MutableBorrowedReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    .WeakReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    .MutableWeakReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    _ then false,
                                }
                            },
                            .None() then true,
                        },
                        .None() then true,
                    }
                    if not owner_matches_receiver then {
                        continue
                    }
                    let candidate_type = mono.storage.context.get_function_type(def_id) or else Type.Unknown()
                    let type_matches_expected = method_type_matches_expected_for_wrapper_receiver_strict(
                        mono,
                        candidate_type,
                        expected_method_type_opt,
                        resolved_receiver_type,
                    )
                    if type_matches_expected then {
                        let bound_symbol_type = when mono.storage.context.get_function_type(def_id) in {
                            .Some(function_type) then function_type,
                            .None() then method.symbol_type,
                        }
                        return Option[Symbol].Some(Symbol(def_id, bound_symbol_type, method.kind))
                    }
                },
                .None() then {},
            }
        }
        return Option[Symbol].None()
    }

    if not strict_wrapper_dispatch then {
        for entry in mono.storage.concrete_callables_by_def_id.iterator() then {
            let def_id = entry.first
            let concrete = entry.second
            let candidate_method_name = semantic_receiver_method_name_for_def_id(mono, def_id, concrete.logical_name)
            if candidate_method_name <> method_name then {
                continue
            }
            let owner_type = concrete.owner_type or else { continue }
            let resolved_owner_type = resolve_parameterized_type(mono, owner_type)
            let owner_matches_receiver = if layout_key(resolved_owner_type) == layout_key(resolved_receiver_type) then {
                break true
            } else when resolved_receiver_type in {
                .ReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                .MutableReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                .BorrowedReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                .MutableBorrowedReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                .WeakReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                .MutableWeakReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                _ then false,
            }
            if not owner_matches_receiver then {
                continue
            }
            let candidate_type = mono.storage.context.get_function_type(def_id) or else Type.Unknown()
            let type_matches_expected = method_type_matches_expected_strict(mono, candidate_type, expected_method_type_opt)
            if not type_matches_expected then {
                continue
            }
            let bound_symbol_type = when mono.storage.context.get_function_type(def_id) in {
                .Some(function_type) then function_type,
                .None() then method.symbol_type,
            }
            return Option[Symbol].Some(Symbol(def_id, bound_symbol_type, method.kind))
        }
    }

    if receiver_uses_strict_wrapper_dispatch(mono, resolved_receiver_type) then {
        for receiver_alias in strict_wrapper_receiver_aliases(resolved_receiver_type) then {
            let alias_lookup_key = "\(receiver_alias).\(method_name)"
            when mono.storage.extension_method_def_ids.get(alias_lookup_key) in {
                .Some(def_id) then {
                    if nested_ref_like_receiver and method.def_id.id > 0 and def_id.id == method.def_id.id then {
                        continue
                    }
                    let owner_matches_receiver = when mono.concrete_callable_info(def_id) in {
                        .Some(info) then when info.owner_type in {
                            .Some(owner_type) then {
                                let resolved_owner_type = resolve_parameterized_type(mono, owner_type)
                                break if layout_key(resolved_owner_type) == layout_key(resolved_receiver_type) then {
                                    break true
                                } else when resolved_receiver_type in {
                                    .ReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    .MutableReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    .BorrowedReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    .MutableBorrowedReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    .WeakReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    .MutableWeakReferenceType(inner) then layout_key(resolved_owner_type) == layout_key(resolve_parameterized_type(mono, *inner)),
                                    _ then false,
                                }
                            },
                            .None() then true,
                        },
                        .None() then true,
                    }
                    if not owner_matches_receiver then {
                        continue
                    }
                    let candidate_type = mono.storage.context.get_function_type(def_id) or else Type.Unknown()
                    let type_matches_expected = method_type_matches_expected_for_wrapper_receiver_strict(
                        mono,
                        candidate_type,
                        expected_method_type_opt,
                        resolved_receiver_type,
                    )
                    if type_matches_expected then {
                        let bound_symbol_type = when mono.storage.context.get_function_type(def_id) in {
                            .Some(function_type) then function_type,
                            .None() then method.symbol_type,
                        }
                        return Option[Symbol].Some(Symbol(def_id, bound_symbol_type, method.kind))
                    }
                },
                .None() then {},
            }
        }
        return Option[Symbol].None()
    }

    for receiver_alias in static_method_receiver_aliases(mono, resolved_receiver_type) then {
        let alias_lookup_key = "\(receiver_alias).\(method_name)"
        when mono.storage.extension_method_def_ids.get(alias_lookup_key) in {
            .Some(def_id) then {
                let candidate_type = mono.storage.context.get_function_type(def_id) or else Type.Unknown()
                let type_matches_expected = if strict_wrapper_dispatch
                    then method_type_matches_expected_for_wrapper_receiver_strict(mono, candidate_type, expected_method_type_opt, resolved_receiver_type)
                    else method_type_matches_expected_strict(mono, candidate_type, expected_method_type_opt)
                if type_matches_expected then {
                    let bound_symbol_type = when mono.storage.context.get_function_type(def_id) in {
                        .Some(function_type) then function_type,
                        .None() then method.symbol_type,
                    }
                    return Option[Symbol].Some(Symbol(def_id, bound_symbol_type, method.kind))
                }
            },
            .None() then {},
        }
    }

    return Option[Symbol].None()
}

let bind_receiver_method_symbol(
    mono * Monomorphizer,
    receiver_type Type,
    method Symbol,
    expected_method_type_opt Option[Type],
) Symbol = {
    let resolved_receiver_type = resolve_parameterized_type(mono, receiver_type)
    let strict_wrapper_dispatch = receiver_uses_strict_wrapper_dispatch(mono, resolved_receiver_type)
    when resolved_receiver_type in {
        .TraitObject(_, _) then {
            return method
        },
        .ReferenceType(inner_ref) then when resolve_parameterized_type(mono, *inner_ref) in {
            .TraitObject(_, _) then { return method },
            _ then {},
        },
        .MutableReferenceType(inner_ref) then when resolve_parameterized_type(mono, *inner_ref) in {
            .TraitObject(_, _) then { return method },
            _ then {},
        },
        .BorrowedReferenceType(inner_ref) then when resolve_parameterized_type(mono, *inner_ref) in {
            .TraitObject(_, _) then { return method },
            _ then {},
        },
        .MutableBorrowedReferenceType(inner_ref) then when resolve_parameterized_type(mono, *inner_ref) in {
            .TraitObject(_, _) then { return method },
            _ then {},
        },
        .WeakReferenceType(inner_ref) then when resolve_parameterized_type(mono, *inner_ref) in {
            .TraitObject(_, _) then { return method },
            _ then {},
        },
        .MutableWeakReferenceType(inner_ref) then when resolve_parameterized_type(mono, *inner_ref) in {
            .TraitObject(_, _) then { return method },
            _ then {},
        },
        _ then {},
    }
    let expected_return_type = when expected_method_type_opt in {
        .Some(expected_method_type) then when resolve_parameterized_type(mono, expected_method_type) in {
            .FunctionType(_, return_type) then resolve_parameterized_type(mono, *return_type),
            _ then resolve_parameterized_type(mono, method.symbol_type),
        },
        .None() then resolve_parameterized_type(mono, method.symbol_type),
    }
    return when resolved_receiver_type in {
        .ReferenceType(inner) then when lookup_exact_receiver_method_symbol(mono, resolved_receiver_type, method, expected_method_type_opt) in {
            .Some(bound) then bound,
            .None() then {
                when expected_method_type_opt in {
                    .Some(expected_method_type) then {
                        let rebound = bind_receiver_method_symbol_for_expected_type(
                            mono,
                            resolved_receiver_type,
                            method,
                            expected_method_type,
                        )
                        if rebound.def_id.id <> method.def_id.id or not has_generic_parameter(resolve_parameterized_type(mono, rebound.symbol_type)) then {
                            return rebound
                        }
                    },
                    .None() then {},
                }
                if strict_wrapper_dispatch then {
                    return when resolve_parameterized_type(mono, *inner) in {
                        .ReferenceType(_) then bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt),
                        .MutableReferenceType(_) then bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt),
                        .BorrowedReferenceType(_) then bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt),
                        .MutableBorrowedReferenceType(_) then bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt),
                        .WeakReferenceType(_) then bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt),
                        .MutableWeakReferenceType(_) then bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt),
                        .PointerType(_) then bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt),
                        .MutablePointerType(_) then bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt),
                        _ then method,
                    }
                }
                let rebound = *try_bind_generic_method_call(
                    mono,
                    resolved_receiver_type,
                    method,
                    List[* TypedExpr].new(),
                    expected_return_type,
                                )
                break if rebound.def_id.id > 0
                    then rebound
                    else bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt)
            },
        },
        .MutableReferenceType(inner) then when lookup_exact_receiver_method_symbol(mono, resolved_receiver_type, method, expected_method_type_opt) in {
            .Some(bound) then bound,
            .None() then {
                when expected_method_type_opt in {
                    .Some(expected_method_type) then {
                        let rebound = bind_receiver_method_symbol_for_expected_type(
                            mono,
                            resolved_receiver_type,
                            method,
                            expected_method_type,
                        )
                        if rebound.def_id.id <> method.def_id.id or not has_generic_parameter(resolve_parameterized_type(mono, rebound.symbol_type)) then {
                            return rebound
                        }
                    },
                    .None() then {},
                }
                if strict_wrapper_dispatch then {
                    return method
                }
                let rebound = *try_bind_generic_method_call(
                    mono,
                    resolved_receiver_type,
                    method,
                    List[* TypedExpr].new(),
                    expected_return_type,
                                )
                if rebound.def_id.id > 0 then {
                    return rebound
                }
                let shared_ref_type = Type.ReferenceType(box(resolve_parameterized_type(mono, *inner)))
                break when lookup_exact_receiver_method_symbol(mono, shared_ref_type, method, expected_method_type_opt) in {
                    .Some(bound) then bound,
                    .None() then {
                        let shared_rebound = *try_bind_generic_method_call(
                            mono,
                            shared_ref_type,
                            method,
                            List[* TypedExpr].new(),
                            expected_return_type,
                                                )
                        break if shared_rebound.def_id.id > 0 then shared_rebound else bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt)
                    },
                }
            },
        },
        .BorrowedReferenceType(inner) then when lookup_exact_receiver_method_symbol(mono, resolved_receiver_type, method, expected_method_type_opt) in {
            .Some(bound) then bound,
            .None() then {
                when expected_method_type_opt in {
                    .Some(expected_method_type) then {
                        let rebound = bind_receiver_method_symbol_for_expected_type(
                            mono,
                            resolved_receiver_type,
                            method,
                            expected_method_type,
                        )
                        if rebound.def_id.id <> method.def_id.id or not has_generic_parameter(resolve_parameterized_type(mono, rebound.symbol_type)) then {
                            return rebound
                        }
                    },
                    .None() then {},
                }
                if strict_wrapper_dispatch then {
                    return method
                }
                let rebound = *try_bind_generic_method_call(
                    mono,
                    resolved_receiver_type,
                    method,
                    List[* TypedExpr].new(),
                    expected_return_type,
                                )
                break if rebound.def_id.id <> method.def_id.id
                    then rebound
                    else if strict_wrapper_dispatch then method else bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt)
            },
        },
        .MutableBorrowedReferenceType(inner) then when lookup_exact_receiver_method_symbol(mono, resolved_receiver_type, method, expected_method_type_opt) in {
            .Some(bound) then bound,
            .None() then {
                when expected_method_type_opt in {
                    .Some(expected_method_type) then {
                        let rebound = bind_receiver_method_symbol_for_expected_type(
                            mono,
                            resolved_receiver_type,
                            method,
                            expected_method_type,
                        )
                        if rebound.def_id.id <> method.def_id.id or not has_generic_parameter(resolve_parameterized_type(mono, rebound.symbol_type)) then {
                            return rebound
                        }
                    },
                    .None() then {},
                }
                if strict_wrapper_dispatch then {
                    return method
                }
                let rebound = *try_bind_generic_method_call(
                    mono,
                    resolved_receiver_type,
                    method,
                    List[* TypedExpr].new(),
                    expected_return_type,
                                )
                if rebound.def_id.id <> method.def_id.id then {
                    return rebound
                }
                break if strict_wrapper_dispatch
                    then method
                    else bind_receiver_method_symbol(mono, *inner, method, expected_method_type_opt)
            },
        },
        .WeakReferenceType(_) then {
            break when lookup_exact_receiver_method_symbol(mono, resolved_receiver_type, method, expected_method_type_opt) in {
                .Some(bound) then bound,
                .None() then when expected_method_type_opt in {
                    .Some(expected_method_type) then {
                        let rebound = bind_receiver_method_symbol_for_expected_type(
                            mono,
                            resolved_receiver_type,
                            method,
                            expected_method_type,
                        )
                        break if rebound.def_id.id <> method.def_id.id or not has_generic_parameter(resolve_parameterized_type(mono, rebound.symbol_type)) then rebound else try_bind_generic_method_call(
                            mono,
                            resolved_receiver_type,
                            method,
                            List[* TypedExpr].new(),
                            expected_return_type,
                                                )
                    },
                    .None() then try_bind_generic_method_call(
                        mono,
                        resolved_receiver_type,
                        method,
                        List[* TypedExpr].new(),
                        expected_return_type,
                                        ),
                },
            }
        },
        .MutableWeakReferenceType(inner) then when lookup_exact_receiver_method_symbol(mono, resolved_receiver_type, method, expected_method_type_opt) in {
            .Some(bound) then bound,
            .None() then {
                when expected_method_type_opt in {
                    .Some(expected_method_type) then {
                        let rebound = bind_receiver_method_symbol_for_expected_type(
                            mono,
                            resolved_receiver_type,
                            method,
                            expected_method_type,
                        )
                        if rebound.def_id.id <> method.def_id.id or not has_generic_parameter(resolve_parameterized_type(mono, rebound.symbol_type)) then {
                            return rebound
                        }
                    },
                    .None() then {},
                }
                if strict_wrapper_dispatch then {
                    return method
                }
                let rebound = *try_bind_generic_method_call(
                    mono,
                    resolved_receiver_type,
                    method,
                    List[* TypedExpr].new(),
                    expected_return_type,
                                )
                if rebound.def_id.id > 0 then {
                    return rebound
                }
                let shared_weakref_type = Type.WeakReferenceType(box(resolve_parameterized_type(mono, *inner)))
                break when lookup_exact_receiver_method_symbol(mono, shared_weakref_type, method, expected_method_type_opt) in {
                    .Some(bound) then bound,
                    .None() then try_bind_generic_method_call(
                        mono,
                        shared_weakref_type,
                        method,
                        List[* TypedExpr].new(),
                        expected_return_type,
                                        ),
                }
            },
        },
        _ then {
            break when lookup_exact_receiver_method_symbol(mono, resolved_receiver_type, method, expected_method_type_opt) in {
                .Some(bound) then bound,
                .None() then when expected_method_type_opt in {
                    .Some(expected_method_type) then {
                        let rebound = bind_receiver_method_symbol_for_expected_type(
                            mono,
                            resolved_receiver_type,
                            method,
                            expected_method_type,
                        )
                        break if rebound.def_id.id <> method.def_id.id or not has_generic_parameter(resolve_parameterized_type(mono, rebound.symbol_type)) then rebound else try_bind_generic_method_call(
                            mono,
                            resolved_receiver_type,
                            method,
                            List[* TypedExpr].new(),
                            expected_return_type,
                                                )
                    },
                    .None() then try_bind_generic_method_call(
                        mono,
                        resolved_receiver_type,
                        method,
                        List[* TypedExpr].new(),
                        expected_return_type,
                                        ),
                },
            }
        },
    }
}

private let substitution_semantic_method_name(
    mono * Monomorphizer,
    method Symbol,
) String = {
    if method.def_id.id > 0 then {
        when mono.receiver_method_dispatch_info(method.def_id) in {
            .Some(info) then { return info.method_name },
            .None() then {},
        }
        when mono.concrete_callable_info(method.def_id) in {
            .Some(info) then { return info.logical_name },
            .None() then {},
        }
        let symbol_name = mono.storage.context.symbol_name(method)
        if not symbol_name.is_empty() then {
            return symbol_name
        }
        when mono.storage.context.get_name(method.def_id) in {
            .Some(name) then { return name },
            .None() then {},
        }
    }
    return mono.storage.context.symbol_name(method)
}

private let substitution_ordered_trait_method_names_helper(
    mono * Monomorphizer,
    trait_name String,
    visited *mut Set[String],
    ordered *mut List[String],
    seen *mut Set[String],
) Void = {
    if visited.contains(trait_name) then {
        return
    }
    visited.insert(trait_name)
    when mono.storage.generic_templates.traits.get(trait_name) in {
        .Some(info) then {
            for parent in info.parent_traits then {
                substitution_ordered_trait_method_names_helper(mono, parent.name, visited, ordered, seen)
            }
            for member in info.raw_members then {
                if not seen.contains(member.name) then {
                    seen.insert(member.name)
                    ordered.push(member.name)
                }
            }
        },
        .None() then {},
    }
}

private let substitution_vtable_method_index(
    mono * Monomorphizer,
    trait_name String,
    method_name String,
) Int = {
    let mut visited = Set[String].new()
    let mut ordered = List[String].new()
    let mut seen = Set[String].new()
    substitution_ordered_trait_method_names_helper(mono, trait_name, &mut visited, &mut ordered, &mut seen)
    let mut idx UInt = 0
    while idx < ordered.count() then {
        if ordered[idx] == method_name then {
            return idx(Int)
        }
        idx += 1
    }
    return -1
}

let align_method_reference_base_for_bound_method(
    mono * Monomorphizer,
    receiver_expr * TypedExpr,
    method Symbol,
) * TypedExpr = {
    let current_expr = when receiver_expr.expr_kind in {
        .TraitObjectConversion(inner, _, _) then inner,
        .RefExpr(inner) then when inner.expr_type in {
            .ReferenceType(_) then inner,
            .MutableReferenceType(_) then inner,
            .BorrowedReferenceType(_) then inner,
            .MutableBorrowedReferenceType(_) then inner,
            .WeakReferenceType(_) then inner,
            .MutableWeakReferenceType(_) then inner,
            .PointerType(_) then inner,
            .MutablePointerType(_) then inner,
            _ then receiver_expr,
        },
        _ then receiver_expr,
    }
    let current_type = resolve_parameterized_type(mono, current_expr.expr_type)
    let effective_current_type = when current_expr.expr_kind in {
        .Variable(symbol) then {
            let symbol_type = resolve_parameterized_type(mono, symbol.symbol_type)
            break when symbol_type in {
                .ReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(current_type) then current_type else symbol_type
                },
                .MutableReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(current_type) then current_type else symbol_type
                },
                .BorrowedReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(current_type) then current_type else symbol_type
                },
                .MutableBorrowedReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(current_type) then current_type else symbol_type
                },
                .WeakReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(current_type) then current_type else symbol_type
                },
                .MutableWeakReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(current_type) then current_type else symbol_type
                },
                .PointerType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(current_type) then current_type else symbol_type
                },
                .MutablePointerType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(current_type) then current_type else symbol_type
                },
                _ then current_type,
            }
        },
        _ then current_type,
    }
    let expected_self_type_opt = when resolve_parameterized_type(mono, method.symbol_type) in {
        .FunctionType(fn_params, _) then {
            let param_types = param_entry_types(fn_params)
            break if param_types.count() == 0 then {
                break Option[Type].None()
            } else {
                break Option[Type].Some(resolve_parameterized_type(mono, (*param_types[0(UInt)])))
            }
        },
        _ then Option[Type].None(),
    }

    return when expected_self_type_opt in {
        .Some(expected_self_type) then {
            let adapted_expr = if layout_key(expected_self_type) == layout_key(effective_current_type) then {
                break current_expr
            } else when expected_self_type in {
                .ReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(effective_current_type) then {
                        break when effective_current_type in {
                            .ReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .MutableReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .BorrowedReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .MutableBorrowedReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .WeakReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .MutableWeakReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .PointerType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .MutablePointerType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            _ then box(TypedExpr(box(TypedExprKind.RefExpr(current_expr)), expected_self_type)),
                        }
                    } else when effective_current_type in {
                        .MutableReferenceType(actual_inner) then {
                            let actual_inner_type = resolve_parameterized_type(mono, *actual_inner)
                            break if layout_key(inner_type) == layout_key(actual_inner_type) then {
                                break box(TypedExpr(current_expr.expr_kind, expected_self_type))
                            } else {
                                break current_expr
                            }
                        },
                        .BorrowedReferenceType(actual_inner) then {
                            let actual_inner_type = resolve_parameterized_type(mono, *actual_inner)
                            break if layout_key(inner_type) == layout_key(actual_inner_type) then {
                                break box(TypedExpr(current_expr.expr_kind, expected_self_type))
                            } else {
                                break current_expr
                            }
                        },
                        .MutableBorrowedReferenceType(actual_inner) then {
                            let actual_inner_type = resolve_parameterized_type(mono, *actual_inner)
                            break if layout_key(inner_type) == layout_key(actual_inner_type) then {
                                break box(TypedExpr(current_expr.expr_kind, expected_self_type))
                            } else {
                                break current_expr
                            }
                        },
                        _ then current_expr,
                    }
                },
                .MutableReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(effective_current_type) then {
                        break when effective_current_type in {
                            .ReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .MutableReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .BorrowedReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .MutableBorrowedReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .WeakReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .MutableWeakReferenceType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .PointerType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            .MutablePointerType(_) then box(TypedExpr(current_expr.expr_kind, expected_self_type)),
                            _ then box(TypedExpr(box(TypedExprKind.RefExpr(current_expr)), expected_self_type)),
                        }
                    } else when effective_current_type in {
                        .ReferenceType(actual_inner) then {
                            let actual_inner_type = resolve_parameterized_type(mono, *actual_inner)
                            break if layout_key(inner_type) == layout_key(actual_inner_type) then {
                                break box(TypedExpr(current_expr.expr_kind, expected_self_type))
                            } else {
                                break current_expr
                            }
                        },
                        .MutableReferenceType(actual_inner) then {
                            let actual_inner_type = resolve_parameterized_type(mono, *actual_inner)
                            break if layout_key(inner_type) == layout_key(actual_inner_type) then {
                                break box(TypedExpr(current_expr.expr_kind, expected_self_type))
                            } else {
                                break current_expr
                            }
                        },
                        _ then current_expr,
                    }
                },
                .BorrowedReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(effective_current_type) then {
                        break box(TypedExpr(box(TypedExprKind.RefExpr(current_expr)), expected_self_type))
                    } else when effective_current_type in {
                        .MutableBorrowedReferenceType(actual_inner) then {
                            let actual_inner_type = resolve_parameterized_type(mono, *actual_inner)
                            break if layout_key(inner_type) == layout_key(actual_inner_type) then {
                                break box(TypedExpr(current_expr.expr_kind, expected_self_type))
                            } else {
                                break current_expr
                            }
                        },
                        _ then current_expr,
                    }
                },
                .MutableBorrowedReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(effective_current_type) then {
                        break box(TypedExpr(box(TypedExprKind.RefExpr(current_expr)), expected_self_type))
                    } else {
                        break current_expr
                    }
                },
                .WeakReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(effective_current_type) then {
                        break box(TypedExpr(box(TypedExprKind.RefExpr(current_expr)), expected_self_type))
                    } else when effective_current_type in {
                        .MutableWeakReferenceType(actual_inner) then {
                            let actual_inner_type = resolve_parameterized_type(mono, *actual_inner)
                            break if layout_key(inner_type) == layout_key(actual_inner_type) then {
                                break box(TypedExpr(current_expr.expr_kind, expected_self_type))
                            } else {
                                break current_expr
                            }
                        },
                        _ then current_expr,
                    }
                },
                .MutableWeakReferenceType(inner) then {
                    let inner_type = resolve_parameterized_type(mono, *inner)
                    break if layout_key(inner_type) == layout_key(effective_current_type) then {
                        break box(TypedExpr(box(TypedExprKind.RefExpr(current_expr)), expected_self_type))
                    } else {
                        break current_expr
                    }
                },
                _ then when effective_current_type in {
                    .ReferenceType(inner) then {
                        let inner_type = resolve_parameterized_type(mono, *inner)
                        break if layout_key(inner_type) == layout_key(expected_self_type) then {
                            break box(TypedExpr(box(TypedExprKind.DerefExpr(current_expr)), expected_self_type))
                        } else {
                            break current_expr
                        }
                    },
                    .MutableReferenceType(inner) then {
                        let inner_type = resolve_parameterized_type(mono, *inner)
                        break if layout_key(inner_type) == layout_key(expected_self_type) then {
                            break box(TypedExpr(box(TypedExprKind.DerefExpr(current_expr)), expected_self_type))
                        } else {
                            break current_expr
                        }
                    },
                    .BorrowedReferenceType(inner) then {
                        let inner_type = resolve_parameterized_type(mono, *inner)
                        break if layout_key(inner_type) == layout_key(expected_self_type) then {
                            break box(TypedExpr(box(TypedExprKind.DerefExpr(current_expr)), expected_self_type))
                        } else {
                            break current_expr
                        }
                    },
                    .MutableBorrowedReferenceType(inner) then {
                        let inner_type = resolve_parameterized_type(mono, *inner)
                        break if layout_key(inner_type) == layout_key(expected_self_type) then {
                            break box(TypedExpr(box(TypedExprKind.DerefExpr(current_expr)), expected_self_type))
                        } else {
                            break current_expr
                        }
                    },
                    .WeakReferenceType(inner) then {
                        let inner_type = resolve_parameterized_type(mono, *inner)
                        break if layout_key(inner_type) == layout_key(expected_self_type) then {
                            break box(TypedExpr(box(TypedExprKind.DerefExpr(current_expr)), expected_self_type))
                        } else {
                            break current_expr
                        }
                    },
                    .MutableWeakReferenceType(inner) then {
                        let inner_type = resolve_parameterized_type(mono, *inner)
                        break if layout_key(inner_type) == layout_key(expected_self_type) then {
                            break box(TypedExpr(box(TypedExprKind.DerefExpr(current_expr)), expected_self_type))
                        } else {
                            break current_expr
                        }
                    },
                    _ then current_expr,
                },
            }

            break when adapted_expr.expr_kind in {
                .RefExpr(inner_expr) then {
                    let inner_type = resolve_parameterized_type(mono, inner_expr.expr_type)
                    break if layout_key(inner_type) == layout_key(expected_self_type) then {
                        break inner_expr
                    } else when inner_type in {
                        .MutableReferenceType(inner_ref) then when expected_self_type in {
                            .ReferenceType(expected_inner) then {
                                let inner_ref_type = resolve_parameterized_type(mono, *inner_ref)
                                let expected_inner_type = resolve_parameterized_type(mono, *expected_inner)
                                break if layout_key(inner_ref_type) == layout_key(expected_inner_type) then inner_expr else adapted_expr
                            },
                            _ then adapted_expr,
                        },
                        .BorrowedReferenceType(inner_ref) then when expected_self_type in {
                            .ReferenceType(expected_inner) then {
                                let inner_ref_type = resolve_parameterized_type(mono, *inner_ref)
                                let expected_inner_type = resolve_parameterized_type(mono, *expected_inner)
                                break if layout_key(inner_ref_type) == layout_key(expected_inner_type) then inner_expr else adapted_expr
                            },
                            _ then adapted_expr,
                        },
                        .MutableBorrowedReferenceType(inner_ref) then when expected_self_type in {
                            .ReferenceType(expected_inner) then {
                                let inner_ref_type = resolve_parameterized_type(mono, *inner_ref)
                                let expected_inner_type = resolve_parameterized_type(mono, *expected_inner)
                                break if layout_key(inner_ref_type) == layout_key(expected_inner_type) then inner_expr else adapted_expr
                            },
                            .BorrowedReferenceType(expected_inner) then {
                                let inner_ref_type = resolve_parameterized_type(mono, *inner_ref)
                                let expected_inner_type = resolve_parameterized_type(mono, *expected_inner)
                                break if layout_key(inner_ref_type) == layout_key(expected_inner_type) then inner_expr else adapted_expr
                            },
                            _ then adapted_expr,
                        },
                        .MutableWeakReferenceType(inner_ref) then when expected_self_type in {
                            .WeakReferenceType(expected_inner) then {
                                let inner_ref_type = resolve_parameterized_type(mono, *inner_ref)
                                let expected_inner_type = resolve_parameterized_type(mono, *expected_inner)
                                break if layout_key(inner_ref_type) == layout_key(expected_inner_type) then inner_expr else adapted_expr
                            },
                            _ then adapted_expr,
                        },
                        _ then adapted_expr,
                    }
                },
                _ then adapted_expr,
            }
        },
        .None() then current_expr,
    }
}

// ── substitute_statement ──────────────────────────────────────────────────────

// Substitute types in a TypedStatement node.
public let substitute_statement(
    mono * Monomorphizer,
    stmt * TypedStatement,
    substitution Dict[String, Type],
) TypedStatement = {
    return when stmt in {
        // LetStmt: substitute symbol type and value expression.
        .LetStmt(symbol, value, span) then {
            let new_sym = substitute_symbol(mono, symbol, substitution)
            let new_val = substitute_types_in_expression(mono, value, substitution)
            break TypedStatement.LetStmt(box(new_sym), new_val, span)
        },

        .PairLetStmt(pair_type, first_symbol, second_symbol, value, span) then {
            let new_first_symbol = when first_symbol in {
                .Some(symbol) then Option[* Symbol].Some(box(substitute_symbol(mono, symbol, substitution))),
                .None() then Option[* Symbol].None(),
            }
            let new_second_symbol = when second_symbol in {
                .Some(symbol) then Option[* Symbol].Some(box(substitute_symbol(mono, symbol, substitution))),
                .None() then Option[* Symbol].None(),
            }
            let new_val = substitute_types_in_expression(mono, value, substitution)
            break TypedStatement.PairLetStmt(mono.substitute_type_impl(pair_type, substitution), new_first_symbol, new_second_symbol, new_val, span)
        },

        // AssignmentStmt: substitute target and value expressions.
        .AssignmentStmt(target, value, span) then {
            let new_target = substitute_types_in_expression(mono, target, substitution)
            let new_value  = substitute_types_in_expression(mono, value,  substitution)
            break TypedStatement.AssignmentStmt(new_target, new_value, span)
        },

        // ExprStmt: substitute the expression.
        .ExprStmt(expr, span) then {
            let new_expr = substitute_types_in_expression(mono, expr, substitution)
            break TypedStatement.ExprStmt(new_expr, span)
        },
        .IfStmt(condition, then_branch, else_branch, span) then {
            let new_else = when else_branch in {
                .Some(expr) then Option[* TypedExpr].Some(substitute_types_in_expression(mono, expr, substitution)),
                .None() then Option[* TypedExpr].None(),
            }
            break TypedStatement.IfStmt(
                substitute_types_in_expression(mono, condition, substitution),
                substitute_types_in_expression(mono, then_branch, substitution),
                new_else,
                span
            )
        },

        .WhileStmt(condition, body, span) then {
            let new_condition = substitute_types_in_expression(mono, condition, substitution)
            let new_body = substitute_types_in_expression(mono, body, substitution)
            break TypedStatement.WhileStmt(new_condition, new_body, span)
        },
        .WhenStmt(subject, arms, span) then {
            let new_subject = substitute_types_in_expression(mono, subject, substitution)
            let mut new_arms = List[* TypedWhenArm].new()
            for arm_ref in arms then {
                let new_pattern = substitute_pattern(mono, arm_ref.pattern, substitution)
                let new_body = substitute_types_in_expression(mono, arm_ref.body, substitution)
                let new_arm_type = mono.substitute_type_impl(arm_ref.arm_type, substitution)
                new_arms.push(box(TypedWhenArm(box(new_pattern), new_body, new_arm_type)))
            }
            break TypedStatement.WhenStmt(new_subject, new_arms, span)
        },

        // ReturnStmt: substitute optional return value.
        .ReturnStmt(value, span) then {
            let new_value = when value in {
                .Some(e) then {
                    break Option[* TypedExpr].Some(substitute_types_in_expression(mono, e, substitution))
                },
                .None() then Option[* TypedExpr].None(),
            }
            break TypedStatement.ReturnStmt(new_value, span)
        },

        // BreakStmt / ContinueStmt: no sub-expressions.
        .BreakStmt(span)    then TypedStatement.BreakStmt(span),
        .ContinueStmt(span) then TypedStatement.ContinueStmt(span),

        // DeferStmt: substitute the expression.
        .DeferStmt(expr, span) then {
            let new_expr = substitute_types_in_expression(mono, expr, substitution)
            break TypedStatement.DeferStmt(new_expr, span)
        },

        // BranchBreakStmt: substitute the expression.
        .BranchBreakStmt(expr, span) then {
            let new_expr = substitute_types_in_expression(mono, expr, substitution)
            break TypedStatement.BranchBreakStmt(new_expr, span)
        },
    }
}

// ── substitute_pattern ────────────────────────────────────────────────────────

// Substitute types in a TypedPattern.
// Most patterns carry no type annotations directly, but struct/enum patterns
// may contain nested patterns that need substitution.
public let substitute_pattern(
    mono * Monomorphizer,
    pattern * TypedPattern,
    substitution Dict[String, Type],
) TypedPattern = {
    return when pattern in {
        // StructPattern: recurse into each element pattern.
        .StructPattern(type_name, elements) then {
            let mut new_elements = List[* TypedPatternElement].new()
            for elem in elements then {
                let new_sub = substitute_pattern(mono, elem.pattern, substitution)
                new_elements.push(box(TypedPatternElement(elem.label, box(new_sub))))
            }
            break TypedPattern.StructPattern(type_name, new_elements)
        },

        // EnumCase: recurse into each element pattern.
        .EnumCase(case_name, tag_index, elements) then {
            let mut new_elements = List[* TypedPatternElement].new()
            for elem in elements then {
                let new_sub = substitute_pattern(mono, elem.pattern, substitution)
                new_elements.push(box(TypedPatternElement(elem.label, box(new_sub))))
            }
            break TypedPattern.EnumCase(case_name, tag_index, new_elements)
        },

        // AndPattern / OrPattern: recurse into sub-patterns.
        .AndPattern(left, right) then {
            let new_left  = substitute_pattern(mono, left,  substitution)
            let new_right = substitute_pattern(mono, right, substitution)
            break TypedPattern.AndPattern(box(new_left), box(new_right))
        },
        .OrPattern(left, right) then {
            let new_left  = substitute_pattern(mono, left,  substitution)
            let new_right = substitute_pattern(mono, right, substitution)
            break TypedPattern.OrPattern(box(new_left), box(new_right))
        },
        .NotPattern(inner) then {
            let new_inner = substitute_pattern(mono, inner, substitution)
            break TypedPattern.NotPattern(box(new_inner))
        },

        // All leaf patterns: no type substitution needed.
        .Wildcard()                   then TypedPattern.Wildcard(),
        .Variable(symbol)             then {
            let substituted_type = mono.substitute_type_impl(symbol.symbol_type, substitution)
            break TypedPattern.Variable(box(Symbol(symbol.def_id, substituted_type, symbol.kind)))
        },
        .BoolLiteral(value)           then TypedPattern.BoolLiteral(value),
        .IntegerLiteral(value)        then TypedPattern.IntegerLiteral(value),
        .NegativeIntegerLiteral(value) then TypedPattern.NegativeIntegerLiteral(value),
        .StringLiteral(value)         then TypedPattern.StringLiteral(value),
        .RuneLiteral(value)           then TypedPattern.RuneLiteral(value),
        .ComparisonPattern(op, value) then TypedPattern.ComparisonPattern(op, value),
    }
}
