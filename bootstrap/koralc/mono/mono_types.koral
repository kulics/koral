// Layout Name generation for the monomorphization phase.
// Provides canonical string representations of types (layout keys) and
// helpers for building the unique C-level identifiers used by the Monomorphizer.
//

// ── layout_key ────────────────────────────────────────────────────────────────

// Convert a Type to its canonical layout key string.
//
// Layout key rules:
//   - Primitive types: use the type name directly (e.g. "Int", "String", "Bool")
//   - ReferenceType:   "ref_<inner_key>"
//   - PointerType:     "ptr_<inner_key>"
//   - WeakReferenceType: "weakref_<inner_key>"
//   - FunctionType:    "fn_<param1>_<param2>_<ret>"
//   - GenericStruct:   "<TemplateName>_<arg1>_<arg2>"
//   - GenericEnum:    "<TemplateName>_<arg1>_<arg2>"
//   - StructureType:   use the struct's DefId-based name (struct#N)
//   - EnumType:       use the enum's DefId-based name (enum#N)
//   - OpaqueType:      use the opaque's DefId-based name (opaque#N)
//   - GenericParameter: use the parameter name directly
//   - TraitObject:     use the trait name directly
//   - TypeVar / Unknown: "?"
file_private type MonoLayoutKeyWrapperKind {
    Reference(),
    MutableReference(),
    BorrowedReference(),
    MutableBorrowedReference(),
    Pointer(),
    MutablePointer(),
    WeakReference(),
    MutableWeakReference(),
};

file_private type MonoLayoutKeyWrapperChain(
    wrappers List[MonoLayoutKeyWrapperKind],
    inner Type,
);

file_private let split_layout_key_wrappers(t Type) MonoLayoutKeyWrapperChain = {
    let mutable wrappers = List[MonoLayoutKeyWrapperKind].new();
    let mutable current = t;
    while true then {
        when current in {
            .ReferenceType(inner) then {
                wrappers.push(MonoLayoutKeyWrapperKind.Reference());
                current = inner;
            },
            .MutableReferenceType(inner) then {
                wrappers.push(MonoLayoutKeyWrapperKind.MutableReference());
                current = inner;
            },
            .BorrowedReferenceType(inner) then {
                wrappers.push(MonoLayoutKeyWrapperKind.BorrowedReference());
                current = inner;
            },
            .MutableBorrowedReferenceType(inner) then {
                wrappers.push(MonoLayoutKeyWrapperKind.MutableBorrowedReference());
                current = inner;
            },
            .PointerType(inner) then {
                wrappers.push(MonoLayoutKeyWrapperKind.Pointer());
                current = inner;
            },
            .MutablePointerType(inner) then {
                wrappers.push(MonoLayoutKeyWrapperKind.MutablePointer());
                current = inner;
            },
            .WeakReferenceType(inner) then {
                wrappers.push(MonoLayoutKeyWrapperKind.WeakReference());
                current = inner;
            },
            .MutableWeakReferenceType(inner) then {
                wrappers.push(MonoLayoutKeyWrapperKind.MutableWeakReference());
                current = inner;
            },
            _ then { break;},
        };
    };
    return MonoLayoutKeyWrapperChain(wrappers, current);
};

file_private let layout_key_wrapper_prefix(kind MonoLayoutKeyWrapperKind) String = {
    return when kind in {
        .Reference() then "ref_",
        .MutableReference() then "mutref_",
        .BorrowedReference() then "bref_",
        .MutableBorrowedReference() then "mutbref_",
        .Pointer() then "ptr_",
        .MutablePointer() then "mutptr_",
        .WeakReference() then "weakref_",
        .MutableWeakReference() then "mutweakref_",
    };
};

file_private let prefix_layout_key(base String, wrappers List[MonoLayoutKeyWrapperKind]) String = {
    if wrappers.is_empty() then {
        return base;
    };

    let mutable out = StringBuilder.new();
    for wrapper in wrappers then {
        out.push_string(layout_key_wrapper_prefix(wrapper));
    };
    out.push_string(base);
    return out.to_string();
};

public let layout_key(t Type) String = {
    let chain = split_layout_key_wrappers(t);
    let inner_key = when chain.inner in {
        .IntType()     then "Int",
        .Int8Type()    then "Int8",
        .Int16Type()   then "Int16",
        .Int32Type()   then "Int32",
        .Int64Type()   then "Int64",
        .UIntType()    then "UInt",
        .UInt8Type()   then "UInt8",
        .UInt16Type()  then "UInt16",
        .UInt32Type()  then "UInt32",
        .UInt64Type()  then "UInt64",
        .Float32Type() then "Float32",
        .Float64Type() then "Float64",
        .BoolType()    then "Bool",
        .VoidType()    then "Void",
        .NeverType()   then "Never",
        .ReferenceType(inner) then "ref_\(layout_key(inner))",
        .MutableReferenceType(inner) then "mutref_\(layout_key(inner))",
        .BorrowedReferenceType(inner) then "bref_\(layout_key(inner))",
        .MutableBorrowedReferenceType(inner) then "mutbref_\(layout_key(inner))",
        .PointerType(inner)   then "ptr_\(layout_key(inner))",
        .MutablePointerType(inner) then "mutptr_\(layout_key(inner))",
        .WeakReferenceType(inner) then "weakref_\(layout_key(inner))",
        .MutableWeakReferenceType(inner) then "mutweakref_\(layout_key(inner))",

        .FunctionType(fn_params, return_type) then {
            let param_types = param_entry_types(fn_params);
            let mutable out = StringBuilder.new();
            out.push_string("fn");
            for pt in param_types then {
                out.push_string("_");
                out.push_string(layout_key(pt));
            };
            out.push_string("_");
            out.push_string(layout_key(return_type));
            yield out.to_string();
        },

        .GenericStruct(template, template_def_id, args) then {
            let mutable out = StringBuilder.new();
            out.push_string(template);
            for a in args then {
                out.push_string("_");
                out.push_string(layout_key(a));
            };
            if template_def_id.is_valid() then {
                out.push_string("_d");
                out.push_string(template_def_id.id.to_string());
            };
            yield out.to_string();
        },

        .GenericEnum(template, template_def_id, args) then {
            let mutable out = StringBuilder.new();
            out.push_string(template);
            for a in args then {
                out.push_string("_");
                out.push_string(layout_key(a));
            };
            if template_def_id.is_valid() then {
                out.push_string("_d");
                out.push_string(template_def_id.id.to_string());
            };
            yield out.to_string();
        },
        .ModuleType(info) then {
            yield if info.module_path.is_empty() then "Module" else info.module_path.join_to_string("_");
        },

        // Concrete struct/enum/opaque: use the DefId-based representation.
        // The Monomorphizer stores the real name in the DefIdMap; here we use
        // the same format as type_to_string so keys remain consistent.
        .StructureType(def_id) then "struct_\(def_id.id)",
        .EnumType(def_id)     then "union_\(def_id.id)",
        .OpaqueType(def_id)    then "opaque_\(def_id.id)",

        .GenericParameter(name) then name,
        .TraitObject(trait_name, trait_def_id, args) then {
            let suffix = if trait_def_id.is_valid() then "_d\(trait_def_id.id)" else "";
            if args.is_empty() then {
                yield "TO_\(trait_name)\(suffix)";
            };
            let mutable out = StringBuilder.new();
            out.push_string("TO_");
            out.push_string(trait_name);
            for arg in args then {
                out.push_byte('_');
                out.push_string(layout_key(arg));
            };
            out.push_string(suffix);
            yield out.to_string();
        },

        .TypeVar(_) then "?",
        .Unknown()  then "?",
    };
    return prefix_layout_key(inner_key, chain.wrappers);
};

// Like layout_key but uses get_name for StructureType/EnumType to match
// the key format used by instantiate_extension_method_from_entry.
// This ensures extension method registration and lookup use the same key format.
public let contextual_layout_key(mono Monomorphizer, t Type) String = {
    return mono.storage.context.get_layout_key(t);
};

file_private let instantiation_layout_key(mono Monomorphizer, t Type) String = {
    return mono.storage.context.get_layout_key(t);
};

file_private let concrete_layout_key(mono Monomorphizer, def_id DefId) Option[String] = {
    let name = mono.storage.context.get_name(def_id) or else { return Option[String].None();};
    let module_path = mono.storage.context.get_module_path(def_id) or else List[String].new();
    let is_private = when mono.storage.context.get_access(def_id) in {
        .Some(access) then when access in {
            .FilePrivate() then true,
            _ then false,
        },
        .None() then false,
    };
    let source_file = mono.storage.context.get_source_file(def_id) or else "";

    let mutable parts = List[String].new();
    if not module_path.is_empty() then {
        let mutable path_str = StringBuilder.new();
        let mutable first = true;
        for seg in module_path then {
            if not first then { path_str.push_byte('_');};
            path_str.push_string(seg);
            first = false;
        };
        parts.push(path_str.to_string());
    };

    if is_private and not source_file.is_empty() then {
        let mutable hash UInt32 = 0;
        for byte in source_file.bytes() then {
            hash = hash.wrapping_mul(31).wrapping_add(byte(UInt32));
        };
        parts.push("f\((hash % 10000)(UInt))");
    };

    parts.push(name);

    let mutable result = StringBuilder.new();
    let mutable first = true;
    for part in parts then {
        if not first then { result.push_byte('_');};
        result.push_string(part);
        first = false;
    };
    return Option[String].Some(result.to_string());
};

// ── make_layout_name ──────────────────────────────────────────────────────────

// Generate the layout name for a generic struct, enum, or function.
//
// Format: "<template_name>_<arg1_key>_<arg2_key>..."
//
// Examples:
//   make_layout_name("List", [Int], template_def_id)       → "List_Int_d<id>"
//   make_layout_name("Dict", [String, Int], template_def_id) → "Dict_String_Int_d<id>"
public let make_layout_name(
    mono Monomorphizer,
    template_name String,
    args List[Type],
    template_def_id DefId,
) String = {
    let mutable arg_keys = List[String].new();
    for a in args then {
        arg_keys.push(mono.storage.context.get_layout_key(a));
    };
    let mutable out = StringBuilder.new();
    out.push_string(template_name);
    out.push_string("_");
    out.push_string(arg_keys.join_to_string("_"));
    if template_def_id.is_valid() then {
        out.push_string("_d");
        out.push_string(template_def_id.id.to_string());
    };
    return out.to_string();
};

// Mirrors Swift's Monomorphizer.typeInstantiationCacheKey(for:).
// The cache identity is the template declaration DefId plus concrete type
// arguments; layout names remain output symbols and are not identity keys.
public let type_instantiation_cache_key(mono Monomorphizer, t Type) Option[InstantiationKey] = {
    return when t in {
        .GenericStruct(template_name, _, args) then {
            yield when mono.storage.generic_templates.lookup_struct(template_name) in {
                .Some(template) then Option[InstantiationKey].Some(InstantiationKey.StructType(template.def_id, args)),
                .None() then Option[InstantiationKey].None(),
            };
        },
        .GenericEnum(template_name, _, args) then {
            yield when mono.storage.generic_templates.lookup_enum(template_name) in {
                .Some(template) then Option[InstantiationKey].Some(InstantiationKey.EnumType(template.def_id, args)),
                .None() then Option[InstantiationKey].None(),
            };
        },
        .StructureType(def_id) then {
            if not mono.storage.context.is_generic_instantiation(def_id) then {
                return Option[InstantiationKey].None();
            };
            yield when mono.storage.context.get_template_name(def_id) in {
                .Some(template_name) then when mono.storage.context.get_type_arguments(def_id) in {
                    .Some(args) then {
                        yield when mono.storage.generic_templates.lookup_struct(template_name) in {
                            .Some(template) then Option[InstantiationKey].Some(InstantiationKey.StructType(template.def_id, args)),
                            .None() then Option[InstantiationKey].None(),
                        };
                    },
                    .None() then Option[InstantiationKey].None(),
                },
                .None() then Option[InstantiationKey].None(),
            };
        },
        .EnumType(def_id) then {
            if not mono.storage.context.is_generic_instantiation(def_id) then {
                return Option[InstantiationKey].None();
            };
            yield when mono.storage.context.get_template_name(def_id) in {
                .Some(template_name) then when mono.storage.context.get_type_arguments(def_id) in {
                    .Some(args) then {
                        yield when mono.storage.generic_templates.lookup_enum(template_name) in {
                            .Some(template) then Option[InstantiationKey].Some(InstantiationKey.EnumType(template.def_id, args)),
                            .None() then Option[InstantiationKey].None(),
                        };
                    },
                    .None() then Option[InstantiationKey].None(),
                },
                .None() then Option[InstantiationKey].None(),
            };
        },
        _ then Option[InstantiationKey].None(),
    };
};

// Swift CodeGen.isStdDropTraitDefId: identity is the declaration DefId, not the
// name. A user trait that happens to be called `Drop` must NOT satisfy this — the
// `info.def_id == id` equality is what rejects it, and no name comparison can.
public let is_std_drop_trait_def_id(mono Monomorphizer, trait_def_id Option[DefId]) Bool = {
    return when trait_def_id in {
        .Some(id) then {
            let trait_name = mono.storage.context.get_name(id) or else "";
            if trait_name <> "Drop" then { return false; };
            yield when mono.storage.generic_templates.traits.get(trait_name) in {
                .Some(info) then {
                    if info.def_id <> id then { return false; };
                    if info.module_path.is_empty() then { return true; };
                    let root = info.module_path[0(UInt)];
                    yield root == "Std" or root == "std";
                },
                .None() then false,
            };
        },
        .None() then false,
    };
};

file_private let is_std_drop_trait_conformance(mono Monomorphizer, conformance_trait_name Option[String]) Bool = {
    return when conformance_trait_name in {
        .Some(trait_name) then {
            if trait_name <> "Drop" and not trait_name.ends_with(".Drop") then { return false;};
            yield when mono.storage.generic_templates.traits.get(trait_name) in {
                .Some(info) then {
                    if info.module_path.is_empty() then { return true;};
                    let root = info.module_path[0(UInt)];
                    yield root == "Std" or root == "std";
                },
                .None() then true,
            };
        },
        .None() then false,
    };
};

// ── make_extension_method_layout_name ────────────────────────────────────────

// Generate the layout name for an extension method.
//
// Format (no method type args):
//   "<template_name>_<type_arg1_key>_..._<method_name>"
//
// Format (with method type args):
//   "<template_name>_<type_arg1_key>_..._<method_name>_<method_arg1_key>_..."
//
// Examples:
//   make_extension_method_layout_name("List",  [Int],         "push",  [])       → "List_Int_push"
//   make_extension_method_layout_name("Dict",   [String, Int], "get",   [])       → "Dict_String_Int_get"
//   make_extension_method_layout_name("List",  [Int],         "map",   [String]) → "List_Int_map_String"
public let make_extension_method_layout_name(
    mono Monomorphizer,
    template_name String,
    type_args List[Type],
    method_name String,
    method_type_args List[Type],
) String = {
    let mutable out = StringBuilder.new();
    out.push_string(template_name);
    for a in type_args then {
        out.push_string("_");
        out.push_string(instantiation_layout_key(mono, a));
    };
    out.push_string("_");
    out.push_string(method_name);
    for a in method_type_args then {
        out.push_string("_");
        out.push_string(instantiation_layout_key(mono, a));
    };
    return out.to_string();
};

public let make_extension_method_lookup_key(
    mono Monomorphizer,
    base_name String,
    method_name String,
    method_type_args List[Type],
) String = {
    let mutable out = StringBuilder.new();
    out.push_string("\(base_name).\(method_name)");
    for a in method_type_args then {
        out.push_string(".");
        out.push_string(instantiation_layout_key(mono, a));
    };
    return out.to_string();
};

// ── has_generic_parameter ─────────────────────────────────────────────────────

// Returns true if the type contains any GenericParameter variant.
// Used to detect partially-resolved types that should skip code generation.
public let has_generic_parameter(t Type) Bool = {
    return when t in {
        .GenericParameter(_) then true,
        .ReferenceType(inner) then has_generic_parameter(inner),
        .MutableReferenceType(inner) then has_generic_parameter(inner),
        .BorrowedReferenceType(inner) then has_generic_parameter(inner),
        .MutableBorrowedReferenceType(inner) then has_generic_parameter(inner),
        .PointerType(inner) then has_generic_parameter(inner),
        .MutablePointerType(inner) then has_generic_parameter(inner),
        .WeakReferenceType(inner) then has_generic_parameter(inner),
        .MutableWeakReferenceType(inner) then has_generic_parameter(inner),
        .FunctionType(fn_params, return_type) then {
            let param_types = param_entry_types(fn_params);
            for pt in param_types then {
                if has_generic_parameter(pt) then { return true;};
            };
            yield has_generic_parameter(return_type);
        },
        .GenericStruct(_, _, args) then {
            for a in args then {
                if has_generic_parameter(a) then { return true;};
            };
            yield false;
        },
        .GenericEnum(_, _, args) then {
            for a in args then {
                if has_generic_parameter(a) then { return true;};
            };
            yield false;
        },
        .TraitObject(_, _, args) then {
            for a in args then {
                if has_generic_parameter(a) then { return true;};
            };
            yield false;
        },
        _ then false,
    };
};

// ── args_have_generic_parameter ───────────────────────────────────────────────

// Returns true if any type in the args list is still unresolved enough that
// monomorphization should not materialize a concrete layout yet.
public let args_have_generic_parameter(args List[Type]) Bool = {
    for a in args then {
        if has_generic_parameter(a) or is_placeholder_inferred_type(a) then { return true;};
    };
    return false;
};

// ── instantiate_struct ────────────────────────────────────────────────────────

// Instantiate a generic struct template with concrete type arguments.
//
// Steps:
//   a. If any type arg is a GenericParameter, return partial GenericStruct (skip codegen)
//   b. Generate layout name
//   c. Check instantiated_types cache
//   d. Build type substitution map
//   e. Resolve each field's TypeNode to a concrete Type
//   f. Create TypeStructDecl and add to generated_nodes
//   g. Cache in instantiated_types
//   h. If template has drop, enqueue ExtensionMethod instantiation request
//   i. Return StructureType(def_id)
//
public let instantiate_struct(mono Monomorphizer, template GenericStructTemplate, args List[Type]) Type = {
    if args.count() <> template.type_parameters.count() then {
        mono.report_monomorphization_error(
            template.def_id,
            "Monomorphization error: struct type arg arity mismatch for \(template.name) - expected \(template.type_parameters.count()), got \(args.count())"
        );
        return Type.Unknown();
    };

    // a. If any type arg contains an unresolved GenericParameter, skip code generation
    //    and return a partial GenericStruct type.
    if args_have_generic_parameter(args) then {
        return Type.GenericStruct(template.name, template.def_id, args);
    };

    // b. Generate the layout name.
    let layout_name = make_layout_name(mono, template.name, args, template.def_id);

    // c. Check instantiated_types cache.
    let mutable type_arg_list = List[Type].new();
    for a in args then {
        type_arg_list.push(a);
    };
    let cache_key = InstantiationKey.StructType(template.def_id, type_arg_list);
    when mono.storage.instantiated_types.get(cache_key) in {
        .Some(cached) then { return cached;},
        .None() then {},
    };

    // Create a placeholder concrete type before resolving fields so recursive
    // references through ref/Option can reuse it instead of tripping cycle detection.
    let def_id = mono.storage.context.allocate(layout_name, DefKind.TypeDef(TypeDefKind.Structure()));
    let mutable concrete_type = Type.StructureType(def_id);
    mono.storage.instantiated_types.insert(cache_key, concrete_type);

    // Propagate the template's nominal mutability to the concrete instantiation
    // so `type mutable RangeIterator[T]` correctly classifies RangeIterator_Int
    // as managed in the layout analysis. Without this, the instantiation is
    // treated as a plain value type and its iterator state is deep-copied on
    // every `next()` call, breaking for-loop termination.
    if mono.storage.context.is_struct_mutable(template.def_id) then {
        mono.storage.context.set_struct_mutable(def_id, true);
    };

    mono.storage.context.set_struct_info(def_id, StructTypeInfo(
        List[StructField].new(),
        true,
        Option[List[Type]].Some(type_arg_list),
        Option[String].Some(template.name),
        template.def_id,
    ));

    // d. Build type substitution map: template.type_parameters[i].name → args[i].
    let mutable substitution = Dict[String, Type].new();
    let mutable param_idx = 0(UInt);
    while param_idx < template.type_parameters.count() then {
        let param = template.type_parameters[param_idx];
        let arg = args[param_idx];
        substitution.insert(param.name, arg);
        param_idx += 1(UInt);
    };

    // e. Resolve each field's TypeNode to a concrete Type.
    let mutable concrete_fields = List[TypedField].new();
    for field in template.fields then {
        let resolved_type = resolve_parameterized_type(mono, mono.resolve_type_node_impl(field.field_type, substitution));

        concrete_fields.push(TypedField(
            field.access,
            field.name,
            field.is_mutable,
            resolved_type,
            field.named,
        ));
    };

    // Register struct fields in the DefIdMap for later use.
    let mutable struct_fields = List[StructField].new();
    for cf in concrete_fields then {
        struct_fields.push(StructField(cf.name, cf.field_type, cf.is_mutable, cf.access, cf.named));
    };
    // 使用 set_struct_info 记录完整的泛型实例化信息
    mono.storage.context.set_struct_info(def_id, StructTypeInfo(
        struct_fields,
        true,
        Option[List[Type]].Some(type_arg_list),
        Option[String].Some(template.name),
        template.def_id,
    ));

    // i. Create TypeStructDecl and add to generated_nodes.
    let decl = TypedDecl.TypeStructDecl(
        AccessModifier.Public(),
        layout_name,
        concrete_fields,
        unknown_span(),
        Symbol(def_id, concrete_type, SymbolKind.TypeSymbol()),
    );
    mono.storage.generated_nodes.push(decl);

    // Record template info for error messages and final trait pass.
    mono.storage.layout_to_template_info.insert(layout_name, TemplateInfo(template.name, args));

    // j. Cache in instantiated_types.
    mono.storage.instantiated_types.insert(cache_key, concrete_type);

    // h. Force instantiate drop if this type conforms to std Drop.
    //    All other extension methods are instantiated on-demand when called,
    //    via try_bind_generic_method_call during monomorphization.
    let template_lookup_name = mono.storage.context.get_name(template.def_id) or else template.name;
    when mono.storage.generic_templates.lookup_extension_methods(template_lookup_name) in {
        .Some(ext_templates) then {
            for ext_template in ext_templates then {
                if ext_template.method.name == "drop" or is_std_drop_trait_def_id(mono, ext_template.conformance_trait_def_id) then {
                    let _ = mono.instantiate_extension_method_impl(
                        concrete_type,
                        template_lookup_name,
                        ext_template,
                        args,
                        List[Type].new(),
                    );
                };
            };
        },
        .None() then {},
    };

    // m. Return the concrete StructureType.
    return concrete_type;
};

// ── instantiate_enum ─────────────────────────────────────────────────────────

// Instantiate a generic enum template with concrete type arguments.
//
// Steps:
//   a. If any type arg is a GenericParameter, return partial GenericEnum (skip codegen)
//   b. Generate layout name
//   c. Check instantiated_types cache
//   d. Build type substitution map
//   e. Resolve each case's param TypeNodes to concrete Types
//   f. Create TypeEnumDecl and add to generated_nodes
//   g. Cache in instantiated_types
//   h. If template has drop, enqueue ExtensionMethod instantiation request
//   i. Return EnumType(def_id)
//
public let instantiate_enum(mono Monomorphizer, template GenericEnumTemplate, args List[Type]) Type = {
    if args.count() <> template.type_parameters.count() then {
        mono.report_monomorphization_error(
            template.def_id,
            "Monomorphization error: enum type arg arity mismatch for \(template.name) - expected \(template.type_parameters.count()), got \(args.count())"
        );
        return Type.Unknown();
    };

    // a. If any type arg contains an unresolved GenericParameter, skip code generation
    //    and return a partial GenericEnum type.
    if args_have_generic_parameter(args) then {
        return Type.GenericEnum(template.name, template.def_id, args);
    };

    // b. Generate the layout name.
    let layout_name = make_layout_name(mono, template.name, args, template.def_id);

    // c. Check instantiated_types cache.
    let mutable type_arg_list = List[Type].new();
    for a in args then {
        type_arg_list.push(a);
    };
    let cache_key = InstantiationKey.EnumType(template.def_id, type_arg_list);
    when mono.storage.instantiated_types.get(cache_key) in {
        .Some(cached) then { return cached;},
        .None() then {},
    };

    // Create a placeholder concrete type before resolving case parameters so
    // recursive references through ref can reuse it instead of tripping cycle detection.
    let def_id = mono.storage.context.allocate(layout_name, DefKind.TypeDef(TypeDefKind.Enum()));
    let mutable concrete_type = Type.EnumType(def_id);
    mono.storage.instantiated_types.insert(cache_key, concrete_type);

    mono.storage.context.set_enum_info(def_id, EnumTypeInfo(
        List[EnumCaseInfo].new(),
        true,
        Option[List[Type]].Some(type_arg_list),
        Option[String].Some(template.name),
        template.def_id,
    ));

    // d. Build type substitution map: template.type_parameters[i].name → args[i].
    let mutable substitution = Dict[String, Type].new();
    let mutable param_idx = 0(UInt);
    while param_idx < template.type_parameters.count() then {
        let param = template.type_parameters[param_idx];
        let arg = args[param_idx];
        substitution.insert(param.name, arg);
        param_idx += 1(UInt);
    };

    // e. Resolve each case's param TypeNodes to concrete Types.
    let mutable concrete_cases = List[TypedEnumCase].new();
    for case_ in template.cases then {
        let mutable concrete_fields = List[TypedEnumCaseField].new();
        for param in case_.params then {
            let resolved_type = resolve_parameterized_type(mono, mono.resolve_type_node_impl(param.param_type, substitution));

            concrete_fields.push(TypedEnumCaseField(
                param.name,
                resolved_type,
                param.named,
            ));
        };
        concrete_cases.push(TypedEnumCase(
            case_.name,
            concrete_fields,
        ));
    };

    // Register enum cases in the DefIdMap for later use.
    let mutable enum_case_infos = List[EnumCaseInfo].new();
    for cc in concrete_cases then {
        let mutable case_params = List[EnumCaseParam].new();
        for cf in cc.fields then {
            case_params.push(EnumCaseParam(cf.name, cf.field_type, cf.named));
        };
        enum_case_infos.push(EnumCaseInfo(cc.name, case_params));
    };
    // 使用 set_enum_info 记录完整的泛型实例化信息
    mono.storage.context.set_enum_info(def_id, EnumTypeInfo(
        enum_case_infos,
        true,
        Option[List[Type]].Some(type_arg_list),
        Option[String].Some(template.name),
        template.def_id,
    ));

    // i. Create TypeEnumDecl and add to generated_nodes.
    let decl = TypedDecl.TypeEnumDecl(
        AccessModifier.Public(),
        layout_name,
        concrete_cases,
        unknown_span(),
        Symbol(def_id, concrete_type, SymbolKind.TypeSymbol()),
    );
    mono.storage.generated_nodes.push(decl);

    // Record template info for error messages and final trait pass.
    mono.storage.layout_to_template_info.insert(layout_name, TemplateInfo(template.name, args));

    // j. Cache in instantiated_types.
    mono.storage.instantiated_types.insert(cache_key, concrete_type);

    // h. Force instantiate drop if this enum type conforms to std Drop.
    //    All other extension methods are instantiated on-demand when called.
    let template_lookup_name = mono.storage.context.get_name(template.def_id) or else template.name;
    when mono.storage.generic_templates.lookup_extension_methods(template_lookup_name) in {
        .Some(ext_templates) then {
            for ext_template in ext_templates then {
                if ext_template.method.name == "drop" or is_std_drop_trait_def_id(mono, ext_template.conformance_trait_def_id) then {
                    let _ = mono.instantiate_extension_method_impl(
                        concrete_type,
                        template_lookup_name,
                        ext_template,
                        args,
                        List[Type].new(),
                    );
                };
            };
        },
        .None() then {},
    };

    // m. Return the concrete EnumType.
    return concrete_type;
};
