// Generic function instantiation for the monomorphization phase.
// Implements instantiate_function, and stubs for instantiate_extension_method
// and instantiate_trait_placeholder_method (implemented in tasks 6.2 and 6.6).
//

using std::os { env }

// ── instantiate_function ──────────────────────────────────────────────────────

// Instantiate a generic function template with concrete type arguments.
//
// Steps:
//   a. If any type arg contains an unresolved GenericParameter, skip code generation
//      and return a partial InstantiatedFunction with empty mangled name
//   b. Generate the mangled name using make_layout_name
//   c. Check instantiated_functions cache
//   d. Check instantiating_functions for cycle detection
//   e. Add to instantiating_functions
//   f. Build type substitution map: template.type_parameters[i].name → args[i]
//   g. Resolve parameter types and return type using resolve_type_node
//   h. Build the concrete FunctionType
//   i. Create InstantiatedFunction and cache it BEFORE processing the body
//   j. Get the checked body: use template.checked_body if Some, otherwise look up from registry
//   k. If body exists, call substitute_types_in_expression to replace generic params
//   l. Create a FunctionDecl node and add to generated_nodes
//   m. Remove from instantiating_functions
//   n. Return the InstantiatedFunction
//
private let make_mono_function_body_placeholder_expr(t Type) * TypedExpr = {
    return box(TypedExpr(box(TypedExprKind.IntegerLiteral("0")), t))
}

private let pass_kind_from_type_node(node TypeNode) FunctionParamPassKind = {
    return when node in {
        .Reference(_, mutable) then if mutable then FunctionParamPassKind.ByMutableReference() else FunctionParamPassKind.ByReference(),
        .BorrowedReference(_, mutable) then if mutable then FunctionParamPassKind.ByMutableReference() else FunctionParamPassKind.ByReference(),
        _ then FunctionParamPassKind.ByValue(),
    }
}

private let should_skip_randomizable_constrained_instantiation(
    mono * Monomorphizer,
    template * GenericFunctionTemplate,
    args List[* Type],
) Bool = {
    let mut i UInt = 0
    while i < template.type_parameters.count() and i < args.count() then {
        let param = template.type_parameters[i]
        let actual_type = resolve_parameterized_type(mono, (*args[i]))
        for constraint in param.constraints then {
            let trait_name_opt = when constraint in {
                .Identifier(name) then Option[String].Some(name),
                .Generic(base, _) then Option[String].Some(base),
                _ then Option[String].None(),
            }
            when trait_name_opt in {
                .Some(trait_name) then {
                    if trait_name == "Randomizable" or trait_name.ends_with(".Randomizable") then {
                        if not type_satisfies_trait_constraint(mono, actual_type, trait_name) then {
                            return true
                        }
                    }
                },
                .None() then {},
            }
        }
        i += 1
    }
    return false
}

public let instantiate_function(mono * Monomorphizer, template * GenericFunctionTemplate, args List[* Type]) InstantiatedFunction = {
    // a. If any type arg contains an unresolved GenericParameter, skip code generation
    //    and return a partial InstantiatedFunction with empty mangled name.
    if args_have_generic_parameter(args) then {
        return InstantiatedFunction("", Type.Unknown())
    }

    // Defensive guard: if inferred type args do not fully match template arity,
    // skip instantiation and let callers fall back to existing symbol resolution.
    if args.count() <> template.type_parameters.count() then {
        return InstantiatedFunction("", Type.Unknown())
    }

    // Narrow guard for known bad speculative specializations in Randomizable flows
    // (e.g. Random.next[T Randomizable] instantiating with non-Randomizable T).
    if should_skip_randomizable_constrained_instantiation(mono, template, args) then {
        return InstantiatedFunction("", Type.Unknown())
    }

    // b. Generate the mangled name.
    let mangled_name = make_layout_name(mono, template.name, args)

    // c. Check instantiated_functions cache.
    when mono.storage.instantiated_functions.get(mangled_name) in {
        .Some(cached) then { return cached },
        .None() then {},
    }

    // d. Check instantiating_functions for cycle detection.
    if mono.storage.instantiating_functions.contains(mangled_name) then {
        // Return a partial result to break the cycle; the cache will be populated
        // once the outer instantiation completes.
        return InstantiatedFunction(mangled_name, Type.Unknown())
    }

    // e. Add to instantiating_functions.
    mono.storage.instantiating_functions.insert(mangled_name)

    // f. Build type substitution map: template.type_parameters[i].name → args[i].
    let mut substitution = Dict[String, Type].new()
    let mut param_idx = 0(UInt)
    while param_idx < template.type_parameters.count() then {
        let param = template.type_parameters[param_idx]
        let arg = args[param_idx]
        substitution.insert(param.name, *arg)
        param_idx += 1(UInt)
    }

    // g. Resolve parameter types and return type using resolve_type_node.
    let mut concrete_param_types = List[* Type].new()
    let mut concrete_params = List[TypedParam].new()

    // Use checked_parameters if available, otherwise resolve from template parameters.
    when template.checked_parameters in {
        .Some(checked_params_list) then {
            for sym in checked_params_list then {
                let substituted_type = mono.substitute_type_impl(sym.symbol_type, substitution)
                let resolved_type = resolve_parameterized_type(mono, substituted_type)
                concrete_params.push(TypedParam(mono.storage.context.symbol_name(sym), sym.is_mutable(), resolved_type, false))
                concrete_param_types.push(box(resolved_type))
            }
        },
        .None() then {
            // Fall back to resolving from template parameters via TypeNode.
            for p in template.parameters then {
                let resolved_type = mono.resolve_type_node_impl(p.param_type, substitution)
                concrete_params.push(TypedParam(p.name, p.mutable, resolved_type, p.named))
                concrete_param_types.push(box(resolved_type))
            }
        },
    }

    // Resolve return type.
    let concrete_return_type = when template.checked_return_type in {
        .Some(checked_ret) then resolve_parameterized_type(mono, mono.substitute_type_impl(checked_ret, substitution)),
        .None() then mono.resolve_type_node_impl(template.return_type, substitution),
    }

    // h. Build the concrete FunctionType, preserving declared pass kinds.
    let mut function_param_entries = List[* FunctionParamEntry].new()
    let mut function_param_index = 0(UInt)
    while function_param_index < concrete_params.count() then {
        let declared_param = template.parameters[function_param_index]
        function_param_entries.push(box(FunctionParamEntry(
            concrete_params[function_param_index].param_type,
            pass_kind_from_type_node(declared_param.param_type)
        )))
        function_param_index += 1(UInt)
    }
    let function_type = Type.FunctionType(function_param_entries, box(concrete_return_type))

    let template_module_path = mono.storage.context.get_module_path(template.def_id) or else List[String].new()
    let template_source_file = mono.storage.context.get_source_file(template.def_id) or else ""
    let template_access = mono.storage.context.get_access(template.def_id) or else AccessModifier.Public()
    let template_span = mono.storage.context.get_span(template.def_id) or else unknown_span()

    // Allocate a new DefId for the concrete function with full metadata so
    // later phases can recover it from the emitted declaration structurally.
    let def_id = mono.storage.context.allocate_full(
        mangled_name,
        DefKind.Function(),
        template_module_path,
        template_source_file,
        template_access,
        template_span,
    )

    // Register the function signature in the DefIdMap.
    let mut param_specs = List[FunctionParamSpec].new()
    for p in concrete_params then {
        param_specs.push(FunctionParamSpec(p.name, p.mutable, p.named))
    }
    mono.storage.context.set_symbol_info(def_id, SymbolInfo(function_type, SymbolKind.Function(), MethodKind.Normal(), false))
    mono.storage.context.set_param_specs(def_id, param_specs)
    mono.storage.context.set_cname(def_id, mangled_name)

    // i. Create InstantiatedFunction and cache it BEFORE processing the body
    //    to support recursive functions.
    let result = InstantiatedFunction(mangled_name, function_type)
    mono.storage.instantiated_functions.insert(mangled_name, result)

    // Also register the symbol for this function.
    let func_symbol = Symbol(def_id, function_type, SymbolKind.Function())
    mono.storage.instantiated_function_symbols.insert(mangled_name, func_symbol)

    // Record the DefId remapping from the generic template's DefId to the concrete one.
    when mono.storage.remapped_function_def_ids.get(template.def_id.id) in {
        .Some(existing_list) then {
            let mut updated = existing_list
            updated.push(Pair(def_id, function_type))
            mono.storage.remapped_function_def_ids.insert(template.def_id.id, updated)
        },
        .None() then {
            let mut new_list = List[Pair[DefId, Type]].new()
            new_list.push(Pair(def_id, function_type))
            mono.storage.remapped_function_def_ids.insert(template.def_id.id, new_list)
        },
    }

    // Register ConcreteCallableInfo with owner_type=None so the codegen
    // uses the mangled name directly (without current_function_type_prefix).
    mono.register_concrete_callable_if_absent(
        ConcreteCallableInfo(def_id, mangled_name, Option[Type].None(), Option[String].None())
    )

    // j. Get the checked body: use template.checked_body if Some,
    //    otherwise look up from GenericTemplateRegistry.
    let body_opt = when template.checked_body in {
        .Some(body) then Option[* TypedExpr].Some(body),
        .None() then {
            // Look up the latest version from the registry.
            break when mono.storage.generic_templates.lookup_function_by_def_id(template.def_id) in {
                .Some(latest_template_ref) then {
                    break when latest_template_ref.checked_body in {
                        .Some(latest_body) then Option[* TypedExpr].Some(latest_body),
                        .None() then Option[* TypedExpr].None(),
                    }
                },
                .None() then {
                    break when mono.storage.generic_templates.lookup_function(template.name) in {
                        .Some(latest_template_ref) then {
                            break when latest_template_ref.checked_body in {
                                .Some(latest_body) then Option[* TypedExpr].Some(latest_body),
                                .None() then Option[* TypedExpr].None(),
                            }
                        },
                        .None() then Option[* TypedExpr].None(),
                    }
                },
            }
        },
    }

    // k. If body exists, substitute generic params with concrete types.
    when body_opt in {
        .Some(body) then {
            let concrete_body = mono.substitute_types_in_expression_impl(body, substitution)
            let resolved_concrete_body = resolve_types_in_expression(mono, concrete_body)
            let mut context = mono.storage.context
            context.set_concrete_function_body(def_id, resolved_concrete_body)
            mono.storage.resolved_function_body_ids.insert(def_id.id)

            // l. Create a FunctionDecl node and add to generated_nodes.
            let mut fn_param_type_refs = List[* Type].new()
            for cp in concrete_params then { fn_param_type_refs.push(box(cp.param_type)) }
            let decl = TypedDecl.FunctionDecl(
                template_access,
                mangled_name,
                concrete_params,
                concrete_return_type,
                make_mono_function_body_placeholder_expr(concrete_return_type),
                template_span,
                box(Symbol(def_id, function_type, SymbolKind.Function())),
            )
            mono.storage.generated_nodes.push(box(decl))
        },
        .None() then {
            // No body available — this is an intrinsic or forward declaration.
            // Emit an IntrinsicFunctionDecl so the symbol is still visible.
            let decl = TypedDecl.IntrinsicFunctionDecl(
                template_access,
                mangled_name,
                concrete_params,
                concrete_return_type,
                template_span,
                box(Symbol(def_id, Type.Unknown(), SymbolKind.Function())),
            )
            mono.storage.generated_nodes.push(box(decl))
        },
    }

    // m. Remove from instantiating_functions.
    mono.storage.instantiating_functions.remove(mangled_name)

    // n. Return the InstantiatedFunction.
    return result
}

// ── select_extension_template ─────────────────────────────────────────────────

// Select the best matching extension method template from a list of candidates.
//
// Filters by:
//   - method name must match
//   - method type parameter count must match (if provided)
//   - extension type parameter count must match (if provided)
//
// Among matching candidates, prefer one with a checked body source.
//
public let select_extension_template(
    extensions List[* GenericExtensionMethodTemplate],
    name String,
    method_type_arg_count Option[UInt],
    extension_type_arg_count Option[UInt],
) Option[* GenericExtensionMethodTemplate] = {
    let mut first_match = Option[* GenericExtensionMethodTemplate].None()
    for ext_ref in extensions then {
        if ext_ref.method.name <> name then { continue }
        when method_type_arg_count in {
            .Some(count) then {
                if ext_ref.method.type_params.count() <> count then { continue }
            },
            .None() then {},
        }
        when extension_type_arg_count in {
            .Some(count) then {
                if ext_ref.type_params.count() <> count then { continue }
            },
            .None() then {},
        }
        if ext_ref.checked_body is .Some(_) then {
            return Option[* GenericExtensionMethodTemplate].Some(ext_ref)
        }
        when first_match in {
            .Some(_) then {},
            .None() then {
                first_match = Option[* GenericExtensionMethodTemplate].Some(ext_ref)
            },
        }
    }
    return first_match
}

private let select_conformance_extension_template(
    mono * Monomorphizer,
    base_type Type,
    method_name String,
    method_type_arg_count Option[UInt],
) Option[* GenericExtensionMethodTemplate] = {
    let parameterized_base_type = resolve_parameterized_type(mono, base_type)
    let count_key = when method_type_arg_count in {
        .Some(count) then count.to_string(),
        .None() then "*",
    }
    let cache_key = "\(stable_type_key(parameterized_base_type))|\(method_name)|\(count_key)"
    if mono.storage.conformance_extension_template_missing.contains(cache_key) then {
        return Option[* GenericExtensionMethodTemplate].None()
    }
    when mono.storage.conformance_extension_template_cache.get(cache_key) in {
        .Some(cached) then { return Option[* GenericExtensionMethodTemplate].Some(cached) },
        .None() then {},
    }

    let mut first_match = Option[* GenericExtensionMethodTemplate].None()
    for ext_entry in mono.storage.generic_templates.extension_methods then {
        for ext_ref in ext_entry.second then {
            if ext_ref.method.name <> method_name then {
                continue
            }
            when method_type_arg_count in {
                .Some(count) then {
                    if ext_ref.method.type_params.count() <> count then {
                        continue
                    }
                },
                .None() then {},
            }
            let target_type = when ext_ref.conformance_target_type in {
                .Some(target) then target,
                .None() then { continue },
            }
            if not trait_conformance_target_matches(mono, target_type, parameterized_base_type)
                and not trait_conformance_target_matches_for_template_binding(mono, target_type, parameterized_base_type)
            then {
                continue
            }
            if ext_ref.checked_body is .Some(_) then {
                mono.storage.conformance_extension_template_cache.insert(cache_key, ext_ref)
                return Option[* GenericExtensionMethodTemplate].Some(ext_ref)
            }
            when first_match in {
                .Some(_) then {},
                .None() then {
                    first_match = Option[* GenericExtensionMethodTemplate].Some(ext_ref)
                },
            }
        }
    }
    when first_match in {
        .Some(template_ref) then {
            mono.storage.conformance_extension_template_cache.insert(cache_key, template_ref)
        },
        .None() then {
            mono.storage.conformance_extension_template_missing.insert(cache_key)
        },
    }
    return first_match
}

private let patched_extension_template_with_body(
    template * GenericExtensionMethodTemplate,
    donor * GenericExtensionMethodTemplate,
) * GenericExtensionMethodTemplate = {
    return box(GenericExtensionMethodTemplate(
        template.type_params,
        donor.method,
        template.conformance_trait_name,
        template.conformance_target_type,
        template.conformance_trait_args,
        template.uses_trait_type_params,
        template.source_file,
        template.module_path,
        template.package_id,
        donor.checked_body,
        donor.checked_parameters,
        donor.checked_return_type,
    ))
}

public let lookup_extension_template_checked_body(
    mono * Monomorphizer,
    template * GenericExtensionMethodTemplate,
) Option[* TypedExpr] = template.checked_body

private let concrete_extension_def_id_is_materialized(mono * Monomorphizer, def_id DefId) Bool = {
    for node_ref in mono.storage.generated_nodes then {
        when node_ref in {
            .FunctionDecl(_, _, _, _, _, _, id) then {
                if id.def_id.id == def_id.id then { return true }
            },
            .IntrinsicFunctionDecl(_, _, _, _, _, id) then {
                if id.def_id.id == def_id.id then { return true }
            },
            .GivenDecl(_, members, _) then {
                for member_ref in members then {
                    if member_ref.def_id.id == def_id.id then { return true }
                }
            },
            .GivenTraitDecl(_, _, _, members, _) then {
                for member_ref in members then {
                    if member_ref.def_id.id == def_id.id then { return true }
                }
            },
            .IntrinsicGivenDecl(_, members, _) then {
                for member_ref in members then {
                    if member_ref.def_id.id == def_id.id then { return true }
                }
            },
            _ then {},
        }
    }
    return false
}


// Resolve a StructureType/EnumType def_id to a (template_name, type_args) pair.
// Tries in order: context.get_template_name + get_type_arguments, layout_to_template_info, context.lookup_type.
// Returns None if none of the sources produce a template name.
private let resolve_template_name_and_args(mono * Monomorphizer, def_id DefId) Option[Pair[String, List[Type]]] = {
    when mono.storage.context.get_template_name(def_id) in {
        .Some(template_name) then {
            when mono.storage.context.get_type_arguments(def_id) in {
                .Some(type_args) then { return Option[Pair[String, List[Type]]].Some(Pair[String, List[Type]](template_name, type_args)) },
                .None() then {},
            }
            let layout_name = mono.storage.context.get_name(def_id) or else ""
            when mono.storage.layout_to_template_info.get(layout_name) in {
                .Some(info) then {
                    let mut args = List[Type].new()
                    for type_arg in info.args then { args.push(*type_arg) }
                    return Option[Pair[String, List[Type]]].Some(Pair[String, List[Type]](info.base_name, args))
                },
                .None() then {},
            }
            when mono.storage.context.lookup_type(def_id) in {
                .Some(mapped_type) then {
                    when mapped_type in {
                        .GenericStruct(_, args) then {
                            let mut concrete_args = List[Type].new()
                            for a in args then { concrete_args.push(*a) }
                            return Option[Pair[String, List[Type]]].Some(Pair[String, List[Type]](template_name, concrete_args))
                        },
                        .GenericEnum(_, args) then {
                            let mut concrete_args = List[Type].new()
                            for a in args then { concrete_args.push(*a) }
                            return Option[Pair[String, List[Type]]].Some(Pair[String, List[Type]](template_name, concrete_args))
                        },
                        _ then {},
                    }
                },
                .None() then {},
            }
            return Option[Pair[String, List[Type]]].Some(Pair[String, List[Type]](template_name, List[Type].new()))
        },
        .None() then {
            let layout_name = mono.storage.context.get_name(def_id) or else ""
            when mono.storage.layout_to_template_info.get(layout_name) in {
                .Some(info) then {
                    let mut args = List[Type].new()
                    for type_arg in info.args then { args.push(*type_arg) }
                    return Option[Pair[String, List[Type]]].Some(Pair[String, List[Type]](info.base_name, args))
                },
                .None() then {},
            }
            when mono.storage.context.lookup_type(def_id) in {
                .Some(mapped_type) then {
                    when mapped_type in {
                        .GenericStruct(name, args) then {
                            let mut concrete_args = List[Type].new()
                            for a in args then { concrete_args.push(*a) }
                            return Option[Pair[String, List[Type]]].Some(Pair[String, List[Type]](name, concrete_args))
                        },
                        .GenericEnum(name, args) then {
                            let mut concrete_args = List[Type].new()
                            for a in args then { concrete_args.push(*a) }
                            return Option[Pair[String, List[Type]]].Some(Pair[String, List[Type]](name, concrete_args))
                        },
                        _ then {},
                    }
                },
                .None() then {},
            }
            return Option[Pair[String, List[Type]]].None()
        },
    }
}

private let trait_name_matches(left String, right String) Bool = {
    if left == right then {
        return true
    }
    if left.ends_with(".\(right)") then {
        return true
    }
    if right.ends_with(".\(left)") then {
        return true
    }
    return false
}

private let lookup_extension_methods_fuzzy(
    mono * Monomorphizer,
    name String,
) Option[List[* GenericExtensionMethodTemplate]] = {
    if mono.storage.fuzzy_extension_methods_missing.contains(name) then {
        return Option[List[* GenericExtensionMethodTemplate]].None()
    }
    when mono.storage.fuzzy_extension_methods_cache.get(name) in {
        .Some(cached) then { return Option[List[* GenericExtensionMethodTemplate]].Some(cached) },
        .None() then {},
    }

    when mono.storage.generic_templates.lookup_extension_methods(name) in {
        .Some(exact) then {
            mono.storage.fuzzy_extension_methods_cache.insert(name, exact)
            return Option[List[* GenericExtensionMethodTemplate]].Some(exact)
        },
        .None() then {},
    }

    let mut merged = List[* GenericExtensionMethodTemplate].new()
    for entry in mono.storage.generic_templates.extension_methods then {
        if not trait_name_matches(entry.first, name) then {
            continue
        }
        for template_ref in entry.second then {
            merged.push(template_ref)
        }
    }
    if merged.is_empty() then {
        mono.storage.fuzzy_extension_methods_missing.insert(name)
        return Option[List[* GenericExtensionMethodTemplate]].None()
    }
    mono.storage.fuzzy_extension_methods_cache.insert(name, merged)
    return Option[List[* GenericExtensionMethodTemplate]].Some(merged)
}

private let select_trait_tool_template_cached(
    mono * Monomorphizer,
    trait_name String,
    method_name String,
    method_type_arg_count Option[UInt],
    trait_arg_count Option[UInt],
) Option[* GenericExtensionMethodTemplate] = {
    let method_count_key = when method_type_arg_count in {
        .Some(count) then count.to_string(),
        .None() then "*",
    }
    let trait_count_key = when trait_arg_count in {
        .Some(count) then count.to_string(),
        .None() then "*",
    }
    let cache_key = "\(trait_name)|\(method_name)|\(method_count_key)|\(trait_count_key)"

    if mono.storage.trait_tool_template_missing.contains(cache_key) then {
        return Option[* GenericExtensionMethodTemplate].None()
    }
    when mono.storage.trait_tool_template_cache.get(cache_key) in {
        .Some(cached) then { return Option[* GenericExtensionMethodTemplate].Some(cached) },
        .None() then {},
    }

    let selected = when lookup_extension_methods_fuzzy(mono, trait_name) in {
        .Some(tool_templates) then select_extension_template(
            tool_templates,
            method_name,
            method_type_arg_count,
            trait_arg_count,
        ),
        .None() then Option[* GenericExtensionMethodTemplate].None(),
    }

    when selected in {
        .Some(template_ref) then mono.storage.trait_tool_template_cache.insert(cache_key, template_ref),
        .None() then mono.storage.trait_tool_template_missing.insert(cache_key),
    }
    return selected
}

private let lookup_given_trait_decls_fuzzy(
    mono * Monomorphizer,
    trait_name String,
) Option[List[* TypedDecl]] = {
    if mono.storage.fuzzy_given_trait_decls_missing.contains(trait_name) then {
        return Option[List[* TypedDecl]].None()
    }
    when mono.storage.fuzzy_given_trait_decls_cache.get(trait_name) in {
        .Some(cached) then { return Option[List[* TypedDecl]].Some(cached) },
        .None() then {},
    }

    let mut matches = List[* TypedDecl].new()
    for node_ref in mono.storage.source_given_decls then {
        when node_ref in {
            .GivenTraitDecl(_, node_trait_name, _, _, _) then {
                if trait_name_matches(node_trait_name, trait_name) then {
                    matches.push(node_ref)
                }
            },
            _ then {},
        }
    }

    if matches.is_empty() then {
        mono.storage.fuzzy_given_trait_decls_missing.insert(trait_name)
        return Option[List[* TypedDecl]].None()
    }
    mono.storage.fuzzy_given_trait_decls_cache.insert(trait_name, matches)
    return Option[List[* TypedDecl]].Some(matches)
}

private let normalize_trait_conformance_actual_type_for_template_binding(mono * Monomorphizer, actual Type) Type = {
    let normalized = normalize_trait_conformance_actual_type(mono, actual)
    let mut out = normalized
    when normalized in {
        .StructureType(def_id) then {
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then {
                    let mut mapped_args = List[* Type].new()
                    for arg in info.second then {
                        mapped_args.push(box(resolve_parameterized_type(mono, arg)))
                    }
                    out = Type.GenericStruct(info.first, mapped_args)
                },
                .None() then {},
            }
        },
        .EnumType(def_id) then {
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then {
                    let mut mapped_args = List[* Type].new()
                    for arg in info.second then {
                        mapped_args.push(box(resolve_parameterized_type(mono, arg)))
                    }
                    out = Type.GenericEnum(info.first, mapped_args)
                },
                .None() then {},
            }
        },
        _ then {},
    }
    return out
}

private let trait_conformance_target_matches_for_template_binding(mono * Monomorphizer, pattern Type, actual Type) Bool = {
    let normalized_pattern = normalize_trait_conformance_actual_type_for_template_binding(mono, pattern)
    let normalized_actual = normalize_trait_conformance_actual_type_for_template_binding(mono, actual)
    return when normalized_pattern in {
        .GenericStruct(pattern_template, pattern_args) then when normalized_actual in {
            .GenericStruct(actual_template, actual_args) then pattern_template == actual_template and pattern_args.count() == actual_args.count(),
            .StructureType(def_id) then when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then info.first == pattern_template and info.second.count() == pattern_args.count(),
                .None() then when mono.storage.context.get_template_name(def_id) in {
                    .Some(template_name) then template_name == pattern_template,
                    .None() then false,
                },
            },
            _ then false,
        },
        .GenericEnum(pattern_template, pattern_args) then when normalized_actual in {
            .GenericEnum(actual_template, actual_args) then pattern_template == actual_template and pattern_args.count() == actual_args.count(),
            .EnumType(def_id) then when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then info.first == pattern_template and info.second.count() == pattern_args.count(),
                .None() then when mono.storage.context.get_template_name(def_id) in {
                    .Some(template_name) then template_name == pattern_template,
                    .None() then false,
                },
            },
            _ then false,
        },
        _ then layout_key(pattern) == layout_key(normalized_actual),
    }
}

private let trait_conformance_target_shallow_matches(mono * Monomorphizer, pattern Type, actual Type) Bool = {
    let normalized_pattern = normalize_trait_conformance_actual_type(mono, pattern)
    let normalized_actual = normalize_trait_conformance_actual_type(mono, actual)
    return when normalized_pattern in {
        .GenericStruct(pattern_template, pattern_args) then when normalized_actual in {
            .GenericStruct(actual_template, actual_args) then pattern_template == actual_template and pattern_args.count() == actual_args.count(),
            .StructureType(def_id) then when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then info.first == pattern_template and info.second.count() == pattern_args.count(),
                .None() then when mono.storage.context.get_template_name(def_id) in {
                    .Some(template_name) then template_name == pattern_template,
                    .None() then false,
                },
            },
            _ then false,
        },
        .GenericEnum(pattern_template, pattern_args) then when normalized_actual in {
            .GenericEnum(actual_template, actual_args) then pattern_template == actual_template and pattern_args.count() == actual_args.count(),
            .EnumType(def_id) then when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then info.first == pattern_template and info.second.count() == pattern_args.count(),
                .None() then when mono.storage.context.get_template_name(def_id) in {
                    .Some(template_name) then template_name == pattern_template,
                    .None() then false,
                },
            },
            _ then false,
        },
        _ then trait_conformance_target_matches(mono, pattern, actual),
    }
}

private let collect_trait_conformance_bindings_for_template_binding(
    mono * Monomorphizer,
    pattern Type,
    actual Type,
    bindings *mut Dict[String, Type],
) Void = {
    let normalized_pattern = normalize_trait_conformance_actual_type_for_template_binding(mono, pattern)
    let normalized_actual = normalize_trait_conformance_actual_type_for_template_binding(mono, actual)
    when normalized_pattern in {
        .GenericParameter(name) then {
            if not bindings.contains_key(name) then {
                bindings.insert(name, normalized_actual)
            }
        },
        .ReferenceType(pattern_inner) then {
            when normalized_actual in {
                .ReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                .BorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .MutableReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .BorrowedReferenceType(pattern_inner) then {
            when normalized_actual in {
                .ReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                .BorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .MutableBorrowedReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .WeakReferenceType(pattern_inner) then {
            when normalized_actual in {
                .WeakReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                .MutableWeakReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .MutableWeakReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableWeakReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .PointerType(pattern_inner) then {
            when normalized_actual in {
                .PointerType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                .MutablePointerType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .MutablePointerType(pattern_inner) then {
            when normalized_actual in {
                .MutablePointerType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .GenericStruct(pattern_template, pattern_args) then {
            when normalized_actual in {
                .GenericStruct(actual_template, actual_args) then {
                    if pattern_template == actual_template and pattern_args.count() == actual_args.count() then {
                        let mut i UInt = 0
                        while i < pattern_args.count() then {
                            collect_trait_conformance_bindings_for_template_binding(mono, (*pattern_args[i]), (*actual_args[i]), bindings)
                            i += 1
                        }
                    }
                },
                _ then {},
            }
        },
        .GenericEnum(pattern_template, pattern_args) then {
            when normalized_actual in {
                .GenericEnum(actual_template, actual_args) then {
                    if pattern_template == actual_template and pattern_args.count() == actual_args.count() then {
                        let mut i UInt = 0
                        while i < pattern_args.count() then {
                            collect_trait_conformance_bindings_for_template_binding(mono, (*pattern_args[i]), (*actual_args[i]), bindings)
                            i += 1
                        }
                    }
                },
                _ then {},
            }
        },
        _ then {},
    }
}

private let infer_trait_extension_type_args_for_template_binding(
    mono * Monomorphizer,
    conformance_target Type,
    parameterized_base_type Type,
    trait_name String,
) List[* Type] = {
    let mut out = List[* Type].new()
    if not trait_conformance_target_matches_for_template_binding(mono, conformance_target, parameterized_base_type) then {
        return out
    }

    let mut bindings = Dict[String, Type].new()
    collect_trait_conformance_bindings_for_template_binding(mono, conformance_target, parameterized_base_type, &mut bindings)

    when mono.storage.generic_templates.traits.get(trait_name) in {
        .Some(info) then {
            for tp in info.type_params then {
                out.push(box(bindings.get(tp.name) or else Type.Unknown()))
            }
        },
        .None() then {},
    }
    return out
}

private let resolve_given_trait_args_for_template_binding(
    mono * Monomorphizer,
    conformance_target Type,
    trait_args List[Type],
    parameterized_base_type Type,
) List[* Type] = {
    let mut out = List[* Type].new()
    if not trait_conformance_target_matches_for_template_binding(mono, conformance_target, parameterized_base_type) then {
        return out
    }

    let mut bindings = Dict[String, Type].new()
    collect_trait_conformance_bindings_for_template_binding(mono, conformance_target, parameterized_base_type, &mut bindings)
    for trait_arg in trait_args then {
        out.push(box(resolve_parameterized_type(mono, substitute_type(mono, trait_arg, bindings))))
    }
    return out
}

private let bind_trait_extension_template_type_args(
    mono * Monomorphizer,
    base_type Type,
    template * GenericExtensionMethodTemplate,
    substitution *mut Dict[String, Type],
) Void = {
    if not template.uses_trait_type_params then {
        return
    }
    when template.conformance_trait_name in {
        .Some(trait_name) then {
            let is_explicit_given_member = conformance_method_has_explicit_body(mono, base_type, trait_name, template.method.name, true)
            if is_explicit_given_member then {
                return
            }
            let trait_args = resolve_extension_template_conformance_trait_args(mono, base_type, template)
            when mono.storage.generic_templates.traits.get(trait_name) in {
                .Some(info) then {
                    let max_count = if info.type_params.count() < trait_args.count()
                        then info.type_params.count()
                        else trait_args.count()
                    let mut trait_i UInt = 0
                    while trait_i < max_count then {
                        substitution.insert(info.type_params[trait_i].name, (*trait_args[trait_i]))
                        trait_i += 1
                    }
                },
                .None() then {},
            }
        },
        .None() then {},
    }
}

private let resolve_template_conformance_trait_args_from_metadata(
    mono * Monomorphizer,
    base_type Type,
    template * GenericExtensionMethodTemplate,
) List[* Type] = {
    let mut out = List[* Type].new()
    let parameterized_base_type = resolve_parameterized_type(mono, base_type)
    let target_type = when template.conformance_target_type in {
        .Some(target) then target,
        .None() then { return out },
    }
    if not trait_conformance_target_matches_for_template_binding(mono, target_type, parameterized_base_type) then {
        return out
    }
    let mut bindings = Dict[String, Type].new()
    collect_trait_conformance_bindings_for_template_binding(mono, target_type, parameterized_base_type, &mut bindings)
    for trait_arg in template.conformance_trait_args then {
        out.push(box(resolve_parameterized_type(mono, substitute_type(mono, trait_arg, bindings))))
    }
    return out
}

public let resolve_extension_template_conformance_trait_args(
    mono * Monomorphizer,
    base_type Type,
    template * GenericExtensionMethodTemplate,
) List[* Type] = {
    let mut out = List[* Type].new()
    let from_metadata = resolve_template_conformance_trait_args_from_metadata(mono, base_type, template)
    if not from_metadata.is_empty() then {
        return from_metadata
    }
    let trait_name = when template.conformance_trait_name in {
        .Some(name) then name,
        .None() then { return out },
    }
    let parameterized_base_type = resolve_parameterized_type(mono, base_type)
    when lookup_given_trait_decls_fuzzy(mono, trait_name) in {
        .Some(given_nodes) then {
            for node_ref in given_nodes then {
                when node_ref in {
                    .GivenTraitDecl(target_type, _, trait_args, _, _) then {
                if not trait_conformance_target_matches_for_template_binding(mono, target_type, parameterized_base_type) then {
                    continue
                }
                if not trait_args.is_empty() then {
                    let resolved = resolve_given_trait_args_for_template_binding(
                        mono,
                        target_type,
                        trait_args,
                        parameterized_base_type,
                    )
                    if not resolved.is_empty() then {
                        return resolved
                    }
                }
                let inferred = infer_trait_extension_type_args_for_template_binding(
                    mono,
                    target_type,
                    parameterized_base_type,
                    trait_name,
                )
                if not inferred.is_empty() then {
                    return inferred
                }
            },
                    _ then {},
                }
            }
        },
        .None() then {},
    }
    return out
}

private let conformance_method_has_explicit_body(
    mono * Monomorphizer,
    base_type Type,
    trait_name String,
    method_name String,
    has_checked_body Bool,
) Bool = {
    let _ = has_checked_body
    let parameterized_base_type = resolve_parameterized_type(mono, base_type)
    let mut explicit = false
    when lookup_given_trait_decls_fuzzy(mono, trait_name) in {
        .Some(given_nodes) then {
            for node_ref in given_nodes then {
                when node_ref in {
                    .GivenTraitDecl(target_type, _, _, members, _) then {
                let target_matches = trait_conformance_target_matches(mono, target_type, parameterized_base_type)
                    or trait_conformance_target_matches_for_template_binding(mono, target_type, parameterized_base_type)
                if not target_matches then {
                    continue
                }
                for member_ref in members then {
                    if member_ref.name == method_name then {
                        explicit = true
                        break
                    }
                }
            },
                    _ then {},
                }
                if explicit then {
                    break
                }
            }
        }
        .None() then {},
    }
    return explicit
}

public let instantiate_conformance_trait_methods_for_type(
    mono * Monomorphizer,
    base_type Type,
) Void = {
    let parameterized_base_type = resolve_parameterized_type(mono, base_type)
    let current_generation_version = mono.storage.generated_nodes.count()
    when mono.storage.conformance_trait_methods_scan_version.get(parameterized_base_type) in {
        .Some(scanned_version) then {
            if scanned_version == current_generation_version then {
                return
            }
        },
        .None() then {},
    }
    let mut instantiated_traits = Set[String].new()
    for node_ref in mono.storage.source_given_decls then {
        when node_ref in {
            .GivenTraitDecl(target_type, trait_name, trait_args, _, _) then {
                if not trait_conformance_target_shallow_matches(mono, target_type, parameterized_base_type) then {
                    continue
                }
                if instantiated_traits.contains(trait_name) then {
                    continue
                }
                let resolved_trait_args = if trait_args.is_empty() then
                        infer_trait_extension_type_args(mono, target_type, parameterized_base_type, trait_name)
                    else resolve_given_trait_args(mono, target_type, trait_args, parameterized_base_type)
                instantiate_trait_vtable_methods(mono, parameterized_base_type, trait_name, resolved_trait_args)
                instantiated_traits.insert(trait_name)
            },
            _ then {},
        }
    }

    // Fallback: rely on extension-template conformance metadata when source
    // given declarations are not sufficient to recover a concrete conformance
    // match for this receiver shape.
    for ext_entry in mono.storage.generic_templates.extension_methods then {
        for template_ref in ext_entry.second then {
            let trait_name = when template_ref.conformance_trait_name in {
                .Some(name) then name,
                .None() then { continue },
            }
            if instantiated_traits.contains(trait_name) then {
                continue
            }
            let conformance_target = when template_ref.conformance_target_type in {
                .Some(target) then target,
                .None() then { continue },
            }
            if not trait_conformance_target_shallow_matches(mono, conformance_target, parameterized_base_type) then {
                continue
            }
            let resolved_trait_args = resolve_extension_template_conformance_trait_args(
                mono,
                parameterized_base_type,
                template_ref,
            )
            instantiate_trait_vtable_methods(mono, parameterized_base_type, trait_name, resolved_trait_args)
            instantiated_traits.insert(trait_name)
        }
    }

    mono.storage.conformance_trait_methods_scan_version.insert(parameterized_base_type, current_generation_version)
}

// ── instantiate_extension_method ─────────────────────────────────────────────

// Instantiate a generic extension method with concrete type arguments.
//
// Outer wrapper matching Swift's instantiateExtensionMethod:
//   1. Resolve base_type via resolve_parameterized_type
//   2. Derive structure_name from the resolved type
//   3. Handle Ref/MutRef/Ptr/etc effective_template_name + effective_type_args
//   4. Look up latest template if checked_body is nil
//   5. Delegate to instantiate_extension_method_from_entry
//
public let instantiate_extension_method(
    mono * Monomorphizer,
    base_type Type,
    template_name String,
    template * GenericExtensionMethodTemplate,
    type_args List[* Type],
    method_type_args List[* Type],
) Symbol = {
    // 1. Resolve the base type if it's a parameterized type.
    let resolved_base_type = resolve_parameterized_type(mono, base_type)

    // Never materialize extension methods for unresolved placeholder/generic shapes.
    if has_generic_parameter(resolved_base_type) or is_placeholder_inferred_type(resolved_base_type) then {
        return Symbol(DefId(0(UInt)), Type.Unknown(), SymbolKind.Function())
    }
    if args_have_generic_parameter(type_args) or args_have_generic_parameter(method_type_args) then {
        return Symbol(DefId(0(UInt)), Type.Unknown(), SymbolKind.Function())
    }

    // 2. Derive structure_name from the resolved type, matching Swift's structureName.
    //    Must cover all type variants that can reach this point to avoid producing
    //    invalid C identifiers (e.g. "struct#546 ref mut" from type_display_name).
    let structure_name = when resolved_base_type in {
        .StructureType(def_id) then {
            let name = mono.storage.context.get_name(def_id) or else ""
            break mono.storage.context.get_template_name(def_id) or else name
        },
        .GenericStruct(tmpl, _) then tmpl,
        .GenericEnum(tmpl, _) then tmpl,
        .EnumType(def_id) then {
            let name = mono.storage.context.get_name(def_id) or else ""
            break mono.storage.context.get_template_name(def_id) or else name
        },
        .PointerType(_) then "Ptr",
        .MutablePointerType(_) then "MutPtr",
        .ReferenceType(_) then "Ref",
        .MutableReferenceType(_) then "MutRef",
        .BorrowedReferenceType(_) then "BorrowRef",
        .MutableBorrowedReferenceType(_) then "BorrowMutRef",
        .WeakReferenceType(_) then "WeakRef",
        .MutableWeakReferenceType(_) then "MutWeakRef",
        _ then mono.storage.context.type_display_name(resolved_base_type),
    }

    // 3. Handle Ref/MutRef/Ptr/etc effective_template_name + effective_type_args.
    //    Now that sema uses fixed keys ("Ref", "MutRef", etc.), we derive
    //    the effective template name directly from the base type structure.
    let mut effective_template_name = template_name
    let mut effective_type_args = type_args
    when base_type in {
        .ReferenceType(inner) then {
            effective_template_name = "Ref"
            if effective_type_args.is_empty() then {
                effective_type_args.push(box(*inner))
            }
        },
        .MutableReferenceType(inner) then {
            effective_template_name = "MutRef"
            if effective_type_args.is_empty() then {
                effective_type_args.push(box(*inner))
            }
        },
        .BorrowedReferenceType(inner) then {
            if effective_type_args.is_empty() then {
                effective_type_args.push(box(*inner))
            }
        },
        .MutableBorrowedReferenceType(inner) then {
            if effective_type_args.is_empty() then {
                effective_type_args.push(box(*inner))
            }
        },
        .PointerType(inner) then {
            effective_template_name = "Ptr"
            if effective_type_args.is_empty() then {
                effective_type_args.push(box(*inner))
            }
        },
        .MutablePointerType(inner) then {
            effective_template_name = "MutPtr"
            if effective_type_args.is_empty() then {
                effective_type_args.push(box(*inner))
            }
        },
        .WeakReferenceType(inner) then {
            effective_template_name = "WeakRef"
            if effective_type_args.is_empty() then {
                effective_type_args.push(box(*inner))
            }
        },
        .MutableWeakReferenceType(inner) then {
            effective_template_name = "MutWeakRef"
            if effective_type_args.is_empty() then {
                effective_type_args.push(box(*inner))
            }
        },
        _ then {},
    }

    let effective_base_type = normalize_borrowed_extension_base_type(
        resolved_base_type,
        effective_template_name,
    )

    // 4. Resolve the latest template from the registry if checked_body is missing.
    //    InstantiationRequests may carry an earlier snapshot without a checked_body.
    let resolved_template = if template.checked_body is .Some(_) then template else {
            break when mono.storage.generic_templates.lookup_extension_methods(template_name) in {
                .Some(ext_list) then {
                    break when select_extension_template(
                        ext_list,
                        template.method.name,
                        Option[UInt].Some(template.method.type_params.count()),
                        Option[UInt].Some(template.type_params.count()),
                    ) in {
                        .Some(latest) then latest,
                        .None() then template,
                    }
                },
                .None() then template,
            }
    }

    // Opportunistically materialize drop for the same concrete base when we
    // instantiate any other extension method. This covers flows where a
    // concrete generic type is only seen through method calls (e.g. Box[T].is_empty)
    // and never receives an explicit struct/enum instantiation request.
    if resolved_template.method.name <> "drop" then {
        when mono.storage.generic_templates.lookup_extension_methods(effective_template_name) in {
            .Some(ext_list) then {
                for ext_ref in ext_list then {
                    let is_drop_trait = when ext_ref.conformance_trait_name in {
                        .Some(trait_name) then trait_name == "Drop" or trait_name.ends_with(".Drop"),
                        .None() then false,
                    }
                    if ext_ref.method.name <> "drop" and not is_drop_trait then {
                        continue
                    }

                    let mut drop_type_args = effective_type_args
                    let mut inferred_args = List[* Type].new()
                    when resolved_base_type in {
                        .GenericStruct(_, args) then {
                            for arg in args then { inferred_args.push(arg) }
                        },
                        .GenericEnum(_, args) then {
                            for arg in args then { inferred_args.push(arg) }
                        },
                        .StructureType(def_id) then {
                            when mono.storage.context.get_type_arguments(def_id) in {
                                .Some(args) then {
                                    for arg in args then { inferred_args.push(box(arg)) }
                                },
                                .None() then {},
                            }
                        },
                        .EnumType(def_id) then {
                            when mono.storage.context.get_type_arguments(def_id) in {
                                .Some(args) then {
                                    for arg in args then { inferred_args.push(box(arg)) }
                                },
                                .None() then {},
                            }
                        },
                        _ then {},
                    }
                    if not inferred_args.is_empty() then {
                        drop_type_args = inferred_args
                    }

                    let expected_count = ext_ref.type_params.count()
                    if expected_count > 0(UInt) and drop_type_args.count() > expected_count then {
                        let mut trimmed = List[* Type].new()
                        let mut i = 0(UInt)
                        while i < expected_count then {
                            trimmed.push(box((*drop_type_args[i])))
                            i += 1(UInt)
                        }
                        drop_type_args = trimmed
                    }

                    let _ = mono.instantiate_extension_method_impl(
                        resolved_base_type,
                        effective_template_name,
                        ext_ref,
                        drop_type_args,
                        List[* Type].new(),
                    )
                }
            },
            .None() then {},
        }
    }

    // 5. Delegate to the inner implementation.
    return instantiate_extension_method_from_entry(
        mono,
        effective_base_type,
        structure_name,
        effective_template_name,
        effective_type_args,
        method_type_args,
        resolved_template,
    )
}

// ── instantiate_extension_method_from_entry ──────────────────────────────────

private let normalize_borrowed_extension_base_type(
    base_type Type,
    template_name String,
) Type = {
    return when template_name in {
        "Ref" then when base_type in {
            .BorrowedReferenceType(inner) then Type.ReferenceType(inner),
            .MutableBorrowedReferenceType(inner) then Type.ReferenceType(inner),
            _ then base_type,
        },
        "MutRef" then when base_type in {
            .MutableBorrowedReferenceType(inner) then Type.MutableReferenceType(inner),
            _ then base_type,
        },
        _ then base_type,
    }
}

// Inner implementation matching Swift's instantiateExtensionMethodFromEntry.
// Receives already-resolved base_type, structure_name, and resolved template.
//
// Steps:
//   a. Generate the symbol name using make_extension_method_layout_name
//   b. Check caches — if already registered, return existing symbol
//   c. Build type substitution map
//   d. Resolve parameter types and return type
//   e. Allocate a new DefId for the concrete method
//   f. Register in extension_method_def_ids with dual keys
//   g. Register in extension_methods map for the type
//   h. Emit the declaration node (FunctionDecl or IntrinsicFunctionDecl)
//   i. Return the Symbol for the instantiated method
//
public let instantiate_extension_method_from_entry(
    mono * Monomorphizer,
    base_type Type,
    structure_name String,
    effective_template_name String,
    type_args List[* Type],
    method_type_args List[* Type],
    template * GenericExtensionMethodTemplate,
) Symbol = {
    let resolved_template = if template.checked_body is .Some(_) then template else when template.conformance_trait_name in {
            .Some(trait_name) then when mono.storage.generic_templates.lookup_extension_methods(trait_name) in {
                .Some(tool_templates) then when select_extension_template(
                    tool_templates,
                    template.method.name,
                    Option[UInt].Some(template.method.type_params.count()),
                    Option[UInt].None(),
                ) in {
                    .Some(tool_template_ref) then patched_extension_template_with_body(template, tool_template_ref),
                    .None() then template,
                },
                .None() then template,
            },
            .None() then template,
    }

    let should_block_invalid_pair_constraint_instantiation = effective_template_name == "Pair"
        and (resolved_template.method.name == "hash" or resolved_template.method.name == "equals")
        and not extension_type_args_satisfy_constraints(mono, resolved_template, type_args)
    if should_block_invalid_pair_constraint_instantiation then {
        return Symbol(DefId(0(UInt)), Type.Unknown(), SymbolKind.Function())
    }

    // Compute concrete_lookup_type_name matching Swift's logic:
    //   StructureType(defId) → context.getName(defId)
    //   EnumType(defId)      → context.getName(defId)
    //   default              → structure_name
    let concrete_lookup_type_name = when base_type in {
        .StructureType(did) then mono.storage.context.get_name(did) or else structure_name,
        .EnumType(did) then mono.storage.context.get_name(did) or else structure_name,
        .ReferenceType(_) then layout_key(resolve_parameterized_type(mono, base_type)),
        .MutableReferenceType(_) then layout_key(resolve_parameterized_type(mono, base_type)),
        .BorrowedReferenceType(_) then layout_key(resolve_parameterized_type(mono, base_type)),
        .MutableBorrowedReferenceType(_) then layout_key(resolve_parameterized_type(mono, base_type)),
        .WeakReferenceType(_) then layout_key(resolve_parameterized_type(mono, base_type)),
        .MutableWeakReferenceType(_) then layout_key(resolve_parameterized_type(mono, base_type)),
        .PointerType(_) then layout_key(resolve_parameterized_type(mono, base_type)),
        .MutablePointerType(_) then layout_key(resolve_parameterized_type(mono, base_type)),
        _ then structure_name,
    }
    let mangle_template_name = effective_template_name
    // a. Generate the symbol name.
    let mangled_name = make_extension_method_layout_name(
        mono,
        mangle_template_name,
        type_args,
        resolved_template.method.name,
        method_type_args,
    )
    let lookup_key = make_extension_method_lookup_key(mono, concrete_lookup_type_name, resolved_template.method.name, method_type_args)
    let cache_key = "ext:\(mangled_name)"
    when mono.storage.instantiated_function_symbols.get(cache_key) in {
        .Some(cached_symbol) then {
            let template_has_body = lookup_extension_template_checked_body(mono, resolved_template) is .Some(_)
            let cached_has_body = mono.storage.resolved_function_body_ids.contains(cached_symbol.def_id.id)
                or mono.storage.context.get_concrete_function_body(cached_symbol.def_id) is .Some(_)
            if not template_has_body or cached_has_body then {
                return cached_symbol
            }
        },
        .None() then {},
    }

    // c. Build type substitution map.
    let mut substitution = Dict[String, Type].new()

    // Self → base_type
    substitution.insert("Self", base_type)

    // Set current_self_type so resolve_parameterized_type can resolve GenericParameter("Self")
    let saved_self_type = mono.storage.current_self_type
    mono.storage.current_self_type = Option[Type].Some(base_type)

    when resolved_template.checked_parameters in {
        .Some(checked_params) then {
            let _ = checked_params
        },
        .None() then {},
    }

    if type_args.count() <> resolved_template.type_params.count() then {
        mono.storage.current_self_type = saved_self_type
        return Symbol(DefId(0(UInt)), Type.Unknown(), SymbolKind.Function())
    }
    if method_type_args.count() <> resolved_template.method.type_params.count() then {
        mono.storage.current_self_type = saved_self_type
        return Symbol(DefId(0(UInt)), Type.Unknown(), SymbolKind.Function())
    }

    bind_trait_extension_template_type_args(mono, base_type, resolved_template, &mut substitution)
    when resolved_template.conformance_trait_name in {
        .Some(trait_name) then substitution.insert(trait_name, base_type),
        .None() then {},
    }

    // template.type_params[i].name → type_args[i]
    let mut tp_idx = 0(UInt)
    while tp_idx < resolved_template.type_params.count() then {
        let tp = resolved_template.type_params[tp_idx]
        let arg = type_args[tp_idx]
        if not substitution.contains_key(tp.name) then {
            substitution.insert(tp.name, *arg)
        }
        tp_idx += 1(UInt)
    }

    // template.method.type_params[i].name → method_type_args[i]
    let mut mtp_idx = 0(UInt)
    while mtp_idx < resolved_template.method.type_params.count() then {
        let mtp = resolved_template.method.type_params[mtp_idx]
        let marg = method_type_args[mtp_idx]
        substitution.insert(mtp.name, *marg)
        mtp_idx += 1(UInt)
    }
    // d. Resolve parameter types and return type.
    let mut concrete_params = List[TypedParam].new()
    let mut concrete_param_types = List[* Type].new()

    when resolved_template.checked_parameters in {
        .Some(checked_params_list) then {
            for sym in checked_params_list then {
                let substituted_type = mono.substitute_type_impl(sym.symbol_type, substitution)
                let resolved_type = resolve_parameterized_type(mono, substituted_type)
                concrete_params.push(TypedParam(mono.storage.context.symbol_name(sym), sym.is_mutable(), resolved_type, false))
                concrete_param_types.push(box(resolved_type))
            }
        },
        .None() then {
            for p in resolved_template.method.params then {
                let resolved_type = resolve_parameterized_type(mono, mono.resolve_type_node_impl(p.param_type, substitution))
                concrete_params.push(TypedParam(p.name, p.mutable, resolved_type, p.named))
                concrete_param_types.push(box(resolved_type))
            }
        },
    }

    let concrete_return_type = when resolved_template.checked_return_type in {
        .Some(checked_return_type) then {
            let substituted_return_type = mono.substitute_type_impl(checked_return_type, substitution)
            break resolve_parameterized_type(mono, substituted_return_type)
        },
        .None() then {
            let resolved_node_type = mono.resolve_type_node_impl(resolved_template.method.return_type, substitution)
            break resolve_parameterized_type(mono, resolved_node_type)
        },
    }
    let mut method_param_entries = List[* FunctionParamEntry].new()
    let mut method_param_index = 0(UInt)
    while method_param_index < concrete_params.count() then {
        let declared_param = resolved_template.method.params[method_param_index]
        method_param_entries.push(box(FunctionParamEntry(
            concrete_params[method_param_index].param_type,
            pass_kind_from_type_node(declared_param.param_type)
        )))
        method_param_index += 1(UInt)
    }
    let function_type = Type.FunctionType(method_param_entries, box(concrete_return_type))
    let method_span = resolved_template.method.span

    // e. Allocate a new DefId for the concrete method with full metadata so
    // codegen can bind the emitted FunctionDecl back to this symbol.
    let def_id = mono.storage.context.allocate_full(
        mangled_name,
        DefKind.Function(),
        List[String].new(),
        "",
        resolved_template.method.access,
        method_span,
    )

    // Register the function signature.
    let mut param_specs = List[FunctionParamSpec].new()
    for p in concrete_params then {
        param_specs.push(FunctionParamSpec(p.name, p.mutable, p.named))
    }
    mono.storage.context.set_symbol_info(def_id, SymbolInfo(function_type, SymbolKind.Function(), MethodKind.Normal(), false))
    mono.storage.context.set_param_specs(def_id, param_specs)
    mono.storage.context.set_cname(def_id, mangled_name)

    // Build the result symbol.
    let result_symbol = Symbol(def_id, function_type, SymbolKind.Function())
    // Keep the semantic method name for receiver lookup. Concrete C naming
    // comes from the DefId/c_identifier path, while typed lookup keys carry
    // any method type arguments separately.
    let logical_name_with_args = resolved_template.method.name
    // Only set owner_type for actual instance methods (first param is self/source).
    // Standalone functions like box() should not get method-style C naming.
    let mut has_receiver = false
    if not resolved_template.method.params.is_empty() then {
        let first_name = resolved_template.method.params[0(UInt)].name
        has_receiver = first_name == "self" or first_name == "source"
    }
    let effective_owner_type = if has_receiver then Option[Type].Some(base_type) else Option[Type].None()
    mono.register_concrete_callable_if_absent(
        ConcreteCallableInfo(def_id, logical_name_with_args, effective_owner_type, resolved_template.conformance_trait_name)
    )
    when effective_owner_type in {
        .Some(owner_type) then {
            mono.set_receiver_method_dispatch_if_absent(
                def_id,
                ReceiverMethodDispatchInfo(
                    def_id,
                    resolved_template.method.name,
                    Option[ReceiverMethodOwner].Some(ReceiverMethodOwner.ConcreteType(mono.storage.context.type_display_name(owner_type))),
                    resolved_template.conformance_trait_name,
                )
            )
        },
        .None() then {},
    }

    let mut remap_source_keys = List[String].new()
    remap_source_keys.push(structure_name)
    remap_source_keys.push(concrete_lookup_type_name)
    when resolved_template.conformance_trait_name in {
        .Some(trait_name) then remap_source_keys.push(trait_name),
        .None() then {},
    }
    for source_key in remap_source_keys then {
        when mono.storage.method_table.lookup(source_key, resolved_template.method.name) in {
            .Some(original_symbol) then {
                when mono.storage.remapped_function_def_ids.get(original_symbol.def_id.id) in {
                    .Some(existing_list) then {
                        let mut updated = existing_list
                        let mut already_present = false
                        for entry in updated then {
                            if entry.first.id == def_id.id then {
                                already_present = true
                            }
                        }
                        if not already_present then {
                            updated.push(Pair(def_id, function_type))
                            mono.storage.remapped_function_def_ids.insert(original_symbol.def_id.id, updated)
                        }
                    },
                    .None() then {
                        let mut new_list = List[Pair[DefId, Type]].new()
                        new_list.push(Pair(def_id, function_type))
                        mono.storage.remapped_function_def_ids.insert(original_symbol.def_id.id, new_list)
                    },
                }
            },
            .None() then {},
        }
    }

    // f. Register in extension_method_def_ids with dual keys.
    //    Primary key: "concreteLookupTypeName.methodName"
    mono.storage.extension_method_def_ids.insert(lookup_key, def_id)

    //    Alias key (only when genericArgs is empty AND structureName != concreteLookupTypeName):
    //    "structureName.methodName"
    if type_args.is_empty() and structure_name <> concrete_lookup_type_name then {
        let alias_key = make_extension_method_lookup_key(mono, structure_name, resolved_template.method.name, method_type_args)
        mono.storage.extension_method_def_ids.insert(alias_key, def_id)
    }

    // g. Register in extension_methods map for the type.
    if method_type_args.is_empty() then {
        let method_entry = ConcreteMethodEntry(result_symbol, Option[String].None())
        when mono.storage.extension_methods.get(concrete_lookup_type_name) in {
            .Some(method_map) then {
                let mut updated_map = method_map
                updated_map.insert(resolved_template.method.name, method_entry)
                mono.storage.extension_methods.insert(concrete_lookup_type_name, updated_map)
            },
            .None() then {
                let mut new_map = Dict[String, ConcreteMethodEntry].new()
                new_map.insert(resolved_template.method.name, method_entry)
                mono.storage.extension_methods.insert(concrete_lookup_type_name, new_map)
            },
        }
    }

    // Cache before body substitution so recursive/re-entrant extension
    // instantiations can reuse the symbol instead of re-entering the body path.
    mono.storage.instantiated_functions.insert(mangled_name, InstantiatedFunction(mangled_name, function_type))
    mono.storage.instantiated_function_symbols.insert(cache_key, result_symbol)

    // h. Emit the declaration node.
    when lookup_extension_template_checked_body(mono, resolved_template) in {
        .Some(body) then {
            // Substitute generic params with concrete types and emit a FunctionDecl.
            mono.storage.extension_body_resolution_depth += 1
            let saved_self_type = mono.storage.current_self_type
            mono.storage.current_self_type = Option[Type].Some(base_type)
            let concrete_body = mono.substitute_types_in_expression_impl(body, substitution)
            let resolved_concrete_body = resolve_types_in_expression(mono, concrete_body)
            mono.storage.current_self_type = saved_self_type
            let mut context = mono.storage.context
            context.set_concrete_function_body(def_id, resolved_concrete_body)
            mono.storage.resolved_function_body_ids.insert(def_id.id)
            let decl = TypedDecl.FunctionDecl(
                resolved_template.method.access,
                mangled_name,
                concrete_params,
                concrete_return_type,
                make_mono_function_body_placeholder_expr(concrete_return_type),
                method_span,
                box(Symbol(def_id, function_type, SymbolKind.Function())),
            )
            mono.storage.generated_nodes.push(box(decl))
            mono.storage.extension_body_resolution_depth -= 1
        },
        .None() then {
            // Intrinsic extension method — emit an IntrinsicFunctionDecl.
            let decl = TypedDecl.IntrinsicFunctionDecl(
                resolved_template.method.access,
                mangled_name,
                concrete_params,
                concrete_return_type,
                method_span,
                box(Symbol(def_id, Type.Unknown(), SymbolKind.Function())),
            )
            mono.storage.generated_nodes.push(box(decl))
        },
    }

    // i. Return the Symbol for the instantiated method.
    mono.storage.current_self_type = saved_self_type
    return result_symbol
}

public let instantiate_extension_method_def_id(
    mono * Monomorphizer,
    base_type Type,
    template_name String,
    template * GenericExtensionMethodTemplate,
    type_args List[* Type],
    method_type_args List[* Type],
) DefId = {
    let sym = instantiate_extension_method(mono, base_type, template_name, template, type_args, method_type_args)
    return sym.def_id
}

// ── instantiate_trait_placeholder_method ─────────────────────────────────────

private let normalize_trait_conformance_actual_type(mono * Monomorphizer, actual Type) Type = {
    return when actual in {
        .StructureType(def_id) then {
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(pair) then {
                    let mut args = List[* Type].new()
                    for arg in pair.second then { args.push(box(arg)) }
                    break Type.GenericStruct(pair.first, args)
                },
                .None() then {
                    break when mono.storage.context.lookup_type(def_id) in {
                        .Some(mapped_type) then mapped_type,
                        .None() then actual,
                    }
                },
            }
        },
        .EnumType(def_id) then {
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(pair) then {
                    let mut args = List[* Type].new()
                    for arg in pair.second then { args.push(box(arg)) }
                    break Type.GenericEnum(pair.first, args)
                },
                .None() then {
                    break when mono.storage.context.lookup_type(def_id) in {
                        .Some(mapped_type) then mapped_type,
                        .None() then actual,
                    }
                },
            }
        },
        _ then actual,
    }
}

private let trait_conformance_target_matches(mono * Monomorphizer, pattern Type, actual Type) Bool = {
    let normalized_pattern = normalize_trait_conformance_actual_type(mono, pattern)
    let normalized_actual = normalize_trait_conformance_actual_type(mono, actual)
    return when normalized_pattern in {
        .GenericStruct(pattern_template, pattern_args) then when normalized_actual in {
            .GenericStruct(actual_template, actual_args) then pattern_template == actual_template and pattern_args.count() == actual_args.count(),
            _ then false,
        },
        .GenericEnum(pattern_template, pattern_args) then when normalized_actual in {
            .GenericEnum(actual_template, actual_args) then pattern_template == actual_template and pattern_args.count() == actual_args.count(),
            _ then false,
        },
        _ then layout_key(pattern) == layout_key(normalized_actual),
    }
}

private let collect_trait_conformance_bindings(mono * Monomorphizer, pattern Type, actual Type, bindings *mut Dict[String, Type]) Void = {
    let normalized_pattern = normalize_trait_conformance_actual_type(mono, pattern)
    let normalized_actual = normalize_trait_conformance_actual_type(mono, actual)
    when normalized_pattern in {
        .GenericParameter(name) then {
            if not bindings.contains_key(name) then {
                bindings.insert(name, normalized_actual)
            }
        },
        .ReferenceType(pattern_inner) then {
            when normalized_actual in {
                .ReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                .BorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .MutableReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .BorrowedReferenceType(pattern_inner) then {
            when normalized_actual in {
                .ReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                .BorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .MutableBorrowedReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .WeakReferenceType(pattern_inner) then {
            when normalized_actual in {
                .WeakReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                .MutableWeakReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .MutableWeakReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableWeakReferenceType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .PointerType(pattern_inner) then {
            when normalized_actual in {
                .PointerType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                .MutablePointerType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .MutablePointerType(pattern_inner) then {
            when normalized_actual in {
                .MutablePointerType(actual_inner) then collect_trait_conformance_bindings(mono, *pattern_inner, *actual_inner, bindings),
                _ then {},
            }
        },
        .GenericStruct(pattern_template, pattern_args) then {
            when normalized_actual in {
                .GenericStruct(actual_template, actual_args) then {
                    if pattern_template == actual_template and pattern_args.count() == actual_args.count() then {
                        let mut i UInt = 0
                        while i < pattern_args.count() then {
                            collect_trait_conformance_bindings(mono, (*pattern_args[i]), (*actual_args[i]), bindings)
                            i += 1
                        }
                    }
                },
                _ then {},
            }
        },
        .GenericEnum(pattern_template, pattern_args) then {
            when normalized_actual in {
                .GenericEnum(actual_template, actual_args) then {
                    if pattern_template == actual_template and pattern_args.count() == actual_args.count() then {
                        let mut i UInt = 0
                        while i < pattern_args.count() then {
                            collect_trait_conformance_bindings(mono, (*pattern_args[i]), (*actual_args[i]), bindings)
                            i += 1
                        }
                    }
                },
                _ then {},
            }
        },
        _ then {},
    }
}

private let infer_trait_extension_type_args(
    mono * Monomorphizer,
    conformance_target Type,
    parameterized_base_type Type,
    trait_name String,
) List[* Type] = {
    let mut out = List[* Type].new()
    if not trait_conformance_target_matches(mono, conformance_target, parameterized_base_type) then {
        return out
    }

    let mut bindings = Dict[String, Type].new()
    collect_trait_conformance_bindings(mono, conformance_target, parameterized_base_type, &mut bindings)

    when mono.storage.generic_templates.traits.get(trait_name) in {
        .Some(info) then {
            for tp in info.type_params then {
                out.push(box(bindings.get(tp.name) or else Type.Unknown()))
            }
        },
        .None() then {},
    }
    return out
}

private let resolve_given_trait_args(
    mono * Monomorphizer,
    conformance_target Type,
    trait_args List[Type],
    parameterized_base_type Type,
) List[* Type] = {
    let mut out = List[* Type].new()
    if not trait_conformance_target_matches(mono, conformance_target, parameterized_base_type) then {
        return out
    }

    let mut bindings = Dict[String, Type].new()
    collect_trait_conformance_bindings(mono, conformance_target, parameterized_base_type, &mut bindings)
    for trait_arg in trait_args then {
        out.push(box(resolve_parameterized_type(mono, substitute_type(mono, trait_arg, bindings))))
    }
    return out
}

private let infer_trait_args_from_extension_template_binding(
    mono * Monomorphizer,
    template * GenericExtensionMethodTemplate,
    concrete_extension_type_args List[* Type],
    trait_name String,
) List[* Type] = {
    let mut out = List[* Type].new()
    let mut bindings = Dict[String, Type].new()
    let mut i UInt = 0
    while i < template.type_params.count() and i < concrete_extension_type_args.count() then {
        bindings.insert(template.type_params[i].name, resolve_parameterized_type(mono, (*concrete_extension_type_args[i])))
        i += 1
    }

    // Fallback for Iterator conformance templates when GivenTraitDecl trait args
    // cannot be recovered: infer Iterator[T] from `next(self) Option[T]`.
    if trait_name == "Iterator" and template.method.name == "next" then {
        when template.checked_return_type in {
            .Some(checked_return_type) then {
                let substituted_return_type = substitute_type(mono, checked_return_type, bindings)
                let resolved_return_type = resolve_parameterized_type(mono, substituted_return_type)
                when resolved_return_type in {
                    .GenericEnum(enum_name, enum_args) then {
                        if enum_name == "Option" and enum_args.count() == 1 then {
                            out.push(box(resolve_parameterized_type(mono, (*enum_args[0]))))
                            return out
                        }
                    },
                    _ then {},
                }
            },
            .None() then {
                let resolved_return_type = resolve_parameterized_type(mono, mono.resolve_type_node_impl(template.method.return_type, bindings))
                when resolved_return_type in {
                    .GenericEnum(enum_name, enum_args) then {
                        if enum_name == "Option" and enum_args.count() == 1 then {
                            out.push(box(resolve_parameterized_type(mono, (*enum_args[0]))))
                            return out
                        }
                    },
                    _ then {},
                }
            },
        }
    }

    when mono.storage.generic_templates.traits.get(trait_name) in {
        .Some(info) then {
            for trait_tp in info.type_params then {
                out.push(box(bindings.get(trait_tp.name) or else Type.Unknown()))
            }
        },
        .None() then {},
    }
    return out
}

private let infer_trait_args_from_owner_next_template(
    mono * Monomorphizer,
    owner_template_name String,
    trait_name String,
    concrete_extension_type_args List[* Type],
) List[* Type] = {
    let mut out = List[* Type].new()
    when mono.storage.generic_templates.lookup_extension_methods(owner_template_name) in {
        .Some(owner_templates) then {
            for owner_template in owner_templates then {
                if owner_template.method.name <> "next" then {
                    continue
                }
                when owner_template.conformance_trait_name in {
                    .Some(owner_trait_name) then {
                        if not trait_name_matches(owner_trait_name, trait_name) then {
                            continue
                        }
                    },
                    .None() then { continue },
                }
                let inferred = infer_trait_args_from_extension_template_binding(
                    mono,
                    owner_template,
                    concrete_extension_type_args,
                    trait_name,
                )
                if not inferred.is_empty() then {
                    return inferred
                }
            }
        },
        .None() then {},
    }
    return out
}

private let primitive_extension_template_name(t Type) Option[String] = {
    return when t in {
        .IntType() then Option[String].Some("Int"),
        .Int8Type() then Option[String].Some("Int8"),
        .Int16Type() then Option[String].Some("Int16"),
        .Int32Type() then Option[String].Some("Int32"),
        .Int64Type() then Option[String].Some("Int64"),
        .UIntType() then Option[String].Some("UInt"),
        .UInt8Type() then Option[String].Some("UInt8"),
        .UInt16Type() then Option[String].Some("UInt16"),
        .UInt32Type() then Option[String].Some("UInt32"),
        .UInt64Type() then Option[String].Some("UInt64"),
        .Float32Type() then Option[String].Some("Float32"),
        .Float64Type() then Option[String].Some("Float64"),
        .BoolType() then Option[String].Some("Bool"),
        _ then Option[String].None(),
    }
}

private let type_satisfies_trait_constraint(
    mono * Monomorphizer,
    actual_type Type,
    trait_name String,
) Bool = {
    if trait_name == "Any" then {
        return true
    }

    let parameterized_actual_type = resolve_parameterized_type(mono, actual_type)
    let primitive_name_opt = primitive_extension_template_name(parameterized_actual_type)

    for node_ref in mono.storage.source_given_decls then {
        when node_ref in {
            .GivenTraitDecl(target_type, given_trait_name, _, _, _) then {
                if not trait_name_matches(given_trait_name, trait_name) then {
                    continue
                }
                if trait_conformance_target_matches(mono, target_type, parameterized_actual_type) then {
                    return true
                }
                when primitive_name_opt in {
                    .Some(primitive_name) then {
                        let primitive_type = Type.GenericStruct(primitive_name, List[* Type].new())
                        if trait_conformance_target_matches(mono, target_type, primitive_type) then {
                            return true
                        }
                    },
                    .None() then {},
                }
            },
            _ then {},
        }
    }

    return false
}

public let extension_type_args_satisfy_constraints(
    mono * Monomorphizer,
    template * GenericExtensionMethodTemplate,
    type_args List[* Type],
) Bool = {
    if template.type_params.count() <> type_args.count() then {
        return false
    }

    let mut i UInt = 0
    while i < template.type_params.count() then {
        let param = template.type_params[i]
        let actual_type = resolve_parameterized_type(mono, (*type_args[i]))
        for constraint in param.constraints then {
            let trait_name = when constraint in {
                .Identifier(name) then name,
                .Generic(base, _) then base,
                _ then "?",
            }
            if not type_satisfies_trait_constraint(mono, actual_type, trait_name) then {
                return false
            }
        }
        i += 1
    }

    return true
}

public let instantiate_trait_vtable_methods(
    mono * Monomorphizer,
    concrete_type Type,
    trait_name String,
    trait_type_args List[* Type],
) Void = {
    if has_generic_parameter(concrete_type) then {
        return
    }

    let parameterized_concrete_type = resolve_parameterized_type(mono, concrete_type)
    let normalized_actual = normalize_trait_conformance_actual_type(mono, parameterized_concrete_type)
    let mut concrete_template_name = stable_type_key(parameterized_concrete_type)
    let mut extension_type_args = List[* Type].new()
    let mut instantiated_any = false

    when normalized_actual in {
        .GenericStruct(template_name, args) then {
            concrete_template_name = template_name
            for arg in args then {
                extension_type_args.push(box(*arg))
            }
        },
        .GenericEnum(template_name, args) then {
            concrete_template_name = template_name
            for arg in args then {
                extension_type_args.push(box(*arg))
            }
        },
        .ReferenceType(inner) then {
            concrete_template_name = "Ref"
            extension_type_args.push(box(*inner))
        },
        .MutableReferenceType(inner) then {
            concrete_template_name = "MutRef"
            extension_type_args.push(box(*inner))
        },
        .BorrowedReferenceType(inner) then {
            concrete_template_name = "Ref"
            extension_type_args.push(box(*inner))
        },
        .MutableBorrowedReferenceType(inner) then {
            concrete_template_name = "MutRef"
            extension_type_args.push(box(*inner))
        },
        .PointerType(inner) then {
            concrete_template_name = "Ptr"
            extension_type_args.push(box(*inner))
        },
        .MutablePointerType(inner) then {
            concrete_template_name = "MutPtr"
            extension_type_args.push(box(*inner))
        },
        .WeakReferenceType(inner) then {
            concrete_template_name = "WeakRef"
            extension_type_args.push(box(*inner))
        },
        .MutableWeakReferenceType(inner) then {
            concrete_template_name = "MutWeakRef"
            extension_type_args.push(box(*inner))
        },
        .StructureType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(layout_name) then {
                    when mono.storage.context.get_template_name(def_id) in {
                        .Some(template_name) then {
                            concrete_template_name = template_name
                            when mono.storage.context.get_type_arguments(def_id) in {
                                .Some(actual_args) then {
                                    for arg in actual_args then {
                                        extension_type_args.push(box(arg))
                                    }
                                },
                                .None() then {
                                    when mono.storage.layout_to_template_info.get(layout_name) in {
                                        .Some(info) then {
                                            for arg in info.args then {
                                                extension_type_args.push(box(*arg))
                                            }
                                        },
                                        .None() then {
                                            when mono.storage.context.lookup_type(def_id) in {
                                                .Some(mapped_type) then {
                                                    when mapped_type in {
                                                        .GenericStruct(_, mapped_args) then {
                                                            for arg in mapped_args then {
                                                                extension_type_args.push(box(*arg))
                                                            }
                                                        },
                                                        .GenericEnum(_, mapped_args) then {
                                                            for arg in mapped_args then {
                                                                extension_type_args.push(box(*arg))
                                                            }
                                                        },
                                                        _ then {},
                                                    }
                                                },
                                                .None() then {},
                                            }
                                        },
                                    }
                                },
                            }
                        },
                        .None() then {
                            when mono.storage.layout_to_template_info.get(layout_name) in {
                                .Some(info) then {
                                    concrete_template_name = info.base_name
                                    for arg in info.args then {
                                        extension_type_args.push(box(*arg))
                                    }
                                },
                                .None() then {
                                    concrete_template_name = layout_name
                                },
                            }
                        },
                    }
                },
                .None() then {},
            }
        },
        .EnumType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(layout_name) then {
                    when mono.storage.context.get_template_name(def_id) in {
                        .Some(template_name) then {
                            concrete_template_name = template_name
                            when mono.storage.context.get_type_arguments(def_id) in {
                                .Some(actual_args) then {
                                    for arg in actual_args then {
                                        extension_type_args.push(box(arg))
                                    }
                                },
                                .None() then {
                                    when mono.storage.layout_to_template_info.get(layout_name) in {
                                        .Some(info) then {
                                            for arg in info.args then {
                                                extension_type_args.push(box(*arg))
                                            }
                                        },
                                        .None() then {
                                            when mono.storage.context.lookup_type(def_id) in {
                                                .Some(mapped_type) then {
                                                    when mapped_type in {
                                                        .GenericEnum(_, mapped_args) then {
                                                            for arg in mapped_args then {
                                                                extension_type_args.push(box(*arg))
                                                            }
                                                        },
                                                        .GenericStruct(_, mapped_args) then {
                                                            for arg in mapped_args then {
                                                                extension_type_args.push(box(*arg))
                                                            }
                                                        },
                                                        _ then {},
                                                    }
                                                },
                                                .None() then {},
                                            }
                                        },
                                    }
                                },
                            }
                        },
                        .None() then {
                            when mono.storage.layout_to_template_info.get(layout_name) in {
                                .Some(info) then {
                                    concrete_template_name = info.base_name
                                    for arg in info.args then {
                                        extension_type_args.push(box(*arg))
                                    }
                                },
                                .None() then {
                                    concrete_template_name = layout_name
                                },
                            }
                        },
                    }
                },
                .None() then {},
            }
        },
        _ then {},
    }

    let mut candidate_template_names = List[String].new()
    if not candidate_template_names.contains(concrete_template_name) then {
        candidate_template_names.push(concrete_template_name)
    }
    when parameterized_concrete_type in {
        .StructureType(def_id) then {
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then {
                    if not candidate_template_names.contains(info.first) then {
                        candidate_template_names.push(info.first)
                    }
                },
                .None() then {},
            }
        },
        .EnumType(def_id) then {
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then {
                    if not candidate_template_names.contains(info.first) then {
                        candidate_template_names.push(info.first)
                    }
                },
                .None() then {},
            }
        },
        _ then {},
    }
    for candidate_template_name in candidate_template_names then {
        when mono.storage.generic_templates.lookup_extension_methods(candidate_template_name) in {
            .Some(templates) then {
                for template_ref in templates then {
                    when template_ref.conformance_trait_name in {
                        .Some(name) then {
                            if not trait_name_matches(name, trait_name) then {
                                continue
                            }
                        },
                        .None() then { continue },
                    }
                    if template_ref.type_params.count() <> extension_type_args.count() then {
                        continue
                    }
                    if not extension_type_args_satisfy_constraints(mono, template_ref, extension_type_args) then {
                        continue
                    }
                    if template_ref.method.type_params.count() <> 0(UInt) then {
                        continue
                    }
                    let mut effective_template_ref = template_ref
                    let mut should_instantiate = true
                    if template_ref.checked_body is .None() then {
                        when lookup_extension_methods_fuzzy(mono, trait_name) in {
                            .Some(tool_templates) then when select_extension_template(
                                tool_templates,
                                template_ref.method.name,
                                Option[UInt].Some(template_ref.method.type_params.count()),
                                Option[UInt].Some(trait_type_args.count()),
                            ) in {
                                .Some(tool_template_ref) then {
                                    if extension_type_args_satisfy_constraints(mono, tool_template_ref, trait_type_args) then {
                                        effective_template_ref = patched_extension_template_with_body(
                                            template_ref,
                                            tool_template_ref,
                                        )
                                    } else {
                                        should_instantiate = false
                                    }
                                },
                                .None() then {
                                    should_instantiate = false
                                },
                            },
                            .None() then {
                                should_instantiate = false
                            },
                        }
                    }
                    if not should_instantiate then {
                        continue
                    }
                    let _ = mono.instantiate_extension_method_impl(
                        parameterized_concrete_type,
                        candidate_template_name,
                        effective_template_ref,
                        extension_type_args,
                        List[* Type].new(),
                    )
                    instantiated_any = true
                }

            }
            .None() then {},
        }
    }

    if not instantiated_any then {
        when parameterized_concrete_type in {
            .ReferenceType(inner) then instantiate_trait_vtable_methods(mono, *inner, trait_name, trait_type_args),
            .MutableReferenceType(inner) then instantiate_trait_vtable_methods(mono, *inner, trait_name, trait_type_args),
            .BorrowedReferenceType(inner) then instantiate_trait_vtable_methods(mono, *inner, trait_name, trait_type_args),
            .MutableBorrowedReferenceType(inner) then instantiate_trait_vtable_methods(mono, *inner, trait_name, trait_type_args),
            .WeakReferenceType(inner) then instantiate_trait_vtable_methods(mono, *inner, trait_name, trait_type_args),
            .MutableWeakReferenceType(inner) then instantiate_trait_vtable_methods(mono, *inner, trait_name, trait_type_args),
            .PointerType(inner) then instantiate_trait_vtable_methods(mono, *inner, trait_name, trait_type_args),
            .MutablePointerType(inner) then instantiate_trait_vtable_methods(mono, *inner, trait_name, trait_type_args),
            _ then {},
        }
    }
}

// Resolve a trait placeholder method call to a concrete implementation.
//
// Steps:
//   a. If base_type contains an unresolved GenericParameter, skip
//   b. Determine the template name and resolved base type:
//      - GenericStruct(template_name, args): resolve args via resolve_parameterized_type,
//        use template_name
//      - GenericEnum(template_name, args): same as GenericStruct
//      - StructureType(def_id): look up name from def_id_map, then check
//        layout_to_template_info for the base template name
//      - EnumType(def_id): same as StructureType
//      - Other types: skip (no extension methods possible)
//   c. Look up extension method templates from the registry using the template name
//   d. Find the matching template using select_extension_template
//   e. Call instantiate_extension_method with the resolved base_type, template_name,
//      template, type_args, and method_type_args
//
public let instantiate_trait_placeholder_method(
    mono * Monomorphizer,
    base_type Type,
    method_name String,
    method_type_args List[* Type],
) Void = {
    let placeholder_base_type = when base_type in {
        .ReferenceType(inner) then *inner,
        .MutableReferenceType(inner) then *inner,
        _ then base_type,
    }
    // a. If base_type contains an unresolved GenericParameter, skip.
    if has_generic_parameter(placeholder_base_type) or is_placeholder_inferred_type(placeholder_base_type) then {
        return
    }
    if args_have_generic_parameter(method_type_args) then {
        return
    }

    let trait_placeholder_key = InstantiationRequest(
        InstantiationKind.TraitMethod(placeholder_base_type, method_name, method_type_args),
        0,
        "",
    ).deduplication_key()
    if mono.storage.resolved_trait_placeholder_keys.contains(trait_placeholder_key) then {
        return
    }
    if mono.storage.in_progress_trait_placeholder_keys.contains(trait_placeholder_key) then {
        return
    }
    mono.storage.in_progress_trait_placeholder_keys.insert(trait_placeholder_key)

    let mut lookup_aliases = List[String].new()
    lookup_aliases.push(stable_type_key(placeholder_base_type))
    when placeholder_base_type in {
        .StructureType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(name) then lookup_aliases.push(name),
                .None() then {},
            }
            when mono.storage.context.get_template_name(def_id) in {
                .Some(name) then {
                    if not lookup_aliases.contains(name) then {
                        lookup_aliases.push(name)
                    }
                },
                .None() then {},
            }
        },
        .EnumType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(name) then {
                    if not lookup_aliases.contains(name) then {
                        lookup_aliases.push(name)
                    }
                },
                .None() then {},
            }
            when mono.storage.context.get_template_name(def_id) in {
                .Some(name) then {
                    if not lookup_aliases.contains(name) then {
                        lookup_aliases.push(name)
                    }
                },
                .None() then {},
            }
        },
        .GenericStruct(template_name, _) then {
            if not lookup_aliases.contains(template_name) then {
                lookup_aliases.push(template_name)
            }
        },
        .GenericEnum(template_name, _) then {
            if not lookup_aliases.contains(template_name) then {
                lookup_aliases.push(template_name)
            }
        },
        _ then {},
    }
    for alias in lookup_aliases then {
        let key = "\(alias).\(method_name)"
        if mono.storage.extension_method_def_ids.contains_key(key) then {
            mono.storage.resolved_trait_placeholder_keys.insert(trait_placeholder_key)
            mono.storage.in_progress_trait_placeholder_keys.remove(trait_placeholder_key)
            return
        }
    }

    // b. Determine the template name and resolved base type.
    //    We need both the template name (for registry lookup) and the resolved
    //    concrete base type (for instantiate_extension_method).
    let mut template_name_opt = Option[String].None()
    let mut resolved_base_type = placeholder_base_type
    let mut type_args = List[* Type].new()

    when placeholder_base_type in {
        // GenericStruct: instantiate the struct to get the concrete type, then use
        // the template name for extension method lookup.
        .GenericStruct(tname, args) then {
            let mut resolved_args = List[* Type].new()
            for a in args then {
                resolved_args.push(box(resolve_parameterized_type(mono, *a)))
            }
            // Instantiate the struct to get the concrete StructureType.
            when mono.storage.generic_templates.lookup_struct(tname) in {
                .Some(struct_template) then {
                    let resolved = mono.instantiate_struct_impl(struct_template, resolved_args)
                    resolved_base_type = resolved
                },
                .None() then {},
            }
            template_name_opt = Option[String].Some(tname)
            // The type_args for the extension method are the generic struct's args.
            for a in resolved_args then {
                type_args.push(box(*a))
            }
        },
        // GenericEnum: same as GenericStruct.
        .GenericEnum(tname, args) then {
            let mut resolved_args = List[* Type].new()
            for a in args then {
                resolved_args.push(box(resolve_parameterized_type(mono, *a)))
            }
            when mono.storage.generic_templates.lookup_enum(tname) in {
                .Some(enum_template) then {
                    let resolved = mono.instantiate_enum_impl(enum_template, resolved_args)
                    resolved_base_type = resolved
                },
                .None() then {},
            }
            template_name_opt = Option[String].Some(tname)
            for a in resolved_args then {
                type_args.push(box(*a))
            }
        },
        // StructureType: look up name from def_id_map, then check layout_to_template_info
        // for the base template name.
        .StructureType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(layout_name) then {
                    // Prefer DefId generic-instantiation metadata when available.
                    when mono.storage.context.get_template_name(def_id) in {
                        .Some(template_name) then {
                            template_name_opt = Option[String].Some(template_name)
                            when mono.storage.context.get_type_arguments(def_id) in {
                                .Some(actual_args) then {
                                    for a in actual_args then {
                                        type_args.push(box(a))
                                    }
                                },
                                .None() then {
                                    when mono.storage.layout_to_template_info.get(layout_name) in {
                                        .Some(info) then {
                                            for a in info.args then {
                                                type_args.push(box(*a))
                                            }
                                        },
                                        .None() then {},
                                    }
                                },
                            }
                        },
                        .None() then {
                            // Fall back to layout-derived template info.
                            when mono.storage.layout_to_template_info.get(layout_name) in {
                                .Some(info) then {
                                    template_name_opt = Option[String].Some(info.base_name)
                                    for a in info.args then {
                                        type_args.push(box(*a))
                                    }
                                },
                                .None() then {
                                    // Concrete (non-generic) struct: use the layout name directly.
                                    when mono.storage.context.lookup_type(def_id) in {
                                        .Some(mapped_type) then {
                                            when mapped_type in {
                                                .GenericStruct(template_name, mapped_args) then {
                                                    template_name_opt = Option[String].Some(template_name)
                                                    for a in mapped_args then {
                                                        type_args.push(box(*a))
                                                    }
                                                },
                                                _ then {
                                                    template_name_opt = Option[String].Some(layout_name)
                                                },
                                            }
                                        },
                                        .None() then {
                                            template_name_opt = Option[String].Some(layout_name)
                                        },
                                    }
                                },
                            }
                        },
                    }
                },
                .None() then {},
            }
        },
        // EnumType: same as StructureType.
        .EnumType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(layout_name) then {
                    when mono.storage.context.get_template_name(def_id) in {
                        .Some(template_name) then {
                            template_name_opt = Option[String].Some(template_name)
                            when mono.storage.context.get_type_arguments(def_id) in {
                                .Some(actual_args) then {
                                    for a in actual_args then {
                                        type_args.push(box(a))
                                    }
                                },
                                .None() then {
                                    when mono.storage.layout_to_template_info.get(layout_name) in {
                                        .Some(info) then {
                                            for a in info.args then {
                                                type_args.push(box(*a))
                                            }
                                        },
                                        .None() then {},
                                    }
                                },
                            }
                        },
                        .None() then {
                            when mono.storage.layout_to_template_info.get(layout_name) in {
                                .Some(info) then {
                                    template_name_opt = Option[String].Some(info.base_name)
                                    for a in info.args then {
                                        type_args.push(box(*a))
                                    }
                                },
                                .None() then {
                                    when mono.storage.context.lookup_type(def_id) in {
                                        .Some(mapped_type) then {
                                            when mapped_type in {
                                                .GenericEnum(template_name, mapped_args) then {
                                                    template_name_opt = Option[String].Some(template_name)
                                                    for a in mapped_args then {
                                                        type_args.push(box(*a))
                                                    }
                                                },
                                                _ then {
                                                    template_name_opt = Option[String].Some(layout_name)
                                                },
                                            }
                                        },
                                        .None() then {
                                            template_name_opt = Option[String].Some(layout_name)
                                        },
                                    }
                                },
                            }
                        },
                    }
                },
                .None() then {},
            }
        },
        .PointerType(inner) then {
            template_name_opt = Option[String].Some("Ptr")
            type_args.push(box(*inner))
        },
        .MutablePointerType(inner) then {
            template_name_opt = Option[String].Some("MutPtr")
            type_args.push(box(*inner))
        },
        .WeakReferenceType(inner) then {
            template_name_opt = Option[String].Some("WeakRef")
            type_args.push(box(*inner))
        },
        .MutableWeakReferenceType(inner) then {
            template_name_opt = Option[String].Some("MutWeakRef")
            type_args.push(box(*inner))
        },
        .IntType() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .Int8Type() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .Int16Type() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .Int32Type() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .Int64Type() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .UIntType() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .UInt8Type() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .UInt16Type() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .UInt32Type() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .UInt64Type() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .Float32Type() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .Float64Type() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        .BoolType() then { template_name_opt = primitive_extension_template_name(placeholder_base_type) },
        // All other types: no extension methods to look up.
        _ then {},
    }

    let method_type_arg_count = Option[UInt].Some(method_type_args.count())
    let concrete_template_name = when template_name_opt in {
        .Some(name) then name,
        .None() then stable_type_key(resolved_base_type),
    }
    let trait_entry_structure_name = when resolved_base_type in {
        .StructureType(def_id) then mono.storage.context.get_name(def_id) or else concrete_template_name,
        .EnumType(def_id) then mono.storage.context.get_name(def_id) or else concrete_template_name,
        _ then concrete_template_name,
    }
    let parameterized_resolved_base_type = resolve_parameterized_type(mono, resolved_base_type)
    let conformance_binding_type_args = if not type_args.is_empty() then {
            break type_args
        } else when parameterized_resolved_base_type in {
            .GenericStruct(_, base_args) then {
                let mut inferred_args = List[* Type].new()
                for arg in base_args then { inferred_args.push(box(*arg)) }
                break inferred_args
            },
            .GenericEnum(_, base_args) then {
                let mut inferred_args = List[* Type].new()
                for arg in base_args then { inferred_args.push(box(*arg)) }
                break inferred_args
            },
            .StructureType(def_id) then {
                let mut inferred_args = List[* Type].new()
                when resolve_template_name_and_args(mono, def_id) in {
                    .Some(info) then {
                        for arg in info.second then {
                            inferred_args.push(box(resolve_parameterized_type(mono, arg)))
                        }
                    },
                    .None() then {},
                }
                break inferred_args
            },
            .EnumType(def_id) then {
                let mut inferred_args = List[* Type].new()
                when resolve_template_name_and_args(mono, def_id) in {
                    .Some(info) then {
                        for arg in info.second then {
                            inferred_args.push(box(resolve_parameterized_type(mono, arg)))
                        }
                    },
                    .None() then {},
                }
                break inferred_args
            },
            _ then List[* Type].new(),
        }

    // c. Look up extension method templates from the registry using the template name.
    let template_name = when template_name_opt in {
        .Some(name) then name,
        .None() then {
            for node_ref in mono.storage.source_given_decls then {
                when node_ref in {
                    .GivenTraitDecl(target_type, trait_name, trait_args, _, _) then {
                        if not trait_conformance_target_matches(mono, target_type, parameterized_resolved_base_type)
                            and not trait_conformance_target_matches_for_template_binding(mono, target_type, parameterized_resolved_base_type)
                        then {
                            continue
                        }
                        let inferred_trait_args = resolve_given_trait_args(mono, target_type, trait_args, parameterized_resolved_base_type)
                        when select_trait_tool_template_cached(
                            mono,
                            trait_name,
                            method_name,
                            method_type_arg_count,
                            Option[UInt].Some(inferred_trait_args.count()),
                        ) in {
                            .Some(tool_template_ref) then {
                                        // Note: select_extension_template already prefers templates
                                        // with checked_body. If no tool template has a body (trait
                                        // declares only a signature), instantiation proceeds without
                                        // a body — the conformance must provide one via GivenTraitDecl.
                                        let _ = mono.instantiate_extension_method_impl(
                                            resolved_base_type,
                                            trait_name,
                                            tool_template_ref,
                                            inferred_trait_args,
                                            method_type_args,
                                        )
                                        mono.storage.resolved_trait_placeholder_keys.insert(trait_placeholder_key)
                                        mono.storage.in_progress_trait_placeholder_keys.remove(trait_placeholder_key)
                                        return
                            },
                            .None() then {},
                        }
                    },
                    _ then {},
                }
            }
            instantiate_conformance_trait_methods_for_type(mono, resolved_base_type)
            mono.storage.in_progress_trait_placeholder_keys.remove(trait_placeholder_key)
            return
        },
    }

    // Ensure trait-tool methods for already-known conformances are materialized
    // before receiver-method binding continues.
    instantiate_conformance_trait_methods_for_type(mono, resolved_base_type)

    let extension_type_arg_count = Option[UInt].None()
    let matched_template_opt = when mono.storage.generic_templates.lookup_extension_methods(template_name) in {
        .Some(ext_templates) then select_extension_template(
            ext_templates,
            method_name,
            method_type_arg_count,
            extension_type_arg_count,
        ),
        .None() then select_conformance_extension_template(
            mono,
            resolved_base_type,
            method_name,
            method_type_arg_count,
        ),
    }
    let matched_template = when matched_template_opt in {
        .Some(t_ref) then t_ref,
        .None() then {
            when mono.storage.generic_templates.lookup_extension_methods(template_name) in {
                .Some(ext_templates) then {
                    for ext_ref in ext_templates then {
                        when ext_ref.conformance_trait_name in {
                            .Some(trait_name) then {
                                let inferred_trait_args_from_conformance = resolve_extension_template_conformance_trait_args(
                                    mono,
                                    resolved_base_type,
                                    ext_ref,
                                )
                                let inferred_trait_args = if not inferred_trait_args_from_conformance.is_empty() then {
                                    break inferred_trait_args_from_conformance
                                } else {
                                    break infer_trait_args_from_extension_template_binding(
                                        mono,
                                        ext_ref,
                                        conformance_binding_type_args,
                                        trait_name,
                                    )
                                }
                                when select_trait_tool_template_cached(
                                    mono,
                                    trait_name,
                                    method_name,
                                    method_type_arg_count,
                                    Option[UInt].Some(inferred_trait_args.count()),
                                ) in {
                                    .Some(tool_template_ref) then {
                                                let _ = mono.instantiate_extension_method_impl(
                                                    resolved_base_type,
                                                    template_name,
                                                    tool_template_ref,
                                                    inferred_trait_args,
                                                    method_type_args,
                                                )
                                                mono.storage.resolved_trait_placeholder_keys.insert(trait_placeholder_key)
                                                mono.storage.in_progress_trait_placeholder_keys.remove(trait_placeholder_key)
                                                return
                                    },
                                    .None() then {},
                                }
                            },
                            .None() then {},
                        }
                    }
                },
                .None() then {},
            }
            for ext_entry in mono.storage.generic_templates.extension_methods then {
                for ext_ref in ext_entry.second then {
                    let trait_name = when ext_ref.conformance_trait_name in {
                        .Some(name) then name,
                        .None() then { continue },
                    }
                    let target_type = when ext_ref.conformance_target_type in {
                        .Some(target) then target,
                        .None() then { continue },
                    }
                    if not trait_conformance_target_matches(mono, target_type, parameterized_resolved_base_type)
                        and not trait_conformance_target_matches_for_template_binding(mono, target_type, parameterized_resolved_base_type)
                    then {
                        continue
                    }
                    let resolved_from_conformance = resolve_extension_template_conformance_trait_args(mono, resolved_base_type, ext_ref)
                    let inferred_from_binding = infer_trait_args_from_extension_template_binding(
                        mono,
                        ext_ref,
                        conformance_binding_type_args,
                        trait_name,
                    )
                    let effective_trait_args = if not resolved_from_conformance.is_empty() then {
                            break resolved_from_conformance
                        } else inferred_from_binding
                    let trait_arg_count_filter = if effective_trait_args.is_empty() then
                            Option[UInt].None()
                        else Option[UInt].Some(effective_trait_args.count())
                    when select_trait_tool_template_cached(
                        mono,
                        trait_name,
                        method_name,
                        method_type_arg_count,
                        trait_arg_count_filter,
                    ) in {
                        .Some(tool_template_ref) then {
                                    let _ = mono.instantiate_extension_method_impl(
                                        resolved_base_type,
                                        template_name,
                                        tool_template_ref,
                                        conformance_binding_type_args,
                                        method_type_args,
                                    )
                                    mono.storage.resolved_trait_placeholder_keys.insert(trait_placeholder_key)
                                    mono.storage.in_progress_trait_placeholder_keys.remove(trait_placeholder_key)
                                    return
                        },
                        .None() then {},
                    }
                }
            }
            for node_ref in mono.storage.source_given_decls then {
                when node_ref in {
                    .GivenTraitDecl(target_type, trait_name, trait_args, _, _) then {
                        if not trait_conformance_target_matches(mono, target_type, parameterized_resolved_base_type)
                            and not trait_conformance_target_matches_for_template_binding(mono, target_type, parameterized_resolved_base_type)
                        then {
                            continue
                        }
                        let owner_template_for_trait_method = when mono.storage.generic_templates.lookup_extension_methods(template_name) in {
                            .Some(owner_templates) then {
                                let mut found = Option[* GenericExtensionMethodTemplate].None()
                                for owner_template in owner_templates then {
                                    if owner_template.method.name <> method_name then {
                                        continue
                                    }
                                    when owner_template.conformance_trait_name in {
                                        .Some(owner_trait_name) then {
                                            if trait_name_matches(owner_trait_name, trait_name) then {
                                                found = Option[* GenericExtensionMethodTemplate].Some(owner_template)
                                                break
                                            }
                                        },
                                        .None() then {},
                                    }
                                }
                                break found
                            },
                            .None() then Option[* GenericExtensionMethodTemplate].None(),
                        }
                        let inferred_trait_args = infer_trait_extension_type_args(mono, target_type, parameterized_resolved_base_type, trait_name)
                        let resolved_trait_args = if trait_args.is_empty() then
                                List[* Type].new()
                            else resolve_given_trait_args(mono, target_type, trait_args, parameterized_resolved_base_type)
                        let resolved_from_conformance = when owner_template_for_trait_method in {
                            .Some(owner_template_ref) then resolve_extension_template_conformance_trait_args(mono, resolved_base_type, owner_template_ref),
                            .None() then List[* Type].new(),
                        }
                        let inferred_from_binding = when owner_template_for_trait_method in {
                            .Some(owner_template_ref) then infer_trait_args_from_extension_template_binding(
                                mono,
                                owner_template_ref,
                                conformance_binding_type_args,
                                trait_name,
                            ),
                            .None() then List[* Type].new(),
                        }
                        let effective_trait_args = if not resolved_trait_args.is_empty() then {
                                break resolved_trait_args
                            } else if not resolved_from_conformance.is_empty() then {
                                break resolved_from_conformance
                            } else if not inferred_from_binding.is_empty() then {
                                break inferred_from_binding
                            } else inferred_trait_args
                        when select_trait_tool_template_cached(
                            mono,
                            trait_name,
                            method_name,
                            method_type_arg_count,
                            Option[UInt].Some(effective_trait_args.count()),
                        ) in {
                            .Some(tool_template_ref) then {
                                        let _ = mono.instantiate_extension_method_impl(
                                            resolved_base_type,
                                            template_name,
                                            tool_template_ref,
                                            effective_trait_args,
                                            method_type_args,
                                        )
                                        mono.storage.resolved_trait_placeholder_keys.insert(trait_placeholder_key)
                                        mono.storage.in_progress_trait_placeholder_keys.remove(trait_placeholder_key)
                                        return
                            },
                            .None() then {},
                        }
                    },
                    _ then {},
                }
            }
            instantiate_conformance_trait_methods_for_type(mono, resolved_base_type)
            mono.storage.in_progress_trait_placeholder_keys.remove(trait_placeholder_key)
            return
        },
    }

    let should_use_trait_fallback = when matched_template.conformance_trait_name in {
        .Some(_) then true,
        .None() then false,
    }
    if should_use_trait_fallback then {
        when matched_template.conformance_trait_name in {
            .Some(trait_name) then {
                let resolved_from_conformance = resolve_extension_template_conformance_trait_args(mono, resolved_base_type, matched_template)
                let inferred_from_binding = infer_trait_args_from_extension_template_binding(
                    mono,
                    matched_template,
                    conformance_binding_type_args,
                    trait_name,
                )
                let effective_trait_args = if not resolved_from_conformance.is_empty() then {
                        break resolved_from_conformance
                    } else if not inferred_from_binding.is_empty() then {
                        break inferred_from_binding
                    } else List[* Type].new()
                when select_trait_tool_template_cached(
                    mono,
                    trait_name,
                    method_name,
                    method_type_arg_count,
                    Option[UInt].Some(effective_trait_args.count()),
                ) in {
                    .Some(tool_template_ref) then {
                                let patched_template = patched_extension_template_with_body(
                                    matched_template,
                                    tool_template_ref,
                                )
                                let _ = mono.instantiate_extension_method_impl(
                                    resolved_base_type,
                                    template_name,
                                    patched_template,
                                    effective_trait_args,
                                    method_type_args,
                                )
                                mono.storage.resolved_trait_placeholder_keys.insert(trait_placeholder_key)
                                mono.storage.in_progress_trait_placeholder_keys.remove(trait_placeholder_key)
                                return
                    },
                    .None() then {},
                }
            },
            .None() then {},
        }
        for node_ref in mono.storage.source_given_decls then {
            when node_ref in {
                .GivenTraitDecl(target_type, trait_name, trait_args, _, _) then {
                    if not trait_conformance_target_matches(mono, target_type, parameterized_resolved_base_type)
                        and not trait_conformance_target_matches_for_template_binding(mono, target_type, parameterized_resolved_base_type)
                    then {
                        continue
                    }
                    let inferred_trait_args = infer_trait_extension_type_args(mono, target_type, parameterized_resolved_base_type, trait_name)
                    let resolved_trait_args = if trait_args.is_empty() then
                            List[* Type].new()
                        else resolve_given_trait_args(mono, target_type, trait_args, parameterized_resolved_base_type)
                    let resolved_from_conformance = resolve_extension_template_conformance_trait_args(mono, resolved_base_type, matched_template)
                    let inferred_from_binding = infer_trait_args_from_extension_template_binding(
                        mono,
                        matched_template,
                        conformance_binding_type_args,
                        trait_name,
                    )
                    let effective_trait_args = if not resolved_trait_args.is_empty() then {
                            break resolved_trait_args
                        } else if not resolved_from_conformance.is_empty() then {
                            break resolved_from_conformance
                        } else if not inferred_from_binding.is_empty() then {
                            break inferred_from_binding
                        } else inferred_trait_args
                    when select_trait_tool_template_cached(
                        mono,
                        trait_name,
                        method_name,
                        method_type_arg_count,
                        Option[UInt].Some(effective_trait_args.count()),
                    ) in {
                        .Some(tool_template_ref) then {
                                    let patched_template = patched_extension_template_with_body(
                                        matched_template,
                                        tool_template_ref,
                                    )
                                    let _ = mono.instantiate_extension_method_impl(
                                        resolved_base_type,
                                        template_name,
                                        patched_template,
                                        effective_trait_args,
                                        method_type_args,
                                    )
                                    mono.storage.resolved_trait_placeholder_keys.insert(trait_placeholder_key)
                                    mono.storage.in_progress_trait_placeholder_keys.remove(trait_placeholder_key)
                                    return
                        },
                        .None() then {},
                    }
                },
                _ then {},
            }
        }
    }

    // e. Call instantiate_extension_method with the resolved base_type, template_name,
    //    template, type_args, and method_type_args.
    mono.instantiate_extension_method_impl(
        resolved_base_type,
        template_name,
        matched_template,
        type_args,
        method_type_args,
    )
    mono.storage.resolved_trait_placeholder_keys.insert(trait_placeholder_key)
    mono.storage.in_progress_trait_placeholder_keys.remove(trait_placeholder_key)
}
