// core_expressions.koral - 表达式解析
//
// 实现 Parser 的表达式解析方法：
// - is_lambda_expression, parse_lambda_expression
// - parse_primary, parse_bracket_leading_expression
// - parse_parenthesized_expression, parse_block_expression
// - parse_when/if/while/for 表达式
// - parse_call_suffix, parse_subscript_suffix, parse_dot_suffix
// - parse_postfix_suffixes, parse_call, parse_unary

private type StaticDispatchReceiver(
    type_name String,
    type_args List[* TypeNode],
)

given Parser {
    protected is_lambda_expression(self) Bool = {
        // Must start with (
        when self.current().kind in {
            .LParen() then {},
            _ then { return false },
        }

        let mutable i = self.index + 1  // skip (

        // Empty params: () ...
        if i < self.tokens.count() then {
            when self.tokens[i].kind in {
                .RParen() then {
                    // () followed by optional type then ->
                    i += 1
                    // skip optional return type (identifier or [...])
                    if i < self.tokens.count() then {
                        when self.tokens[i].kind in {
                            .Arrow() then { return true },
                            .Identifier(_) then {
                                i += 1
                                if i < self.tokens.count() then {
                                    when self.tokens[i].kind in {
                                        .Arrow() then { return true },
                                        _ then {},
                                    }
                                }
                            },
                            .LBracket() then {
                                // skip [...] type arg list
                                let mutable depth UInt = 1
                                i += 1
                                while i < self.tokens.count() and depth > 0 then {
                                    when self.tokens[i].kind in {
                                        .LBracket() then { depth += 1 },
                                        .RBracket() then { depth -= 1 },
                                        .Eof() then { return false },
                                        _ then {},
                                    }
                                    i += 1
                                }
                                // after [...] expect identifier (type name)
                                if i < self.tokens.count() then {
                                    when self.tokens[i].kind in {
                                        .Identifier(_) then { i += 1 },
                                        _ then {},
                                    }
                                }
                                if i < self.tokens.count() then {
                                    when self.tokens[i].kind in {
                                        .Arrow() then { return true },
                                        _ then {},
                                    }
                                }
                            },
                            _ then {},
                        }
                    }
                    return false
                },
                _ then {},
            }
        }

        // Non-empty params: first token must be an identifier (param name)
        if i >= self.tokens.count() then { return false }
        when self.tokens[i].kind in {
            .Identifier(_) then {},
            _ then { return false },
        }

        // Scan forward: skip param list (name [Type], ...) looking for ) then optional type then ->
        // We do a simple scan: skip until matching ) at depth 0
        let mutable depth UInt = 1  // we already consumed the opening (
        i += 1  // skip first identifier
        while i < self.tokens.count() and depth > 0 then {
            when self.tokens[i].kind in {
                .LParen() then { depth += 1 },
                .LBracket() then { depth += 1 },
                .RParen() then {
                    depth -= 1
                    if depth == 0 then { break }
                },
                .RBracket() then { if depth > 0 then { depth -= 1 } },
                .Eof() then { return false },
                _ then {},
            }
            i += 1
        }
        if depth > 0 then { return false }
        i += 1  // skip )

        // skip optional return type
        if i < self.tokens.count() then {
            when self.tokens[i].kind in {
                .Arrow() then { return true },
                .Identifier(_) then {
                    i += 1
                    if i < self.tokens.count() then {
                        when self.tokens[i].kind in {
                            .Arrow() then { return true },
                            _ then {},
                        }
                    }
                },
                .LBracket() then {
                    let mutable d UInt = 1
                    i += 1
                    while i < self.tokens.count() and d > 0 then {
                        when self.tokens[i].kind in {
                            .LBracket() then { d += 1 },
                            .RBracket() then { d -= 1 },
                            .Eof() then { return false },
                            _ then {},
                        }
                        i += 1
                    }
                    if i < self.tokens.count() then {
                        when self.tokens[i].kind in {
                            .Identifier(_) then { i += 1 },
                            _ then {},
                        }
                    }
                    if i < self.tokens.count() then {
                        when self.tokens[i].kind in {
                            .Arrow() then { return true },
                            _ then {},
                        }
                    }
                },
                _ then {},
            }
        }
        return false
    }

    // Parse a lambda expression: (params) [ReturnType] -> body
    protected parse_lambda_expression(*mutable self) Result[* Expr] = {
        let start = self.current()

        if self.current().kind is .LParen() then {
            self.advance()
        } else {
            return .Error(box("Expected '(' in lambda expression"))
        }

        let mutable params = List[LambdaParam].new()

        // Parse parameter list
        while true then {
            if self.current().kind is .RParen() then {
                break
            }

            let name = self.expect_identifier("lambda parameter") or else {
                return .Error(box("parse lambda parameter error"))
            }
            if not self.is_valid_value_name(name) then {
                return .Error(box(self.invalid_parameter_name_error(name)))
            }

            if self.current().kind is .Colon() then {
                return .Error(box("Unexpected token: :"))
            }

            // Optional type annotation
            let mutable type_ann = Option[TypeNode].None()
            if self.is_type_start() then {
                let t = self.parse_type() or else {
                    return .Error(box("parse lambda parameter type error"))
                }
                type_ann = Option[TypeNode].Some(t)
            }

            params.push(LambdaParam(name, type_ann))

            when self.current().kind in {
                .Comma() then { self.advance() },
                .RParen() then {},
                _ then { return .Error(box("Expected ',' or ')' in lambda parameter list")) },
            }
        }

        when self.current().kind in {
            .RParen() then { self.advance() },
            _ then { return .Error(box("Expected ')' after lambda parameters")) },
        }

        // Optional return type
        let mutable return_type = Option[TypeNode].None()
        let has_arrow = when self.current().kind in { .Arrow() then true, _ then false }
        if not has_arrow then {
            if self.is_type_start() then {
                let t = self.parse_type() or else {
                    return .Error(box("parse lambda return type error"))
                }
                return_type = Option[TypeNode].Some(t)
            }
        }

        when self.current().kind in {
            .Arrow() then { self.advance() },
            _ then { return .Error(box("Expected '->' in lambda expression")) },
        }

        let body = self.parse_expression() or else {
            return .Error(box("parse lambda body error"))
        }

        return .Ok(box(Expr.LambdaExpr(params, return_type, body, self.span_from_start(start))))
    }

    protected build_duration_literal_expression(self, value String, unit String, span SourceSpan) Result[* Expr] = {
        let mutable secs_expr = box(Expr.IntegerLiteral("0", span))
        let mutable nanos_expr = box(Expr.IntegerLiteral("0", span))

        when unit in {
            "s" then {
                secs_expr = box(Expr.IntegerLiteral(value, span))
            },
            "ms" then {
                secs_expr = box(Expr.ArithmeticExpr(box(Expr.IntegerLiteral(value, span)), ArithmeticOperator.Divide(), box(Expr.IntegerLiteral("1000", span)), span))
                nanos_expr = box(Expr.ArithmeticExpr(box(Expr.ArithmeticExpr(box(Expr.IntegerLiteral(value, span)), ArithmeticOperator.Remainder(), box(Expr.IntegerLiteral("1000", span)), span)), ArithmeticOperator.Multiply(), box(Expr.IntegerLiteral("1000000", span)), span))
            },
            "us" then {
                secs_expr = box(Expr.ArithmeticExpr(box(Expr.IntegerLiteral(value, span)), ArithmeticOperator.Divide(), box(Expr.IntegerLiteral("1000000", span)), span))
                nanos_expr = box(Expr.ArithmeticExpr(box(Expr.ArithmeticExpr(box(Expr.IntegerLiteral(value, span)), ArithmeticOperator.Remainder(), box(Expr.IntegerLiteral("1000000", span)), span)), ArithmeticOperator.Multiply(), box(Expr.IntegerLiteral("1000", span)), span))
            },
            "ns" then {
                secs_expr = box(Expr.ArithmeticExpr(box(Expr.IntegerLiteral(value, span)), ArithmeticOperator.Divide(), box(Expr.IntegerLiteral("1000000000", span)), span))
                nanos_expr = box(Expr.ArithmeticExpr(box(Expr.IntegerLiteral(value, span)), ArithmeticOperator.Remainder(), box(Expr.IntegerLiteral("1000000000", span)), span))
            },
            _ then {
                return .Error(box("unsupported duration suffix: \(unit)"))
            },
        }

        let mutable args = List[* Expr].new()
        args.push(secs_expr)
        args.push(nanos_expr)

        let ctor = box(Expr.StaticMethodCall("Duration", List[* TypeNode].new(), "new", args, span))
        let mutable unwrap_path = List[String].new()
        unwrap_path.push("unwrap")
        let callee = box(Expr.MemberPath(ctor, unwrap_path, span))
        return .Ok(box(Expr.Call(callee, List[* Expr].new(), span)))
    }

    protected parse_primary(*mutable self) Result[* Expr] = {
        let t = self.current()

        when t.kind in {
            .Identifier(name) then {
                self.advance()
                return .Ok(box(Expr.Identifier(name, self.token_span(t))))
            },
            .KwSelf() then {
                self.advance()
                return .Ok(box(Expr.Identifier("self", self.token_span(t))))
            },
            .IntegerLiteral(value) then {
                self.advance()
                return .Ok(box(Expr.IntegerLiteral(value, self.token_span(t))))
            },
            .DurationLiteral(value, unit) then {
                self.advance()
                return self.build_duration_literal_expression(value, unit, self.token_span(t))
            },
            .FloatLiteral(value) then {
                self.advance()
                return .Ok(box(Expr.FloatLiteral(value, self.token_span(t))))
            },
            .StringLiteral(value) then {
                self.advance()
                let parsed = self.parse_string_literal_expr(value, self.span_from_start(t)) or return
                return .Ok(parsed)
            },
            .RuneLiteral(value) then {
                self.advance()
                return .Ok(box(Expr.RuneLiteral(value, self.token_span(t))))
            },
            .KwTrue() then {
                self.advance()
                return .Ok(box(Expr.BoolLiteral(true, self.token_span(t))))
            },
            .KwFalse() then {
                self.advance()
                return .Ok(box(Expr.BoolLiteral(false, self.token_span(t))))
            },
            .KwIt() then {
                self.advance()
                return .Ok(box(Expr.Identifier("it", self.token_span(t))))
            },
            .LParen() then {
                return self.parse_parenthesized_expression()
            },
            .LBrace() then {
                return self.parse_block_expression()
            },
            .LBracket() then {
                return self.parse_bracket_leading_expression()
            },
            .KwIf() then {
                return self.parse_if_expression()
            },
            .KwWhile() then {
                return self.parse_while_expression()
            },
            .KwFor() then {
                return self.parse_for_expression()
            },
            .KwWhen() then {
                return self.parse_when_expression()
            },
            .Dot() then {
                // Implicit member expression: .SomeName or .SomeName(args)
                let span = self.span_from_start(t)
                self.advance() // consume '.'
                let member_name = self.expect_identifier("implicit member name") or return
                let mutable call_args = List[* Expr].new()
                let cur_kind = self.current().kind
                let has_lparen = when cur_kind in { .LParen() then true, _ then false }
                let no_newline = not self.current().has_newline_before
                if has_lparen and no_newline then {
                    self.advance() // consume '('
                    call_args = self.parse_argument_list_until_rparen("implicit member call") or return
                    when self.current().kind in {
                        .RParen() then { self.advance() },
                        _ then { return .Error(box("Expected ')' after implicit member call arguments")) },
                    }
                }
                return .Ok(box(Expr.ImplicitMemberExpr(member_name, call_args, span)))
            },
            // Prefix/full range expressions used as standalone values (e.g. as arguments)
            .Range() then {
                self.advance()
                if self.is_expr_start_token(self.current().kind) and self.can_continue_range_bound_after_newline() then {
                    let rhs = self.parse_unary() or return
                    return .Ok(box(Expr.RangeExpr(RangeOperator.To(), Option[* Expr].None(), Option[* Expr].Some(rhs), self.span_from_start(t))))
                }
                return .Ok(box(Expr.RangeExpr(RangeOperator.Full(), Option[* Expr].None(), Option[* Expr].None(), self.span_from_start(t))))
            },
            .RangeLess() then {
                self.advance()
                if not self.can_continue_range_bound_after_newline() then {
                    return .Error(box("Unexpected token: \(token_text(self.current()))"))
                }
                let rhs = self.parse_unary() or return
                return .Ok(box(Expr.RangeExpr(RangeOperator.ToOpen(), Option[* Expr].None(), Option[* Expr].Some(rhs), self.span_from_start(t))))
            },
            _ then {
                return .Error(box("Unexpected token: \(token_text(t))"))
            },
        }
    }

    protected parse_bracket_leading_expression(*mutable self) Result[* Expr] = {
        return self.parse_collection_or_dict_literal()
    }

    protected extract_static_dispatch_receiver(self, expr * Expr) Option[StaticDispatchReceiver] = {
        return when expr in {
            .Identifier(base_name, _) then if self.is_upper_first(base_name)
                then Option[StaticDispatchReceiver].Some(StaticDispatchReceiver(base_name, List[* TypeNode].new()))
                else Option[StaticDispatchReceiver].None(),
            .GenericInstantiation(base_name, type_args, _) then {
                break Option[StaticDispatchReceiver].Some(StaticDispatchReceiver(base_name, type_args))
            },
            .MemberPath(base_expr, path, _) then {
                if not path.is_empty() then {
                    if self.extract_static_dispatch_receiver(base_expr) is .Some(base_receiver) then {
                        if base_receiver.type_args.is_empty() then {
                            let mutable qualified = base_receiver.type_name
                            let mutable all_upper = true
                            for seg in path then {
                                if not self.is_upper_first(seg) then {
                                    all_upper = false
                                } else {
                                    qualified = qualified + "." + seg
                                }
                            }
                            if all_upper then {
                                return Option[StaticDispatchReceiver].Some(StaticDispatchReceiver(qualified, List[* TypeNode].new()))
                            }
                        }
                    }

                    let last = path[path.count() - 1]
                    if self.is_upper_first(last) then {
                        break Option[StaticDispatchReceiver].Some(StaticDispatchReceiver(last, List[* TypeNode].new()))
                    } else {
                        break Option[StaticDispatchReceiver].None()
                    }
                }
                break Option[StaticDispatchReceiver].None()
            },
            _ then Option[StaticDispatchReceiver].None(),
        }
    }

    protected member_path_call_receiver_expr(self, base * Expr, path List[String]) * Expr = {
        return if path.count() == 1 then base else {
            let mutable receiver_path = List[String].new()
            let mutable idx UInt = 0
            while idx + 1 < path.count() then {
                receiver_path.push(path[idx])
                idx += 1
            }
            break box(Expr.MemberPath(base, receiver_path, self.span_from_expr_start(base)))
        }
    }

    protected parse_parenthesized_expression(*mutable self) Result[* Expr] = {
        let start = self.current()
        let saved = self.save_state()
        when self.parse_lambda_expression() in {
            .Ok(lambda_expr) then {
                return .Ok(lambda_expr)
            },
            .Error(err) then {
                self.restore_state(saved)
                if self.is_lambda_expression() then {
                    return .Error(err)
                }
            },
        }

        self.advance()
        self.enter_line_join_grouping()
        let first = self.parse_expression_checked("parenthesized expression") or else {
            self.leave_line_join_grouping()
            return .Error(it)
        }
        when self.current().kind in {
            .Comma() then {
                self.advance()
                let second = self.parse_expression_checked("pair literal second element") or else {
                    self.leave_line_join_grouping()
                    return .Error(it)
                }
                let has_rparen = when self.current().kind in { .RParen() then true, _ then false }
                if not has_rparen then {
                    self.leave_line_join_grouping()
                    return .Error(box("Expected ')'"))
                }
                self.advance()
                self.leave_line_join_grouping()
                let mutable args = List[* Expr].new()
                args.push(first)
                args.push(second)
                let span = self.span_from_start(start)
                return .Ok(box(Expr.Call(box(Expr.Identifier("Pair", span)), args, span)))
            },
            .RParen() then {
                self.advance()
                self.leave_line_join_grouping()
                return .Ok(first)
            },
            _ then {
                self.leave_line_join_grouping()
                return .Error(box("Expected ')'"))
            },
        }
    }

    protected parse_block_expression(*mutable self) Result[* Expr] = {
        let start = self.current()
        when self.current().kind in {
            .LBrace() then { self.advance() },
            _ then { return .Error(box("Expected '{' to start block")) },
        }

        self.parse_debug("block begin")
        let statements = self.parse_statement_list_until_rbrace("block") or return

        let span = self.span_from_start(start)
        return .Ok(box(Expr.Block(statements, span)))
    }

    protected parse_call_argument(*mutable self, context String) Result[* Expr] = {
        let start = self.current()
        let saved = self.save_state()

        when self.current().kind in {
            .Identifier(label) then {
                let next_is_colon = self.next_is_colon()
                if not self.is_upper_first(label) and next_is_colon then {
                    self.advance()
                    self.advance()
                    let expr = self.parse_expression_checked("named \(context) argument") or else {
                        self.restore_state(saved)
                        return .Error(box("parse named argument error"))
                    }
                    return .Ok(box(Expr.NamedArgument(label, expr, self.span_from_start(start))))
                }
            },
            _ then {},
        }

        self.restore_state(saved)
        return self.parse_expression_checked("\(context) arguments")
    }

    protected parse_pattern_argument(*mutable self, stop_on_in Bool) Result[PatternElement] = {
        let saved = self.save_state()

        when self.current().kind in {
            .Identifier(label) then {
                let next_is_colon = self.next_is_colon()
                if label <> "_" and not self.is_upper_first(label) and next_is_colon then {
                    self.advance()
                    self.advance()
                    let pattern = self.parse_pattern_or(stop_on_in) or else {
                        self.restore_state(saved)
                        return .Error(box("parse named pattern argument error"))
                    }
                    return .Ok(PatternElement(Option[String].Some(label), box(pattern)))
                }
            },
            _ then {},
        }

        self.restore_state(saved)
        let pattern = self.parse_pattern_or(stop_on_in) or return
        return .Ok(PatternElement(Option[String].None(), box(pattern)))
    }

    protected parse_argument_list_until_rparen(*mutable self, context String) Result[List[* Expr]] = {
        self.enter_line_join_grouping()
        let mutable args = List[* Expr].new()
        if self.current().kind is .RParen() then {
            self.leave_line_join_grouping()
            return .Ok(args)
        }

        while true then {
            let parsed = self.parse_call_argument(context) or else {
                self.leave_line_join_grouping()
                return .Error(it)
            }
            args.push(parsed)
            if self.current().kind is .Comma() then {
                self.advance()
                if self.current().kind is .RParen() then {
                    break
                }
            } else {
                break
            }
        }

        self.leave_line_join_grouping()
        return .Ok(args)
    }

    protected parse_control_flow_body(*mutable self) Result[* Expr] = {
        return self.parse_expression_checked("control-flow body")
    }

    protected parse_when_arm_body(*mutable self) Result[* Expr] = {
        // `when` arm body follows expression grammar; block is one expression form.
        if self.current().kind is .LBrace() then {
            let body = self.parse_block_expression() or return
            return .Ok(body)
        }
        return self.parse_expression_checked("when arm body")
    }

    protected expect_kw_then(*mutable self, context String) Result[Token] = {
        let t = self.current()
        when t.kind in {
            .KwThen() then {
                self.advance()
                return .Ok(t)
            },
            _ then {
                return .Error(box("Expected 'then' in \(context) at \(t.line):\(t.column)"))
            },
        }
    }

    protected expect_kw_in(*mutable self, context String) Result[Token] = {
        let t = self.current()
        when t.kind in {
            .KwIn() then {
                self.advance()
                return .Ok(t)
            },
            _ then {
                return .Error(box("Expected 'in' in \(context) at \(t.line):\(t.column)"))
            },
        }
    }

    protected expect_lbrace(*mutable self, context String) Result[Token] = {
        let t = self.current()
        when t.kind in {
            .LBrace() then {
                self.advance()
                return .Ok(t)
            },
            _ then {
                return .Error(box("Expected '{' to start \(context) at \(t.line):\(t.column)"))
            },
        }
    }

    protected parse_when_arm(*mutable self) Result[WhenArm] = {
        let arm_start_index = self.index
        let arm_start = self.current()
        self.parse_debug("when arm begin @ \(arm_start.line):\(arm_start.column) token=\(token_text(arm_start))")
        let pattern = self.collect_pattern_until_then() or return

        let _ = self.expect_kw_then("when arm") or return

        let body = self.parse_when_arm_body() or return

        if self.index == arm_start_index then {
            let t = self.current()
            return .Error(box("Parser made no progress in when arm at \(t.line):\(t.column) (token: \(token_text(t)))"))
        }

        return .Ok(WhenArm(pattern, body))
    }

    protected parse_when_arms(*mutable self) Result[List[WhenArm]] = {
        let mutable arms = List[WhenArm].new()
        while true then {
            when self.current().kind in {
                .RBrace() then {
                    self.advance()
                    break
                },
                .Eof() then {
                    return .Error(box("Unexpected EOF in when expression"))
                },
                _ then {
                    let arm = self.parse_when_arm() or return
                    arms.push(arm)
                    if self.current().kind is .Comma() then {
                        self.advance()
                    }
                },
            }
        }
        return .Ok(arms)
    }

    protected try_parse_postfix_cast_suffix(*mutable self, base * Expr) Option[* Expr] = {
        let saved = self.save_state()
        when self.current().kind in {
            .LParen() then {},
            _ then { return Option[* Expr].None() },
        }

        self.advance()

        let cast_type = self.parse_type() or else {
            self.restore_state(saved)
            return Option[* Expr].None()
        }

        when self.current().kind in {
            .RParen() then { self.advance() },
            _ then {
                self.restore_state(saved)
                return Option[* Expr].None()
            },
        }
        return Option[* Expr].Some(box(Expr.CastExpr(cast_type, base, self.span_from_expr_start(base))))
    }

    protected parse_pattern_primary(*mutable self, stop_on_in Bool) Result[PatternNode] = {
        let start = self.current()

        when self.current().kind in {
            .Eof() then {
                return .Error(box("Unexpected EOF while parsing pattern"))
            },
            .KwThen() then {
                if not stop_on_in then {
                    return .Error(box("Expected pattern before 'then'"))
                }
            },
            .KwIn() then {
                if stop_on_in then {
                    return .Error(box("Expected pattern before 'in'"))
                }
            },
            _ then {},
        }

        let node = when self.current().kind in {
            .KwMut() then {
                self.advance()
                let name = self.expect_identifier("mutable pattern variable") or return
                break PatternNode.Variable(name, true, self.span_from_start(start))
            },
            .KwTrue() then {
                self.advance()
                break PatternNode.BoolLiteral(true, self.span_from_start(start))
            },
            .KwFalse() then {
                self.advance()
                break PatternNode.BoolLiteral(false, self.span_from_start(start))
            },
            .Minus() then {
                self.advance()
                let value = if self.current().kind is .IntegerLiteral(v)
                    then {
                        self.advance()
                        break v
                    }
                    else {
                        return .Error(box("Expected integer literal after '-' in negative pattern"))
                    }
                break PatternNode.NegativeIntegerLiteral(value, self.span_from_start(start))
            },
            .IntegerLiteral(value) then {
                self.advance()
                break PatternNode.IntegerLiteral(value, self.span_from_start(start))
            },
            .StringLiteral(value) then {
                self.advance()
                break PatternNode.StringLiteral(value, self.span_from_start(start))
            },
            .RuneLiteral(value) then {
                self.advance()
                break PatternNode.RuneLiteral(value, self.span_from_start(start))
            },
            .Greater() then {
                self.advance()
                let mutable is_negative = false
                if self.current().kind is .Minus() then {
                    self.advance()
                    is_negative = true
                }
                let value = if self.current().kind is .IntegerLiteral(v)
                    then {
                        self.advance()
                        break if is_negative then "-\(v)" else v
                    }
                    else {
                        return .Error(box("Expected integer literal after '>' in comparison pattern"))
                    }
                break PatternNode.ComparisonPattern(ComparisonPatternOperator.Greater(), value, self.span_from_start(start))
            },
            .Less() then {
                self.advance()
                let mutable is_negative = false
                if self.current().kind is .Minus() then {
                    self.advance()
                    is_negative = true
                }
                let value = if self.current().kind is .IntegerLiteral(v)
                    then {
                        self.advance()
                        break if is_negative then "-\(v)" else v
                    }
                    else {
                        return .Error(box("Expected integer literal after '<' in comparison pattern"))
                    }
                break PatternNode.ComparisonPattern(ComparisonPatternOperator.Less(), value, self.span_from_start(start))
            },
            .GreaterEqual() then {
                self.advance()
                let mutable is_negative = false
                if self.current().kind is .Minus() then {
                    self.advance()
                    is_negative = true
                }
                let value = if self.current().kind is .IntegerLiteral(v)
                    then {
                        self.advance()
                        break if is_negative then "-\(v)" else v
                    }
                    else {
                        return .Error(box("Expected integer literal after '>=' in comparison pattern"))
                    }
                break PatternNode.ComparisonPattern(ComparisonPatternOperator.GreaterEqual(), value, self.span_from_start(start))
            },
            .LessEqual() then {
                self.advance()
                let mutable is_negative = false
                if self.current().kind is .Minus() then {
                    self.advance()
                    is_negative = true
                }
                let value = if self.current().kind is .IntegerLiteral(v)
                    then {
                        self.advance()
                        break if is_negative then "-\(v)" else v
                    }
                    else {
                        return .Error(box("Expected integer literal after '<=' in comparison pattern"))
                    }
                break PatternNode.ComparisonPattern(ComparisonPatternOperator.LessEqual(), value, self.span_from_start(start))
            },
            .Identifier(name) then {
                self.advance()
                let parsed_pattern = if name == "_" then PatternNode.Wildcard(self.span_from_start(start)) else {
                    // Struct destructuring pattern: TypeName(pattern1, pattern2, ...)
                    let mutable parsed_pattern = PatternNode.Variable(name, false, self.span_from_start(start))
                    if self.is_upper_first(name) then {
                        if self.current().kind is .LParen() then {
                            self.advance()
                            let mutable elements = List[PatternElement].new()
                            if self.current().kind is .RParen() then {
                                self.advance()
                            } else {
                                while true then {
                                    let elem = self.parse_pattern_argument(stop_on_in) or return
                                    elements.push(elem)
                                    if self.current().kind is .Comma() then {
                                        self.advance()
                                    } else {
                                        break
                                    }
                                }
                                when self.current().kind in {
                                    .RParen() then { self.advance() },
                                    _ then { return .Error(box("Expected ')' in struct destructuring pattern")) },
                                }
                            }
                            parsed_pattern = PatternNode.StructPattern(name, elements, self.span_from_start(start))
                        }
                    }
                    if not self.is_upper_first(name) and not self.is_valid_value_name(name) then {
                        return .Error(box(self.invalid_variable_name_error(name)))
                    }
                    break parsed_pattern
                }
                break parsed_pattern
            },
            .Dot() then {
                self.advance()
                let case_name = self.expect_identifier("enum case pattern") or return
                if not self.is_upper_first(case_name) then {
                    return .Error(box(self.invalid_enum_case_name_error(case_name)))
                }
                let mutable elements = List[PatternElement].new()

                if self.current().kind is .LParen() then {
                    self.advance()
                    if self.current().kind is .RParen() then {
                        self.advance()
                    } else {
                        while true then {
                            let elem = self.parse_pattern_argument(stop_on_in) or return
                            elements.push(elem)
                            if self.current().kind is .Comma() then {
                                self.advance()
                            } else {
                                break
                            }
                        }
                        when self.current().kind in {
                            .RParen() then { self.advance() },
                            _ then { return .Error(box("Expected ')' in enum case pattern")) },
                        }
                    }
                }

                break PatternNode.EnumCase(case_name, elements, self.span_from_start(start))
            },
            .LParen() then {
                self.advance()
                let first = self.parse_pattern_or(stop_on_in) or return
                // Pair pattern: (pattern1, pattern2)
                let mutable parsed_pattern = first
                if self.current().kind is .Comma() then {
                    self.advance()
                    let second = self.parse_pattern_or(stop_on_in) or return
                    when self.current().kind in {
                        .RParen() then { self.advance() },
                        _ then { return .Error(box("Expected ')' in pair pattern")) },
                    }
                    let mutable elements = List[PatternElement].new()
                    elements.push(PatternElement(Option[String].None(), box(first)))
                    elements.push(PatternElement(Option[String].None(), box(second)))
                    parsed_pattern = PatternNode.StructPattern("Pair", elements, self.span_from_start(start))
                } else {
                    when self.current().kind in {
                        .RParen() then { self.advance() },
                        _ then { return .Error(box("Expected ')' in pattern")) },
                    }
                }
                break parsed_pattern
            },
            _ then {
                return .Error(box("Unexpected token in pattern: \(token_text(self.current()))"))
            },
        }
        return .Ok(node)
    }

    protected parse_pattern_not(*mutable self, stop_on_in Bool) Result[PatternNode] = {
        let start = self.current()
        if self.current().kind is .KwNot() then {
            self.advance()
            let inner = self.parse_pattern_not(stop_on_in) or return
            return .Ok(PatternNode.NotPattern(box(inner), self.span_from_start(start)))
        }
        return self.parse_pattern_primary(stop_on_in)
    }

    protected parse_pattern_and(*mutable self, stop_on_in Bool) Result[PatternNode] = {
        let start = self.current()
        let mutable left = self.parse_pattern_not(stop_on_in) or return

        while self.current().kind is .KwAnd() then {
            self.advance()
            let right = self.parse_pattern_primary(stop_on_in) or return
            left = PatternNode.AndPattern(box(left), box(right), self.span_from_start(start))
        }

        return .Ok(left)
    }

    protected parse_pattern_or(*mutable self, stop_on_in Bool) Result[PatternNode] = {
        let start = self.current()
        let mutable left = self.parse_pattern_and(stop_on_in) or return

        while true then {
            when self.current().kind in {
                .Pipe() then { self.advance() },
                .KwOr() then { self.advance() },
                _ then { break },
            }
            let right = self.parse_pattern_and(stop_on_in) or return
            left = PatternNode.OrPattern(box(left), box(right), self.span_from_start(start))
        }

        return .Ok(left)
    }

    protected collect_pattern_until_then(*mutable self) Result[PatternNode] = {
        let pattern = self.parse_pattern_or(false) or return
        when self.current().kind in {
            .KwThen() then { return .Ok(pattern) },
            _ then { return .Error(box("Expected 'then' after pattern")) },
        }
    }

    protected parse_single_pattern(*mutable self) Result[PatternNode] = {
        return self.parse_pattern_primary(false)
    }

    protected collect_pattern_until_clause_end(*mutable self) Result[PatternNode] = {
        let pattern = self.parse_pattern_or(false) or return
        when self.current().kind in {
            .KwThen() then { return .Ok(pattern) },
            .Semicolon() then { return .Ok(pattern) },
            _ then { return .Error(box("Expected ';' or 'then' after pattern")) },
        }
    }

    protected collect_pattern_until_in(*mutable self) Result[PatternNode] = {
        let pattern = self.parse_pattern_or(true) or return
        when self.current().kind in {
            .KwIn() then { return .Ok(pattern) },
            _ then { return .Error(box("Expected 'in' after pattern")) },
        }
    }

    protected parse_collection_or_dict_literal(*mutable self) Result[* Expr] = {
        let start = self.current()
        self.advance()
        self.enter_line_join_grouping()

        if self.current().kind is .RBracket() then {
            self.advance()
            self.leave_line_join_grouping()
            return .Ok(box(Expr.EmptyLiteral(self.span_from_start(start))))
        }

        let first = self.parse_expression() or else {
            self.leave_line_join_grouping()
            return .Error(it)
        }

        if self.current().kind is .Colon() then {
            self.advance()
            let first_value = self.parse_expression() or else {
                self.leave_line_join_grouping()
                return .Error(it)
            }
            let mutable entries = List[ExprPair].new()
            entries.push(ExprPair(first, first_value))

            while self.current().kind is .Comma() then {
                self.advance()
                if self.current().kind is .RBracket() then {
                    break
                }
                let key = self.parse_expression() or else {
                    self.leave_line_join_grouping()
                    return .Error(it)
                }
                when self.current().kind in {
                    .Colon() then { self.advance() },
                    _ then {
                        self.leave_line_join_grouping()
                        return .Error(box("Expected ':' in dict literal entry"))
                    },
                }
                let value = self.parse_expression() or else {
                    self.leave_line_join_grouping()
                    return .Error(it)
                }
                entries.push(ExprPair(key, value))
            }

            when self.current().kind in {
                .RBracket() then { self.advance() },
                _ then {
                    self.leave_line_join_grouping()
                    return .Error(box("Expected ']' after dict literal"))
                },
            }
            self.leave_line_join_grouping()
            return .Ok(box(Expr.DictLiteral(entries, self.span_from_start(start))))
        }

        let mutable elements = List[* Expr].new()
        elements.push(first)

        while self.current().kind is .Comma() then {
            self.advance()
            if self.current().kind is .RBracket() then {
                break
            }
            let next = self.parse_expression() or else {
                self.leave_line_join_grouping()
                return .Error(it)
            }
            elements.push(next)
        }

        when self.current().kind in {
            .RBracket() then { self.advance() },
            _ then {
                self.leave_line_join_grouping()
                return .Error(box("Expected ']' after collection literal"))
            },
        }
        self.leave_line_join_grouping()
        return .Ok(box(Expr.CollectionLiteral(elements, self.span_from_start(start))))
    }

    protected parse_when_expression(*mutable self) Result[* Expr] = {
        let start = self.current()
        self.advance()
        let subject = self.parse_expression_checked("when subject") or return

        let _ = self.expect_kw_in("when expression") or return

        let _ = self.expect_lbrace("when arms") or return

        let arms = self.parse_when_arms() or return

        return .Ok(box(Expr.WhenExpr(subject, arms, self.span_from_start(start))))
    }

    protected parse_if_expression(*mutable self) Result[* Expr] = {
        let start = self.current()
        self.advance()
        let condition = self.parse_expression_checked("if condition") or return

        let _ = self.expect_kw_then("if expression") or return
        let then_expr = self.parse_control_flow_body() or return

        let mutable else_expr = Option[* Expr].None()
        if self.current().kind is .KwElse() then {
            self.advance()
            let parsed_else = self.parse_expression_checked("if else body") or return
            else_expr = .Some(parsed_else)
        }

        let span = self.span_from_start(start)
        return .Ok(box(Expr.IfExpr(condition, then_expr, else_expr, span)))
    }

    protected parse_while_expression(*mutable self) Result[* Expr] = {
        let start = self.current()
        self.advance()
        let condition = self.parse_expression_checked("while condition") or return

        let _ = self.expect_kw_then("while expression") or return
        let body = self.parse_control_flow_body() or return

        let span = self.span_from_start(start)
        return .Ok(box(Expr.WhileExpr(condition, body, span)))
    }

    protected parse_for_expression(*mutable self) Result[* Expr] = {
        let start = self.current()
        self.advance()
        let pattern = self.collect_pattern_until_in() or return

        let _ = self.expect_kw_in("for expression") or return

        let iterable = self.parse_expression_checked("for iterable") or return

        let _ = self.expect_kw_then("for expression") or return

        let body = self.parse_control_flow_body() or return

        return .Ok(box(Expr.ForExpr(pattern, iterable, body, self.span_from_start(start))))
    }

    protected parse_postfix_generic_application(*mutable self, base * Expr) Result[* Expr] = {
        return when base in {
            .Identifier(name, _) then {
                let type_args = self.parse_type_arg_list() or else {
                    return .Error(box("parse generic application type arguments error"))
                }
                break .Ok(box(Expr.GenericInstantiation(name, type_args, self.span_from_expr_start(base))))
            },
            _ then .Error(box("generic application requires a type-like base expression")),
        }
    }

    protected try_parse_postfix_generic_application(*mutable self, base * Expr) Option[* Expr] = {
        let saved = self.save_state()
        let parsed = self.parse_postfix_generic_application(base)
        return when parsed in {
            .Ok(expr) then Option[* Expr].Some(expr),
            .Error(_) then {
                self.restore_state(saved)
                break Option[* Expr].None()
            },
        }
    }

    protected try_parse_method_type_args(*mutable self) Option[List[* TypeNode]] = {
        if self.current().kind is not .LBracket() then {
            return Option[List[* TypeNode]].None()
        }

        let saved = self.save_state()
        let type_args = self.parse_type_arg_list() or else {
            self.restore_state(saved)
            return Option[List[* TypeNode]].None()
        }
        if self.current().kind is .LParen() then {
            return Option[List[* TypeNode]].Some(type_args)
        }

        self.restore_state(saved)
        return Option[List[* TypeNode]].None()
    }

    protected parse_call_suffix(*mutable self, base * Expr) Result[* Expr] = {
        self.advance()
        let args = self.parse_argument_list_until_rparen("call") or return
        when self.current().kind in {
            .RParen() then { self.advance() },
            _ then { return .Error(box("Expected ')' after call arguments")) },
        }
        when base in {
            .MemberPath(receiver_base, path, _) then {
                if path.is_empty() then {
                    return .Ok(box(Expr.Call(base, args, self.span_from_expr_start(base))))
                }
                let member = path[path.count() - 1]
                let receiver_expr = self.member_path_call_receiver_expr(receiver_base, path)
                return when receiver_expr in {
                    .Identifier(type_name, _) then {
                        let expr = if self.is_upper_first(type_name)
                            then box(Expr.StaticMethodCall(type_name, List[* TypeNode].new(), member, args, self.span_from_expr_start(base)))
                            else box(Expr.Call(base, args, self.span_from_expr_start(base)))
                        break Result[* Expr].Ok(expr)
                    },
                    .GenericInstantiation(type_name, type_args, _) then {
                        break Result[* Expr].Ok(box(Expr.StaticMethodCall(type_name, type_args, member, args, self.span_from_expr_start(base))))
                    },
                    .MemberPath(_, _, _) then {
                        let expr = when self.extract_static_dispatch_receiver(receiver_expr) in {
                            .Some(receiver) then box(Expr.StaticMethodCall(receiver.type_name, receiver.type_args, member, args, self.span_from_expr_start(base))),
                            .None() then box(Expr.Call(base, args, self.span_from_expr_start(base))),
                        }
                        break Result[* Expr].Ok(expr)
                    },
                    _ then Result[* Expr].Ok(box(Expr.Call(base, args, self.span_from_expr_start(base)))),
                }
            },
            _ then {},
        }
        return .Ok(box(Expr.Call(base, args, self.span_from_expr_start(base))))
    }

    protected parse_subscript_suffix(*mutable self, base * Expr) Result[* Expr] = {
        self.advance()
        self.enter_line_join_grouping()
        if self.current().kind is .RBracket() then {
            self.leave_line_join_grouping()
            return .Error(box("Subscript expression requires one index argument"))
        }
        let index = self.parse_expression_checked("subscript index") or else {
            self.leave_line_join_grouping()
            return .Error(it)
        }
        if self.current().kind is .Comma() then {
            self.leave_line_join_grouping()
            return .Error(box("Subscript expression supports exactly one index"))
        }
        when self.current().kind in {
            .RBracket() then { self.advance() },
            _ then {
                self.leave_line_join_grouping()
                return .Error(box("Expected ']' after subscript argument"))
            },
        }
        self.leave_line_join_grouping()
        let mutable args = List[* Expr].new()
        args.push(index)
        return .Ok(box(Expr.SubscriptExpr(base, args, self.span_from_expr_start(base))))
    }

    protected append_member_path_segment(self, base * Expr, member String) * Expr = {
        let span = self.span_from_expr_start(base)
        return when base in {
            .MemberPath(path_base, path, _) then {
                let mutable extended = List[String].new()
                for segment in path then {
                    extended.push(segment)
                }
                extended.push(member)
                break box(Expr.MemberPath(path_base, extended, span))
            },
            _ then {
                let mutable path = List[String].new()
                path.push(member)
                break box(Expr.MemberPath(base, path, span))
            },
        }
    }

    protected parse_dot_suffix(*mutable self, base * Expr) Result[* Expr] = {
        self.advance()


        // 0b/0o/0x literals cannot be floating-point forms like 0b101.1.
        if base is .IntegerLiteral(value, _) and self.current().kind is .IntegerLiteral(_) then {
            if value.starts_with("0b") then {
                return .Error(box("0b literals do not support floating point"))
            }
            if value.starts_with("0o") then {
                return .Error(box("0o literals do not support floating point"))
            }
            if value.starts_with("0x") then {
                return .Error(box("0x literals do not support floating point"))
            }
        }

        if self.current().kind is .LParen() then {
            self.advance()
            let trait_name = self.expect_identifier("qualified method trait") or return
            when self.current().kind in {
                .RParen() then { self.advance() },
                _ then { return .Error(box("Expected ')' after qualified method trait")) },
            }

            let method_name = self.expect_identifier("qualified method name") or return
            let method_type_args = when self.try_parse_method_type_args() in {
                .Some(type_args) then type_args,
                .None() then List[* TypeNode].new(),
            }
            when self.current().kind in {
                .LParen() then { self.advance() },
                _ then { return .Error(box("Expected '(' after qualified method name")) },
            }
            let args = self.parse_argument_list_until_rparen("qualified method call") or return
            when self.current().kind in {
                .RParen() then { self.advance() },
                _ then { return .Error(box("Expected ')' after qualified method call arguments")) },
            }

            return if method_type_args.is_empty()
                then .Ok(box(Expr.QualifiedMethodCall(base, trait_name, method_name, args, self.span_from_expr_start(base))))
                else .Ok(box(Expr.QualifiedGenericMethodCall(base, trait_name, method_type_args, method_name, args, self.span_from_expr_start(base))))
        }

        let member = self.expect_identifier("member access") or return
        self.parse_debug("dot suffix member=\(member)")
        let method_type_args = when self.try_parse_method_type_args() in {
            .Some(type_args) then type_args,
            .None() then List[* TypeNode].new(),
        }

        let has_lparen = when self.current().kind in {
            .LParen() then true,
            _ then false,
        }
        let static_receiver = self.extract_static_dispatch_receiver(base)

        if has_lparen and static_receiver is .Some(receiver) and method_type_args.is_empty() then {
            self.parse_debug("static dispatch receiver=\(receiver.type_name) member=\(member)")
            self.advance()
            let args = self.parse_argument_list_until_rparen("static method call") or return
            when self.current().kind in {
                .RParen() then { self.advance() },
                _ then { return .Error(box("Expected ')' after static method call arguments")) },
            }
            return .Ok(box(Expr.StaticMethodCall(receiver.type_name, receiver.type_args, member, args, self.span_from_expr_start(base))))
        }

        if has_lparen and not method_type_args.is_empty() then {
            self.advance()
            let args = self.parse_argument_list_until_rparen("generic method call") or return
            when self.current().kind in {
                .RParen() then { self.advance() },
                _ then { return .Error(box("Expected ')' after generic method call arguments")) },
            }
            return .Ok(box(Expr.GenericMethodCall(base, method_type_args, member, args, self.span_from_expr_start(base))))
        }

        if not method_type_args.is_empty() then {
            return .Error(box("Expected '(' after generic method name"))
        }

        let member_path = self.append_member_path_segment(base, member)
        let _ = has_lparen
        return .Ok(member_path)
    }

    protected parse_postfix_suffixes(*mutable self, base * Expr) Result[* Expr] = {
        let mutable expr = base

        while true then {
            when self.current().kind in {
                .LParen() then {
                    if not self.should_continue_postfix_after_expression() then { break }
                    expr = when self.try_parse_postfix_cast_suffix(expr) in {
                        .Some(cast_expr) then cast_expr,
                        .None() then self.parse_call_suffix(expr) or return,
                    }
                },
                .LBracket() then {
                    if not self.should_continue_postfix_after_expression() then { break }
                    when expr in {
                        .Identifier(name, _) then {
                            if self.is_upper_first(name) then {
                                expr = self.parse_postfix_generic_application(expr) or return
                            } else {
                                expr = when self.try_parse_postfix_generic_application(expr) in {
                                    .Some(generic_expr) then generic_expr,
                                    .None() then self.parse_subscript_suffix(expr) or return,
                                }
                            }
                        },
                        _ then {
                            expr = self.parse_subscript_suffix(expr) or return
                        },
                    }
                },
                .Dot() then {
                    if not self.can_continue_dot_postfix() then { break }
                    expr = self.parse_dot_suffix(expr) or return
                },
                _ then { break },
            }
        }

        return .Ok(expr)
    }

    protected parse_call(*mutable self) Result[* Expr] = {
        let expr = self.parse_primary() or return
        return self.parse_postfix_suffixes(expr)
    }

    protected parse_unary(*mutable self) Result[* Expr] = {
        if self.current().kind is .Minus() then {
            let start = self.current()
            self.advance()
            let operand = self.parse_unary() or return
            return .Ok(box(Expr.Unary(UnaryOperator.Negate(), operand, self.span_from_start(start))))
        }

        if self.current().kind is .Tilde() then {
            let start = self.current()
            self.advance()
            let operand = self.parse_unary() or return
            return .Ok(box(Expr.Unary(UnaryOperator.BitwiseNot(), operand, self.span_from_start(start))))
        }

        if self.current().kind is .Star() then {
            let start = self.current()
            self.advance()
            let operand = self.parse_unary() or return
            return .Ok(box(Expr.DerefExpr(operand, self.span_from_start(start))))
        }

        if self.current().kind is .KwUnsafe() then {
            let start = self.current()
            self.advance()
            if self.current().kind is .Ampersand() then {
                self.advance()
                let is_mutable = self.current().kind is .KwMut()
                if is_mutable then { self.advance() }
                let operand = self.parse_unary() or return
                return .Ok(box(Expr.PtrExpr(operand, self.span_from_start(start))))
            }
            return .Error(box("Expected '&' after 'unsafe'"))
        }
        if self.current().kind is .Ampersand() then {
            let start = self.current()
            self.advance()
            let is_mutable = self.current().kind is .KwMut()
            if is_mutable then { self.advance() }
            let operand = self.parse_unary() or return
            return .Ok(box(Expr.RefExpr(operand, is_mutable, self.span_from_start(start))))
        }

        return self.parse_call()
    }

}
