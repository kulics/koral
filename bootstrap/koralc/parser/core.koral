using std::os { .. }

private type ParseDeclFlags(
    access AccessModifier,
    has_explicit_access Bool,
    is_foreign Bool,
    is_intrinsic Bool,
    invalid_access_message Option[String],
)

public type Parser(
    tokens List[Token],
    mutable index UInt,
    mutable line_join_grouping_depth UInt,
)

given Parser {
    protected parse_debug(self, message String) Void = {
        if env("KORAL_DEBUG_PARSE") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            eprintln("[parse] \(message)")
        }
    }

    protected token_position_text(self, token Token) String = {
        let _ = self
        let mutable text = token.line.to_string()
        text.push_byte(':')
        text.push_string(token.column.to_string())
        return text
    }

    protected format_context_position_error(self, prefix String, context String, token Token) String = {
        let mutable text = prefix
        text.push_string(context)
        text.push_string(" at ")
        text.push_string(self.token_position_text(token))
        return text
    }

    protected format_progress_error(self, prefix String, context String, token Token) String = {
        let mutable text = self.format_context_position_error(prefix, context, token)
        text.push_string(" (token: ")
        text.push_string(token_text(token))
        text.push_byte(')')
        return text
    }

    protected previous_token(self) Option[Token] = {
        if self.index == 0 then {
            return .None()
        }
        return .Some(self.tokens[self.index - 1])
    }

    protected span_from_start(self, start Token) SourceSpan = {
        let start_loc = SourceLocation(start.line, start.column)
        let end_tok = self.previous_token() or else {
            return SourceSpan(start_loc, start_loc)
        }
        let end_loc = SourceLocation(end_tok.line, end_tok.column)
        return SourceSpan(start_loc, end_loc)
    }

    protected token_span(self, token Token) SourceSpan = {
        let loc = SourceLocation(token.line, token.column)
        return SourceSpan(loc, loc)
    }

    protected span_from_expr_start(self, expr * Expr) SourceSpan = {
        let expr_base_span = expr_span(expr)
        let end_tok = self.previous_token() or else {
            return expr_base_span
        }
        if not is_known_span(expr_base_span) then {
            let end_loc = SourceLocation(end_tok.line, end_tok.column)
            return SourceSpan(end_loc, end_loc)
        }
        let end_loc = SourceLocation(end_tok.line, end_tok.column)
        return SourceSpan(expr_base_span.start, end_loc)
    }

    protected is_decimal_digits(self, text String) Bool = {
        let runes = text.to_runes()
        if runes.is_empty() then {
            return false
        }
        for r in runes then {
            if not r.is_ascii_digit() then {
                return false
            }
        }
        return true
    }

    // 按顶层 | 分割 pattern 文本（忽略括号内的 |）
    protected split_or_pattern(self, text String) List[String] = {
        let mutable result = List[String].new()
        let mutable current = String.new()
        let mutable depth UInt = 0
        let runes = text.to_runes()
        for ch in runes then {
            if ch == '(' or ch == '[' then {
                depth += 1
                current.push_rune(ch)
            } else if ch == ')' or ch == ']' then {
                if depth > 0 then { depth -= 1 }
                current.push_rune(ch)
            } else if ch == '|' and depth == 0 then {
                result.push(current)
                current = String.new()
            } else {
                current.push_rune(ch)
            }
        }
        result.push(current)
        return result
    }

    protected pattern_from_text(self, text String, span SourceSpan) PatternNode = {
        // 先检查顶层 | 分割（or 模式）
        let or_parts = self.split_or_pattern(text)
        if or_parts.count() > 1 then {
            // 有多个 or 分支，递归构建 OrPattern（右结合）
            let mutable i UInt = or_parts.count()
            let last_part = or_parts[i - 1].trim_ascii()
            let mutable result = self.pattern_from_text(last_part, span)
            while i > 1 then {
                i -= 1
                let part = or_parts[i - 1].trim_ascii()
                let left = self.pattern_from_text(part, span)
                result = PatternNode.OrPattern(box(left), box(result), span)
            }
            return result
        }

        if text == "_" then {
            return PatternNode.Wildcard(span)
        }
        if text == "true" then {
            return PatternNode.BoolLiteral(true, span)
        }
        if text == "false" then {
            return PatternNode.BoolLiteral(false, span)
        }
        if self.is_decimal_digits(text) then {
            return PatternNode.IntegerLiteral(text, span)
        }
        if text.starts_with("mutable ") then {
            let name = text.substring(4..)
            if not name.is_empty() then {
                return PatternNode.Variable(name, true, span)
            }
        }
        if text.starts_with(".") then {
            let rest = text.substring(1..)
            // 检查是否有括号参数：". SomeName ( ... )"
            when rest.find("(") in {
                .Some(lparen_idx) then {
                    let case_name = rest.substring(0..<lparen_idx).trim_ascii()
                    // 找最后一个 ')'
                    when rest.find_last(")") in {
                        .Some(rparen_idx) then {
                            let inner = rest.substring(lparen_idx + 1..<rparen_idx).trim_ascii()
                            let mutable elements = List[PatternElement].new()
                            if not inner.is_empty() then {
                                // 按逗号分割，每个子 pattern 递归解析
                                let parts = self.split_pattern_args(inner)
                                for part in parts then {
                                    let trimmed = part.trim_ascii()
                                    if not trimmed.is_empty() then {
                                        elements.push(PatternElement(Option[String].None(), box(self.pattern_from_text(trimmed, span))))
                                    }
                                }
                            }
                            return PatternNode.EnumCase(case_name, elements, span)
                        },
                        .None() then {},
                    }
                },
                .None() then {
                    let case_name = rest.trim_ascii()
                    if not case_name.is_empty() then {
                        return PatternNode.EnumCase(case_name, List[PatternElement].new(), span)
                    }
                },
            }
        }
        return PatternNode.Variable(text, false, span)
    }

    // 按顶层逗号分割 pattern 参数列表（忽略括号内的逗号）
    protected split_pattern_args(self, text String) List[String] = {
        let mutable result = List[String].new()
        let mutable current = String.new()
        let mutable depth UInt = 0
        let runes = text.to_runes()
        for ch in runes then {
            if ch == '(' or ch == '[' then {
                depth += 1
                current.push_rune(ch)
            } else if ch == ')' or ch == ']' then {
                if depth > 0 then { depth -= 1 }
                current.push_rune(ch)
            } else if ch == ',' and depth == 0 then {
                result.push(current)
                current = String.new()
            } else {
                current.push_rune(ch)
            }
        }
        if not current.trim_ascii().is_empty() then {
            result.push(current)
        }
        return result
    }

    public new(tokens List[Token]) Parser = {
        return Parser(tokens, 0, 0(UInt))
    }

    protected current(self) Token = {
        if self.index < self.tokens.count() then {
            return self.tokens[self.index]
        }
        return Token(TokenKind.Eof(), 0, 0, false)
    }

    protected save_state(self) UInt = self.index

    protected restore_state(*mutable self, saved UInt) Void = {
        self.index = saved
    }

    protected peek_kind(self) Option[TokenKind] = {
        if self.index + 1 < self.tokens.count() then {
            return .Some(self.tokens[self.index + 1].kind)
        }
        return .None()
    }

    protected next_is_colon(self) Bool = {
        if self.index + 1 >= self.tokens.count() then {
            return false
        }
        return self.tokens[self.index + 1].kind is .Colon()
    }

    protected next_is_then(self) Bool = {
        if self.index + 1 >= self.tokens.count() then {
            return false
        }
        return self.tokens[self.index + 1].kind is .KwThen()
    }

    protected next_is_else(self) Bool = {
        if self.index + 1 >= self.tokens.count() then {
            return false
        }
        return self.tokens[self.index + 1].kind is .KwElse()
    }

    protected next_is_return(self) Bool = {
        if self.index + 1 >= self.tokens.count() then {
            return false
        }
        return self.tokens[self.index + 1].kind is .KwReturn()
    }

    protected is_eof(self) Bool = {
        when self.current().kind in {
            .Eof() then { return true },
            _ then { return false },
        }
    }

    // 检查 token 是否是表达式开始（用于区分类型转换和括号表达式）
    protected is_expr_start_token(self, kind TokenKind) Bool = {
        return when kind in {
            .Identifier(_) then true,
            .IntegerLiteral(_) then true,
            .DurationLiteral(_, _) then true,
            .FloatLiteral(_) then true,
            .StringLiteral(_) then true,
            .RuneLiteral(_) then true,
            .KwTrue() then true,
            .KwFalse() then true,
            .LParen() then true,
            .LBrace() then true,
            .LBracket() then true,
            .KwNot() then true,
            .Minus() then true,
            .Tilde() then true,
            .KwIf() then true,
            .KwWhile() then true,
            .KwFor() then true,
            .KwWhen() then true,
            .KwLet() then true,
            .KwSelf() then true,
            .Dot() then true,
            _ then false,
        }
    }

    // 检查当前位置是否是泛型类型表达式 [T, U]TypeName
    // 判断字符串首字母是否大写（用于区分类型名和变量名）
    protected is_upper_first(self, s String) Bool = {
        let runes = s.to_runes()
        if runes.is_empty() then { return false }
        let mutable i UInt = 0
        while i < runes.count() then {
            let ch = runes[i]
            if ch == '_' then {
                i += 1
                continue
            }
            return ch.is_ascii_uppercase()
        }
        return false
    }

    protected is_lower_first(self, s String) Bool = {
        let runes = s.to_runes()
        if runes.is_empty() then { return false }
        let mutable i UInt = 0
        while i < runes.count() then {
            let ch = runes[i]
            if ch == '_' then {
                i += 1
                continue
            }
            return ch.is_ascii_lowercase()
        }
        return false
    }

    protected is_valid_value_name(self, s String) Bool = {
        if s.is_empty() then { return false }
        let runes = s.to_runes()
        if runes.is_empty() then { return false }
        let mutable all_underscore = true
        for ch in runes then {
            if ch <> '_' then {
                all_underscore = false
                break
            }
        }
        return all_underscore or self.is_lower_first(s)
    }

    protected is_valid_module_segment_name(self, s String) Bool = {
        if s.is_empty() then { return false }
        let runes = s.to_runes()
        if runes.is_empty() then { return false }
        let first = runes[0]
        if not first.is_ascii_lowercase() then { return false }
        let mutable i UInt = 1
        while i < runes.count() then {
            let ch = runes[i]
            if not ch.is_ascii_lowercase() and not ch.is_ascii_digit() and ch <> '_' then {
                return false
            }
            i += 1
        }
        return true
    }

    protected invalid_variable_name_error(self, name String) String = "Variable name '\(name)' must start with a lowercase letter"
    protected invalid_function_name_error(self, name String) String = "Function name '\(name)' must start with a lowercase letter"
    protected invalid_type_name_error(self, name String) String = "Type name '\(name)' must start with an uppercase letter"
    protected invalid_field_name_error(self, name String) String = "Field name '\(name)' must start with a lowercase letter"
    protected invalid_parameter_name_error(self, name String) String = "Parameter name '\(name)' must start with a lowercase letter"
    protected invalid_enum_case_name_error(self, name String) String = "Enum case name '\(name)' must start with an uppercase letter"
    protected invalid_module_name_error(self, name String) String = "Module name '\(name)' must start with a lowercase letter"

    // 通过 lookahead 检查 [...] 后面是否跟着标识符
    protected is_generic_type_expr(self) Bool = {
        when self.current().kind in {
            .LBracket() then {},
            _ then { return false },
        }
        
        // Lookahead: 跳过 [...] 找到 ] 后的 token
        let mutable depth UInt = 0
        let mutable i = self.index
        while i < self.tokens.count() then {
            let tok = self.tokens[i]
            when tok.kind in {
                .LBracket() then { depth += 1 },
                .RBracket() then {
                    if depth == 1 then {
                        // 找到匹配的 ]，检查下一个 token
                        if i + 1 < self.tokens.count() then {
                            let next_tok = self.tokens[i + 1]
                            return when next_tok.kind in {
                                .Identifier(_) then not next_tok.has_newline_before,
                                _ then false,
                            }
                        }
                        return false
                    }
                    depth -= 1
                },
                .Eof() then { return false },
                _ then {},
            }
            i += 1
        }
        return false
    }

    protected advance(*mutable self) Token = {
        let t = self.current()
        if not self.is_eof() then {
            self.index += 1
        }
        return t
    }

    protected consume_semicolon(*mutable self) Void = {
        if self.current().kind is .Semicolon() then {
            self.advance()
        }
    }

    protected enter_line_join_grouping(*mutable self) Void = {
        self.line_join_grouping_depth += 1(UInt)
    }

    protected leave_line_join_grouping(*mutable self) Void = {
        if self.line_join_grouping_depth > 0(UInt) then {
            self.line_join_grouping_depth -= 1(UInt)
        }
    }

    protected is_inside_line_join_grouping(self) Bool = self.line_join_grouping_depth > 0(UInt)

    // 判断当前 token 是否属于少数允许换行接续的 join token。
    protected is_line_join_token(self) Bool = {
        return when self.current().kind in {
            .KwAnd() then true,
            .KwOr() then true,
            .KwIs() then true,
            .KwThen() then true,
            .KwElse() then true,
            .Dot() then true,
            .Arrow() then true,
            _ then false,
        }
    }

    protected should_break_binary_at_current_token(self) Bool = {
        return self.current().has_newline_before and not (self.is_line_join_token() or self.is_inside_line_join_grouping())
    }

    protected can_continue_range_bound_after_newline(self) Bool = {
        return not self.current().has_newline_before or self.is_inside_line_join_grouping()
    }

    protected require_no_line_break_before_rhs(*mutable self) Result[Void] = {
        if self.current().has_newline_before and not self.is_inside_line_join_grouping() then {
            return Result[Void].Error(box("Unexpected token: \(token_text(self.current()))"))
        }
        return Result[Void].Ok({})
    }

    // 判断是否应该终止当前语句（自动分号插入规则）
    protected should_terminate_statement(self) Bool = {
        // 显式分号
        if self.current().kind is .Semicolon() then {
            return true
        }
        // 文件结束或块结束
        if self.current().kind is .Eof() then {
            return true
        }
        if self.current().kind is .RBrace() then {
            return true
        }
        // 换行规则：有换行且当前 token 不是允许接续的 join token
        if self.current().has_newline_before then {
            if not self.is_line_join_token() then {
                return true
            }
        }
        return false
    }

    // 消耗可选的语句终止符（分号或换行）
    protected consume_statement_terminator(*mutable self) Void = {
        if self.current().kind is .Semicolon() then {
            self.advance()
        }
        // 换行自动终止不需要消耗 token
    }

    protected can_continue_dot_postfix(self) Bool = self.current().kind is .Dot()

    protected should_continue_postfix_after_expression(self) Bool = {
        return when self.current().kind in {
            .LParen() then not self.current().has_newline_before,
            .LBracket() then not self.current().has_newline_before,
            .Dot() then self.can_continue_dot_postfix(),
            _ then false,
        }
    }

    protected expect_identifier(*mutable self, label String) Result[String] = {
        let t = self.current()
        if t.kind is .Identifier(name) then {
            self.advance()
            return .Ok(name)
        }
        return .Error(box(self.format_context_position_error("Expected identifier for ", label, t)))
    }

    protected parse_decl_flags(*mutable self) ParseDeclFlags = {
        let mutable access = AccessModifier.Protected()
        let mutable has_explicit_access = false
        let mutable is_foreign = false
        let mutable is_intrinsic = false
        let mutable invalid_access_message = Option[String].None()

        while true then {
            when self.current().kind in {
                .KwPublic() then {
                    if has_explicit_access then {
                        let previous = when access in {
                            .Public() then "public",
                            .Protected() then "protected",
                            .Private() then "private",
                            .ProtectedPublic() then "protected public",
                        }
                        if invalid_access_message is .None() then {
                            invalid_access_message = .Some(
                                "Invalid access modifier order: '\(previous) public'. Use 'protected public' only in that exact order"
                            )
                        }
                        break
                    }
                    has_explicit_access = true
                    access = AccessModifier.Public()
                    self.advance()
                },
                .KwProtected() then {
                    if has_explicit_access then {
                        let previous = when access in {
                            .Public() then "public",
                            .Protected() then "protected",
                            .Private() then "private",
                            .ProtectedPublic() then "protected public",
                        }
                        if invalid_access_message is .None() then {
                            invalid_access_message = .Some(
                                "Invalid access modifier order: '\(previous) protected'. Use 'protected public' only in that exact order"
                            )
                        }
                        break
                    }
                    has_explicit_access = true
                    self.advance()
                    if self.current().kind is .KwPublic() then {
                        access = AccessModifier.ProtectedPublic()
                        self.advance()
                    } else {
                        access = AccessModifier.Protected()
                    }
                },
                .KwPrivate() then {
                    if has_explicit_access then {
                        let previous = when access in {
                            .Public() then "public",
                            .Protected() then "protected",
                            .Private() then "private",
                            .ProtectedPublic() then "protected public",
                        }
                        if invalid_access_message is .None() then {
                            invalid_access_message = .Some(
                                "Invalid access modifier order: '\(previous) private'. Use 'protected public' only in that exact order"
                            )
                        }
                        break
                    }
                    has_explicit_access = true
                    access = AccessModifier.Private()
                    self.advance()
                },
                .KwForeign() then {
                    is_foreign = true
                    self.advance()
                },
                .KwIntrinsic() then {
                    is_intrinsic = true
                    self.advance()
                },
                _ then {
                    break
                },
            }
        }

        return ParseDeclFlags(access, has_explicit_access, is_foreign, is_intrinsic, invalid_access_message)
    }

    protected wrap_decl(self, access AccessModifier, is_foreign Bool, is_intrinsic Bool, base Decl) Result[Decl] = {
        if is_foreign and is_intrinsic then {
            return .Error(box("foreign and intrinsic cannot be used together"))
        }

        if is_foreign then {
            return when base in {
                .FunctionDecl(_, name, _, params, return_type, _, span) then .Ok(Decl.ForeignFunctionDecl(access, name, params, return_type, span)),
                .LetDecl(_, name, is_mutable, type_name, _, span) then .Ok(Decl.ForeignLetDecl(access, name, is_mutable, type_name, span)),
                .TypeStructDecl(_, name, _, fields, span) then .Ok(Decl.ForeignTypeDecl(access, name, Option[String].None(), Option[List[Field]].Some(fields), span)),
                .GivenDecl(_, _, _, _) then .Error(box("foreign given declaration is not supported")),
                .GivenTraitDecl(_, _, _, _, _) then .Error(box("foreign given declaration is not supported")),
                .GivenNotTraitDecl(_, _, _, _) then .Error(box("foreign given declaration is not supported")),
                _ then .Error(box("unsupported foreign declaration kind")),
            }
        }

        if is_intrinsic then {
            return when base in {
                .FunctionDecl(_, name, type_params, params, return_type, _, span) then .Ok(Decl.IntrinsicFunctionDecl(access, name, type_params, params, return_type, span)),
                .GivenDecl(target_type, type_params, members, span) then .Ok(Decl.IntrinsicGivenDecl(target_type, type_params, members, span)),
                .GivenTraitDecl(_, _, _, _, _) then .Error(box("intrinsic given trait declaration is not supported")),
                .GivenNotTraitDecl(_, _, _, _) then .Error(box("intrinsic given declaration is not supported")),
                .TypeStructDecl(_, name, type_params, _, span) then .Ok(Decl.IntrinsicTypeDecl(access, name, type_params, span)),
                _ then .Error(box("unsupported intrinsic declaration kind")),
            }
        }
        return .Ok(base)
    }

    protected is_type_start(self) Bool = {
        return when self.current().kind in {
            .Star() then true,
            .Bang() then true,
            .QuestionMark() then true,
            .KwSelfType() then true,
            .KwUnsafe() then true,
            .Identifier(_) then true,
            _ then false,
        }
    }

    protected parse_type_arg_list(*mutable self) Result[List[* TypeNode]] = {
        when self.current().kind in {
            .LBracket() then { self.advance() },
            _ then { return .Error(box("Expected '[' to start type argument list")) },
        }

        let mutable args = List[* TypeNode].new()
        while true then {
            if self.current().kind is .RBracket() then {
                self.advance()
                break
            }
            let arg = self.parse_type() or else {
                return .Error(box("parse type argument error"))
            }
            args.push(box(arg))

            when self.current().kind in {
                .Comma() then {
                    self.advance()
                },
                .RBracket() then {},
                _ then {
                    return .Error(box("Expected ',' or ']' in type argument list"))
                },
            }
        }

        return .Ok(args)
    }

    protected parse_type(*mutable self) Result[TypeNode] = {
        when self.current().kind in {
            .QuestionMark() then {
                self.advance()
                if self.current().kind is .Star() then {
                    self.advance()
                } else {
                    return .Error(box("Expected '*' after '?'"))
                }
                let mutable is_mutable = false
                if self.current().kind is .KwMut() then {
                    self.advance()
                    is_mutable = true
                }
                let inner = self.parse_type() or else {
                    return .Error(box("parse type error"))
                }
                return .Ok(TypeNode.WeakReference(box(inner), is_mutable))
            },
            .KwUnsafe() then {
                self.advance()
                if self.current().kind is .Star() then {
                    self.advance()
                    let mutable is_mutable = false
                    if self.current().kind is .KwMut() then {
                        self.advance()
                        is_mutable = true
                    }
                    let inner = self.parse_type() or else {
                        return .Error(box("parse type error"))
                    }
                    return .Ok(TypeNode.Pointer(box(inner), is_mutable))
                }
                return .Error(box("Expected '*' after 'unsafe'"))
            },
            .Star() then {
                self.advance()
                let mutable is_mutable = false
                if self.current().kind is .KwMut() then {
                    self.advance()
                    is_mutable = true
                }
                let inner = self.parse_type() or else {
                    return .Error(box("parse type error"))
                }
                return .Ok(TypeNode.Reference(box(inner), is_mutable))
            },
            .KwSelfType() then {
                self.advance()
                return .Ok(TypeNode.InferredSelf())
            },
            .Identifier(module_or_name) then {
                self.advance()

                if module_or_name == "Func" and self.current().kind is .LBracket() then {
                    let args = self.parse_type_arg_list() or else {
                        return .Error(box("parse type error"))
                    }
                    if args.is_empty() then {
                        return .Error(box("Function type must include a return type"))
                    }
                    let mutable param_types = List[* TypeNode].new()
                    let mutable return_type_opt = Option[* TypeNode].None()
                    let mutable i UInt = 0
                    for arg in args then {
                        if i + 1 < args.count() then {
                            param_types.push(arg)
                        } else {
                            return_type_opt = Option[* TypeNode].Some(arg)
                        }
                        i += 1
                    }
                    return when return_type_opt in {
                        .Some(return_type) then .Ok(TypeNode.FunctionType(param_types, return_type)),
                        .None() then .Error(box("Function type must include a return type")),
                    }
                }

                if not self.is_upper_first(module_or_name) then {
                    let mutable message = "Type name '"
                    message.push_string(module_or_name)
                    message.push_string("' must start with an uppercase letter")
                    return .Error(box(message))
                }

                if self.current().kind is .LBracket() then {
                    let args = self.parse_type_arg_list() or else {
                        return .Error(box("parse type error"))
                    }
                    return .Ok(TypeNode.Generic(module_or_name, args))
                }

                return .Ok(TypeNode.Identifier(module_or_name))
            },
            _ then {
                return .Error(box("Expected type"))
            },
        }
    }

    protected parse_type_parameters(*mutable self) Result[List[TypeParameter]] = {
        let mutable params = List[TypeParameter].new()

        if self.current().kind is .LBracket() then {
            self.advance()
        } else {
            return .Ok(params)
        }

        while true then {
            if self.current().kind is .RBracket() then {
                self.advance()
                break
            }

            // Accept both Identifier and LifetimeIdentifier as type parameter names
            let param_name = when self.current().kind in {
                .Identifier(name) then {
                    self.advance()
                    break name
                },
                _ then {
                    return .Error(box(self.format_context_position_error("Expected identifier for ", "type parameter", self.current())))
                },
            }

            // Reject lifetime parameters in generic parameter lists
            let is_lifetime_param = param_name.starts_with("'")
            if is_lifetime_param then {
                return .Error(box("Lifetime syntax has been removed. Use *T/*mutable T for managed references."))
            }
            if not self.is_type_start() then {
                let t = self.current()
                let mutable message = "Type parameter '"
                message.push_string(param_name)
                message.push_string("' requires a constraint at ")
                message.push_string(self.token_position_text(t))
                return .Error(box(message))
            }
            let mutable constraints = List[* TypeNode].new()
            let first_constraint = self.parse_type() or else {
                return .Error(box("parse type parameter constraint error"))
            }
            constraints.push(box(first_constraint))

            while self.current().kind is .KwAnd() then {
                self.advance()
                let next_constraint = self.parse_type() or else {
                    return .Error(box("parse type parameter constraint error"))
                }
                constraints.push(box(next_constraint))
            }

            params.push(TypeParameter(param_name, constraints))

            when self.current().kind in {
                .Comma() then {
                    self.advance()
                },
                .RBracket() then {},
                _ then {
                    return .Error(box("Expected ',' or ']' in type parameter list"))
                },
            }
        }

        return .Ok(params)
    }

    protected parse_param_list(*mutable self) Result[List[Param]] = {
        let mutable params = List[Param].new()

        while true then {
            if self.current().kind is .RParen() then {
                return .Ok(params)
            }

            let mutable is_mut = false
            if self.current().kind is .KwMut() then {
                is_mut = true
                self.advance()
            }

            // Check for *self / *mutable self prefix receiver
            if self.current().kind is .Star() then {
                self.advance()
                let mutable is_mutable = false
                if self.current().kind is .KwMut() then {
                    self.advance()
                    is_mutable = true
                }
                if self.current().kind is .KwSelf() then {
                    self.advance()
                    let self_type = TypeNode.Reference(box(TypeNode.InferredSelf()), is_mutable)
                    params.push(Param("self", false, self_type, false))
                } else {
                    return .Error(box("Expected 'self' after '*' in receiver"))
                }
            } else if self.current().kind is .KwSelf() then {
                self.advance()
                let mutable self_type = TypeNode.InferredSelf()
                if self.current().kind is .KwSelfType() then {
                    return .Error(box("Invalid receiver parameter syntax: use 'self', '*self', or '*mutable self'"))
                }
                if self.is_type_start() then {
                    return .Error(box("Invalid receiver parameter syntax: use 'self', '*self', or '*mutable self'"))
                }
                params.push(Param("self", false, self_type, false))
            } else {
                let name = self.expect_identifier("parameter") or else {
                    return .Error(box("parse parameter error"))
                }
                if not self.is_valid_value_name(name) then {
                    return .Error(box(self.invalid_parameter_name_error(name)))
                }

                let mutable is_named = false
                if self.current().kind is .Colon() then {
                    is_named = true
                    self.advance()
                }

                if not self.is_type_start() then {
                    return .Error(box("parameter type is required"))
                }
                let param_type = self.parse_type() or else {
                    return .Error(box("parse parameter type error"))
                }

                params.push(Param(name, is_mut, param_type, is_named))
            }

            when self.current().kind in {
                .Comma() then {
                    self.advance()
                },
                .RParen() then {
                    return .Ok(params)
                },
                .Eof() then {
                    return .Error(box("Unexpected EOF in parameter list"))
                },
                _ then {
                    return .Error(box("Expected ',' or ')' in parameter list"))
                },
            }
        }

        return .Ok(params)
    }

    protected parse_let_decl(*mutable self, access AccessModifier, is_foreign Bool, is_intrinsic Bool) Result[Decl] = {
        let start = self.current()
        self.advance()

        let mutable is_mut = false
        if self.current().kind is .KwMut() then {
            is_mut = true
            self.advance()
        }

        let name = self.expect_identifier("let declaration") or return
        if self.current().kind is .LParen() then {
            if not self.is_valid_value_name(name) then {
                return .Error(box(self.invalid_function_name_error(name)))
            }
        } else if not self.is_valid_value_name(name) then {
            return .Error(box(self.invalid_variable_name_error(name)))
        }
        let type_params = self.parse_type_parameters() or return

        if self.current().kind is .LParen() then {
            if is_mut then {
                return .Error(box("Function declaration cannot use mutable before name"))
            }

            if is_foreign and not type_params.is_empty() then {
                return .Error(box("foreign function does not support generics"))
            }

            self.advance()
            let params = self.parse_param_list() or return

            if is_foreign then {
                for param in params then {
                    if param.named then {
                        return .Error(box("Named parameters are not supported in foreign declarations"))
                    }
                }
            }

            when self.current().kind in {
                .RParen() then {},
                _ then { return .Error(box("Expected ')' after parameters")) },
            }
            self.advance()

            if self.current().kind is .Assign() then {
                return .Error(box("Missing return type: function and method declarations must explicitly declare a return type"))
            }
            if not self.is_type_start() then {
                return .Error(box("Missing return type: function and method declarations must explicitly declare a return type"))
            }
            let return_type = self.parse_type() or else {
                return .Error(box("parse function return type error"))
            }

            if is_foreign or is_intrinsic then {
                if self.current().kind is .Assign() then {
                    if is_foreign then {
                        return .Error(box("foreign function cannot have a body"))
                    }
                    return .Error(box("intrinsic function declaration should not have body"))
                }
                self.consume_semicolon()
                let span = self.span_from_start(start)
                let base = Decl.FunctionDecl(access, name, type_params, params, return_type, box(Expr.Identifier("<intrinsic-body>", span)), span)
                return self.wrap_decl(access, is_foreign, is_intrinsic, base)
            }

            while true then {
                when self.current().kind in {
                    .Assign() then {
                        break
                    },
                    .Eof() then {
                        return .Error(box("Unexpected EOF in function declaration"))
                    },
                    _ then {
                        self.advance()
                    },
                }
            }

            self.advance()
            let body = self.parse_expression_checked("function body") or return
            self.consume_semicolon()
            let base = Decl.FunctionDecl(access, name, type_params, params, return_type, body, self.span_from_start(start))
            return self.wrap_decl(access, is_foreign, is_intrinsic, base)
        }

        // Variable declaration
        if not type_params.is_empty() then {
            return .Error(box("variable declaration cannot use type parameters"))
        }

        if is_foreign then {
            if not self.is_type_start() then {
                return .Error(box("foreign let declaration requires explicit type"))
            }
            let foreign_type = self.parse_type() or else {
                return .Error(box("parse foreign let type error"))
            }
            self.consume_semicolon()
            let span = self.span_from_start(start)
            let base = Decl.LetDecl(access, name, is_mut, foreign_type, box(Expr.Identifier("<foreign-init>", span)), span)
            return self.wrap_decl(access, is_foreign, is_intrinsic, base)
        }

        let mutable type_name = TypeNode.Identifier("Int")
        if self.is_type_start() then {
            type_name = self.parse_type() or else {
                return .Error(box("parse let declaration type error"))
            }
        }

        // skip to '='
        if self.current().kind is .Eof() then {
            return .Error(box("Expected '=' in let declaration"))
        }

        self.advance()
        let initializer = self.parse_expression_checked("let declaration initializer") or return
        self.consume_semicolon()
        let base = Decl.LetDecl(access, name, is_mut, type_name, initializer, self.span_from_start(start))
        return self.wrap_decl(access, is_foreign, is_intrinsic, base)
    }

    protected parse_type_decl(*mutable self, access AccessModifier, is_foreign Bool, is_intrinsic Bool) Result[Decl] = {
        let start = self.current()
        self.advance()

        let mutable foreign_cname = Option[String].None()
        if is_foreign then {
            if self.current().kind is .StringLiteral(v) then {
                foreign_cname = .Some(v)
                self.advance()
            }
        }

        let name = self.expect_identifier("type declaration") or return
        if not self.is_upper_first(name) then {
            return .Error(box(self.invalid_type_name_error(name)))
        }
        let type_params = self.parse_type_parameters() or return

        when self.current().kind in {
            .Assign() then {
                self.advance()
                let target = self.parse_type() or else {
                    return .Error(box("parse type alias target error"))
                }
                self.consume_semicolon()
                let base = Decl.TypeAliasDecl(access, name, target, self.span_from_start(start))
                return self.wrap_decl(access, is_foreign, is_intrinsic, base)
            },
            .LParen() then {
                self.advance()
                let mutable fields = List[Field].new()
                while true then {
                    when self.current().kind in {
                        .RParen() then {
                            self.advance()
                            break
                        },
                        .Eof() then {
                            return .Error(box("Unexpected EOF in struct declaration"))
                        },
                        _ then {
                            let field_access = self.parse_access_modifier(AccessModifier.Public())
                            let mutable field_mut = false
                            if self.current().kind is .KwMut() then {
                                field_mut = true
                                self.advance()
                            }

                            let field_name = self.expect_identifier("field name") or return
                            if not self.is_valid_value_name(field_name) then {
                                return .Error(box(self.invalid_field_name_error(field_name)))
                            }
                            let mutable field_named = false
                            if self.current().kind is .Colon() then {
                                field_named = true
                                self.advance()
                            }

                            let field_type = self.parse_type() or else {
                                return .Error(box("parse field type error"))
                            }

                            fields.push(Field(field_access, field_name, field_mut, field_type, field_named))
                            if self.current().kind is .Comma() then {
                                self.advance()
                            }
                        },
                    }
                }
                self.consume_semicolon()
                if is_foreign then {
                    return .Ok(Decl.ForeignTypeDecl(access, name, foreign_cname, Option[List[Field]].Some(fields), self.span_from_start(start)))
                }
                let base = Decl.TypeStructDecl(access, name, type_params, fields, self.span_from_start(start))
                return self.wrap_decl(access, is_foreign, is_intrinsic, base)
            },
            .LBrace() then {
                if is_foreign then {
                    self.advance()
                    if self.current().kind is .RBrace() then {
                        self.advance()
                        self.consume_semicolon()
                        return .Ok(Decl.ForeignTypeDecl(access, name, foreign_cname, Option[List[Field]].None(), self.span_from_start(start)))
                    }
                    return .Error(box("foreign type must use an empty body: {}"))
                }
                self.advance()
                let mutable cases = List[EnumCase].new()
                while true then {
                    when self.current().kind in {
                        .RBrace() then {
                            self.advance()
                            break
                        },
                        .Eof() then {
                            return .Error(box("Unexpected EOF in enum declaration"))
                        },
                        _ then {
                            let case_name = self.expect_identifier("enum case") or return
                            if not self.is_upper_first(case_name) then {
                                return .Error(box(self.invalid_enum_case_name_error(case_name)))
                            }
                            let mutable case_fields = List[EnumCaseField].new()

                            if self.current().kind is .LParen() then {
                                self.advance()
                                while true then {
                                    when self.current().kind in {
                                        .RParen() then {
                                            self.advance()
                                            break
                                        },
                                        .Eof() then {
                                            return .Error(box("Unexpected EOF in enum payload"))
                                        },
                                        _ then {
                                            let payload_name = self.expect_identifier("enum payload name") or return
                                            if not self.is_valid_value_name(payload_name) then {
                                                return .Error(box(self.invalid_parameter_name_error(payload_name)))
                                            }
                                            let mutable payload_named = false
                                            if self.current().kind is .Colon() then {
                                                payload_named = true
                                                self.advance()
                                            }
                                            let payload_type = self.parse_type() or else {
                                                return .Error(box("parse enum payload type error"))
                                            }
                                            case_fields.push(EnumCaseField(payload_name, payload_type, payload_named))
                                            when self.current().kind in {
                                                .Comma() then {
                                                    self.advance()
                                                },
                                                .RParen() then {},
                                                _ then {
                                                    return .Error(box("Expected ',' or ')' in enum payload"))
                                                },
                                            }
                                        },
                                    }
                                }
                            }

                            cases.push(EnumCase(case_name, case_fields))
                            if self.current().kind is .Comma() then {
                                self.advance()
                            }
                        },
                    }
                }
                self.consume_semicolon()
                let base = Decl.TypeEnumDecl(access, name, type_params, cases, self.span_from_start(start))
                return self.wrap_decl(access, is_foreign, is_intrinsic, base)
            },
            .Semicolon() then {
                if is_foreign then {
                    return .Error(box("foreign type cannot be declared without a body"))
                }
                if is_intrinsic then {
                    self.consume_semicolon()
                    return .Ok(Decl.IntrinsicTypeDecl(access, name, type_params, self.span_from_start(start)))
                }
                return .Error(box("Expected '=', '(' or '{' after type name"))
            },
            _ then {
                if is_foreign then {
                    return .Error(box("foreign type cannot be declared without a body"))
                }
                if is_intrinsic then {
                    return .Ok(Decl.IntrinsicTypeDecl(access, name, type_params, self.span_from_start(start)))
                }
                return .Error(box("Expected '=', '(' or '{' after type name"))
            },
        }
    }

    protected parse_let_statement(*mutable self) Result[Statement] = {
        let start = self.current()
        self.advance()

        if self.current().kind is .LParen() then {
            return self.parse_pair_let_statement(start)
        }

        let mutable is_mut = false
        if self.current().kind is .KwMut() then {
            is_mut = true
            self.advance()
        }

        let name = self.expect_identifier("let statement") or return
        if not self.is_valid_value_name(name) then {
            return .Error(box(self.invalid_variable_name_error(name)))
        }

        let mutable type_name = Option[TypeNode].None()
        if self.is_type_start() then {
            let parsed_type_name = self.parse_type() or else {
                return .Error(box("parse let statement type error"))
            }
            type_name = .Some(parsed_type_name)
        }

        // skip to '='
        if self.current().kind is .Eof() then {
            return .Error(box("Expected '=' in let statement"))
        }

        self.advance()
        let mutable value = self.parse_expression_checked("let statement value") or return
        if self.should_continue_postfix_after_expression() then {
            value = self.parse_postfix_suffixes(value) or return
        }
        self.consume_semicolon()
        return .Ok(Statement.LetStmt(name, is_mut, type_name, value, self.span_from_start(start)))
    }

    protected parse_pair_let_statement(*mutable self, start Token) Result[Statement] = {
        self.advance()

        let first = self.parse_pair_binding_element() or return

        if self.current().kind is not .Comma() then {
            return .Error(box("Expected ',' in pair let statement"))
        }
        self.advance()

        let second = self.parse_pair_binding_element() or return

        if self.current().kind is not .RParen() then {
            return .Error(box("Expected ')' in pair let statement"))
        }
        self.advance()

        if self.current().kind is .Eof() then {
            return .Error(box("Expected '=' in pair let statement"))
        }
        self.advance()

        let value = self.parse_expression_checked("pair let statement value") or return
        self.consume_semicolon()
        return .Ok(Statement.PairLetStmt(first, second, value, self.span_from_start(start)))
    }

    protected parse_pair_binding_element(*mutable self) Result[PairBindingElement] = {
        let start = self.current()

        if start.kind is .Identifier(name) and name == "_" then {
            self.advance()
            return .Ok(PairBindingElement("_", false, Option[TypeNode].None(), true, self.span_from_start(start)))
        }

        let mutable is_mut = false
        if self.current().kind is .KwMut() then {
            is_mut = true
            self.advance()
        }

        let name = self.expect_identifier("pair let binding") or return
        if not self.is_valid_value_name(name) then {
            return .Error(box(self.invalid_variable_name_error(name)))
        }

        let mutable type_name = Option[TypeNode].None()
        when self.current().kind in {
            .Comma() then {},
            .RParen() then {},
            _ then {
                let parsed_type_name = self.parse_type() or else {
                    return .Error(box("parse pair let binding type error"))
                }
                type_name = .Some(parsed_type_name)
            },
        }

        return .Ok(PairBindingElement(name, is_mut, type_name, false, self.span_from_start(start)))
    }

    protected is_assignment_operator(self) Bool = {
        return when self.current().kind in {
            .Assign() then true,
            .PlusAssign() then true,
            .MinusAssign() then true,
            .StarAssign() then true,
            .SlashAssign() then true,
            .PercentAssign() then true,
            .AmpersandAssign() then true,
            .PipeAssign() then true,
            .CaretAssign() then true,
            .LeftShiftAssign() then true,
            .RightShiftAssign() then true,
            _ then false,
        }
    }

    protected parse_assignment_operator(self) Result[Option[CompoundAssignmentOperator]] = {
        return when self.current().kind in {
            .Assign() then .Ok(Option[CompoundAssignmentOperator].None()),
            .PlusAssign() then .Ok(.Some(CompoundAssignmentOperator.AddAssign())),
            .MinusAssign() then .Ok(.Some(CompoundAssignmentOperator.SubtractAssign())),
            .StarAssign() then .Ok(.Some(CompoundAssignmentOperator.MultiplyAssign())),
            .SlashAssign() then .Ok(.Some(CompoundAssignmentOperator.DivideAssign())),
            .PercentAssign() then .Ok(.Some(CompoundAssignmentOperator.RemainderAssign())),
            .AmpersandAssign() then .Ok(.Some(CompoundAssignmentOperator.BitAndAssign())),
            .PipeAssign() then .Ok(.Some(CompoundAssignmentOperator.BitOrAssign())),
            .CaretAssign() then .Ok(.Some(CompoundAssignmentOperator.BitXorAssign())),
            .LeftShiftAssign() then .Ok(.Some(CompoundAssignmentOperator.LeftShiftAssign())),
            .RightShiftAssign() then .Ok(.Some(CompoundAssignmentOperator.RightShiftAssign())),
            _ then .Error(box("token is not an assignment operator")),
        }
    }

    protected parse_expression_checked(*mutable self, context String) Result[* Expr] = {
        let t = self.current()
        self.parse_debug("expr begin")
        let before = self.index
        let parsed_expr = self.parse_expression() or return
        if self.index == before then {
            let t = self.current()
            return .Error(box(self.format_progress_error("Parser made no progress while parsing ", context, t)))
        }
        let mutable expr = parsed_expr
        if self.should_continue_postfix_after_expression() then {
            expr = self.parse_postfix_suffixes(expr) or return
        }
        return .Ok(expr)
    }

    protected parse_statement_list_until_rbrace(*mutable self, context String) Result[List[Statement]] = {
        let mutable statements = List[Statement].new()
        self.parse_debug("stmt-list begin")
        while true then {
            when self.current().kind in {
                .RBrace() then {
                    self.advance()
                    break
                },
                .Eof() then {
                    let mutable message = "Unexpected EOF in "
                    message.push_string(context)
                    return .Error(box(message))
                },
                _ then {
                    let before = self.index
                    let parsed_statement = self.parse_statement() or return
                    let parsed = self.parse_statement_postfix_continuations(parsed_statement) or return
                    if self.index == before then {
                        let t = self.current()
                        return .Error(box(self.format_progress_error("Parser made no progress in ", context, t)))
                    }
                    statements.push(parsed)
                },
            }
        }
        return .Ok(statements)
    }

    protected apply_statement_postfix_continuation(self, base * Expr, continuation * Expr) Result[* Expr] = {
        return when continuation in {
            .ImplicitMemberExpr(member_name, args, _) then {
                let span = expr_span(continuation)
                let mutable path = List[String].new()
                path.push(member_name)
                let callee = box(Expr.MemberPath(base, path, span))
                break Result[* Expr].Ok(box(Expr.Call(callee, args, span)))
            },
            _ then Result[* Expr].Error(box("Expected postfix continuation expression")),
        }
    }

    protected parse_statement_postfix_continuations(*mutable self, statement Statement) Result[Statement] = {
        let mutable current = statement
        while self.can_continue_dot_postfix() then {
            self.parse_debug("statement postfix continuation")
            let continuation = self.parse_expression_checked("statement postfix continuation") or return
            current = when current in {
                .LetStmt(name, is_mutable, type_name, value, span) then {
                    let updated = self.apply_statement_postfix_continuation(value, continuation) or return
                    break Statement.LetStmt(name, is_mutable, type_name, updated, span)
                },
                .ExprStmt(expr, span) then {
                    let updated = self.apply_statement_postfix_continuation(expr, continuation) or return
                    break Statement.ExprStmt(updated, span)
                },
                _ then { return .Ok(current) },
            }
        }
        return .Ok(current)
    }

    protected parse_statement(*mutable self) Result[Statement] = {
        let start = self.current()
        self.parse_debug("statement dispatch")
        when self.current().kind in {
            .KwLet() then {
                return self.parse_let_statement()
            },
            .KwReturn() then {
                self.advance()
                // return 后面如果是分号、右括号、或换行（自动终止），则返回 None
                if self.should_terminate_statement() then {
                    self.consume_semicolon()
                    return .Ok(Statement.ReturnStmt(Option[* Expr].None(), self.span_from_start(start)))
                }
                let value = self.parse_expression_checked("return statement value") or return
                self.consume_semicolon()
                return .Ok(Statement.ReturnStmt(.Some(value), self.span_from_start(start)))
            },
            .KwBreak() then {
                self.advance()
                if self.should_terminate_statement() then {
                    self.consume_semicolon()
                    return .Ok(Statement.BreakStmt(Option[* Expr].None(), self.span_from_start(start)))
                }
                let value = self.parse_expression_checked("break statement value") or return
                self.consume_semicolon()
                return .Ok(Statement.BreakStmt(.Some(value), self.span_from_start(start)))
            },
            .KwContinue() then {
                self.advance()
                self.consume_semicolon()
                return .Ok(Statement.ContinueStmt(self.span_from_start(start)))
            },
            .KwDefer() then {
                self.advance()
                let value = self.parse_expression_checked("defer statement value") or return
                self.consume_semicolon()
                return .Ok(Statement.DeferStmt(value, self.span_from_start(start)))
            },
            _ then {
                let mutable value = self.parse_expression_checked("statement expression") or return
                if self.should_continue_postfix_after_expression() then {
                    value = self.parse_postfix_suffixes(value) or return
                }

                if self.is_assignment_operator() then {
                    let op = self.parse_assignment_operator() or else {
                        return .Error(box("Unknown assignment operator"))
                    }
                    self.advance()
                    let rhs = self.parse_expression_checked("assignment right-hand side") or return
                    self.consume_semicolon()
                    return .Ok(Statement.AssignmentStmt(value, op, rhs, self.span_from_start(start)))
                }

                self.consume_semicolon()
                return .Ok(Statement.ExprStmt(value, self.span_from_start(start)))
            },
        }
    }

    // Lookahead: check if current position starts a lambda expression.
    // Lambda forms: () [RetType] ->  or  (name [Type], ...) [RetType] ->
}
