type MIRValueCleanup(name String, cleanup_type Type)

type MIRValueEmission(expression String, cleanup Option[* MIRValueCleanup])

type MIRPlaceAccess(path String, control String, cleanup Option[* MIRValueCleanup])

type MIRLocalLifetimePlan(
    root_locals List[MIRLocalID],
    locals_by_scope Dict[UInt, List[MIRLocalID]],
    hoisted_declaration_locals List[MIRLocalID],
    block_local_declarations_by_block Dict[UInt, List[MIRLocalID]],
    block_local_declaration_locals Dict[UInt, Bool],
)

type MIRFunctionEmitPlan(
    local_names List[String],
    local_names_by_id *mutable Dict[UInt, String],
    non_owning_local_ids * Dict[UInt, Bool],
    tracked_init_locals * Dict[UInt, Bool],
    lifetime_plan * MIRLocalLifetimePlan,
)

private let is_borrowed_reference_like_type(t Type) Bool = {
    return when t in {
        .ReferenceType(_) then true,
        .MutableReferenceType(_) then true,
        .BorrowedReferenceType(_) then true,
        .MutableBorrowedReferenceType(_) then true,
        .WeakReferenceType(_) then true,
        .MutableWeakReferenceType(_) then true,
        _ then false,
    }
}

private let is_reference_like_type(t Type) Bool = {
    return when t in {
        .ReferenceType(_) then true,
        .MutableReferenceType(_) then true,
        .BorrowedReferenceType(_) then true,
        .MutableBorrowedReferenceType(_) then true,
        .WeakReferenceType(_) then true,
        .MutableWeakReferenceType(_) then true,
        .TraitObject(_, _) then true,
        _ then false,
    }
}

private let is_non_owning_local_value(value MIRValue, target_type Type) Bool = {
    return when value in {
        .Ref(_, _, allocation) then allocation is .StackBorrow(),
        .PlaceRead(_, ownership) then ownership is .Borrow() and is_borrowed_reference_like_type(target_type),
        _ then false,
    }
}

private let compute_non_owning_mir_locals(function * MIRFunction) * Dict[UInt, Bool] = {
    let mutable saw_assignment_by_local = Dict[UInt, Bool].new()
    let mutable all_non_owning_by_local = Dict[UInt, Bool].new()

    for block in function.blocks then {
        for statement in block.statements then {
            when statement in {
                .Assign(place, value) then when place in {
                    .Local(local_id) then {
                        saw_assignment_by_local.insert(local_id.raw_value, true)
                        let already_all_non_owning = all_non_owning_by_local.get(local_id.raw_value) or else true
                        let mutable target_type = Type.Unknown()
                        for local in function.locals then {
                            if local.id.raw_value == local_id.raw_value then {
                                target_type = local.local_type
                                break
                            }
                        }
                        all_non_owning_by_local.insert(
                            local_id.raw_value,
                            already_all_non_owning and is_non_owning_local_value(value, target_type),
                        )
                    },
                    _ then {},
                },
                _ then {},
            }
        }
    }

    let mutable result = Dict[UInt, Bool].new()
    for local in function.locals then {
        if local.storage is .Parameter() and is_borrowed_reference_like_type(local.local_type) then {
            result.insert(local.id.raw_value, true)
            continue
        }

        if (saw_assignment_by_local.get(local.id.raw_value) or else false)
            and (all_non_owning_by_local.get(local.id.raw_value) or else false)
        then {
            result.insert(local.id.raw_value, true)
        }
    }
    return box(result)
}

private let mir_active_scope_contains(active_scopes * List[MIRScopeID], scope MIRScopeID) Bool = {
    for active_scope in active_scopes then {
        if active_scope.raw_value == scope.raw_value then {
            return true
        }
    }
    return false
}

private let mir_parent_scope(
    parent_scope_by_scope * Dict[UInt, MIRScopeID],
    scope MIRScopeID,
) Option[MIRScopeID] = {
    return when parent_scope_by_scope.get(scope.raw_value) in {
        .Some(parent_scope) then Option[MIRScopeID].Some(parent_scope),
        .None() then Option[MIRScopeID].None(),
    }
}

private let mir_nearest_active_common_scope(
    parent_scope_by_scope * Dict[UInt, MIRScopeID],
    existing_scope MIRScopeID,
    active_scopes * List[MIRScopeID],
) Option[MIRScopeID] = {
    let mutable scope_opt = Option[MIRScopeID].Some(existing_scope)
    while scope_opt is .Some(_) then {
        let scope = when scope_opt in {
            .Some(existing) then existing,
            .None() then MIRScopeID(0(UInt)),
        }
        if mir_active_scope_contains(active_scopes, scope) then {
            return Option[MIRScopeID].Some(scope)
        }
        scope_opt = mir_parent_scope(parent_scope_by_scope, scope)
    }
    return Option[MIRScopeID].None()
}

private let mir_record_local_use(
    shared_use_scope_by_local *mutable Dict[UInt, MIRScopeID],
    first_use_block_by_local *mutable Dict[UInt, UInt],
    multiple_use_blocks_by_local *mutable Dict[UInt, Bool],
    tracked_drop_local_ids * Dict[UInt, Bool],
    parent_scope_by_scope * Dict[UInt, MIRScopeID],
    local MIRLocalID,
    block MIRBlockID,
    active_scopes * List[MIRScopeID],
) Void = {
    when tracked_drop_local_ids.get(local.raw_value) in {
        .Some(_) then {
            when shared_use_scope_by_local.get(local.raw_value) in {
                .Some(shared_use_scope) then {
                    when mir_nearest_active_common_scope(parent_scope_by_scope, shared_use_scope, active_scopes) in {
                        .Some(common_scope) then shared_use_scope_by_local.insert(local.raw_value, common_scope),
                        .None() then {
                            let _ = shared_use_scope_by_local.remove(local.raw_value)
                        },
                    }
                },
                .None() then {
                    if not active_scopes.is_empty() then {
                        shared_use_scope_by_local.insert(local.raw_value, active_scopes[active_scopes.count() - 1(UInt)])
                    }
                },
            }
        },
        .None() then {},
    }

    when first_use_block_by_local.get(local.raw_value) in {
        .Some(first_use_block) then {
            if first_use_block <> block.raw_value then {
                multiple_use_blocks_by_local.insert(local.raw_value, true)
            }
        },
        .None() then {
            first_use_block_by_local.insert(local.raw_value, block.raw_value)
        },
    }
}

private let mir_walk_operand_uses(
    shared_use_scope_by_local *mutable Dict[UInt, MIRScopeID],
    first_use_block_by_local *mutable Dict[UInt, UInt],
    multiple_use_blocks_by_local *mutable Dict[UInt, Bool],
    tracked_drop_local_ids * Dict[UInt, Bool],
    parent_scope_by_scope * Dict[UInt, MIRScopeID],
    operand MIROperand,
    block MIRBlockID,
    active_scopes * List[MIRScopeID],
) Void = {
    when operand in {
        .Local(local) then mir_record_local_use(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, local, block, active_scopes),
        _ then {},
    }
}

private let mir_walk_place_uses(
    shared_use_scope_by_local *mutable Dict[UInt, MIRScopeID],
    first_use_block_by_local *mutable Dict[UInt, UInt],
    multiple_use_blocks_by_local *mutable Dict[UInt, Bool],
    tracked_drop_local_ids * Dict[UInt, Bool],
    parent_scope_by_scope * Dict[UInt, MIRScopeID],
    place MIRPlace,
    block MIRBlockID,
    active_scopes * List[MIRScopeID],
) Void = {
    when place in {
        .Local(local) then mir_record_local_use(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, local, block, active_scopes),
        .Global(_) then {},
        .Field(base, _) then mir_walk_place_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *base, block, active_scopes),
        .EnumPayload(base, _, _, _, _) then mir_walk_place_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *base, block, active_scopes),
        .Deref(base, _) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *base, block, active_scopes),
        .PointerElement(base, _) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *base, block, active_scopes),
    }
}

private let mir_walk_intrinsic_uses(
    shared_use_scope_by_local *mutable Dict[UInt, MIRScopeID],
    first_use_block_by_local *mutable Dict[UInt, UInt],
    multiple_use_blocks_by_local *mutable Dict[UInt, Bool],
    tracked_drop_local_ids * Dict[UInt, Bool],
    parent_scope_by_scope * Dict[UInt, MIRScopeID],
    intrinsic_node MIRIntrinsic,
    block MIRBlockID,
    active_scopes * List[MIRScopeID],
) Void = {
    when intrinsic_node in {
        .AllocMemory(count, _) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *count, block, active_scopes),
        .DeallocMemory(pointer) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *pointer, block, active_scopes),
        .CopyMemory(dest, source, count) then {
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *dest, block, active_scopes)
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *source, block, active_scopes)
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *count, block, active_scopes)
        },
        .MoveMemory(dest, source, count) then {
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *dest, block, active_scopes)
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *source, block, active_scopes)
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *count, block, active_scopes)
        },
        .IsUniqueMutable(value) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *value, block, active_scopes),
        .RefCount(value) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *value, block, active_scopes),
        .MakeRef(pointer, owner, _) then {
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *pointer, block, active_scopes)
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *owner, block, active_scopes)
        },
        .MakeMutRef(pointer, owner, _) then {
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *pointer, block, active_scopes)
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *owner, block, active_scopes)
        },
        .DowngradeRef(value, _) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *value, block, active_scopes),
        .DowngradeMutRef(value, _) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *value, block, active_scopes),
        .UpgradeRef(value, _) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *value, block, active_scopes),
        .UpgradeMutRef(value, _) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *value, block, active_scopes),
        .InitMemory(pointer, value) then {
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *pointer, block, active_scopes)
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *value, block, active_scopes)
        },
        .DeinitMemory(pointer) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *pointer, block, active_scopes),
        .TakeMemory(pointer, _) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *pointer, block, active_scopes),
        .NullPtr(_) then {},
        .SpawnThread(out_handle, out_tid, closure, stack_size) then {
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *out_handle, block, active_scopes)
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *out_tid, block, active_scopes)
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *closure, block, active_scopes)
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *stack_size, block, active_scopes)
        },
    }
}

private let mir_walk_value_uses(
    shared_use_scope_by_local *mutable Dict[UInt, MIRScopeID],
    first_use_block_by_local *mutable Dict[UInt, UInt],
    multiple_use_blocks_by_local *mutable Dict[UInt, Bool],
    tracked_drop_local_ids * Dict[UInt, Bool],
    parent_scope_by_scope * Dict[UInt, MIRScopeID],
    value MIRValue,
    block MIRBlockID,
    active_scopes * List[MIRScopeID],
) Void = {
    when value in {
        .Operand(operand) then mir_walk_operand_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, operand, block, active_scopes),
        .PlaceRead(place, _) then mir_walk_place_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, place, block, active_scopes),
        .Binary(operation) then {
            mir_walk_operand_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, operation.left, block, active_scopes)
            mir_walk_operand_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, operation.right, block, active_scopes)
        },
        .Unary(operation) then mir_walk_operand_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, operation.operand, block, active_scopes),
        .Call(call) then {
            mir_walk_operand_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, call.callee, block, active_scopes)
            for argument in call.arguments then {
                mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *argument, block, active_scopes)
            }
        },
        .Aggregate(aggregate) then {
            for field in aggregate.fields then {
                mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *field, block, active_scopes)
            }
        },
        .EnumCase(construction) then {
            for argument in construction.arguments then {
                mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *argument, block, active_scopes)
            }
        },
        .EnumTag(tag) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *(tag.subject), block, active_scopes),
        .TraitObjectConversion(conversion) then mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *(conversion.inner), block, active_scopes),
        .TraitMethodCall(call) then {
            mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *(call.receiver), block, active_scopes)
            for argument in call.arguments then {
                mir_walk_value_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, *argument, block, active_scopes)
            }
        },
        .Ref(place, _, _) then mir_walk_place_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, place, block, active_scopes),
        .Pointer(place) then mir_walk_place_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, place, block, active_scopes),
        .Cast(operand, _) then mir_walk_operand_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, operand, block, active_scopes),
        .Intrinsic(node) then mir_walk_intrinsic_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, node, block, active_scopes),
        .Lambda(lambda) then {
            for source in lambda.capture_sources then {
                mir_walk_place_uses(shared_use_scope_by_local, first_use_block_by_local, multiple_use_blocks_by_local, tracked_drop_local_ids, parent_scope_by_scope, source, block, active_scopes)
            }
        },
    }
}

type MIRFunctionCodeEmitter(
    codegen *mutable CodeGen,
    function * MIRFunction,
    mutable local_names List[String],
    mutable local_names_by_id *mutable Dict[UInt, String],
    mutable non_owning_local_ids * Dict[UInt, Bool],
    mutable tracked_init_locals * Dict[UInt, Bool],
    mutable lifetime_plan * MIRLocalLifetimePlan,
    mutable lambda_counter UInt,
    mutable nested_definitions String,
    mutable current_owner_callable_name_cache_prefix Option[String],
    mutable callable_name_cache Dict[UInt, String],
    mutable consumed_locals Dict[UInt, Bool],
)

private let build_mir_function_emit_plan(
    codegen * CodeGen,
    function * MIRFunction,
) * MIRFunctionEmitPlan = {
    let mutable local_names = List[String].new()
    let mutable local_names_by_id = Dict[UInt, String].new()
    let mutable non_owning_local_ids = compute_non_owning_mir_locals(function)
    let mutable tracked_init_locals = Dict[UInt, Bool].new()

    for local in function.locals then {
        let name = when local.storage in {
            .Parameter() then when local.symbol in {
                .Some(symbol) then codegen.c_identifier_for_symbol(symbol),
                .None() then codegen.sanitize_codegen_identifier(local.name),
            },
            .Capture() then when local.symbol in {
                .Some(symbol) then codegen.c_identifier_for_symbol(symbol),
                .None() then codegen.sanitize_codegen_identifier(local.name),
            },
            _ then "__mir_\(codegen.sanitize_codegen_identifier(local.name))_\(local.id.raw_value)",
        }
        let is_non_owning = when non_owning_local_ids.get(local.id.raw_value) in {
            .Some(_) then true,
            .None() then false,
        }
        local_names.push(name)
        local_names_by_id.insert(local.id.raw_value, name)
        if local.storage is not .Capture() and not codegen.type_is_void_or_never(local.local_type) and codegen.needs_drop(local.local_type) and not is_non_owning then {
            tracked_init_locals.insert(local.id.raw_value, true)
        }
    }

    let lifetime_plan = build_mir_lifetime_plan(function, codegen, tracked_init_locals)
    return box(MIRFunctionEmitPlan(
        local_names,
        box(local_names_by_id),
        non_owning_local_ids,
        box(tracked_init_locals),
        lifetime_plan,
    ))
}

given MIRFunctionCodeEmitter {
    public new(codegen *mutable CodeGen, function * MIRFunction, plan * MIRFunctionEmitPlan) MIRFunctionCodeEmitter = {
        return MIRFunctionCodeEmitter(
            codegen,
            function,
            plan.local_names,
            plan.local_names_by_id,
            plan.non_owning_local_ids,
            plan.tracked_init_locals,
            plan.lifetime_plan,
            0(UInt),
            String.new(),
            when codegen.current_function_owner_type in {
                .Some(owner_type) then Option[String].Some(codegen.concrete_receiver_lookup_key(owner_type)),
                .None() then Option[String].None(),
            },
            Dict[UInt, String].new(),
            Dict[UInt, Bool].new(),
        )
    }

    public emit_body(*mutable self) Void = {
        self.emit_local_declarations()
        for block in self.function.blocks then {
            self.emit_block(block)
        }
    }

    public emit_body_and_get_nested_definitions(*mutable self) String = {
        self.emit_body()
        return self.get_nested_definitions()
    }

    public get_nested_definitions(*self) String = {
        return self.nested_definitions
    }

    protected callable_name_for_symbol(*mutable self, symbol * Symbol) String = {
        when self.callable_name_cache.get(symbol.def_id.id) in {
            .Some(name) then { return name },
            .None() then {},
        }

        when self.current_owner_callable_name_cache_prefix in {
            .Some(owner_key_prefix) then {
                let global_cache_key = "\(owner_key_prefix)|\(symbol.def_id.id.to_string())"
                when self.codegen.current_owner_callable_c_name_cache.get(global_cache_key) in {
                    .Some(name) then {
                        self.callable_name_cache.insert(symbol.def_id.id, name)
                        return name
                    },
                    .None() then {},
                }
            },
            .None() then {},
        }
        let name = self.codegen.callable_c_name(symbol)
        self.callable_name_cache.insert(symbol.def_id.id, name)
        when self.current_owner_callable_name_cache_prefix in {
            .Some(owner_key_prefix) then {
                let global_cache_key = "\(owner_key_prefix)|\(symbol.def_id.id.to_string())"
                self.codegen.current_owner_callable_c_name_cache.insert(global_cache_key, name)
            },
            .None() then {},
        }
        return name
    }

    protected local_info(*self, local_id MIRLocalID) Option[* MIRLocal] = {
        for local in self.function.locals then {
            if local.id.raw_value == local_id.raw_value then {
                return Option[* MIRLocal].Some(local)
            }
        }
        return Option[* MIRLocal].None()
    }

    protected init_flag(*self, local_id MIRLocalID) Option[String] = {
        if self.tracked_init_locals.get(local_id.raw_value) is .Some(_) then {
            return Option[String].Some("__mir_init_\(local_id.raw_value)")
        }
        return Option[String].None()
    }

    protected emit_local_declarations(*mutable self) Void = {
        for local in self.function.locals then {
            if local.storage is not .Parameter() and local.storage is not .Capture() and not self.codegen.type_is_void_or_never(local.local_type) then {
                let name = self.local_name(local.id)
                self.codegen.add_indent()
                self.codegen.buffer.push_string(self.codegen.c_type_name(local.local_type))
                self.codegen.buffer.push_string(" ")
                self.codegen.buffer.push_string(name)
                self.codegen.buffer.push_string(";\n")
            }
        }
        for local in self.function.locals then {
            when self.init_flag(local.id) in {
                .Some(flag) then {
                    let initial = if local.storage is .Parameter() then "1" else "0"
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("_Bool ")
                    self.codegen.buffer.push_string(flag)
                    self.codegen.buffer.push_string(" = ")
                    self.codegen.buffer.push_string(initial)
                    self.codegen.buffer.push_string(";\n")
                },
                .None() then {},
            }
        }
    }

    protected emit_block(*mutable self, block * MIRBasicBlock) Void = {
        let preserved_return_local = when block.terminator in {
            .ReturnValue(operand_opt) then when operand_opt in {
                .Some(operand) then self.local_id_from_operand(operand),
                .None() then Option[MIRLocalID].None(),
            },
            _ then Option[MIRLocalID].None(),
        }
        let wraps_block = when self.lifetime_plan.block_local_declarations_by_block.get(block.id.raw_value) in {
            .Some(locals) then not locals.is_empty(),
            .None() then false,
        }
        self.codegen.add_indent()
        if wraps_block then {
            self.codegen.buffer.push_string(self.block_label(block.id))
            self.codegen.buffer.push_string(": {\n")
            let saved_indent = self.codegen.indent
            self.codegen.indent = "\(self.codegen.indent)    "
            for statement in block.statements then {
                when statement in {
                    .ScopeExit(scope) then self.emit_scope_cleanup_preserving(scope, preserved_return_local),
                    _ then self.emit_statement(statement),
                }
            }
            self.emit_terminator(block.terminator)
            self.codegen.indent = saved_indent
            self.codegen.add_indent()
            self.codegen.buffer.push_string("}\n")
            return
        }
        self.codegen.buffer.push_string(self.block_label(block.id))
        self.codegen.buffer.push_string(":;\n")
        for statement in block.statements then {
            when statement in {
                .ScopeExit(scope) then self.emit_scope_cleanup_preserving(scope, preserved_return_local),
                _ then self.emit_statement(statement),
            }
        }
        self.emit_terminator(block.terminator)
    }

    protected emit_statement(*mutable self, statement * MIRStatement) Void = {
        when statement in {
            .Declare(_) then {},
            .Assign(place, value) then self.emit_assign(place, value),
            .CompoundAssign(assignment) then self.emit_compound_assign(assignment),
            .Drop(place) then self.emit_drop(place),
            .Retain(value) then self.emit_retain(value),
            .Release(value) then self.emit_release(value),
            .Evaluate(value) then self.emit_evaluate(value),
            .ScopeEnter(_) then {},
            .ScopeExit(scope) then self.emit_scope_cleanup(scope),
            .DebugSource(_) then {},
        }
    }

    protected emit_terminator(*mutable self, terminator MIRTerminator) Void = {
        when terminator in {
            .Goto(block) then self.emit_goto(block),
            .Branch(condition, then_block, else_block) then {
                let condition_expr = self.emit_operand_expression(condition)
                self.codegen.add_indent()
                self.codegen.buffer.push_string("if (")
                self.codegen.buffer.push_string(condition_expr)
                self.codegen.buffer.push_string(") { goto ")
                self.codegen.buffer.push_string(self.block_label(then_block))
                self.codegen.buffer.push_string("; }\n")
                self.codegen.add_indent()
                self.codegen.buffer.push_string("goto ")
                self.codegen.buffer.push_string(self.block_label(else_block))
                self.codegen.buffer.push_string(";\n")
            },
            .SwitchValue(operand, cases, default_block) then {
                let switch_expr = self.emit_operand_expression(operand)
                self.codegen.add_indent()
                self.codegen.buffer.push_string("switch (")
                self.codegen.buffer.push_string(switch_expr)
                self.codegen.buffer.push_string(") {\n")
                let saved_indent = self.codegen.indent
                self.codegen.indent = "\(self.codegen.indent)    "
                for switch_case in cases then {
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("case ")
                    self.codegen.buffer.push_string(self.switch_case_expression(switch_case.value))
                    self.codegen.buffer.push_string(": goto ")
                    self.codegen.buffer.push_string(self.block_label(switch_case.target))
                    self.codegen.buffer.push_string(";\n")
                }
                self.codegen.add_indent()
                when default_block in {
                    .Some(block) then {
                        self.codegen.buffer.push_string("default: goto ")
                        self.codegen.buffer.push_string(self.block_label(block))
                        self.codegen.buffer.push_string(";\n")
                    },
                    .None() then self.codegen.buffer.push_string("default: __builtin_unreachable();\n"),
                }
                self.codegen.indent = saved_indent
                self.codegen.add_indent()
                self.codegen.buffer.push_string("}\n")
            },
            .ReturnValue(operand) then self.emit_return(operand),
            .Unreachable() then {
                self.codegen.add_indent()
                self.codegen.buffer.push_string("__builtin_unreachable();\n")
            },
        }
    }

    protected emit_goto(*mutable self, block MIRBlockID) Void = {
        self.codegen.add_indent()
        self.codegen.buffer.push_string("goto ")
        self.codegen.buffer.push_string(self.block_label(block))
        self.codegen.buffer.push_string(";\n")
    }

    protected emit_assign(*mutable self, place MIRPlace, value MIRValue) Void = {
        let access = self.emit_place_access(place)
        let emission = self.emit_value(value)
        let target_type = self.type_of_place(place)
        let source_type = self.type_of_value(value)
        // When MIR assigns a void constant to a struct/enum result (dead branch of when/if),
        // emit memset instead of invalid `struct_var = 0`.
        if self.is_void_constant(value) and self.codegen.needs_drop(target_type) then {
            when self.local_target_id(place) in {
                .Some(local_id) then when self.init_flag(local_id) in {
                    .Some(flag) then self.emit_guarded_drop(flag, target_type, access.path),
                    .None() then {},
                },
                .None() then {},
            }
            self.codegen.add_indent()
            self.codegen.buffer.push_string("memset(&(")
            self.codegen.buffer.push_string(access.path)
            self.codegen.buffer.push_string("), 0, sizeof(")
            self.codegen.buffer.push_string(access.path)
            self.codegen.buffer.push_string("));\n")
            when self.local_target_id(place) in {
                .Some(local_id) then self.set_init_flag(local_id, true),
                .None() then {},
            }
            return
        }
        when self.local_target_id(place) in {
            .Some(local_id) then when self.init_flag(local_id) in {
                .Some(flag) then self.emit_guarded_drop(flag, target_type, access.path),
                .None() then {},
            },
            .None() then {
                // Non-local (field/deref): use temp to avoid use-after-free when
                // source and destination alias the same location.
                if self.codegen.needs_drop(target_type) then {
                    let adapted = self.adapt_expression_for_target_type(
                        emission.expression,
                        source_type,
                        target_type,
                        false,
                        value is .Operand(.Function(_)),
                    )
                    let temp = self.codegen.next_temp_with_decl(self.codegen.c_type_name(target_type))
                    self.codegen.append_copy_or_move_assignment(target_type, adapted, temp, false)
                    self.codegen.add_indent()
                    self.codegen.append_drop_statement(target_type, access.path)
                    self.codegen.append_copy_or_move_assignment(target_type, temp, access.path, false)
                    self.consume_moved_source(value)
                    self.emit_cleanup(access.cleanup)
                    self.emit_residual_cleanups(emission, true)
                    return
                }
            },
        }
        let assigned_expression = self.adapt_expression_for_target_type(
            emission.expression,
            source_type,
            target_type,
            false,
            value is .Operand(.Function(_)),
        )
        // When assigning through a deref (pointer/ref), the old value is released
        // but the new value must be retained. Use copy semantics (retain) for
        // deref places; for other non-local places (field access), move is fine.
        let store_is_lvalue = self.is_deref_place(place)
        self.codegen.append_copy_or_move_assignment(target_type, assigned_expression, access.path, store_is_lvalue)
        self.consume_moved_source(value)
        self.emit_cleanup(access.cleanup)
        self.emit_residual_cleanups(emission, true)
        when self.local_target_id(place) in {
            .Some(local_id) then self.set_init_flag(local_id, true),
            .None() then {},
        }
    }

    protected is_void_constant(*self, value MIRValue) Bool = {
        return when value in {
            .Operand(operand) then when operand in {
                .Constant(constant) then when constant in {
                    .Void() then true,
                    _ then false,
                },
                _ then false,
            },
            _ then false,
        }
    }

    protected is_deref_place(*self, place MIRPlace) Bool = {
        return when place in {
            .Deref(_, _) then true,
            .Field(base, _) then self.is_deref_place(*base),
            .EnumPayload(base, _, _, _, _) then self.is_deref_place(*base),
            .Local(_) then false,
            .Global(_) then false,
            .PointerElement(_, _) then false,
        }
    }

    protected emit_compound_assign(*mutable self, assignment MIRCompoundAssignment) Void = {
        let access = self.emit_place_access(assignment.target)
        let emission = self.emit_value(assignment.value)
        let target_type = self.type_of_place(assignment.target)
        // Use checked shift for integer types to avoid C undefined behavior
        // when shift amount >= bit width.
        if (assignment.operator_kind is .LeftShiftAssign() or assignment.operator_kind is .RightShiftAssign()) and self.codegen.is_integer_type(target_type) then {
            let shift_op = if assignment.operator_kind is .LeftShiftAssign() then BitwiseOperator.LeftShift() else BitwiseOperator.RightShift()
            let func_name = self.codegen.checked_shift_func_name(shift_op, target_type)
            self.codegen.add_indent()
            self.codegen.buffer.push_string(access.path)
            self.codegen.buffer.push_string(" = ")
            self.codegen.buffer.push_string(func_name)
            self.codegen.buffer.push_string("(")
            self.codegen.buffer.push_string(access.path)
            self.codegen.buffer.push_string(", ")
            self.codegen.buffer.push_string(emission.expression)
            self.codegen.buffer.push_string(");\n")
        } else {
            let op = self.compound_op_to_c(assignment.operator_kind)
            self.codegen.add_indent()
            self.codegen.buffer.push_string(access.path)
            self.codegen.buffer.push_string(" ")
            self.codegen.buffer.push_string(op)
            self.codegen.buffer.push_string(" ")
            self.codegen.buffer.push_string(emission.expression)
            self.codegen.buffer.push_string(";\n")
        }
        self.consume_moved_source(assignment.value)
        self.emit_cleanup(access.cleanup)
        self.emit_residual_cleanups(emission, true)
    }

    protected compound_op_to_c(*self, op CompoundAssignmentOperator) String = {
        return when op in {
            .AddAssign() then "+=",
            .SubtractAssign() then "-=",
            .MultiplyAssign() then "*=",
            .DivideAssign() then "/=",
            .RemainderAssign() then "%=",
            .BitAndAssign() then "&=",
            .BitOrAssign() then "|=",
            .BitXorAssign() then "^=",
            .LeftShiftAssign() then "<<=",
            .RightShiftAssign() then ">>=",
        }
    }

    protected emit_drop(*mutable self, place MIRPlace) Void = {
        let access = self.emit_place_access(place)
        let drop_type = self.type_of_place(place)
        when self.local_target_id(place) in {
            .Some(local_id) then when self.init_flag(local_id) in {
                .Some(flag) then self.emit_guarded_drop(flag, drop_type, access.path),
                .None() then {},
            },
            .None() then {
                self.codegen.add_indent()
                self.codegen.append_drop_statement(drop_type, access.path)
            },
        }
        self.emit_cleanup(access.cleanup)
    }

    protected emit_retain(*mutable self, value MIRValue) Void = {
        let emission = self.emit_value_source(value)
        let value_type = self.type_of_value(value)
        when value_type in {
            .ReferenceType(_) or .MutableReferenceType(_) or .TraitObject(_, _) then {
                self.codegen.add_indent()
                self.codegen.buffer.push_string("if (((")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(").control)) { __koral_retain(((")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(").control)); }\n")
            },
            .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) then {},
            .WeakReferenceType(_) or .MutableWeakReferenceType(_) then {
                self.codegen.add_indent()
                self.codegen.buffer.push_string("if (((")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(").control)) { __koral_weak_retain(((")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(").control)); }\n")
            },
            .FunctionType(_, _) then {
                self.codegen.add_indent()
                self.codegen.buffer.push_string("__koral_closure_retain(")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(");\n")
            },
            _ then {},
        }
        self.emit_cleanup(emission.cleanup)
    }

    protected emit_release(*mutable self, value MIRValue) Void = {
        let emission = self.emit_value_source(value)
        self.codegen.add_indent()
        self.codegen.append_drop_statement(self.type_of_value(value), emission.expression)
        self.emit_cleanup(emission.cleanup)
    }

    protected emit_evaluate(*mutable self, value MIRValue) Void = {
        let emission = self.emit_value(value)
        let value_type = self.type_of_value(value)
        if self.codegen.needs_drop(value_type) then {
            when value in {
                .Operand(.Local(local_id)) then when self.init_flag(local_id) in {
                    .Some(flag) then self.emit_guarded_drop(flag, value_type, emission.expression),
                    .None() then {},
                },
                _ then {
                    self.codegen.add_indent()
                    self.codegen.append_drop_statement(value_type, emission.expression)
                },
            }
            self.emit_residual_cleanups(emission, true)
        } else {
            self.emit_cleanup(emission.cleanup)
        }
    }

    protected emit_scope_cleanup(*mutable self, scope MIRScopeID) Void = {
        self.emit_scope_cleanup_preserving(scope, Option[MIRLocalID].None())
    }

    protected emit_scope_cleanup_preserving(*mutable self, scope MIRScopeID, preserved Option[MIRLocalID]) Void = {
        when self.lifetime_plan.locals_by_scope.get(scope.raw_value) in {
            .Some(locals) then {
                let mutable i = locals.count()
                while i > 0 then {
                    i -= 1
                    let local_id = locals[i]
                    let skip = when preserved in {
                        .Some(value) then value.raw_value == local_id.raw_value,
                        .None() then false,
                    }
                    if not skip then {
                        when self.init_flag(local_id) in {
                            .Some(flag) then when self.local_info(local_id) in {
                                .Some(local) then self.emit_guarded_drop(flag, local.local_type, self.local_name(local_id)),
                                .None() then {},
                            },
                            .None() then {},
                        }
                    }
                }
            },
            .None() then {},
        }
    }

    protected emit_return(*mutable self, operand Option[MIROperand]) Void = {
        when operand in {
            .Some(op) then {
                let raw_emission = self.emit_operand_value(op)
                let return_type = self.type_of_operand(op)
                let emission = raw_emission
                let should_copy = self.should_copy_returned_operand(op, return_type)
                let return_expression = if should_copy then {
                    let temp = self.codegen.next_temp_with_decl(self.codegen.c_type_name(return_type))
                    self.codegen.append_copy_or_move_assignment(return_type, emission.expression, temp, true)
                    self.emit_root_cleanup(Option[MIRLocalID].None())
                    yield temp
                } else {
                    // Treat returning a local as moving ownership to the caller.
                    // Otherwise root cleanup can still drop the same local before
                    // the `return`, which is catastrophic for boxed/string values.
                    when self.local_id_from_operand(op) in {
                        .Some(local_id) then self.set_init_flag(local_id, false),
                        .None() then {},
                    }
                    self.emit_root_cleanup(self.local_id_from_operand(op))
                    // For borrowed reference parameters, retain before returning so the
                    // caller receives an owned reference. Without this, the caller and
                    // the callee parameter share the same control block, and both
                    // releases cause a double-free.
                    if self.is_parameter_operand(op) and is_reference_like_type(return_type) then {
                        self.codegen.add_indent()
                        self.codegen.buffer.push_string("if ((")
                        self.codegen.buffer.push_string(emission.expression)
                        self.codegen.buffer.push_string(").control) { __koral_retain((")
                        self.codegen.buffer.push_string(emission.expression)
                        self.codegen.buffer.push_string(").control); }\n")
                    }
                    yield emission.expression
                }
                self.codegen.add_indent()
                self.codegen.buffer.push_string("return ")
                self.codegen.buffer.push_string(return_expression)
                self.codegen.buffer.push_string(";\n")
                self.emit_residual_cleanups(emission, not should_copy)
            },
            .None() then {
                self.emit_root_cleanup(Option[MIRLocalID].None())
                self.codegen.add_indent()
                self.codegen.buffer.push_string("return;\n")
            },
        }
    }

    protected emit_root_cleanup(*mutable self, preserved Option[MIRLocalID]) Void = {
        let mutable i = self.function.locals.count()
        while i > 0 then {
            i -= 1
            let local = self.function.locals[i]
            let local_id = local.id
            let skip = when preserved in { .Some(p) then p.raw_value == local_id.raw_value, .None() then false }
            if skip then { continue }
            when self.init_flag(local_id) in {
                .Some(flag) then self.emit_guarded_drop(flag, local.local_type, self.local_name(local_id)),
                .None() then {},
            }
        }
    }

    protected emit_guarded_drop(*mutable self, flag String, drop_type Type, expression String) Void = {
        self.codegen.add_indent()
        self.codegen.buffer.push_string("if (")
        self.codegen.buffer.push_string(flag)
        self.codegen.buffer.push_string(") {\n")
        let saved_indent = self.codegen.indent
        self.codegen.indent = "\(self.codegen.indent)    "
        self.codegen.add_indent()
        self.codegen.append_drop_statement(drop_type, expression)
        self.codegen.add_indent()
        self.codegen.buffer.push_string(flag)
        self.codegen.buffer.push_string(" = 0;\n")
        self.codegen.indent = saved_indent
        self.codegen.add_indent()
        self.codegen.buffer.push_string("}\n")
    }

    protected emit_value(*mutable self, value MIRValue) MIRValueEmission = {
        return when value in {
            .Operand(operand) then self.emit_operand_value(operand),
            .PlaceRead(place, ownership) then self.emit_place_read(place, ownership, false),
            .Binary(operation) then self.emit_binary(operation),
            .Unary(operation) then self.emit_unary(operation),
            .Call(call) then self.emit_call(call),
            .Aggregate(aggregate) then self.emit_aggregate(aggregate),
            .EnumCase(construction) then self.emit_enum_case(construction),
            .EnumTag(tag) then self.emit_enum_tag(tag),
            .TraitObjectConversion(conversion) then self.emit_trait_object_conversion(conversion),
            .TraitMethodCall(call) then self.emit_trait_method_call(call),
            .Ref(place, kind, allocation) then self.emit_reference(place, kind, allocation),
            .Pointer(place) then self.emit_pointer(place),
            .Cast(operand, target_type) then self.emit_cast_operand(operand, target_type),
            .Intrinsic(node) then self.emit_intrinsic(node),
            .Lambda(lambda) then self.emit_lambda(lambda),
        }
    }

    protected emit_value_source(*mutable self, value MIRValue) MIRValueEmission = {
        return when value in {
            .PlaceRead(place, ownership) then {
                let result = self.emit_place_read(place, ownership, true)
                yield result
            },
            _ then self.emit_value(value),
        }
    }

    protected emit_operand_value(*mutable self, operand MIROperand) MIRValueEmission = {
        let expression = self.emit_operand_expression(operand)
        return MIRValueEmission(expression, Option[* MIRValueCleanup].None())
    }

    protected emit_operand_expression(*mutable self, operand MIROperand) String = {
        return when operand in {
            .Local(local) then self.local_name(local),
            .Function(symbol) then self.codegen.callable_c_name(symbol),
            .Constant(constant) then self.constant_expression(constant),
        }
    }

    protected constant_expression(*mutable self, constant MIRConstant) String = {
        return when constant in {
            .Integer(value, _) then self.codegen.sanitize_c_numeric_literal(value),
            .Float(value, _) then self.codegen.sanitize_c_numeric_literal(value),
            .StringLiteral(value, string_type) then self.codegen.generate_string_literal(value, string_type),
            .Boolean(value) then if value then "1" else "0",
            .Void() then "0",
        }
    }

    protected emit_place_read(*mutable self, place MIRPlace, ownership MIROwnershipUse, source_mode Bool) MIRValueEmission = {
        let access = self.emit_place_access(place)
        let place_type = self.type_of_place(place)
        if ownership is .Move() then {
            self.consume_moved_place(place)
        }
        if source_mode or ownership is not .Copy() or not self.codegen.needs_drop(place_type) then {
            return MIRValueEmission(access.path, access.cleanup)
        }
        let temp = self.codegen.next_temp_with_decl(self.codegen.c_type_name(place_type))
        self.codegen.append_copy_or_move_assignment(place_type, access.path, temp, true)
        self.emit_cleanup(access.cleanup)
        return MIRValueEmission(temp, self.cleanup_for_temporary_result(temp, place_type))
    }

    protected emit_binary(*mutable self, operation MIRBinaryOperation) MIRValueEmission = {
        let left = self.emit_operand_expression(operation.left)
        let right = self.emit_operand_expression(operation.right)
        let result_type = operation.result_type
        let c_type = self.codegen.c_type_name(result_type)
        let expression = when operation.operator_kind in {
            .Arithmetic(op, checked) then {
                let expr = if checked and self.codegen.is_integer_type(result_type) then self.codegen.next_temp_with_call_2(c_type, self.codegen.checked_arithmetic_func_name(op, result_type), left, right) else self.codegen.next_temp_with_infix_init(c_type, left, self.codegen.arithmetic_op_to_c(op), right)
                yield expr
            },
            .WrappingArithmetic(op) then self.codegen.next_temp_with_call_2(c_type, self.wrapping_arithmetic_func_name(op, result_type), left, right),
            .Comparison(op) then self.codegen.next_temp_with_infix_init(c_type, left, self.codegen.comparison_op_to_c(op), right),
            .LogicalAnd() then self.codegen.next_temp_with_infix_init("_Bool", left, "&&", right),
            .LogicalOr() then self.codegen.next_temp_with_infix_init("_Bool", left, "||", right),
            .Bitwise(op, checked_shift) then {
                let expr = if checked_shift and self.codegen.is_integer_type(result_type) and (op is .LeftShift() or op is .RightShift()) then self.codegen.next_temp_with_call_2(c_type, self.codegen.checked_shift_func_name(op, result_type), left, right) else self.codegen.next_temp_with_infix_init(c_type, left, self.codegen.bitwise_op_to_c(op), right)
                yield expr
            },
            .WrappingShift(op) then self.codegen.next_temp_with_call_2(c_type, self.wrapping_shift_func_name(op, result_type), left, right),
        }
        return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, result_type))
    }

    protected wrapping_arithmetic_func_name(*self, op ArithmeticOperator, t Type) String = {
        let op_name = when op in {
            .Add() then "add",
            .Subtract() then "sub",
            .Multiply() then "mul",
            .Divide() then "div",
            .Remainder() then "rem",
        }
        return "koral_wrapping_\(op_name)_\(self.codegen.type_suffix(t))"
    }

    protected wrapping_shift_func_name(*self, op BitwiseOperator, t Type) String = {
        let op_name = when op in {
            .LeftShift() then "shl",
            .RightShift() then "shr",
            _ then "shl",
        }
        return "koral_wrapping_\(op_name)_\(self.codegen.type_suffix(t))"
    }

    protected call_arguments_match_function_type(*self, arguments List[* MIRValue], function_type Type) Bool = {
        return when function_type in {
            .FunctionType(params, _) then {
                if params.count() <> arguments.count() then {
                    return false
                }
                let mutable i UInt = 0
                while i < arguments.count() then {
                    let expected_param_type = self.codegen.function_type_param_type(function_type, i) or else Type.Unknown()
                    let actual_param_type = self.type_of_value((*arguments[i]))
                    let expected_key = self.codegen.concrete_layout_key_for_type(self.codegen.concretize_codegen_type(expected_param_type))
                    let actual_key = self.codegen.concrete_layout_key_for_type(self.codegen.concretize_codegen_type(actual_param_type))
                    if expected_key <> actual_key then {
                        return false
                    }
                    i += 1
                }
                yield true
            },
            _ then false,
        }
    }

    protected emit_unary(*mutable self, operation MIRUnaryOperation) MIRValueEmission = {
        let operand = self.emit_operand_expression(operation.operand)
        let result_type = operation.result_type
        let expression = when operation.operator_kind in {
            .LogicalNot() then self.codegen.next_temp_with_init("_Bool", "!\(operand)"),
            .BitwiseNot() then self.codegen.next_temp_with_init(self.codegen.c_type_name(result_type), "~\(operand)"),
        }
        return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, result_type))
    }

    protected emit_call(*mutable self, call MIRCall) MIRValueEmission = {
        let has_ownerships = call.argument_ownerships.count() == call.arguments.count()
        when call.callee in {
            .Function(symbol) then {
                let function_name = self.callable_name_for_symbol(symbol)
                let function_type = self.codegen.context.get_function_type(symbol.def_id) or else symbol.symbol_type
                if call.arguments.count() == 0 then {
                    let expression = self.emit_direct_call_0(function_name, call.result_type)
                    return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, call.result_type))
                }
                if call.arguments.count() == 1 then {
                    let ownership = if has_ownerships then call.argument_ownerships[0(UInt)] else MIROwnershipUse.Move()
                    let emission = self.emit_direct_call_argument((*call.arguments[0(UInt)]), ownership)
                    // Auto-wrap: if the function parameter expects a borrowed reference
                    // but the argument is a raw value, wrap it in a stack borrow.
                    let arg_type = self.type_of_value((*call.arguments[0(UInt)]))
                    let expected_param_type = self.codegen.function_type_param_type(function_type, 0(UInt)) or else Type.Unknown()
                    let needs_wrap = is_borrowed_reference_like_type(expected_param_type) and not is_borrowed_reference_like_type(arg_type)
                    let final_emission = if needs_wrap
                        then self.wrap_value_as_stack_borrow(emission.expression, arg_type, expected_param_type)
                        else self.unwrap_reference_like_argument_if_needed(emission, arg_type, expected_param_type)
                    let expression = self.emit_direct_call_1(function_name, final_emission.expression, call.result_type)
                    if ownership is .Move() or ownership is .Take() then {
                        self.consume_moved_source((*call.arguments[0(UInt)]))
                    }
                    self.emit_residual_cleanups(final_emission, self.call_arg_consumed(ownership, (*call.arguments[0(UInt)])))
                    return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, call.result_type))
                }
                if call.arguments.count() == 2 then {
                    let first_ownership = if has_ownerships then call.argument_ownerships[0(UInt)] else MIROwnershipUse.Move()
                    let second_ownership = if has_ownerships then call.argument_ownerships[1(UInt)] else MIROwnershipUse.Move()
                    let first_emission = self.emit_direct_call_argument((*call.arguments[0(UInt)]), first_ownership)
                    let second_emission = self.emit_direct_call_argument((*call.arguments[1(UInt)]), second_ownership)
                    // Auto-wrap borrowed reference parameters.
                    let first_type = self.type_of_value((*call.arguments[0(UInt)]))
                    let second_type = self.type_of_value((*call.arguments[1(UInt)]))
                    let first_expected = self.codegen.function_type_param_type(function_type, 0(UInt)) or else Type.Unknown()
                    let second_expected = self.codegen.function_type_param_type(function_type, 1(UInt)) or else Type.Unknown()
                    let first = if is_borrowed_reference_like_type(first_expected) and not is_borrowed_reference_like_type(first_type)
                        then self.wrap_value_as_stack_borrow(first_emission.expression, first_type, first_expected)
                        else self.unwrap_reference_like_argument_if_needed(first_emission, first_type, first_expected)
                    let second = if is_borrowed_reference_like_type(second_expected) and not is_borrowed_reference_like_type(second_type)
                        then self.wrap_value_as_stack_borrow(second_emission.expression, second_type, second_expected)
                        else self.unwrap_reference_like_argument_if_needed(second_emission, second_type, second_expected)
                    let expression = self.emit_direct_call_2(function_name, first.expression, second.expression, call.result_type)
                    if first_ownership is .Move() or first_ownership is .Take() then {
                        self.consume_moved_source((*call.arguments[0(UInt)]))
                    }
                    if second_ownership is .Move() or second_ownership is .Take() then {
                        self.consume_moved_source((*call.arguments[1(UInt)]))
                    }
                    self.emit_residual_cleanups(first, self.call_arg_consumed(first_ownership, (*call.arguments[0(UInt)])))
                    self.emit_residual_cleanups(second, self.call_arg_consumed(second_ownership, (*call.arguments[1(UInt)])))
                    return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, call.result_type))
                }
            },
            _ then {},
        }

        // Get function parameter types for borrowed-reference wrapping.
        let fn_param_types = when call.callee in {
            .Function(sym) then {
                let mutable pts = List[Type].new()
                let function_type = self.codegen.context.get_function_type(sym.def_id) or else sym.symbol_type
                when function_type in {
                    .FunctionType(params, _) then {
                        for p in params then { pts.push(p.param_type) }
                    },
                    _ then {},
                }
                yield pts
            },
            _ then List[Type].new(),
        }
        let mutable arg_values = List[String].new()
        let mutable emissions = List[MIRValueEmission].new()
        let mutable ownerships = List[MIROwnershipUse].new()
        let mutable arg_i UInt = 0
        while arg_i < call.arguments.count() then {
            let arg = call.arguments[arg_i]
            let ownership = if has_ownerships then call.argument_ownerships[arg_i] else MIROwnershipUse.Move()
            ownerships.push(ownership)
            let emission = self.emit_direct_call_argument(*arg, ownership)
            // Auto-wrap: if the function parameter expects a borrowed reference
            // but the argument is a raw value, wrap it in a stack borrow.
            let arg_type = self.type_of_value(*arg)
            let needs_wrap = arg_i < fn_param_types.count() and is_borrowed_reference_like_type(fn_param_types[arg_i]) and not is_borrowed_reference_like_type(arg_type)
            if needs_wrap then {
                let wrapped = self.wrap_value_as_stack_borrow(emission.expression, arg_type, fn_param_types[arg_i])
                emissions.push(wrapped)
                arg_values.push(wrapped.expression)
            } else {
                let final_emission = if arg_i < fn_param_types.count()
                    then self.unwrap_reference_like_argument_if_needed(emission, arg_type, fn_param_types[arg_i])
                    else emission
                emissions.push(final_emission)
                arg_values.push(final_emission.expression)
            }
            arg_i += 1
        }
        let expression = when call.callee in {
            .Function(symbol) then {
                let callee_name = self.callable_name_for_symbol(symbol)
                yield self.emit_direct_call(callee_name, arg_values, call.result_type)
            },
            _ then self.emit_closure_call(self.emit_operand_expression(call.callee), self.type_of_operand(call.callee), arg_values, call.result_type),
        }
        let mutable consume_i UInt = 0
        while consume_i < call.arguments.count() then {
            let ownership = ownerships[consume_i]
            if ownership is .Move() or ownership is .Take() then {
                self.consume_moved_source((*call.arguments[consume_i]))
            }
            consume_i += 1
        }
        let mutable cleanup_i UInt = 0
        while cleanup_i < emissions.count() then {
            self.emit_residual_cleanups(emissions[cleanup_i], self.call_arg_consumed(ownerships[cleanup_i], (*call.arguments[cleanup_i])))
            cleanup_i += 1
        }
        return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, call.result_type))
    }

    protected emit_direct_call_argument(*mutable self, value MIRValue, ownership MIROwnershipUse) MIRValueEmission = {
        let value_type = self.type_of_value(value)
        return when ownership in {
            .Copy() then {
                let emission = self.emit_value(value)
                if not self.codegen.needs_drop(value_type) then {
                    yield emission
                }
                yield when value in {
                    .PlaceRead(_, place_ownership) then {
                        if place_ownership is .Copy() then {
                            yield emission
                        } else {
                            let temp = self.codegen.next_temp_with_decl(self.codegen.c_type_name(value_type))
                            self.codegen.append_copy_or_move_assignment(value_type, emission.expression, temp, true)
                            self.emit_cleanup(emission.cleanup)
                            yield MIRValueEmission(temp, self.cleanup_for_temporary_result(temp, value_type))
                        }
                    },
                    _ then {
                        let temp = self.codegen.next_temp_with_decl(self.codegen.c_type_name(value_type))
                        self.codegen.append_copy_or_move_assignment(value_type, emission.expression, temp, true)
                        self.emit_cleanup(emission.cleanup)
                        yield MIRValueEmission(temp, self.cleanup_for_temporary_result(temp, value_type))
                    },
                }
            },
            .Borrow() then self.emit_value_source(value),
            .Move() then self.emit_value_source(value),
            .Take() then self.emit_value_source(value),
        }
    }

    protected call_arg_consumed(*self, ownership MIROwnershipUse, value MIRValue) Bool = {
        return when ownership in {
            .Move() or .Take() then true,
            .Copy() then when value in {
                .PlaceRead(_, borrow_ownership) then borrow_ownership is not .Borrow(),
                _ then true,
            },
            .Borrow() then false,
        }
    }

    protected emit_direct_call_0(*mutable self, function_name String, return_type Type) String = {
        if self.codegen.type_is_void_or_never(return_type) then {
            self.codegen.add_indent()
            self.codegen.buffer.push_string(function_name)
            self.codegen.buffer.push_string("();\n")
            return ""
        }
        return self.codegen.next_temp_with_call_0(self.codegen.c_type_name(return_type), function_name)
    }

    protected emit_direct_call_1(*mutable self, function_name String, arg String, return_type Type) String = {
        if self.codegen.type_is_void_or_never(return_type) then {
            self.codegen.add_indent()
            self.codegen.buffer.push_string(function_name)
            self.codegen.buffer.push_string("(")
            self.codegen.buffer.push_string(arg)
            self.codegen.buffer.push_string(");\n")
            return ""
        }
        return self.codegen.next_temp_with_call_1(self.codegen.c_type_name(return_type), function_name, arg)
    }

    protected emit_direct_call_2(*mutable self, function_name String, first_arg String, second_arg String, return_type Type) String = {
        if self.codegen.type_is_void_or_never(return_type) then {
            self.codegen.add_indent()
            self.codegen.buffer.push_string(function_name)
            self.codegen.buffer.push_string("(")
            self.codegen.buffer.push_string(first_arg)
            self.codegen.buffer.push_string(", ")
            self.codegen.buffer.push_string(second_arg)
            self.codegen.buffer.push_string(");\n")
            return ""
        }
        return self.codegen.next_temp_with_call_2(self.codegen.c_type_name(return_type), function_name, first_arg, second_arg)
    }

    protected emit_direct_call(*mutable self, function_name String, arguments List[String], return_type Type) String = {
        if self.codegen.type_is_void_or_never(return_type) then {
            self.codegen.add_indent()
            self.codegen.buffer.push_string(function_name)
            self.codegen.buffer.push_string("(")
            self.codegen.push_joined_strings(arguments, ", ")
            self.codegen.buffer.push_string(");\n")
            return ""
        }
        return self.codegen.next_temp_with_call_args(self.codegen.c_type_name(return_type), function_name, arguments)
    }

    protected emit_closure_call(*mutable self, closure_expr String, callee_type Type, arguments List[String], return_type Type) String = {
        let mutable param_types = List[String].new()
        when callee_type in {
            .FunctionType(params, _) then for param in params then { param_types.push(self.codegen.c_type_name(param.param_type)) },
            _ then {},
        }
        let no_capture_sig = if param_types.is_empty() then "void" else join_strings(param_types, ", ")
        let mutable with_capture_parts = List[String].new()
        with_capture_parts.push("void*")
        for p in param_types then { with_capture_parts.push(p) }
        let with_capture_sig = join_strings(with_capture_parts, ", ")
        let return_c_type = self.codegen.c_type_name(return_type)
        let mutable args_with_env = List[String].new()
        args_with_env.push("\(closure_expr).env")
        for arg in arguments then { args_with_env.push(arg) }
        if self.codegen.type_is_void_or_never(return_type) then {
            self.codegen.add_indent()
            self.codegen.buffer.push_string("if (")
            self.codegen.buffer.push_string(closure_expr)
            self.codegen.buffer.push_string(".env == NULL) {\n")
            self.codegen.indent = "\(self.codegen.indent)    "
            self.codegen.add_indent()
            self.codegen.buffer.push_string("((")
            self.codegen.buffer.push_string(return_c_type)
            self.codegen.buffer.push_string(" (*)(")
            self.codegen.buffer.push_string(no_capture_sig)
            self.codegen.buffer.push_string("))(")
            self.codegen.buffer.push_string(closure_expr)
            self.codegen.buffer.push_string(".fn))(")
            self.codegen.push_joined_strings(arguments, ", ")
            self.codegen.buffer.push_string(");\n")
            self.codegen.indent = self.codegen.indent.substring(..self.codegen.indent.count() - 4(UInt))
            self.codegen.add_indent()
            self.codegen.buffer.push_string("} else {\n")
            self.codegen.indent = "\(self.codegen.indent)    "
            self.codegen.add_indent()
            self.codegen.buffer.push_string("((")
            self.codegen.buffer.push_string(return_c_type)
            self.codegen.buffer.push_string(" (*)(")
            self.codegen.buffer.push_string(with_capture_sig)
            self.codegen.buffer.push_string("))(")
            self.codegen.buffer.push_string(closure_expr)
            self.codegen.buffer.push_string(".fn))(")
            self.codegen.push_joined_strings(args_with_env, ", ")
            self.codegen.buffer.push_string(");\n")
            self.codegen.indent = self.codegen.indent.substring(..self.codegen.indent.count() - 4(UInt))
            self.codegen.add_indent()
            self.codegen.buffer.push_string("}\n")
            return ""
        }
        let result = self.codegen.next_temp_with_decl(return_c_type)
        self.codegen.add_indent()
        self.codegen.buffer.push_string("if (")
        self.codegen.buffer.push_string(closure_expr)
        self.codegen.buffer.push_string(".env == NULL) {\n")
        self.codegen.indent = "\(self.codegen.indent)    "
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(" = ((")
        self.codegen.buffer.push_string(return_c_type)
        self.codegen.buffer.push_string(" (*)(")
        self.codegen.buffer.push_string(no_capture_sig)
        self.codegen.buffer.push_string("))(")
        self.codegen.buffer.push_string(closure_expr)
        self.codegen.buffer.push_string(".fn))(")
        self.codegen.push_joined_strings(arguments, ", ")
        self.codegen.buffer.push_string(");\n")
        self.codegen.indent = self.codegen.indent.substring(..self.codegen.indent.count() - 4(UInt))
        self.codegen.add_indent()
        self.codegen.buffer.push_string("} else {\n")
        self.codegen.indent = "\(self.codegen.indent)    "
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(" = ((")
        self.codegen.buffer.push_string(return_c_type)
        self.codegen.buffer.push_string(" (*)(")
        self.codegen.buffer.push_string(with_capture_sig)
        self.codegen.buffer.push_string("))(")
        self.codegen.buffer.push_string(closure_expr)
        self.codegen.buffer.push_string(".fn))(")
        self.codegen.push_joined_strings(args_with_env, ", ")
        self.codegen.buffer.push_string(");\n")
        self.codegen.indent = self.codegen.indent.substring(..self.codegen.indent.count() - 4(UInt))
        self.codegen.add_indent()
        self.codegen.buffer.push_string("}\n")
        return result
    }

    protected emit_aggregate(*mutable self, aggregate MIRAggregate) MIRValueEmission = {
        let mutable fields = List[String].new()
        let mutable emissions = List[MIRValueEmission].new()
        for field in aggregate.fields then {
            self.consume_moved_source(*field)
            let emission = self.emit_value(*field)
            emissions.push(emission)
            fields.push(emission.expression)
        }
        let expression = self.codegen.next_temp_with_braced_values(self.codegen.c_type_name(aggregate.aggregate_type), fields)
        for emission in emissions then { self.emit_residual_cleanups(emission, true) }
        return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, aggregate.aggregate_type))
    }

    protected emit_enum_case(*mutable self, construction MIREnumConstruction) MIRValueEmission = {
        let expression = self.codegen.next_temp_with_decl(self.codegen.c_type_name(construction.enum_type))
        let case_info = self.enum_case_info(construction.enum_type, construction.case_name)
        self.codegen.add_indent()
        self.codegen.buffer.push_string(expression)
        self.codegen.buffer.push_string(".tag = ")
        self.codegen.buffer.push_string(case_info.first.to_string())
        self.codegen.buffer.push_string(";\n")
        let mutable argument_index UInt = 0
        for field in case_info.second then {
            if not self.codegen.type_is_void(field.param_type) then {
                let arg_value = (*construction.arguments[argument_index])
                let emission = self.emit_value(arg_value)
                let field_dest = "\(expression).data.\(self.codegen.sanitize_codegen_identifier(construction.case_name)).\(self.codegen.sanitize_codegen_identifier(field.name))"
                let assigned_expression = self.adapt_expression_for_target_type(
                    emission.expression,
                    self.type_of_value(arg_value),
                    field.param_type,
                    false,
                    arg_value is .Operand(.Function(_)),
                )
                self.codegen.append_copy_or_move_assignment(field.param_type, assigned_expression, field_dest, false)
                self.consume_moved_source(arg_value)
                self.emit_residual_cleanups(emission, true)
                argument_index += 1
            }
        }
        return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, construction.enum_type))
    }

    protected emit_enum_tag(*mutable self, tag MIREnumTag) MIRValueEmission = {
        let subject = self.emit_value_source(*(tag.subject))
        let subject_expr = when self.type_of_value(*(tag.subject)) in {
            .ReferenceType(inner) then "(*(\(self.codegen.c_type_name(*inner))*)\(subject.expression).ptr)",
            .MutableReferenceType(inner) then "(*(\(self.codegen.c_type_name(*inner))*)\(subject.expression).ptr)",
            .BorrowedReferenceType(inner) then "(*(\(self.codegen.c_type_name(*inner))*)\(subject.expression).ptr)",
            .MutableBorrowedReferenceType(inner) then "(*(\(self.codegen.c_type_name(*inner))*)\(subject.expression).ptr)",
            .WeakReferenceType(inner) then "(*(\(self.codegen.c_type_name(*inner))*)\(subject.expression).ptr)",
            .MutableWeakReferenceType(inner) then "(*(\(self.codegen.c_type_name(*inner))*)\(subject.expression).ptr)",
            _ then subject.expression,
        }
        let expression = self.codegen.next_temp_with_init(self.codegen.c_type_name(Type.IntType()), "\(subject_expr).tag")
        self.emit_cleanup(subject.cleanup)
        return MIRValueEmission(expression, Option[* MIRValueCleanup].None())
    }

    protected emit_trait_object_conversion(*mutable self, conversion MIRTraitObjectConversion) MIRValueEmission = {
        let inner = self.emit_value_source(*(conversion.inner))
        let inner_type = self.type_of_value(*(conversion.inner))
        let should_retain = conversion.source_ownership is .Copy() or conversion.source_ownership is .Borrow()
        // If inner is a scalar type (not a ref), we need to heap-allocate it first
        let is_ref_type = when inner_type in {
            .ReferenceType(_) or .MutableReferenceType(_) or .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) or .WeakReferenceType(_) or .MutableWeakReferenceType(_) or .TraitObject(_, _) then true,
            _ then false,
        }
        let mutable ref_expression = inner.expression
        if not is_ref_type then {
            // Merged layout: allocate control block + payload in one malloc
            let pointee_c_type = self.codegen.c_type_name(inner_type)
            let ref_temp = self.codegen.next_temp_with_decl("struct __koral_Ref")
            self.codegen.add_indent()
            self.codegen.buffer.push_string(ref_temp)
            self.codegen.buffer.push_string(".control = malloc(sizeof(struct __koral_Control) + sizeof(")
            self.codegen.buffer.push_string(pointee_c_type)
            self.codegen.buffer.push_string("));\n")
            self.codegen.add_indent()
            self.codegen.buffer.push_string(ref_temp)
            self.codegen.buffer.push_string(".ptr = (char*)")
            self.codegen.buffer.push_string(ref_temp)
            self.codegen.buffer.push_string(".control + sizeof(struct __koral_Control);\n")
            self.codegen.add_indent()
            self.codegen.buffer.push_string("((struct __koral_Control*)")
            self.codegen.buffer.push_string(ref_temp)
            self.codegen.buffer.push_string(".control)->strong_count = 1;\n")
            self.codegen.add_indent()
            self.codegen.buffer.push_string("((struct __koral_Control*)")
            self.codegen.buffer.push_string(ref_temp)
            self.codegen.buffer.push_string(".control)->weak_count = 1;\n")
            self.codegen.add_indent()
            self.codegen.buffer.push_string("((struct __koral_Control*)")
            self.codegen.buffer.push_string(ref_temp)
            self.codegen.buffer.push_string(".control)->ptr = ")
            self.codegen.buffer.push_string(ref_temp)
            self.codegen.buffer.push_string(".ptr;\n")
            self.codegen.add_indent()
            self.codegen.buffer.push_string("((struct __koral_Control*)")
            self.codegen.buffer.push_string(ref_temp)
            self.codegen.buffer.push_string(".control)->dtor = ")
            when inner_type in {
                .StructureType(def_id) then {
                    self.codegen.buffer.push_string("(__koral_Dtor)__koral_\(self.codegen.c_name_for_def_id(def_id))_drop;\n")
                },
                .EnumType(def_id) then {
                    self.codegen.buffer.push_string("(__koral_Dtor)__koral_\(self.codegen.c_name_for_def_id(def_id))_drop;\n")
                },
                .ReferenceType(_) then {
                    self.codegen.buffer.push_string("(__koral_Dtor)__koral_ref_drop;\n")
                },
                .MutableReferenceType(_) then {
                    self.codegen.buffer.push_string("(__koral_Dtor)__koral_ref_drop;\n")
                },
                .BorrowedReferenceType(_) then {
                    self.codegen.buffer.push_string("(__koral_Dtor)__koral_ref_drop;\n")
                },
                .MutableBorrowedReferenceType(_) then {
                    self.codegen.buffer.push_string("(__koral_Dtor)__koral_ref_drop;\n")
                },
                .WeakReferenceType(_) then {
                    self.codegen.buffer.push_string("(__koral_Dtor)__koral_weakref_drop;\n")
                },
                .MutableWeakReferenceType(_) then {
                    self.codegen.buffer.push_string("(__koral_Dtor)__koral_weakref_drop;\n")
                },
                .FunctionType(_, _) then {
                    self.codegen.buffer.push_string("(__koral_Dtor)__koral_closure_drop;\n")
                },
                _ then {
                    self.codegen.buffer.push_string("NULL;\n")
                },
            }
            let dest_expr = "*(" + pointee_c_type + "*)" + ref_temp + ".ptr"
            self.codegen.append_copy_or_move_assignment(inner_type, inner.expression, dest_expr, false)
            ref_expression = ref_temp
        }
        let expression = self.codegen.generate_trait_object_conversion_from_ref_value(ref_expression, conversion.trait_name, conversion.concrete_type, should_retain)
        if conversion.source_ownership is .Move() then {
            self.consume_moved_source(*(conversion.inner))
        }
        self.emit_residual_cleanups(inner, conversion.source_ownership is .Move())
        return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, conversion.result_type))
    }

    protected trait_object_target_name(*self, t Type) Option[String] = {
        return when t in {
            .TraitObject(trait_name, _) then Option[String].Some(trait_name),
            .ReferenceType(inner) then self.trait_object_target_name(*inner),
            .MutableReferenceType(inner) then self.trait_object_target_name(*inner),
            .BorrowedReferenceType(inner) then self.trait_object_target_name(*inner),
            .MutableBorrowedReferenceType(inner) then self.trait_object_target_name(*inner),
            _ then Option[String].None(),
        }
    }

    protected trait_object_source_concrete_type(*self, t Type) Option[Type] = {
        let _ = self
        return when t in {
            .ReferenceType(inner) then if *inner is .TraitObject(_, _)
                then Option[Type].None()
                else Option[Type].Some(*inner),
            .MutableReferenceType(inner) then if *inner is .TraitObject(_, _)
                then Option[Type].None()
                else Option[Type].Some(*inner),
            .BorrowedReferenceType(inner) then if *inner is .TraitObject(_, _)
                then Option[Type].None()
                else Option[Type].Some(*inner),
            .MutableBorrowedReferenceType(inner) then if *inner is .TraitObject(_, _)
                then Option[Type].None()
                else Option[Type].Some(*inner),
            _ then Option[Type].None(),
        }
    }

    protected adapt_expression_for_target_type(
        *mutable self,
        expression String,
        source_type Type,
        target_type Type,
        retain_source Bool,
        bare_function_source Bool,
    ) String = {
        // Wrap bare function pointers in closure structs when target is FunctionType
        if target_type is .FunctionType(_, _) and source_type is .FunctionType(_, _) then {
            if bare_function_source then {
                return "(struct __koral_Closure){ .fn = (void*)\(expression), .env = NULL, .drop = NULL }"
            }
            return expression
        }
        return when self.trait_object_target_name(target_type) in {
            .Some(trait_name) then when self.trait_object_source_concrete_type(source_type) in {
                .Some(concrete_type) then self.codegen.generate_trait_object_conversion_from_ref_value(expression, trait_name, concrete_type, retain_source),
                .None() then expression,
            },
            .None() then expression,
        }
    }

    protected emit_trait_method_call(*mutable self, call MIRTraitMethodCall) MIRValueEmission = {
        let receiver = self.emit_value_source(*(call.receiver))
        let mutable arg_values = List[String].new()
        let mutable arg_types = List[Type].new()
        let mutable idx UInt = 0
        while idx < call.arguments.count() then {
            let emission = self.emit_value_source((*call.arguments[idx]))
            arg_values.push(emission.expression)
            arg_types.push(self.type_of_value((*call.arguments[idx])))
            if call.argument_ownerships[idx] is .Move() then {
                self.consume_moved_source((*call.arguments[idx]))
            }
            self.emit_residual_cleanups(emission, call.argument_ownerships[idx] is .Move())
            idx += 1
        }
        let expression = self.emit_trait_method_call_abi(receiver.expression, call.receiver_ownership, call.trait_name, self.type_list_to_ref_list(call.trait_type_args), call.method_name, call.method_index, arg_values, arg_types, call.result_type)
        if call.receiver_ownership is .Move() then {
            self.consume_moved_source(*(call.receiver))
        }
        self.emit_residual_cleanups(receiver, call.receiver_ownership is .Move())
        return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, call.result_type))
    }

    protected emit_trait_method_call_abi(
        *mutable self,
        receiver_result String,
        receiver_ownership MIROwnershipUse,
        trait_name String,
        trait_type_args List[* Type],
        method_name String,
        method_index Int,
        arg_values List[String],
        arg_types List[Type],
        result_type Type,
    ) String = {
        let members = self.codegen.get_ordered_trait_members_for_vtable(trait_name, self.codegen.trait_object_type_from_name(trait_name), trait_type_args)
        let mutable dispatch_method_name = method_name
        let mutable signature_return_type = result_type
        let mutable signature_param_types = List[Type].new()
        if method_index >= 0 and method_index(UInt) < members.count() then {
            let member = members[method_index(UInt)]
            dispatch_method_name = member.name
            signature_return_type = member.return_type or else signature_return_type
            for p in member.parameters then { signature_param_types.push(p.param_type or else Type.Unknown()) }
        } else {
            for member in members then {
                if member.name == method_name then {
                    dispatch_method_name = member.name
                    signature_return_type = member.return_type or else signature_return_type
                    for p in member.parameters then { signature_param_types.push(p.param_type or else Type.Unknown()) }
                    break
                }
            }
        }

        let effective_return_type = when result_type in { .Unknown() then signature_return_type, _ then result_type }
        let mutable method_param_types = List[String].new()
        method_param_types.push("struct __koral_Ref")
        let mutable arg_index UInt = 0
        while arg_index < arg_values.count() then {
            let expected_type = if arg_index + 1 < signature_param_types.count() then signature_param_types[arg_index + 1] else arg_types[arg_index]
            method_param_types.push(self.codegen.c_type_name(expected_type))
            arg_index += 1
        }
        let ref_var = self.codegen.next_temp_with_init("struct __koral_Ref", "(struct __koral_Ref){ .ptr = \(receiver_result).ptr, .control = \(receiver_result).control }")
        if receiver_ownership is .Copy() or receiver_ownership is .Borrow() then {
            self.codegen.add_indent()
            self.codegen.buffer.push_string("__koral_retain(")
            self.codegen.buffer.push_string(ref_var)
            self.codegen.buffer.push_string(".control);\n")
        }
        let mutable call_args = List[String].new()
        call_args.push(ref_var)
        for arg in arg_values then { call_args.push(arg) }
        let sanitized_method = self.codegen.sanitize_codegen_identifier(dispatch_method_name)
        let return_c_type = self.codegen.c_type_name(effective_return_type)
        let method_field_type = "\(return_c_type) (*\(sanitized_method))(\(join_strings(method_param_types, ", ")))"
        let vtable_struct = self.vtable_prefix_struct_type_for_mir_method(members, dispatch_method_name, method_field_type)
        let vt_call_target = "((\(vtable_struct)*)\(receiver_result).vtable)->\(sanitized_method)"
        if self.codegen.type_is_void_or_never(effective_return_type) then {
            self.codegen.add_indent()
            self.codegen.buffer.push_string(vt_call_target)
            self.codegen.buffer.push_string("(")
            self.codegen.push_joined_strings(call_args, ", ")
            self.codegen.buffer.push_string(");\n")
            return ""
        }
        return self.codegen.next_temp_with_call_args(return_c_type, vt_call_target, call_args)
    }

    protected vtable_prefix_struct_type_for_mir_method(*self, members List[MIRTraitVTableMethod], method_name String, method_field_type String) String = {
        let mutable code = "struct { "
        if members.is_empty() then {
            code.push_string(method_field_type)
            code.push_string("; ")
            code.push_string("}")
            return code
        }
        for member in members then {
            let field_name = self.codegen.sanitize_codegen_identifier(member.name)
            if member.name == method_name then {
                code.push_string(method_field_type)
                code.push_string("; ")
                break
            }
            code.push_string("void (*")
            code.push_string(field_name)
            code.push_string(")(); ")
        }
        code.push_string("}")
        return code
    }

    // Wrap a raw value expression in a stack-borrow __koral_Ref.
    // Used when a function expects a borrowed reference but the MIR passes a raw value.
    protected unwrap_reference_like_argument_if_needed(*mutable self, emission MIRValueEmission, arg_type Type, expected_type Type) MIRValueEmission = {
        if not is_borrowed_reference_like_type(arg_type) or is_borrowed_reference_like_type(expected_type) then {
            return emission
        }

        let expected_c_type = self.codegen.c_type_name(expected_type)
        let expression = when expected_type in {
            .StructureType(def_id) then "__koral_\(self.codegen.c_name_for_def_id(def_id))_copy((\(expected_c_type)*)\(emission.expression).ptr)",
            .EnumType(def_id) then "__koral_\(self.codegen.c_name_for_def_id(def_id))_copy((\(expected_c_type)*)\(emission.expression).ptr)",
            _ then "*(\(expected_c_type)*)\(emission.expression).ptr",
        }
        return MIRValueEmission(expression, emission.cleanup)
    }

    protected wrap_value_as_stack_borrow(*mutable self, value_expr String, value_type Type, ref_type Type) MIRValueEmission = {
        let result = self.codegen.next_temp_with_decl(self.codegen.c_type_name(ref_type))
        // Create a temporary to hold the value so we can take its address.
        let value_temp = self.codegen.next_temp_with_decl(self.codegen.c_type_name(value_type))
        self.codegen.add_indent()
        self.codegen.buffer.push_string(value_temp)
        self.codegen.buffer.push_string(" = ")
        self.codegen.buffer.push_string(value_expr)
        self.codegen.buffer.push_string(";\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".ptr = &")
        self.codegen.buffer.push_string(value_temp)
        self.codegen.buffer.push_string(";\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".control = NULL;\n")
        return MIRValueEmission(result, Option[* MIRValueCleanup].None())
    }

    protected emit_reference(*mutable self, place MIRPlace, kind MIRReferenceKind, allocation MIRReferenceAllocation) MIRValueEmission = {
        let result_type = self.type_of_ref(place, kind)
        return when allocation in {
            .HeapOwned() then self.emit_heap_reference(place, result_type),
            .StackBorrow() then self.emit_borrowed_reference(place, result_type),
        }
    }

    protected emit_borrowed_reference(*mutable self, place MIRPlace, result_type Type) MIRValueEmission = {
        let access = self.emit_place_access(place)
        let result = self.codegen.next_temp_with_decl(self.codegen.c_type_name(result_type))
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".ptr = &")
        self.codegen.buffer.push_string(access.path)
        self.codegen.buffer.push_string(";\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".control = ")
        self.codegen.buffer.push_string(access.control)
        self.codegen.buffer.push_string(";\n")
        self.emit_cleanup(access.cleanup)
        return MIRValueEmission(result, Option[* MIRValueCleanup].None())
    }

    protected emit_heap_reference(*mutable self, place MIRPlace, result_type Type) MIRValueEmission = {
        let access = self.emit_place_access(place)
        let pointee_type = self.type_of_place(place)
        let pointee_c_type = self.codegen.c_type_name(pointee_type)
        let result = self.codegen.next_temp_with_decl(self.codegen.c_type_name(result_type))
        let should_transfer = self.can_transfer_owned_heap_reference(place)
        // Merged layout: allocate control block + payload in one malloc
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".control = malloc(sizeof(struct __koral_Control) + sizeof(")
        self.codegen.buffer.push_string(pointee_c_type)
        self.codegen.buffer.push_string("));\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".ptr = (char*)")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".control + sizeof(struct __koral_Control);\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string("((struct __koral_Control*)")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".control)->strong_count = 1;\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string("((struct __koral_Control*)")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".control)->weak_count = 1;\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string("((struct __koral_Control*)")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".control)->ptr = ")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".ptr;\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string("((struct __koral_Control*)")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".control)->dtor = ")
        when pointee_type in {
            .StructureType(def_id) then {
                self.codegen.buffer.push_string("(__koral_Dtor)__koral_\(self.codegen.c_name_for_def_id(def_id))_drop;\n")
            },
            .EnumType(def_id) then {
                self.codegen.buffer.push_string("(__koral_Dtor)__koral_\(self.codegen.c_name_for_def_id(def_id))_drop;\n")
            },
            .ReferenceType(_) then {
                self.codegen.buffer.push_string("(__koral_Dtor)__koral_ref_drop;\n")
            },
            .MutableReferenceType(_) then {
                self.codegen.buffer.push_string("(__koral_Dtor)__koral_ref_drop;\n")
            },
            .BorrowedReferenceType(_) then {
                self.codegen.buffer.push_string("(__koral_Dtor)__koral_ref_drop;\n")
            },
            .MutableBorrowedReferenceType(_) then {
                self.codegen.buffer.push_string("(__koral_Dtor)__koral_ref_drop;\n")
            },
            .WeakReferenceType(_) then {
                self.codegen.buffer.push_string("(__koral_Dtor)__koral_weakref_drop;\n")
            },
            .MutableWeakReferenceType(_) then {
                self.codegen.buffer.push_string("(__koral_Dtor)__koral_weakref_drop;\n")
            },
            .FunctionType(_, _) then {
                self.codegen.buffer.push_string("(__koral_Dtor)__koral_closure_drop;\n")
            },
            _ then {
                self.codegen.buffer.push_string("NULL;\n")
            },
        }
        self.codegen.append_copy_or_move_assignment(pointee_type, access.path, "*(\(pointee_c_type)*)\(result).ptr", not should_transfer)
        if should_transfer then {
            self.consume_moved_place(place)
        }
        self.emit_cleanup(access.cleanup)
        return MIRValueEmission(result, self.cleanup_for_temporary_result(result, result_type))
    }

    protected can_transfer_owned_heap_reference(*self, place MIRPlace) Bool = {
        return when place in {
            .Local(local) then self.init_flag(local) is .Some(_) and not self.consumed_locals.contains_key(local.raw_value),
            _ then false,
        }
    }

    protected emit_pointer(*mutable self, place MIRPlace) MIRValueEmission = {
        let access = self.emit_place_access(place)
        let pointer_type = self.type_of_pointer(place)
        let expression = self.codegen.next_temp_with_init(self.codegen.c_type_name(pointer_type), "&\(access.path)")
        self.emit_cleanup(access.cleanup)
        return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, pointer_type))
    }

    protected is_float_cast_source_type(*self, t Type) Bool = {
        let _ = self
        return when t in {
            .Float32Type() then true,
            .Float64Type() then true,
            _ then false,
        }
    }

    protected is_signed_int_cast_target_type(*self, t Type) Bool = {
        let _ = self
        return when t in {
            .Int8Type() then true,
            .Int16Type() then true,
            .Int32Type() then true,
            .Int64Type() then true,
            .IntType() then true,
            _ then false,
        }
    }

    protected is_unsigned_int_cast_target_type(*self, t Type) Bool = {
        let _ = self
        return when t in {
            .UInt8Type() then true,
            .UInt16Type() then true,
            .UInt32Type() then true,
            .UInt64Type() then true,
            .UIntType() then true,
            _ then false,
        }
    }

    protected float_cast_target_bounds(*self, t Type) Option[Pair[String, String]] = {
        let _ = self
        return when t in {
            .Int8Type() then Option[Pair[String, String]].Some(Pair[String, String]("INT8_MIN", "INT8_MAX")),
            .Int16Type() then Option[Pair[String, String]].Some(Pair[String, String]("INT16_MIN", "INT16_MAX")),
            .Int32Type() then Option[Pair[String, String]].Some(Pair[String, String]("INT32_MIN", "INT32_MAX")),
            .Int64Type() then Option[Pair[String, String]].Some(Pair[String, String]("INT64_MIN", "INT64_MAX")),
            .IntType() then Option[Pair[String, String]].Some(Pair[String, String]("INTPTR_MIN", "INTPTR_MAX")),
            .UInt8Type() then Option[Pair[String, String]].Some(Pair[String, String]("0", "UINT8_MAX")),
            .UInt16Type() then Option[Pair[String, String]].Some(Pair[String, String]("0", "UINT16_MAX")),
            .UInt32Type() then Option[Pair[String, String]].Some(Pair[String, String]("0", "UINT32_MAX")),
            .UInt64Type() then Option[Pair[String, String]].Some(Pair[String, String]("0", "UINT64_MAX")),
            .UIntType() then Option[Pair[String, String]].Some(Pair[String, String]("0", "UINTPTR_MAX")),
            _ then Option[Pair[String, String]].None(),
        }
    }

    protected emit_cast_operand(*mutable self, operand MIROperand, target_type Type) MIRValueEmission = {
        let source = self.emit_operand_value(operand)
        let source_type = self.type_of_operand(operand)
        let target_c_type = self.codegen.c_type_name(target_type)
        let expression = if self.is_float_cast_source_type(source_type)
            and (self.is_signed_int_cast_target_type(target_type) or self.is_unsigned_int_cast_target_type(target_type))
        then when self.float_cast_target_bounds(target_type) in {
            .Some(bounds) then {
                let float_value = self.codegen.next_temp_with_init("double", "(double)\(source.expression)")
                self.codegen.add_indent()
                self.codegen.buffer.push_string("if (!(\(float_value) >= (double)\(bounds.first) && \(float_value) <= (double)\(bounds.second))) {\n")
                self.codegen.add_indent()
                self.codegen.buffer.push_string("    __koral_panic_float_cast_overflow();\n")
                self.codegen.add_indent()
                self.codegen.buffer.push_string("}\n")
                yield self.codegen.next_temp_with_init(target_c_type, "(\(target_c_type))\(float_value)")
            },
            .None() then self.codegen.next_temp_with_init(target_c_type, "(\(target_c_type))\(source.expression)"),
        } else self.codegen.next_temp_with_init(target_c_type, "(\(target_c_type))\(source.expression)")
        self.emit_cleanup(source.cleanup)
        return MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, target_type))
    }

    protected emit_intrinsic(*mutable self, node MIRIntrinsic) MIRValueEmission = {
        return when node in {
            .AllocMemory(count, result_type) then {
                let count_emission = self.emit_value_source(*count)
                let element_type = self.pointer_element_type(result_type)
                let expression = self.codegen.next_temp_with_decl(self.codegen.c_type_name(result_type))
                self.codegen.add_indent()
                self.codegen.buffer.push_string(expression)
                self.codegen.buffer.push_string(" = malloc(")
                self.codegen.buffer.push_string(count_emission.expression)
                self.codegen.buffer.push_string(" * sizeof(")
                self.codegen.buffer.push_string(self.codegen.c_type_name(element_type))
                self.codegen.buffer.push_string("));\n")
                self.emit_cleanup(count_emission.cleanup)
                yield MIRValueEmission(expression, Option[* MIRValueCleanup].None())
            },
            .DeallocMemory(pointer) then {
                let p = self.emit_value_source(*pointer)
                self.codegen.add_indent()
                self.codegen.buffer.push_string("free(")
                self.codegen.buffer.push_string(p.expression)
                self.codegen.buffer.push_string(");\n")
                self.emit_cleanup(p.cleanup)
                yield MIRValueEmission("", Option[* MIRValueCleanup].None())
            },
            .CopyMemory(dest, source, count) then self.emit_memory_transfer("memcpy", *dest, *source, *count),
            .MoveMemory(dest, source, count) then self.emit_memory_transfer("memmove", *dest, *source, *count),
            .IsUniqueMutable(value) then self.emit_is_unique(*value),
            .RefCount(value) then self.emit_ref_count(*value),
            .MakeRef(pointer, owner, result_type) then self.emit_make_ref(*pointer, *owner, result_type),
            .MakeMutRef(pointer, owner, result_type) then self.emit_make_ref(*pointer, *owner, result_type),
            .DowngradeRef(value, result_type) then self.emit_downgrade_ref(*value, result_type),
            .DowngradeMutRef(value, result_type) then self.emit_downgrade_ref(*value, result_type),
            .UpgradeRef(value, result_type) then self.emit_upgrade_ref(*value, result_type),
            .UpgradeMutRef(value, result_type) then self.emit_upgrade_ref(*value, result_type),
            .InitMemory(pointer, value) then {
                let p = self.emit_value_source(*pointer)
                let v = self.emit_value_source(*value)
                let element_type = self.pointer_element_type(self.type_of_value(*pointer))
                self.codegen.append_copy_assignment(element_type, v.expression, "*(\(self.codegen.c_type_name(element_type))*)\(p.expression)")
                self.consume_moved_source(*value)
                self.emit_cleanup(p.cleanup)
                self.emit_residual_cleanups(v, true)
                yield MIRValueEmission("", Option[* MIRValueCleanup].None())
            },
            .DeinitMemory(pointer) then {
                let p = self.emit_value_source(*pointer)
                let element_type = self.pointer_element_type(self.type_of_value(*pointer))
                self.codegen.add_indent()
                self.codegen.append_drop_statement(element_type, "*(\(self.codegen.c_type_name(element_type))*)\(p.expression)")
                self.emit_cleanup(p.cleanup)
                yield MIRValueEmission("", Option[* MIRValueCleanup].None())
            },
            .TakeMemory(pointer, result_type) then {
                let p = self.emit_value_source(*pointer)
                let expression = self.codegen.next_temp_with_init(self.codegen.c_type_name(result_type), "*(\(self.codegen.c_type_name(result_type))*)\(p.expression)")
                self.emit_cleanup(p.cleanup)
                yield MIRValueEmission(expression, self.cleanup_for_temporary_result(expression, result_type))
            },
            .NullPtr(result_type) then {
                let expression = self.codegen.next_temp_with_init(self.codegen.c_type_name(result_type), "NULL")
                yield MIRValueEmission(expression, Option[* MIRValueCleanup].None())
            },
            .SpawnThread(out_handle, out_tid, closure, stack_size) then self.emit_spawn_thread(*out_handle, *out_tid, *closure, *stack_size),
        }
    }

    protected emit_lambda(*mutable self, lambda MIRLambda) MIRValueEmission = {
        // Resolve capture sources to C expression paths
        let mutable capture_source_overrides = Dict[UInt, String].new()
        let mutable capture_source_cleanups = List[* MIRValueCleanup].new()
        let mutable ci UInt = 0
        while ci < lambda.captures.count() then {
            let capture = lambda.captures[ci]
            let source = lambda.capture_sources[ci]
            let capture_emission = when capture.symbol_type in {
                .ReferenceType(inner_ref) then if self.type_of_place(source) == *inner_ref
                    then self.emit_heap_reference(source, capture.symbol_type)
                    else {
                        let access = self.emit_place_access(source)
                        yield MIRValueEmission(access.path, access.cleanup)
                    },
                .MutableReferenceType(inner_ref) then if self.type_of_place(source) == *inner_ref
                    then self.emit_borrowed_reference(source, capture.symbol_type)
                    else {
                        let access = self.emit_place_access(source)
                        yield MIRValueEmission(access.path, access.cleanup)
                    },
                _ then {
                    let access = self.emit_place_access(source)
                    yield MIRValueEmission(access.path, access.cleanup)
                },
            }
            capture_source_overrides.insert(capture.def_id.id, capture_emission.expression)
            when capture_emission.cleanup in {
                .Some(cleanup) then capture_source_cleanups.push(cleanup),
                .None() then {},
            }
            ci += 1
        }
        let closure = self.generate_lambda_expression(lambda, capture_source_overrides)
        // Clean up capture source cleanups
        for cleanup_ref in capture_source_cleanups then {
            self.emit_cleanup(Option[* MIRValueCleanup].Some(cleanup_ref))
        }
        return MIRValueEmission(closure, self.cleanup_for_temporary_result(closure, lambda.lambda_type))
    }

    protected generate_lambda_expression(*mutable self, lambda MIRLambda, capture_source_overrides Dict[UInt, String]) String = {
        let lambda_name = self.next_lambda_name()
        // Extract function parameters and return type from lambda_type
        let (function_params, return_type) = when lambda.lambda_type in {
            .FunctionType(params, ret) then (params, *ret),
            _ then (List[* FunctionParamEntry].new(), Type.VoidType()),
        }

        if lambda.captures.is_empty() then {
            // No captures: generate a plain C function
            self.generate_no_capture_lambda_function(lambda_name, lambda.params, function_params, return_type, lambda.function)
            return self.codegen.next_temp_with_init("struct __koral_Closure", "{ .fn = (void*)\(lambda_name), .env = NULL, .drop = NULL }")
        }

        // With captures: generate env struct, capture function, heap-allocate env
        let env_struct_name = "\(lambda_name)_env"
        self.generate_lambda_env_struct(env_struct_name, lambda.captures)
        self.generate_capture_lambda_function(lambda_name, env_struct_name, lambda.params, function_params, return_type, lambda.captures, capture_source_overrides, lambda.function)

        // Heap-allocate env and populate captures
        let env_var = self.codegen.next_temp_with_init("struct \(env_struct_name)*", "(struct \(env_struct_name)*)malloc(sizeof(struct \(env_struct_name)))")
        self.codegen.add_indent()
        self.codegen.buffer.push_string(env_var)
        self.codegen.buffer.push_string("->__refcount = 1;\n")

        let mutable ci UInt = 0
        while ci < lambda.captures.count() then {
            let capture = lambda.captures[ci]
            let field_name = self.capture_field_name(*capture)
            let source = capture_source_overrides.get(capture.def_id.id) or else ""
            let dest = "\(env_var)->\(field_name)"
            when capture.symbol_type in {
                .ReferenceType(inner_ref) then {
                    let pointee_type = *inner_ref
                    let pointee_c_type = self.codegen.c_type_name(pointee_type)
                    let source_ptr = self.codegen.next_temp_with_decl("void*")
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(" = ")
                    self.codegen.buffer.push_string(source)
                    self.codegen.buffer.push_string(";\n")
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("if ((")
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(").control != NULL) {\n")
                    self.codegen.add_indent()
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("__koral_retain((")
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(").control);\n")
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("} else if ((")
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(").ptr != NULL) {\n")
                    self.codegen.add_indent()
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(source_ptr)
                    self.codegen.buffer.push_string(" = (")
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(").ptr;\n")
                    self.codegen.add_indent()
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(".control = malloc(sizeof(struct __koral_Control) + sizeof(")
                    self.codegen.buffer.push_string(pointee_c_type)
                    self.codegen.buffer.push_string("));\n")
                    self.codegen.add_indent()
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(".ptr = (char*)")
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(".control + sizeof(struct __koral_Control);\n")
                    self.codegen.add_indent()
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("((struct __koral_Control*)")
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(".control)->strong_count = 1;\n")
                    self.codegen.add_indent()
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("((struct __koral_Control*)")
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(".control)->weak_count = 1;\n")
                    self.codegen.add_indent()
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("((struct __koral_Control*)")
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(".control)->ptr = ")
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(".ptr;\n")
                    let source_value_expr = when pointee_type in {
                        .StructureType(def_id) then "__koral_\(self.codegen.c_name_for_def_id(def_id))_copy((\(pointee_c_type)*)\(source_ptr))",
                        .EnumType(def_id) then "__koral_\(self.codegen.c_name_for_def_id(def_id))_copy((\(pointee_c_type)*)\(source_ptr))",
                        _ then "*(\(pointee_c_type)*)\(source_ptr)",
                    }
                    self.codegen.append_copy_or_move_assignment(
                        pointee_type,
                        source_value_expr,
                        "*(\(pointee_c_type)*)\(dest).ptr",
                        true,
                    )
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("}\n")
                },
                .MutableReferenceType(inner_ref) then {
                    let _ = inner_ref
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(" = ")
                    self.codegen.buffer.push_string(source)
                    self.codegen.buffer.push_string(";\n")
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("if ((")
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(").control != NULL) {\n")
                    self.codegen.add_indent()
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("__koral_retain((")
                    self.codegen.buffer.push_string(dest)
                    self.codegen.buffer.push_string(").control);\n")
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string("}\n")
                },
                _ then self.codegen.append_copy_or_move_assignment(capture.symbol_type, source, dest, true),
            }
            ci += 1
        }

        return self.codegen.next_temp_with_init("struct __koral_Closure", "{ .fn = (void*)\(lambda_name), .env = \(env_var), .drop = __koral_\(env_struct_name)_drop }")
    }

    protected generate_no_capture_lambda_function(*mutable self, name String, params List[* Symbol], function_params List[* FunctionParamEntry], return_type Type, mir_function * MIRFunction) Void = {
        let plan = build_mir_function_emit_plan(self.codegen, mir_function)
        let mutable parameter_local_names = List[String].new()
        for local in mir_function.locals then {
            if local.storage is .Parameter() and parameter_local_names.count() < params.count() then {
                parameter_local_names.push(plan.local_names_by_id.get(local.id.raw_value) or else plan.local_names[parameter_local_names.count()])
            }
        }
        // Build parameter list
        let mutable param_parts = List[String].new()
        let mutable pi UInt = 0
        while pi < params.count() then {
            let param = params[pi]
            let c_type = if pi < function_params.count() then self.codegen.c_type_name(function_params[pi].param_type) else self.codegen.c_type_name(param.symbol_type)
            let param_name = if pi < parameter_local_names.count() then parameter_local_names[pi] else self.codegen.c_identifier_for_symbol(param)
            param_parts.push("\(c_type) \(param_name)")
            pi += 1
        }
        let param_str = if param_parts.is_empty() then "void" else join_strings(param_parts, ", ")
        let return_c_type = self.codegen.c_type_name(return_type)

        let saved_indent = self.codegen.indent
        self.codegen.indent = "    "
        let mutable body_emitter = MIRFunctionCodeEmitter.new(self.codegen, mir_function, plan)
        let saved_buffer = self.codegen.buffer
        self.codegen.buffer = CodegenBuffer.new()
        let inner_nested = (&mutable body_emitter).emit_body_and_get_nested_definitions()
        let body_text = self.codegen.buffer.into_string()
        self.codegen.buffer = saved_buffer
        self.codegen.indent = saved_indent

        self.nested_definitions.push_string(inner_nested)
        self.nested_definitions.push_string("static \(return_c_type) \(name)(\(param_str)) {\n")
        self.nested_definitions.push_string(body_text)
        self.nested_definitions.push_string("}\n")
    }

    protected generate_capture_lambda_function(*mutable self, name String, env_struct_name String, params List[* Symbol], function_params List[* FunctionParamEntry], return_type Type, captures List[* Symbol], capture_source_overrides Dict[UInt, String], mir_function * MIRFunction) Void = {
        let plan = build_mir_function_emit_plan(self.codegen, mir_function)
        let mutable parameter_local_names = List[String].new()
        for local in mir_function.locals then {
            if local.storage is .Parameter() and parameter_local_names.count() < params.count() then {
                parameter_local_names.push(plan.local_names_by_id.get(local.id.raw_value) or else plan.local_names[parameter_local_names.count()])
            }
        }
        // Build parameter list with void* __env first
        let mutable param_parts = List[String].new()
        param_parts.push("void* __env")
        let mutable pi UInt = 0
        while pi < params.count() then {
            let param = params[pi]
            let c_type = if pi < function_params.count() then self.codegen.c_type_name(function_params[pi].param_type) else self.codegen.c_type_name(param.symbol_type)
            let param_name = if pi < parameter_local_names.count() then parameter_local_names[pi] else self.codegen.c_identifier_for_symbol(param)
            param_parts.push("\(c_type) \(param_name)")
            pi += 1
        }
        let param_str = join_strings(param_parts, ", ")
        let return_c_type = self.codegen.c_type_name(return_type)

        let saved_indent = self.codegen.indent
        self.codegen.indent = "    "
        let mutable body_emitter = MIRFunctionCodeEmitter.new(self.codegen, mir_function, plan)
        let saved_buffer = self.codegen.buffer
        self.codegen.buffer = CodegenBuffer.new()
        // Override local names for captured variables
        for capture in captures then {
            let capture_name = "__captured->\(self.capture_field_name(*capture))"
            for local in mir_function.locals then {
                when local.symbol in {
                    .Some(symbol) then {
                        if symbol.def_id.id == capture.def_id.id and local.storage is .Capture() then {
                            body_emitter.local_names_by_id.insert(local.id.raw_value, capture_name)
                        }
                    },
                    .None() then {},
                }
            }
        }
        let inner_nested = (&mutable body_emitter).emit_body_and_get_nested_definitions()
        let body_text = self.codegen.buffer.into_string()
        self.codegen.buffer = saved_buffer
        self.codegen.indent = saved_indent

        self.nested_definitions.push_string(inner_nested)
        self.nested_definitions.push_string("static \(return_c_type) \(name)(\(param_str)) {\n")
        self.nested_definitions.push_string("    struct \(env_struct_name)* __captured = (struct \(env_struct_name)*)__env;\n")
        self.nested_definitions.push_string(body_text)
        self.nested_definitions.push_string("}\n")
    }

    protected generate_lambda_env_struct(*mutable self, env_struct_name String, captures List[* Symbol]) Void = {
        // Generate env struct definition
        self.nested_definitions.push_string("struct \(env_struct_name) {\n")
        self.nested_definitions.push_string("    _Atomic intptr_t __refcount;\n")
        for capture in captures then {
            let field_name = self.capture_field_name(*capture)
            let c_type = self.codegen.c_type_name(capture.symbol_type)
            self.nested_definitions.push_string("    \(c_type) \(field_name);\n")
        }
        self.nested_definitions.push_string("};\n")

        // Generate drop function
        self.nested_definitions.push_string("static void __koral_\(env_struct_name)_drop(void* raw_env) {\n")
        self.nested_definitions.push_string("    struct \(env_struct_name)* env = (struct \(env_struct_name)*)raw_env;\n")
        for capture in captures then {
            let field_name = self.capture_field_name(*capture)
            if self.codegen.needs_drop(capture.symbol_type) then {
                let saved_buffer = self.codegen.buffer
                self.codegen.buffer = CodegenBuffer.new()
                self.codegen.add_indent()
                self.codegen.append_drop_statement(capture.symbol_type, "env->\(field_name)")
                self.nested_definitions.push_string(self.codegen.buffer.into_string())
                self.codegen.buffer = saved_buffer
            }
        }
        self.nested_definitions.push_string("    free(raw_env);\n")
        self.nested_definitions.push_string("}\n")
    }

    protected emit_place_access(*mutable self, place MIRPlace) MIRPlaceAccess = {
        return when place in {
            .Local(local) then {
                let name = self.local_name(local)
                yield MIRPlaceAccess(name, self.control_expression(self.type_of_place(place), name), Option[* MIRValueCleanup].None())
            },
            .Global(def_id) then {
                let name = when self.codegen.context.get_symbol(def_id) in {
                    .Some(symbol) then self.codegen.c_identifier_for_symbol_value(symbol),
                    .None() then self.codegen.c_identifier_opt(def_id) or else self.codegen.sanitize_codegen_identifier(self.context_name(def_id)),
                }
                yield MIRPlaceAccess(name, self.control_expression(self.type_of_place(place), name), Option[* MIRValueCleanup].None())
            },
            .Field(base, field) then {
                let base_access = self.emit_place_access(*base)
                let field_name = self.codegen.sanitize_codegen_identifier(self.codegen.context.symbol_name(*field))
                let path = when self.type_of_place(*base) in {
                    .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner) or .MutableBorrowedReferenceType(inner) or .WeakReferenceType(inner) or .MutableWeakReferenceType(inner) then {
                        let mutable path = String.new()
                        path.push_string("(*(")
                        path.push_string(self.codegen.c_type_name(*inner))
                        path.push_string("*)")
                        path.push_string(base_access.path)
                        path.push_string(".ptr).")
                        path.push_string(field_name)
                        yield path
                    },
                    _ then {
                        let mutable path = String.new()
                        path.push_string(base_access.path)
                        path.push_string(".")
                        path.push_string(field_name)
                        yield path
                    },
                }
                yield MIRPlaceAccess(path, base_access.control, base_access.cleanup)
            },
            .EnumPayload(base, case_name, field_name, _, _) then {
                let base_access = self.emit_place_access(*base)
                let payload_base = when self.type_of_place(*base) in {
                    .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner) or .MutableBorrowedReferenceType(inner) or .WeakReferenceType(inner) or .MutableWeakReferenceType(inner) then {
                        let mutable payload_base = String.new()
                        payload_base.push_string("(*(")
                        payload_base.push_string(self.codegen.c_type_name(*inner))
                        payload_base.push_string("*)")
                        payload_base.push_string(base_access.path)
                        payload_base.push_string(".ptr)")
                        yield payload_base
                    },
                    _ then base_access.path,
                }
                let mutable path = String.new()
                path.push_string(payload_base)
                path.push_string(".data.")
                path.push_string(self.codegen.sanitize_codegen_identifier(case_name))
                path.push_string(".")
                path.push_string(self.codegen.sanitize_codegen_identifier(field_name))
                yield MIRPlaceAccess(path, base_access.control, base_access.cleanup)
            },
            .Deref(base, pointee) then {
                let base_emission = self.emit_value_source(*base)
                let base_type = self.type_of_value(*base)
                yield when base_type in {
                    .ReferenceType(_) or .MutableReferenceType(_) or .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) then {
                        when self.trait_object_target_name(pointee) in {
                            .Some(_) then {
                                let mutable control = String.new()
                                control.push_string(base_emission.expression)
                                control.push_string(".control")
                                yield MIRPlaceAccess(base_emission.expression, control, base_emission.cleanup)
                            },
                            .None() then {},
                        }
                        let mutable path = String.new()
                        path.push_string("(*(")
                        path.push_string(self.codegen.c_type_name(pointee))
                        path.push_string("*)")
                        path.push_string(base_emission.expression)
                        path.push_string(".ptr)")
                        let mutable control = String.new()
                        control.push_string(base_emission.expression)
                        control.push_string(".control")
                        yield MIRPlaceAccess(path, control, base_emission.cleanup)
                    },
                    _ then {
                        let mutable path = String.new()
                        path.push_string("(*(")
                        path.push_string(self.codegen.c_type_name(pointee))
                        path.push_string("*)")
                        path.push_string(base_emission.expression)
                        path.push_string(")")
                        yield MIRPlaceAccess(path, "NULL", base_emission.cleanup)
                    },
                }
            },
            .PointerElement(base, element) then {
                let base_emission = self.emit_value_source(*base)
                let mutable path = String.new()
                path.push_string("(*(")
                path.push_string(self.codegen.c_type_name(element))
                path.push_string("*)")
                path.push_string(base_emission.expression)
                path.push_string(")")
                yield MIRPlaceAccess(path, "NULL", base_emission.cleanup)
            },
        }
    }

    protected type_of_place(*self, place MIRPlace) Type = {
        return when place in {
            .Local(local) then when self.local_info(local) in { .Some(info) then info.local_type, .None() then Type.Unknown() },
            .Global(def_id) then self.codegen.context.get_symbol_type(def_id) or else Type.Unknown(),
            .Field(_, field) then field.symbol_type,
            .EnumPayload(_, _, _, _, field_type) then field_type,
            .Deref(_, pointee) then pointee,
            .PointerElement(_, element) then element,
        }
    }

    protected type_of_value(*self, value MIRValue) Type = {
        return when value in {
            .Operand(operand) then self.type_of_operand(operand),
            .PlaceRead(place, _) then self.type_of_place(place),
            .Binary(operation) then operation.result_type,
            .Unary(operation) then operation.result_type,
            .Call(call) then call.result_type,
            .Aggregate(aggregate) then aggregate.aggregate_type,
            .EnumCase(construction) then construction.enum_type,
            .EnumTag(_) then Type.IntType(),
            .TraitObjectConversion(conversion) then conversion.result_type,
            .TraitMethodCall(call) then call.result_type,
            .Ref(place, kind, _) then self.type_of_ref(place, kind),
            .Pointer(place) then self.type_of_pointer(place),
            .Cast(_, target_type) then target_type,
            .Intrinsic(node) then self.type_of_intrinsic(node),
            .Lambda(lambda) then lambda.lambda_type,
        }
    }

    protected type_of_operand(*self, operand MIROperand) Type = {
        return when operand in {
            .Local(local) then when self.local_info(local) in { .Some(info) then info.local_type, .None() then Type.Unknown() },
            .Function(symbol) then symbol.symbol_type,
            .Constant(constant) then when constant in {
                .Integer(_, t) then t,
                .Float(_, t) then t,
                .StringLiteral(_, t) then t,
                .Boolean(_) then Type.BoolType(),
                .Void() then Type.VoidType(),
            },
        }
    }

    protected type_of_ref(*self, place MIRPlace, kind MIRReferenceKind) Type = {
        let inner = self.type_of_place(place)
        return when kind in {
            .Mutable() then Type.MutableReferenceType(box(inner)),
            .Weak() then Type.WeakReferenceType(box(inner)),
            .MutableWeak() then Type.MutableWeakReferenceType(box(inner)),
            .Shared() then Type.ReferenceType(box(inner)),
        }
    }

    protected type_of_pointer(*self, place MIRPlace) Type = Type.PointerType(box(self.type_of_place(place)))

    protected type_of_intrinsic(*self, node MIRIntrinsic) Type = {
        return when node in {
            .AllocMemory(_, result_type) then result_type,
            .IsUniqueMutable(_) then Type.BoolType(),
            .RefCount(_) then Type.UIntType(),
            .MakeRef(_, _, result_type) then result_type,
            .MakeMutRef(_, _, result_type) then result_type,
            .DowngradeRef(_, result_type) then result_type,
            .DowngradeMutRef(_, result_type) then result_type,
            .UpgradeRef(_, result_type) then result_type,
            .UpgradeMutRef(_, result_type) then result_type,
            .TakeMemory(_, result_type) then result_type,
            .NullPtr(result_type) then result_type,
            .SpawnThread(_, _, _, _) then Type.Int32Type(),
            _ then Type.VoidType(),
        }
    }

    protected local_target_id(*self, place MIRPlace) Option[MIRLocalID] = when place in { .Local(local) then Option[MIRLocalID].Some(local), _ then Option[MIRLocalID].None() }
    protected local_id_from_operand(*self, operand MIROperand) Option[MIRLocalID] = when operand in { .Local(local) then Option[MIRLocalID].Some(local), _ then Option[MIRLocalID].None() }
    protected local_name(*self, local MIRLocalID) String = self.local_names_by_id.get(local.raw_value) or else "__mir_local_\(local.raw_value)"
    protected block_label(*self, block MIRBlockID) String = "__mir_bb_\(block.raw_value)"

    protected is_parameter_operand(*self, operand MIROperand) Bool = {
        return when operand in {
            .Local(local) then when self.local_info(local) in {
                .Some(info) then info.storage is .Parameter(),
                .None() then false,
            },
            _ then false,
        }
    }

    protected root_local_of_place(*self, place MIRPlace) Option[MIRLocalID] = {
        return when place in {
            .Local(local) then Option[MIRLocalID].Some(local),
            .Field(base, _) then self.root_local_of_place(*base),
            .EnumPayload(base, _, _, _, _) then self.root_local_of_place(*base),
            _ then Option[MIRLocalID].None(),
        }
    }

    protected consume_moved_place(*mutable self, place MIRPlace) Void = {
        when self.root_local_of_place(place) in {
            .Some(local) then {
                self.set_init_flag(local, false)
                self.consumed_locals.insert(local.raw_value, true)
            },
            .None() then {},
        }
    }

    protected consume_moved_source(*mutable self, value MIRValue) Void = {
        when value in {
            .Operand(.Local(local)) then self.set_init_flag(local, false),
            .PlaceRead(place, ownership) then {
                if ownership is .Move() then {
                    self.consume_moved_place(place)
                }
            },
            // Heap-owned ref values already decide whether ownership transfer is
            // allowed inside emit_heap_reference(). Consuming again here would
            // incorrectly treat field/member-path boxing as moving the root local.
            .Ref(_, _, _) then {},
            _ then {},
        }
    }

    protected next_lambda_name(*mutable self) String = {
        let name = "__koral_lambda_\(self.function.identifier.def_id.id)_\(self.lambda_counter)"
        self.lambda_counter += 1
        return name
    }

    protected capture_field_name(*self, symbol Symbol) String = {
        return self.codegen.c_identifier_for_symbol_value(symbol)
    }

    protected should_copy_returned_operand(*self, operand MIROperand, operand_type Type) Bool = {
        if not self.codegen.needs_drop(operand_type) then { return false }
        return when operand in {
            .Local(local) then when self.local_info(local) in {
                .Some(info) then if info.storage is .Capture()
                    then true
                    else self.non_owning_local_ids.get(local.raw_value) is .Some(_),
                .None() then false,
            },
            _ then false,
        }
    }

    protected set_init_flag(*mutable self, local MIRLocalID, value Bool) Void = {
        when self.init_flag(local) in {
            .Some(flag) then {
                self.codegen.add_indent()
                self.codegen.buffer.push_string(flag)
                self.codegen.buffer.push_string(" = ")
                self.codegen.buffer.push_string(if value then "1" else "0")
                self.codegen.buffer.push_string(";\n")
            },
            .None() then {},
        }
    }

    protected cleanup_for_temporary_result(*self, expression String, cleanup_type Type) Option[* MIRValueCleanup] = {
        if not expression.is_empty() and self.codegen.needs_drop(cleanup_type) then {
            return Option[* MIRValueCleanup].Some(box(MIRValueCleanup(expression, cleanup_type)))
        }
        return Option[* MIRValueCleanup].None()
    }

    protected emit_cleanup(*mutable self, cleanup Option[* MIRValueCleanup]) Void = {
        when cleanup in {
            .Some(item) then {
                self.codegen.add_indent()
                self.codegen.append_drop_statement(item.cleanup_type, item.name)
            },
            .None() then {},
        }
    }

    protected emit_residual_cleanups(*mutable self, emission MIRValueEmission, consumed Bool) Void = {
        when emission.cleanup in {
            .Some(cleanup) then {
                if consumed and cleanup.name == emission.expression then {
                    return
                }
                self.codegen.add_indent()
                self.codegen.append_drop_statement(cleanup.cleanup_type, cleanup.name)
            },
            .None() then {},
        }
    }

    protected control_expression(*self, value_type Type, value String) String = {
        return when value_type in {
            .ReferenceType(_) or .MutableReferenceType(_) or .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) or .WeakReferenceType(_) or .MutableWeakReferenceType(_) or .TraitObject(_, _) then {
                let mutable control = String.new()
                control.push_string(value)
                control.push_string(".control")
                yield control
            },
            _ then "NULL",
        }
    }

    protected context_name(*self, def_id DefId) String = self.codegen.context.get_name(def_id) or else "global_\(def_id.id)"

    protected switch_case_expression(*mutable self, constant MIRConstant) String = self.constant_expression(constant)

    protected enum_case_info(*self, enum_type Type, case_name String) Pair[UInt, List[EnumCaseParam]] = {
        let def_id = when enum_type in {
            .EnumType(id) then id,
            .GenericEnum(template, _) then self.codegen.find_type_def_id_by_layout_or_template(enum_type, template) or else DefId(0(UInt)),
            _ then DefId(0(UInt)),
        }
        when self.codegen.context.get_enum_cases(def_id) in {
            .Some(cases) then {
                let mutable index UInt = 0
                for c in cases then {
                    if c.name == case_name then { return Pair[UInt, List[EnumCaseParam]](index, c.params) }
                    index += 1
                }
            },
            .None() then {},
        }
        return Pair[UInt, List[EnumCaseParam]](0(UInt), List[EnumCaseParam].new())
    }

    protected type_list_to_ref_list(*self, args List[Type]) List[* Type] = {
        let _ = self
        let mutable out = List[* Type].new()
        for arg in args then { out.push(box(arg)) }
        return out
    }

    protected pointer_element_type(*self, pointer_type Type) Type = when pointer_type in { .PointerType(inner) then *inner, .MutablePointerType(inner) then *inner, _ then Type.VoidType() }

    protected emit_memory_transfer(*mutable self, function_name String, dest MIRValue, source MIRValue, count MIRValue) MIRValueEmission = {
        let d = self.emit_value_source(dest)
        let s = self.emit_value_source(source)
        let c = self.emit_value_source(count)
        let element_type = self.pointer_element_type(self.type_of_value(dest))
        self.codegen.add_indent()
        self.codegen.buffer.push_string(function_name)
        self.codegen.buffer.push_string("(")
        self.codegen.buffer.push_string(d.expression)
        self.codegen.buffer.push_string(", ")
        self.codegen.buffer.push_string(s.expression)
        self.codegen.buffer.push_string(", ")
        self.codegen.buffer.push_string(c.expression)
        self.codegen.buffer.push_string(" * sizeof(")
        self.codegen.buffer.push_string(self.codegen.c_type_name(element_type))
        self.codegen.buffer.push_string("));\n")
        self.emit_cleanup(d.cleanup)
        self.emit_cleanup(s.cleanup)
        self.emit_cleanup(c.cleanup)
        return MIRValueEmission("", Option[* MIRValueCleanup].None())
    }

    protected emit_is_unique(*mutable self, value MIRValue) MIRValueEmission = {
        let emission = self.emit_value_source(value)
        let result = self.codegen.next_temp_with_decl("int")
        let value_type = self.type_of_value(value)
        let control = when value_type in {
            .MutablePointerType(_) or .PointerType(_) then "((struct __koral_Ref*)\(emission.expression))->control",
            _ then self.control_expression(value_type, emission.expression),
        }
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(" = 0;\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string("if (")
        self.codegen.buffer.push_string(control)
        self.codegen.buffer.push_string(") { ")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(" = (atomic_load(&((struct __koral_Control*)")
        self.codegen.buffer.push_string(control)
        self.codegen.buffer.push_string(")->strong_count) == 1); }\n")
        self.emit_cleanup(emission.cleanup)
        return MIRValueEmission(result, Option[* MIRValueCleanup].None())
    }

    protected emit_ref_count(*mutable self, value MIRValue) MIRValueEmission = {
        let emission = self.emit_value_source(value)
        let result = self.codegen.next_temp_with_decl(self.codegen.c_type_name(Type.UIntType()))
        let value_type = self.type_of_value(value)
        let control = when value_type in {
            .MutablePointerType(_) or .PointerType(_) then "((struct __koral_Ref*)\(emission.expression))->control",
            _ then self.control_expression(value_type, emission.expression),
        }
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(" = 0;\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string("if (")
        self.codegen.buffer.push_string(control)
        self.codegen.buffer.push_string(") { ")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(" = (")
        self.codegen.buffer.push_string(self.codegen.c_type_name(Type.UIntType()))
        self.codegen.buffer.push_string(")atomic_load(&((struct __koral_Control*)")
        self.codegen.buffer.push_string(control)
        self.codegen.buffer.push_string(")->strong_count); }\n")
        self.emit_cleanup(emission.cleanup)
        return MIRValueEmission(result, Option[* MIRValueCleanup].None())
    }

    protected emit_make_ref(*mutable self, pointer MIRValue, owner MIRValue, result_type Type) MIRValueEmission = {
        let p = self.emit_value_source(pointer)
        let o = self.emit_value_source(owner)
        let result = self.codegen.next_temp_with_decl(self.codegen.c_type_name(result_type))
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".ptr = (void*)")
        self.codegen.buffer.push_string(p.expression)
        self.codegen.buffer.push_string(";\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".control = ")
        self.codegen.buffer.push_string(o.expression)
        self.codegen.buffer.push_string(".control;\n")
        self.codegen.add_indent()
        self.codegen.buffer.push_string("if (")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".control) { __koral_retain(")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".control); }\n")
        self.emit_cleanup(p.cleanup)
        self.emit_cleanup(o.cleanup)
        return MIRValueEmission(result, self.cleanup_for_temporary_result(result, result_type))
    }

    protected emit_runtime_unary_ref(*mutable self, function_name String, value MIRValue, result_type Type) MIRValueEmission = {
        let emission = self.emit_value_source(value)
        let result = self.codegen.next_temp_with_init(self.codegen.c_type_name(result_type), "\(function_name)(\(emission.expression))")
        self.emit_cleanup(emission.cleanup)
        return MIRValueEmission(result, self.cleanup_for_temporary_result(result, result_type))
    }

    protected emit_downgrade_ref(*mutable self, value MIRValue, result_type Type) MIRValueEmission = {
        let emission = self.emit_value_source(value)
        return when self.type_of_value(value) in {
            .ReferenceType(inner) then if *inner is .TraitObject(_, _) then {
                let result = self.codegen.next_temp_with_decl("struct __koral_TraitWeakRef")
                let weak_temp = self.codegen.next_temp_with_decl("struct __koral_WeakRef")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(weak_temp)
                self.codegen.buffer.push_string(" = __koral_downgrade_ref((struct __koral_Ref){")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".ptr, ")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".control});\n")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(result)
                self.codegen.buffer.push_string(".control = ")
                self.codegen.buffer.push_string(weak_temp)
                self.codegen.buffer.push_string(".control;\n")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(result)
                self.codegen.buffer.push_string(".vtable = ")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".vtable;\n")
                self.emit_cleanup(emission.cleanup)
                yield MIRValueEmission(result, self.cleanup_for_temporary_result(result, result_type))
            } else self.emit_runtime_unary_ref_from_emission("__koral_downgrade_ref", emission, result_type),
            .MutableReferenceType(inner) then if *inner is .TraitObject(_, _) then {
                let result = self.codegen.next_temp_with_decl("struct __koral_TraitWeakRef")
                let weak_temp = self.codegen.next_temp_with_decl("struct __koral_WeakRef")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(weak_temp)
                self.codegen.buffer.push_string(" = __koral_downgrade_ref((struct __koral_Ref){")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".ptr, ")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".control});\n")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(result)
                self.codegen.buffer.push_string(".control = ")
                self.codegen.buffer.push_string(weak_temp)
                self.codegen.buffer.push_string(".control;\n")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(result)
                self.codegen.buffer.push_string(".vtable = ")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".vtable;\n")
                self.emit_cleanup(emission.cleanup)
                yield MIRValueEmission(result, self.cleanup_for_temporary_result(result, result_type))
            } else self.emit_runtime_unary_ref_from_emission("__koral_downgrade_ref", emission, result_type),
            .BorrowedReferenceType(inner) then if *inner is .TraitObject(_, _) then {
                let result = self.codegen.next_temp_with_decl("struct __koral_TraitWeakRef")
                let weak_temp = self.codegen.next_temp_with_decl("struct __koral_WeakRef")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(weak_temp)
                self.codegen.buffer.push_string(" = __koral_downgrade_ref((struct __koral_Ref){")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".ptr, ")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".control});\n")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(result)
                self.codegen.buffer.push_string(".control = ")
                self.codegen.buffer.push_string(weak_temp)
                self.codegen.buffer.push_string(".control;\n")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(result)
                self.codegen.buffer.push_string(".vtable = ")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".vtable;\n")
                self.emit_cleanup(emission.cleanup)
                yield MIRValueEmission(result, self.cleanup_for_temporary_result(result, result_type))
            } else self.emit_runtime_unary_ref_from_emission("__koral_downgrade_ref", emission, result_type),
            .MutableBorrowedReferenceType(inner) then if *inner is .TraitObject(_, _) then {
                let result = self.codegen.next_temp_with_decl("struct __koral_TraitWeakRef")
                let weak_temp = self.codegen.next_temp_with_decl("struct __koral_WeakRef")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(weak_temp)
                self.codegen.buffer.push_string(" = __koral_downgrade_ref((struct __koral_Ref){")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".ptr, ")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".control});\n")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(result)
                self.codegen.buffer.push_string(".control = ")
                self.codegen.buffer.push_string(weak_temp)
                self.codegen.buffer.push_string(".control;\n")
                self.codegen.add_indent()
                self.codegen.buffer.push_string(result)
                self.codegen.buffer.push_string(".vtable = ")
                self.codegen.buffer.push_string(emission.expression)
                self.codegen.buffer.push_string(".vtable;\n")
                self.emit_cleanup(emission.cleanup)
                yield MIRValueEmission(result, self.cleanup_for_temporary_result(result, result_type))
            } else self.emit_runtime_unary_ref_from_emission("__koral_downgrade_ref", emission, result_type),
            _ then self.emit_runtime_unary_ref_from_emission("__koral_downgrade_ref", emission, result_type),
        }
    }

    protected emit_runtime_unary_ref_from_emission(
        *mutable self,
        function_name String,
        emission MIRValueEmission,
        result_type Type,
    ) MIRValueEmission = {
        let result = self.codegen.next_temp_with_init(self.codegen.c_type_name(result_type), "\(function_name)(\(emission.expression))")
        self.emit_cleanup(emission.cleanup)
        return MIRValueEmission(result, self.cleanup_for_temporary_result(result, result_type))
    }

    protected emit_upgrade_ref(*mutable self, value MIRValue, result_type Type) MIRValueEmission = {
        let emission = self.emit_value_source(value)
        let success = self.codegen.next_temp_with_decl("int")
        return when self.type_of_value(value) in {
            .WeakReferenceType(inner) then if *inner is .TraitObject(_, _) then {
                let upgraded = self.codegen.next_temp_with_init("struct __koral_Ref", "__koral_upgrade_ref((struct __koral_WeakRef){\(emission.expression).control}, &\(success))")
                let result = self.codegen.next_temp_with_decl(self.codegen.c_type_name(result_type))
                self.codegen.add_indent()
                self.codegen.buffer.push_string("if (")
                self.codegen.buffer.push_string(success)
                self.codegen.buffer.push_string(") {\n")
                self.codegen.with_indent(() -> {
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(result)
                    self.codegen.buffer.push_string(".tag = 1;\n")
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(result)
                    self.codegen.buffer.push_string(".data.Some.value.ptr = ")
                    self.codegen.buffer.push_string(upgraded)
                    self.codegen.buffer.push_string(".ptr;\n")
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(result)
                    self.codegen.buffer.push_string(".data.Some.value.control = ")
                    self.codegen.buffer.push_string(upgraded)
                    self.codegen.buffer.push_string(".control;\n")
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(result)
                    self.codegen.buffer.push_string(".data.Some.value.vtable = ")
                    self.codegen.buffer.push_string(emission.expression)
                    self.codegen.buffer.push_string(".vtable;\n")
                })
                self.codegen.add_indent()
                self.codegen.buffer.push_string("} else {\n")
                self.codegen.with_indent(() -> {
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(result)
                    self.codegen.buffer.push_string(".tag = 0;\n")
                })
                self.codegen.add_indent()
                self.codegen.buffer.push_string("}\n")
                self.emit_cleanup(emission.cleanup)
                yield MIRValueEmission(result, self.cleanup_for_temporary_result(result, result_type))
            } else self.emit_plain_upgrade_ref(emission, success, result_type),
            .MutableWeakReferenceType(inner) then if *inner is .TraitObject(_, _) then {
                let upgraded = self.codegen.next_temp_with_init("struct __koral_Ref", "__koral_upgrade_ref((struct __koral_WeakRef){\(emission.expression).control}, &\(success))")
                let result = self.codegen.next_temp_with_decl(self.codegen.c_type_name(result_type))
                self.codegen.add_indent()
                self.codegen.buffer.push_string("if (")
                self.codegen.buffer.push_string(success)
                self.codegen.buffer.push_string(") {\n")
                self.codegen.with_indent(() -> {
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(result)
                    self.codegen.buffer.push_string(".tag = 1;\n")
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(result)
                    self.codegen.buffer.push_string(".data.Some.value.ptr = ")
                    self.codegen.buffer.push_string(upgraded)
                    self.codegen.buffer.push_string(".ptr;\n")
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(result)
                    self.codegen.buffer.push_string(".data.Some.value.control = ")
                    self.codegen.buffer.push_string(upgraded)
                    self.codegen.buffer.push_string(".control;\n")
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(result)
                    self.codegen.buffer.push_string(".data.Some.value.vtable = ")
                    self.codegen.buffer.push_string(emission.expression)
                    self.codegen.buffer.push_string(".vtable;\n")
                })
                self.codegen.add_indent()
                self.codegen.buffer.push_string("} else {\n")
                self.codegen.with_indent(() -> {
                    self.codegen.add_indent()
                    self.codegen.buffer.push_string(result)
                    self.codegen.buffer.push_string(".tag = 0;\n")
                })
                self.codegen.add_indent()
                self.codegen.buffer.push_string("}\n")
                self.emit_cleanup(emission.cleanup)
                yield MIRValueEmission(result, self.cleanup_for_temporary_result(result, result_type))
            } else self.emit_plain_upgrade_ref(emission, success, result_type),
            _ then self.emit_plain_upgrade_ref(emission, success, result_type),
        }
    }

    protected emit_plain_upgrade_ref(
        *mutable self,
        emission MIRValueEmission,
        success String,
        result_type Type,
    ) MIRValueEmission = {
        let upgraded = self.codegen.next_temp_with_init("struct __koral_Ref", "__koral_upgrade_ref(\(emission.expression), &\(success))")
        let result = self.codegen.next_temp_with_decl(self.codegen.c_type_name(result_type))
        self.codegen.add_indent()
        self.codegen.buffer.push_string("if (")
        self.codegen.buffer.push_string(success)
        self.codegen.buffer.push_string(") { ")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".tag = 1; ")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".data.Some.value = ")
        self.codegen.buffer.push_string(upgraded)
        self.codegen.buffer.push_string("; } else { ")
        self.codegen.buffer.push_string(result)
        self.codegen.buffer.push_string(".tag = 0; }\n")
        self.emit_cleanup(emission.cleanup)
        return MIRValueEmission(result, self.cleanup_for_temporary_result(result, result_type))
    }

    protected emit_spawn_thread(*mutable self, out_handle MIRValue, out_tid MIRValue, closure MIRValue, stack_size MIRValue) MIRValueEmission = {
        let h = self.emit_value_source(out_handle)
        let t = self.emit_value_source(out_tid)
        let c = self.emit_value_source(closure)
        let s = self.emit_value_source(stack_size)
        let result = self.codegen.next_temp_with_init("int32_t", "__koral_spawn_thread(\(h.expression), \(t.expression), \(c.expression), \(s.expression))")
        self.emit_cleanup(h.cleanup)
        self.emit_cleanup(t.cleanup)
        self.emit_cleanup(c.cleanup)
        self.emit_cleanup(s.cleanup)
        return MIRValueEmission(result, Option[* MIRValueCleanup].None())
    }
}

private let join_strings(values List[String], separator String) String = {
    let mutable out = String.new()
    let mutable first = true
    for value in values then {
        if not first then { out.push_string(separator) }
        out.push_string(value)
        first = false
    }
    return out
}

private let build_mir_lifetime_plan(function * MIRFunction, codegen * CodeGen, tracked_init_locals Dict[UInt, Bool]) * MIRLocalLifetimePlan = {
    let mutable tracked_drop_local_ids = Dict[UInt, Bool].new()
    let mutable has_tracked_drop_locals = false
    for local in function.locals then {
        let has_init_flag = tracked_init_locals.get(local.id.raw_value) or else false
        if has_init_flag then {
            tracked_drop_local_ids.insert(local.id.raw_value, true)
            has_tracked_drop_locals = true
        }
    }

    // If no local in the function needs init/drop tracking, the full scope/use
    // analysis below only burns transient Dict/List/Set allocations. In that
    // case we can conservatively hoist declarations and skip the analysis.
    if not has_tracked_drop_locals then {
        let mutable hoisted_declaration_locals = List[MIRLocalID].new()
        for local in function.locals then {
            if local.storage is not .Parameter() and local.storage is not .Capture() and not codegen.type_is_void_or_never(local.local_type) then {
                hoisted_declaration_locals.push(local.id)
            }
        }
        return box(MIRLocalLifetimePlan(
            List[MIRLocalID].new(),
            Dict[UInt, List[MIRLocalID]].new(),
            hoisted_declaration_locals,
            Dict[UInt, List[MIRLocalID]].new(),
            Dict[UInt, Bool].new()
        ))
    }

    let mutable root_locals = List[MIRLocalID].new()
    let mutable locals_by_scope = Dict[UInt, List[MIRLocalID]].new()
    let mutable hoisted_declaration_locals = List[MIRLocalID].new()
    let mutable block_local_declarations_by_block = Dict[UInt, List[MIRLocalID]].new()
    let mutable block_local_declaration_locals = Dict[UInt, Bool].new()
    let mutable parent_scope_by_scope = Dict[UInt, MIRScopeID].new()
    let mutable declared_scope_by_local = Dict[UInt, MIRScopeID].new()
    let mutable active_scopes = List[MIRScopeID].new()
    let mutable declared_block_by_local = Dict[UInt, MIRBlockID].new()
    let mutable shared_use_scope_by_local = Dict[UInt, MIRScopeID].new()
    let mutable first_use_block_by_local = Dict[UInt, UInt].new()
    let mutable multiple_use_blocks_by_local = Dict[UInt, Bool].new()
    for block in function.blocks then {
        for statement in block.statements then {
            when statement in {
                .ScopeEnter(scope) then {
                    if not active_scopes.is_empty() then {
                        parent_scope_by_scope.insert(scope.raw_value, active_scopes[active_scopes.count() - 1(UInt)])
                    }
                    active_scopes.push(scope)
                },
                .ScopeExit(scope) then {
                    let mutable idx = active_scopes.count()
                    while idx > 0 then {
                        idx -= 1
                        if active_scopes[idx].raw_value == scope.raw_value then {
                            active_scopes.remove_at(idx)
                            break
                        }
                    }
                },
                .Declare(local_id) then {
                    if declared_block_by_local.get(local_id.raw_value) is .None() then {
                        declared_block_by_local.insert(local_id.raw_value, block.id)
                    }
                    if not active_scopes.is_empty() then {
                        declared_scope_by_local.insert(local_id.raw_value, active_scopes[active_scopes.count() - 1(UInt)])
                    }
                    mir_record_local_use(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, local_id, block.id, &mutable active_scopes)
                },
                .Assign(place, value) then {
                    mir_walk_place_uses(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, place, block.id, &mutable active_scopes)
                    mir_walk_value_uses(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, value, block.id, &mutable active_scopes)
                },
                .CompoundAssign(assignment) then {
                    mir_walk_place_uses(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, assignment.target, block.id, &mutable active_scopes)
                    mir_walk_value_uses(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, assignment.value, block.id, &mutable active_scopes)
                },
                .Drop(place) then mir_walk_place_uses(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, place, block.id, &mutable active_scopes),
                .Retain(value) then mir_walk_value_uses(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, value, block.id, &mutable active_scopes),
                .Release(value) then mir_walk_value_uses(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, value, block.id, &mutable active_scopes),
                .Evaluate(value) then mir_walk_value_uses(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, value, block.id, &mutable active_scopes),
                .DebugSource(_) then {},
            }
        }
        when block.terminator in {
            .Branch(condition, _, _) then mir_walk_operand_uses(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, condition, block.id, &mutable active_scopes),
            .SwitchValue(operand, _, _) then mir_walk_operand_uses(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, operand, block.id, &mutable active_scopes),
            .ReturnValue(operand) then when operand in {
                .Some(op) then mir_walk_operand_uses(&mutable shared_use_scope_by_local, &mutable first_use_block_by_local, &mutable multiple_use_blocks_by_local, &mutable tracked_drop_local_ids, &mutable parent_scope_by_scope, op, block.id, &mutable active_scopes),
                .None() then {},
            },
            _ then {},
        }
    }
    for local in function.locals then {
        when tracked_drop_local_ids.get(local.id.raw_value) in {
            .Some(_) then {
            let mutable scope = when declared_scope_by_local.get(local.id.raw_value) in {
                .Some(scope_id) then Option[MIRScopeID].Some(scope_id),
                .None() then Option[MIRScopeID].None(),
            }
            let shared_use_scope_opt = shared_use_scope_by_local.get(local.id.raw_value)
            while scope is .Some(_) then {
                let scope_id = when scope in {
                    .Some(existing) then existing,
                    .None() then MIRScopeID(0(UInt)),
                }
                let retained_scope = when shared_use_scope_opt in {
                    .Some(shared_use_scope) then shared_use_scope.raw_value == scope_id.raw_value,
                    .None() then false,
                }
                if retained_scope then { break }
                scope = mir_parent_scope(&mutable parent_scope_by_scope, scope_id)
            }
            when scope in {
                .Some(scope_id) then {
                    let mutable scoped_locals = locals_by_scope.get(scope_id.raw_value) or else List[MIRLocalID].new()
                    scoped_locals.push(local.id)
                    locals_by_scope.insert(scope_id.raw_value, scoped_locals)
                },
                .None() then root_locals.push(local.id),
            }
            },
            .None() then {},
        }
    }
    for local in function.locals then {
        if local.storage is not .Parameter() and local.storage is not .Capture() and not codegen.type_is_void_or_never(local.local_type) then {
            let has_init_flag = tracked_init_locals.get(local.id.raw_value) or else false
            let can_block_local = if not has_init_flag then when declared_block_by_local.get(local.id.raw_value) in {
                .Some(declaration_block) then when first_use_block_by_local.get(local.id.raw_value) in {
                    .Some(first_use_block) then first_use_block == declaration_block.raw_value and not (multiple_use_blocks_by_local.get(local.id.raw_value) or else false),
                    .None() then false,
                },
                .None() then false,
            } else false
            if can_block_local then {
                when declared_block_by_local.get(local.id.raw_value) in {
                    .Some(declaration_block) then {
                        let mutable block_locals = block_local_declarations_by_block.get(declaration_block.raw_value) or else List[MIRLocalID].new()
                        block_locals.push(local.id)
                        block_local_declarations_by_block.insert(declaration_block.raw_value, block_locals)
                        block_local_declaration_locals.insert(local.id.raw_value, true)
                    },
                    .None() then hoisted_declaration_locals.push(local.id),
                }
            } else {
                hoisted_declaration_locals.push(local.id)
            }
        }
    }
    return box(MIRLocalLifetimePlan(
        root_locals,
        locals_by_scope,
        hoisted_declaration_locals,
        block_local_declarations_by_block,
        block_local_declaration_locals
    ))
}

given CodeGen {
    protected receiver_owner_type_from_typed_params(*self, params List[TypedParam]) Option[Type] = {
        let _ = self
        if params.is_empty() then {
            return Option[Type].None()
        }
        let first_param = params[0(UInt)]
        if not (first_param.name == "self" or first_param.name == "source") then {
            return Option[Type].None()
        }
        return when first_param.param_type in {
            .ReferenceType(inner) then Option[Type].Some(*inner),
            .MutableReferenceType(inner) then Option[Type].Some(*inner),
            .BorrowedReferenceType(inner) then Option[Type].Some(*inner),
            .MutableBorrowedReferenceType(inner) then Option[Type].Some(*inner),
            .WeakReferenceType(inner) then Option[Type].Some(*inner),
            .MutableWeakReferenceType(inner) then Option[Type].Some(*inner),
            _ then Option[Type].Some(first_param.param_type),
        }
    }

    public emit_mir_function_body(*mutable self, function * MIRFunction) String = {
        let saved_indent = self.indent
        self.indent = "    "
        let plan = build_mir_function_emit_plan(self, function)
        let mutable emitter = MIRFunctionCodeEmitter.new(self, function, plan)
        let saved_buffer = self.buffer
        self.buffer = CodegenBuffer.new()
        let nested = (&mutable emitter).emit_body_and_get_nested_definitions()
        let body_text = self.buffer.into_string()
        self.buffer = saved_buffer
        if not nested.is_empty() then {
            self.nested_function_definitions.push_string(nested)
        }
        self.indent = saved_indent
        return body_text
    }

    public emit_mir_global_function(*mutable self, function * MIRFunction) Void = {
        let c_name = self.callable_c_name(function.identifier)
        if self.emitted_function_names.contains(c_name) then { return }
        self.emitted_function_names.insert(c_name)
        let declared_return_type = self.mir_function_return_type(function)
        if self.type_contains_generic(declared_return_type) or self.params_contain_generic(function.params) then {
            panic("Generic MIR function body reached codegen: \(self.context.symbol_name(*(function.identifier))) :: \(self.context.type_display_name(function.identifier.symbol_type))")
        }

        let saved_owner_type = self.current_function_owner_type
        let concrete_return_type = self.concretize_codegen_type(declared_return_type)
        self.current_function_owner_type = when function.kind in {
            .Given(target_type, _, _) then Option[Type].Some(target_type),
            .Global() then self.receiver_owner_type_from_typed_params(function.params),
        }

        {
            let return_c_type = self.c_type_name(concrete_return_type)
            let params_str = self.build_param_list(function.params)
            // Generate the function body and collect nested definitions
            let body_text = self.emit_mir_function_body(function)

            // Emit nested definitions (lambda functions, env structs) before the function
            if not self.nested_function_definitions.is_empty() then {
                self.buffer.push_string(self.nested_function_definitions)
                self.nested_function_definitions = String.new()
            }

            self.buffer.push_string(return_c_type)
            self.buffer.push_string(" ")
            self.buffer.push_string(c_name)
            self.buffer.push_string("(")
            self.buffer.push_string(params_str)
            self.buffer.push_string(") {\n")
            self.buffer.push_string(body_text)
            self.buffer.push_string("}\n")
        }

        self.current_function_owner_type = saved_owner_type
        return
    }
}
