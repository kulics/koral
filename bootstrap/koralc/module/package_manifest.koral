// Package manifest: the four fields of §5.1 and the rules that make a name in
// `using` mean one package. Mirrors
// compiler/Sources/KoralCompiler/Driver/PackageManifest.swift.
//
// A package never declares where it comes from. The consumer's `dependencies`
// says that, keyed by the name the consumer writes -- which is why renaming a
// dependency is just changing that key (§5.3), and why the same package can sit
// at different places for different consumers without either side being wrong.

using "std/json";
using "std/os";

// ── errors ────────────────────────────────────────────────────────────────────

public type ManifestError {
    FileNotFound(path String),
    InvalidField(path String, message String),
    MissingTargetModule(module String),
    DuplicateModuleEntry(entry String),
    UnknownPackageName(name String, context String, known List[String]),
    UnknownModule(name String, package_name String, declared List[String]),
    NoMainModule(package_name String, declared List[String]),
    ReservedName(name String),
    UnsupportedSource(source String),
    Message(text String),
};

file_private let manifest_error_detail(err ManifestError) String = when err in {
    .FileNotFound(path) then "Manifest file not found: \(path)",
    .InvalidField(path, message) then "Invalid manifest field '\(path)': \(message)",
    .MissingTargetModule(module) then "Target module '\(module)' not found in resolved module graph",
    .DuplicateModuleEntry(entry) then "entry file '\(entry)' is declared by two modules",
    .UnknownPackageName(name, context, known) then
        "Unknown package name \"\(name)\"\n  referenced from \(context)\n  known package names: \(known.join_to_string(", "))",
    .UnknownModule(name, package_name, declared) then
        // One condition, one spelling: the `using` path reports these through
        // `ModuleError`, and the two must not grow apart.
        "Module '\(name)' does not exist in package '\(package_name)'; declared modules: \(declared.join_to_string(", "))",
    .NoMainModule(package_name, declared) then
        "Package '\(package_name)' has no main module; write its subpath instead; declared modules: \(declared.join_to_string(", "))",
    .ReservedName(name) then "Package name '\(name)' is reserved",
    .UnsupportedSource(source) then
        "Cannot locate package source '\(source)'\n  only 'path:' sources are resolvable without a fetch step",
    .Message(text) then text,
};

/// How a manifest failure reaches the reader: `Error: msg`. It is about the
/// manifest or the command line, not about source, so it carries no location.
public let manifest_error_text(err ManifestError) String = "Error: " + manifest_error_detail(err);

// ── manifest shape ────────────────────────────────────────────────────────────

/// The name this package writes for a dependency, where that dependency lives,
/// and which versions of it are acceptable. `source` is both the fetch location
/// and the package's identity, and never carries a ref (§5.3).
public type PackageDependencyConfig(
    key String,
    source String,
    version String,
);

/// A module as the manifest declares it. `key` is the package-internal name --
/// `"."` for the main module, otherwise the subpath. A consumer spells the FULL
/// name, `package[/subpath]`; the manifest only ever describes the inside (§5.2).
public type PackageModuleConfig(
    key String,
    subpath String,
    entry_path String,
    links List[String],
);

/// Four fields (§5.1): `package`, `version`, `modules`, `dependencies`.
/// No `name` (same thing as `package`), no top-level `entry` (the default build
/// target IS the main module), no `requires` (the module graph comes from
/// `using`, §5.4), no `module_aliases` (renaming is the dependency key, §5.3).
public type PackageManifest(
    manifest_path String,
    package_root String,
    package_name String,
    version String,
    modules Dict[String, PackageModuleConfig],
    dependencies Dict[String, PackageDependencyConfig],
);

public type ResolvedPackageKind {
    Root(),
    Std(),
    Dependency(key String),
};

// ── loaded packages ───────────────────────────────────────────────────────────
//
// A package is reached by a NAME, and that name is whoever is asking (§4):
// `dep_utils` writes `using "dep_utils/…"`, its consumer writes
// `using "game_utils/…"`. Both land on the same package because each package
// resolves its own source with its own table. Identity is the `source`, which
// is what the two spellings have in common.

public type LoadedPackage(
    identity String,
    self_name String,
    manifest PackageManifest,
    kind ResolvedPackageKind,
);

public type mutable PackageRegistry(
    mutable by_identity Dict[String, LoadedPackage],
    mutable all List[LoadedPackage],
    mutable std_package Option[LoadedPackage],
    mutable root_package Option[LoadedPackage],
);

given PackageRegistry {
    public new() PackageRegistry = PackageRegistry(
        Dict[String, LoadedPackage].new(),
        [],
        Option[LoadedPackage].None(),
        Option[LoadedPackage].None(),
    );

    public register(self, package LoadedPackage) Void = {
        if self.by_identity.get(package.identity) is .None() then {
            self.by_identity.insert(package.identity, package);
            self.all.push(package);
        };
        when package.kind in {
            .Std() then {
                self.std_package = Option[LoadedPackage].Some(package);
            },
            .Root() then {
                self.root_package = Option[LoadedPackage].Some(package);
            },
            _ then {},
        };
    };

    public package_by_identity(self, identity String) Option[LoadedPackage] =
        self.by_identity.get(identity);

    /// Resolve `name` as written in `owner`'s source.
    ///
    /// A package name is one of three things (§4): the package's own `package`,
    /// one of its `dependencies` keys, or the reserved `std`. Nothing else.
    public resolve_name(self, name String, owner LoadedPackage) Option[LoadedPackage] = {
        if name == owner.self_name then {
            return Option[LoadedPackage].Some(owner);
        };
        when owner.manifest.dependencies.get(name) in {
            .Some(dependency) then {
                return self.by_identity.get(dependency.source);
            },
            .None() then {},
        };
        if name == "std" then {
            return self.std_package;
        };
        return Option[LoadedPackage].None();
    };

    /// Every name `owner` can write, for error messages.
    public known_names(self, owner LoadedPackage) List[String] = {
        let mutable names List[String] = [owner.self_name, "std"];
        let mutable iter = owner.manifest.dependencies.iterator();
        while iter.next() is .Some(entry) then {
            names.push(entry.first);
        };
        return names;
    };
};

// ── resolved module ───────────────────────────────────────────────────────────

/// A module as the rest of the compiler sees it.
///
/// `full_name` is the name as written from the ROOT package's point of view and
/// is display only -- identity is `(package identity, subpath)`. `path_segments`
/// qualifies top-level symbols; §10.4 records why that is still name-based and
/// open.
public type ResolvedModuleSpec(
    full_name String,
    path_segments List[String],
    key String,
    subpath String,
    entry_file String,
    links List[String],
    package_identity String,
    package_kind ResolvedPackageKind,
    owner LoadedPackage,
);

/// Whether `name` is a single lowercase identifier segment -- a package name,
/// or one segment of a subpath (§2.1).
public let is_valid_package_or_segment_name(name String) Bool = {
    if name.is_empty() then {
        return false;
    };
    let first = name[0(UInt)];
    if first < 'a' or first > 'z' then {
        return false;
    };
    for i in 0..<name.count() then {
        let ch = name[i];
        let is_lower = ch >= 'a' and ch <= 'z';
        let is_digit = ch >= '0' and ch <= '9';
        let is_underscore = ch == '_';
        if not is_lower and not is_digit and not is_underscore then {
            return false;
        };
    };
    return true;
};

/// A manifest module key is `"."` or a `/`-separated subpath of identifier
/// segments (§5.2). It never carries the package name -- that would be
/// describing the package from the outside, which is the consumer's job.
///
/// Returns the subpath: `""` for the main module, otherwise the key itself.
/// `None` means the key is not a legal module key at all.
public let parse_manifest_module_key(key String) Option[String] = {
    if key == "." then {
        return Option[String].Some("");
    };
    if key.is_empty() or key.contains(".") then {
        return Option[String].None();
    };
    // `split` drops empty segments, so `io` and `io/` would both become `io`
    // and two keys would name one module. Reject the empty ones outright.
    if key.starts_with("/") or key.ends_with("/") or key.contains("//") then {
        return Option[String].None();
    };
    for segment in key.split("/") then {
        if not is_valid_package_or_segment_name(segment) then {
            return Option[String].None();
        };
    };
    return Option[String].Some(key);
};

/// A semver constraint (§5.3): an optional comparison operator followed by a
/// dotted numeric version. The exact version is a lockfile's job -- this only
/// says the constraint is written in a form that means something.
public let is_valid_version_constraint(text String) Bool = {
    let mutable rest = text;
    for op in ["^", "~", ">=", "<=", ">", "<", "="] then {
        if rest.starts_with(op) then {
            rest = rest.trim_prefix(op);
            break;
        };
    };
    let mutable parts = List[String].new();
    for part in rest.split(".") then {
        parts.push(part);
    };
    if parts.count() < 2 or parts.count() > 4 then {
        return false;
    };
    for part in parts then {
        if part.is_empty() then {
            return false;
        };
        for i in 0..<part.count() then {
            let ch = part[i];
            if ch < '0' or ch > '9' then {
                return false;
            };
        };
    };
    return true;
};

/// Build a module spec from a manifest entry. `root_name` is the name the root
/// package uses for the owning package -- its own `package`, a dependency key,
/// or `"std"`.
public let make_resolved_module_spec(
    key String,
    config PackageModuleConfig,
    root_name String,
    owner LoadedPackage,
) ResolvedModuleSpec = {
    let full_name = if config.subpath.is_empty() then root_name
        else root_name + "/" + config.subpath;

    let mutable segments = List[String].new();
    segments.push(module_file_name_to_identifier(root_name));
    if not config.subpath.is_empty() then {
        for segment in config.subpath.split("/") then {
            segments.push(module_file_name_to_identifier(segment));
        };
    };

    return ResolvedModuleSpec(
        full_name,
        segments,
        key,
        config.subpath,
        config.entry_path,
        config.links,
        owner.identity,
        owner.kind,
        owner,
    );
};

/// The name the ROOT package uses for `package`. For the root itself that is
/// its own `package`; for a dependency it is the root's `dependencies` key; for
/// std it is `"std"`.
public let root_view_name(
    package LoadedPackage,
    registry PackageRegistry,
    root LoadedPackage,
) String = {
    if package.kind is .Root() or package.kind is .Std() then {
        return package.self_name;
    };

    // A dependency is named by the root's `dependencies` key -- which is what
    // the root's own source writes for it, and so what its modules are called
    // from where the build is standing.
    let mutable iter = root.manifest.dependencies.iterator();
    while iter.next() is .Some(entry) then {
        if entry.second.source == package.identity then {
            return entry.first;
        };
    };
    return package.self_name;
};

// ── parsing ───────────────────────────────────────────────────────────────────

file_private let obsolete_field_hint(field String) String = when field in {
    "name" then
        "renamed to 'package'; 'package' is the name the SOURCE writes, not an identity",
    "entry" then
        "removed; the default build target is the main module ('modules' key \".\")",
    "requires" then
        "removed; the module graph is derived from 'using' (§5.4)",
    "module_aliases" then
        "removed; renaming a dependency is its 'dependencies' key (§5.3)",
    "git" then
        "removed; the fetch location is 'source' (§5.3)",
    "hash" then
        "removed; hashes live in koral.lock, one place (§11.2)",
    "links" then
        "moved onto the module that needs it ('modules.<key>.links')",
    _ then "unsupported",
};

/// Reject fields the current manifest schema no longer has, naming the
/// replacement. A manifest that still carries one is told so instead of being
/// silently half-read. The list is per section: `entry` is gone at the top
/// level but is exactly what a module entry must still declare.
file_private let reject_obsolete_fields(json JsonValue, context String, fields List[String]) Result[Void] = {
    for field in fields then {
        if json.get_field(field) is .Some(_) then {
            let field_path = if context.is_empty() then field else context + "." + field;
            let hint = obsolete_field_hint(field);
            let message = manifest_error_text(.InvalidField(field_path, hint));
            return Result[Void].Error(message);
        };
    };
    return Result[Void].Ok({});
};

file_private let expect_manifest_string(json JsonValue, path String) Result[String] = {
    let value = json.get_field(path) or else {
        return Result[String].Error(manifest_error_text(.InvalidField(path, "missing required string")));
    };
    let text = value.as_string() or else {
        return Result[String].Error(manifest_error_text(.InvalidField(path, "expected string")));
    };
    return Result[String].Ok(text);
};

file_private let load_manifest_string_array(value JsonValue, path String) Result[List[String]] = {
    let arr = value.as_array() or else {
        return Result[List[String]].Error(manifest_error_text(.InvalidField(path, "expected string array")));
    };
    let mutable out List[String] = [];
    for i in 0..<arr.count() then {
        let item = arr[i].as_string() or else {
            return Result[List[String]].Error(manifest_error_text(.InvalidField("\(path)[\(i)]", "expected string")));
        };
        out.push(item);
    };
    return Result[List[String]].Ok(out);
};

public let load_package_manifest(manifest_path String) Result[PackageManifest] = {
    let absolute_manifest_path = when absolute_path(manifest_path.into_path()) in {
        .Ok(path) then path.to_string(),
        .Error(_) then manifest_path,
    };
    if not path_exist(absolute_manifest_path.into_path()) then {
        return Result[PackageManifest].Error(manifest_error_text(.FileNotFound(absolute_manifest_path)));
    };

    let text = read_text_file(absolute_manifest_path.into_path()) or return;
    let json = JsonValue.parse(text) or else {
        return Result[PackageManifest].Error(manifest_error_text(.Message("Invalid manifest JSON: \(absolute_manifest_path)")));
    };
    if json.as_object() is .None() then {
        return Result[PackageManifest].Error(manifest_error_text(.Message("Invalid manifest JSON: \(absolute_manifest_path)")));
    };

    let top_fields = List[String].new();
    top_fields.push("name");
    top_fields.push("entry");
    top_fields.push("requires");
    top_fields.push("module_aliases");
    top_fields.push("links");
    reject_obsolete_fields(json, "", top_fields) or return;

    let package_root = absolute_manifest_path.into_path().dir_name().to_string();

    let package_name = expect_manifest_string(json, "package") or return;
    if not is_valid_package_or_segment_name(package_name) then {
        return Result[PackageManifest].Error(manifest_error_text(.InvalidField(
            "package",
            "package name must be a single lowercase identifier",
        )));
    };
    let version = expect_manifest_string(json, "version") or return;

    let mutable dependencies = Dict[String, PackageDependencyConfig].new();
    when json.get_field("dependencies") in {
        .Some(dep_ref) then {
            let dep_obj = dep_ref.as_object() or else {
                return Result[PackageManifest].Error(manifest_error_text(.InvalidField("dependencies", "expected object")));
            };
            let mutable source_owners = Dict[String, String].new();
            // Sorted: the message names the two keys that fight, and which
            // one is "first" must not depend on hash iteration order.
            let mutable dep_keys = List[String].new();
            let mutable key_iter = dep_obj.iterator();
            while key_iter.next() is .Some(e) then {
                dep_keys.push(e.first);
            };
            dep_keys.sort();
            for dep_key in dep_keys then {
                let dep_json = dep_obj.get(dep_key) or else { continue; };
                if not is_valid_package_or_segment_name(dep_key) then {
                    return Result[PackageManifest].Error(manifest_error_text(.InvalidField(
                        "dependencies.\(dep_key)",
                        "dependency key must be a single lowercase identifier",
                    )));
                };
                if dep_key == package_name then {
                    return Result[PackageManifest].Error(manifest_error_text(.InvalidField(
                        "dependencies.\(dep_key)",
                        "dependency key collides with this package's own name",
                    )));
                };
                if dep_key == "std" then {
                    return Result[PackageManifest].Error(manifest_error_text(.ReservedName(dep_key)));
                };

                let dep_fields = List[String].new();
                dep_fields.push("name");
                dep_fields.push("git");
                dep_fields.push("module_aliases");
                dep_fields.push("hash");
                reject_obsolete_fields(dep_json, "dependencies.\(dep_key)", dep_fields) or return;
                let source = expect_manifest_string(dep_json, "source") or else {
                    return Result[PackageManifest].Error(manifest_error_text(.InvalidField(
                        "dependencies.\(dep_key).source",
                        "missing required string",
                    )));
                };
                let dep_version = expect_manifest_string(dep_json, "version") or else {
                    return Result[PackageManifest].Error(manifest_error_text(.InvalidField(
                        "dependencies.\(dep_key).version",
                        "missing required string",
                    )));
                };
                if not is_valid_version_constraint(dep_version) then {
                    return Result[PackageManifest].Error(manifest_error_text(.InvalidField(
                        "dependencies.\(dep_key).version",
                        "'\(dep_version)' is not a semver constraint (for example '^1.2')",
                    )));
                };
                if source.contains("#") or source.contains("?") then {
                    return Result[PackageManifest].Error(manifest_error_text(.InvalidField(
                        "dependencies.\(dep_key).source",
                        "source must not carry a ref; pin the version with koral.lock",
                    )));
                };
                when source_owners.get(source) in {
                    .Some(previous) then {
                        // One source may only have one spelling in a project (§4).
                        // Name both keys so the reader can see which two fight.
                        return Result[PackageManifest].Error(manifest_error_text(.Message(
                            "Source '\(source)' is declared by both '\(previous)' and '\(dep_key)'; one package would have two spellings",
                        )));
                    },
                    .None() then {},
                };
                source_owners.insert(source, dep_key);
                dependencies.insert(dep_key, PackageDependencyConfig(dep_key, source, dep_version));
            };
        },
        .None() then {},
    };

    let modules_ref = json.get_field("modules") or else {
        return Result[PackageManifest].Error(manifest_error_text(.InvalidField("modules", "missing required object")));
    };
    let modules_obj = modules_ref.as_object() or else {
        return Result[PackageManifest].Error(manifest_error_text(.InvalidField("modules", "expected object")));
    };

    let mutable modules = Dict[String, PackageModuleConfig].new();
    let mutable seen_entries = Set[String].new();
    let mutable iter = modules_obj.iterator();
    while iter.next() is .Some(module_entry) then {
        let module_name = module_entry.first;
        let module_fields = List[String].new();
        module_fields.push("requires");
        reject_obsolete_fields(module_entry.second, "modules.\(module_name)", module_fields) or return;

        let subpath = parse_manifest_module_key(module_name) or else {
            return Result[PackageManifest].Error(manifest_error_text(.InvalidField(
                "modules.\(module_name)",
                "module key must be '.' or lowercase segments joined by '/'",
            )));
        };
        let module_json = module_entry.second;
        let entry_rel = expect_manifest_string(module_json, "entry") or else {
            return Result[PackageManifest].Error(manifest_error_text(.InvalidField(
                "modules.\(module_name).entry",
                "missing required string",
            )));
        };
        // Resolve `.` / `..` ourselves: `join` keeps them, so `../x` would still
        // start with the package root as a string and the containment check
        // below could not see that it climbs out.
        let mutable entry_target = package_root.into_path();
        for segment in entry_rel.split("/") then {
            if segment == "." or segment.is_empty() then {
                continue;
            };
            if segment == ".." then {
                entry_target = entry_target.dir_name();
            } else {
                entry_target = entry_target.join(segment);
            };
        };
        let entry_abs = entry_target.to_string();
        if seen_entries.contains(entry_abs) then {
            return Result[PackageManifest].Error(manifest_error_text(.DuplicateModuleEntry(entry_rel)));
        };
        // An entry file lives inside the package (§7.16). `entry` is relative
        // to the package root, so a path that climbs out is either a mistake or
        // an attempt to compile someone else's source under this name. Checked
        // before "does it exist": a path outside the package is the problem,
        // whether or not something happens to sit there.
        let root_norm = package_root.into_path().normalize().to_string();
        if not (entry_abs == root_norm or entry_abs.starts_with(root_norm + "/")) then {
            return Result[PackageManifest].Error(manifest_error_text(.InvalidField(
                "modules.\(module_name).entry",
                "entry file '\(entry_rel)' is outside the package root",
            )));
        };
        seen_entries.insert(entry_abs);
        if not path_exist(entry_abs.into_path()) then {
            return Result[PackageManifest].Error(manifest_error_text(.InvalidField(
                "modules.\(module_name).entry",
                "entry file '\(entry_rel)' does not exist",
            )));
        };
        let module_links = when module_json.get_field("links") in {
            .Some(value_ref) then load_manifest_string_array(value_ref, "modules.\(module_name).links") or return,
            .None() then List[String].new(),
        };
        modules.insert(module_name, PackageModuleConfig(module_name, subpath, entry_abs, module_links));
    };

    if modules.is_empty() then {
        return Result[PackageManifest].Error(manifest_error_text(.InvalidField("modules", "a package declares at least one module")));
    };

    return Result[PackageManifest].Ok(PackageManifest(
        absolute_manifest_path,
        package_root,
        package_name,
        version,
        modules,
        dependencies,
    ));
};

// ── loading the package set ───────────────────────────────────────────────────
//
// `path:` sources are relative to the manifest that declares them (§5.3), so a
// dependency can say `path:../slug` and mean the same directory from anywhere
// that dependency is reused. Anything else is a fetch location: `koral get`
// materializes it and the compiler reads it back from the cache.

public let locate_dependency(
    dependency PackageDependencyConfig,
    declaring_manifest PackageManifest,
    fetch_root Option[String],
) Result[String] = {
    if dependency.source.starts_with("path:") then {
        let relative = dependency.source.trim_prefix("path:");
        if relative.is_empty() then {
            return Result[String].Error(manifest_error_text(.InvalidField(
                "dependencies.\(dependency.key).source",
                "'path:' source needs a path after the colon",
            )));
        };
        return Result[String].Ok(
            declaring_manifest.package_root.into_path()
                .join(relative)
                .join("koral.json")
                .normalize()
                .to_string()
        );
    };

    when fetch_root in {
        .Some(root) then {
            return Result[String].Ok(
                root.into_path().join(dependency.key).join("koral.json").normalize().to_string()
            );
        },
        .None() then {
            return Result[String].Error(manifest_error_text(.UnsupportedSource(dependency.source)));
        },
    };
};

/// Load the root package and every package reachable from it, transitively.
public let load_package_registry(
    root_manifest_path String,
    std_manifest_path Option[String],
    fetch_root Option[String],
) Result[PackageRegistry] = {
    let registry = PackageRegistry.new();
    let root_manifest = load_package_manifest(root_manifest_path) or return;

    // Building the standard library itself makes the root package BE std: one
    // package, one identity, and it is the prelude for everyone else.
    let absolute_root = absolute_path(root_manifest_path.into_path()) or else {
        root_manifest_path.into_path()
    };
    let root_is_std = when std_manifest_path in {
        .Some(path) then {
            let absolute_std = absolute_path(path.into_path()) or else { path.into_path() };
            absolute_std.normalize().to_string() == absolute_root.normalize().to_string()
        },
        .None() then false,
    };

    if not root_is_std and root_manifest.package_name == "std" then {
        // `std` names the standard library and nothing else (§4). Only the
        // manifest loaded AS std may claim it.
        return Result[PackageRegistry].Error(manifest_error_text(.ReservedName(root_manifest.package_name)));
    };

    let root = if root_is_std then
        LoadedPackage("std", "std", root_manifest, .Std())
    else
        LoadedPackage(root_manifest.package_name, root_manifest.package_name, root_manifest, .Root());

    if not root_is_std then {
        when std_manifest_path in {
            .Some(std_path) then {
                let std_manifest = load_package_manifest(std_path) or return;
                registry.register(LoadedPackage("std", "std", std_manifest, .Std()));
            },
            .None() then {},
        };
    };
    registry.register(root);

    // Breadth-first so a package is loaded once no matter how many others name it.
    let mutable pending List[LoadedPackage] = [root];
    when registry.std_package in {
        .Some(std) then {
            if not root_is_std then {
                pending.push(std);
            };
        },
        .None() then {},
    };
    let mutable next UInt = 0;
    while next < pending.count() then {
        let owner = pending[next];
        next = next + 1;

        let mutable dep_keys List[String] = [];
        let mutable dep_iter = owner.manifest.dependencies.iterator();
        while dep_iter.next() is .Some(entry) then {
            dep_keys.push(entry.first);
        };
        // Sorted so the load order does not depend on hash iteration order.
        let mutable sorted_keys = dep_keys;
        sorted_keys.sort();

        for dep_key in sorted_keys then {
            let dependency = owner.manifest.dependencies.get(dep_key) or else {
                continue;
            };
            if registry.package_by_identity(dependency.source) is .Some(_) then {
                continue;
            };

            let manifest_path = locate_dependency(dependency, owner.manifest, fetch_root) or return;
            let manifest = load_package_manifest(manifest_path) or else {
                return Result[PackageRegistry].Error(manifest_error_text(.InvalidField(
                    "dependencies.\(dependency.key).source",
                    "cannot load '\(dependency.source)': \(it.message())",
                )));
            };

            // `std` is reserved (§7.20). Only the standard library's own
            // manifest may claim it; a dependency trying to is a name collision
            // with the built-in.
            if manifest.package_name == "std" then {
                return Result[PackageRegistry].Error(manifest_error_text(.ReservedName(manifest.package_name)));
            };

            let package = LoadedPackage(
                dependency.source,
                manifest.package_name,
                manifest,
                .Dependency(dependency.key),
            );
            registry.register(package);
            pending.push(package);
        };
    };

    return Result[PackageRegistry].Ok(registry);
};

/// The standard library's main module is the prelude: it is compiled in and in
/// scope in every non-std module without being named. It is therefore NOT part
/// of the `using` graph -- it is the base the graph sits on (§6.4's "主模块是基础层").
public let prelude_module_spec(registry PackageRegistry) Option[ResolvedModuleSpec] = {
    when registry.std_package in {
        .Some(std) then {
            when std.manifest.modules.get(".") in {
                .Some(config) then {
                    return Option[ResolvedModuleSpec].Some(
                        make_resolved_module_spec(".", config, "std", std)
                    );
                },
                .None() then {},
            };
        },
        .None() then {},
    };
    return Option[ResolvedModuleSpec].None();
};
