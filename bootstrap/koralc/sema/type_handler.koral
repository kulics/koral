// type_handler.koral - 类型处理器系统
//
// 对应 compiler/Sources/KoralCompiler/Sema/TypeHandler.swift
// - copy/drop 代码生成
// - 成员/方法查询
// - 泛型参数检测

// ── TypeHandlerKind ───────────────────────────────────────────────────────────

/// 类型处理器支持的类型种类
public type TypeHandlerKind {
    Primitive(),
    Structure(),
    Enum(),
    Function(),
    Reference(),
    MutableReference(),
    Pointer(),
    MutablePointer(),
    WeakReference(),
    GenericParameter(),
    GenericStruct(),
    GenericEnum(),
    Module(),
    TypeVariable(),
    Opaque(),
}

/// 从 Type 获取对应的 TypeHandlerKind
public let type_handler_kind_from(t Type) TypeHandlerKind = {
    return when t in {
        .IntType() then TypeHandlerKind.Primitive(),
        .Int8Type() then TypeHandlerKind.Primitive(),
        .Int16Type() then TypeHandlerKind.Primitive(),
        .Int32Type() then TypeHandlerKind.Primitive(),
        .Int64Type() then TypeHandlerKind.Primitive(),
        .UIntType() then TypeHandlerKind.Primitive(),
        .UInt8Type() then TypeHandlerKind.Primitive(),
        .UInt16Type() then TypeHandlerKind.Primitive(),
        .UInt32Type() then TypeHandlerKind.Primitive(),
        .UInt64Type() then TypeHandlerKind.Primitive(),
        .Float32Type() then TypeHandlerKind.Primitive(),
        .Float64Type() then TypeHandlerKind.Primitive(),
        .BoolType() then TypeHandlerKind.Primitive(),
        .VoidType() then TypeHandlerKind.Primitive(),
        .NeverType() then TypeHandlerKind.Primitive(),
        .StructureType(_) then TypeHandlerKind.Structure(),
        .EnumType(_) then TypeHandlerKind.Enum(),
        .FunctionType(_, _) then TypeHandlerKind.Function(),
        .ReferenceType(_) then TypeHandlerKind.Reference(),
        .MutableReferenceType(_) then TypeHandlerKind.MutableReference(),
        .BorrowedReferenceType(_) then TypeHandlerKind.Reference(),
        .MutableBorrowedReferenceType(_) then TypeHandlerKind.MutableReference(),
        .PointerType(_) then TypeHandlerKind.Pointer(),
        .MutablePointerType(_) then TypeHandlerKind.MutablePointer(),
        .WeakReferenceType(_) then TypeHandlerKind.WeakReference(),
        .MutableWeakReferenceType(_) then TypeHandlerKind.WeakReference(),
        .GenericParameter(_) then TypeHandlerKind.GenericParameter(),
        .GenericStruct(_, _) then TypeHandlerKind.GenericStruct(),
        .GenericEnum(_, _) then TypeHandlerKind.GenericEnum(),
        .ModuleType(_) then TypeHandlerKind.Module(),
        .OpaqueType(_) then TypeHandlerKind.Opaque(),
        .TraitObject(_, _) then TypeHandlerKind.Reference(),
        .TypeVar(_) then TypeHandlerKind.TypeVariable(),
        .Unknown() then TypeHandlerKind.Primitive(),
    }
}

// ── TypeHandlerResult types ───────────────────────────────────────────────────

/// 类型成员信息
public type TypeMemberInfo(
    name String,
    member_type Type,
    is_mutable Bool,
    access AccessModifier,
)

// ── TypeHandler 查询函数 ──────────────────────────────────────────────────────

/// 检查类型是否需要 copy 函数
public let type_needs_copy(t Type) Bool = {
    return when t in {
        .StructureType(_) then true,
        .EnumType(_) then true,
        .ReferenceType(_) then true,
        .MutableReferenceType(_) then true,
        .FunctionType(_, _) then true,
        .WeakReferenceType(_) then true,
        .MutableWeakReferenceType(_) then true,
        .GenericStruct(_, _) then true,
        .GenericEnum(_, _) then true,
        _ then false,
    }
}

/// 检查类型是否需要 drop 函数
public let type_needs_drop(t Type) Bool = {
    return when t in {
        .StructureType(_) then true,
        .EnumType(_) then true,
        .ReferenceType(_) then true,
        .MutableReferenceType(_) then true,
        .BorrowedReferenceType(_) then true,
        .MutableBorrowedReferenceType(_) then true,
        .FunctionType(_, _) then true,
        .WeakReferenceType(_) then true,
        .MutableWeakReferenceType(_) then true,
        .GenericStruct(_, _) then true,
        .GenericEnum(_, _) then true,
        .TraitObject(_, _) then true,
        .TypeVar(_) then true,
        _ then false,
    }
}

/// 生成原始类型的 C 类型名
public let primitive_c_type_name(t Type) String = {
    return when t in {
        .IntType() then "intptr_t",
        .Int8Type() then "int8_t",
        .Int16Type() then "int16_t",
        .Int32Type() then "int32_t",
        .Int64Type() then "int64_t",
        .UIntType() then "uintptr_t",
        .UInt8Type() then "uint8_t",
        .UInt16Type() then "uint16_t",
        .UInt32Type() then "uint32_t",
        .UInt64Type() then "uint64_t",
        .Float32Type() then "float",
        .Float64Type() then "double",
        .BoolType() then "int",
        .VoidType() then "void",
        .NeverType() then "void",
        _ then "void",
    }
}

/// 检查类型是否包含泛型参数（递归检查，带循环检测）
public let type_contains_generic_parameter(t Type, context * CompilerContext) Bool = {
    let mutable visited = Set[UInt].new()
    return type_contains_generic_parameter_internal(t, context, &mutable visited)
}

/// 仅检查类型表面是否仍提及未解析的泛型占位。
///
/// 这与 `type_contains_generic_parameter` 的语义不同：它不会递归展开
/// 已定义的结构体/枚举，只用于判断当前类型节点是否还未完全具体化。
public let type_mentions_unresolved_generic_placeholder(t Type) Bool = {
    let mutable worklist = List[* Type].new()
    worklist.push(box(t))

    while not worklist.is_empty() then {
        let current_opt = worklist.pop()
        if current_opt is .None() then { break }
        let current = current_opt.unwrap()
        when *current in {
            .GenericParameter(_) then { return true },
            .TypeVar(_) then { return true },
            .FunctionType(params, ret) then {
                worklist.push(ret)
                for entry in params then {
                    worklist.push(box(entry.param_type))
                }
            },
            .ReferenceType(inner) then { worklist.push(inner) },
            .MutableReferenceType(inner) then { worklist.push(inner) },
            .PointerType(inner) then { worklist.push(inner) },
            .MutablePointerType(inner) then { worklist.push(inner) },
            .WeakReferenceType(inner) then { worklist.push(inner) },
            .MutableWeakReferenceType(inner) then { worklist.push(inner) },
            .GenericStruct(_, args) then {
                for a in args then {
                    worklist.push(a)
                }
            },
            .GenericEnum(_, args) then {
                for a in args then {
                    worklist.push(a)
                }
            },
            _ then {},
        }
    }
    return false
}

/// Returns the children types that need to be checked for generic parameters.
/// This is used by the iterative version to avoid deep recursion.
private let collect_type_children(t Type, context * CompilerContext, visited *mutable Set[UInt]) List[* Type] = {
    let mutable children = List[* Type].new()
    when t in {
        .FunctionType(params, ret) then {
            children.push(ret)
            for entry in params then {
                children.push(box(entry.param_type))
            }
        },
        .ReferenceType(inner) then { children.push(inner) },
        .MutableReferenceType(inner) then { children.push(inner) },
        .BorrowedReferenceType(inner) then { children.push(inner) },
        .MutableBorrowedReferenceType(inner) then { children.push(inner) },
        .PointerType(inner) then { children.push(inner) },
        .MutablePointerType(inner) then { children.push(inner) },
        .WeakReferenceType(inner) then { children.push(inner) },
        .MutableWeakReferenceType(inner) then { children.push(inner) },
        .StructureType(def_id) then {
            if not visited.contains(def_id.id) then {
                visited.insert(def_id.id)
                when context.get_type_arguments(def_id) in {
                    .Some(args) then {
                        for a in args then { children.push(box(a)) }
                    },
                    .None() then {
                        when context.get_struct_fields(def_id) in {
                            .Some(fields) then {
                                for f in fields then { children.push(box(f.field_type)) }
                            },
                            .None() then {},
                        }
                    },
                }
            }
        },
        .EnumType(def_id) then {
            if not visited.contains(def_id.id) then {
                visited.insert(def_id.id)
                when context.get_type_arguments(def_id) in {
                    .Some(args) then {
                        for a in args then { children.push(box(a)) }
                    },
                    .None() then {
                        when context.get_enum_cases(def_id) in {
                            .Some(cases) then {
                                for c in cases then {
                                    for p in c.params then { children.push(box(p.param_type)) }
                                }
                            },
                            .None() then {},
                        }
                    },
                }
            }
        },
        .GenericStruct(_, args) then {
            for a in args then { children.push(a) }
        },
        .GenericEnum(_, args) then {
            for a in args then { children.push(a) }
        },
        _ then {},
    }
    return children
}

/// Iterative version of type_contains_generic_parameter_internal.
/// Uses an explicit worklist to avoid stack overflow on deeply nested types.
private let type_contains_generic_parameter_internal(t Type, context * CompilerContext, visited *mutable Set[UInt]) Bool = {
    let mutable worklist = List[* Type].new()
    worklist.push(box(t))

    while not worklist.is_empty() then {
        let current_opt = worklist.pop()
        if current_opt is .None() then { break }
        let current = current_opt.unwrap()
        when *current in {
            .GenericParameter(_) then { return true },
            .TypeVar(_) then { return true },
            _ then {
                let children = collect_type_children(*current, context, visited)
                for child in children then {
                    worklist.push(child)
                }
            },
        }
    }
    return false
}
