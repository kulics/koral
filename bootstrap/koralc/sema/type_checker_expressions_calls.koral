
using std::os { IntoPath, env, read_text_file };

given TypeChecker {
 module_private typed_generic_function_callee_for_call(self, callee Expr) Option[TypedExpr] = {
 return when callee in {
 .GenericInstantiation(base, _, _) then {
 if self.lookup_current_file_type_symbol(base) is .Some(_) or self.storage.global_scope.lookup_type(base) is .Some(_) then {
 return Option[TypedExpr].None();
 };

 let fn_lookup = when self.lookup_current_file_symbol(base) in {
 .Some(sym) then Option[Symbol].Some(sym),
 .None() then self.storage.global_scope.lookup(base),
 };
 yield when fn_lookup in {
 .Some(sym) then Option[TypedExpr].Some(make_typed_expr(TypedExprKind.Variable(sym), sym.symbol_type)),
 .None() then Option[TypedExpr].None(),
 };
 },
 _ then Option[TypedExpr].None(),
 };
 };

 module_private generic_function_template_for_callee(self, callee TypedExpr) Option[GenericFunctionTemplate] = {
 return when callee.expr_kind in {
 .Variable(sym) then {
 if self.storage.generic_templates.lookup_function_by_def_id(sym.def_id) is .Some(template) then {
 return Option[GenericFunctionTemplate].Some(template);
 };
 yield self.storage.generic_templates.lookup_function_by_def_id(sym.def_id);
 },
 _ then Option[GenericFunctionTemplate].None(),
 };
 };

 module_private explicit_generic_function_type_args(self, callee Expr, scope Scope) List[Type] = {
 return when callee in {
 .GenericInstantiation(base, type_args, _) then {
 if self.lookup_current_file_type_symbol(base) is .Some(_) or self.storage.global_scope.lookup_type(base) is .Some(_) then {
 return List[Type].new();
 };
 let mutable resolved = List[Type].new();
 for type_arg in type_args then {
 resolved.push(self.resolve_type_in_scope(type_arg, scope));
 };
 yield resolved;
 },
 _ then List[Type].new(),
 };
 };

 module_private raw_generic_function_param_type(self, template GenericFunctionTemplate, param_index UInt) Option[Type] = {
 if param_index >= template.parameters.count() then {
 return Option[Type].None();
 };
 let mutable generic_scope = Scope.new_child(self.storage.global_scope);
 for tp in template.type_parameters then {
 generic_scope.define_type(tp.name, Type.GenericParameter(tp.name));
 };
 return Option[Type].Some(self.resolve_type_in_scope(template.parameters[param_index].param_type, generic_scope));
 };

 module_private initial_generic_function_bindings(self, callee Expr, typed_callee TypedExpr, scope Scope) Option[Dict[String, Type]] = {
 let template = self.generic_function_template_for_callee(typed_callee) or else {
 return Option[Dict[String, Type]].None();
 };
 if template.type_parameters.is_empty() then {
 return Option[Dict[String, Type]].None();
 };

 let explicit_type_args = self.explicit_generic_function_type_args(callee, scope);
 let mutable bindings = Dict[String, Type].new();
 if not explicit_type_args.is_empty() then {
 if explicit_type_args.count() <> template.type_parameters.count() then {
 self.storage.diagnostics.push(
 make_diagnostic(
 DiagnosticStage.Semantic(),
 self.storage.file_path,
 "Type mismatch: expected \(template.type_parameters.count()) generic arguments, got \(explicit_type_args.count())"
 
 )
 );
 return Option[Dict[String, Type]].None();
 };
 let mutable idx UInt = 0;
 while idx < template.type_parameters.count() then {
 bindings.insert(template.type_parameters[idx].name, explicit_type_args[idx]);
 idx += 1;
 };
 };
 return Option[Dict[String, Type]].Some(bindings);
 };

 module_private constructor_direct_param_types(self, constructor_type Type) List[Type] = {
 return when constructor_type in {
 .StructureType(def_id) then when self.context().get_struct_fields(def_id) in {
 .Some(fields) then {
 let mutable types = List[Type].new();
 for field in fields then {
 types.push(field.field_type);
 };
 yield types;
 },
 .None() then List[Type].new(),
 },
 .GenericStruct(template_name, _, args) then when self.storage.generic_templates.lookup_struct(template_name) in {
 .Some(struct_template) then when self.context().get_struct_fields(struct_template.def_id) in {
 .Some(fields) then {
 let mutable bindings = Dict[String, Type].new();
 let mutable i UInt = 0;
 let param_count = struct_template.type_parameters.count();
 let arg_count = args.count();
 let n = if param_count < arg_count then param_count else arg_count;
 while i < n then {
 let tp = struct_template.type_parameters[i];
 bindings.insert(tp.name, (args[i]));
 i += 1;
 };
 let mutable types = List[Type].new();
 for field in fields then {
 types.push(self.apply_type_bindings(field.field_type, bindings));
 };
 yield types;
 },
 .None() then List[Type].new(),
 },
 .None() then List[Type].new(),
 },
 _ then List[Type].new(),
 };
 };

 module_private constructor_matches_expected_type(self, constructor_type Type, expected_type Type) Bool = {
 return when constructor_type in {
 .StructureType(def_id) then when expected_type in {
 .StructureType(expected_def_id) then def_id.id == expected_def_id.id,
 .GenericStruct(template_name, _, _) then self.context().def_id_name_equals(def_id, template_name),
 _ then false,
 },
 .GenericStruct(template_name, _, _) then when expected_type in {
 .GenericStruct(expected_template, _, _) then template_name == expected_template,
 .StructureType(expected_def_id) then self.context().def_id_name_equals(expected_def_id, template_name),
 _ then false,
 },
 _ then false,
 };
 };

 module_private resolved_constructor_type_or_unknown(self, callee Expr, scope Scope) Type = {
 return when callee in {
 .Identifier(name, _) then when self.try_resolve_named_type_in_scope_without_diag(name, scope) in {
 .Some(t) then t,
 .None() then Type.Unknown(),
 },
 .GenericInstantiation(base, type_args, _) then {
 let resolved_base = self.try_resolve_named_type_in_scope_without_diag(base, scope) or else {
 return Type.Unknown();
 };
 let mutable resolved_args = List[Type].new();
 for type_arg in type_args then {
 resolved_args.push(self.resolve_type_in_scope(type_arg, scope));
 };
 yield when resolved_base in {
         .StructureType(def_id) then {
             let template_name = self.context().get_template_name(def_id) or else base;
             let template_def_id = self.context().get_template_def_id(def_id);
             yield Type.GenericStruct(template_name, if template_def_id.is_valid() then template_def_id else def_id, resolved_args);
         },
         .EnumType(def_id) then {
             let template_name = self.context().get_template_name(def_id) or else base;
             let template_def_id = self.context().get_template_def_id(def_id);
             yield Type.GenericEnum(template_name, if template_def_id.is_valid() then template_def_id else def_id, resolved_args);
         },
         .GenericStruct(template_name, template_def_id, _) then Type.GenericStruct(template_name, template_def_id, resolved_args),
         .GenericEnum(template_name, template_def_id, _) then Type.GenericEnum(template_name, template_def_id, resolved_args),
 _ then resolved_base,
 };
 },
 _ then Type.Unknown(),
 };
 };

 module_private option_type_or_unknown(self, value Option[Type]) Type = {
 return when value in {
 .Some(t) then t,
 .None() then Type.Unknown(),
 };
 };

 module_private resolve_expected_constructor_param_types(self, callee Expr, expected Option[Type], scope Scope) List[Type] = {
 if expected is .Some(expected_type) then {
 when callee in {
 .MemberPath(_, path, _) then {
 if not path.is_empty() then {
 let enum_case_param_types = self.get_enum_case_field_types(expected_type, path[path.count() - 1(UInt)]);
 if not enum_case_param_types.is_empty() then {
 return enum_case_param_types;
 };
 };
 },
 .StaticMethodCall(_, _, method_name, _, _) then {
 let enum_case_param_types = self.get_enum_case_field_types(expected_type, method_name);
 if not enum_case_param_types.is_empty() then {
 return enum_case_param_types;
 };
 },
 _ then {},
 };
 };

 let mutable constructor_type = self.resolved_constructor_type_or_unknown(callee, scope);
 if constructor_type is .Unknown() then {
 return List[Type].new();
 };

 let direct_param_types = self.constructor_direct_param_types(constructor_type);
 if expected is .Some(_) then {
 let mutable expected_type = self.option_type_or_unknown(expected);
 if not (expected_type is .Unknown()) and self.constructor_matches_expected_type(constructor_type, expected_type) then {
 return self.struct_constructor_param_types(expected_type);
 };
 } else if not direct_param_types.is_empty() then {
 return direct_param_types;
 };
 return direct_param_types;
 };

 module_private infer_generic_function_bindings(self, callee Expr, typed_callee TypedExpr, typed_args List[TypedExpr], scope Scope) Option[Dict[String, Type]] = {
 let template = self.generic_function_template_for_callee(typed_callee) or else {
 return Option[Dict[String, Type]].None();
 };
 if template.type_parameters.is_empty() then {
 return Option[Dict[String, Type]].None();
 };

 let explicit_type_args = self.explicit_generic_function_type_args(callee, scope);
 let mutable bindings = Dict[String, Type].new();

 if not explicit_type_args.is_empty() then {
 if explicit_type_args.count() <> template.type_parameters.count() then {
 self.storage.diagnostics.push(
 make_diagnostic(
 DiagnosticStage.Semantic(),
 self.storage.file_path,
 "Type mismatch: expected \(template.type_parameters.count()) generic arguments, got \(explicit_type_args.count())"
 
 )
 );
 return Option[Dict[String, Type]].None();
 };
 let mutable idx UInt = 0;
 while idx < template.type_parameters.count() then {
 bindings.insert(template.type_parameters[idx].name, explicit_type_args[idx]);
 idx += 1;
 };
 } else {
 let mutable generic_scope = Scope.new_child(self.storage.global_scope);
 for tp in template.type_parameters then {
 generic_scope.define_type(tp.name, Type.GenericParameter(tp.name));
 };
 let mutable idx UInt = 0;
 while idx < template.parameters.count() and idx < typed_args.count() then {
 let mutable expected_type = self.resolve_type_in_scope(template.parameters[idx].param_type, generic_scope);
 bindings = self.infer_type_bindings_persistent(expected_type, typed_args[idx].expr_type, bindings);
 idx += 1;
 };
 };

 return Option[Dict[String, Type]].Some(bindings);
 };

 module_private resolve_generic_function_call_return_type(
 self,
 callee Expr,
 typed_callee TypedExpr,
 typed_args List[TypedExpr],
 expected Option[Type],
 scope Scope,
 inferred_bindings Dict[String, Type],
 ) Option[Type] = {
 let template = self.generic_function_template_for_callee(typed_callee) or else {
 return Option[Type].None();
 };
 if template.type_parameters.is_empty() then {
 return Option[Type].None();
 };
 let mutable bindings = inferred_bindings;
 if bindings.is_empty() then {
 bindings = self.infer_generic_function_bindings(callee, typed_callee, typed_args, scope) or else {
 return Option[Type].None();
 };
 };

 let mutable generic_scope = Scope.new_child(self.storage.global_scope);
 for tp in template.type_parameters then {
 generic_scope.define_type(tp.name, Type.GenericParameter(tp.name));
 };
 let generic_return_type = when template.checked_return_type in {
 .Some(return_type) then return_type,
 .None() then self.resolve_type_in_scope(template.return_type, generic_scope),
 };
 when expected in {
 .Some(expected_type) then {
 bindings = self.infer_type_bindings_persistent(generic_return_type, expected_type, bindings);
 },
 .None() then {},
 };
 return Option[Type].Some(self.apply_type_bindings(generic_return_type, bindings));
 };

 module_private validate_generic_function_call_constraints(
 self,
 callee Expr,
 typed_callee TypedExpr,
 typed_args List[TypedExpr],
 scope Scope,
 inferred_bindings Dict[String, Type],
 ) Void = {
 when self.generic_function_template_for_callee(typed_callee) in {
 .Some(template) then {
 if template.type_parameters.is_empty() then {
 } else {
 let bindings = if inferred_bindings.is_empty() then self.infer_generic_function_bindings(callee, typed_callee, typed_args, scope) else Option[Dict[String, Type]].Some(inferred_bindings);
 when bindings in {
 .Some(resolved_bindings) then {
 for tp in template.type_parameters then {
 if resolved_bindings.get(tp.name) is .Some(bound_type) then {
 for constraint in tp.constraints then {
 let trait_name = self.type_node_name(constraint);
 if not (trait_name == "Any") then {
 let trait_args = self.trait_type_args_with_bindings(constraint, resolved_bindings);
 when self.storage.trait_registry.get(trait_name) in {
 .Some(info) then {
 if self.make_visibility_checker() is .Some(checker) then {
 when checker.check_symbol(info.module_path, trait_name, false) in {
 .Ok(_) then {},
 .Error(message) then {
 self.push_typed_expr_diagnostic(typed_callee, message.message());
 return;
 },
 };
 };
 },
 .None() then {},
 };
 if trait_args.is_empty() then {
 let _ = self.enforce_explicit_trait_requirement_with_context(bound_type, trait_name, tp.name);
 } else {
 let _ = self.enforce_explicit_generic_trait_conformance(bound_type, trait_name, trait_args);
 };
 };
 };
 };
 };
 },
 .None() then {
 },
 };
 };
 },
 .None() then {
 },
 };
 };

 module_private is_mutable_ref_like_type(self, t Type) Bool = {
 return when t in {
 .MutableReferenceType(_) then true,
 .MutableBorrowedReferenceType(_) then true,
 .MutablePointerType(_) then true,
 .MutableWeakReferenceType(_) then true,
 _ then false,
 };
 };

 module_private is_read_only_ref_like_type(self, t Type) Bool = {
 return when t in {
 .ReferenceType(_) then true,
 .BorrowedReferenceType(_) then true,
 .PointerType(_) then true,
 .WeakReferenceType(_) then true,
 _ then false,
 };
 };

 module_private can_take_mutable_ref_of_expr(self, expr TypedExpr) Bool = {
 return when expr.expr_kind in {
 .Variable(sym) then {
 if self.is_mutable_ref_like_type(sym.symbol_type) then {
 return true;
 };
 return sym.is_mutable();
 },
 .MemberPath(base, path) then {
 let mutable current = base.expr_type;
 let mutable mutable_path = self.can_take_mutable_ref_of_expr(base);
 let mutable idx UInt = 0;
 while idx < path.count() then {
 let segment = path[idx];
 let is_last = idx + 1(UInt) == path.count();
 let mutable segment_type = segment.symbol_type;
 if self.is_mutable_ref_like_type(current) then {
 mutable_path = true;
 if is_last then {
 return segment.is_mutable() or self.is_mutable_ref_like_type(segment_type);
 };
 } else if self.is_read_only_ref_like_type(current) then {
 mutable_path = false;
 if is_last then {
 return false;
 };
 } else if is_last then {
 return mutable_path and segment.is_mutable();
 } else if not segment.is_mutable() and not self.is_mutable_ref_like_type(segment_type) then {
 mutable_path = false;
 };
 current = segment_type;
 idx += 1(UInt);
 };
 yield false;
 },
 .DerefExpr(inner) then self.is_mutable_ref_like_type(inner.expr_type),
 .UnsafeDerefExpr(inner) then self.is_mutable_ref_like_type(inner.expr_type),
 _ then false,
 };
 };

 module_private can_take_ref_of_expr(self, expr TypedExpr) Bool = {
 return when expr.expr_kind in {
 .Variable(sym) then {
 when sym.kind in {
 .Variable(variable_kind) then if variable_kind is .SubscriptBaseBorrowAlias() then {
 return true;
 },
 _ then {},
 };
 if sym.is_mutable() then {
 return true;
 };
 yield when sym.symbol_type in {
 .ReferenceType(_) then true,
 .MutableReferenceType(_) then true,
 .BorrowedReferenceType(_) then true,
 .MutableBorrowedReferenceType(_) then true,
 .PointerType(_) then true,
 .MutablePointerType(_) then true,
 _ then false,
 };
 },
 .MemberPath(base, path) then {
 let mutable current = base.expr_type;
 let mutable can_take = when current in {
 .ReferenceType(_) then true,
 .MutableReferenceType(_) then true,
 .BorrowedReferenceType(_) then true,
 .MutableBorrowedReferenceType(_) then true,
 .PointerType(_) then true,
 .MutablePointerType(_) then true,
 _ then self.can_take_ref_of_expr(base),
 };
 let mutable idx UInt = 0;
 while not can_take and idx < path.count() then {
 let mutable segment_type = path[idx].symbol_type;
 can_take = self.is_ref_like_assignment_type(current) or self.is_ref_like_assignment_type(segment_type);
 current = segment_type;
 idx += 1;
 };
 yield can_take;
 },
 .DerefExpr(inner) then when inner.expr_type in {
 .ReferenceType(_) then true,
 .MutableReferenceType(_) then true,
 .BorrowedReferenceType(_) then true,
 .MutableBorrowedReferenceType(_) then true,
 .PointerType(_) then true,
 .MutablePointerType(_) then true,
 _ then false,
 },
 .UnsafeDerefExpr(inner) then when inner.expr_type in {
 .ReferenceType(_) then true,
 .MutableReferenceType(_) then true,
 .BorrowedReferenceType(_) then true,
 .MutableBorrowedReferenceType(_) then true,
 .PointerType(_) then true,
 .MutablePointerType(_) then true,
 _ then false,
 },
 _ then false,
 };
 };

 module_private render_call_site_expr_text(self, expr Expr) Option[String] = {
 return when expr in {
 .Identifier(name, _) then Option[String].Some(name),
 .StringLiteral(value, _) then Option[String].Some("\"" + value + "\""),
 .IntegerLiteral(value, _) then Option[String].Some(value),
 .FloatLiteral(value, _) then Option[String].Some(value),
 .BoolLiteral(value, _) then if value then Option[String].Some("true") else Option[String].Some("false"),
 .MemberPath(base, path, _) then if self.render_call_site_expr_text(base) is .Some(base_text) then {
 let mutable out = base_text;
 for part in path then {
 out = out + "." + part;
 };
 yield Option[String].Some(out);
 } else {
 yield Option[String].None();
 },
 _ then Option[String].None(),
 };
 };

 module_private call_site_lookup_text(self, callee Expr, args List[Expr]) Option[String] = {
 if self.render_call_site_expr_text(callee) is .Some(callee_text) then {
 let mutable rendered_args = List[String].new();
 let mutable all_args_rendered = true;
 for arg in args then {
 when self.render_call_site_expr_text(arg) in {
 .Some(arg_text) then rendered_args.push(arg_text),
 .None() then {
 all_args_rendered = false;
 break;
 },
 };
 };
 if all_args_rendered then {
 let mutable rendered_call = callee_text + "(";
 let mutable idx UInt = 0;
 while idx < rendered_args.count() then {
 if idx > 0 then {
 rendered_call = rendered_call + ", ";
 };
 rendered_call = rendered_call + rendered_args[idx];
 idx += 1;
 };
 rendered_call = rendered_call + ")";
 return Option[String].Some(rendered_call);
 };
 return Option[String].Some(callee_text + "(");
 };

 return when callee in {
 .Identifier(name, _) then Option[String].Some(name + "("),
 .MemberPath(_, path, _) then if path.is_empty() then Option[String].None() else Option[String].Some(path[path.count() - 1(UInt)] + "("),
 .StaticMethodCall(_, _, method_name, _, _) then Option[String].Some(method_name + "("),
 _ then Option[String].None(),
 };
 };

 module_private find_call_site_prefix(self, callee Expr, args List[Expr]) Option[String] = {
 let needle = self.call_site_lookup_text(callee, args) or else {
 return Option[String].None();
 };
 let source = read_text_file(self.storage.file_path.into_path()) or else {
 return Option[String].None();
 };

 let mutable line_no UInt = 1;
 for line in source.lines() then {
 if line.find(needle) is .Some(col0) then {
 return Option[String].Some("\(self.storage.file_path):\(line_no):\(col0 + 1): error: ");
 };
 line_no += 1;
 };

 return Option[String].None();
 };

 module_private format_call_type_mismatch_message(self, callee Expr, args List[Expr], expected_t Type, actual_t Type) String = {
 let expected_name = self.display_type_name(expected_t);
 let actual_name = self.display_type_name(actual_t);
 let suffix = "Type mismatch: expected \(expected_name), got \(actual_name)";
 return when self.find_call_site_prefix(callee, args) in {
 .Some(prefix) then prefix + suffix,
 .None() then suffix,
 };
 };

 module_private function_like_type(self, t Type) Option[Type] = {
 return when t in {
 .FunctionType(_, _) then Option[Type].Some(t),
 .ReferenceType(inner) then self.function_like_type(inner),
 .MutableReferenceType(inner) then self.function_like_type(inner),
 .BorrowedReferenceType(inner) then self.function_like_type(inner),
 .MutableBorrowedReferenceType(inner) then self.function_like_type(inner),
 .WeakReferenceType(inner) then self.function_like_type(inner),
 .MutableWeakReferenceType(inner) then self.function_like_type(inner),
 _ then Option[Type].None(),
 };
 };

 module_private validate_function_expression_argument_count(self, typed_callee TypedExpr, args List[Expr]) Bool = {
 // Skip validation for method-like callees — self is implicit, validated separately.
 when typed_callee.expr_kind in {
 .MethodReference(_, _, _, _, _, _) then { return true;},
 .TraitMethodPlaceholder(_, _, _, _, _) then { return true;},
 .TraitMethodCall(_, _, _, _, _) then { return true;},
 _ then {},
 };
 let callable_type = self.function_like_type(typed_callee.expr_type) or else {
 return true;
 };
 let param_count = when callable_type in {
 .FunctionType(fn_params, _) then fn_params.count(),
 _ then 0(UInt),
 };
 if not (callable_type is .FunctionType(_, _)) then {
 return true;
 };
 if args.count() <> param_count then {
 self.storage.diagnostics.push(
 make_diagnostic(
 DiagnosticStage.Semantic(),
 self.storage.file_path,
 "Invalid argument count for function expression: expected \(param_count), got \(args.count())"
 
 )
 );
 return false;
 };
 return true;
 };

 module_private positional_param_specs_for_function_type(self, fn_type Type) List[FunctionParamSpec] = {
 return when fn_type in {
 .FunctionType(fn_params, _) then {
 let param_types = param_entry_types(fn_params);
 let mutable specs = List[FunctionParamSpec].new();
 for _ in param_types then {
 specs.push(FunctionParamSpec("", false, false, false));
 };

 return specs;
 },
 _ then List[FunctionParamSpec].new(),
 };
 };

 module_private positional_param_specs_for_count(self, count UInt) List[FunctionParamSpec] = {
 let mutable specs = List[FunctionParamSpec].new();
 let mutable index UInt = 0;
 while index < count then {
 specs.push(FunctionParamSpec("", false, false, false));
 index += 1;
 };
 return specs;
 };

 module_private drop_first_param_specs(self, specs List[FunctionParamSpec]) List[FunctionParamSpec] = {
 let mutable out = List[FunctionParamSpec].new();
 let mutable index UInt = 1;
 while index < specs.count() then {
 out.push(specs[index]);
 index += 1;
 };
 return out;
 };

 module_private normalize_param_specs_for_count(self, specs List[FunctionParamSpec], expected_count UInt) List[FunctionParamSpec] = {
 if specs.count() == expected_count + 1(UInt) and not specs.is_empty() and specs[0(UInt)].name == "self" then {
 return self.drop_first_param_specs(specs);
 };
 if specs.count() == expected_count then {
 return specs;
 };
 return self.positional_param_specs_for_count(expected_count);
 };

 module_private declared_call_param_count(self, specs List[FunctionParamSpec]) UInt = {
 if not specs.is_empty() and specs[0(UInt)].name == "self" then {
 return if specs.count() <= 1(UInt) then 0(UInt) else specs.count() - 1(UInt);
 };
 return specs.count();
 };

 module_private drop_receiver_param_specs(self, method Symbol) List[FunctionParamSpec] = {
 let param_specs = self.context().get_param_specs(method.def_id) or else List[FunctionParamSpec].new();
 let expected_count = if self.method_param_count(method) == 0(UInt) then 0(UInt) else self.method_param_count(method) - 1(UInt);
 return self.normalize_param_specs_for_count(param_specs, expected_count);
 };

 module_private owner_type_name_for_type(self, owner_type Type) Option[String] = {
 return when owner_type in {
 .StructureType(def_id) then self.context().get_name(def_id),
 .EnumType(def_id) then self.context().get_name(def_id),
 .GenericStruct(template_name, _, _) then Option[String].Some(template_name),
 .GenericEnum(template_name, _, _) then Option[String].Some(template_name),
 .GenericParameter(name) then Option[String].Some(name),
 .ReferenceType(inner) then self.owner_type_name_for_type(inner),
 .MutableReferenceType(inner) then self.owner_type_name_for_type(inner),
 .BorrowedReferenceType(inner) then self.owner_type_name_for_type(inner),
 .MutableBorrowedReferenceType(inner) then self.owner_type_name_for_type(inner),
 .WeakReferenceType(inner) then self.owner_type_name_for_type(inner),
 .MutableWeakReferenceType(inner) then self.owner_type_name_for_type(inner),
 _ then Option[String].None(),
 };
 };

 module_private trait_name_for_type(self, trait_type Type) String = {
 return when trait_type in {
 .TraitObject(trait_name, _, _) then trait_name,
 _ then self.context().type_display_name(trait_type),
 };
 };

 module_private struct_constructor_param_specs(self, constructor_type Type) List[FunctionParamSpec] = {
 let inner_type = when constructor_type in {
 .ReferenceType(inner) then inner,
 .MutableReferenceType(inner) then inner,
 .BorrowedReferenceType(inner) then inner,
 .MutableBorrowedReferenceType(inner) then inner,
 .WeakReferenceType(inner) then inner,
 .MutableWeakReferenceType(inner) then inner,
 _ then constructor_type,
 };
 return when inner_type in {
 .StructureType(def_id) then when self.context().get_struct_fields(def_id) in {
 .Some(fields) then {
 let mutable specs = List[FunctionParamSpec].new();
 for field in fields then {
 let type_name = self.context().get_name(def_id) or else "";
 let key1 = "\(type_name).\(field.name)";
 let has_def = self.context().parsed_default_values.contains_key(key1) or self.context().parsed_default_values.contains_key(field.name);
 specs.push(FunctionParamSpec(field.name, field.is_mutable, field.named, has_def));
 };
 yield specs;
 },
 .None() then List[FunctionParamSpec].new(),
 },
 .GenericStruct(template_name, template_def_id, _) then {
 let resolved_def_id = if template_def_id.is_valid() then template_def_id else self.storage.generic_templates.lookup_struct_def_id(template_name);
 let fields = self.context().get_struct_fields(resolved_def_id) or else List[StructField].new();
 let mutable specs = List[FunctionParamSpec].new();
 for field in fields then {
 let type_name = self.context().get_name(resolved_def_id) or else "";
 let key1 = "\(type_name).\(field.name)";
 let has_def = self.context().parsed_default_values.contains_key(key1) or self.context().parsed_default_values.contains_key(field.name);
 specs.push(FunctionParamSpec(field.name, field.is_mutable, field.named, has_def));
 };
 return specs;
 },
 _ then List[FunctionParamSpec].new(),
 };
 };

 module_private enum_case_param_specs(self, enum_type Type, case_name String) List[FunctionParamSpec] = {
 let inner_type = when enum_type in {
 .ReferenceType(inner) then inner,
 .MutableReferenceType(inner) then inner,
 .BorrowedReferenceType(inner) then inner,
 .MutableBorrowedReferenceType(inner) then inner,
 .WeakReferenceType(inner) then inner,
 .MutableWeakReferenceType(inner) then inner,
 _ then enum_type,
 };
 return when inner_type in {
 .EnumType(DefId(def_id)) then self.context().enum_case_param_specs_by_raw_id(def_id(UInt), case_name),
 .GenericEnum(_, template_def_id, _) then when self.context().get_kind(template_def_id) in {
 .Some(_) then self.context().enum_case_param_specs_by_raw_id(template_def_id.id, case_name),
 .None() then List[FunctionParamSpec].new(),
 },
 _ then List[FunctionParamSpec].new(),
 };
 };

 module_private static_member_is_enum_case(self, receiver_type Type, member_name String) Bool = {
 let inner_type = when receiver_type in {
 .ReferenceType(inner) then inner,
 .MutableReferenceType(inner) then inner,
 .BorrowedReferenceType(inner) then inner,
 .MutableBorrowedReferenceType(inner) then inner,
 .WeakReferenceType(inner) then inner,
 .MutableWeakReferenceType(inner) then inner,
 _ then receiver_type,
 };
 return when inner_type in {
  .EnumType(DefId(def_id)) then self.context().enum_has_case_by_raw_id(def_id(UInt), member_name),
 .GenericEnum(template_name, _, _) then when self.storage.generic_templates.lookup_enum(template_name) in {
 .Some(enum_template) then self.context().enum_has_case_by_raw_id(enum_template.def_id.id, member_name),
 .None() then false,
 },
 _ then false,
 };
 };

 module_private resolve_static_call_param_specs(self, type_name String, method_name String) List[FunctionParamSpec] = {
 let bound_specs = self.resolve_generic_bound_method_param_specs(type_name, method_name);
 if not bound_specs.is_empty() then {
 return bound_specs;
 };
 when self.context().get_method_param_specs(type_name, method_name) in {
 .Some(specs) then { return specs; },
 .None() then {},
 };
 if self.lookup_method_signature(type_name, method_name) is .Some(method) then {
 return self.context().get_param_specs(method.def_id) or else List[FunctionParamSpec].new();
 };
 return when self.try_resolve_named_type_without_diag(type_name) in {
 .Some(receiver_type) then self.enum_case_param_specs(receiver_type, method_name),
 .None() then List[FunctionParamSpec].new(),
 };
 };

 module_private resolve_qualified_method_param_specs(self, trait_name String, method_name String) List[FunctionParamSpec] = {
 when self.storage.trait_registry.flatten_methods(trait_name) in {
 .Ok(methods) then {
 if methods.get(method_name) is .Some(member) then {
 let mutable specs = List[FunctionParamSpec].new();
 let mutable idx UInt = if member.params.is_empty() or member.params[0(UInt)].name <> "self" then 0(UInt) else 1(UInt);
 while idx < member.params.count() then {
 let p = member.params[idx];
 specs.push(FunctionParamSpec(p.name, p.is_mutable, p.named, false));
 idx += 1;
 };
 return specs;
 };
 },
 .Error(_) then {},
 };
 return when self.lookup_method_signature(trait_name, method_name) in {
 .Some(sig) then self.drop_receiver_param_specs(sig),
 .None() then List[FunctionParamSpec].new(),
 };
 };

module_private resolve_generic_bound_method_param_specs(self, type_name String, method_name String) List[FunctionParamSpec] = {
 when self.storage.generic_param_constraints.get(type_name) in {
 .Some(bounds) then {
 for bound in bounds then {
 let specs = self.resolve_qualified_method_param_specs(bound.trait_name, method_name);
 if not specs.is_empty() then {
 return specs;
 };
 };
 },
 .None() then {},
 };
 return List[FunctionParamSpec].new();
 };

 module_private resolve_identifier_call_param_specs(self, name String, typed_callee TypedExpr) List[FunctionParamSpec] = {
 if typed_callee.expr_kind is .Variable(sym) then {
 if sym.kind is .TypeSymbol() then {
 return self.struct_constructor_param_specs(sym.symbol_type);
 };
 if self.context().get_param_specs(sym.def_id) is .Some(specs) then {
 return specs;
 };
 let constructor_specs = self.struct_constructor_param_specs(sym.symbol_type);
 if not constructor_specs.is_empty() then {
 return constructor_specs;
 };
 return List[FunctionParamSpec].new();
 };
 return self.positional_param_specs_for_function_type(typed_callee.expr_type);
 };

 module_private resolve_method_call_param_specs(self, base_type Type, method Symbol, callee_type Type) List[FunctionParamSpec] = {
 let method_name = self.context().symbol_name(method);
 when self.find_trait_constraint_for_method(base_type, method_name) in {
 .Some(trait_name) then {
 return self.resolve_qualified_method_param_specs(trait_name, method_name);
 },
 .None() then {},
 };
 let owner_name = self.owner_type_name_for_type(base_type) or else "";
 let owner_specs = self.context().get_method_param_specs(owner_name, method_name);
 let expected_count = when owner_specs in {
 .Some(specs) then self.declared_call_param_count(specs),
 .None() then {
 let signature = self.resolve_method_signature(base_type, method_name);
 yield when signature in {
 .Some(sig) then if self.method_param_count(sig) == 0(UInt) then 0(UInt) else self.method_param_count(sig) - 1(UInt),
 .None() then if self.method_param_count(method) == 0(UInt) then 0(UInt) else self.method_param_count(method) - 1(UInt),
 };
 },
 };
 let resolved_specs = when owner_specs in {
 .Some(specs) then self.normalize_param_specs_for_count(specs, expected_count),
 .None() then self.normalize_param_specs_for_count(self.context().get_param_specs(method.def_id) or else List[FunctionParamSpec].new(), expected_count),
 };
 if not resolved_specs.is_empty() then {
 return resolved_specs;
 };
 return self.positional_param_specs_for_count(expected_count);
 };

 module_private resolve_call_param_specs(self, callee Expr, typed_callee TypedExpr, scope Scope) List[FunctionParamSpec] = {
 when callee in {
 .Identifier(name, _) then {
 return self.resolve_identifier_call_param_specs(name, typed_callee);
 },
 .GenericInstantiation(base, _, _) then {
 return when self.try_resolve_named_type_in_scope_without_diag(base, scope) in {
 .Some(constructor_type) then self.struct_constructor_param_specs(constructor_type),
 .None() then self.positional_param_specs_for_function_type(typed_callee.expr_type),
 };
 },
 .MemberPath(base_expr, path, _) then {
 when base_expr in {
 .Identifier(base_name, _) then {
 if not path.is_empty() then {
 let bound_specs = self.resolve_generic_bound_method_param_specs(base_name, path[path.count() - 1(UInt)]);
 if not bound_specs.is_empty() then {
 return bound_specs;
 };
 };
 },
 _ then {},
 };
 return when typed_callee.expr_kind in {
 .TraitMethodPlaceholder(_, trait_type, method, _, _) then self.resolve_qualified_method_param_specs(self.trait_name_for_type(trait_type), self.context().symbol_name(method)),
 .MethodReference(base, _, method, _, _, _) then self.resolve_method_call_param_specs(base.expr_type, method, typed_callee.expr_type),
 .MemberPath(base, path) then if not path.is_empty() then {
 return when self.resolve_method_signature(base.expr_type, self.context().symbol_name(path[path.count() - 1(UInt)])) in {
 .Some(sig) then self.drop_receiver_param_specs(sig),
 .None() then self.positional_param_specs_for_function_type(typed_callee.expr_type),
 };
 } else self.positional_param_specs_for_function_type(typed_callee.expr_type),
 _ then self.positional_param_specs_for_function_type(typed_callee.expr_type),
 };
 },
 .QualifiedMethodCall(_, trait_type_node, method_name, _, _) then {
 return self.resolve_qualified_method_param_specs(self.type_node_name(trait_type_node), method_name);
 },
 .QualifiedGenericMethodCall(_, trait_type_node, _, method_name, _, _) then {
 return self.resolve_qualified_method_param_specs(self.type_node_name(trait_type_node), method_name);
 },
 .StaticMethodCall(type_name, _, method_name, _, _) then {
 return self.resolve_static_call_param_specs(type_name, method_name);
 },
 _ then {},
 };
 return self.positional_param_specs_for_function_type(typed_callee.expr_type);
 };

 module_private call_description_for_expr(self, callee Expr) String = {
 return when callee in {
 .Identifier(name, _) then name,
 .MemberPath(_, path, _) then if path.is_empty() then "function expression" else path[path.count() - 1(UInt)],
 .StaticMethodCall(_, _, method_name, _, _) then method_name,
 .QualifiedMethodCall(_, _, method_name, _, _) then method_name,
 .QualifiedGenericMethodCall(_, _, _, method_name, _, _) then method_name,
 _ then "function expression",
 };
 };

 module_private call_defaults_prefix_for_expr(self, callee Expr) String = {
 return when callee in {
 .Identifier(name, _) then name,
 .MemberPath(_, path, _) then if path.is_empty() then "" else path[path.count() - 1(UInt)],
 .StaticMethodCall(_, _, method_name, _, _) then method_name,
 .QualifiedMethodCall(_, _, method_name, _, _) then method_name,
 .QualifiedGenericMethodCall(_, _, _, method_name, _, _) then method_name,
 _ then "",
 };
 };

 module_private call_argument_expr(self, arg Expr) Expr = {
 return when arg in {
 .NamedArgument(_, inner, _) then inner,
 _ then arg,
 };
 };

 module_private lookup_default_value(self, defaults_key_prefix String, param_name String) Option[String] = {
 let exact_key = "\(defaults_key_prefix).\(param_name)";
 let exact = self.context().parsed_default_values.get(exact_key);
 if exact is .Some(_) then {
 return exact;
 };
 let bare = self.context().parsed_default_values.get(param_name);
 if bare is .Some(_) then {
 return bare;
 };
 let method_suffix = ".\(defaults_key_prefix).\(param_name)";
 for kv in self.context().parsed_default_values.iterator() then {
 if kv.first.ends_with(method_suffix) then {
 return Option[String].Some(kv.second);
 };
 };
 let param_suffix = ".\(param_name)";
 for kv in self.context().parsed_default_values.iterator() then {
 if kv.first.ends_with(param_suffix) then {
 return Option[String].Some(kv.second);
 };
 };
 return Option[String].None();
 };

 module_private plan_call_argument_exprs(
 self,
 args List[Expr],
 param_specs List[FunctionParamSpec],
 call_description String,
 defaults_key_prefix String,
 ) Option[List[Expr]] = {
 let mutable ordered = List[Option[Expr]].new();
 for _ in param_specs then {
 ordered.push(Option[Expr].None());
 };
 let mutable positional_index UInt = 0;
 let mutable seen_named = false;
 for arg in args then {
 when arg in {
 .NamedArgument(label, _, _) then {
 seen_named = true;
 let mutable field_index UInt = 0;
 let mutable found = false;
 while field_index < param_specs.count() then {
 if param_specs[field_index].name == label then {
 found = true;
 break;
 };
 field_index += 1;
 };
 if not found then {
 self.push_diagnostic_at_span("Unknown named argument '\(label)' for '\(call_description)'", expr_span(arg));
 return Option[List[Expr]].None();
 };
 if not param_specs[field_index].named then {
 self.push_diagnostic_at_span("Parameter '\(label)' is positional and cannot be passed by label", expr_span(arg));
 return Option[List[Expr]].None();
 };
 if ordered[field_index] is .Some(_) then {
 self.push_diagnostic_at_span("Duplicate argument '\(label)'", expr_span(arg));
 return Option[List[Expr]].None();
 };
 ordered[field_index] = Option[Expr].Some(self.call_argument_expr(arg));
 },
 _ then {
 if seen_named then {
 self.push_diagnostic_at_span("Positional argument cannot appear after named argument in call to '\(call_description)'", expr_span(arg));
 return Option[List[Expr]].None();
 };
 while positional_index < param_specs.count() and param_specs[positional_index].named then {
 positional_index += 1;
 };
 if positional_index >= param_specs.count() then {
 let mutable required_index UInt = 0;
 let mutable reported = false;
 while required_index < param_specs.count() then {
 if param_specs[required_index].named and ordered[required_index] is .None() then {
 self.push_diagnostic_at_span("Named parameter '\(param_specs[required_index].name)' must be passed by label", expr_span(arg));
 reported = true;
 break;
 };
 required_index += 1;
 };
 if not reported then {
 self.push_diagnostic_at_span("Too many positional arguments in call to '\(call_description)'", expr_span(arg));
 };
 return Option[List[Expr]].None();
 };
 ordered[positional_index] = Option[Expr].Some(self.call_argument_expr(arg));
 positional_index += 1;
 },
 };
 };

 let mutable expressions = List[Expr].new();
 let mutable index UInt = 0;
 while index < param_specs.count() then {
 let spec = param_specs[index];
 when ordered[index] in {
 .Some(expr) then expressions.push(expr),
 .None() then {
 let default_value = self.lookup_default_value(defaults_key_prefix, spec.name);
 when default_value in {
 .Some(value) then expressions.push(self.make_default_value_expr(value, unknown_span())),
 .None() then {
 let message = if spec.named then {
 yield "Missing named argument '\(spec.name)' for '\(call_description)'; provide '\(spec.name):' or declare a default value";
 } else {
 yield "Missing positional argument '\(spec.name)' for '\(call_description)'";
 };
 let diagnostic_span = if args.is_empty() then unknown_span() else expr_span(args[0(UInt)]);
 self.push_diagnostic_at_span(message, diagnostic_span);
 return Option[List[Expr]].None();
 },
 };
 },
 };
 index += 1;
 };
 return Option[List[Expr]].Some(expressions);
 };


 module_private validate_call_argument_order(self, args List[Expr]) Bool = {
 let mutable seen_named = false;
 for arg in args then {
 when arg in {
 .NamedArgument(_, _, _) then {
 seen_named = true;
 },
 _ then {
 if seen_named then {
 self.storage.diagnostics.push(
 make_diagnostic(
 DiagnosticStage.Semantic(),
 self.storage.file_path,
 "Positional arguments are not allowed after named arguments"
 
 )
 );
 return false;
 };
 },
 };
 };
 return true;
 };

 module_private validate_named_param_call_labels(self, args List[Expr], param_specs List[FunctionParamSpec]) Bool = {
 let mutable arg_idx UInt = 0;
 for arg in args then {
 if arg_idx < param_specs.count() then {
 let spec = param_specs[arg_idx];
 when arg in {
 .NamedArgument(label, _, _) then {
 if not spec.named then {
 self.storage.diagnostics.push(
 make_diagnostic(
 DiagnosticStage.Semantic(),
 self.storage.file_path,
 "Positional argument provided for named field '\(spec.name)'"
 
 )
 );
 return false;
 };
 if label <> spec.name then {
 self.storage.diagnostics.push(
 make_diagnostic(
 DiagnosticStage.Semantic(),
 self.storage.file_path,
 "Named argument label '\(label)' does not match parameter '\(spec.name)'"
 
 )
 );
 return false;
 };
 },
 _ then {
 if spec.named then {
 self.storage.diagnostics.push(
 make_diagnostic(
 DiagnosticStage.Semantic(),
 self.storage.file_path,
 "Named parameter '\(spec.name)' must be called with label '\(spec.name):'"
 
 )
 );
 return false;
 };
 },
 };
 };
 arg_idx += 1;
 };
 return true;
 };

};
