given TypeChecker {
    protected should_defer_explicit_trait_check(self, t Type) Bool = {
        return when t in {
            .Unknown() then true,
            .TypeVar(_) then true,
            .GenericParameter(_) then true,
            _ then false,
        }
    }

    protected check_expr_scoped_ref(self, expr * Expr, expected Option[Type], scope Scope) TypedExpr = {
        let skip_call_family_expr = if self.skip_call_family_debug_enabled() then when expr in {
            .Call(_, _, _) then true,
            .GenericMethodCall(_, _, _, _, _) then true,
            .QualifiedMethodCall(_, _, _, _, _) then true,
            .QualifiedGenericMethodCall(_, _, _, _, _, _) then true,
            .StaticMethodCall(_, _, _, _, _) then true,
            _ then false,
        } else false
        if skip_call_family_expr then {
            return self.empty_typed_block(Type.Unknown())
        }
        let skip_member_path_expr = if self.skip_member_path_debug_enabled() then when expr in {
            .MemberPath(_, _, _) then true,
            _ then false,
        } else false
        if skip_member_path_expr then {
            return self.empty_typed_block(Type.Unknown())
        }
        // Use bidirectional inference for literals, lambdas, and collection expressions
        // when an expected type is available, to improve type inference.
        if expected is .Some(et) then {
            when expr in {
                .IntegerLiteral(value, _) then {
                    if self.is_numeric_type(et) then {
                        return make_typed_expr(TypedExprKind.IntegerLiteral(value), et)
                    }
                },
                .FloatLiteral(value, _) then {
                    if self.is_float_type(et) or self.is_numeric_type(et) then {
                        return make_typed_expr(TypedExprKind.FloatLiteral(value), et)
                    }
                },
                .RuneLiteral(value, _) then {
                    if self.is_integer_type(et) or self.is_rune_type(et) then {
                        return self.lower_rune_literal(value, .Some(et))
                    }
                },
                .LambdaExpr(params, return_type, body, span) then {
                    // 当期望类型是 FunctionType 时，使用双向推断
                    if et is .FunctionType(_, _) then {
                        return self.bidi_check_mode(expr, et, scope)
                    }
                },
                .CollectionLiteral(_, _) then {
                    // 当期望类型是泛型集合时，传播元素类型
                    if self.extract_collection_element_type(et) is .Some(_) then {
                        return self.bidi_check_mode(expr, et, scope)
                    }
                },
                .DictLiteral(_, _) then {
                    // 当期望类型是 Dict 时，传播 key/value 类型
                    if self.extract_dict_kv_types(et).first is .Some(_) then {
                        return self.bidi_check_mode(expr, et, scope)
                    }
                },
                .EmptyLiteral(_) then {
                    return self.lower_empty_literal_expr(Option[Type].Some(et))
                },
                .Call(callee, args, _) then when callee in {
                    .Identifier(name, _) then {
                        if name == "null_ptr" and args.is_empty() and (et is .PointerType(_) or et is .MutablePointerType(_)) then {
                            return make_typed_expr(TypedExprKind.IntrinsicCall(TypedIntrinsic.NullPtr(et)), et)
                        }
                    },
                    _ then {},
                },
                _ then {},
            }
        }
        return self.check_expr_core_ref(expr, expected, scope)
    }

    protected flatten_left_assoc_and_operands(self, expr * Expr) List[* Expr] = {
        let mutable reversed_tail = List[* Expr].new()
        let mutable current = expr
        while true then {
            when current in {
                .AndExpr(left, right, _) then {
                    reversed_tail.push(right)
                    current = left
                },
                _ then { break },
            }
        }
        let mutable operands = List[* Expr].new()
        operands.push(current)
        let mutable i = reversed_tail.count()
        while i > 0 then {
            i -= 1
            let operand = (*reversed_tail[i])
            operands.push(box(operand))
        }
        return operands
    }

    protected flatten_left_assoc_or_operands(self, expr * Expr) List[* Expr] = {
        let mutable reversed_tail = List[* Expr].new()
        let mutable current = expr
        while true then {
            when current in {
                .OrExpr(left, right, _) then {
                    reversed_tail.push(right)
                    current = left
                },
                _ then { break },
            }
        }
        let mutable operands = List[* Expr].new()
        operands.push(current)
        let mutable i = reversed_tail.count()
        while i > 0 then {
            i -= 1
            let operand = (*reversed_tail[i])
            operands.push(box(operand))
        }
        return operands
    }

    protected check_and_expr_iterative(self, expr * Expr, scope Scope) TypedExpr = {
        let operands = self.flatten_left_assoc_and_operands(expr)
        let mutable typed_operands = List[* TypedExpr].new()
        for operand in operands then {
            typed_operands.push(box(self.check_expr_scoped_ref(operand, .Some(Type.BoolType()), scope)))
        }
        if typed_operands.is_empty() then {
            return make_typed_expr(TypedExprKind.BoolLiteral(true), Type.BoolType())
        }
        let mutable current = (*typed_operands[0(UInt)])
        let mutable i UInt = 1
        while i < typed_operands.count() then {
            let right = (*typed_operands[i])
            current = make_typed_expr(TypedExprKind.AndExpr(box(current), box(right)), Type.BoolType())
            i += 1
        }
        return current
    }

    protected check_or_expr_iterative(self, expr * Expr, scope Scope) TypedExpr = {
        let operands = self.flatten_left_assoc_or_operands(expr)
        let mutable typed_operands = List[* TypedExpr].new()
        for operand in operands then {
            typed_operands.push(box(self.check_expr_scoped_ref(operand, .Some(Type.BoolType()), scope)))
        }
        if typed_operands.is_empty() then {
            return make_typed_expr(TypedExprKind.BoolLiteral(false), Type.BoolType())
        }
        let mutable current = (*typed_operands[0(UInt)])
        let mutable i UInt = 1
        while i < typed_operands.count() then {
            let right = (*typed_operands[i])
            current = make_typed_expr(TypedExprKind.OrExpr(box(current), box(right)), Type.BoolType())
            i += 1
        }
        return current
    }

    protected collect_bitwise_chain(self, left * Expr, op BitwiseOperator, right * Expr) Pair[List[* Expr], List[BitwiseOperator]] = {
        let mutable ops_rev = List[BitwiseOperator].new()
        let mutable rhs_rev = List[* Expr].new()
        let mutable current_left = left

        ops_rev.push(op)
        rhs_rev.push(right)

        while true then {
            when current_left in {
                .BitwiseExpr(next_left, next_op, next_right, _) then {
                    ops_rev.push(next_op)
                    rhs_rev.push(next_right)
                    current_left = next_left
                },
                _ then { break },
            }
        }

        let mutable operands = List[* Expr].new()
        operands.push(current_left)
        let mutable i = rhs_rev.count()
        while i > 0 then {
            i -= 1
            let operand = (*rhs_rev[i])
            operands.push(box(operand))
        }

        let mutable ops = List[BitwiseOperator].new()
        let mutable j = ops_rev.count()
        while j > 0 then {
            j -= 1
            ops.push(ops_rev[j])
        }

        return Pair[List[* Expr], List[BitwiseOperator]](operands, ops)
    }

    protected collect_if_chain(self, condition * Expr, then_branch * Expr, else_branch Option[* Expr]) IfChain = {
        let mutable arms = List[Pair[* Expr, * Expr]].new()
        arms.push(Pair[* Expr, * Expr](condition, then_branch))
        let mutable current_else = else_branch
        while true then {
            when current_else in {
                .Some(e) then {
                    when e in {
                        .IfExpr(next_cond, next_then, next_else, _) then {
                            arms.push(Pair[* Expr, * Expr](next_cond, next_then))
                            current_else = next_else
                        },
                        _ then {
                            return IfChain(arms, Option[* Expr].Some(e))
                        },
                    }
                },
                .None() then {
                    return IfChain(arms, Option[* Expr].None())
                },
            }
        }
        return IfChain(arms, Option[* Expr].None())
    }

    protected pattern_contains_bindings(self, pattern * PatternNode) Bool = {
        let mutable names = Set[String].new()
        let mutable stack = List[* PatternNode].new()
        stack.push(pattern)
        while not stack.is_empty() then {
            let node = stack.pop() or else pattern
            when node in {
                .Variable(name, _, _) then {
                    if not (name == "_") then {
                        names.insert(name)
                    }
                },
                .EnumCase(_, elements, _) then {
                    for element in elements then {
                        stack.push(element.pattern)
                    }
                },
                .StructPattern(_, elements, _) then {
                    for element in elements then {
                        stack.push(element.pattern)
                    }
                },
                .AndPattern(left, right, _) then {
                    stack.push(left)
                    stack.push(right)
                },
                .OrPattern(left, right, _) then {
                    stack.push(left)
                    stack.push(right)
                },
                _ then {},
            }
        }
        return not names.is_empty()
    }

    protected check_for_loop_pattern_exhaustiveness(self, pattern * PatternNode, element_type Type) Void = {
        when pattern in {
            .Variable(_, _, _) then { return },
            .Wildcard(_) then { return },
            .EnumCase(_, _, _) then {
                self.push_pattern_diagnostic(pattern, "For loop pattern must be exhaustive for element type \(type_to_string(element_type)). Use a simple variable binding.")
            },
            .BoolLiteral(_, _) then {
                self.push_pattern_diagnostic(pattern, "For loop pattern must be exhaustive. Literal patterns are not exhaustive.")
            },
            .IntegerLiteral(_, _) then {
                self.push_pattern_diagnostic(pattern, "For loop pattern must be exhaustive. Literal patterns are not exhaustive.")
            },
            .NegativeIntegerLiteral(_, _) then {
                self.push_pattern_diagnostic(pattern, "For loop pattern must be exhaustive. Literal patterns are not exhaustive.")
            },
            .StringLiteral(_, _) then {
                self.push_pattern_diagnostic(pattern, "For loop pattern must be exhaustive. Literal patterns are not exhaustive.")
            },
            .RuneLiteral(_, _) then {
                self.push_pattern_diagnostic(pattern, "For loop pattern must be exhaustive. Literal patterns are not exhaustive.")
            },
            .ComparisonPattern(_, _, _) then {
                self.push_pattern_diagnostic(pattern, "For loop pattern must be exhaustive. Comparison patterns are not exhaustive.")
            },
            .AndPattern(_, _, _) then {
                self.push_pattern_diagnostic(pattern, "For loop pattern must be exhaustive. Pattern combinators are not exhaustive.")
            },
            .OrPattern(_, _, _) then {
                self.push_pattern_diagnostic(pattern, "For loop pattern must be exhaustive. Pattern combinators are not exhaustive.")
            },
            .NotPattern(_, _) then {
                self.push_pattern_diagnostic(pattern, "For loop pattern must be exhaustive. Pattern combinators are not exhaustive.")
            },
            .StructPattern(_, _, _) then {
                self.push_pattern_diagnostic(pattern, "For loop pattern must be exhaustive. Struct destructuring patterns are not exhaustive.")
            },
        }
    }

    protected condition_contains_is_with_bindings(self, expr * Expr) Bool = {
        return when expr in {
            .IsExpr(_, pattern, _) then self.pattern_contains_bindings(box(pattern)),
            .AndExpr(left, right, _) then self.condition_contains_is_with_bindings(left) or self.condition_contains_is_with_bindings(right),
            .OrExpr(left, right, _) then self.condition_contains_is_with_bindings(left) or self.condition_contains_is_with_bindings(right),
            .Unary(op, inner, _) then when op in {
                .Not() then self.condition_contains_is_with_bindings(inner),
                _ then false,
            },
            _ then false,
        }
    }

    protected condition_contains_is_expression(self, expr * Expr) Bool = {
        return when expr in {
            .IsExpr(_, _, _) then true,
            .AndExpr(left, right, _) then self.condition_contains_is_expression(left) or self.condition_contains_is_expression(right),
            .OrExpr(left, right, _) then self.condition_contains_is_expression(left) or self.condition_contains_is_expression(right),
            .Unary(op, inner, _) then when op in {
                .Not() then self.condition_contains_is_expression(inner),
                _ then false,
            },
            _ then false,
        }
    }

    protected condition_requires_pattern_lowering(self, expr * Expr) Bool = {
        return when expr in {
            .IsExpr(_, _, _) then true,
            .AndExpr(left, right, _) then self.condition_requires_pattern_lowering(left) or self.condition_requires_pattern_lowering(right),
            .OrExpr(_, _, _) then false,
            .IsNotExpr(_, _, _) then false,
            .Unary(_, _, _) then false,
            _ then false,
        }
    }

    protected check_or_branches_for_bindings(self, expr * Expr) Bool = {
        return when expr in {
            .OrExpr(left, right, _) then {
                let has_invalid_bindings = self.condition_contains_is_with_bindings(left) or self.condition_contains_is_with_bindings(right)
                if has_invalid_bindings then {
                    self.storage.diagnostics.push(
                        make_diagnostic(
                            DiagnosticStage.Semantic(),
                            self.storage.file_path,
                            "Variable bindings in 'is' expression are not allowed in 'or' branches"
                        )
                    )
                }
                break has_invalid_bindings
            },
            .AndExpr(left, right, _) then self.check_or_branches_for_bindings(left) or self.check_or_branches_for_bindings(right),
            .Unary(op, inner, _) then when op in {
                .Not() then {
                    let has_invalid_bindings = self.condition_contains_is_with_bindings(inner)
                    if has_invalid_bindings then {
                        self.storage.diagnostics.push(
                            make_diagnostic(
                                DiagnosticStage.Semantic(),
                                self.storage.file_path,
                                "Variable bindings in 'is' expression are not allowed under 'not'"
                            )
                        )
                    }
                    break has_invalid_bindings
                },
                _ then false,
            },
            _ then false,
        }
    }

    protected flatten_and_chain_into(self, expr * Expr, out *mutable List[* Expr]) Void = {
        when expr in {
            .AndExpr(left, right, _) then {
                self.flatten_and_chain_into(left, out)
                self.flatten_and_chain_into(right, out)
            },
            _ then out.push(expr),
        }
    }

    protected expr_condition_span(self, expr * Expr) SourceSpan = {
        return when expr in {
            .IsExpr(_, _, span) then span,
            .IsNotExpr(_, _, span) then span,
            _ then unknown_span(),
        }
    }

    protected make_if_expr_from_condition(self, condition * Expr, then_expr * Expr, else_expr Option[* Expr], fallback_span SourceSpan) * Expr = {
        return when condition in {
            .IsExpr(subject, pattern, span) then {
                let actual_span = if is_known_span(span) then span else fallback_span
                let mutable arms = List[WhenArm].new()
                arms.push(WhenArm(pattern, then_expr))
                let else_body = when else_expr in {
                    .Some(else_ref) then box(*else_ref),
                    .None() then box(Expr.Block(List[Statement].new(), actual_span)),
                }
                arms.push(WhenArm(PatternNode.Wildcard(unknown_span()), else_body))
                break box(Expr.WhenExpr(subject, arms, actual_span))
            },
            _ then box(Expr.IfExpr(condition, then_expr, else_expr, fallback_span)),
        }
    }

    protected make_while_expr_from_condition(self, condition * Expr, body * Expr, fallback_span SourceSpan) * Expr = {
        return when condition in {
            .IsExpr(subject, pattern, span) then {
                let actual_span = if is_known_span(span) then span else fallback_span
                let mutable arms = List[WhenArm].new()
                arms.push(WhenArm(pattern, body))
                arms.push(WhenArm(PatternNode.Wildcard(unknown_span()), self.make_break_block_expr(actual_span)))
                let when_expr = box(Expr.WhenExpr(subject, arms, actual_span))
                break box(Expr.WhileExpr(box(Expr.BoolLiteral(true, actual_span)), when_expr, actual_span))
            },
            _ then box(Expr.WhileExpr(condition, body, fallback_span)),
        }
    }

    protected lower_if_condition_with_bindings(self, condition * Expr, then_expr * Expr, else_expr Option[* Expr], outer_span SourceSpan) Option[* Expr] = {
        if self.check_or_branches_for_bindings(condition) then {
            return Option[* Expr].Some(box(Expr.IfExpr(box(Expr.BoolLiteral(false, outer_span)), then_expr, else_expr, outer_span)))
        }

        if not self.condition_requires_pattern_lowering(condition) then {
            return Option[* Expr].None()
        }

        if not self.condition_contains_is_expression(condition) then {
            return Option[* Expr].None()
        }

        when condition in {
            .IsExpr(_, _, _) then {
                return Option[* Expr].Some(self.make_if_expr_from_condition(condition, then_expr, else_expr, outer_span))
            },
            _ then {},
        }

        let mutable clauses = List[* Expr].new()
        self.flatten_and_chain_into(condition, &mutable clauses)
        if clauses.is_empty() then {
            return Option[* Expr].None()
        }

        let final_clause = clauses[clauses.count() - 1(UInt)]
        let mutable lowered = self.make_if_expr_from_condition(final_clause, then_expr, else_expr, outer_span)
        if clauses.count() == 1 then {
            return Option[* Expr].Some(lowered)
        }

        let mutable i = clauses.count() - 1
        while i > 0 then {
            i -= 1
            let fallback_span = if i == 0 then outer_span else unknown_span()
            let clause = clauses[i]
            lowered = self.make_if_expr_from_condition(clause, lowered, else_expr, fallback_span)
        }

        return Option[* Expr].Some(lowered)
    }

    protected lower_while_condition_with_bindings(self, condition * Expr, body * Expr, outer_span SourceSpan) Option[* Expr] = {
        if self.check_or_branches_for_bindings(condition) then {
            return Option[* Expr].Some(box(Expr.WhileExpr(box(Expr.BoolLiteral(false, outer_span)), body, outer_span)))
        }

        if not self.condition_requires_pattern_lowering(condition) then {
            return Option[* Expr].None()
        }

        if not self.condition_contains_is_expression(condition) then {
            return Option[* Expr].None()
        }

        when condition in {
            .IsExpr(_, _, _) then {
                return Option[* Expr].Some(self.make_while_expr_from_condition(condition, body, outer_span))
            },
            _ then {},
        }

        let mutable clauses = List[* Expr].new()
        self.flatten_and_chain_into(condition, &mutable clauses)

        let mutable first_pattern_idx Option[UInt] = .None()
        let mutable idx UInt = 0
        while idx < clauses.count() then {
            let clause = clauses[idx]
            when clause in {
                .IsExpr(_, pattern, _) then {
                    if self.pattern_contains_bindings(box(pattern)) then {
                        first_pattern_idx = .Some(idx)
                        break
                    }
                },
                _ then {},
            }
            idx += 1
        }

        when first_pattern_idx in {
            .None() then { return Option[* Expr].None() },
            _ then {},
        }

        let first_idx = when first_pattern_idx in {
            .Some(v) then v,
            .None() then 0(UInt),
        }

        let mutable lowered_body = body
        let mutable i = clauses.count()
        while i > 0 then {
            i -= 1
            if i == first_idx then {
                continue
            }
            let clause = clauses[i]
            let clause_span = self.expr_condition_span(clause)
            let break_block = self.make_break_block_expr(clause_span)
            lowered_body = self.make_if_expr_from_condition(
                clause,
                lowered_body,
                Option[* Expr].Some(break_block),
                clause_span
            )
        }

        let first_clause = clauses[first_idx]
        return Option[* Expr].Some(self.make_while_expr_from_condition(first_clause, lowered_body, outer_span))
    }

    protected make_break_block_expr(self, span SourceSpan) * Expr = {
        let mutable statements = List[Statement].new()
        statements.push(Statement.BreakStmt(Option[* Expr].None(), span))
        return box(Expr.Block(statements, span))
    }

    protected lower_range_expr_from_typed(self, op RangeOperator, typed_left Option[* TypedExpr], typed_right Option[* TypedExpr], range_type Type) TypedExpr = {
        let mutable args = List[* TypedExpr].new()
        let case_name = when op in {
            .Closed() then {
                when typed_left in { .Some(left_ref) then args.push(left_ref), .None() then {} }
                when typed_right in { .Some(right_ref) then args.push(right_ref), .None() then {} }
                break "Closed"
            },
            .ClosedOpen() then {
                when typed_left in { .Some(left_ref) then args.push(left_ref), .None() then {} }
                when typed_right in { .Some(right_ref) then args.push(right_ref), .None() then {} }
                break "ClosedOpen"
            },
            .OpenClosed() then {
                when typed_left in { .Some(left_ref) then args.push(left_ref), .None() then {} }
                when typed_right in { .Some(right_ref) then args.push(right_ref), .None() then {} }
                break "OpenClosed"
            },
            .Open() then {
                when typed_left in { .Some(left_ref) then args.push(left_ref), .None() then {} }
                when typed_right in { .Some(right_ref) then args.push(right_ref), .None() then {} }
                break "Open"
            },
            .From() then {
                when typed_left in { .Some(left_ref) then args.push(left_ref), .None() then {} }
                break "From"
            },
            .FromOpen() then {
                when typed_left in { .Some(left_ref) then args.push(left_ref), .None() then {} }
                break "After"
            },
            .To() then {
                when typed_right in { .Some(right_ref) then args.push(right_ref), .None() then {} }
                break "To"
            },
            .ToOpen() then {
                when typed_right in { .Some(right_ref) then args.push(right_ref), .None() then {} }
                break "Until"
            },
            .Full() then "Full",
        }
        return self.lower_enum_constructor_expr(range_type, case_name, args)
    }

    protected check_range_expr_ref(self, op RangeOperator, left Option[* Expr], right Option[* Expr], expected Option[Type], scope Scope) TypedExpr = {
        let expected_element_type = when expected in {
            .Some(et) then when et in {
                .GenericEnum(template, args) then {
                    break if template == "Range" and args.count() > 0(UInt) then Option[Type].Some((*args[0(UInt)])) else Option[Type].None()
                },
                _ then Option[Type].None(),
            },
            .None() then Option[Type].None(),
        }

        let mutable typed_left = when left in {
            .Some(l) then Option[* TypedExpr].Some(box(self.check_expr_scoped_ref(l, expected_element_type, scope))),
            .None() then Option[* TypedExpr].None(),
        }
        let mutable typed_right = when right in {
            .Some(r) then Option[* TypedExpr].Some(box(self.check_expr_scoped_ref(r, expected_element_type, scope))),
            .None() then Option[* TypedExpr].None(),
        }

        if typed_left is .Some(typed_left_ref) and typed_right is .Some(typed_right_ref) and not self.same_expr_type(typed_left_ref.expr_type, typed_right_ref.expr_type) then {
            // Prefer coercing literals to the concrete type (like Swift's coerceLiteral)
            let left_is_literal = when typed_left_ref.expr_kind in {
                .IntegerLiteral(_) then true,
                .FloatLiteral(_) then true,
                _ then false,
            }
            if left_is_literal then {
                // Coerce left literal to right's type
                let adapted_left = self.adapt_expr_to_expected_type_at(*typed_left_ref, .Some(typed_right_ref.expr_type), .None())
                typed_left = .Some(box(adapted_left))
            } else {
                // Coerce right literal to left's type
                let adapted_right = self.adapt_expr_to_expected_type_at(*typed_right_ref, .Some(typed_left_ref.expr_type), .None())
                typed_right = .Some(box(adapted_right))
            }
        }

        let element_type = when typed_left in {
            .Some(typed_left_ref) then {
                let left_type = typed_left_ref.expr_type
                when typed_right in {
                    .Some(typed_right_ref) then {
                        if not self.same_expr_type(left_type, typed_right_ref.expr_type) then {
                            self.storage.diagnostics.push(
                                make_diagnostic(
                                    DiagnosticStage.Semantic(),
                                    self.storage.file_path,
                                    "Type mismatch: expected \(self.display_type_name(left_type)), got \(self.display_type_name(typed_right_ref.expr_type))"
                                )
                            )
                        }
                    },
                    .None() then {},
                }
                break left_type
            },
            .None() then when typed_right in {
                .Some(typed_right_ref) then typed_right_ref.expr_type,
                .None() then when expected_element_type in {
                    .Some(et) then et,
                    .None() then {
                        self.storage.diagnostics.push(
                            make_diagnostic(
                                DiagnosticStage.Semantic(),
                                self.storage.file_path,
                                "Full range '..' requires type annotation or context type"
                            )
                        )
                        break Type.Unknown()
                    },
                },
            },
        }

        let concrete_element_type = self.concretize_default_literal_type(element_type)

        if concrete_element_type is not .Unknown() then {
            let _ = self.enforce_explicit_trait_requirement(concrete_element_type, "Ord")
        }

        let range_type = when concrete_element_type in {
            .Unknown() then Type.Unknown(),
            _ then {
                let mutable range_args = List[* Type].new()
                range_args.push(box(concrete_element_type))
                break Type.GenericEnum("Range", range_args)
            },
        }

        return self.lower_range_expr_from_typed(op, typed_left, typed_right, range_type)
    }

}
