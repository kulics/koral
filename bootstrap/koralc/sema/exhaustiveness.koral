// 穷举性检查器
// 检查 when 表达式的模式是否覆盖了所有可能的情况

// ── ExhaustivenessChecker ─────────────────────────────────────────────────────

public type ExhaustivenessChecker(
    subject_type Type,
    patterns List[* TypedPattern],
    context CompilerContext,
    generic_templates * GenericTemplateRegistry,
    span SourceSpan,
)

private type PatternSpace {
    Full(type_value Type),
    Empty(),
    EnumCases(type_name String, cases Dict[String, List[* PatternSpace]]),
    BoolValues(has_true Bool, has_false Bool),
}

given ExhaustivenessChecker {
    public new(
        subject_type Type,
        patterns List[* TypedPattern],
        context CompilerContext,
        generic_templates * GenericTemplateRegistry,
        span SourceSpan,
    ) ExhaustivenessChecker = {
        return ExhaustivenessChecker(subject_type, patterns, context, generic_templates, span)
    }

    // 执行穷举性检查
    // 返回 Ok 或 Error(message)
    public check(self) Result[Void] = {
        // 先检查不可达模式
        let _ = self.check_unreachable_patterns() or return

        when self.initial_finite_pattern_space() in {
            .Some(space) then {
                let mutable remaining = space
                for p in self.patterns.iterator() then {
                    remaining = self.subtract_pattern(remaining, p, self.subject_type)
                }
                if not self.pattern_space_is_empty(remaining) then {
                    let type_name = self.exhaustiveness_type_name()
                    let message = self.non_exhaustive_match_message_from_patterns(type_name, self.pattern_space_missing_cases(remaining))
                    return Result[Void].Error(box(message))
                }
                return Result[Void].Ok({})
            },
            .None() then {},
        }

        // 检查是否有通配符/绑定模式（catchall）
        let mutable has_catchall = false
        for p in self.patterns.iterator() then {
            if is_catchall(p) then {
                has_catchall = true
            }
        }
        // 按主题类型分支检查穷举性
        when self.subject_type in {
            .EnumType(def_id) then {
                return self.check_enum_exhaustiveness(def_id, has_catchall)
            },
            .GenericEnum(template_name, _) then {
                // 泛型 Enum 类型：通过 GenericTemplateRegistry 查找模板，再用 def_id 获取 case 列表
                let maybe_cases = when self.generic_templates.lookup_enum(template_name) in {
                    .Some(tmpl) then self.context.get_enum_cases(tmpl.def_id),
                    .None() then Option[List[EnumCaseInfo]].None(),
                }
                when maybe_cases in {
                    .Some(all_cases) then {
                        return self.check_enum_cases_exhaustiveness(template_name, all_cases, has_catchall)
                    },
                    .None() then {
                        if has_catchall then {
                            return Result[Void].Ok({})
                        }
                        let message = self.missing_catchall_message(template_name)
                        return Result[Void].Error(box(message))
                    },
                }
            },
            .GenericStruct(_, _) then {
                if not has_catchall then {
                    let type_name = type_to_string(self.subject_type)
                    let message = self.missing_catchall_message(type_name)
                    return Result[Void].Error(box(message))
                }
            },
            .BoolType() then {
                return self.check_bool_exhaustiveness(has_catchall)
            },
            .IntType() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("Int")
                    return Result[Void].Error(box(message))
                }
            },
            .Int8Type() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("Int8")
                    return Result[Void].Error(box(message))
                }
            },
            .Int16Type() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("Int16")
                    return Result[Void].Error(box(message))
                }
            },
            .Int32Type() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("Int32")
                    return Result[Void].Error(box(message))
                }
            },
            .Int64Type() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("Int64")
                    return Result[Void].Error(box(message))
                }
            },
            .UIntType() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("UInt")
                    return Result[Void].Error(box(message))
                }
            },
            .UInt8Type() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("UInt8")
                    return Result[Void].Error(box(message))
                }
            },
            .UInt16Type() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("UInt16")
                    return Result[Void].Error(box(message))
                }
            },
            .UInt32Type() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("UInt32")
                    return Result[Void].Error(box(message))
                }
            },
            .UInt64Type() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("UInt64")
                    return Result[Void].Error(box(message))
                }
            },
            .Float32Type() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("Float32")
                    return Result[Void].Error(box(message))
                }
            },
            .Float64Type() then {
                if not has_catchall then {
                    let message = self.missing_catchall_message("Float64")
                    return Result[Void].Error(box(message))
                }
            },
            .StructureType(_) then {
                if not has_catchall then {
                    let type_name = self.context.type_display_name(self.subject_type)
                    let message = self.missing_catchall_message(type_name)
                    return Result[Void].Error(box(message))
                }
            },
            _ then {
                if not has_catchall then {
                    let type_name = type_to_string(self.subject_type)
                    // Unknown 类型和 TypeVar 跳过穷举性检查
                    when self.subject_type in {
                        .Unknown() then {},
                        .TypeVar(_) then {},
                        _ then {
                            let message = self.missing_catchall_message(type_name)
                            return Result[Void].Error(box(message))
                        },
                    }
                }
            },
        }
        return Result[Void].Ok({})
    }


    // 检查不可达模式（已被前面模式完全覆盖的分支）
    private check_unreachable_patterns(self) Result[Void] = {
        let mutable covered_cases = Set[String].new()
        let mutable covered_trait_object_types = Set[String].new()
        let mutable has_catchall = false
        let mutable catchall_is_struct = false
        let mutable catchall_pattern_desc = ""
        let pattern_count = self.patterns.count()
        let mutable pattern_index UInt = 0
        let mutable remaining_space = self.initial_finite_pattern_space()

        for p in self.patterns.iterator() then {
            if self.is_synthetic_trailing_wildcard(p, pattern_index, pattern_count) then {
                pattern_index += 1
                continue
            }
            if has_catchall then {
                // When the catchall is a struct pattern and the current pattern is a
                // wildcard, this is the synthetic else-branch of an if-is / while-is
                // lowered when expression.  Skip the unreachable error to match the
                // Swift compiler behaviour (which uses a separate ifPatternExpression
                // node that never runs the exhaustiveness checker).
                let skip = catchall_is_struct and (p is .Wildcard())
                if not skip then {
                    let message = unreachable_after_pattern_message(catchall_pattern_desc)
                    return Result[Void].Error(box(message))
                }
            }

            when remaining_space in {
                .Some(space) then {
                    let reduced = self.subtract_pattern(space, p, self.subject_type)
                    if self.can_precisely_subtract_pattern(space, p, self.subject_type)
                       and self.pattern_space_equals(space, reduced)
                    then {
                        let mutable message = "Unreachable pattern: already covered by previous patterns"
                        return Result[Void].Error(box(message))
                    }
                    remaining_space = Option[PatternSpace].Some(reduced)
                },
                .None() then {},
            }

            if remaining_space is .None() then {
                // Legacy fallback for non-finite domains where we still only
                // have top-level enum-case names.
                let pattern_cases = collect_enum_cases(p)

                if not pattern_cases.is_empty() then {
                    for case_name in pattern_cases.iterator() then {
                        if covered_cases.contains(case_name) then {
                            let message = unreachable_case_covered_message(case_name)
                            return Result[Void].Error(box(message))
                        }
                    }
                    if self.is_enum_fully_covered(covered_cases) then {
                        return Result[Void].Error(box("Unreachable pattern: all enum cases are already covered"))
                    }
                    for case_name in pattern_cases.iterator() then {
                        covered_cases.insert(case_name)
                    }
                }
            }

            let pattern_trait_types = collect_trait_object_types(p)
            if not pattern_trait_types.is_empty() then {
                for type_name in pattern_trait_types.iterator() then {
                    if covered_trait_object_types.contains(type_name) then {
                        let mutable msg = "Unreachable pattern: implementation type pattern '"
                        msg.push_string(type_name)
                        msg.push_string("' is already covered")
                        return Result[Void].Error(box(msg))
                    }
                }
                for type_name in pattern_trait_types.iterator() then {
                    covered_trait_object_types.insert(type_name)
                }
            }

            if is_catchall(p) then {
                has_catchall = true
                catchall_is_struct = p is .StructPattern(_, _)
                catchall_pattern_desc = pattern_description(p)
            }
            pattern_index += 1
        }

        return Result[Void].Ok({})
    }

    private initial_finite_pattern_space(self) Option[PatternSpace] = {
        return when self.subject_type in {
            .EnumType(def_id) then Option[PatternSpace].Some(self.enum_pattern_space(self.context.type_display_name(self.subject_type), self.context.get_enum_cases(def_id))),
            .GenericEnum(template_name, _) then {
                let maybe_cases = when self.generic_templates.lookup_enum(template_name) in {
                    .Some(tmpl) then self.context.get_enum_cases(tmpl.def_id),
                    .None() then Option[List[EnumCaseInfo]].None(),
                }
                yield when maybe_cases in {
                    .Some(cases) then Option[PatternSpace].Some(self.enum_pattern_space(template_name, Option[List[EnumCaseInfo]].Some(cases))),
                    .None() then Option[PatternSpace].None(),
                }
            },
            .BoolType() then Option[PatternSpace].Some(PatternSpace.BoolValues(true, true)),
            _ then Option[PatternSpace].None(),
        }
    }

    private enum_pattern_space(self, type_name String, maybe_cases Option[List[EnumCaseInfo]]) PatternSpace = {
        let _ = self
        let mutable cases = Dict[String, List[* PatternSpace]].new()
        when maybe_cases in {
            .Some(all_cases) then {
                for case_info in all_cases then {
                    let mutable fields = List[* PatternSpace].new()
                    for param in case_info.params then {
                        fields.push(box(self.full_space_for_type(param.param_type)))
                    }
                    cases.insert(case_info.name, fields)
                }
            },
            .None() then {},
        }
        return PatternSpace.EnumCases(type_name, cases)
    }

    private full_space_for_type(self, t Type) PatternSpace = {
        return when t in {
            .BoolType() then PatternSpace.BoolValues(true, true),
            .EnumType(def_id) then self.enum_pattern_space(self.context.type_display_name(t), self.context.get_enum_cases(def_id)),
            .GenericEnum(template_name, _) then {
                let maybe_cases = when self.generic_templates.lookup_enum(template_name) in {
                    .Some(tmpl) then self.context.get_enum_cases(tmpl.def_id),
                    .None() then Option[List[EnumCaseInfo]].None(),
                }
                yield self.enum_pattern_space(template_name, maybe_cases)
            },
            _ then PatternSpace.Full(t),
        }
    }

    private pattern_space_is_empty(self, space PatternSpace) Bool = {
        let _ = self
        return when space in {
            .Empty() then true,
            .Full(_) then false,
            .BoolValues(has_true, has_false) then not has_true and not has_false,
            .EnumCases(_, cases) then cases.is_empty(),
        }
    }

    private pattern_space_equals(self, lhs PatternSpace, rhs PatternSpace) Bool = {
        let _ = self
        return when lhs in {
            .Empty() then rhs is .Empty(),
            .Full(left_t) then when rhs in {
                .Full(right_t) then left_t == right_t,
                _ then false,
            },
            .BoolValues(left_true, left_false) then when rhs in {
                .BoolValues(right_true, right_false) then left_true == right_true and left_false == right_false,
                _ then false,
            },
            .EnumCases(left_name, left_cases) then when rhs in {
                .EnumCases(right_name, right_cases) then {
                    if left_name <> right_name or left_cases.count() <> right_cases.count() then {
                        return false
                    }
                    for entry in left_cases.iterator() then {
                        let case_name = entry.first
                        let left_fields = entry.second
                        let right_fields = right_cases.get(case_name) or else { return false }
                        if left_fields.count() <> right_fields.count() then {
                            return false
                        }
                        let mutable idx UInt = 0
                        while idx < left_fields.count() then {
                            if not self.pattern_space_equals(*left_fields[idx], *right_fields[idx]) then {
                                return false
                            }
                            idx += 1
                        }
                    }
                    yield true
                },
                _ then false,
            },
        }
    }

    private subtract_pattern(self, space PatternSpace, pattern * TypedPattern, subject_type Type) PatternSpace = {
        return when pattern in {
            .Wildcard() then PatternSpace.Empty(),
            .Variable(_) then PatternSpace.Empty(),
            .BoolLiteral(value) then self.subtract_bool(space, value),
            .EnumCase(case_name, _, elements) then self.subtract_enum_case(space, case_name, elements, subject_type),
            .OrPattern(left, right) then {
                let after_left = self.subtract_pattern(space, left, subject_type)
                yield self.subtract_pattern(after_left, right, subject_type)
            },
            .AndPattern(left, right) then {
                let after_left = self.subtract_pattern(space, left, subject_type)
                yield self.subtract_pattern(after_left, right, subject_type)
            },
            _ then space,
        }
    }

    private can_precisely_subtract_pattern(self, space PatternSpace, pattern * TypedPattern, subject_type Type) Bool = {
        return when pattern in {
            .Wildcard() then true,
            .Variable(_) then true,
            .BoolLiteral(_) then space is .BoolValues(_, _),
            .EnumCase(case_name, _, elements) then {
                let case_fields = when space in {
                    .Full(_) then self.enum_case_map_for_type(subject_type).get(case_name),
                    .EnumCases(_, cases) then cases.get(case_name),
                    _ then Option[List[* PatternSpace]].None(),
                } or else { return false }
                if self.pattern_elements_all_catchall(elements) then {
                    return true
                }
                if case_fields.count() <> elements.count() then {
                    return false
                }
                let mutable idx UInt = 0
                while idx < elements.count() then {
                    let field_space = *case_fields[idx]
                    let field_type = self.pattern_space_type(field_space)
                    if not self.can_precisely_subtract_pattern(field_space, elements[idx].pattern, field_type) then {
                        return false
                    }
                    idx += 1
                }
                yield true
            },
            .OrPattern(left, right) then self.can_precisely_subtract_pattern(space, left, subject_type)
                and self.can_precisely_subtract_pattern(space, right, subject_type),
            .AndPattern(left, right) then self.can_precisely_subtract_pattern(space, left, subject_type)
                and self.can_precisely_subtract_pattern(space, right, subject_type),
            _ then false,
        }
    }

    private subtract_bool(self, space PatternSpace, value Bool) PatternSpace = {
        let _ = self
        return when space in {
            .BoolValues(has_true, has_false) then {
                let next_true = if value then false else has_true
                let next_false = if value then has_false else false
                yield if not next_true and not next_false then PatternSpace.Empty() else PatternSpace.BoolValues(next_true, next_false)
            },
            _ then space,
        }
    }

    private subtract_enum_case(self, space PatternSpace, case_name String, elements List[* TypedPatternElement], subject_type Type) PatternSpace = {
        let mutable cases = when space in {
            .Full(_) then self.enum_case_map_for_type(subject_type),
            .EnumCases(_, existing) then existing,
            _ then { return space },
        }
        let case_fields = cases.get(case_name) or else { return space }
        let covers_entire_case = self.pattern_elements_all_catchall(elements)
        if covers_entire_case then {
            let _ = cases.remove(case_name)
        } else {
            let new_fields = self.subtract_pattern_fields(case_fields, elements)
            if self.pattern_space_list_all_empty(new_fields) then {
                let _ = cases.remove(case_name)
            } else {
                cases.insert(case_name, new_fields)
            }
        }
        if cases.is_empty() then {
            return PatternSpace.Empty()
        }
        return when space in {
            .EnumCases(type_name, _) then PatternSpace.EnumCases(type_name, cases),
            .Full(_) then PatternSpace.EnumCases(self.exhaustiveness_type_name(), cases),
            _ then space,
        }
    }

    private enum_case_map_for_type(self, t Type) Dict[String, List[* PatternSpace]] = {
        let mutable cases = Dict[String, List[* PatternSpace]].new()
        let maybe_cases = when t in {
            .EnumType(def_id) then self.context.get_enum_cases(def_id),
            .GenericEnum(template_name, _) then when self.generic_templates.lookup_enum(template_name) in {
                .Some(tmpl) then self.context.get_enum_cases(tmpl.def_id),
                .None() then Option[List[EnumCaseInfo]].None(),
            },
            _ then Option[List[EnumCaseInfo]].None(),
        }
        when maybe_cases in {
            .Some(all_cases) then {
                for case_info in all_cases then {
                    let mutable fields = List[* PatternSpace].new()
                    for param in case_info.params then {
                        fields.push(box(self.full_space_for_type(param.param_type)))
                    }
                    cases.insert(case_info.name, fields)
                }
            },
            .None() then {},
        }
        return cases
    }

    private subtract_pattern_fields(self, fields List[* PatternSpace], elements List[* TypedPatternElement]) List[* PatternSpace] = {
        if fields.count() <> elements.count() then {
            return fields
        }
        let mutable result = List[* PatternSpace].new()
        let mutable idx UInt = 0
        while idx < fields.count() then {
            let field_space = *fields[idx]
            let element = elements[idx]
            let field_type = self.pattern_space_type(field_space)
            result.push(box(self.subtract_pattern(field_space, element.pattern, field_type)))
            idx += 1
        }
        return result
    }

    private pattern_space_type(self, space PatternSpace) Type = {
        let _ = self
        return when space in {
            .Full(t) then t,
            .BoolValues(_, _) then Type.BoolType(),
            .EnumCases(_, _) then Type.Unknown(),
            _ then Type.Unknown(),
        }
    }

    private pattern_elements_all_catchall(self, elements List[* TypedPatternElement]) Bool = {
        let _ = self
        for element in elements then {
            if not is_catchall(element.pattern) then {
                return false
            }
        }
        return true
    }

    private pattern_space_list_all_empty(self, spaces List[* PatternSpace]) Bool = {
        for space in spaces then {
            if not self.pattern_space_is_empty(*space) then {
                return false
            }
        }
        return true
    }

    private pattern_space_missing_cases(self, space PatternSpace) List[String] = {
        return when space in {
            .Empty() then List[String].new(),
            .Full(t) then {
                let mutable out = List[String].new()
                out.push(type_to_string(t))
                yield out
            },
            .BoolValues(has_true, has_false) then {
                let mutable out = List[String].new()
                if has_true then { out.push("true") }
                if has_false then { out.push("false") }
                yield out
            },
            .EnumCases(_, cases) then {
                let mutable out = List[String].new()
                let mutable names = List[String].new()
                for entry in cases.iterator() then { names.push(entry.first) }
                names.sort()
                for case_name in names then {
                    let fields = cases.get(case_name) or else List[* PatternSpace].new()
                    let rendered = self.render_missing_constructor(case_name, fields)
                    for value in rendered then { out.push(value) }
                }
                yield out
            },
        }
    }

    private render_missing_constructor(self, case_name String, fields List[* PatternSpace]) List[String] = {
        let _ = self
        if fields.is_empty() then {
            let mutable out = List[String].new()
            out.push(".")
            out[0(UInt)].push_string(case_name)
            return out
        }
        let mutable field_options = List[List[String]].new()
        for field in fields then {
            field_options.push(self.pattern_space_missing_fragments(*field))
        }
        let combinations = self.combine_missing_field_options(field_options)
        let mutable out = List[String].new()
        for combo in combinations then {
            let mutable rendered = "."
            rendered.push_string(case_name)
            rendered.push_byte('(')
            let mutable first = true
            for fragment in combo then {
                if not first then { rendered.push_string(", ") }
                rendered.push_string(fragment)
                first = false
            }
            rendered.push_byte(')')
            out.push(rendered)
        }
        return out
    }

    private pattern_space_missing_fragments(self, space PatternSpace) List[String] = {
        return when space in {
            .Empty() then List[String].new(),
            .Full(_) then {
                let mutable out = List[String].new()
                out.push("_")
                yield out
            },
            .BoolValues(has_true, has_false) then {
                let mutable out = List[String].new()
                if has_true and has_false then {
                    out.push("_")
                    return out
                }
                if has_true then { out.push("true") }
                if has_false then { out.push("false") }
                yield out
            },
            .EnumCases(_, cases) then {
                let mutable out = List[String].new()
                let mutable names = List[String].new()
                for entry in cases.iterator() then { names.push(entry.first) }
                names.sort()
                for case_name in names then {
                    let fields = cases.get(case_name) or else List[* PatternSpace].new()
                    let rendered = self.render_missing_constructor(case_name, fields)
                    for value in rendered then { out.push(value) }
                }
                yield out
            },
        }
    }

    private combine_missing_field_options(self, options List[List[String]]) List[List[String]] = {
        if options.is_empty() then {
            return List[List[String]].new()
        }
        let mutable result = List[List[String]].new()
        result.push(List[String].new())
        for values in options then {
            if values.is_empty() then {
                return List[List[String]].new()
            }
            let mutable next = List[List[String]].new()
            for prefix in result then {
                for value in values then {
                    let mutable combined = List[String].new()
                    for existing in prefix then { combined.push(existing) }
                    combined.push(value)
                    next.push(combined)
                }
            }
            result = next
        }
        return result
    }

    private exhaustiveness_type_name(self) String = {
        return when self.subject_type in {
            .EnumType(_) then self.context.type_display_name(self.subject_type),
            .GenericEnum(template_name, _) then template_name,
            .BoolType() then "Bool",
            _ then type_to_string(self.subject_type),
        }
    }

    private non_exhaustive_match_message_from_patterns(self, type_name String, missing List[String]) String = {
        let _ = self
        let mutable msg = "Non-exhaustive match on type '"
        msg.push_string(type_name)
        msg.push_string("': missing cases ")
        let mutable first = true
        for c in missing then {
            if not first then { msg.push_string(", ") }
            msg.push_string(c)
            first = false
        }
        return msg
    }

    private is_synthetic_trailing_wildcard(self, pattern * TypedPattern, pattern_index UInt, pattern_count UInt) Bool = {
        if pattern_count <> 2(UInt) then {
            return false
        }
        if pattern_index + 1(UInt) <> pattern_count then {
            return false
        }
        if pattern is not .Wildcard() then {
            return false
        }
        let first_pattern = self.patterns[0(UInt)]
        return when first_pattern in {
            .Wildcard() then false,
            .Variable(_) then false,
            _ then true,
        }
    }

    // 检查 enum 是否已被完全覆盖
    private is_enum_fully_covered(self, covered_cases Set[String]) Bool = {
        let all_cases = self.get_all_enum_case_names()
        if all_cases.is_empty() then { return false }
        for case_name in all_cases.iterator() then {
            if not covered_cases.contains(case_name) then {
                return false
            }
        }
        return true
    }

    // 获取所有 enum case 名称
    private get_all_enum_case_names(self) Set[String] = {
        let mutable names = Set[String].new()
        when self.subject_type in {
            .EnumType(def_id) then {
                when self.context.get_enum_cases(def_id) in {
                    .Some(cases) then {
                        for c in cases then {
                            names.insert(c.name)
                        }
                    },
                    .None() then {},
                }
            },
            .GenericEnum(template_name, _) then {
                when self.generic_templates.lookup_enum(template_name) in {
                    .Some(tmpl) then {
                        when self.context.get_enum_cases(tmpl.def_id) in {
                            .Some(cases) then {
                                for c in cases then {
                                    names.insert(c.name)
                                }
                            },
                            .None() then {},
                        }
                    },
                    .None() then {},
                }
            },
            _ then {},
        }
        return names
    }

    // 检查 Enum 类型的穷举性
    private check_enum_exhaustiveness(self, def_id DefId, has_catchall Bool) Result[Void] = {
        if has_catchall then {
            return Result[Void].Ok({})
        }

        // 获取所有 case
        let all_cases = when self.context.get_enum_cases(def_id) in {
            .None() then {
                // 无法获取 case 列表，跳过检查
                return Result[Void].Ok({})
            },
            .Some(cases) then cases,
        }

        let type_name = self.context.type_display_name(self.subject_type)
        return self.check_enum_cases_exhaustiveness(type_name, all_cases, has_catchall)
    }

    // 通用 enum case 穷举性检查（支持 EnumType 和 GenericEnum）
    private check_enum_cases_exhaustiveness(self, type_name String, all_cases List[EnumCaseInfo], has_catchall Bool) Result[Void] = {
        if has_catchall then {
            return Result[Void].Ok({})
        }

        // 收集被覆盖的 case（递归处理 or 模式）
        let mutable covered = Set[String].new()
        for p in self.patterns.iterator() then {
            let pattern_cases = collect_enum_cases(p)
            for case_name in pattern_cases.iterator() then {
                covered.insert(case_name)
            }
        }

        // 找出缺失的 case
        let mutable missing = List[String].new()
        for case_info in all_cases then {
            if not covered.contains(case_info.name) then {
                missing.push(case_info.name)
            }
        }

        // 按字母顺序排序缺失的 case
        missing.sort()

        if missing.count() > 0 then {
            let message = self.non_exhaustive_match_message(type_name, missing, true)
            return Result[Void].Error(box(message))
        }

        return Result[Void].Ok({})
    }

    // 检查 Bool 类型的穷举性
    private check_bool_exhaustiveness(self, has_catchall Bool) Result[Void] = {
        if has_catchall then {
            return Result[Void].Ok({})
        }

        let mutable has_true = false
        let mutable has_false = false

        for p in self.patterns.iterator() then {
            when p in {
                .BoolLiteral(value) then {
                    if value then { has_true = true }
                    else { has_false = true }
                },
                _ then {},
            }
        }

        if not has_true or not has_false then {
            let mutable missing = List[String].new()
            if not has_true then { missing.push("true") }
            if not has_false then { missing.push("false") }
            let message = self.non_exhaustive_match_message("Bool", missing, false)
            return Result[Void].Error(box(message))
        }

        return Result[Void].Ok({})
    }

    private missing_catchall_message(self, type_name String) String = {
        let _ = self
        let mutable msg = "Match on type '"
        msg.push_string(type_name)
        msg.push_string("' requires a wildcard or variable binding pattern")
        return msg
    }

    private non_exhaustive_match_message(self, type_name String, missing List[String], add_case_dot Bool) String = {
        let mutable msg = "Non-exhaustive match on type '"
        msg.push_string(type_name)
        msg.push_string("': missing cases ")
        let mutable first = true
        for c in missing then {
            if not first then { msg.push_string(", ") }
            if add_case_dot then {
                msg.push_string(".")
            }
            msg.push_string(c)
            first = false
        }
        return msg
    }
}

// ── 辅助函数 ──────────────────────────────────────────────────────────────────

// 判断模式是否为 catchall（通配符或绑定模式）
public let is_catchall(pattern * TypedPattern) Bool = {
    return when pattern in {
        .Wildcard() then true,
        .Variable(_) then true,
        .TraitObjectType(_) then false,
        .TraitObjectTypeBinding(_, _) then false,
        .OrPattern(left, right) then is_catchall(left) or is_catchall(right),
        .AndPattern(left, right) then is_catchall(left) and is_catchall(right),
        .NotPattern(_) then false,
        .StructPattern(_, elements) then {
            let mutable all_catchall = true
            for elem in elements then {
                if not is_catchall(elem.pattern) then {
                    all_catchall = false
                }
            }
            yield all_catchall
        },
        .ComparisonPattern(_, _) then false,
        _ then false,
    }
}

// 获取模式的简短描述（用于错误消息）
public let pattern_description(pattern * TypedPattern) String = {
    return when pattern in {
        .Wildcard() then "_",
        .Variable(symbol) then if symbol.is_mutable() then {
            let mutable msg = "mutable "
            msg.push_string("sym#\(symbol.def_id.id)")
            yield msg
        } else "sym#\(symbol.def_id.id)",
        .TraitObjectType(target_type) then type_to_string(target_type),
        .TraitObjectTypeBinding(_, target_type) then type_to_string(target_type),
        .BoolLiteral(value) then if value then "true" else "false",
        .IntegerLiteral(value) then value,
        .NegativeIntegerLiteral(value) then {
            let mutable msg = "-"
            msg.push_string(value)
            yield msg
        },
        .StringLiteral(value) then {
            let mutable msg = "\""
            msg.push_string(value)
            msg.push_string("\"")
            yield msg
        },
        .RuneLiteral(value) then {
            let mutable msg = "'"
            msg.push_string(value)
            msg.push_string("'")
            yield msg
        },
        .EnumCase(name, _, _) then {
            let mutable msg = "."
            msg.push_string(name)
            yield msg
        },
        .StructPattern(name, _) then name,
        .ComparisonPattern(_, value) then value,
        .AndPattern(_, _) then "<and>",
        .OrPattern(_, _) then "<or>",
        .NotPattern(_) then "<not>",
    }
}

private let unreachable_after_pattern_message(pattern_desc String) String = {
    let mutable msg = "Unreachable pattern: pattern after '"
    msg.push_string(pattern_desc)
    msg.push_string("' is unreachable")
    return msg
}

private let unreachable_case_covered_message(case_name String) String = {
    let mutable msg = "Unreachable pattern: case '"
    msg.push_string(case_name)
    msg.push_string("' is already covered")
    return msg
}

// 递归收集 or 模式中覆盖的 enum case 名称
public let collect_enum_cases(pattern * TypedPattern) Set[String] = {
    let mutable covered = Set[String].new()
    when pattern in {
        .EnumCase(case_name, _, _) then {
            covered.insert(case_name)
        },
        .OrPattern(left, right) then {
            let left_cases = collect_enum_cases(left)
            for case_name in left_cases.iterator() then {
                covered.insert(case_name)
            }
            let right_cases = collect_enum_cases(right)
            for case_name in right_cases.iterator() then {
                covered.insert(case_name)
            }
        },
        _ then {},
    }
    return covered
}

public let collect_trait_object_types(pattern * TypedPattern) Set[String] = {
    let mutable covered = Set[String].new()
    when pattern in {
        .TraitObjectType(target_type) then {
            covered.insert(type_to_string(target_type))
        },
        .TraitObjectTypeBinding(_, target_type) then {
            covered.insert(type_to_string(target_type))
        },
        .OrPattern(left, right) then {
            let left_types = collect_trait_object_types(left)
            for type_name in left_types.iterator() then {
                covered.insert(type_name)
            }
            let right_types = collect_trait_object_types(right)
            for type_name in right_types.iterator() then {
                covered.insert(type_name)
            }
        },
        _ then {},
    }
    return covered
}
