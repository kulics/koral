
given TypeChecker {
    // Resolve a trait name to its declaration identity. Name -> DefId happens once,
    // at the registration boundary; every later match compares DefIds so that
    // renaming, module suffixes, or two same-named traits cannot alias.
    module_private trait_def_id_of(self, trait_name String) Option[DefId] = {
        return when self.storage.trait_registry.get(trait_name) in {
            .Some(trait_info) then Option[DefId].Some(trait_info.def_id),
            .None() then Option[DefId].None(),
        };
    };

    module_private copy_template_type_params(self, type_params List[TypeParameterDecl]) List[TypeParameterDecl] = {
        let mutable copied = List[TypeParameterDecl].new();
        for type_param in type_params then {
            let mutable constraints = List[TypeNode].with_capacity(type_param.constraints.count());
            for constraint in type_param.constraints then {
                constraints.push(self.copy_type_node(constraint));
            };
            copied.push(TypeParameterDecl(type_param.name, constraints));
        };
        return copied;
    };

    module_private copy_template_params(self, params List[TemplateParam]) List[TemplateParam] = {
        let mutable copied = List[TemplateParam].new();
        for param in params then {
            let mutable copied_type = self.copy_type_node(param.param_type);
            copied.push(TemplateParam(param.name, param.is_mutable, copied_type, param.named));
        };
        return copied;
    };

    module_private copy_string_list(self, values List[String]) List[String] = {
        let mutable copied = List[String].with_capacity(values.count());
        for value in values then {
            copied.push(value);
        };
        return copied;
    };

    module_private copy_method_declaration(self, method MethodDeclaration) MethodDeclaration = {
        return MethodDeclaration(
            method.name,
            method.access,
            self.copy_template_type_params(method.type_params),
            self.copy_template_params(method.params),
            self.copy_type_node(method.return_type),
            method.span,
            method.def_id,
        );
    };

    module_private copy_optional_checked_body(self, checked_body Option[TypedExpr]) Option[TypedExpr] = {
        return when checked_body in {
            .Some(body) then Option[TypedExpr].Some(body),
            .None() then Option[TypedExpr].None(),
        };
    };

    module_private copy_optional_symbols(self, symbols Option[List[Symbol]]) Option[List[Symbol]] = {
        return when symbols in {
            .Some(items) then {
                let mutable copied = List[Symbol].with_capacity(items.count());
                for item in items then {
                    copied.push(item);
                };
                yield Option[List[Symbol]].Some(copied);
            },
            .None() then Option[List[Symbol]].None(),
        };
    };

    module_private copy_optional_type(self, value Option[Type]) Option[Type] = {
        return when value in {
            .Some(t) then Option[Type].Some(t),
            .None() then Option[Type].None(),
        };
    };

    module_private typed_params_to_checked_symbols(self, params List[TypedParam]) List[Symbol] = {
        let mutable symbols = List[Symbol].with_capacity(params.count());
        for param in params then {
            let variable_kind = if param.is_mutable then VariableKind.MutableValue() else VariableKind.Value();
            symbols.push(Symbol(
                self.allocate_unindexed_def_id(param.name, DefKind.Variable()),
                param.param_type,
                SymbolKind.Variable(variable_kind),
            ));
        };
        return symbols;
    };

    module_private copied_extension_method_template(
        self,
        type_params List[TypeParameterDecl],
        method MethodDeclaration,
        conformance_trait_name Option[String],
        conformance_trait_def_id Option[DefId],
        conformance_target_type Option[Type],
        conformance_trait_args List[Type],
        uses_trait_type_params Bool,
        source_file String,
        module_path List[String],
        package_id String,
        checked_body Option[TypedExpr],
        checked_parameters Option[List[Symbol]],
        checked_return_type Option[Type],
    ) GenericExtensionMethodTemplate = {
        return GenericExtensionMethodTemplate(
            self.copy_template_type_params(type_params),
            self.copy_method_declaration(method),
            conformance_trait_name,
            conformance_trait_def_id,
            self.copy_optional_type(conformance_target_type),
            self.copy_type_list(conformance_trait_args),
            uses_trait_type_params,
            source_file,
            self.copy_string_list(module_path),
            package_id,
            self.copy_optional_checked_body(checked_body),
            self.copy_optional_symbols(checked_parameters),
            self.copy_optional_type(checked_return_type),
        );
    };

    module_private boxed_extension_method_template(
        self,
        type_params List[TypeParameterDecl],
        method MethodDeclaration,
        conformance_trait_name Option[String],
        conformance_trait_def_id Option[DefId],
        conformance_target_type Option[Type],
        conformance_trait_args List[Type],
        uses_trait_type_params Bool,
        source_file String,
        module_path List[String],
        package_id String,
        checked_body Option[TypedExpr],
        checked_parameters Option[List[Symbol]],
        checked_return_type Option[Type],
    ) GenericExtensionMethodTemplate = {
        let _ = self;
        return GenericExtensionMethodTemplate(
            type_params,
            method,
            conformance_trait_name,
            conformance_trait_def_id,
            conformance_target_type,
            conformance_trait_args,
            uses_trait_type_params,
            source_file,
            module_path,
            package_id,
            checked_body,
            checked_parameters,
            checked_return_type,
        );
    };

    module_private copy_type_list(self, values List[Type]) List[Type] = {
        let mutable copied = List[Type].with_capacity(values.count());
        for value in values then {
            copied.push(value);
        };
        return copied;
    };

    module_private contains_generic_parameter(self, t Type) Bool = {
        let mutable context = self.context();
        return context.contains_generic_parameter(t);
    };

    module_private mentions_unresolved_generic_placeholder(self, t Type) Bool = {
        return type_mentions_unresolved_generic_placeholder(t);
    };

    module_private contains_generic_parameter_in_list(self, types List[Type]) Bool = {
        for t in types then {
            if self.contains_generic_parameter(t) then { return true;};
        };
        return false;
    };

    module_private should_register_extension_template_for_member(
        self,
        target_type Type,
        owner_type_params List[TypeParameter],
        member_type_params List[TypeParameter],
    ) Bool = {
        when target_type in {
            .TraitObject(_, _, _) then { return true;},
            _ then {},
        };
        if not owner_type_params.is_empty() then {
            return true;
        };
        if not member_type_params.is_empty() then {
            return true;
        };
        return self.mentions_unresolved_generic_placeholder(target_type);
    };

    module_private resolve_template_type_node_with_bindings(self, node TypeNode, bindings Dict[String, Type]) Type = {
        return when node in {
            .Identifier(name) then when bindings.get(name) in {
                .Some(bound) then bound,
                .None() then {
                    // Check current_scope before falling back (Swift: currentScope.resolveType)
                    if self.storage.current_scope.lookup_type(name) is .Some(t) then {
                        return self.canonicalize_alias_type(t);
                    };
                    yield self.resolve_type(node);
                },
            },
            .InferredSelf() then when bindings.get("Self") in {
                .Some(bound) then bound,
                .None() then Type.Unknown(),
            },
            .Reference(inner, is_mutable) then {
                let trait_ref_override = when inner in {
                    .Identifier(name) then if bindings.get(name) is .None() and self.storage.trait_registry.get(name) is .Some(_) then {
                        let trait_ref_inner = self.canonical_trait_object_type(name);
                        yield Option[Type].Some(if is_mutable then self.resolve_mutable_reference_type(trait_ref_inner) else self.resolve_reference_type(trait_ref_inner));
                    } else Option[Type].None(),
                    .Generic(base, args) then {
                        yield if self.storage.trait_registry.get(base) is .Some(_) then {
                            let mutable resolved_args = List[Type].new();
                            for arg in args then {
                                resolved_args.push(self.resolve_template_type_node_with_bindings(arg, bindings));
                            };
                            let trait_ref_inner = self.make_trait_object_type(base, self.to_type_ref_list_in_resolution(resolved_args));
                            yield Option[Type].Some(if is_mutable then self.resolve_mutable_reference_type(trait_ref_inner) else self.resolve_reference_type(trait_ref_inner));
                        } else Option[Type].None();
                    },
                    _ then Option[Type].None(),
                };
                when trait_ref_override in {
                    .Some(resolved_trait_ref) then { yield resolved_trait_ref;},
                    .None() then {},
                };
                let resolved_inner = self.resolve_template_type_node_with_bindings(inner, bindings);
                yield if is_mutable then self.resolve_mutable_reference_type(resolved_inner) else self.resolve_reference_type(resolved_inner);
            },
            .BorrowedReference(inner, is_mutable) then {
                let resolved_inner = self.resolve_template_type_node_with_bindings(inner, bindings);
                yield if is_mutable then Type.MutableBorrowedReferenceType(resolved_inner) else Type.BorrowedReferenceType(resolved_inner);
            },
            .Pointer(inner, is_mutable) then {
                let resolved_inner = self.resolve_template_type_node_with_bindings(inner, bindings);
                yield if is_mutable then Type.MutablePointerType(resolved_inner) else Type.PointerType(resolved_inner);
            },
            .WeakReference(inner, is_mutable) then {
                // Check if inner is a trait name → trait object weakref
                let trait_ref_override = when inner in {
                    .Identifier(name) then if bindings.get(name) is .None() and self.storage.trait_registry.get(name) is .Some(_) then {
                        let trait_ref_inner = self.canonical_trait_object_type(name);
                        yield Option[Type].Some(if is_mutable then self.resolve_mutable_weak_reference_type(trait_ref_inner) else self.resolve_weak_reference_type(trait_ref_inner));
                    } else Option[Type].None(),
                    .Generic(base, args) then {
                        yield if self.storage.trait_registry.get(base) is .Some(_) then {
                            let mutable resolved_args = List[Type].new();
                            for arg in args then {
                                resolved_args.push(self.resolve_template_type_node_with_bindings(arg, bindings));
                            };
                            let trait_ref_inner = self.make_trait_object_type(base, self.to_type_ref_list_in_resolution(resolved_args));
                            yield Option[Type].Some(if is_mutable then self.resolve_mutable_weak_reference_type(trait_ref_inner) else self.resolve_weak_reference_type(trait_ref_inner));
                        } else Option[Type].None();
                    },
                    _ then Option[Type].None(),
                };
                when trait_ref_override in {
                    .Some(resolved_trait_ref) then { yield resolved_trait_ref;},
                    .None() then {},
                };
                let resolved_inner = self.resolve_template_type_node_with_bindings(inner, bindings);
                yield if is_mutable then self.resolve_mutable_weak_reference_type(resolved_inner) else self.resolve_weak_reference_type(resolved_inner);
            },
            .Generic(base, args) then {
                let mutable resolved_args = List[Type].new();
                for arg in args then {
                    resolved_args.push(self.resolve_template_type_node_with_bindings(arg, bindings));
                };
                yield if self.is_enum_base_name(base) then {
                    yield Type.GenericEnum(base, self.storage.generic_templates.lookup_enum_def_id(base), resolved_args);
                } else {
                    yield Type.GenericStruct(base, self.storage.generic_templates.lookup_struct_def_id(base), resolved_args);
                };
            },
            .FunctionType(param_types, return_type) then {
                let mutable resolved_params = List[Type].new();
                for param_type in param_types then {
                    resolved_params.push(self.resolve_template_type_node_with_bindings(param_type, bindings));
                };
                let resolved_return = self.resolve_template_type_node_with_bindings(return_type, bindings);
                yield make_function_type(resolved_params, resolved_return);
            },
        };
    };

    module_private same_extension_template_slot(self, current GenericExtensionMethodTemplate, candidate GenericExtensionMethodTemplate) Bool = {
        // Trait identity is the declaration DefId, not the name — two traits that
        // share a name (or the same trait seen through a module alias) must not
        // collapse into one template slot.
        return current.method.name == candidate.method.name and current.type_params.count() == candidate.type_params.count() and current.method.type_params.count() == candidate.method.type_params.count() and current.conformance_trait_def_id == candidate.conformance_trait_def_id and current.conformance_target_type == candidate.conformance_target_type and current.conformance_trait_args == candidate.conformance_trait_args;
    };

    module_private upsert_extension_template(self, key String, template GenericExtensionMethodTemplate) Void = {
        when self.storage.generic_templates.extension_methods.get(key) in {
            .Some(existing) then {
                let mutable updated = existing;
                let mutable index = 0(UInt);
                let mutable replaced = false;
                while index < updated.count() then {
                    let current_ref = updated[index];
                    if self.same_extension_template_slot(current_ref, template) then {
                        let should_replace = if template.checked_body is .Some(_) then true else current_ref.checked_body is .None();
                        if should_replace then {
                            updated[index] = template;
                        };
                        replaced = true;
                        break;
                    };
                    index += 1(UInt);
                };
                if not replaced then {
                    updated.push(template);
                };
                self.storage.generic_templates.extension_methods.insert(key, updated);
            },
            .None() then {
                let mutable list = List[GenericExtensionMethodTemplate].with_capacity(4(UInt));
                list.push(template);
                self.storage.generic_templates.extension_methods.insert(key, list);
            },
        };
    };

    // Returns the canonical extension template registry key for a type.
    // For modifier types (ref/ptr/weakref), returns fixed short names matching Swift:
    //   "Ref", "MutRef", "Ptr", "MutPtr", "WeakRef", "MutWeakRef"
    // For generic types, returns the template name (e.g. "List", "Option").
    // For concrete types, returns the type name.
    module_private extension_template_key(self, target_type Type) String = {
        return when target_type in {
            .TraitObject(trait_name, _, _) then trait_name,
            .ReferenceType(_) then "Ref",
            .MutableReferenceType(_) then "MutRef",
            .PointerType(_) then "Ptr",
            .MutablePointerType(_) then "MutPtr",
            .WeakReferenceType(_) then "WeakRef",
            .MutableWeakReferenceType(_) then "MutWeakRef",
            .GenericStruct(template, _, _) then template,
            .GenericEnum(template, _, _) then template,
            .StructureType(def_id) then when self.context().get_template_name(def_id) in {
                .Some(template_name) then template_name,
                .None() then self.context().get_name(def_id) or else "struct#\(def_id.id)",
            },
            .EnumType(def_id) then when self.context().get_template_name(def_id) in {
                .Some(template_name) then template_name,
                .None() then self.context().get_name(def_id) or else "enum#\(def_id.id)",
            },
            _ then self.context().type_display_name(target_type),
        };
    };

    module_private extension_template_key_for_target_node(self, target_type TypeNode, resolved_target Type) String = {
        return when target_type in {
            .Reference(_, is_mutable) then if is_mutable then "MutRef" else "Ref",
            .Pointer(_, is_mutable) then if is_mutable then "MutPtr" else "Ptr",
            .WeakReference(_, is_mutable) then if is_mutable then "MutWeakRef" else "WeakRef",
            .Generic(base, _) then base,
            _ then self.extension_template_key(resolved_target),
        };
    };

    module_private register_extension_method_template(
        self,
        type_key String,
        owner_type_params List[TypeParameter],
        conformance_target_type Option[Type],
        conformance_trait_args List[Type],
        method_name String,
        source_def_id DefId,
        method_access AccessModifier,
        method_type_params List[TypeParameter],
        method_params List[Param],
        method_return_type TypeNode,
        conformance_trait_name Option[String],
        conformance_trait_def_id Option[DefId],
        checked_body Option[TypedExpr],
        checked_parameters Option[List[Symbol]],
        checked_return_type Option[Type],
    ) Void = {
        let copied_method_type_params = self.to_template_type_params(method_type_params);
        let copied_method_params = self.to_template_params(method_params);
        let copied_method_return_type = self.copy_type_node(method_return_type);
        let method_decl = MethodDeclaration(
            method_name,
            method_access,
            copied_method_type_params,
            copied_method_params,
            copied_method_return_type,
            unknown_span(),
            source_def_id,
        );
        let template_checked_return_type = when checked_return_type in {
            .Some(t) then Option[Type].Some(t),
            .None() then Option[Type].None(),
        };
        let primary_template = self.boxed_extension_method_template(

            self.to_template_type_params(owner_type_params),

            method_decl,

            conformance_trait_name,
            conformance_trait_def_id,

            conformance_target_type,

            conformance_trait_args,

            false,

            self.storage.file_path,

            self.storage.module_path,

            self.storage.package_id,

            checked_body,

            checked_parameters,

            template_checked_return_type
        );
        self.upsert_extension_template(type_key, primary_template);
    };

    module_private update_extension_method_checked_template(
        self,
        target_type Type,
        owner_type_param_count UInt,
        method_name String,
        method_type_param_count UInt,
        conformance_trait_name Option[String],
        checked_body Option[TypedExpr],
        checked_parameters Option[List[Symbol]],
        checked_return_type Type,
    ) Void = {
        let type_key = self.extension_template_key(target_type);
        when self.storage.generic_templates.extension_methods.get(type_key) in {
            .Some(existing) then {
                let mutable updated = existing;
                let mutable index = 0(UInt);
                while index < updated.count() then {
                    let current_ref = updated[index];
                    if current_ref.method.name == method_name and current_ref.type_params.count() == owner_type_param_count and current_ref.method.type_params.count() == method_type_param_count and current_ref.conformance_trait_name == conformance_trait_name then {
                        let new_checked_body = when checked_body in {
                            .Some(_) then checked_body,
                            .None() then current_ref.checked_body,
                        };
                        updated[index] = self.copied_extension_method_template(

                            current_ref.type_params,

                            current_ref.method,

                            current_ref.conformance_trait_name,
            current_ref.conformance_trait_def_id,

                            current_ref.conformance_target_type,

                            current_ref.conformance_trait_args,

                            current_ref.uses_trait_type_params,

                            current_ref.source_file,

                            current_ref.module_path,

                            current_ref.package_id,

                            new_checked_body,

                            checked_parameters,

                            Option[Type].Some(checked_return_type)
        );
                        self.storage.generic_templates.extension_methods.insert(type_key, updated);
                        return;
                    };
                    index += 1(UInt);
                };
                return;
            },
            .None() then {
                return;
            },
        };
    };


    module_private register_conformance_method_signatures_for_concrete_type(self, target_type Type, members List[TypedGivenMember], mark_inherent Bool, trait_def_id Option[DefId]) Void = {
        let type_key = self.extension_template_key(target_type);
        for member_ref in members then {
            let member = member_ref;
            let mutable param_types = List[Type].new();
            for param in member.params then {
                // For Drop trait's drop(self): wrap self parameter type as
                // *unsafe mutable Self for MIR/codegen, matching Swift behavior.
                if member.name == "drop" and param.name == "self" and member.params.count() == 1 then {
                    param_types.push(Type.MutablePointerType(target_type));
                } else {
                    param_types.push(param.param_type);
                };
            };
            let method_symbol = Symbol(
                member.def_id,
                make_function_type(param_types, member.return_type),
                SymbolKind.Function(),
            );
            let param_specs = self.function_param_specs_from_typed_params(member.params);
            let source_def_id = self.context().get_original_def_id(member.def_id) or else member.def_id;
            self.context().register_method_param_specs(type_key, member.name, param_specs);
            self.storage.method_table.register_with_source(type_key, member.name, method_symbol, source_def_id);
            if mark_inherent then {
                self.storage.method_table.mark_inherent(type_key, member.name);
            };
            when target_type in {
                .GenericStruct(template_name, _, _) then {
                    self.context().register_method_param_specs(template_name, member.name, param_specs);
                    self.storage.method_table.register_with_source(template_name, member.name, method_symbol, source_def_id);
                    if mark_inherent then {
                        self.storage.method_table.mark_inherent(template_name, member.name);
                    };
                },
                .GenericEnum(template_name, _, _) then {
                    self.context().register_method_param_specs(template_name, member.name, param_specs);
                    self.storage.method_table.register_with_source(template_name, member.name, method_symbol, source_def_id);
                    if mark_inherent then {
                        self.storage.method_table.mark_inherent(template_name, member.name);
                    };
                },
                .StructureType(def_id) then {
                    if self.context().get_name(def_id) is .Some(name) then {
                        self.context().register_method_param_specs(name, member.name, param_specs);
                        if name <> type_key then {
                            self.storage.method_table.register_with_source(name, member.name, method_symbol, source_def_id);
                            if mark_inherent then {
                                self.storage.method_table.mark_inherent(name, member.name);
                            };
                        };
                    };
                },
                .EnumType(def_id) then {
                    if self.context().get_name(def_id) is .Some(name) then {
                        self.context().register_method_param_specs(name, member.name, param_specs);
                        if name <> type_key then {
                            self.storage.method_table.register_with_source(name, member.name, method_symbol, source_def_id);
                            if mark_inherent then {
                                self.storage.method_table.mark_inherent(name, member.name);
                            };
                        };
                    };
                },
                _ then {},
            };
        };
    };




    module_private register_generic_function_template(
        self,
        name String,
        type_params List[TypeParameter],
        params List[Param],
        return_type TypeNode,
        checked_body Option[TypedExpr],
        checked_parameters Option[List[Symbol]],
        checked_return_type Option[Type],
    ) Void = {
        if self.lookup_current_file_symbol(name) is .Some(sym) then {
            let qualified_name = qualified_trait_key(self.storage.module_path, name);
            when self.storage.generic_templates.lookup_function_by_def_id(sym.def_id) in {
                .Some(existing) then {
                    let new_checked_body = when checked_body in {
                        .Some(_) then checked_body,
                        .None() then existing.checked_body,
                    };
                    let new_checked_parameters = when checked_parameters in {
                        .Some(_) then checked_parameters,
                        .None() then existing.checked_parameters,
                    };
                    let new_checked_return_type = when checked_return_type in {
                        .Some(_) then checked_return_type,
                        .None() then existing.checked_return_type,
                    };
                    let updated = GenericFunctionTemplate(
                        sym.def_id,
                        name,
                        self.to_template_type_params(type_params),
                        self.to_template_params(params),
                        self.copy_type_node(return_type),
                        self.copy_optional_checked_body(new_checked_body),
                        self.copy_optional_symbols(new_checked_parameters),
                        self.copy_optional_type(new_checked_return_type),
                    );
                    self.storage.generic_templates.function_templates.insert(name, updated);
                    self.storage.generic_templates.function_templates.insert(qualified_name, updated);
                },
                .None() then {
                    let template = GenericFunctionTemplate(
                        sym.def_id,
                        name,
                        self.to_template_type_params(type_params),
                        self.to_template_params(params),
                        self.copy_type_node(return_type),
                        checked_body,
                        checked_parameters,
                        checked_return_type,
                    );
                    self.storage.generic_templates.function_templates.insert(name, template);
                    self.storage.generic_templates.function_templates.insert(qualified_name, template);
                },
            };
        };
    };

    // Resolve extension template signature for modifier types (ref/ptr) and weakref types.
    // When the base type is a modifier type, look up extension methods
    // registered under "Ref" / "MutRef" / "Ptr" / "MutPtr" / "WeakRef" / "MutWeakRef" keys.
    // For mutable variants, checks the mutable key first, then falls back to the immutable key.
    module_private resolve_modifier_extension_template_signature(self, base_type Type, method_name String) Option[Symbol] = {
        let mutable keys = List[String].new();
        let mutable inner_type_opt = Option[Type].None();
        when base_type in {
            .ReferenceType(inner) then {
                keys.push("Ref");
                inner_type_opt = Option[Type].Some(inner);
            },
            .MutableReferenceType(inner) then {
                keys.push("MutRef");
                keys.push("Ref");
                inner_type_opt = Option[Type].Some(inner);
            },
            .PointerType(inner) then {
                keys.push("Ptr");
                inner_type_opt = Option[Type].Some(inner);
            },
            .MutablePointerType(inner) then {
                keys.push("MutPtr");
                keys.push("Ptr");
                inner_type_opt = Option[Type].Some(inner);
            },
            _ then { return Option[Symbol].None();},
        };

        let inner_type = when inner_type_opt in {
            .Some(t) then t,
            .None() then { return Option[Symbol].None();},
        };

        for key in keys then {
            when self.storage.generic_templates.lookup_extension_method(
                key,
                method_name,
                Option[UInt].None(),
                Option[UInt].Some(1(UInt)),
            ) in {
                .Some(template) then {
                    let mutable bindings = Dict[String, Type].new();
                    if template.type_params.count() > 0(UInt) then {
                        bindings.insert(template.type_params[0(UInt)].name, inner_type);
                    };
                    bindings.insert("Self", base_type);
                    let mutable typed_params = List[TypedParam].new();
                    for param in template.method.params then {
                        typed_params.push(
                            TypedParam(
                                param.name,
                                param.is_mutable,
                                self.resolve_template_type_node_with_bindings(param.param_type, bindings),
                                param.named,
                            ),
                        );
                    };
                    if typed_params.is_empty() then {
                        continue;
                    };
                    let mutable self_param_type = typed_params[0(UInt)].param_type;
                    if self.is_unresolved_expr_type(self_param_type) then {
                        continue;
                    };
                    let self_matches = self.same_expr_type(self_param_type, base_type) or self.type_matches_expected_pattern(base_type, self_param_type);
                    if not self_matches then {
                        continue;
                    };
                    let return_type = when template.checked_return_type in {
                        .Some(ret) then self.apply_type_bindings(ret, bindings),
                        .None() then Type.Unknown(),
                    };
                    return Option[Symbol].Some(self.make_method_callable_symbol(method_name, typed_params, return_type));
                },
                .None() then {},
            };
        };
        return Option[Symbol].None();
    };

    module_private resolve_weakref_extension_template_signature(self, base_type Type, method_name String) Option[Symbol] = {
        let mutable keys = List[String].new();
        let mutable inner_type_opt = Option[Type].None();
        when base_type in {
            .WeakReferenceType(inner) then {
                keys.push("WeakRef");
                inner_type_opt = Option[Type].Some(inner);
            },
            .MutableWeakReferenceType(inner) then {
                keys.push("MutWeakRef");
                keys.push("WeakRef");
                inner_type_opt = Option[Type].Some(inner);
            },
            _ then { return Option[Symbol].None();},
        };
        let inner_type = when inner_type_opt in {
            .Some(t) then t,
            .None() then { return Option[Symbol].None();},
        };
        for key in keys then {
            when self.storage.generic_templates.lookup_extension_method(
                key,
                method_name,
                Option[UInt].None(),
                Option[UInt].Some(1(UInt)),
            ) in {
                .Some(template) then {
                    let mutable bindings = Dict[String, Type].new();
                    // Bind the type mutable parameter (e.g., T) to the inner type
                    if template.type_params.count() > 0(UInt) then {
                        bindings.insert(template.type_params[0(UInt)].name, inner_type);
                    };
                    bindings.insert("Self", base_type);
                    let mutable typed_params = List[TypedParam].new();
                    for param in template.method.params then {
                        typed_params.push(
                            TypedParam(
                                param.name,
                                param.is_mutable,
                                self.resolve_template_type_node_with_bindings(param.param_type, bindings),
                                param.named,
                            ),
                        );
                    };
                    let return_type = when template.checked_return_type in {
                        .Some(ret) then self.apply_type_bindings(ret, bindings),
                        .None() then Type.Unknown(),
                    };
                    return Option[Symbol].Some(self.make_method_callable_symbol(method_name, typed_params, return_type));
                },
                .None() then {},
            };
        };
        return Option[Symbol].None();
    };

    module_private maybe_record_extension_method_instantiation(self, base_type Type, method_name String, method_type_args List[Type]) Void = {
        let normalized_base = base_type;
        if self.contains_generic_parameter(normalized_base) then { return;};
        if self.contains_generic_parameter_in_list(method_type_args) then { return;};

        let mutable template_name_opt = Option[String].None();
        let mutable extension_type_args = List[Type].new();
        when normalized_base in {
            .GenericStruct(template_name, _, args) then {
                template_name_opt = Option[String].Some(template_name);
                for arg in args then {
                    extension_type_args.push(arg);
                };
            },
            .GenericEnum(template_name, _, args) then {
                template_name_opt = Option[String].Some(template_name);
                for arg in args then {
                    extension_type_args.push(arg);
                };
            },
            .StructureType(def_id) then {
                when self.context().get_template_name(def_id) in {
                    .Some(template_name) then {
                        template_name_opt = Option[String].Some(template_name);
                        when self.context().get_type_arguments(def_id) in {
                            .Some(actual_args) then {
                                for arg in actual_args then {
                                    extension_type_args.push(arg);
                                };
                            },
                            .None() then {
                                when self.context().lookup_type(def_id) in {
                                    .Some(mapped_type) then when mapped_type in {
                                        .GenericStruct(_, _, mapped_args) then {
                                            for arg in mapped_args then {
                                                extension_type_args.push(arg);
                                            };
                                        },
                                        .GenericEnum(_, _, mapped_args) then {
                                            for arg in mapped_args then {
                                                extension_type_args.push(arg);
                                            };
                                        },
                                        _ then {},
                                    },
                                    .None() then {},
                                };
                            },
                        };
                    },
                    .None() then {
                        if self.context().get_name(def_id) is .Some(name) then {
                            template_name_opt = Option[String].Some(name);
                        };
                    },
                };
            },
            .EnumType(def_id) then {
                when self.context().get_template_name(def_id) in {
                    .Some(template_name) then {
                        template_name_opt = Option[String].Some(template_name);
                        when self.context().get_type_arguments(def_id) in {
                            .Some(actual_args) then {
                                for arg in actual_args then {
                                    extension_type_args.push(arg);
                                };
                            },
                            .None() then {
                                when self.context().lookup_type(def_id) in {
                                    .Some(mapped_type) then when mapped_type in {
                                        .GenericStruct(_, _, mapped_args) then {
                                            for arg in mapped_args then {
                                                extension_type_args.push(arg);
                                            };
                                        },
                                        .GenericEnum(_, _, mapped_args) then {
                                            for arg in mapped_args then {
                                                extension_type_args.push(arg);
                                            };
                                        },
                                        _ then {},
                                    },
                                    .None() then {},
                                };
                            },
                        };
                    },
                    .None() then {
                        if self.context().get_name(def_id) is .Some(name) then {
                            template_name_opt = Option[String].Some(name);
                        };
                    },
                };
            },
            .ReferenceType(inner) then {
                template_name_opt = Option[String].Some("Ref");
                extension_type_args.push(inner);
            },
            .MutableReferenceType(inner) then {
                template_name_opt = Option[String].Some("MutRef");
                extension_type_args.push(inner);
            },
            .PointerType(inner) then {
                template_name_opt = Option[String].Some("Ptr");
                extension_type_args.push(inner);
            },
            .WeakReferenceType(inner) then {
                template_name_opt = Option[String].Some("WeakRef");
                extension_type_args.push(inner);
            },
            .MutableWeakReferenceType(inner) then {
                template_name_opt = Option[String].Some("MutWeakRef");
                extension_type_args.push(inner);
            },
            _ then {},
        };

        let template_name = when template_name_opt in {
            .Some(name) then name,
            .None() then { return;},
        };
        let method_type_args_ref = self.to_type_ref_list(method_type_args);
        let receiver_is_generic_instance = when normalized_base in {
            .GenericStruct(_, _, _) then true,
            .GenericEnum(_, _, _) then true,
            _ then false,
        };
        let mutable recorded = false;
        if self.storage.generic_templates.lookup_extension_methods(template_name) is .Some(ext_templates) then {
            if select_extension_template(
                ext_templates,
                method_name,
                Option[UInt].Some(method_type_args_ref.count()),
                Option[UInt].Some(extension_type_args.count()),
            ) is .Some(template) then {
                let request_template = self.copied_extension_method_template(

                    template.type_params,

                    template.method,

                    template.conformance_trait_name,
            template.conformance_trait_def_id,

                    template.conformance_target_type,

                    template.conformance_trait_args,

                    template.uses_trait_type_params,

                    template.source_file,

                    template.module_path,

                    template.package_id,

                    template.checked_body,

                    template.checked_parameters,

                    template.checked_return_type
        );
                self.record_instantiation_request(InstantiationRequest(
                    InstantiationKind.ExtensionMethod(
                        template_name,
                        normalized_base,
                        request_template,
                        extension_type_args,
                        method_type_args_ref,
                        ),
                    0,
                    self.storage.file_path,
                ));
                recorded = true;
            };
        };
        if recorded then { return;};

        let conformance_key = self.conformance_template_key(normalized_base);
        when self.storage.conformance_index.get(conformance_key) in {
            .Some(conformances) then {
                for conformance in conformances then {
                    let mutable conformance_bindings = Dict[String, Type].new();
                    if not self.conformance_type_key_matches(conformance.target_type, normalized_base, conformance_bindings) then {
                        continue;
                    };
                    let trait_name = conformance.trait_name;
                    let trait_templates = self.storage.generic_templates.lookup_extension_methods(trait_name) or else {
                        continue;
                    };
                    let matched_template = select_extension_template(
                        trait_templates,
                        method_name,
                        Option[UInt].Some(method_type_args_ref.count()),
                        Option[UInt].Some(conformance.trait_arg_types.count()),
                    ) or else {
                        continue;
                    };
                    let mutable concrete_trait_args = List[Type].new();
                    for trait_arg in conformance.trait_arg_types then {
                        concrete_trait_args.push(self.apply_type_bindings(trait_arg, conformance_bindings));
                    };
                    let request_template = self.copied_extension_method_template(

                        matched_template.type_params,

                        matched_template.method,

                        matched_template.conformance_trait_name,
            matched_template.conformance_trait_def_id,

                        matched_template.conformance_target_type,

                        matched_template.conformance_trait_args,

                        matched_template.uses_trait_type_params,

                        matched_template.source_file,

                        matched_template.module_path,

                        matched_template.package_id,

                        matched_template.checked_body,

                        matched_template.checked_parameters,

                        matched_template.checked_return_type
        );
                    self.record_instantiation_request(InstantiationRequest(
                        InstantiationKind.ExtensionMethod(
                            trait_name,
                            normalized_base,
                            request_template,
                            concrete_trait_args,
                            method_type_args_ref,
                        ),
                        0,
                        self.storage.file_path,
                    ));
                    return;
                };
            },
            .None() then {},
        };
    };

    module_private maybe_record_trait_method_instantiation(self, base_type Type, method_name String, method_type_args List[Type]) Void = {
        let normalized_base = when base_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then base_type,
        };
        if self.contains_generic_parameter(normalized_base) then { return;};
        if self.contains_generic_parameter_in_list(method_type_args) then { return;};
        self.record_instantiation_request(InstantiationRequest(
            InstantiationKind.TraitMethod(normalized_base, method_name, self.to_type_ref_list(method_type_args)),
            0,
            self.storage.file_path,
        ));
    };

};
