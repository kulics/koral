// Pass 1 – Name Collector
// Scans all top-level declarations and registers their names in the global scope.
// Does NOT inspect function bodies.

public type mutable NameCollector(
    mutable context CompilerContext,
    mutable global_scope Scope,
    mutable diagnostics DiagnosticCollector,
    mutable module_path List[String],
    mutable source_file String,
    mutable package_id String,
    mutable std_type_names Set[String],
);

given NameCollector {
    public new() NameCollector = {
        return NameCollector(CompilerContext.new(), Scope.new_root(), DiagnosticCollector.new(), List[String].new(), "", "", Set[String].new());
    };

    public new_with_context(module_path List[String], source_file String) NameCollector = {
        return NameCollector(CompilerContext.new(), Scope.new_root(), DiagnosticCollector.new(), module_path, source_file, "", Set[String].new());
    };

    // Register all top-level names from a program.
    public collect(self, program Program) Void = {
        for decl in program.declarations then {
            self.collect_decl(decl);
        };
    };

    // Register all top-level names from a list of LoadedNodes (multi-module compilation).
    // Each node carries its own source_file; module_path is provided per-node via pairs.
    public collect_loaded_nodes_with_path(self, pairs List[Pair[LoadedNode, List[String]]]) Void = {
        let saved_module_path = self.module_path;
        let saved_source_file = self.source_file;
        let saved_package_id = self.package_id;
        for pair in pairs then {
            self.module_path = pair.second;
            self.source_file = pair.first.source_file;
            self.package_id = pair.first.package_id;
            self.collect_decl(pair.first.decl);
        };
        self.module_path = saved_module_path;
        self.source_file = saved_source_file;
        self.package_id = saved_package_id;
    };

    file_private make_var_symbol(self, name String, is_mutable Bool, access AccessModifier, span SourceSpan) Symbol = {
        let kind = if is_mutable then SymbolKind.Variable(VariableKind.MutableValue()) else SymbolKind.Variable(VariableKind.Value());
        let mutable context = self.context;
        let def_id = context.allocate_full_in_package(name, DefKind.Variable(), self.module_path, self.source_file, self.package_id, access, span);
        return Symbol(def_id, Type.Unknown(), kind);
    };

    file_private make_fn_symbol(self, name String, access AccessModifier, span SourceSpan) Symbol = {
        let mutable context = self.context;
        let def_id = context.allocate_full_in_package(name, DefKind.Function(), self.module_path, self.source_file, self.package_id, access, span);
        return Symbol(def_id, Type.Unknown(), SymbolKind.Function());
    };

    file_private duplicate_definition_message(self, name String) String = {
        let _ = self;
        let mutable message = StringBuilder.new();
        message.push_string("Duplicate definition: ");
        message.push_string(name);
        return message.to_string();
    };

    file_private is_std_package(self) Bool = {
        return self.package_id == "std:std";
    };

    file_private reserve_std_type_name_if_needed(self, name String, access AccessModifier) Bool = {
        if self.is_std_package() then {
            if access is not .FilePrivate() then {
                self.std_type_names.insert(name);
            };
            return false;
        };
        return access is not .FilePrivate() and self.std_type_names.contains(name);
    };

    file_private push_name_diagnostic(self, message String) Void = {
        self.diagnostics.push(make_diagnostic(DiagnosticStage.Semantic(), self.source_file, message));
    };

    file_private has_conflicting_top_level_name(self, name String, access AccessModifier) Bool = {
        return self.has_existing_top_level_definition(name, access);
    };

    file_private has_conflicting_top_level_type_name(self, name String, access AccessModifier) Bool = {
        return self.has_existing_top_level_definition(name, access);
    };

    file_private has_existing_top_level_definition(self, name String, access AccessModifier) Bool = {
        let mutable id UInt = 1;
        let next_def_id = self.context.next_def_id();
        while id < next_def_id then {
            let def_id = DefId(id);
            if self.context.get_name(def_id) is .Some(existing_name) and existing_name == name then {
                let existing_module = self.context.get_module_path(def_id) or else List[String].new();
                if string_list_eq(existing_module, self.module_path) then {
                    if access is not .FilePrivate() then {
                        return true;
                    };
                    let existing_source = self.context.get_source_file(def_id);
                    if source_file_matches(existing_source, Option[String].Some(self.source_file)) then {
                        return true;
                    };
                };
            };
            id += 1;
        };
        return false;
    };

    file_private collect_decl(self, decl Decl) Void = {
        when decl in {
            .TypeStructDecl(access, name, is_mutable_type, type_params, fields, span) then {
                if self.reserve_std_type_name_if_needed(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                if self.has_conflicting_top_level_type_name(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                let kind = if type_params.is_empty() then DefKind.TypeDef(TypeDefKind.Structure()) else DefKind.GenericTemplate(GenericTemplateKind.Structure());
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(name, kind, self.module_path, self.source_file, self.package_id, access, span);
                context.set_struct_mutable(def_id, is_mutable_type);
                let t = Type.StructureType(def_id);
                self.global_scope.define_type(name, t);
            },
            .TypeEnumDecl(access, name, type_params, cases, span) then {
                if self.reserve_std_type_name_if_needed(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                if self.has_conflicting_top_level_type_name(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                let kind = if type_params.is_empty() then DefKind.TypeDef(TypeDefKind.Enum()) else DefKind.GenericTemplate(GenericTemplateKind.Enum());
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(name, kind, self.module_path, self.source_file, self.package_id, access, span);
                let t = Type.EnumType(def_id);
                self.global_scope.define_type(name, t);
            },
            .TypeAliasDecl(access, name, target, span) then {
                if self.has_conflicting_top_level_type_name(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(name, DefKind.TypeDef(TypeDefKind.Structure()), self.module_path, self.source_file, self.package_id, access, span);
                self.global_scope.define_type(name, Type.StructureType(def_id));
            },
            .IntrinsicTypeDecl(access, name, type_params, span) then {
                if self.has_conflicting_top_level_type_name(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                // Register intrinsic types as their dedicated enum cases (matching Swift compiler)
                // so that conformance keys are consistent between scope lookup and hardcoded checks.
                let intrinsic_type = when name in {
                    "Bool" then Type.BoolType(),
                    "Never" then Type.NeverType(),
                    "Int" then Type.IntType(),
                    "Int8" then Type.Int8Type(),
                    "Int16" then Type.Int16Type(),
                    "Int32" then Type.Int32Type(),
                    "Int64" then Type.Int64Type(),
                    "UInt" then Type.UIntType(),
                    "UInt8" then Type.UInt8Type(),
                    "UInt16" then Type.UInt16Type(),
                    "UInt32" then Type.UInt32Type(),
                    "UInt64" then Type.UInt64Type(),
                    "Float32" then Type.Float32Type(),
                    "Float64" then Type.Float64Type(),
                    _ then {
                        // Unknown intrinsic type - allocate as OpaqueType
                        let mutable context = self.context;
                        let def_id = context.allocate_full_in_package(name, DefKind.TypeDef(TypeDefKind.Opaque()), self.module_path, self.source_file, self.package_id, access, span);
                        yield Type.OpaqueType(def_id);
                    },
                };
                self.global_scope.define_type(name, intrinsic_type);
            },
            .ForeignTypeDecl(access, name, cname, fields, span) then {
                if self.has_conflicting_top_level_type_name(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                let kind = when fields in {
                    .Some(_) then DefKind.TypeDef(TypeDefKind.Structure()),
                    .None() then DefKind.TypeDef(TypeDefKind.Opaque()),
                };
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(name, kind, self.module_path, self.source_file, self.package_id, access, span);
                let t = when fields in {
                    .Some(_) then Type.StructureType(def_id),
                    .None() then Type.OpaqueType(def_id),
                };
                self.global_scope.define_type(name, t);
            },
            .TraitDecl(access, name, type_params, parents, members, span) then {
                let trait_source_file = when access in {
                    .FilePrivate() then Option[String].Some(self.source_file),
                    _ then Option[String].None(),
                };
                if self.has_existing_top_level_definition(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(name, DefKind.TypeDef(TypeDefKind.Trait()), self.module_path, self.source_file, self.package_id, access, span);
                let mutable trait_type_args = List[Type].new();
                for type_param in type_params then {
                    trait_type_args.push(Type.GenericParameter(type_param.name));
                };
                self.global_scope.define_type(name, Type.TraitObject(name, def_id, trait_type_args));
            },
            .FunctionDecl(access, name, type_params, params, return_type, body, span) then {
                if self.has_conflicting_top_level_name(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                let kind = if type_params.is_empty() then DefKind.Function() else DefKind.GenericTemplate(GenericTemplateKind.Function());
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(name, kind, self.module_path, self.source_file, self.package_id, access, span);
                let sym = Symbol(def_id, Type.Unknown(), SymbolKind.Function());
                self.global_scope.define(self.context, sym);
            },
            .IntrinsicFunctionDecl(access, name, type_params, params, return_type, span) then {
                if self.has_conflicting_top_level_name(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(name, DefKind.Function(), self.module_path, self.source_file, self.package_id, access, span);
                let sym = Symbol(def_id, Type.Unknown(), SymbolKind.Function());
                self.global_scope.define(self.context, sym);
            },
            .ForeignFunctionDecl(access, name, params, return_type, span) then {
                if self.has_conflicting_top_level_name(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(name, DefKind.Function(), self.module_path, self.source_file, self.package_id, access, span);
                let sym = Symbol(def_id, Type.Unknown(), SymbolKind.Function());
                self.global_scope.define(self.context, sym);
            },
            .LetDecl(access, name, is_mutable, type_name, initializer, span) then {
                if self.has_conflicting_top_level_name(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                let sym = self.make_var_symbol(name, is_mutable, access, span);
                self.global_scope.define(self.context, sym);
            },
            .ForeignLetDecl(access, name, is_mutable, type_name, span) then {
                if self.has_conflicting_top_level_name(name, access) then {
                    self.push_name_diagnostic(self.duplicate_definition_message(name));
                    return;
                };
                let sym = self.make_var_symbol(name, is_mutable, access, span);
                self.global_scope.define(self.context, sym);
            },
            // Declarations that don't introduce names into the value/type namespace
            .ModuleUsingDecl(_, _, _) then {},
            .FileUsingDecl(_, _) then {},
            .GivenDecl(_, _, _, _) then {},
            .GivenTraitDecl(_, _, _, _, _) then {},
            .GivenNotTraitDecl(_, _, _, _) then {},
            .IntrinsicGivenDecl(_, _, _, _) then {},
        };
    };
};
