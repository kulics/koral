// Scope management for name resolution.
// Scope 使用 storage ref 模式（与 TypeChecker 相同），
// 确保 define/lookup 的修改能正确传播，无需到处传 ref。

module_private type mutable ScopeStorage(
    mutable entries Dict[String, Symbol],
    mutable entry_list List[Symbol],
    mutable local_entry_list List[Symbol],
    mutable type_entries Dict[String, Type],
    mutable generic_params Set[String],
    parent Option[Scope],
    // Ambient for NAME RESOLUTION (never identity): what this module imports and
    // from which file. See `GenericTemplateRegistry.candidate_keys`.
    mutable import_graph Option[ImportGraph],
    mutable source_file Option[String],
);

public type mutable Scope(module_private mutable storage ScopeStorage);

given Scope {
    public new_root() Scope = {
        let s = ScopeStorage(
            Dict[String, Symbol].new(),
            List[Symbol].new(),
            List[Symbol].new(),
            Dict[String, Type].new(),
            Set[String].new(),
            Option[Scope].None(),
            Option[ImportGraph].None(),
            Option[String].None()
        );
        return Scope(s);
    };

    public new_child(parent Scope) Scope = {
        let s = ScopeStorage(
            Dict[String, Symbol].new(),
            List[Symbol].new(),
            List[Symbol].new(),
            Dict[String, Type].new(),
            Set[String].new(),
            Option[Scope].Some(parent),
            Option[ImportGraph].None(),
            Option[String].None()
        );
        return Scope(s);
    };

    // Create a child scope with generic parameters and optional Self binding.
    // Mirrors Swift's pattern: withNewScope { defineGenericParameter(...); defineType("Self", ...) }
    // storage ref 模式：self 值传递，mutations 通过 storage ref 自动传播
    public define(self, context CompilerContext, symbol Symbol) Void = {
        let name = context.symbol_name(symbol);
        self.storage.entries.insert(name, symbol);
    };

    public define_type(self, name String, t Type) Void = {
        self.storage.type_entries.insert(name, t);
    };

    /// Register a MODULE-SCOPED type under both its bare name and a
    /// module-qualified one. Use plain `define_type` for LOCAL bindings.
    public define_scoped_type(self, module_path List[String], name String, t Type) Void = {
        self.define_type(name, t);
        self.define_type(qualified_symbol_key(module_path, name), t);
    };

    /// The type `name` denotes in `module_path` through its IMPORTS.
    ///
    /// 2. a symbol import (`using m { x }`; `using m { x as y }` spells `y` and
    ///    declares `x`), 3. a batch/module import (`using m { .. }`) which
    ///    creates no symbol edge and keeps the same spelling.
    file_private imported_type_entry(self, current Scope, name String, module_path List[String]) Option[Type] = {
        let graph = when current.storage.import_graph in {
            .Some(g) then g,
            .None() then { return Option[Type].None(); },
        };
        let mutable targets = List[Pair[List[String], String]].new();
        when graph.symbol_import_candidates(name) in {
            .Some(candidates) then {
                for edge in candidates then {
                    if edge.symbol == name
                        and string_list_eq(edge.module, module_path)
                        and source_file_matches(edge.source_file, current.storage.source_file) then {
                        targets.push(Pair[List[String], String](edge.target, edge.original_symbol));
                    };
                };
            },
            .None() then {},
        };
        for edge in graph.edges then {
            if string_list_eq(edge.source, module_path)
                and source_file_matches(edge.source_file, current.storage.source_file) then {
                targets.push(Pair[List[String], String](edge.target, name));
            };
        };
        for pair in targets then {
            let qualified = qualified_symbol_key(pair.first, pair.second);
            when current.storage.type_entries.get(qualified) in {
                .Some(t) then { return Option[Type].Some(t); },
                .None() then {},
            };
        };
        return Option[Type].None();
    };

    /// Install the ambient import context used by `lookup_type_in_module`.
    public set_import_context(self, import_graph Option[ImportGraph], source_file Option[String]) Void = {
        self.storage.import_graph = import_graph;
        self.storage.source_file = source_file;
    };

    /// The type registered for `name`, preferring the one declared in
    /// `module_path`. Walks the chain so an inner binding still shadows.
    public lookup_type_in_module(self, name String, module_path List[String]) Option[Type] = {
        let qualified = qualified_symbol_key(module_path, name);
        let mutable current_opt = Option[Scope].Some(self);
        let mutable traversed UInt = 0;
        while current_opt is .Some(_) then {
            let current = when current_opt in {
                .Some(scope) then scope,
                .None() then self,
            };
            if current.storage.generic_params.contains(name) then {
                when current.storage.type_entries.get(name) in {
                    .Some(t) then { return Option[Type].Some(t); },
                    .None() then {},
                };
            };
            when current.storage.type_entries.get(qualified) in {
                .Some(t) then { return Option[Type].Some(t); },
                .None() then {},
            };
            // What this module IMPORTS under this spelling wins over the
            // unqualified entry below: that one is last-wins across modules and
            // so cannot answer "which `Box`?". See
            // `GenericTemplateRegistry.candidate_keys` for the full order.
            when self.imported_type_entry(current, name, module_path) in {
                .Some(t) then { return Option[Type].Some(t); },
                .None() then {},
            };
            when current.storage.type_entries.get(name) in {
                .Some(t) then {
                    return Option[Type].Some(t);
                },
                .None() then {},
            };
            traversed += 1;
            if traversed > 4096(UInt) then {
                return Option[Type].None();
            };
            current_opt = current.storage.parent;
        };
        return Option[Type].None();
    };

    public lookup(self, name String) Option[Symbol] = {
        let mutable current_opt = Option[Scope].Some(self);
        let mutable traversed UInt = 0;

        while current_opt is .Some(_) then {
            let current = when current_opt in {
                .Some(scope) then scope,
                .None() then self,
            };

            when current.storage.entries.get(name) in {
                .Some(symbol) then { return .Some(symbol);},
                .None() then {},
            };

            traversed += 1;
            if traversed > 4096(UInt) then {
                return .None();
            };

            current_opt = current.storage.parent;
        };

        return .None();
    };

    public lookup_type(self, name String) Option[Type] = {
        let mutable current_opt = Option[Scope].Some(self);
        let mutable traversed UInt = 0;

        while current_opt is .Some(_) then {
            let current = when current_opt in {
                .Some(scope) then scope,
                .None() then self,
            };

            // Generic params have highest priority (matches Swift's genericParameters check)
            if current.storage.generic_params.contains(name) then {
                when current.storage.type_entries.get(name) in {
                    .Some(t) then { return .Some(t);},
                    .None() then {},
                };
            };

            when current.storage.type_entries.get(name) in {
                .Some(t) then { return .Some(t);},
                .None() then {},
            };

            traversed += 1;
            if traversed > 4096(UInt) then {
                return .None();
            };

            current_opt = current.storage.parent;
        };

        return .None();
    };

    // 只查当前层，不递归父链（用于重复定义检查）
    public lookup_local(self, name String) Option[Symbol] = {
        return self.storage.entries.get(name);
    };

    public lookup_local_type(self, name String) Option[Type] = {
        return self.storage.type_entries.get(name);
    };

    public parent_scope(self) Option[Scope] = {
        return self.storage.parent;
    };

    // 注册泛型参数：同时写入 type_entries 并记录到 generic_params 集合
    public define_generic_param(self, name String) Void = {
        self.define_type(name, Type.GenericParameter(name));
        self.storage.generic_params.insert(name);
    };

    /// A type parameter bound to a specific type, as opposed to
    /// `define_generic_param` which binds it to itself.
    ///
    /// Still a BINDER: it goes into `generic_params`, so it shadows a
    /// same-named module-level type. Recording the substitution with plain
    /// `define_type` would leave `lookup_generic_param_type` unable to see it,
    /// and the name would fall through to a global of the same spelling -- which
    /// is how a user's `type T` became the meaning of std's `[T ...]` parameter.
    public define_generic_binding(self, name String, t Type) Void = {
        self.define_type(name, t);
        self.storage.generic_params.insert(name);
    };

    // 判断名称是否通过 define_generic_param 注册（普通 define_type 不算）
    public is_generic_param(self, name String) Bool = {
        return self.storage.generic_params.contains(name);
    };

    /// The type parameter named `name`, if any enclosing scope declares one.
    ///
    /// Walks the scope chain and matches ONLY generic parameters -- never an
    /// ordinary type entry. That distinction matters: a type parameter must
    /// shadow a same-named module-level type, while two same-named module-level
    /// types must still be disambiguated by their (module, name) identity.
    public lookup_generic_param_type(self, name String) Option[Type] = {
        let mutable current_opt = Option[Scope].Some(self);
        let mutable traversed UInt = 0;
        while current_opt is .Some(_) then {
            let current = when current_opt in {
                .Some(scope) then scope,
                .None() then self,
            };
            if current.storage.generic_params.contains(name) then {
                when current.storage.type_entries.get(name) in {
                    .Some(t) then { return Option[Type].Some(t); },
                    .None() then {},
                };
            };
            traversed += 1;
            if traversed > 4096(UInt) then {
                return Option[Type].None();
            };
            current_opt = current.storage.parent;
        };
        return Option[Type].None();
    };

    public is_local_type_binding(self, name String) Bool = {
        if self.storage.parent is .None() then {
            return false;
        };
        return self.storage.type_entries.get(name) is .Some(_);
    };

    // 返回当前层的所有类型条目（不递归父链）。
    public all_types(self) Dict[String, Type] = {
        return self.storage.type_entries;
    };

    // 返回当前层注册的泛型参数集合（不递归父链）。
    public all_generic_params(self) Set[String] = {
        return self.storage.generic_params;
    };

    public entry_count(self) UInt = {
        return self.storage.entries.count();
    };

    public local_entry_count(self) UInt = {
        return self.storage.local_entry_list.count();
    };

    public type_entry_count(self) UInt = {
        return self.storage.type_entries.count();
    };

    public generic_param_count(self) UInt = {
        return self.storage.generic_params.count();
    };


};
