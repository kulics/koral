using std::os { env };

file_private type BuiltinSubscriptKind {
    String(),
    List(element Type),
    Deque(element Type),
    Dict(key Type, value Type),
    Pointer(element Type, is_mutable Bool),
};

given TypeChecker {


    module_private box_type(self, inner Type) Type = {
        let _ = self;
        return inner;
    };

    module_private method_param_specs(self, method Symbol) List[FunctionParamSpec] = {
        return self.context().get_param_specs(method.def_id) or else List[FunctionParamSpec].new();
    };

    module_private method_param_count(self, method Symbol) UInt = {
        return when method.symbol_type in {
            .FunctionType(params, _) then params.count(),
            _ then 0(UInt),
        };
    };

    module_private method_param_type(self, method Symbol, index UInt) Option[Type] = {
        return when method.symbol_type in {
            .FunctionType(params, _) then
                if index < params.count() then Option[Type].Some((params[index]).param_type) else Option[Type].None(),
            _ then Option[Type].None(),
        };
    };

    module_private method_return_type(self, method Symbol) Type = {
        return when method.symbol_type in {
            .FunctionType(_, return_type_ref) then return_type_ref,
            _ then Type.Unknown(),
        };
    };

    module_private receiver_wrapper_family(self, receiver_type Type) Int = {
        return when self.normalize_method_receiver_type(receiver_type) in {
            .MutableReferenceType(_) then 1,
            .ReferenceType(_) then 1,
            .MutableBorrowedReferenceType(_) then 2,
            .BorrowedReferenceType(_) then 2,
            .WeakReferenceType(_) then 3,
            .MutableWeakReferenceType(_) then 3,
            .PointerType(_) then 4,
            .MutablePointerType(_) then 4,
            _ then 0,
        };
    };

    module_private receiver_wrapper_is_mutable(self, receiver_type Type) Bool = {
        return when self.normalize_method_receiver_type(receiver_type) in {
            .MutableReferenceType(_) then true,
            .MutableBorrowedReferenceType(_) then true,
            .MutableWeakReferenceType(_) then true,
            .MutablePointerType(_) then true,
            _ then false,
        };
    };

    module_private receiver_wrapper_mutability_compatible(self, receiver_type Type, expected_self_type Type) Bool = {
        let receiver_mutable = self.receiver_wrapper_is_mutable(receiver_type);
        let expected_mutable = self.receiver_wrapper_is_mutable(expected_self_type);
        if expected_mutable and not receiver_mutable then {
            return false;
        };
        return true;
    };

    module_private method_symbol_accepts_receiver_shape(self, receiver_type Type, method Symbol) Bool = {
        if self.method_param_count(method) == 0 then {
            return true;
        };
        let normalized_receiver = self.normalize_method_receiver_type(receiver_type);
        let expected_self = self.method_param_type(method, 0(UInt)) or else normalized_receiver;
        let normalized_expected_self = self.normalize_method_receiver_type(expected_self);
        let receiver_family = self.receiver_wrapper_family(normalized_receiver);
        let expected_family = self.receiver_wrapper_family(normalized_expected_self);
        // Only enforce strict wrapper-shape matching when the receiver itself is
        // already wrapper-like. Keep normal value->ref adaptation unchanged.
        if receiver_family == 0 then {
            return true;
        };
        if receiver_family <> 0 then {
            if expected_family == 0 then {
                return false;
            };
            if receiver_family <> expected_family then {
                return false;
            };
            if not self.receiver_wrapper_mutability_compatible(normalized_receiver, normalized_expected_self) then {
                return false;
            };
        };
        return self.type_matches_expected_pattern(normalized_expected_self, normalized_receiver) or self.type_matches_expected_pattern(normalized_receiver, normalized_expected_self);
    };

    module_private bind_method_symbol_type(self, method Symbol, bindings Dict[String, Type]) Symbol = {
        let bound_type = self.apply_type_bindings(method.symbol_type, bindings);
        return Symbol(method.def_id, bound_type, method.kind);
    };

    module_private method_param_types(self, method Symbol) List[Type] = {
        return when method.symbol_type in {
            .FunctionType(params, _) then {
                let mutable out = List[Type].new();
                for entry in params then {
                    out.push(entry.param_type);
                };
                yield out;
            },
            _ then List[Type].new(),
        };
    };

    module_private rebuild_method_symbol(self, method_name String, base_method Symbol, param_types List[Type], return_type Type) Symbol = {
        let _ = self;
        let _ = method_name;
        return Symbol(base_method.def_id, make_function_type(self.to_type_ref_list(param_types), return_type), base_method.kind);
    };

    module_private builtin_subscript_base_type(self, t Type) Type = {
        let _ = self;
        return when t in {
            .ReferenceType(inner) then inner,
            .MutableReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            _ then t,
        };
    };

    module_private resolve_builtin_subscript_kind(self, base_type Type) Option[BuiltinSubscriptKind] = {
        let unwrapped = self.builtin_subscript_base_type(base_type);
        return when unwrapped in {
            .StructureType(def_id) then {
                let type_name = self.context().get_name(def_id) or else "";
                if type_name == "String" then {
                    return Option[BuiltinSubscriptKind].Some(BuiltinSubscriptKind.String());
                };
                let template_name_opt = self.context().get_template_name(def_id);
                let type_args_opt = self.context().get_type_arguments(def_id);
                yield when template_name_opt in {
                    .Some(template_name) then when type_args_opt in {
                        .Some(type_args) then {
                            if type_args.count() == 1(UInt) and template_name == "List" then {
                                return Option[BuiltinSubscriptKind].Some(BuiltinSubscriptKind.List(type_args[0(UInt)]));
                            };
                            if type_args.count() == 1(UInt) and template_name == "Deque" then {
                                return Option[BuiltinSubscriptKind].Some(BuiltinSubscriptKind.Deque(type_args[0(UInt)]));
                            };
                            if type_args.count() == 2(UInt) and template_name == "Dict" then {
                                return Option[BuiltinSubscriptKind].Some(BuiltinSubscriptKind.Dict(type_args[0(UInt)], type_args[1(UInt)]));
                            };
                            yield Option[BuiltinSubscriptKind].None();
                        },
                        .None() then Option[BuiltinSubscriptKind].None(),
                    },
                    .None() then Option[BuiltinSubscriptKind].None(),
                };
            },
            .GenericStruct(template_name, _, type_args) then {
                if template_name == "List" and type_args.count() == 1(UInt) then {
                    return Option[BuiltinSubscriptKind].Some(BuiltinSubscriptKind.List((type_args[0(UInt)])));
                };
                if template_name == "Deque" and type_args.count() == 1(UInt) then {
                    return Option[BuiltinSubscriptKind].Some(BuiltinSubscriptKind.Deque((type_args[0(UInt)])));
                };
                if template_name == "Dict" and type_args.count() == 2(UInt) then {
                    return Option[BuiltinSubscriptKind].Some(BuiltinSubscriptKind.Dict((type_args[0(UInt)]), (type_args[1(UInt)])));
                };
                yield Option[BuiltinSubscriptKind].None();
            },
            .PointerType(inner) then Option[BuiltinSubscriptKind].Some(BuiltinSubscriptKind.Pointer(inner, false)),
            .MutablePointerType(inner) then Option[BuiltinSubscriptKind].Some(BuiltinSubscriptKind.Pointer(inner, true)),
            _ then Option[BuiltinSubscriptKind].None(),
        };
    };

    module_private build_builtin_subscript_helper_call(self, base TypedExpr, args List[TypedExpr], helper_name String) TypedExpr = {
        let normalized_base_type = self.builtin_subscript_base_type(base.expr_type);
        self.maybe_record_extension_method_instantiation(normalized_base_type, helper_name, List[Type].new());
        let method = self.resolve_method_signature(normalized_base_type, helper_name) or else {
            self.push_diagnostic_at_span(
                "Missing builtin subscript helper '\(helper_name)' for type '\(self.context().type_display_name(normalized_base_type))'",
                self.typed_expr_span(base)
            );
            return self.empty_typed_block(Type.Unknown());
        };

        let mutable expected_self_type = self.resolve_bound_method_self_type(base.expr_type, method);
        let prepared_base = self.prepare_call_receiver(base, expected_self_type);
        let adapted_base = self.adapt_receiver_to_expected_self_type_for_method(prepared_base.first, expected_self_type, helper_name);
        let param_types = self.resolve_signature_param_types(adapted_base.expr_type, method);

        let mutable typed_args = List[TypedExpr].new();
        let mutable arg_idx UInt = 0;
        for arg_ref in args then {
            let mutable expected_arg_type = when param_types.get(arg_idx) in {
                .Some(param_type) then Option[Type].Some(param_type),
                .None() then Option[Type].None(),
            };
            typed_args.push(self.adapt_expr_to_expected_type(arg_ref, expected_arg_type));
            arg_idx += 1;
        };

        let mutable bindings = self.resolve_signature_method_type_bindings(adapted_base.expr_type, method, List[Type].new());
        let mutable param_idx UInt = 1;
        while param_idx < self.method_param_count(method) and (param_idx - 1(UInt)) < typed_args.count() then {
            let param_type = self.method_param_type(method, param_idx) or else Type.Unknown();
            self.infer_type_bindings(param_type, (typed_args[param_idx - 1(UInt)]).expr_type, bindings);
            param_idx += 1(UInt);
        };

        let bound_method = self.bind_method_symbol_type(method, bindings);
        let return_type = self.apply_type_bindings(self.method_return_type(method), bindings);
        let callee = make_typed_expr(
            TypedExprKind.MethodReference(adapted_base, adapted_base.expr_type, bound_method, List[Type].new(), List[Type].new(), .None()),
            bound_method.symbol_type,
        );
        let call_expr = make_typed_expr(TypedExprKind.Call(callee, typed_args), return_type);
        return self.wrap_receiver_materialized_call(prepared_base.second, base, call_expr);
    };

    module_private resolve_builtin_subscript_as_reference(self, base TypedExpr, args List[TypedExpr], is_mutable Bool) TypedExpr = {
        return when self.resolve_builtin_subscript_kind(base.expr_type) in {
            .Some(kind) then when kind in {
                .String() then {
                    if is_mutable then {
                        self.push_diagnostic_at_span("String subscript is not addressable", self.typed_expr_span(base));
                        yield make_typed_expr(TypedExprKind.Block(List[TypedStatement].new()), Type.Unknown());
                    };
                    let pointer_expr = self.lower_receiver_method_call_expr(base, "borrow_ptr", List[TypedExpr].new());
                    let index_expr = if args.is_empty() then make_typed_expr(TypedExprKind.IntegerLiteral("0"), Type.UIntType()) else (args[0(UInt)]);
                    let pointer_base_type = self.builtin_subscript_base_type(pointer_expr.expr_type);
                    let offset_expr = make_typed_expr(
                        TypedExprKind.ArithmeticExpr(pointer_expr, ArithmeticOperator.Add(), index_expr),
                        pointer_base_type,
                    );
                    let deref_expr = make_typed_expr(TypedExprKind.UnsafeDerefExpr(offset_expr), Type.UInt8Type());
                    yield self.adapt_expr_to_expected_type(deref_expr, Option[Type].Some(Type.ReferenceType(Type.UInt8Type())));
                },
                .Dict(_, _) or .List(_) or .Deque(_) then {
                    let helper_name = if is_mutable then "__index_mut_ref" else "__index_ref";
                    yield self.build_builtin_subscript_helper_call(base, args, helper_name);
                },
                .Pointer(element_type, _) then {
                    let index_expr = if args.is_empty() then make_typed_expr(TypedExprKind.IntegerLiteral("0"), Type.UIntType()) else (args[0(UInt)]);
                    let pointer_base_type = self.builtin_subscript_base_type(base.expr_type);
                    let pointer_expr = when base.expr_type in {
                        .ReferenceType(_) then make_typed_expr(TypedExprKind.DerefExpr(base), pointer_base_type),
                        .MutableReferenceType(_) then make_typed_expr(TypedExprKind.DerefExpr(base), pointer_base_type),
                        .BorrowedReferenceType(_) then make_typed_expr(TypedExprKind.DerefExpr(base), pointer_base_type),
                        .MutableBorrowedReferenceType(_) then make_typed_expr(TypedExprKind.DerefExpr(base), pointer_base_type),
                        _ then base,
                    };
                    let offset_expr = make_typed_expr(
                        TypedExprKind.ArithmeticExpr(pointer_expr, ArithmeticOperator.Add(), index_expr),
                        pointer_base_type,
                    );
                    let deref_expr = make_typed_expr(TypedExprKind.UnsafeDerefExpr(offset_expr), element_type);
                    let expected_ref_type = if is_mutable then Option[Type].Some(Type.MutableReferenceType(element_type)) else Option[Type].Some(Type.ReferenceType(element_type));
                    yield self.adapt_expr_to_expected_type(deref_expr, expected_ref_type);
                },
            },
            .None() then {
                self.push_diagnostic_at_span(
                    "subscript is only supported for String, List, Deque, Dict, and pointer types",
                    self.typed_expr_span(base)
                );
                yield make_typed_expr(TypedExprKind.Block(List[TypedStatement].new()), Type.Unknown());
            },
        };
    };

    module_private lookup_method_signature(self, type_key String, method_name String) Option[Symbol] = {
        return self.storage.method_table.lookup(type_key, method_name);
    };

    module_private push_ambiguous_trait_extension_method_diagnostic(self, base_type Type, method_name String) Void = {
        let mutable msg = StringBuilder.new();
        msg.push_string("Ambiguous method '");
        msg.push_string(method_name);
        msg.push_string("' for type '");
        msg.push_string(self.context().type_display_name(base_type));
        msg.push_string("' via trait extensions");
        self.push_diagnostic(msg.to_string());
    };

    module_private inject_trait_type_args(self, trait_type TypeNode, trait_name String) Void = {
        self.inject_trait_type_args_with_bindings(trait_type, trait_name, Dict[String, Type].new());
    };

    module_private inject_trait_type_args_with_bindings(self, trait_type TypeNode, trait_name String, bindings Dict[String, Type]) Void = {
        if trait_type is .Generic(_, args) then {
            // Create a child scope with trait type params instead of mutating global_scope
            // (Swift: withNewScope { defineGenericParameter(...) })
            if self.storage.trait_registry.get(trait_name) is .Some(info) then {
                let mutable child = Scope.new_child(self.storage.global_scope);
                let mutable i UInt = 0;
                for param_name in info.type_params then {
                    if i < args.count() and args.get(i) is .Some(arg_ref) then {
                        let resolved_arg = self.resolve_type_with_bindings(arg_ref, bindings);
                        child.define_type(param_name, resolved_arg);
                    };
                    i += 1;
                };
                self.storage.current_scope = child;
            };
        };
    };

    /// Bind type parameters from ancestor traits in the inheritance chain.
    /// For example, if FloatingPoint inherits Numeric which inherits [Self]Add,
    /// then Add's type parameter R should be bound to self_type.
    /// This is needed when resolving method signatures inherited from generic parent traits.
    module_private bind_ancestor_trait_type_params(self, trait_name String, self_type Type) Void = {
        let mutable visited = Set[String].new();
        self.bind_ancestor_trait_type_params_recursive(trait_name, self_type, visited);
    };

    module_private bind_ancestor_trait_type_params_recursive(self, trait_name String, self_type Type, visited Set[String]) Void = {
        if visited.contains(trait_name) then { return;};
        visited.insert(trait_name);
        when self.storage.trait_registry.get(trait_name) in {
            .Some(info) then {
                for parent in info.parent_traits then {
                    when self.storage.trait_registry.get(parent.name) in {
                        .Some(parent_info) then {
                            if not parent.type_arg_nodes.is_empty() and not parent_info.type_params.is_empty() then {
                                // Generic parent — resolve arg nodes in a child scope (Swift: withNewScope)
                                let prev_scope = self.storage.current_scope;
                                defer { self.storage.current_scope = prev_scope;};
                                let child = Scope.new_child(self.storage.current_scope);
                                child.define_type("Self", self_type);
                                // Set current_scope BEFORE resolving so generic params are visible
                                self.storage.current_scope = child;
                                let mutable idx UInt = 0;
                                while idx < parent_info.type_params.count() and idx < parent.type_arg_nodes.count() then {
                                    let param_name = parent_info.type_params[idx];
                                    let resolved = self.resolve_type(parent.type_arg_nodes[idx]);
                                    child.define_type(param_name, resolved);
                                    idx += 1;
                                };
                                // Recurse with child scope active
                                self.bind_ancestor_trait_type_params_recursive(parent.name, self_type, visited);
                            };
                        },
                        .None() then {},
                    };
                };
            },
            .None() then {},
        };
    };

    // 提取 Option<T> 或 Result<T> 的内部类型 T，用于 and then / or else 的 _ 绑定
    module_private extract_option_result_inner(self, t Type) Type = {
        if t is .GenericEnum(template, _, args) and (template == "Option" or template == "Result") then {
            return when args.get(0) in {
                .Some(arg_ref) then arg_ref,
                .None() then Type.Unknown(),
            };
        };
        return Type.Unknown();
    };

    module_private infer_or_else_success_type(self, t Type) Type = {
        let ok_fields = self.get_enum_case_field_types(t, "Ok");
        if not ok_fields.is_empty() then {
            return ok_fields[0(UInt)];
        };
        let some_fields = self.get_enum_case_field_types(t, "Some");
        if not some_fields.is_empty() then {
            return some_fields[0(UInt)];
        };
        return self.extract_option_result_inner(t);
    };

    module_private infer_or_else_error_binding_type(self, t Type) Type = {
        let err_fields = self.get_enum_case_field_types(t, "Error");
        if not err_fields.is_empty() then {
            return err_fields[0(UInt)];
        };
        return when t in {
            .GenericEnum(template, _, args) then
                if template == "Result" and args.count() > 1 then (args[1]) else self.extract_option_result_inner(t),
            _ then self.extract_option_result_inner(t),
        };
    };

    module_private is_option_result_wrapper(self, t Type, template_name String) Bool = {
        when t in {
            .GenericEnum(template, _, _) then {
                return template == template_name;
            },
            _ then {},
        };

        if template_name == "Option" then {
            return not self.get_enum_case_field_types(t, "Some").is_empty();
        };
        if template_name == "Result" then {
            return not self.get_enum_case_field_types(t, "Ok").is_empty() and not self.get_enum_case_field_types(t, "Error").is_empty();
        };
        return false;
    };

    module_private option_result_template_def_id(self, t Type, template_name String) DefId = {
        return when t in {
            .GenericEnum(template, template_def_id, _) then if template == template_name then template_def_id else def_id_invalid(),
            .EnumType(def_id) then {
                let template_def_id = self.context().get_template_def_id(def_id);
                yield if self.context().get_template_name(def_id) is .Some(name) and name == template_name then template_def_id else def_id_invalid();
            },
            _ then def_id_invalid(),
        };
    };

    module_private compute_and_then_result_type(self, operand_type Type, transform_result_type Type) Type = {
        let has_ok = not self.get_enum_case_field_types(operand_type, "Ok").is_empty();
        let has_error = not self.get_enum_case_field_types(operand_type, "Error").is_empty();
        if has_ok and has_error then {
            if self.is_option_result_wrapper(transform_result_type, "Result") then {
                return transform_result_type;
            };
            let mutable args = List[Type].new();
            args.push(transform_result_type);
            return Type.GenericEnum("Result", self.option_result_template_def_id(operand_type, "Result"), args);
        };

        let has_some = not self.get_enum_case_field_types(operand_type, "Some").is_empty();
        if has_some then {
            if self.is_option_result_wrapper(transform_result_type, "Option") then {
                return transform_result_type;
            };
            let mutable args = List[Type].new();
            args.push(transform_result_type);
            return Type.GenericEnum("Option", self.option_result_template_def_id(operand_type, "Option"), args);
        };

        when operand_type in {
            .GenericEnum(template, template_def_id, _) then {
                if template == "Result" then {
                    if self.is_option_result_wrapper(transform_result_type, "Result") then {
                        return transform_result_type;
                    };
                    let mutable args = List[Type].new();
                    args.push(transform_result_type);
                    return Type.GenericEnum("Result", template_def_id, args);
                };
                if template == "Option" then {
                    if self.is_option_result_wrapper(transform_result_type, "Option") then {
                        return transform_result_type;
                    };
                    let mutable args = List[Type].new();
                    args.push(transform_result_type);
                    return Type.GenericEnum("Option", template_def_id, args);
                };
            },
            _ then {},
        };

        return transform_result_type;
    };

    module_private refine_and_then_result_type_from_expected(self, operand_type Type, computed_type Type, expected Option[Type]) Type = {
        return when expected in {
            .Some(expected_type) then {
                let operand_is_result = not self.get_enum_case_field_types(operand_type, "Ok").is_empty() and not self.get_enum_case_field_types(operand_type, "Error").is_empty();
                let operand_is_option = not self.get_enum_case_field_types(operand_type, "Some").is_empty() or when operand_type in {
                        .GenericEnum(template, _, _) then template == "Option",
                        _ then false,
                    };

                if operand_is_result and self.is_option_result_wrapper(expected_type, "Result") then {
                    return expected_type;
                };
                if operand_is_option and self.is_option_result_wrapper(expected_type, "Option") then {
                    return expected_type;
                };
                return computed_type;
            },
            .None() then computed_type,
        };
    };

    module_private resolve_member_type_ref(self, base_type_ref Type, member String) Type = {
        let inner_type = when base_type_ref in {
            .MutableReferenceType(inner) then inner,
            .MutablePointerType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            .PointerType(inner) then inner,
            _ then base_type_ref,
        };
        return when inner_type in {
            .StructureType(def_id) then {
                let fields_opt = when self.context().is_foreign_struct(def_id) in {
                    true then self.context().get_foreign_struct_fields(def_id),
                    false then self.context().get_struct_fields(def_id),
                };
                yield when fields_opt in {
                    .Some(fields) then {
                        let mutable found = Type.Unknown();
                        for f in fields then {
                            if f.name == member then {
                                if self.context().is_foreign_struct(def_id) or self.is_field_accessible_from_current_context(f.access, def_id) then {
                                    found = f.field_type;
                                } else {
                                    let access_label = when f.access in {
                                        .FilePrivate() then "file_private",
                                        _ then "module_private",
                                    };
                                    self.storage.diagnostics.push(
                                        make_diagnostic(
                                            DiagnosticStage.Semantic(),
                                            self.storage.file_path,
                                            "Cannot access \(access_label) field '\(member)' of type '\(self.context().get_name(def_id) or else self.context().type_display_name(inner_type))'"

                                    )
                                    );
                                };
                                break;
                            };
                        };
                        yield found;
                    },
                    .None() then Type.Unknown(),
                };
            },
            .GenericStruct(template_name, _, args) then {
                // 直接从泛型模板的 def_id 读取字段，避免再次依赖全局类型表。
                let mutable raw_field_type = when self.storage.generic_templates.lookup_struct(template_name) in {
                    .Some(struct_template) then when self.context().get_struct_fields(struct_template.def_id) in {
                        .Some(fields) then {
                            let mutable found = Type.Unknown();
                            for f in fields then {
                                if f.name == member then {
                                    if self.is_field_accessible_from_current_context(f.access, struct_template.def_id) then {
                                        found = f.field_type;
                                    } else {
                                        let access_label = when f.access in {
                                            .FilePrivate() then "file_private",
                                            _ then "module_private",
                                        };
                                        self.storage.diagnostics.push(
                                            make_diagnostic(
                                                DiagnosticStage.Semantic(),
                                                self.storage.file_path,
                                                "Cannot access \(access_label) field '\(member)' of type '\(template_name)'"

                                        )
                                        );
                                    };
                                    break;
                                };
                            };
                            yield found;
                        },
                        .None() then Type.Unknown(),
                    },
                    .None() then Type.Unknown(),
                };

                // 将模板字段类型中的泛型参数替换为当前实例的实参类型。
                yield when self.storage.generic_templates.lookup_struct(template_name) in {
                    .Some(struct_template) then {
                        let mutable bindings = Dict[String, Type].new();
                        let mutable i UInt = 0;
                        let param_count = struct_template.type_parameters.count();
                        let arg_count = args.count();
                        let n = if param_count < arg_count then param_count else arg_count;
                        while i < n then {
                            let tp = struct_template.type_parameters[i];
                            bindings.insert(tp.name, (args[i]));
                            i += 1;
                        };
                        yield self.apply_type_bindings(raw_field_type, bindings);
                    },
                    .None() then raw_field_type,
                };
            },
            .GenericEnum(template, _, _) then
                // 泛型 enum 的成员访问（通常不常见，返回 Unknown）
                Type.Unknown(),
            _ then Type.Unknown(),
        };
    };

    module_private resolve_member_type(self, base_type Type, member String) Type = {
        return self.resolve_member_type_ref(base_type, member);
    };

    module_private member_decl_is_mutable(self, base_type Type, member String) Bool = {
        let inner_type = when base_type in {
            .MutableReferenceType(inner) then inner,
            .MutablePointerType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            .PointerType(inner) then inner,
            _ then base_type,
        };
        return when inner_type in {
            .StructureType(def_id) then {
                if self.context().is_foreign_struct(def_id) then {
                    return true;
                };
                yield when self.context().get_struct_fields(def_id) in {
                    .Some(fields) then {
                        let mutable found = false;
                        for field in fields then {
                            if field.name == member then {
                                found = true;
                                return field.is_mutable;
                            };
                        };
                        yield not found;
                    },
                    .None() then true,
                };
            },
            .GenericStruct(template_name, _, _) then when self.storage.generic_templates.lookup_struct(template_name) in {
                .Some(struct_template) then when self.context().get_struct_fields(struct_template.def_id) in {
                    .Some(fields) then {
                        let mutable found = false;
                        for field in fields then {
                            if field.name == member then {
                                found = true;
                                return field.is_mutable;
                            };
                        };
                        yield not found;
                    },
                    .None() then true,
                },
                .None() then true,
            },
            _ then true,
        };
    };

    module_private normalize_type_for_bindings(self, t Type) Type = {
        return when t in {
            .StructureType(def_id) then {
                let template_name_opt = self.context().get_template_name(def_id);
                let type_args_opt = self.context().get_type_arguments(def_id);
                yield when template_name_opt in {
                    .Some(template_name) then when type_args_opt in {
                        .Some(type_args) then {
                            let mutable args = List[Type].new();
                            for arg in type_args then {
                                args.push(arg);
                            };
                            yield Type.GenericStruct(template_name, self.context().get_template_def_id(def_id), args);
                        },
                        .None() then t,
                    },
                    .None() then t,
                };
            },
            .EnumType(def_id) then {
                let template_name_opt = self.context().get_template_name(def_id);
                let type_args_opt = self.context().get_type_arguments(def_id);
                yield when template_name_opt in {
                    .Some(template_name) then when type_args_opt in {
                        .Some(type_args) then {
                            let mutable args = List[Type].new();
                            for arg in type_args then {
                                args.push(arg);
                            };
                            yield Type.GenericEnum(template_name, self.context().get_template_def_id(def_id), args);
                        },
                        .None() then t,
                    },
                    .None() then t,
                };
            },
            _ then t,
        };
    };

    module_private infer_type_bindings(self, pattern Type, concrete Type, bindings Dict[String, Type]) Void = {
        let normalized_pattern = self.normalize_type_for_bindings(pattern);
        let normalized_concrete = self.normalize_type_for_bindings(concrete);
        when normalized_pattern in {
            .GenericParameter(name) then {
                when bindings.get(name) in {
                    .Some(existing) then {
                        if self.same_expr_type(existing, normalized_concrete) then {
                        };
                    },
                    .None() then {
                        bindings.insert(name, normalized_concrete);
                    },
                };
            },
            .ReferenceType(p_inner) then {
                when normalized_concrete in {
                    .ReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    .MutableReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    .BorrowedReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    .MutableBorrowedReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    _ then {},
                };
            },
            .MutableReferenceType(p_inner) then {
                when normalized_concrete in {
                    .MutableReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    .MutableBorrowedReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    _ then {},
                };
            },
            .BorrowedReferenceType(p_inner) then {
                when normalized_concrete in {
                    .ReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    .MutableReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    .BorrowedReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    .MutableBorrowedReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    _ then {},
                };
            },
            .MutableBorrowedReferenceType(p_inner) then {
                when normalized_concrete in {
                    .MutableReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    .MutableBorrowedReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    _ then {},
                };
            },
            .WeakReferenceType(p_inner) then {
                when normalized_concrete in {
                    .WeakReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    .MutableWeakReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    _ then {},
                };
            },
            .MutableWeakReferenceType(p_inner) then {
                when normalized_concrete in {
                    .MutableWeakReferenceType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    _ then {},
                };
            },
            .PointerType(p_inner) then {
                when normalized_concrete in {
                    .PointerType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    .MutablePointerType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    _ then {},
                };
            },
            .MutablePointerType(p_inner) then {
                when normalized_concrete in {
                    .MutablePointerType(c_inner) then self.infer_type_bindings(p_inner, c_inner, bindings),
                    _ then {},
                };
            },
            .FunctionType(p_params, p_ret) then {
                when normalized_concrete in {
                    .FunctionType(c_params, c_ret) then {
                        if p_params.count() == c_params.count() then {
                            let mutable i UInt = 0;
                            while i < p_params.count() then {
                                self.infer_type_bindings((p_params[i]).param_type, (c_params[i]).param_type, bindings);
                                i += 1;
                            };
                            self.infer_type_bindings(p_ret, c_ret, bindings);
                        };
                    },
                    _ then {},
                };
            },
            .GenericStruct(p_template, _, p_args) then {
                when normalized_concrete in {
                    .GenericStruct(c_template, _, c_args) then {
                        if p_template == c_template and p_args.count() == c_args.count() then {
                            let mutable i UInt = 0;
                            while i < p_args.count() then {
                                self.infer_type_bindings((p_args[i]), (c_args[i]), bindings);
                                i += 1;
                            };
                        };
                    },
                    _ then {},
                };
            },
            .GenericEnum(p_template, _, p_args) then {
                when normalized_concrete in {
                    .GenericEnum(c_template, _, c_args) then {
                        if p_template == c_template and p_args.count() == c_args.count() then {
                            let mutable i UInt = 0;
                            while i < p_args.count() then {
                                self.infer_type_bindings((p_args[i]), (c_args[i]), bindings);
                                i += 1;
                            };
                        };
                    },
                    _ then {},
                };
            },
            _ then {},
        };
    };

    module_private infer_type_bindings_persistent(self, pattern Type, concrete Type, bindings Dict[String, Type]) Dict[String, Type] = {
        let normalized_pattern = self.normalize_type_for_bindings(pattern);
        let normalized_concrete = self.normalize_type_for_bindings(concrete);
        return when normalized_pattern in {
            .GenericParameter(name) then {
                yield when bindings.get(name) in {
                    .Some(existing) then if self.same_expr_type(existing, normalized_concrete) then bindings else bindings,
                    .None() then {
                        let mutable next_bindings = bindings;
                        next_bindings.insert(name, normalized_concrete);
                        yield next_bindings;
                    },
                };
            },
            .ReferenceType(p_inner) then when normalized_concrete in {
                .ReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                .MutableReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                .BorrowedReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                .MutableBorrowedReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                _ then bindings,
            },
            .MutableReferenceType(p_inner) then when normalized_concrete in {
                .MutableReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                .MutableBorrowedReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                _ then bindings,
            },
            .BorrowedReferenceType(p_inner) then when normalized_concrete in {
                .ReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                .MutableReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                .BorrowedReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                .MutableBorrowedReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                _ then bindings,
            },
            .MutableBorrowedReferenceType(p_inner) then when normalized_concrete in {
                .MutableReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                .MutableBorrowedReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                _ then bindings,
            },
            .WeakReferenceType(p_inner) then when normalized_concrete in {
                .WeakReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                .MutableWeakReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                _ then bindings,
            },
            .MutableWeakReferenceType(p_inner) then when normalized_concrete in {
                .MutableWeakReferenceType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                _ then bindings,
            },
            .PointerType(p_inner) then when normalized_concrete in {
                .PointerType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                .MutablePointerType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                _ then bindings,
            },
            .MutablePointerType(p_inner) then when normalized_concrete in {
                .MutablePointerType(c_inner) then self.infer_type_bindings_persistent(p_inner, c_inner, bindings),
                _ then bindings,
            },
            .FunctionType(p_params, p_ret) then when normalized_concrete in {
                .FunctionType(c_params, c_ret) then {
                    if p_params.count() <> c_params.count() then {
                        return bindings;
                    };
                    let mutable current_bindings = bindings;
                    let mutable i UInt = 0;
                    while i < p_params.count() then {
                        current_bindings = self.infer_type_bindings_persistent((p_params[i]).param_type, (c_params[i]).param_type, current_bindings);
                        i += 1;
                    };
                    yield self.infer_type_bindings_persistent(p_ret, c_ret, current_bindings);
                },
                _ then bindings,
            },
            .GenericStruct(p_template, _, p_args) then when normalized_concrete in {
                .GenericStruct(c_template, _, c_args) then {
                    if not (p_template == c_template and p_args.count() == c_args.count()) then {
                        return bindings;
                    };
                    let mutable current_bindings = bindings;
                    let mutable i UInt = 0;
                    while i < p_args.count() then {
                        current_bindings = self.infer_type_bindings_persistent((p_args[i]), (c_args[i]), current_bindings);
                        i += 1;
                    };
                    yield current_bindings;
                },
                _ then bindings,
            },
            .GenericEnum(p_template, _, p_args) then when normalized_concrete in {
                .GenericEnum(c_template, _, c_args) then {
                    if not (p_template == c_template and p_args.count() == c_args.count()) then {
                        return bindings;
                    };
                    let mutable current_bindings = bindings;
                    let mutable i UInt = 0;
                    while i < p_args.count() then {
                        current_bindings = self.infer_type_bindings_persistent((p_args[i]), (c_args[i]), current_bindings);
                        i += 1;
                    };
                    yield current_bindings;
                },
                _ then bindings,
            },
            _ then bindings,
        };
    };

    module_private apply_type_bindings(self, t Type, bindings Dict[String, Type]) Type = {
        return self.apply_type_bindings_impl(t, bindings);
    };

    module_private apply_type_bindings_impl(self, t Type, bindings Dict[String, Type]) Type = {
        return when t in {
            .GenericParameter(name) then when bindings.get(name) in {
                .Some(bound) then bound,
                .None() then t,
            },
            .ReferenceType(inner) then Type.ReferenceType(self.apply_type_bindings(inner, bindings)),
            .MutableReferenceType(inner) then Type.MutableReferenceType(self.apply_type_bindings(inner, bindings)),
            .BorrowedReferenceType(inner) then Type.BorrowedReferenceType(self.apply_type_bindings(inner, bindings)),
            .MutableBorrowedReferenceType(inner) then Type.MutableBorrowedReferenceType(self.apply_type_bindings(inner, bindings)),
            .WeakReferenceType(inner) then Type.WeakReferenceType(self.apply_type_bindings(inner, bindings)),
            .MutableWeakReferenceType(inner) then Type.MutableWeakReferenceType(self.apply_type_bindings(inner, bindings)),
            .PointerType(inner) then Type.PointerType(self.apply_type_bindings(inner, bindings)),
            .MutablePointerType(inner) then Type.MutablePointerType(self.apply_type_bindings(inner, bindings)),
            .FunctionType(fn_params, return_type) then {
                let param_types = param_entry_types(fn_params);
                let mutable replaced_params = List[Type].new();
                for param_ref in param_types then {
                    replaced_params.push(self.apply_type_bindings(param_ref, bindings));
                };
                yield Type.FunctionType(types_to_param_entries(replaced_params), self.apply_type_bindings(return_type, bindings));
            },
            .GenericStruct(template, template_def_id, args) then {
                let mutable replaced = List[Type].new();
                for arg_ref in args then {
                    replaced.push(self.apply_type_bindings(arg_ref, bindings));
                };
                yield Type.GenericStruct(template, template_def_id, replaced);
            },
            .GenericEnum(template, template_def_id, args) then {
                let mutable replaced = List[Type].new();
                for arg_ref in args then {
                    replaced.push(self.apply_type_bindings(arg_ref, bindings));
                };
                yield Type.GenericEnum(template, template_def_id, replaced);
            },
            .TraitObject(trait_name, trait_def_id, args) then {
                let mutable replaced = List[Type].new();
                for arg_ref in args then {
                    replaced.push(self.apply_type_bindings(arg_ref, bindings));
                };
                yield Type.TraitObject(trait_name, trait_def_id, replaced);
            },
            _ then t,
        };
    };

    module_private normalize_method_receiver_type(self, base_type Type) Type = {
        return when base_type in {
            .MutableReferenceType(inner) then Type.MutableReferenceType(self.canonicalize_alias_type(self.concretize_default_literal_type(inner))),
            .ReferenceType(inner) then Type.ReferenceType(self.canonicalize_alias_type(self.concretize_default_literal_type(inner))),
            .MutableBorrowedReferenceType(inner) then Type.MutableBorrowedReferenceType(self.canonicalize_alias_type(self.concretize_default_literal_type(inner))),
            .BorrowedReferenceType(inner) then Type.BorrowedReferenceType(self.canonicalize_alias_type(self.concretize_default_literal_type(inner))),
            .WeakReferenceType(inner) then Type.WeakReferenceType(self.canonicalize_alias_type(self.concretize_default_literal_type(inner))),
            .MutableWeakReferenceType(inner) then Type.MutableWeakReferenceType(self.canonicalize_alias_type(self.concretize_default_literal_type(inner))),
            .MutablePointerType(inner) then Type.MutablePointerType(self.canonicalize_alias_type(self.concretize_default_literal_type(inner))),
            .PointerType(inner) then Type.PointerType(self.canonicalize_alias_type(self.concretize_default_literal_type(inner))),
            _ then self.canonicalize_alias_type(self.concretize_default_literal_type(base_type)),
        };
    };

    module_private receiver_type_args(self, inner_type Type) List[Type] = {
        return when inner_type in {
            .GenericStruct(_, _, args) then {
                let mutable out = List[Type].new();
                for arg in args then {
                    out.push(arg);
                };
                yield out;
            },
            .GenericEnum(_, _, args) then {
                let mutable out = List[Type].new();
                for arg in args then {
                    out.push(arg);
                };
                yield out;
            },
            .StructureType(def_id) then self.context().get_type_arguments(def_id) or else List[Type].new(),
            .EnumType(def_id) then self.context().get_type_arguments(def_id) or else List[Type].new(),
            _ then List[Type].new(),
        };
    };

    module_private generic_extension_lookup_key(self, inner_type Type) Option[String] = {
        return when inner_type in {
            .GenericStruct(template_name, _, _) then when self.storage.generic_templates.lookup_extension_methods(template_name) in {
                .Some(_) then Option[String].Some(template_name),
                .None() then Option[String].None(),
            },
            .GenericEnum(template_name, _, _) then when self.storage.generic_templates.lookup_extension_methods(template_name) in {
                .Some(_) then Option[String].Some(template_name),
                .None() then Option[String].None(),
            },
            .StructureType(def_id) then {
                when self.context().get_template_name(def_id) in {
                    .Some(template_name) then when self.storage.generic_templates.lookup_extension_methods(template_name) in {
                        .Some(_) then { return Option[String].Some(template_name);},
                        .None() then {},
                    },
                    .None() then {},
                };
                let type_name = self.context().get_name(def_id) or else "";
                yield when self.storage.generic_templates.lookup_extension_methods(type_name) in {
                    .Some(_) then Option[String].Some(type_name),
                    .None() then Option[String].None(),
                };
            },
            .EnumType(def_id) then {
                when self.context().get_template_name(def_id) in {
                    .Some(template_name) then when self.storage.generic_templates.lookup_extension_methods(template_name) in {
                        .Some(_) then { return Option[String].Some(template_name);},
                        .None() then {},
                    },
                    .None() then {},
                };
                let type_name = self.context().get_name(def_id) or else "";
                yield when self.storage.generic_templates.lookup_extension_methods(type_name) in {
                    .Some(_) then Option[String].Some(type_name),
                    .None() then Option[String].None(),
                };
            },
            .ReferenceType(_) then when self.storage.generic_templates.lookup_extension_methods("Ref") in {
                .Some(_) then Option[String].Some("Ref"),
                .None() then Option[String].None(),
            },
            .MutableReferenceType(_) then when self.storage.generic_templates.lookup_extension_methods("MutRef") in {
                .Some(_) then Option[String].Some("MutRef"),
                .None() then Option[String].None(),
            },
            .BorrowedReferenceType(_) then when self.storage.generic_templates.lookup_extension_methods("Ref") in {
                .Some(_) then Option[String].Some("Ref"),
                .None() then Option[String].None(),
            },
            .MutableBorrowedReferenceType(_) then when self.storage.generic_templates.lookup_extension_methods("MutRef") in {
                .Some(_) then Option[String].Some("MutRef"),
                .None() then Option[String].None(),
            },
            .WeakReferenceType(_) then when self.storage.generic_templates.lookup_extension_methods("WeakRef") in {
                .Some(_) then Option[String].Some("WeakRef"),
                .None() then Option[String].None(),
            },
            .MutableWeakReferenceType(_) then when self.storage.generic_templates.lookup_extension_methods("MutWeakRef") in {
                .Some(_) then Option[String].Some("MutWeakRef"),
                .None() then Option[String].None(),
            },
            .PointerType(_) then when self.storage.generic_templates.lookup_extension_methods("Ptr") in {
                .Some(_) then Option[String].Some("Ptr"),
                .None() then Option[String].None(),
            },
            .MutablePointerType(_) then when self.storage.generic_templates.lookup_extension_methods("MutPtr") in {
                .Some(_) then Option[String].Some("MutPtr"),
                .None() then Option[String].None(),
            },
            .IntType() then when self.storage.generic_templates.lookup_extension_methods("Int") in {
                .Some(_) then Option[String].Some("Int"),
                .None() then Option[String].None(),
            },
            .Int8Type() then when self.storage.generic_templates.lookup_extension_methods("Int8") in {
                .Some(_) then Option[String].Some("Int8"),
                .None() then Option[String].None(),
            },
            .Int16Type() then when self.storage.generic_templates.lookup_extension_methods("Int16") in {
                .Some(_) then Option[String].Some("Int16"),
                .None() then Option[String].None(),
            },
            .Int32Type() then when self.storage.generic_templates.lookup_extension_methods("Int32") in {
                .Some(_) then Option[String].Some("Int32"),
                .None() then Option[String].None(),
            },
            .Int64Type() then when self.storage.generic_templates.lookup_extension_methods("Int64") in {
                .Some(_) then Option[String].Some("Int64"),
                .None() then Option[String].None(),
            },
            .UIntType() then when self.storage.generic_templates.lookup_extension_methods("UInt") in {
                .Some(_) then Option[String].Some("UInt"),
                .None() then Option[String].None(),
            },
            .UInt8Type() then when self.storage.generic_templates.lookup_extension_methods("UInt8") in {
                .Some(_) then Option[String].Some("UInt8"),
                .None() then Option[String].None(),
            },
            .UInt16Type() then when self.storage.generic_templates.lookup_extension_methods("UInt16") in {
                .Some(_) then Option[String].Some("UInt16"),
                .None() then Option[String].None(),
            },
            .UInt32Type() then when self.storage.generic_templates.lookup_extension_methods("UInt32") in {
                .Some(_) then Option[String].Some("UInt32"),
                .None() then Option[String].None(),
            },
            .UInt64Type() then when self.storage.generic_templates.lookup_extension_methods("UInt64") in {
                .Some(_) then Option[String].Some("UInt64"),
                .None() then Option[String].None(),
            },
            .Float32Type() then when self.storage.generic_templates.lookup_extension_methods("Float32") in {
                .Some(_) then Option[String].Some("Float32"),
                .None() then Option[String].None(),
            },
            .Float64Type() then when self.storage.generic_templates.lookup_extension_methods("Float64") in {
                .Some(_) then Option[String].Some("Float64"),
                .None() then Option[String].None(),
            },
            .BoolType() then when self.storage.generic_templates.lookup_extension_methods("Bool") in {
                .Some(_) then Option[String].Some("Bool"),
                .None() then Option[String].None(),
            },
            _ then Option[String].None(),
        };
    };

    module_private resolve_extension_method_template_signature(
        self,
        base_type Type,
        inner_type Type,
        template GenericExtensionMethodTemplate,
        actual_type_args List[Type],
    ) Option[Symbol] = {
        // A template declares the target's type parameters; the receiver must
        // carry exactly that many arguments. Swift checks this the same way in
        // `selectExtensionTemplate` (`ext.typeParams.count != extensionTypeArgCount`).
        if template.type_params.count() <> actual_type_args.count() then {
            self.push_diagnostic("Type mismatch: expected \(template.type_params.count()) type arguments, got \(actual_type_args.count())");
            return Option[Symbol].None();
        };
        let mutable bindings = Dict[String, Type].new();
        let mutable i UInt = 0;
        while i < template.type_params.count() and i < actual_type_args.count() then {
            bindings.insert(template.type_params[i].name, actual_type_args[i]);
            i += 1;
        };
        // Swift `resolveGenericExtensionMethod`
        // (TypeCheckerMethods.swift:562-610) calls `enforceGenericConstraints`
        // with `methodInfo.typeParams`, i.e. at the CALL SITE. Re-checking a
        // tool body during materialization reaches this same code, but that is
        // a declaration activity: `constraint_enforcement_deferred` keeps it
        // from reporting (`Rune: Hash`, `Pair[K, V]: Hash`), while a real call
        // site like `names.borrow_ptr()` must report `String` lacking `Pod`.
        for tp in template.type_params then {
            for constraint in tp.constraints then {
                let trait_name = self.type_node_name(constraint);
                if trait_name == "Any" then {
                    continue;
                };
                let bound_type = bindings.get(tp.name) or else Type.GenericParameter(tp.name);
                let trait_args = self.trait_type_args_with_bindings(constraint, bindings);
                if trait_args.is_empty() then {
                    if trait_name == "mutable" then {
                        if not self.satisfies_mutable_constraint(bound_type) then {
                            self.push_diagnostic(self.mutable_constraint_violation_message(bound_type, "checking constraint \(tp.name): mutable"));
                            return Option[Symbol].None();
                        };
                    } else if not self.enforce_explicit_trait_requirement_with_context(bound_type, trait_name, tp.name) then {
                        return Option[Symbol].None();
                    };
                } else if not self.enforce_explicit_generic_trait_conformance(bound_type, trait_name, trait_args) then {
                    return Option[Symbol].None();
                };
            };
        };
        for method_type_param in template.method.type_params then {
            if not bindings.contains_key(method_type_param.name) then {
                bindings.insert(method_type_param.name, Type.GenericParameter(method_type_param.name));
            };
        };
        // Generic extension lookup receives the de-referenced receiver as
        // `inner_type`; this is the Swift `typeToLookup` value used for `Self`.
        // Keeping `base_type` here reintroduces a reference wrapper into
        // generic constraints such as `R Iterator[T]`.
        bindings.insert("Self", inner_type);
        // `checkedParameters` / `checkedReturnType` were resolved with the
        // conformance's trait arguments ALREADY BAKED IN — Swift
        // `resolveGenericExtensionMethod` (TypeCheckerMethods.swift:587-610)
        // substitutes only the template's own `typeParams`. Binding the trait
        // arguments again (a map like `T -> Pair[UInt, T]` whose value still
        // mentions its key) inflates `Option[Pair[UInt, T]]` into
        // `Option[Pair[UInt, Pair[UInt, T]]]`. So the checked types get the
        // template's own parameters only; the trait arguments stay in `bindings`
        // for the TypeNode path below and for constraint checking.
        let mutable checked_bindings = Dict[String, Type].new();
        // `checked_*` keep the TARGET's type parameters generic (`Func(T) Bool` on
        // `Iterator[T]`). Bind them the way `bind_direct_method_signature` does —
        // unify the method's own `self` parameter with this receiver — so the
        // caller sees `Func(Int) Bool` for `ListIterator[Int]`.
        when template.checked_parameters in {
            .Some(checked_symbols) then {
                if not checked_symbols.is_empty() then {
                    self.infer_type_bindings(checked_symbols[0(UInt)].symbol_type, inner_type, checked_bindings);
                };
            },
            .None() then {},
        };
        for entry in bindings then {
            if not checked_bindings.contains_key(entry.first) then {
                checked_bindings.insert(entry.first, entry.second);
            };
        };
        self.bind_extension_template_conformance_trait_args(inner_type, template, bindings);
        // The tool method is written against the TRAIT's type parameters
        // (`fn Func(T) Bool` on `Iterator[T]`). Map them straight to this
        // receiver's conformance arguments — `T` becomes `Int` for
        // `ListIterator[Int]` — so the parameter type comes out as
        // `Func(Int) Bool` rather than a bare `T`. This is the same map
        // `resolve_trait_registry_method_signature` builds via
        // `trait_method_bindings`.
        when template.conformance_trait_name in {
            .Some(trait_name) then {
                for entry in self.trait_method_bindings(trait_name, inner_type) then {
                    bindings.insert(entry.first, entry.second);
                };
            },
            .None() then {},
        };
        let mutable typed_params = List[TypedParam].new();
        when template.checked_parameters in {
            .Some(checked_symbols) then {
                let mutable checked_index UInt = 0;
                while checked_index < checked_symbols.count() then {
                    let declared = if checked_index < template.method.params.count() then template.method.params[checked_index] else TemplateParam("p", false, TypeNode.Identifier("Unknown"), true);
                    typed_params.push(TypedParam(
                        declared.name,
                        declared.is_mutable,
                        self.apply_type_bindings(checked_symbols[checked_index].symbol_type, checked_bindings),
                        declared.named,
                    ));
                    checked_index += 1;
                };
            },
            .None() then {
                for param in template.method.params then {
                    typed_params.push(
                        TypedParam(
                            param.name,
                            param.is_mutable,
                            self.resolve_template_type_node_with_bindings(param.param_type, bindings),
                            param.named,
                        ),
                    );
                };
            },
        };
        let return_type = when template.checked_return_type in {
            .Some(ret) then self.apply_type_bindings(ret, checked_bindings),
            .None() then self.resolve_template_type_node_with_bindings(template.method.return_type, bindings),
        };
        return Option[Symbol].Some(
            self.make_method_callable_symbol_with_visibility(
                template.method.name,
                typed_params,
                return_type,
                template.method.access,
                template.module_path,
                template.source_file,
                template.package_id,
            ),
        );
    };

    module_private resolve_extension_template_signature(self, base_type Type, inner_type Type, method_name String) Option[Symbol] = {
        let template_key = self.generic_extension_lookup_key(inner_type);
        return when template_key in {
            .Some(key) then when self.storage.generic_templates.lookup_extension_method(
                key,
                method_name,
                Option[UInt].None(),
                Option[UInt].Some(self.receiver_type_args(inner_type).count()),
            ) in {
                .Some(template) then self.resolve_extension_method_template_signature(
                    base_type,
                    inner_type,
                    template,
                    self.receiver_type_args(inner_type),
                ),
                .None() then Option[Symbol].None(),
            },
            .None() then Option[Symbol].None(),
        };
    };

    module_private resolve_trait_tool_method_signature(
        self,
        base_type Type,
        trait_name String,
        method_name String,
    ) Option[Symbol] = {
        return when self.flattened_trait_tool_methods(trait_name) in {
            .Ok(methods) then when methods.get(method_name) in {
                .Some(entry) then {
                    if not self.trait_tool_method_is_receiver_style(entry.method) then {
                        return Option[Symbol].None();
                    };
                    // The tool method is written against the TRAIT's type
                    // parameters (`fn Func(T) Bool` on `Iterator[T]`, `other T` on
                    // `MyEq[T]`). They must be bound to this receiver's conformance
                    // arguments — the same map `resolve_trait_registry_method_signature`
                    // builds — otherwise the parameter types come back as bare `T`.
                    let mutable bindings = self.trait_method_bindings(trait_name, base_type);
                    bindings.insert("Self", base_type);
                    for type_param in entry.method.type_params then {
                        if not bindings.contains_key(type_param.name) then {
                            bindings.insert(type_param.name, Type.GenericParameter(type_param.name));
                        };
                    };
                    let mutable typed_params = List[TypedParam].new();
                    for param in entry.method.params then {
                        typed_params.push(TypedParam(
                            param.name,
                            param.is_mutable,
                            self.resolve_template_type_node_with_bindings(param.type_name, bindings),
                            param.named,
                        ));
                    };
                    let return_type = self.resolve_template_type_node_with_bindings(entry.method.return_type, bindings);
                    return Option[Symbol].Some(self.make_method_callable_symbol_with_visibility(
                        entry.method.name,
                        typed_params,
                        return_type,
                        entry.method.access,
                        entry.module_path,
                        entry.source_file,
                        entry.package_id,
                    ));
                },
                .None() then Option[Symbol].None(),
            },
            .Error(error) then {
                self.push_diagnostic(error.message());
                return Option[Symbol].None();
            },
        };
    };

    module_private concrete_receiver_for_method(self, base_type Type, method Symbol) Type = {
        let mutable normalized_base_type = self.normalize_method_receiver_type(base_type);
        if self.method_param_count(method) == 0 then {
            return normalized_base_type;
        };
        let inner_type = when normalized_base_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            .MutablePointerType(inner) then inner,
            .PointerType(inner) then inner,
            _ then normalized_base_type,
        };
        let mutable receiver_param_type = self.method_param_type(method, 0(UInt)) or else normalized_base_type;
        return when receiver_param_type in {
            .MutableReferenceType(_) then when normalized_base_type in {
                .MutableReferenceType(_) then normalized_base_type,
                .MutableBorrowedReferenceType(_) then normalized_base_type,
                .ReferenceType(_) then {
                    let mutable _rdmsg = StringBuilder.new();
                    _rdmsg.push_string("Cannot call mutating method through read-only reference of type '");
                    _rdmsg.push_string(type_to_string(base_type));
                    _rdmsg.push_string("'");
                    self.push_diagnostic(_rdmsg.to_string());
                    yield normalized_base_type;
                },
                .BorrowedReferenceType(_) then {
                    let mutable _rdmsg = StringBuilder.new();
                    _rdmsg.push_string("Cannot call mutating method through read-only reference of type '");
                    _rdmsg.push_string(type_to_string(base_type));
                    _rdmsg.push_string("'");
                    self.push_diagnostic(_rdmsg.to_string());
                    yield normalized_base_type;
                },
                _ then Type.MutableReferenceType(self.box_type(inner_type)),
            },
            .MutableBorrowedReferenceType(_) then when normalized_base_type in {
                .MutableReferenceType(_) then normalized_base_type,
                .MutableBorrowedReferenceType(_) then normalized_base_type,
                .ReferenceType(_) then {
                    let mutable _rdmsg = StringBuilder.new();
                    _rdmsg.push_string("Cannot call mutating method through read-only reference of type '");
                    _rdmsg.push_string(type_to_string(base_type));
                    _rdmsg.push_string("'");
                    self.push_diagnostic(_rdmsg.to_string());
                    yield normalized_base_type;
                },
                .BorrowedReferenceType(_) then {
                    let mutable _rdmsg = StringBuilder.new();
                    _rdmsg.push_string("Cannot call mutating method through read-only reference of type '");
                    _rdmsg.push_string(type_to_string(base_type));
                    _rdmsg.push_string("'");
                    self.push_diagnostic(_rdmsg.to_string());
                    yield normalized_base_type;
                },
                _ then Type.MutableBorrowedReferenceType(self.box_type(inner_type)),
            },
            .ReferenceType(_) then when normalized_base_type in {
                .ReferenceType(_) then normalized_base_type,
                .BorrowedReferenceType(_) then normalized_base_type,
                _ then Type.ReferenceType(self.box_type(inner_type)),
            },
            .BorrowedReferenceType(_) then when normalized_base_type in {
                .ReferenceType(_) then normalized_base_type,
                .BorrowedReferenceType(_) then normalized_base_type,
                _ then Type.BorrowedReferenceType(self.box_type(inner_type)),
            },
            .WeakReferenceType(_) then when normalized_base_type in {
                .WeakReferenceType(_) then normalized_base_type,
                .MutableWeakReferenceType(_) then normalized_base_type,
                _ then Type.WeakReferenceType(self.box_type(inner_type)),
            },
            .MutableWeakReferenceType(_) then when normalized_base_type in {
                .MutableWeakReferenceType(_) then normalized_base_type,
                _ then Type.MutableWeakReferenceType(self.box_type(inner_type)),
            },
            .MutablePointerType(_) then when normalized_base_type in {
                .MutablePointerType(_) then normalized_base_type,
                _ then Type.MutablePointerType(self.box_type(inner_type)),
            },
            .PointerType(_) then when normalized_base_type in {
                .PointerType(_) then normalized_base_type,
                _ then Type.PointerType(self.box_type(inner_type)),
            },
            _ then inner_type,
        };
    };

    module_private bind_extension_template_conformance_trait_args(
        self,
        receiver_type Type,
        template GenericExtensionMethodTemplate,
        bindings Dict[String, Type],
    ) Void = {
        when template.conformance_trait_name in {
            .Some(trait_name) then {
                // Use the type-keyed index for O(1) lookup instead of O(N) scan
                let key = self.conformance_template_key(receiver_type);
                let conformances = when self.storage.conformance_index.get(key) in {
                    .Some(list) then list,
                    .None() then {
                        return;
                    },
                };
                for conformance in conformances then {
                    if conformance.trait_name <> trait_name then {
                        continue;
                    };

                    let mutable conformance_bindings = Dict[String, Type].new();
                    if not self.conformance_type_key_matches(conformance.target_type, receiver_type, conformance_bindings) then {
                        continue;
                    };

                    when self.storage.trait_registry.get(trait_name) in {
                        .Some(info) then {
                            let param_count = info.type_params.count();
                            let arg_count = conformance.trait_arg_types.count();
                            let n = if param_count < arg_count then param_count else arg_count;
                            let mutable trait_i UInt = 0;
                            while trait_i < n then {
                                let bound_trait_arg = self.apply_type_bindings(conformance.trait_arg_types[trait_i], conformance_bindings);
                                bindings.insert(info.type_params[trait_i], bound_trait_arg);
                                trait_i += 1;
                            };
                        },
                        .None() then {},
                    };
                    return;
                };
            },
            .None() then {},
        };
    };

    module_private resolve_bound_method_self_type(self, base_type Type, method Symbol) Option[Type] = {
        if self.method_param_count(method) == 0 then {
            return Option[Type].None();
        };
        return Option[Type].Some(self.concrete_receiver_for_method(base_type, method));
    };

    module_private bind_direct_method_signature(self, base_type Type, method_name String, raw_method Symbol) Symbol = {
        let mutable receiver_type = self.concrete_receiver_for_method(base_type, raw_method);
        let mutable bindings = Dict[String, Type].new();
        let self_param_type = self.method_param_type(raw_method, 0(UInt)) or else Type.Unknown();
        if self.method_param_count(raw_method) > 0(UInt) then {
            self.infer_type_bindings(self_param_type, receiver_type, bindings);
        };
        let concrete_self = when receiver_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then receiver_type,
        };
        bindings.insert("Self", concrete_self);

        let mutable bound_param_types = List[Type].new();
        for parameter_type in self.method_param_types(raw_method) then {
            bound_param_types.push(self.concretize_default_literal_type(self.apply_type_bindings(parameter_type, bindings)));
        };
        if not bound_param_types.is_empty() then {
            bound_param_types[0(UInt)] = receiver_type;
        };
        let mutable bound_return_type = self.concretize_default_literal_type(self.apply_type_bindings(self.method_return_type(raw_method), bindings));
        return self.rebuild_method_symbol(method_name, raw_method, bound_param_types, bound_return_type);
    };


    module_private replace_type_occurrence(self, t Type, pattern Type, replacement Type) Type = {
        if self.same_expr_type(t, pattern) then {
            return replacement;
        };
        return when t in {
            .MutableReferenceType(inner) then Type.MutableReferenceType(self.replace_type_occurrence(inner, pattern, replacement)),
            .ReferenceType(inner) then Type.ReferenceType(self.replace_type_occurrence(inner, pattern, replacement)),
            .MutableBorrowedReferenceType(inner) then Type.MutableBorrowedReferenceType(self.replace_type_occurrence(inner, pattern, replacement)),
            .BorrowedReferenceType(inner) then Type.BorrowedReferenceType(self.replace_type_occurrence(inner, pattern, replacement)),
            .WeakReferenceType(inner) then Type.WeakReferenceType(self.replace_type_occurrence(inner, pattern, replacement)),
            .MutableWeakReferenceType(inner) then Type.MutableWeakReferenceType(self.replace_type_occurrence(inner, pattern, replacement)),
            .MutablePointerType(inner) then Type.MutablePointerType(self.replace_type_occurrence(inner, pattern, replacement)),
            .PointerType(inner) then Type.PointerType(self.replace_type_occurrence(inner, pattern, replacement)),
            .GenericStruct(template, template_def_id, args) then {
                let mutable replaced = List[Type].new();
                for arg_ref in args then {
                    replaced.push(self.replace_type_occurrence(arg_ref, pattern, replacement));
                };
                yield Type.GenericStruct(template, template_def_id, replaced);
            },
            .GenericEnum(template, template_def_id, args) then {
                let mutable replaced = List[Type].new();
                for arg_ref in args then {
                    replaced.push(self.replace_type_occurrence(arg_ref, pattern, replacement));
                };
                yield Type.GenericEnum(template, template_def_id, replaced);
            },
            .FunctionType(params, ret) then {
                let mutable replaced_params = List[Type].new();
                for entry in params then {
                    replaced_params.push(self.replace_type_occurrence(entry.param_type, pattern, replacement));
                };
                let replaced_ret = self.replace_type_occurrence(ret, pattern, replacement);
                yield make_function_type(replaced_params, replaced_ret);
            },
            _ then t,
        };
    };

    module_private resolve_signature_return_type(self, receiver_type Type, method Symbol) Type = {
        if self.method_param_count(method) == 0 then {
            return self.method_return_type(method);
        };
        let mutable bindings = Dict[String, Type].new();
        let mutable self_param_type = self.method_param_type(method, 0(UInt)) or else Type.Unknown();
        let concrete_self_type = when receiver_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then receiver_type,
        };
        // Only infer type bindings from self if parameter 0 is actually a self parameter
        // (i.e., its type matches the receiver type pattern). For static methods like
        // constructors (e.g., Random[DefaultRandomSource].new(rng)), parameter 0 is NOT self.
        let is_self_param = when self_param_type in {
            .GenericParameter(_) then true,
            .ReferenceType(inner) then when inner in {
                .GenericParameter(_) then true,
                _ then self.same_expr_type(inner, concrete_self_type) or self.type_matches_expected_pattern(concrete_self_type, inner),
            },
            .MutableReferenceType(inner) then when inner in {
                .GenericParameter(_) then true,
                _ then self.same_expr_type(inner, concrete_self_type) or self.type_matches_expected_pattern(concrete_self_type, inner),
            },
            .BorrowedReferenceType(inner) then when inner in {
                .GenericParameter(_) then true,
                _ then self.same_expr_type(inner, concrete_self_type) or self.type_matches_expected_pattern(concrete_self_type, inner),
            },
            .MutableBorrowedReferenceType(inner) then when inner in {
                .GenericParameter(_) then true,
                _ then self.same_expr_type(inner, concrete_self_type) or self.type_matches_expected_pattern(concrete_self_type, inner),
            },
            _ then self.same_expr_type(self_param_type, concrete_self_type) or self.type_matches_expected_pattern(concrete_self_type, self_param_type),
        };
        if is_self_param then {
            self.infer_type_bindings(self_param_type, receiver_type, bindings);
        };
        bindings.insert("Self", concrete_self_type);
        let mutable bound_return_type = self.apply_type_bindings(self.method_return_type(method), bindings);
        return bound_return_type;
    };

    module_private resolve_method_template_key(self, inner_type Type) Option[String] = {
        return when inner_type in {
            .GenericStruct(template, _, _) then {
                yield Option[String].Some(template);
            },
            .GenericEnum(template, _, _) then {
                yield Option[String].Some(template);
            },
            .StructureType(def_id) then {
                yield self.context().get_template_name(def_id);
            },
            .EnumType(def_id) then {
                yield self.context().get_template_name(def_id);
            },
            _ then Option[String].None(),
        };
    };

    // Check if `ancestor` is a transitive parent of `descendant` in the trait hierarchy.
    module_private trait_is_ancestor_of(self, ancestor String, descendant String, visited Set[String]) Bool = {
        if visited.contains(descendant) then { return false;};
        visited.insert(descendant);
        when self.storage.trait_registry.get(descendant) in {
            .Some(info) then {
                for parent in info.parent_traits then {
                    if parent.name == ancestor then { return true;};
                    if self.trait_is_ancestor_of(ancestor, parent.name, visited) then { return true;};
                };
            },
            .None() then {},
        };
        return false;
    };

    // Check if two traits have an ancestor-descendant relationship.
    module_private traits_are_related(self, trait_a String, trait_b String) Bool = {
        if trait_a == trait_b then { return true;};
        let mutable visited = Set[String].new();
        if self.trait_is_ancestor_of(trait_a, trait_b, visited) then { return true;};
        visited = Set[String].new();
        return self.trait_is_ancestor_of(trait_b, trait_a, visited);
    };

    module_private resolve_conformance_method_signature(self, receiver_type Type, method_name String) Option[Symbol] = {
        let normalized_receiver = when receiver_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then receiver_type,
        };
        // Use the type-keyed index for O(1) lookup instead of O(N) scan
        let key = self.conformance_template_key(normalized_receiver);
        let templates = when self.storage.conformance_index.get(key) in {
            .Some(list) then list,
            .None() then {
                // No conformance templates for this type key - skip the scan
                return Option[Symbol].None();
            },
        };
        let mutable first_match = Option[Symbol].None();
        let mutable first_trait = "";
        let mutable ambiguous = false;
        for template in templates then {
            let mutable bindings = Dict[String, Type].new();
            if not self.conformance_type_key_matches(template.target_type, normalized_receiver, bindings) then {
                continue;
            };

            let trait_name = template.trait_name;
            let mutable method_bindings = bindings;
            when self.storage.trait_registry.get(trait_name) in {
                .Some(info) then {
                    let param_count = info.type_params.count();
                    let arg_count = template.trait_arg_types.count();
                    let n = if param_count < arg_count then param_count else arg_count;
                    let mutable i UInt = 0;
                    while i < n then {
                        let mutable arg_type = self.apply_type_bindings(template.trait_arg_types[i], bindings);
                        method_bindings.insert(info.type_params[i], arg_type);
                        i += 1;
                    };
                },
                .None() then {},
            };

            let raw_method_opt = self.lookup_method_signature(trait_name, method_name);
            when raw_method_opt in {
                .Some(raw_method) then {
                    let mutable bound_param_types = List[Type].new();
                    for parameter_type in self.method_param_types(raw_method) then {
                        let mutable bound_type = self.bind_conformance_trait_self_type(self.apply_type_bindings(parameter_type, method_bindings), trait_name, receiver_type);
                        bound_param_types.push(bound_type);
                    };
                    if not bound_param_types.is_empty() then {
                        bound_param_types[0(UInt)] = self.concrete_receiver_for_method(receiver_type, raw_method);
                    };
                    let bound_return = self.bind_conformance_trait_self_type(self.apply_type_bindings(self.method_return_type(raw_method), method_bindings), trait_name, receiver_type);
                    let mutable bound_symbol_type = make_function_type(self.to_type_ref_list(bound_param_types), bound_return);
                    let candidate = Symbol(raw_method.def_id, bound_symbol_type, raw_method.kind);
                    if first_match is .Some(_) then {
                        if trait_name <> first_trait and not self.traits_are_related(first_trait, trait_name) then {
                            ambiguous = true;
                            let mutable msg = StringBuilder.new();
                            msg.push_string("ambiguous method '");
                            msg.push_string(method_name);
                            msg.push_string("' on type - implemented by both '");
                            msg.push_string(first_trait);
                            msg.push_string("' and '");
                            msg.push_string(trait_name);
                            msg.push_string("'. Use explicit trait qualification (e.g., value.(TraitName).method())");
                            self.push_diagnostic(msg.to_string());
                        };
                    } else {
                        first_match = Option[Symbol].Some(candidate);
                        first_trait = trait_name;
                    };
                },
                .None() then {},
            };

            when self.storage.trait_registry.flatten_methods(trait_name) in {
                .Ok(methods) then {
                    when methods.get(method_name) in {
                        .Some(member) then {
                            let mutable typed_params = List[TypedParam].new();
                            for param in member.params then {
                                let bound_param = self.bind_conformance_trait_self_type(self.apply_trait_self_binding(self.apply_type_bindings(param.param_type, method_bindings), receiver_type), trait_name, receiver_type);
                                typed_params.push(TypedParam(param.name, param.is_mutable, bound_param, param.named));
                            };
                            let bound_return = self.bind_conformance_trait_self_type(self.apply_trait_self_binding(self.apply_type_bindings(member.return_type, method_bindings), receiver_type), trait_name, receiver_type);
                            let candidate = self.make_method_callable_symbol(method_name, typed_params, bound_return);
                            if first_match is .Some(_) then {
                                if trait_name <> first_trait and not self.traits_are_related(first_trait, trait_name) then {
                                    ambiguous = true;
                                    let mutable msg = StringBuilder.new();
                                    msg.push_string("ambiguous method '");
                                    msg.push_string(method_name);
                                    msg.push_string("' on type - implemented by both '");
                                    msg.push_string(first_trait);
                                    msg.push_string("' and '");
                                    msg.push_string(trait_name);
                                    msg.push_string("'. Use explicit trait qualification (e.g., value.(TraitName).method())");
                                    self.push_diagnostic(msg.to_string());
                                };
                            } else {
                                first_match = Option[Symbol].Some(candidate);
                                first_trait = trait_name;
                            };
                        },
                        .None() then {},
                    };
                },
                .Error(e) then self.report_trait_method_flatten_failure(trait_name, method_name, "resolve_conformance_trait_method_signature", e),
            };
            if raw_method_opt is .None() then {
                continue;
            };
        };

        if ambiguous then {
            return Option[Symbol].None();
        };
        return first_match;
    };

    module_private resolve_conformance_extension_template_signature(self, base_type Type, receiver_type Type, method_name String) Option[Symbol] = {
        let normalized_receiver = when receiver_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then receiver_type,
        };
        let key = self.conformance_template_key(normalized_receiver);
        let conformances = when self.storage.conformance_index.get(key) in {
            .Some(list) then list,
            .None() then {
                return Option[Symbol].None();
            },
        };
        for conformance in conformances then {
            let mutable conformance_bindings = Dict[String, Type].new();
            if not self.conformance_type_key_matches(conformance.target_type, normalized_receiver, conformance_bindings) then {
                continue;
            };

            let trait_name = conformance.trait_name;
            let template_opt = self.storage.generic_templates.lookup_extension_method(
                trait_name,
                method_name,
                Option[UInt].None(),
                Option[UInt].Some(conformance.trait_arg_types.count()),
            );
            let template = when template_opt in {
                .Some(found) then found,
                .None() then {
                    continue;
                },
            };

            let mutable bindings = Dict[String, Type].new();
            for entry in conformance_bindings then {
                bindings.insert(entry.first, entry.second);
            };
            // Snapshot before the trait-argument pass: `checked_*` already carry
            // those arguments and must not see them again (see
            // resolve_extension_method_template_signature).
            let mutable checked_bindings = Dict[String, Type].new();
            for entry in bindings then {
                checked_bindings.insert(entry.first, entry.second);
            };
            when self.storage.trait_registry.get(trait_name) in {
                .Some(info) then {
                    let param_count = info.type_params.count();
                    let arg_count = conformance.trait_arg_types.count();
                    let n = if param_count < arg_count then param_count else arg_count;
                    let mutable trait_i UInt = 0;
                    while trait_i < n then {
                        let bound_trait_arg = self.apply_type_bindings(conformance.trait_arg_types[trait_i], conformance_bindings);
                        bindings.insert(info.type_params[trait_i], bound_trait_arg);
                        trait_i += 1;
                    };
                },
                .None() then {},
            };
            for mtp in template.method.type_params then {
                if not bindings.contains_key(mtp.name) then {
                    bindings.insert(mtp.name, Type.GenericParameter(mtp.name));
                };
            };
            bindings.insert("Self", normalized_receiver);

            // Swift `resolveGenericExtensionMethod` (TypeCheckerMethods.swift:587-610):
            // `checkedParameters` / `checkedReturnType` are already resolved and must
            // not be re-bound. See resolve_extension_method_template_signature.
            let mutable typed_params = List[TypedParam].new();
            when template.checked_parameters in {
                .Some(checked_symbols) then {
                    let mutable checked_index UInt = 0;
                    while checked_index < checked_symbols.count() then {
                        let declared = if checked_index < template.method.params.count() then template.method.params[checked_index] else TemplateParam("p", false, TypeNode.Identifier("Unknown"), true);
                        typed_params.push(TypedParam(
                            declared.name,
                            declared.is_mutable,
                            self.apply_type_bindings(checked_symbols[checked_index].symbol_type, checked_bindings),
                            declared.named,
                        ));
                        checked_index += 1;
                    };
                },
                .None() then {
                    for param in template.method.params then {
                        typed_params.push(
                            TypedParam(
                                param.name,
                                param.is_mutable,
                                self.resolve_template_type_node_with_bindings(param.param_type, bindings),
                                param.named,
                            ),
                        );
                    };
                },
            };
            let return_type = when template.checked_return_type in {
                .Some(ret) then self.apply_type_bindings(ret, checked_bindings),
                .None() then self.resolve_template_type_node_with_bindings(template.method.return_type, bindings),
            };
            return Option[Symbol].Some(
                self.make_method_callable_symbol_with_visibility(
                    method_name,
                    typed_params,
                    return_type,
                    template.method.access,
                    template.module_path,
                    template.source_file,
                    template.package_id,
                ),
            );
        };

        return Option[Symbol].None();
    };

    module_private resolve_conformance_trait_method_signature(self, receiver_type Type, trait_name String, method_name String) Option[Symbol] = {
        let normalized_receiver = when receiver_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then receiver_type,
        };
        // Use the type-keyed index for O(1) lookup instead of O(N) scan
        let key = self.conformance_template_key(normalized_receiver);
        let templates = when self.storage.conformance_index.get(key) in {
            .Some(list) then list,
            .None() then {
                return Option[Symbol].None();
            },
        };
        for template in templates then {
            if template.trait_name <> trait_name then {
                continue;
            };

            let mutable bindings = Dict[String, Type].new();
            if not self.conformance_type_key_matches(template.target_type, normalized_receiver, bindings) then {
                continue;
            };

            let mutable method_bindings = bindings;
            when self.storage.trait_registry.get(trait_name) in {
                .Some(info) then {
                    let param_count = info.type_params.count();
                    let arg_count = template.trait_arg_types.count();
                    let n = if param_count < arg_count then param_count else arg_count;
                    let mutable i UInt = 0;
                    while i < n then {
                        let mutable arg_type = self.apply_type_bindings(template.trait_arg_types[i], bindings);
                        method_bindings.insert(info.type_params[i], arg_type);
                        i += 1;
                    };
                },
                .None() then {},
            };

            when self.storage.trait_registry.flatten_methods(trait_name) in {
                .Ok(methods) then {
                    when methods.get(method_name) in {
                        .Some(member) then {
                            let mutable typed_params = List[TypedParam].new();
                            for param in member.params then {
                                let bound_param = self.bind_conformance_trait_self_type(self.apply_trait_self_binding(self.apply_type_bindings(param.param_type, method_bindings), receiver_type), trait_name, receiver_type);
                                typed_params.push(TypedParam(param.name, param.is_mutable, bound_param, param.named));
                            };
                            let bound_return = self.bind_conformance_trait_self_type(self.apply_trait_self_binding(self.apply_type_bindings(member.return_type, method_bindings), receiver_type), trait_name, receiver_type);
                            return Option[Symbol].Some(self.make_method_callable_symbol(method_name, typed_params, bound_return));
                        },
                        .None() then {},
                    };
                },
                .Error(e) then self.report_trait_method_flatten_failure(trait_name, method_name, "resolve_conformance_extension_template_signature", e),
            };

            when self.lookup_method_signature(trait_name, method_name) in {
                .Some(raw_method) then {
                    let mutable bound_param_types = List[Type].new();
                    for parameter_type in self.method_param_types(raw_method) then {
                        let mutable bound_type = self.bind_conformance_trait_self_type(self.apply_type_bindings(parameter_type, method_bindings), trait_name, receiver_type);
                        bound_param_types.push(bound_type);
                    };
                    if not bound_param_types.is_empty() then {
                        bound_param_types[0(UInt)] = self.concrete_receiver_for_method(receiver_type, raw_method);
                    };
                    let bound_return = self.bind_conformance_trait_self_type(self.apply_type_bindings(self.method_return_type(raw_method), method_bindings), trait_name, receiver_type);
                    let mutable bound_symbol_type = make_function_type(self.to_type_ref_list(bound_param_types), bound_return);
                    return Option[Symbol].Some(Symbol(raw_method.def_id, bound_symbol_type, raw_method.kind));
                },
                .None() then {},
            };
        };

        return Option[Symbol].None();
    };

    module_private apply_trait_self_binding(self, t Type, receiver_type Type) Type = {
        let concrete_receiver = when receiver_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then receiver_type,
        };
        let mutable bindings = Dict[String, Type].new();
        bindings.insert("Self", concrete_receiver);
        return self.apply_type_bindings(t, bindings);
    };

    /// Resolve a trait member type by substituting Self and ancestor trait type params.
    /// For example, for method `add(self, other R) Self` from [R Any]Add inherited through
    /// Numeric (which declares [Self]Add), this resolves R -> Self and Self -> receiver_type.
    module_private resolve_trait_member_type(self, t Type, receiver_type Type) Type = {
        let concrete_receiver = when receiver_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then receiver_type,
        };
        // Build bindings from Self + any ancestor trait type params currently in scope
        let mutable bindings = Dict[String, Type].new();
        bindings.insert("Self", concrete_receiver);
        // Check if there are any GenericParameter references in the type that are
        // bound in the global scope (from bind_ancestor_trait_type_params)
        self.collect_ancestor_bindings(t, bindings);
        return self.apply_type_bindings(t, bindings);
    };

    module_private trait_method_bindings(self, trait_name String, receiver_type Type) Dict[String, Type] = {
        let concrete_receiver = when receiver_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then receiver_type,
        };
        let mutable bindings = Dict[String, Type].new();
        bindings.insert("Self", concrete_receiver);

        // If receiver is a GenericParameter, extract constraint type args for this trait
        // to populate bindings. e.g. [R Iterator[T]] → Element -> T
        let receiver_inner = when receiver_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            _ then receiver_type,
        };
        when receiver_inner in {
            .GenericParameter(gp_name) then {
                when self.storage.generic_param_constraints.get(gp_name) in {
                    .Some(constraints) then {
                        for constraint in constraints then {
                            if constraint.trait_name == trait_name then {
                                when self.storage.trait_registry.get(trait_name) in {
                                    .Some(info) then {
                                        let mutable idx UInt = 0;
                                        while idx < info.type_params.count() and idx < constraint.type_args.count() then {
                                            let param_name = info.type_params[idx];
                                            if not bindings.contains_key(param_name) then {
                                                bindings.insert(param_name, constraint.type_args[idx]);
                                            };
                                            idx += 1;
                                        };
                                    },
                                    .None() then {},
                                };
                            };
                        };
                    },
                    .None() then {},
                };
            },
            .TraitObject(receiver_trait_name, _, receiver_trait_args) then {
                when self.storage.trait_registry.get(receiver_trait_name) in {
                    .Some(info) then {
                        let mutable idx UInt = 0;
                        while idx < info.type_params.count() and idx < receiver_trait_args.count() then {
                            let param_name = info.type_params[idx];
                            if not bindings.contains_key(param_name) then {
                                bindings.insert(param_name, (receiver_trait_args[idx]));
                            };
                            idx += 1;
                        };
                    },
                    .None() then {},
                };
                if receiver_trait_name <> trait_name then {
                    let mutable receiver_visited = Set[String].new();
                    bindings = self.collect_trait_method_bindings_recursive(receiver_trait_name, bindings, receiver_visited);
                };
            },
            _ then {},
        };

        // Fill in any remaining unresolved trait type params from global_scope
        when self.storage.trait_registry.get(trait_name) in {
            .Some(info) then {
                for type_param in info.type_params then {
                    if not bindings.contains_key(type_param) then {
                        let mutable bound_type = when self.storage.global_scope.lookup_type(type_param) in {
                            .Some(existing) then existing,
                            .None() then Type.GenericParameter(type_param),
                        };
                        bindings.insert(type_param, bound_type);
                    };
                };
            },
            .None() then {
                self.report_missing_trait_method_info(trait_name, "trait_method_bindings");
                return bindings;
            },
        };
        let mutable visited = Set[String].new();
        return self.collect_trait_method_bindings_recursive(trait_name, bindings, visited);
    };

    module_private collect_trait_method_bindings_recursive(
        self,
        trait_name String,
        bindings Dict[String, Type],
        visited Set[String],
    ) Dict[String, Type] = {
        if visited.contains(trait_name) then {
            return bindings;
        };
        visited.insert(trait_name);
        when self.storage.trait_registry.get(trait_name) in {
            .Some(info) then {
                let mutable collected = bindings;
                for parent in info.parent_traits then {
                    if parent.name == "Any" then {
                        continue;
                    };
                    when self.storage.trait_registry.get(parent.name) in {
                        .Some(parent_info) then {
                            let mutable parent_bindings = Dict[String, Type].new();
                            for entry in collected then {
                                parent_bindings.insert(entry.first, entry.second);
                            };
                            let mutable idx UInt = 0;
                            while idx < parent_info.type_params.count() and idx < parent.type_arg_nodes.count() then {
                                let param_name = parent_info.type_params[idx];
                                let resolved_arg = self.resolve_type_with_bindings(parent.type_arg_nodes[idx], collected);
                                parent_bindings.insert(param_name, resolved_arg);
                                if not collected.contains_key(param_name) then {
                                    collected.insert(param_name, resolved_arg);
                                };
                                idx += 1;
                            };
                            parent_bindings = self.collect_trait_method_bindings_recursive(parent.name, parent_bindings, visited);
                            for entry in parent_bindings then {
                                if not collected.contains_key(entry.first) then {
                                    collected.insert(entry.first, entry.second);
                                };
                            };
                        },
                        .None() then {
                            self.report_missing_trait_method_info(parent.name, "collect_trait_method_bindings_recursive");
                        },
                    };
                };
                return collected;
            },
            .None() then {
                self.report_missing_trait_method_info(trait_name, "collect_trait_method_bindings_recursive");
                return bindings;
            },
        };
    };

    module_private resolve_trait_registry_method_signature(self, trait_name String, method_name String, receiver_type Type) Option[Symbol] = {
        let bindings = self.trait_method_bindings(trait_name, receiver_type);
        if self.lookup_method_signature(trait_name, method_name) is .Some(raw_method) then {
            let mutable bound_param_types = List[Type].new();
            for parameter_type in self.method_param_types(raw_method) then {
                bound_param_types.push(self.concretize_default_literal_type(self.apply_type_bindings(parameter_type, bindings)));
            };
            let mutable bound_return_type = self.concretize_default_literal_type(self.apply_type_bindings(self.method_return_type(raw_method), bindings));
            return Option[Symbol].Some(self.rebuild_method_symbol(method_name, raw_method, bound_param_types, bound_return_type));
        };
        return when self.storage.trait_registry.flatten_methods(trait_name) in {
            .Ok(methods) then when methods.get(method_name) in {
                .Some(member) then {
                    let mutable typed_params = List[TypedParam].new();
                    for p in member.params then {
                        let mutable resolved_param_type = self.concretize_default_literal_type(self.apply_type_bindings(p.param_type, bindings));
                        typed_params.push(TypedParam(p.name, p.is_mutable, resolved_param_type, p.named));
                    };
                    let mutable resolved_return_type = self.concretize_default_literal_type(self.apply_type_bindings(member.return_type, bindings));
                    yield Option[Symbol].Some(self.make_method_callable_symbol(method_name, typed_params, resolved_return_type));
                },
                .None() then Option[Symbol].None(),
            },
            .Error(e) then {
                self.report_trait_method_flatten_failure(trait_name, method_name, "resolve_trait_registry_method_signature", e);
                yield Option[Symbol].None();
            },
        };
    };

    module_private collect_ancestor_bindings(self, t Type, bindings Dict[String, Type]) Void = {
        when t in {
            .GenericParameter(name) then {
                if not bindings.contains_key(name) then {
                    when self.storage.global_scope.lookup_type(name) in {
                        .Some(resolved) then {
                            if not (resolved is .GenericParameter(_) and when resolved in { .GenericParameter(n) then n == name, _ then false }) then {
                                bindings.insert(name, resolved)
                            ;};
                        },
                        .None() then {},
                    };
                };
            },
            .ReferenceType(inner) then self.collect_ancestor_bindings(inner, bindings),
            .MutableReferenceType(inner) then self.collect_ancestor_bindings(inner, bindings),
            .BorrowedReferenceType(inner) then self.collect_ancestor_bindings(inner, bindings),
            .MutableBorrowedReferenceType(inner) then self.collect_ancestor_bindings(inner, bindings),
            .PointerType(inner) then self.collect_ancestor_bindings(inner, bindings),
            .MutablePointerType(inner) then self.collect_ancestor_bindings(inner, bindings),
            .GenericStruct(_, _, args) then {
                for arg in args then { self.collect_ancestor_bindings(arg, bindings);};
            },
            .GenericEnum(_, _, args) then {
                for arg in args then { self.collect_ancestor_bindings(arg, bindings);};
            },
            .FunctionType(params, ret) then {
                for entry in params then { self.collect_ancestor_bindings(entry.param_type, bindings);};
                self.collect_ancestor_bindings(ret, bindings);
            },
            _ then {},
        };
    };

    module_private bind_conformance_trait_self_type(self, t Type, trait_name String, receiver_type Type) Type = {
        let concrete_receiver = when receiver_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then receiver_type,
        };
        return when t in {
            .TraitObject(name, _, _) then if name == trait_name then concrete_receiver else t,
            .MutableReferenceType(inner) then Type.MutableReferenceType(self.bind_conformance_trait_self_type(inner, trait_name, concrete_receiver)),
            .ReferenceType(inner) then Type.ReferenceType(self.bind_conformance_trait_self_type(inner, trait_name, concrete_receiver)),
            .MutableBorrowedReferenceType(inner) then Type.MutableBorrowedReferenceType(self.bind_conformance_trait_self_type(inner, trait_name, concrete_receiver)),
            .BorrowedReferenceType(inner) then Type.BorrowedReferenceType(self.bind_conformance_trait_self_type(inner, trait_name, concrete_receiver)),
            .WeakReferenceType(inner) then Type.WeakReferenceType(self.bind_conformance_trait_self_type(inner, trait_name, concrete_receiver)),
            .MutableWeakReferenceType(inner) then Type.MutableWeakReferenceType(self.bind_conformance_trait_self_type(inner, trait_name, concrete_receiver)),
            .MutablePointerType(inner) then Type.MutablePointerType(self.bind_conformance_trait_self_type(inner, trait_name, concrete_receiver)),
            .PointerType(inner) then Type.PointerType(self.bind_conformance_trait_self_type(inner, trait_name, concrete_receiver)),
            .FunctionType(fn_params, return_type) then {
                let param_types = param_entry_types(fn_params);
                let mutable replaced_params = List[Type].new();
                for param_ref in param_types then {
                    replaced_params.push(self.bind_conformance_trait_self_type(param_ref, trait_name, concrete_receiver));
                };
                yield Type.FunctionType(types_to_param_entries(replaced_params), self.bind_conformance_trait_self_type(return_type, trait_name, concrete_receiver));
            },
            .GenericStruct(template, template_def_id, args) then {
                yield when template == trait_name in {
                    true then concrete_receiver,
                    false then {
                        let mutable replaced_args = List[Type].new();
                        for arg_ref in args then {
                            replaced_args.push(self.bind_conformance_trait_self_type(arg_ref, trait_name, concrete_receiver));
                        };
                        yield Type.GenericStruct(template, template_def_id, replaced_args);
                    },
                };
            },
            .GenericEnum(template, template_def_id, args) then {
                yield when template == trait_name in {
                    true then concrete_receiver,
                    false then {
                        let mutable replaced_args = List[Type].new();
                        for arg_ref in args then {
                            replaced_args.push(self.bind_conformance_trait_self_type(arg_ref, trait_name, concrete_receiver));
                        };
                        yield Type.GenericEnum(template, template_def_id, replaced_args);
                    },
                };
            },
            _ then t,
        };
    };

    // Unified: delegates to resolve_method_signature (8-layer cascade).
    module_private resolve_method_return_type(self, base_type Type, method_name String) Type = {
        return when self.resolve_method_signature(base_type, method_name) in {
            .Some(method) then self.method_return_type(method),
            .None() then Type.Unknown(),
        };
    };

    // Unified: delegates to resolve_method_signature (8-layer cascade).
    module_private resolve_method_self_type(self, base_type Type, method_name String) Option[Type] = {
        return when self.resolve_method_signature(base_type, method_name) in {
            .Some(method) then self.resolve_bound_method_self_type(base_type, method),
            .None() then Option[Type].None(),
        };
    };

    module_private resolve_static_method_return_type(self, type_name String, method_name String) Type = {
        return when self.lookup_method_signature(type_name, method_name) in {
            .Some(method) then self.method_return_type(method),
            .None() then Type.Unknown(),
        };
    };

    module_private extension_template_is_receiver_style(self, template GenericExtensionMethodTemplate) Bool = {
        let _ = self;
        return if template.method.params.is_empty() then false else template.method.params[0(UInt)].name == "self";
    };

    module_private resolve_static_extension_template_signature(self, receiver_type Type, method_name String) Option[Symbol] = {
        let template_key = self.generic_extension_lookup_key(receiver_type);
        return when template_key in {
            .Some(key) then {
                let actual_type_args = self.receiver_type_args(receiver_type);
                yield when self.storage.generic_templates.lookup_extension_method(
                    key,
                    method_name,
                    Option[UInt].None(),
                    Option[UInt].Some(actual_type_args.count()),
                ) in {
                    .Some(template) then {
                        yield if self.extension_template_is_receiver_style(template) then Option[Symbol].None() else {
                            // Swift `resolveGenericExtensionMethod`
                            // (TypeCheckerMethods.swift:581-610) binds the template's own
                            // `typeParams` and `Self`, then substitutes once. The
                            // conformance's trait arguments are already baked into
                            // `checked_*`, so they must not be bound a second time.
                            let mutable checked_bindings = Dict[String, Type].new();
                            let mutable bind_index UInt = 0;
                            while bind_index < template.type_params.count() and bind_index < actual_type_args.count() then {
                                checked_bindings.insert(template.type_params[bind_index].name, actual_type_args[bind_index]);
                                bind_index += 1;
                            };
                            for mtp in template.method.type_params then {
                                if not checked_bindings.contains_key(mtp.name) then {
                                    checked_bindings.insert(mtp.name, Type.GenericParameter(mtp.name));
                                };
                            };
                            checked_bindings.insert("Self", receiver_type);
                            let mutable bindings = Dict[String, Type].new();
                            for entry in checked_bindings then {
                                bindings.insert(entry.first, entry.second);
                            };
                            self.bind_extension_template_conformance_trait_args(receiver_type, template, bindings);
                            let mutable typed_params = List[TypedParam].new();
                            for param in template.method.params then {
                                typed_params.push(
                                    TypedParam(
                                        param.name,
                                        param.is_mutable,
                                        self.resolve_template_type_node_with_bindings(param.param_type, bindings),
                                        param.named,
                                    ),
                                );
                            };
                            let return_type = when template.checked_return_type in {
                                .Some(ret) then self.apply_type_bindings(ret, checked_bindings),
                                .None() then self.resolve_template_type_node_with_bindings(template.method.return_type, bindings),
                            };
                            yield Option[Symbol].Some(
                                self.make_method_callable_symbol_with_visibility(
                                    method_name,
                                    typed_params,
                                    return_type,
                                    template.method.access,
                                    template.module_path,
                                    template.source_file,
                                    template.package_id,
                                ),
                            );
                        };
                    },
                    .None() then Option[Symbol].None(),
                };
            },
            .None() then Option[Symbol].None(),
        };
    };

    // Swift `resolveGenericExtensionMethod` (TypeCheckerMethods.swift:562-610)
    // substitutes the template's type parameters and `Self` exactly once and
    // hands back a symbol in final form; callers read its types verbatim.
    // All three lookup paths below therefore return a receiver-substituted
    // symbol. Substituting again at the call site captures the replacement's own
    // free names: `List`'s parameter is `T` while `List[Pair[UInt, T]]`'s
    // argument carries an outer `T`, so a second pass turns
    // `List[Pair[UInt, T]]` into `List[Pair[UInt, Pair[UInt, T]]]`.
    module_private resolve_static_method_signature_for_receiver(self, type_name String, receiver_type Type, method_name String) Option[Symbol] = {
        return when self.lookup_method_signature(type_name, method_name) in {
            .Some(method) then Option[Symbol].Some(self.bind_static_declaration_signature(type_name, self.receiver_type_args(receiver_type), method)),
            .None() then when self.resolve_static_extension_template_signature(receiver_type, method_name) in {
                .Some(method) then Option[Symbol].Some(method),
                .None() then self.resolve_conformance_method_signature(receiver_type, method_name),
            },
        };
    };

    // Substitute a declaration-form signature (`List[T]`'s `new` returns
    // `List[T]`) against the receiver's actual type arguments and `Self`.
    module_private bind_static_declaration_signature(self, type_name String, receiver_type_args List[Type], method Symbol) Symbol = {
        if receiver_type_args.is_empty() then {
            return method;
        };
        let mutable bindings = Dict[String, Type].new();
        self.bind_static_receiver_type_args(type_name, receiver_type_args, bindings);
        bindings.insert("Self", self.resolve_static_declared_receiver_type(type_name, receiver_type_args));
        let bound_type = self.apply_type_bindings(method.symbol_type, bindings);
        return Symbol(method.def_id, bound_type, method.kind);
    };

    // Unified: delegates to resolve_method_signature (8-layer cascade).
    module_private resolve_method_param_types(self, base_type Type, method_name String) List[Type] = {
        return when self.resolve_method_signature(base_type, method_name) in {
            .Some(method) then self.resolve_signature_param_types(base_type, method),
            .None() then List[Type].new(),
        };
    };

    module_private resolve_signature_param_types(self, receiver_type Type, method Symbol) List[Type] = {
        if self.method_param_count(method) <= 1(UInt) then {
            return List[Type].new();
        };
        let mutable bindings = Dict[String, Type].new();
        self.infer_type_bindings(self.method_param_type(method, 0(UInt)) or else Type.Unknown(), receiver_type, bindings);
        let mutable out = List[Type].new();
        let mutable i = 1(UInt);
        while i < self.method_param_count(method) then {
            let mutable param_type = self.method_param_type(method, i) or else Type.Unknown();
            out.push(self.apply_type_bindings(param_type, bindings));
            i += 1(UInt);
        };
        return out;
    };

    module_private collect_unbound_method_generic_param_names(self, t Type, receiver_bindings Dict[String, Type], ordered List[String], seen Set[String]) Void = {
        when t in {
            .GenericParameter(name) then {
                if not receiver_bindings.contains_key(name) and not seen.contains(name) then {
                    seen.insert(name);
                    ordered.push(name);
                };
            },
            .MutableReferenceType(inner) then self.collect_unbound_method_generic_param_names(inner, receiver_bindings, ordered, seen),
            .ReferenceType(inner) then self.collect_unbound_method_generic_param_names(inner, receiver_bindings, ordered, seen),
            .MutableBorrowedReferenceType(inner) then self.collect_unbound_method_generic_param_names(inner, receiver_bindings, ordered, seen),
            .BorrowedReferenceType(inner) then self.collect_unbound_method_generic_param_names(inner, receiver_bindings, ordered, seen),
            .WeakReferenceType(inner) then self.collect_unbound_method_generic_param_names(inner, receiver_bindings, ordered, seen),
            .MutableWeakReferenceType(inner) then self.collect_unbound_method_generic_param_names(inner, receiver_bindings, ordered, seen),
            .MutablePointerType(inner) then self.collect_unbound_method_generic_param_names(inner, receiver_bindings, ordered, seen),
            .PointerType(inner) then self.collect_unbound_method_generic_param_names(inner, receiver_bindings, ordered, seen),
            .FunctionType(params, ret) then {
                for entry in params then {
                    self.collect_unbound_method_generic_param_names(entry.param_type, receiver_bindings, ordered, seen);
                };
                self.collect_unbound_method_generic_param_names(ret, receiver_bindings, ordered, seen);
            },
            .GenericStruct(_, _, args) then {
                for arg in args then {
                    self.collect_unbound_method_generic_param_names(arg, receiver_bindings, ordered, seen);
                };
            },
            .GenericEnum(_, _, args) then {
                for arg in args then {
                    self.collect_unbound_method_generic_param_names(arg, receiver_bindings, ordered, seen);
                };
            },
            _ then {},
        };
    };

    module_private collect_method_generic_param_names_from_params(self, method Symbol, receiver_bindings Dict[String, Type], ordered List[String], seen Set[String]) Void = {
        let mutable i UInt = 1;
        while i < self.method_param_count(method) then {
            let mutable param_type = self.method_param_type(method, i) or else Type.Unknown();
            self.collect_unbound_method_generic_param_names(param_type, receiver_bindings, ordered, seen);
            i += 1;
        };
    };

    module_private collect_method_generic_param_names(self, method Symbol, receiver_bindings Dict[String, Type], ordered List[String], seen Set[String]) Void = {
        self.collect_method_generic_param_names_from_params(method, receiver_bindings, ordered, seen);
        self.collect_unbound_method_generic_param_names(self.method_return_type(method), receiver_bindings, ordered, seen);
    };

    module_private resolve_signature_method_type_bindings(self, receiver_type Type, method Symbol, method_type_args List[Type]) Dict[String, Type] = {
        let mutable bindings = Dict[String, Type].new();
        if self.method_param_count(method) > 0 then {
            self.infer_type_bindings(self.method_param_type(method, 0(UInt)) or else Type.Unknown(), receiver_type, bindings);
        };
        if method_type_args.is_empty() then {
            return bindings;
        };

        let mutable ordered = List[String].new();
        let mutable seen = Set[String].new();
        self.collect_method_generic_param_names(method, bindings, ordered, seen);

        let mutable arg_i UInt = 0;
        while arg_i < method_type_args.count() and arg_i < ordered.count() then {
            bindings.insert(ordered[arg_i], method_type_args[arg_i]);
            arg_i += 1;
        };
        return bindings;
    };

    module_private resolve_signature_call_type_bindings(self, base_type Type, method Symbol, args List[TypedExpr], method_type_args List[Type]) Dict[String, Type] = {
        let mutable receiver_type = self.concrete_receiver_for_method(base_type, method);
        let mutable bindings = self.resolve_signature_method_type_bindings(receiver_type, method, method_type_args);
        let mutable arg_i UInt = 0;
        while arg_i < args.count() and arg_i + 1(UInt) < self.method_param_count(method) then {
            let mutable param_type = self.method_param_type(method, arg_i + 1(UInt)) or else Type.Unknown();
            self.infer_type_bindings(param_type, args[arg_i].expr_type, bindings);
            arg_i += 1;
        };
        return bindings;
    };

    module_private bind_static_receiver_type_args(self, type_name String, receiver_type_args List[Type], bindings Dict[String, Type]) Void = {
        when self.storage.generic_templates.lookup_struct(type_name) in {
            .Some(struct_template) then {
                let mutable i UInt = 0;
                let param_count = struct_template.type_parameters.count();
                let arg_count = receiver_type_args.count();
                let n = if param_count < arg_count then param_count else arg_count;
                while i < n then {
                    let tp = struct_template.type_parameters[i];
                    bindings.insert(tp.name, receiver_type_args[i]);
                    i += 1;
                };
            },
            .None() then {
                when self.storage.generic_templates.lookup_enum(type_name) in {
                    .Some(enum_template) then {
                        let mutable i UInt = 0;
                        let param_count = enum_template.type_parameters.count();
                        let arg_count = receiver_type_args.count();
                        let n = if param_count < arg_count then param_count else arg_count;
                        while i < n then {
                            let tp = enum_template.type_parameters[i];
                            bindings.insert(tp.name, receiver_type_args[i]);
                            i += 1;
                        };
                    },
                    .None() then {},
                };
            },
        };
    };

    module_private resolve_static_declared_receiver_type(self, type_name String, receiver_type_args List[Type]) Type = {
        when self.storage.generic_templates.lookup_struct(type_name) in {
            .Some(struct_template) then {
                let mutable args = List[Type].new();
                if receiver_type_args.is_empty() then {
                    for tp in struct_template.type_parameters then {
                        args.push(Type.GenericParameter(tp.name));
                    };
                } else {
                    for arg in receiver_type_args then {
                        args.push(arg);
                    };
                };
                return Type.GenericStruct(type_name, struct_template.def_id, args);
            },
            .None() then {
                when self.storage.generic_templates.lookup_enum(type_name) in {
                    .Some(enum_template) then {
                        let mutable args = List[Type].new();
                        if receiver_type_args.is_empty() then {
                            for tp in enum_template.type_parameters then {
                                args.push(Type.GenericParameter(tp.name));
                            };
                        } else {
                            for arg in receiver_type_args then {
                                args.push(arg);
                            };
                        };
                        return Type.GenericEnum(type_name, enum_template.def_id, args);
                    },
                    .None() then {},
                };
            },
        };

        return when self.try_resolve_named_type_without_diag(type_name) in {
            .Some(t) then t,
            .None() then Type.Unknown(),
        };
    };

    module_private collect_unbound_static_generic_param_names(self, method Symbol, bindings Dict[String, Type], ordered List[String], seen Set[String]) Void = {
        for parameter_type in self.method_param_types(method) then {
            self.collect_unbound_method_generic_param_names(parameter_type, bindings, ordered, seen);
        };
        self.collect_unbound_method_generic_param_names(self.method_return_type(method), bindings, ordered, seen);
    };

    module_private collect_static_generic_param_names_from_params(self, method Symbol, receiver_bindings Dict[String, Type], ordered List[String], seen Set[String]) Void = {
        for parameter_type in self.method_param_types(method) then {
            self.collect_unbound_method_generic_param_names(parameter_type, receiver_bindings, ordered, seen);
        };
    };

    module_private collect_static_generic_param_names(self, method Symbol, receiver_bindings Dict[String, Type], ordered List[String], seen Set[String]) Void = {
        self.collect_static_generic_param_names_from_params(method, receiver_bindings, ordered, seen);
        self.collect_unbound_method_generic_param_names(self.method_return_type(method), receiver_bindings, ordered, seen);
    };

    module_private resolve_static_call_type_bindings(self, type_name String, receiver_type_args List[Type], method Symbol, args List[TypedExpr], method_type_args List[Type], expected Option[Type]) Dict[String, Type] = {
        let mutable bindings = Dict[String, Type].new();
        self.bind_static_receiver_type_args(type_name, receiver_type_args, bindings);
        // Signatures are kept in declaration form (see
        // resolve_static_extension_template_signature); `Self` is resolved here so
        // the single substitution at the call site covers it too.
        bindings.insert("Self", self.resolve_static_declared_receiver_type(type_name, receiver_type_args));

        let mutable ordered = List[String].new();
        let mutable seen = Set[String].new();
        self.collect_static_generic_param_names(method, bindings, ordered, seen);

        let mutable type_arg_i UInt = 0;
        while type_arg_i < method_type_args.count() and type_arg_i < ordered.count() then {
            bindings.insert(ordered[type_arg_i], method_type_args[type_arg_i]);
            type_arg_i += 1;
        };

        let mutable arg_i UInt = 0;
        while arg_i < args.count() and arg_i < self.method_param_count(method) then {
            let mutable param_type = self.method_param_type(method, arg_i) or else Type.Unknown();
            self.infer_type_bindings(param_type, args[arg_i].expr_type, bindings);
            arg_i += 1;
        };

        when expected in {
            .Some(expected_type) then self.infer_type_bindings(self.method_return_type(method), expected_type, bindings),
            .None() then {},
        };
        return bindings;
    };

    module_private resolve_static_method_type_args_for_call(self, type_name String, receiver_type_args List[Type], method Symbol, args List[TypedExpr], method_type_args List[Type], expected Option[Type]) List[Type] = {
        let bindings = self.resolve_static_call_type_bindings(type_name, receiver_type_args, method, args, method_type_args, expected);
        let mutable receiver_bindings = Dict[String, Type].new();
        self.bind_static_receiver_type_args(type_name, receiver_type_args, receiver_bindings);
        let mutable ordered = List[String].new();
        let mutable seen = Set[String].new();
        self.collect_static_generic_param_names(method, receiver_bindings, ordered, seen);

        let mutable resolved = List[Type].new();
        for name in ordered then {
            when bindings.get(name) in {
                .Some(bound) then {
                    if self.is_unresolved_expr_type(bound) or self.contains_generic_parameter(bound) then {
                        return List[Type].new();
                    };
                    resolved.push(bound);
                },
                .None() then {
                    return List[Type].new();
                },
            };
        };
        return resolved;
    };

    // Infer ONLY the method's own type parameters from the call site. The
    // receiver's type parameters and `Self` are already substituted into the
    // signature by resolve_static_method_signature_for_receiver; binding them a
    // second time captures the replacement's free names (see the note there).
    module_private resolve_static_method_param_bindings(
        self,
        type_name String,
        receiver_type_args List[Type],
        method Symbol,
        args List[TypedExpr],
        method_type_args List[Type],
        expected Option[Type],
    ) Dict[String, Type] = {
        let mutable bound_names = Dict[String, Type].new();
        self.bind_static_receiver_type_args(type_name, receiver_type_args, bound_names);
        bound_names.insert("Self", self.resolve_static_declared_receiver_type(type_name, receiver_type_args));
        let mutable ordered = List[String].new();
        let mutable seen = Set[String].new();
        self.collect_static_generic_param_names(method, bound_names, ordered, seen);

        let mutable bindings = Dict[String, Type].new();
        let mutable type_arg_i = 0(UInt);
        while type_arg_i < method_type_args.count() and type_arg_i < ordered.count() then {
            bindings.insert(ordered[type_arg_i], method_type_args[type_arg_i]);
            type_arg_i += 1;
        };

        let mutable arg_i = 0(UInt);
        while arg_i < args.count() and arg_i < self.method_param_count(method) then {
            let mutable param_type = self.method_param_type(method, arg_i) or else Type.Unknown();
            self.infer_type_bindings(param_type, args[arg_i].expr_type, bindings);
            arg_i += 1;
        };

        when expected in {
            .Some(expected_type) then self.infer_type_bindings(self.method_return_type(method), expected_type, bindings),
            .None() then {},
        };
        return bindings;
    };

    module_private resolve_static_method_return_type_for_call(self, type_name String, receiver_type_args List[Type], method Symbol, args List[TypedExpr], method_type_args List[Type], expected Option[Type]) Type = {
        let bindings = self.resolve_static_method_param_bindings(type_name, receiver_type_args, method, args, method_type_args, expected);
        let bound_static_return = self.apply_type_bindings(self.method_return_type(method), bindings);
        return self.concretize_default_literal_type(bound_static_return);
    };

    module_private resolve_method_type_args_for_call(self, base_type Type, method Symbol, args List[TypedExpr], method_type_args List[Type]) List[Type] = {
        let mutable receiver_type = self.concrete_receiver_for_method(base_type, method);
        let receiver_bindings = self.resolve_signature_method_type_bindings(receiver_type, method, List[Type].new());
        let bindings = self.resolve_signature_call_type_bindings(base_type, method, args, method_type_args);
        let mutable ordered = List[String].new();
        let mutable seen = Set[String].new();
        self.collect_method_generic_param_names(method, receiver_bindings, ordered, seen);

        let mutable resolved = List[Type].new();
        for name in ordered then {
            when bindings.get(name) in {
                .Some(bound) then {
                    if self.is_unresolved_expr_type(bound) or self.contains_generic_parameter(bound) then {
                        return List[Type].new();
                    };
                    resolved.push(bound);
                },
                .None() then {
                    return List[Type].new();
                },
            };
        };
        return resolved;
    };

    module_private resolve_method_type_args_for_call_with_expected(self, base_type Type, method Symbol, args List[TypedExpr], method_type_args List[Type], expected Option[Type]) List[Type] = {
        let mutable receiver_type = self.concrete_receiver_for_method(base_type, method);
        let receiver_bindings = self.resolve_signature_method_type_bindings(receiver_type, method, List[Type].new());
        let mutable bindings = self.resolve_signature_call_type_bindings(base_type, method, args, method_type_args);
        let mutable ordered_from_params = List[String].new();
        let mutable seen_from_params = Set[String].new();
        self.collect_method_generic_param_names_from_params(method, receiver_bindings, ordered_from_params, seen_from_params);
        if args.is_empty() and method_type_args.is_empty() and self.method_param_count(method) == 1(UInt) and expected is .None() then {
            return List[Type].new();
        };
        // Align with Swift sema: if arguments produced no method-level bindings and
        // there is no expected return type or explicit method type args, we do not
        // infer method generics from return position alone.
        if ordered_from_params.is_empty() and method_type_args.is_empty() and expected is .None() then {
            return List[Type].new();
        };
        let mutable ordered = ordered_from_params;
        let mutable seen = seen_from_params;
        self.collect_unbound_method_generic_param_names(self.method_return_type(method), receiver_bindings, ordered, seen);
        if ordered.is_empty() then {
            return List[Type].new();
        };
        when expected in {
            .Some(expected_type) then self.infer_type_bindings(self.method_return_type(method), expected_type, bindings),
            .None() then {},
        };

        let mutable resolved = List[Type].new();
        for name in ordered then {
            when bindings.get(name) in {
                .Some(bound) then {
                    if self.is_unresolved_expr_type(bound) or self.contains_generic_parameter(bound) then {
                        return List[Type].new();
                    };
                    resolved.push(bound);
                },
                .None() then {
                    return List[Type].new();
                },
            };
        };
        return resolved;
    };

    module_private resolve_method_return_type_for_call(self, base_type Type, method Symbol, args List[TypedExpr], method_type_args List[Type]) Type = {
        if self.method_param_count(method) == 0 then {
            let bindings = self.resolve_signature_call_type_bindings(base_type, method, args, method_type_args);
            return self.concretize_default_literal_type(self.apply_type_bindings(self.method_return_type(method), bindings));
        };

        let mutable receiver_type = self.concrete_receiver_for_method(base_type, method);
        let mutable bindings = self.resolve_signature_call_type_bindings(base_type, method, args, method_type_args);
        let mutable self_param_type = self.method_param_type(method, 0(UInt)) or else Type.Unknown();
        if bindings.is_empty() and self.same_expr_type(self_param_type, receiver_type) then {
            let mutable concrete_return_type = self.concretize_default_literal_type(self.method_return_type(method));
            return concrete_return_type;
        };
        let concrete_self_type = when receiver_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then receiver_type,
        };
        bindings.insert("Self", concrete_self_type);
        let mutable bound_return_type = self.apply_type_bindings(self.method_return_type(method), bindings);
        return self.concretize_default_literal_type(bound_return_type);
    };

    module_private resolve_method_param_types_from_signature_with_method_type_args(self, base_type Type, method Symbol, method_type_args List[Type]) List[Type] = {
        let mutable out = List[Type].new();
        if self.method_param_count(method) <= 1(UInt) then {
            return out;
        };
        let mutable receiver_type = self.concrete_receiver_for_method(base_type, method);
        let bindings = self.resolve_signature_method_type_bindings(receiver_type, method, method_type_args);
        let mutable i UInt = 1(UInt);
        while i < self.method_param_count(method) then {
            let mutable param_type = self.method_param_type(method, i) or else Type.Unknown();
            out.push(self.apply_type_bindings(param_type, bindings));
            i += 1(UInt);
        };
        return out;
    };

    module_private resolve_method_signature_unchecked(self, base_type Type, method_name String) Option[Symbol] = {
        let mutable normalized_base_type = self.normalize_method_receiver_type(base_type);
        let inner_type = when normalized_base_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then normalized_base_type,
        };

        when inner_type in {
            .GenericParameter(name) then {
                if self.storage.generic_param_constraints.get(name) is .Some(constraints) then {
                    for constraint in constraints then {
                        let cn = constraint.trait_name;
                        if cn == "Any" then {
                            continue;
                        };
                        when self.resolve_trait_registry_method_signature(cn, method_name, inner_type) in {
                            .Some(method) then { return Option[Symbol].Some(method);},
                            .None() then {},
                        };
                        when self.resolve_trait_tool_method_signature(inner_type, cn, method_name) in {
                            .Some(method) then { return Option[Symbol].Some(method);},
                            .None() then {},
                        };
                    };
                };
            },
            .TraitObject(trait_name, _, _) then {
                when self.resolve_trait_registry_method_signature(trait_name, method_name, inner_type) in {
                    .Some(method) then { return Option[Symbol].Some(method);},
                    .None() then {},
                };
                when self.resolve_trait_tool_method_signature(inner_type, trait_name, method_name) in {
                    .Some(method) then { return Option[Symbol].Some(method);},
                    .None() then {},
                };
                if self.lookup_method_signature(trait_name, method_name) is .Some(raw_method) then {
                    return Option[Symbol].Some(raw_method);
                };
            },
            _ then {},
        };

        let type_key = self.context().type_display_name(inner_type);
        if self.lookup_method_signature(type_key, method_name) is .Some(raw_method) then {
            if self.storage.method_table.has_conflict(type_key, method_name) and not self.storage.method_table.is_inherent(type_key, method_name) then {
                self.push_ambiguous_trait_extension_method_diagnostic(inner_type, method_name);
                return Option[Symbol].None();
            };
            return Option[Symbol].Some(self.bind_direct_method_signature(base_type, method_name, raw_method));
        };

        when self.resolve_extension_template_signature(normalized_base_type, inner_type, method_name) in {
            .Some(method) then { return Option[Symbol].Some(method);},
            .None() then {},
        };

        let template_key = self.resolve_method_template_key(inner_type);
        if template_key is .Some(key) and self.lookup_method_signature(key, method_name) is .Some(raw_method) then {
            if self.storage.method_table.has_conflict(key, method_name) and not self.storage.method_table.is_inherent(key, method_name) then {
                self.push_ambiguous_trait_extension_method_diagnostic(inner_type, method_name);
                return Option[Symbol].None();
            };
            return Option[Symbol].Some(self.bind_direct_method_signature(base_type, method_name, raw_method));
        };

        // Check weakref intrinsic given extension methods (e.g., upgrade on ?*T / ?T)
        when self.resolve_weakref_extension_template_signature(normalized_base_type, method_name) in {
            .Some(method_symbol) then { return Option[Symbol].Some(method_symbol);},
            .None() then {},
        };

        when self.resolve_conformance_method_signature(inner_type, method_name) in {
            .Some(method) then { return Option[Symbol].Some(method);},
            .None() then {},
        };

        when self.resolve_conformance_extension_template_signature(normalized_base_type, inner_type, method_name) in {
            .Some(method) then { return Option[Symbol].Some(method);},
            .None() then {},
        };

        when self.resolve_modifier_extension_template_signature(normalized_base_type, method_name) in {
            .Some(method_symbol) then { return Option[Symbol].Some(method_symbol);},
            .None() then {},
        };

        return Option[Symbol].None();
    };

    module_private resolve_method_signature(self, base_type Type, method_name String) Option[Symbol] = {
        return self.resolve_method_signature_unchecked(base_type, method_name);
    };

    module_private resolve_method_param_types_with_method_type_args(self, base_type Type, method_name String, method_type_args List[Type]) List[Type] = {
        return when self.resolve_method_signature(base_type, method_name) in {
            .Some(method) then {
                let mutable out = List[Type].new();
                if self.method_param_count(method) > 1(UInt) then {
                    let mutable receiver_type = self.concrete_receiver_for_method(base_type, method);
                    let bindings = self.resolve_signature_method_type_bindings(receiver_type, method, method_type_args);
                    let mutable i UInt = 1;
                    while i < self.method_param_count(method) then {
                        let mutable param_type = self.method_param_type(method, i) or else Type.Unknown();
                        out.push(self.apply_type_bindings(param_type, bindings));
                        i += 1;
                    };
                };
                yield out;
            },
            .None() then self.resolve_method_param_types(base_type, method_name),
        };
    };

    module_private resolve_method_return_type_with_method_type_args(self, base_type Type, method_name String, method_type_args List[Type]) Type = {
        return when self.resolve_method_signature(base_type, method_name) in {
            .Some(method) then {
                let mutable receiver_type = self.concrete_receiver_for_method(base_type, method);
                let bindings = self.resolve_signature_method_type_bindings(receiver_type, method, method_type_args);
                yield self.concretize_default_literal_type(self.apply_type_bindings(self.method_return_type(method), bindings));
            },
            .None() then self.resolve_method_return_type(base_type, method_name),
        };
    };

    // 从 trait registry 中提取 trait 方法的参数类型列表（不含 self）。
    module_private resolve_trait_method_param_types(self, trait_name String, method_name String, receiver_type Type) List[Type] = {
        when self.resolve_conformance_trait_method_signature(receiver_type, trait_name, method_name) in {
            .Some(method) then {
                let mutable out = List[Type].new();
                let mutable i UInt = 1;
                while i < self.method_param_count(method) then {
                    out.push(self.method_param_type(method, i) or else Type.Unknown());
                    i += 1;
                };
                return out;
            },
            .None() then {},
        };
        if self.storage.trait_registry.flatten_methods(trait_name) is .Ok(methods) and methods.get(method_name) is .Some(member) then {
            let bindings = self.trait_method_bindings(trait_name, receiver_type);
            // member.params 包含 self，跳过第一个
            if member.params.count() > 0(UInt) then {
                let mutable out = List[Type].new();
                let mutable i = 1(UInt);
                while i < member.params.count() then {
                    out.push(self.concretize_default_literal_type(self.apply_type_bindings(member.params[i].param_type, bindings)));
                    i += 1(UInt);
                };
                return out;
            };
            return List[Type].new();
        };
        if self.lookup_method_signature(trait_name, method_name) is .Some(method) then {
            if self.method_param_count(method) > 0(UInt) then {
                let mutable concrete_receiver_type = self.concrete_receiver_for_method(receiver_type, method);
                let mutable bindings = Dict[String, Type].new();
                self.infer_type_bindings(self.method_param_type(method, 0(UInt)) or else Type.Unknown(), concrete_receiver_type, bindings);
                let mutable out = List[Type].new();
                let mutable i UInt = 1;
                while i < self.method_param_count(method) then {
                    let mutable param_type = self.method_param_type(method, i) or else Type.Unknown();
                    out.push(self.apply_type_bindings(param_type, bindings));
                    i += 1;
                };
                return out;
            };
            return List[Type].new();
        };
        return List[Type].new();
    };

    module_private resolve_trait_method_self_type(self, trait_name String, method_name String, receiver_type Type) Option[Type] = {
        when self.resolve_conformance_trait_method_signature(receiver_type, trait_name, method_name) in {
            .Some(method) then {
                if self.method_param_count(method) > 0(UInt) then {
                    return Option[Type].Some(self.method_param_type(method, 0(UInt)) or else Type.Unknown());
                };
            },
            .None() then {},
        };
        if self.storage.trait_registry.flatten_methods(trait_name) is .Ok(methods) and methods.get(method_name) is .Some(member) and member.params.count() > 0(UInt) then {
            let bindings = self.trait_method_bindings(trait_name, receiver_type);
            return Option[Type].Some(self.concretize_default_literal_type(self.apply_type_bindings(member.params[0(UInt)].param_type, bindings)));
        };
        if self.lookup_method_signature(trait_name, method_name) is .Some(method) then {
            return self.resolve_bound_method_self_type(receiver_type, method);
        };
        return Option[Type].None();
    };

    module_private collect_ordered_trait_members(
        self,
        trait_name String,
        module_path List[String],
        ordered List[TypedTraitMember],
        seen Set[String],
        visited Set[String],
    ) Void = {
        let visit_key = qualified_trait_key(module_path, trait_name);
        if visited.contains(visit_key) then {
            return;
        };
        visited.insert(visit_key);
        let info = self.storage.trait_registry.get_in_module(trait_name, module_path) or else {
            return;
        };
        for parent in info.parent_traits then {
            self.collect_ordered_trait_members(parent.name, info.module_path, ordered, seen, visited);
        };
        for member in info.methods then {
            if not seen.contains(member.name) then {
                seen.insert(member.name);
                ordered.push(member);
            };
        };
    };

    module_private trait_vtable_method_index_for_type(self, trait_type Type, method_name String) Option[Int] = {
        let trait_name = self.trait_name_from_type(trait_type);
        let mutable module_path = self.storage.module_path;
        when trait_type in {
            .TraitObject(_, trait_def_id, _) then {
                if self.storage.generic_templates.lookup_trait_by_def_id(trait_def_id) is .Some(info) then {
                    module_path = info.module_path;
                };
            },
            _ then {},
        };
        let mutable ordered = List[TypedTraitMember].new();
        let mutable seen = Set[String].new();
        let mutable visited = Set[String].new();
        self.collect_ordered_trait_members(trait_name, module_path, ordered, seen, visited);
        let mutable index UInt = 0;
        while index < ordered.count() then {
            if ordered[index].name == method_name then {
                return Option[Int].Some(index(Int));
            };
            index += 1;
        };
        return Option[Int].None();
    };

    module_private trait_vtable_method_index(self, trait_name String, method_name String) Option[Int] = {
        return self.trait_vtable_method_index_for_type(self.canonical_trait_object_type(trait_name), method_name);
    };

    module_private report_trait_method_flatten_failure(self, trait_name String, method_name String, context String, error Error) Void = {
        let mutable message = StringBuilder.new();
        message.push_string("failed to flatten trait ");
        message.push_string(trait_name);
        message.push_string(" while resolving method '");
        message.push_string(method_name);
        message.push_string("' in ");
        message.push_string(context);
        message.push_string(": ");
        message.push_string(error.message());
        self.push_diagnostic(message.to_string());
    };

    module_private report_missing_trait_method_info(self, trait_name String, context String) Void = {
        let mutable message = StringBuilder.new();
        message.push_string("missing trait info for ");
        message.push_string(trait_name);
        message.push_string(" in ");
        message.push_string(context);
        self.push_diagnostic(message.to_string());
    };

    // 从 trait registry 解析 qualified method call 的返回类型。
    // 先查 trait registry，再回退到 base_type 的 method_table。
    module_private resolve_qualified_method_return_type(self, trait_name String, method_name String, base_type Type) Type = {
        when self.resolve_conformance_trait_method_signature(base_type, trait_name, method_name) in {
            .Some(method) then { return self.method_return_type(method);},
            .None() then {},
        };
        when self.storage.trait_registry.flatten_methods(trait_name) in {
            .Ok(methods) then {
                when methods.get(method_name) in {
                    .Some(member) then {
                        let bindings = self.trait_method_bindings(trait_name, base_type);
                        when member.return_type in {
                            .Unknown() then {},
                            _ then { return self.concretize_default_literal_type(self.apply_type_bindings(member.return_type, bindings));},
                        };
                    },
                    .None() then {},
                };
            },
            .Error(e) then self.report_trait_method_flatten_failure(trait_name, method_name, "resolve_qualified_method_return_type", e),
        };
        if self.lookup_method_signature(trait_name, method_name) is .Some(method) then {
            return self.resolve_signature_return_type(self.concrete_receiver_for_method(base_type, method), method);
        };
        // 回退到 base_type 的 method_table
        return self.resolve_method_return_type(base_type, method_name);
    };

    // 从 method_table 中提取静态方法/enum case 构造器的参数类型列表。
    module_private resolve_static_method_param_types(self, type_name String, method_name String) List[Type] = {
        return when self.lookup_method_signature(type_name, method_name) in {
            .Some(method) then {
                let mutable out = List[Type].new();
                for parameter_type in self.method_param_types(method) then {
                    out.push(parameter_type);
                };
                yield out;
            },
            .None() then
                // 尝试从 enum case 字段获取参数类型
                when self.storage.global_scope.lookup_type(type_name) in {
                    .Some(t) then self.get_enum_case_field_types(t, method_name),
                    .None() then List[Type].new(),
                },
        };
    };

    module_private resolve_static_method_param_types_for_receiver(self, type_name String, receiver_type Type, method_name String) List[Type] = {
        return when self.resolve_static_method_signature_for_receiver(type_name, receiver_type, method_name) in {
            .Some(method) then {
                let mutable out = List[Type].new();
                for parameter_type in self.method_param_types(method) then {
                    out.push(parameter_type);
                };
                yield out;
            },
            .None() then self.resolve_static_method_param_types(type_name, method_name),
        };
    };

    module_private apply_static_method_type_bindings(self, type_name String, type_args List[Type], return_type Type) Type = {
        if type_args.is_empty() then {
            return return_type;
        };

        let mutable bindings = Dict[String, Type].new();
        let mutable receiver_type = when self.storage.global_scope.lookup_type(type_name) in {
            .Some(t) then when t in {
                .StructureType(template_def_id) then Type.GenericStruct(type_name, template_def_id, type_args),
                .EnumType(template_def_id) then Type.GenericEnum(type_name, template_def_id, type_args),
                _ then Type.Unknown(),
            },
            .None() then Type.Unknown(),
        };
        when receiver_type in {
            .Unknown() then {},
            _ then { bindings.insert("Self", receiver_type);},
        };

        when self.storage.generic_templates.lookup_struct(type_name) in {
            .Some(struct_template) then {
                let mutable i UInt = 0;
                let param_count = struct_template.type_parameters.count();
                let arg_count = type_args.count();
                let n = if param_count < arg_count then param_count else arg_count;
                while i < n then {
                    let tp = struct_template.type_parameters[i];
                    bindings.insert(tp.name, (type_args[i]));
                    i += 1;
                };
            },
            .None() then {
                when self.storage.generic_templates.lookup_enum(type_name) in {
                    .Some(enum_template) then {
                        let mutable i UInt = 0;
                        let param_count = enum_template.type_parameters.count();
                        let arg_count = type_args.count();
                        let n = if param_count < arg_count then param_count else arg_count;
                        while i < n then {
                            let tp = enum_template.type_parameters[i];
                            bindings.insert(tp.name, (type_args[i]));
                            i += 1;
                        };
                    },
                    .None() then {},
                };
            },
        };

        return self.apply_type_bindings(return_type, bindings);
    };

    module_private bind_static_method_param_types(self, type_name String, type_args List[Type], param_types List[Type]) List[Type] = {
        if type_args.is_empty() then {
            return param_types;
        };

        let mutable bindings = Dict[String, Type].new();
        let mutable receiver_type = when self.storage.global_scope.lookup_type(type_name) in {
            .Some(t) then when t in {
                .StructureType(template_def_id) then Type.GenericStruct(type_name, template_def_id, type_args),
                .EnumType(template_def_id) then Type.GenericEnum(type_name, template_def_id, type_args),
                _ then Type.Unknown(),
            },
            .None() then Type.Unknown(),
        };
        when receiver_type in {
            .Unknown() then {},
            _ then { bindings.insert("Self", receiver_type);},
        };

        when self.storage.generic_templates.lookup_struct(type_name) in {
            .Some(struct_template) then {
                let mutable i UInt = 0;
                let param_count = struct_template.type_parameters.count();
                let arg_count = type_args.count();
                let n = if param_count < arg_count then param_count else arg_count;
                while i < n then {
                    let tp = struct_template.type_parameters[i];
                    bindings.insert(tp.name, (type_args[i]));
                    i += 1;
                };
            },
            .None() then {
                when self.storage.generic_templates.lookup_enum(type_name) in {
                    .Some(enum_template) then {
                        let mutable i UInt = 0;
                        let param_count = enum_template.type_parameters.count();
                        let arg_count = type_args.count();
                        let n = if param_count < arg_count then param_count else arg_count;
                        while i < n then {
                            let tp = enum_template.type_parameters[i];
                            bindings.insert(tp.name, (type_args[i]));
                            i += 1;
                        };
                    },
                    .None() then {},
                };
            },
        };

        let mutable bound = List[Type].new();
        for param_type in param_types then {
            bound.push(self.apply_type_bindings(param_type, bindings));
        };
        return bound;
    };

    module_private resolve_call_return_type(self, callee TypedExpr) Type = {
        when callee.expr_kind in {
            .Variable(sym) then {
                if self.context().get_function_return_type(sym.def_id) is .Some(return_type) then {
                    return return_type;
                };
                let sym_name = self.context().symbol_name(sym);
                return when sym.symbol_type in {
                    .FunctionType(_, ret) then ret,
                    .StructureType(_) then sym.symbol_type,
                    .EnumType(_) then sym.symbol_type,
                    .GenericStruct(_, _, _) then sym.symbol_type,
                    .GenericEnum(_, _, _) then sym.symbol_type,
                    _ then if self.storage.global_scope.lookup_type(sym_name) is .Some(t) then t else Type.Unknown(),
                };
            },
            .MemberPath(base, path) then if not path.is_empty() then {
                return self.resolve_method_return_type(base.expr_type, self.context().symbol_name(path[path.count() - 1]));
            },
            .MethodReference(base, _, method, _, _, _) then {
                when method.symbol_type in {
                    .FunctionType(_, ret) then {
                        return ret;
                    },
                    _ then {},
                };
                if self.context().get_function_return_type(method.def_id) is .Some(return_type) then {
                    return return_type;
                };
                return self.resolve_method_return_type(base.expr_type, self.context().symbol_name(method));
            },
            .TraitMethodPlaceholder(base, trait_type, method, _, _) then {
                let trait_name = self.trait_name_from_type(trait_type);
                let method_name = self.context().symbol_name(method);
                let mutable qualified_return_type = self.resolve_qualified_method_return_type(trait_name, method_name, base.expr_type);
                return when qualified_return_type in {
                    .Unknown() then self.resolve_method_return_type(base.expr_type, self.context().symbol_name(method)),
                    _ then qualified_return_type,
                };
            },
            .StaticMethodCall(receiver_type, _, method, _, _, _) then {
                when method.symbol_type in {
                    .FunctionType(_, ret) then {
                        return ret;
                    },
                    .Unknown() then {},
                    _ then {
                        return method.symbol_type;
                    },
                };
                if self.context().get_function_return_type(method.def_id) is .Some(return_type) then {
                    return return_type;
                };
                return self.resolve_method_return_type(receiver_type, self.context().symbol_name(method));
            },
            .GenericInstantiation(_, _) then {
                return callee.expr_type;
            },
            .TraitMethodCall(base, trait_type, method_name, _, _) then {
                let trait_name = self.trait_name_from_type(trait_type);
                let mutable qualified_return_type = self.resolve_qualified_method_return_type(trait_name, method_name, base.expr_type);
                return when qualified_return_type in {
                    .Unknown() then self.resolve_method_return_type(base.expr_type, method_name),
                    _ then qualified_return_type,
                };
            },
            _ then {},
        };
        when callee.expr_type in {
            .FunctionType(_, ret) then { return ret;},
            _ then {},
        };
        return Type.Unknown();
    };

    // 从 callee 的类型信息中提取参数类型列表，用于向调用参数传播期望类型。
    // 返回空列表表示无法确定参数类型。
    module_private resolve_call_param_types(self, callee TypedExpr) List[Type] = {
        when callee.expr_kind in {
            .Variable(sym) then {
                if self.context().get_function_type(sym.def_id) is .Some(function_type) then {
                    let mutable out = List[Type].new();
                    when function_type in {
                        .FunctionType(fn_params, _) then {
                            for parameter in fn_params then {
                                out.push(parameter.param_type);
                            };
                        },
                        _ then {},
                    };
                    return out;
                };
                let constructor_param_types = self.struct_constructor_param_types(sym.symbol_type);
                if not constructor_param_types.is_empty() then {
                    let mutable out = List[Type].new();
                    for param_type in constructor_param_types then {
                        out.push(param_type);
                    };
                    return out;
                };
                when sym.symbol_type in {
                    .FunctionType(params, _) then {
                        let mutable out = List[Type].new();
                        for entry in params then {
                            out.push(entry.param_type);
                        };
                        return out;
                    },
                    _ then {},
                };
                return List[Type].new();
            },
            .MemberPath(base, path) then if not path.is_empty() then {
                let mutable out = List[Type].new();
                for param_type in self.resolve_method_param_types(base.expr_type, self.context().symbol_name(path[path.count() - 1])) then {
                    out.push(param_type);
                };
                return out;
            },
            .MethodReference(base, _, method, _, _, _) then {
                let method_name = self.context().symbol_name(method);
                let mutable out = List[Type].new();
                for param_type in self.resolve_method_param_types(base.expr_type, method_name) then {
                    out.push(param_type);
                };
                return out;
            },
            .TraitMethodPlaceholder(base, trait_type, method, _, _) then {
                let trait_name = self.trait_name_from_type(trait_type);
                let method_name = self.context().symbol_name(method);
                let trait_params = self.resolve_trait_method_param_types(trait_name, method_name, base.expr_type);
                if trait_params.is_empty() then {
                    let mutable out = List[Type].new();
                    for param_type in self.resolve_method_param_types(base.expr_type, method_name) then {
                        out.push(param_type);
                    };
                    return out;
                };
                let mutable out = List[Type].new();
                for param_type in trait_params then {
                    out.push(param_type);
                };
                return out;
            },
            .TraitMethodCall(base, trait_type, method_name, _, _) then {
                let trait_name = self.trait_name_from_type(trait_type);
                let trait_params = self.resolve_trait_method_param_types(trait_name, method_name, base.expr_type);
                if trait_params.is_empty() then {
                    let mutable out = List[Type].new();
                    for param_type in self.resolve_method_param_types(base.expr_type, method_name) then {
                        out.push(param_type);
                    };
                    return out;
                };
                let mutable out = List[Type].new();
                for param_type in trait_params then {
                    out.push(param_type);
                };
                return out;
            },
            _ then {},
        };
        when callee.expr_type in {
            .FunctionType(params, _) then {
                let mutable out = List[Type].new();
                for entry in params then {
                    out.push(entry.param_type);
                };
                return out;
            },
            _ then {},
        };
        return List[Type].new();
    };

    module_private struct_constructor_param_types(self, constructor_type Type) List[Type] = {
        let inner_type = when constructor_type in {
            .MutableReferenceType(inner) then inner,
            .ReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then constructor_type,
        };

        return when inner_type in {
            .StructureType(DefId(def_id)) then when self.context().get_struct_fields_by_raw_id(def_id(UInt)) in {
                .Some(fields) then {
                    let mutable types = List[Type].new();
                    for field in fields then {
                        types.push(field.field_type);
                    };
                    yield types;
                },
                .None() then List[Type].new(),
            },
            .GenericStruct(template_name, _, args) then when self.storage.generic_templates.lookup_struct(template_name) in {
                .Some(struct_template) then when self.context().get_struct_fields(struct_template.def_id) in {
                    .Some(fields) then {
                        let mutable bindings = Dict[String, Type].new();
                        let mutable i UInt = 0;
                        let param_count = struct_template.type_parameters.count();
                        let arg_count = args.count();
                        let n = if param_count < arg_count then param_count else arg_count;
                        while i < n then {
                            let tp = struct_template.type_parameters[i];
                            bindings.insert(tp.name, (args[i]));
                            i += 1;
                        };
                        let mutable types = List[Type].new();
                        for field in fields then {
                            types.push(self.apply_type_bindings(field.field_type, bindings));
                        };
                        yield types;
                    },
                    .None() then List[Type].new(),
                },
                .None() then List[Type].new(),
            },
            _ then List[Type].new(),
        };
    };

    // 将 TypeSubstitution 应用到 TypedDecl（递归替换所有类型变量）
};
