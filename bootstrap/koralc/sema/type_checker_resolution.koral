given TypeChecker {
    module_private surface_named_type(self, t Type) Type = {
        return when t in {
            .TraitObject(_, _, _) then Type.ReferenceType(t),
            _ then t,
        };
    };

    // Return the trait object underneath any reference-family layers.
    // Trait-target decisions (Self's type and the `Self : Trait[args]` bound) must
    // key off the trait itself; Swift uses `traits[baseName] != nil`, which is
    // unaffected by the internal `ReferenceType(TraitObject)` layout wrap that
    // surface_named_type adds. Matching on a bare `.TraitObject` shape instead
    // silently skipped every wrapped case.
    module_private as_trait_object_type(self, t Type) Option[Type] = {
        return when t in {
            .TraitObject(_, _, _) then Option[Type].Some(t),
            .ReferenceType(inner) then self.as_trait_object_type(inner),
            .MutableReferenceType(inner) then self.as_trait_object_type(inner),
            .BorrowedReferenceType(inner) then self.as_trait_object_type(inner),
            .MutableBorrowedReferenceType(inner) then self.as_trait_object_type(inner),
            .WeakReferenceType(inner) then self.as_trait_object_type(inner),
            .MutableWeakReferenceType(inner) then self.as_trait_object_type(inner),
            _ then Option[Type].None(),
        };
    };

    module_private to_type_ref_list_in_resolution(self, args List[Type]) List[Type] = {
        let mutable refs = List[Type].new();
        for arg in args then {
            refs.push(arg);
        };
        return refs;
    };

    module_private trait_object_safety_name(self, t Type) Option[String] = {
        return when t in {
            .TraitObject(name, _, _) then Option[String].Some(name),
            .ReferenceType(inner) then self.trait_object_safety_name(inner),
            .MutableReferenceType(inner) then self.trait_object_safety_name(inner),
            .BorrowedReferenceType(inner) then self.trait_object_safety_name(inner),
            .MutableBorrowedReferenceType(inner) then self.trait_object_safety_name(inner),
            .WeakReferenceType(inner) then self.trait_object_safety_name(inner),
            .MutableWeakReferenceType(inner) then self.trait_object_safety_name(inner),
            _ then Option[String].None(),
        };
    };

    module_private resolve_visible_generic_template_type(self, base String, resolved_args List[Type], base_type Type) Type = {
        let canonical = self.canonicalize_alias_type(base_type);
        return when canonical in {
            .StructureType(def_id) then {
                if not self.ensure_generic_template_visible(base, def_id, unknown_span()) then {
                    return Type.Unknown();
                };
                Type.GenericStruct(base, def_id, self.to_type_ref_list_in_resolution(resolved_args))
            },
            .EnumType(def_id) then {
                if not self.ensure_generic_template_visible(base, def_id, unknown_span()) then {
                    return Type.Unknown();
                };
                Type.GenericEnum(base, def_id, self.to_type_ref_list_in_resolution(resolved_args))
            },
            _ then {
                self.storage.diagnostics.push(make_diagnostic(DiagnosticStage.Semantic(), self.storage.file_path, "Undefined type: \(base)"));
                Type.Unknown()
            },
        };
    };

    module_private check_trait_object_safety(self, trait_name String) Bool = {
        return when self.storage.trait_registry.check_object_safety_in_module(trait_name, self.storage.module_path) in {
            .Ok(is_safe) then {
                if not is_safe then {
                    self.storage.diagnostics.push(
                        make_diagnostic(
                            DiagnosticStage.Semantic(),
                            self.storage.file_path,
                            "Trait '\(trait_name)' is not object-safe"
                        )
                    );
                };
                is_safe
            },
            .Error(_) then true,
        };
    };

    module_private resolve_type(self, node TypeNode) Type = {
        return when node in {
            .Identifier(name) then {
                // Swift `resolveTypeNode` (TypeCheckerTypeResolution.swift:295)
                // checks object safety when a bare trait name is used as a type.
                let resolved = self.resolve_named_type(name);
                when self.trait_object_safety_name(resolved) in {
                    .Some(trait_name) then { let _ = self.check_trait_object_safety(trait_name); },
                    .None() then {},
                };
                self.surface_named_type(resolved)
            },
            .Reference(inner, is_mutable) then {
                let trait_ref_override = when inner in {
                    .Identifier(name) then if self.storage.trait_registry.get(name) is .Some(_) then {
                        let trait_ref_inner = self.canonical_trait_object_type(name);
                        Option[Type].Some(if is_mutable then self.resolve_mutable_reference_type(trait_ref_inner) else self.resolve_reference_type(trait_ref_inner))
                    } else Option[Type].None(),
                    .Generic(base, args) then {
                        if self.storage.trait_registry.get(base) is .Some(_) then {
                            let mutable resolved_args = List[Type].new();
                            for arg in args then {
                                resolved_args.push(self.resolve_type(arg));
                            };
                            let trait_ref_inner = self.make_trait_object_type(base, self.to_type_ref_list_in_resolution(resolved_args));
                            Option[Type].Some(if is_mutable then self.resolve_mutable_reference_type(trait_ref_inner) else self.resolve_reference_type(trait_ref_inner))
                        } else Option[Type].None()
                    },
                    _ then Option[Type].None(),
                };
                when trait_ref_override in {
                    .Some(resolved_trait_ref) then resolved_trait_ref,
                    .None() then {
                        let resolved_inner = self.resolve_type(inner);
                        if is_mutable then self.resolve_mutable_reference_type(resolved_inner) else self.resolve_reference_type(resolved_inner)
                    },
                }
            },
            .BorrowedReference(inner, is_mutable) then {
                let resolved_inner = self.resolve_type(inner);
                if is_mutable then Type.MutableBorrowedReferenceType(resolved_inner) else Type.BorrowedReferenceType(resolved_inner)
            },
            .Pointer(inner, is_mutable) then {
                let resolved_inner = self.resolve_type(inner);
                if is_mutable then Type.MutablePointerType(resolved_inner) else Type.PointerType(resolved_inner)
            },
            .WeakReference(inner, is_mutable) then {
                let resolved_inner = self.resolve_type(inner);
                if is_mutable then self.resolve_mutable_weak_reference_type(resolved_inner) else self.resolve_weak_reference_type(resolved_inner)
            },
            .Generic(base, args) then {
                let mutable resolved_args = List[Type].new();
                for a in args then {
                    resolved_args.push(self.resolve_type(a));
                };
                if self.storage.trait_registry.get(base) is .Some(_) then {
                    let _ = self.check_trait_object_safety(base);
                    return Type.ReferenceType(self.make_trait_object_type(base, self.to_type_ref_list_in_resolution(resolved_args)));
                };
                when self.try_resolve_named_type_without_diag(base) in {
                    .Some(base_type) then {
                        return self.resolve_visible_generic_template_type(base, resolved_args, base_type);
                    },
                    .None() then {},
                };
                self.storage.diagnostics.push(make_diagnostic(DiagnosticStage.Semantic(), self.storage.file_path, "Undefined type: \(base)"));
                return Type.Unknown();
            },
            .InferredSelf() then {
                if self.storage.current_scope.lookup_type("Self") is .Some(t) then {
                    return t;
                };
                self.storage.diagnostics.push(make_diagnostic(DiagnosticStage.Semantic(), self.storage.file_path, "Undefined type: Self"));
                return Type.Unknown();
            },
            .FunctionType(param_types, return_type) then {
                let mutable resolved_params = List[Type].new();
                for pt in param_types then {
                    resolved_params.push(self.resolve_type(pt));
                };
                let resolved_ret = self.resolve_type(return_type);
                return make_function_type(resolved_params, resolved_ret);
            },
        };
    };

    module_private resolve_type_with_bindings(self, node TypeNode, bindings Dict[String, Type]) Type = {
        return when node in {
            .Identifier(name) then when bindings.get(name) in {
                .Some(bound) then bound,
                .None() then {
                    if self.lookup_current_file_type_symbol(name) is .Some(local_trait) then {
                        if local_trait is .TraitObject(_, _, _) then {
                            return self.surface_named_type(self.canonicalize_alias_type(local_trait));
                        };
                    };
                    if self.storage.current_scope.lookup_type(name) is .Some(t) then {
                        return self.surface_named_type(self.canonicalize_alias_type(t));
                    };
                    self.surface_named_type(self.resolve_named_type(name))
                },
            },
            .Reference(inner, is_mutable) then {
                let trait_ref_override = when inner in {
                    .Identifier(name) then if bindings.get(name) is .None() and self.storage.trait_registry.get(name) is .Some(_) then {
                        let trait_ref_inner = self.canonical_trait_object_type(name);
                        Option[Type].Some(if is_mutable then self.resolve_mutable_reference_type(trait_ref_inner) else self.resolve_reference_type(trait_ref_inner))
                    } else Option[Type].None(),
                    .Generic(base, args) then {
                        if self.storage.trait_registry.get(base) is .Some(_) then {
                            let mutable resolved_args = List[Type].new();
                            for arg in args then {
                                resolved_args.push(self.resolve_type_with_bindings(arg, bindings));
                            };
                            let trait_ref_inner = self.make_trait_object_type(base, self.to_type_ref_list_in_resolution(resolved_args));
                            Option[Type].Some(if is_mutable then self.resolve_mutable_reference_type(trait_ref_inner) else self.resolve_reference_type(trait_ref_inner))
                        } else Option[Type].None()
                    },
                    _ then Option[Type].None(),
                };
                when trait_ref_override in {
                    .Some(resolved_trait_ref) then resolved_trait_ref,
                    .None() then {
                        let resolved_inner = self.resolve_type_with_bindings(inner, bindings);
                        if is_mutable then self.resolve_mutable_reference_type(resolved_inner) else self.resolve_reference_type(resolved_inner)
                    },
                }
            },
            .BorrowedReference(inner, is_mutable) then {
                let resolved_inner = self.resolve_type_with_bindings(inner, bindings);
                if is_mutable then Type.MutableBorrowedReferenceType(resolved_inner) else Type.BorrowedReferenceType(resolved_inner)
            },
            .Pointer(inner, is_mutable) then {
                let resolved_inner = self.resolve_type_with_bindings(inner, bindings);
                if is_mutable then Type.MutablePointerType(resolved_inner) else Type.PointerType(resolved_inner)
            },
            .WeakReference(inner, is_mutable) then {
                let resolved_inner = self.resolve_type_with_bindings(inner, bindings);
                if is_mutable then self.resolve_mutable_weak_reference_type(resolved_inner) else self.resolve_weak_reference_type(resolved_inner)
            },
            .Generic(base, args) then {
                let mutable resolved_args = List[Type].new();
                for a in args then {
                    resolved_args.push(self.resolve_type_with_bindings(a, bindings));
                };
                if self.storage.trait_registry.get(base) is .Some(_) then {
                    return Type.ReferenceType(self.make_trait_object_type(base, self.to_type_ref_list_in_resolution(resolved_args)));
                };
                when self.storage.current_scope.lookup_type(base) in {
                    .Some(base_type) then {
                        return self.resolve_visible_generic_template_type(base, resolved_args, base_type);
                    },
                    .None() then when self.try_resolve_named_type_without_diag(base) in {
                        .Some(base_type) then {
                            return self.resolve_visible_generic_template_type(base, resolved_args, base_type);
                        },
                        .None() then {},
                    },
                };
                return Type.Unknown();
            },
            .InferredSelf() then when bindings.get("Self") in {
                .Some(bound_self) then bound_self,
                .None() then self.resolve_type(node),
            },
            .FunctionType(param_types, return_type) then {
                let mutable resolved_params = List[Type].new();
                for pt in param_types then {
                    resolved_params.push(self.resolve_type_with_bindings(pt, bindings));
                };
                let resolved_ret = self.resolve_type_with_bindings(return_type, bindings);
                return make_function_type(resolved_params, resolved_ret);
            },
        };
    };

    module_private try_resolve_named_type_in_scope_without_diag(self, name String, scope Scope) Option[Type] = {
        if name == "Self" then {
            return scope.lookup_type("Self");
        };
        if self.lookup_current_file_type_symbol(name) is .Some(local_trait) then {
            if local_trait is .TraitObject(_, _, _) then {
                return Option[Type].Some(local_trait);
            };
        };
        if scope.lookup_type(name) is .Some(t) then {
            return Option[Type].Some(t);
        };
        return self.try_resolve_named_type_without_diag(name);
    };

    module_private resolve_named_type_in_scope(self, name String, scope Scope) Type = {
        if self.try_resolve_named_type_in_scope_without_diag(name, scope) is .Some(t) then {
            let canonical = self.canonicalize_alias_type(t);
            self.check_type_visibility(canonical, name, scope);
            return canonical;
        };
        self.storage.diagnostics.push(make_diagnostic(DiagnosticStage.Semantic(), self.storage.file_path, "Undefined type: \(name)"));
        return Type.Unknown();
    };

    module_private resolve_type_in_scope(self, node TypeNode, scope Scope) Type = {
        return when node in {
            .Identifier(name) then {
                let resolved = self.resolve_named_type_in_scope(name, scope);
                when self.trait_object_safety_name(resolved) in {
                    .Some(trait_name) then { let _ = self.check_trait_object_safety(trait_name); },
                    .None() then {},
                };
                self.surface_named_type(resolved)
            },
            .Reference(inner, is_mutable) then {
                let trait_ref_override = when inner in {
                    .Identifier(name) then if self.storage.trait_registry.get(name) is .Some(_) then {
                        let trait_ref_inner = self.canonical_trait_object_type(name);
                        Option[Type].Some(if is_mutable then self.resolve_mutable_reference_type(trait_ref_inner) else self.resolve_reference_type(trait_ref_inner))
                    } else Option[Type].None(),
                    .Generic(base, args) then {
                        if self.storage.trait_registry.get(base) is .Some(_) then {
                            let mutable resolved_args = List[Type].new();
                            for arg in args then {
                                resolved_args.push(self.resolve_type_in_scope(arg, scope));
                            };
                            let trait_ref_inner = self.make_trait_object_type(base, self.to_type_ref_list_in_resolution(resolved_args));
                            Option[Type].Some(if is_mutable then self.resolve_mutable_reference_type(trait_ref_inner) else self.resolve_reference_type(trait_ref_inner))
                        } else Option[Type].None()
                    },
                    _ then Option[Type].None(),
                };
                when trait_ref_override in {
                    .Some(resolved_trait_ref) then resolved_trait_ref,
                    .None() then {
                        let resolved_inner = self.resolve_type_in_scope(inner, scope);
                        if is_mutable then self.resolve_mutable_reference_type(resolved_inner) else self.resolve_reference_type(resolved_inner)
                    },
                }
            },
            .Pointer(inner, is_mutable) then {
                let resolved_inner = self.resolve_type_in_scope(inner, scope);
                if is_mutable then Type.MutablePointerType(resolved_inner) else Type.PointerType(resolved_inner)
            },
            .WeakReference(inner, is_mutable) then {
                let resolved_inner = self.resolve_type_in_scope(inner, scope);
                if is_mutable then self.resolve_mutable_weak_reference_type(resolved_inner) else self.resolve_weak_reference_type(resolved_inner)
            },
            .BorrowedReference(inner, is_mutable) then {
                let resolved_inner = self.resolve_type_in_scope(inner, scope);
                if is_mutable then Type.MutableBorrowedReferenceType(resolved_inner) else Type.BorrowedReferenceType(resolved_inner)
            },
            .Generic(base, args) then {
                let mutable resolved_args = List[Type].new();
                for a in args then {
                    resolved_args.push(self.resolve_type_in_scope(a, scope));
                };
                if self.storage.trait_registry.get(base) is .Some(_) then {
                    return Type.ReferenceType(self.make_trait_object_type(base, self.to_type_ref_list_in_resolution(resolved_args)));
                };
                when self.try_resolve_named_type_in_scope_without_diag(base, scope) in {
                    .Some(base_type) then {
                        return self.resolve_visible_generic_template_type(base, resolved_args, base_type);
                    },
                    .None() then {},
                };
                return Type.Unknown();
            },
            .InferredSelf() then {
                if scope.lookup_type("Self") is .Some(t) then {
                    return t;
                };
                self.storage.diagnostics.push(make_diagnostic(DiagnosticStage.Semantic(), self.storage.file_path, "Undefined type: Self"));
                return Type.Unknown();
            },
            .FunctionType(param_types, return_type) then {
                let mutable resolved_params = List[Type].new();
                for pt in param_types then {
                    resolved_params.push(self.resolve_type_in_scope(pt, scope));
                };
                let resolved_ret = self.resolve_type_in_scope(return_type, scope);
                return make_function_type(resolved_params, resolved_ret);
            },
        };
    };

    module_private variable_kind_for_param_type(self, param_type Type, is_mutable Bool) VariableKind = {
        let is_mutable_ref_like = when param_type in {
            .MutableReferenceType(_) then true,
            .MutablePointerType(_) then true,
            _ then false,
        };
        if is_mutable_ref_like then {
            return if is_mutable then VariableKind.MutableReference() else VariableKind.Reference();
        };
        let is_ref_like = when param_type in {
            .ReferenceType(_) then true,
            .PointerType(_) then true,
            .WeakReferenceType(_) then true,
            .MutableWeakReferenceType(_) then true,
            _ then false,
        };
        if is_ref_like then {
            return if is_mutable then VariableKind.MutableReference() else VariableKind.Reference();
        };
        return if is_mutable then VariableKind.MutableValue() else VariableKind.Value();
    };

    module_private try_resolve_named_type_without_diag(self, name String) Option[Type] = {
        if name == "Int" then { return Option[Type].Some(Type.IntType());};
        if name == "Int8" then { return Option[Type].Some(Type.Int8Type());};
        if name == "Int16" then { return Option[Type].Some(Type.Int16Type());};
        if name == "Int32" then { return Option[Type].Some(Type.Int32Type());};
        if name == "Int64" then { return Option[Type].Some(Type.Int64Type());};
        if name == "UInt" then { return Option[Type].Some(Type.UIntType());};
        if name == "UInt8" then { return Option[Type].Some(Type.UInt8Type());};
        if name == "UInt16" then { return Option[Type].Some(Type.UInt16Type());};
        if name == "UInt32" then { return Option[Type].Some(Type.UInt32Type());};
        if name == "UInt64" then { return Option[Type].Some(Type.UInt64Type());};
        if name == "Float32" then { return Option[Type].Some(Type.Float32Type());};
        if name == "Float64" then { return Option[Type].Some(Type.Float64Type());};
        if name == "Bool" then { return Option[Type].Some(Type.BoolType());};
        if name == "Void" then { return Option[Type].Some(Type.VoidType());};
        if name == "Never" then { return Option[Type].Some(Type.NeverType());};
        if name == "Self" then {
            return self.storage.global_scope.lookup_type("Self");
        };
        if self.lookup_current_file_type_symbol(name) is .Some(t) then {
            return Option[Type].Some(self.canonicalize_alias_type(t));
        };
        if self.resolve_imported_alias_type(name) is .Some(t) then {
            return Option[Type].Some(self.canonicalize_alias_type(t));
        };
        if self.storage.global_scope.lookup_type(name) is .Some(t) then {
            return Option[Type].Some(self.canonicalize_alias_type(t));
        };
        // 某些模块加载顺序下，Trait 可能尚未写入 type scope；
        // 回退到 trait registry，避免 given Writer 之类退化为 Unknown。
        if self.storage.trait_registry.get(name) is .Some(_) then {
            return Option[Type].Some(self.canonical_trait_object_type(name));
        };
        return Option[Type].None();
    };

    module_private builtin_string_type(self) Type = {
        return when self.storage.global_scope.lookup_type("String") in {
            .Some(t) then self.canonicalize_alias_type(t),
            .None() then Type.Unknown(),
        };
    };

    module_private builtin_rune_type(self) Type = {
        return when self.storage.global_scope.lookup_type("Rune") in {
            .Some(t) then self.canonicalize_alias_type(t),
            .None() then Type.Unknown(),
        };
    };

    module_private rune_literal_scalar_value(self, value String) String = {
        let bytes = value.to_bytes();
        if bytes.is_empty() then {
            return "0";
        };
        let b0 = bytes[0(UInt)](UInt);
        if b0 < 128(UInt) then {
            return b0.to_string();
        };
        if b0 < 224(UInt) and bytes.count() >= 2(UInt) then {
            let b1 = bytes[1(UInt)](UInt);
            let cp = ((b0 & 31(UInt)) << 6(UInt)) | (b1 & 63(UInt));
            return cp.to_string();
        };
        if b0 < 240(UInt) and bytes.count() >= 3(UInt) then {
            let b1 = bytes[1(UInt)](UInt);
            let b2 = bytes[2(UInt)](UInt);
            let cp = ((b0 & 15(UInt)) << 12(UInt)) | ((b1 & 63(UInt)) << 6(UInt)) | (b2 & 63(UInt));
            return cp.to_string();
        };
        if b0 < 248(UInt) and bytes.count() >= 4(UInt) then {
            let b1 = bytes[1(UInt)](UInt);
            let b2 = bytes[2(UInt)](UInt);
            let b3 = bytes[3(UInt)](UInt);
            let cp = ((b0 & 7(UInt)) << 18(UInt)) | ((b1 & 63(UInt)) << 12(UInt)) | ((b2 & 63(UInt)) << 6(UInt)) | (b3 & 63(UInt));
            return cp.to_string();
        };
        return "0";
    };

    module_private build_rune_constructor_expr(self, scalar_value String, rune_type Type) TypedExpr = {
        return when rune_type in {
            .StructureType(def_id) then {
                let type_name = self.context().get_name(def_id) or else "Rune";
                let identifier = Symbol(def_id, rune_type, SymbolKind.TypeSymbol());
                let mutable args = List[TypedExpr].new();
                args.push(make_typed_expr(TypedExprKind.IntegerLiteral(scalar_value), Type.UInt32Type()));
                let _ = type_name;
                make_typed_expr(TypedExprKind.TypeConstruction(identifier, List[Type].new(), args), rune_type)
            },
            _ then make_typed_expr(TypedExprKind.IntegerLiteral(scalar_value), Type.Unknown()),
        };
    };

    module_private lower_rune_literal(self, value String, expected Option[Type]) TypedExpr = {
        let scalar_value = self.rune_literal_scalar_value(value);
        when expected in {
            .Some(target_type) then {
                if self.is_integer_type(target_type) then {
                    return make_typed_expr(TypedExprKind.IntegerLiteral(scalar_value), target_type);
                };
                if self.is_rune_type(target_type) then {
                    return self.build_rune_constructor_expr(scalar_value, target_type);
                };
            },
            .None() then {},
        };

        let rune_type = self.builtin_rune_type();
        return when rune_type in {
            .Unknown() then {
                self.storage.diagnostics.push(
                    make_diagnostic(
                        DiagnosticStage.Semantic(),
                        self.storage.file_path,
                        "Rune type not found. Make sure the standard library is imported."
                    )
                );
                make_typed_expr(TypedExprKind.IntegerLiteral(scalar_value), Type.Unknown())
            },
            _ then self.build_rune_constructor_expr(scalar_value, rune_type),
        };
    };

    module_private lower_rune_literal_for_cast(self, value String, target_type Type) TypedExpr = {
        let scalar_value = self.rune_literal_scalar_value(value);
        if self.is_numeric_type(target_type) or self.is_float_type(target_type) then {
            return make_typed_expr(TypedExprKind.IntegerLiteral(scalar_value), target_type);
        };
        if self.is_rune_type(target_type) then {
            return self.build_rune_constructor_expr(scalar_value, target_type);
        };
        return self.lower_rune_literal(value, Option[Type].None());
    };

    module_private is_string_type(self, t Type) Bool = self.context().type_display_name(self.canonicalize_alias_type(t)) == "String";

    module_private is_rune_type(self, t Type) Bool = self.context().type_display_name(self.canonicalize_alias_type(t)) == "Rune";

    module_private type_module_path(self, t Type) Option[List[String]] = {
        return when t in {
            .StructureType(def_id) then self.context().get_module_path(def_id),
            .EnumType(def_id) then self.context().get_module_path(def_id),
            .OpaqueType(def_id) then self.context().get_module_path(def_id),
            .GenericStruct(template, _, _) then when self.try_resolve_named_type_without_diag(template) in {
                .Some(resolved) then self.type_module_path(self.canonicalize_alias_type(resolved)),
                .None() then Option[List[String]].None(),
            },
            .GenericEnum(template, _, _) then when self.try_resolve_named_type_without_diag(template) in {
                .Some(resolved) then self.type_module_path(self.canonicalize_alias_type(resolved)),
                .None() then Option[List[String]].None(),
            },
            _ then Option[List[String]].None(),
        };
    };

    module_private resolve_named_type(self, name String) Type = {
        // Declaration identity wins over the global textual type scope. This keeps
        // same-named traits/types from different modules distinct while preserving
        // local generic-parameter lookup through current_scope below.
        if self.lookup_current_file_type_symbol(name) is .Some(local_trait) then {
            if local_trait is .TraitObject(_, _, _) then {
                return self.canonicalize_alias_type(local_trait);
            };
        };
        if self.storage.current_scope.lookup_type(name) is .Some(t) then {
            return self.canonicalize_alias_type(t);
        };
        if self.try_resolve_named_type_without_diag(name) is .Some(t) then {
            let canonical = self.canonicalize_alias_type(t);
            self.check_type_visibility(canonical, name, self.storage.current_scope);
            return canonical;
        };
        self.storage.diagnostics.push(make_diagnostic(DiagnosticStage.Semantic(), self.storage.file_path, "Undefined type: \(name)"));
        return Type.Unknown();
    };

};
