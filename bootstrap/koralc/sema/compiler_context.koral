 // ── 类型查询 ──────────────────────────────────────────────────────────

 /// 获取类型的人类可读名称
 public get_type_name(self, t Type) String = {
 return when t in {
 .StructureType(def_id) then {
 yield when self.def_id_map.get_name(def_id) in {
 .Some(name) then name,
 .None() then "<unknown>",
 };
 },
 .EnumType(def_id) then {
 yield when self.def_id_map.get_name(def_id) in {
 .Some(name) then name,
 .None() then "<unknown>",
 };
 },
 .OpaqueType(def_id) then {
 yield when self.def_id_map.get_name(def_id) in {
 .Some(name) then name,
 .None() then "<unknown>",
 };
 },
 .ModuleType(info) then {
 yield if info.module_path.is_empty() then "<module>" else join_strings(info.module_path, ".");
 },
 _ then type_to_string(t),
 };
 };

 /// 获取类型的调试名称（含泛型参数展开）
 public get_debug_name(self, t Type) String = {
 return when t in {
 .IntType() then "Int",
 .Int8Type() then "Int8",
 .Int16Type() then "Int16",
 .Int32Type() then "Int32",
 .Int64Type() then "Int64",
 .UIntType() then "UInt",
 .UInt8Type() then "UInt8",
 .UInt16Type() then "UInt16",
 .UInt32Type() then "UInt32",
 .UInt64Type() then "UInt64",
 .Float32Type() then "Float32",
 .Float64Type() then "Float64",
 .BoolType() then "Bool",
 .VoidType() then "Void",
 .NeverType() then "Never",
 .FunctionType(params, ret) then {
 let mutable parts = List[String].new();
 for entry in params then {
 parts.push(self.get_debug_name(entry.param_type));
 };
 let mutable out = StringBuilder.new();
 out.push_string("Func(");
 out.push_string(join_strings(parts, ", "));
 out.push_byte(')');
 out.push_byte(' ');
 out.push_string(self.get_debug_name(ret));
 yield out.to_string();
 },
 .ReferenceType(inner) then "*\(self.get_debug_name(inner))",
 .BorrowedReferenceType(inner) then "ref *\(self.get_debug_name(inner))",
 .MutableReferenceType(inner) then "*mutable \(self.get_debug_name(inner))",
 .MutableBorrowedReferenceType(inner) then "ref mutable *\(self.get_debug_name(inner))",
 .PointerType(inner) then "*unsafe \(self.get_debug_name(inner))",
 .MutablePointerType(inner) then "*unsafe mutable \(self.get_debug_name(inner))",
 .WeakReferenceType(inner) then "?*\(self.get_debug_name(inner))",
 .MutableWeakReferenceType(inner) then "?*mutable \(self.get_debug_name(inner))",
 .StructureType(def_id) then {
 let base_name = when self.def_id_map.get_name(def_id) in {
 .Some(n) then n,
 .None() then "<unknown>",
 };
 yield when self.def_id_map.get_type_arguments(def_id) in {
 .Some(args) then if not args.is_empty() then {
 let mutable arg_parts = List[String].new();
 for a in args then {
 arg_parts.push(self.get_debug_name(a));
 };
 let args_str = join_strings(arg_parts, ", ");
 let mutable out = StringBuilder.new();
 out.push_string(base_name);
 out.push_byte('[');
 out.push_string(args_str);
 out.push_byte(']');
 yield out.to_string();
 } else base_name,
 .None() then base_name,
 };
 },
 .EnumType(def_id) then {
 let base_name = when self.def_id_map.get_name(def_id) in {
 .Some(n) then n,
 .None() then "<unknown>",
 };
 yield when self.def_id_map.get_type_arguments(def_id) in {
 .Some(args) then if not args.is_empty() then {
 let mutable arg_parts = List[String].new();
 for a in args then {
 arg_parts.push(self.get_debug_name(a));
 };
 let args_str = join_strings(arg_parts, ", ");
 let mutable out = StringBuilder.new();
 out.push_string(base_name);
 out.push_byte('[');
 out.push_string(args_str);
 out.push_byte(']');
 yield out.to_string();
 } else base_name,
 .None() then base_name,
 };
 },
 .OpaqueType(def_id) then {
 yield when self.def_id_map.get_name(def_id) in {
 .Some(n) then n,
 .None() then "<unknown>",
 };
 },
 .ModuleType(info) then {
 yield if info.module_path.is_empty() then "<module>" else join_strings(info.module_path, ".");
 },
 .GenericParameter(name) then name,
 .GenericStruct(template, _, args) then {
 let mutable arg_parts = List[String].new();
 for a in args then {
 arg_parts.push(self.get_debug_name(a));
 };
 let args_str = join_strings(arg_parts, ", ");
 let mutable out = StringBuilder.new();
 out.push_string(template);
 out.push_byte('[');
 out.push_string(args_str);
 out.push_byte(']');
 yield out.to_string();
 },
 .GenericEnum(template, _, args) then {
 let mutable arg_parts = List[String].new();
 for a in args then {
 arg_parts.push(self.get_debug_name(a));
 };
 let args_str = join_strings(arg_parts, ", ");
 let mutable out = StringBuilder.new();
 out.push_string(template);
 out.push_byte('[');
 out.push_string(args_str);
 out.push_byte(']');
 yield out.to_string();
 },
 .TraitObject(name, _, args) then {
 if args.is_empty() then {
 yield name;
 } else {
 let mutable arg_parts = List[String].new();
 for a in args then {
 arg_parts.push(self.get_debug_name(a));
 };
 let args_str = join_strings(arg_parts, ", ");
 let mutable out = StringBuilder.new();
 out.push_byte('[');
 out.push_string(args_str);
 out.push_byte(']');
 out.push_string(name);
 yield out.to_string();
 };
 },
 .TypeVar(tv) then "?\(tv.id)",
 .Unknown() then "?",
 };
 };

 // ── 类型变量查询 ──────────────────────────────────────────────────────

 /// 检查类型是否包含类型变量
 public contains_type_variable(self, t Type) Bool = {
 return when t in {
 .TypeVar(_) then true,
 .FunctionType(params, ret) then {
 if self.contains_type_variable(ret) then { return true;};
 for entry in params then {
 if self.contains_type_variable(entry.param_type) then { return true;};
 };
 yield false;
 },
 .ReferenceType(inner) then self.contains_type_variable(inner),
 .MutableReferenceType(inner) then self.contains_type_variable(inner),
 .PointerType(inner) then self.contains_type_variable(inner),
 .MutablePointerType(inner) then self.contains_type_variable(inner),
 .WeakReferenceType(inner) then self.contains_type_variable(inner),
 .MutableWeakReferenceType(inner) then self.contains_type_variable(inner),
 .GenericStruct(_, _, args) then {
 for a in args then {
 if self.contains_type_variable(a) then { return true;};
 };
 yield false;
 },
 .GenericEnum(_, _, args) then {
 for a in args then {
 if self.contains_type_variable(a) then { return true;};
 };
 yield false;
 },
 _ then false,
 };
 };

 /// 检查类型是否包含泛型参数
 public contains_generic_parameter(self, t Type) Bool = {
 return type_contains_generic_parameter(t, self);
 };

 /// 检查类型表面是否仍提及未解析的泛型占位。
 public mentions_unresolved_generic_placeholder(self, t Type) Bool = {
 return type_mentions_unresolved_generic_placeholder(t);
 };

 // ── Layout Key 生成 ───────────────────────────────────────────────────

 /// 生成类型的布局键（用于 C 标识符生成）
 public get_layout_key(self, t Type) String = {
 return when t in {
 .IntType() then "I",
 .Int8Type() then "I8",
 .Int16Type() then "I16",
 .Int32Type() then "I32",
 .Int64Type() then "I64",
 .UIntType() then "U",
 .UInt8Type() then "U8",
 .UInt16Type() then "U16",
 .UInt32Type() then "U32",
 .UInt64Type() then "U64",
 .Float32Type() then "F32",
 .Float64Type() then "F64",
 .BoolType() then "B",
 .VoidType() then "V",
 .NeverType() then "N",
 .FunctionType(_, _) then "Fn",
 .ReferenceType(inner) then "R_\(self.get_layout_key(inner))",
 .MutableReferenceType(inner) then "MR_\(self.get_layout_key(inner))",
 .PointerType(inner) then "P_\(self.get_layout_key(inner))",
 .MutablePointerType(inner) then "MP_\(self.get_layout_key(inner))",
 .WeakReferenceType(inner) then "W_\(self.get_layout_key(inner))",
 .MutableWeakReferenceType(inner) then "MW_\(self.get_layout_key(inner))",
 .BorrowedReferenceType(inner) then "R_\(self.get_layout_key(inner))",
 .MutableBorrowedReferenceType(inner) then "MR_\(self.get_layout_key(inner))",
 .StructureType(def_id) then self.layout_key_for_def_id(def_id),
 .EnumType(def_id) then self.layout_key_for_def_id(def_id),
 .OpaqueType(def_id) then self.layout_key_for_def_id(def_id),
 .GenericParameter(name) then "Param_\(name)",
        .GenericStruct(template, template_def_id, args) then {
            if args.is_empty() and template_def_id.is_valid() and not self.is_generic_instantiation(template_def_id) then {
                yield self.layout_key_for_def_id(template_def_id);
            };
            let mutable arg_keys = List[String].new();
            for a in args then {
                arg_keys.push(self.get_layout_key(a));
            };
            let arg_key_suffix = join_strings(arg_keys, "_");
            let mutable out = StringBuilder.new();
            out.push_string(template);
            out.push_byte('_');
            out.push_string(arg_key_suffix);
            if template_def_id.is_valid() then {
                out.push_string("_d");
                out.push_string(template_def_id.id.to_string());
            };
            yield out.to_string();
        },
        .GenericEnum(template, template_def_id, args) then {
            if args.is_empty() and template_def_id.is_valid() and not self.is_generic_instantiation(template_def_id) then {
                yield self.layout_key_for_def_id(template_def_id);
            };
            let mutable arg_keys = List[String].new();
            for a in args then {
                arg_keys.push(self.get_layout_key(a));
            };
            let arg_key_suffix = join_strings(arg_keys, "_");
            let mutable out = StringBuilder.new();
            out.push_string(template);
            out.push_byte('_');
            out.push_string(arg_key_suffix);
            if template_def_id.is_valid() then {
                out.push_string("_d");
                out.push_string(template_def_id.id.to_string());
            };
            yield out.to_string();
        },
        .TraitObject(name, trait_def_id, args) then {
            let suffix = if trait_def_id.is_valid() then "_d\(trait_def_id.id)" else "";
            if args.is_empty() then {
                yield "TO_\(name)\(suffix)";
            };
            let mutable arg_keys = List[String].new();
 for arg in args then {
                arg_keys.push(self.get_layout_key(arg));
            };
            yield "TO_\(name)_\(join_strings(arg_keys, "_"))\(suffix)";
        },
        .ModuleType(info) then "M_\(join_strings(info.module_path, "_"))",
 .TypeVar(tv) then "TV_\(tv.id)",
 .Unknown() then "Unknown",
 };
 };

 file_private layout_key_for_def_id(self, def_id DefId) String = {
 let name_opt = self.def_id_map.get_name(def_id);
 let module_opt = self.def_id_map.get_module_path(def_id);
 let access_opt = self.def_id_map.get_access(def_id);
 let source_opt = self.def_id_map.get_source_file(def_id);

 let mutable parts = List[String].new();

 if module_opt is .Some(mod_path) and not mod_path.is_empty() then {
 parts.push(join_strings(mod_path, "_"));
 };

 // file_private 符号添加文件哈希
 let is_private = when access_opt in {
 .Some(a) then when a in {
 .FilePrivate() then true,
 _ then false,
 },
 .None() then false,
 };
 if is_private then {
 if source_opt is .Some(sf) then {
 let mutable hash UInt32 = 0;
 // 简单哈希
 let bytes = sf.bytes();
 for b in bytes then {
 hash = hash.wrapping_mul(31).wrapping_add(b(UInt32));
 };
 parts.push("f\((hash % 10000)(UInt))");
 };
 };

 when name_opt in {
 .Some(n) then parts.push(n),
 .None() then parts.push("T_\(def_id.id)"),
 };

 // 泛型实例化的类型参数
 if self.def_id_map.get_type_arguments(def_id) is .Some(args) then {
 let is_inst = when self.def_id_map.get_generic_instantiation(def_id) in {
 .Some(v) then v,
 .None() then false,
 };
 if not is_inst and not args.is_empty() then {
 let mutable arg_keys = List[String].new();
 for a in args then {
 arg_keys.push(self.get_layout_key(a));
 };
 parts.push(join_strings(arg_keys, "_"));
 };
 };

 return join_strings(parts, "_");
 };

 // ── Concrete function/given-member body cache ───────────────────────────

 public get_concrete_global_initializer(self, def_id DefId) Option[TypedExpr] = {
 return self.concrete_global_initializers.get(def_id.id);
 };

 public set_concrete_global_initializer(self, def_id DefId, initializer TypedExpr) Void = {
 self.concrete_global_initializers.insert(def_id.id, initializer);
 };

 public take_concrete_global_initializer(self, def_id DefId) Option[TypedExpr] = {
 let initializer = self.concrete_global_initializers.get(def_id.id);
 when initializer in {
 .Some(_) then self.concrete_global_initializers.remove(def_id.id),
 .None() then {},
 };
 return initializer;
 };

 public get_concrete_function_body(self, def_id DefId) Option[TypedExpr] = {
 return self.concrete_function_bodies.get(def_id.id);
 };

 public set_concrete_function_body(self, def_id DefId, body TypedExpr) Void = {
 self.concrete_function_bodies.insert(def_id.id, body);
 };

 public take_concrete_function_body(self, def_id DefId) Option[TypedExpr] = {
 let body = self.concrete_function_bodies.get(def_id.id);
 when body in {
 .Some(_) then self.concrete_function_bodies.remove(def_id.id),
 .None() then {},
 };
 return body;
 };

 public get_concrete_function_source(self, def_id DefId) Option[ConcreteExprSource] = {
 return self.concrete_function_sources.get(def_id.id);
 };

 public set_concrete_function_source(self, def_id DefId, source ConcreteExprSource) Void = {
 self.concrete_function_sources.insert(def_id.id, source);
 };

 public take_concrete_function_source(self, def_id DefId) Option[ConcreteExprSource] = {
 let source = self.concrete_function_sources.get(def_id.id);
 when source in {
 .Some(_) then self.concrete_function_sources.remove(def_id.id),
 .None() then {},
 };
 return source;
 };

 public get_concrete_given_member_body(self, def_id DefId) Option[TypedExpr] = {
 return self.concrete_given_member_bodies.get(def_id.id);
 };

 public set_concrete_given_member_body(self, def_id DefId, body TypedExpr) Void = {
 self.concrete_given_member_bodies.insert(def_id.id, body);
 };

 public take_concrete_given_member_body(self, def_id DefId) Option[TypedExpr] = {
 let body = self.concrete_given_member_bodies.get(def_id.id);
 when body in {
 .Some(_) then self.concrete_given_member_bodies.remove(def_id.id),
 .None() then {},
 };
 return body;
 };

 public get_concrete_given_member_source(self, def_id DefId) Option[ConcreteExprSource] = {
 return self.concrete_given_member_sources.get(def_id.id);
 };

 public set_concrete_given_member_source(self, def_id DefId, source ConcreteExprSource) Void = {
 self.concrete_given_member_sources.insert(def_id.id, source);
 };

 public take_concrete_given_member_source(self, def_id DefId) Option[ConcreteExprSource] = {
 let source = self.concrete_given_member_sources.get(def_id.id);
 when source in {
 .Some(_) then self.concrete_given_member_sources.remove(def_id.id),
 .None() then {},
 };
 return source;
 };

 /// Drop and replace concrete body caches with empty dicts to free memory.
 /// Call after monomorphization — MIR lowering and codegen don't need these.
 public drop_concrete_bodies(self) Void = {
 self.concrete_global_initializers = Dict[UInt, TypedExpr].new();
 self.concrete_function_bodies = Dict[UInt, TypedExpr].new();
 self.concrete_function_sources = Dict[UInt, ConcreteExprSource].new();
 self.concrete_given_member_bodies = Dict[UInt, TypedExpr].new();
 self.concrete_given_member_sources = Dict[UInt, ConcreteExprSource].new();
 };

 /// Drop DefId metadata that is only needed before codegen.
 /// Keep names/types/layout-related maps intact for MIR/codegen queries.
 public drop_codegen_unused_metadata(self) Void = {
 self.parsed_default_values = Dict[String, String].new();
 self.def_id_map.name_to_def_id = Dict[String, DefId].new();
 self.def_id_map.package_ids = Dict[UInt, String].new();
 self.def_id_map.spans = Dict[UInt, SourceSpan].new();
 self.def_id_map.import_records = Dict[UInt, ImportRecord].new();
 self.def_id_map.symbol_method_kinds = Dict[UInt, UInt].new();
 self.def_id_map.symbol_mutables = Dict[UInt, Bool].new();
 self.def_id_map.struct_generic_instantiation = Dict[UInt, Bool].new();
 self.def_id_map.enum_generic_instantiation = Dict[UInt, Bool].new();
 self.def_id_map.foreign_struct_fields = Dict[UInt, List[StructField]].new();
 self.def_id_map.not_deref_types = Set[UInt].new();
 };
};

// ── 辅助函数 ──────────────────────────────────────────────────────────────────

file_private let join_strings(parts List[String], sep String) String = {
 let mutable result = StringBuilder.new();
 let mutable first = true;
 for p in parts then {
 if not first then { result.push_string(sep);};
 result.push_string(p);
 first = false;
 };
 return result.to_string();
};
