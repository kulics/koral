// compiler_context.koral - 统一编译上下文
//
// 对应 compiler/Sources/KoralCompiler/Sema/CompilerContext.swift
//
// 提供统一的查询/更新接口，封装 DefIdMap 的访问，
// 避免直接依赖全局可变状态。
//
// MethodKind, SymbolInfo, StructTypeInfo, EnumTypeInfo 定义在
// bootstrap/koralc/typed/types.koral 中，通过模块系统可见。

// ── CompilerContext ───────────────────────────────────────────────────────────

/// 统一编译上下文
///
/// 封装 DefIdMap ref，提供不可变查询 API 和显式更新 API。
/// 使用 ref 持有 DefIdMap，与 Swift 版本的 class 语义一致，
/// 避免 ~500 字节的 DefIdMap 在栈上复制。
public type mutable CompilerContext(
 mutable def_id_map DefIdMap,
 mutable concrete_global_initializers Dict[UInt, TypedExpr],
 mutable concrete_function_bodies Dict[UInt, TypedExpr],
 mutable concrete_function_sources Dict[UInt, ConcreteExprSource],
 mutable concrete_given_member_bodies Dict[UInt, TypedExpr],
 mutable concrete_given_member_sources Dict[UInt, ConcreteExprSource],
 mutable parsed_default_values Dict[String, String],
 mutable method_param_specs Dict[String, Dict[String, List[FunctionParamSpec]]],
);

public type ConcreteExprSource(
 body Expr,
 source_file String,
 package_id String,
 module_path List[String],
);

given CompilerContext {
 public new() CompilerContext = {
 return CompilerContext(
 DefIdMap.new(),
 Dict[UInt, TypedExpr].new(),
 Dict[UInt, TypedExpr].new(),
 Dict[UInt, ConcreteExprSource].new(),
 Dict[UInt, TypedExpr].new(),
 Dict[UInt, ConcreteExprSource].new(),
 Dict[String, String].new(),
 Dict[String, Dict[String, List[FunctionParamSpec]]].new(),
 );
 };

 public from_def_id_map(map DefIdMap) CompilerContext = {
 return CompilerContext(
 map,
 Dict[UInt, TypedExpr].new(),
 Dict[UInt, TypedExpr].new(),
 Dict[UInt, ConcreteExprSource].new(),
 Dict[UInt, TypedExpr].new(),
 Dict[UInt, ConcreteExprSource].new(),
 Dict[String, String].new(),
 Dict[String, Dict[String, List[FunctionParamSpec]]].new(),
 );
 };

 public register_method_param_specs(self, owner_name String, method_name String, specs List[FunctionParamSpec]) Void = {
 let mutable methods = self.method_param_specs.get(owner_name) or else Dict[String, List[FunctionParamSpec]].new();
 methods.insert(method_name, specs);
 self.method_param_specs.insert(owner_name, methods);
 };

 public get_method_param_specs(self, owner_name String, method_name String) Option[List[FunctionParamSpec]] = {
 return when self.method_param_specs.get(owner_name) in {
 .Some(methods) then methods.get(method_name),
 .None() then Option[List[FunctionParamSpec]].None(),
 };
 };

 public find_method_param_specs_by_name(self, method_name String, expected_count UInt) Option[List[FunctionParamSpec]] = {
 for owner_entry in self.method_param_specs.iterator() then {
 when owner_entry.second.get(method_name) in {
 .Some(specs) then {
 if expected_count == 0(UInt) or specs.count() == expected_count then {
 return Option[List[FunctionParamSpec]].Some(specs);
 };
 },
 .None() then {},
 };
 };
 return Option[List[FunctionParamSpec]].None();
 };

 // ── DefIdMap 查询 ─────────────────────────────────────────────────────

 public get_name(self, def_id DefId) Option[String] = {
 return self.def_id_map.get_name(def_id);
 };

 public get_module_path(self, def_id DefId) Option[List[String]] = {
 return self.def_id_map.get_module_path(def_id);
 };

 public get_source_file(self, def_id DefId) Option[String] = {
 return self.def_id_map.get_source_file(def_id);
 };

 public get_package_id(self, def_id DefId) Option[String] = {
 return self.def_id_map.get_package_id(def_id);
 };

 public get_kind(self, def_id DefId) Option[DefKind] = {
 return self.def_id_map.get_kind(def_id);
 };

 public get_access(self, def_id DefId) Option[AccessModifier] = {
 return self.def_id_map.get_access(def_id);
 };

 public get_span(self, def_id DefId) Option[SourceSpan] = {
 return self.def_id_map.get_span(def_id);
 };

 public get_qualified_name(self, def_id DefId) Option[String] = {
 return self.def_id_map.get_qualified_name(def_id);
 };

 public get_c_identifier(self, def_id DefId) Option[String] = {
 return self.def_id_map.get_c_identifier(def_id);
 };

 public get_symbol_type(self, def_id DefId) Option[Type] = {
 return self.def_id_map.get_symbol_type(def_id);
 };

 public get_symbol_kind(self, def_id DefId) Option[SymbolKind] = {
 return self.def_id_map.get_symbol_kind(def_id);
 };

 public get_symbol_method_kind(self, def_id DefId) Option[MethodKind] = {
 return self.def_id_map.get_symbol_method_kind(def_id);
 };

 public get_symbol_mutable(self, def_id DefId) Option[Bool] = {
 return self.def_id_map.get_symbol_mutable(def_id);
 };

 public get_symbol(self, def_id DefId) Option[Symbol] = {
 return when self.get_symbol_type(def_id) in {
 .Some(symbol_type) then when self.get_symbol_kind(def_id) in {
 .Some(kind) then Option[Symbol].Some(Symbol(def_id, symbol_type, kind)),
 .None() then Option[Symbol].None(),
 },
 .None() then Option[Symbol].None(),
 };
 };

 public symbol_name(self, symbol Symbol) String = {
 return self.get_name(symbol.def_id) or else "";
 };

 public symbol_name_or(self, symbol Symbol, fallback String) String = {
 return self.get_name(symbol.def_id) or else fallback;
 };

 public is_symbol_mutable(self, def_id DefId) Bool = {
 return when self.def_id_map.get_symbol_mutable(def_id) in {
 .Some(v) then v,
 .None() then false,
 };
 };

 // ── DefId 查找 ────────────────────────────────────────────────────────

 public lookup_def_id(self, module_path List[String], name String, source_file Option[String]) Option[DefId] = {
 return self.def_id_map.lookup(module_path, name, source_file);
 };

 // ── DefId 分配 ────────────────────────────────────────────────────────

 public allocate_def_id(
 self,
 module_path List[String],
 name String,
 kind DefKind,
 source_file String,
 access AccessModifier,
 span SourceSpan,
 ) DefId = {
 return self.def_id_map.allocate_full(name, kind, module_path, source_file, "", access, span);
 };

 public allocate(self, name String, kind DefKind) DefId = {
 return self.def_id_map.allocate(name, kind);
 };

 public allocate_unindexed(self, name String, kind DefKind) DefId = {
 return self.def_id_map.allocate_unindexed(name, kind);
 };

 public allocate_full(
 self,
 name String,
 kind DefKind,
 module_path List[String],
 source_file String,
 access AccessModifier,
 span SourceSpan,
 ) DefId = {
 return self.def_id_map.allocate_full(name, kind, module_path, source_file, "", access, span);
 };

 public allocate_full_in_package(
 self,
 name String,
 kind DefKind,
 module_path List[String],
 source_file String,
 package_id String,
 access AccessModifier,
 span SourceSpan,
 ) DefId = {
 return self.def_id_map.allocate_full(name, kind, module_path, source_file, package_id, access, span);
 };

 // ── 符号创建 ──────────────────────────────────────────────────────────

 public create_symbol(
 self,
 name String,
 module_path List[String],
 source_file String,
 symbol_type Type,
 kind SymbolKind,
 method_kind MethodKind,
 access AccessModifier,
 span SourceSpan,
 is_mutable Bool,
 ) Symbol = {
 let def_kind = when kind in {
 .Function() then DefKind.Function(),
 .Variable(_) then DefKind.Variable(),
 .TypeSymbol() then {
 yield when symbol_type in {
 .OpaqueType(_) then DefKind.TypeDef(TypeDefKind.Opaque()),
 _ then DefKind.TypeDef(TypeDefKind.Structure()),
 };
 },
 .Module() then DefKind.Module(),
 };

 let def_id = when access in {
 .FilePrivate() then when self.def_id_map.lookup_exact(module_path, name, source_file) in {
 .Some(existing) then existing,
 .None() then self.def_id_map.allocate_full(name, def_kind, module_path, source_file, "", access, span),
 },
 _ then when self.def_id_map.lookup(module_path, name, Option[String].None()) in {
 .Some(existing) then existing,
 .None() then self.def_id_map.allocate_full(name, def_kind, module_path, source_file, "", access, span),
 },
 };

 self.def_id_map.set_symbol_info(def_id, SymbolInfo(symbol_type, kind, method_kind, is_mutable));

 return Symbol(def_id, symbol_type, kind);
 };

 public create_symbol_with_package(
 self,
 name String,
 module_path List[String],
 source_file String,
 symbol_type Type,
 kind SymbolKind,
 method_kind MethodKind,
 access AccessModifier,
 span SourceSpan,
 is_mutable Bool,
 package_id String,
 ) Symbol = {
 let def_kind = when kind in {
 .Function() then DefKind.Function(),
 .Variable(_) then DefKind.Variable(),
 .TypeSymbol() then {
 yield when symbol_type in {
 .OpaqueType(_) then DefKind.TypeDef(TypeDefKind.Opaque()),
 _ then DefKind.TypeDef(TypeDefKind.Structure()),
 };
 },
 .Module() then DefKind.Module(),
 };

 let def_id = when access in {
 .FilePrivate() then when self.def_id_map.lookup_exact(module_path, name, source_file) in {
 .Some(existing) then existing,
 .None() then self.def_id_map.allocate_full(name, def_kind, module_path, source_file, package_id, access, span),
 },
 _ then when self.def_id_map.lookup(module_path, name, Option[String].None()) in {
 .Some(existing) then existing,
 .None() then self.def_id_map.allocate_full(name, def_kind, module_path, source_file, package_id, access, span),
 },
 };

 self.def_id_map.set_symbol_info(def_id, SymbolInfo(symbol_type, kind, method_kind, is_mutable));

 return Symbol(def_id, symbol_type, kind);
 };

 // ── 类型定义查询 ──────────────────────────────────────────────────────

 public get_struct_fields(self, def_id DefId) Option[List[StructField]] = {
 return self.def_id_map.get_struct_fields(def_id);
 };

 public get_struct_fields_by_raw_id(self, raw_id UInt) Option[List[StructField]] = {
 return self.def_id_map.get_struct_fields(DefId(raw_id));
 };

 public def_id_name_equals(self, def_id DefId, expected String) Bool = {
 for entry in self.def_id_map.names then {
 if entry.first == def_id.id then {
 return entry.second == expected;
 };
 };
 return false;
 };

 public get_enum_cases(self, def_id DefId) Option[List[EnumCaseInfo]] = {
 return self.def_id_map.get_enum_cases(def_id);
 };

 public get_enum_cases_by_raw_id(self, raw_id UInt) Option[List[EnumCaseInfo]] = {
 return self.def_id_map.get_enum_cases(DefId(raw_id));
 };

 public enum_case_tag_index_by_raw_id(self, raw_id UInt, case_name String) UInt = {
 let zero UInt = 0;
 for entry in self.def_id_map.enum_cases.iterator() then {
 if entry.first == raw_id then {
 let cases = entry.second;
 let mutable idx UInt = 0;
 for case_info in cases then {
 if case_info.name == case_name or case_info.name.ends_with(".\(case_name)") then {
 return idx;
 };
 idx += 1(UInt);
 };
 return zero;
 };
 };
 return zero;
 };

 public enum_case_param_specs_by_raw_id(self, raw_id UInt, case_name String) List[FunctionParamSpec] = {
 for entry in self.def_id_map.enum_cases.iterator() then {
 if entry.first == raw_id then {
 let cases = entry.second;
 let mutable specs = List[FunctionParamSpec].new();
 for case_info in cases then {
 if case_info.name == case_name or case_info.name.ends_with(".\(case_name)") then {
 for param in case_info.params then {
 let default_key = "\(case_name).\(param.name)";
 let has_def = self.parsed_default_values.contains_key(default_key) or self.parsed_default_values.contains_key(param.name);
 specs.push(FunctionParamSpec(param.name, false, param.named, has_def));
 };
 };
 };
 return specs;
 };
 };
 return List[FunctionParamSpec].new();
 };

 public enum_case_params_by_raw_id(self, raw_id UInt, case_name String) List[EnumCaseParam] = {
 for entry in self.def_id_map.enum_cases.iterator() then {
 if entry.first == raw_id then {
 let cases = entry.second;
 for case_info in cases then {
 if case_info.name == case_name or case_info.name.ends_with(".\(case_name)") then {
 return case_info.params;
 };
 };
 return List[EnumCaseParam].new();
 };
 };
 return List[EnumCaseParam].new();
 };

 public enum_case_params_by_template_name(self, template_name String, case_name String) List[EnumCaseParam] = {
 for entry in self.def_id_map.enum_template_names.iterator() then {
 if entry.second == template_name then {
 return self.enum_case_params_by_raw_id(entry.first, case_name);
 };
 };
 return List[EnumCaseParam].new();
 };

 public enum_has_case_by_raw_id(self, raw_id UInt, case_name String) Bool = {
 for entry in self.def_id_map.enum_cases.iterator() then {
 if entry.first == raw_id then {
 let cases = entry.second;
 for case_info in cases then {
 if case_info.name == case_name or case_info.name.ends_with(".\(case_name)") then {
 return true;
 };
 };
 return false;
 };
 };
 return false;
 };

 public is_foreign_struct(self, def_id DefId) Bool = {
 return self.def_id_map.is_foreign_struct(def_id);
 };

 public get_foreign_struct_fields(self, def_id DefId) Option[List[StructField]] = {
 return self.def_id_map.get_foreign_struct_fields(def_id);
 };

 public get_param_specs(self, def_id DefId) Option[List[FunctionParamSpec]] = {
 return self.def_id_map.get_param_specs(def_id);
 };

 public get_function_type(self, def_id DefId) Option[Type] = {
 return when self.get_symbol_type(def_id) in {
 .Some(symbol_type) then when symbol_type in {
 .FunctionType(_, _) then Option[Type].Some(symbol_type),
 _ then Option[Type].None(),
 },
 .None() then Option[Type].None(),
 };
 };

 public get_function_return_type(self, def_id DefId) Option[Type] = {
 return when self.get_function_type(def_id) in {
 .Some(function_type) then when function_type in {
 .FunctionType(_, return_type_ref) then Option[Type].Some(return_type_ref),
 _ then Option[Type].None(),
 },
 .None() then Option[Type].None(),
 };
 };

 public get_function_param_type(self, def_id DefId, arg_index UInt) Option[Type] = {
 return when self.get_function_type(def_id) in {
 .Some(function_type) then when function_type in {
 .FunctionType(params, _) then {
 yield if arg_index < params.count() then Option[Type].Some(params[arg_index].param_type) else Option[Type].None();
 },
 _ then Option[Type].None(),
 },
 .None() then Option[Type].None(),
 };
 };

 public signature_param_type(self, def_id DefId, arg_index UInt) Option[Type] = {
 return self.get_function_param_type(def_id, arg_index);
 };

 public signature_param_type_or_unknown(self, def_id DefId, arg_index UInt) Type = {
 return self.get_function_param_type(def_id, arg_index) or else Type.Unknown();
 };

 public get_original_def_id(self, def_id DefId) Option[DefId] = {
 return self.def_id_map.get_original_def_id(def_id);
 };

 public record_original_def_id(self, def_id DefId, original_def_id DefId) Void = {
 self.def_id_map.record_import(def_id, original_def_id, List[String].new());
 };

 public lookup_type(self, def_id DefId) Option[Type] = {
 return self.def_id_map.lookup_type(def_id);
 };

 public is_not_deref(self, def_id DefId) Bool = {
 return self.def_id_map.is_not_deref(def_id);
 };

 public type_display_name(self, t Type) String = {
 return self.def_id_map.type_display_name(t);
 };

 public has_explicit_drop(self, def_id DefId) Bool = {
 if self.def_id_map.has_explicit_drop(def_id) then {
 return true;
 };
 let template_def_id = self.get_template_def_id(def_id);
 return template_def_id.is_valid() and self.def_id_map.has_explicit_drop(template_def_id);
 };

 public set_explicit_drop(self, def_id DefId) Void = {
 self.def_id_map.set_explicit_drop(def_id);
 };

 public nominal_layout_kind(self, def_id DefId) NominalLayoutKind = {
 return if self.requires_managed_nominal_layout_def(def_id) then NominalLayoutKind.Managed() else NominalLayoutKind.Value();
 };

 public nominal_layout_kind_for_type(self, t Type) NominalLayoutKind = {
 let result = if self.requires_managed_nominal_layout_type(t) then NominalLayoutKind.Managed() else NominalLayoutKind.Value();
 return result;
 };

 file_private requires_managed_nominal_layout_type(self, t Type) Bool = {
 return when t in {
 .StructureType(def_id) then self.requires_managed_nominal_layout_def(def_id),
 .EnumType(def_id) then self.requires_managed_nominal_layout_def(def_id),
 .OpaqueType(def_id) then self.requires_managed_nominal_layout_def(def_id),
 .GenericStruct(template, template_def_id, _) then {
 let resolved_template_def_id = if template_def_id.is_valid() then template_def_id else self.def_id_map.lookup_generic_struct_template_def_id(template) or else def_id_invalid();
 if resolved_template_def_id.is_valid() and (self.is_struct_mutable(resolved_template_def_id) or self.has_explicit_drop(resolved_template_def_id)) then {
 return true;
 };
 yield when self.lookup_generic_layout_def_id(t) in {
 .Some(def_id) then self.requires_managed_nominal_layout_def(def_id),
 .None() then false,
 };
 },
 .GenericEnum(template, template_def_id, _) then {
 let resolved_template_def_id = if template_def_id.is_valid() then template_def_id else self.def_id_map.lookup_generic_enum_template_def_id(template) or else def_id_invalid();
 if resolved_template_def_id.is_valid() and self.has_explicit_drop(resolved_template_def_id) then {
 return true;
 };
 yield when self.lookup_generic_layout_def_id(t) in {
 .Some(def_id) then self.requires_managed_nominal_layout_def(def_id),
 .None() then false,
 };
 },
 _ then false,
 };
 };

 file_private requires_managed_nominal_layout_def(self, def_id DefId) Bool = {
 if self.is_struct_mutable(def_id) or self.has_explicit_drop(def_id) then {
 return true;
 };
 let mutable path = Set[UInt].new();
 path.insert(def_id.id);
 let cycle = self.contains_nominal_value_cycle(def_id, def_id, path);
 return cycle;
 };

 file_private contains_nominal_value_cycle(self, current DefId, target DefId, mutable path Set[UInt]) Bool = {
 let dependencies = self.direct_nominal_value_dependencies_of_def(current);
 for dependency in dependencies then {
 if dependency.id == target.id then {
 return true;
 };
 if path.contains(dependency.id) then {
 continue;
 };
 path.insert(dependency.id);
 if self.contains_nominal_value_cycle(dependency, target, path) then {
 return true;
 };
 path.remove(dependency.id);
 };
 return false;
 };

 file_private direct_nominal_value_dependencies_of_def(self, def_id DefId) List[DefId] = {
 if self.is_struct_mutable(def_id) or self.has_explicit_drop(def_id) then {
 return List[DefId].new();
 };

 let mutable result = List[DefId].new();
 if self.def_id_map.get_struct_fields(def_id) is .Some(fields) then {
 for field in fields then {
 let dependencies = self.direct_nominal_value_dependencies_in_type(field.field_type);
 for dependency in dependencies then { result.push(dependency); };
 };
 return result;
 };

 if self.def_id_map.get_enum_cases(def_id) is .Some(cases) then {
 for case_info in cases then {
 for param in case_info.params then {
 let dependencies = self.direct_nominal_value_dependencies_in_type(param.param_type);
 for dependency in dependencies then { result.push(dependency); };
 };
 };
 };
 return result;
 };

 file_private lookup_generic_layout_def_id(self, t Type) Option[DefId] = {
 let direct_layout_name = self.get_layout_key(t);
 if self.lookup_def_id(List[String].new(), direct_layout_name, Option[String].None()) is .Some(def_id) then {
 return Option[DefId].Some(def_id);
 };

 return when t in {
 .GenericStruct(template, template_def_id, args) then {
 let resolved_template_def_id = if template_def_id.is_valid() then template_def_id else self.def_id_map.lookup_generic_struct_template_def_id(template) or else def_id_invalid();
 if args.is_empty() and resolved_template_def_id.is_valid() and not self.is_generic_instantiation(resolved_template_def_id) then {
 return Option[DefId].Some(resolved_template_def_id);
 };
 let resolved_type = Type.GenericStruct(template, resolved_template_def_id, args);
 let layout_name = self.get_layout_key(resolved_type);
 yield self.lookup_def_id(List[String].new(), layout_name, Option[String].None());
 },
 .GenericEnum(template, template_def_id, args) then {
 let resolved_template_def_id = if template_def_id.is_valid() then template_def_id else self.def_id_map.lookup_generic_enum_template_def_id(template) or else def_id_invalid();
 if args.is_empty() and resolved_template_def_id.is_valid() and not self.is_generic_instantiation(resolved_template_def_id) then {
 return Option[DefId].Some(resolved_template_def_id);
 };
 let resolved_type = Type.GenericEnum(template, resolved_template_def_id, args);
 let layout_name = self.get_layout_key(resolved_type);
 yield self.lookup_def_id(List[String].new(), layout_name, Option[String].None());
 },
 _ then Option[DefId].None(),
 };
 };

 file_private direct_nominal_value_dependencies_in_type(self, t Type) List[DefId] = {
 let mutable result = List[DefId].new();
 when t in {
 .StructureType(def_id) then {
 if not self.is_struct_mutable(def_id) and not self.has_explicit_drop(def_id) then {
 result.push(def_id);
 };
 },
 .EnumType(def_id) then {
 if not self.is_struct_mutable(def_id) and not self.has_explicit_drop(def_id) then {
 result.push(def_id);
 };
 },
 .OpaqueType(def_id) then {
 if not self.is_struct_mutable(def_id) and not self.has_explicit_drop(def_id) then {
 result.push(def_id);
 };
 },
 .GenericStruct(template, template_def_id, type_args) then {
 let resolved_template_def_id = if template_def_id.is_valid() then template_def_id else self.def_id_map.lookup_generic_struct_template_def_id(template) or else def_id_invalid();
 if resolved_template_def_id.is_valid() and (self.is_struct_mutable(resolved_template_def_id) or self.has_explicit_drop(resolved_template_def_id)) then {
 return result;
 };
 when self.lookup_generic_layout_def_id(t) in {
 .Some(def_id) then {
 if not self.is_struct_mutable(def_id) and not self.has_explicit_drop(def_id) then {
 result.push(def_id);
 };
 },
 .None() then {
 for arg in type_args then {
 let dependencies = self.direct_nominal_value_dependencies_in_type(arg);
 for dependency in dependencies then { result.push(dependency); };
 };
 },
 };
 },
 .GenericEnum(template, template_def_id, type_args) then {
 let resolved_template_def_id = if template_def_id.is_valid() then template_def_id else self.def_id_map.lookup_generic_enum_template_def_id(template) or else def_id_invalid();
 if resolved_template_def_id.is_valid() and self.has_explicit_drop(resolved_template_def_id) then {
 return result;
 };
 when self.lookup_generic_layout_def_id(t) in {
 .Some(def_id) then {
 if not self.is_struct_mutable(def_id) and not self.has_explicit_drop(def_id) then {
 result.push(def_id);
 };
 },
 .None() then {
 for arg in type_args then {
 let dependencies = self.direct_nominal_value_dependencies_in_type(arg);
 for dependency in dependencies then { result.push(dependency); };
 };
 },
 };
 },
 .GenericParameter(_) then {},
 _ then {},
 };
 return result;
 };

 public get_cname(self, def_id DefId) Option[String] = {
 return self.def_id_map.get_cname(def_id);
 };

 public set_cname(self, def_id DefId, cname String) Void = {
 self.def_id_map.set_cname(def_id, cname);
 };

 public next_def_id(self) UInt = {
 return self.def_id_map.next_id;
 };

 public get_names(self) Dict[UInt, String] = {
 return self.def_id_map.names;
 };

 public is_generic_instantiation(self, def_id DefId) Bool = {
 return when self.def_id_map.get_generic_instantiation(def_id) in {
 .Some(v) then v,
 .None() then false,
 };
 };

 public get_type_arguments(self, def_id DefId) Option[List[Type]] = {
 when self.def_id_map.get_type_arguments(def_id) in {
 .Some(args) then { return Option[List[Type]].Some(args);},
 .None() then {},
 };
 return when self.def_id_map.lookup_type(def_id) in {
 .Some(mapped) then when mapped in {
 .GenericStruct(_, _, args) then {
 let mutable unpacked = List[Type].new();
 for arg in args then {
 unpacked.push(arg);
 };
 yield Option[List[Type]].Some(unpacked);
 },
 .GenericEnum(_, _, args) then {
 let mutable unpacked = List[Type].new();
 for arg in args then {
 unpacked.push(arg);
 };
 yield Option[List[Type]].Some(unpacked);
 },
 _ then Option[List[Type]].None(),
 },
 .None() then Option[List[Type]].None(),
 };
 };

 public get_template_name(self, def_id DefId) Option[String] = {
 when self.def_id_map.get_template_name(def_id) in {
 .Some(name) then { return Option[String].Some(name);},
 .None() then {},
 };
 return when self.def_id_map.lookup_type(def_id) in {
 .Some(mapped) then when mapped in {
 .GenericStruct(template, _, _) then Option[String].Some(template),
 .GenericEnum(template, _, _) then Option[String].Some(template),
 _ then Option[String].None(),
 },
 .None() then Option[String].None(),
 };
 };

 public get_template_def_id(self, def_id DefId) DefId = {
 return self.def_id_map.get_template_def_id(def_id);
 };

