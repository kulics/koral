public type SourceManager(
    file_path String,
    source String,
);

given SourceManager {
    public new(file_path String, source String) SourceManager = {
        return SourceManager(file_path, source);
    };

    file_private is_crlf_at(self, runes List[Rune], index UInt) Bool = {
        if index + 1 >= runes.count() then {
            return false;
        };
        return runes[index] == '\r' and runes[index + 1] == '\n';
    };

    public get_line(self, line_number UInt) Option[String] = {
        if line_number == 0 then {
            return Option[String].None();
        };

        let runes = self.source.to_runes();
        let mutable current_line UInt = 1;
        let mutable i UInt = 0;
        let mutable buffer = StringBuilder.new();

        while i < runes.count() then {
            let ch = runes[i];
            if ch.is_newline() then {
                if current_line == line_number then {
                    return Option[String].Some(buffer.to_string());
                };
                if self.is_crlf_at(runes, i) then {
                    i += 1;
                };
                current_line += 1;
                buffer = StringBuilder.new();
            } else {
                buffer.push_rune(ch);
            };
            i += 1;
        };

        if current_line == line_number then {
            return Option[String].Some(buffer.to_string());
        };

        return Option[String].None();
    };
};
