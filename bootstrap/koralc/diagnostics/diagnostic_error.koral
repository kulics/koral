public type DiagnosticStage {
    Lexer(),
    Parser(),
    Semantic(),
    Other(),
};

public type DiagnosticError(
    stage DiagnosticStage,
    file_path String,
    message String,
    span Option[SourceSpan],
);

file_private let diagnostic_stage_text(stage DiagnosticStage) String = {
    return when stage in {
        .Lexer() then "lexer error",
        .Parser() then "syntax error",
        .Semantic() then "error",
        .Other() then "error",
    };
};

file_private let normalized_diagnostic_message(stage DiagnosticStage, file_path String, rendered String) String = {
    let mutable stage_prefix = StringBuilder.new();
    stage_prefix.push_string(diagnostic_stage_text(stage));
    stage_prefix.push_string(": ");
    if rendered.starts_with(stage_prefix.to_string()) then {
        return rendered.substring(stage_prefix.count()..);
    };

    if not file_path.is_empty() and rendered.starts_with(file_path) then {
        let remainder = rendered.substring(file_path.count()..);
        if remainder.starts_with(": ") then {
            let candidate = remainder.substring(2..);
            if candidate.starts_with(stage_prefix.to_string()) then {
                return candidate.substring(stage_prefix.count()..);
            };
        };

        let mutable location_stage_needle = StringBuilder.new();
        location_stage_needle.push_string(": ");
        location_stage_needle.push_string(diagnostic_stage_text(stage));
        location_stage_needle.push_string(": ");
        when remainder.find(location_stage_needle.to_string()) in {
            .Some(idx) then {
                return remainder.substring(idx + location_stage_needle.to_string().count()..);
            },
            .None() then {},
        };
    };

    return rendered;
};

given DiagnosticError as Error {
    public message(self) String = {
        let mutable location = StringBuilder.new();
        location.push_string(self.file_path);
        when self.span in {
            .Some(span) then if is_known_span(span) then {
                if location.is_empty() then {
                    location = StringBuilder.new();
                    location.push_string(span.start.line.to_string());
                } else {
                    location.push_byte(':');
                    location.push_string(span.start.line.to_string());
                };
                location.push_byte(':');
                location.push_string(span.start.column.to_string());
            },
            .None() then {},
        };

        let mutable out = StringBuilder.new();
        if location.is_empty() then {
            out.push_string(diagnostic_stage_text(self.stage));
        } else {
            out.push_string(location.to_string());
        };
        if location.is_empty() then {
            out.push_string(": ");
        } else {
            out.push_string(": ");
            out.push_string(diagnostic_stage_text(self.stage));
            out.push_string(": ");
        };
        out.push_string(self.message);
        return out.to_string();
    };
};

/// Build a diagnostic. The span is an INPUT: the source location of the
/// construct the diagnostic is about, supplied by the site that reports it.
///
/// It is deliberately never recovered from the message text. A site with no
/// location available passes `unknown_span()` and the diagnostic prints without
/// one -- honest, and strictly better than pointing at wherever the message
/// happened to spell out a pair of numbers.
public let make_diagnostic(stage DiagnosticStage, file_path String, message String, span SourceSpan) DiagnosticError = {
    return DiagnosticError(stage, file_path, message, if is_known_span(span) then Option[SourceSpan].Some(span) else Option[SourceSpan].None());
};

public let wrap_error_as_diagnostic(stage DiagnosticStage, file_path String, error Error, span SourceSpan) DiagnosticError = {
    let rendered = error.message();
    let message = normalized_diagnostic_message(stage, file_path, rendered);
    return DiagnosticError(stage, file_path, message, if is_known_span(span) then Option[SourceSpan].Some(span) else Option[SourceSpan].None());
};
