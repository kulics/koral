public type DiagnosticStage {
    Lexer(),
    Parser(),
    Semantic(),
    Other(),
};

public type DiagnosticError(
    stage DiagnosticStage,
    file_path String,
    message String,
    span Option[SourceSpan],
);

file_private let diagnostic_stage_text(stage DiagnosticStage) String = {
    return when stage in {
        .Lexer() then "lexer error",
        .Parser() then "syntax error",
        .Semantic() then "error",
        .Other() then "error",
    };
};

file_private let normalized_diagnostic_message(stage DiagnosticStage, file_path String, rendered String) String = {
    let mutable stage_prefix = diagnostic_stage_text(stage);
    stage_prefix.push_string(": ");
    if rendered.starts_with(stage_prefix) then {
        return rendered.substring(stage_prefix.count()..);
    };

    if not file_path.is_empty() and rendered.starts_with(file_path) then {
        let remainder = rendered.substring(file_path.count()..);
        if remainder.starts_with(": ") then {
            let candidate = remainder.substring(2..);
            if candidate.starts_with(stage_prefix) then {
                return candidate.substring(stage_prefix.count()..);
            };
        };

        let mutable location_stage_needle = ": ";
        location_stage_needle.push_string(diagnostic_stage_text(stage));
        location_stage_needle.push_string(": ");
        when remainder.find(location_stage_needle) in {
            .Some(idx) then {
                return remainder.substring(idx + location_stage_needle.count()..);
            },
            .None() then {},
        };
    };

    return rendered;
};

given DiagnosticError as Error {
    public message(*self) String = {
        let mutable location = self.file_path;
        when self.span in {
            .Some(span) then if is_known_span(span) then {
                if location.is_empty() then {
                    location = span.start.line.to_string();
                } else {
                    location.push_byte(':');
                    location.push_string(span.start.line.to_string());
                };
                location.push_byte(':');
                location.push_string(span.start.column.to_string());
            },
            .None() then {},
        };

        let mutable out = if location.is_empty() then diagnostic_stage_text(self.stage) else location;
        if location.is_empty() then {
            out.push_string(": ");
        } else {
            out.push_string(": ");
            out.push_string(diagnostic_stage_text(self.stage));
            out.push_string(": ");
        };
        out.push_string(self.message);
        return out;
    };
};

file_private type UIntParseResult(
    value UInt,
    next_index UInt,
    ok Bool,
);

file_private let digit_value(ch Rune) Option[UInt] = {
    if ch == '0' then { return Option[UInt].Some(0);};
    if ch == '1' then { return Option[UInt].Some(1);};
    if ch == '2' then { return Option[UInt].Some(2);};
    if ch == '3' then { return Option[UInt].Some(3);};
    if ch == '4' then { return Option[UInt].Some(4);};
    if ch == '5' then { return Option[UInt].Some(5);};
    if ch == '6' then { return Option[UInt].Some(6);};
    if ch == '7' then { return Option[UInt].Some(7);};
    if ch == '8' then { return Option[UInt].Some(8);};
    if ch == '9' then { return Option[UInt].Some(9);};
    return Option[UInt].None();
};

file_private let parse_uint_at(runes List[Rune], start UInt) UIntParseResult = {
    let mutable i = start;
    let mutable value UInt = 0;
    let mutable ok = false;

    while i < runes.count() then {
        let digit = digit_value(runes[i]);
        when digit in {
            .Some(d) then {
                ok = true;
                value = value * 10 + d;
                i += 1;
            },
            .None() then {
                break;
            },
        };
    };

    return UIntParseResult(value, i, ok);
};

file_private let find_first_line_col(message String) Option[SourceSpan] = {
    let runes = message.to_runes();
    let mutable i UInt = 0;

    while i < runes.count() then {
        let left = parse_uint_at(runes, i);
        if left.ok then {
            if left.next_index < runes.count() and runes[left.next_index] == ':' then {
                let right = parse_uint_at(runes, left.next_index + 1);
                if right.ok then {
                    let loc = SourceLocation(left.value, right.value);
                    return Option[SourceSpan].Some(SourceSpan(loc, loc));
                };
            };
            i = left.next_index;
        } else {
            i += 1;
        };
    };

    return Option[SourceSpan].None();
};

public let make_diagnostic(stage DiagnosticStage, file_path String, message String) DiagnosticError = {
    return DiagnosticError(stage, file_path, message, find_first_line_col(message));
};

public let make_diagnostic_at(stage DiagnosticStage, file_path String, message String, span SourceSpan) DiagnosticError = {
    let diagnostic_span = if is_known_span(span) then Option[SourceSpan].Some(span) else find_first_line_col(message);
    return DiagnosticError(stage, file_path, message, diagnostic_span);
};

public let wrap_error_as_diagnostic(stage DiagnosticStage, file_path String, error * Error) DiagnosticError = {
    let rendered = error.message();
    let message = normalized_diagnostic_message(stage, file_path, rendered);
    let span = when find_first_line_col(rendered) in {
        .Some(found) then Option[SourceSpan].Some(found),
        .None() then find_first_line_col(message),
    };
    return DiagnosticError(stage, file_path, message, span);
};
