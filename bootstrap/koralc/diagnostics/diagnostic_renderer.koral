public type DiagnosticRenderer(
    source_manager Option[SourceManager],
)

given DiagnosticRenderer {
    public new(source_manager Option[SourceManager]) DiagnosticRenderer = {
        return DiagnosticRenderer(source_manager)
    }

    private stage_text(self, stage DiagnosticStage) String = {
        return when stage in {
            .Lexer() then "lexer error",
            .Parser() then "syntax error",
            .Semantic() then "error",
            .Other() then "error",
        }
    }

    private spaces(self, count UInt) String = {
        let mutable out = String.new()
        let mutable i UInt = 0
        while i < count then {
            out.push_byte(' ')
            i += 1
        }
        return out
    }

    private marker(self, width UInt) String = {
        if width <= 1 then {
            return "^"
        }

        let mutable out = String.new()
        out.push_byte('^')
        let mutable i UInt = 1
        while i < width then {
            out.push_byte('~')
            i += 1
        }
        return out
    }

    public render(self, diag DiagnosticError) String = {
        let mutable out = String.new()

        let mutable location = diag.file_path
        let mutable line_number UInt = 0
        let mutable column_number UInt = 0
        if diag.span is .Some(span) and is_known_span(span) then {
            line_number = span.start.line
            column_number = span.start.column
            let mutable location_text = diag.file_path
            location_text.push_byte(':')
            location_text.push_string(line_number.to_string())
            location_text.push_byte(':')
            location_text.push_string(column_number.to_string())
            location = location_text
        }

        out.push_string(location)
        out.push_string(": ")
        out.push_string(self.stage_text(diag.stage))
        out.push_string(": ")
        out.push_string(diag.message)

        if self.source_manager is .Some(sm) and line_number > 0 then {
            when sm.get_line(line_number) in {
                .Some(source_line) then {
                    let line_str = line_number.to_string()
                    let gutter = line_str.count() + 1
                    out.push_byte('\n')
                    out.push_string(self.spaces(gutter))
                    out.push_string(" |")
                    out.push_byte('\n')
                    out.push_byte(' ')
                    out.push_string(line_str)
                    out.push_string(" | ")
                    out.push_string(source_line)
                    out.push_byte('\n')
                    out.push_string(self.spaces(gutter))
                    out.push_string(" | ")
                    let pointer_padding = if column_number > 0 then column_number - 1 else 0
                    out.push_string(self.spaces(pointer_padding))
                    out.push_string(self.marker(1))
                },
                .None() then {},
            }
        }

        return out
    }
}
