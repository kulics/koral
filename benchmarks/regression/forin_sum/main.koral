using "std/time" { MonoTime };
// for-in 求和（slice 战役 P4 门槛：零回归）——for-in 不上锁不检查，这里只测
// 游标 + 保留形循环变量的读流量。
let main(): Int = {
    let n = 5_000_000;
    let mutable xs = List[Int].with_capacity(n);
    for i in 0..<n then {
        xs.push(i);
    };
    let start = MonoTime.now();
    let mutable sum = 0;
    for v in xs then {
        sum += v;
    };
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(sum) \(elapsed)");
    return 0;
};
