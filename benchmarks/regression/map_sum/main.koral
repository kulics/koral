using "std/time" { MonoTime };
// 带体 map + 求和（slice 战役 P4 门槛：≤ 1.03×）——map 全程包锁 + 回调实参
// 保留形的税基。
let main(): Int = {
    let n = 5_000_000;
    let mutable xs = List[Int].with_capacity(n);
    for i in 0..<n then {
        xs.push(i);
    };
    let start = MonoTime.now();
    let ys = xs.map((v) => v + 1);
    let mutable sum = 0;
    for v in ys then {
        sum += v;
    };
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(sum) \(elapsed)");
    return 0;
};
