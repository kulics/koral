// 小列表足迹（slice 战役 P4 门槛：10⁶ 个 cap-8 列表，RSS 差按账面 +16～32MB
// 验收）——块化后的账面：块头 24B + 8×8 元素区 = 88B/块 + 列表句柄；基线是
// 分配式 {data, len, cap} 三字 + 元素缓冲。跑完打印 RESULT 后停 0（RSS 由
// 外部量具在进程峰值读取）。
let main(): Int = {
    let outer = List[List[Int]].new();
    let mutable i = 0;
    while i < 1_000_000 then {
        let inner = List[Int].with_capacity(8);
        inner.push(i);
        outer.push(inner);
        i += 1;
    };
    println("RESULT \(outer.count()) 0");
    return 0;
};
