using "std/time" { MonoTime };
// 下标遍历对照（slice 战役 P4 门槛：`s[i]` 遍历 vs `xs[i]` ≤ 1.03×，同构建内
// 比）：同一份数据分别经 List 下标与切片下标求和，RESULT 行输出
// `<sum_list> <ns_list>` 与 `<sum_slice> <ns_slice>` 两行。
let main(): Int = {
    let n = 5_000_000;
    let mutable xs = List[Int].with_capacity(n);
    for i in 0..<n then {
        xs.push(i);
    };

    let start1 = MonoTime.now();
    let mutable sum1 = 0;
    let mutable i = 0;
    while i < n then {
        sum1 += xs[i];
        i += 1;
    };
    let t1 = start1.elapsed().as_nanoseconds();
    println("RESULT \(sum1) \(t1)");

    let s = xs.into_slice();
    let start2 = MonoTime.now();
    let mutable sum2 = 0;
    let mutable j = 0;
    while j < n then {
        sum2 += s[j];
        j += 1;
    };
    let t2 = start2.elapsed().as_nanoseconds();
    println("RESULT \(sum2) \(t2)");
    return 0;
};
