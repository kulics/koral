using "std/time" { MonoTime };
// 纯 push（slice 战役 P4 门槛：≤ 1.05×，查锁一跳的税基）：预留容量后 push N
// 次——只测修改入口的锁检查与存入，不掺增长。
let main(): Int = {
    let n = 5_000_000;
    let start = MonoTime.now();
    let mutable xs = List[Int].with_capacity(n);
    for i in 0..<n then {
        xs.push(i);
    };
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(xs.count()) \(elapsed)");
    return 0;
};
