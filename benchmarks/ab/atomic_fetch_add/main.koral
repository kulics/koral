using "std/async" { ... };
using "std/sync" { AtomicInt };
using "std/time" { MonoTime };

// 8 threads hammer one shared AtomicInt with fetch_add: contended atomic RMW
// throughput. Identical workload in koral/go/swift/rust. This is an A/B
// instrument, NOT a cross-language comparison row (see ../../ab/README.md):
// at 8 threads every language sits at the hardware floor and a single-line
// contended seq_cst RMW trails an adaptive mutex on a tiny critical section
// even in bare C (measured 2.05x on this machine) -- the row does not race
// lock_counter. What it pins: a fetch_add must cost ONE atomic RMW per op,
// no refcount traffic (the borrowed-receiver rule 5a carve-out in
// codegen_borrowed_self.koral keeps AtomicInt's methods off the
// retain/release path; the deterministic pins are w12_atomic_* in
// tests/runtime-cases/rc_counter_pin.koral and the atomic shape pin in
// scripts/verify.sh).
let main(): Int = {
    let threads_n = 8;
    let per_thread = 1_000_000;
    let counter = AtomicInt.new(0);
    let start = MonoTime.now();
    let mutable handles = List[Thread].new();
    let mutable t = 0;
    while t < threads_n then {
        let c = counter;
        handles.push(
            run_task(() => {
                let mutable i = 0;
                while i < per_thread then {
                    c.fetch_add(1);
                    i = i + 1;
                };
            }),
        );
        t = t + 1;
    };
    let mutable k = 0;
    while k < handles.count() then {
        let _ = handles[k].wait();
        k = k + 1;
    };
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(counter.load()) \(elapsed)");
    return 0;
};
