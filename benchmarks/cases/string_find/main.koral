using "std/time" { MonoTime };

// Build an 8MB string, then count pattern occurrences (scan throughput).
let main(): Int = {
    let start = MonoTime.now();
    let mutable b = StringBuilder.with_capacity(8_000_000);
    for _ in 0..<1_000_000 then {
        b.push_string("abcdefgh");
    };
    let s = b.into_string();
    let mutable hits = 0;
    let mutable off = 0;
    while s.find_from(off, "abc") is .Some(p) then {
        hits += 1;
        off = p + 1;
    };
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(hits) \(elapsed)");
    return 0;
};
