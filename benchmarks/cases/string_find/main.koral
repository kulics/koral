using "std/time" { MonoTime };

// Build an 8MB string, then count pattern occurrences (scan throughput).
let main(): Int = {
    let start = MonoTime.now();
    let mutable b = StringBuilder.with_capacity(1024);
    let mutable i = UInt(0);
    while i < UInt(1_000_000) then {
        b.push_string("abcdefgh");
        i += UInt(1);
    };
    let s = b.to_string();
    let mutable hits = UInt(0);
    let mutable off = UInt(0);
    let mutable searching = true;
    while searching then {
        when s.find_from(off, "abc") in {
            .Some(p) then {
                hits += UInt(1);
                off = p + UInt(1);
            },
            .None() then {
                searching = false;
            },
        };
    };
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(hits) \(elapsed)");
    return 0;
};
