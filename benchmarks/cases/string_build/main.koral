using "std/time" { MonoTime };

// Repeated small-string building: StringBuilder append throughput.
let main(): Int = {
    let n = 300_000;
    let start = MonoTime.now();
    let mutable b = StringBuilder.with_capacity(16);
    for i in 0..<n then {
        b.push_string("abc");
        b.push_string(i.to_string());
    };
    let s = b.into_string();
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(s.count()) \(elapsed)");
    return 0;
};
