using "std/time" { MonoTime };

// Comparison sort of 1M pseudo-random ints (same LCG everywhere).
let main(): Int = {
    let n = UInt(1_000_000);
    let start = MonoTime.now();
    let mutable xs = List[Int].with_capacity(n);
    let mutable state: Int64 = 42;
    let mutable i = UInt(0);
    while i < n then {
        state = (state * Int64(1103515245) + Int64(12345)) % Int64(2147483648);
        xs.push(Int(state % Int64(2147483647)));
        i += UInt(1);
    };
    xs.sort();
    let elapsed = start.elapsed().as_nanoseconds();

    // Verify the result really is sorted, then checksum it in order so a
    // wrong or partial sort changes the RESULT line.
    let mutable checksum = 0;
    let mutable prev = 0;
    i = UInt(0);
    while i < n then {
        let v = xs[i];
        assert(v >= prev, "sort_ints: output must be sorted");
        checksum = (checksum * 131 + v) % 2147483648;
        prev = v;
        i += UInt(1);
    };
    println("RESULT \(checksum) \(elapsed)");
    return 0;
};
