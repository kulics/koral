using "std/time" { MonoTime };

// Iterating a list of small records: data layout and field access.
type Pair(a: Int64, b: Int64);

let main(): Int = {
    let n = UInt(5_000_000);
    let start = MonoTime.now();
    let mutable xs = List[Pair].with_capacity(n);
    let mutable i = UInt(0);
    while i < n then {
        xs.push(Pair(Int64(i), Int64(i % UInt(7))));
        i += UInt(1);
    };
    let mutable sum: Int64 = 0;
    let mutable j = UInt(0);
    while j < xs.count() then {
        let p = xs[j];
        sum += p.a * p.b;
        j += UInt(1);
    };
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(sum) \(elapsed)");
    return 0;
};
