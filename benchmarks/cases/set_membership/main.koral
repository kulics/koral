using "std/time" { MonoTime };

// Hash-set insert and contains throughput on Int keys.
let main(): Int = {
    let n = 500_000;
    let start = MonoTime.now();
    let mutable s = Set[Int].with_capacity(n);
    for i in 0..<n then {
        s.insert(Int(i));
    };
    let mutable hits = 0;
    for i in 0..<(n * 2) then {
        if s.contains(Int(i % n)) then {
            hits += 1;
        };
    };
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(hits) \(elapsed)");
    return 0;
};
