using "std/time" { MonoTime };

// Hash-map insert then lookup throughput on String keys.
let main(): Int = {
    let n = UInt(500_000);
    let start = MonoTime.now();
    let mutable d = Dict[String, Int].with_capacity(n);
    let mutable i = UInt(0);
    while i < n then {
        d.insert("k" + i.to_string(), Int(i));
        i += UInt(1);
    };
    let mutable sum = 0;
    i = UInt(0);
    while i < n then {
        sum += d.get("k" + i.to_string()) or else 0;
        i += UInt(1);
    };
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(sum) \(elapsed)");
    return 0;
};
