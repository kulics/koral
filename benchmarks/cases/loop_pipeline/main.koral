using "std/time" { MonoTime };

// Integer loop throughput with a branch and a multiply.
let main(): Int = {
    let n: Int64 = 3_500_000;
    let start = MonoTime.now();
    let mutable sum: Int64 = 0;
    for i in 0..<n then {
        if i % Int64(3) == Int64(0) then {
            sum += i * i;
        };
    };
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(sum) \(elapsed)");
    return 0;
};
