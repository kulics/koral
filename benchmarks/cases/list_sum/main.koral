using "std/time" { MonoTime };
// Build a List[Int] of N sequential values and sum it: container growth and
// iteration throughput. Identical workload in koral/go/swift/rust.
let main(): Int = {
    let n = 5_000_000;
    let start = MonoTime.now();
    let mutable list = List[Int].with_capacity(n);
    for i in 0..<n then {
        list.push(Int(i));
    };
    let mutable sum = 0;
    for v in list then {
        sum += v;
    };
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(sum) \(elapsed)");
    return 0;
};
