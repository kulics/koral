using "std/time" { MonoTime };

// Call-overhead baseline: naive recursive fib.
let fib(n: Int): Int = if n < 2 then n else fib(n - 1) + fib(n - 2);

let main(): Int = {
    let start = MonoTime.now();
    let v = fib(27);
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(v) \(elapsed)");
    return 0;
};
