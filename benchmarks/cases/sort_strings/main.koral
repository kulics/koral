using "std/time" { MonoTime };

// Sort 200k random strings: comparison sort with string keys.
let main(): Int = {
    let n = UInt(200_000);
    let start = MonoTime.now();
    let mutable xs = List[String].new();
    let mutable state: Int64 = 7;
    let mutable i = UInt(0);
    while i < n then {
        state = (state * Int64(1103515245) + Int64(12345)) % Int64(2147483648);
        xs.push("s" + (state % Int64(2147483647)).to_string());
        i += UInt(1);
    };
    xs.sort();
    let elapsed = start.elapsed().as_nanoseconds();
    println("RESULT \(xs.count()) \(elapsed)");
    return 0;
};
