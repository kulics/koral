using "std/time" { MonoTime };

// Sort 200k random strings: comparison sort with string keys.
let main(): Int = {
    let n = UInt(200_000);
    let start = MonoTime.now();
    let mutable xs = List[String].with_capacity(n);
    let mutable state: Int64 = 7;
    let mutable i = UInt(0);
    while i < n then {
        state = (state * Int64(1103515245) + Int64(12345)) % Int64(2147483648);
        xs.push("s" + (state % Int64(2147483647)).to_string());
        i += UInt(1);
    };
    xs.sort();
    let elapsed = start.elapsed().as_nanoseconds();

    // Verify the result really is sorted, then checksum the strings' bytes in
    // order so a wrong or partial sort changes the RESULT line.
    let mutable checksum = 0;
    let mutable prev = "";
    i = UInt(0);
    while i < n then {
        let v = xs[i];
        assert(prev.compare(v) <= 0, "sort_strings: output must be sorted");
        let mutable g = 0;
        for b in v.bytes() then {
            g = (g * 131 + Int(b)) % 2147483648;
        };
        checksum = (checksum * 131 + g) % 2147483648;
        prev = v;
        i += UInt(1);
    };
    println("RESULT \(checksum) \(elapsed)");
    return 0;
};
