// MIR lowering: assignment order + object-lock protocol
// (concurrency-design.md §赋值求值顺序 + §对象锁语义).
//
// 赋值统一「左路径与下标 → RHS → 写入」（全类型一致）：owner 装载先发射，
// RHS 在**锁外**求值，写入按字段种类分协议——
// - 标量 `mutable` 字段 / 全局标量槽：AtomicStore（顺序一致）；
// - 引用 / 多字长字段 / 槽：Lock → Exchange（旧值转入临时）→ Unlock →
//   Drop(旧值)——释放**绝不进锁**；
// - 非锁定对象：原 Assign 形状（字节级不变约束保留）。
//
// 读同样按种类：非 `mutable` 字段直接读（构造后不变，无同步）；`mutable`
// 标量字段 AtomicLoad；引用 / 多字长字段短锁内读（复制句柄的 retain 同在
// 锁内）。嵌套路径 `a.b.c` 的中间链节各按所属对象协议取放，最终访问的同步
// 落在「路径上最后一个被锁对象」上（下标/deref 终点同样如此）。
//
// 临界区只有一处机器级访问，锁内不跑用户代码——不需要可重入锁，也不再需要
// 早退补释放的在飞簿记（return / break / continue 不可能落在锁内）。
//
// 只对带锁类型的访问发射协议动作；其余访问保持原 MIR 形状（非锁定类型的
// codegen 逐字节不变是硬性约束）。

/// 语句级「读 place」的落点（Evaluate 丢弃 / 装入 if-when 结果局部）。
type LockedPlaceStmtKind {
    EvaluateStmt(),
    AssignToLocal(target: MIRLocalID),
};

given MIRFunctionBuilder {
    // ── 锁相关性判定 ────────────────────────────────────────────────────────

    /// `let mutable` 全局绑定（Koral 存储 + accessor）才有每变量锁。foreign
    /// 变量的存储归 C 侧管，不加编译器锁；不可变 `let` 无锁。
    global_slot_is_locked(self, def_id: DefId): Bool = {
        if self.context.is_foreign_global(def_id) then {
            return false;
        };
        return when self.context.get_symbol(def_id) in {
            .Some(symbol) then symbol.is_mutable(),
            .None() then false,
        };
    };

    /// place 的求值是否会经过「锁定对象的字段读」或「可变全局绑定读」。
    /// 是 ⇒ 走协议化装载；否 ⇒ 保持原有延迟读形状（字节级不变约束）。
    place_locked_relevant(self, place: MIRPlace): Bool = {
        return when place in {
            .Local(_) then false,
            .Global(def_id) then self.global_slot_is_locked(def_id),
            .Field(base, _) then {
                self.context.is_locked_type(self.place_type(base))
                    or self.place_locked_relevant(base)
            },
            .EnumPayload(base, _, _, _, _) then self.place_locked_relevant(base),
            .Deref(value, _) or .PointerElement(value, _) then self.value_locked_relevant(
                value,
            ),
        };
    };

    value_locked_relevant(self, value: MIRValue): Bool = {
        return when value in {
            .PlaceRead(place, _) then self.place_locked_relevant(place),
            _ then false,
        };
    };

    /// 取址/取 owner 类型前剥掉引用/指针壳：`r.f = v`（r: &Counter）的字段
    /// 所属对象仍是 Counter，按锁定对象算。
    private lock_owner_probe_type(self, t: Type): Type = {
        let _ = self;
        let mutable current = t;
        let mutable again = true;
        while again then {
            when current in {
                .ReferenceType(inner) or .MutableReferenceType(inner)
                or .BorrowedReferenceType(inner) or .MutableBorrowedReferenceType(inner)
                or .WeakReferenceType(inner) or .MutableWeakReferenceType(inner)
                or .PointerType(inner) or .MutablePointerType(inner) then {
                    current = inner;
                },
                _ then {
                    again = false;
                },
            };
        };
        return current;
    };

    // ── owner 装载与协议化读 ────────────────────────────────────────────────

    /// place 的「所属对象句柄」操作数。字段访问的同步目标就是它。
    ///
    /// 链上的锁定链接（`a.b.c` 里的 `a.b`）在这里递归装载，每个链接的读按
    /// 其所属对象的协议取放；`Local` 句柄直接用，不产生读（读局部变量不是
    /// 字段访问）。
    load_place_owner(self, base: MIRPlace): MIROperand = {
        when base in {
            .Local(local_id) then {
                return MIROperand.Local(local_id);
            },
            _ then {},
        };
        let base_type = self.place_type(base);
        return when self.lower_locked_read(base, MIROwnershipUse.Copy(), base_type) in {
            .Some(operand) then operand,
            .None() then self.materialize_raw(
                MIRValue.PlaceRead(base, MIROwnershipUse.Copy()),
                base_type,
            ),
        };
    };

    /// 协议化装载 place 的值：非 `mutable` 字段直接读、`mutable` 标量字段
    /// AtomicLoad、引用/多字长字段短锁内读（含复制句柄的 retain）。place 不
    /// 涉及锁定访问时返回 None，调用方保持原有延迟读路径。
    lower_locked_read(
        self,
        place: MIRPlace,
        ownership: MIROwnershipUse,
        result_type: Type,
    ): Option[MIROperand] = {
        if not self.place_locked_relevant(place) then {
            return Option[MIROperand].None();
        };
        when place in {
            .Field(base, field) then {
                let owner = self.load_place_owner(base);
                let handle_id = owner.local_id_or_zero();
                let rewritten = MIRPlace.Field(MIRPlace.Local(handle_id), field);
                if self.context.is_locked_type(self.place_type(base)) then {
                    if not field.is_mutable() then {
                        // 非 `mutable` 字段构造后不变：直接读，无同步。
                        return Option[MIROperand].Some(
                            self.materialize_raw(
                                MIRValue.PlaceRead(rewritten, ownership),
                                result_type,
                            ),
                        );
                    };
                    if self.context.is_atomic_scalar_type(field.symbol_type) then {
                        let temp = self.make_temporary(result_type, "aload");
                        self.append_statement(MIRStatement.Declare(temp.id));
                        self.append_statement(MIRStatement.AtomicLoad(temp.id, rewritten));
                        return Option[MIROperand].Some(MIROperand.Local(temp.id));
                    };
                    let lock = MIRLockTarget.ObjectLock(handle_id);
                    self.append_statement(MIRStatement.Lock(lock));
                    let result = self.materialize_raw(
                        MIRValue.PlaceRead(rewritten, ownership),
                        result_type,
                    );
                    self.append_statement(MIRStatement.Unlock(lock));
                    return Option[MIROperand].Some(result);
                };
                return Option[MIROperand].Some(
                    self.materialize_raw(MIRValue.PlaceRead(rewritten, ownership), result_type),
                );
            },
            .Global(def_id) then {
                if self.context.is_atomic_scalar_type(self.place_type(place)) then {
                    let temp = self.make_temporary(result_type, "aload");
                    self.append_statement(MIRStatement.Declare(temp.id));
                    self.append_statement(MIRStatement.AtomicLoad(temp.id, place));
                    return Option[MIROperand].Some(MIROperand.Local(temp.id));
                };
                let lock = MIRLockTarget.GlobalLock(def_id);
                self.append_statement(MIRStatement.Lock(lock));
                let result = self.materialize_raw(
                    MIRValue.PlaceRead(place, ownership),
                    result_type,
                );
                self.append_statement(MIRStatement.Unlock(lock));
                return Option[MIROperand].Some(result);
            },
            .EnumPayload(base, case_name, field_name, field_index, field_type) then {
                let owner = self.load_place_owner(base);
                let rewritten = MIRPlace.EnumPayload(
                    MIRPlace.Local(owner.local_id_or_zero()),
                    case_name,
                    field_name,
                    field_index,
                    field_type,
                );
                return Option[MIROperand].Some(
                    self.materialize_raw(MIRValue.PlaceRead(rewritten, ownership), result_type),
                );
            },
            .Deref(value, pointee) then {
                let rewritten = MIRPlace.Deref(self.rewrite_locked_value(value), pointee);
                return Option[MIROperand].Some(
                    self.materialize_raw(MIRValue.PlaceRead(rewritten, ownership), result_type),
                );
            },
            .PointerElement(value, element) then {
                let rewritten = MIRPlace.PointerElement(
                    self.rewrite_locked_value(value),
                    element,
                );
                return Option[MIROperand].Some(
                    self.materialize_raw(MIRValue.PlaceRead(rewritten, ownership), result_type),
                );
            },
            .Local(_) then {},
        };
        return Option[MIROperand].None();
    };

    /// 重写 place 基链上的锁定链接为已装载的临时局部（每个链接按所属对象
    /// 协议取放）。最终链接的访问不在此处理（读由 lower_locked_read 走协议，
    /// 写由 lower_assignment_write 走协议）。
    rewrite_locked_place_links(self, place: MIRPlace): MIRPlace = {
        return when place in {
            .Field(base, field) then MIRPlace.Field(
                MIRPlace.Local(self.load_place_owner(base).local_id_or_zero()),
                field,
            ),
            .EnumPayload(base, case_name, field_name, field_index, field_type) then MIRPlace.EnumPayload(
                MIRPlace.Local(self.load_place_owner(base).local_id_or_zero()),
                case_name,
                field_name,
                field_index,
                field_type,
            ),
            .Deref(value, pointee) then MIRPlace.Deref(
                self.rewrite_locked_value(value),
                pointee,
            ),
            .PointerElement(value, element) then MIRPlace.PointerElement(
                self.rewrite_locked_value(value),
                element,
            ),
            _ then place,
        };
    };

    rewrite_locked_value(self, value: MIRValue): MIRValue = {
        return when value in {
            .PlaceRead(place, ownership) then {
                if not self.place_locked_relevant(place) then {
                    value
                } else {
                    when self.lower_locked_read(place, ownership, self.place_type(place)) in {
                        .Some(operand) then MIRValue.Operand(operand),
                        .None() then value,
                    }
                }
            },
            _ then value,
        };
    };

    // ── 语句级发射 ──────────────────────────────────────────────────────────

    /// 「读 place 的语句」（Evaluate 丢弃 / 装入结果局部）：按字段种类走协议
    /// （非 `mutable` 直读 / 标量 AtomicLoad / 短锁内读，值装载与复制句柄的
    /// retain 都在锁内）；基链上的锁定链接先按所属对象协议取放重写。不涉及
    /// 锁定访问 ⇒ 原样发射。
    append_locked_place_statement(
        self,
        place: MIRPlace,
        ownership: MIROwnershipUse,
        kind: LockedPlaceStmtKind,
    ): Void = {
        if not self.place_locked_relevant(place) then {
            self.append_statement(self.locked_place_statement(kind, place, ownership));
            return;
        };
        when place in {
            .Field(base, field) then {
                if self.context.is_locked_type(self.place_type(base)) then {
                    let owner = self.load_place_owner(base);
                    let handle_id = owner.local_id_or_zero();
                    let rewritten = MIRPlace.Field(MIRPlace.Local(handle_id), field);
                    if not field.is_mutable() then {
                        self.append_statement(
                            self.locked_place_statement(kind, rewritten, ownership),
                        );
                        return;
                    };
                    if self.context.is_atomic_scalar_type(field.symbol_type) then {
                        self.append_atomic_place_statement(kind, rewritten);
                        return;
                    };
                    let lock = MIRLockTarget.ObjectLock(handle_id);
                    self.append_statement(MIRStatement.Lock(lock));
                    self.append_statement(self.locked_place_statement(kind, rewritten, ownership));
                    self.append_statement(MIRStatement.Unlock(lock));
                    return;
                };
            },
            .Global(def_id) then {
                if self.global_slot_is_locked(def_id) then {
                    if self.context.is_atomic_scalar_type(self.place_type(place)) then {
                        self.append_atomic_place_statement(kind, place);
                        return;
                    };
                    let lock = MIRLockTarget.GlobalLock(def_id);
                    self.append_statement(MIRStatement.Lock(lock));
                    self.append_statement(self.locked_place_statement(kind, place, ownership));
                    self.append_statement(MIRStatement.Unlock(lock));
                    return;
                };
            },
            _ then {},
        };
        let rewritten = self.rewrite_locked_place_links(place);
        self.append_statement(self.locked_place_statement(kind, rewritten, ownership));
    };

    /// 标量槽的语句级原子读：装入目标局部（或丢弃读）。
    private append_atomic_place_statement(
        self,
        kind: LockedPlaceStmtKind,
        place: MIRPlace,
    ): Void = {
        when kind in {
            .EvaluateStmt() then {
                let temp = self.make_temporary(self.place_type(place), "aload");
                self.append_statement(MIRStatement.Declare(temp.id));
                self.append_statement(MIRStatement.AtomicLoad(temp.id, place));
            },
            .AssignToLocal(target) then {
                self.append_statement(MIRStatement.AtomicLoad(target, place));
            },
        };
    };

    private locked_place_statement(
        self,
        kind: LockedPlaceStmtKind,
        place: MIRPlace,
        ownership: MIROwnershipUse,
    ): MIRStatement = {
        let _ = self;
        return when kind in {
            .EvaluateStmt() then MIRStatement.Evaluate(MIRValue.PlaceRead(place, ownership)),
            .AssignToLocal(target) then MIRStatement.Assign(
                MIRPlace.Local(target),
                MIRValue.PlaceRead(place, ownership),
            ),
        };
    };

    // ── 赋值写入协议（concurrency-design.md §对象锁语义）────────────────────

    /// 写入协议：标量 `mutable` 槽 AtomicStore；引用/多字长槽 Lock →
    /// Exchange（旧值按位转入临时，所有权转移）→ Unlock → Drop(旧值)——
    /// 释放在解锁之后，析构绝不进锁。非锁定 place 保持原 Assign 形状。
    /// place 已经 rewrite 过（基链锁定链接都是 Local 句柄）。
    lower_assignment_write(self, place: MIRPlace, value: MIRValue): Void = {
        when place in {
            .Field(base, field) then {
                if self.context.is_locked_type(self.place_type(base)) then {
                    let handle_id = self.load_place_owner(base).local_id_or_zero();
                    if field.is_mutable() and self.context.is_atomic_scalar_type(
                        field.symbol_type,
                    ) then {
                        self.append_statement(MIRStatement.AtomicStore(place, value));
                        return;
                    };
                    let lock = MIRLockTarget.ObjectLock(handle_id);
                    let old_temp = self.make_temporary(field.symbol_type, "slot_old");
                    self.append_statement(MIRStatement.Declare(old_temp.id));
                    self.append_statement(MIRStatement.Lock(lock));
                    self.append_statement(MIRStatement.Exchange(place, old_temp.id, value));
                    self.append_statement(MIRStatement.Unlock(lock));
                    self.append_statement(MIRStatement.Drop(MIRPlace.Local(old_temp.id)));
                    return;
                };
                self.append_statement(MIRStatement.Assign(place, value));
            },
            .Global(def_id) then {
                if self.global_slot_is_locked(def_id) then {
                    if self.context.is_atomic_scalar_type(self.place_type(place)) then {
                        self.append_statement(MIRStatement.AtomicStore(place, value));
                        return;
                    };
                    let lock = MIRLockTarget.GlobalLock(def_id);
                    let old_temp = self.make_temporary(self.place_type(place), "slot_old");
                    self.append_statement(MIRStatement.Declare(old_temp.id));
                    self.append_statement(MIRStatement.Lock(lock));
                    self.append_statement(MIRStatement.Exchange(place, old_temp.id, value));
                    self.append_statement(MIRStatement.Unlock(lock));
                    self.append_statement(MIRStatement.Drop(MIRPlace.Local(old_temp.id)));
                    return;
                };
                self.append_statement(MIRStatement.Assign(place, value));
            },
            _ then {
                self.append_statement(MIRStatement.Assign(place, value));
            },
        };
    };
};
