// MIR lowering: while-loop and loop-scoped pattern control flow.

given MIRFunctionBuilder {
    lower_while(self, condition: TypedExpr, body: TypedExpr): Void = {
        let predecessor_block = self.current_block_id();
        let condition_block = self.make_block();
        let body_block = self.make_block();
        let exit_block = self.make_block();
        self.set_current_block(predecessor_block);
        self.terminate(MIRTerminator.Goto(condition_block));
        self.set_current_block(condition_block);
        let condition_operand = self.lower_operand(condition);
        self.terminate(MIRTerminator.Branch(condition_operand, body_block, exit_block));
        self.set_current_block(body_block);
        self.loop_stack.push(
            MIRLoopBuilderContext(condition_block, exit_block, self.scope_stack.count()),
        );
        let _ = self.lower_expression(body);
        let _ = self.loop_stack.pop();
        if not self.current_block_is_terminated() then {
            self.terminate(MIRTerminator.Goto(condition_block));
        };
        self.set_current_block(exit_block);
    };

    /// Check if a when expression can be lowered to SwitchValue instead of branch chains.
    /// This is possible when all patterns are simple enum case patterns (with conditionless
    /// payloads) or simple integer/boolean literal patterns, with at most one wildcard/default.
    private can_lower_to_switch_value(
        self,
        subject: TypedExpr,
        arms: List[TypedWhenArm],
    ): Bool = {
        if arms.count() < UInt(2) then {
            return false;
        };
        // A guarded arm needs its own conditional test, which a SwitchValue
        // cannot express -- fall back to the branch chain.
        for arm in arms then {
            if arm.guard is .Some(_) then {
                return false;
            };
        };
        let subject_type = subject.expr_type;
        // Dereference reference types
        let matched_type = when subject_type in {
            .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner)
            or .MutableBorrowedReferenceType(inner) or .WeakReferenceType(inner)
            or .MutableWeakReferenceType(inner) then inner,
            _ then subject_type,
        };
        let mutable enum_count: UInt = 0;
        let mutable literal_count: UInt = 0;
        for arm in arms then {
            when arm.pattern in {
                .Wildcard() or .Variable(_) then {},
                .EnumCase(_, _, elements) then {
                    if matched_type is not .EnumType(_) then {
                        return false;
                    };
                    for element in elements then {
                        if not typed_pattern_is_conditionless_payload(element.pattern) then {
                            return false;
                        };
                    };
                    enum_count += 1;
                },
                .IntegerLiteral(_) then {
                    let is_int = when matched_type in {
                        .IntType() or .Int8Type() or .Int16Type() or .Int32Type() or .Int64Type()
                        or .UIntType() or .UInt8Type() or .UInt16Type() or .UInt32Type() or .UInt64Type()
                        or .WrappingIntType() or .WrappingInt8Type() or .WrappingInt16Type()
                        or .WrappingInt32Type() or .WrappingInt64Type() or .WrappingUIntType()
                        or .WrappingUInt8Type() or .WrappingUInt16Type() or .WrappingUInt32Type()
                        or .WrappingUInt64Type() then true,
                        _ then false,
                    };
                    if not is_int then {
                        return false;
                    };
                    literal_count += 1;
                },
                .BoolLiteral(_) then {
                    if matched_type is not .BoolType() then {
                        return false;
                    };
                    literal_count += 1;
                },
                _ then {
                    return false;
                },
            };
        };
        return (enum_count + literal_count) >= UInt(2);
    };

    /// Extract the switch constant for a pattern.
    private switch_constant_for_pattern(
        self,
        pattern: TypedPattern,
    ): Option[MIRConstant] = {
        return when pattern in {
            .EnumCase(_, tag_index, _) then Option[MIRConstant].Some(
                MIRConstant.Integer(tag_index.to_string(), Type.IntType()),
            ),
            .IntegerLiteral(value) then Option[MIRConstant].Some(
                MIRConstant.Integer(value, Type.IntType()),
            ),
            .BoolLiteral(value) then Option[MIRConstant].Some(
                MIRConstant.Boolean(value),
            ),
            _ then Option[MIRConstant].None(),
        };
    };

    /// Lower a when expression with simple enum/literal patterns to SwitchValue.
    /// This replaces a linear chain of branch checks with a single switch dispatch,
    /// significantly reducing the number of MIR locals and C stack frame size.
    private lower_switch_when_expression(
        self,
        subject: TypedExpr,
        arms: List[TypedWhenArm],
        result_type: Type,
    ): Option[MIRExprResult] = {
        let has_result = not self.type_is_void_or_never(result_type);
        let mutable result_local = Option[MIRLocalID].None();
        if has_result then {
            let local = self.make_temporary(result_type, "when_result");
            self.append_statement(MIRStatement.Declare(local.id));
            result_local = Option[MIRLocalID].Some(local.id);
        };
        let prepared_subject = self.prepare_pattern_subject(subject, "when_subject") or else {
            return Option[MIRExprResult].None();
        };
        let subject_place = prepared_subject.first;
        let subject_scope = prepared_subject.second;
        let dispatch_block = self.current_block_id();

        let matched = self.pattern_match_place(subject_place, subject.expr_type);
        let matched_place = matched.first;
        let matched_type = matched.second;
        let matched_value = MIRValue.PlaceRead(matched_place, MIROwnershipUse.Borrow());

        // Extract switch operand: enum tag for enums, direct value for int/bool
        let switch_operand = when matched_type in {
            .EnumType(_) then {
                let tag_value = MIRValue.EnumTag(
                    MIREnumTag(matched_value, matched_type),
                );
                self.materialize(tag_value, Type.IntType())
            },
            _ then self.materialize(matched_value, matched_type),
        };

        let join_block = self.make_block();
        let mutable switch_cases = List[MIRSwitchCase].new();
        let mutable default_block = Option[MIRBlockID].None();

        // Create case blocks and build switch cases
        for arm in arms then {
            let case_block = self.make_block();
            when arm.pattern in {
                .Wildcard() or .Variable(_) then {
                    default_block = Option[MIRBlockID].Some(case_block);
                },
                _ then {
                    when self.switch_constant_for_pattern(arm.pattern) in {
                        .Some(constant) then {
                            switch_cases.push(MIRSwitchCase(constant, case_block));
                        },
                        .None() then {},
                    };
                },
            };
        };

        // Create default block if not explicitly provided
        let effective_default = default_block or else {
            let unreachable_block = self.make_block();
            let saved_block = self.current_block_index;
            self.set_current_block(unreachable_block);
            self.terminate(MIRTerminator.Unreachable());
            self.current_block_index = saved_block;
            unreachable_block
        };

        // Emit the switch terminator from the original dispatch block.
        self.set_current_block(dispatch_block);
        self.terminate(
            MIRTerminator.SwitchValue(
                switch_operand,
                switch_cases,
                Option[MIRBlockID].Some(effective_default),
            ),
        );

        // Emit case bodies
        for arm in arms then {
            let case_block = when arm.pattern in {
                .Wildcard() or .Variable(_) then default_block,
                .EnumCase(_, tag_index, _) then {
                    let target_value = MIRConstant.Integer(
                        tag_index.to_string(),
                        Type.IntType(),
                    );
                    let mutable found = Option[MIRBlockID].None();
                    for sc in switch_cases then {
                        when sc.value in {
                            .Integer(v, _) then {
                                if v == tag_index.to_string() then {
                                    found = Option[MIRBlockID].Some(sc.target);
                                };
                            },
                            _ then {},
                        };
                    };
                    found
                },
                .IntegerLiteral(value) then {
                    let mutable found = Option[MIRBlockID].None();
                    for sc in switch_cases then {
                        when sc.value in {
                            .Integer(v, _) then {
                                if v == value then {
                                    found = Option[MIRBlockID].Some(sc.target);
                                };
                            },
                            _ then {},
                        };
                    };
                    found
                },
                .BoolLiteral(value) then {
                    let mutable found = Option[MIRBlockID].None();
                    for sc in switch_cases then {
                        when sc.value in {
                            .Boolean(v) then {
                                if v == value then {
                                    found = Option[MIRBlockID].Some(sc.target);
                                };
                            },
                            _ then {},
                        };
                    };
                    found
                },
                _ then Option[MIRBlockID].None(),
            };

            when case_block in {
                .Some(cb) then {
                    self.set_current_block(cb);
                    let branch_result_local = result_local;
                    let branch_scope = self.make_scope_id();
                    self.scope_stack.push(branch_scope);
                    self.append_statement(MIRStatement.ScopeEnter(branch_scope));
                    // Snapshot by CLONE. A plain `let saved = self.field` aliases the
                    // same Dict, so `insert` mutates the "saved" state too and the
                    // restore is a no-op -- pattern bindings then leak out of their arm
                    // and later shadow enclosing parameters (pattern_binding_scope_test).
                    let saved_pattern_places = self.pattern_place_by_def_id.clone();
                    let saved_pattern_names = self.pattern_place_by_name.clone();
                    self.bind_pattern_variables(
                        arm.pattern,
                        subject_place,
                        subject.expr_type,
                    );
                    self.lower_branch_body(arm.body, branch_result_local);
                    self.pattern_place_by_def_id = saved_pattern_places;
                    self.pattern_place_by_name = saved_pattern_names;
                    if not self.current_block_is_terminated() then {
                        self.append_statement(MIRStatement.ScopeExit(branch_scope));
                        self.deferred_exprs_by_scope.remove(branch_scope.raw_value);
                        let _ = self.scope_stack.pop();
                        self.terminate(MIRTerminator.Goto(join_block));
                    } else {
                        self.deferred_exprs_by_scope.remove(branch_scope.raw_value);
                        let _ = self.scope_stack.pop();
                    };
                },
                .None() then {},
            };
        };

        self.set_current_block(join_block);
        when subject_scope in {
            .Some(scope) then {
                when subject_place in {
                    .Local(local_id) then self.append_statement(
                        MIRStatement.Drop(MIRPlace.Local(local_id)),
                    ),
                    _ then {},
                };
                self.append_statement(MIRStatement.ScopeExit(scope));
                let _ = self.scope_stack.pop();
                self.deferred_exprs_by_scope.remove(scope.raw_value);
            },
            .None() then {},
        };
        return if result_local is .Some(local_id) then Option[MIRExprResult].Some(
            MIRExprResult(
                result_type,
                ValueCategory.RValue(),
                Option[MIROperand].Some(MIROperand.Local(local_id)),
                Option[MIRPlace].None(),
            ),
        ) else self.void_result();
    };

    lower_when_expression(
        self,
        subject: TypedExpr,
        arms: List[TypedWhenArm],
        result_type: Type,
    ): Option[MIRExprResult] = {
        // Use SwitchValue lowering for simple enum/literal patterns
        if self.can_lower_to_switch_value(subject, arms) then {
            return self.lower_switch_when_expression(subject, arms, result_type);
        };
        let has_result = not self.type_is_void_or_never(result_type);
        let mutable result_local = Option[MIRLocalID].None();
        if has_result then {
            let local = self.make_temporary(result_type, "when_result");
            self.append_statement(MIRStatement.Declare(local.id));
            result_local = Option[MIRLocalID].Some(local.id);
        };
        let prepared_subject = self.prepare_pattern_subject(subject, "when_subject") or else {
            return Option[MIRExprResult].None();
        };
        let subject_place = prepared_subject.first;
        let subject_scope = prepared_subject.second;
        let dispatch_block = self.current_block_id();
        let join_block = self.make_block();
        let mutable next_test_block = dispatch_block;
        // Pre-materialize subject operand for reuse across all pattern conditions,
        // matching Swift compiler's lowerSimpleWhenExpression optimization.
        let saved_pattern_subject = self.pattern_subject_operand;
        let saved_pattern_tag = self.pattern_subject_tag;
        let saved_comparison_local = self.pattern_comparison_local;
        self.pattern_subject_operand = when subject_place in {
            .Local(local_id) then Option[MIROperand].Some(MIROperand.Local(local_id)),
            _ then Option[MIROperand].None(),
        };
        self.pattern_subject_tag = Option[MIROperand].None();
        self.pattern_comparison_local = Option[MIRLocalID].None();
        let unmatched_trap_block = self.make_block();
        for pair in arms.lazy().enumerate() then {
            self.set_current_block(next_test_block);
            let arm = pair.second;
            // `make_block` moves the cursor, so park the arm's test block first
            // and come back to it before any lowering runs.
            let arm_entry_block = self.current_block_id();
            let next_block = if pair.first + UInt(1) == arms.count() then unmatched_trap_block
            else self.make_block();
            self.set_current_block(arm_entry_block);
            // An arm whose pattern offers several readings is matched as a
            // backtracking chain (the guard re-runs per reading); an or-free
            // pattern keeps the single-test path, which binds by alias.
            let alternatives = typed_pattern_or_alternatives(arm.pattern);
            if alternatives.count() > UInt(1) then {
                self.lower_when_arm_alternative_chain(
                    arm,
                    alternatives,
                    subject_place,
                    subject.expr_type,
                    result_local,
                    next_block,
                    join_block,
                );
            } else {
                self.lower_when_arm_single(
                    arm,
                    subject_place,
                    subject.expr_type,
                    result_local,
                    next_block,
                    join_block,
                );
            };
            next_test_block = next_block;
        };
        self.pattern_subject_operand = saved_pattern_subject;
        self.pattern_subject_tag = saved_pattern_tag;
        self.pattern_comparison_local = saved_comparison_local;
        self.set_current_block(unmatched_trap_block);
        self.terminate(MIRTerminator.Unreachable());
        self.set_current_block(join_block);
        when subject_scope in {
            .Some(scope) then {
                when subject_place in {
                    .Local(local_id) then self.append_statement(
                        MIRStatement.Drop(MIRPlace.Local(local_id)),
                    ),
                    _ then {},
                };
                self.append_statement(MIRStatement.ScopeExit(scope));
                let _ = self.scope_stack.pop();
                self.deferred_exprs_by_scope.remove(scope.raw_value);
            },
            .None() then {},
        };
        let mutable final_result = self.void_result();
        when result_local in {
            .Some(local_id) then {
                final_result = Option[MIRExprResult].Some(
                    MIRExprResult(
                        result_type,
                        ValueCategory.RValue(),
                        Option[MIROperand].Some(MIROperand.Local(local_id)),
                        Option[MIRPlace].None(),
                    ),
                );
            },
            .None() then {},
        };
        return final_result;
    };

    /// One arm of a branch-chain `when`, matched by a single or-free test.
    /// The cursor sits in the block that runs the test; bindings are aliases
    /// of the payload places, which is correct while one layout covers the
    /// whole pattern.
    private lower_when_arm_single(
        self,
        arm: TypedWhenArm,
        subject_place: MIRPlace,
        subject_type: Type,
        result_local: Option[MIRLocalID],
        next_block: MIRBlockID,
        join_block: MIRBlockID,
    ): Void = {
        let condition = self.lower_pattern_condition(
            subject_place,
            subject_type,
            arm.pattern,
            false,
        );
        let condition_block = self.current_block_id();
        let body_block = self.make_block();
        self.set_current_block(condition_block);
        self.terminate(MIRTerminator.Branch(condition, body_block, next_block));
        self.set_current_block(body_block);
        let branch_scope = self.make_scope_id();
        self.scope_stack.push(branch_scope);
        self.append_statement(MIRStatement.ScopeEnter(branch_scope));
        let saved_pattern_places = self.pattern_place_by_def_id.clone();
        let saved_pattern_names = self.pattern_place_by_name.clone();
        self.bind_pattern_variables(arm.pattern, subject_place, subject_type);
        // Arm guard, evaluated with the pattern's bindings in scope. A
        // false guard falls through to the next arm's check.
        when arm.guard in {
            .Some(guard_expr) then {
                let guard_operand = self.lower_operand_for_expected_type(
                    guard_expr,
                    Type.BoolType(),
                );
                // `make_block` moves the cursor, so the branch is emitted
                // back in the block the guard computation landed in.
                let guard_block = self.current_block_id();
                let guard_fail_block = self.make_block();
                let real_body_block = self.make_block();
                self.set_current_block(guard_block);
                self.terminate(
                    MIRTerminator.Branch(guard_operand, real_body_block, guard_fail_block),
                );
                // The arm scope is already entered (the guard sees the
                // bindings), so the false path leaves it the way the body's
                // normal exit does -- drops and scope exit -- before the
                // next arm runs.
                self.set_current_block(guard_fail_block);
                self.emit_deferred_exprs(branch_scope);
                if not self.current_block_is_terminated() then {
                    self.append_statement(MIRStatement.ScopeExit(branch_scope));
                };
                self.terminate(MIRTerminator.Goto(next_block));
                self.set_current_block(real_body_block);
            },
            .None() then {},
        };
        self.lower_when_arm_body(
            arm,
            result_local,
            branch_scope,
            saved_pattern_places,
            saved_pattern_names,
            join_block,
        );
    };

    /// One arm of a branch-chain `when` whose pattern offers several readings.
    /// The readings run in backtracking order: each is tested, its bindings
    /// fill the shared slots, and the guard is re-evaluated on THOSE bindings.
    /// The next reading is tried when the test fails OR the guard refuses --
    /// never the left-biased "guard runs once on the first matching reading".
    /// All readings share one body block, so the arm body lowers exactly once.
    private lower_when_arm_alternative_chain(
        self,
        arm: TypedWhenArm,
        alternatives: List[TypedPattern],
        subject_place: MIRPlace,
        subject_type: Type,
        result_local: Option[MIRLocalID],
        next_block: MIRBlockID,
        join_block: MIRBlockID,
    ): Void = {
        // One slot per name, filled from each reading's own layout. Claimed
        // before the first test so every path through the chain sees the same
        // places; a reading that matches overwrites the slots with its values.
        let entry_block = self.current_block_id();
        let branch_scope = self.make_scope_id();
        self.scope_stack.push(branch_scope);
        self.append_statement(MIRStatement.ScopeEnter(branch_scope));
        let saved_pattern_places = self.pattern_place_by_def_id.clone();
        let saved_pattern_names = self.pattern_place_by_name.clone();
        self.apply_pattern_bindings(
            arm.pattern,
            subject_place,
            subject_type,
            PatternBindMode.Claim(),
        );

        let body_block = self.make_block();
        // The arm gives up here -- every reading either failed to match or was
        // refused by the guard -- and leaves like a single-test arm whose guard
        // said false: drops, scope exit, next arm's check.
        let arm_fail_block = self.make_block();
        self.set_current_block(arm_fail_block);
        self.emit_deferred_exprs(branch_scope);
        if not self.current_block_is_terminated() then {
            self.append_statement(MIRStatement.ScopeExit(branch_scope));
        };
        self.terminate(MIRTerminator.Goto(next_block));

        let mutable test_block = entry_block;
        for pair in alternatives.lazy().enumerate() then {
            self.set_current_block(test_block);
            let alternative = pair.second;
            let is_last = pair.first + UInt(1) == alternatives.count();
            let condition = self.lower_pattern_condition(
                subject_place,
                subject_type,
                alternative,
                false,
            );
            let condition_end = self.current_block_id();
            // A reading that does not match hands over to the next reading's
            // test; the last one hands over to the arm's give-up block.
            let fail_block = if is_last then arm_fail_block else self.make_block();
            let fill_block = self.make_block();
            self.set_current_block(condition_end);
            self.terminate(MIRTerminator.Branch(condition, fill_block, fail_block));
            self.set_current_block(fill_block);
            self.apply_pattern_bindings(
                alternative,
                subject_place,
                subject_type,
                PatternBindMode.Fill(),
            );
            // The guard runs on THIS reading's bindings and may refuse them:
            // a false guard tries the next reading, same as a failed match.
            when arm.guard in {
                .Some(guard_expr) then {
                    let guard_operand = self.lower_operand_for_expected_type(
                        guard_expr,
                        Type.BoolType(),
                    );
                    let guard_end = self.current_block_id();
                    let real_body_block = self.make_block();
                    self.set_current_block(guard_end);
                    self.terminate(
                        MIRTerminator.Branch(guard_operand, real_body_block, fail_block),
                    );
                    self.set_current_block(real_body_block);
                },
                .None() then {},
            };
            self.terminate(MIRTerminator.Goto(body_block));
            test_block = fail_block;
        };

        self.set_current_block(body_block);
        self.lower_when_arm_body(
            arm,
            result_local,
            branch_scope,
            saved_pattern_places,
            saved_pattern_names,
            join_block,
        );
    };

    /// The arm body under an already-established binding, with the arm scope's
    /// teardown. The place maps are restored first so pattern places never
    /// leak past the arm.
    private lower_when_arm_body(
        self,
        arm: TypedWhenArm,
        result_local: Option[MIRLocalID],
        branch_scope: MIRScopeID,
        saved_pattern_places: Dict[UInt, MIRPlace],
        saved_pattern_names: Dict[String, MIRPlace],
        join_block: MIRBlockID,
    ): Void = {
        self.lower_branch_body(arm.body, result_local);
        self.pattern_place_by_def_id = saved_pattern_places;
        self.pattern_place_by_name = saved_pattern_names;
        if not self.current_block_is_terminated() then {
            self.append_statement(MIRStatement.ScopeExit(branch_scope));
            self.deferred_exprs_by_scope.remove(branch_scope.raw_value);
            let _ = self.scope_stack.pop();
            self.terminate(MIRTerminator.Goto(join_block));
        } else {
            self.deferred_exprs_by_scope.remove(branch_scope.raw_value);
            let _ = self.scope_stack.pop();
        };
    };

    lower_pattern_test(
        self,
        subject: TypedExpr,
        pattern: TypedPattern,
        negated: Bool,
        result_type: Type,
    ): MIRExprResult = {
        let subject_value = self.lower_value(subject);
        let subject_operand = self.materialize(subject_value, subject.expr_type);
        let subject_place = MIRPlace.Local(
            when subject_operand in {
                .Local(id) then id,
                _ then MIRLocalID(UInt(0)),
            },
        );
        // `?name` / `is not ?name`: the subject is the upgrade intrinsic
        // (`Option[T]`), so the test is liveness -- the Some tag. A positive
        // test also binds the strong reference from the Some payload.
        if pattern is .WeakBinding(_) then {
            return self.lower_weak_binding_pattern_test(
                subject_place,
                subject.expr_type,
                pattern,
                negated,
                result_type,
            );
        };
        let saved_pattern_subject = self.pattern_subject_operand;
        let saved_pattern_tag = self.pattern_subject_tag;
        let saved_comparison_local = self.pattern_comparison_local;
        self.pattern_subject_operand = when subject_operand in {
            .Local(_) then Option[MIROperand].Some(subject_operand),
            _ then Option[MIROperand].None(),
        };
        self.pattern_subject_tag = Option[MIROperand].None();
        self.pattern_comparison_local = Option[MIRLocalID].None();
        // A positive test whose pattern binds claims one slot per name before
        // the test and fills it on the matching edge. The names are live in
        // the rest of the guard and in the body -- and must land in the SAME
        // slots however many readings a guarded arm re-runs the guard on -- and
        // a failed test must not write payload values into them (reading a
        // non-matching variant's payload is garbage).
        let binds = not negated and typed_pattern_introduces_binding(pattern);
        if binds then {
            self.apply_pattern_bindings(
                pattern,
                subject_place,
                subject.expr_type,
                PatternBindMode.Claim(),
            );
        };
        let condition = self.lower_pattern_condition(
            subject_place,
            subject.expr_type,
            pattern,
            negated,
        );
        self.pattern_subject_operand = saved_pattern_subject;
        self.pattern_subject_tag = saved_pattern_tag;
        self.pattern_comparison_local = saved_comparison_local;
        if not binds then {
            let result = self.materialize(MIRValue.Operand(condition), result_type);
            return MIRExprResult(
                result_type,
                ValueCategory.RValue(),
                Option[MIROperand].Some(result),
                Option[MIRPlace].None(),
            );
        };
        return self.lower_binding_pattern_test(
            condition,
            subject_place,
            subject.expr_type,
            pattern,
            result_type,
        );
    };

    /// Liveness plus (on the alive edge) the strong-reference binding for
    /// `?name`. `is not ?name` keeps the negated liveness test and no binding:
    /// the name there is only a probe for death.
    private lower_weak_binding_pattern_test(
        self,
        subject_place: MIRPlace,
        subject_type: Type,
        pattern: TypedPattern,
        negated: Bool,
        result_type: Type,
    ): MIRExprResult = {
        let tag = self.materialize(
            MIRValue.EnumTag(
                MIREnumTag(
                    MIRValue.PlaceRead(subject_place, MIROwnershipUse.Borrow()),
                    subject_type,
                ),
            ),
            Type.IntType(),
        );
        // Niche layout: 0 = None, 1 = Some. Alive = tag != 0.
        let is_alive = self.materialize(
            MIRValue.Binary(
                MIRBinaryOperation(
                    tag,
                    MIRBinaryOperator.Comparison(ComparisonOperator.NotEqual()),
                    MIROperand.Constant(MIRConstant.Integer("0", Type.IntType())),
                    Type.BoolType(), unknown_span()),
            ),
            Type.BoolType(),
        );
        if negated then {
            return self.materialize_negated_bool(is_alive, result_type);
        };
        return self.lower_binding_pattern_test(
            is_alive,
            subject_place,
            subject_type,
            pattern,
            result_type,
        );
    };

    private materialize_negated_bool(
        self,
        operand: MIROperand,
        result_type: Type,
    ): MIRExprResult = {
        let flipped = self.materialize(
            MIRValue.Binary(
                MIRBinaryOperation(
                    operand,
                    MIRBinaryOperator.Comparison(ComparisonOperator.Equal()),
                    MIROperand.Constant(MIRConstant.Boolean(false)),
                    Type.BoolType(), unknown_span()),
            ),
            result_type,
        );
        return MIRExprResult(
            result_type,
            ValueCategory.RValue(),
            Option[MIROperand].Some(flipped),
            Option[MIRPlace].None(),
        );
    };

    /// The Bool result of a binding `is` test, with the pattern's slots filled
    /// on the matching edge. The cursor lands on the join block, which holds
    /// the result local.
    private lower_binding_pattern_test(
        self,
        condition: MIROperand,
        subject_place: MIRPlace,
        subject_type: Type,
        pattern: TypedPattern,
        result_type: Type,
    ): MIRExprResult = {
        let result_local = self.make_temporary(Type.BoolType(), "is_test");
        self.append_statement(MIRStatement.Declare(result_local.id));
        let condition_end = self.current_block_id();
        let bind_block = self.make_block();
        let fail_block = self.make_block();
        let join_block = self.make_block();
        self.set_current_block(condition_end);
        self.terminate(MIRTerminator.Branch(condition, bind_block, fail_block));

        self.set_current_block(bind_block);
        self.apply_pattern_bindings(
            pattern,
            subject_place,
            subject_type,
            PatternBindMode.Fill(),
        );
        self.append_statement(
            MIRStatement.Assign(
                MIRPlace.Local(result_local.id),
                MIRValue.Operand(MIROperand.Constant(MIRConstant.Boolean(true))),
            ),
        );
        self.terminate(MIRTerminator.Goto(join_block));

        self.set_current_block(fail_block);
        self.append_statement(
            MIRStatement.Assign(
                MIRPlace.Local(result_local.id),
                MIRValue.Operand(MIROperand.Constant(MIRConstant.Boolean(false))),
            ),
        );
        self.terminate(MIRTerminator.Goto(join_block));

        self.set_current_block(join_block);
        return MIRExprResult(
            result_type,
            ValueCategory.RValue(),
            Option[MIROperand].Some(MIROperand.Local(result_local.id)),
            Option[MIRPlace].None(),
        );
    };

    lower_pattern_condition(
        self,
        subject_place: MIRPlace,
        subject_type: Type,
        pattern: TypedPattern,
        negated: Bool,
    ): MIROperand = {
        // The subject the PATTERN was checked against: one pointer indirection
        // for every pattern except the raw-subject family (`null` and
        // trait-object tests), exactly the auto-deref the type checker did.
        let matched_subject = self.pattern_match_subject_place(
            subject_place,
            subject_type,
            pattern,
        );
        let matched_place = matched_subject.first;
        let matched_type = matched_subject.second;
        let peeled_pointer_subject = when subject_type in {
            .PointerType(_) or .MutablePointerType(_) then not typed_pattern_requires_raw_subject(pattern),
            _ then false,
        };
        if peeled_pointer_subject then {
            // The cached subject/tag describe the RAW subject; a peeled
            // pointer test must read through the deref instead.
            self.pattern_subject_operand = Option[MIROperand].None();
            self.pattern_subject_tag = Option[MIROperand].None();
        };
        when pattern in {
            .NotPattern(inner) then {
                return self.lower_pattern_condition(
                    matched_place,
                    matched_type,
                    inner,
                    not negated,
                );
            },
            .ListPattern(ops, elements) then {
                // Handles negation internally (the length condition forks).
                return self.lower_list_pattern_condition(
                    matched_place,
                    ops,
                    elements,
                    negated,
                );
            },
            .RestPattern() then {
                // A rest slot never reaches the lowerer on its own: the
                // enclosing element list expands or forwards it. Standing
                // alone it constrains nothing.
                return self.pattern_bool(not negated);
            },
            _ then {},
        };

        let operand = when pattern in {
            .Wildcard() or .Variable(_) then self.pattern_bool(true),
            .BoolLiteral(value) then self.pattern_compare(
                matched_place,
                matched_type,
                MIROperand.Constant(MIRConstant.Boolean(value)),
                ComparisonOperator.Equal(),
            ),
            .NullLiteral(result_type) then {
                // The pattern compares the subject against a null pointer at
                // the subject's own pointer type -- the same `nullPtr`
                // intrinsic a `== null` comparison lowers to.
                let null_operand = when self.lower_intrinsic_call(
                    TypedIntrinsic.NullPtr(result_type),
                ) in {
                    .Some(null_result) then null_result.operand or else MIROperand.Constant(
                            MIRConstant.Integer("0", result_type),
                        ),
                    .None() then MIROperand.Constant(
                        MIRConstant.Integer("0", result_type),
                    ),
                };
                self.pattern_compare(
                    matched_place,
                    matched_type,
                    null_operand,
                    ComparisonOperator.Equal(),
                )
            },
            .IntegerLiteral(value) then when self.rune_pattern_value_access(
                matched_place,
                matched_type,
            ) in {
                .Some(access) then self.pattern_compare(
                    access.first,
                    access.second,
                    MIROperand.Constant(MIRConstant.Integer(value, access.second)),
                    ComparisonOperator.Equal(),
                ),
                .None() then self.pattern_compare(
                    matched_place,
                    matched_type,
                    MIROperand.Constant(MIRConstant.Integer(value, matched_type)),
                    ComparisonOperator.Equal(),
                ),
            },
            .NegativeIntegerLiteral(value) then self.pattern_compare(
                matched_place,
                matched_type,
                MIROperand.Constant(MIRConstant.Integer("-\(value)", matched_type)),
                ComparisonOperator.Equal(),
            ),
            .FloatLiteral(value) then self.pattern_compare(
                matched_place,
                matched_type,
                self.pattern_literal_constant(value, matched_type),
                ComparisonOperator.Equal(),
            ),
            .EnumCase(case_name, tag_index, elements) then self.lower_enum_case_pattern_condition(
                matched_place,
                matched_type,
                case_name,
                tag_index,
                elements,
            ),
            .StructPattern(_, elements) then self.lower_struct_pattern_condition(
                matched_place,
                matched_type,
                elements,
            ),
            .ComparisonPattern(op, value) then {
                let comparison_op = when op in {
                    .Greater() then ComparisonOperator.Greater(),
                    .Less() then ComparisonOperator.Less(),
                    .GreaterEqual() then ComparisonOperator.GreaterEqual(),
                    .LessEqual() then ComparisonOperator.LessEqual(),
                };
                // A rune subject compares through its `value` field, the way a
                // rune equality pattern matches; the value is already a code
                // point. Everything else compares against its own domain.
                when self.rune_pattern_value_access(matched_place, matched_type) in {
                    .Some(access) then self.pattern_compare(
                        access.first,
                        access.second,
                        MIROperand.Constant(MIRConstant.Integer(value, access.second)),
                        comparison_op,
                    ),
                    .None() then self.pattern_compare(
                        matched_place,
                        matched_type,
                        self.pattern_literal_constant(value, matched_type),
                        comparison_op,
                    ),
                }
            },
            .AndPattern(left, right) then {
                let left_condition = self.lower_pattern_condition(
                    matched_place,
                    matched_type,
                    left,
                    false,
                );
                let right_condition = self.lower_pattern_condition(
                    matched_place,
                    matched_type,
                    right,
                    false,
                );
                self.pattern_binary(
                    left_condition,
                    MIRBinaryOperator.LogicalAnd(),
                    right_condition,
                )
            },
            .OrPattern(left, right) then {
                let left_condition = self.lower_pattern_condition(
                    matched_place,
                    matched_type,
                    left,
                    false,
                );
                let right_condition = self.lower_pattern_condition(
                    matched_place,
                    matched_type,
                    right,
                    false,
                );
                self.pattern_binary(
                    left_condition,
                    MIRBinaryOperator.LogicalOr(),
                    right_condition,
                )
            },
            .TraitObjectType(target_type) or .TraitObjectTypeBinding(_, target_type) then self.lower_trait_object_type_pattern_condition(
                matched_place,
                matched_type,
                target_type,
            ),
            .StringLiteral(value, equals_symbol) then self.pattern_string_compare(
                matched_place,
                matched_type,
                value,
                equals_symbol,
            ),
            .RuneLiteral(_) or .NotPattern(_) then self.pattern_bool(false),
            .WeakBinding(_) or .ListPattern(_, _) or .RestPattern() then self.pattern_bool(true),
        };
        return self.pattern_maybe_negate(operand, negated);
    };

    /// List patterns and rest patterns handle negation internally (the list
    /// condition forks), so they return before `pattern_maybe_negate`.

    /// The position a pattern slot reads in the subject list.
    ///
    /// Slots before the rest count forward from the front and are compile-time
    /// constants. Slots after it count back from the end, so their position is
    /// `count - k`.
    list_slot_index_operand(
        self,
        slot_index: UInt,
        elements: List[TypedPattern],
        count_value: MIROperand,
    ): MIROperand = {
        let mutable rest_index = -1;
        for pair in elements.lazy().enumerate() then {
            if pair.second is .RestPattern() then {
                rest_index = Int(pair.first);
                break;
            };
        };
        if rest_index >= 0 and Int(slot_index) > rest_index then {
            let from_end = elements.count() - slot_index;
            return self.materialize(
                MIRValue.Binary(
                    MIRBinaryOperation(
                        count_value,
                        MIRBinaryOperator.Arithmetic(
                            ArithmeticOperator.Subtract(),
                            false,
                        ),
                        MIROperand.Constant(
                            MIRConstant.Integer(from_end.to_string(), Type.UIntType()),
                        ),
                        Type.UIntType(), unknown_span()),
                ),
                Type.UIntType(),
            );
        };
        return MIROperand.Constant(
            MIRConstant.Integer(slot_index.to_string(), Type.UIntType()),
        );
    };

    /// The subject handle as a call receiver. A `type mutable` handle is
    /// refcounted, so the receiver is handed over as a counted COPY exactly as
    /// an ordinary `xs.count()` call does.
};
