// MIR function builder: the builder type, core block machinery, and the
// MIROperand helpers.

type MIRLoopBuilderContext(
    continue_block: MIRBlockID,
    break_block: MIRBlockID,
    scope_depth: Int,
);

/// What a pattern-binding walk is doing to each binding it reaches.
///
/// A plain pattern binds by ALIASING the payload place it reads from, which is
/// correct only while one layout covers the whole pattern. An `or` pattern
/// breaks that: its branches bind the same names from different payload
/// positions, so each name needs one slot that every branch fills from its own
/// layout. Claim/Fill split that across the branch, and the walk is
/// parameterised rather than written out twice.
type PatternBindMode {
    Alias(),
    Claim(),
    Fill(),
};

type mutable MIRFunctionBuilder(
    program: MonomorphizedProgram,
    identifier: Symbol,
    params: List[TypedParam],
    captured_symbols: List[Symbol],
    return_type: Type,
    kind: MIRFunctionKind,
    body: TypedExpr,
    context: CompilerContext,
    mutable next_local_id: Int,
    mutable next_block_id: Int,
    mutable next_scope_id: Int,
    mutable locals: List[MIRLocal],
    mutable blocks: List[MIRBasicBlock],
    mutable current_block_index: Int,
    mutable terminated_blocks: Set[Int],
    mutable local_by_def_id: Dict[UInt, MIRLocalID],
    mutable parameter_local_by_name: Dict[String, MIRLocalID],
    mutable pattern_place_by_def_id: Dict[UInt, MIRPlace],
    mutable pattern_place_by_name: Dict[String, MIRPlace],
    mutable loop_stack: List[MIRLoopBuilderContext],
    mutable scope_stack: List[MIRScopeID],
    mutable deferred_exprs_by_scope: Dict[Int, List[TypedExpr]],
    mutable pattern_subject_operand: Option[MIROperand],
    mutable pattern_subject_tag: Option[MIROperand],
    mutable pattern_comparison_local: Option[MIRLocalID],
    mutable temporary_value_source_locations: Dict[Int, MIRTemporaryValueSourceLocation],
    mutable ambiguous_temporary_value_source_locals: Set[Int],
    // Locals holding POINTERS RETURNED BY CALLS (built-in element slot
    // lookups). Loads through them must be materialized eagerly: a later
    // side effect can free the buffer the pointer addresses. Plain pointer
    // locals (a container's `source` field) are stable and keep the deferred
    // read the borrowed-parameter convention relies on.
    mutable call_derived_pointer_locals: Set[Int],
    // 在飞的对象锁临界区（Lock 已发、Unlock 未发）。早退（return / break /
    // continue）走出临界区时必须补释放，否则锁永远被持有、其他线程死锁
    // （concurrency-design.md §对象锁语义）。loop_depth 记获取时的循环深度：
    // break/continue 只释放「被退出的循环体内」取得的锁，外层语句临界区
    // 仍然合法持有。
    mutable diagnostics: DiagnosticCollector,
);

given MIRFunctionBuilder {
    public new(
        program: MonomorphizedProgram,
        identifier: Symbol,
        params: List[TypedParam],
        captured_symbols: List[Symbol],
        return_type: Type,
        kind: MIRFunctionKind,
        body: TypedExpr,
        context: CompilerContext,
    ): MIRFunctionBuilder = {
        return MIRFunctionBuilder(
            program,
            identifier,
            params,
            captured_symbols,
            return_type,
            kind,
            body,
            context,
            0,
            0,
            0,
            List[MIRLocal].new(),
            List[MIRBasicBlock].new(),
            0,
            Set[Int].new(),
            Dict[UInt, MIRLocalID].new(),
            Dict[String, MIRLocalID].new(),
            Dict[UInt, MIRPlace].new(),
            Dict[String, MIRPlace].new(),
            List[MIRLoopBuilderContext].new(),
            List[MIRScopeID].new(),
            Dict[Int, List[TypedExpr]].new(),
            Option[MIROperand].None(),
            Option[MIROperand].None(),
            Option[MIRLocalID].None(),
            Dict[Int, MIRTemporaryValueSourceLocation].new(),
            Set[Int].new(),
            Set[Int].new(),
            DiagnosticCollector.new(),
        );
    };

    public emitted_diagnostics(self): DiagnosticCollector = self.diagnostics;

    report_lowering_error(self, message: String): Void = {
        let file_path = self.context.get_source_file(self.identifier.def_id) or else "";
        let span = self.context.get_span(self.identifier.def_id) or else unknown_span();
        self.diagnostics.push(
            make_diagnostic(DiagnosticStage.Other(), file_path, message, span),
        );
    };

    public lower(self): MIRFunction = {
        let entry = self.append_block();
        let _ = entry;
        for param in self.params then {
            let local = self.make_local(
                param.name,
                param.param_type,
                MIRStorage.Parameter(),
                Option[Symbol].None(),
            );
            self.parameter_local_by_name.insert(param.name, local.id);
            self.append_statement(MIRStatement.Declare(local.id));
        };
        // A capture local is a HANDLE into the closure environment, not a
        // mutable slot: sema rejects a mutable capture outright
        // (`Cannot capture mutable variable ... hold the state in a Cell and
        // capture the cell instead`), so the mutability this used to compute
        // from `capture.is_mutable()` was never observable. The local is keyed
        // by the captured symbol's DefId and typed by its sema type.
        for capture in self.captured_symbols then {
            let local = self.make_local(
                self.context.symbol_name(capture),
                capture.symbol_type,
                MIRStorage.Capture(),
                Option[Symbol].Some(capture),
            );
            self.local_by_def_id.insert(capture.def_id.id, local.id);
            self.append_statement(MIRStatement.Declare(local.id));
        };
        let result = self.lower_expression(self.body);
        self.finish_implicit_return(result);
        return MIRFunction(
            self.identifier,
            self.params,
            self.return_type,
            self.kind,
            MIRBlockID(0),
            self.boxed_locals(),
            self.boxed_blocks(),
            self.temporary_value_source_locations,
        );
    };

    private append_block(self): MIRBlockID = {
        let id = MIRBlockID(self.next_block_id);
        self.next_block_id += 1;
        self.blocks.push(
            MIRBasicBlock(id, List[MIRStatement].new(), MIRTerminator.Unreachable()),
        );
        self.current_block_index = self.blocks.count() - 1;
        return id;
    };

    make_block(self): MIRBlockID = self.append_block();

    current_block_id(self): MIRBlockID = self.blocks[self.current_block_index].id;

    current_block_is_terminated(self): Bool =
        self.terminated_blocks.contains(self.current_block_id().raw_value);

    set_current_block(self, id: MIRBlockID): Void = {
        let found = self.blocks.lazy().position(
            (block) => block.id.raw_value == id.raw_value,
        );
        when found in {
            .Some(index) then {
                self.current_block_index = index;
            },
            .None() then {},
        };
    };

    append_statement(self, statement: MIRStatement): Void = {
        if self.current_block_is_terminated() then {
            return;
        };
        self.append_statement_to_block(self.blocks[self.current_block_index], statement);
    };

    terminate(self, terminator: MIRTerminator): Void = {
        if self.current_block_is_terminated() then {
            return;
        };
        let block_id = self.current_block_id();
        self.set_block_terminator(self.blocks[self.current_block_index], terminator);
        self.terminated_blocks.insert(block_id.raw_value);
    };

    private append_statement_to_block(
        self,
        block: MIRBasicBlock,
        statement: MIRStatement,
    ): Void = {
        self.record_temporary_value_source(block, statement);
        block.statements.push(statement);
    };

    private local_is_temporary(self, local_id: MIRLocalID): Bool = {
        if local_id.raw_value < self.locals.count() then {
            return self.locals[local_id.raw_value].storage is .Temporary();
        };
        return false;
    };

    private record_temporary_value_source(
        self,
        block: MIRBasicBlock,
        statement: MIRStatement,
    ): Void = {
        when statement in {
            .Assign(place, _) then when place in {
                .Local(local_id) then {
                    if not self.local_is_temporary(local_id) then {
                        return;
                    };
                    if self.ambiguous_temporary_value_source_locals.contains(
                        local_id.raw_value,
                    ) then {
                        return;
                    };
                    when self.temporary_value_source_locations.get(local_id.raw_value) in {
                        .Some(_) then {
                            let _ = self.temporary_value_source_locations.remove(
                                local_id.raw_value,
                            );
                            self.ambiguous_temporary_value_source_locals.insert(
                                local_id.raw_value,
                            );
                        },
                        .None() then {
                            self.temporary_value_source_locations.insert(
                                local_id.raw_value,
                                MIRTemporaryValueSourceLocation(
                                    self.current_block_index,
                                    block.statements.count(),
                                ),
                            );
                        },
                    };
                },
                _ then {},
            },
            _ then {},
        };
    };

    private set_block_terminator(
        self,
        block: MIRBasicBlock,
        terminator: MIRTerminator,
    ): Void = {
        let _ = self;
        block.terminator = terminator;
    };

    make_local(
        self,
        name: String,
        local_type: Type,
        storage: MIRStorage,
        symbol: Option[Symbol],
    ): MIRLocal = {
        let local = MIRLocal(
            MIRLocalID(self.next_local_id),
            name,
            local_type,
            storage,
            symbol,
        );
        self.next_local_id += 1;
        self.locals.push(local);
        return local;
    };

    make_temporary(self, local_type: Type, name_hint: String): MIRLocal = {
        return self.make_local(
            "\(name_hint)_\(self.next_local_id)",
            local_type,
            MIRStorage.Temporary(),
            Option[Symbol].None(),
        );
    };

    private boxed_locals(self): List[MIRLocal] = {
        let mutable boxed = List[MIRLocal].with_capacity(self.locals.count());
        for local in self.locals then {
            boxed.push(local);
        };
        return boxed;
    };

    private boxed_blocks(self): List[MIRBasicBlock] = {
        let mutable boxed = List[MIRBasicBlock].with_capacity(self.blocks.count());
        for block in self.blocks then {
            boxed.push(block);
        };
        return boxed;
    };

    make_scope_id(self): MIRScopeID = {
        let scope = MIRScopeID(self.next_scope_id);
        self.next_scope_id += 1;
        return scope;
    };

    private finish_implicit_return(self, result: Option[MIRExprResult]): Void = {
        if self.current_block_is_terminated() then {
            return;
        };
        if self.type_is_never(self.body.expr_type) or self.type_is_never(
            self.return_type,
        ) then {
            self.terminate(MIRTerminator.Unreachable());
            return;
        };
        if self.type_is_void(self.return_type) then {
            // 防御性：函数末的隐式返回也走同一释放规则（正常情况下此处无
            // 在飞锁——语句临界区都在语句内闭合）。
                        self.terminate(MIRTerminator.ReturnValue(Option[MIROperand].None()));
            return;
        };
        when self.return_operand(result) in {
            .Some(operand) then {
                                self.terminate(
                    MIRTerminator.ReturnValue(Option[MIROperand].Some(operand)),
                );
            },
            .None() then self.terminate(MIRTerminator.Unreachable()),
        };
    };

    return_operand(self, result: Option[MIRExprResult]): Option[MIROperand] = {
        return when result in {
            .Some(value) then when value.operand in {
                .Some(operand) then Option[MIROperand].Some(
                    self.adapt_operand_to_expected_type(
                        operand,
                        value.result_type,
                        self.return_type,
                    ),
                ),
                .None() then when value.place in {
                    .Some(place) then when place in {
                        .Local(local) then {
                            let mutable local_type = self.type_of_local(local);
                            if local_type == self.return_type then Option[MIROperand].Some(
                                MIROperand.Local(local),
                            )
                            else Option[MIROperand].Some(
                                self.materialize(
                                    self.read_place_for_expected_type(
                                        place,
                                        local_type,
                                        self.return_type,
                                    ),
                                    self.return_type,
                                ),
                            )
                        },
                        _ then Option[MIROperand].Some(
                            self.materialize(
                                self.read_place_for_expected_type(
                                    place,
                                    value.result_type,
                                    self.return_type,
                                ),
                                self.return_type,
                            ),
                        ),
                    },
                    .None() then Option[MIROperand].None(),
                },
            },
            .None() then Option[MIROperand].None(),
        };
    };

    type_of_local(self, local_id: MIRLocalID): Type = {
        for local in self.locals then {
            if local.id.raw_value == local_id.raw_value then {
                return local.local_type;
            };
        };
        return Type.Unknown();
    };

    private ref_like_inner_type(self, t: Type): Option[Type] = {
        let _ = self;
        return when t in {
            .ReferenceType(inner_ref) or .MutableReferenceType(inner_ref) or .BorrowedReferenceType(inner_ref)
            or .MutableBorrowedReferenceType(inner_ref) or .WeakReferenceType(inner_ref)
            or .MutableWeakReferenceType(inner_ref) then Option[Type].Some(inner_ref),
            _ then Option[Type].None(),
        };
    };

    private adapt_place_for_expected_type(
        self,
        place: MIRPlace,
        actual_type: Type,
        expected_type: Type,
    ): Option[MIRPlace] = {
        let expected_is_ref_like = self.is_ref_like_type(expected_type);
        let mutable current_place = place;
        let mutable current_type = actual_type;
        let mutable changed = false;

        while current_type != expected_type then {
            when self.ref_like_inner_type(current_type) in {
                .Some(pointee_type) then {
                    if expected_is_ref_like and pointee_type != expected_type then {
                        break;
                    };
                    current_place = MIRPlace.Deref(
                        MIRValue.PlaceRead(current_place, MIROwnershipUse.Borrow()),
                        pointee_type,
                    );
                    current_type = pointee_type;
                    changed = true;
                },
                .None() then {
                    break;
                },
            };
        };

        return if changed and current_type == expected_type then Option[MIRPlace].Some(
            current_place,
        ) else Option[MIRPlace].None();
    };

    /// Whether the expression's value is a pointer produced by a call (the
    /// built-in element slot shape, possibly wrapped in a block): loads
    /// through such pointers must run eagerly.
    expr_lowers_to_pointer_call(self, expr: TypedExpr): Bool = {
        return when expr.expr_kind in {
            .Call(_, _) then true,
            .Block(_, tail) then when tail in {
                .Some(inner) then self.expr_lowers_to_pointer_call(inner),
                .None() then false,
            },
            _ then false,
        };
    };

    /// Whether a load through this place must run eagerly: the place reaches
    /// through a pointer RETURNED BY A CALL (a built-in element slot), and a
    /// later side effect can free the buffer that pointer addresses. A plain
    /// pointer local (a container's `source` field) is stable, so reads
    /// through it keep the deferred form the borrowed-parameter convention
    /// relies on.
    place_needs_eager_load(self, place: MIRPlace): Bool = {
        return when place in {
            .Deref(value, _) or .PointerElement(value, _) then when value in {
                .PlaceRead(inner_place, _) then when inner_place in {
                    .Local(local_id) then self.call_derived_pointer_locals.contains(
                        local_id.raw_value,
                    ),
                    _ then false,
                },
                .Operand(operand) then when operand in {
                    .Local(local_id) then self.call_derived_pointer_locals.contains(
                        local_id.raw_value,
                    ),
                    _ then false,
                },
                _ then false,
            },
            .Field(base, _) or .EnumPayload(base, _, _, _, _) then self.place_needs_eager_load(
                base,
            ),
            .Local(_) or .Global(_) then false,
        };
    };

    /// Record that `source` holds a pointer produced by a call, so loads
    /// through it are materialized eagerly (see place_needs_eager_load).
    mark_call_derived_pointer(self, source: MIRValue): Void = {
        when source in {
            .PlaceRead(inner_place, _) then when inner_place in {
                .Local(local_id) then {
                    self.call_derived_pointer_locals.insert(local_id.raw_value);
                },
                _ then {},
            },
            .Operand(operand) then when operand in {
                .Local(local_id) then {
                    self.call_derived_pointer_locals.insert(local_id.raw_value);
                },
                _ then {},
            },
            _ then {},
        };
    };

    read_place_for_expected_type(
        self,
        place: MIRPlace,
        actual_type: Type,
        expected_type: Type,
    ): MIRValue = {
        // 锁定对象的字段读 / 可变全局绑定读不走延迟读：装载必须包在所属
        // 对象锁的临界区里（concurrency-design.md §对象锁语义 1）。
        if self.place_locked_relevant(place) then {
            return MIRValue.Operand(
                self.materialize_place_for_expected_type(place, expected_type),
            );
        };
        // A load through a call-produced pointer (an element slot) is
        // materialized HERE, at the read's evaluation position: later
        // instructions can run side effects (a call argument that grows the
        // container), and a deferred load would read through an already
        // invalidated slot pointer. Everything else keeps the deferred read:
        // the call convention passes non-escaping parameters straight from
        // their locals, and a materialized copy would add retain/drop churn
        // in hot loops.
        if self.place_needs_eager_load(place) then {
            return when self.adapt_place_for_expected_type(place, actual_type, expected_type) in {
                .Some(adapted_place) then MIRValue.Operand(
                    self.materialize(
                        MIRValue.PlaceRead(adapted_place, MIROwnershipUse.Copy()),
                        expected_type,
                    ),
                ),
                .None() then MIRValue.Operand(
                    self.materialize(
                        MIRValue.PlaceRead(place, MIROwnershipUse.Copy()),
                        actual_type,
                    ),
                ),
            };
        };
        return when self.adapt_place_for_expected_type(place, actual_type, expected_type) in {
            .Some(adapted_place) then MIRValue.PlaceRead(
                adapted_place,
                MIROwnershipUse.Copy(),
            ),
            .None() then MIRValue.PlaceRead(place, MIROwnershipUse.Copy()),
        };
    };

    materialize_place_for_expected_type(
        self,
        place: MIRPlace,
        expected_type: Type,
    ): MIROperand = {
        let mutable actual_type = self.place_type(place);
        return when self.adapt_place_for_expected_type(place, actual_type, expected_type) in {
            .Some(adapted_place) then self.materialize(
                MIRValue.PlaceRead(adapted_place, MIROwnershipUse.Copy()),
                expected_type,
            ),
            .None() then self.materialize(
                MIRValue.PlaceRead(place, MIROwnershipUse.Copy()),
                actual_type,
            ),
        };
    };

    adapt_operand_to_expected_type(
        self,
        operand: MIROperand,
        actual_type: Type,
        expected_type: Type,
    ): MIROperand = {
        return when operand in {
            .Local(local_id) then {
                when self.adapt_place_for_expected_type(
                    MIRPlace.Local(local_id),
                    actual_type,
                    expected_type,
                ) in {
                    .Some(adapted_place) then self.materialize(
                        MIRValue.PlaceRead(adapted_place, MIROwnershipUse.Copy()),
                        expected_type,
                    ),
                    .None() then operand,
                }
            },
            _ then operand,
        };
    };
};

given MIROperand {
    local_id_or_zero(self): MIRLocalID = {
        return when self in {
            .Local(id) then id,
            _ then MIRLocalID(0),
        };
    };
};
