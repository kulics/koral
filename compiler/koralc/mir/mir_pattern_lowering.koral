// MIR lowering: list/pattern subjects, pattern tests, and pattern
// dispatch helpers.

given MIRFunctionBuilder {
    private list_subject_argument(self, place: MIRPlace): MIRValue = {
        return MIRValue.PlaceRead(place, MIROwnershipUse.Copy());
    };

    /// `xs.count()`, the subject's length.
    private list_count_value(
        self,
        subject_place: MIRPlace,
        ops: ListPatternOps,
    ): MIROperand = {
        let mutable count_args = List[MIRValue].new();
        count_args.push(self.list_subject_argument(subject_place));
        let mutable count_owns = List[MIROwnershipUse].new();
        count_owns.push(MIROwnershipUse.Copy());
        return self.materialize(
            MIRValue.Call(
                MIRCall(
                    MIROperand.Function(ops.count_symbol),
                    count_args,
                    count_owns,
                    Type.UIntType(),
                ),
            ),
            Type.UIntType(),
        );
    };

    /// Read one element out of the subject list into a fresh local. A list
    /// element sits behind a computed index, so there is no stable place to
    /// alias; it is copied out first and everything below destructures that
    /// value. The observable semantics is `let x = xs[i]`.
    private materialize_list_slot(
        self,
        subject_place: MIRPlace,
        ops: ListPatternOps,
        slot_index: UInt,
        elements: List[TypedPattern],
        count_value: MIROperand,
    ): MIRPlace = {
        let index_value = self.list_slot_index_operand(slot_index, elements, count_value);
        let mutable idx_args = List[MIRValue].new();
        idx_args.push(self.list_subject_argument(subject_place));
        idx_args.push(MIRValue.Operand(index_value));
        let mutable idx_owns = List[MIROwnershipUse].new();
        idx_owns.push(MIROwnershipUse.Copy());
        idx_owns.push(MIROwnershipUse.Move());
        let element_value = self.materialize(
            MIRValue.Call(
                MIRCall(
                    MIROperand.Function(ops.index_symbol),
                    idx_args,
                    idx_owns,
                    ops.element_type,
                ),
            ),
            ops.element_type,
        );
        let local = self.make_temporary(ops.element_type, "list_elem");
        self.append_statement(MIRStatement.Declare(local.id));
        self.append_statement(
            MIRStatement.Assign(
                MIRPlace.Local(local.id),
                MIRValue.Operand(element_value),
            ),
        );
        return MIRPlace.Local(local.id);
    };

    /// Compile a list pattern to a Bool: the length test first, then the slot
    /// tests. The length test FORKS so a slot is never read out of bounds.
    lower_list_pattern_condition(
        self,
        subject_place: MIRPlace,
        ops: ListPatternOps,
        elements: List[TypedPattern],
        negated: Bool,
    ): MIROperand = {
        let mutable rest_index = -1;
        let mutable fixed_slot_indices = List[UInt].new();
        for pair in elements.lazy().enumerate() then {
            if pair.second is .RestPattern() then {
                rest_index = Int(pair.first);
            } else {
                fixed_slot_indices.push(pair.first);
            };
        };
        let bound = fixed_slot_indices.count();
        let length_op = if rest_index < 0 then ComparisonOperator.Equal()
        else ComparisonOperator.GreaterEqual();

        let count_value = self.list_count_value(subject_place, ops);
        let length_condition = self.materialize(
            MIRValue.Binary(
                MIRBinaryOperation(
                    count_value,
                    MIRBinaryOperator.Comparison(length_op),
                    MIROperand.Constant(
                        MIRConstant.Integer(bound.to_string(), Type.UIntType()),
                    ),
                    Type.BoolType(), unknown_span()),
            ),
            Type.BoolType(),
        );

        // Nothing left to test once the length is right: `[...]`, `[_, _]`.
        let mutable needs_slot_tests = false;
        for element in elements then {
            if not typed_pattern_is_conditionless_payload(element) then {
                needs_slot_tests = true;
            };
        };
        if not needs_slot_tests then {
            if negated then {
                return self.materialize(
                    MIRValue.Unary(
                        MIRUnaryOperation(
                            MIRUnaryOperator.LogicalNot(),
                            length_condition,
                            Type.BoolType(), unknown_span()),
                    ),
                    Type.BoolType(),
                );
            };
            return length_condition;
        };

        let result_local = self.make_temporary(Type.BoolType(), "pattern_match");
        self.append_statement(MIRStatement.Declare(result_local.id));

        let branch_block = self.current_block_id();
        let slots_block = self.make_block();
        let failed_block = self.make_block();
        let join_block = self.make_block();

        self.set_current_block(branch_block);
        self.terminate(
            MIRTerminator.Branch(length_condition, slots_block, failed_block),
        );

        self.set_current_block(slots_block);
        let mutable slots_result = MIROperand.Constant(MIRConstant.Boolean(true));
        // A slot is its own subject: clear the cached subject before recursing,
        // the way nested enum payloads do. Otherwise an inner pattern would
        // read the OUTER list as though it were the slot's value.
        let saved_slot_source = self.pattern_subject_operand;
        let saved_slot_tag = self.pattern_subject_tag;
        let saved_slot_comparison = self.pattern_comparison_local;
        self.pattern_subject_operand = Option[MIROperand].None();
        self.pattern_subject_tag = Option[MIROperand].None();
        self.pattern_comparison_local = Option[MIRLocalID].None();
        for slot_index in fixed_slot_indices then {
            let element = elements[slot_index];
            let element_place = self.materialize_list_slot(
                subject_place,
                ops,
                slot_index,
                elements,
                count_value,
            );
            let slot_condition = self.lower_pattern_condition(
                element_place,
                ops.element_type,
                element,
                false,
            );
            self.pattern_subject_operand = Option[MIROperand].None();
            self.pattern_subject_tag = Option[MIROperand].None();
            self.pattern_comparison_local = Option[MIRLocalID].None();
            slots_result = self.materialize(
                MIRValue.Binary(
                    MIRBinaryOperation(
                        slots_result,
                        MIRBinaryOperator.LogicalAnd(),
                        slot_condition,
                        Type.BoolType(), unknown_span()),
                ),
                Type.BoolType(),
            );
        };
        self.pattern_subject_operand = saved_slot_source;
        self.pattern_subject_tag = saved_slot_tag;
        self.pattern_comparison_local = saved_slot_comparison;
        if negated then {
            slots_result = self.materialize(
                MIRValue.Unary(
                    MIRUnaryOperation(
                        MIRUnaryOperator.LogicalNot(),
                        slots_result,
                        Type.BoolType(), unknown_span()),
                ),
                Type.BoolType(),
            );
        };
        if not self.current_block_is_terminated() then {
            self.append_statement(
                MIRStatement.Assign(
                    MIRPlace.Local(result_local.id),
                    MIRValue.Operand(slots_result),
                ),
            );
            self.terminate(MIRTerminator.Goto(join_block));
        };

        self.set_current_block(failed_block);
        self.append_statement(
            MIRStatement.Assign(
                MIRPlace.Local(result_local.id),
                MIRValue.Operand(MIROperand.Constant(MIRConstant.Boolean(negated))),
            ),
        );
        self.terminate(MIRTerminator.Goto(join_block));

        self.set_current_block(join_block);
        return MIROperand.Local(result_local.id);
    };

    lower_trait_object_type_pattern_condition(
        self,
        subject_place: MIRPlace,
        subject_type: Type,
        target_type: Type,
    ): MIROperand = {
        let trait_ref = self.trait_object_ref(subject_type);
        let trait_name = trait_ref.trait_name;
        if trait_name.is_empty() then {
            return self.pattern_bool(false);
        };
        let trait_def_id = trait_ref.trait_def_id;
        let trait_args = trait_ref.trait_type_args;
        let concrete_type = when target_type in {
            .ReferenceType(inner) or .MutableReferenceType(inner) then inner,
            .StructureType(_) or .EnumType(_) or .GenericStruct(...) or .GenericEnum(...) then target_type,
            _ then Type.Unknown(),
        };
        let subject_value = MIRValue.PlaceRead(subject_place, MIROwnershipUse.Borrow());
        let match_value = MIRValue.Intrinsic(
            MIRIntrinsic.TraitObjectMatches(
                subject_value,
                trait_name,
                trait_def_id,
                trait_args,
                concrete_type,
            ),
        );
        return self.materialize(match_value, Type.BoolType());
    };

    /// The constant a literal pattern compares against: a float spelling for a
    /// float subject (it takes the subject's width, so `1.1` against `Float32`
    /// is `Float32(1.1)`), an integer otherwise.
    pattern_literal_constant(
        self,
        value: String,
        subject_type: Type,
    ): MIROperand = {
        if self.is_float_type(subject_type) then {
            return MIROperand.Constant(MIRConstant.Float(value, subject_type));
        };
        return MIROperand.Constant(MIRConstant.Integer(value, subject_type));
    };

    pattern_bool(self, value: Bool): MIROperand = {
        return MIROperand.Constant(MIRConstant.Boolean(value));
    };

    pattern_compare(
        self,
        subject_place: MIRPlace,
        subject_type: Type,
        expected: MIROperand,
        op: ComparisonOperator,
    ): MIROperand = {
        let subject_operand = self.materialize(
            MIRValue.PlaceRead(subject_place, MIROwnershipUse.Borrow()),
            subject_type,
        );
        let comparison_value = MIRValue.Binary(
            MIRBinaryOperation(
                subject_operand,
                MIRBinaryOperator.Comparison(op),
                expected,
                Type.BoolType(), unknown_span()),
        );
        // Reuse a single comparison result local across all arms when available.
        // This significantly reduces MIR local count for pattern-heavy code.
        when self.pattern_comparison_local in {
            .Some(local_id) then {
                self.append_statement(
                    MIRStatement.Assign(MIRPlace.Local(local_id), comparison_value),
                );
                return MIROperand.Local(local_id);
            },
            .None() then {
                return self.materialize(comparison_value, Type.BoolType());
            },
        };
    };

    rune_pattern_value_access(
        self,
        subject_place: MIRPlace,
        subject_type: Type,
    ): Option[Pair[MIRPlace, Type]] = {
        return when subject_type in {
            .StructureType(def_id) then {
                // std's `Rune` by declaration identity, not by spelling. Swift
                // already decided this with `isStdNominal(defId, stdRuneDefId)`.
                if not is_std_rune_def_id(self.context, def_id) then {
                    return Option[Pair[MIRPlace, Type]].None();
                };
                when self.context.get_struct_fields(def_id) in {
                    .Some(fields) then {
                        for field in fields then {
                            if field.name == "value" then {
                                let field_symbol = self.make_synthetic_symbol(
                                    field.name,
                                    field.field_type,
                                );
                                return Option[Pair[MIRPlace, Type]].Some(
                                    Pair[MIRPlace, Type](
                                        MIRPlace.Field(subject_place, field_symbol),
                                        field.field_type,
                                    ),
                                );
                            };
                        };
                    },
                    .None() then {},
                };
                Option[Pair[MIRPlace, Type]].None()
            },
            _ then Option[Pair[MIRPlace, Type]].None(),
        };
    };

    pattern_string_compare(
        self,
        subject_place: MIRPlace,
        subject_type: Type,
        value: String,
        equals_symbol: Symbol,
    ): MIROperand = {
        let mutable matched_type = self.receiver_lookup_type(subject_type);
        return when Option[Symbol].Some(equals_symbol) in {
            .Some(equals_symbol) then {
                let subject_value = MIRValue.PlaceRead(
                    subject_place,
                    MIROwnershipUse.Copy(),
                );
                let mutable args = List[MIRValue].new();
                args.push(subject_value);
                args.push(
                    MIRValue.Operand(
                        MIROperand.Constant(
                            MIRConstant.StringLiteral(value, matched_type),
                        ),
                    ),
                );
                let mutable ownerships = List[MIROwnershipUse].new();
                ownerships.push(MIROwnershipUse.Copy());
                ownerships.push(MIROwnershipUse.Move());
                self.materialize(
                    MIRValue.Call(
                        MIRCall(
                            MIROperand.Function(equals_symbol),
                            args,
                            ownerships,
                            Type.BoolType(),
                        ),
                    ),
                    Type.BoolType(),
                )
            },
            .None() then self.pattern_bool(false),
        };
    };

    pattern_binary(
        self,
        left: MIROperand,
        op: MIRBinaryOperator,
        right: MIROperand,
    ): MIROperand = {
        let value = MIRValue.Binary(
            MIRBinaryOperation(left, op, right, Type.BoolType(), unknown_span()),
        );
        if self.pattern_comparison_local is .Some(local_id) then {
            self.append_statement(MIRStatement.Assign(MIRPlace.Local(local_id), value));
            return MIROperand.Local(local_id);
        };
        return self.materialize(value, Type.BoolType());
    };

    pattern_maybe_negate(self, operand: MIROperand, negated: Bool): MIROperand = {
        if negated then {
            let value = MIRValue.Unary(
                MIRUnaryOperation(MIRUnaryOperator.LogicalNot(), operand, Type.BoolType(), unknown_span()),
            );
            if self.pattern_comparison_local is .Some(local_id) then {
                self.append_statement(
                    MIRStatement.Assign(MIRPlace.Local(local_id), value),
                );
                return MIROperand.Local(local_id);
            };
            return self.materialize(value, Type.BoolType());
        };
        return operand;
    };

    lower_enum_case_pattern_condition(
        self,
        subject_place: MIRPlace,
        subject_type: Type,
        case_name: String,
        tag_index: UInt,
        elements: List[TypedPatternElement],
    ): MIROperand = {
        // Reuse the cached tag operand when available to avoid creating redundant
        // temporaries across when/if branches (matches Swift compiler optimization).
        let tag_operand = self.pattern_subject_tag or else {
            let subject_source = when self.pattern_subject_operand in {
                .Some(op) then MIRValue.Operand(op),
                .None() then MIRValue.PlaceRead(
                    subject_place,
                    MIROwnershipUse.Borrow(),
                ),
            };
            let tag_value = MIRValue.EnumTag(
                MIREnumTag(subject_source, subject_type),
            );
            let tag = self.materialize(tag_value, Type.IntType());
            self.pattern_subject_tag = Option[MIROperand].Some(tag);
            tag
        };
        let expected_tag = MIROperand.Constant(
            MIRConstant.Integer(tag_index.to_string(), Type.IntType()),
        );
        let tag_comparison = MIRValue.Binary(
            MIRBinaryOperation(
                tag_operand,
                MIRBinaryOperator.Comparison(ComparisonOperator.Equal()),
                expected_tag,
                Type.BoolType(), unknown_span()),
        );
        // Reuse comparison local when available to reduce MIR local count.
        let tag_condition = when self.pattern_comparison_local in {
            .Some(local_id) then {
                self.append_statement(
                    MIRStatement.Assign(MIRPlace.Local(local_id), tag_comparison),
                );
                MIROperand.Local(local_id)
            },
            .None() then self.materialize(tag_comparison, Type.BoolType()),
        };

        if self.pattern_elements_are_conditionless(elements) then {
            return tag_condition;
        };

        let mutable case_info_opt = Option[EnumCaseInfo].None();
        when subject_type in {
            .EnumType(def_id) then {
                when self.context.get_enum_cases(def_id) in {
                    .Some(cases) then {
                        if tag_index < cases.count() then {
                            case_info_opt = Option[EnumCaseInfo].Some(cases[tag_index]);
                        };
                    },
                    .None() then {},
                };
            },
            _ then {},
        };

        when case_info_opt in {
            .Some(case_info) then {
                if not (case_info.params.count() == elements.count()) then {
                    return self.pattern_bool(false);
                };
                let result_local = self.make_temporary(Type.BoolType(), "pattern_match");
                self.append_statement(MIRStatement.Declare(result_local.id));
                let branch_block = self.current_block_id();
                let payload_block = self.make_block();
                let failed_block = self.make_block();
                let join_block = self.make_block();

                self.set_current_block(branch_block);
                self.terminate(
                    MIRTerminator.Branch(tag_condition, payload_block, failed_block),
                );

                self.set_current_block(payload_block);
                let mutable payload_result = self.pattern_bool(true);
                // The cached tag and comparison local describe the SUBJECT we just
                // tested. A nested payload is a different value with its own tag, so
                // clear both before recursing -- otherwise the inner pattern
                // compares the OUTER enum's tag against the INNER case index and
                // matches the wrong arm (or none at all).
                let saved_nested_source = self.pattern_subject_operand;
                let saved_nested_tag = self.pattern_subject_tag;
                let saved_nested_comparison = self.pattern_comparison_local;
                self.pattern_subject_operand = Option[MIROperand].None();
                self.pattern_subject_tag = Option[MIROperand].None();
                self.pattern_comparison_local = Option[MIRLocalID].None();
                for pair in elements.lazy().enumerate() then {
                    let param = case_info.params[pair.first];
                    let payload_place = MIRPlace.EnumPayload(
                        subject_place,
                        case_name,
                        param.name,
                        pair.first,
                        param.param_type,
                    );
                    let payload_condition = self.lower_pattern_condition(
                        payload_place,
                        param.param_type,
                        pair.second.pattern,
                        false,
                    );
                    payload_result = self.pattern_binary(
                        payload_result,
                        MIRBinaryOperator.LogicalAnd(),
                        payload_condition,
                    );
                    self.pattern_subject_operand = Option[MIROperand].None();
                    self.pattern_subject_tag = Option[MIROperand].None();
                    self.pattern_comparison_local = Option[MIRLocalID].None();
                };
                self.pattern_subject_operand = saved_nested_source;
                self.pattern_subject_tag = saved_nested_tag;
                self.pattern_comparison_local = saved_nested_comparison;
                if not self.current_block_is_terminated() then {
                    self.append_statement(
                        MIRStatement.Assign(
                            MIRPlace.Local(result_local.id),
                            MIRValue.Operand(payload_result),
                        ),
                    );
                    self.terminate(MIRTerminator.Goto(join_block));
                };

                self.set_current_block(failed_block);
                self.append_statement(
                    MIRStatement.Assign(
                        MIRPlace.Local(result_local.id),
                        MIRValue.Operand(self.pattern_bool(false)),
                    ),
                );
                self.terminate(MIRTerminator.Goto(join_block));

                self.set_current_block(join_block);
                return MIROperand.Local(result_local.id);
            },
            .None() then {
                if not elements.is_empty() then {
                    return self.pattern_bool(false);
                };
            },
        };

        return tag_condition;
    };

    private pattern_elements_are_conditionless(
        self,
        elements: List[TypedPatternElement],
    ): Bool = {
        for element in elements then {
            if not typed_pattern_is_conditionless_payload(element.pattern) then {
                return false;
            };
        };
        return true;
    };

    lower_struct_pattern_condition(
        self,
        subject_place: MIRPlace,
        subject_type: Type,
        elements: List[TypedPatternElement],
    ): MIROperand = {
        let matched = self.pattern_match_place(subject_place, subject_type);
        let matched_place = matched.first;
        let matched_type = matched.second;
        let mutable fields_opt = Option[List[StructField]].None();
        when matched_type in {
            .StructureType(def_id) then {
                fields_opt = self.context.get_struct_fields(def_id);
            },
            _ then {},
        };
        when fields_opt in {
            .Some(fields) then {
                if fields.count() < elements.count() then {
                    return self.pattern_bool(false);
                };
                let mutable condition = self.pattern_bool(true);
                // Same as for enum payloads: a nested field is a different value,
                // so the cached subject tag/comparison must not leak into it.
                let saved_nested_source = self.pattern_subject_operand;
                let saved_nested_tag = self.pattern_subject_tag;
                let saved_nested_comparison = self.pattern_comparison_local;
                self.pattern_subject_operand = Option[MIROperand].None();
                self.pattern_subject_tag = Option[MIROperand].None();
                self.pattern_comparison_local = Option[MIRLocalID].None();
                for pair in elements.lazy().zip[
                    StructField,
                    ListIterator[StructField],
                    List[StructField],
                ](fields) then {
                    self.pattern_subject_operand = Option[MIROperand].None();
                    self.pattern_subject_tag = Option[MIROperand].None();
                    self.pattern_comparison_local = Option[MIRLocalID].None();
                    let field = pair.second;
                    let field_symbol = self.make_synthetic_symbol(
                        field.name,
                        field.field_type,
                    );
                    let field_place = MIRPlace.Field(matched_place, field_symbol);
                    let field_condition = self.lower_pattern_condition(
                        field_place,
                        field.field_type,
                        pair.first.pattern,
                        false,
                    );
                    condition = self.pattern_binary(
                        condition,
                        MIRBinaryOperator.LogicalAnd(),
                        field_condition,
                    );
                };
                self.pattern_subject_operand = saved_nested_source;
                self.pattern_subject_tag = saved_nested_tag;
                self.pattern_comparison_local = saved_nested_comparison;
                return condition;
            },
            .None() then {},
        };
        return if elements.is_empty() then self.pattern_bool(true)
        else self.pattern_bool(false);
    };

    private with_pattern_bindings(
        self,
        pattern: TypedPattern,
        subject_place: MIRPlace,
        subject_type: Type,
        body: () -> Void,
    ): Void = {
        let saved_pattern_places = self.pattern_place_by_def_id.clone();
        let saved_pattern_names = self.pattern_place_by_name.clone();
        self.bind_pattern_variables(pattern, subject_place, subject_type);
        body();
        self.pattern_place_by_def_id = saved_pattern_places;
        self.pattern_place_by_name = saved_pattern_names;
    };

    pattern_match_place(
        self,
        place: MIRPlace,
        subject_type: Type,
    ): Pair[MIRPlace, Type] = {
        let _ = self;
        return when subject_type in {
            .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner)
            or .MutableBorrowedReferenceType(inner) or .WeakReferenceType(inner)
            or .MutableWeakReferenceType(inner) then Pair[MIRPlace, Type](
                MIRPlace.Deref(
                    MIRValue.PlaceRead(place, MIROwnershipUse.Borrow()),
                    inner,
                ),
                inner,
            ),
            _ then Pair[MIRPlace, Type](place, subject_type),
        };
    };

    /// The subject place/type a pattern test reads: one level of indirection
    /// off -- managed references, weak handles and raw pointers alike --
    /// exactly when the type checker auto-dereffed the subject for this
    /// pattern. A `null` or trait-object test keeps the RAW subject: the null
    /// pattern compares the pointer itself and the trait-object match runs on
    /// the handle.
    pattern_match_subject_place(
        self,
        place: MIRPlace,
        subject_type: Type,
        pattern: TypedPattern,
    ): Pair[MIRPlace, Type] = {
        if typed_pattern_requires_raw_subject(pattern) then {
            return Pair[MIRPlace, Type](place, subject_type);
        };
        let matched = self.pattern_match_place(place, subject_type);
        return when matched.second in {
            .PointerType(inner) or .MutablePointerType(inner) then Pair[MIRPlace, Type](
                MIRPlace.Deref(
                    MIRValue.PlaceRead(matched.first, MIROwnershipUse.Borrow()),
                    inner,
                ),
                inner,
            ),
            _ then matched,
        };
    };

    private goes_through_deref(self, place: MIRPlace): Bool = {
        let _ = self;
        return when place in {
            .Deref(_, _) then true,
            .Field(base, _) or .EnumPayload(base, _, _, _, _) then self.goes_through_deref(base),
            .Local(_) or .Global(_) or .PointerElement(_, _) then false,
        };
    };

    /// Establish the bindings of an already-matched pattern by aliasing the
    /// payload places they read from.
    bind_pattern_variables(
        self,
        pattern: TypedPattern,
        subject_place: MIRPlace,
        subject_type: Type,
    ): Void = {
        self.apply_pattern_bindings(
            pattern,
            subject_place,
            subject_type,
            PatternBindMode.Alias(),
        );
    };

    /// One structural walk over a pattern's bindings. The recursion that finds
    /// the payload place of each leaf is shared by all three modes; only what
    /// happens to a binding once its place is known differs.
    apply_pattern_bindings(
        self,
        pattern: TypedPattern,
        subject_place: MIRPlace,
        subject_type: Type,
        mode: PatternBindMode,
    ): Void = {
        let matched = self.pattern_match_subject_place(
            subject_place,
            subject_type,
            pattern,
        );
        let matched_place = matched.first;
        let matched_type = matched.second;
        when pattern in {
            .WeakBinding(symbol) then {
                // The subject is the upgrade result (`Option[T]`). Extract the
                // Some payload from the Option place (not the unwrapped inner).
                let binding_type = self.pattern_binding_type(symbol, subject_type);
                if binding_type is not .VoidType() then {
                    let payload_place = MIRPlace.EnumPayload(
                        subject_place,
                        "Some",
                        "value",
                        0,
                        binding_type,
                    );
                    let binding_name = self.context.symbol_name(symbol);
                    when mode in {
                        .Alias() then {
                            self.pattern_place_by_def_id.insert(
                                symbol.def_id.id,
                                payload_place,
                            );
                            self.pattern_place_by_name.insert(
                                binding_name,
                                payload_place,
                            );
                        },
                        .Claim() then {
                            // Declare only: the payload read belongs to the
                            // matching edge (Fill), never to a path where the
                            // pattern failed and the payload is another
                            // variant's memory.
                            if self.pattern_place_by_def_id.get(symbol.def_id.id) is .None() then {
                                let bind_local = self.make_temporary(
                                    binding_type,
                                    "weak_bind",
                                );
                                self.append_statement(
                                    MIRStatement.Declare(bind_local.id),
                                );
                                self.pattern_place_by_def_id.insert(
                                    symbol.def_id.id,
                                    MIRPlace.Local(bind_local.id),
                                );
                                self.pattern_place_by_name.insert(
                                    binding_name,
                                    MIRPlace.Local(bind_local.id),
                                );
                            };
                        },
                        .Fill() then {
                            when self.pattern_place_by_def_id.get(symbol.def_id.id) in {
                                .Some(destination) then self.append_statement(
                                    MIRStatement.Assign(
                                        destination,
                                        MIRValue.PlaceRead(
                                            payload_place,
                                            MIROwnershipUse.Copy(),
                                        ),
                                    ),
                                ),
                                .None() then {},
                            };
                        },
                    };
                };
            },
            .Variable(symbol) then {
                let mutable binding_type = self.pattern_binding_type(
                    symbol,
                    subject_type,
                );
                if binding_type is not .VoidType() then {
                    let source_place = if binding_type == subject_type then subject_place
                    else matched_place;
                    let binding_name = self.context.symbol_name(symbol);
                    when mode in {
                        .Alias() then {
                            self.pattern_place_by_def_id.insert(
                                symbol.def_id.id,
                                source_place,
                            );
                            self.pattern_place_by_name.insert(binding_name, source_place);
                        },
                        .Claim() then {
                            if self.pattern_place_by_def_id.get(symbol.def_id.id) is .None() then {
                                let local = self.make_temporary(
                                    binding_type,
                                    if binding_name.is_empty() then "pattern_binding"
                                    else binding_name,
                                );
                                self.append_statement(MIRStatement.Declare(local.id));
                                let slot = MIRPlace.Local(local.id);
                                self.pattern_place_by_def_id.insert(
                                    symbol.def_id.id,
                                    slot,
                                );
                                self.pattern_place_by_name.insert(binding_name, slot);
                            };
                        },
                        .Fill() then {
                            when self.pattern_place_by_def_id.get(symbol.def_id.id) in {
                                .Some(destination) then self.append_statement(
                                    MIRStatement.Assign(
                                        destination,
                                        MIRValue.PlaceRead(
                                            source_place,
                                            MIROwnershipUse.Copy(),
                                        ),
                                    ),
                                ),
                                .None() then {},
                            };
                        },
                    };
                };
            },
            .TraitObjectTypeBinding(symbol, target_type) then {
                let binding_name = self.context.symbol_name(symbol);
                let name_hint = if binding_name.is_empty() then "trait_object_binding"
                else binding_name;
                when mode in {
                    .Alias() then {
                        let local = self.make_temporary(target_type, name_hint);
                        self.append_statement(MIRStatement.Declare(local.id));
                        self.append_statement(
                            MIRStatement.Assign(
                                MIRPlace.Local(local.id),
                                MIRValue.Intrinsic(
                                    MIRIntrinsic.TraitObjectDowncast(
                                        MIRValue.PlaceRead(
                                            subject_place,
                                            MIROwnershipUse.Borrow(),
                                        ),
                                        target_type,
                                    ),
                                ),
                            ),
                        );
                        self.pattern_place_by_def_id.insert(
                            symbol.def_id.id,
                            MIRPlace.Local(local.id),
                        );
                        self.pattern_place_by_name.insert(
                            binding_name,
                            MIRPlace.Local(local.id),
                        );
                    },
                    .Claim() then {
                        if self.pattern_place_by_def_id.get(symbol.def_id.id) is .None() then {
                            let local = self.make_temporary(target_type, name_hint);
                            self.append_statement(MIRStatement.Declare(local.id));
                            let slot = MIRPlace.Local(local.id);
                            self.pattern_place_by_def_id.insert(symbol.def_id.id, slot);
                            self.pattern_place_by_name.insert(binding_name, slot);
                        };
                    },
                    .Fill() then {
                        when self.pattern_place_by_def_id.get(symbol.def_id.id) in {
                            .Some(destination) then self.append_statement(
                                MIRStatement.Assign(
                                    destination,
                                    MIRValue.Intrinsic(
                                        MIRIntrinsic.TraitObjectDowncast(
                                            MIRValue.PlaceRead(
                                                subject_place,
                                                MIROwnershipUse.Borrow(),
                                            ),
                                            target_type,
                                        ),
                                    ),
                                ),
                            ),
                            .None() then {},
                        };
                    },
                };
            },
            .EnumCase(case_name, tag_index, elements) then {
                let mutable case_info_opt = Option[EnumCaseInfo].None();
                when matched_type in {
                    .EnumType(def_id) then {
                        when self.context.get_enum_cases(def_id) in {
                            .Some(cases) then {
                                if tag_index < cases.count() then {
                                    case_info_opt = Option[EnumCaseInfo].Some(
                                        cases[tag_index],
                                    );
                                };
                            },
                            .None() then {},
                        };
                    },
                    _ then {},
                };
                when case_info_opt in {
                    .Some(case_info) then {
                        if not (case_info.params.count() == elements.count()) then {
                            return;
                        };
                        for pair in elements.lazy().enumerate() then {
                            let param = case_info.params[pair.first];
                            let payload_place = MIRPlace.EnumPayload(
                                matched_place,
                                case_name,
                                param.name,
                                pair.first,
                                param.param_type,
                            );
                            let resolved_place = if self.goes_through_deref(
                                matched_place,
                            ) and param.param_type is not .VoidType() then {
                                let local_name = if param.name.is_empty() then "payload"
                                else param.name;
                                let local = self.make_temporary(
                                    param.param_type,
                                    local_name,
                                );
                                self.append_statement(MIRStatement.Declare(local.id));
                                self.append_statement(
                                    MIRStatement.Assign(
                                        MIRPlace.Local(local.id),
                                        MIRValue.PlaceRead(
                                            payload_place,
                                            MIROwnershipUse.Copy(),
                                        ),
                                    ),
                                );
                                MIRPlace.Local(local.id)
                            } else {
                                payload_place
                            };
                            self.apply_pattern_bindings(
                                pair.second.pattern,
                                resolved_place,
                                param.param_type,
                                mode,
                            );
                        };
                    },
                    .None() then {
                        // Fallback for GenericEnum types: extract element types from
                        // the TypedPattern elements, which carry correct type info
                        // from the type checker.
                        let generic_params = when matched_type in {
                            // Identity: the template's DECLARATION selects the container,
                            // then the case NAME picks a member inside it.
                            .GenericEnum(template_def_id, _) then self.context.enum_case_params_by_raw_id(
                                template_def_id.id,
                                case_name,
                            ),
                            _ then List[EnumCaseParam].new(),
                        };
                        for pair in elements.lazy().enumerate() then {
                            let elem = pair.second;
                            let mutable elem_type = self.pattern_element_type(
                                elem.pattern,
                            );
                            if elem_type is not .VoidType() then {
                                let field_name = if pair.first < generic_params.count() then {
                                    generic_params[pair.first].name
                                } else if generic_params.count() == UInt(1) then {
                                    "value"
                                } else {
                                    ""
                                };
                                let payload_place = MIRPlace.EnumPayload(
                                    matched_place,
                                    case_name,
                                    field_name,
                                    pair.first,
                                    elem_type,
                                );
                                let resolved_place = if self.goes_through_deref(
                                    matched_place,
                                ) then {
                                    let local = self.make_temporary(elem_type, "payload");
                                    self.append_statement(
                                        MIRStatement.Declare(local.id),
                                    );
                                    self.append_statement(
                                        MIRStatement.Assign(
                                            MIRPlace.Local(local.id),
                                            MIRValue.PlaceRead(
                                                payload_place,
                                                MIROwnershipUse.Copy(),
                                            ),
                                        ),
                                    );
                                    MIRPlace.Local(local.id)
                                } else {
                                    payload_place
                                };
                                self.apply_pattern_bindings(
                                    elem.pattern,
                                    resolved_place,
                                    elem_type,
                                    mode,
                                );
                            };
                        };
                    },
                };
            },
            .StructPattern(_, elements) then {
                let mutable fields_opt = Option[List[StructField]].None();
                when matched_type in {
                    .StructureType(def_id) then {
                        fields_opt = self.context.get_struct_fields(def_id);
                    },
                    _ then {},
                };
                when fields_opt in {
                    .Some(fields) then {
                        if fields.count() < elements.count() then {
                            return;
                        };
                        for pair in elements.lazy().zip[
                            StructField,
                            ListIterator[StructField],
                            List[StructField],
                        ](fields) then {
                            let field = pair.second;
                            let field_symbol = self.make_synthetic_symbol(
                                field.name,
                                field.field_type,
                            );
                            let field_place = MIRPlace.Field(matched_place, field_symbol);
                            self.apply_pattern_bindings(
                                pair.first.pattern,
                                field_place,
                                field.field_type,
                                mode,
                            );
                        };
                    },
                    .None() then {},
                };
            },
            .AndPattern(left, right) then {
                self.apply_pattern_bindings(left, matched_place, matched_type, mode);
                self.apply_pattern_bindings(right, matched_place, matched_type, mode);
            },
            // An `or` pattern's branches bind the same names from different
            // payload positions, so they cannot alias. Claim one slot per name,
            // then let each branch fill the slots from its own layout.
            .OrPattern(left, right) then {
                when mode in {
                    .Claim() then {
                        self.apply_pattern_bindings(
                            left,
                            subject_place,
                            subject_type,
                            mode,
                        );
                        self.apply_pattern_bindings(
                            right,
                            subject_place,
                            subject_type,
                            mode,
                        );
                    },
                    .Alias() or .Fill() then self.bind_or_pattern_variables(
                        left,
                        right,
                        subject_place,
                        subject_type,
                    ),
                };
            },
            .NotPattern(_) then {},
            .ListPattern(ops, elements) then {
                let count_value = self.list_count_value(matched_place, ops);
                // A slot is its own subject -- clear the cached subject before
                // descending, or an inner pattern reads the OUTER list.
                let saved_slot_source = self.pattern_subject_operand;
                let saved_slot_tag = self.pattern_subject_tag;
                let saved_slot_comparison = self.pattern_comparison_local;
                self.pattern_subject_operand = Option[MIROperand].None();
                self.pattern_subject_tag = Option[MIROperand].None();
                self.pattern_comparison_local = Option[MIRLocalID].None();
                for pair in elements.lazy().enumerate() then {
                    if pair.second is .RestPattern() then {
                        continue;
                    };
                    let element_place = self.materialize_list_slot(
                        matched_place,
                        ops,
                        pair.first,
                        elements,
                        count_value,
                    );
                    self.apply_pattern_bindings(
                        pair.second,
                        element_place,
                        ops.element_type,
                        mode,
                    );
                    self.pattern_subject_operand = Option[MIROperand].None();
                    self.pattern_subject_tag = Option[MIROperand].None();
                    self.pattern_comparison_local = Option[MIRLocalID].None();
                };
                self.pattern_subject_operand = saved_slot_source;
                self.pattern_subject_tag = saved_slot_tag;
                self.pattern_comparison_local = saved_slot_comparison;
            },
            _ then {},
        };
    };

    /// Bind an `or` pattern by giving every name one slot and letting each
    /// branch write its own payload layout into it. The join block is where the
    /// arm body goes, so both branches reach it with every slot filled.
    private bind_or_pattern_variables(
        self,
        left: TypedPattern,
        right: TypedPattern,
        subject_place: MIRPlace,
        subject_type: Type,
    ): Void = {
        self.apply_pattern_bindings(
            left,
            subject_place,
            subject_type,
            PatternBindMode.Claim(),
        );
        // The cached subject/tag describe whatever the ENCLOSING test matched,
        // which need not be `subject_place` -- an `or` under a `Some(...)` or a
        // struct field is a different value with its own tag. Re-testing a side
        // through the cache compares the outer tag and picks the wrong fill
        // branch. Clear both around the re-test, the way nested payloads do.
        let saved_subject_source = self.pattern_subject_operand;
        let saved_subject_tag = self.pattern_subject_tag;
        let saved_comparison_local = self.pattern_comparison_local;
        self.pattern_subject_operand = Option[MIROperand].None();
        self.pattern_subject_tag = Option[MIROperand].None();
        self.pattern_comparison_local = Option[MIRLocalID].None();
        let left_condition = self.lower_pattern_condition(
            subject_place,
            subject_type,
            left,
            false,
        );
        self.pattern_subject_operand = saved_subject_source;
        self.pattern_subject_tag = saved_subject_tag;
        self.pattern_comparison_local = saved_comparison_local;
        let branch_block = self.current_block_id();
        let left_block = self.make_block();
        let right_block = self.make_block();
        let join_block = self.make_block();
        self.set_current_block(branch_block);
        self.terminate(MIRTerminator.Branch(left_condition, left_block, right_block));

        self.set_current_block(left_block);
        self.apply_pattern_bindings(
            left,
            subject_place,
            subject_type,
            PatternBindMode.Fill(),
        );
        if not self.current_block_is_terminated() then {
            self.terminate(MIRTerminator.Goto(join_block));
        };

        self.set_current_block(right_block);
        self.apply_pattern_bindings(
            right,
            subject_place,
            subject_type,
            PatternBindMode.Fill(),
        );
        if not self.current_block_is_terminated() then {
            self.terminate(MIRTerminator.Goto(join_block));
        };

        self.set_current_block(join_block);
    };

};
