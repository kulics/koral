// MIR lowering: intrinsics, values, borrows, operands, places, and
// materialization.

given MIRFunctionBuilder {
    lower_intrinsic(self, intrinsic_node: TypedIntrinsic): MIRIntrinsic = {
        return when intrinsic_node in {
            .AllocMemory(count, result_type) then MIRIntrinsic.AllocMemory(
                self.lower_value(count),
                result_type,
            ),
            .AllocString(len, result_type) then MIRIntrinsic.AllocString(
                self.lower_value(len),
                result_type,
            ),
            .DeallocMemory(pointer_expr) then MIRIntrinsic.DeallocMemory(
                self.lower_value(pointer_expr),
            ),
            .CopyMemory(dest, source, count) then MIRIntrinsic.CopyMemory(
                self.lower_value(dest),
                self.lower_value(source),
                self.lower_value(count),
            ),
            .MoveMemory(dest, source, count) then MIRIntrinsic.MoveMemory(
                self.lower_value(dest),
                self.lower_value(source),
                self.lower_value(count),
            ),
            .CompareMemory(a, b, count) then MIRIntrinsic.CompareMemory(
                self.lower_value(a),
                self.lower_value(b),
                self.lower_value(count),
            ),
            .DowngradeRef(value, result_type) then MIRIntrinsic.DowngradeRef(
                self.lower_value(value),
                result_type,
            ),
            .UpgradeRef(value, result_type) then MIRIntrinsic.UpgradeRef(
                self.lower_value(value),
                result_type,
            ),
            .InitMemory(pointer_expr, value_expr) then MIRIntrinsic.InitMemory(
                self.lower_value(pointer_expr),
                self.lower_value(value_expr),
            ),
            .DeinitMemory(pointer_expr) then MIRIntrinsic.DeinitMemory(
                self.lower_value(pointer_expr),
            ),
            .TakeMemory(pointer_expr, result_type) then MIRIntrinsic.TakeMemory(
                self.lower_value(pointer_expr),
                result_type,
            ),
            .NullPtr(result_type) then MIRIntrinsic.NullPtr(result_type),
            .FixedArrayLiteral(result_type, elements) then {
                let mutable lowered = List[MIRValue].new();
                for element in elements then {
                    lowered.push(self.lower_value(element));
                };
                MIRIntrinsic.FixedArrayLiteral(result_type, lowered)
            },
            .SpawnThread(out_handle, out_tid, closure, stack_size) then MIRIntrinsic.SpawnThread(
                self.lower_value(out_handle),
                self.lower_value(out_tid),
                self.lower_value(closure),
                self.lower_value(stack_size),
            ),
        };
    };

    intrinsic_result_type(self, intrinsic_node: TypedIntrinsic): Type = {
        return when intrinsic_node in {
            .AllocMemory(_, result_type) or .AllocString(_, result_type)
            or .DowngradeRef(_, result_type) or .UpgradeRef(_, result_type)
            or .TakeMemory(_, result_type) or .NullPtr(result_type)
            or .FixedArrayLiteral(result_type, _) then result_type,
            .SpawnThread(_, _, _, _) then Type.Int32Type(),
            .CompareMemory(_, _, _) then Type.IntType(),
            _ then Type.VoidType(),
        };
    };

    lower_lambda_expression(
        self,
        params: List[TypedParam],
        return_type: Type,
        body: TypedExpr,
        lambda_type: Type,
    ): Option[MIRExprResult] = {
        let mutable captures = List[Symbol].new();
        let mutable capture_sources = List[MIRPlace].new();
        self.collect_captures(body, params, captures);
        let mutable lambda_captures = List[Symbol].new();
        for capture in captures then {
            capture_sources.push(self.capture_place(capture));
            // The captured symbol goes in AS IT IS: its type and kind are
            // sema's answer. This used to run through `lambda_capture_symbol`,
            // which rewrote a `MutableValue` capture into a mutable reference;
            // sema rejects a mutable capture outright
            // (`Cannot capture mutable variable ... hold the state in a Cell and
            // capture the cell instead`), so no accepted program ever took that
            // branch. Swift passes `capture.type` straight through here.
            lambda_captures.push(capture);
        };
        let mutable param_symbols = List[Symbol].new();
        for param in params then {
            let symbol = Symbol(
                self.context.allocate_unindexed(param.name, DefKind.Variable()),
                param.param_type,
                SymbolKind.Variable(
                    if param.is_mutable then VariableKind.MutableValue()
                    else VariableKind.Value(),
                ),
            );
            param_symbols.push(symbol);
        };
        let effective_return_type = when lambda_type in {
            .FunctionType(_, fn_return_type, _) or .ForeignFunctionType(_, fn_return_type) then fn_return_type,
            _ then return_type,
        };
        let mutable function_type = Type.FunctionType(
            types_to_param_entries(self.param_types_to_refs(params)),
            effective_return_type,
        false);
        let lambda_identifier = Symbol(
            self.context.allocate_unindexed(
                "__mir_lambda_\(self.identifier.def_id.id)_\(self.next_local_id)_\(self.next_block_id)",
                DefKind.Function(),
            ),
            function_type,
            SymbolKind.Function(),
        );
        let mutable builder = MIRFunctionBuilder.new(
            self.program,
            lambda_identifier,
            params,
            lambda_captures,
            effective_return_type,
            MIRFunctionKind.Global(),
            body,
            self.context,
        );
        let nested = (builder).lower();
        let value = MIRValue.Lambda(
            MIRLambda(
                param_symbols,
                lambda_captures,
                capture_sources,
                nested,
                function_type,
            ),
        );
        let result = self.materialize(value, lambda_type);
        return Option[MIRExprResult].Some(
            MIRExprResult(
                lambda_type,
                ValueCategory.RValue(),
                Option[MIROperand].Some(result),
                Option[MIRPlace].None(),
            ),
        );
    };

    private param_types_to_refs(self, params: List[TypedParam]): List[Type] = {
        let mutable out = List[Type].new();
        for param in params then {
            out.push(param.param_type);
        };
        return out;
    };

    lower_value(self, expression: TypedExpr): MIRValue = {
        if self.context.contains_generic_parameter(expression.expr_type) then {
            when expression.expr_kind in {
                .RefExpr(inner) then when self.lower_place(inner) in {
                    .Some(place) then {
                        return MIRValue.Ref(
                            place,
                            self.reference_kind(expression.expr_type),
                            MIRReferenceAllocation.StackBorrow(),
                        );
                    },
                    .None() then {},
                },
                .PtrExpr(inner) then when self.lower_place(inner) in {
                    .Some(place) then {
                        return MIRValue.Pointer(place);
                    },
                    .None() then {},
                },
                _ then {},
            };
        };
        return when self.lower_expression(expression) in {
            .Some(result) then when result.operand in {
                .Some(operand) then MIRValue.Operand(operand),
                .None() then when result.place in {
                    .Some(place) then {
                        // 锁定对象的字段读 / 可变全局绑定读不能延迟到使用点
                        // （那会把装载挪出锁的临界区）：在求值位置装取并上锁
                        // （concurrency-design.md §对象锁语义 1）。
                        if self.place_locked_relevant(place) then {
                            MIRValue.Operand(
                                self.materialize(
                                    MIRValue.PlaceRead(place, MIROwnershipUse.Copy()),
                                    result.result_type,
                                ),
                            )
                        } else if self.place_needs_eager_load(place) then {
                            // A load through a call-produced pointer (an element
                            // slot) is materialized HERE, at the value's own
                            // evaluation position: later instructions in the
                            // block can run side effects (a call argument that
                            // grows a container), and a deferred load would then
                            // read through an already-invalidated slot pointer.
                            // Everything else keeps the deferred read so the call
                            // convention can pass non-escaping parameters
                            // straight from their locals.
                            MIRValue.Operand(
                                self.materialize(
                                    MIRValue.PlaceRead(place, MIROwnershipUse.Copy()),
                                    result.result_type,
                                ),
                            )
                        } else {
                            MIRValue.PlaceRead(place, MIROwnershipUse.Copy())
                        }
                    },
                    .None() then MIRValue.Operand(
                        MIROperand.Constant(MIRConstant.Void()),
                    ),
                },
            },
            .None() then MIRValue.Operand(MIROperand.Constant(MIRConstant.Void())),
        };
    };

    lower_borrowed_source_value(self, expression: TypedExpr): MIRValue = {
        if expression.expr_kind is .CastExpr(_, inner) and self.is_ownership_preserving_place_cast(
            inner.expr_type,
            expression.expr_type,
        ) then {
            return self.lower_borrowed_source_value(inner);
        };
        return when self.lower_expression(expression) in {
            .Some(result) then when result.place in {
                .Some(place) then {
                    // 锁定字段的借用位装载（含 +0 别名约定的句柄位拷贝）也是
                    // 读：必须包在所属对象锁的临界区里（concurrency-design.md
                    // §对象锁语义 1）。装到临时后按 Borrow 语义传给使用方，
                    // 调用约定的 +0 形状不变。
                    if self.place_locked_relevant(place) then {
                        when self.lower_locked_read(
                            place,
                            MIROwnershipUse.Borrow(),
                            self.place_type(place),
                        ) in {
                            .Some(operand) then MIRValue.PlaceRead(
                                MIRPlace.Local(operand.local_id_or_zero()),
                                MIROwnershipUse.Borrow(),
                            ),
                            .None() then MIRValue.PlaceRead(
                                place,
                                MIROwnershipUse.Borrow(),
                            ),
                        }
                    } else {
                        MIRValue.PlaceRead(place, MIROwnershipUse.Borrow())
                    }
                },
                .None() then when result.operand in {
                    .Some(operand) then when operand in {
                        .Local(local_id) then MIRValue.PlaceRead(
                            MIRPlace.Local(local_id),
                            MIROwnershipUse.Borrow(),
                        ),
                        _ then MIRValue.Operand(operand),
                    },
                    .None() then MIRValue.Operand(
                        MIROperand.Constant(MIRConstant.Void()),
                    ),
                },
            },
            .None() then MIRValue.Operand(MIROperand.Constant(MIRConstant.Void())),
        };
    };

    lower_operand(self, expression: TypedExpr): MIROperand = {
        return when self.lower_expression(expression) in {
            .Some(result) then when result.operand in {
                .Some(operand) then operand,
                .None() then when result.place in {
                    .Some(place) then self.materialize(
                        MIRValue.PlaceRead(place, MIROwnershipUse.Copy()),
                        result.result_type,
                    ),
                    .None() then MIROperand.Constant(MIRConstant.Void()),
                },
            },
            .None() then MIROperand.Constant(MIRConstant.Void()),
        };
    };

    lower_operand_for_expected_type(
        self,
        expression: TypedExpr,
        expected_type: Type,
    ): MIROperand = {
        return when self.lower_expression(expression) in {
            .Some(result) then when result.operand in {
                .Some(operand) then self.adapt_operand_to_expected_type(
                    operand,
                    result.result_type,
                    expected_type,
                ),
                .None() then when result.place in {
                    .Some(place) then self.materialize_place_for_expected_type(
                        place,
                        expected_type,
                    ),
                    .None() then MIROperand.Constant(MIRConstant.Void()),
                },
            },
            .None() then MIROperand.Constant(MIRConstant.Void()),
        };
    };

    place_type(self, place: MIRPlace): Type = {
        return when place in {
            .Local(local_id) then self.type_of_local(local_id),
            .Global(def_id) then self.context.get_symbol_type(def_id) or else Type.Unknown(
            ),
            .Field(_, field_symbol) then field_symbol.symbol_type,
            .EnumPayload(_, _, _, _, field_type) then field_type,
            .Deref(_, pointee_type) then pointee_type,
            .PointerElement(_, element_type) then element_type,
        };
    };

    materialize(self, value: MIRValue, result_type: Type): MIROperand = {
        // 锁定对象的字段读 / 可变全局绑定读必须包在所属对象锁里装载
        // （concurrency-design.md §对象锁语义 1）。所有经 materialize 的装载
        // 路径统一在这里收口；lower_locked_read 内部用 materialize_raw 避免
        // 自嵌套。
        when value in {
            .PlaceRead(place, ownership) then {
                when self.lower_locked_read(place, ownership, result_type) in {
                    .Some(operand) then return operand,
                    .None() then {},
                };
            },
            _ then {},
        };
        return self.materialize_raw(value, result_type);
    };

    materialize_raw(self, value: MIRValue, result_type: Type): MIROperand = {
        if self.type_is_void_or_never(result_type) then {
            return MIROperand.Constant(MIRConstant.Void());
        };
        let local = self.make_temporary(result_type, "tmp");
        self.append_statement(MIRStatement.Declare(local.id));
        self.append_statement(MIRStatement.Assign(MIRPlace.Local(local.id), value));
        return MIROperand.Local(local.id);
    };

    lower_place(self, expression: TypedExpr): Option[MIRPlace] = {
        return when expression.expr_kind in {
            .Variable(symbol) then {
                when self.pattern_place_by_def_id.get(symbol.def_id.id) in {
                    .Some(place) then {
                        return Option[MIRPlace].Some(
                            self.variable_place_for_expr(
                                place,
                                symbol.symbol_type,
                                expression.expr_type,
                            ),
                        );
                    },
                    .None() then {},
                };
                let name = self.context.symbol_name(symbol);
                // See `capture_place`: declaration identity decides the place;
                // the name-keyed tables are a last resort only.
                when self.local_by_def_id.get(symbol.def_id.id) in {
                    .Some(local_id) then {
                        return Option[MIRPlace].Some(
                            self.variable_place_for_expr(
                                MIRPlace.Local(local_id),
                                self.type_of_local(local_id),
                                expression.expr_type,
                            ),
                        );
                    },
                    .None() then {},
                };
                when self.pattern_place_by_name.get(name) in {
                    .Some(place) then {
                        // The name table is a last resort: two DISTINCT symbols
                        // can share a name (the flow desugars' payload carriers
                        // do). Only take the name hit when its place has the
                        // symbol's type; otherwise fall through and make a local.
                        let place_type = when place in {
                            .Local(local_id) then self.type_of_local(local_id),
                            .EnumPayload(_, _, _, _, field_type) then field_type,
                            _ then symbol.symbol_type,
                        };
                        if self.call_param_types_match(place_type, symbol.symbol_type) then {
                            return Option[MIRPlace].Some(
                                self.variable_place_for_expr(
                                    place,
                                    symbol.symbol_type,
                                    expression.expr_type,
                                ),
                            );
                        };
                    },
                    .None() then {},
                };
                when self.parameter_local_by_name.get(name) in {
                    .Some(local_id) then {
                        self.local_by_def_id.insert(symbol.def_id.id, local_id);
                        return Option[MIRPlace].Some(
                            self.variable_place_for_expr(
                                MIRPlace.Local(local_id),
                                self.type_of_local(local_id),
                                expression.expr_type,
                            ),
                        );
                    },
                    .None() then {},
                };
                // Fallback: if the symbol is a variable (not a true global),
                // create a MIR local for it. This handles cases where pattern
                // bindings are missing (e.g., for-loop variables).
                let is_top_level_variable = when symbol.kind in {
                    .Variable(_) then {
                        let has_module_path = self.context.get_module_path(
                            symbol.def_id,
                        ) is .Some(_);
                        let has_source_file = self.context.get_source_file(
                            symbol.def_id,
                        ) is .Some(_);
                        has_module_path or has_source_file
                    },
                    _ then false,
                };
                when symbol.kind in {
                    .Variable(_) then if is_top_level_variable then Option[MIRPlace].Some(
                        self.variable_place_for_expr(
                            MIRPlace.Global(symbol.def_id),
                            symbol.symbol_type,
                            expression.expr_type,
                        ),
                    )
                    else {
                        let local = self.make_local(
                            name,
                            symbol.symbol_type,
                            MIRStorage.Local(),
                            Option[Symbol].Some(symbol),
                        );
                        self.local_by_def_id.insert(symbol.def_id.id, local.id);
                        self.append_statement(MIRStatement.Declare(local.id));
                        Option[MIRPlace].Some(
                            self.variable_place_for_expr(
                                MIRPlace.Local(local.id),
                                local.local_type,
                                expression.expr_type,
                            ),
                        )
                    },
                    _ then Option[MIRPlace].Some(
                        self.variable_place_for_expr(
                            MIRPlace.Global(symbol.def_id),
                            symbol.symbol_type,
                            expression.expr_type,
                        ),
                    ),
                }
            },
            .MemberPath(base, path) then {
                let mutable base_place = when base.expr_type in {
                    .ReferenceType(inner) or .MutableReferenceType(inner) or .WeakReferenceType(inner)
                    or .MutableWeakReferenceType(inner) or .PointerType(inner) or .MutablePointerType(inner) then MIRPlace.Deref(
                        self.lower_borrowed_source_value(base),
                        inner,
                    ),
                    // Swift lowerPlace: when the base has no place of its own (e.g. it is a
                    // call such as `__index_get(pairs, 0)`), fall back to materializing the
                    // base into a temp and building the member path on top of it. Without this
                    // `pairs[0].x = 200` resolves to no place and the store is lost.
                    _ then self.lower_place(base) or else {
                        return self.lower_materialized_member_path_place(expression);
                    },
                };
                let mutable current_type = self.place_type(base_place);
                for segment in path then {
                    when current_type in {
                        .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner)
                        or .MutableBorrowedReferenceType(inner) or .WeakReferenceType(inner)
                        or .MutableWeakReferenceType(inner) or .PointerType(inner)
                        or .MutablePointerType(inner) then {
                            base_place = MIRPlace.Deref(
                                MIRValue.PlaceRead(base_place, MIROwnershipUse.Borrow()),
                                inner,
                            );
                            current_type = inner;
                        },
                        _ then {},
                    };
                    base_place = MIRPlace.Field(base_place, segment);
                    current_type = segment.symbol_type;
                };
                Option[MIRPlace].Some(base_place)
            },
            .DerefExpr(inner) or .UnsafeDerefExpr(inner) then {
                let pointee = self.deref_pointee_type(
                    inner.expr_type,
                    expression.expr_type,
                );
                let source = self.lower_borrowed_source_value(inner);
                if self.expr_lowers_to_pointer_call(inner) then {
                    self.mark_call_derived_pointer(source);
                };
                Option[MIRPlace].Some(MIRPlace.Deref(source, pointee))
            },
            .CastExpr(target_type, inner) then {
                if self.is_ownership_preserving_place_cast(inner.expr_type, target_type) then {
                    self.lower_place(inner)
                } else {
                    Option[MIRPlace].None()
                }
            },
            _ then Option[MIRPlace].None(),
        };
    };

    private variable_place_for_expr(
        self,
        place: MIRPlace,
        declared_type: Type,
        expr_type: Type,
    ): MIRPlace = {
        let _ = self;
        // Every reference-like shape behaves alike: deref when the declared
        // pointee is the expression's own type, keep the place otherwise. A
        // raw-pointer local typed as its own pointee is the drop body's `self`
        // -- see the matching cases in `lower_expression`.
        return when declared_type in {
            .ReferenceType(inner_ref) or .MutableReferenceType(inner_ref) or .BorrowedReferenceType(inner_ref) or .MutableBorrowedReferenceType(inner_ref) or .WeakReferenceType(inner_ref) or .MutableWeakReferenceType(inner_ref) or .PointerType(inner_ref) or .MutablePointerType(inner_ref) where inner_ref == expr_type then MIRPlace.Deref(
                MIRValue.PlaceRead(place, MIROwnershipUse.Borrow()),
                inner_ref,
            ),
            _ then place,
        };
    };

    lower_materialized_member_path_place(
        self,
        expression: TypedExpr,
    ): Option[MIRPlace] = {
        return when expression.expr_kind in {
            .MemberPath(base, path) then {
                let lowered_base = self.lower_expression(base);
                let base_result = lowered_base or return;
                let base_place = when base_result.place in {
                    .Some(place) then Option[MIRPlace].Some(place),
                    .None() then when base_result.operand in {
                        .Some(operand) then when operand in {
                            .Local(local_id) then Option[MIRPlace].Some(
                                MIRPlace.Local(local_id),
                            ),
                            _ then {
                                let local = self.make_temporary(
                                    base.expr_type,
                                    "member_base",
                                );
                                self.append_statement(MIRStatement.Declare(local.id));
                                self.append_statement(
                                    MIRStatement.Assign(
                                        MIRPlace.Local(local.id),
                                        MIRValue.Operand(operand),
                                    ),
                                );
                                Option[MIRPlace].Some(MIRPlace.Local(local.id))
                            },
                        },
                        .None() then Option[MIRPlace].None(),
                    },
                };
                let mutable place = base_place or return;
                let mutable current_type = self.place_type(place);
                for field in path then {
                    when current_type in {
                        .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner)
                        or .MutableBorrowedReferenceType(inner) or .WeakReferenceType(inner)
                        or .MutableWeakReferenceType(inner) or .PointerType(inner)
                        or .MutablePointerType(inner) then {
                            place = MIRPlace.Deref(
                                MIRValue.PlaceRead(place, MIROwnershipUse.Borrow()),
                                inner,
                            );
                            current_type = inner;
                        },
                        _ then {},
                    };
                    place = MIRPlace.Field(place, field);
                    current_type = field.symbol_type;
                };
                Option[MIRPlace].Some(place)
            },
            _ then Option[MIRPlace].None(),
        };
    };

};
