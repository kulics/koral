using "std/os";
using "std/proc";

file_private type InvocationOptions(
    command String,
    package_config_path Option[String],
    entry_file_path Option[String],
    target_module_name Option[String],
    requires_root Option[String],
    std_config_path Option[String],
    no_std Bool,
    out_dir Option[String],
    // Clang flags for the generated C. `-O1` is the historical default;
    // `--debug` / `--release` / `--optimize` select the conventional pairs.
    optimize_args List[String],
);

file_private type PreparedCompilation(
    graph ResolvedModuleGraph,
    display_name String,
    artifact_base_name String,
    linked_libraries List[String],
    default_output_dir Path,
);

file_private let phase_trace_enabled() Bool = {
    return if env("KORAL_DEBUG_PHASE") is .Some(value) then value == "1" or value == "true" or value == "TRUE" else false;
};

file_private let trace_phase(label String) Void = {
    if phase_trace_enabled() then {
        eprintln(label);
    };
};

public let run_driver() Int = {
    let argv = args();

    if argv.count() < 2 then {
        print_usage();
        return 0;
    };

    let first = argv[1];
    if first == "help" or first == "-h" or first == "--help" then {
        print_usage();
        return 0;
    };
    let mutable command = StringBuilder.new();
    command.push_string("build");
    let mutable index UInt = 1;

    if first == "check" or first == "build" or first == "emit-c" or first == "run" then {
        command = StringBuilder.new();
        command.push_string(first);
        index = 2;
    };

    let mutable package_config_path = Option[String].None();
    let mutable entry_file_path = Option[String].None();
    let mutable target_module_name = Option[String].None();
    let mutable requires_root = Option[String].None();
    let mutable std_config_path = Option[String].None();
    let mutable no_std = false;
    let mutable out_dir = Option[String].None();
    let mutable optimize_args = List[String].new();
    optimize_args.push("-O1");

    let mutable i = index;
    while i < argv.count() then {
        let arg = argv[i];
        if arg == "-h" or arg == "--help" then {
            print_usage();
            return 0;
        } else if arg == "--no-std" then {
            no_std = true;
        } else if arg == "--debug" then {
            optimize_args = List[String].new();
            optimize_args.push("-O0");
            optimize_args.push("-g");
        } else if arg == "--release" then {
            optimize_args = List[String].new();
            optimize_args.push("-O2");
        } else if arg == "--optimize" then {
            i += 1;
            if i >= argv.count() or argv[i].starts_with("-") then {
                eprintln("Error: Missing value for --optimize option");
                return 1;
            };
            let level = argv[i];
            if level <> "0" and level <> "1" and level <> "2" and level <> "3" and level <> "s" and level <> "fast" then {
                eprintln("Error: Invalid value for --optimize (expected 0, 1, 2, 3, s or fast): \(level)");
                return 1;
            };
            optimize_args = List[String].new();
            optimize_args.push("-O\(level)");
        } else if arg == "--package-config" then {
            i += 1;
            if i >= argv.count() then {
                eprintln("Error: Missing path for --package-config option");
                return 1;
            };
            package_config_path = Option[String].Some(argv[i]);
        } else if arg == "--target-module" then {
            i += 1;
            if i >= argv.count() then {
                eprintln("Error: Missing value for --target-module option");
                return 1;
            };
            target_module_name = Option[String].Some(argv[i]);
        } else if arg == "--requires-root" then {
            i += 1;
            if i >= argv.count() then {
                eprintln("Error: Missing path for --requires-root option");
                return 1;
            };
            requires_root = Option[String].Some(argv[i]);
        } else if arg == "--std-config" then {
            i += 1;
            if i >= argv.count() then {
                eprintln("Error: Missing path for --std-config option");
                return 1;
            };
            std_config_path = Option[String].Some(argv[i]);
        } else if arg == "-o" or arg == "--output" then {
            i += 1;
            if i >= argv.count() then {
                eprintln("Error: Missing path for -o option");
                return 1;
            };
            out_dir = Option[String].Some(argv[i]);
        } else if arg.starts_with("-") then {
            eprintln("Error: Unknown argument: \(arg)");
            print_usage();
            return 1;
        } else {
            if package_config_path is .None() and entry_file_path is .None() then {
                entry_file_path = Option[String].Some(arg);
            } else {
                eprintln("Error: Unknown positional argument: \(arg)");
                print_usage();
                return 1;
            };
        };
        i += 1;
    };

    let options = InvocationOptions(
        command.to_string(),
        package_config_path,
        entry_file_path,
        target_module_name,
        requires_root,
        std_config_path,
        no_std,
        out_dir,
        optimize_args,
    );

    if options.package_config_path is .None() and options.entry_file_path is .None() then {
        eprintln("Error: Missing input file or --package-config");
        print_usage();
        return 1;
    };
    if options.package_config_path is .Some(_) and options.entry_file_path is .Some(_) then {
        eprintln("Error: Cannot combine direct file input with --package-config");
        print_usage();
        return 1;
    };

    return when command.to_string() in {
        "emit-c" then run_emit_c(options),
        "check" then run_check(options),
        "build" then run_build(options),
        "run" then run_run(options),
        _ then 1,
    };
};

file_private let print_usage() Void = {
    println("Usage: koralc [command] [--package-config <koral.json> | <file.koral>] [--target-module <module>] [options]");
    println("Commands:");
    println("  help    Show this help text");
    println("  build   Compile to executable (default)");
    println("  check   Type-check only (no code generation)");
    println("  run     Compile and run");
    println("  emit-c  Generate C code only");
    println("Options:");
    println("  -h, --help                Show this help text");
    println("  -o, --output <path>       Output directory for generated files");
    println("  --package-config <path>   Package manifest path for manifest-driven builds");
    println("  --target-module <name>    Target module full name, e.g. app::main");
    println("  --requires-root <path>        Root directory for resolved requires (default unresolved)");
    println("  --std-config <path>       Standard library manifest path");
    println("  --no-std                  Compile without standard library");
    println("");
    println("Build mode (selects the clang flags used for the generated C):");
    println("  --debug                   -O0 -g   (unoptimized, debuggable)");
    println("  --release                 -O2      (optimized)");
    println("  --optimize <level>        Explicit clang level: 0, 1, 2, 3, s or fast");
    println("                            Default: -O1");
};

// Shared: read file from disk.
file_private let read_source(file_path String) Option[String] = {
    let source = read_text_file(file_path.into_path()) or else {
        eprintln("Error: Failed to read file: \(file_path)");
        return Option[String].None();
    };
    return Option[String].Some(source);
};

file_private let normalize_path_for_match(path String) String =
path.into_path().normalize().to_string().replace_all("\\", with: "/").to_ascii_lowercase();

file_private let path_matches_user_file(diag_path String, user_file_path String) Bool = {
    let diag_norm = normalize_path_for_match(diag_path);
    let user_norm = normalize_path_for_match(user_file_path);
    if diag_norm == user_norm then {
        return true;
    };

    let user_input_norm = user_file_path.replace_all("\\", with: "/").to_ascii_lowercase();
    if diag_norm == user_input_norm or diag_norm.ends_with("/" + user_input_norm) then {
        return true;
    };

    let user_base = user_file_path.into_path().base_name().to_ascii_lowercase();
    if not user_base.is_empty() and (diag_norm == user_base or diag_norm.ends_with("/" + user_base)) then {
        return true;
    };

    return false;
};

file_private let diagnostic_record_severity_label(severity DiagnosticSeverity) String = {
    return when severity in {
        .Error() then "error",
        .Warning() then "warning",
        .Note() then "note",
    };
};

file_private let format_cli_diagnostic_record(record DiagnosticRecord, user_file_path String) String = {
    let diag = record.diagnostic;
    let render_path = if diag.file_path.is_empty() then user_file_path else diag.file_path;
    let rendered_message = diag.detail;
    let mutable header = StringBuilder.new();
    when diag.span in {
        .Some(span) then if is_known_span(span) then header.push_string("\(render_path):\(span.start.line):\(span.start.column): \(diagnostic_record_severity_label(record.severity)): \(rendered_message)") else header.push_string("\(render_path): \(diagnostic_record_severity_label(record.severity)): \(rendered_message)"),
        .None() then header.push_string("\(render_path): \(diagnostic_record_severity_label(record.severity)): \(rendered_message)"),
    };
    for note in record.notes then {
        header.push_string("\n  note: ");
        header.push_string(note.message);
    };
    return header.to_string();
};

file_private let print_user_focused_diagnostic_records(diagnostics DiagnosticCollector, user_file_path String) Void = {
    if env("KORAL_PRINT_ALL_DIAGNOSTICS") is .Some(flag) and (flag == "1" or flag == "true" or flag == "TRUE") then {
        for record in diagnostics.all_records() then {
            eprintln(format_cli_diagnostic_record(record, user_file_path));
        };
        return;
    };
    for record in diagnostics.all_records() then {
        eprintln(format_cli_diagnostic_record(record, user_file_path));
    };
};

file_private let diagnostic_stage_label(stage DiagnosticStage) String = {
    return when stage in {
        .Lexer() then "lexer error",
        .Parser() then "syntax error",
        .Semantic() then "error",
        .Other() then "error",
    };
};

file_private let sanitize_module_artifact_name(module_name String) String = {
    let mutable out = StringBuilder.new();
    let mutable i UInt = 0;
    let mutable pending_sep = false;
    while i < module_name.count() then {
        let ch = module_name[i];
        if ch == ':' or ch == '/' then {
            if not pending_sep then {
                out.push_string("__");
                pending_sep = true;
            };
        } else {
            out.push_byte(ch);
            pending_sep = false;
        };
        i += 1;
    };
    return out.to_string();
};

file_private let contains_string(values List[String], target String) Bool = {
    for value in values then {
        if value == target then {
            return true;
        };
    };
    return false;
};

file_private let contains_module_path(paths List[List[String]], target List[String]) Bool = {
    for path in paths then {
        if string_list_eq(path, target) then {
            return true;
        };
    };
    return false;
};

file_private let collect_unique_module_paths_from_pairs(pairs List[Pair[LoadedNode, List[String]]]) List[List[String]] = {
    let mutable seen = Set[String].new();
    let mutable out = List[List[String]].new();
    for pair in pairs then {
        let key = pair.second.join_to_string(".");
        if not seen.contains(key) then {
            seen.insert(key);
            out.push(pair.second);
        };
    };
    return out;
};

file_private let collect_unique_source_paths_from_pairs(pairs List[Pair[LoadedNode, List[String]]]) List[String] = {
    let mutable seen = Set[String].new();
    let mutable out = List[String].new();
    for pair in pairs then {
        let source_path = pair.first.source_file;
        if not seen.contains(source_path) then {
            seen.insert(source_path);
            out.push(source_path);
        };
    };
    return out;
};

file_private let make_prepared_compilation(
    std_pairs List[Pair[LoadedNode, List[String]]],
    user_pairs List[Pair[LoadedNode, List[String]]],
    merged_graph ImportGraph,
    display_name String,
    artifact_base_name String,
    linked_libraries List[String],
    default_output_dir Path,
    root_module_path String,
    parsed_defaults Dict[String, String],
) PreparedCompilation = {
    let mutable all_pairs = List[Pair[LoadedNode, List[String]]].new();
    for pair in std_pairs then {
        let package_id = if pair.first.package_id.is_empty() then "std:std" else pair.first.package_id;
        all_pairs.push(Pair[LoadedNode, List[String]](
            LoadedNode(pair.first.decl, pair.first.source_file, package_id),
            pair.second
        ));
    };
    for pair in user_pairs then {
        let package_id = if pair.first.package_id.is_empty() then "root:user" else pair.first.package_id;
        all_pairs.push(Pair[LoadedNode, List[String]](
            LoadedNode(pair.first.decl, pair.first.source_file, package_id),
            pair.second
        ));
    };

    let mutable loaded_nodes = List[LoadedNode].new();
    let mutable node_source_paths = List[String].new();
    for pair in all_pairs then {
        loaded_nodes.push(pair.first);
        node_source_paths.push(pair.first.source_file);
    };

    let graph = ResolvedModuleGraph(
        root_module_path,
        merged_graph,
        loaded_nodes,
        all_pairs,
        node_source_paths,
        collect_unique_module_paths_from_pairs(all_pairs),
        collect_unique_source_paths_from_pairs(all_pairs),
        parsed_defaults,
    );

    return PreparedCompilation(graph, display_name, artifact_base_name, linked_libraries, default_output_dir);
};

/// The standard library's main module is the prelude: it is compiled in and in
/// scope in every non-std module without being named. It is therefore NOT part
/// of the `using` graph -- it is the base the graph sits on (§6.4's "主模块是基础层").
file_private let load_prelude_into(resolver ModuleResolver, registry PackageRegistry, unit CompilationUnit) Result[Void] = {
    when prelude_module_spec(registry) in {
        .Some(spec) then {
            let _ = resolver.resolve_module_spec(spec, unit) or return;
        },
        .None() then {},
    };
    return Result[Void].Ok({});
};

/// Load the target module and everything its `using` statements reach. The
/// module graph is exactly those edges (§5.4) -- nothing is loaded that no
/// `using` asked for, and nothing that IS asked for is skipped.
file_private let load_target_unit(
    resolver ModuleResolver,
    registry PackageRegistry,
    root LoadedPackage,
    target_spec ResolvedModuleSpec,
) Result[CompilationUnit] = {
    resolver.set_packages(registry, root);
    let unit = CompilationUnit.empty();
    load_prelude_into(resolver, registry, unit) or return;
    let _ = resolver.resolve_module_spec(target_spec, unit) or return;
    return Result[CompilationUnit].Ok(unit);
};

/// `links` follow the code (§5.4): a module that needs `-lm` says so, and
/// anything that imports that module inherits the requirement.
file_private let linked_libraries_of(resolver ModuleResolver) List[String] = {
    let mutable out = List[String].new();
    for spec in resolver.loaded_module_specs() then {
        for link in spec.links then {
            out.push(link);
        };
    };
    return out;
};

/// Split loaded nodes into standard-library and everything else, emitting in
/// full-name order so the tables do not depend on which `using` was seen first.
file_private let split_pairs_by_package(
    pairs List[Pair[LoadedNode, List[String]]],
) Pair[List[Pair[LoadedNode, List[String]]], List[Pair[LoadedNode, List[String]]]] = {
    let mutable std_pairs = List[Pair[LoadedNode, List[String]]].new();
    let mutable user_pairs = List[Pair[LoadedNode, List[String]]].new();
    for pair in pairs then {
        if pair.first.package_id.starts_with("std:") then {
            std_pairs.push(pair);
        } else {
            user_pairs.push(pair);
        };
    };
    return Pair[List[Pair[LoadedNode, List[String]]], List[Pair[LoadedNode, List[String]]]](std_pairs, user_pairs);
};

/// Turn a module full name written the way source writes it
/// (`package[/subpath]`) into the module it names, looked up in `root`'s table.
file_private let resolve_target_spec(
    raw_name String,
    root LoadedPackage,
    registry PackageRegistry,
) Result[ResolvedModuleSpec] = {
    let mutable head = raw_name;
    let mutable subpath = "";
    when raw_name.split_once("/") in {
        .Some(pair) then {
            head = pair.first;
            subpath = pair.second;
        },
        .None() then {},
    };
    if head.is_empty() or not is_valid_package_or_segment_name(head) then {
        return Result[ResolvedModuleSpec].Error(manifest_error_text(.MissingTargetModule(raw_name)));
    };

    let owner = registry.resolve_name(head, root) or else {
        return Result[ResolvedModuleSpec].Error(manifest_error_text(.UnknownPackageName(head, "--target-module", registry.known_names(root))));
    };
    let key = if subpath.is_empty() then "." else subpath;
    let config = owner.manifest.modules.get(key) or else {
        if subpath.is_empty() then {
            // Naming the package root asks for the main module. Say that this
            // package has none and what it does have -- an undifferentiated
            // "not found" hides which of the two readings failed.
            return Result[ResolvedModuleSpec].Error(manifest_error_text(.NoMainModule(owner.self_name, declared_module_keys(owner.manifest))));
        };
        return Result[ResolvedModuleSpec].Error(manifest_error_text(.MissingTargetModule(raw_name)));
    };
    let root_name = root_view_name(owner, registry, root);
    return Result[ResolvedModuleSpec].Ok(make_resolved_module_spec(key, config, root_name, owner));
};

file_private let prepare_package_compilation(options InvocationOptions) Result[PreparedCompilation] = {
    let package_config_path = options.package_config_path or else {
        return Result[PreparedCompilation].Error("Error: Missing input file or --package-config");
    };
    let resolved_std_manifest_path = if options.no_std then Option[String].None() else when options.std_config_path in {
        .Some(path) then Option[String].Some(path),
        .None() then find_std_manifest_path(),
    };
    let registry = load_package_registry(package_config_path, resolved_std_manifest_path, options.requires_root) or return;
    let root = registry.root_package or else {
        return Result[PreparedCompilation].Error(manifest_error_text(.FileNotFound(package_config_path)));
    };

    // The default build target is the main module -- the one declared under the
    // `modules` key `"."`. A package with no main module has no default (§5.1).
    let mutable target_full_name = when options.target_module_name in {
        .Some(name) then name,
        .None() then "",
    };
    if target_full_name.is_empty() then {
        // The default build target is the main module (§5.1). A package with
        // no main module has no default -- the caller has to say which one.
        if root.manifest.modules.get(".") is .Some(_) then {
            target_full_name = root.self_name;
        } else {
            return Result[PreparedCompilation].Error(manifest_error_text(.Message("Missing default target module; pass --target-module")));
        };
    };
    let target_spec = resolve_target_spec(target_full_name, root, registry) or return;

    let resolver = ModuleResolver.new();
    let unit = load_target_unit(resolver, registry, root, target_spec) or return;

    let pair_split = split_pairs_by_package(unit.collect_all_nodes_with_path_sorted());
    let linked_libraries = linked_libraries_of(resolver);
    let default_output_dir = package_config_path.into_path().dir_name();

    return Result[PreparedCompilation].Ok(make_prepared_compilation(
        pair_split.first,
        pair_split.second,
        unit.import_graph(),
        target_full_name,
        sanitize_module_artifact_name(target_full_name),
        linked_libraries,
        default_output_dir,
        target_spec.path_segments.join_to_string("."),
        unit.collect_parsed_defaults(),
    ));
};

file_private let prepare_single_file_compilation(options InvocationOptions) Result[PreparedCompilation] = {
    let entry_file_path = options.entry_file_path or else {
        return Result[PreparedCompilation].Error("Error: Missing input file or --package-config");
    };
    let absolute_entry = when absolute_path(entry_file_path.into_path()) in {
        .Ok(p) then p.to_string(),
        .Error(_) then entry_file_path,
    };

    let resolver = ModuleResolver.new();
    // Everything goes in ONE unit. The prelude and the file's own `using` may
    // name the same module; two units would compile it twice.
    let unit = CompilationUnit.empty();

    // A bare file has no package of its own. The standard library is still
    // nameable -- `using "std/io";` is a package import even here -- so the
    // registry std brings with it is installed before the file is read.
    let resolved_std_manifest_path = if options.no_std then Option[String].None() else when options.std_config_path in {
        .Some(path) then Option[String].Some(path),
        .None() then find_std_manifest_path(),
    };

    when resolved_std_manifest_path in {
        .Some(std_manifest_path) then {
            let registry = load_package_registry(std_manifest_path, Option[String].Some(std_manifest_path), Option[String].None()) or return;
            let std_package = registry.std_package or else {
                return Result[PreparedCompilation].Error("standard library not found");
            };
            resolver.set_packages(registry, std_package);
            load_prelude_into(resolver, registry, unit) or return;
        },
        .None() then {},
    };

    let stem = absolute_entry.into_path().with_ext_name("").base_name();
    let root_module = ModuleInfo.named(
        [module_file_name_to_identifier(stem)],
        absolute_entry,
        false,
        stem,
        "root:user",
    );
    unit.add_module(root_module);
    resolver.resolve_single_file(root_module, unit) or return;

    let pair_split = split_pairs_by_package(unit.collect_all_nodes_with_path());
    let default_output_dir = absolute_entry.into_path().dir_name();
    return Result[PreparedCompilation].Ok(make_prepared_compilation(
        pair_split.first,
        pair_split.second,
        unit.import_graph(),
        entry_file_path,
        sanitize_module_artifact_name(stem),
        linked_libraries_of(resolver),
        default_output_dir,
        root_module.path_string(),
        unit.collect_parsed_defaults(),
    ));
};

file_private let prepare_compilation(options InvocationOptions) Result[PreparedCompilation] = {
    return when options.package_config_path in {
        .Some(_) then prepare_package_compilation(options),
        .None() then prepare_single_file_compilation(options),
    };
};

file_private let run_check(options InvocationOptions) Int = {

    let prepared = prepare_compilation(options) or else {
        eprintln(it.message());
        return 1;
    };
    let result = check_resolved_graph(prepared.graph, prepared.display_name);

    if result.diagnostics.has_errors() then {

        print_user_focused_diagnostic_records(result.diagnostics, prepared.display_name);
        return 1;
    };

    return 0;
};

file_private let run_emit_typed_ast(options InvocationOptions) Int = {

    let prepared = prepare_compilation(options) or else {
        eprintln(it.message());
        return 1;
    };
    let result = type_check_resolved_graph(prepared.graph, prepared.display_name);

    if result.diagnostics.has_errors() then {

        print_user_focused_diagnostic_records(result.diagnostics, prepared.display_name);
        return 1;
    };

    if result.typed_program is .Some(typed_program) then {
        print_typed_program(typed_program);
    } else {
        return 1;
    };

    return 0;
};

file_private let run_resolve_module(options InvocationOptions) Int = {
    let prepared = prepare_compilation(options) or else {
        eprintln("module resolution failed: \(it.message())");
        return 1;
    };
    let graph = prepared.graph;

    println("Resolved module graph for: \(prepared.display_name)");
    println("root module path: \(graph.root_module_path)");
    println("module paths (\(graph.module_paths.count())):");
    for module_path in graph.module_paths then {
        let module_path_text = module_path.join_to_string(".");
        println("  - \(module_path_text)");
    };
    println("source files (\(graph.source_files.count())):");
    for source_file in graph.source_files then {
        println("  - \(source_file)");
    };
    return 0;
};

// ── build command ─────────────────────────────────────────────────────────────

// Find clang by searching PATH, mirroring Swift Driver.findExecutable("clang").
file_private let find_clang() String = {
    let path_env = if env("PATH") is .Some(path) then path else if env("Path") is .Some(path) then path else { return "clang";};
    let is_windows = if env("OS") is .Some(os) then os.contains("Windows") else false;
    let sep = if is_windows then ";" else ":";
    let exts = if is_windows then [".exe", ".cmd", ".bat", ""] else [""];
    for dir in path_env.split(sep) then {
        for ext in exts then {
            let candidate = dir + "/clang" + ext;
            if path_exist(candidate.into_path()) then { return candidate;};
        };
    };
    return "clang";
};

// Invoke clang to compile a .c file to an executable.
// Uses Inherit stdio (no pipe) to avoid buffer deadlock, mirroring Swift runSubprocess.
// Returns true on success.
file_private let run_clang(c_file String, exe_file String, linked_libraries List[String], optimize_args List[String]) Bool = {
    let clang = find_clang();

    let mutable clang_args = List[String].new();
    clang_args.push(c_file);

    // Include koral_runtime.c and header if available
    if find_std_lib_path() is .Some(std_path) then {
        let runtime_c = std_path + "/koral_runtime.c";
        if path_exist(runtime_c.into_path()) then {
            clang_args.push(runtime_c);
        };
        clang_args.push("-I");
        clang_args.push(std_path);
    };

    clang_args.push("-o");
    clang_args.push(exe_file);
    clang_args.push("-Wno-everything");
    for opt in optimize_args then {
        clang_args.push(opt);
    };

    let mutable seen_libs = Set[String].new();
    for lib in linked_libraries then {
        if lib == "c" or seen_libs.contains(lib) then {
            continue;
        };
        seen_libs.insert(lib);
        clang_args.push("-l\(lib)");
    };

    // Windows: link bcrypt and ws2_32 (needed by koral_runtime)
    if env("OS") is .Some(os) and os.contains("Windows") then {
        if not seen_libs.contains("bcrypt") then {
            clang_args.push("-lbcrypt");
        };
        if not seen_libs.contains("ws2_32") then {
            clang_args.push("-lws2_32");
        };
        if not seen_libs.contains("psapi") then {
            clang_args.push("-lpsapi");
        };
    };

    // Use Inherit stdio so clang output goes directly to terminal (no pipe deadlock)
    let status = Command.new(clang)
    .args(clang_args)
    .set_stdout(IoRedirect.Inherit())
    .set_stderr(IoRedirect.Inherit())
    .run() or else {
        eprintln("clang: failed to run: \(it.message())");
        return false;
    };
    if not status.is_success() then {
        return false;
    };
    return true;
};

file_private let build_c_output_path(artifact_base_name String, default_output_dir Path, out_dir Option[String]) Path = {
    return if out_dir is .Some(dir) then {
        dir.into_path().join(artifact_base_name + ".c").normalize()
    } else {
        default_output_dir.join(artifact_base_name + ".c").normalize()
    };
};

type MIRLoweringOutput(
    mir_program Option[MIRProgram],
    context CompilerContext,
    diagnostics DiagnosticCollector,
);

type MonomorphizationOutput(
    mono_program Option[MonomorphizedProgram],
    diagnostics DiagnosticCollector,
);

file_private let empty_typed_program() TypedProgram = {
    return TypedProgram(List[TypedDecl].new(), Dict[UInt, String].new());
};

file_private let empty_body_checker_output() BodyCheckerOutput = {
    return BodyCheckerOutput(
        Option[TypedProgram].None(),
        CompilerContext.new(),
        Scope.new_root(),
        ImportGraph.new(),
        MethodTable.new(),
        TraitRegistry.new(),
        Dict[MethodOwner, List[GenericTraitConformanceTemplate]].new(),
        Dict[String, ConformanceWitness].new(),
        DiagnosticCollector.new(),
        GenericTemplateRegistry.new(),
        Set[InstantiationRequest].new(),
    );
};

file_private let monomorphize_after_typecheck(mutable result BodyCheckerOutput, mutable typed_program TypedProgram, context CompilerContext, phase_prefix String) MonomorphizationOutput = {
    trace_phase(phase_prefix + ": monomorphize");
    let mutable mono = Monomorphizer.new_with_inputs(
        typed_program,
        result.instantiation_requests,
        result.generic_templates,
        context,
        result.global_scope,
        result.import_graph,
        result.method_table,
        result.trait_registry,
        result.conformance_index,
        result.conformance_witnesses,
    );
    typed_program = empty_typed_program();
    result = empty_body_checker_output();

    let built_program = mono.monomorphize();
    if mono.diagnostics().has_errors() then {
        return MonomorphizationOutput(Option[MonomorphizedProgram].None(), mono.diagnostics());
    };
    return MonomorphizationOutput(Option[MonomorphizedProgram].Some(built_program), DiagnosticCollector.new());
};

file_private let lower_mir_after_typecheck(mutable result BodyCheckerOutput, mutable typed_program TypedProgram, display_name String) MIRLoweringOutput = {
    let mutable context = result.context;

    let mono_output = monomorphize_after_typecheck(result, typed_program, context, display_name);
    if mono_output.diagnostics.has_errors() then {
        context.drop_concrete_bodies();
        context.drop_codegen_unused_metadata();
        return MIRLoweringOutput(Option[MIRProgram].None(), context, mono_output.diagnostics);
    };
    let mutable mono_program = mono_output.mono_program.unwrap();

    trace_phase(display_name + ": mir");
    let lowered_mir = lower_monomorphized_program_releasing_source(mono_program, context);
    let mir_program = lowered_mir.mir_program;
    if lowered_mir.diagnostics.has_errors() then {
        context.drop_concrete_bodies();
        context.drop_codegen_unused_metadata();
        return MIRLoweringOutput(Option[MIRProgram].Some(mir_program), context, lowered_mir.diagnostics);
    };
    let verifier = MIRVerifier.new(mir_program);
    let mutable diagnostics = lowered_mir.diagnostics;
    let _ = verifier.verify() or else {
        diagnostics.push(make_diagnostic(DiagnosticStage.Other(), display_name, it.message(), unknown_span()));
        context.drop_concrete_bodies();
        context.drop_codegen_unused_metadata();
        return MIRLoweringOutput(Option[MIRProgram].Some(mir_program), context, diagnostics);
    };

    // MIR lowering has consumed the concrete body caches; release them
    // before codegen to reduce peak RSS from retained typecheck artifacts.
    context.drop_concrete_bodies();
    context.drop_codegen_unused_metadata();

    return MIRLoweringOutput(Option[MIRProgram].Some(mir_program), context, DiagnosticCollector.new());
};

type EmitCGenerationInput(
    output_path Path,
    linked_libraries List[String],
    mir_program MIRProgram,
    context CompilerContext,
);

type PreparedEmitTypecheck(
    output_path Path,
    linked_libraries List[String],
    display_name String,
    result BodyCheckerOutput,
);

file_private let prepare_emit_c_typecheck(options InvocationOptions, phase_prefix String) Option[PreparedEmitTypecheck] = {
    let prepared = prepare_compilation(options) or else {
        eprintln(it.message());
        return Option[PreparedEmitTypecheck].None();
    };

    let output_path = build_c_output_path(prepared.artifact_base_name, prepared.default_output_dir, options.out_dir);
    let display_name = prepared.display_name;
    let linked_libraries = prepared.linked_libraries;
    trace_phase(phase_prefix + ": type check");
    let result = type_check_resolved_graph(prepared.graph, display_name);

    return Option[PreparedEmitTypecheck].Some(PreparedEmitTypecheck(
        output_path,
        linked_libraries,
        display_name,
        result,
    ));
};

file_private let prepare_emit_c_generation_input(options InvocationOptions, phase_prefix String) Option[EmitCGenerationInput] = {
    let checked = prepare_emit_c_typecheck(options, phase_prefix) or else {
        return Option[EmitCGenerationInput].None();
    };

    let output_path = checked.output_path;
    let linked_libraries = checked.linked_libraries;
    let display_name = checked.display_name;
    let mutable result = checked.result;

    if result.diagnostics.has_errors() then {
        print_user_focused_diagnostic_records(result.diagnostics, display_name);
        return Option[EmitCGenerationInput].None();
    };

    let mutable typed_program = if result.typed_program is .Some(program) then program else {
        eprintln("\(phase_prefix): typed program unavailable after successful semantic checks");
        return Option[EmitCGenerationInput].None();
    };

    create_dir_all(output_path.dir_name()) or else {
        eprintln("failed to create output directory: \(output_path.dir_name().to_string()): \(it.message())");
        return Option[EmitCGenerationInput].None();
    };

    let lowered = lower_mir_after_typecheck(result, typed_program, phase_prefix);
    if lowered.diagnostics.has_errors() then {
        print_user_focused_diagnostic_records(lowered.diagnostics, display_name);
        return Option[EmitCGenerationInput].None();
    };
    let mir_program = lowered.mir_program or else {
        eprintln("\(phase_prefix): MIR program unavailable after successful monomorphization");
        return Option[EmitCGenerationInput].None();
    };
    return Option[EmitCGenerationInput].Some(EmitCGenerationInput(
        output_path,
        linked_libraries,
        mir_program,
        lowered.context,
    ));
};

file_private let generate_c_from_mir(mir_program MIRProgram, context CompilerContext, phase_prefix String) String = {
    let mutable concrete_mir_program = mir_program;

    let mutable cg = CodeGen.new(concrete_mir_program, context);
    cg.validate_codegen_inputs();
    cg.generate_prelude_into_buffer();
    cg.emit_mir_function_implementations();
    cg.finalize_program_into_buffer();

    let generated_c = cg.into_generated_string();
    let _ = phase_prefix;
    return generated_c;
};

file_private let emit_c(options InvocationOptions, phase_prefix String) Option[Pair[Path, List[String]]] = {
    let generation_input = prepare_emit_c_generation_input(options, phase_prefix) or else {
        return Option[Pair[Path, List[String]]].None();
    };

    trace_phase(phase_prefix + ": codegen");
    let generated_c = generate_c_from_mir(generation_input.mir_program, generation_input.context, phase_prefix);

    write_text_file(generation_input.output_path, content: generated_c) or else {
        eprintln("failed to write output file: \(generation_input.output_path.to_string()): \(it.message())");
        return Option[Pair[Path, List[String]]].None();
    };

    return Option[Pair[Path, List[String]]].Some(Pair[Path, List[String]](generation_input.output_path, generation_input.linked_libraries));
};

file_private let run_emit_c(options InvocationOptions) Int = {
    return when emit_c(options, "emit-c") in {
        .Some(_) then 0,
        .None() then 1,
    };
};

file_private let run_build(options InvocationOptions) Int = {
    let output = emit_c(options, "build") or else { return 1;};
    let output_path = output.first;
    let linked_libraries = output.second;

    let is_windows = if env("OS") is .Some(os) then os.contains("Windows") else false;
    let exe_path = output_path.with_ext_name(if is_windows then ".exe" else "");

    if not run_clang(output_path.to_string(), exe_path.to_string(), linked_libraries, options.optimize_args) then {
        eprintln("clang compilation failed");
        return 1;
    };

    println("Build successful: \(exe_path.to_string())");
    return 0;
};

file_private let run_run(options InvocationOptions) Int = {
    let output = emit_c(options, "run") or else { return 1;};
    let output_path = output.first;
    let linked_libraries = output.second;

    let is_windows = if env("OS") is .Some(os) then os.contains("Windows") else false;
    let exe_path = output_path.with_ext_name(if is_windows then ".exe" else "");

    if not run_clang(output_path.to_string(), exe_path.to_string(), linked_libraries, options.optimize_args) then {
        eprintln("clang compilation failed");
        return 1;
    };

    let result = Command.new(exe_path.to_string())
    .set_stdout(IoRedirect.Inherit())
    .set_stderr(IoRedirect.Inherit())
    .run() or else {
        eprintln("failed to run: \(it.message())");
        return 1;
    };
    return if result.is_success() then 0 else (result.code() or else 1);
};
