public type TokenKind {
    Identifier(name: String),
    IntegerLiteral(value: String),
    DurationLiteral(value: String, unit: String),
    FloatLiteral(value: String),
    StringLiteral(value: String),
    InterpolatedString(parts: List[InterpolatedStringTokenPart]),
    RuneLiteral(value: String),

    KwLet(),
    KwMut(),
    KwType(),
    KwIf(),
    KwWhile(),
    KwFor(),
    KwWhen(),
    KwIs(),
    KwIn(),
    KwAs(),
    KwGiven(),
    KwTrait(),
    KwIntrinsic(),
    KwForeign(),
    KwUsing(),
    KwPrivate(),
    KwInternal(),
    KwProtected(),
    KwPublic(),
    Bang(),
    QuestionMark(),
    KwSelf(),
    KwSelfType(),
    KwReturn(),
    KwBreak(),
    KwContinue(),
    KwDefer(),
    KwThen(),
    KwElse(),
    KwAnd(),
    KwOr(),
    KwNot(),
    KwTrue(),
    KwFalse(),
    /// The null-pointer literal `null` -- a hard keyword literal, same class
    /// as `true` / `false`. It JOINS the expected pointer type; it is never an
    /// identifier.
    KwNull(),
    KwUnsafe(),
    KwWhere(),

    Plus(),
    Minus(),
    Star(),
    Slash(),
    Percent(),
    Ampersand(),
    Pipe(),
    Caret(),
    Tilde(),
    LeftShift(),
    RightShift(),

    Assign(),
    PlusAssign(),
    MinusAssign(),
    StarAssign(),
    SlashAssign(),
    PercentAssign(),
    AmpersandAssign(),
    PipeAssign(),
    CaretAssign(),
    LeftShiftAssign(),
    RightShiftAssign(),
    EqualEqual(),
    NotEqual(),
    Greater(),
    Less(),
    GreaterEqual(),
    LessEqual(),

    Comma(),
    Dot(),
    Ellipsis(),
    DoubleColon(),
    Colon(),
    Semicolon(),

    LParen(),
    RParen(),
    LBracket(),
    RBracket(),
    LBrace(),
    RBrace(),

    Range(),
    RangeLess(),
    LessRange(),
    LessRangeLess(),
    EllipsisLt(),
    LtEllipsis(),

    Arrow(),
    // `=>` introduces a lambda body; `->` is the function-type arrow
    FatArrow(),

    Eof(),
};

public type InterpolatedStringTokenPart {
    Literal(value: String),
    ExpressionTokens(tokens: List[Token]),
};

public type Token(kind: TokenKind, line: UInt, column: UInt, has_newline_before: Bool);
