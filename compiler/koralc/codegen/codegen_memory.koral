// codegen_memory.koral - MIR-oriented copy/drop helpers

let drop_thunk_marker(): String = {
    return "/* __koral_drop_thunks__ */\n";
};

let fixed_array_typedef_marker(): String = {
    return "/* __koral_array_typedefs__ */\n";
};

let fn_ptr_typedef_marker(): String = {
    return "/* __koral_fnptr_typedefs__ */\n";
};

/// 定长数组包装 struct 的 typedef：形状 → 名字，以及待 splice 的 typedef 文本。
/// 名字由 codegen 的命名路径统一发（指针命名等递归都经过它），顺序即注册
/// 顺序（内层形状先注册），生成的 typedef 天然有序。
/// foreign 函数指针的 typedef：形状 → 名字，以及待 splice 的 typedef 文本
/// （`typedef R (*name)(params);`）。
///
/// 这些表在 codegen 期间就地增长，是编译器自身的可变工作状态；按全局量
/// 规则装进 `unsafe sendable mutable` 持有者（全局绑定的类型必须 sendable，
/// 容器本身保持线程内工作状态的未标注形态）。
type unsafe sendable mutable TypedefTables(
    mutable fixed_array_typedef_names: Dict[String, String],
    mutable fixed_array_typedef_texts: List[String],
    mutable foreign_function_typedef_names: Dict[String, String],
    mutable foreign_function_typedef_texts: List[String],
);

let mutable typedef_tables = TypedefTables(
    Dict[String, String].new(),
    List[String].new(),
    Dict[String, String].new(),
    List[String].new(),
);

/// niche 布局的描述：用「空位模式」而不是 tag 来区分 case。
type EnumNicheLayout(
    empty_case_index: UInt,
    payload_case_index: UInt,
    payload_case_name: String,
    payload_field_name: String,
    payload_field_type: Type,
);

given CodeGen {
    public needs_drop(self, var_type: Type): Bool = {
        let mapped_needs_drop = when var_type in {
            .OpaqueType(def_id) then {
                when self.context.lookup_type(def_id) in {
                    .Some(mapped) then when mapped in {
                        .TraitObject(...) then true,
                        _ then type_needs_drop(mapped),
                    },
                    .None() then false,
                }
            },
            _ then false,
        };
        if mapped_needs_drop then {
            return true;
        };
        return type_needs_drop(var_type);
    };

    // ── RC 分流（concurrency-design.md §RC 分流）────────────────────────────
    //
    // 受管对象的 RC 走非原子族当且仅当它的静态类型**确定**为非 sendable
    // （`uses_nonatomic_rc(type) = managed && not is_sendable_type(type)`）；
    // sendable（含 `unsafe sendable`）保持原子族，发射的 C 逐字节不变。
    //
    // 定族看「块的归属类型」：句柄形态 `*T` / `?*T` 按被指对象 T 定族；
    // 函数类型按 `sendable` 修饰位（false → 非原子）；trait object 按 trait
    // 声明的 `trait sendable` 定（concurrency-design.md §派生规则 6）；
    // OpaqueType 解映射后递归。Unknown/TypeVar 是错误恢复与类型擦除占位，
    // 保守走原子族（宁可多算不可少算）。
    //
    // 同一个块只由一族碰：族由静态类型在每个 retain/release/weak/闭包环境
    // 发射点决定，绝不混用于同一块。
    public uses_nonatomic_rc(self, t: Type): Bool = {
        return when t in {
            .ReferenceType(inner) or .MutableReferenceType(inner)
            or .BorrowedReferenceType(inner) or .MutableBorrowedReferenceType(inner)
            or .WeakReferenceType(inner) or .MutableWeakReferenceType(inner) then self.uses_nonatomic_rc(
                inner,
            ),
            .FunctionType(_, _, is_sendable) then not is_sendable,
            .TraitObject(_, _, _) then not self.context.is_sendable_type(t),
            .OpaqueType(def_id) then {
                when self.context.lookup_type(def_id) in {
                    .Some(mapped) then self.uses_nonatomic_rc(mapped),
                    .None() then false,
                }
            },
            .Unknown() or .TypeVar(_) or .GenericParameter(_) or .ModuleType(_) then false,
            _ then not self.context.is_sendable_type(t),
        };
    };

    /// 强 retain 的值层入口名（`*T` 句柄与受管名义值都走这一对）。
    public rc_retain_fn(self, t: Type): String = {
        return if self.uses_nonatomic_rc(t) then "__koral_retain_value_nonatomic" else "__koral_retain_value";
    };

    /// 强 release 的值层入口名（dtor 仍按释放调用点单态化传入）。
    public rc_release_fn(self, t: Type): String = {
        return if self.uses_nonatomic_rc(t) then "__koral_release_value_nonatomic" else "__koral_release_value";
    };

    /// weak 计数入口名（retain/release 同族）。
    public rc_weak_retain_fn(self, t: Type): String = {
        return if self.uses_nonatomic_rc(t) then "__koral_weak_retain_nonatomic" else "__koral_weak_retain";
    };

    public rc_weak_release_fn(self, t: Type): String = {
        return if self.uses_nonatomic_rc(t) then "__koral_weak_release_nonatomic" else "__koral_weak_release";
    };

    /// 闭包环境计数入口名（retain/release 同族）。
    public rc_closure_retain_fn(self, t: Type): String = {
        return if self.uses_nonatomic_rc(t) then "__koral_closure_retain_nonatomic" else "__koral_closure_retain";
    };

    public rc_closure_release_fn(self, t: Type): String = {
        return if self.uses_nonatomic_rc(t) then "__koral_closure_release_nonatomic" else "__koral_closure_release";
    };

    /// weak 句柄转换入口名（downgrade/upgrade 同族）。
    public rc_downgrade_fn(self, t: Type): String = {
        return if self.uses_nonatomic_rc(t) then "__koral_downgrade_ref_nonatomic" else "__koral_downgrade_ref";
    };

    public rc_upgrade_fn(self, t: Type): String = {
        return if self.uses_nonatomic_rc(t) then "__koral_upgrade_ref_nonatomic" else "__koral_upgrade_ref";
    };

    /// 类型无关 drop glue 的入口名（`__koral_Dtor` 实参用）。
    public rc_closure_drop_fn(self, t: Type): String = {
        return if self.uses_nonatomic_rc(t) then "__koral_closure_drop_nonatomic" else "__koral_closure_drop";
    };

    public rc_weakref_drop_fn(self, t: Type): String = {
        return if self.uses_nonatomic_rc(t) then "__koral_weakref_drop_nonatomic" else "__koral_weakref_drop";
    };

    public rc_traitref_drop_fn(self, t: Type): String = {
        return if self.uses_nonatomic_rc(t) then "__koral_traitref_drop_nonatomic" else "__koral_traitref_drop";
    };

    append_assignment_line(self, dest: String, source: String): Void = {
        self.buffer.push_string(dest);
        self.buffer.push_string(" = ");
        self.buffer.push_string(source);
        self.buffer.push_string(";\n");
    };

    append_drop_call_line(self, type_name: String, value: String): Void = {
        self.buffer.push_string("__koral_");
        self.buffer.push_string(type_name);
        self.buffer.push_string("_drop(&(");
        self.buffer.push_string(value);
        self.buffer.push_string("));\n");
    };

    append_copy_call_line(self, type_name: String, source: String, dest: String): Void = {
        let copy_prefix = "__koral_" + type_name + "_copy(";
        if source.starts_with(copy_prefix) then {
            // Source is already a value produced by the type copy helper.
            // Wrapping it again as __koral_Type_copy(&(source)) would take
            // the address of an rvalue and can emit invalid C.
            self.append_assignment_line(dest, source);
            return;
        };
        self.buffer.push_string(dest);
        self.buffer.push_string(" = __koral_");
        self.buffer.push_string(type_name);
        self.buffer.push_string("_copy(&(");
        self.buffer.push_string(source);
        self.buffer.push_string("));\n");
    };

    /// `nonatomic` 由调用点按被碰块的静态类型定（RC 分流，见 uses_nonatomic_rc）。
    append_release_control_line(
        self,
        runtime_name: String,
        value: String,
        nonatomic: Bool,
    ): Void = {
        // 弱引用持有 control 字；owning ref / 托管值是单字 payload 指针。
        let is_weak = runtime_name == "__koral_weak_retain" or runtime_name == "__koral_weak_release";
        if runtime_name == "__koral_release" then {
            // 头里不存析构函数之后，释放必须带上 dtor，只能走 append_release_handle_statement。
            // 走到这里说明有调用点漏改了 —— 直接炸，不要静默发成 retain。
            panic(
                "append_release_control_line: release must go through append_release_handle_statement",
            );
        };
        let resolved_name = if is_weak then {
            if nonatomic then runtime_name + "_nonatomic" else runtime_name
        } else if nonatomic then "__koral_retain_value_nonatomic" else "__koral_retain_value";
        self.buffer.push_string(resolved_name);
        self.buffer.push_string("((");
        self.buffer.push_string(value);
        self.buffer.push_string(if is_weak then ").control);\n" else ").ptr);\n");
    };

    /// `__koral_release_value((value).ptr, dtor)`：头里不存析构函数，
    /// drop glue 在释放调用点单态化后作为第二个参数传入。`nonatomic` 按
    /// 被碰块的静态类型定族（RC 分流）。
    append_release_value_line(self, value: String, dtor: String, nonatomic: Bool): Void = {
        self.buffer.push_string(
            if nonatomic then "__koral_release_value_nonatomic((" else "__koral_release_value((",
        );
        self.buffer.push_string(value);
        self.buffer.push_string(").ptr, ");
        self.buffer.push_string(dtor);
        self.buffer.push_string(");\n");
    };

    /// 释放一个**句柄**。`handle_type` 是引用或 trait object。
    ///
    /// - owning reference：`value.ptr` 指向一个 C 值，dtor 是该值的原地 drop glue。
    /// - trait object：dtor 是**动态**的（具体类型的 glue 在 `value.vtable` 里）。
    /// - weak reference：只减 weak 计数，不碰 payload（可能已死）。
    /// - 借用：不拥有，什么都不做。
    public append_release_handle_statement(self, handle_type: Type, value: String): Void = {
        when handle_type in {
            .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) then {},
            .WeakReferenceType(_) or .MutableWeakReferenceType(_) then {
                self.buffer.push_string(
                    if self.uses_nonatomic_rc(handle_type) then "__koral_weak_release_nonatomic(("
                    else "__koral_weak_release((",
                );
                self.buffer.push_string(value);
                self.buffer.push_string(").control);\n");
            },
            .TraitObject(...) then {
                self.append_release_value_line(
                    value,
                    "((const struct __koral_VTableHeader*)(\(value)).vtable)->destroy",
                    self.uses_nonatomic_rc(handle_type),
                );
            },
            .ReferenceType(inner) or .MutableReferenceType(inner) then {
                if self.is_trait_object_type(inner) then {
                    self.append_release_value_line(
                        value,
                        "((const struct __koral_VTableHeader*)(\(value)).vtable)->destroy",
                        self.uses_nonatomic_rc(inner),
                    );
                } else {
                    self.append_release_value_line(
                        value,
                        self.drop_function_pointer(inner),
                        self.uses_nonatomic_rc(inner),
                    );
                };
            },
            .OpaqueType(def_id) then {
                when self.context.lookup_type(def_id) in {
                    .Some(mapped) then self.append_release_handle_statement(
                        mapped,
                        value,
                    ),
                    .None() then {},
                };
            },
            _ then {},
        };
    };

    /// 判断类型是否是 trait object（含 OpaqueType 映射到 trait object 的情况）。
    public is_trait_object_type(self, var_type: Type): Bool = {
        return when var_type in {
            .TraitObject(...) then true,
            .OpaqueType(def_id) then {
                when self.context.lookup_type(def_id) in {
                    .Some(mapped) then self.is_trait_object_type(mapped),
                    .None() then false,
                }
            },
            _ then false,
        };
    };

    // ── Enum niche layout ──────────────────────────────────────────────────
    //
    // 两 case、其中恰好一个无参数、另一个恰好一个参数且该参数的 C 表示整段就是
    // 一个可空指针字时，枚举可以不带 tag —— 用那个指针的 NULL 位模式表示空 case。
    // 这正是 `Option[T] { None(), Some(value T) }` 的形状。

    /// C 表示是否整段就是一个可空指针字 —— NULL 是未使用的位模式。
    ///
    /// 不变量：**活的 owning handle 永不为 NULL**。`__koral_upgrade_ref` 失败时返回的
    /// null ref 是瞬时值，生成代码立刻转成 Option 的 None，从不作为活值流出。
    /// 将来若有「可空句柄」类型，必须先排除出 niche 名单。
    has_null_niche(self, var_type: Type): Bool = {
        return when var_type in {
            // managed 名义 wrapper 是 `struct X { void* ptr; }`，单字。
            .StructureType(_) then self.uses_managed_nominal_representation(var_type),
            .EnumType(_) or .GenericStruct(...) or .GenericEnum(...) then self.uses_managed_nominal_representation(var_type),
            // 引用 + 弱句柄有空位（type_is_tracked_handle）。Int/Float 全位模式
            // 有效；Closure 是三字；TraitRef 是两字；裸指针的 NULL 合法；
            // 值布局枚举（包括已用 niche 布局的）不带空位 —— 嵌套 Option[Option[T]]
            // 必须回落 tag 布局，否则 `.None()` 与 `.Some(Option.None())` 无法区分。
            _ then type_is_tracked_handle(var_type),
        };
    };

    /// 承载 niche 的那个字段的「置空」语句。`field_path` 是该字段的完整 C 路径。
    niche_null_assignment(self, var_type: Type, field_path: String): String = {
        return when var_type in {
            .WeakReferenceType(_) or .MutableWeakReferenceType(_) then "\(field_path).control = NULL;\n",
            _ then "\(field_path).ptr = NULL;\n",
        };
    };

    /// 「值为空」的 C 条件表达式。
    niche_null_test(self, var_type: Type, value_expr: String): String = {
        return when var_type in {
            .WeakReferenceType(_) or .MutableWeakReferenceType(_) then "(\(value_expr).control == NULL)",
            _ then "(\(value_expr).ptr == NULL)",
        };
    };

    /// 由值表达式算出 case 序号（`intptr_t`），供 `switch` 分派使用。
    niche_tag_expression(self, layout: EnumNicheLayout, value_expr: String): String = {
        return "(\(self.niche_null_test(layout.payload_field_type, value_expr)) ? \(layout.empty_case_index.to_string()) : \(layout.payload_case_index.to_string()))";
    };

    /// 按 case 列表判定 niche 布局；形状不对（或参数类型没有 niche）返回 None。
    enum_niche_layout(self, cases: List[TypedEnumCase]): Option[EnumNicheLayout] = {
        if cases.count() != 2 then {
            return Option[EnumNicheLayout].None();
        };
        let mutable empty_case_index: UInt = 0;
        let mutable empty_count: UInt = 0;
        let mutable payload_case_index: UInt = 0;
        let mutable payload_count: UInt = 0;
        let mutable payload_case_name = "";
        let mutable payload_fields = List[TypedEnumCaseField].new();
        let mutable case_index: UInt = 0;
        for case_info in cases then {
            if case_info.fields.is_empty() then {
                empty_count += 1;
                empty_case_index = case_index;
            } else {
                payload_count += 1;
                payload_case_index = case_index;
                payload_case_name = case_info.name;
                payload_fields = case_info.fields;
            };
            case_index += 1;
        };
        if empty_count != 1 or payload_count != 1 then {
            return Option[EnumNicheLayout].None();
        };
        // Void 参数不占存储，先滤掉再数。
        let mutable field_count: UInt = 0;
        let mutable payload_field_name = "";
        let mutable payload_field_type = Type.VoidType();
        for field in payload_fields then {
            if not self.type_is_void(field.field_type) then {
                field_count += 1;
                payload_field_name = field.name;
                payload_field_type = field.field_type;
            };
        };
        if field_count != 1 then {
            return Option[EnumNicheLayout].None();
        };
        if not self.has_null_niche(payload_field_type) then {
            return Option[EnumNicheLayout].None();
        };
        return Option[EnumNicheLayout].Some(
            EnumNicheLayout(
                empty_case_index,
                payload_case_index,
                payload_case_name,
                payload_field_name,
                payload_field_type,
            ),
        );
    };

    /// 从类型出发判定 niche 布局。
    ///
    /// 必须读**实例化后**的 case 列表，与 `generate_enum_declaration` 喂进去的那份
    /// 完全相同 —— 否则布局判定与结构体定义会不一致，构造路径按带 tag 的布局发码，
    /// 而结构体根本没声明 `tag` 字段。
    ///
    /// 泛型枚举的模板声明里 payload 类型还是未实例化的 `T`，`concrete_enum_cases_from_def`
    /// 会因「含未解析泛型」返回 None，于是「查不到 niche」与「真没有 niche」混为一谈。
    /// 所以先把泛型实例解析到它的布局声明（同 `register_type_declaration_for_used_type`
    /// 与 codegen_mir 的做法），再从那份声明读 case。
    enum_niche_layout_for_type(self, t: Type): Option[EnumNicheLayout] = {
        let def_id = when t in {
            .EnumType(id) then Option[DefId].Some(id),
            // Identity is the instance's LAYOUT declaration, not the template.
            .GenericEnum(...) then self.find_type_def_id_by_layout_or_template(t),
            _ then Option[DefId].None(),
        };
        return when def_id in {
            .Some(id) then {
                when self.concrete_enum_cases_from_def(id) in {
                    .Some(cases) then self.enum_niche_layout(cases),
                    .None() then Option[EnumNicheLayout].None(),
                }
            },
            .None() then Option[EnumNicheLayout].None(),
        };
    };

    // ── Drop glue as a function pointer ─────────────────────────────────────
    //
    // 头里不存析构函数之后，`__koral_release_value` 的第二个参数必须在**释放调用点**
    // 就绪。绝大多数类型已有同构的 `__koral_*_drop(void*)`，直接取函数名即可；
    // 剩下的（典型是 `Ref[Y]`，其 drop 依赖内层类型）按需物化一个 thunk。

    /// 「原地销毁一个 var_type 类型 C 值」的 `__koral_Dtor` 表达式。
    /// 没有 drop glue 的类型返回 `NULL`。
    ///
    /// 注意：trait object 的销毁是**动态**的（具体类型的 glue 在 vtable 里），
    /// 不要对 trait object 句柄用本函数 —— 用 append_release_handle_statement。
    public drop_function_pointer(self, var_type: Type): String = {
        if not self.needs_drop(var_type) then {
            return "NULL";
        };
        return when var_type in {
            .StructureType(def_id) or .EnumType(def_id) then "(__koral_Dtor)__koral_\(self.c_name_for_def_id(def_id))_drop",
            .GenericStruct(...) or .GenericEnum(...) then {
                let type_name = when self.find_type_def_id_by_layout_or_template(
                    var_type,
                ) in {
                    .Some(def_id) then self.c_name_for_def_id(def_id),
                    .None() then self.sanitize_codegen_identifier(
                        self.context.get_layout_key(var_type),
                    ),
                };
                "(__koral_Dtor)__koral_\(type_name)_drop"
            },
            .FunctionType(...) then "(__koral_Dtor)\(self.rc_closure_drop_fn(var_type))",
            .WeakReferenceType(_) or .MutableWeakReferenceType(_) then "(__koral_Dtor)\(self.rc_weakref_drop_fn(var_type))",
            .TraitObject(...) then "(__koral_Dtor)\(self.rc_traitref_drop_fn(var_type))",
            .ReferenceType(_) or .MutableReferenceType(_) then "(__koral_Dtor)\(self.materialize_drop_thunk(var_type))",
            .OpaqueType(def_id) then {
                when self.context.lookup_type(def_id) in {
                    .Some(mapped) then self.drop_function_pointer(mapped),
                    .None() then "NULL",
                }
            },
            .TypeVar(_) then "NULL",
            _ then "NULL",
        };
    };

    /// 为没有现成 `void (*)(void*)` glue 的类型物化一个 thunk，并返回函数名。
    materialize_drop_thunk(self, var_type: Type): String = {
        let key = self.c_type_name(var_type);
        when self.drop_thunk_names.get(key) in {
            .Some(existing) then {
                return existing;
            },
            .None() then {},
        };
        let name = "__koral_drop_thunk_\(self.drop_thunk_defs.count())";
        self.drop_thunk_names.insert(key, name);

        let saved_buffer = self.buffer;
        self.buffer = CodegenBuffer.new();
        self.buffer.push_string("    ");
        self.buffer.push_string(self.c_type_name(var_type));
        self.buffer.push_string(" __koral_thunk_self = *(");
        self.buffer.push_string(self.c_type_name(var_type));
        self.buffer.push_string("*)raw_value;\n");
        self.buffer.push_string("    ");
        self.append_drop_statement(var_type, "__koral_thunk_self");
        let body = self.buffer.into_string();
        self.buffer = saved_buffer;

        self.drop_thunk_defs.push("static void \(name)(void* raw_value) {\n\(body)}\n");
        return name;
    };

    /// 在类型声明之后、函数体之前插入 thunk 定义。
    public emit_drop_thunk_definitions(self, source: String): String = {
        // The array typedefs splice unconditionally: a program can use fixed
        // arrays and never drop anything.
        let mutable with_typedefs = source.replace_all(
            fixed_array_typedef_marker(),
            with = self.fixed_array_typedef_code(),
        );
        with_typedefs = with_typedefs.replace_all(
            fn_ptr_typedef_marker(),
            with = self.foreign_function_typedef_code(),
        );
        if self.drop_thunk_defs.count() == 0 then {
            return with_typedefs;
        };
        let mutable code = StringBuilder.new();
        for thunk in self.drop_thunk_defs then {
            code.push_string(thunk);
            code.push_string("\n");
        };
        return with_typedefs.replace_all(drop_thunk_marker(), with = code.to_string());
    };

    /// 定长数组的包装 struct typedef 名（首次出现时登记形状）。
    public fixed_array_type_name(self, len: UInt, inner: Type): String = {
        let key = "[\(len)]\(self.c_type_name(inner))";
        when typedef_tables.fixed_array_typedef_names.get(key) in {
            .Some(existing) then existing,
            .None() then {
                let name = "__koral_arr_\(typedef_tables.fixed_array_typedef_texts.count())";
                typedef_tables.fixed_array_typedef_names.insert(key, name);
                typedef_tables.fixed_array_typedef_texts.push(
                    "typedef struct { \(self.c_type_name(inner)) data[\(len)]; } \(name);",
                );
                name
            },
        }
    };

    fixed_array_typedef_code(self): String = {
        let mutable code = StringBuilder.new();
        for text in typedef_tables.fixed_array_typedef_texts then {
            code.push_string(text);
            code.push_string("\n");
        };
        return code.to_string();
    };

    /// foreign 函数指针的 typedef 名（首次出现时登记形状）。
    public foreign_function_type_name(self, params: List[FunctionParamEntry], return_type: Type): String = {
        let mutable key = StringBuilder.new();
        key.push_string("Fn(");
        let mutable first = true;
        for p in params then {
            if not first then {
                key.push_string(",");
            };
            key.push_string(self.c_type_name(p.param_type));
            first = false;
        };
        key.push_string(")->");
        key.push_string(self.c_type_name(return_type));
        let key_text = key.to_string();
        when typedef_tables.foreign_function_typedef_names.get(key_text) in {
            .Some(existing) then existing,
            .None() then {
                let name = "__koral_fnptr_\(typedef_tables.foreign_function_typedef_texts.count())";
                typedef_tables.foreign_function_typedef_names.insert(key_text, name);
                let mutable param_str = StringBuilder.new();
                let mutable p_first = true;
                for p in params then {
                    if not p_first then {
                        param_str.push_string(", ");
                    };
                    param_str.push_string(self.c_type_name(p.param_type));
                    p_first = false;
                };
                typedef_tables.foreign_function_typedef_texts.push(
                    "typedef \(self.c_type_name(return_type)) (*\(name))(\(param_str.to_string()));",
                );
                name
            },
        }
    };

    foreign_function_typedef_code(self): String = {
        let mutable code = StringBuilder.new();
        for text in typedef_tables.foreign_function_typedef_texts then {
            code.push_string(text);
            code.push_string("\n");
        };
        return code.to_string();
    };

    public append_drop_statement(self, var_type: Type, value: String): Void = {
        when var_type in {
            .StructureType(def_id) then {
                if self.is_foreign_type_def_id(def_id) then {
                    return;
                };
                self.append_drop_call_line(self.c_name_for_def_id(def_id), value);
            },
            .EnumType(def_id) then {
                self.append_drop_call_line(self.c_name_for_def_id(def_id), value);
            },
            .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) then {},
            .ReferenceType(_) then self.append_release_handle_statement(var_type, value),
            .MutableReferenceType(_) then self.append_release_handle_statement(
                var_type,
                value,
            ),
            .FunctionType(...) then {
                self.buffer.push_string(self.rc_closure_release_fn(var_type));
                self.buffer.push_string("(");
                self.buffer.push_string(value);
                self.buffer.push_string(");\n");
            },
            .WeakReferenceType(_) or .MutableWeakReferenceType(_) then self.append_release_handle_statement(
                var_type,
                value,
            ),
            .OpaqueType(def_id) then {
                when self.context.lookup_type(def_id) in {
                    .Some(mapped) then when mapped in {
                        .TraitObject(...) then self.append_release_handle_statement(
                            var_type,
                            value,
                        ),
                        .OpaqueType(_) then {},
                        _ then self.append_drop_statement(mapped, value),
                    },
                    .None() then {},
                };
            },
            .GenericStruct(...) or .GenericEnum(...) then {
                let type_name = when self.find_type_def_id_by_layout_or_template(
                    var_type,
                ) in {
                    .Some(def_id) then self.c_name_for_def_id(def_id),
                    .None() then self.sanitize_codegen_identifier(
                        self.context.get_layout_key(var_type),
                    ),
                };
                self.append_drop_call_line(type_name, value);
            },
            .TraitObject(...) then self.append_release_handle_statement(var_type, value),
            .TypeVar(_) then {
                // TypeVar 是编译器内部的类型擦除，落到 codegen 时内层类型已不可知。
                // 头里不存析构函数之后只能传 NULL（drop glue 不会跑）——这是一个
                // 已存在的擦除空洞，不是本次改动引入的。族同保守走原子。
                self.append_release_value_line(value, "NULL", false);
            },
            _ then {},
        };
    };

    public append_copy_assignment(
        self,
        var_type: Type,
        source: String,
        dest: String,
    ): Void = {
        when var_type in {
            .StructureType(def_id) then {
                let type_name = self.c_name_for_def_id(def_id);
                self.add_indent();
                if self.is_foreign_type_def_id(def_id) then {
                    self.append_assignment_line(dest, source);
                } else {
                    self.append_copy_call_line(type_name, source, dest);
                };
            },
            .EnumType(def_id) then {
                self.add_indent();
                self.append_copy_call_line(self.c_name_for_def_id(def_id), source, dest);
            },
            .ReferenceType(_) or .MutableReferenceType(_) or .TraitObject(...) then {
                self.add_indent();
                self.append_assignment_line(dest, source);
                self.add_indent();
                self.append_release_control_line(
                    "__koral_retain",
                    dest,
                    self.uses_nonatomic_rc(var_type),
                );
            },
            .FunctionType(...) then {
                self.add_indent();
                self.append_assignment_line(dest, source);
                self.add_indent();
                self.buffer.push_string(self.rc_closure_retain_fn(var_type));
                self.buffer.push_string("(");
                self.buffer.push_string(dest);
                self.buffer.push_string(");\n");
            },
            .WeakReferenceType(_) or .MutableWeakReferenceType(_) then {
                self.add_indent();
                self.append_assignment_line(dest, source);
                self.add_indent();
                self.append_release_control_line(
                    "__koral_weak_retain",
                    dest,
                    self.uses_nonatomic_rc(var_type),
                );
            },
            .OpaqueType(def_id) then {
                when self.context.lookup_type(def_id) in {
                    .Some(mapped) then when mapped in {
                        .TraitObject(...) then {
                            self.add_indent();
                            self.append_assignment_line(dest, source);
                            self.add_indent();
                            self.append_release_control_line(
                                "__koral_retain",
                                dest,
                                self.uses_nonatomic_rc(var_type),
                            );
                        },
                        .OpaqueType(_) then {
                            self.add_indent();
                            self.append_assignment_line(dest, source);
                        },
                        _ then self.append_copy_assignment(mapped, source, dest),
                    },
                    .None() then {
                        self.add_indent();
                        self.append_assignment_line(dest, source);
                    },
                };
            },
            .GenericStruct(...) or .GenericEnum(...) then {
                let type_name = when self.find_type_def_id_by_layout_or_template(
                    var_type,
                ) in {
                    .Some(def_id) then self.c_name_for_def_id(def_id),
                    .None() then self.sanitize_codegen_identifier(
                        self.context.get_layout_key(var_type),
                    ),
                };
                self.add_indent();
                self.append_copy_call_line(type_name, source, dest);
            },
            _ then {
                self.add_indent();
                self.append_assignment_line(dest, source);
            },
        };
    };

    public append_copy_or_move_assignment(
        self,
        var_type: Type,
        source: String,
        dest: String,
        is_lvalue: Bool,
    ): Void = {
        if is_lvalue and self.needs_drop(var_type) then {
            self.append_copy_assignment(var_type, source, dest);
        } else {
            self.add_indent();
            self.append_assignment_line(dest, source);
        };
    };

    public type_is_void_or_never(self, t: Type): Bool = {
        return when t in {
            .VoidType() or .NeverType() then true,
            _ then false,
        };
    };

    public type_is_void(self, t: Type): Bool = {
        return when t in {
            .VoidType() then true,
            _ then false,
        };
    };

    public type_is_never(self, t: Type): Bool = {
        return when t in {
            .NeverType() then true,
            _ then false,
        };
    };
};
