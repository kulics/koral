// codegen_borrowed_self.koral - borrowed-parameter (guaranteed) analysis
//
// Swift's "guaranteed self" / ARC retain-release pair elision: a method whose
// `self` never escapes can receive its receiver handle +0 (unretained struct
// copy) and must not release it at exit. Every call site of such a method then
// skips the `__koral_*_copy` retain it used to pay, and the callee skips the
// matching `__koral_*_drop` -- one retain/release pair elided per call layer.
// Nested calls on `self` inside such a body (`self.ensure_capacity(...)`)
// elide their pair too, so chains like push -> ensure_capacity pay zero
// refcount ops. The language contract allows this outright: "Reference
// counting is an implementation detail. The compiler may use ARC and hidden
// storage internally." (docs/guide/document.md)
//
// The convention is adopted PER (function instance, parameter) SLOT and must
// hold at EVERY entry point (`self` is simply parameter 0):
//   - call sites: `MIRFunctionCodeEmitter.apply_borrowed_self_receiver_convention`
//     rewrites the self slot (argument 0) of direct calls to `Borrow()`, which
//     `emit_direct_call_argument` already lowers as a +0 pass.
//   - the callee: `build_mir_function_emit_plan` marks the self local
//     non-owning, so it gets no tracked init flag and no epilogue drop.
//   - vtable wrappers: `generate_wrapper_function` must not copy the receiver
//     for a borrowed method (belt only -- the analysis excludes vtable
//     targets from the set, see below).
//
// ── The analysis rule ────────────────────────────────────────────────────────
//
// A method's `self` (parameter 0, named "self", managed nominal handle type)
// is NON-ESCAPING iff its body reads/mutates through `self` but never hands
// the handle onward. Concretely, the body must contain NONE of:
//
//   1. a bare `self`-handle flow outside the receiver slot of a direct call to
//      another non-escaping-self method -- i.e. any `PlaceRead(self)` /
//      `Operand(self)` other than (a) argument 0 of a `MIRCall` to a set
//      member with a Copy/Borrow read, or (b) a `let x = self`-shaped binding
//      that `emit_assign` turns into a retained copy owned by a call-local
//      slot. This covers RETURNS of self, storing self into struct/list/dict
//      elements or globals, passing self to unknown/extern targets, and
//      passing self onward to a method whose own self escapes (the fixpoint).
//   2. a Move/Take read of a place rooted at `self` (a Field/EnumPayload chain
//      reaching the self local) -- a move-out invalidates the owner's slot and
//      cannot be paired under a +0 handle.
//   3. a `Drop` / `Retain` / `Release` statement touching a self-rooted place
//      -- the ledger has no +1 there to release.
//   4. an assignment TO the `self` slot itself (the borrowed handle is not
//      ours to replace).
//   5. a `Ref` / `Pointer` value of a self-rooted place -- "a reference to
//      self" may outlive the call.
//   6. a closure capture of the bare `self` handle -- the closure outlives the
//      call (capturing a projected FIELD value is a plain copy and fine).
//
// Field/projection READS through self (Copy/Borrow) are fine: they retain a
// copy that the normal machinery owns and releases. The fixpoint is the
// greatest one over the receiver-pass edges (item 1a): start with every
// candidate assumed non-escaping and demote until stable, so self-recursive
// and mutually recursive readers stay eligible.
//
// A function is not even a CANDIDATE (stays on the owned convention) if:
//   - its self parameter is not a managed nominal handle (reference/pointer/
//     trait-object self runs on the existing reference machinery; drop bodies
//     take a pointer-typed self and are excluded by the same shape check);
//   - its symbol is ever used as a VALUE (boxed into a closure / bound-method
//     trampoline / function pointer) -- those invocations keep the owned ABI;
//   - any call to it has an unsafe self-slot shape (misaligned ownership list,
//     no receiver, a CONSUMED slot 0, or a slot-0 value whose embedded
//     ownership consumes the source place). A consumed slot 0 is a chain
//     temporary (`create(1).transform().get_value()`'s intermediates): the
//     owned convention transfers the temporary's +1 into the call and drops
//     it at the callee epilogue, and that timing is observable through a user
//     `Drop`. Borrowing is only invisible when the receiver is a place that
//     still owns a count after the call ("a place read is Copy(); a chain
//     temporary is Move()"), so the borrow is restricted to Copy receivers
//     and a method with even one consumed-receiver call site keeps the owned
//     convention at EVERY call site -- the ABI is uniform per function. The
//     same slot-0 rule covers `consume_moved_source` shapes: that would
//     suppress the owner's drop while the borrowed callee releases nothing,
//     leaking the +1. Vtable reachability is handled by the wrapper's safety
//     net instead of an exclusion: trait dispatch always wraps by-value self
//     (`generate_wrapper_function`), and the wrapper pairs the call site's
//     retain with its own release regardless of the method's convention.

/// What a body walk is doing.
type BorrowedSelfWalkMode {
    /// Global usage scan: find value-position function symbols (address
    /// taken) and unsafe call shapes. Runs over every function once.
    GlobalUsage(),
    /// Self-escape scan for one candidate method.
    SelfEscape(),
};

/// Mutable state threaded through one body walk. The walk is parameterized by
/// one ROOT PARAMETER (the `self` of the original use is param 0): a bare
/// handle flow out of that parameter is what decides the convention.
type mutable BorrowedSelfWalk(
    mode: BorrowedSelfWalkMode,
    root_local_id: Int,
    root_param_index: Int,
    // Every phase-1 candidate, keyed by borrowed_slot_key. A bare-root
    // parameter passed to a candidate's matching slot records a fixpoint edge;
    // one passed to anybody else escapes.
    candidates: Dict[String, Bool],
    unsafe_callees: Dict[UInt, Bool],
    unsafe_slots: Dict[String, Bool],
    receiver_deps: Dict[String, Bool],
    // Locals whose ADDRESS is taken anywhere in the walked body (a Ref /
    // Pointer rooted at them). A projection read rooted at any other local
    // cannot be rewritten during a call -- no alias into its storage exists
    // -- so the borrowed convention may pass it +0 without a protective copy.
    address_taken: Set[Int],
    mutable escaped: Bool,
);

/// Fixpoint node for one candidate parameter.
type mutable BorrowedSelfCandidateInfo(
    mutable local_ok: Bool,
    receiver_deps: Dict[String, Bool],
);

/// Candidate/edge key for one (function instance, parameter index) slot. The
/// pair is the ABI unit: the borrowed convention is uniform per slot, not per
/// function -- `f(a, b)` may borrow `a` while owning `b`.
let borrowed_slot_key(def_id: UInt, index: Int): String = {
    return "\(def_id)|\(index)";
};

/// The self parameter's shape: a managed nominal handle (List/String/...
/// style `struct { void* ptr; }` values with copy/drop glue). Reference,
/// pointer, and trait-object selves run on the existing conventions, and a
/// std Drop body's self is re-typed to a mutable pointer by `make_function`,
/// so this one shape check excludes all of them.
let borrowed_self_type_is_candidate(t: Type): Bool = {
    return when t in {
        .StructureType(_) or .EnumType(_) or .GenericStruct(...) or .GenericEnum(...) then type_needs_drop(t),
        _ then false,
    };
};

/// The local a place ultimately roots at, walking Field/EnumPayload
/// projections: taking a reference to a projection takes a reference to the
/// root's storage. Deref/PointerElement bases are value bases and root at
/// nothing here.
let borrowed_self_place_root_local(place: MIRPlace): Option[Int] = {
    let mutable current = place;
    while true then {
        when current in {
            .Local(local) then {
                return Option[Int].Some(local.raw_value);
            },
            .Field(base, _) or .EnumPayload(base, _, _, _, _) then {
                current = base;
            },
            .Global(_) or .Deref(_, _) or .PointerElement(_, _) then {
                return Option[Int].None();
            },
        };
    };
    return Option[Int].None();
};

/// Root classification of a place relative to the self local:
/// 0 = not self-rooted, 1 = self-rooted projection (Field/EnumPayload chain),
/// 2 = the bare self local. Deref/PointerElement bases are VALUE bases and are
/// walked separately; codegen's `root_local_of_place` treats them the same way
/// (a Move read through them is already forced to a retained copy, so their
/// behavior cannot change under the borrowed convention).
let borrowed_self_place_root_kind(place: MIRPlace, root_local_id: Int): UInt = {    let mutable current = place;
    let mutable via_projection = false;
    while true then {
        when current in {
            .Local(local) then {
                if local.raw_value == root_local_id then {
                    return if via_projection then UInt(1) else UInt(2);
                };
                return UInt(0);
            },
            .Field(base, _) or .EnumPayload(base, _, _, _, _) then {
                via_projection = true;
                current = base;
            },
            .Global(_) or .Deref(_, _) or .PointerElement(_, _) then {
                return UInt(0);
            },
        };
    };
    return UInt(0);
};

/// A slot-0 argument that consumes its source place when emitted: the
/// `consume_moved_source` / `consume_moved_place` shapes. Under the borrowed
/// convention the callee releases nothing, so a consumed source would leak
/// its +1; such call shapes disqualify the callee instead.
let borrowed_self_arg0_consumable(value: MIRValue): Bool = {
    return when value in {
        .PlaceRead(_, ownership) then ownership is .Move() or is .Take(),
        .Ref(_, _, allocation) then allocation is .HeapOwnedMove(),
        _ then false,
    };
};

/// The one allowed bare-self shape at a receiver slot: a Copy/Borrow read of
/// the self local. `emit_direct_call_argument` passes that raw (+0) and the
/// callee (a set member) does not release it.
let borrowed_self_is_bare_receiver(value: MIRValue, root_local_id: Int): Bool = {
    return when value in {
        .PlaceRead(place, ownership) then {
            if not (ownership is .Copy() or is .Borrow()) then {
                return false;
            };
            when place in {
                .Local(local) then local.raw_value == root_local_id,
                _ then false,
            }
        },
        _ then false,
    };
};

/// The `let x = self`-shaped binding: `emit_assign` turns a Copy read of the
/// bare self local into a RETAINED copy owned by a call-local slot (which the
/// slot's own cleanup releases), so it is balanced under the +0 handle. Any
/// other value in an assignment is classified normally.
let borrowed_self_is_bare_copy_binding(value: MIRValue, root_local_id: Int): Bool = {
    return when value in {
        .PlaceRead(place, ownership) then {
            if not (ownership is .Copy()) then {
                return false;
            };
            when place in {
                .Local(local) then local.raw_value == root_local_id,
                _ then false,
            }
        },
        _ then false,
    };
};

let borrowed_self_walk_operand(w: BorrowedSelfWalk, operand: MIROperand): Void = {
    when operand in {
        .Local(local) then {
            if w.mode is .SelfEscape() and local.raw_value == w.root_local_id then {
                w.escaped = true;
            };
        },
        .Function(symbol) then {
            if w.mode is .GlobalUsage() then {
                // A function symbol outside the callee slot is being taken as
                // a value (closure box / bound method / function pointer).
                // Such invocations keep the owned ABI, so the function can
                // never adopt the borrowed convention.
                w.unsafe_callees.insert(symbol.def_id.id, true);
            };
        },
        .Constant(_) then {},
    };
};

/// Walk a place's VALUE bases (Deref/PointerElement). Pure structure -- the
/// root classification lives with the consuming value shape.
let borrowed_self_walk_place(w: BorrowedSelfWalk, place: MIRPlace): Void = {
    when place in {
        .Local(_) or .Global(_) then {},
        .Field(base, _) or .EnumPayload(base, _, _, _, _) then borrowed_self_walk_place(
            w,
            base,
        ),
        .Deref(base, _) or .PointerElement(base, _) then borrowed_self_walk_value(
            w,
            base,
            false,
        ),
    };
};

let borrowed_self_walk_call(w: BorrowedSelfWalk, call: MIRCall): Void = {
    let mutable callee_known = false;
    when call.callee in {
        .Function(symbol) then {
            callee_known = true;
            if w.mode is .GlobalUsage() then {
                if call.arguments.count() == 0 then {
                    // A parameterized function invoked without its slots:
                    // leave it on the owned convention rather than reason
                    // about it.
                    w.unsafe_callees.insert(symbol.def_id.id, true);
                } else if call.argument_ownerships.count() != call.arguments.count() then {
                    // The emit side keys every decision off the ownership
                    // list; a misaligned list falls back to owned defaults.
                    w.unsafe_callees.insert(symbol.def_id.id, true);
                } else {
                    for pair in call.arguments.lazy().enumerate() then {
                        if call.argument_ownerships[pair.first] is .Move() or is .Take() then {
                            // The slot carries a CONSUMED value -- a chain
                            // temporary like `create(1).transform().get_value()`'s
                            // intermediates. The owned convention transfers the
                            // temporary's +1 into the call and drops it at the
                            // callee epilogue, and that timing is observable
                            // through a user `Drop`
                            // (tests/compiler-cases/chain_call_drop.koral pins
                            // it). Borrowing is only invisible when the slot
                            // receives a place that still owns a count after
                            // the call, so a slot with even one consumed call
                            // site keeps the owned convention at EVERY call
                            // site (the ABI is uniform per slot).
                            w.unsafe_slots.insert(
                                borrowed_slot_key(symbol.def_id.id, pair.first),
                                true,
                            );
                        } else if borrowed_self_arg0_consumable(pair.second) then {
                            w.unsafe_slots.insert(
                                borrowed_slot_key(symbol.def_id.id, pair.first),
                                true,
                            );
                        };
                    };
                };
            };
        },
        _ then {
            borrowed_self_walk_operand(w, call.callee);
        },
    };

    for pair in call.arguments.lazy().enumerate() then {
        let mutable bare_root_allowed = false;
        if w.mode is .SelfEscape() and callee_known and borrowed_self_is_bare_receiver(
            pair.second,
            w.root_local_id,
        ) then {
            // Bare-root pass edge of the fixpoint (rule 1a): fine when the
            // callee's matching parameter is itself a non-escaping candidate,
            // an escape otherwise.
            when call.callee in {
                .Function(symbol) then {
                    let slot_key = borrowed_slot_key(symbol.def_id.id, pair.first);
                    if w.candidates.get(slot_key) is .Some(_) then {
                        w.receiver_deps.insert(slot_key, true);
                        bare_root_allowed = true;
                    } else {
                        w.escaped = true;
                    };
                },
                _ then {
                    w.escaped = true;
                },
            };
        };
        borrowed_self_walk_value(w, pair.second, bare_root_allowed);
    };
};

let borrowed_self_walk_value(
    w: BorrowedSelfWalk,
    value: MIRValue,
    receiver_slot: Bool,
): Void = {
    when value in {
        .Operand(operand) then borrowed_self_walk_operand(w, operand),
        .PlaceRead(place, ownership) then {
            if w.mode is .SelfEscape() then {
                let root = borrowed_self_place_root_kind(place, w.root_local_id);
                if root == UInt(2) then {
                    // The bare handle itself. Only the receiver slot of a set
                    // member call (checked in walk_call) may pass it on.
                    if not (receiver_slot and (ownership is .Copy() or is .Borrow())) then {
                        w.escaped = true;
                    };
                } else if root == UInt(1) then {
                    if ownership is .Move() or is .Take() then {
                        w.escaped = true;
                    };
                };
            };
            borrowed_self_walk_place(w, place);
        },
        .Binary(operation) then {
            borrowed_self_walk_operand(w, operation.left);
            borrowed_self_walk_operand(w, operation.right);
        },
        .Unary(operation) then borrowed_self_walk_operand(w, operation.operand),
        .Call(call) then borrowed_self_walk_call(w, call),
        .Aggregate(aggregate) then {
            for field in aggregate.fields then {
                borrowed_self_walk_value(w, field, false);
            };
        },
        .EnumCase(construction) then {
            for argument in construction.arguments then {
                borrowed_self_walk_value(w, argument, false);
            };
        },
        .EnumTag(tag) then borrowed_self_walk_value(w, tag.subject, false),
        .TraitObjectConversion(conversion) then borrowed_self_walk_value(
            w,
            conversion.inner,
            false,
        ),
        .TraitMethodCall(call) then {
            // Dynamic dispatch: the concrete target is unknown here (the
            // vtable wrapper pairs the refcount itself), so a bare self
            // receiver escapes.
            borrowed_self_walk_value(w, call.receiver, false);
            for argument in call.arguments then {
                borrowed_self_walk_value(w, argument, false);
            };
        },
        .Ref(place, _, _) or .Pointer(place) then {
            if w.mode is .SelfEscape() then {
                if borrowed_self_place_root_kind(place, w.root_local_id) != UInt(0) then {
                    // A reference to self may outlive the call (rule 5).
                    w.escaped = true;
                };
            };
            if borrowed_self_place_root_local(place) is .Some(root) then {
                w.address_taken.insert(root);
            };
            borrowed_self_walk_place(w, place);
        },
        .Cast(operand, _, _) then borrowed_self_walk_operand(w, operand),
        .Intrinsic(node) then borrowed_self_walk_intrinsic(w, node),
        .Lambda(lambda) then {
            for pair in lambda.captures.lazy().enumerate() then {
                let source = lambda.capture_sources[pair.first];
                if w.mode is .SelfEscape() then {
                    if borrowed_self_place_root_kind(source, w.root_local_id) == UInt(2) then {
                        // Capturing the bare self handle: the closure env
                        // outlives the call (rule 6). A captured FIELD value is
                        // a plain copy and fine.
                        w.escaped = true;
                    };
                };
                borrowed_self_walk_place(w, source);
            };
            // The lambda body cannot see the enclosing self (only its
            // captures), but it can box function values or call methods with
            // unsafe shapes, so the usage scan descends into it.
            if w.mode is .GlobalUsage() then {
                borrowed_self_walk_function(w, lambda.function);
            };
        },
    };
};

let borrowed_self_walk_intrinsic(w: BorrowedSelfWalk, node: MIRIntrinsic): Void = {
    when node in {
        .AllocMemory(count, _) or .AllocString(count, _) or .DeallocMemory(count) then borrowed_self_walk_value(
            w,
            count,
            false,
        ),
        .CopyMemory(dest, source, count) or .MoveMemory(dest, source, count)
        or .CompareMemory(dest, source, count) then {
            borrowed_self_walk_value(w, dest, false);
            borrowed_self_walk_value(w, source, false);
            borrowed_self_walk_value(w, count, false);
        },
        .DowngradeRef(value, _) or .UpgradeRef(value, _) or .TraitObjectMatches(value, _, _, _, _)
        or .TraitObjectDowncast(value, _) or .DeinitMemory(value) or .TakeMemory(value, _) then borrowed_self_walk_value(
            w,
            value,
            false,
        ),
        .InitMemory(pointer, value) then {
            borrowed_self_walk_value(w, pointer, false);
            borrowed_self_walk_value(w, value, false);
        },
        .FixedArrayLiteral(_, elements) then {
            for element in elements then {
                borrowed_self_walk_value(w, element, false);
            };
        },
        .SpawnThread(out_handle, out_tid, closure, stack_size) then {
            borrowed_self_walk_value(w, out_handle, false);
            borrowed_self_walk_value(w, out_tid, false);
            borrowed_self_walk_value(w, closure, false);
            borrowed_self_walk_value(w, stack_size, false);
        },
        .NullPtr(_) then {},
    };
};

let borrowed_self_walk_statement(w: BorrowedSelfWalk, statement: MIRStatement): Void = {
    when statement in {
        // Lock/Unlock 只动锁字，不改写也不外借 self 槽位。
        .Declare(_) or .ScopeEnter(_) or .ScopeExit(_) or .DebugSource(_)
        or .Lock(_) or .Unlock(_) then {},
        .Assign(place, value) then {
            let mutable allowed_binding = false;
            when place in {
                .Local(local) then {
                    if w.mode is .SelfEscape() then {
                        if local.raw_value == w.root_local_id then {
                            // Rebinding the borrowed self slot (rule 4).
                            w.escaped = true;
                        } else if borrowed_self_is_bare_copy_binding(value, w.root_local_id) then {
                            allowed_binding = true;
                        };
                    };
                },
                _ then {},
            };
            borrowed_self_walk_place(w, place);
            if not allowed_binding then {
                borrowed_self_walk_value(w, value, false);
            };
        },
        .AtomicLoad(_, place) then {
            borrowed_self_walk_place(w, place);
        },
        .AtomicStore(place, value) then {
            borrowed_self_walk_place(w, place);
            borrowed_self_walk_value(w, value, false);
        },
        .Exchange(place, _, value) then {
            if w.mode is .SelfEscape() then {
                // The old value MOVES out of the slot into a temp (rule 2: a
                // move-read of a self-rooted place would steal a reference out
                // of a borrowed object).
                if borrowed_self_place_root_kind(place, w.root_local_id) != UInt(0) then {
                    w.escaped = true;
                };
            };
            borrowed_self_walk_place(w, place);
            borrowed_self_walk_value(w, value, false);
        },
        .Drop(place) then {
            if w.mode is .SelfEscape() then {
                if borrowed_self_place_root_kind(place, w.root_local_id) != UInt(0) then {
                    // Dropping a self-rooted place has no +1 to release under
                    // the borrowed convention (rule 3).
                    w.escaped = true;
                };
            };
            borrowed_self_walk_place(w, place);
        },
        .Retain(value) or .Release(value) then {
            if w.mode is .SelfEscape() then {
                when value in {
                    .PlaceRead(place, _) then {
                        if borrowed_self_place_root_kind(place, w.root_local_id) != UInt(0) then {
                            w.escaped = true;
                        };
                    },
                    _ then {},
                };
            };
            borrowed_self_walk_value(w, value, false);
        },
        .Evaluate(value) then borrowed_self_walk_value(w, value, false),
    };
};

let borrowed_self_walk_terminator(
    w: BorrowedSelfWalk,
    terminator: MIRTerminator,
): Void = {
    when terminator in {
        .Goto(_) or .Unreachable() then {},
        .Branch(condition, _, _) or .SwitchValue(condition, _, _) then borrowed_self_walk_operand(
            w,
            condition,
        ),
        .ReturnValue(operand) then when operand in {
            .Some(op) then borrowed_self_walk_operand(w, op),
            .None() then {},
        },
    };
};

let borrowed_self_walk_function(w: BorrowedSelfWalk, function: MIRFunction): Void = {
    for block in function.blocks then {
        for statement in block.statements then {
            borrowed_self_walk_statement(w, statement);
        };
        borrowed_self_walk_terminator(w, block.terminator);
    };
};

/// Locals whose address is taken anywhere in the function -- the roots of
/// `.Ref` / `.Pointer` places. A projection read rooted at any other local
/// cannot be rewritten during a call (no alias into its storage exists), so
/// the borrowed convention may pass it +0 without a protective copy.
let mir_address_taken_locals(function: MIRFunction): Set[Int] = {
    let walk = BorrowedSelfWalk(
        BorrowedSelfWalkMode.GlobalUsage(),
        0,
        0,
        Dict[String, Bool].new(),
        Dict[UInt, Bool].new(),
        Dict[String, Bool].new(),
        Dict[String, Bool].new(),
        Set[Int].new(),
        false,
    );
    borrowed_self_walk_function(walk, function);
    return walk.address_taken;
};

/// Compute the set of (function instance, parameter) slots that run the
/// borrowed convention. Keys are `borrowed_slot_key(def_id, index)` -- the
/// ABI unit is the slot: `f(a, b)` may borrow `a` while owning `b`. `self` is
/// simply parameter 0 of the original use. The identity matches what call
/// sites carry on `MIROperand.Function(symbol)` and what function emission
/// carries on `MIRFunction.identifier`.
///
/// This is a fixpoint over the instantiated (monomorphized) call graph:
/// edges are the bare-root passes of rule 1a, and the greatest fixed point
/// keeps self-recursive and mutually recursive readers eligible.
let compute_borrowed_param_slots(program: MIRProgram): Dict[String, Bool] = {
    // ── Phase 0: global usage scan ─────────────────────────────────────────
    // One walk over every function (and nested lambda body) collecting
    // address-taken symbols and unsafe call shapes.
    let global_walk = BorrowedSelfWalk(
        BorrowedSelfWalkMode.GlobalUsage(),
        0,
        0,
        Dict[String, Bool].new(),
        Dict[UInt, Bool].new(),
        Dict[String, Bool].new(),
        Dict[String, Bool].new(),
        Set[Int].new(),
        false,
    );
    for function in program.functions then {
        borrowed_self_walk_function(global_walk, function);
    };

    // ── Phase 1: candidate collection + per-candidate escape scan ──────────
    let mutable candidate_order = List[String].new();
    let mutable candidate_info = Dict[String, BorrowedSelfCandidateInfo].new();
    let mutable candidate_flags = Dict[String, Bool].new();
    let mutable root_local_by_key = Dict[String, Int].new();
    for function in program.functions then {
        let def_id = function.identifier.def_id.id;
        if global_walk.unsafe_callees.get(def_id) is .Some(_) then {
            continue;
        };
        for pair in function.params.lazy().enumerate() then {
            let index = pair.first;
            let param = pair.second;
            if not borrowed_self_type_is_candidate(param.param_type) then {
                continue;
            };
            if index > 0 then {
                let is_trait_impl = when function.kind in {
                    .Given(_, _, _, trait_def_id) then trait_def_id is .Some(_),
                    _ then false,
                };
                if is_trait_impl then {
                    // Trait-impl methods keep the owned convention on
                    // non-receiver parameters: the vtable wrapper forwards
                    // extra arguments ownership-first (the method releases
                    // them), so a borrowed slot would need a per-slot release
                    // net in the wrapper. The receiver slot keeps its existing
                    // net (see codegen_vtable.koral).
                    continue;
                };
            };
            let slot_key = borrowed_slot_key(def_id, index);
            if global_walk.unsafe_slots.get(slot_key) is .Some(_) then {
                continue;
            };
            let mutable param_local = Option[Int].None();
            for local in function.locals then {
                if local.storage is .Parameter() and local.name == param.name then {
                    param_local = Option[Int].Some(local.id.raw_value);
                    break;
                };
            };
            if param_local is .None() then {
                continue;
            };
            candidate_order.push(slot_key);
            candidate_flags.insert(slot_key, true);
            root_local_by_key.insert(slot_key, param_local or else 0);
            candidate_info.insert(
                slot_key,
                BorrowedSelfCandidateInfo(true, Dict[String, Bool].new()),
            );
        };
    };

    for function in program.functions then {
        let def_id = function.identifier.def_id.id;
        for pair in function.params.lazy().enumerate() then {
            let slot_key = borrowed_slot_key(def_id, pair.first);
            when candidate_info.get(slot_key) in {
                .Some(info) then {
                    let root_local_id = root_local_by_key.get(slot_key) or else 0;
                    let walk = BorrowedSelfWalk(
                        BorrowedSelfWalkMode.SelfEscape(),
                        root_local_id,
                        pair.first,
                        candidate_flags,
                        global_walk.unsafe_callees,
                        global_walk.unsafe_slots,
                        Dict[String, Bool].new(),
                        Set[Int].new(),
                        false,
                    );
                    borrowed_self_walk_function(walk, function);
                    // AND across bodies: emission keys the convention on the
                    // slot, so if two lowered bodies ever share one, the slot
                    // may only be borrowed when EVERY body passes.
                    info.local_ok = info.local_ok and not walk.escaped;
                    for dep in walk.receiver_deps.iterator() then {
                        info.receiver_deps.insert(dep.first, true);
                    };
                },
                .None() then {},
            };
        };
    };

    // ── Phase 2: greatest fixpoint over the bare-root pass edges ───────────
    // Clone: managed collections alias on assignment, and the scan below
    // demotes members in place.
    let mutable alive = candidate_flags.clone();
    let mutable changed = true;
    while changed then {
        changed = false;
        for slot_key in candidate_order then {
            if alive.get(slot_key) is .None() then {
                continue;
            };
            let info = candidate_info.get(slot_key).unwrap();
            let mutable demote = not info.local_ok;
            if not demote then {
                for dep in info.receiver_deps.iterator() then {
                    if alive.get(dep.first) is .None() then {
                        demote = true;
                        break;
                    };
                };
            };
            if demote then {
                let _ = alive.remove(slot_key);
                changed = true;
            };
        };
    };

    let mutable result = Dict[String, Bool].new();
    for slot_key in candidate_order then {
        if alive.get(slot_key) is .Some(_) then {
            result.insert(slot_key, true);
        };
    };
    return result;
};

// ── Purity: which functions can rewrite parameter-/global-reachable state ────

/// Mutable state of one function's purity walk. The roots are the function's
/// parameter and capture locals plus every global: a write through one of
/// them rewrites the CALLER's state (or state reachable from anywhere).
type mutable PurityWalk(
    root_ids: Set[Int],
    // Locals whose type carries drop glue: their values can hold handles
    // into caller-reachable object graphs, so writes through them may
    // rewrite the caller's state even though the local itself is fresh.
    drop_local_ids: Set[Int],
    callees: Dict[UInt, Bool],
    mutable impure: Bool,
);

/// Whether writing through a place can rewrite caller-owned state: rooted
/// at a parameter / capture local (the caller's own slots), at a global, at
/// a drop-glue local (its value can hold handles into caller-reachable
/// graphs), or through an unknown pointer.
let purity_place_reaches_caller_state(
    place: MIRPlace,
    roots: Set[Int],
    drop_ids: Set[Int],
): Bool = {
    let mutable current = place;
    while true then {
        when current in {
            .Local(local) then {
                return roots.contains(local.raw_value) or drop_ids.contains(
                    local.raw_value,
                );
            },
            .Field(base, _) or .EnumPayload(base, _, _, _, _) then {
                current = base;
            },
            .Global(_) then {
                return true;
            },
            .Deref(_, _) or .PointerElement(_, _) then {
                return true;
            },
        };
    };
    return true;
};

let purity_walk_operand(w: PurityWalk, operand: MIROperand): Void = {
    when operand in {
        .Local(_) or .Function(_) or .Constant(_) then {},
    };
};

let purity_walk_intrinsic(w: PurityWalk, node: MIRIntrinsic): Void = {
    when node in {
        .AllocMemory(count, _) or .AllocString(count, _) then {
            purity_walk_value(w, count);
        },
        .NullPtr(_) then {},
        .FixedArrayLiteral(_, elements) then {
            for element in elements then {
                purity_walk_value(w, element);
            };
        },
        .DeallocMemory(_) or .DeinitMemory(_) or .TakeMemory(_, _)
        or .DowngradeRef(_, _) or .UpgradeRef(_, _)
        or .TraitObjectMatches(_, _, _, _, _) or .TraitObjectDowncast(_, _)
        or .CopyMemory(_, _, _) or .MoveMemory(_, _, _) or .CompareMemory(_, _, _)
        or .InitMemory(_, _) or .SpawnThread(_, _, _, _) then {
            // Memory-writing or pointer-taking: conservative.
            w.impure = true;
        },
    };
};

let purity_walk_call(w: PurityWalk, call: MIRCall): Void = {
    when call.callee in {
        .Function(symbol) then {
            w.callees.insert(symbol.def_id.id, true);
        },
        _ then {
            // Dynamic dispatch / function value: unknown target.
            w.impure = true;
        },
    };
    if call.argument_ownerships.count() == call.arguments.count() then {
        for pair in call.arguments.lazy().enumerate() then {
            if call.argument_ownerships[pair.first] is .Move() or is .Take() then {
                when pair.second in {
                    .PlaceRead(place, _) then {
                        if purity_place_reaches_caller_state(place, w.root_ids, w.drop_local_ids) then {
                            // Consuming a caller-rooted slot empties it.
                            w.impure = true;
                        };
                    },
                    _ then {},
                };
            };
            purity_walk_value(w, pair.second);
        };
    } else {
        w.impure = true;
        for argument in call.arguments then {
            purity_walk_value(w, argument);
        };
    };
};

let purity_walk_value(w: PurityWalk, value: MIRValue): Void = {
    when value in {
        .Operand(operand) then purity_walk_operand(w, operand),
        .PlaceRead(place, ownership) then {
            if ownership is .Move() or is .Take() then {
                if purity_place_reaches_caller_state(place, w.root_ids, w.drop_local_ids) then {
                    w.impure = true;
                };
            };
        },
        .Ref(place, _, _) or .Pointer(place) then {
            // A reference into caller state: any later write through it
            // counts against purity.
            if purity_place_reaches_caller_state(place, w.root_ids, w.drop_local_ids) then {
                w.impure = true;
            };
        },
        .Binary(operation) then {
            purity_walk_operand(w, operation.left);
            purity_walk_operand(w, operation.right);
        },
        .Unary(operation) then purity_walk_operand(w, operation.operand),
        .Call(call) then purity_walk_call(w, call),
        .Aggregate(aggregate) then {
            for field in aggregate.fields then {
                purity_walk_value(w, field);
            };
        },
        .EnumCase(construction) then {
            for argument in construction.arguments then {
                purity_walk_value(w, argument);
            };
        },
        .EnumTag(tag) then purity_walk_value(w, tag.subject),
        .TraitObjectConversion(conversion) then purity_walk_value(w, conversion.inner),
        .TraitMethodCall(call) then {
            // Unknown target: conservative.
            w.impure = true;
            purity_walk_value(w, call.receiver);
            for argument in call.arguments then {
                purity_walk_value(w, argument);
            };
        },
        .Cast(operand, _, _) then purity_walk_operand(w, operand),
        .Intrinsic(node) then purity_walk_intrinsic(w, node),
        .Lambda(lambda) then {
            // A closure body may run later against captured state.
            w.impure = true;
        },
    };
};

let purity_walk_statement(w: PurityWalk, statement: MIRStatement): Void = {
    when statement in {
        .Declare(_) or .ScopeEnter(_) or .ScopeExit(_) or .DebugSource(_)
        or .Lock(_) or .Unlock(_) then {},
        .Assign(place, value) then {
            if purity_place_reaches_caller_state(place, w.root_ids, w.drop_local_ids) then {
                w.impure = true;
            };
            purity_walk_value(w, value);
        },
        .AtomicLoad(_, place) then {
            // A scalar copy-read: pure. (Moves-out would be impure; this is not one.)
            purity_walk_value(w, MIRValue.PlaceRead(place, MIROwnershipUse.Copy()));
        },
        .AtomicStore(place, value) then {
            if purity_place_reaches_caller_state(place, w.root_ids, w.drop_local_ids) then {
                w.impure = true;
            };
            purity_walk_value(w, value);
        },
        .Exchange(place, _, value) then {
            // The old value moves out of the slot into a temp dropped later:
            // a caller-rooted slot's contents leave it (moves-out).
            if purity_place_reaches_caller_state(place, w.root_ids, w.drop_local_ids) then {
                w.impure = true;
            };
            purity_walk_value(w, value);
        },
        .Drop(place) then {
            // Dropping a caller-rooted slot releases its value.
            if purity_place_reaches_caller_state(place, w.root_ids, w.drop_local_ids) then {
                w.impure = true;
            };
        },
        .Retain(value) or .Release(value) then {
            w.impure = true;
            purity_walk_value(w, value);
        },
        .Evaluate(value) then purity_walk_value(w, value),
    };
};

/// The impure complement of the pure-reader convention: a function is impure
/// when it can rewrite state reachable from its parameters or the globals --
/// a direct caller-rooted write (including moves-out, drops and references),
/// dynamic dispatch, a closure, or a call to an impure function. The borrowed
/// convention may pass projection reads +0 to a PURE callee: with nothing in
/// the call able to empty the holder's slot, the old value cannot die
/// mid-call and the drop timing is unchanged.
let compute_impure_function_ids(program: MIRProgram): Dict[UInt, Bool] = {
    let mutable direct = Dict[UInt, Bool].new();
    let mutable callees_by_def = Dict[UInt, Dict[UInt, Bool]].new();
    for function in program.functions then {
        let def_id = function.identifier.def_id.id;
        let roots = Set[Int].new();
        for local in function.locals then {
            if local.storage is .Parameter() or local.storage is .Capture() then {
                roots.insert(local.id.raw_value);
            };
        };
        let drop_ids = Set[Int].new();
        for local in function.locals then {
            if type_needs_drop(local.local_type) then {
                drop_ids.insert(local.id.raw_value);
            };
        };
        let walk = PurityWalk(roots, drop_ids, Dict[UInt, Bool].new(), false);
        for block in function.blocks then {
            for statement in block.statements then {
                purity_walk_statement(walk, statement);
            };
            when block.terminator in {
                .Goto(_) or .Unreachable() then {},
                .Branch(condition, _, _) or .SwitchValue(condition, _, _) then {
                    purity_walk_operand(walk, condition);
                },
                .ReturnValue(operand) then when operand in {
                    .Some(op) then purity_walk_operand(walk, op),
                    .None() then {},
                },
            };
        };
        if walk.impure then {
            direct.insert(def_id, true);
        };
        callees_by_def.insert(def_id, walk.callees);
    };
    let mutable impure = Dict[UInt, Bool].new();
    for pair in direct.iterator() then {
        impure.insert(pair.first, true);
    };
    let mutable changed = true;
    while changed then {
        changed = false;
        for function in program.functions then {
            let def_id = function.identifier.def_id.id;
            if impure.get(def_id) is .Some(_) then {
                continue;
            };
            when callees_by_def.get(def_id) in {
                .Some(callees) then {
                    for callee in callees.iterator() then {
                        if impure.get(callee.first) is .Some(_) then {
                            impure.insert(def_id, true);
                            changed = true;
                            break;
                        };
                    };
                },
                .None() then {},
            };
        };
    };
    return impure;
};

// ── Last-use move (concurrency-design.md P5 · ARC 优化) ─────────────────────
//
// 末次使用移动：值源是**裸局部**、全函数只有这一次值读、使用所在块内有该局部
// 的定义（循环里逐迭代重定义因此天然安全；外层定义、内层使用的形状被排除）、
// 局部拥有 init flag（参数/捕获除外——借用约定已单独覆盖）、且类型闭包内没有
// 用户 `Drop`（析构时序完全不可观察）时，复制读改走移动路径——省一对
// retain/release，正确性与析构时序都不变。`self` 借用是同族的既有先例。

/// 析构是否可观察：名义类型带用户 `Drop`，或字段/实参闭包能到达这样的类型。
/// 函数类型（捕获未知）与 trait object（动态析构）保守视为可观察；弱句柄
/// 与标量的释放只动内存；枚举保守按可观察处理（载荷析构可能跑用户码）。
private let move_type_drop_observable(tainted: Dict[UInt, Bool], t: Type): Bool = {
    return when t in {
        .FunctionType(_, _, _) or .TraitObject(_, _, _) then {
            true
        },
        .StructureType(def_id) or .OpaqueType(def_id) or .EnumType(def_id) then {
            tainted.get(def_id.id) is .Some(_)
        },
        .GenericStruct(template_def_id, args) or .GenericEnum(template_def_id, args) then {
            if tainted.get(template_def_id.id) is .Some(_) then {
                true
            } else {
                let mutable found = false;
                for arg in args then {
                    if move_type_drop_observable(tainted, arg) then {
                        found = true;
                    };
                };
                found
            }
        },
        .ReferenceType(inner) or .MutableReferenceType(inner)
        or .BorrowedReferenceType(inner) or .MutableBorrowedReferenceType(inner)
        or .FixedArrayType(_, inner) then move_type_drop_observable(tainted, inner),
        _ then false,
    };
};

/// 「析构跑用户码」的名义类型闭包（不动点）：用户 `Drop` 目标为根，字段类型
/// 向上污染容器。`type mutable` 的析构钩子只能写在 `Drop` 实现里，判据就是
/// given 的 trait 身份（`is_std_drop_impl`）。
let compute_observable_drop_defs(codegen: CodeGen): Dict[UInt, Bool] = {
    let mutable tainted = Dict[UInt, Bool].new();
    for global in codegen.program.globals then {
        when global in {
            .Given(target_type, _, _, _, trait_def_id) then {
                if codegen.is_std_drop_impl(trait_def_id) then {
                    when target_type in {
                        .StructureType(def_id) then tainted.insert(def_id.id, true),
                        .GenericStruct(template_def_id, _) then tainted.insert(
                            template_def_id.id,
                            true,
                        ),
                        _ then {},
                    };
                };
            },
            _ then {},
        };
    };
    let mutable again = true;
    while again then {
        again = false;
        for entry in codegen.context.def_id_map.struct_fields.iterator() then {
            let def_key = entry.first;
            if tainted.get(def_key) is .Some(_) then {
            } else {
                for field in entry.second then {
                    if move_type_drop_observable(tainted, field.field_type) then {
                        tainted.insert(def_key, true);
                        again = true;
                        break;
                    };
                };
            };
        };
        // 枚举载荷同构参与污染：载荷类型不可观察析构 → 枚举本身可移动。
        for entry in codegen.context.def_id_map.enum_cases.iterator() then {
            let def_key = entry.first;
            if tainted.get(def_key) is .Some(_) then {
            } else {
                let mutable found = false;
                for case_info in entry.second then {
                    for param in case_info.params then {
                        if move_type_drop_observable(tainted, param.param_type) then {
                            found = true;
                        };
                    };
                };
                if found then {
                    tainted.insert(def_key, true);
                    again = true;
                };
            };
        };
        // 单态化实例的泛型实参参与污染：容器把元素藏在裸缓冲后，字段走查看
        // 不见它们——`List[Element]` 实例的字段只有指针和长度，可观察性全在
        // 实参里。漏掉它就会把持有用户 `Drop` 值的容器当可移动的。
        for entry in codegen.context.def_id_map.struct_type_arguments.iterator() then {
            let def_key = entry.first;
            if tainted.get(def_key) is .Some(_) then {
            } else {
                for arg in entry.second then {
                    if move_type_drop_observable(tainted, arg) then {
                        tainted.insert(def_key, true);
                        again = true;
                        break;
                    };
                };
            };
        };
        for entry in codegen.context.def_id_map.enum_type_arguments.iterator() then {
            let def_key = entry.first;
            if tainted.get(def_key) is .Some(_) then {
            } else {
                for arg in entry.second then {
                    if move_type_drop_observable(tainted, arg) then {
                        tainted.insert(def_key, true);
                        again = true;
                        break;
                    };
                };
            };
        };
    };
    return tainted;
};
/// 使用点位置：块号 + 语句号（终结子占用「语句数」这个号）。
type MoveBlockPos(block_index: Int, statement_index: Int);

/// 判 G 扫描队列项：从块内某语句号起向后扫描。
type mutable MoveScanEntry(block_index: Int, start_statement: Int);

/// 值读/定义位置表。逐局部记 (块,语句) → 标志——bit0 值读 / bit1 定义 /
/// bit2 复制读（移动候选形态）/ bit3 同语句多读（保守拒绝）；`copy_sites`
/// 是复制读位置（走查序，供倒序找末次候选），`consumed_elsewhere` 标记被
/// MIR 自带 Move/Take/HeapOwnedMove 消费过的局部——消费点与末次移动的消费
/// 会打架，整局部排除。`block_successors` 是 CFG 后继（块下标），`i` 处是
/// 第 i 块的后继；`block_statements[i]` 是第 i 块的语句数（终结子的语句号）。
type mutable MoveUseTable(
    mutable flags: Dict[Int, Dict[Int, Dict[Int, UInt]]],
    mutable copy_sites: Dict[Int, List[MoveBlockPos]],
    mutable consumed_elsewhere: Dict[Int, Bool],
    mutable block_successors: List[List[Int]],
    mutable block_statements: List[Int],
    // 借用参数槽（`borrowed_param_slots` 快照）：发射期实参会把这些槽的实参
    // 改写成 `.Borrow()`（`apply_borrowed_self_receiver_convention`），走查
    // 必须用同一有效所有权分类——借用实参读不是移动候选（发射点不会消费）。
    mutable borrowed_slots: Dict[String, Bool],
    // 借用投影风险：+0 读（借用实参/借用接收者/借用 PlaceRead）、取址
    //（`Ref`/`Pointer`）都可能把指向对象内部的裸引用送出去并活得比 +1 长
    //（`bytes.borrow_ptr()` 的指针在 from_bytes 里活过了载荷释放）。带任何
    // 一处的局部不得移动——移动会把 +1 生命周期缩短到最后一个读。
    mutable projection_risks: Dict[Int, Bool],
    mutable block_index: Int,
    mutable statement_index: Int,
);

private let move_table_note(
    table: MoveUseTable,
    local_id: MIRLocalID,
    bits: UInt,
): Void = {
    let key = local_id.raw_value;
    let mutable by_block = when table.flags.get(key) in {
        .Some(existing) then existing,
        .None() then Dict[Int, Dict[Int, UInt]].new(),
    };
    let mutable by_stmt = when by_block.get(table.block_index) in {
        .Some(existing) then existing,
        .None() then Dict[Int, UInt].new(),
    };
    let prev = when by_stmt.get(table.statement_index) in {
        .Some(existing) then existing,
        .None() then UInt(0),
    };
    let mutable next = prev | bits;
    // 同一 (块,语句) 内第二次记值读 → 多读标记。
    if (prev & UInt(1)) != UInt(0) and (bits & UInt(1)) != UInt(0) then {
        next = next | UInt(8);
    };
    by_stmt.insert(table.statement_index, next);
    by_block.insert(table.block_index, by_stmt);
    table.flags.insert(key, by_block);
};

private let move_table_note_use(table: MoveUseTable, local_id: MIRLocalID): Void = {
    move_table_note(table, local_id, UInt(1));
};

private let move_table_note_copy_read(
    table: MoveUseTable,
    local_id: MIRLocalID,
): Void = {
    move_table_note(table, local_id, UInt(5));
    let key = local_id.raw_value;
    let mutable sites = when table.copy_sites.get(key) in {
        .Some(existing) then existing,
        .None() then List[MoveBlockPos].new(),
    };
    sites.push(MoveBlockPos(table.block_index, table.statement_index));
    table.copy_sites.insert(key, sites);
};

private let move_table_note_def(table: MoveUseTable, local_id: MIRLocalID): Void = {
    move_table_note(table, local_id, UInt(2));
};

private let move_table_note_consumed(
    table: MoveUseTable,
    local_id: MIRLocalID,
): Void = {
    table.consumed_elsewhere.insert(local_id.raw_value, true);
    move_table_note(table, local_id, UInt(1));
};

/// Place 的根局部（用于 HeapOwnedMove 消费标记）。
private let move_place_root_local(place: MIRPlace): Option[MIRLocalID] = {
    return when place in {
        .Local(local_id) then Option[MIRLocalID].Some(local_id),
        .Field(base, _) or .EnumPayload(base, _, _, _, _) then move_place_root_local(base),
        .Global(_) or .Deref(_, _) or .PointerElement(_, _) then Option[MIRLocalID].None(),
    };
};

private let move_table_note_projection(
    table: MoveUseTable,
    local_id: MIRLocalID,
): Void = {
    table.projection_risks.insert(local_id.raw_value, true);
};

/// 借用实参的顶层读：不复制、不消费——按普通值读计（不是移动候选）。
/// 被借用的句柄可能被投影出指向内部的裸引用（借用投影风险）。
private let move_walk_value_as_borrow(value: MIRValue, table: MoveUseTable): Void = {
    when value in {
        .PlaceRead(place, _) then {
            when move_place_root_local(place) in {
                .Some(root) then move_table_note_projection(table, root),
                .None() then {},
            };
            move_walk_place(place, table);
        },
        _ then move_walk_value(value, table),
    };
};

/// 消费性实参的顶层读（init_memory 的 value）：按 MIR 自带消费点计（与
/// .Move()/.Take() 读同级），值源局部整局部禁移；place 的嵌套子表达式仍按
/// 普通值走（它们只是地址/下标计算，不被消费）。
private let move_walk_value_as_consumed(value: MIRValue, table: MoveUseTable): Void = {
    when value in {
        .Operand(.Local(local_id)) then move_table_note_consumed(table, local_id),
        .PlaceRead(place, _) then {
            when move_place_root_local(place) in {
                .Some(root) then move_table_note_consumed(table, root),
                .None() then {},
            };
            move_walk_place(place, table);
        },
        _ then move_walk_value(value, table),
    };
};

private let move_walk_operand(operand: MIROperand, table: MoveUseTable): Void = {
    when operand in {
        // 裸局部的值读与 `PlaceRead(Local, Copy)` 同义：+1 的复制读、移动
        // 候选形态。材料化临时多半走 Operand 形态（eager-load 的元素槽读、
        // 调用链中转量），只记普通使用点就永远排不上移动指定点——每次多付
        // 一对 retain/release。
        .Local(local_id) then move_table_note_copy_read(table, local_id),
        .Constant(_) or .Function(_) then {},
    };
};

private let move_walk_place(place: MIRPlace, table: MoveUseTable): Void = {
    when place in {
        .Local(local_id) then move_table_note_use(table, local_id),
        .Global(_) then {},
        .Field(base, _) then move_walk_place(base, table),
        .EnumPayload(base, _, _, _, _) then move_walk_place(base, table),
        .Deref(value, _) or .PointerElement(value, _) then move_walk_value(value, table),
    };
};

private let move_walk_intrinsic(node: MIRIntrinsic, table: MoveUseTable): Void = {
    when node in {
        .AllocMemory(count, _) or .AllocString(count, _) then move_walk_value(count, table),
        .DeallocMemory(pointer) or .DeinitMemory(pointer) or .TakeMemory(pointer, _) then {
            move_walk_value(pointer, table)
        },
        .CopyMemory(dest, source, count) or .MoveMemory(dest, source, count)
        or .CompareMemory(dest, source, count) then {
            move_walk_value(dest, table);
            move_walk_value(source, table);
            move_walk_value(count, table);
        },
        .DowngradeRef(value, _) or .UpgradeRef(value, _)
        or .TraitObjectMatches(value, _, _, _, _) or .TraitObjectDowncast(value, _) then {
            move_walk_value(value, table)
        },
        .InitMemory(pointer, value) then {
            move_walk_value(pointer, table);
            // init_memory 的实参是**消费性使用**（契约即「接管 value 的所有权」）。
            // MIR 自带消费标签的读（Move/Take、Operand(Local)）按消费点计——
            // 值源局部整局部禁移，与发射侧的转移一一对应。Copy 标签的读只是
            // 普通使用点：它可能还有后续使用（MIR 允许），是否转移由移动指定
            // 点（P5）决定——指定命中时发射侧就地清 flag放行移动（消费只发生
            // 在那一个点上，不存在双认领），未命中时照常 retain。
            when value in {
                .PlaceRead(_, ownership) then {
                    if ownership is .Copy() then {
                        move_walk_value(value, table);
                    } else {
                        move_walk_value_as_consumed(value, table);
                    }
                },
                _ then move_walk_value_as_consumed(value, table),
            };
        },
        .NullPtr(_) then {},
        .FixedArrayLiteral(_, elements) then {
            for element in elements then {
                move_walk_value(element, table);
            };
        },
        .SpawnThread(out_handle, out_tid, closure, stack_size) then {
            move_walk_value(out_handle, table);
            move_walk_value(out_tid, table);
            move_walk_value(closure, table);
            move_walk_value(stack_size, table);
        },
    };
};

private let move_walk_value(value: MIRValue, table: MoveUseTable): Void = {
    when value in {
        .Operand(operand) then move_walk_operand(operand, table),
        // 裸局部的 Copy 复制读是移动候选；Move/Take 读是 MIR 自带消费点
        //（与末次移动冲突，整局部排除）；其余所有权形态按普通值读计。
        .PlaceRead(place, ownership) then {
            when place in {
                .Local(local_id) then {
                    if ownership is .Copy() then {
                        move_table_note_copy_read(table, local_id);
                    } else {
                        if ownership is .Move() or ownership is .Take() then {
                            move_table_note_consumed(table, local_id);
                        } else {
                            move_table_note_projection(table, local_id);
                            move_table_note_use(table, local_id);
                        };
                    };
                },
                _ then move_walk_place(place, table),
            }
        },
        .Ref(place, _, allocation) then {
            when move_place_root_local(place) in {
                .Some(root) then move_table_note_projection(table, root),
                .None() then {},
            };
            if allocation is .HeapOwnedMove() then {
                when move_place_root_local(place) in {
                    .Some(local_id) then move_table_note_consumed(table, local_id),
                    .None() then {},
                };
                move_walk_place(place, table);
            } else {
                move_walk_place(place, table);
            };
        },
        .Pointer(place) then {
            when move_place_root_local(place) in {
                .Some(root) then move_table_note_projection(table, root),
                .None() then {},
            };
            move_walk_place(place, table);
        },
        .Binary(operation) then {
            move_walk_operand(operation.left, table);
            move_walk_operand(operation.right, table);
        },
        .Unary(operation) then move_walk_operand(operation.operand, table),
        .Call(call) then {
            move_walk_operand(call.callee, table);
            let mutable callee_def_id = UInt(0);
            when call.callee in {
                .Function(symbol) then {
                    callee_def_id = symbol.def_id.id;
                },
                _ then {},
            };
            let owners_match = call.argument_ownerships.count() == call.arguments.count();
            for pair in call.arguments.lazy().enumerate() then {
                let slot_key = borrowed_slot_key(callee_def_id, pair.first);
                if table.borrowed_slots.get(slot_key) is .Some(_) then {
                    move_walk_value_as_borrow(pair.second, table);
                } else {
                    if owners_match then {
                        move_walk_value(pair.second, table);
                    } else {
                        // 缺所有权表时发射侧按 `.Move()` 兜底——实参会被消费。
                        when pair.second in {
                            .PlaceRead(.Local(local_id), _) then {
                                move_table_note_consumed(table, local_id);
                            },
                            _ then move_walk_value(pair.second, table),
                        };
                    };
                };
            };
        },
        .Aggregate(aggregate) then {
            for field in aggregate.fields then {
                move_walk_value(field, table);
            };
        },
        .EnumCase(construction) then {
            for argument in construction.arguments then {
                move_walk_value(argument, table);
            };
        },
        .EnumTag(tag) then move_walk_value(tag.subject, table),
        .TraitObjectConversion(conversion) then move_walk_value(conversion.inner, table),
        .TraitMethodCall(call) then {
            move_walk_value(call.receiver, table);
            for argument in call.arguments then {
                move_walk_value(argument, table);
            };
        },
        .Cast(operand, _, _) then move_walk_operand(operand, table),
        .Intrinsic(node) then move_walk_intrinsic(node, table),
        .Lambda(lambda) then {
            for source in lambda.capture_sources then {
                move_walk_place(source, table);
            };
        },
    };
};

/// 构建整函数的值读/定义位置表 + CFG 后继表。
let build_move_use_table(codegen: CodeGen, function: MIRFunction): MoveUseTable = {
    let mutable borrowed_slots = Dict[String, Bool].new();
    for pair in codegen.borrowed_param_slots.iterator() then {
        borrowed_slots.insert(pair.first, pair.second);
    };
    let table = MoveUseTable(
        Dict[Int, Dict[Int, Dict[Int, UInt]]].new(),
        Dict[Int, List[MoveBlockPos]].new(),
        Dict[Int, Bool].new(),
        List[List[Int]].new(),
        List[Int].new(),
        borrowed_slots,
        Dict[Int, Bool].new(),
        0,
        0,
    );
    // 块 id → 数组下标；后继边按下标存。
    let mutable id_to_index = Dict[Int, Int].new();
    let mutable index = 0;
    for block in function.blocks then {
        id_to_index.insert(block.id.raw_value, index);
        index += 1;
    };
    for block in function.blocks then {
        let mutable targets = List[Int].new();
        when block.terminator in {
            .Goto(target) then targets.push(id_to_index.get(target.raw_value) or else target.raw_value),
            .Branch(_, then_block, else_block) then {
                targets.push(id_to_index.get(then_block.raw_value) or else then_block.raw_value);
                targets.push(id_to_index.get(else_block.raw_value) or else else_block.raw_value);
            },
            .SwitchValue(_, cases, default_block) then {
                for case in cases then {
                    targets.push(id_to_index.get(case.target.raw_value) or else case.target.raw_value);
                };
                when default_block in {
                    .Some(target) then targets.push(id_to_index.get(target.raw_value) or else target.raw_value),
                    .None() then {},
                };
            },
            .ReturnValue(_) or .Unreachable() then {},
        };
        table.block_successors.push(targets);
        table.block_statements.push(block.statements.count());
    };
    for block in function.blocks then {
        table.statement_index = 0;
        for statement in block.statements then {
            when statement in {
                .Declare(_) or .ScopeEnter(_) or .ScopeExit(_) or .DebugSource(_) then {},
                // Place roots are VALUE USES wherever the place is read for
                // addressing (a field write, an atomic slot, a drop path, a
                // lock target's handle). Undercounting these mis-marks a local
                // moveable and a later access reads a moved-from handle.
                .Lock(lock) or .Unlock(lock) then {
                    when lock in {
                        .ObjectLock(handle) then move_walk_operand(
                            MIROperand.Local(handle),
                            table,
                        ),
                        .GlobalLock(_) then {},
                    };
                },
                .Assign(place, value) then {
                    move_walk_value(value, table);
                    when place in {
                        .Local(local_id) then move_table_note_def(table, local_id),
                        _ then move_walk_place(place, table),
                    };
                },
                .AtomicStore(place, value) then {
                    move_walk_place(place, table);
                    move_walk_value(value, table);
                },
                .Exchange(place, old_target, value) then {
                    move_walk_place(place, table);
                    move_walk_value(value, table);
                    move_table_note_def(table, old_target);
                },
                .AtomicLoad(local_id, place) then {
                    move_walk_place(place, table);
                    move_table_note_def(table, local_id);
                },
                .Drop(place) then move_walk_place(place, table),
                .Retain(value) or .Release(value) then move_walk_value(value, table),
                .Evaluate(value) then move_walk_value(value, table),
            };
            table.statement_index += 1;
        };
        // 终结子占用「语句数」这个语句号。
        when block.terminator in {
            .Goto(_) or .Unreachable() then {},
            .Branch(condition, _, _) then move_walk_operand(condition, table),
            .SwitchValue(operand, _, _) then move_walk_operand(operand, table),
            .ReturnValue(operand) then when operand in {
                .Some(op) then move_walk_operand(op, table),
                .None() then {},
            },
        };
        table.block_index += 1;
    };
    return table;
};

private let move_flags_at(
    table: MoveUseTable,
    local_key: Int,
    block_index: Int,
    statement_index: Int,
): UInt = {
    return when table.flags.get(local_key) in {
        .Some(by_block) then when by_block.get(block_index) in {
            .Some(by_stmt) then when by_stmt.get(statement_index) in {
                .Some(bits) then bits,
                .None() then UInt(0),
            },
            .None() then UInt(0),
        },
        .None() then UInt(0),
    };
};

/// 判 G（末次使用）：从使用点 U 出发的每条执行路径（含回边，语句粒度）在
/// 碰到该局部的下一次值读（含 U 自身的动态重入）之前必然经过一次定义——
/// 于是每次动态执行的 U 消费的都是「最近一次定义」给出的 +1，静态移动
/// （清 init flag + 复制读改移交）不会重复消费同一份所有权。
///
/// 同语句出现第二次读保守拒绝（写协议的语句内求值细节不进判定）；同语句
/// 的定义是写协议的最后一步（左路径 → RHS → 写入），在读之后执行，对后续
/// 语句与后继块构成截断。
private let move_site_is_last_use(
    table: MoveUseTable,
    local_key: Int,
    site: MoveBlockPos,
): Bool = {
    let own_bits = move_flags_at(table, local_key, site.block_index, site.statement_index);
    if (own_bits & UInt(8)) != UInt(0) then {
        return false;
    };
    if (own_bits & UInt(1)) == UInt(0) or (own_bits & UInt(4)) == UInt(0) then {
        return false;
    };
    if (own_bits & UInt(2)) != UInt(0) then {
        return true;
    };
    let mutable work = List[MoveScanEntry].new();
    work.push(MoveScanEntry(site.block_index, site.statement_index + 1));
    let mutable visited = Dict[Int, Dict[Int, Bool]].new();
    let start_key = site.block_index;
    let mutable start_seen = Dict[Int, Bool].new();
    start_seen.insert(1, true);
    visited.insert(start_key, start_seen);
    let mutable cursor = 0;
    while cursor < work.count() then {
        let entry = work[cursor];
        cursor += 1;
        let stmt_count = table.block_statements[entry.block_index];
        let mutable s = entry.start_statement;
        let mutable cut = false;
        while s <= stmt_count then {
            let bits = move_flags_at(table, local_key, entry.block_index, s);
            if (bits & UInt(1)) != UInt(0) then {
                return false;
            };
            if (bits & UInt(2)) != UInt(0) then {
                cut = true;
                break;
            };
            s += 1;
        };
        if not cut then {
            let successors = table.block_successors[entry.block_index];
            for succ in successors then {
                let mutable seen = when visited.get(succ) in {
                    .Some(existing) then existing,
                    .None() then Dict[Int, Bool].new(),
                };
                if seen.get(0) is .None() then {
                    seen.insert(0, true);
                    visited.insert(succ, seen);
                    work.push(MoveScanEntry(succ, 0));
                };
            };
        };
    };
    return true;
};

/// 末次使用移动的指定点（P5 · concurrency-design.md）：每个可移动局部恰好
/// 指定一个使用点（判 G 放行的最后复制读），发射点按 (块,语句) 命中即消费。
/// 判据：拥有 init flag（非持有/借用参数/捕获都不是）、非 MIR 消费点、
/// 析构不可观察（用户 `Drop` 的析构时序是契约，绝不移动）。
let compute_move_designations(
    codegen: CodeGen,
    function: MIRFunction,
    table: MoveUseTable,
    tracked_init_locals: Dict[Int, Bool],
    non_owning_local_ids: Dict[Int, Bool],
): Dict[Int, MoveBlockPos] = {
    let mutable designations = Dict[Int, MoveBlockPos].new();
    for local in function.locals then {
        let key = local.id.raw_value;
        if local.storage is .Capture() then {
        } else {
            if tracked_init_locals.get(key) is .Some(_)
                and non_owning_local_ids.get(key) is .None()
                and table.consumed_elsewhere.get(key) is .None()
                and table.projection_risks.get(key) is .None()
                and not move_type_drop_observable(codegen.observable_drop_defs, local.local_type) then {
                when table.copy_sites.get(key) in {
                    .Some(sites) then {
                        // 倒序找第一个过判 G 的复制读——它就是语义上的末次使用。
                        let mutable i = sites.count();
                        while i > 0 then {
                            i -= 1;
                            let site = sites[i];
                            if move_site_is_last_use(table, key, site) then {
                                designations.insert(key, site);
                                break;
                            };
                        };
                    },
                    .None() then {},
                };
            };
        };
    };
    return designations;
};

private let alias_note_def(
    def_counts: Dict[Int, Int],
    target: MIRLocalID,
): Void = {
    let key = target.raw_value;
    let next = when def_counts.get(key) in {
        .Some(n) then n + 1,
        .None() then 1,
    };
    def_counts.insert(key, next);
};

/// 源合格：不被消费、不被中途释放、且其 +1 在 b 的窗口内不会死去——
/// 非持有（借用参数/捕获/先建别名）恒活到调用结束；tracked 源要求单定义
/// 且无移动指定点（有指定点的源已被自己的移动优化，别名会双重记账）。
private let alias_source_is_sound(
    table: MoveUseTable,
    non_owning_local_ids: Dict[Int, Bool],
    tracked_init_locals: Dict[Int, Bool],
    designations: Dict[Int, MoveBlockPos],
    def_counts: Dict[Int, Int],
    disqualified: Dict[Int, Bool],
    source_key: Int,
): Bool = {
    if disqualified.get(source_key) is .Some(_) then {
        return false;
    };
    if table.consumed_elsewhere.get(source_key) is .Some(_) then {
        return false;
    };
    // 源必须是**非持有**（借用参数/捕获/先建别名）：其 +1 的所有权在函数体
    // 之外，生命周期覆盖整个函数体，必活过 b 的任何窗口。tracked 局部源的
    // +1 可能死在作用域尾或循环重定义的写协议里（静态 def 计数看不见动态
    // 重定义），别名窗口内提前死就悬垂——那需要源生死点的可达性分析，留作
    // 后续；此刻只放行构造上安全的源。
    return non_owning_local_ids.get(source_key) is .Some(_);
};

/// 借用型绑定（WP-2 · ARC 成对消除，Swift 的 retain/release pair elimination
/// 同形）：`let b = <局部/参数/捕获>` 这样的复制绑定，若 b 的全部使用都不消
/// 费、且源在 b 的窗口内既不被消费也不重定义、不中途释放，则 b 只是别名——
/// 省掉绑定处的 retain 与作用域尾的 release 一对。析构时序不变：对象仍死在
/// 源的 +1 死去的时刻（源的释放点）。b 因而不持 +1，走既有非持有机制
/// （返回处复制、Move 读强制复制），只是把「绑定读不复制」这一半补上。
///
/// 消费面全覆盖：移动指定点、MIR Move/Take/HeapOwnedMove（`consumed_elsewhere`）、
/// `Drop` 语句、`Exchange` 槽位换出、`return` 转发（tracked 局部的返回即消费）。
/// 源的重定义会走写协议释放旧值——恰是别名所指的对象——故源同样要求单定义。
let compute_alias_locals(
    codegen: CodeGen,
    function: MIRFunction,
    table: MoveUseTable,
    tracked_init_locals: Dict[Int, Bool],
    non_owning_local_ids: Dict[Int, Bool],
    designations: Dict[Int, MoveBlockPos],
): Dict[Int, Bool] = {
    let _ = codegen;
    let mutable candidates = Dict[Int, Int].new();
    let mutable def_counts = Dict[Int, Int].new();
    let mutable disqualified = Dict[Int, Bool].new();

    for block in function.blocks then {
        for statement in block.statements then {
            when statement in {
                .Assign(place, value) then {
                    when place in {
                        .Local(target) then {
                            alias_note_def(def_counts, target);
                            when value in {
                                .PlaceRead(source_place, ownership) then {
                                    if ownership is .Copy() then {
                                        when source_place in {
                                            .Local(source_id) then {
                                                candidates.insert(
                                                    target.raw_value,
                                                    source_id.raw_value,
                                                );
                                            },
                                            _ then {},
                                        };
                                    };
                                },
                                _ then {},
                            };
                        },
                        _ then {
                            when move_place_root_local(place) in {
                                .Some(root) then disqualified.insert(root.raw_value, true),
                                .None() then {},
                            };
                        },
                    };
                },
                .AtomicLoad(target, place) then {
                    alias_note_def(def_counts, target);
                    when move_place_root_local(place) in {
                        .Some(root) then disqualified.insert(root.raw_value, true),
                        .None() then {},
                    };
                },
                .Exchange(place, old_target, _) then {
                    alias_note_def(def_counts, old_target);
                    when move_place_root_local(place) in {
                        .Some(root) then disqualified.insert(root.raw_value, true),
                        .None() then {},
                    };
                },
                .Drop(place) then {
                    when move_place_root_local(place) in {
                        .Some(root) then disqualified.insert(root.raw_value, true),
                        .None() then {},
                    };
                },
                _ then {},
            };
        };
        when block.terminator in {
            .ReturnValue(some_op) then {
                when some_op in {
                    .Some(op) then {
                        when op in {
                            .Local(local_id) then disqualified.insert(local_id.raw_value, true),
                            .Constant(_) or .Function(_) then {},
                        };
                    },
                    .None() then {},
                };
            },
            _ then {},
        };
    };

    let mutable aliases = Dict[Int, Bool].new();
    for local in function.locals then {
        let key = local.id.raw_value;
        if local.storage is .Parameter() or local.storage is .Capture() then {
        } else {
            when candidates.get(key) in {
                .Some(source_key) then {
                    let def_once = when def_counts.get(key) in {
                        .Some(n) then n == 1,
                        .None() then false,
                    };
                    if tracked_init_locals.get(key) is .Some(_)
                        and designations.get(key) is .None()
                        and table.consumed_elsewhere.get(key) is .None()
                        and disqualified.get(key) is .None()
                        and def_once
                        and source_key != key
                        and alias_source_is_sound(
                            table,
                            non_owning_local_ids,
                            tracked_init_locals,
                            designations,
                            def_counts,
                            disqualified,
                            source_key,
                        ) then {
                        aliases.insert(key, true);
                    };
                },
                .None() then {},
            };
        };
    };
    return aliases;
};
