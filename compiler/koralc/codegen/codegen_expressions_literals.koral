// codegen_expressions_literals.koral - MIR literal and operator helpers

let format_hex_byte(b UInt8) String = {
    let hex_chars = "0123456789ABCDEF";
    let hi = UInt((b >> 4));
    let lo = UInt((b & UInt8(0x0F)));
    let hi_char = hex_chars[hi];
    let lo_char = hex_chars[lo];
    let mutable result = StringBuilder.new();
    result.push_string("0x");
    result.push_byte(hi_char);
    result.push_byte(lo_char);
    return result.to_string();
};

private let immortal_refcount() String = "-1";

given CodeGen {
    generate_string_literal(self, value String, str_type Type) String = {
        let bytes_var = self.next_temp();
        let bytes_var_name = "\(bytes_var)_bytes";
        let storage_var_name = "\(bytes_var)_storage";
        let utf8_bytes = value.to_bytes();
        let mutable byte_literals = StringBuilder.new();
        let mutable i UInt = 0;
        while i < utf8_bytes.count() then {
            if i > 0 then {
                byte_literals.push_string(", ");
            };
            byte_literals.push_string(format_hex_byte(utf8_bytes[i]));
            i += 1;
        };
        if not byte_literals.is_empty() then {
            byte_literals.push_string(", ");
        };
        byte_literals.push_string("0x00");

        self.add_indent();
        self.buffer.push_string(
            "static const uint8_t \(bytes_var_name.to_string())[] = { \(byte_literals.to_string()) };\n",
        );

        // In the simplified type system, String is a managed nominal type.
        // The payload is __koral_payload_Std_String with {data, len} fields.
        let storage_c_type = self.managed_payload_type_name(str_type);
        let byte_count = utf8_bytes.count();
        // Immortal 头（Swift 的 immortal object 做法）：静态字面量的 control 块
        // strong_count = -1，retain/release 直接早退，永不释放。
        // 布局仍是 [Control | payload]，所以 __koral_control_of(ptr) 能反推回来。
        self.add_indent();
        self.buffer.push_string(
            "static const struct { struct __koral_Control ctrl; struct \(storage_c_type) payload; } \(storage_var_name)_block = { { \(immortal_refcount()), -1 }, { (uint8_t*)\(bytes_var_name), \(byte_count) } };\n",
        );

        let c_type = self.c_type_name(str_type);
        return self.next_temp_with_init(
            c_type,
            "(\(c_type)){ .ptr = (void*)&\(storage_var_name)_block.payload }",
        );
    };

    sanitize_c_numeric_literal(self, value String) String = {
        let cleaned = value.replace_all("_", with: "");
        if cleaned.starts_with("0o") or cleaned.starts_with("0O") then {
            return "0" + cleaned.substring(2...);
        };
        return cleaned;
    };

    arithmetic_op_to_c(self, op ArithmeticOperator) String = {
        return when op in {
            .Add() then "+",
            .Subtract() then "-",
            .Multiply() then "*",
            .Divide() then "/",
            .Remainder() then "%",
        };
    };

    comparison_op_to_c(self, op ComparisonOperator) String = {
        return when op in {
            .Equal() then "==",
            .NotEqual() then "!=",
            .Greater() then ">",
            .Less() then "<",
            .GreaterEqual() then ">=",
            .LessEqual() then "<=",
        };
    };

    bitwise_op_to_c(self, op BitwiseOperator) String = {
        return when op in {
            .BitAnd() then "&",
            .BitOr() then "|",
            .BitXor() then "^",
            .LeftShift() then "<<",
            .RightShift() then ">>",
        };
    };

    checked_arithmetic_func_name(self, op ArithmeticOperator, t Type) String = {
        let op_name = when op in {
            .Add() then "add",
            .Subtract() then "sub",
            .Multiply() then "mul",
            .Divide() then "div",
            .Remainder() then "mod",
        };
        return "koral_checked_\(op_name)_\(self.type_suffix(t))";
    };

    /// The shift helper for a target width. Plain widths panic on an
    /// out-of-range amount; the Wrapping family masks the amount modulo the
    /// width instead, because a wrapped answer exists.
    shift_func_name(self, op BitwiseOperator, t Type) String = {
        let op_name = when op in {
            .LeftShift() then "shl",
            .RightShift() then "shr",
            _ then "shl",
        };
        let family = if self.is_wrapping_integer_type(t) then "koral_wrapping_" else "koral_checked_";
        return "\(family)\(op_name)_\(self.type_suffix(t))";
    };

    is_wrapping_integer_type(self, t Type) Bool = {
        return when t in {
            .WrappingIntType() then true,
            .WrappingInt8Type() then true,
            .WrappingInt16Type() then true,
            .WrappingInt32Type() then true,
            .WrappingInt64Type() then true,
            .WrappingUIntType() then true,
            .WrappingUInt8Type() then true,
            .WrappingUInt16Type() then true,
            .WrappingUInt32Type() then true,
            .WrappingUInt64Type() then true,
            _ then false,
        };
    };

    /// Unsigned C twin used to compute Wrapping arithmetic in well-defined
    /// unsigned C arithmetic; the outer cast back to the result type truncates
    /// to the family's width (modulo 2^N). Wider than the narrow widths on
    /// purpose: `uint16_t * uint16_t` promotes to signed `int` and can
    /// overflow it.
    wrapping_unsigned_op_type_name(self, t Type) String = {
        return when t in {
            .WrappingIntType() or .WrappingUIntType() then "uintptr_t",
            .WrappingInt64Type() or .WrappingUInt64Type() then "uint64_t",
            _ then "uint32_t",
        };
    };

    is_signed_wrapping_integer_type(self, t Type) Bool = {
        return when t in {
            .WrappingIntType() then true,
            .WrappingInt8Type() then true,
            .WrappingInt16Type() then true,
            .WrappingInt32Type() then true,
            .WrappingInt64Type() then true,
            _ then false,
        };
    };

    /// Wrapping arithmetic emits the C operator itself with no overflow guard
    /// -- modular by construction. Division and remainder keep the plain
    /// family's divide-by-zero panic and additionally wrap `MIN / -1` to `MIN`
    /// (`MIN % -1` to `0`) instead of the C undefined result.
    wrapping_arithmetic_init_expr(
        self,
        op ArithmeticOperator,
        left String,
        right String,
        t Type,
    ) String = {
        let c_type = self.c_type_name(t);
        let unsigned_type = self.wrapping_unsigned_op_type_name(t);
        return when op in {
            .Add() then "(\(c_type))((\(unsigned_type))(\(left)) + (\(unsigned_type))(\(right)))",
            .Subtract() then "(\(c_type))((\(unsigned_type))(\(left)) - (\(unsigned_type))(\(right)))",
            .Multiply() then "(\(c_type))((\(unsigned_type))(\(left)) * (\(unsigned_type))(\(right)))",
            .Divide() then if self.is_signed_wrapping_integer_type(t) then "((\(right)) == -1 ? (\(c_type))((\(unsigned_type))0 - (\(unsigned_type))(\(left))) : koral_checked_div_\(self.type_suffix(t))(\(left), \(right)))"
            else "koral_checked_div_\(self.type_suffix(t))(\(left), \(right))",
            .Remainder() then if self.is_signed_wrapping_integer_type(t) then "((\(right)) == -1 ? (\(c_type))0 : koral_checked_mod_\(self.type_suffix(t))(\(left), \(right)))"
            else "koral_checked_mod_\(self.type_suffix(t))(\(left), \(right))",
        };
    };

    type_suffix(self, t Type) String = {
        return when t in {
            .IntType() then "isize",
            .Int8Type() then "i8",
            .Int16Type() then "i16",
            .Int32Type() then "i32",
            .Int64Type() then "i64",
            .UIntType() then "usize",
            .UInt8Type() then "u8",
            .UInt16Type() then "u16",
            .UInt32Type() then "u32",
            .UInt64Type() then "u64",
            .WrappingIntType() then "isize",
            .WrappingInt8Type() then "i8",
            .WrappingInt16Type() then "i16",
            .WrappingInt32Type() then "i32",
            .WrappingInt64Type() then "i64",
            .WrappingUIntType() then "usize",
            .WrappingUInt8Type() then "u8",
            .WrappingUInt16Type() then "u16",
            .WrappingUInt32Type() then "u32",
            .WrappingUInt64Type() then "u64",
            _ then "isize",
        };
    };

    is_integer_type(self, t Type) Bool = {
        return when t in {
            .IntType() then true,
            .Int8Type() then true,
            .Int16Type() then true,
            .Int32Type() then true,
            .Int64Type() then true,
            .UIntType() then true,
            .UInt8Type() then true,
            .UInt16Type() then true,
            .UInt32Type() then true,
            .UInt64Type() then true,
            .WrappingIntType() then true,
            .WrappingInt8Type() then true,
            .WrappingInt16Type() then true,
            .WrappingInt32Type() then true,
            .WrappingInt64Type() then true,
            .WrappingUIntType() then true,
            .WrappingUInt8Type() then true,
            .WrappingUInt16Type() then true,
            .WrappingUInt32Type() then true,
            .WrappingUInt64Type() then true,
            _ then false,
        };
    };

    is_float_type(self, t Type) Bool = {
        return when t in {
            .Float32Type() then true,
            .Float64Type() then true,
            _ then false,
        };
    };
};
