// codegen_indexes.koral - CodeGen query helpers over MonomorphizedProgram projection APIs

// ── C 名字碰撞检测（「C 标识符唯一性」的碰撞消解面） ────────────────────────

/// 一条 C 名字分配结果：名字、声明的显示名、声明位置。
type CNameCollisionEntry(
    c_name String,
    display_name String,
    source_file String,
    line UInt,
    column UInt,
    span SourceSpan,
);

/// 一次待报告的碰撞：折叠出的 C 名字 + 两个不同拼写。
type CNameCollisionReport(
    c_name String,
    first CNameCollisionEntry,
    second CNameCollisionEntry,
);

/// C 名字清理不是单射：`aα` 与 `a_` 折叠成同一个 C 名字，链接期才炸。
/// 「C 标识符唯一性」四要素（模块路径、private 文件隔离、关键字转义、碰撞
/// 消解）里的碰撞消解以检测落地：报告，不改名——改名会把冲突藏起来。
///
/// 在 C 名字分配完成后收集一个翻译单元的最终名字；两个不同拼写落进同一个
/// C 名字时报告。编译器自造的名字（`__koral_*`、`__mir_*`、`T_<id>` /
/// `U_<id>` 兜底）不参与；同名重复（跨类型同名方法、同一外部符号的多个
/// foreign 声明、一个声明的多个 DefId）不是折叠撞名，不报告。
/// 与 Swift `CodeGen.checkCNameCollisions` 同一判定、同一消息、同一顺序。
public let c_name_collision_diagnostics(
    program MIRProgram,
    context CompilerContext,
) List[DiagnosticError] = {
    let mutable entries = List[CNameCollisionEntry].new();
    for global in program.globals then {
        collect_c_name_collision_entries(global, context, entries);
    };

    let mutable groups = Dict[String, List[CNameCollisionEntry]].new();
    for entry in entries then {
        if is_compiler_minted_c_name(entry.c_name) then {
            continue;
        };
        let mutable group = groups.get(entry.c_name) or else List[CNameCollisionEntry].new();
        group.push(entry);
        groups.insert(entry.c_name, group);
    };

    let mutable reports = List[CNameCollisionReport].new();
    for group_pair in groups then {
        let c_name = group_pair.first;
        let group = group_pair.second;
        // 只看不同拼写：同名重复是一个声明经多个 DefId 到达（或多个 owner
        // 的同名方法、同一外部符号的多个声明），什么都没撞。
        let mutable by_name = Dict[String, CNameCollisionEntry].new();
        for entry in group then {
            if by_name.get(entry.display_name) is .Some(existing) then {
                if c_name_entry_location_less(entry, existing) then {
                    by_name.insert(entry.display_name, entry);
                };
            } else {
                by_name.insert(entry.display_name, entry);
            };
        };
        let mutable names = List[String].new();
        for name_pair in by_name then {
            names.push(name_pair.first);
        };
        if names.count() < 2 then {
            continue;
        };
        // UTF-8 字节序，与 Swift 端的比较一致，两侧都取同两个拼写。
        sort_strings_utf8(names);
        when by_name.get(names[UInt(0)]) in {
            .Some(f) then when by_name.get(names[UInt(1)]) in {
                .Some(s) then {
                    reports.push(CNameCollisionReport(c_name, f, s));
                },
                .None() then {},
            },
            .None() then {},
        };
    };

    sort_c_name_reports(reports);

    let mutable diagnostics = List[DiagnosticError].new();
    for report in reports then {
        diagnostics.push(
            make_diagnostic(
                DiagnosticStage.Semantic(),
                report.first.source_file,
                "C name collision: '\(report.c_name)' is generated by both '\(report.first.display_name)' and '\(report.second.display_name)'; rename one of them",
                report.first.span,
            ),
        );
    };
    return diagnostics;
};

/// 一条声明的 C 名字分配，镜像 Swift `buildCIdentifierMap` 的登记集合。
file_private let collect_c_name_collision_entries(
    global MIRGlobal,
    context CompilerContext,
    out List[CNameCollisionEntry],
) Void = {
    when global in {
        .ForeignType(identifier) then {
            push_foreign_c_name_entry(context, identifier.def_id, out);
            when identifier.symbol_type in {
                .OpaqueType(def_id) then push_foreign_c_name_entry(context, def_id, out),
                _ then {},
            };
        },
        .ForeignStruct(identifier, _) then {
            push_foreign_c_name_entry(context, identifier.def_id, out);
            when identifier.symbol_type in {
                .StructureType(def_id) then push_foreign_c_name_entry(context, def_id, out),
                _ then {},
            };
        },
        .ForeignFunction(identifier, _, _) then {
            push_foreign_c_name_entry(context, identifier.def_id, out);
        },
        .ForeignGlobalVariable(identifier, _, _) then {
            push_foreign_c_name_entry(context, identifier.def_id, out);
        },
        .StructDeclaration(identifier, _) then {
            push_plain_c_name_entry(context, identifier.def_id, out);
            when identifier.symbol_type in {
                .StructureType(def_id) then push_plain_c_name_entry(context, def_id, out),
                _ then {},
            };
        },
        .EnumDeclaration(identifier, _) then {
            push_plain_c_name_entry(context, identifier.def_id, out);
            when identifier.symbol_type in {
                .EnumType(def_id) then push_plain_c_name_entry(context, def_id, out),
                _ then {},
            };
        },
        .Function(identifier, _, _, _) then {
            push_plain_c_name_entry(context, identifier.def_id, out);
        },
        .GlobalVariable(identifier, _, _, _) then {
            push_plain_c_name_entry(context, identifier.def_id, out);
        },
        .Given(target_type, _, _, methods, _) then {
            when target_type in {
                .StructureType(def_id) then push_plain_c_name_entry(context, def_id, out),
                .EnumType(def_id) then push_plain_c_name_entry(context, def_id, out),
                _ then {},
            };
            for method in methods then {
                push_plain_c_name_entry(context, method.def_id, out);
            };
        },
        _ then {},
    };
};

/// 非 foreign 声明的 C 名字：模块前缀 + private 文件隔离 + 清理后的名字
/// （`get_c_identifier`），拿不到时退回 DefId 唯一的 `T_<id>`。
file_private let push_plain_c_name_entry(
    context CompilerContext,
    def_id DefId,
    out List[CNameCollisionEntry],
) Void = {
    let c_name = context.get_c_identifier(def_id) or else "T_\(def_id.id)";
    push_c_name_entry(context, def_id, c_name, out);
};

/// foreign 声明的 C 名字：`cname` 或 Koral 名字原样，不加模块前缀
/// （Swift `buildCIdentifierMap` 的 foreign 分支同规则）。
file_private let push_foreign_c_name_entry(
    context CompilerContext,
    def_id DefId,
    out List[CNameCollisionEntry],
) Void = {
    let c_name = when context.get_cname(def_id) in {
        .Some(cname) then cname,
        .None() then context.get_name(def_id) or else "T_\(def_id.id)",
    };
    push_c_name_entry(context, def_id, c_name, out);
};

file_private let push_c_name_entry(
    context CompilerContext,
    def_id DefId,
    c_name String,
    out List[CNameCollisionEntry],
) Void = {
    // 没有显示名的条目无拼写可报告；它们的 C 名字本来就是 DefId 兜底。
    if context.get_name(def_id) is .Some(display_name) then {
        let source_file = context.get_source_file(def_id) or else "";
        let span = context.get_span(def_id) or else unknown_span();
        out.push(
            CNameCollisionEntry(
                c_name,
                display_name,
                source_file,
                span.start.line,
                span.start.column,
                span,
            ),
        );
    };
};

/// 编译器自造的 C 名字：运行时/MIR 前缀，以及 DefId 唯一的 `T_<id>` /
/// `U_<id>` 兜底。按构造唯一，不存在折叠撞名。
file_private let is_compiler_minted_c_name(c_name String) Bool = {
    if c_name.starts_with("__koral_") or c_name.starts_with("__mir_") then {
        return true;
    };
    if c_name.count() < 3 then {
        return false;
    };
    let runes = c_name.to_runes();
    if not (runes[UInt(0)] == 'T' or runes[UInt(0)] == 'U') then {
        return false;
    };
    if runes[UInt(1)] != '_' then {
        return false;
    };
    let mutable i UInt = 2;
    while i < runes.count() then {
        if runes[i] < '0' or runes[i] > '9' then {
            return false;
        };
        i += 1;
    };
    return true;
};

/// 码点序比较：与 UTF-8 字节序同序（UTF-8 保序），与 Swift 端
/// `Array(a.utf8)` 的比较同一全序。
file_private let string_codepoint_less(a String, b String) Bool = {
    let ar = a.to_runes();
    let br = b.to_runes();
    let shared = if ar.count() < br.count() then ar.count() else br.count();
    let mutable i UInt = 0;
    while i < shared then {
        if ar[i] < br[i] then {
            return true;
        };
        if ar[i] > br[i] then {
            return false;
        };
        i += 1;
    };
    return ar.count() < br.count();
};

/// 同名条目里取位置最小者：诊断指向的声明，两侧选同一个。
file_private let c_name_entry_location_less(
    a CNameCollisionEntry,
    b CNameCollisionEntry,
) Bool = {
    if a.source_file != b.source_file then {
        return string_codepoint_less(a.source_file, b.source_file);
    };
    if a.line != b.line then {
        return a.line < b.line;
    };
    return a.column < b.column;
};

file_private let sort_strings_utf8(values List[String]) Void = {
    let mutable i UInt = 1;
    while i < values.count() then {
        let mutable j UInt = i;
        while j > 0 and string_codepoint_less(values[j], values[j - 1]) then {
            let tmp = values[j - 1];
            values[j - 1] = values[j];
            values[j] = tmp;
            j -= 1;
        };
        i += 1;
    };
};

/// 报告按 C 名字的字节序输出，两侧同序。
file_private let sort_c_name_reports(reports List[CNameCollisionReport]) Void = {
    let mutable i UInt = 1;
    while i < reports.count() then {
        let mutable j UInt = i;
        while j > 0 and string_codepoint_less(
            reports[j].c_name,
            reports[j - 1].c_name,
        ) then {
            let tmp = reports[j - 1];
            reports[j - 1] = reports[j];
            reports[j] = tmp;
            j -= 1;
        };
        i += 1;
    };
};

given CodeGen {
    find_def_id_by_name(self, name String) Option[DefId] = {
        let def_ids = self.def_ids_named(name);
        return when def_ids.get(UInt(0)) in {
            .Some(def_id) then Option[DefId].Some(def_id),
            .None() then Option[DefId].None(),
        };
    };

    def_ids_for_name(self, name String) List[DefId] = {
        return self.def_ids_named(name);
    };

    spans_equal(self, left SourceSpan, right SourceSpan) Bool = {
        return left.start.line == right.start.line and left.start.column == right.start.column and left.end.line == right.end.line and left.end.column == right.end.column;
    };

    module_private def_id_has_span(self, def_id DefId, span SourceSpan) Bool = {
        return if self.context.get_span(def_id) is .Some(def_span) then self.spans_equal(
            def_span,
            span,
        ) else false;
    };

    find_function_def_id_by_name_and_span(
        self,
        name String,
        span SourceSpan,
    ) Option[DefId] = {
        for def_id in self.def_ids_for_name(name) then {
            if self.is_function_def_id(def_id) and self.def_id_has_span(def_id, span) then {
                return Option[DefId].Some(def_id);
            };
        };
        return Option[DefId].None();
    };

    find_variable_def_id_by_name_and_span(
        self,
        name String,
        span SourceSpan,
    ) Option[DefId] = {
        for def_id in self.def_ids_for_name(name) then {
            if self.is_variable_def_id(def_id) and self.def_id_has_span(def_id, span) then {
                return Option[DefId].Some(def_id);
            };
        };
        return Option[DefId].None();
    };

    find_function_def_id_by_name(self, name String) Option[DefId] = {
        let def_ids = self.def_ids_for_name(name);
        for def_id in def_ids then {
            if self.is_function_def_id(def_id) and self.has_c_identifier(def_id) then {
                return Option[DefId].Some(def_id);
            };
        };
        for def_id in def_ids then {
            if self.is_function_def_id(def_id) then {
                return Option[DefId].Some(def_id);
            };
        };
        return Option[DefId].None();
    };

    find_variable_def_id_by_name(self, name String) Option[DefId] = {
        let def_ids = self.def_ids_for_name(name);
        for def_id in def_ids then {
            if self.is_variable_def_id(def_id) and self.has_c_identifier(def_id) then {
                return Option[DefId].Some(def_id);
            };
        };
        for def_id in def_ids then {
            if self.is_variable_def_id(def_id) then {
                return Option[DefId].Some(def_id);
            };
        };
        return Option[DefId].None();
    };

    find_type_like_def_id_by_name(self, name String) Option[DefId] = {
        for def_id in self.def_ids_for_name(name) then {
            if self.is_type_like_def_id(def_id) then {
                return Option[DefId].Some(def_id);
            };
        };
        return Option[DefId].None();
    };

    public lookup_struct_type_by_name(self, name String) Option[Type] = {
        for def_id in self.type_def_ids_named(name) then {
            if self.is_struct_type_def_id(def_id) then {
                return Option[Type].Some(Type.StructureType(def_id));
            };
        };
        return Option[Type].None();
    };

    public lookup_struct_type_by_name_and_module(
        self,
        name String,
        module_path List[String],
    ) Option[Type] = {
        let def_ids = self.type_def_ids_named(name);
        for def_id in def_ids then {
            if self.is_struct_type_def_id(def_id) and self.module_paths_equal(
                self.context.get_module_path(def_id) or else List[String].new(),
                module_path,
            ) then {
                return Option[Type].Some(Type.StructureType(def_id));
            };
        };
        for def_id in def_ids then {
            if self.is_struct_type_def_id(def_id) and self.has_c_identifier(def_id) then {
                return Option[Type].Some(Type.StructureType(def_id));
            };
        };
        for def_id in def_ids then {
            if self.is_struct_type_def_id(def_id) then {
                return Option[Type].Some(Type.StructureType(def_id));
            };
        };
        return Option[Type].None();
    };

    is_struct_type_def_id(self, def_id DefId) Bool = {
        return if self.context.get_kind(def_id) is .Some(k) then k is .TypeDef(.Structure()) or is .GenericTemplate(.Structure())
        else false;
    };

    is_type_like_def_id(self, def_id DefId) Bool = {
        return if self.context.get_kind(def_id) is .Some(k) then k is .TypeDef(_) or is .GenericTemplate(_)
        else false;
    };

    is_function_def_id(self, def_id DefId) Bool = {
        return if self.context.get_kind(def_id) is .Some(k) then k is .Function()
        else false;
    };

    is_variable_def_id(self, def_id DefId) Bool = {
        return if self.context.get_kind(def_id) is .Some(k) then k is .Variable()
        else false;
    };
};
