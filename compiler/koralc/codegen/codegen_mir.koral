type MIRValueCleanup(name: String, cleanup_type: Type);

type MIRValueEmission(expression: String, cleanup: Option[MIRValueCleanup]);

type MIRPlaceAccess(path: String, cleanup: Option[MIRValueCleanup]);

type MIRLocalLifetimePlan(
    root_locals: List[MIRLocalID],
    locals_by_scope: Dict[UInt, List[MIRLocalID]],
    hoisted_declaration_locals: List[MIRLocalID],
    block_local_declarations_by_block: Dict[UInt, List[MIRLocalID]],
    block_local_declaration_locals: Dict[UInt, Bool],
);

type MIRFunctionEmitPlan(
    local_names: List[String],
    local_names_by_id: Dict[UInt, String],
    non_owning_local_ids: Dict[UInt, Bool],
    tracked_init_locals: Dict[UInt, Bool],
    lifetime_plan: MIRLocalLifetimePlan,
    address_taken_local_ids: Set[UInt],
    move_designations: Dict[UInt, MoveBlockPos],
    alias_locals: Dict[UInt, Bool],
);

/// 一个 MIR 函数发射出的 C 函数体，以及该函数体是否含 alloc_memory。
/// `allocates` 决定函数定义是否带 KORAL_NOINLINE（见 koral_runtime.h）。
type MIRFunctionBodyText(body: String, allocates: Bool);

private let is_borrowed_reference_like_type(t: Type): Bool = {
    return when t.indirection_info() in {
        .Some(info) then info.family is .ManagedReference() or is .WeakReference(),
        .None() then false,
    };
};

private let is_reference_like_type(t: Type): Bool = {
    return type_is_tracked_handle(t) or t is .TraitObject(...);
};

private let is_non_owning_local_value(value: MIRValue, target_type: Type): Bool = {
    return when value in {
        .Ref(_, _, allocation) then allocation is .StackBorrow(),
        .PlaceRead(_, ownership) then ownership is .Borrow() and is_borrowed_reference_like_type(
            target_type,
        ),
        _ then false,
    };
};

private let compute_non_owning_mir_locals(function: MIRFunction): Dict[UInt, Bool] = {
    let mutable saw_assignment_by_local = Dict[UInt, Bool].new();
    let mutable all_non_owning_by_local = Dict[UInt, Bool].new();

    for block in function.blocks then {
        for statement in block.statements then {
            when statement in {
                .Assign(place, value) then when place in {
                    .Local(local_id) then {
                        saw_assignment_by_local.insert(local_id.raw_value, true);
                        let already_all_non_owning = all_non_owning_by_local.get(
                            local_id.raw_value,
                        ) or else true;
                        let mutable target_type = Type.Unknown();
                        for local in function.locals then {
                            if local.id.raw_value == local_id.raw_value then {
                                target_type = local.local_type;
                                break;
                            };
                        };
                        all_non_owning_by_local.insert(
                            local_id.raw_value,
                            already_all_non_owning and is_non_owning_local_value(
                                value,
                                target_type,
                            ),
                        );
                    },
                    _ then {},
                },
                _ then {},
            };
        };
    };

    let mutable result = Dict[UInt, Bool].new();
    for local in function.locals then {
        if local.storage is .Parameter() and is_borrowed_reference_like_type(
            local.local_type,
        ) then {
            result.insert(local.id.raw_value, true);
            continue;
        };

        if (saw_assignment_by_local.get(local.id.raw_value) or else false) and (all_non_owning_by_local.get(
            local.id.raw_value,
        ) or else false) then {
            result.insert(local.id.raw_value, true);
        };
    };
    return result;
};

private let mir_active_scope_contains(
    active_scopes: List[MIRScopeID],
    scope: MIRScopeID,
): Bool = {
    for active_scope in active_scopes then {
        if active_scope.raw_value == scope.raw_value then {
            return true;
        };
    };
    return false;
};

private let mir_parent_scope(
    parent_scope_by_scope: Dict[UInt, MIRScopeID],
    scope: MIRScopeID,
): Option[MIRScopeID] = {
    return when parent_scope_by_scope.get(scope.raw_value) in {
        .Some(parent_scope) then Option[MIRScopeID].Some(parent_scope),
        .None() then Option[MIRScopeID].None(),
    };
};

private let mir_nearest_active_common_scope(
    parent_scope_by_scope: Dict[UInt, MIRScopeID],
    existing_scope: MIRScopeID,
    active_scopes: List[MIRScopeID],
): Option[MIRScopeID] = {
    let mutable scope_opt = Option[MIRScopeID].Some(existing_scope);
    while scope_opt is .Some(_) then {
        let scope = scope_opt or else MIRScopeID(UInt(0));
        if mir_active_scope_contains(active_scopes, scope) then {
            return Option[MIRScopeID].Some(scope);
        };
        scope_opt = mir_parent_scope(parent_scope_by_scope, scope);
    };
    return Option[MIRScopeID].None();
};

private let mir_record_local_use(
    shared_use_scope_by_local: Dict[UInt, MIRScopeID],
    first_use_block_by_local: Dict[UInt, UInt],
    multiple_use_blocks_by_local: Dict[UInt, Bool],
    tracked_drop_local_ids: Dict[UInt, Bool],
    parent_scope_by_scope: Dict[UInt, MIRScopeID],
    local: MIRLocalID,
    block: MIRBlockID,
    active_scopes: List[MIRScopeID],
): Void = {
    when tracked_drop_local_ids.get(local.raw_value) in {
        .Some(_) then {
            when shared_use_scope_by_local.get(local.raw_value) in {
                .Some(shared_use_scope) then {
                    when mir_nearest_active_common_scope(
                        parent_scope_by_scope,
                        shared_use_scope,
                        active_scopes,
                    ) in {
                        .Some(common_scope) then shared_use_scope_by_local.insert(
                            local.raw_value,
                            common_scope,
                        ),
                        .None() then {
                            let _ = shared_use_scope_by_local.remove(local.raw_value);
                        },
                    };
                },
                .None() then {
                    if not active_scopes.is_empty() then {
                        shared_use_scope_by_local.insert(
                            local.raw_value,
                            active_scopes[active_scopes.count() - UInt(1)],
                        );
                    };
                },
            };
        },
        .None() then {},
    };

    when first_use_block_by_local.get(local.raw_value) in {
        .Some(first_use_block) then {
            if first_use_block != block.raw_value then {
                multiple_use_blocks_by_local.insert(local.raw_value, true);
            };
        },
        .None() then {
            first_use_block_by_local.insert(local.raw_value, block.raw_value);
        },
    };
};

private let mir_walk_operand_uses(
    shared_use_scope_by_local: Dict[UInt, MIRScopeID],
    first_use_block_by_local: Dict[UInt, UInt],
    multiple_use_blocks_by_local: Dict[UInt, Bool],
    tracked_drop_local_ids: Dict[UInt, Bool],
    parent_scope_by_scope: Dict[UInt, MIRScopeID],
    operand: MIROperand,
    block: MIRBlockID,
    active_scopes: List[MIRScopeID],
): Void = {
    when operand in {
        .Local(local) then mir_record_local_use(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            local,
            block,
            active_scopes,
        ),
        _ then {},
    };
};

private let mir_walk_place_uses(
    shared_use_scope_by_local: Dict[UInt, MIRScopeID],
    first_use_block_by_local: Dict[UInt, UInt],
    multiple_use_blocks_by_local: Dict[UInt, Bool],
    tracked_drop_local_ids: Dict[UInt, Bool],
    parent_scope_by_scope: Dict[UInt, MIRScopeID],
    place: MIRPlace,
    block: MIRBlockID,
    active_scopes: List[MIRScopeID],
): Void = {
    when place in {
        .Local(local) then mir_record_local_use(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            local,
            block,
            active_scopes,
        ),
        .Global(_) then {},
        .Field(base, _) or .EnumPayload(base, _, _, _, _) then mir_walk_place_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            base,
            block,
            active_scopes,
        ),
        .Deref(base, _) or .PointerElement(base, _) then mir_walk_value_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            base,
            block,
            active_scopes,
        ),
    };
};

private let mir_walk_intrinsic_uses(
    shared_use_scope_by_local: Dict[UInt, MIRScopeID],
    first_use_block_by_local: Dict[UInt, UInt],
    multiple_use_blocks_by_local: Dict[UInt, Bool],
    tracked_drop_local_ids: Dict[UInt, Bool],
    parent_scope_by_scope: Dict[UInt, MIRScopeID],
    intrinsic_node: MIRIntrinsic,
    block: MIRBlockID,
    active_scopes: List[MIRScopeID],
): Void = {
    when intrinsic_node in {
        .AllocMemory(count, _) or .AllocString(count, _) then mir_walk_value_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            count,
            block,
            active_scopes,
        ),
        .DeallocMemory(pointer) then mir_walk_value_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            pointer,
            block,
            active_scopes,
        ),
        .CopyMemory(dest, source, count) or .MoveMemory(dest, source, count)
        or .CompareMemory(dest, source, count) then {
            mir_walk_value_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                dest,
                block,
                active_scopes,
            );
            mir_walk_value_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                source,
                block,
                active_scopes,
            );
            mir_walk_value_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                count,
                block,
                active_scopes,
            );
        },
        .DowngradeRef(value, _) or .UpgradeRef(value, _) or .TraitObjectMatches(value, _, _, _, _)
        or .TraitObjectDowncast(value, _) then mir_walk_value_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            value,
            block,
            active_scopes,
        ),
        .InitMemory(pointer, value) then {
            mir_walk_value_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                pointer,
                block,
                active_scopes,
            );
            mir_walk_value_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                value,
                block,
                active_scopes,
            );
        },
        .DeinitMemory(pointer) or .TakeMemory(pointer, _) then mir_walk_value_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            pointer,
            block,
            active_scopes,
        ),
        .NullPtr(_) then {},
        .FixedArrayLiteral(_, elements) then {
            for element in elements then {
                mir_walk_value_uses(
                    shared_use_scope_by_local,
                    first_use_block_by_local,
                    multiple_use_blocks_by_local,
                    tracked_drop_local_ids,
                    parent_scope_by_scope,
                    element,
                    block,
                    active_scopes,
                );
            };
        },
        .SpawnThread(out_handle, out_tid, closure, stack_size) then {
            mir_walk_value_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                out_handle,
                block,
                active_scopes,
            );
            mir_walk_value_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                out_tid,
                block,
                active_scopes,
            );
            mir_walk_value_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                closure,
                block,
                active_scopes,
            );
            mir_walk_value_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                stack_size,
                block,
                active_scopes,
            );
        },
    };
};

private let mir_walk_value_uses(
    shared_use_scope_by_local: Dict[UInt, MIRScopeID],
    first_use_block_by_local: Dict[UInt, UInt],
    multiple_use_blocks_by_local: Dict[UInt, Bool],
    tracked_drop_local_ids: Dict[UInt, Bool],
    parent_scope_by_scope: Dict[UInt, MIRScopeID],
    value: MIRValue,
    block: MIRBlockID,
    active_scopes: List[MIRScopeID],
): Void = {
    when value in {
        .Operand(operand) then mir_walk_operand_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            operand,
            block,
            active_scopes,
        ),
        .PlaceRead(place, _) then mir_walk_place_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            place,
            block,
            active_scopes,
        ),
        .Binary(operation) then {
            mir_walk_operand_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                operation.left,
                block,
                active_scopes,
            );
            mir_walk_operand_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                operation.right,
                block,
                active_scopes,
            );
        },
        .Unary(operation) then mir_walk_operand_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            operation.operand,
            block,
            active_scopes,
        ),
        .Call(call) then {
            mir_walk_operand_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                call.callee,
                block,
                active_scopes,
            );
            for argument in call.arguments then {
                mir_walk_value_uses(
                    shared_use_scope_by_local,
                    first_use_block_by_local,
                    multiple_use_blocks_by_local,
                    tracked_drop_local_ids,
                    parent_scope_by_scope,
                    argument,
                    block,
                    active_scopes,
                );
            };
        },
        .Aggregate(aggregate) then {
            for field in aggregate.fields then {
                mir_walk_value_uses(
                    shared_use_scope_by_local,
                    first_use_block_by_local,
                    multiple_use_blocks_by_local,
                    tracked_drop_local_ids,
                    parent_scope_by_scope,
                    field,
                    block,
                    active_scopes,
                );
            };
        },
        .EnumCase(construction) then {
            for argument in construction.arguments then {
                mir_walk_value_uses(
                    shared_use_scope_by_local,
                    first_use_block_by_local,
                    multiple_use_blocks_by_local,
                    tracked_drop_local_ids,
                    parent_scope_by_scope,
                    argument,
                    block,
                    active_scopes,
                );
            };
        },
        .EnumTag(tag) then mir_walk_value_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            tag.subject,
            block,
            active_scopes,
        ),
        .TraitObjectConversion(conversion) then mir_walk_value_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            conversion.inner,
            block,
            active_scopes,
        ),
        .TraitMethodCall(call) then {
            mir_walk_value_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                call.receiver,
                block,
                active_scopes,
            );
            for argument in call.arguments then {
                mir_walk_value_uses(
                    shared_use_scope_by_local,
                    first_use_block_by_local,
                    multiple_use_blocks_by_local,
                    tracked_drop_local_ids,
                    parent_scope_by_scope,
                    argument,
                    block,
                    active_scopes,
                );
            };
        },
        .Ref(place, _, _) or .Pointer(place) then mir_walk_place_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            place,
            block,
            active_scopes,
        ),
        .Cast(operand, _, _) then mir_walk_operand_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            operand,
            block,
            active_scopes,
        ),
        .Intrinsic(node) then mir_walk_intrinsic_uses(
            shared_use_scope_by_local,
            first_use_block_by_local,
            multiple_use_blocks_by_local,
            tracked_drop_local_ids,
            parent_scope_by_scope,
            node,
            block,
            active_scopes,
        ),
        .Lambda(lambda) then {
            for source in lambda.capture_sources then {
                mir_walk_place_uses(
                    shared_use_scope_by_local,
                    first_use_block_by_local,
                    multiple_use_blocks_by_local,
                    tracked_drop_local_ids,
                    parent_scope_by_scope,
                    source,
                    block,
                    active_scopes,
                );
            };
        },
    };
};

type mutable MIRFunctionCodeEmitter(
    codegen: CodeGen,
    function: MIRFunction,
    mutable local_names: List[String],
    mutable local_names_by_id: Dict[UInt, String],
    mutable non_owning_local_ids: Dict[UInt, Bool],
    mutable tracked_init_locals: Dict[UInt, Bool],
    mutable lifetime_plan: MIRLocalLifetimePlan,
    mutable address_taken_local_ids: Set[UInt],
    // P5 末次使用移动的指定点表（见 codegen_borrowed_self.koral）。
    mutable move_designations: Dict[UInt, MoveBlockPos],
    // WP-2 借用型绑定（成对消除）：绑定读不复制、作用域尾不释放。
    mutable alias_locals: Dict[UInt, Bool],
    // 发射游标：当前 (块,语句) —— 移动指定点按它命中。
    mutable current_block_index: UInt,
    mutable current_statement_index: UInt,
    mutable lambda_counter: UInt,
    mutable nested_definitions: StringBuilder,
    mutable current_owner_callable_name_cache_prefix: Option[String],
    mutable callable_name_cache: Dict[UInt, String],
    mutable consumed_locals: Dict[UInt, Bool],
    // 本函数体是否发射过 alloc_memory（含增长/创建辅助）。为 true 时函数
    // 定义带 KORAL_NOINLINE —— 见 koral_runtime.h 该宏处的注释。
    mutable saw_alloc_memory: Bool,
);

private let build_mir_function_emit_plan(
    codegen: CodeGen,
    function: MIRFunction,
): MIRFunctionEmitPlan = {
    let mutable local_names = List[String].new();
    let mutable local_names_by_id = Dict[UInt, String].new();
    let mutable non_owning_local_ids = compute_non_owning_mir_locals(function);
    let mutable tracked_init_locals = Dict[UInt, Bool].new();

    // Borrowed-self convention (Swift's "guaranteed self" / ARC pair elision):
    // the analysis (codegen_borrowed_self.koral) proved this method's `self`
    // non-escaping, every call site passes the handle +0, so this function
    // must NOT release it. Marking the self local non-owning does exactly that
    // -- no tracked init flag, hence no epilogue/root drop -- and the existing
    // non-owning machinery keeps the ledger balanced on every consuming use:
    // `should_copy_returned_operand` copies non-owning locals on return and
    // `emit_place_read` forces a retained copy for a Move read of a place with
    // no init flag, so nothing can consume the borrowed +0 handle directly.
    // Borrowed-convention parameters (see codegen_borrowed_self.koral): the
    // caller passes the handle +0, so the parameter owns nothing and must not
    // release at exit.
    for pair in function.params.lazy().enumerate() then {
        let slot_key = borrowed_slot_key(function.identifier.def_id.id, pair.first);
        if codegen.borrowed_param_slots.get(slot_key) is .Some(_) then {
            for local in function.locals then {
                if local.storage is .Parameter() and local.name == pair.second.name then {
                    non_owning_local_ids.insert(local.id.raw_value, true);
                    break;
                };
            };
        };
    };

    for local in function.locals then {
        let name = when local.storage in {
            .Parameter() or .Capture() then when local.symbol in {
                .Some(symbol) then codegen.c_identifier_for_symbol(symbol),
                .None() then codegen.sanitize_codegen_identifier(local.name),
            },
            _ then "__mir_\(codegen.sanitize_codegen_identifier(local.name))_\(local.id.raw_value)",
        };
        let is_non_owning = when non_owning_local_ids.get(local.id.raw_value) in {
            .Some(_) then true,
            .None() then false,
        };
        local_names.push(name);
        local_names_by_id.insert(local.id.raw_value, name);
        if local.storage is not .Capture() and not codegen.type_is_void_or_never(
            local.local_type,
        ) and codegen.needs_drop(local.local_type) and not is_non_owning then {
            tracked_init_locals.insert(local.id.raw_value, true);
        };
    };

    let lifetime_plan = build_mir_lifetime_plan(function, codegen, tracked_init_locals);
    let move_table = build_move_use_table(codegen, function);
    let move_designations = compute_move_designations(
        codegen,
        function,
        move_table,
        tracked_init_locals,
        non_owning_local_ids,
    );
    // WP-2 借用型绑定：不持 +1 —— 摘掉 init flag、并入非持有集后再出发射计划。
    let alias_locals = compute_alias_locals(
        codegen,
        function,
        move_table,
        tracked_init_locals,
        non_owning_local_ids,
        move_designations,
    );
    for pair in alias_locals.iterator() then {
        tracked_init_locals.try_remove(pair.first);
        non_owning_local_ids.insert(pair.first, true);
    };
    return MIRFunctionEmitPlan(
        local_names,
        local_names_by_id,
        non_owning_local_ids,
        tracked_init_locals,
        lifetime_plan,
        mir_address_taken_locals(function),
        move_designations,
        alias_locals,
    );
};

given MIRFunctionCodeEmitter {
    public new(
        codegen: CodeGen,
        function: MIRFunction,
        plan: MIRFunctionEmitPlan,
    ): MIRFunctionCodeEmitter = {
        return MIRFunctionCodeEmitter(
            codegen,
            function,
            plan.local_names,
            plan.local_names_by_id,
            plan.non_owning_local_ids,
            plan.tracked_init_locals,
            plan.lifetime_plan,
            plan.address_taken_local_ids,
            plan.move_designations,
            plan.alias_locals,
            UInt(0),
            UInt(0),
            UInt(0),
            StringBuilder.new(),
            when codegen.current_function_owner_type in {
                .Some(owner_type) then Option[String].Some(
                    codegen.receiver_owner(owner_type).display(),
                ),
                .None() then Option[String].None(),
            },
            Dict[UInt, String].new(),
            Dict[UInt, Bool].new(),
            false,
        );
    };

    public emit_body(self): Void = {
        self.emit_local_declarations();
        let mutable block_index = UInt(0);
        for block in self.function.blocks then {
            self.current_block_index = block_index;
            self.emit_block(block);
            block_index += UInt(1);
        };
    };

    public emit_body_and_get_nested_definitions(self): String = {
        self.emit_body();
        return self.get_nested_definitions();
    };

    public get_nested_definitions(self): String = {
        return self.nested_definitions.to_string();
    };

    callable_name_for_symbol(self, symbol: Symbol): String = {
        when self.callable_name_cache.get(symbol.def_id.id) in {
            .Some(name) then {
                return name;
            },
            .None() then {},
        };

        when self.current_owner_callable_name_cache_prefix in {
            .Some(owner_key_prefix) then {
                let global_cache_key = "\(owner_key_prefix)|\(symbol.def_id.id.to_string())";
                when self.codegen.current_owner_callable_c_name_cache.get(
                    global_cache_key,
                ) in {
                    .Some(name) then {
                        self.callable_name_cache.insert(symbol.def_id.id, name);
                        return name;
                    },
                    .None() then {},
                };
            },
            .None() then {},
        };
        let name = self.codegen.callable_c_name(symbol);
        self.callable_name_cache.insert(symbol.def_id.id, name);
        when self.current_owner_callable_name_cache_prefix in {
            .Some(owner_key_prefix) then {
                let global_cache_key = "\(owner_key_prefix)|\(symbol.def_id.id.to_string())";
                self.codegen.current_owner_callable_c_name_cache.insert(
                    global_cache_key,
                    name,
                );
            },
            .None() then {},
        };
        return name;
    };

    local_info(self, local_id: MIRLocalID): Option[MIRLocal] = {
        for local in self.function.locals then {
            if local.id.raw_value == local_id.raw_value then {
                return Option[MIRLocal].Some(local);
            };
        };
        return Option[MIRLocal].None();
    };

    init_flag(self, local_id: MIRLocalID): Option[String] = {
        if self.tracked_init_locals.get(local_id.raw_value) is .Some(_) then {
            return Option[String].Some("__mir_init_\(local_id.raw_value)");
        };
        return Option[String].None();
    };

    emit_local_declarations(self): Void = {
        for local in self.function.locals then {
            if local.storage is not .Parameter() and is not .Capture() then {
                let mutable c_type = self.codegen.c_type_name(local.local_type);
                // Skip void/unknown locals — C does not allow void variables.
                // Use a placeholder name that will be replaced with "(void)0" when referenced.
                if c_type == "void" then {
                    c_type = "intptr_t";
                };
                let name = self.local_name(local.id);
                self.codegen.add_indent();
                self.codegen.buffer.push_string(c_type);
                self.codegen.buffer.push_string(" ");
                self.codegen.buffer.push_string(name);
                self.codegen.buffer.push_string(";\n");
            };
        };
        for local in self.function.locals then {
            when self.init_flag(local.id) in {
                .Some(flag) then {
                    let initial = if local.storage is .Parameter() then "1" else "0";
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string("_Bool ");
                    self.codegen.buffer.push_string(flag);
                    self.codegen.buffer.push_string(" = ");
                    self.codegen.buffer.push_string(initial);
                    self.codegen.buffer.push_string(";\n");
                },
                .None() then {},
            };
        };
    };

    emit_block(self, block: MIRBasicBlock): Void = {
        let preserved_return_local = when block.terminator in {
            .ReturnValue(operand_opt) then when operand_opt in {
                .Some(operand) then self.local_id_from_operand(operand),
                .None() then Option[MIRLocalID].None(),
            },
            _ then Option[MIRLocalID].None(),
        };
        let wraps_block = when self.lifetime_plan.block_local_declarations_by_block.get(
            block.id.raw_value,
        ) in {
            .Some(locals) then not locals.is_empty(),
            .None() then false,
        };
        self.codegen.add_indent();
        let mutable statement_index = UInt(0);
        if wraps_block then {
            self.codegen.buffer.push_string(self.block_label(block.id));
            self.codegen.buffer.push_string(": {\n");
            self.codegen.push_indent_level();
            for statement in block.statements then {
                self.current_statement_index = statement_index;
                when statement in {
                    .ScopeExit(scope) then self.emit_scope_cleanup_preserving(
                        scope,
                        preserved_return_local,
                    ),
                    _ then self.emit_statement(statement),
                };
                statement_index += UInt(1);
            };
            self.current_statement_index = statement_index;
            self.emit_terminator(block.terminator);
            self.codegen.pop_indent_level();
            self.codegen.add_indent();
            self.codegen.buffer.push_string("}\n");
            return;
        };
        self.codegen.buffer.push_string(self.block_label(block.id));
        self.codegen.buffer.push_string(":;\n");
        for statement in block.statements then {
            self.current_statement_index = statement_index;
            when statement in {
                .ScopeExit(scope) then self.emit_scope_cleanup_preserving(
                    scope,
                    preserved_return_local,
                ),
                _ then self.emit_statement(statement),
            };
            statement_index += UInt(1);
        };
        self.current_statement_index = statement_index;
        self.emit_terminator(block.terminator);
    };

    emit_statement(self, statement: MIRStatement): Void = {
        when statement in {
            .Declare(_) then {},
            .Assign(place, value) then self.emit_assign(place, value),
            .AtomicLoad(target, place) then self.emit_atomic_load(target, place),
            .AtomicStore(place, value) then self.emit_atomic_store(place, value),
            .Exchange(place, old_target, value) then self.emit_exchange(place, old_target, value),
            .Drop(place) then self.emit_drop(place),
            .Retain(value) then self.emit_retain(value),
            .Release(value) then self.emit_release(value),
            .Evaluate(value) then self.emit_evaluate(value),
            .Lock(lock) then self.emit_lock_op(lock, true),
            .Unlock(lock) then self.emit_lock_op(lock, false),
            .ScopeEnter(_) then {},
            .ScopeExit(scope) then self.emit_scope_cleanup(scope),
            .DebugSource(_) then {},
        };
    };

    /// 标量槽原子读（concurrency-design.md §对象锁语义）：`__koral_atomic_load_n`
    /// 按位取入目标局部，顺序一致。
    emit_atomic_load(self, target: MIRLocalID, place: MIRPlace): Void = {
        let access = self.emit_place_access(place);
        let target_name = self.local_name(target);
        self.codegen.add_indent();
        self.codegen.buffer.push_string(
            "__koral_atomic_load_n(&\(target_name), &\(access.path), sizeof(\(target_name)));\n",
        );
        self.emit_cleanup(access.cleanup);
    };

    /// 标量槽原子写（顺序一致）。值先绑定临时（`&` 只对左值合法）。
    emit_atomic_store(self, place: MIRPlace, value: MIRValue): Void = {
        let access = self.emit_place_access(place);
        let emission = self.emit_value(value);
        let temp = self.codegen.next_temp_with_decl(
            self.codegen.c_type_name(self.type_of_place(place)),
        );
        self.codegen.add_indent();
        self.codegen.buffer.push_string("\(temp) = \(emission.expression);\n");
        self.codegen.add_indent();
        self.codegen.buffer.push_string(
            "__koral_atomic_store_n(&\(access.path), &\(temp), sizeof(\(access.path)));\n",
        );
        self.consume_moved_source(value);
        self.emit_cleanup(access.cleanup);
        self.emit_residual_cleanups(emission, true);
    };

    /// 句柄换写：旧值按位转入 `old_target`（所有权转移，无 retain），再写入
    /// 新值。`old_target` 的释放由调用方在 `Unlock` 之后发射（析构绝不进锁）。
    emit_exchange(self, place: MIRPlace, old_target: MIRLocalID, value: MIRValue): Void = {
        let access = self.emit_place_access(place);
        let emission = self.emit_value(value);
        let target_name = self.local_name(old_target);
        self.codegen.add_indent();
        self.codegen.buffer.push_string("\(target_name) = \(access.path);\n");
        self.set_init_flag(old_target, true);
        self.codegen.add_indent();
        self.codegen.buffer.push_string("\(access.path) = \(emission.expression);\n");
        self.consume_moved_source(value);
        self.emit_cleanup(access.cleanup);
        self.emit_residual_cleanups(emission, true);
    };

    emit_terminator(self, terminator: MIRTerminator): Void = {
        when terminator in {
            .Goto(block) then self.emit_goto(block),
            .Branch(condition, then_block, else_block) then {
                let condition_expr = self.emit_operand_expression(condition);
                self.codegen.add_indent();
                self.codegen.buffer.push_string("if (");
                self.codegen.buffer.push_string(condition_expr);
                self.codegen.buffer.push_string(") { goto ");
                self.codegen.buffer.push_string(self.block_label(then_block));
                self.codegen.buffer.push_string("; }\n");
                self.codegen.add_indent();
                self.codegen.buffer.push_string("goto ");
                self.codegen.buffer.push_string(self.block_label(else_block));
                self.codegen.buffer.push_string(";\n");
            },
            .SwitchValue(operand, cases, default_block) then {
                let switch_expr = self.emit_operand_expression(operand);
                self.codegen.add_indent();
                self.codegen.buffer.push_string("switch (");
                self.codegen.buffer.push_string(switch_expr);
                self.codegen.buffer.push_string(") {\n");
                self.codegen.push_indent_level();
                for switch_case in cases then {
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string("case ");
                    self.codegen.buffer.push_string(
                        self.switch_case_expression(switch_case.value),
                    );
                    self.codegen.buffer.push_string(": goto ");
                    self.codegen.buffer.push_string(
                        self.block_label(switch_case.target),
                    );
                    self.codegen.buffer.push_string(";\n");
                };
                self.codegen.add_indent();
                when default_block in {
                    .Some(block) then {
                        self.codegen.buffer.push_string("default: goto ");
                        self.codegen.buffer.push_string(self.block_label(block));
                        self.codegen.buffer.push_string(";\n");
                    },
                    .None() then self.codegen.buffer.push_string(
                        "default: __builtin_unreachable();\n",
                    ),
                };
                self.codegen.pop_indent_level();
                self.codegen.add_indent();
                self.codegen.buffer.push_string("}\n");
            },
            .ReturnValue(operand) then self.emit_return(operand),
            .Unreachable() then {
                self.codegen.add_indent();
                self.codegen.buffer.push_string("__builtin_unreachable();\n");
            },
        };
    };

    emit_goto(self, block: MIRBlockID): Void = {
        self.codegen.add_indent();
        self.codegen.buffer.push_string("goto ");
        self.codegen.buffer.push_string(self.block_label(block));
        self.codegen.buffer.push_string(";\n");
    };

    emit_assign(self, place: MIRPlace, value: MIRValue): Void = {
        let access = self.emit_place_access(place);
        // P5 末次使用移动（concurrency-design.md）：放行表命中的裸局部复制读
        // 直接以移动语义入槽——省一对 retain/release，析构时序不变。
        let emission = if self.consume_last_use_source(value) then {
            self.emit_value_source(value)
        } else {
            if self.consume_alias_binding(place, value) then {
                self.emit_value_source(value)
            } else {
                self.emit_value(value)
            }
        };
        let target_type = self.type_of_place(place);
        let source_type = self.type_of_value(value);
        // When MIR assigns a void constant to a struct/enum result (dead branch of when/if),
        // emit memset instead of invalid `struct_var = 0`.
        if self.is_void_constant(value) and self.codegen.needs_drop(target_type) then {
            when self.local_target_id(place) in {
                .Some(local_id) then when self.init_flag(local_id) in {
                    .Some(flag) then self.emit_guarded_drop(
                        flag,
                        target_type,
                        access.path,
                    ),
                    .None() then {},
                },
                .None() then {},
            };
            self.codegen.add_indent();
            self.codegen.buffer.push_string("memset(&(");
            self.codegen.buffer.push_string(access.path);
            self.codegen.buffer.push_string("), 0, sizeof(");
            self.codegen.buffer.push_string(access.path);
            self.codegen.buffer.push_string("));\n");
            when self.local_target_id(place) in {
                .Some(local_id) then self.set_init_flag(local_id, true),
                .None() then {},
            };
            return;
        };
        when self.local_target_id(place) in {
            .Some(local_id) then when self.init_flag(local_id) in {
                .Some(flag) then self.emit_guarded_drop(flag, target_type, access.path),
                .None() then {},
            },
            .None() then {
                // Non-local (field/deref): use temp to avoid use-after-free when
                // source and destination alias the same location.
                if self.codegen.needs_drop(target_type) then {
                    let adapted = self.adapt_expression_for_target_type(
                        emission.expression,
                        source_type,
                        target_type,
                        false,
                        value is .Operand(.Function(_)),
                    );
                    let temp = self.codegen.next_temp_with_decl(
                        self.codegen.c_type_name(target_type),
                    );
                    self.codegen.append_copy_or_move_assignment(
                        target_type,
                        adapted,
                        temp,
                        false,
                    );
                    self.codegen.add_indent();
                    self.codegen.append_drop_statement(target_type, access.path);
                    self.codegen.append_copy_or_move_assignment(
                        target_type,
                        temp,
                        access.path,
                        false,
                    );
                    self.consume_moved_source(value);
                    self.emit_cleanup(access.cleanup);
                    self.emit_residual_cleanups(emission, true);
                    return;
                };
            },
        };
        let assigned_expression = self.adapt_expression_for_target_type(
            emission.expression,
            source_type,
            target_type,
            false,
            value is .Operand(.Function(_)),
        );
        // When assigning through a deref (pointer/ref), the old value is released
        // but the new value must be retained. Use copy semantics (retain) for
        // deref places; for other non-local places (field access), move is fine.
        let store_is_lvalue = self.is_deref_place(place);
        self.codegen.append_copy_or_move_assignment(
            target_type,
            assigned_expression,
            access.path,
            store_is_lvalue,
        );
        self.consume_moved_source(value);
        self.emit_cleanup(access.cleanup);
        self.emit_residual_cleanups(emission, true);
        when self.local_target_id(place) in {
            .Some(local_id) then self.set_init_flag(local_id, true),
            .None() then {},
        };
    };

    is_void_constant(self, value: MIRValue): Bool = {
        return when value in {
            .Operand(operand) then when operand in {
                .Constant(constant) then when constant in {
                    .Void() then true,
                    _ then false,
                },
                _ then false,
            },
            _ then false,
        };
    };

    is_deref_place(self, place: MIRPlace): Bool = {
        return when place in {
            .Deref(_, _) then true,
            .Field(base, _) or .EnumPayload(base, _, _, _, _) then self.is_deref_place(base),
            .Local(_) or .Global(_) or .PointerElement(_, _) then false,
        };
    };

    emit_drop(self, place: MIRPlace): Void = {
        let access = self.emit_place_access(place);
        let mutable drop_type = self.type_of_place(place);
        when self.local_target_id(place) in {
            .Some(local_id) then when self.init_flag(local_id) in {
                .Some(flag) then self.emit_guarded_drop(flag, drop_type, access.path),
                .None() then {},
            },
            .None() then {
                self.codegen.add_indent();
                self.codegen.append_drop_statement(drop_type, access.path);
                // Swift emitDrop: dropping a sub-place (e.g. a discarded pair field)
                // must invalidate the root local, otherwise the container is dropped
                // a second time at scope exit and the payload is released twice.
                when self.root_local_of_place(place) in {
                    .Some(local) then self.set_init_flag(local, false),
                    .None() then {},
                };
            },
        };
        self.emit_cleanup(access.cleanup);
    };

    emit_retain(self, value: MIRValue): Void = {
        let emission = self.emit_value_source(value);
        let mutable value_type = self.type_of_value(value);
        when value_type in {
            .ReferenceType(_) or .MutableReferenceType(_) or .TraitObject(...) then {
                self.codegen.add_indent();
                self.codegen.buffer.push_string(
                    if self.codegen.uses_nonatomic_rc(value_type) then "__koral_retain_value_nonatomic(("
                    else "__koral_retain_value((",
                );
                self.codegen.buffer.push_string(emission.expression);
                self.codegen.buffer.push_string(").ptr);\n");
            },
            .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) then {},
            .WeakReferenceType(_) or .MutableWeakReferenceType(_) then {
                self.codegen.add_indent();
                self.codegen.buffer.push_string("if (((");
                self.codegen.buffer.push_string(emission.expression);
                self.codegen.buffer.push_string(").control)) { ");
                self.codegen.buffer.push_string(self.codegen.rc_weak_retain_fn(value_type));
                self.codegen.buffer.push_string("(((");
                self.codegen.buffer.push_string(emission.expression);
                self.codegen.buffer.push_string(").control)); }\n");
            },
            .FunctionType(...) then {
                self.codegen.add_indent();
                self.codegen.buffer.push_string(self.codegen.rc_closure_retain_fn(value_type));
                self.codegen.buffer.push_string("(");
                self.codegen.buffer.push_string(emission.expression);
                self.codegen.buffer.push_string(");\n");
            },
            _ then {},
        };
        self.emit_cleanup(emission.cleanup);
    };

    emit_release(self, value: MIRValue): Void = {
        let emission = self.emit_value_source(value);
        self.codegen.add_indent();
        self.codegen.append_drop_statement(
            self.type_of_value(value),
            emission.expression,
        );
        // 自持临时的 drop 就是上面那句（释放发射物的引用），残余清理必须
        // 跳过自命名 cleanup，否则同一份引用被放两次。
        self.emit_residual_cleanups(emission, true);
    };

    emit_evaluate(self, value: MIRValue): Void = {
        let emission = self.emit_value(value);
        let mutable value_type = self.type_of_value(value);
        if self.codegen.needs_drop(value_type) then {
            when value in {
                .Operand(.Local(local_id)) then when self.init_flag(local_id) in {
                    .Some(flag) then self.emit_guarded_drop(
                        flag,
                        value_type,
                        emission.expression,
                    ),
                    .None() then {},
                },
                _ then {
                    self.codegen.add_indent();
                    self.codegen.append_drop_statement(value_type, emission.expression);
                },
            };
            self.emit_residual_cleanups(emission, true);
        } else {
            self.emit_cleanup(emission.cleanup);
        };
    };

    /// 对象锁临界区边界（concurrency-design.md §对象锁语义）。
    ///
    /// `ObjectLock(handle)`：锁是 payload 隐藏首字段，`handle.ptr` 即 payload
    /// 指针，按 `&payload->__lock` 取锁地址（不依赖首字段偏移为 0 的巧合）。
    /// `GlobalLock(def_id)`：`let mutable` 全局量的每变量静态锁（静态零初始化，
    /// owner=0 / recursion=0 就是 runtime 的空闲态，无需启动期 init）。
    emit_lock_op(self, lock: MIRLockTarget, acquire: Bool): Void = {
        let lock_fn = if acquire then "__koral_lock_acquire" else "__koral_lock_release";
        let lock_expr = when lock in {
            .ObjectLock(handle) then {
                let name = self.local_name(handle);
                let handle_type = when self.local_info(handle) in {
                    .Some(info) then info.local_type,
                    .None() then Type.Unknown(),
                };
                let payload_type = self.codegen.managed_payload_type_name(handle_type);
                "&((struct \(payload_type)*)\(name).ptr)->__lock"
            },
            .GlobalLock(def_id) then {
                let name = when self.codegen.context.get_symbol(def_id) in {
                    .Some(symbol) then self.codegen.c_identifier_for_symbol_value(symbol),
                    .None() then self.codegen.c_identifier_opt(def_id) or else self.codegen.sanitize_codegen_identifier(
                        self.context_name(def_id),
                    ),
                };
                "&__koral_glock_\(name)"
            },
        };
        self.codegen.add_indent();
        self.codegen.buffer.push_string("\(lock_fn)((struct __koral_Lock*)\(lock_expr));\n");
    };

    emit_scope_cleanup(self, scope: MIRScopeID): Void = {
        self.emit_scope_cleanup_preserving(scope, Option[MIRLocalID].None());
    };

    emit_scope_cleanup_preserving(
        self,
        scope: MIRScopeID,
        preserved: Option[MIRLocalID],
    ): Void = {
        when self.lifetime_plan.locals_by_scope.get(scope.raw_value) in {
            .Some(locals) then {
                let mutable i = locals.count();
                while i > 0 then {
                    i -= 1;
                    let local_id = locals[i];
                    let skip = when preserved in {
                        .Some(value) then value.raw_value == local_id.raw_value,
                        .None() then false,
                    };
                    if not skip then {
                        when self.init_flag(local_id) in {
                            .Some(flag) then when self.local_info(local_id) in {
                                .Some(local) then self.emit_guarded_drop(
                                    flag,
                                    local.local_type,
                                    self.local_name(local_id),
                                ),
                                .None() then {},
                            },
                            .None() then {},
                        };
                    };
                };
            },
            .None() then {},
        };
    };

    emit_return(self, operand: Option[MIROperand]): Void = {
        when operand in {
            .Some(op) then {
                let raw_emission = self.emit_operand_value(op);
                let mutable return_type = self.type_of_operand(op);
                let emission = raw_emission;
                let should_copy = self.should_copy_returned_operand(op, return_type);
                let return_expression = if should_copy then {
                    let temp = self.codegen.next_temp_with_decl(
                        self.codegen.c_type_name(return_type),
                    );
                    self.codegen.append_copy_or_move_assignment(
                        return_type,
                        emission.expression,
                        temp,
                        true,
                    );
                    self.emit_root_cleanup(Option[MIRLocalID].None());
                    temp
                } else {
                    // Treat returning a local as moving ownership to the caller.
                    // Otherwise root cleanup can still drop the same local before
                    // the `return`, which is catastrophic for boxed/string values.
                    when self.local_id_from_operand(op) in {
                        .Some(local_id) then self.set_init_flag(local_id, false),
                        .None() then {},
                    };
                    self.emit_root_cleanup(self.local_id_from_operand(op));
                    // For borrowed reference parameters, retain before returning so the
                    // caller receives an owned reference. Without this, the caller and
                    // the callee parameter share the same control block, and both
                    // releases cause a double-free.
                    if self.is_parameter_operand(op) and is_reference_like_type(
                        return_type,
                    ) then {
                        self.codegen.add_indent();
                        self.codegen.buffer.push_string(
                            if self.codegen.uses_nonatomic_rc(return_type) then "__koral_retain_value_nonatomic(("
                            else "__koral_retain_value((",
                        );
                        self.codegen.buffer.push_string(emission.expression);
                        self.codegen.buffer.push_string(").ptr);\n");
                    };
                    emission.expression
                };
                self.codegen.add_indent();
                self.codegen.buffer.push_string("return ");
                self.codegen.buffer.push_string(return_expression);
                self.codegen.buffer.push_string(";\n");
                self.emit_residual_cleanups(emission, not should_copy);
            },
            .None() then {
                self.emit_root_cleanup(Option[MIRLocalID].None());
                self.codegen.add_indent();
                self.codegen.buffer.push_string("return;\n");
            },
        };
    };

    emit_root_cleanup(self, preserved: Option[MIRLocalID]): Void = {
        let mutable i = self.function.locals.count();
        while i > 0 then {
            i -= 1;
            let local = self.function.locals[i];
            let local_id = local.id;
            let skip = when preserved in {
                .Some(p) then p.raw_value == local_id.raw_value,
                .None() then false,
            };
            if skip then {
                continue;
            };
            when self.init_flag(local_id) in {
                .Some(flag) then self.emit_guarded_drop(
                    flag,
                    local.local_type,
                    self.local_name(local_id),
                ),
                .None() then {},
            };
        };
    };

    emit_guarded_drop(self, flag: String, drop_type: Type, expression: String): Void = {
        self.codegen.add_indent();
        self.codegen.buffer.push_string("if (");
        self.codegen.buffer.push_string(flag);
        self.codegen.buffer.push_string(") {\n");
        self.codegen.push_indent_level();
        self.codegen.add_indent();
        self.codegen.append_drop_statement(drop_type, expression);
        self.codegen.add_indent();
        self.codegen.buffer.push_string(flag);
        self.codegen.buffer.push_string(" = 0;\n");
        self.codegen.pop_indent_level();
        self.codegen.add_indent();
        self.codegen.buffer.push_string("}\n");
    };

    emit_value(self, value: MIRValue): MIRValueEmission = {
        return when value in {
            .Operand(operand) then self.emit_operand_value(operand),
            .PlaceRead(place, ownership) then self.emit_place_read(
                place,
                ownership,
                false,
            ),
            .Binary(operation) then self.emit_binary(operation),
            .Unary(operation) then self.emit_unary(operation),
            .Call(call) then self.emit_call(call),
            .Aggregate(aggregate) then self.emit_aggregate(aggregate),
            .EnumCase(construction) then self.emit_enum_case(construction),
            .EnumTag(tag) then self.emit_enum_tag(tag),
            .TraitObjectConversion(conversion) then self.emit_trait_object_conversion(
                conversion,
            ),
            .TraitMethodCall(call) then self.emit_trait_method_call(call),
            .Ref(place, kind, allocation) then self.emit_reference(
                place,
                kind,
                allocation,
            ),
            .Pointer(place) then self.emit_pointer(place),
            .Cast(operand, target_type, cast_span) then self.emit_cast_operand(operand, target_type, cast_span),
            .Intrinsic(node) then self.emit_intrinsic(node),
            .Lambda(lambda) then self.emit_lambda(lambda),
        };
    };

    emit_value_source(self, value: MIRValue): MIRValueEmission = {
        return when value in {
            .PlaceRead(place, ownership) then {
                let result = self.emit_place_read(place, ownership, true);
                result
            },
            _ then self.emit_value(value),
        };
    };

    emit_operand_value(self, operand: MIROperand): MIRValueEmission = {
        let expression = self.emit_operand_expression(operand);
        return MIRValueEmission(expression, Option[MIRValueCleanup].None());
    };

    emit_operand_expression(self, operand: MIROperand): String = {
        return when operand in {
            .Local(local) then self.local_name(local),
            .Function(symbol) then self.codegen.callable_c_name(symbol),
            .Constant(constant) then self.constant_expression(constant),
        };
    };

    /// A float constant's spelling is a decimal literal, and C reads an
    /// unsuffixed one as `double`. A `Float32` operand has to compare and
    /// compute at `float` width, so it carries the `f` suffix: without it
    /// `y == 1.1` for `y: Float32` promotes the subject and compares
    /// `(double)1.1f` against `1.1`, which is false. A synthesized constant
    /// may carry an integer spelling (`0`); the suffix only attaches to a real
    /// floating token, so that one becomes `0.0f` -- `0f` is not valid C.
    float_constant_literal(self, value: String, constant_type: Type): String = {
        let base = self.codegen.sanitize_c_numeric_literal(value);
        if constant_type is not .Float32Type() then {
            return base;
        };
        if base.contains(".") or base.contains("e") or base.contains("E") then {
            return base + "f";
        };
        return base + ".0f";
    };

    constant_expression(self, constant: MIRConstant): String = {
        return when constant in {
            .Integer(value, _) then self.codegen.integer_constant_literal(value),
            .Float(value, constant_type) then self.float_constant_literal(
                value,
                constant_type,
            ),
            .StringLiteral(value, string_type) then self.codegen.generate_string_literal(
                value,
                string_type,
            ),
            .Boolean(value) then if value then "1" else "0",
            .Void() then "0",
        };
    };

    emit_place_read(
        self,
        place: MIRPlace,
        ownership: MIROwnershipUse,
        source_mode: Bool,
    ): MIRValueEmission = {
        let access = self.emit_place_access(place);
        let mutable place_type = self.type_of_place(place);
        let mutable must_copy = false;
        if ownership is .Move() then {
            if self.place_is_consumable(place) then {
                self.consume_moved_place(place);
            } else {
                // 根不可消费的 move 读（指针元素/全局/解引用 place、捕获/
                // 非持有局部）只是别名：源仍持有引用并在之后 drop。必须物
                // 化 copy（retain）让发射物自持引用，否则任何存放点拿到的
                // 都是无主引用，源的 drop 会把它一起放掉（双释放）。
                must_copy = true;
            };
        };
        if not must_copy then {
            if source_mode or ownership is not .Copy() or not self.codegen.needs_drop(
                place_type,
            ) then {
                return MIRValueEmission(access.path, access.cleanup);
            };
        };
        let temp = self.codegen.next_temp_with_decl(
            self.codegen.c_type_name(place_type),
        );
        self.codegen.append_copy_or_move_assignment(place_type, access.path, temp, true);
        self.emit_cleanup(access.cleanup);
        return MIRValueEmission(
            temp,
            self.cleanup_for_temporary_result(temp, place_type),
        );
    };

    /// consume_moved_place 真能压掉一次 drop 的 place：根是持有 init flag
    /// 的局部（Capture/非持有局部没有 flag，清 flag 是空操作）。
    place_is_consumable(self, place: MIRPlace): Bool = {
        return when self.root_local_of_place(place) in {
            .Some(local) then self.init_flag(local) is .Some(_),
            .None() then false,
        };
    };

    emit_binary(self, operation: MIRBinaryOperation): MIRValueEmission = {
        let left = self.emit_operand_expression(operation.left);
        let right = self.emit_operand_expression(operation.right);
        let result_type = operation.result_type;
        let mutable c_type = self.codegen.c_type_name(result_type);
        let expression = when operation.operator_kind in {
            .Arithmetic(op, checked) then {
                let expr = if checked and self.codegen.is_integer_type(result_type) then self.codegen.next_temp_with_located_call_2(
                    c_type,
                    self.codegen.checked_arithmetic_func_name(op, result_type),
                    left,
                    right,
                    self.codegen.panic_loc_string(operation.span),
                )
                else self.codegen.next_temp_with_infix_init(
                    c_type,
                    left,
                    self.codegen.arithmetic_op_to_c(op),
                    right,
                );
                expr
            },
            .WrappingArithmetic(op) then self.codegen.next_temp_with_init(
                c_type,
                self.codegen.wrapping_arithmetic_init_expr(op, left, right, result_type, self.codegen.panic_loc_string(
                    operation.span,
                )),
            ),
            .Comparison(op) then self.codegen.next_temp_with_infix_init(
                c_type,
                left,
                self.codegen.comparison_op_to_c(op),
                right,
            ),
            .LogicalAnd() then self.codegen.next_temp_with_infix_init(
                "_Bool",
                left,
                "&&",
                right,
            ),
            .LogicalOr() then self.codegen.next_temp_with_infix_init(
                "_Bool",
                left,
                "||",
                right,
            ),
            .Bitwise(op, checked_shift) then {
                let expr = if checked_shift and self.codegen.is_integer_type(
                    result_type,
                ) and (op is .LeftShift() or is .RightShift()) then self.codegen.next_temp_with_located_call_2(
                    c_type,
                    self.codegen.shift_func_name(op, result_type),
                    left,
                    right,
                    self.codegen.panic_loc_string(operation.span),
                )
                else self.codegen.next_temp_with_infix_init(
                    c_type,
                    left,
                    self.codegen.bitwise_op_to_c(op),
                    right,
                );
                expr
            },
        };
        return MIRValueEmission(
            expression,
            self.cleanup_for_temporary_result(expression, result_type),
        );
    };

    call_arguments_match_function_type(
        self,
        arguments: List[MIRValue],
        function_type: Type,
    ): Bool = {
        return when function_type in {
            .FunctionType(params, _, _) then {
                if params.count() != arguments.count() then {
                    return false;
                };
                for pair in arguments.lazy().enumerate() then {
                    let i = pair.first;
                    let mutable expected_param_type = self.codegen.function_type_param_type(
                        function_type,
                        i,
                    ) or else Type.Unknown();
                    let mutable actual_param_type = self.type_of_value(pair.second);
                    let expected_key = self.codegen.concrete_layout_key_for_type(
                        self.codegen.concretize_codegen_type(expected_param_type),
                    );
                    let actual_key = self.codegen.concrete_layout_key_for_type(
                        self.codegen.concretize_codegen_type(actual_param_type),
                    );
                    if expected_key != actual_key then {
                        return false;
                    };
                };
                true
            },
            .ForeignFunctionType(params, _) then {
                if params.count() != arguments.count() then {
                    return false;
                };
                for pair in arguments.lazy().enumerate() then {
                    let i = pair.first;
                    let mutable expected_param_type = self.codegen.function_type_param_type(
                        function_type,
                        i,
                    ) or else Type.Unknown();
                    let mutable actual_param_type = self.type_of_value(pair.second);
                    let expected_key = self.codegen.concrete_layout_key_for_type(
                        self.codegen.concretize_codegen_type(expected_param_type),
                    );
                    let actual_key = self.codegen.concrete_layout_key_for_type(
                        self.codegen.concretize_codegen_type(actual_param_type),
                    );
                    if expected_key != actual_key then {
                        return false;
                    };
                };
                true
            },
            _ then false,
        };
    };

    emit_unary(self, operation: MIRUnaryOperation): MIRValueEmission = {
        let operand = self.emit_operand_expression(operation.operand);
        let result_type = operation.result_type;
        let expression = when operation.operator_kind in {
            .LogicalNot() then self.codegen.next_temp_with_init("_Bool", "!\(operand)"),
            .BitwiseNot() then self.codegen.next_temp_with_init(
                self.codegen.c_type_name(result_type),
                "~\(operand)",
            ),
        };
        return MIRValueEmission(
            expression,
            self.cleanup_for_temporary_result(expression, result_type),
        );
    };

    /// Borrowed-self convention (Swift's "guaranteed self" / ARC pair elision):
    /// when the callee's `self` was proven non-escaping (see
    /// codegen_borrowed_self.koral), the receiver handle is passed +0 -- the
    /// caller must NOT retain it and the callee will NOT release it.
    /// `MIROwnershipUse.Borrow()` is exactly the +0 shape
    /// `emit_direct_call_argument` already implements: a place read passes the
    /// raw handle and a temporary receiver keeps its caller-side cleanup (so
    /// `f().push(x)` still drops the temporary after the call). Only argument
    /// 0 -- the self slot -- is touched; every other argument keeps its
    /// lowered ownership, and a callee outside the set keeps the owned
    /// convention (the analysis only admits methods whose every call site can
    /// adopt this pass).
    apply_borrowed_self_receiver_convention(self, call: MIRCall): MIRCall = {
        if call.arguments.count() == 0 then {
            return call;
        };
        let mutable callee_def_id = UInt(0);
        when call.callee in {
            .Function(symbol) then {
                callee_def_id = symbol.def_id.id;
            },
            _ then {
                return call;
            },
        };
        if call.argument_ownerships.count() != call.arguments.count() then {
            return call;
        };
        let mutable changed = false;
        let mutable ownerships = List[MIROwnershipUse].new();
        for pair in call.argument_ownerships.lazy().enumerate() then {
            let slot_key = borrowed_slot_key(callee_def_id, pair.first);
            if not (pair.second is .Borrow()) and self.codegen.borrowed_param_slots.get(
                slot_key,
            ) is .Some(_) then {
                ownerships.push(MIROwnershipUse.Borrow());
                changed = true;
            } else {
                ownerships.push(pair.second);
            };
        };
        if not changed then {
            return call;
        };
        return MIRCall(call.callee, call.arguments, ownerships, call.result_type);
    };

    emit_call(self, call_arg: MIRCall): MIRValueEmission = {
        let call = self.apply_borrowed_self_receiver_convention(call_arg);
        let has_ownerships = call.argument_ownerships.count() == call.arguments.count();
        when call.callee in {
            .Function(symbol) then {
                let function_name = self.callable_name_for_symbol(symbol);
                let mutable function_type = self.codegen.context.get_function_type(
                    symbol.def_id,
                ) or else symbol.symbol_type;
                if call.arguments.count() == 0 then {
                    let expression = self.emit_direct_call_0(
                        function_name,
                        call.result_type,
                    );
                    return MIRValueEmission(
                        expression,
                        self.cleanup_for_temporary_result(expression, call.result_type),
                    );
                };
                if call.arguments.count() == 1 then {
                    let ownership = if has_ownerships then call.argument_ownerships[
                        UInt(0)
                    ] else MIROwnershipUse.Move();
                    let emission = self.emit_direct_call_argument(
                        call.arguments[UInt(0)],
                        ownership,
                        self.codegen.impure_function_ids.get(symbol.def_id.id) is .None(),
                    );
                    // Auto-wrap: if the function parameter expects a borrowed reference
                    // but the argument is a raw value, wrap it in a stack borrow.
                    let mutable arg_type = self.type_of_value(call.arguments[UInt(0)]);
                    let mutable expected_param_type = self.codegen.function_type_param_type(
                        function_type,
                        UInt(0),
                    ) or else Type.Unknown();
                    let needs_wrap = is_borrowed_reference_like_type(
                        expected_param_type,
                    ) and not is_reference_like_type(arg_type);
                    let final_emission = if needs_wrap then self.wrap_value_as_stack_borrow(
                        emission.expression,
                        arg_type,
                        expected_param_type,
                    )
                    else self.unwrap_reference_like_argument_if_needed(
                        emission,
                        arg_type,
                        expected_param_type,
                    );
                    let expression = self.emit_direct_call_1(
                        function_name,
                        final_emission.expression,
                        call.result_type,
                    );
                    if ownership is .Move() or is .Take() then {
                        self.consume_moved_source(call.arguments[UInt(0)]);
                    };
                    self.emit_residual_cleanups(
                        final_emission,
                        self.call_arg_consumed(ownership, call.arguments[UInt(0)]),
                    );
                    return MIRValueEmission(
                        expression,
                        self.cleanup_for_temporary_result(expression, call.result_type),
                    );
                };
                if call.arguments.count() == 2 then {
                    let first_ownership = if has_ownerships then call.argument_ownerships[
                        UInt(0)
                    ] else MIROwnershipUse.Move();
                    let second_ownership = if has_ownerships then call.argument_ownerships[
                        UInt(1)
                    ] else MIROwnershipUse.Move();
                    let first_emission = self.emit_direct_call_argument(
                        call.arguments[UInt(0)],
                        first_ownership,
                        self.codegen.impure_function_ids.get(symbol.def_id.id) is .None(),
                    );
                    let second_emission = self.emit_direct_call_argument(
                        call.arguments[UInt(1)],
                        second_ownership,
                        self.codegen.impure_function_ids.get(symbol.def_id.id) is .None(),
                    );
                    // Auto-wrap borrowed reference parameters.
                    let mutable first_type = self.type_of_value(call.arguments[UInt(0)]);
                    let mutable second_type = self.type_of_value(
                        call.arguments[UInt(1)],
                    );
                    let first_expected = self.codegen.function_type_param_type(
                        function_type,
                        UInt(0),
                    ) or else Type.Unknown();
                    let second_expected = self.codegen.function_type_param_type(
                        function_type,
                        UInt(1),
                    ) or else Type.Unknown();
                    let first = if is_borrowed_reference_like_type(first_expected) and not is_reference_like_type(
                        first_type,
                    ) then self.wrap_value_as_stack_borrow(
                        first_emission.expression,
                        first_type,
                        first_expected,
                    )
                    else self.unwrap_reference_like_argument_if_needed(
                        first_emission,
                        first_type,
                        first_expected,
                    );
                    let second = if is_borrowed_reference_like_type(second_expected) and not is_reference_like_type(
                        second_type,
                    ) then self.wrap_value_as_stack_borrow(
                        second_emission.expression,
                        second_type,
                        second_expected,
                    )
                    else self.unwrap_reference_like_argument_if_needed(
                        second_emission,
                        second_type,
                        second_expected,
                    );
                    let expression = self.emit_direct_call_2(
                        function_name,
                        first.expression,
                        second.expression,
                        call.result_type,
                    );
                    if first_ownership is .Move() or is .Take() then {
                        self.consume_moved_source(call.arguments[UInt(0)]);
                    };
                    if second_ownership is .Move() or is .Take() then {
                        self.consume_moved_source(call.arguments[UInt(1)]);
                    };
                    self.emit_residual_cleanups(
                        first,
                        self.call_arg_consumed(first_ownership, call.arguments[UInt(0)]),
                    );
                    self.emit_residual_cleanups(
                        second,
                        self.call_arg_consumed(second_ownership, call.arguments[UInt(1)]),
                    );
                    return MIRValueEmission(
                        expression,
                        self.cleanup_for_temporary_result(expression, call.result_type),
                    );
                };
            },
            _ then {},
        };

        // Get function parameter types for borrowed-reference wrapping.
        let fn_param_types = when call.callee in {
            .Function(sym) then {
                let mutable pts = List[Type].new();
                let mutable function_type = self.codegen.context.get_function_type(
                    sym.def_id,
                ) or else sym.symbol_type;
                when function_type in {
                    .FunctionType(params, _, _) then {
                        for p in params then {
                            pts.push(p.param_type);
                        };
                    },
                    .ForeignFunctionType(params, _) then {
                        for p in params then {
                            pts.push(p.param_type);
                        };
                    },
                    _ then {},
                };
                pts
            },
            _ then List[Type].new(),
        };
        let callee_pure = when call.callee in {
            .Function(sym) then {
                self.codegen.impure_function_ids.get(sym.def_id.id) is .None()
            },
            _ then false,
        };
        let mutable arg_values = List[String].new();
        let mutable emissions = List[MIRValueEmission].new();
        let mutable ownerships = List[MIROwnershipUse].new();
        for pair in call.arguments.lazy().enumerate() then {
            let arg_i = pair.first;
            let arg = pair.second;
            let ownership = if has_ownerships then call.argument_ownerships[arg_i]
            else MIROwnershipUse.Move();
            ownerships.push(ownership);
            let emission = self.emit_direct_call_argument(
                arg,
                ownership,
                callee_pure,
            );
            // Auto-wrap: if the function parameter expects a borrowed reference
            // but the argument is a raw value, wrap it in a stack borrow.
            let mutable arg_type = self.type_of_value(arg);
            let needs_wrap = arg_i < fn_param_types.count() and is_borrowed_reference_like_type(
                fn_param_types[arg_i],
            ) and not is_reference_like_type(arg_type);
            if needs_wrap then {
                let wrapped = self.wrap_value_as_stack_borrow(
                    emission.expression,
                    arg_type,
                    fn_param_types[arg_i],
                );
                emissions.push(wrapped);
                arg_values.push(wrapped.expression);
            } else {
                let final_emission = if arg_i < fn_param_types.count() then self.unwrap_reference_like_argument_if_needed(
                    emission,
                    arg_type,
                    fn_param_types[arg_i],
                ) else emission;
                emissions.push(final_emission);
                arg_values.push(final_emission.expression);
            };
        };
        let expression = when call.callee in {
            .Function(symbol) then {
                let callee_name = self.callable_name_for_symbol(symbol);
                self.emit_direct_call(callee_name, arg_values, call.result_type)
            },
            _ then {
                let callee_type = self.type_of_operand(call.callee);
                if callee_type is .ForeignFunctionType(_, _) then {
                    // A bare C function pointer: a plain C call through it.
                    let callee_expr = self.emit_operand_expression(call.callee);
                    let mutable call_text = StringBuilder.new();
                    call_text.push_string("(");
                    call_text.push_string(callee_expr);
                    call_text.push_string(")(");
                    let mutable first_arg = true;
                    for a in arg_values then {
                        if not first_arg then {
                            call_text.push_string(", ");
                        };
                        call_text.push_string(a);
                        first_arg = false;
                    };
                    call_text.push_string(")");
                    call_text.to_string()
                } else {
                    self.emit_closure_call(
                        self.emit_operand_expression(call.callee),
                        callee_type,
                        arg_values,
                        call.result_type,
                    )
                }
            },
        };
        for pair in ownerships.lazy().zip[
            MIRValue,
            ListIterator[MIRValue],
            List[MIRValue],
        ](call.arguments) then {
            let ownership = pair.first;
            if ownership is .Move() or is .Take() then {
                self.consume_moved_source(pair.second);
            };
        };
        for pair in emissions.lazy().enumerate() then {
            self.emit_residual_cleanups(
                pair.second,
                self.call_arg_consumed(ownerships[pair.first], call.arguments[pair.first]),
            );
        };
        return MIRValueEmission(
            expression,
            self.cleanup_for_temporary_result(expression, call.result_type),
        );
    };

    /// Whether `t` is a nominal whose slots are rewritable through any alias
    /// of the object (`type mutable`) -- the layout question, not syntax.
    type_is_mutable_nominal(self, t: Type): Bool = {
        return when t in {
            .StructureType(def_id) or .EnumType(def_id) or .OpaqueType(def_id) then {
                self.codegen.context.is_struct_mutable(def_id)
            },
            .GenericStruct(template_def_id, _) or .GenericEnum(template_def_id, _) then {
                template_def_id.is_valid()
                    and self.codegen.context.is_struct_mutable(template_def_id)
            },
            _ then false,
        };
    };

    /// Can an impure callee borrow this place's read +0, with no retained
    /// temp? The value must survive the call untouched:
    ///
    /// * A **bare local read** is always safe: the binding owns the value, so
    ///   it cannot die mid-call, and there is no intermediate slot whose
    ///   rewrite could invalidate the read. (A chain of such borrows bottoms
    ///   out at a real owner in some caller frame.)
    /// * A **projected read** loads out of a slot that code with an alias to
    ///   the container can rewrite (`type mutable` fields are rewritable
    ///   through any handle), so every container along the chain must be
    ///   immutable -- `observe(h, h.box)` rewrites `h.box` mid-call and frees
    ///   the borrowed box behind the argument's back. The root-local gates
    ///   still apply: an escaped `&local` can overwrite the binding itself,
    ///   and a reference-like local points into someone else's slot.
    /// * Anything else (global/deref/pointer-element roots) is never stable.
    ///
    /// A pure callee rewrites nothing reachable, so it needs no stability at
    /// all -- the caller checks that first.
    borrowed_place_is_stable(self, place: MIRPlace): Bool = {
        let mutable current = place;
        while true then {
            when current in {
                .Local(local) then {
                    if self.address_taken_local_ids.contains(local.raw_value) then {
                        return false;
                    };
                    return when self.local_info(local) in {
                        .Some(info) then not is_reference_like_type(info.local_type),
                        .None() then false,
                    };
                },
                .Field(base, _) or .EnumPayload(base, _, _, _, _) then {
                    let container_t = self.type_of_place(base);
                    if is_reference_like_type(container_t)
                        or self.type_is_mutable_nominal(container_t) then {
                        return false;
                    };
                    current = base;
                },
                _ then {
                    return false;
                },
            };
        };
        return false;
    };

    /// P5 末次使用移动（concurrency-design.md · codegen_borrowed_self.koral）：
    /// 值源是裸局部的复制读、且当前 (块,语句) 命中预计算的移动指定点时，
    /// 就地消费源（清 init flag）并放行移动语义——省一对 retain/release。
    /// 消费必须在这里做：值的 Copy 标签不会让 `consume_moved_source` 记账，
    /// 不清 flag 就会在作用域尾二次释放。指定点是判 G 放行的末次使用，
    /// 清掉的 flag 又是运行时判据，路径敏感天然成立。
    consume_last_use_source(self, value: MIRValue): Bool = {
        return when value in {
            .PlaceRead(place, ownership) then {
                if not (ownership is .Copy()) then {
                    return false;
                };
                when place in {
                    .Local(local_id) then {
                        when self.move_designations.get(local_id.raw_value) in {
                            .Some(site) then {
                                if site.block_index == self.current_block_index
                                    and site.statement_index == self.current_statement_index then {
                                    self.set_init_flag(local_id, false);
                                    true
                                } else {
                                    false
                                }
                            },
                            .None() then false,
                        }
                    },
                    _ then false,
                }
            },
            _ then false,
        };
    };

    /// WP-2 借用型绑定（concurrency-design.md · codegen_borrowed_self.koral）：
    /// 目标是别名局部时，绑定只是句柄借用——源读不复制（不 retain），目标
    /// 非持有（作用域尾不 release），正好省掉一对；源不被消费。
    consume_alias_binding(self, place: MIRPlace, value: MIRValue): Bool = {
        return when place in {
            .Local(local_id) then {
                if self.alias_locals.get(local_id.raw_value) is .Some(_)
                    and value is .PlaceRead(...) then {
                    true
                } else {
                    false
                }
            },
            _ then false,
        };
    };

    emit_direct_call_argument(
        self,
        value: MIRValue,
        ownership: MIROwnershipUse,
        callee_pure: Bool,
    ): MIRValueEmission = {
        let mutable value_type = self.type_of_value(value);
        return when ownership in {
            .Copy() then {
                // P5 末次使用移动（concurrency-design.md）：预计算放行表命中
                // 的裸局部复制读改走移动路径——省一对 retain/release。
                if self.consume_last_use_source(value) then {
                    return self.emit_direct_call_argument(
                        value,
                        MIROwnershipUse.Move(),
                        callee_pure,
                    );
                };
                let emission = self.emit_value(value);
                // A bare function operand has to be boxed into a `__koral_Closure`
                // before it lands in one: `emit_value` hands back the C function
                // name, and assigning that straight to a closure temp is a type
                // error. Lambda values are already boxed by the lambda emitter.
                let source_expr = self.adapt_expression_for_target_type(
                    emission.expression,
                    value_type,
                    value_type,
                    false,
                    value is .Operand(.Function(_)),
                );
                if not self.codegen.needs_drop(value_type) then {
                    return MIRValueEmission(source_expr, emission.cleanup);
                };
                when value in {
                    .PlaceRead(_, place_ownership) then {
                        if place_ownership is .Copy() then {
                            emission
                        } else {
                            let temp = self.codegen.next_temp_with_decl(
                                self.codegen.c_type_name(value_type),
                            );
                            self.codegen.append_copy_or_move_assignment(
                                value_type,
                                source_expr,
                                temp,
                                true,
                            );
                            self.emit_cleanup(emission.cleanup);
                            MIRValueEmission(
                                temp,
                                self.cleanup_for_temporary_result(temp, value_type),
                            )
                        }
                    },
                    _ then {
                        let temp = self.codegen.next_temp_with_decl(
                            self.codegen.c_type_name(value_type),
                        );
                        self.codegen.append_copy_or_move_assignment(
                            value_type,
                            source_expr,
                            temp,
                            true,
                        );
                        self.emit_cleanup(emission.cleanup);
                        MIRValueEmission(
                            temp,
                            self.cleanup_for_temporary_result(temp, value_type),
                        )
                    },
                }
            },
            .Borrow() then {
                // A borrowed read goes over +0 only when it is stable for the
                // call's duration (see `borrowed_place_is_stable`) or the
                // callee is a pure reader (see `compute_impure_function_ids`)
                // and can rewrite nothing reachable. Everything else keeps a
                // retained temp that drops right after the call.
                let emission = when value in {
                    .PlaceRead(place, _) then {
                        let stable = callee_pure
                            or self.borrowed_place_is_stable(place);
                        if not stable and self.codegen.needs_drop(value_type) then {
                            self.emit_place_read(place, MIROwnershipUse.Copy(), false)
                        } else {
                            self.emit_value_source(value)
                        }
                    },
                    _ then self.emit_value_source(value),
                };
                MIRValueEmission(
                    self.adapt_expression_for_target_type(
                        emission.expression,
                        value_type,
                        value_type,
                        false,
                        value is .Operand(.Function(_)),
                    ),
                    emission.cleanup,
                )
            },
            .Move() then {
                let emission = self.emit_value_source(value);
                // When passing a managed nominal value that was read from another
                // managed nominal (as a field), we must retain it.  The callee
                // will drop the value; without a retain the payload's reference
                // to the nested field will have an under-counted refcount.
                if self.is_nested_managed_nominal_field_read(value) then {
                    let mutable field_type = self.type_of_value(value);
                    let temp = self.codegen.next_temp_with_decl(
                        self.codegen.c_type_name(field_type),
                    );
                    self.codegen.append_copy_or_move_assignment(
                        field_type,
                        self.adapt_expression_for_target_type(
                            emission.expression,
                            field_type,
                            field_type,
                            false,
                            value is .Operand(.Function(_)),
                        ),
                        temp,
                        true,
                    );
                    self.emit_cleanup(emission.cleanup);
                    MIRValueEmission(
                        temp,
                        self.cleanup_for_temporary_result(temp, field_type),
                    )
                } else {
                    MIRValueEmission(
                        self.adapt_expression_for_target_type(
                            emission.expression,
                            value_type,
                            value_type,
                            false,
                            value is .Operand(.Function(_)),
                        ),
                        emission.cleanup,
                    )
                }
            },
            .Take() then {
                let emission = self.emit_value_source(value);
                if self.is_nested_managed_nominal_field_read(value) then {
                    let mutable field_type = self.type_of_value(value);
                    let temp = self.codegen.next_temp_with_decl(
                        self.codegen.c_type_name(field_type),
                    );
                    self.codegen.append_copy_or_move_assignment(
                        field_type,
                        self.adapt_expression_for_target_type(
                            emission.expression,
                            field_type,
                            field_type,
                            false,
                            value is .Operand(.Function(_)),
                        ),
                        temp,
                        true,
                    );
                    self.emit_cleanup(emission.cleanup);
                    MIRValueEmission(
                        temp,
                        self.cleanup_for_temporary_result(temp, field_type),
                    )
                } else {
                    MIRValueEmission(
                        self.adapt_expression_for_target_type(
                            emission.expression,
                            value_type,
                            value_type,
                            false,
                            value is .Operand(.Function(_)),
                        ),
                        emission.cleanup,
                    )
                }
            },
        };
    };

    /// Returns true if `value` is a PlaceRead of a managed nominal field
    /// from another managed nominal type (base type is managed nominal and
    /// field type is also managed nominal).
    is_nested_managed_nominal_field_read(self, value: MIRValue): Bool = {
        return when value in {
            .PlaceRead(place, _) then when place in {
                .Field(base, _) then {
                    let base_type = self.type_of_place(base);
                    let field_type = self.type_of_place(place);
                    return if self.codegen.uses_managed_nominal_representation(
                        base_type,
                    ) and self.codegen.uses_managed_nominal_representation(field_type) then self.codegen.needs_drop(
                        field_type,
                    ) else false;
                },
                _ then false,
            },
            _ then false,
        };
    };

    call_arg_consumed(self, ownership: MIROwnershipUse, value: MIRValue): Bool = {
        return when ownership in {
            .Move() or .Take() then true,
            .Copy() then when value in {
                .PlaceRead(_, borrow_ownership) then borrow_ownership is not .Borrow(),
                _ then true,
            },
            .Borrow() then false,
        };
    };

    emit_direct_call_0(self, function_name: String, return_type: Type): String = {
        if self.codegen.type_is_void_or_never(return_type) then {
            self.codegen.add_indent();
            self.codegen.buffer.push_string(function_name);
            self.codegen.buffer.push_string("();\n");
            return "";
        };
        return self.codegen.next_temp_with_call_0(
            self.codegen.c_type_name(return_type),
            function_name,
        );
    };

    emit_direct_call_1(
        self,
        function_name: String,
        arg: String,
        return_type: Type,
    ): String = {
        if self.codegen.type_is_void_or_never(return_type) then {
            self.codegen.add_indent();
            self.codegen.buffer.push_string(function_name);
            self.codegen.buffer.push_string("(");
            self.codegen.buffer.push_string(arg);
            self.codegen.buffer.push_string(");\n");
            return "";
        };
        return self.codegen.next_temp_with_call_1(
            self.codegen.c_type_name(return_type),
            function_name,
            arg,
        );
    };

    emit_direct_call_2(
        self,
        function_name: String,
        first_arg: String,
        second_arg: String,
        return_type: Type,
    ): String = {
        if self.codegen.type_is_void_or_never(return_type) then {
            self.codegen.add_indent();
            self.codegen.buffer.push_string(function_name);
            self.codegen.buffer.push_string("(");
            self.codegen.buffer.push_string(first_arg);
            self.codegen.buffer.push_string(", ");
            self.codegen.buffer.push_string(second_arg);
            self.codegen.buffer.push_string(");\n");
            return "";
        };
        return self.codegen.next_temp_with_call_2(
            self.codegen.c_type_name(return_type),
            function_name,
            first_arg,
            second_arg,
        );
    };

    emit_direct_call(
        self,
        function_name: String,
        arguments: List[String],
        return_type: Type,
    ): String = {
        if self.codegen.type_is_void_or_never(return_type) then {
            self.codegen.add_indent();
            self.codegen.buffer.push_string(function_name);
            self.codegen.buffer.push_string("(");
            self.codegen.push_joined_strings(arguments, ", ");
            self.codegen.buffer.push_string(");\n");
            return "";
        };
        return self.codegen.next_temp_with_call_args(
            self.codegen.c_type_name(return_type),
            function_name,
            arguments,
        );
    };

    emit_closure_call(
        self,
        closure_expr: String,
        callee_type: Type,
        arguments: List[String],
        return_type: Type,
    ): String = {
        let mutable param_types = List[String].new();
        when callee_type in {
            .FunctionType(params, _, _) then for param in params then {
                param_types.push(self.codegen.c_type_name(param.param_type));
            },
            .ForeignFunctionType(params, _) then for param in params then {
                param_types.push(self.codegen.c_type_name(param.param_type));
            },
            _ then {},
        };
        let no_capture_sig = if param_types.is_empty() then "void"
        else join_strings(param_types, ", ");
        let mutable with_capture_parts = List[String].new();
        with_capture_parts.push("void*");
        for p in param_types then {
            with_capture_parts.push(p);
        };
        let with_capture_sig = join_strings(with_capture_parts, ", ");
        let mutable return_c_type = self.codegen.c_type_name(return_type);
        let mutable args_with_env = List[String].new();
        args_with_env.push("\(closure_expr).env");
        for arg in arguments then {
            args_with_env.push(arg);
        };
        if self.codegen.type_is_void_or_never(return_type) then {
            self.codegen.add_indent();
            self.codegen.buffer.push_string("if (");
            self.codegen.buffer.push_string(closure_expr);
            self.codegen.buffer.push_string(".env == NULL) {\n");
            self.codegen.push_indent_level();
            self.codegen.add_indent();
            self.codegen.buffer.push_string("((");
            self.codegen.buffer.push_string(return_c_type);
            self.codegen.buffer.push_string(" (*)(");
            self.codegen.buffer.push_string(no_capture_sig);
            self.codegen.buffer.push_string("))(");
            self.codegen.buffer.push_string(closure_expr);
            self.codegen.buffer.push_string(".fn))(");
            self.codegen.push_joined_strings(arguments, ", ");
            self.codegen.buffer.push_string(");\n");
            self.codegen.pop_indent_level();
            self.codegen.add_indent();
            self.codegen.buffer.push_string("} else {\n");
            self.codegen.push_indent_level();
            self.codegen.add_indent();
            self.codegen.buffer.push_string("((");
            self.codegen.buffer.push_string(return_c_type);
            self.codegen.buffer.push_string(" (*)(");
            self.codegen.buffer.push_string(with_capture_sig);
            self.codegen.buffer.push_string("))(");
            self.codegen.buffer.push_string(closure_expr);
            self.codegen.buffer.push_string(".fn))(");
            self.codegen.push_joined_strings(args_with_env, ", ");
            self.codegen.buffer.push_string(");\n");
            self.codegen.pop_indent_level();
            self.codegen.add_indent();
            self.codegen.buffer.push_string("}\n");
            return "";
        };
        let result = self.codegen.next_temp_with_decl(return_c_type);
        self.codegen.add_indent();
        self.codegen.buffer.push_string("if (");
        self.codegen.buffer.push_string(closure_expr);
        self.codegen.buffer.push_string(".env == NULL) {\n");
        self.codegen.push_indent_level();
        self.codegen.add_indent();
        self.codegen.buffer.push_string(result);
        self.codegen.buffer.push_string(" = ((");
        self.codegen.buffer.push_string(return_c_type);
        self.codegen.buffer.push_string(" (*)(");
        self.codegen.buffer.push_string(no_capture_sig);
        self.codegen.buffer.push_string("))(");
        self.codegen.buffer.push_string(closure_expr);
        self.codegen.buffer.push_string(".fn))(");
        self.codegen.push_joined_strings(arguments, ", ");
        self.codegen.buffer.push_string(");\n");
        self.codegen.pop_indent_level();
        self.codegen.add_indent();
        self.codegen.buffer.push_string("} else {\n");
        self.codegen.push_indent_level();
        self.codegen.add_indent();
        self.codegen.buffer.push_string(result);
        self.codegen.buffer.push_string(" = ((");
        self.codegen.buffer.push_string(return_c_type);
        self.codegen.buffer.push_string(" (*)(");
        self.codegen.buffer.push_string(with_capture_sig);
        self.codegen.buffer.push_string("))(");
        self.codegen.buffer.push_string(closure_expr);
        self.codegen.buffer.push_string(".fn))(");
        self.codegen.push_joined_strings(args_with_env, ", ");
        self.codegen.buffer.push_string(");\n");
        self.codegen.pop_indent_level();
        self.codegen.add_indent();
        self.codegen.buffer.push_string("}\n");
        return result;
    };

    emit_aggregate(self, aggregate: MIRAggregate): MIRValueEmission = {
        let struct_fields_opt = when aggregate.aggregate_type in {
            .StructureType(def_id) then self.codegen.context.get_struct_fields(def_id),
            .GenericStruct(...) then when self.codegen.find_type_def_id_by_layout_or_template(
                aggregate.aggregate_type,
            ) in {
                .Some(def_id) then self.codegen.context.get_struct_fields(def_id),
                .None() then Option[List[StructField]].None(),
            },
            _ then Option[List[StructField]].None(),
        };
        when struct_fields_opt in {
            .Some(fields) then {
                if fields.count() == aggregate.fields.count() and self.codegen.uses_managed_nominal_representation(
                    aggregate.aggregate_type,
                ) then {
                    let expression = self.codegen.next_temp_with_decl(
                        self.codegen.c_type_name(aggregate.aggregate_type),
                    );
                    let payload_type = self.codegen.managed_payload_type_name(
                        aggregate.aggregate_type,
                    );
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        "\(expression).ptr = __koral_payload_of(malloc(sizeof(struct __koral_Control) + sizeof(struct \(payload_type))));\n",
                    );
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        "__koral_control_of(\(expression).ptr)->strong_count = 1;\n",
                    );
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        "__koral_control_of(\(expression).ptr)->weak_count = 1;\n",
                    );
                    if self.codegen.context.is_locked_type(aggregate.aggregate_type) then {
                        // 锁定类型的内建对象锁在构造路径初始化
                        // （concurrency-design.md §对象锁语义）。锁不持资源，
                        // 析构无需动作。
                        self.codegen.add_indent();
                        self.codegen.buffer.push_string(
                            "__koral_lock_init(&((struct \(payload_type)*)\(expression).ptr)->__lock);\n",
                        );
                    };
                    let payload_expr = "((struct \(payload_type)*)\(expression).ptr)";
                    for pair in aggregate.fields.lazy().zip[
                        StructField,
                        ListIterator[StructField],
                        List[StructField],
                    ](fields) then {
                        let value = pair.first;
                        let member = pair.second;
                        let emission = self.emit_value(value);
                        let field_name = self.codegen.sanitize_codegen_identifier(
                            member.name,
                        );
                        let assigned_expression = self.adapt_expression_for_target_type(
                            emission.expression,
                            self.type_of_value(value),
                            member.field_type,
                            false,
                            value is .Operand(.Function(_)),
                        );
                        self.codegen.append_copy_or_move_assignment(
                            member.field_type,
                            assigned_expression,
                            "\(payload_expr)->\(field_name)",
                            self.should_copy_borrowed_aggregate_field(value),
                        );
                        self.consume_moved_source(value);
                        self.emit_residual_cleanups(emission, true);
                    };
                    return MIRValueEmission(
                        expression,
                        self.cleanup_for_temporary_result(
                            expression,
                            aggregate.aggregate_type,
                        ),
                    );
                };
            },
            .None() then {},
        };
        let mutable fields = List[String].new();
        let mutable emissions = List[MIRValueEmission].new();
        for field in aggregate.fields then {
            self.consume_moved_source(field);
            let emission = self.emit_value(field);
            emissions.push(emission);
            fields.push(emission.expression);
        };
        let expression = self.codegen.next_temp_with_braced_values(
            self.codegen.c_type_name(aggregate.aggregate_type),
            fields,
        );
        for emission in emissions then {
            self.emit_residual_cleanups(emission, true);
        };
        return MIRValueEmission(
            expression,
            self.cleanup_for_temporary_result(expression, aggregate.aggregate_type),
        );
    };

    emit_enum_case(self, construction: MIREnumConstruction): MIRValueEmission = {
        if self.codegen.uses_managed_nominal_representation(construction.enum_type) then {
            let expression = self.codegen.next_temp_with_decl(
                self.codegen.c_type_name(construction.enum_type),
            );
            let payload_type = self.codegen.managed_payload_type_name(
                construction.enum_type,
            );
            let case_info = self.enum_case_info(
                construction.enum_type,
                construction.case_name,
            );
            // 无字段 case 的值没有任何可观察状态（枚举不能是 type mutable，
            // 弱引用够不着；判等是结构判等），可以给每个 (类型, case) 造一块
            // 静态 [Control | payload]，strong/weak = -1（immortal）——构造退化
            // 为取址，retain/release 全部早退，省掉每次构造的 malloc 与整条
            // ARC 流量。**门禁**：类型带用户 Drop 时每个值欠一次析构副作用，
            // 静态化会吞掉它，这种情况照旧 malloc（钉子：
            // empty_case_with_drop_runs_destructor）。
            if self.enum_case_is_fieldless(case_info.second)
                and not self.codegen.user_defined_drop_for_type_name(
                    self.codegen.user_defined_drop_type_key(construction.enum_type),
                ).is_some()
            then {
                // niche 布局下空 case 的载荷就是零值（空位模式恒为 NULL），
                // 因此初始化器**省略载荷**、靠聚合零填充 —— 不能写 { 0 }：
                // union 首成员可能是空 struct，`{ 0 }` 会报
                // “initializer for aggregate with no elements”。
                // tag 布局写 case 序号（首成员是 tag 标量，{ N } 合法）。
                let init_text = when self.codegen.enum_niche_layout_for_type(
                    construction.enum_type,
                ) in {
                    .Some(_) then "{ { -1, -1 } }",
                    .None() then "{ { -1, -1 }, { \(case_info.first.to_string()) } }",
                };
                let storage_var_name = "\(expression)_storage";
                self.codegen.add_indent();
                self.codegen.buffer.push_string(
                    "static const struct { struct __koral_Control ctrl; struct \(payload_type) payload; } \(storage_var_name) = \(init_text);\n",
                );
                self.codegen.add_indent();
                self.codegen.buffer.push_string(
                    "\(expression).ptr = (void*)&\(storage_var_name).payload;\n",
                );
                return MIRValueEmission(
                    expression,
                    self.cleanup_for_temporary_result(expression, construction.enum_type),
                );
            };
            self.codegen.add_indent();
            self.codegen.buffer.push_string(
                "\(expression).ptr = __koral_payload_of(malloc(sizeof(struct __koral_Control) + sizeof(struct \(payload_type))));\n",
            );
            self.codegen.add_indent();
            self.codegen.buffer.push_string(
                "__koral_control_of(\(expression).ptr)->strong_count = 1;\n",
            );
            self.codegen.add_indent();
            self.codegen.buffer.push_string(
                "__koral_control_of(\(expression).ptr)->weak_count = 1;\n",
            );
            let payload_expr = "((struct \(payload_type)*)\(expression).ptr)";
            when self.codegen.enum_niche_layout_for_type(construction.enum_type) in {
                .Some(layout) then {
                    if case_info.second.is_empty() then {
                        // niche 布局：空 case 没有自己的存储，必须把空位模式写进 payload case 的字段，
                        // 否则后面 niche 测试读到脏值会判成 payload case。
                        let field_path = "\(payload_expr)->data.\(self.codegen.sanitize_codegen_identifier(layout.payload_case_name)).\(self.codegen.sanitize_codegen_identifier(layout.payload_field_name))";
                        self.codegen.add_indent();
                        self.codegen.buffer.push_string(
                            self.codegen.niche_null_assignment(
                                layout.payload_field_type,
                                field_path,
                            ),
                        );
                    };
                },
                .None() then {
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        "\(payload_expr)->tag = \(case_info.first.to_string());\n",
                    );
                },
            };
            let member_base = "\(payload_expr)->data.\(self.codegen.sanitize_codegen_identifier(construction.case_name))";
            let mutable argument_index: UInt = 0;
            for field in case_info.second then {
                if not self.codegen.type_is_void(field.param_type) then {
                    let arg_value = construction.arguments[argument_index];
                    let emission = self.emit_value(arg_value);
                    let field_dest = "\(member_base).\(self.codegen.sanitize_codegen_identifier(field.name))";
                    let assigned_expression = self.adapt_expression_for_target_type(
                        emission.expression,
                        self.type_of_value(arg_value),
                        field.param_type,
                        false,
                        arg_value is .Operand(.Function(_)),
                    );
                    self.codegen.append_copy_or_move_assignment(
                        field.param_type,
                        assigned_expression,
                        field_dest,
                        self.should_copy_borrowed_aggregate_field(arg_value),
                    );
                    self.consume_moved_source(arg_value);
                    self.emit_residual_cleanups(emission, true);
                    argument_index += 1;
                };
            };
            return MIRValueEmission(
                expression,
                self.cleanup_for_temporary_result(expression, construction.enum_type),
            );
        };
        let expression = self.codegen.next_temp_with_decl(
            self.codegen.c_type_name(construction.enum_type),
        );
        let case_info = self.enum_case_info(
            construction.enum_type,
            construction.case_name,
        );
        when self.codegen.enum_niche_layout_for_type(construction.enum_type) in {
            .Some(layout) then {
                if case_info.second.is_empty() then {
                    // niche 布局：空 case 没有自己的存储，必须把空位模式写进 payload case 的字段，
                    // 否则后面 niche 测试读到脏值会判成 payload case。
                    let field_path = "\(expression).data.\(self.codegen.sanitize_codegen_identifier(layout.payload_case_name)).\(self.codegen.sanitize_codegen_identifier(layout.payload_field_name))";
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        self.codegen.niche_null_assignment(
                            layout.payload_field_type,
                            field_path,
                        ),
                    );
                };
            },
            .None() then {
                self.codegen.add_indent();
                self.codegen.buffer.push_string(expression);
                self.codegen.buffer.push_string(".tag = ");
                self.codegen.buffer.push_string(case_info.first.to_string());
                self.codegen.buffer.push_string(";\n");
            },
        };
        let mutable argument_index: UInt = 0;
        for field in case_info.second then {
            if not self.codegen.type_is_void(field.param_type) then {
                let arg_value = construction.arguments[argument_index];
                let emission = self.emit_value(arg_value);
                let field_dest = "\(expression).data.\(self.codegen.sanitize_codegen_identifier(construction.case_name)).\(self.codegen.sanitize_codegen_identifier(field.name))";
                let assigned_expression = self.adapt_expression_for_target_type(
                    emission.expression,
                    self.type_of_value(arg_value),
                    field.param_type,
                    false,
                    arg_value is .Operand(.Function(_)),
                );
                self.codegen.append_copy_or_move_assignment(
                    field.param_type,
                    assigned_expression,
                    field_dest,
                    self.should_copy_borrowed_aggregate_field(arg_value),
                );
                self.consume_moved_source(arg_value);
                self.emit_residual_cleanups(emission, true);
                argument_index += 1;
            };
        };
        return MIRValueEmission(
            expression,
            self.cleanup_for_temporary_result(expression, construction.enum_type),
        );
    };

    emit_enum_tag(self, tag: MIREnumTag): MIRValueEmission = {
        let subject = self.emit_value_source(tag.subject);
        let niche = self.codegen.enum_niche_layout_for_type(tag.enum_type);
        let mutable base_expr = subject.expression;
        let mutable member_op = ".";
        if self.codegen.uses_managed_nominal_representation(tag.enum_type) then {
            let payload_type = self.codegen.managed_payload_type_name(tag.enum_type);
            base_expr = "((struct \(payload_type)*)\(subject.expression).ptr)";
            member_op = "->";
        } else {
            when self.type_of_value(tag.subject) in {
                .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner)
                or .MutableBorrowedReferenceType(inner) or .WeakReferenceType(inner)
                or .MutableWeakReferenceType(inner) then {
                    base_expr = "(*(\(self.codegen.c_type_name(inner))*)\(subject.expression).ptr)";
                },
                _ then {},
            };
        };
        let tag_expr = when niche in {
            .Some(layout) then {
                let value_expr = "\(base_expr)\(member_op)data.\(self.codegen.sanitize_codegen_identifier(layout.payload_case_name)).\(self.codegen.sanitize_codegen_identifier(layout.payload_field_name))";
                self.codegen.niche_tag_expression(layout, value_expr)
            },
            .None() then "\(base_expr)\(member_op)tag",
        };
        let expression = self.codegen.next_temp_with_init(
            self.codegen.c_type_name(Type.IntType()),
            tag_expr,
        );
        self.emit_cleanup(subject.cleanup);
        return MIRValueEmission(expression, Option[MIRValueCleanup].None());
    };

    emit_trait_object_conversion(
        self,
        conversion: MIRTraitObjectConversion,
    ): MIRValueEmission = {
        let inner = self.emit_value_source(conversion.inner);
        let mutable inner_type = self.type_of_value(conversion.inner);
        let should_retain = conversion.source_ownership is .Copy() or is .Borrow();
        // If inner is a scalar type mutable (not a ref), we need to heap-allocate it first
        let is_ref_type = when inner_type in {
            .ReferenceType(_) or .MutableReferenceType(_) or .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) or .WeakReferenceType(_) or .MutableWeakReferenceType(_) or .TraitObject(...) then true,
            _ then false,
        };
        let mutable ref_expression = inner.expression;
        if not is_ref_type then {
            // Merged layout: allocate control block + payload in one malloc
            let mutable pointee_c_type = self.codegen.c_type_name(inner_type);
            let ref_temp = self.codegen.next_temp_with_decl("struct __koral_Ref");
            self.codegen.add_indent();
            self.codegen.buffer.push_string(
                "\(ref_temp).ptr = __koral_payload_of(malloc(sizeof(struct __koral_Control) + sizeof(\(pointee_c_type))));\n",
            );
            self.codegen.add_indent();
            self.codegen.buffer.push_string(
                "__koral_control_of(\(ref_temp).ptr)->strong_count = 1;\n",
            );
            self.codegen.add_indent();
            self.codegen.buffer.push_string(
                "__koral_control_of(\(ref_temp).ptr)->weak_count = 1;\n",
            );
            let dest_expr = "*(" + pointee_c_type + "*)" + ref_temp + ".ptr";
            self.codegen.append_copy_or_move_assignment(
                inner_type,
                inner.expression,
                dest_expr,
                false,
            );
            ref_expression = ref_temp;
        };
        let expression = self.codegen.generate_trait_object_conversion_from_ref_value(
            ref_expression,
            conversion.trait_name,
            conversion.trait_def_id,
            self.codegen.mir_type_args_to_ref_list(conversion.trait_type_args),
            conversion.concrete_type,
            should_retain,
        );
        if conversion.source_ownership is .Move() then {
            self.consume_moved_source(conversion.inner);
        };
        self.emit_residual_cleanups(inner, conversion.source_ownership is .Move());
        return MIRValueEmission(
            expression,
            self.cleanup_for_temporary_result(expression, conversion.result_type),
        );
    };

    trait_object_target_name(self, t: Type): Option[String] = {
        return when t in {
            // Display only: the spelling is read from the declaration.
            .TraitObject(trait_def_id, _, _) then Option[String].Some(
                def_id_spelling(trait_def_id),
            ),
            .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner) then self.trait_object_target_name(inner),
            .MutableBorrowedReferenceType(inner) then self.trait_object_target_name(
                inner,
            ),
            _ then Option[String].None(),
        };
    };

    trait_object_target_def_id(self, t: Type): Option[DefId] = {
        return when t in {
            .TraitObject(trait_def_id, _, _) then Option[DefId].Some(trait_def_id),
            .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner) then self.trait_object_target_def_id(inner),
            .MutableBorrowedReferenceType(inner) then self.trait_object_target_def_id(
                inner,
            ),
            _ then Option[DefId].None(),
        };
    };

    trait_object_target_type_args(self, t: Type): List[Type] = {
        return when t in {
            .TraitObject(_, args, _) then args,
            .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner) then self.trait_object_target_type_args(inner),
            .MutableBorrowedReferenceType(inner) then self.trait_object_target_type_args(
                inner,
            ),
            _ then List[Type].new(),
        };
    };

    trait_object_source_concrete_type(self, t: Type): Option[Type] = {
        let _ = self;
        return when t in {
            .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner)
            or .MutableBorrowedReferenceType(inner) then if inner is .TraitObject(...) then Option[Type].None(
            ) else Option[Type].Some(inner),
            // In the simplified type system, concrete types can be directly
            // assigned to trait object fields without going through references.
            .StructureType(_) then Option[Type].Some(t),
            .EnumType(_) or .GenericStruct(...) or .GenericEnum(...) then Option[Type].Some(t),
            _ then Option[Type].None(),
        };
    };

    adapt_expression_for_target_type(
        self,
        expression: String,
        source_type: Type,
        target_type: Type,
        retain_source: Bool,
        bare_function_source: Bool,
    ): String = {
        // Wrap bare function pointers in closure structs when target is FunctionType
        if target_type is .FunctionType(...) and source_type is .FunctionType(...) then {
            if bare_function_source then {
                return "(struct __koral_Closure){ .fn = (void*)\(expression), .env = NULL, .drop = NULL }";
            };
            return expression;
        };
        let target_trait_def_id = self.trait_object_target_def_id(target_type) or else def_id_invalid(
        );
        return when self.trait_object_target_name(target_type) in {
            .Some(trait_name) then when self.trait_object_source_concrete_type(
                source_type,
            ) in {
                .Some(concrete_type) then {
                    // If the source is not a reference-like type, we need to wrap it
                    // in a __koral_Ref first (allocate control + payload).
                    let is_ref = when source_type in {
                        .ReferenceType(_) or .MutableReferenceType(_) or .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) or .TraitObject(...) then true,
                        _ then false,
                    };
                    if is_ref then {
                        self.codegen.generate_trait_object_conversion_from_ref_value(
                            expression,
                            trait_name,
                            target_trait_def_id,
                            self.trait_object_target_type_args(target_type),
                            concrete_type,
                            retain_source,
                        )
                    } else {
                        // Non-managed or managed nominal: wrap in __koral_Ref
                        let ref_temp = self.codegen.next_temp_with_decl(
                            "struct __koral_Ref",
                        );
                        let c_type = self.codegen.c_type_name(source_type);
                        self.codegen.add_indent();
                        self.codegen.buffer.push_string(
                            "\(ref_temp).ptr = __koral_payload_of(malloc(sizeof(struct __koral_Control) + sizeof(\(c_type))));\n",
                        );
                        self.codegen.add_indent();
                        self.codegen.buffer.push_string(
                            "__koral_control_of(\(ref_temp).ptr)->strong_count = 1;\n",
                        );
                        self.codegen.add_indent();
                        self.codegen.buffer.push_string(
                            "__koral_control_of(\(ref_temp).ptr)->weak_count = 1;\n",
                        );
                        self.codegen.add_indent();
                        self.codegen.buffer.push_string(
                            "*(\(c_type)*)\(ref_temp).ptr = \(expression);\n",
                        );
                        self.codegen.generate_trait_object_conversion_from_ref_value(
                            ref_temp,
                            trait_name,
                            target_trait_def_id,
                            self.trait_object_target_type_args(target_type),
                            concrete_type,
                            false,
                        )
                    }
                },
                .None() then expression,
            },
            .None() then expression,
        };
    };

    emit_trait_method_call(self, call: MIRTraitMethodCall): MIRValueEmission = {
        let receiver = self.emit_value_source(call.receiver);
        let mutable arg_values = List[String].new();
        let mutable arg_types = List[Type].new();
        for pair in call.arguments.lazy().enumerate() then {
            let idx = pair.first;
            let emission = self.emit_value_source(pair.second);
            arg_values.push(emission.expression);
            arg_types.push(self.type_of_value(pair.second));
            if call.argument_ownerships[idx] is .Move() then {
                self.consume_moved_source(pair.second);
            };
            self.emit_residual_cleanups(
                emission,
                call.argument_ownerships[idx] is .Move(),
            );
        };
        let expression = self.emit_trait_method_call_abi(
            receiver.expression,
            call.receiver_ownership,
            self.type_of_value(call.receiver),
            call.trait_name,
            call.trait_def_id,
            self.type_list_to_ref_list(call.trait_type_args),
            call.method_name,
            call.method_index,
            arg_values,
            arg_types,
            call.result_type,
        );
        if call.receiver_ownership is .Move() then {
            self.consume_moved_source(call.receiver);
        };
        self.emit_residual_cleanups(receiver, call.receiver_ownership is .Move());
        return MIRValueEmission(
            expression,
            self.cleanup_for_temporary_result(expression, call.result_type),
        );
    };

    emit_trait_method_call_abi(
        self,
        receiver_result: String,
        receiver_ownership: MIROwnershipUse,
        receiver_type: Type,
        trait_name: String,
        trait_def_id: DefId,
        trait_type_args: List[Type],
        method_name: String,
        method_index: Int,
        arg_values: List[String],
        arg_types: List[Type],
        result_type: Type,
    ): String = {
        let members = self.codegen.get_ordered_trait_members_for_vtable(
            trait_name,
            trait_def_id,
            self.codegen.trait_object_type_from_name(trait_name),
            trait_type_args,
        );
        let mutable dispatch_method_name = method_name;
        let mutable signature_return_type = result_type;
        let mutable signature_param_types = List[Type].new();
        if method_index >= 0 and UInt(method_index) < members.count() then {
            let member = members[UInt(method_index)];
            dispatch_method_name = member.name;
            signature_return_type = member.return_type or else signature_return_type;
            for p in member.parameters then {
                signature_param_types.push(p.param_type or else Type.Unknown());
            };
        } else {
            for member in members then {
                if member.name == method_name then {
                    dispatch_method_name = member.name;
                    signature_return_type = member.return_type or else signature_return_type;
                    for p in member.parameters then {
                        signature_param_types.push(p.param_type or else Type.Unknown());
                    };
                    break;
                };
            };
        };

        let mutable effective_return_type = when result_type in {
            .Unknown() then signature_return_type,
            _ then result_type,
        };
        let mutable method_param_types = List[String].new();
        method_param_types.push("struct __koral_Ref");
        for pair in arg_values.lazy().enumerate() then {
            let arg_index = pair.first;
            let mutable expected_type = if arg_index + 1 < signature_param_types.count() then signature_param_types[
                arg_index + 1
            ] else arg_types[arg_index];
            method_param_types.push(self.codegen.c_type_name(expected_type));
        };
        let ref_var = self.codegen.next_temp_with_init(
            "struct __koral_Ref",
            "(struct __koral_Ref){ .ptr = \(receiver_result).ptr }",
        );
        if receiver_ownership is .Copy() or is .Borrow() then {
            self.codegen.add_indent();
            self.codegen.buffer.push_string(self.codegen.rc_retain_fn(receiver_type));
            self.codegen.buffer.push_string("(");
            self.codegen.buffer.push_string(ref_var);
            self.codegen.buffer.push_string(".ptr);\n");
        };
        let mutable call_args = List[String].new();
        call_args.push(ref_var);
        for arg in arg_values then {
            call_args.push(arg);
        };
        let sanitized_method = self.codegen.sanitize_codegen_identifier(
            dispatch_method_name,
        );
        let mutable return_c_type = self.codegen.c_type_name(effective_return_type);
        let method_param_types_text = join_strings(method_param_types, ", ");
        let mutable method_field_type = "\(return_c_type) (*\(sanitized_method))(\(method_param_types_text) )";
        let vtable_struct = self.vtable_prefix_struct_type_for_mir_method(
            members,
            dispatch_method_name,
            method_field_type,
        );
        let vt_call_target = "((\(vtable_struct)*)\(receiver_result).vtable)->\(sanitized_method)";
        if self.codegen.type_is_void_or_never(effective_return_type) then {
            self.codegen.add_indent();
            self.codegen.buffer.push_string(vt_call_target);
            self.codegen.buffer.push_string("(");
            self.codegen.push_joined_strings(call_args, ", ");
            self.codegen.buffer.push_string(");\n");
            return "";
        };
        return self.codegen.next_temp_with_call_args(
            return_c_type,
            vt_call_target,
            call_args,
        );
    };

    vtable_prefix_struct_type_for_mir_method(
        self,
        members: List[MIRTraitVTableMethod],
        method_name: String,
        method_field_type: String,
    ): String = {
        let mutable code = StringBuilder.new();
        // 与 `generate_vtable_struct_definition` 发的头字段名保持一致：这个内联
        // 结构体是照着真 vtable 的布局捏的，字段名必须逐个对齐才能按偏移取到方法。
        code.push_string("struct { struct __koral_VTableHeader _Base; ");
        if members.is_empty() then {
            code.push_string(method_field_type);
            code.push_string("; ");
            code.push_string("}");
            return code.to_string();
        };
        for member in members then {
            let field_name = self.codegen.sanitize_codegen_identifier(member.name);
            if member.name == method_name then {
                code.push_string(method_field_type);
                code.push_string("; ");
                break;
            };
            code.push_string("void (*");
            code.push_string(field_name);
            code.push_string(")(); ");
        };
        code.push_string("}");
        return code.to_string();
    };

    // Wrap a raw value expression in a stack-borrow __koral_Ref.
    // Used when a function expects a borrowed reference but the MIR passes a raw value.
    unwrap_reference_like_argument_if_needed(
        self,
        emission: MIRValueEmission,
        arg_type: Type,
        expected_type: Type,
    ): MIRValueEmission = {
        if not is_borrowed_reference_like_type(arg_type) or is_borrowed_reference_like_type(
            expected_type,
        ) then {
            return emission;
        };

        let mutable expected_c_type = self.codegen.c_type_name(expected_type);
        let expression = when expected_type in {
            .StructureType(def_id) or .EnumType(def_id) then "__koral_\(self.codegen.c_name_for_def_id(def_id))_copy((\(expected_c_type)*)\(emission.expression).ptr)",
            _ then "*(\(expected_c_type)*)\(emission.expression).ptr",
        };
        return MIRValueEmission(expression, emission.cleanup);
    };

    wrap_value_as_stack_borrow(
        self,
        value_expr: String,
        value_type: Type,
        ref_type: Type,
    ): MIRValueEmission = {
        let result = self.codegen.next_temp_with_decl(
            self.codegen.c_type_name(ref_type),
        );
        // Create a temporary to hold the value so we can take its address.
        let value_temp = self.codegen.next_temp_with_decl(
            self.codegen.c_type_name(value_type),
        );
        self.codegen.add_indent();
        self.codegen.buffer.push_string(value_temp);
        self.codegen.buffer.push_string(" = ");
        self.codegen.buffer.push_string(value_expr);
        self.codegen.buffer.push_string(";\n");
        self.codegen.add_indent();
        self.codegen.buffer.push_string(result);
        self.codegen.buffer.push_string(".ptr = &");
        self.codegen.buffer.push_string(value_temp);
        self.codegen.buffer.push_string(";\n");
        return MIRValueEmission(result, Option[MIRValueCleanup].None());
    };

    emit_reference(
        self,
        place: MIRPlace,
        kind: MIRReferenceKind,
        allocation: MIRReferenceAllocation,
    ): MIRValueEmission = {
        let mutable result_type = self.type_of_ref(place, kind);
        return when allocation in {
            .HeapOwned() or .HeapOwnedMove() then self.emit_heap_reference(place, result_type, allocation),
            .StackBorrow() then self.emit_borrowed_reference(place, result_type),
        };
    };

    emit_borrowed_reference(self, place: MIRPlace, result_type: Type): MIRValueEmission = {
        let access = self.emit_place_access(place);
        let result = self.codegen.next_temp_with_decl(
            self.codegen.c_type_name(result_type),
        );
        self.codegen.add_indent();
        self.codegen.buffer.push_string(result);
        self.codegen.buffer.push_string(".ptr = &");
        self.codegen.buffer.push_string(access.path);
        self.codegen.buffer.push_string(";\n");
        self.emit_cleanup(access.cleanup);
        return MIRValueEmission(result, Option[MIRValueCleanup].None());
    };

    emit_heap_reference(
        self,
        place: MIRPlace,
        result_type: Type,
        allocation: MIRReferenceAllocation,
    ): MIRValueEmission = {
        let access = self.emit_place_access(place);
        let mutable pointee_type = self.type_of_place(place);
        let mutable pointee_c_type = self.codegen.c_type_name(pointee_type);
        let result = self.codegen.next_temp_with_decl(
            self.codegen.c_type_name(result_type),
        );
        // Ownership transfer is an explicit signal from lowering (Swift: `allocation == .heapOwnedMove`),
        // not an inference about the source place. A move bit-copies the pointee and consumes the
        // source so it is not dropped again; a copy retains via the type's copy helper.
        let should_transfer = allocation is .HeapOwnedMove();
        // Merged layout: allocate control block + payload in one malloc
        self.codegen.add_indent();
        self.codegen.buffer.push_string(
            "\(result).ptr = __koral_payload_of(malloc(sizeof(struct __koral_Control) + sizeof(\(pointee_c_type))));\n",
        );
        self.codegen.add_indent();
        self.codegen.buffer.push_string(
            "__koral_control_of(\(result).ptr)->strong_count = 1;\n",
        );
        self.codegen.add_indent();
        self.codegen.buffer.push_string(
            "__koral_control_of(\(result).ptr)->weak_count = 1;\n",
        );
        self.codegen.append_copy_or_move_assignment(
            pointee_type,
            access.path,
            "*(\(pointee_c_type)*)\(result).ptr",
            not should_transfer,
        );
        if should_transfer then {
            self.consume_moved_place(place);
        };
        self.emit_cleanup(access.cleanup);
        return MIRValueEmission(
            result,
            self.cleanup_for_temporary_result(result, result_type),
        );
    };

    emit_pointer(self, place: MIRPlace): MIRValueEmission = {
        let access = self.emit_place_access(place);
        let mutable pointer_type = self.type_of_pointer(place);
        let expression = self.codegen.next_temp_with_init(
            self.codegen.c_type_name(pointer_type),
            "&\(access.path)",
        );
        self.emit_cleanup(access.cleanup);
        return MIRValueEmission(
            expression,
            self.cleanup_for_temporary_result(expression, pointer_type),
        );
    };

    is_float_cast_source_type(self, t: Type): Bool = {
        let _ = self;
        return when t in {
            .Float32Type() or .Float64Type() then true,
            _ then false,
        };
    };

    is_int_cast_source_type(self, t: Type): Bool = {
        // The signed/unsigned predicates below already name the integer types;
        // this is their union, asked from the source side of a cast.
        return self.is_signed_int_cast_target_type(t) or self.is_unsigned_int_cast_target_type(
            t,
        );
    };

    /// A width-changing numeric conversion is checked and does not wrap; a
    /// same-width one reinterprets the bit pattern and never panics. The width
    /// test is left to the C compiler (`sizeof` is a constant expression), so
    /// the guards disappear entirely for same-width pairs and the rule holds on
    /// every target regardless of how wide `Int` is there.
    ///
    /// Two guards are needed inside the width-changing case, because the round
    /// trip alone is blind across signedness: `(int)(unsigned)(-1) == -1`, so a
    /// value the target cannot hold can come back unchanged. Same-signedness
    /// widening needs neither guard to fire, and the C compiler folds the round
    /// trip away there.
    emit_numeric_conversion_guard(
        self,
        source_value: String,
        converted: String,
        source_type: Type,
        target_type: Type,
        bounds: Option[Pair[String, String]],
        loc_literal: String,
    ): Void = {
        let source_c_type = self.codegen.c_type_name(source_type);
        let target_c_type = self.codegen.c_type_name(target_type);
        if source_c_type == target_c_type then {
            // The whole guard sits behind `sizeof(a) != sizeof(b)`: with one
            // C type the condition is compile-time false and every check
            // inside is dead. Skip the emission (same behavior, less noise
            // for the C compiler).
            return;
        };
        self.codegen.add_indent();
        self.codegen.buffer.push_string(
            "if (sizeof(\(source_c_type)) != sizeof(\(target_c_type))) {\n",
        );
        self.codegen.add_indent();
        self.codegen.buffer.push_string(
            "if (((\(source_c_type))\(converted)) != (\(source_c_type))\(source_value)) {\n",
        );
        self.codegen.add_indent();
        self.codegen.buffer.push_string(
            "    __koral_panic_numeric_conversion_overflow(\(loc_literal));\n",
        );
        self.codegen.add_indent();
        self.codegen.buffer.push_string("}\n");
        if self.is_signed_int_cast_target_type(source_type) and self.is_unsigned_int_cast_target_type(
            target_type,
        ) then {
            self.codegen.add_indent();
            self.codegen.buffer.push_string("if (\(source_value) < 0) {\n");
            self.codegen.add_indent();
            self.codegen.buffer.push_string(
                "    __koral_panic_numeric_conversion_overflow(\(loc_literal));\n",
            );
            self.codegen.add_indent();
            self.codegen.buffer.push_string("}\n");
        };
        if self.is_unsigned_int_cast_target_type(source_type) and self.is_signed_int_cast_target_type(
            target_type,
        ) then {
            when bounds in {
                .Some(b) then {
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        "if ((unsigned long long)\(source_value) > (unsigned long long)\(b.second)) {\n",
                    );
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        "    __koral_panic_numeric_conversion_overflow(\(loc_literal));\n",
                    );
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string("}\n");
                },
                .None() then {},
            };
        };
        self.codegen.add_indent();
        self.codegen.buffer.push_string("}\n");
    };

    is_signed_int_cast_target_type(self, t: Type): Bool = {
        let _ = self;
        return when t in {
            .Int8Type() or .Int16Type() or .Int32Type() or .Int64Type() or .IntType() or .WrappingInt8Type()
            or .WrappingInt16Type() or .WrappingInt32Type() or .WrappingInt64Type() or .WrappingIntType() then true,
            _ then false,
        };
    };

    is_unsigned_int_cast_target_type(self, t: Type): Bool = {
        let _ = self;
        return when t in {
            .UInt8Type() or .UInt16Type() or .UInt32Type() or .UInt64Type() or .UIntType()
            or .WrappingUInt8Type() or .WrappingUInt16Type() or .WrappingUInt32Type() or .WrappingUInt64Type()
            or .WrappingUIntType() then true,
            _ then false,
        };
    };

    float_cast_target_bounds(self, t: Type): Option[Pair[String, String]] = {
        let _ = self;
        return when t in {
            .Int8Type() or .WrappingInt8Type() then Option[Pair[String, String]].Some(
                Pair[String, String]("INT8_MIN", "INT8_MAX"),
            ),
            .Int16Type() or .WrappingInt16Type() then Option[Pair[String, String]].Some(
                Pair[String, String]("INT16_MIN", "INT16_MAX"),
            ),
            .Int32Type() or .WrappingInt32Type() then Option[Pair[String, String]].Some(
                Pair[String, String]("INT32_MIN", "INT32_MAX"),
            ),
            .Int64Type() or .WrappingInt64Type() then Option[Pair[String, String]].Some(
                Pair[String, String]("INT64_MIN", "INT64_MAX"),
            ),
            .IntType() or .WrappingIntType() then Option[Pair[String, String]].Some(
                Pair[String, String]("INTPTR_MIN", "INTPTR_MAX"),
            ),
            .UInt8Type() or .WrappingUInt8Type() then Option[Pair[String, String]].Some(
                Pair[String, String]("0", "UINT8_MAX"),
            ),
            .UInt16Type() or .WrappingUInt16Type() then Option[Pair[String, String]].Some(
                Pair[String, String]("0", "UINT16_MAX"),
            ),
            .UInt32Type() or .WrappingUInt32Type() then Option[Pair[String, String]].Some(
                Pair[String, String]("0", "UINT32_MAX"),
            ),
            .UInt64Type() or .WrappingUInt64Type() then Option[Pair[String, String]].Some(
                Pair[String, String]("0", "UINT64_MAX"),
            ),
            .UIntType() or .WrappingUIntType() then Option[Pair[String, String]].Some(
                Pair[String, String]("0", "UINTPTR_MAX"),
            ),
            _ then Option[Pair[String, String]].None(),
        };
    };

    /// The wrapping-family cast targets: `WrappingInt` .. `WrappingUInt64`.
    is_wrapping_int_cast_target_type(self, t: Type): Bool = {
        let _ = self;
        return when t in {
            .WrappingIntType() or .WrappingInt8Type() or .WrappingInt16Type() or .WrappingInt32Type()
            or .WrappingInt64Type() or .WrappingUIntType() or .WrappingUInt8Type() or .WrappingUInt16Type()
            or .WrappingUInt32Type() or .WrappingUInt64Type() then true,
            _ then false,
        };
    };

    emit_cast_operand(self, operand: MIROperand, target_type: Type, span: SourceSpan): MIRValueEmission = {
        let loc_literal = self.codegen.panic_loc_literal(span);
        let source = self.emit_operand_value(operand);
        let mutable source_type = self.type_of_operand(operand);
        let mutable target_c_type = self.codegen.c_type_name(target_type);
        // The TARGET decides the conversion policy (numeric-families design):
        // a wrapping-family target truncates to the target width's low bits and
        // never panics; a plain-family target is checked. A same-width pair is
        // a lossless retype either way.
        let expression = if self.is_wrapping_int_cast_target_type(target_type) then {
            if self.is_float_cast_source_type(source_type) then {
                // Float -> Wrapping is two steps. Domain first: NaN and +-inf
                // have no truncatable integer value and panic regardless of
                // family. Then the truncated-toward-zero value takes the target
                // width's low bits.
                self.codegen.next_temp_with_init(
                    target_c_type,
                    "(\(target_c_type))__koral_wrapping_bits_from_f64((double)\(source.expression), (unsigned)(sizeof(\(target_c_type)) * 8), \(loc_literal))",
                )
            } else {
                // Integer -> Wrapping is a pure C cast: narrowing takes the low
                // bits, widening sign/zero-extends. It never panics.
                self.codegen.next_temp_with_init(
                    target_c_type,
                    "(\(target_c_type))\(source.expression)",
                )
            }
        } else if self.is_float_cast_source_type(source_type) and (self.is_signed_int_cast_target_type(
            target_type,
        ) or self.is_unsigned_int_cast_target_type(target_type)) then when self.float_cast_target_bounds(
            target_type,
        ) in {
            .Some(bounds) then {
                let float_value = self.codegen.next_temp_with_init(
                    "double",
                    "(double)\(source.expression)",
                );
                self.codegen.add_indent();
                self.codegen.buffer.push_string(
                    "if (!(\(float_value) >= (double)\(bounds.first) && \(float_value) <= (double)\(bounds.second))) {\n",
                );
                self.codegen.add_indent();
                self.codegen.buffer.push_string(
                    "    __koral_panic_numeric_conversion_overflow(\(loc_literal));\n",
                );
                self.codegen.add_indent();
                self.codegen.buffer.push_string("}\n");
                self.codegen.next_temp_with_init(
                    target_c_type,
                    "(\(target_c_type))\(float_value)",
                )
            },
            .None() then self.codegen.next_temp_with_init(
                target_c_type,
                "(\(target_c_type))\(source.expression)",
            ),
        }
        else if self.is_int_cast_source_type(source_type) and (self.is_signed_int_cast_target_type(
            target_type,
        ) or self.is_unsigned_int_cast_target_type(target_type)) then {
            let source_c_type = self.codegen.c_type_name(source_type);
            let source_value = self.codegen.next_temp_with_init(
                source_c_type,
                source.expression,
            );
            let converted = self.codegen.next_temp_with_init(
                target_c_type,
                "(\(target_c_type))\(source_value)",
            );
            self.emit_numeric_conversion_guard(
                source_value,
                converted,
                source_type,
                target_type,
                self.float_cast_target_bounds(target_type),
                loc_literal,
            );
            converted
        } else self.codegen.next_temp_with_init(
            target_c_type,
            "(\(target_c_type))\(source.expression)",
        );
        self.emit_cleanup(source.cleanup);
        return MIRValueEmission(
            expression,
            self.cleanup_for_temporary_result(expression, target_type),
        );
    };

    emit_intrinsic(self, node: MIRIntrinsic): MIRValueEmission = {
        return when node in {
            .AllocMemory(count, result_type) then {
                self.saw_alloc_memory = true;
                let count_emission = self.emit_value_source(count);
                let mutable element_type = self.pointer_element_type(result_type);
                let expression = self.codegen.next_temp_with_decl(
                    self.codegen.c_type_name(result_type),
                );
                self.codegen.add_indent();
                self.codegen.buffer.push_string(expression);
                self.codegen.buffer.push_string(" = malloc(");
                self.codegen.buffer.push_string(count_emission.expression);
                self.codegen.buffer.push_string(" * sizeof(");
                self.codegen.buffer.push_string(self.codegen.c_type_name(element_type));
                self.codegen.buffer.push_string("));\n");
                self.emit_cleanup(count_emission.cleanup);
                MIRValueEmission(expression, Option[MIRValueCleanup].None())
            },
            .AllocString(len, result_type) then {
                self.saw_alloc_memory = true;
                let len_emission = self.emit_value_source(len);
                let expression = self.codegen.next_temp_with_decl(
                    self.codegen.c_type_name(result_type),
                );
                self.codegen.add_indent();
                self.codegen.buffer.push_string(expression);
                self.codegen.buffer.push_string(".ptr = __koral_string_alloc(");
                self.codegen.buffer.push_string(len_emission.expression);
                self.codegen.buffer.push_string(");\n");
                self.emit_cleanup(len_emission.cleanup);
                MIRValueEmission(expression, Option[MIRValueCleanup].None())
            },
            .DeallocMemory(pointer) then {
                let p = self.emit_value_source(pointer);
                self.codegen.add_indent();
                self.codegen.buffer.push_string("free(");
                self.codegen.buffer.push_string(p.expression);
                self.codegen.buffer.push_string(");\n");
                self.emit_cleanup(p.cleanup);
                MIRValueEmission("", Option[MIRValueCleanup].None())
            },
            .CopyMemory(dest, source, count) then self.emit_memory_transfer(
                "memcpy",
                dest,
                source,
                count,
            ),
            .MoveMemory(dest, source, count) then self.emit_memory_transfer(
                "memmove",
                dest,
                source,
                count,
            ),
            .CompareMemory(a, b, count) then self.emit_memory_compare(a, b, count),
            .DowngradeRef(value, result_type) then self.emit_downgrade_ref(
                value,
                result_type,
            ),
            .UpgradeRef(value, result_type) then self.emit_upgrade_ref(
                value,
                result_type,
            ),
            .TraitObjectMatches(value, trait_name, trait_def_id, trait_type_args, concrete_type) then {
                let emission = self.emit_value_source(value);
                let concrete_c_name = self.codegen.concrete_type_c_name_fallback(
                    concrete_type,
                ) or else self.codegen.sanitize_codegen_identifier(
                    self.codegen.c_type_name(concrete_type),
                );
                let vtable_name = self.codegen.vtable_instance_name(
                    trait_name,
                    trait_def_id,
                    concrete_c_name,
                );
                let expression = self.codegen.next_temp_with_init(
                    self.codegen.c_type_name(Type.BoolType()),
                    "(\(emission.expression).vtable == &\(vtable_name))",
                );
                let _ = trait_type_args;
                self.emit_cleanup(emission.cleanup);
                MIRValueEmission(expression, Option[MIRValueCleanup].None())
            },
            .TraitObjectDowncast(value, result_type) then {
                let emission = self.emit_value_source(value);
                let expression = self.codegen.next_temp_with_decl(
                    self.codegen.c_type_name(result_type),
                );
                if self.codegen.uses_managed_nominal_representation(result_type) then {
                    // A managed nominal is stored in the trait object's payload as
                    // its C value -- the thin handle -- so the payload address is
                    // NOT the handle. Load the handle out of the payload, the same
                    // read `generate_wrapper_function` makes, then take a reference
                    // to the payload the handle points at. Aliasing the payload
                    // address as the handle reads the handle's own bytes as if they
                    // were the object's payload.
                    let managed_c_type = self.codegen.c_type_name(result_type);
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        "\(expression) = *(\(managed_c_type)*)\(emission.expression).ptr;\n",
                    );
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        "\(self.codegen.rc_retain_fn(result_type))(\(expression).ptr);\n",
                    );
                } else {
                    let concrete_c_type = self.codegen.c_type_name(result_type);
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        "\(expression) = *(\(concrete_c_type)*)\(emission.expression).ptr;\n",
                    );
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        "\(self.codegen.rc_retain_fn(result_type))((\(emission.expression)).ptr);\n",
                    );
                    self.codegen.add_indent();
                    self.codegen.append_release_handle_statement(
                        self.type_of_value(value),
                        emission.expression,
                    );
                };
                self.emit_cleanup(emission.cleanup);
                MIRValueEmission(
                    expression,
                    self.cleanup_for_temporary_result(expression, result_type),
                )
            },
            .InitMemory(pointer, value) then {
                let p = self.emit_value_source(pointer);
                let v = self.emit_value_source(value);
                let mutable element_type = self.pointer_element_type(
                    self.type_of_value(pointer),
                );
                // init_memory 的 value 源自 emit_value_source（place 的原位
                // 表达式，不做所有权物化），store 的 copy/move 必须与所有权
                // 去向严格一致：
                //   move —— consume_moved_source 真会接管所有权（.Operand(.Local)、
                //     .Move() place 读、HeapOwnedMove 引用），或发射物是自有
                //     临时（cleanup 指向表达式本身，残余清理跳过它 = 所有权随
                //     临时物转移）；
                //   copy —— 其余（Borrow/Copy/Take place 读、cast 等）：源仍
                //     持有自己的引用并在作用域末尾 drop，store 必须 retain。
                // 旧代码固定 copy + consume：消费型源多 retain 一次永不释放
                //（每次 Dict/List 插入漏一个句柄）；反过来按 place 家族一刀切
                // 又会把「源仍持有」的形态搬成 move —— 双重释放。
                // 自有临时（cleanup 指向表达式本身）两种去向都不 drop 它：
                // move 时所有权随 store 转移进槽，copy 时它只是别名载体。
                let is_owned_temp = when v.cleanup in {
                    .Some(cleanup) then cleanup.name == v.expression,
                    .None() then false,
                };
                let transferred = self.source_is_consumed(value) or is_owned_temp;
                let dest = "*(\(self.codegen.c_type_name(element_type))*)\(p.expression)";
                if transferred then {
                    self.codegen.append_copy_or_move_assignment(
                        element_type,
                        v.expression,
                        dest,
                        false,
                    );
                } else {
                    self.codegen.append_copy_assignment(
                        element_type,
                        v.expression,
                        dest,
                    );
                };
                self.consume_moved_source(value);
                self.emit_cleanup(p.cleanup);
                self.emit_residual_cleanups(v, true);
                MIRValueEmission("", Option[MIRValueCleanup].None())
            },
            .DeinitMemory(pointer) then {
                let p = self.emit_value_source(pointer);
                let mutable element_type = self.pointer_element_type(
                    self.type_of_value(pointer),
                );
                self.codegen.add_indent();
                self.codegen.append_drop_statement(
                    element_type,
                    "*(\(self.codegen.c_type_name(element_type))*)\(p.expression)",
                );
                self.emit_cleanup(p.cleanup);
                MIRValueEmission("", Option[MIRValueCleanup].None())
            },
            .TakeMemory(pointer, result_type) then {
                let p = self.emit_value_source(pointer);
                let expression = self.codegen.next_temp_with_init(
                    self.codegen.c_type_name(result_type),
                    "*(\(self.codegen.c_type_name(result_type))*)\(p.expression)",
                );
                self.emit_cleanup(p.cleanup);
                MIRValueEmission(
                    expression,
                    self.cleanup_for_temporary_result(expression, result_type),
                )
            },
            .NullPtr(result_type) then {
                let expression = self.codegen.next_temp_with_init(
                    self.codegen.c_type_name(result_type),
                    "NULL",
                );
                MIRValueEmission(expression, Option[MIRValueCleanup].None())
            },
            .FixedArrayLiteral(result_type, elements) then {
                let c_type = self.codegen.c_type_name(result_type);
                if elements.is_empty() then {
                    // The `{0}` idiom zeroes the whole wrapper.
                    let expression = self.codegen.next_temp_with_init(
                        c_type,
                        "(\(c_type)){0}",
                    );
                    MIRValueEmission(expression, Option[MIRValueCleanup].None())
                } else {
                    let mutable init_text = StringBuilder.new();
                    init_text.push_string("(\(c_type)){ .data = { ");
                    let mutable first = true;
                    for element in elements then {
                        let emission = self.emit_value(element);
                        if not first then {
                            init_text.push_string(", ");
                        };
                        init_text.push_string(emission.expression);
                        self.emit_cleanup(emission.cleanup);
                        first = false;
                    };
                    init_text.push_string(" } }");
                    let expression = self.codegen.next_temp_with_init(
                        c_type,
                        init_text.to_string(),
                    );
                    MIRValueEmission(expression, Option[MIRValueCleanup].None())
                }
            },
            .SpawnThread(out_handle, out_tid, closure, stack_size) then self.emit_spawn_thread(
                out_handle,
                out_tid,
                closure,
                stack_size,
            ),
        };
    };

    emit_lambda(self, lambda: MIRLambda): MIRValueEmission = {
        // Resolve capture sources to C expression paths
        let mutable capture_source_overrides = Dict[UInt, String].new();
        let mutable capture_source_cleanups = List[MIRValueCleanup].new();
        for pair in lambda.captures.lazy().enumerate() then {
            let capture = pair.second;
            let source = lambda.capture_sources[pair.first];
            let capture_emission = when capture.symbol_type in {
                .ReferenceType(inner_ref) then if self.type_of_place(source) == inner_ref then self.emit_heap_reference(
                    source,
                    capture.symbol_type,
                    MIRReferenceAllocation.HeapOwned(),
                )
                else {
                    let access = self.emit_place_access(source);
                    MIRValueEmission(access.path, access.cleanup)
                },
                .MutableReferenceType(inner_ref) then if self.type_of_place(source) == inner_ref then self.emit_borrowed_reference(
                    source,
                    capture.symbol_type,
                )
                else {
                    let access = self.emit_place_access(source);
                    MIRValueEmission(access.path, access.cleanup)
                },
                _ then {
                    let access = self.emit_place_access(source);
                    MIRValueEmission(access.path, access.cleanup)
                },
            };
            capture_source_overrides.insert(
                capture.def_id.id,
                capture_emission.expression,
            );
            when capture_emission.cleanup in {
                .Some(cleanup) then capture_source_cleanups.push(cleanup),
                .None() then {},
            };
        };
        let closure = self.generate_lambda_expression(lambda, capture_source_overrides);
        // Clean up capture source cleanups
        for cleanup_ref in capture_source_cleanups then {
            self.emit_cleanup(Option[MIRValueCleanup].Some(cleanup_ref));
        };
        return MIRValueEmission(
            closure,
            self.cleanup_for_temporary_result(closure, lambda.lambda_type),
        );
    };

    generate_lambda_expression(
        self,
        lambda: MIRLambda,
        capture_source_overrides: Dict[UInt, String],
    ): String = {
        let lambda_name = self.next_lambda_name();
        // Extract function parameters and return type from lambda_type
        let (function_params, return_type) = when lambda.lambda_type in {
            .FunctionType(params, ret, _) or .ForeignFunctionType(params, ret) then Pair(params, ret),
            _ then Pair(List[FunctionParamEntry].new(), Type.VoidType()),
        };

        if lambda.captures.is_empty() then {
            // No captures: generate a plain C function
            self.generate_no_capture_lambda_function(
                lambda_name,
                lambda.params,
                function_params,
                return_type,
                lambda.function,
            );
            return self.codegen.next_temp_with_init(
                "struct __koral_Closure",
                "{ .fn = (void*)\(lambda_name), .env = NULL, .drop = NULL }",
            );
        };

        // With captures: generate env struct, capture function, heap-allocate env
        let env_struct_name = "\(lambda_name)_env";
        self.generate_lambda_env_struct(env_struct_name, lambda.captures);
        self.generate_capture_lambda_function(
            lambda_name,
            env_struct_name,
            lambda.params,
            function_params,
            return_type,
            lambda.captures,
            capture_source_overrides,
            lambda.function,
        );

        // Heap-allocate env and populate captures
        let env_var = self.codegen.next_temp_with_init(
            "struct \(env_struct_name)*",
            "(struct \(env_struct_name)*)malloc(sizeof(struct \(env_struct_name)))",
        );
        self.codegen.add_indent();
        self.codegen.buffer.push_string(env_var);
        self.codegen.buffer.push_string("->__refcount = 1;\n");

        let mutable ci: UInt = 0;
        for capture in lambda.captures then {
            let field_name = self.capture_field_name(capture);
            let source = capture_source_overrides.get(capture.def_id.id) or else "";
            let dest = "\(env_var)->\(field_name)";
            when capture.symbol_type in {
                .ReferenceType(inner_ref) or .MutableReferenceType(inner_ref) then {
                    let _ = inner_ref;
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(dest);
                    self.codegen.buffer.push_string(" = ");
                    self.codegen.buffer.push_string(source);
                    self.codegen.buffer.push_string(";\n");
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        if self.codegen.uses_nonatomic_rc(capture.symbol_type) then "__koral_retain_value_nonatomic(("
                        else "__koral_retain_value((",
                    );
                    self.codegen.buffer.push_string(dest);
                    self.codegen.buffer.push_string(").ptr);\n");
                },
                _ then self.codegen.append_copy_or_move_assignment(
                    capture.symbol_type,
                    source,
                    dest,
                    true,
                ),
            };
        };

        return self.codegen.next_temp_with_init(
            "struct __koral_Closure",
            "{ .fn = (void*)\(lambda_name), .env = \(env_var), .drop = __koral_\(env_struct_name)_drop }",
        );
    };

    generate_no_capture_lambda_function(
        self,
        name: String,
        params: List[Symbol],
        function_params: List[FunctionParamEntry],
        return_type: Type,
        mir_function: MIRFunction,
    ): Void = {
        let plan = build_mir_function_emit_plan(self.codegen, mir_function);
        let mutable parameter_local_names = List[String].new();
        for local in mir_function.locals then {
            if local.storage is .Parameter() and parameter_local_names.count() < params.count(
            ) then {
                let fallback_param = params[parameter_local_names.count()];
                let fallback_name = if parameter_local_names.count() < plan.local_names.count(
                ) then plan.local_names[parameter_local_names.count()]
                else self.codegen.c_identifier_for_symbol(fallback_param);
                parameter_local_names.push(
                    plan.local_names_by_id.get(local.id.raw_value) or else fallback_name,
                );
            };
        };
        // Build parameter list
        let mutable param_parts = List[String].new();
        for pair in params.lazy().enumerate() then {
            let pi = pair.first;
            let param = pair.second;
            let mutable c_type = if pi < function_params.count() then self.codegen.c_type_name(
                function_params[pi].param_type,
            ) else self.codegen.c_type_name(param.symbol_type);
            let param_name = if pi < parameter_local_names.count() then parameter_local_names[
                pi
            ] else self.codegen.c_identifier_for_symbol(param);
            param_parts.push("\(c_type) \(param_name)");
        };
        let param_str = if param_parts.is_empty() then "void"
        else join_strings(param_parts, ", ");
        let mutable return_c_type = self.codegen.c_type_name(return_type);

        let saved_indent = self.codegen.indent;
        self.codegen.indent = StringBuilder.new();
        self.codegen.indent.push_string(" ");
        let mutable body_emitter = MIRFunctionCodeEmitter.new(
            self.codegen,
            mir_function,
            plan,
        );
        let saved_buffer = self.codegen.buffer;
        let mutable body_buffer = CodegenBuffer.new();
        self.codegen.buffer = body_buffer;
        let inner_nested = (body_emitter).emit_body_and_get_nested_definitions();
        let body_text = self.codegen.buffer.into_string();
        self.codegen.buffer = saved_buffer;
        self.codegen.indent = saved_indent;

        let header_prefix = if body_emitter.saw_alloc_memory then "static KORAL_NOINLINE "
        else "static ";
        self.nested_definitions.push_string(inner_nested);
        self.nested_definitions.push_string(
            "\(header_prefix)\(return_c_type) \(name)(\(param_str)) {\n",
        );
        self.nested_definitions.push_string(body_text);
        self.nested_definitions.push_string("}\n");
    };

    generate_capture_lambda_function(
        self,
        name: String,
        env_struct_name: String,
        params: List[Symbol],
        function_params: List[FunctionParamEntry],
        return_type: Type,
        captures: List[Symbol],
        capture_source_overrides: Dict[UInt, String],
        mir_function: MIRFunction,
    ): Void = {
        let plan = build_mir_function_emit_plan(self.codegen, mir_function);
        let mutable parameter_local_names = List[String].new();
        for local in mir_function.locals then {
            if local.storage is .Parameter() and parameter_local_names.count() < params.count(
            ) then {
                let fallback_param = params[parameter_local_names.count()];
                let fallback_name = if parameter_local_names.count() < plan.local_names.count(
                ) then plan.local_names[parameter_local_names.count()]
                else self.codegen.c_identifier_for_symbol(fallback_param);
                parameter_local_names.push(
                    plan.local_names_by_id.get(local.id.raw_value) or else fallback_name,
                );
            };
        };
        // Build parameter list with void* __env first
        let mutable param_parts = List[String].new();
        param_parts.push("void* __env");
        for pair in params.lazy().enumerate() then {
            let pi = pair.first;
            let param = pair.second;
            let mutable c_type = if pi < function_params.count() then self.codegen.c_type_name(
                function_params[pi].param_type,
            ) else self.codegen.c_type_name(param.symbol_type);
            let param_name = if pi < parameter_local_names.count() then parameter_local_names[
                pi
            ] else self.codegen.c_identifier_for_symbol(param);
            param_parts.push("\(c_type) \(param_name)");
        };
        let param_str = join_strings(param_parts, ", ");
        let mutable return_c_type = self.codegen.c_type_name(return_type);

        let saved_indent = self.codegen.indent;
        self.codegen.indent = StringBuilder.new();
        self.codegen.indent.push_string(" ");
        let mutable body_emitter = MIRFunctionCodeEmitter.new(
            self.codegen,
            mir_function,
            plan,
        );
        let saved_buffer = self.codegen.buffer;
        let mutable body_buffer = CodegenBuffer.new();
        self.codegen.buffer = body_buffer;
        // Override local names for captured variables
        for capture in captures then {
            let capture_name = "__captured->\(self.capture_field_name(capture))";
            for local in mir_function.locals then {
                when local.symbol in {
                    .Some(symbol) then {
                        if symbol.def_id.id == capture.def_id.id and local.storage is .Capture() then {
                            body_emitter.local_names_by_id.insert(
                                local.id.raw_value,
                                capture_name,
                            );
                        };
                    },
                    .None() then {},
                };
            };
        };
        let inner_nested = (body_emitter).emit_body_and_get_nested_definitions();
        let body_text = self.codegen.buffer.into_string();
        self.codegen.buffer = saved_buffer;
        self.codegen.indent = saved_indent;

        let header_prefix = if body_emitter.saw_alloc_memory then "static KORAL_NOINLINE "
        else "static ";
        self.nested_definitions.push_string(inner_nested);
        self.nested_definitions.push_string(
            "\(header_prefix)\(return_c_type) \(name)(\(param_str)) {\n",
        );
        self.nested_definitions.push_string(
            "    struct \(env_struct_name)* __captured = (struct \(env_struct_name)*)__env;\n",
        );
        self.nested_definitions.push_string(body_text);
        self.nested_definitions.push_string("}\n");
    };

    generate_lambda_env_struct(
        self,
        env_struct_name: String,
        captures: List[Symbol],
    ): Void = {
        // Generate env struct definition
        self.nested_definitions.push_string("struct \(env_struct_name) {\n");
        self.nested_definitions.push_string("    _Atomic intptr_t __refcount;\n");
        for capture in captures then {
            let field_name = self.capture_field_name(capture);
            let mutable c_type = self.codegen.c_type_name(capture.symbol_type);
            self.nested_definitions.push_string("    \(c_type) \(field_name);\n");
        };
        self.nested_definitions.push_string("};\n");

        // Generate drop function
        self.nested_definitions.push_string(
            "static void __koral_\(env_struct_name)_drop(void* raw_env) {\n",
        );
        self.nested_definitions.push_string(
            "    struct \(env_struct_name)* env = (struct \(env_struct_name)*)raw_env;\n",
        );
        for capture in captures then {
            let field_name = self.capture_field_name(capture);
            if self.codegen.needs_drop(capture.symbol_type) then {
                let saved_buffer = self.codegen.buffer;
                self.codegen.buffer = CodegenBuffer.new();
                self.codegen.add_indent();
                self.codegen.append_drop_statement(
                    capture.symbol_type,
                    "env->\(field_name)",
                );
                self.nested_definitions.push_string(self.codegen.buffer.into_string());
                self.codegen.buffer = saved_buffer;
            };
        };
        self.nested_definitions.push_string("    free(raw_env);\n");
        self.nested_definitions.push_string("}\n");
    };

    emit_place_access(self, place: MIRPlace): MIRPlaceAccess = {
        return when place in {
            .Local(local) then {
                let name = self.local_name(local);
                MIRPlaceAccess(name, Option[MIRValueCleanup].None())
            },
            .Global(def_id) then {
                // Koral globals go through their accessor so the initializer
                // is guaranteed to have run; foreign globals are bare externs
                // (no initializer of ours to run).
                let name = when self.codegen.context.get_symbol(def_id) in {
                    .Some(symbol) then self.codegen.c_identifier_for_symbol_value(
                        symbol,
                    ),
                    .None() then self.codegen.c_identifier_opt(def_id) or else self.codegen.sanitize_codegen_identifier(
                        self.context_name(def_id),
                    ),
                };
                if self.codegen.is_foreign_global_var_def_id(def_id) then {
                    MIRPlaceAccess(name, Option[MIRValueCleanup].None())
                } else {
                    MIRPlaceAccess(
                        "(*__koral_gptr_\(name)())",
                        Option[MIRValueCleanup].None(),
                    )
                }
            },
            .Field(base, field) then {
                let base_access = self.emit_place_access(base);
                let field_name = self.codegen.sanitize_codegen_identifier(
                    self.codegen.context.symbol_name(field),
                );
                let base_type = self.type_of_place(base);
                let mutable path = "";
                if self.codegen.uses_managed_nominal_representation(base_type) then {
                    let payload_type = self.codegen.managed_payload_type_name(base_type);
                    path = "((struct \(payload_type)*)\(base_access.path).ptr)->\(field_name)";
                } else when base_type in {
                    .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner)
                    or .MutableBorrowedReferenceType(inner) or .WeakReferenceType(inner)
                    or .MutableWeakReferenceType(inner) then {
                        path = "(*(\(self.codegen.c_type_name(inner))*)\(base_access.path).ptr).\(field_name)";
                    },
                    .PointerType(pointee) or .MutablePointerType(pointee) then {
                        if self.codegen.uses_managed_nominal_representation(pointee) then {
                            let payload_type = self.codegen.managed_payload_type_name(
                                pointee,
                            );
                            path = "((struct \(payload_type)*)\(base_access.path)->ptr)->\(field_name)";
                        } else {
                            path = "\(base_access.path)->\(field_name)";
                        };
                    },
                    _ then {
                        path = "\(base_access.path).\(field_name)";
                    },
                };
                MIRPlaceAccess(path, base_access.cleanup)
            },
            .EnumPayload(base, case_name, field_name, _, _) then {
                let base_access = self.emit_place_access(base);
                let base_type = self.type_of_place(base);
                let mutable path = "\(base_access.path).data.\(self.codegen.sanitize_codegen_identifier(case_name)).\(self.codegen.sanitize_codegen_identifier(field_name))";
                if self.codegen.uses_managed_nominal_representation(base_type) then {
                    let payload_type = self.codegen.managed_payload_type_name(base_type);
                    path = "((struct \(payload_type)*)\(base_access.path).ptr)->data.\(self.codegen.sanitize_codegen_identifier(case_name)).\(self.codegen.sanitize_codegen_identifier(field_name))";
                };
                MIRPlaceAccess(path, base_access.cleanup)
            },
            .Deref(base, pointee) then {
                let base_emission = self.emit_value_source(base);
                let mutable base_type = self.type_of_value(base);
                when base_type in {
                    .ReferenceType(_) or .MutableReferenceType(_) or .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) then {
                        // A reference to a TRAIT OBJECT is the fat handle
                        // itself (`struct __koral_TraitRef` in both shapes), so
                        // dereferencing one is the identity -- there is no
                        // pointee behind `.ptr` to load. This must be the
                        // arm's VALUE: an earlier form computed the identity
                        // access as a discarded `when` and then always emitted
                        // the payload load, reading the receiver's data pointer
                        // as a TraitRef.
                        when self.trait_object_target_name(pointee) in {
                            .Some(_) then MIRPlaceAccess(
                                base_emission.expression,
                                base_emission.cleanup,
                            ),
                            .None() then {
                                let mutable path = StringBuilder.new();
                                path.push_string("(*(");
                                path.push_string(
                                    self.codegen.c_type_name(pointee),
                                );
                                path.push_string("*)");
                                path.push_string(base_emission.expression);
                                path.push_string(".ptr)");
                                MIRPlaceAccess(
                                    path.to_string(),
                                    base_emission.cleanup,
                                )
                            },
                        }
                    },
                    _ then {
                        let mutable path = StringBuilder.new();
                        path.push_string("(*(");
                        path.push_string(self.codegen.c_type_name(pointee));
                        path.push_string("*)");
                        path.push_string(base_emission.expression);
                        path.push_string(")");
                        MIRPlaceAccess(path.to_string(), base_emission.cleanup)
                    },
                }
            },
            .PointerElement(base, element) then {
                let base_emission = self.emit_value_source(base);
                let mutable path = StringBuilder.new();
                path.push_string("(*(");
                path.push_string(self.codegen.c_type_name(element));
                path.push_string("*)");
                path.push_string(base_emission.expression);
                path.push_string(")");
                MIRPlaceAccess(path.to_string(), base_emission.cleanup)
            },
        };
    };

    type_of_place(self, place: MIRPlace): Type = {
        return when place in {
            .Local(local) then when self.local_info(local) in {
                .Some(info) then info.local_type,
                .None() then Type.Unknown(),
            },
            .Global(def_id) then self.codegen.context.get_symbol_type(def_id) or else Type.Unknown(
            ),
            .Field(_, field) then field.symbol_type,
            .EnumPayload(_, _, _, _, field_type) then field_type,
            .Deref(_, pointee) then pointee,
            .PointerElement(_, element) then element,
        };
    };

    type_of_value(self, value: MIRValue): Type = {
        return when value in {
            .Operand(operand) then self.type_of_operand(operand),
            .PlaceRead(place, _) then self.type_of_place(place),
            .Binary(operation) then operation.result_type,
            .Unary(operation) then operation.result_type,
            .Call(call) then call.result_type,
            .Aggregate(aggregate) then aggregate.aggregate_type,
            .EnumCase(construction) then construction.enum_type,
            .EnumTag(_) then Type.IntType(),
            .TraitObjectConversion(conversion) then conversion.result_type,
            .TraitMethodCall(call) then call.result_type,
            .Ref(place, kind, _) then self.type_of_ref(place, kind),
            .Pointer(place) then self.type_of_pointer(place),
            .Cast(_, target_type, _) then target_type,
            .Intrinsic(node) then self.type_of_intrinsic(node),
            .Lambda(lambda) then lambda.lambda_type,
        };
    };

    type_of_operand(self, operand: MIROperand): Type = {
        return when operand in {
            .Local(local) then when self.local_info(local) in {
                .Some(info) then info.local_type,
                .None() then Type.Unknown(),
            },
            .Function(symbol) then symbol.symbol_type,
            .Constant(constant) then when constant in {
                .Integer(_, t) or .Float(_, t) or .StringLiteral(_, t) then t,
                .Boolean(_) then Type.BoolType(),
                .Void() then Type.VoidType(),
            },
        };
    };

    type_of_ref(self, place: MIRPlace, kind: MIRReferenceKind): Type = {
        let inner = self.type_of_place(place);
        return when kind in {
            .Mutable() then Type.MutableReferenceType(inner),
            .Weak() then Type.WeakReferenceType(inner),
            .MutableWeak() then Type.MutableWeakReferenceType(inner),
            .Shared() then Type.ReferenceType(inner),
        };
    };

    type_of_pointer(self, place: MIRPlace): Type =
        Type.PointerType(self.type_of_place(place));

    type_of_intrinsic(self, node: MIRIntrinsic): Type = {
        return when node in {
            .AllocMemory(_, result_type) or .AllocString(_, result_type)
            or .DowngradeRef(_, result_type) or .UpgradeRef(_, result_type) then result_type,
            .CompareMemory(_, _, _) then Type.IntType(),
            .TraitObjectMatches(_, _, _, _, _) then Type.BoolType(),
            .TraitObjectDowncast(_, result_type) or .TakeMemory(_, result_type) or .NullPtr(result_type) then result_type,
            .FixedArrayLiteral(result_type, _) then result_type,
            .SpawnThread(_, _, _, _) then Type.Int32Type(),
            _ then Type.VoidType(),
        };
    };

    local_target_id(self, place: MIRPlace): Option[MIRLocalID] = when place in {
        .Local(local) then Option[MIRLocalID].Some(local),
        _ then Option[MIRLocalID].None(),
    };
    local_id_from_operand(self, operand: MIROperand): Option[MIRLocalID] = when operand in {
        .Local(local) then Option[MIRLocalID].Some(local),
        _ then Option[MIRLocalID].None(),
    };

    computed_local_name(self, local: MIRLocal): String = {
        return when local.storage in {
            .Parameter() or .Capture() then when local.symbol in {
                .Some(symbol) then self.codegen.c_identifier_for_symbol(symbol),
                .None() then self.codegen.sanitize_codegen_identifier(local.name),
            },
            _ then "__mir_\(self.codegen.sanitize_codegen_identifier(local.name))_\(local.id.raw_value)",
        };
    };

    local_name(self, local: MIRLocalID): String = {
        return when self.local_names_by_id.get(local.raw_value) in {
            .Some(name) then name,
            .None() then when self.local_info(local) in {
                .Some(info) then self.computed_local_name(info),
                .None() then if local.raw_value < self.local_names.count() then self.local_names[
                    local.raw_value
                ] else "__mir_local_\(local.raw_value)",
            },
        };
    };
    block_label(self, block: MIRBlockID): String = "__mir_bb_\(block.raw_value)";

    is_parameter_operand(self, operand: MIROperand): Bool = {
        return when operand in {
            .Local(local) then when self.local_info(local) in {
                .Some(info) then info.storage is .Parameter(),
                .None() then false,
            },
            _ then false,
        };
    };

    root_local_of_place(self, place: MIRPlace): Option[MIRLocalID] = {
        return when place in {
            .Local(local) then Option[MIRLocalID].Some(local),
            .Field(base, _) or .EnumPayload(base, _, _, _, _) then self.root_local_of_place(base),
            _ then Option[MIRLocalID].None(),
        };
    };

    consume_moved_place(self, place: MIRPlace): Void = {
        when self.root_local_of_place(place) in {
            .Some(local) then {
                self.set_init_flag(local, false);
                self.consumed_locals.insert(local.raw_value, true);
            },
            .None() then {},
        };
    };

    consume_moved_source(self, value: MIRValue): Void = {
        when value in {
            .Operand(.Local(local)) then self.set_init_flag(local, false),
            .PlaceRead(place, ownership) then {
                if ownership is .Move() then {
                    self.consume_moved_place(place);
                };
            },
            .Cast(operand, target_type, _) then {
                let source_type = self.type_of_value(MIRValue.Operand(operand));
                if self.is_ownership_preserving_cast(source_type, target_type) then {
                    self.consume_moved_source(MIRValue.Operand(operand));
                };
            },
            .Ref(place, _, allocation) then {
                if allocation is .HeapOwnedMove() then {
                    self.consume_moved_place(place);
                };
            },
            _ then {},
        };
    };

    /// init_memory 的 store 应该转移还是保留所有权，判据与
    /// consume_moved_source 同构：consume 真会压掉一次 drop 的形态 → 转移
    ///（move store，不 retain）；其余形态源仍持有自己的引用 → 保留
    ///（copy store，retain 一份）。判据是「consume 真能接管」：目标局部
    /// 持有 init flag（Capture/非持有局部清 flag 是空操作，只是别名）。
    source_is_consumed(self, value: MIRValue): Bool = {
        return when value in {
            .Operand(.Local(local)) then self.init_flag(local) is .Some(_),
            .PlaceRead(place, ownership) then ownership is .Move()
                and self.place_is_consumable(place),
            .Cast(operand, target_type, _) then self.cast_source_is_consumed(
                operand,
                target_type,
            ),
            .Ref(place, _, allocation) then allocation is .HeapOwnedMove()
                and self.place_is_consumable(place),
            _ then false,
        };
    };

    cast_source_is_consumed(self, operand: MIROperand, target_type: Type): Bool = {
        let source_type = self.type_of_value(MIRValue.Operand(operand));
        if not self.is_ownership_preserving_cast(source_type, target_type) then {
            return false;
        };
        return self.source_is_consumed(MIRValue.Operand(operand));
    };

    should_copy_borrowed_aggregate_field(self, value: MIRValue): Bool = {
        return when value in {
            .PlaceRead(_, ownership) then ownership is .Borrow(),
            _ then false,
        };
    };

    /// A case is field-less when none of its parameters occupy storage
    /// (Void parameters are erased from the payload union).
    enum_case_is_fieldless(self, params: List[EnumCaseParam]): Bool = {
        for field in params then {
            if not self.codegen.type_is_void(field.param_type) then {
                return false;
            };
        };
        return true;
    };

    is_ownership_preserving_cast(self, source_type: Type, target_type: Type): Bool = {
        return when source_type in {
            .ReferenceType(_) or .MutableReferenceType(_) then target_type is .ReferenceType(_) or is .MutableReferenceType(_),
            .WeakReferenceType(_) or .MutableWeakReferenceType(_) then target_type is .WeakReferenceType(_) or is .MutableWeakReferenceType(_),
            .MutablePointerType(_) then target_type is .PointerType(_) or is .MutablePointerType(_),
            _ then source_type == target_type,
        };
    };

    next_lambda_name(self): String = {
        let name = "__koral_lambda_\(self.function.identifier.def_id.id)_\(self.lambda_counter)";
        self.lambda_counter += 1;
        return name;
    };

    capture_field_name(self, symbol: Symbol): String = {
        return self.codegen.c_identifier_for_symbol_value(symbol);
    };

    should_copy_returned_operand(self, operand: MIROperand, operand_type: Type): Bool = {
        if not self.codegen.needs_drop(operand_type) then {
            return false;
        };
        return when operand in {
            .Local(local) then when self.local_info(local) in {
                .Some(info) then if info.storage is .Capture() then true
                else self.non_owning_local_ids.get(local.raw_value) is .Some(_),
                .None() then false,
            },
            _ then false,
        };
    };

    set_init_flag(self, local: MIRLocalID, value: Bool): Void = {
        when self.init_flag(local) in {
            .Some(flag) then {
                self.codegen.add_indent();
                self.codegen.buffer.push_string(flag);
                self.codegen.buffer.push_string(" = ");
                self.codegen.buffer.push_string(if value then "1" else "0");
                self.codegen.buffer.push_string(";\n");
            },
            .None() then {},
        };
    };

    cleanup_for_temporary_result(
        self,
        expression: String,
        cleanup_type: Type,
    ): Option[MIRValueCleanup] = {
        if not expression.is_empty() and self.codegen.needs_drop(cleanup_type) then {
            return Option[MIRValueCleanup].Some(
                MIRValueCleanup(expression, cleanup_type),
            );
        };
        return Option[MIRValueCleanup].None();
    };

    emit_cleanup(self, cleanup: Option[MIRValueCleanup]): Void = {
        when cleanup in {
            .Some(item) then {
                self.codegen.add_indent();
                self.codegen.append_drop_statement(item.cleanup_type, item.name);
            },
            .None() then {},
        };
    };

    emit_residual_cleanups(self, emission: MIRValueEmission, consumed: Bool): Void = {
        when emission.cleanup in {
            .Some(cleanup) then {
                if consumed and cleanup.name == emission.expression then {
                    return;
                };
                self.codegen.add_indent();
                self.codegen.append_drop_statement(cleanup.cleanup_type, cleanup.name);
            },
            .None() then {},
        };
    };

    context_name(self, def_id: DefId): String = self.codegen.context.get_name(def_id) or else "global_\(def_id.id)";

    switch_case_expression(self, constant: MIRConstant): String =
        self.constant_expression(constant);

    enum_case_info(
        self,
        enum_type: Type,
        case_name: String,
    ): Pair[UInt, List[EnumCaseParam]] = {
        let def_id = when enum_type in {
            .EnumType(id) then id,
            .GenericEnum(...) then self.codegen.find_type_def_id_by_layout_or_template(
                enum_type,
            ) or else DefId(UInt(0)),
            _ then DefId(UInt(0)),
        };
        when self.codegen.context.get_enum_cases(def_id) in {
            .Some(cases) then {
                let mutable index: UInt = 0;
                for c in cases then {
                    if c.name == case_name then {
                        return Pair[UInt, List[EnumCaseParam]](index, c.params);
                    };
                    index += 1;
                };
            },
            .None() then {},
        };
        return Pair[UInt, List[EnumCaseParam]](UInt(0), List[EnumCaseParam].new());
    };

    type_list_to_ref_list(self, args: List[Type]): List[Type] = {
        let _ = self;
        let mutable out = List[Type].new();
        for arg in args then {
            out.push(arg);
        };
        return out;
    };

    pointer_element_type(self, pointer_type: Type): Type = when pointer_type in {
        .PointerType(inner) or .MutablePointerType(inner) then inner,
        _ then Type.VoidType(),
    };

    emit_memory_transfer(
        self,
        function_name: String,
        dest: MIRValue,
        source: MIRValue,
        count: MIRValue,
    ): MIRValueEmission = {
        let d = self.emit_value_source(dest);
        let s = self.emit_value_source(source);
        let c = self.emit_value_source(count);
        let mutable element_type = self.pointer_element_type(self.type_of_value(dest));
        self.codegen.add_indent();
        self.codegen.buffer.push_string(function_name);
        self.codegen.buffer.push_string("(");
        self.codegen.buffer.push_string(d.expression);
        self.codegen.buffer.push_string(", ");
        self.codegen.buffer.push_string(s.expression);
        self.codegen.buffer.push_string(", ");
        self.codegen.buffer.push_string(c.expression);
        self.codegen.buffer.push_string(" * sizeof(");
        self.codegen.buffer.push_string(self.codegen.c_type_name(element_type));
        self.codegen.buffer.push_string("));\n");
        self.emit_cleanup(d.cleanup);
        self.emit_cleanup(s.cleanup);
        self.emit_cleanup(c.cleanup);
        return MIRValueEmission("", Option[MIRValueCleanup].None());
    };

    /// `compare_memory` 的发射：批量无符号字节比较。`__koral_memcmp` 是
    /// koral_runtime 的 libc memcmp 垫片（直接声明 memcmp 会与 libc 原型在
    /// 同一翻译单元里冲突）；count 按元素计数，乘元素宽度折成字节数。
    emit_memory_compare(
        self,
        a: MIRValue,
        b: MIRValue,
        count: MIRValue,
    ): MIRValueEmission = {
        let pa = self.emit_value_source(a);
        let pb = self.emit_value_source(b);
        let c = self.emit_value_source(count);
        let mutable element_type = self.pointer_element_type(self.type_of_value(a));
        let result = self.codegen.next_temp_with_decl(
            self.codegen.c_type_name(Type.IntType()),
        );
        self.codegen.add_indent();
        self.codegen.buffer.push_string(result);
        self.codegen.buffer.push_string(" = (intptr_t)__koral_memcmp((uint8_t*)(");
        self.codegen.buffer.push_string(pa.expression);
        self.codegen.buffer.push_string("), (uint8_t*)(");
        self.codegen.buffer.push_string(pb.expression);
        self.codegen.buffer.push_string("), (uintptr_t)(");
        self.codegen.buffer.push_string(c.expression);
        self.codegen.buffer.push_string(") * sizeof(");
        self.codegen.buffer.push_string(self.codegen.c_type_name(element_type));
        self.codegen.buffer.push_string("));\n");
        self.emit_cleanup(pa.cleanup);
        self.emit_cleanup(pb.cleanup);
        self.emit_cleanup(c.cleanup);
        return MIRValueEmission(result, Option[MIRValueCleanup].None());
    };

    emit_runtime_unary_ref(
        self,
        function_name: String,
        value: MIRValue,
        result_type: Type,
    ): MIRValueEmission = {
        let emission = self.emit_value_source(value);
        let result = self.codegen.next_temp_with_init(
            self.codegen.c_type_name(result_type),
            "\(function_name)(\(emission.expression))",
        );
        self.emit_cleanup(emission.cleanup);
        return MIRValueEmission(
            result,
            self.cleanup_for_temporary_result(result, result_type),
        );
    };

    emit_downgrade_ref(self, value: MIRValue, result_type: Type): MIRValueEmission = {
        let emission = self.emit_value_source(value);
        let value_type = self.type_of_value(value);
        // For managed nominal types, convert to __koral_Ref before calling downgrade.
        if self.codegen.uses_managed_nominal_representation(value_type) then {
            let ref_expr = "(struct __koral_Ref){.ptr = \(emission.expression).ptr}";
            let result = self.codegen.next_temp_with_init(
                "struct __koral_WeakRef",
                "\(self.codegen.rc_downgrade_fn(value_type))(\(ref_expr))",
            );
            self.emit_cleanup(emission.cleanup);
            return MIRValueEmission(
                result,
                self.cleanup_for_temporary_result(result, result_type),
            );
        };
        return when value_type in {
            .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner) or .MutableBorrowedReferenceType(inner) where inner is .TraitObject(...) then self.emit_trait_weak_downgrade(
                emission,
                result_type,
            ),
            _ then self.emit_runtime_unary_ref_from_emission(
                self.codegen.rc_downgrade_fn(value_type),
                emission,
                result_type,
            ),
        };
    };

    /// Downgrade a trait-object reference to a weak one, keeping the vtable.
    ///
    /// The control block goes through `__koral_downgrade_ref`; the vtable is
    /// the one the reference already carried, so the weak handle can still
    /// dispatch after a successful upgrade.
    emit_trait_weak_downgrade(
        self,
        emission: MIRValueEmission,
        result_type: Type,
    ): MIRValueEmission = {
        let result = self.codegen.next_temp_with_decl("struct __koral_TraitWeakRef");
        let weak_temp = self.codegen.next_temp_with_decl("struct __koral_WeakRef");
        self.codegen.add_indent();
        self.codegen.buffer.push_string(weak_temp);
        self.codegen.buffer.push_string(
            " = \(self.codegen.rc_downgrade_fn(result_type))((struct __koral_Ref){",
        );
        self.codegen.buffer.push_string(emission.expression);
        self.codegen.buffer.push_string(".ptr});\n");
        self.codegen.add_indent();
        self.codegen.buffer.push_string(result);
        self.codegen.buffer.push_string(".control = ");
        self.codegen.buffer.push_string(weak_temp);
        self.codegen.buffer.push_string(".control;\n");
        self.codegen.add_indent();
        self.codegen.buffer.push_string(result);
        self.codegen.buffer.push_string(".vtable = ");
        self.codegen.buffer.push_string(emission.expression);
        self.codegen.buffer.push_string(".vtable;\n");
        self.emit_cleanup(emission.cleanup);
        return MIRValueEmission(
            result,
            self.cleanup_for_temporary_result(result, result_type),
        );
    };

    emit_runtime_unary_ref_from_emission(
        self,
        function_name: String,
        emission: MIRValueEmission,
        result_type: Type,
    ): MIRValueEmission = {
        let result = self.codegen.next_temp_with_init(
            self.codegen.c_type_name(result_type),
            "\(function_name)(\(emission.expression))",
        );
        self.emit_cleanup(emission.cleanup);
        return MIRValueEmission(
            result,
            self.cleanup_for_temporary_result(result, result_type),
        );
    };

    emit_upgrade_ref(self, value: MIRValue, result_type: Type): MIRValueEmission = {
        let emission = self.emit_value_source(value);
        let success = self.codegen.next_temp_with_decl("int");
        let value_type = self.type_of_value(value);
        let is_trait_weak = when value_type in {
            .WeakReferenceType(inner) or .MutableWeakReferenceType(inner) then inner is .TraitObject(...),
            _ then false,
        };
        if is_trait_weak then {
            let upgraded = self.codegen.next_temp_with_init(
                "struct __koral_Ref",
                "\(self.codegen.rc_upgrade_fn(value_type))((struct __koral_WeakRef){\(emission.expression).control}, &\(success))",
            );
            let result = self.codegen.next_temp_with_decl(
                self.codegen.c_type_name(result_type),
            );
            let niche = self.codegen.enum_niche_layout_for_type(result_type);
            self.codegen.add_indent();
            self.codegen.buffer.push_string("if (");
            self.codegen.buffer.push_string(success);
            self.codegen.buffer.push_string(") {\n");
            self.codegen.push_indent_level();
            if niche is .None() then {
                self.codegen.add_indent();
                self.codegen.buffer.push_string(result);
                self.codegen.buffer.push_string(".tag = 1;\n");
            };
            self.codegen.add_indent();
            self.codegen.buffer.push_string(result);
            self.codegen.buffer.push_string(".data.Some.value.ptr = ");
            self.codegen.buffer.push_string(upgraded);
            self.codegen.buffer.push_string(".ptr;\n");
            self.codegen.add_indent();
            self.codegen.buffer.push_string(result);
            self.codegen.buffer.push_string(".data.Some.value.vtable = ");
            self.codegen.buffer.push_string(emission.expression);
            self.codegen.buffer.push_string(".vtable;\n");
            self.codegen.pop_indent_level();
            self.codegen.add_indent();
            self.codegen.buffer.push_string("} else {\n");
            self.codegen.push_indent_level();
            when niche in {
                .Some(layout) then {
                    let field_path = "\(result).data.\(self.codegen.sanitize_codegen_identifier(layout.payload_case_name)).\(self.codegen.sanitize_codegen_identifier(layout.payload_field_name))";
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(
                        self.codegen.niche_null_assignment(
                            layout.payload_field_type,
                            field_path,
                        ),
                    );
                },
                .None() then {
                    self.codegen.add_indent();
                    self.codegen.buffer.push_string(result);
                    self.codegen.buffer.push_string(".tag = 0;\n");
                },
            };
            self.codegen.pop_indent_level();
            self.codegen.add_indent();
            self.codegen.buffer.push_string("}\n");
            self.emit_cleanup(emission.cleanup);
            return MIRValueEmission(
                result,
                self.cleanup_for_temporary_result(result, result_type),
            );
        };
        return self.emit_plain_upgrade_ref(
            emission,
            success,
            result_type,
            self.codegen.rc_upgrade_fn(value_type),
        );
    };

    emit_plain_upgrade_ref(
        self,
        emission: MIRValueEmission,
        success: String,
        result_type: Type,
        upgrade_fn: String,
    ): MIRValueEmission = {
        let upgraded = self.codegen.next_temp_with_init(
            "struct __koral_Ref",
            "\(upgrade_fn)(\(emission.expression), &\(success))",
        );
        let result = self.codegen.next_temp_with_decl(
            self.codegen.c_type_name(result_type),
        );
        let niche = self.codegen.enum_niche_layout_for_type(result_type);
        self.codegen.add_indent();
        self.codegen.buffer.push_string("if (");
        self.codegen.buffer.push_string(success);
        self.codegen.buffer.push_string(") {\n");
        self.codegen.push_indent_level();
        if niche is .None() then {
            self.codegen.add_indent();
            self.codegen.buffer.push_string(result);
            self.codegen.buffer.push_string(".tag = 1;\n");
        };
        self.codegen.add_indent();
        self.codegen.buffer.push_string(result);
        self.codegen.buffer.push_string(".data.Some.value.ptr = ");
        self.codegen.buffer.push_string(upgraded);
        self.codegen.buffer.push_string(".ptr;\n");
        self.codegen.pop_indent_level();
        self.codegen.add_indent();
        self.codegen.buffer.push_string("} else {\n");
        self.codegen.push_indent_level();
        when niche in {
            .Some(layout) then {
                let field_path = "\(result).data.\(self.codegen.sanitize_codegen_identifier(layout.payload_case_name)).\(self.codegen.sanitize_codegen_identifier(layout.payload_field_name))";
                self.codegen.add_indent();
                self.codegen.buffer.push_string(
                    self.codegen.niche_null_assignment(
                        layout.payload_field_type,
                        field_path,
                    ),
                );
            },
            .None() then {
                self.codegen.add_indent();
                self.codegen.buffer.push_string(result);
                self.codegen.buffer.push_string(".tag = 0;\n");
            },
        };
        self.codegen.pop_indent_level();
        self.codegen.add_indent();
        self.codegen.buffer.push_string("}\n");
        self.emit_cleanup(emission.cleanup);
        return MIRValueEmission(
            result,
            self.cleanup_for_temporary_result(result, result_type),
        );
    };

    emit_spawn_thread(
        self,
        out_handle: MIRValue,
        out_tid: MIRValue,
        closure: MIRValue,
        stack_size: MIRValue,
    ): MIRValueEmission = {
        let h = self.emit_value_source(out_handle);
        let t = self.emit_value_source(out_tid);
        let c = self.emit_value_source(closure);
        let s = self.emit_value_source(stack_size);
        let result = self.codegen.next_temp_with_init(
            "int32_t",
            "__koral_spawn_thread(\(h.expression), \(t.expression), \(c.expression), \(s.expression))",
        );
        self.emit_cleanup(h.cleanup);
        self.emit_cleanup(t.cleanup);
        self.emit_cleanup(c.cleanup);
        self.emit_cleanup(s.cleanup);
        return MIRValueEmission(result, Option[MIRValueCleanup].None());
    };
};

private let join_strings(values: List[String], separator: String): String = {
    let mutable out = StringBuilder.new();
    let mutable first = true;
    for value in values then {
        if not first then {
            out.push_string(separator);
        };
        out.push_string(value);
        first = false;
    };
    return out.to_string();
};

private let build_mir_lifetime_plan(
    function: MIRFunction,
    codegen: CodeGen,
    tracked_init_locals: Dict[UInt, Bool],
): MIRLocalLifetimePlan = {
    let mutable tracked_drop_local_ids = Dict[UInt, Bool].new();
    let mutable has_tracked_drop_locals = false;
    for local in function.locals then {
        let has_init_flag = tracked_init_locals.get(local.id.raw_value) or else false;
        if has_init_flag then {
            tracked_drop_local_ids.insert(local.id.raw_value, true);
            has_tracked_drop_locals = true;
        };
    };

    // If no local in the function needs init/drop tracking, the full scope/use
    // analysis below only burns transient Dict/List/Set allocations. In that
    // case we can conservatively hoist declarations and skip the analysis.
    if not has_tracked_drop_locals then {
        let mutable hoisted_declaration_locals = List[MIRLocalID].new();
        for local in function.locals then {
            if local.storage is not .Parameter() and is not .Capture() and not codegen.type_is_void_or_never(
                local.local_type,
            ) then {
                hoisted_declaration_locals.push(local.id);
            };
        };
        return MIRLocalLifetimePlan(
            List[MIRLocalID].new(),
            Dict[UInt, List[MIRLocalID]].new(),
            hoisted_declaration_locals,
            Dict[UInt, List[MIRLocalID]].new(),
            Dict[UInt, Bool].new(),
        );
    };

    let mutable root_locals = List[MIRLocalID].new();
    let mutable locals_by_scope = Dict[UInt, List[MIRLocalID]].new();
    let mutable hoisted_declaration_locals = List[MIRLocalID].new();
    let mutable block_local_declarations_by_block = Dict[UInt, List[MIRLocalID]].new();
    let mutable block_local_declaration_locals = Dict[UInt, Bool].new();
    let mutable parent_scope_by_scope = Dict[UInt, MIRScopeID].new();
    let mutable declared_scope_by_local = Dict[UInt, MIRScopeID].new();
    let mutable active_scopes = List[MIRScopeID].new();
    let mutable declared_block_by_local = Dict[UInt, MIRBlockID].new();
    let mutable shared_use_scope_by_local = Dict[UInt, MIRScopeID].new();
    let mutable first_use_block_by_local = Dict[UInt, UInt].new();
    let mutable multiple_use_blocks_by_local = Dict[UInt, Bool].new();
    for block in function.blocks then {
        for statement in block.statements then {
            when statement in {
                .ScopeEnter(scope) then {
                    if not active_scopes.is_empty() then {
                        parent_scope_by_scope.insert(
                            scope.raw_value,
                            active_scopes[active_scopes.count() - UInt(1)],
                        );
                    };
                    active_scopes.push(scope);
                },
                .ScopeExit(scope) then {
                    let mutable idx = active_scopes.count();
                    while idx > 0 then {
                        idx -= 1;
                        if active_scopes[idx].raw_value == scope.raw_value then {
                            active_scopes.remove_at(idx);
                            break;
                        };
                    };
                },
                .Declare(local_id) then {
                    if declared_block_by_local.get(local_id.raw_value) is .None() then {
                        declared_block_by_local.insert(local_id.raw_value, block.id);
                    };
                    if not active_scopes.is_empty() then {
                        declared_scope_by_local.insert(
                            local_id.raw_value,
                            active_scopes[active_scopes.count() - UInt(1)],
                        );
                    };
                    mir_record_local_use(
                        shared_use_scope_by_local,
                        first_use_block_by_local,
                        multiple_use_blocks_by_local,
                        tracked_drop_local_ids,
                        parent_scope_by_scope,
                        local_id,
                        block.id,
                        active_scopes,
                    );
                },
                .Assign(place, value) then {
                    mir_walk_place_uses(
                        shared_use_scope_by_local,
                        first_use_block_by_local,
                        multiple_use_blocks_by_local,
                        tracked_drop_local_ids,
                        parent_scope_by_scope,
                        place,
                        block.id,
                        active_scopes,
                    );
                    mir_walk_value_uses(
                        shared_use_scope_by_local,
                        first_use_block_by_local,
                        multiple_use_blocks_by_local,
                        tracked_drop_local_ids,
                        parent_scope_by_scope,
                        value,
                        block.id,
                        active_scopes,
                    );
                },
                .AtomicLoad(target, place) then {
                    mir_record_local_use(
                        shared_use_scope_by_local,
                        first_use_block_by_local,
                        multiple_use_blocks_by_local,
                        tracked_drop_local_ids,
                        parent_scope_by_scope,
                        target,
                        block.id,
                        active_scopes,
                    );
                    mir_walk_place_uses(
                        shared_use_scope_by_local,
                        first_use_block_by_local,
                        multiple_use_blocks_by_local,
                        tracked_drop_local_ids,
                        parent_scope_by_scope,
                        place,
                        block.id,
                        active_scopes,
                    );
                },
                .AtomicStore(place, value) then {
                    mir_walk_place_uses(
                        shared_use_scope_by_local,
                        first_use_block_by_local,
                        multiple_use_blocks_by_local,
                        tracked_drop_local_ids,
                        parent_scope_by_scope,
                        place,
                        block.id,
                        active_scopes,
                    );
                    mir_walk_value_uses(
                        shared_use_scope_by_local,
                        first_use_block_by_local,
                        multiple_use_blocks_by_local,
                        tracked_drop_local_ids,
                        parent_scope_by_scope,
                        value,
                        block.id,
                        active_scopes,
                    );
                },
                .Exchange(place, old_target, value) then {
                    mir_record_local_use(
                        shared_use_scope_by_local,
                        first_use_block_by_local,
                        multiple_use_blocks_by_local,
                        tracked_drop_local_ids,
                        parent_scope_by_scope,
                        old_target,
                        block.id,
                        active_scopes,
                    );
                    mir_walk_place_uses(
                        shared_use_scope_by_local,
                        first_use_block_by_local,
                        multiple_use_blocks_by_local,
                        tracked_drop_local_ids,
                        parent_scope_by_scope,
                        place,
                        block.id,
                        active_scopes,
                    );
                    mir_walk_value_uses(
                        shared_use_scope_by_local,
                        first_use_block_by_local,
                        multiple_use_blocks_by_local,
                        tracked_drop_local_ids,
                        parent_scope_by_scope,
                        value,
                        block.id,
                        active_scopes,
                    );
                },
                .Drop(place) then mir_walk_place_uses(
                    shared_use_scope_by_local,
                    first_use_block_by_local,
                    multiple_use_blocks_by_local,
                    tracked_drop_local_ids,
                    parent_scope_by_scope,
                    place,
                    block.id,
                    active_scopes,
                ),
                .Retain(value) or .Release(value) or .Evaluate(value) then mir_walk_value_uses(
                    shared_use_scope_by_local,
                    first_use_block_by_local,
                    multiple_use_blocks_by_local,
                    tracked_drop_local_ids,
                    parent_scope_by_scope,
                    value,
                    block.id,
                    active_scopes,
                ),
                .Lock(lock) or .Unlock(lock) then {
                    when lock in {
                        .ObjectLock(handle) then mir_record_local_use(
                            shared_use_scope_by_local,
                            first_use_block_by_local,
                            multiple_use_blocks_by_local,
                            tracked_drop_local_ids,
                            parent_scope_by_scope,
                            handle,
                            block.id,
                            active_scopes,
                        ),
                        .GlobalLock(_) then {},
                    };
                },
                .DebugSource(_) then {},
            };
        };
        when block.terminator in {
            .Branch(condition, _, _) then mir_walk_operand_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                condition,
                block.id,
                active_scopes,
            ),
            .SwitchValue(operand, _, _) then mir_walk_operand_uses(
                shared_use_scope_by_local,
                first_use_block_by_local,
                multiple_use_blocks_by_local,
                tracked_drop_local_ids,
                parent_scope_by_scope,
                operand,
                block.id,
                active_scopes,
            ),
            .ReturnValue(operand) then when operand in {
                .Some(op) then mir_walk_operand_uses(
                    shared_use_scope_by_local,
                    first_use_block_by_local,
                    multiple_use_blocks_by_local,
                    tracked_drop_local_ids,
                    parent_scope_by_scope,
                    op,
                    block.id,
                    active_scopes,
                ),
                .None() then {},
            },
            _ then {},
        }
    };
    for local in function.locals then {
        when tracked_drop_local_ids.get(local.id.raw_value) in {
            .Some(_) then {
                let mutable scope = when declared_scope_by_local.get(local.id.raw_value) in {
                    .Some(scope_id) then Option[MIRScopeID].Some(scope_id),
                    .None() then Option[MIRScopeID].None(),
                };
                let shared_use_scope_opt = shared_use_scope_by_local.get(
                    local.id.raw_value,
                );
                while scope is .Some(_) then {
                    let scope_id = scope or else MIRScopeID(UInt(0));
                    let retained_scope = when shared_use_scope_opt in {
                        .Some(shared_use_scope) then shared_use_scope.raw_value == scope_id.raw_value,
                        .None() then false,
                    };
                    if retained_scope then {
                        break;
                    };
                    scope = mir_parent_scope(parent_scope_by_scope, scope_id);
                };
                when scope in {
                    .Some(scope_id) then {
                        let mutable scoped_locals = locals_by_scope.get(
                            scope_id.raw_value,
                        ) or else List[MIRLocalID].new();
                        scoped_locals.push(local.id);
                        locals_by_scope.insert(scope_id.raw_value, scoped_locals);
                    },
                    .None() then root_locals.push(local.id),
                };
            },
            .None() then {},
        };
    };
    for local in function.locals then {
        if local.storage is not .Parameter() and is not .Capture() and not codegen.type_is_void_or_never(
            local.local_type,
        ) then {
            let has_init_flag = tracked_init_locals.get(local.id.raw_value) or else false;
            let can_block_local = if not has_init_flag then when declared_block_by_local.get(
                local.id.raw_value,
            ) in {
                .Some(declaration_block) then when first_use_block_by_local.get(
                    local.id.raw_value,
                ) in {
                    .Some(first_use_block) then first_use_block == declaration_block.raw_value and not (multiple_use_blocks_by_local.get(
                        local.id.raw_value,
                    ) or else false),
                    .None() then false,
                },
                .None() then false,
            } else false;
            if can_block_local then {
                when declared_block_by_local.get(local.id.raw_value) in {
                    .Some(declaration_block) then {
                        let mutable block_locals = block_local_declarations_by_block.get(
                            declaration_block.raw_value,
                        ) or else List[MIRLocalID].new();
                        block_locals.push(local.id);
                        block_local_declarations_by_block.insert(
                            declaration_block.raw_value,
                            block_locals,
                        );
                        block_local_declaration_locals.insert(local.id.raw_value, true);
                    },
                    .None() then hoisted_declaration_locals.push(local.id),
                };
            } else {
                hoisted_declaration_locals.push(local.id);
            };
        };
    };
    return MIRLocalLifetimePlan(
        root_locals,
        locals_by_scope,
        hoisted_declaration_locals,
        block_local_declarations_by_block,
        block_local_declaration_locals,
    );
};

given CodeGen {
    receiver_owner_type_from_typed_params(self, params: List[TypedParam]): Option[Type] = {
        let _ = self;
        if params.is_empty() then {
            return Option[Type].None();
        };
        let first_param = params[UInt(0)];
        if not (first_param.name == "self" or first_param.name == "source") then {
            return Option[Type].None();
        };
        return when first_param.param_type in {
            .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner)
            or .MutableBorrowedReferenceType(inner) or .WeakReferenceType(inner)
            or .MutableWeakReferenceType(inner) then Option[Type].Some(inner),
            _ then Option[Type].Some(first_param.param_type),
        };
    };

    public emit_mir_function_body(self, function: MIRFunction): MIRFunctionBodyText = {
        let saved_indent = self.indent;
        self.indent = StringBuilder.new();
        self.indent.push_string(" ");
        let plan = build_mir_function_emit_plan(self, function);
        let mutable emitter = MIRFunctionCodeEmitter.new(self, function, plan);
        let saved_buffer = self.buffer;
        self.buffer = CodegenBuffer.new();
        let nested = (emitter).emit_body_and_get_nested_definitions();
        let body_text = self.buffer.into_string();
        self.buffer = saved_buffer;
        if not nested.is_empty() then {
            self.nested_function_definitions.push_string(nested);
        };
        self.indent = saved_indent;
        return MIRFunctionBodyText(body_text, emitter.saw_alloc_memory);
    };

    public emit_mir_global_function(self, function: MIRFunction): Void = {
        let c_name = self.callable_c_name(function.identifier);
        if self.emitted_function_names.contains(c_name) then {
            return;
        };
        self.emitted_function_names.insert(c_name);
        // Bound owner-sensitive callable-name cache to one top-level function.
        // Keeping it across the full codegen run trades a small lookup win for higher RSS.
        self.current_owner_callable_c_name_cache = Dict[String, String].new();
        let declared_return_type = self.mir_function_return_type(function);
        if self.type_contains_generic(declared_return_type) or self.params_contain_generic(
            function.params,
        ) then {
            panic(
                internal_compiler_error(
                    "Generic MIR function body reached codegen: \(self.context.symbol_name(function.identifier)) :: \(self.context.type_display_name(function.identifier.symbol_type))",
                ),
            );
        };

        let saved_owner_type = self.current_function_owner_type;
        let concrete_return_type = self.concretize_codegen_type(declared_return_type);
        self.current_function_owner_type = when function.kind in {
            .Given(target_type, _, _, _) then Option[Type].Some(target_type),
            .Global() then self.receiver_owner_type_from_typed_params(function.params),
        };

        {
            let return_c_type = self.c_type_name(concrete_return_type);
            let params_str = self.build_param_list(function.params);
            // Generate the function body and collect nested definitions
            let body_emission = self.emit_mir_function_body(function);
            let body_text = body_emission.body;

            // Emit nested definitions (lambda functions, env structs) before the function
            if not self.nested_function_definitions.is_empty() then {
                self.buffer.push_string(self.nested_function_definitions.to_string());
                self.nested_function_definitions = StringBuilder.new();
            };

            if body_emission.allocates then {
                self.buffer.push_string("KORAL_NOINLINE ");
            };
            self.buffer.push_string(return_c_type);
            self.buffer.push_string(" ");
            self.buffer.push_string(c_name);
            self.buffer.push_string("(");
            self.buffer.push_string(params_str);
            self.buffer.push_string(") {\n");
            self.buffer.push_string(body_text);
            self.buffer.push_string("}\n");
        };

        self.current_function_owner_type = saved_owner_type;
        return;
    };
};
