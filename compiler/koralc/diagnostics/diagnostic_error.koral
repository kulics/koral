public type DiagnosticStage {
    Lexer(),
    Parser(),
    Semantic(),
    Other(),
};

public type DiagnosticError(
    stage DiagnosticStage,
    file_path String,
    /// The bare text: what went wrong, with no location and no stage.
    ///
    /// Named `detail` and not `message` because `message()` is also a method on
    /// this type -- the `Error` trait's -- and it returns the rendered CLI line.
    /// Sharing one name for both is how a diagnostic ended up nested inside
    /// another one's message with its location printed twice.
    detail String,
    span Option[SourceSpan],
);

file_private let diagnostic_stage_text(stage DiagnosticStage) String = {
    return when stage in {
        .Lexer() then "lexer error",
        .Parser() then "syntax error",
        .Semantic() then "error",
        .Other() then "error",
    };
};

given DiagnosticError as Error {
    /// The CLI line: `path:line:col: stage: message`.
    ///
    /// This is the one form a `Result`-escaped error can offer its consumer --
    /// `Result.Error` holds `Error`, so a caller cannot ask a diagnostic for its
    /// span and stage afterwards. That is why this is the rendered line and not
    /// the bare message.
    ///
    /// The bare text is the `message` FIELD. Read that when COMPOSING one
    /// diagnostic out of another. Reading `message()` there would nest this
    /// whole envelope inside a new one and the CLI would print the location
    /// twice -- which is exactly what used to happen, until two normalizing
    /// hacks were invented to strip the doubled prefix back off. Both are gone;
    /// nothing composes through `message()` any more.
    public message(self) String = {
        let mutable location = StringBuilder.new();
        location.push_string(self.file_path);
        when self.span in {
            .Some(span) then if is_known_span(span) then {
                if location.is_empty() then {
                    location = StringBuilder.new();
                    location.push_string(span.start.line.to_string());
                } else {
                    location.push_byte(':');
                    location.push_string(span.start.line.to_string());
                };
                location.push_byte(':');
                location.push_string(span.start.column.to_string());
            },
            .None() then {},
        };

        let mutable out = StringBuilder.new();
        if location.is_empty() then {
            out.push_string(diagnostic_stage_text(self.stage));
        } else {
            out.push_string(location.to_string());
        };
        if location.is_empty() then {
            out.push_string(": ");
        } else {
            out.push_string(": ");
            out.push_string(diagnostic_stage_text(self.stage));
            out.push_string(": ");
        };
        out.push_string(self.detail);
        return out.to_string();
    };
};

/// The bare text of an error: what went wrong, with no location and no stage.
///
/// Build a diagnostic. The span is an INPUT: the source location of the
/// construct the diagnostic is about, supplied by the site that reports it.
///
/// It is deliberately never recovered from the message text. A site with no
/// location available passes `unknown_span()` and the diagnostic prints without
/// one -- honest, and strictly better than pointing at wherever the message
/// happened to spell out a pair of numbers.
public let make_diagnostic(stage DiagnosticStage, file_path String, message String, span SourceSpan) DiagnosticError = {
    return DiagnosticError(stage, file_path, message, if is_known_span(span) then Option[SourceSpan].Some(span) else Option[SourceSpan].None());
};
