// core_precedence.koral - 优先级爬升与声明解析
//
// 实现 Parser 的优先级爬升方法（parse_factor 到 parse_expression）、
// trait/given 声明解析、using 声明解析、顶层声明解析、
// 以及字符串插值解析。

private let access_modifier_text(access: AccessModifier): String = {
    return when access in {
        .Public() then "public",
        .Internal() then "internal",
        .Private() then "private",
        .Protected() then "protected",
    };
};

given Parser {

    comparison_kind_is_equality(self, kind: TokenKind): Bool = {
        let _ = self;
        return when kind in {
            .EqualEqual() then true,
            .NotEqual() then true,
            _ then false,
        };
    };

    comparison_kind_is_ordering(self, kind: TokenKind): Bool = {
        let _ = self;
        return when kind in {
            .Greater() then true,
            .GreaterEqual() then true,
            .Less() then true,
            .LessEqual() then true,
            _ then false,
        };
    };

    comparison_kind_is_ascending(self, kind: TokenKind): Bool = {
        let _ = self;
        return when kind in {
            .Less() then true,
            .LessEqual() then true,
            .Greater() then false,
            .GreaterEqual() then false,
            _ then false,
        };
    };

    comparison_operator_from_kind(self, kind: TokenKind): ComparisonOperator = {
        let _ = self;
        return when kind in {
            .EqualEqual() then ComparisonOperator.Equal(),
            .NotEqual() then ComparisonOperator.NotEqual(),
            .Greater() then ComparisonOperator.Greater(),
            .GreaterEqual() then ComparisonOperator.GreaterEqual(),
            .Less() then ComparisonOperator.Less(),
            .LessEqual() then ComparisonOperator.LessEqual(),
            _ then ComparisonOperator.Equal(),
        };
    };

    expr_is_ordering_comparison(self, expr: Expr): Bool = {
        return when expr in {
            .ComparisonExpr(_, op, _, _) then when op in {
                .Greater() then true,
                .GreaterEqual() then true,
                .Less() then true,
                .LessEqual() then true,
                _ then false,
            },
            .ComparisonChainExpr(_, _, _) then true,
            _ then false,
        };
    };

    invalid_comparison_chain_error(self): Result[Expr] = {
        return .Error(
            self.parser_error(
                "Comparison chains only support same-direction ordering operators (<, <=) or (>, >=). Use 'and' to combine other comparisons explicitly.",
            ),
        );
    };

    /// `expr as Type` -- pointer reinterpretation, pointer <-> address, weak
    /// construction, and explicit trait-object upcasts. Left-associative and
    /// sitting between the multiplicative level and the prefix level (Rust's
    /// `as` position):
    ///
    ///   `&x as *T`       == `(&x) as *T`
    ///   `*p as *Int`     == `(*p) as *Int`
    ///   `p * q as *T`    == `p * (q as *T)`
    ///   `p as *Int == q` == `(p as *Int) == q`
    ///
    /// `as` takes a full `<type>`: `*T`, `*mutable T`, `?T`, `Trait[Int]`, an
    /// alias. The cast result takes no postfix suffixes -- a method call on one
    /// takes parentheses, `(self as *T).equals(...)`.
    parse_cast(self): Result[Expr] = {
        let mutable expr = self.parse_unary() or return;

        while self.current().kind is .KwAs() then {
            self.advance();
            let cast_type = self.parse_type() or return;
            expr = Expr.CastExpr(cast_type, expr, self.span_from_expr_start(expr));
        };

        return .Ok(expr);
    };

    parse_factor(self): Result[Expr] = {
        let mutable expr = self.parse_cast() or return;

        while true then {
            when self.current().kind in {
                .Star() then {
                    self.advance();
                    let rhs = self.parse_cast() or return;
                    expr = Expr.ArithmeticExpr(
                        expr,
                        ArithmeticOperator.Multiply(),
                        rhs,
                        self.span_from_expr_start(expr),
                    );
                },
                .Slash() then {
                    self.advance();
                    let rhs = self.parse_cast() or return;
                    expr = Expr.ArithmeticExpr(
                        expr,
                        ArithmeticOperator.Divide(),
                        rhs,
                        self.span_from_expr_start(expr),
                    );
                },
                .Percent() then {
                    self.advance();
                    let rhs = self.parse_cast() or return;
                    expr = Expr.ArithmeticExpr(
                        expr,
                        ArithmeticOperator.Remainder(),
                        rhs,
                        self.span_from_expr_start(expr),
                    );
                },
                _ then {
                    break;
                },
            };
        };

        return .Ok(expr);
    };

    parse_term(self): Result[Expr] = {
        let mutable expr = self.parse_factor() or return;

        while true then {
            when self.current().kind in {
                .Plus() then {
                    self.advance();
                    let rhs = self.parse_factor() or return;
                    expr = Expr.ArithmeticExpr(
                        expr,
                        ArithmeticOperator.Add(),
                        rhs,
                        self.span_from_expr_start(expr),
                    );
                },
                .Minus() then {
                    self.advance();
                    let rhs = self.parse_factor() or return;
                    expr = Expr.ArithmeticExpr(
                        expr,
                        ArithmeticOperator.Subtract(),
                        rhs,
                        self.span_from_expr_start(expr),
                    );
                },
                _ then {
                    break;
                },
            };
        };

        return .Ok(expr);
    };

    parse_range(self): Result[Expr] = {
        // Prefix ranges (`..b`, `..<b`, `..`) live at the range layer, ABOVE
        // comparison -- the same layering the seed uses. A comparison's
        // operand is parsed below this layer, so `a < ..b` (with a gap) cannot
        // smuggle a range in as the right operand: the `..` reaches
        // `parse_primary`, which rejects it. Without this, `a < ..b` parsed as
        // `a < (..b)` and codegen emitted a comparison against a range.
        when self.current().kind in {
            .Ellipsis() then {
                let start = self.current();
                self.advance();
                if self.can_start_range_bound(self.current().kind) then {
                    let rhs = self.parse_comparison() or return;
                    return .Ok(
                        Expr.RangeExpr(
                            RangeOperator.To(),
                            Option[Expr].None(),
                            Option[Expr].Some(rhs),
                            self.span_from_start(start),
                        ),
                    );
                };
                return .Ok(
                    Expr.RangeExpr(
                        RangeOperator.Full(),
                        Option[Expr].None(),
                        Option[Expr].None(),
                        self.span_from_start(start),
                    ),
                );
            },
            .EllipsisLt() then {
                let start = self.current();
                self.advance();
                let rhs = self.parse_comparison() or return;
                return .Ok(
                    Expr.RangeExpr(
                        RangeOperator.ToOpen(),
                        Option[Expr].None(),
                        Option[Expr].Some(rhs),
                        self.span_from_start(start),
                    ),
                );
            },
            .Range() or .RangeLess() then {
                return .Error(
                    self.parser_error_at_current(
                        "open ranges are spelled with '...': write '...b', '...<b', or '...'",
                    ),
                );
            },
            .LtEllipsis() then {
                return .Error(
                    self.parser_error_at_current(
                        "'<...' follows a range bound; write 'a<...'",
                    ),
                );
            },
            _ then {},
        };

        let mutable expr = self.parse_comparison() or return;

        while true then {
            when self.current().kind in {
                .Range() then {
                    let op = self.current();
                    self.advance();
                    if self.can_start_range_bound(self.current().kind) and true then {
                        let rhs = self.parse_comparison() or return;
                        expr = Expr.RangeExpr(
                            RangeOperator.Closed(),
                            .Some(expr),
                            .Some(rhs),
                            self.span_from_expr_start(expr),
                        );
                    } else {
                        return .Error(
                            self.parser_error_at(
                                "open ranges are spelled with '...': write 'a...' or 'a<...'",
                                op,
                            ),
                        );
                    };
                },
                .RangeLess() then {
                    self.advance();
                    let rhs = self.parse_comparison() or return;
                    expr = Expr.RangeExpr(
                        RangeOperator.ClosedOpen(),
                        .Some(expr),
                        .Some(rhs),
                        self.span_from_expr_start(expr),
                    );
                },
                .LessRange() then {
                    let op = self.current();
                    self.advance();
                    if self.can_start_range_bound(self.current().kind) and true then {
                        let rhs = self.parse_comparison() or return;
                        expr = Expr.RangeExpr(
                            RangeOperator.OpenClosed(),
                            .Some(expr),
                            .Some(rhs),
                            self.span_from_expr_start(expr),
                        );
                    } else {
                        return .Error(
                            self.parser_error_at(
                                "open ranges are spelled with '...': write 'a...' or 'a<...'",
                                op,
                            ),
                        );
                    };
                },
                .LessRangeLess() then {
                    self.advance();
                    let rhs = self.parse_comparison() or return;
                    expr = Expr.RangeExpr(
                        RangeOperator.Open(),
                        .Some(expr),
                        .Some(rhs),
                        self.span_from_expr_start(expr),
                    );
                },
                .Ellipsis() then {
                    self.advance();
                    if self.can_start_range_bound(self.current().kind) then {
                        return .Error(
                            self.parser_error_at_current(
                                "a '...' range takes at most one bound; write 'a..b' for a closed range",
                            ),
                        );
                    };
                    expr = Expr.RangeExpr(
                        RangeOperator.From(),
                        .Some(expr),
                        Option[Expr].None(),
                        self.span_from_expr_start(expr),
                    );
                },
                .LtEllipsis() then {
                    self.advance();
                    if self.can_start_range_bound(self.current().kind) then {
                        return .Error(
                            self.parser_error_at_current(
                                "a '...' range takes at most one bound; write 'a..b' for a closed range",
                            ),
                        );
                    };
                    expr = Expr.RangeExpr(
                        RangeOperator.FromOpen(),
                        .Some(expr),
                        Option[Expr].None(),
                        self.span_from_expr_start(expr),
                    );
                },
                .EllipsisLt() then {
                    return .Error(
                        self.parser_error_at_current(
                            "'...<' opens a range with no left bound; write '...<b'",
                        ),
                    );
                },
                _ then {
                    break;
                },
            };
        };

        return .Ok(expr);
    };

    parse_shift(self): Result[Expr] = {
        let mutable expr = self.parse_term() or return;

        while true then {
            when self.current().kind in {
                .LeftShift() then {
                    self.advance();
                    let rhs = self.parse_term() or return;
                    expr = Expr.BitwiseExpr(
                        expr,
                        BitwiseOperator.LeftShift(),
                        rhs,
                        self.span_from_expr_start(expr),
                    );
                },
                .RightShift() then {
                    self.advance();
                    let rhs = self.parse_term() or return;
                    expr = Expr.BitwiseExpr(
                        expr,
                        BitwiseOperator.RightShift(),
                        rhs,
                        self.span_from_expr_start(expr),
                    );
                },
                _ then {
                    break;
                },
            };
        };

        return .Ok(expr);
    };

    parse_bitwise_and(self): Result[Expr] = {
        let mutable expr = self.parse_shift() or return;

        while self.current().kind is .Ampersand() then {
            self.advance();
            let rhs = self.parse_shift() or return;
            expr = Expr.BitwiseExpr(
                expr,
                BitwiseOperator.BitAnd(),
                rhs,
                self.span_from_expr_start(expr),
            );
        };

        return .Ok(expr);
    };

    parse_bitwise_xor(self): Result[Expr] = {
        let mutable expr = self.parse_bitwise_and() or return;

        while self.current().kind is .Caret() then {
            self.advance();
            let rhs = self.parse_bitwise_and() or return;
            expr = Expr.BitwiseExpr(
                expr,
                BitwiseOperator.BitXor(),
                rhs,
                self.span_from_expr_start(expr),
            );
        };

        return .Ok(expr);
    };

    parse_bitwise_or(self): Result[Expr] = {
        let mutable expr = self.parse_bitwise_xor() or return;

        while self.current().kind is .Pipe() then {
            self.advance();
            let rhs = self.parse_bitwise_xor() or return;
            expr = Expr.BitwiseExpr(
                expr,
                BitwiseOperator.BitOr(),
                rhs,
                self.span_from_expr_start(expr),
            );
        };

        return .Ok(expr);
    };

    parse_comparison(self): Result[Expr] = {
        let start = self.current();
        let expr = self.parse_bitwise_or() or return;

        let first_kind = self.current().kind;

        // Handle equality (==, !=) - no chaining allowed
        if self.comparison_kind_is_equality(first_kind) then {
            if self.expr_is_ordering_comparison(expr) then {
                return self.invalid_comparison_chain_error();
            };
            let op = self.comparison_operator_from_kind(first_kind);
            self.advance();
            let rhs = self.parse_bitwise_or() or return;
            if self.expr_is_ordering_comparison(rhs) then {
                return self.invalid_comparison_chain_error();
            };
            let result = Expr.ComparisonExpr(
                expr,
                op,
                rhs,
                self.span_from_expr_start(expr),
            );
            if self.comparison_kind_is_equality(self.current().kind) or self.comparison_kind_is_ordering(
                self.current().kind,
            ) then {
                return self.invalid_comparison_chain_error();
            };
            return .Ok(result);
        };

        // Handle ordering (<, >, <=, >=) - chaining allowed
        if not self.comparison_kind_is_ordering(first_kind) then {
            return .Ok(expr);
        };

        let direction_is_ascending = self.comparison_kind_is_ascending(first_kind);
        let first_op = self.comparison_operator_from_kind(first_kind);
        self.advance();
        let first_right = self.parse_bitwise_or() or return;

        // Check if next token is equality (invalid in chain) or not ordering (simple comparison)
        if not self.comparison_kind_is_ordering(self.current().kind) then {
            if self.comparison_kind_is_equality(self.current().kind) then {
                return self.invalid_comparison_chain_error();
            };
            return .Ok(
                Expr.ComparisonExpr(
                    expr,
                    first_op,
                    first_right,
                    self.span_from_expr_start(expr),
                ),
            );
        };

        let mutable operands = List[Expr].new();
        operands.push(expr);
        operands.push(first_right);
        let mutable operators = List[ComparisonOperator].new();
        operators.push(first_op);

        while self.comparison_kind_is_ordering(self.current().kind) or self.comparison_kind_is_equality(
            self.current().kind,
        ) then {
            let next_kind = self.current().kind;
            if self.comparison_kind_is_equality(next_kind) then {
                return self.invalid_comparison_chain_error();
            };
            if self.comparison_kind_is_ascending(next_kind) != direction_is_ascending then {
                return self.invalid_comparison_chain_error();
            };
            let next_op = self.comparison_operator_from_kind(next_kind);
            self.advance();
            let rhs = self.parse_bitwise_or() or return;
            operands.push(rhs);
            operators.push(next_op);
        };

        return .Ok(
            Expr.ComparisonChainExpr(operands, operators, self.span_from_start(start)),
        );
    };

    /// One or more `is` tests on a single subject, joined by the two-token
    /// connectors `and is` / `or is`.
    ///
    /// The chain is one PATTERN, not several tests: `x is A or is B` is
    /// `x is (A or B)`, so the two sides share bindings the way an `or`
    /// pattern does in a `when` arm. Building it as an expression `or` of two
    /// `is` tests would instead fall under "bindings in `is` are not allowed
    /// in `or` branches" and reject `x is Point(a, b) or is Circle(a)`.
    ///
    /// Each slot is `is` `not`? `<primary-pattern>`; combinators live between
    /// slots, never inside one. `and` alone is the expression operator, so a
    /// connector is only one when it is followed by `is`. `and is` binds
    /// tighter than `or is`, and the whole chain sits where a lone `is` sat --
    /// tighter than expression `and` / `or`.
    parse_is(self): Result[Expr] = {
        let subject = self.parse_range() or return;
        if self.current().kind is not .KwIs() then {
            return .Ok(subject);
        };
        let start = self.current();
        let pattern = self.parse_is_or_pattern() or return;
        // A lone negated slot keeps its own node, so `x is not P` is
        // unchanged; negations inside a chain live in the combined pattern.
        let inner = when pattern in {
            .NotPattern(p, _) then Option[PatternNode].Some(p),
            _ then Option[PatternNode].None(),
        };
        if inner is .Some(p) then {
            return .Ok(Expr.IsNotExpr(subject, p, self.span_from_expr_start(subject)));
        };
        return .Ok(Expr.IsExpr(subject, pattern, self.span_from_expr_start(subject)));
    };

    parse_is_or_pattern(self): Result[PatternNode] = {
        let mutable left = self.parse_is_and_pattern() or return;
        while self.current().kind is .KwOr() and self.next_token_is_is() then {
            self.advance();
            let right = self.parse_is_and_pattern() or return;
            left = PatternNode.OrPattern(left, right, span_across_patterns(left, right));
        };
        return .Ok(left);
    };

    parse_is_and_pattern(self): Result[PatternNode] = {
        let mutable left = self.parse_is_slot_pattern() or return;
        while self.current().kind is .KwAnd() and self.next_token_is_is() then {
            self.advance();
            let right = self.parse_is_slot_pattern() or return;
            left = PatternNode.AndPattern(left, right, span_across_patterns(left, right));
        };
        return .Ok(left);
    };

    parse_is_slot_pattern(self): Result[PatternNode] = {
        let start = self.current();
        self.advance();
        if self.current().kind is .KwNot() then {
            self.advance();
            let inner = self.parse_single_pattern() or return;
            return .Ok(PatternNode.NotPattern(inner, self.span_from_start(start)));
        };
        return self.parse_single_pattern();
    };

    /// Whether the token after the current one is `is` -- the signal that this
    /// `and` / `or` joins two `is` tests rather than two expressions.
    next_token_is_is(self): Bool = {
        return self.peek_kind() is .Some(.KwIs());
    };

    parse_logical_not(self): Result[Expr] = {
        if self.current().kind is .KwNot() then {
            let start = self.current();
            self.advance();
            let operand = self.parse_is() or return;
            return .Ok(
                Expr.Unary(UnaryOperator.Not(), operand, self.span_from_start(start)),
            );
        };

        return self.parse_is();
    };

    // ── flow layer / logical layer ──────────────────────────────────────────
    //
    // `and then` / `or else` / `or return` are ONE layer -- value flow -- and
    // `and` / `or` are another -- boolean logic. Precedence inside a layer is
    // unchanged: `and then` binds tighter than `or else` / `or return`, and
    // `and` binds tighter than `or`. The layers do not mix implicitly.
    //
    // Everything below the layers -- comparison, range, `is`, `not`, the
    // arithmetic ladder -- binds TIGHTER than both of them: the operand parsed
    // here already includes comparison, so `a == b or else c` is
    // `(a == b) or else c`, never `a == (b or else c)`.
    //
    // Crossing from one to the other takes parentheses, the way `??` refuses
    // to sit beside `||` in the languages that have it:
    //
    //   `a and (b or else c)`                   -- fine, and means that
    //   `(a and b) or else c`                   -- fine, and means something else
    //   `a and b or else c`                     -- refused: it means neither
    //   `opt and then as v in v == 1 and false` -- refused
    //
    // So the operand is parsed first, and the operator that follows it decides
    // which chain continues. Both chains stop at the other layer's operators
    // and refuse them there instead of guessing a grouping.

    parse_expression(self): Result[Expr] = {
        let operand = self.parse_logical_not() or return;
        return self.parse_layered_tail(operand);
    };

    /// Continue `operand` in whichever layer its next operator belongs to.
    parse_layered_tail(self, operand: Expr): Result[Expr] = {
        if self.starts_flow_chain() then {
            let flowed = self.parse_flow_tail(operand) or return;
            return self.reject_logical_at_flow_layer(flowed);
        };
        if self.starts_logical_chain() then {
            let logical = self.parse_logical_tail(operand) or return;
            return self.reject_flow_at_logical_layer(logical);
        };
        return .Ok(operand);
    };

    /// Whether the operator at the cursor is a flow operator.
    starts_flow_chain(self): Bool = {
        return when self.current().kind in {
            .KwAnd() then self.next_is_then(),
            .KwOr() then self.next_is_else() or self.next_is_return(),
            _ then false,
        };
    };

    /// Whether the operator at the cursor is a logical operator.
    starts_logical_chain(self): Bool = {
        return when self.current().kind in {
            .KwAnd() then not self.next_is_then(),
            .KwOr() then not self.next_is_else() and not self.next_is_return(),
            _ then false,
        };
    };

    // The right operand of one `and then` link. Three shapes:
    //   `.f(x).g`      -- receiver-elided member chain on the unwrapped value
    //   `as v in body` -- explicit binder, body is a layer operand
    //   anything else  -- a plain layer operand (legacy; goes away with `it`)
    //
    // A leading dot here is the chain, never an implicit member: `and then` does
    // not push an expected type into the transform, so the implicit-member
    // reading was never reachable in this slot.
    parse_and_then_operand(self): Result[Expr] = {
        let t = self.current();
        if t.kind is .Dot() then {
            // The leading `.` is consumed by `parse_dot_suffix`, which the
            // postfix loop runs on the elided receiver.
            let base = Expr.FlowReceiver(self.span_from_start(t));
            let chain = self.parse_postfix_suffixes(base) or return;
            // The chain is postfix-only. A binary continuation here means the
            // reader tried to compute on the value through the sugar -- point
            // at the binder instead of leaving a bare "expected ';'".
            let after = self.current().kind;
            let extends_chain = when after in {
                .Plus() or .Minus() or .Star() or .Slash() or .Percent() or .Ampersand() or .Pipe() or .Caret() or .LeftShift() or .RightShift() or .EqualEqual() or .NotEqual() or .Greater() or .Less() or .GreaterEqual() or .LessEqual() or .Range() or .RangeLess() or .LessRange() or .LessRangeLess() or .EllipsisLt() or .LtEllipsis() or .KwIs() or .KwAs() then true,
                _ then false,
            };
            if extends_chain then {
                return .Error(
                    self.parser_error_at(
                        "'and then' chain is postfix-only -- compute on the value with 'as name in ...'",
                        self.current(),
                    ),
                );
            };
            return .Ok(Expr.FlowChainExpr(chain, self.span_from_start(t)));
        };
        if t.kind is .KwAs() then {
            return self.parse_flow_bind();
        };
        // No plain-expression form: the unwrapped value has no implicit name.
        return .Error(
            self.parser_error_at(
                "'and then' takes a '.member()' chain or an 'as name in body' binder -- there is no implicit name",
                t,
            ),
        );
    };

    // The right operand of `or else`. `as e in body` names the error payload
    // (Result only -- `None` has no payload); anything else is the fallback
    // value itself, where a leading dot stays an implicit member.
    parse_or_else_operand(self): Result[Expr] = {
        if self.current().kind is .KwAs() then {
            return self.parse_flow_bind();
        };
        return self.parse_logical_not();
    };

    // `as name in body`. The body stops at a layer operand, so an `or else`
    // written after it belongs to the enclosing flow chain and the binder's
    // scope stays tight.
    parse_flow_bind(self): Result[Expr] = {
        let start = self.current();
        self.advance();
        let name = self.expect_identifier("flow binding name") or return;
        when self.current().kind in {
            .KwIn() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error_at(
                        "Unexpected token: \(token_text(self.current())), expected: 'in' after flow binding name",
                        self.current(),
                    ),
                );
            },
        };
        let body = self.parse_logical_not() or return;
        return .Ok(Expr.FlowBindExpr(name, body, self.span_from_start(start)));
    };

    // `and then` binds tightest of the flow operators.
    parse_and_then_chain(self, operand: Expr): Result[Expr] = {
        let mutable expr = operand;

        while self.current().kind is .KwAnd() and self.next_is_then() then {
            self.advance();
            self.advance();
            let rhs = self.parse_and_then_operand() or return;
            expr = Expr.AndThenExpr(expr, rhs, self.span_from_expr_start(expr));
        };

        return .Ok(expr);
    };

    // `or else` / `or return` sit between `and then` and the end of the layer:
    // `f() and then as v in g(v) or else h()` groups as `(f() and then as v in g(v)) or else h()`.
    parse_flow_tail(self, operand: Expr): Result[Expr] = {
        let mutable expr = self.parse_and_then_chain(operand) or return;

        while self.current().kind is .KwOr() then {
            // Same as `is`: `x or return` begins at `x`, so the span does too.
            if self.next_is_else() then {
                self.advance();
                self.advance();
                let rhs_operand = self.parse_or_else_operand() or return;
                let rhs = self.parse_and_then_chain(rhs_operand) or return;
                expr = Expr.OrElseExpr(expr, rhs, self.span_from_expr_start(expr));
                continue;
            };
            if self.next_is_return() then {
                self.advance();
                self.advance();
                expr = Expr.OrReturnExpr(expr, self.span_from_expr_start(expr));
                continue;
            };
            break;
        };

        return .Ok(expr);
    };

    parse_logical_and_chain(self, operand: Expr): Result[Expr] = {
        let mutable expr = operand;

        while self.current().kind is .KwAnd() and not self.next_is_then() then {
            self.advance();
            let rhs = self.parse_logical_not() or return;
            expr = Expr.AndExpr(expr, rhs, self.span_from_expr_start(expr));
        };

        return .Ok(expr);
    };

    parse_logical_tail(self, operand: Expr): Result[Expr] = {
        let mutable expr = self.parse_logical_and_chain(operand) or return;

        while self.current().kind is .KwOr() and not self.next_is_else() and not self.next_is_return(
        ) then {
            self.advance();
            let rhs_operand = self.parse_logical_not() or return;
            let rhs = self.parse_logical_and_chain(rhs_operand) or return;
            expr = Expr.OrExpr(expr, rhs, self.span_from_expr_start(expr));
        };

        return .Ok(expr);
    };

    /// A logical operator arriving after a flow chain. The span is the operator
    /// itself, so the caret sits on the token to parenthesize around.
    reject_logical_at_flow_layer(self, expr: Expr): Result[Expr] = {
        if self.current().kind is .KwAnd() and not self.next_is_then() then {
            return .Error(
                self.parser_error_at_current(
                    "'and' cannot be mixed with the flow operators 'and then' / 'or else' / 'or return' without parentheses",
                ),
            );
        };
        if self.current().kind is .KwOr() and not self.next_is_else() and not self.next_is_return(
        ) then {
            return .Error(
                self.parser_error_at_current(
                    "'or' cannot be mixed with the flow operators 'and then' / 'or else' / 'or return' without parentheses",
                ),
            );
        };
        return .Ok(expr);
    };

    /// A flow operator arriving after a logical chain.
    reject_flow_at_logical_layer(self, expr: Expr): Result[Expr] = {
        if self.current().kind is .KwAnd() and self.next_is_then() then {
            return .Error(
                self.parser_error_at_current(
                    "'and then' cannot be mixed with logical 'and' / 'or' without parentheses",
                ),
            );
        };
        if self.current().kind is .KwOr() and self.next_is_else() then {
            return .Error(
                self.parser_error_at_current(
                    "'or else' cannot be mixed with logical 'and' / 'or' without parentheses",
                ),
            );
        };
        if self.current().kind is .KwOr() and self.next_is_return() then {
            return .Error(
                self.parser_error_at_current(
                    "'or return' cannot be mixed with logical 'and' / 'or' without parentheses",
                ),
            );
        };
        return .Ok(expr);
    };

    parse_access_modifier(self, default: AccessModifier): Result[AccessModifier] = {
        when self.current().kind in {
            .KwPublic() then {
                self.advance();
                return .Ok(AccessModifier.Public());
            },
            .KwInternal() then {
                self.advance();
                return .Ok(AccessModifier.Internal());
            },
            .KwProtected() then {
                self.advance();
                return .Ok(AccessModifier.Protected());
            },
            .KwPrivate() then {
                self.advance();
                return .Ok(AccessModifier.Private());
            },
            _ then {
                // A legacy spelling in the modifier slot is the old spelling of
                // a modifier; a name spelled `file_private` is a name and is
                // left alone (see `legacy_access_modifier_message`).
                when self.legacy_access_modifier_message() in {
                    .Some(message) then {
                        return .Error(self.parser_error_at_current(message));
                    },
                    .None() then {},
                };
                return .Ok(default);
            },
        };
    };

    parse_trait_member(
        self,
        trait_name: String,
        trait_access: AccessModifier,
    ): Result[TraitMember] = {
        // A trait requirement has NO modifier slot: its visibility is the
        // trait's, stamped here from the trait's own declaration. The old slot
        // is rejected outright; a legacy spelling in it is an old modifier, not
        // a name, and gets the migration complaint instead.
        when self.legacy_access_modifier_message() in {
            .Some(message) then {
                return .Error(self.parser_error_at_current(message));
            },
            .None() then {},
        };
        when self.current().kind in {
            .KwPublic() or .KwInternal() or .KwProtected() or .KwPrivate() then {
                return .Error(
                    self.parser_error_at_current(
                        "Access modifier on trait method is not supported",
                    ),
                );
            },
            _ then {},
        };
        let name_token = self.current();
        let name = self.expect_identifier("trait member") or return;
        if not self.is_valid_value_name(name) then {
            return .Error(
                self.parser_error_at(self.invalid_function_name_error(name), name_token),
            );
        };
        let type_params = self.parse_type_parameters() or return;

        when self.current().kind in {
            .LParen() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error("Expected '(' in trait member declaration"),
                );
            },
        };

        let params = self.parse_param_list(trait_name + "." + name, false) or return;

        when self.current().kind in {
            .RParen() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error("Expected ')' after trait member parameters"),
                );
            },
        };

        if self.current().kind is .Colon() then {
            self.advance();
        } else {
            return .Error(
                self.parser_error(
                    "Missing return type: function and method declarations must explicitly declare a return type",
                ),
            );
        };
        let mutable return_type = self.parse_type() or return;

        if self.current().kind is .Assign() then {
            return .Error(self.parser_error("trait member cannot have a body"));
        };

        return .Ok(TraitMember(name, type_params, trait_access, params, return_type));
    };

    parse_given_member(
        self,
        allow_body: Bool,
        target_type_name: String,
    ): Result[GivenMember] = {
        let access = self.parse_access_modifier(AccessModifier.Internal()) or return;
        let name_token = self.current();
        let name = self.expect_identifier("given member") or return;
        if not self.is_valid_value_name(name) then {
            return .Error(
                self.parser_error_at(self.invalid_function_name_error(name), name_token),
            );
        };
        let type_params = self.parse_type_parameters() or return;

        when self.current().kind in {
            .LParen() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error("Expected '(' in given member declaration"),
                );
            },
        };

        let params = self.parse_param_list(target_type_name + "." + name, false) or return;

        when self.current().kind in {
            .RParen() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error("Expected ')' after given member parameters"),
                );
            },
        };

        if self.current().kind is .Colon() then {
            self.advance();
        } else {
            return .Error(
                self.parser_error(
                    "Missing return type: function and method declarations must explicitly declare a return type",
                ),
            );
        };
        let mutable return_type = self.parse_type() or return;

        let mutable body = Option[Expr].None();
        if self.current().kind is .Assign() then {
            if not allow_body then {
                return .Error(
                    self.parser_error("intrinsic given member cannot have a body"),
                );
            };
            self.advance();
            // Propagate the nested failure as-is. Folding it into a new message
            // would have to flatten a diagnostic that already has its own span
            // and stage into a bare string, and the wrapper's location would
            // then stand in for one that was more precise.
            let expr = self.parse_expression_checked("given member body") or return;
            body = .Some(expr);
        };

        return .Ok(
            GivenMember(
                name,
                type_params,
                access,
                params,
                return_type,
                body,
                def_id_invalid(),
            ),
        );
    };

    parse_trait_members(
        self,
        trait_name: String,
        trait_access: AccessModifier,
    ): Result[List[TraitMember]] = {
        let mutable members = List[TraitMember].new();

        while true then {
            when self.current().kind in {
                .RBrace() then {
                    self.advance();
                    break;
                },
                .Semicolon() then {
                    self.advance();
                },
                .Eof() then {
                    return .Error(
                        self.parser_error("Unexpected EOF in trait declaration"),
                    );
                },
                _ then {
                    // Propagate: the nested failure already has a span and a
                    // message of its own (see the note in parse_given_member).
                    let member = self.parse_trait_member(trait_name, trait_access) or return;
                    let _ = self.require_semicolon() or return;
                    members.push(member);
                },
            };
        };

        return .Ok(members);
    };

    parse_given_members(
        self,
        allow_body: Bool,
        target_type_name: String,
    ): Result[List[GivenMember]] = {
        let mutable members = List[GivenMember].new();

        while true then {
            when self.current().kind in {
                .RBrace() then {
                    self.advance();
                    break;
                },
                .Semicolon() then {
                    self.advance();
                },
                .Eof() then {
                    return .Error(
                        self.parser_error("Unexpected EOF in given declaration"),
                    );
                },
                _ then {
                    // Propagate: the nested failure already has a span and a
                    // message of its own (see the note in parse_given_member).
                    let member = self.parse_given_member(allow_body, target_type_name) or return;
                    let _ = self.require_semicolon() or return;
                    members.push(member);
                },
            };
        };

        return .Ok(members);
    };

    /// `{ … }` -- the filter on an import (§3.3).
    ///
    /// Omitting the braces is a merge (§3.2); writing them is an import, and the
    /// list says which members come along. Six forms:
    ///
    ///     { }                  nothing at all (a placeholder while editing)
    ///     { a, b }             exactly these
    ///     { a as b }           exactly these, one renamed
    ///     { ... }              every visible member
    ///     { a as b, ... }      every member, `a` spelled `b`
    ///     { !a, !b, ... }      every member but `a` and `b`
    ///
    /// `...` is the base set. Items alongside it are renames (positive) or
    /// exclusions (`!`), never both; a positive item without `as` next to `...`
    /// is redundant and rejected.
    parse_using_import_list(
        self,
        specifier: String,
        is_file_merge: Bool,
    ): Result[UsingImportList] = {
        let brace_token = self.current();
        self.advance();
        let mutable items = List[UsingModuleItem].new();
        let mutable import_all = false;
        let mutable saw_exclude = false;
        let mutable saw_positive = false;

        while self.current().kind is not .RBrace() then {
            if self.current().kind is .Range() then {
                // `{ .. }` used to mean "everything" and `...` means it now (§3.3).
                return .Error(
                    self.parser_error_at(
                        "\"..\" is not an import item; write \"...\" to import every visible member of \"\(specifier)\"",
                        self.current(),
                    ),
                );
            };
            if self.current().kind is .Ellipsis() then {
                // `...` is the base set and closes the list: renames and
                // exclusions come before it, nothing comes after (§3.3).
                self.advance();
                import_all = true;
                if self.current().kind is .Comma() then {
                    self.advance();
                };
                if self.current().kind is not .RBrace() then {
                    return .Error(
                        self.parser_error_at(
                            "\"...\" closes the import list; put renames or exclusions before it, or write \"{ ... }\"",
                            self.current(),
                        ),
                    );
                };
                self.advance();
                return self.finish_import_list(
                    specifier,
                    items,
                    true,
                    saw_exclude,
                    saw_positive,
                    brace_token,
                    is_file_merge,
                );
            };

            let name_token = self.current();
            let mutable excluded = false;
            if self.current().kind is .Bang() then {
                self.advance();
                excluded = true;
                saw_exclude = true;
            } else {
                saw_positive = true;
            };
            let name = self.expect_identifier("import item") or return;

            let alias = when self.current().kind in {
                .KwAs() then {
                    if excluded then {
                        return .Error(
                            self.parser_error_at(
                                "'!\(name)' is an exclusion and cannot be renamed; drop the '!' or drop the 'as'",
                                name_token,
                            ),
                        );
                    };
                    self.advance();
                    let alias_name = self.expect_identifier("using alias") or return;
                    let name_is_upper = self.is_upper_first(name);
                    let alias_is_upper = self.is_upper_first(alias_name);
                    if name_is_upper != alias_is_upper then {
                        if name_is_upper then {
                            return .Error(
                                self.parser_error_at(
                                    "Using alias '\(alias_name)' is invalid: alias must start with an uppercase letter because referenced identifier '\(name)' starts with uppercase",
                                    name_token,
                                ),
                            );
                        };
                        return .Error(
                            self.parser_error_at(
                                "Using alias '\(alias_name)' is invalid: alias must start with a lowercase letter because referenced identifier '\(name)' starts with lowercase",
                                name_token,
                            ),
                        );
                    };
                    Option[String].Some(alias_name)
                },
                _ then Option[String].None(),
            };

            items.push(UsingModuleItem(name, alias, excluded));

            when self.current().kind in {
                .Comma() then {
                    self.advance();
                },
                .RBrace() then {},
                _ then {
                    return .Error(
                        self.parser_error("Expected ',' or '}' in using declaration"),
                    );
                },
            };
        };

        self.advance();
        return self.finish_import_list(
            specifier,
            items,
            false,
            saw_exclude,
            saw_positive,
            brace_token,
            is_file_merge,
        );
    };

    /// Validate one import list's shape once its items and base set are known
    /// (§3.3). `is_file_merge` covers the bare caller path where no brace was
    /// read -- a merge has no member surface to filter.
    finish_import_list(
        self,
        specifier: String,
        items: List[UsingModuleItem],
        import_all: Bool,
        saw_exclude: Bool,
        saw_positive: Bool,
        brace_token: Token,
        is_file_merge: Bool,
    ): Result[UsingImportList] = {
        let _ = is_file_merge;

        if saw_exclude and saw_positive then {
            return .Error(
                self.parser_error_at(
                    "an import list is either all-positive or all-exclusions; '{ !a, ... }' and '{ a as b, ... }' do not mix",
                    brace_token,
                ),
            );
        };
        if saw_exclude and not import_all then {
            return .Error(
                self.parser_error_at(
                    "'!' excludes from the whole module surface and needs '...'; write '{ !name, ... }'",
                    brace_token,
                ),
            );
        };
        if import_all and saw_positive then {
            // A positive item beside `...` is only meaningful as a rename --
            // without `as` it is the whole surface renamed to itself.
            for item in items then {
                if not item.excluded and item.alias is .None() then {
                    return .Error(
                        self.parser_error_at(
                            "'\(item.name)' next to '...' is redundant; either drop it, rename it with 'as', or exclude it with '!'",
                            brace_token,
                        ),
                    );
                };
            };
        };
        return .Ok(UsingImportList(items, import_all));
    };

    /// A module's full name is `package[/subpath]`, lowercase identifier
    /// segments (§2.1). `.` is not a spelling of anything in source -- it is
    /// only how a manifest names a package's main module (§5.2).
    validate_module_specifier(self, specifier: String, token: Token): Result[Void] = {
        if specifier == "." then {
            return .Error(
                self.parser_error_at(
                    "write the package name itself for its main module; \".\" is only manifest notation",
                    token,
                ),
            );
        };
        // `split` drops empty segments, so `a//b` would look like `a/b`. Ask
        // for the parts without losing them (§7.5 lists empty segments).
        let mutable parts = List[String].new();
        let mutable current = StringBuilder.new();
        let mutable i: UInt = 0;
        while i < specifier.count() then {
            let ch = specifier[i];
            if ch == '/' then {
                parts.push(current.to_string());
                current = StringBuilder.new();
            } else {
                current.push_byte(ch);
            };
            i += 1;
        };
        parts.push(current.to_string());
        for segment in parts then {
            if segment.is_empty() then {
                return .Error(
                    self.parser_error_at(
                        "module name must be 'package[/subpath]' with lowercase identifier segments",
                        token,
                    ),
                );
            };
            let first = segment[UInt(0)];
            if first < 'a' or first > 'z' then {
                return .Error(
                    self.parser_error_at(
                        "module name must be 'package[/subpath]' with lowercase identifier segments",
                        token,
                    ),
                );
            };
            for i in 0..<segment.count() then {
                let ch = segment[i];
                let is_lower = ch >= 'a' and ch <= 'z';
                let is_digit = ch >= '0' and ch <= '9';
                let is_underscore = ch == '_';
                if not is_lower and not is_digit and not is_underscore then {
                    return .Error(
                        self.parser_error_at(
                            "module name must be 'package[/subpath]' with lowercase identifier segments",
                            token,
                        ),
                    );
                };
            };
        };
        return .Ok({});
    };

    /// Parse `using "<specifier>" ("{" items "}")?;`
    ///
    /// One form (§3). The specifier is a string; what it means is decided by
    /// its shape: `./` or `../` is a file to merge, anything else is a module's
    /// full name, `package[/subpath]`. The parser settles that here because
    /// every rule about the specifier is a rule about its spelling.
    parse_using_decl(
        self,
        access: AccessModifier,
        has_explicit_access: Bool,
    ): Result[Decl] = {
        let start = self.current();
        self.advance();

        if has_explicit_access then {
            return .Error(
                self.parser_error(
                    "access modifier on using declaration is not supported",
                ),
            );
        };

        let specifier_token = self.current();
        let mutable specifier = "";
        when self.current().kind in {
            .StringLiteral(text) then {
                specifier = text;
                self.advance();
            },
            _ then {
                return .Error(
                    self.unexpected_token_error_at(
                        token_kind_description(self.current()),
                        "a string literal: \"./file.koral\" to merge a file, or \"package[/subpath]\" to import a module",
                        self.current(),
                    ),
                );
            },
        };

        if self.current().kind is .KwAs() then {
            // `using "x" as Y;` was "merge this file and rename it". There is
            // no whole-module alias any more (§3.3: a module name is not a
            // namespace), so say where an alias does belong.
            return .Error(
                self.parser_error_at(
                    "a module is not renamed; alias the names you import: using \"\(specifier)\" { Name as Alias }",
                    specifier_token,
                ),
            );
        };

        let is_file_merge = specifier.starts_with("./") or specifier.starts_with("../") or specifier.starts_with(
            ".\\",
        ) or specifier.starts_with("..\\");

        let mutable items = Option[List[UsingModuleItem]].None();
        let mutable import_all = false;
        if self.current().kind is .LBrace() then {
            let parsed = self.parse_using_import_list(specifier, is_file_merge) or return;
            items = Option[List[UsingModuleItem]].Some(parsed.items);
            import_all = parsed.import_all;
        };

        if is_file_merge then {
            // A local path may be merged (bare) or imported (braces). Either
            // way it names the module rooted at that entry file (§3.1); the
            // braces decide only whether the boundary survives.
            if not specifier.ends_with(".koral") then {
                return .Error(
                    self.parser_error_at(
                        "File merge path must end in '.koral'; write '\(specifier).koral'",
                        specifier_token,
                    ),
                );
            };
        } else {
            self.validate_module_specifier(specifier, specifier_token) or return;
        };

        // `<using-decl>` ends with `;` like every other declaration
        // (grammar.bnf). It used to go unchecked here, which made `using "x"`
        // compile while every other declaration demanded its terminator.
        self.require_semicolon() or return;

        return .Ok(
            Decl.UsingDecl(specifier, items, import_all, self.span_from_start(start)),
        );
    };

    parse_trait_decl(self, access: AccessModifier): Result[Decl] = {
        let start = self.current();
        self.advance();
        let name_token = self.current();
        let name = self.expect_identifier("trait declaration") or return;
        if not self.is_upper_first(name) then {
            return .Error(
                self.parser_error_at(self.invalid_type_name_error(name), name_token),
            );
        };
        let type_params = self.parse_type_parameters() or return;

        let mutable parents = List[TypeNode].new();
        // Super traits: `Child: Parent and Parent2 { ... }` -- the colon
        // separates the trait from its parents.
        if self.current().kind is .Colon() then {
            self.advance();
            // `or return` propagates the inner parse diagnostic. A wrapper
            // message like "parse trait parent type error" would replace the
            // specific one and lose what actually went wrong.
            let parent = self.parse_type() or return;
            parents.push(parent);

            while self.current().kind is .KwAnd() then {
                self.advance();
                let next_parent = self.parse_type() or return;
                parents.push(next_parent);
            };
        };

        when self.current().kind in {
            .LBrace() then {
                self.advance();
            },
            _ then {
                return .Error(self.parser_error("Expected '{' in trait declaration"));
            },
        };

        let members = self.parse_trait_members(name, access) or return;
        let base = Decl.TraitDecl(
            access,
            name,
            type_params,
            parents,
            members,
            self.span_from_start(start),
            self.token_span(name_token),
        );
        // A trait declaration carries no `foreign` / `intrinsic` qualifier, so
        // there is nothing for `wrap_decl` to rewrite.
        return .Ok(base);
    };

    parse_given_decl(self, access: AccessModifier): Result[Decl] = {
        let start = self.current();
        self.advance();
        // `given intrinsic T { ... };` -- the qualifier sits right after `given`.
        let decl_qualifiers = self.parse_decl_qualifiers();
        let decl_is_foreign = decl_qualifiers.is_foreign;
        let decl_is_intrinsic = decl_qualifiers.is_intrinsic;
        let type_params = self.parse_type_parameters() or return;
        let mutable target_type = self.parse_type() or return;

        // Conformance: `given Target: Trait { ... }` -- the colon separates
        // the target type from the trait it satisfies.
        let mutable trait_type = Option[TypeNode].None();
        if self.current().kind is .Colon() then {
            self.advance();
            let mutable parsed_trait_type = self.parse_type() or return;
            trait_type = .Some(parsed_trait_type);
        };

        when self.current().kind in {
            .LBrace() then {
                self.advance();
            },
            _ then {
                return .Error(self.parser_error("Expected '{' in given declaration"));
            },
        };

        let target_name = type_node_name(target_type);
        let members = self.parse_given_members(not decl_is_intrinsic, target_name) or return;
        let base = if trait_type is .Some(t) then Decl.GivenTraitDecl(
            target_type,
            type_params,
            t,
            members,
            self.span_from_start(start),
        )
        else Decl.GivenDecl(target_type, type_params, members, self.span_from_start(
            start,
        ));
        return self.wrap_decl(access, decl_is_foreign, decl_is_intrinsic, base);
    };

    parse_top_level_decl(self): Result[Decl] = {
        let flags = self.parse_decl_flags();

        when flags.invalid_access_message in {
            .Some(message) then {
                return .Error(self.parser_error_at_current(message.to_string()));
            },
            .None() then {},
        };

        // `foreign` / `intrinsic` are written immediately after the keyword,
        // not before it. A bounded token peek reads them without disturbing the
        // branch parser that consumes the keyword -- no parse-and-rollback.
        let mutable qualifiers = DeclQualifiers(false, false, Option[String].None());
        when self.current().kind in {
            .KwLet() or .KwType() or .KwGiven() then {
                qualifiers = self.peek_decl_qualifiers_at(self.index + 1);
            },
            _ then {},
        };
        when qualifiers.invalid_message in {
            .Some(message) then {
                return .Error(self.parser_error_at_current(message));
            },
            .None() then {},
        };
        when self.current().kind in {
            .KwLet() then {
                return self.parse_let_decl(flags.access);
            },
            .KwType() then {
                return self.parse_type_decl(flags.access);
            },
            .KwUsing() then {
                let mutable using_access = AccessModifier.Private();
                if flags.has_explicit_access then {
                    using_access = flags.access;
                };
                return self.parse_using_decl(using_access, flags.has_explicit_access);
            },
            .KwTrait() then {
                return self.parse_trait_decl(flags.access);
            },
            .KwGiven() then {
                if flags.has_explicit_access then {
                    return .Error(
                        self.parser_error(
                            "Access modifier on given declaration is not supported",
                        ),
                    );
                };
                return self.parse_given_decl(flags.access);
            },
            _ then {
                let t = self.current();
                return .Error(
                    self.parser_error_at(
                        "Unexpected token: \(token_kind_description(t))",
                        t,
                    ),
                );
            },
        };
    };

    public parse_program(self): Result[Program] = {
        let mutable declarations = List[Decl].new();
        let mutable has_non_using_decl = false;

        while not self.is_eof() then {
            if self.current().kind is .Semicolon() then {
                self.advance();
                continue;
            };
            if self.is_eof() then {
                break;
            };
            let decl_start = self.current();
            let decl = self.parse_top_level_decl() or return;
            // Check that using declarations appear before other declarations.
            let is_using = when decl in {
                .UsingDecl(_, _, _, _) then true,
                _ then false,
            };
            if is_using then {
                if has_non_using_decl then {
                    // Blame the `using` keyword, not whatever token happens to
                    // follow the declaration -- that is the line to move.
                    return .Error(
                        self.parser_error_at(
                            "Using declarations must appear before other declarations",
                            decl_start,
                        ),
                    );
                };
            } else {
                has_non_using_decl = true;
            };
            declarations.push(decl);
        };

        return .Ok(Program(declarations));
    };
};

given Parser {

    /// Whether an interpolation's token list holds an expression to parse.
    /// An empty `\( )` still lexes to a bare end-of-input token, so counting
    /// tokens is not enough -- only a real token means there is one.
    private has_expression_tokens(self, tokens: List[Token]): Bool = {
        for t in tokens then {
            if t.kind is not .Eof() then {
                return true;
            };
        };
        return false;
    };

    parse_interpolated_string_expr(
        self,
        parts: List[InterpolatedStringTokenPart],
        span: SourceSpan,
    ): Result[Expr] = {
        let mutable ast_parts = List[InterpolatedStringPart].new();
        let mutable literal_value = StringBuilder.new();
        let mutable has_expression = false;

        for part in parts then {
            when part in {
                .Literal(part_value) then {
                    literal_value.push_string(part_value);
                    ast_parts.push(InterpolatedStringPart.Literal(part_value));
                },
                .ExpressionTokens(expr_tokens) then {
                    // An interpolation with no expression in it. The literal is
                    // well formed; the expression is what is missing, so it is a
                    // syntax complaint about the literal as a whole.
                    if not self.has_expression_tokens(expr_tokens) then {
                        return .Error(
                            self.parser_error_at_span(
                                "empty interpolation expression",
                                span,
                            ),
                        );
                    };
                    // Propagate: the nested failure already has a span and a
                    // message of its own (see the note in parse_given_member).
                    let expr = self.parse_embedded_expression(expr_tokens) or return;
                    ast_parts.push(InterpolatedStringPart.Expression(expr));
                    has_expression = true;
                },
            };
        };

        if not has_expression then {
            return .Ok(Expr.StringLiteral(literal_value.to_string(), span));
        };
        return .Ok(Expr.InterpolatedString(ast_parts, span));
    };

    parse_string_literal_expr(self, value: String, span: SourceSpan): Result[Expr] = {
        return .Ok(Expr.StringLiteral(value, span));
    };

    parse_embedded_expression(self, expr_tokens: List[Token]): Result[Expr] = {
        let mutable token_list = List[Token].new();
        for token_ref in expr_tokens then {
            token_list.push(token_ref);
        };

        let mutable nested = Parser.new_in_file(token_list, self.file_path);
        // Propagate: the nested failure already has a span and a message of its
        // own (see the note in parse_given_member).
        let expr = nested.parse_expression() or return;

        if not nested.is_eof() then {
            return .Error(
                self.parser_error_at_current(
                    "trailing tokens in interpolation expression",
                ),
            );
        };

        return .Ok(expr);
    };
};

let token_text(token: Token): String = {
    return when token.kind in {
        .Identifier(name) then name,
        .IntegerLiteral(v) then v,
        .DurationLiteral(v, u) then "\(v)\(u)",
        .FloatLiteral(v) then v,
        .StringLiteral(v) then "\"\(v)\"",
        .InterpolatedString(_) then "<interpolated-string>",
        .RuneLiteral(v) then "'\(v)'",
        .KwLet() then "let",
        .KwMut() then "mutable",
        .KwType() then "type",
        .KwIf() then "if",
        .KwWhile() then "while",
        .KwFor() then "for",
        .KwWhen() then "when",
        .KwIs() then "is",
        .KwIn() then "in",
        .KwAs() then "as",
        .KwGiven() then "given",
        .KwTrait() then "trait",
        .KwIntrinsic() then "intrinsic",
        .KwForeign() then "foreign",
        .KwUsing() then "using",
        .KwPrivate() then "private",
        .KwInternal() then "internal",
        .KwProtected() then "protected",
        .KwPublic() then "public",
        .KwSelf() then "self",
        .KwSelfType() then "Self",
        .KwReturn() then "return",
        .KwBreak() then "break",
        .KwContinue() then "continue",
        .KwDefer() then "defer",
        .KwThen() then "then",
        .KwElse() then "else",
        .KwAnd() then "and",
        .KwOr() then "or",
        .KwNot() then "not",
        .KwTrue() then "true",
        .KwFalse() then "false",
        .KwNull() then "null",
        .KwUnsafe() then "unsafe",
        .KwWhere() then "where",
        .Plus() then "+",
        .Minus() then "-",
        .Star() then "*",
        .Slash() then "/",
        .Percent() then "%",
        .Ampersand() then "&",
        .Pipe() then "|",
        .Caret() then "^",
        .Tilde() then "~",
        .LeftShift() then "<<",
        .RightShift() then ">>",
        .Assign() then "=",
        .PlusAssign() then "+=",
        .MinusAssign() then "-=",
        .StarAssign() then "*=",
        .SlashAssign() then "/=",
        .PercentAssign() then "%=",
        .AmpersandAssign() then "&=",
        .PipeAssign() then "|=",
        .CaretAssign() then "^=",
        .LeftShiftAssign() then "<<=",
        .RightShiftAssign() then ">>=",
        .EqualEqual() then "==",
        .NotEqual() then "!=",
        .Greater() then ">",
        .Less() then "<",
        .GreaterEqual() then ">=",
        .LessEqual() then "<=",
        .Comma() then ",",
        .Dot() then ".",
        .Ellipsis() then "...",
        .DoubleColon() then "::",
        .Colon() then ":",
        .Semicolon() then ";",
        .LParen() then "(",
        .RParen() then ")",
        .LBracket() then "[",
        .RBracket() then "]",
        .LBrace() then "{",
        .RBrace() then "}",
        .Range() then "..",
        .RangeLess() then "..<",
        .LessRange() then "<..",
        .LessRangeLess() then "<..<",
        .EllipsisLt() then "...<",
        .LtEllipsis() then "<...",
        .Arrow() then "->",
        .FatArrow() then "=>",
        .Bang() then "!",
        .QuestionMark() then "?",
        .Eof() then "<eof>",
    };
};

let token_kind_description(token: Token): String = {
    return when token.kind in {
        .Identifier(name) then "Identifier(\(name))",
        .IntegerLiteral(v) then "Integer(\(v))",
        .FloatLiteral(v) then "Float(\(v))",
        .StringLiteral(v) then "String(\(v))",
        .RuneLiteral(v) then "Rune('\(v)')",
        _ then token_text(token),
    };
};

public let parse(tokens: List[Token]): Result[Program] = {
    let mutable parser = Parser.new(tokens);
    return parser.parse_program();
};

public let parse_in_file(tokens: List[Token], file_path: String): Result[Program] = {
    let mutable parser = Parser.new_in_file(tokens, file_path);
    // Pass the failure through untouched. It already carries its own stage and
    // span; re-wrapping it as a fresh `Parser` diagnostic with `unknown_span()`
    // threw the span away and flattened the message.
    return parser.parse_program();
};
