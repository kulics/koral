using "std/os" { ... };

public type DeclQualifiers(
    is_foreign Bool,
    is_intrinsic Bool,
    invalid_message Option[String],
);

private type ParseDeclFlags(
    access AccessModifier,
    has_explicit_access Bool,
    invalid_access_message Option[String],
);

public type mutable Parser(
    tokens List[Token],
    file_path String,
    mutable index UInt,
    mutable pending_statements List[Statement],
);

given Parser {
    parse_debug(self, message String) Void = {
        if env("KORAL_DEBUG_PARSE") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            eprintln("[parse] \(message)");
        };
    };

    token_position_text(self, token Token) String = {
        let _ = self;
        let mutable text = StringBuilder.new();
        text.push_string(token.line.to_string());
        text.push_byte(':');
        text.push_string(token.column.to_string());
        return text.to_string();
    };

    format_context_position_error(
        self,
        prefix String,
        context String,
        token Token,
    ) String = {
        let mutable text = StringBuilder.new();
        text.push_string(prefix);
        text.push_string(context);
        if self.file_path.is_empty() then {
            text.push_string(" at ");
            text.push_string(self.token_position_text(token));
        };
        return text.to_string();
    };

    format_progress_error(
        self,
        prefix String,
        context String,
        token Token,
    ) String = {
        let mutable text = StringBuilder.new();
        text.push_string(self.format_context_position_error(prefix, context, token));
        text.push_string(" (token: ");
        text.push_string(token_text(token));
        text.push_byte(')');
        return text.to_string();
    };

    parser_error_at(self, message String, token Token) DiagnosticError = {
        return make_diagnostic(
            DiagnosticStage.Parser(),
            self.file_path,
            message,
            self.token_span(token),
        );
    };

    parser_error(self, message String) DiagnosticError = {
        return self.parser_error_at(message.to_string(), self.current());
    };

    /// Report a wrong TOKEN: say what was found and what the grammar wanted
    /// there. A rejected construct -- tokens legal, the shape disallowed --
    /// reports a bare sentence through `parser_error` instead, because
    /// `Unexpected token: <sentence>, expected: ...` reads as if the sentence
    /// were a token.
    unexpected_token_error_at(
        self,
        got String,
        expected String,
        token Token,
    ) DiagnosticError = {
        return self.parser_error_at(
            "Unexpected token: \(got), expected: \(expected)",
            token,
        );
    };

    /// Report a parse error anchored at the CURRENT token.
    ///
    /// Every parse error carries a source location -- Swift's always does, and a
    /// diagnostic with no line/column cannot be acted on. This used to build a
    /// span-less diagnostic, so 75 error paths printed bare `syntax error: msg`
    /// with no `file:line:col`.
    parser_error_at_current(self, message String) DiagnosticError = {
        return self.parser_error_at(message.to_string(), self.current());
    };

    /// Report a parse error anchored at a SPAN the parser already consumed.
    ///
    /// `parser_error_at` blames a token, which is right for a wrong token. For
    /// a failure inside a construct that has been read whole -- an
    /// interpolation inside a string literal -- the cursor has moved past the
    /// place the complaint is about.
    parser_error_at_span(
        self,
        message String,
        span SourceSpan,
    ) DiagnosticError = {
        return make_diagnostic(DiagnosticStage.Parser(), self.file_path, message, span);
    };

    previous_token(self) Option[Token] = {
        if self.index == 0 then {
            return .None();
        };
        return .Some(self.tokens[self.index - 1]);
    };

    span_from_start(self, start Token) SourceSpan = {
        let start_loc = SourceLocation(start.line, start.column);
        let end_tok = self.previous_token() or else {
            return SourceSpan(start_loc, start_loc);
        };
        let end_loc = SourceLocation(end_tok.line, end_tok.column);
        return SourceSpan(start_loc, end_loc);
    };

    token_span(self, token Token) SourceSpan = {
        let loc = SourceLocation(token.line, token.column);
        return SourceSpan(loc, loc);
    };

    span_from_expr_start(self, expr Expr) SourceSpan = {
        let expr_base_span = expr_span(expr);
        let end_tok = self.previous_token() or else {
            return expr_base_span;
        };
        if not is_known_span(expr_base_span) then {
            let end_loc = SourceLocation(end_tok.line, end_tok.column);
            return SourceSpan(end_loc, end_loc);
        };
        let end_loc = SourceLocation(end_tok.line, end_tok.column);
        return SourceSpan(expr_base_span.start, end_loc);
    };

    is_decimal_digits(self, text String) Bool = {
        let runes = text.to_runes();
        if runes.is_empty() then {
            return false;
        };
        for r in runes then {
            if not r.is_ascii_digit() then {
                return false;
            };
        };
        return true;
    };

    pattern_from_text(self, text String, span SourceSpan) PatternNode = {
        if text == "_" then {
            return PatternNode.Wildcard(span);
        };
        if text == "true" then {
            return PatternNode.BoolLiteral(true, span);
        };
        if text == "false" then {
            return PatternNode.BoolLiteral(false, span);
        };
        if self.is_decimal_digits(text) then {
            return PatternNode.IntegerLiteral(text, span);
        };
        if text.starts_with("mutable ") then {
            let name = text.substring(4...);
            if not name.is_empty() then {
                return PatternNode.Variable(name, true, span);
            };
        };
        if text.starts_with(".") then {
            let rest = text.substring(1...);
            // 检查是否有括号参数：". SomeName ( ... )"
            when rest.find("(") in {
                .Some(lparen_idx) then {
                    let case_name = rest.substring(0..<lparen_idx).trim_ascii();
                    // 找最后一个 ')'
                    when rest.find_last(")") in {
                        .Some(rparen_idx) then {
                            let inner = rest.substring(lparen_idx + 1..<rparen_idx).trim_ascii(
                            );
                            let mutable elements = List[PatternElement].new();
                            if not inner.is_empty() then {
                                // 按逗号分割，每个子 pattern 递归解析
                                let parts = self.split_pattern_args(inner);
                                for part in parts then {
                                    let trimmed = part.trim_ascii();
                                    if not trimmed.is_empty() then {
                                        elements.push(
                                            PatternElement(
                                                Option[String].None(),
                                                self.pattern_from_text(trimmed, span),
                                            ),
                                        );
                                    };
                                };
                            };
                            return PatternNode.EnumCase(case_name, elements, span);
                        },
                        .None() then {},
                    };
                },
                .None() then {
                    let case_name = rest.trim_ascii();
                    if not case_name.is_empty() then {
                        return PatternNode.EnumCase(
                            case_name,
                            List[PatternElement].new(),
                            span,
                        );
                    };
                },
            };
        };
        return PatternNode.Variable(text, false, span);
    };

    // 按顶层逗号分割 pattern 参数列表（忽略括号内的逗号）
    split_pattern_args(self, text String) List[String] = {
        let mutable result = List[String].new();
        let mutable current = StringBuilder.new();
        let mutable depth UInt = 0;
        let runes = text.to_runes();
        for ch in runes then {
            if ch == '(' or ch == '[' then {
                depth += 1;
                current.push_rune(ch);
            } else if ch == ')' or ch == ']' then {
                if depth > 0 then {
                    depth -= 1;
                };
                current.push_rune(ch);
            } else if ch == ',' and depth == 0 then {
                result.push(current.to_string());
                current = StringBuilder.new();
            } else {
                current.push_rune(ch);
            };
        };
        if not current.to_string().trim_ascii().is_empty() then {
            result.push(current.to_string());
        };
        return result;
    };

    public new(tokens List[Token]) Parser = {
        return Parser(tokens, "", 0, List[Statement].new());
    };

    public new_in_file(tokens List[Token], file_path String) Parser = {
        return Parser(
            tokens,
            file_path,
            0,
            List[Statement].new(),
        );
    };

    current(self) Token = {
        if self.index < self.tokens.count() then {
            return self.tokens[self.index];
        };
        return Token(TokenKind.Eof(), 0, 0, false);
    };

    save_state(self) UInt = self.index;

    restore_state(self, saved UInt) Void = {
        self.index = saved;
    };

    peek_kind(self) Option[TokenKind] = {
        if self.index + 1 < self.tokens.count() then {
            return .Some(self.tokens[self.index + 1].kind);
        };
        return .None();
    };

    next_is_colon(self) Bool = {
        if self.index + 1 >= self.tokens.count() then {
            return false;
        };
        return self.tokens[self.index + 1].kind is .Colon();
    };

    current_labeled_argument_name(
        self,
        allow_underscore Bool,
    ) Option[String] = {
        return when self.current().kind in {
            .Identifier(label) then {
                if self.is_upper_first(label) then {
                    return Option[String].None();
                };
                if not allow_underscore and label == "_" then {
                    return Option[String].None();
                };
                if self.next_is_colon() then {
                    return Option[String].Some(label);
                };
                Option[String].None()
            },
            _ then Option[String].None(),
        };
    };

    next_is_then(self) Bool = {
        if self.index + 1 >= self.tokens.count() then {
            return false;
        };
        return self.tokens[self.index + 1].kind is .KwThen();
    };

    next_is_else(self) Bool = {
        if self.index + 1 >= self.tokens.count() then {
            return false;
        };
        return self.tokens[self.index + 1].kind is .KwElse();
    };

    next_is_return(self) Bool = {
        if self.index + 1 >= self.tokens.count() then {
            return false;
        };
        return self.tokens[self.index + 1].kind is .KwReturn();
    };

    is_eof(self) Bool = {
        when self.current().kind in {
            .Eof() then {
                return true;
            },
            _ then {
                return false;
            },
        };
    };

    // Range bounds start at the comparison-operand layer, not the full expression grammar.
    can_start_range_bound(self, kind TokenKind) Bool = {
        return when kind in {
            .Identifier(_) then true,
            .IntegerLiteral(_) then true,
            .DurationLiteral(_, _) then true,
            .FloatLiteral(_) then true,
            .StringLiteral(_) then true,
            .InterpolatedString(_) then true,
            .RuneLiteral(_) then true,
            .KwTrue() then true,
            .KwFalse() then true,
            .KwNull() then true,
            .LParen() then true,
            .LBrace() then true,
            .LBracket() then true,
            .Minus() then true,
            .Tilde() then true,
            .Star() then true,
            .Ampersand() then true,
            .KwIf() then true,
            .KwWhile() then true,
            .KwFor() then true,
            .KwWhen() then true,
            .KwSelf() then true,
            .Dot() then true,
            _ then false,
        };
    };

    // 检查当前位置是否是泛型类型表达式 [T, U]TypeName
    // 判断字符串首字母是否大写（用于区分类型名和变量名）
    is_upper_first(self, s String) Bool = {
        let runes = s.to_runes();
        if runes.is_empty() then {
            return false;
        };
        let mutable i UInt = 0;
        while i < runes.count() then {
            let ch = runes[i];
            if ch == '_' then {
                i += 1;
                continue;
            };
            return ch.is_ascii_uppercase();
        };
        return false;
    };

    is_lower_first(self, s String) Bool = {
        let runes = s.to_runes();
        if runes.is_empty() then {
            return false;
        };
        let mutable i UInt = 0;
        while i < runes.count() then {
            let ch = runes[i];
            if ch == '_' then {
                i += 1;
                continue;
            };
            return ch.is_ascii_lowercase();
        };
        return false;
    };

    is_valid_value_name(self, s String) Bool = {
        if s.is_empty() then {
            return false;
        };
        let runes = s.to_runes();
        if runes.is_empty() then {
            return false;
        };
        let mutable all_underscore = true;
        for ch in runes then {
            if ch != '_' then {
                all_underscore = false;
                break;
            };
        };
        return all_underscore or self.is_lower_first(s);
    };

    is_valid_module_segment_name(self, s String) Bool = {
        if s.is_empty() then {
            return false;
        };
        let runes = s.to_runes();
        if runes.is_empty() then {
            return false;
        };
        let first = runes[0];
        if not first.is_ascii_lowercase() then {
            return false;
        };
        let mutable i UInt = 1;
        while i < runes.count() then {
            let ch = runes[i];
            if not ch.is_ascii_lowercase() and not ch.is_ascii_digit() and ch != '_' then {
                return false;
            };
            i += 1;
        };
        return true;
    };

    invalid_variable_name_error(self, name String) String =
        "Variable name '\(name)' must start with a lowercase letter";
    invalid_function_name_error(self, name String) String =
        "Function name '\(name)' must start with a lowercase letter";
    invalid_type_name_error(self, name String) String =
        "Type name '\(name)' must start with an uppercase letter";
    invalid_field_name_error(self, name String) String =
        "Field name '\(name)' must start with a lowercase letter";
    invalid_parameter_name_error(self, name String) String =
        "Parameter name '\(name)' must start with a lowercase letter";
    invalid_enum_case_name_error(self, name String) String =
        "Enum case name '\(name)' must start with an uppercase letter";
    invalid_module_name_error(self, name String) String =
        "Module name '\(name)' must start with a lowercase letter";

    advance(self) Token = {
        let t = self.current();
        if not self.is_eof() then {
            self.index += 1;
        };
        return t;
    };

    consume_semicolon(self) Void = {
        if self.current().kind is .Semicolon() then {
            self.advance();
        };
    };

    require_semicolon(self) Result[Void] = {
        if self.current().kind is .Semicolon() then {
            self.advance();
            return .Ok({});
        };
        return .Error(
            self.parser_error(
                "Unexpected token: \(token_kind_description(self.current())), expected: ';'",
            ),
        );
    };

    can_continue_dot_postfix(self) Bool = self.current().kind is .Dot();

    should_continue_postfix_after_expression(self) Bool = {
        return when self.current().kind in {
            .LParen() then true,
            .LBracket() then true,
            .Dot() then self.can_continue_dot_postfix(),
            _ then false,
        };
    };

    expect_identifier(self, label String) Result[String] = {
        let t = self.current();
        if t.kind is .Identifier(name) then {
            self.advance();
            return .Ok(name);
        };
        return .Error(
            self.parser_error_at(
                "\(self.format_context_position_error("Expected identifier for ", label, t)), got: \(token_kind_description(t))",
                t,
            ),
        );
    };

    /// Read the `foreign` / `intrinsic` qualifiers written immediately after a
    /// declaration's keyword. They qualify the thing being declared -- where its
    /// definition lives -- so they sit in the slot right after the keyword, the
    /// slot `type mutable` and `let mutable` established. Access modifiers stay
    /// in the prefix slot: they say who can see the declaration, not what kind
    /// of thing it is. The two are mutually exclusive and may not repeat.
    /// The same qualifiers, read as a bounded token peek from `start_index`.
    /// Reads the buffer only -- never moves the cursor -- so a caller that just
    /// needs to know what is there does not have to parse and roll back.
    peek_decl_qualifiers_at(self, start_index UInt) DeclQualifiers = {
        let mutable is_foreign = false;
        let mutable is_intrinsic = false;
        let mutable invalid_message = Option[String].None();
        let mutable i = start_index;
        let mutable done = false;
        while not done then {
            if i >= self.tokens.count() then {
                done = true;
                continue;
            };
            when self.tokens[i].kind in {
                .KwForeign() then {
                    if is_foreign then {
                        if invalid_message is .None() then {
                            invalid_message = .Some(
                                "Duplicate declaration modifier: foreign",
                            );
                        };
                        done = true;
                    } else if is_intrinsic then {
                        if invalid_message is .None() then {
                            invalid_message = .Some(
                                "foreign and intrinsic cannot be used together",
                            );
                        };
                        done = true;
                    } else {
                        is_foreign = true;
                        i += 1;
                    };
                },
                .KwIntrinsic() then {
                    if is_intrinsic then {
                        if invalid_message is .None() then {
                            invalid_message = .Some(
                                "Duplicate declaration modifier: intrinsic",
                            );
                        };
                        done = true;
                    } else if is_foreign then {
                        if invalid_message is .None() then {
                            invalid_message = .Some(
                                "foreign and intrinsic cannot be used together",
                            );
                        };
                        done = true;
                    } else {
                        is_intrinsic = true;
                        i += 1;
                    };
                },
                _ then {
                    done = true;
                },
            };
        };
        return DeclQualifiers(is_foreign, is_intrinsic, invalid_message);
    };

    parse_decl_qualifiers(self) DeclQualifiers = {
        let mutable is_foreign = false;
        let mutable is_intrinsic = false;
        let mutable invalid_message = Option[String].None();
        while true then {
            when self.current().kind in {
                .KwForeign() then {
                    if is_foreign then {
                        if invalid_message is .None() then {
                            invalid_message = .Some(
                                "Duplicate declaration modifier: foreign",
                            );
                        };
                        break;
                    };
                    if is_intrinsic then {
                        if invalid_message is .None() then {
                            invalid_message = .Some(
                                "foreign and intrinsic cannot be used together",
                            );
                        };
                        break;
                    };
                    is_foreign = true;
                    self.advance();
                },
                .KwIntrinsic() then {
                    if is_intrinsic then {
                        if invalid_message is .None() then {
                            invalid_message = .Some(
                                "Duplicate declaration modifier: intrinsic",
                            );
                        };
                        break;
                    };
                    if is_foreign then {
                        if invalid_message is .None() then {
                            invalid_message = .Some(
                                "foreign and intrinsic cannot be used together",
                            );
                        };
                        break;
                    };
                    is_intrinsic = true;
                    self.advance();
                },
                _ then {
                    break;
                },
            };
        };
        return DeclQualifiers(is_foreign, is_intrinsic, invalid_message);
    };

    /// The migration complaint for a legacy access-modifier spelling.
    ///
    /// `file_private` / `module_private` / `package_private` are free
    /// identifiers now; one written where a declaration header CONTINUES after
    /// it is an attempt to use the old modifier, not a name. A name position is
    /// left alone: `let file_private = 1` and `type T(file_private: Int)` name
    /// their declarations and keep working.
    legacy_access_modifier_message(self) Option[String] = {
        let mutable name = "";
        when self.current().kind in {
            .Identifier(text) then {
                name = text;
            },
            _ then {
                return Option[String].None();
            },
        };
        let mutable message = "";
        when name in {
            "file_private" then {
                message = "Access modifier is 'private', not legacy 'file_private'";
            },
            "module_private" then {
                message = "Access modifier is 'internal', not legacy 'module_private'";
            },
            "package_private" then {
                message = "Access modifier is 'protected', not legacy 'package_private'";
            },
            _ then {
                return Option[String].None();
            },
        };
        if not self.next_token_opens_declaration_item() then {
            return Option[String].None();
        };
        return Option[String].Some(message);
    };

    /// The next token starts what a modifier slot modifies: another modifier, a
    /// declaration keyword, or the declared NAME. When the next token instead
    /// completes the current identifier AS a name (`:`, `(`, `[`, a type after a
    /// positional field name, ...) the identifier is a name, not a modifier.
    next_token_opens_declaration_item(self) Bool = {
        if self.index + 1 >= self.tokens.count() then {
            return false;
        };
        return when self.tokens[self.index + 1].kind in {
            .KwLet() or .KwType() or .KwUsing() or .KwTrait() or .KwGiven() or .KwMut() or .KwForeign() or .KwIntrinsic() or .KwPublic() or .KwInternal() or .KwProtected() or .KwPrivate() then true,
            .Identifier(next_name) then self.is_valid_value_name(next_name),
            _ then false,
        };
    };

    parse_decl_flags(self) ParseDeclFlags = {
        let mutable access = AccessModifier.Internal();
        let mutable has_explicit_access = false;
        let mutable invalid_access_message = Option[String].None();

        while true then {
            when self.current().kind in {
                .KwPublic() then {
                    if has_explicit_access then {
                        let previous = when access in {
                            .Public() then "public",
                            .Internal() then "internal",
                            .Protected() then "protected",
                            .Private() then "private",
                        };
                        if invalid_access_message is .None() then {
                            invalid_access_message = .Some(
                                "Invalid access modifier order: '\(previous) public'.",
                            );
                        };
                        break;
                    };
                    has_explicit_access = true;
                    access = AccessModifier.Public();
                    self.advance();
                },
                .KwInternal() then {
                    if has_explicit_access then {
                        let previous = when access in {
                            .Public() then "public",
                            .Internal() then "internal",
                            .Protected() then "protected",
                            .Private() then "private",
                        };
                        if invalid_access_message is .None() then {
                            invalid_access_message = .Some(
                                "Invalid access modifier order: '\(previous) internal'.",
                            );
                        };
                        break;
                    };
                    has_explicit_access = true;
                    access = AccessModifier.Internal();
                    self.advance();
                },
                .KwProtected() then {
                    if has_explicit_access then {
                        let previous = when access in {
                            .Public() then "public",
                            .Internal() then "internal",
                            .Protected() then "protected",
                            .Private() then "private",
                        };
                        if invalid_access_message is .None() then {
                            invalid_access_message = .Some(
                                "Invalid access modifier order: '\(previous) protected'.",
                            );
                        };
                        break;
                    };
                    has_explicit_access = true;
                    access = AccessModifier.Protected();
                    self.advance();
                },
                .KwPrivate() then {
                    if has_explicit_access then {
                        let previous = when access in {
                            .Public() then "public",
                            .Internal() then "internal",
                            .Protected() then "protected",
                            .Private() then "private",
                        };
                        if invalid_access_message is .None() then {
                            invalid_access_message = .Some(
                                "Invalid access modifier order: '\(previous) private'.",
                            );
                        };
                        break;
                    };
                    has_explicit_access = true;
                    access = AccessModifier.Private();
                    self.advance();
                },
                _ then {
                    // A legacy spelling in the modifier slot is an old spelling
                    // of the modifier, not the declaration's name -- the name
                    // comes after the declaration keyword and is never read
                    // here. Blame it before anything else gets to call it an
                    // unexpected token.
                    when self.legacy_access_modifier_message() in {
                        .Some(message) then {
                            if invalid_access_message is .None() then {
                                invalid_access_message = .Some(message);
                            };
                        },
                        .None() then {},
                    };
                    break;
                },
            };
        };

        // `foreign` / `intrinsic` are NOT prefix modifiers. They qualify the
        // thing being declared, so they sit in the slot right after the
        // keyword -- the slot `type mutable` and `let mutable` established --
        // and are read by `parse_decl_qualifiers` there. Access modifiers stay
        // in the prefix slot; they say who can see the declaration, not what
        // kind of thing it is.
        return ParseDeclFlags(access, has_explicit_access, invalid_access_message);
    };

    wrap_decl(
        self,
        access AccessModifier,
        is_foreign Bool,
        is_intrinsic Bool,
        base Decl,
    ) Result[Decl] = {
        if is_foreign then {
            return when base in {
                .FunctionDecl(_, name, _, params, return_type, _, span, name_span) then .Ok(
                    Decl.ForeignFunctionDecl(
                        access,
                        name,
                        params,
                        return_type,
                        span,
                        name_span,
                    ),
                ),
                .LetDecl(_, name, is_mutable, type_name, _, span, name_span) then when type_name in {
                    .Some(tn) then Result[Decl].Ok(
                        Decl.ForeignLetDecl(access, name, is_mutable, tn, span, name_span),
                    ),
                    .None() then Result[Decl].Error(
                        self.parser_error_at_current(
                            "foreign let declaration requires explicit type",
                        ),
                    ),
                },
                .TypeStructDecl(_, name, _, _, fields, span, name_span) then .Ok(
                    Decl.ForeignTypeDecl(
                        access,
                        name,
                        Option[List[Field]].Some(fields),
                        span,
                        name_span,
                    ),
                ),
                .GivenDecl(_, _, _, _) then .Error(
                    self.parser_error_at_current(
                        "foreign given declaration is not supported",
                    ),
                ),
                .GivenTraitDecl(_, _, _, _, _) then .Error(
                    self.parser_error_at_current(
                        "foreign given declaration is not supported",
                    ),
                ),
                _ then .Error(
                    self.parser_error_at_current("unsupported foreign declaration kind"),
                ),
            };
        };

        if is_intrinsic then {
            return when base in {
                .FunctionDecl(_, name, type_params, params, return_type, _, span, name_span) then .Ok(
                    Decl.IntrinsicFunctionDecl(
                        access,
                        name,
                        type_params,
                        params,
                        return_type,
                        span,
                        name_span,
                    ),
                ),
                .GivenDecl(target_type, type_params, members, span) then .Ok(
                    Decl.IntrinsicGivenDecl(target_type, type_params, members, span),
                ),
                .GivenTraitDecl(_, _, _, _, _) then .Error(
                    self.parser_error_at_current(
                        "intrinsic given trait declaration is not supported",
                    ),
                ),
                .TypeStructDecl(_, name, _, type_params, _, span, name_span) then .Ok(
                    Decl.IntrinsicTypeDecl(access, name, type_params, span, name_span),
                ),
                _ then .Error(
                    self.parser_error_at_current(
                        "unsupported intrinsic declaration kind",
                    ),
                ),
            };
        };
        return .Ok(base);
    };

    is_type_start(self) Bool = {
        return when self.current().kind in {
            .Star() then true,
            .QuestionMark() then true,
            .KwSelfType() then true,
            // A function type opens with its parameter list: `(T1, T2) -> R`.
            .LParen() then true,
            .Identifier(_) then true,
            _ then false,
        };
    };

    // ── 有界前看：形状归类 ─────────────────────────────────────────────────
    //
    // 解析歧义一律用「形状归类」决定，不用「试着解析、失败就回退」。后者要
    // 保存/恢复词法位置、要为每个分支实现一套失败路径，而且失败的分支会把
    // 更好的诊断吃掉。形状归类只读 token 缓冲、不建树、不改状态，回答一个
    // 有界问题：从某个下标起的 token 串是不是一个类型的形状，到哪里结束。
    //
    // 形状必须与 `parse_type` 接受的语法逐条对齐：类型前缀（`?`、`*`
    // [`mutable`]）+ 类型头（`Self`、大写标识符、`( ... )` 分组/函数类型），
    // 类型头后可跟 `[` 类型实参表 `]`。`*` + 类型头是类型；`*` + 其他是解引用。

    /// `*` + type-head (mutable, uppercase ident, Self) starts a pointer type.
    /// `*` + anything else is the dereference operator.
    index_followed_by_type_head_at(self, index UInt) Bool = {
        if index + 1 >= self.tokens.count() then {
            return false;
        };
        return when self.tokens[index + 1].kind in {
            .KwMut() then true,
            .KwSelfType() then true,
            .Identifier(name) then self.is_upper_first(name),
            _ then false,
        };
    };

    /// Whether the token after `*` / `?` at `index` starts the TYPE of a type
    /// application (`*Int(p)`, `?T(x)`) rather than a deref / upgrade operand.
    /// A `(` counts when it opens a parenthesized TYPE: either a function
    /// type's parameter list (`*(Int) -> Int(p)` is a cast) or a grouping
    /// (`*(Int)(p)` is a cast); `*(p)` is a deref.
    index_followed_by_type_application_at(self, index UInt) Bool = {
        if self.index_followed_by_type_head_at(index) then {
            return true;
        };
        if index + 1 >= self.tokens.count() or self.tokens[index + 1].kind is not .LParen() then {
            return false;
        };
        let after_params = self.scan_type_param_list_at(index + 1) or else {
            return self.scan_paren_type_suffix_at(index + 1) is .Some(_);
        };
        if after_params < self.tokens.count() and self.tokens[after_params].kind is .Arrow() then {
            return true;
        };
        return self.scan_paren_type_suffix_at(index + 1) is .Some(_);
    };

    /// The index just past a `[` ... `]` type argument list that starts at
    /// `start_index`, or `None` when the run is not exactly one.
    scan_type_list_at(self, start_index UInt) Option[UInt] = {
        if start_index >= self.tokens.count() then {
            return Option[UInt].None();
        };
        if self.tokens[start_index].kind is not .LBracket() then {
            return Option[UInt].None();
        };
        let mutable i = start_index + 1;
        if i < self.tokens.count() and self.tokens[i].kind is .RBracket() then {
            return Option[UInt].Some(i + 1);
        };
        let mutable done = false;
        let mutable result = Option[UInt].None();
        while not done then {
            let next = self.scan_type_shape_at(i) or else {
                done = true;
                result = Option[UInt].None();
                continue;
            };
            i = next;
            if i >= self.tokens.count() then {
                done = true;
                result = Option[UInt].None();
                continue;
            };
            when self.tokens[i].kind in {
                .Comma() then {
                    i += 1;
                    // A trailing comma is allowed: `[A, B,]`.
                    if i < self.tokens.count() and self.tokens[i].kind is .RBracket() then {
                        done = true;
                        result = Option[UInt].Some(i + 1);
                    };
                },
                .RBracket() then {
                    done = true;
                    result = Option[UInt].Some(i + 1);
                },
                _ then {
                    done = true;
                    result = Option[UInt].None();
                },
            };
        };
        return result;
    };

    /// The index just past a `(` ... `)` function-type parameter list that
    /// starts at `start_index`, or `None`.
    scan_type_param_list_at(self, start_index UInt) Option[UInt] = {
        if start_index >= self.tokens.count() then {
            return Option[UInt].None();
        };
        if self.tokens[start_index].kind is not .LParen() then {
            return Option[UInt].None();
        };
        let mutable i = start_index + 1;
        if i < self.tokens.count() and self.tokens[i].kind is .RParen() then {
            return Option[UInt].Some(i + 1);
        };
        let mutable done = false;
        let mutable result = Option[UInt].None();
        while not done then {
            let next = self.scan_type_shape_at(i) or else {
                done = true;
                result = Option[UInt].None();
                continue;
            };
            i = next;
            if i >= self.tokens.count() then {
                done = true;
                result = Option[UInt].None();
                continue;
            };
            when self.tokens[i].kind in {
                .Comma() then {
                    i += 1;
                    if i < self.tokens.count() and self.tokens[i].kind is .RParen() then {
                        done = true;
                        result = Option[UInt].Some(i + 1);
                    };
                },
                .RParen() then {
                    done = true;
                    result = Option[UInt].Some(i + 1);
                },
                _ then {
                    done = true;
                    result = Option[UInt].None();
                },
            };
        };
        return result;
    };

    /// Whether the `(` at `index` opens a TYPE written as a binding's
    /// annotation, rather than a declaration's parameter list. Two tells:
    /// a `->` after the closing `)` (a function type always has one, a
    /// signature never writes its result type with one), or contents that
    /// scan as a non-empty type list ending exactly at `)` (a parenthesized
    /// type). An empty `()` is decided by the `->` alone -- `let f () Int = …`
    /// stays a signature.
    paren_opens_type_at(self, index UInt) Bool = {
        if index >= self.tokens.count() or self.tokens[index].kind is not .LParen() then {
            return false;
        };
        let mutable depth UInt = 0;
        let mutable i = index;
        while i < self.tokens.count() then {
            when self.tokens[i].kind in {
                .LParen() then {
                    depth += 1;
                },
                .RParen() then {
                    depth -= 1;
                    if depth == 0 then {
                        let after = i + 1;
                        if after < self.tokens.count() and self.tokens[after].kind is .Arrow() then {
                            return true;
                        };
                        // Non-empty contents that scan as a type list closing
                        // exactly here: a parenthesized type annotation.
                        if i > index + 1 then {
                            return when self.scan_type_param_list_at(index) in {
                                .Some(after) then after == i + 1,
                                .None() then false,
                            };
                        };
                        return false;
                    };
                },
                _ then {},
            };
            i += 1;
        };
        return false;
    };

    /// The span of the balanced `(` ... `)` group starting at `index` -- from
    /// the opening paren to the closing one. A grouping complaint is anchored
    /// at the whole group.
    paren_group_span_at(self, index UInt) Option[SourceSpan] = {
        if index >= self.tokens.count() or self.tokens[index].kind is not .LParen() then {
            return Option[SourceSpan].None();
        };
        let start_loc = SourceLocation(
            self.tokens[index].line,
            self.tokens[index].column,
        );
        let mutable depth UInt = 0;
        let mutable i = index;
        while i < self.tokens.count() then {
            when self.tokens[i].kind in {
                .LParen() then {
                    depth += 1;
                },
                .RParen() then {
                    depth -= 1;
                    if depth == 0 then {
                        let end_loc = SourceLocation(
                            self.tokens[i].line,
                            self.tokens[i].column,
                        );
                        return Option[SourceSpan].Some(SourceSpan(start_loc, end_loc));
                    };
                },
                _ then {},
            };
            i += 1;
        };
        return Option[SourceSpan].None();
    };

    /// Whether the balanced `(` ... `)` run starting at `index` is followed by
    /// a `->`: the tell of a function TYPE's parameter list. A parenthesized
    /// group without the `->` is a grouping of exactly one type instead.
    paren_run_followed_by_arrow_at(self, index UInt) Bool = {
        if index >= self.tokens.count() or self.tokens[index].kind is not .LParen() then {
            return false;
        };
        let mutable depth UInt = 0;
        let mutable i = index;
        while i < self.tokens.count() then {
            when self.tokens[i].kind in {
                .LParen() then {
                    depth += 1;
                },
                .RParen() then {
                    depth -= 1;
                    if depth == 0 then {
                        let after = i + 1;
                        return after < self.tokens.count() and self.tokens[after].kind is .Arrow();
                    };
                },
                _ then {},
            };
            i += 1;
        };
        return false;
    };

    /// The index just past one type starting at `start_index`, or `None` when
    /// the run there is not a type.
    scan_type_shape_at(self, start_index UInt) Option[UInt] = {
        let mutable i = start_index;
        // Prefixes: `?T`, `*T`, `*mutable T`. They nest: `?*T`.
        let mutable more_prefixes = true;
        while more_prefixes then {
            if i >= self.tokens.count() then {
                return Option[UInt].None();
            };
            if self.tokens[i].kind is .QuestionMark() then {
                i += 1;
            } else if self.tokens[i].kind is .Star() and self.index_followed_by_type_application_at(
                i,
            ) then {
                i += 1;
                if i < self.tokens.count() and self.tokens[i].kind is .KwMut() then {
                    i += 1;
                };
            } else {
                more_prefixes = false;
            };
        };

        if i >= self.tokens.count() then {
            return Option[UInt].None();
        };
        when self.tokens[i].kind in {
            .KwSelfType() then {
                return Option[UInt].Some(i + 1);
            },
            .LParen() then {
                // Function type: `( <type-list> ) "->" <type>`. Without the
                // `->` a parenthesized run is a GROUPING of exactly one type:
                // `( <type> )`. A type list without `->` and an empty `( )`
                // are not type shapes.
                let after_params = self.scan_type_param_list_at(i) or else {
                    return self.scan_paren_type_suffix_at(i);
                };
                if after_params < self.tokens.count() and self.tokens[after_params].kind is .Arrow() then {
                    return self.scan_type_shape_at(after_params + 1);
                };
                return self.scan_paren_type_suffix_at(i);
            },
            .Identifier(name) then {
                i += 1;
                if not self.is_upper_first(name) then {
                    return Option[UInt].None();
                };
                if i < self.tokens.count() and self.tokens[i].kind is .LBracket() then {
                    return self.scan_type_list_at(i);
                };
                return Option[UInt].Some(i);
            },
            _ then {
                return Option[UInt].None();
            },
        };
    };

    /// The index just past a `( <type> )` suffix that starts at `start_index`,
    /// or `None`. This is the SHAPE of a postfix cast and of a Rust-style
    /// qualified path `Type(Trait)`; which one it is depends on the base, not
    /// on the tokens here.
    scan_paren_type_suffix_at(self, start_index UInt) Option[UInt] = {
        if start_index >= self.tokens.count() then {
            return Option[UInt].None();
        };
        if self.tokens[start_index].kind is not .LParen() then {
            return Option[UInt].None();
        };
        let after_type = self.scan_type_shape_at(start_index + 1) or else {
            return Option[UInt].None();
        };
        if after_type >= self.tokens.count() then {
            return Option[UInt].None();
        };
        if self.tokens[after_type].kind is not .RParen() then {
            return Option[UInt].None();
        };
        return Option[UInt].Some(after_type + 1);
    };

    /// The index just past a `[ <type-list> ]` suffix that starts at
    /// `start_index`, or `None`.
    scan_type_arg_list_suffix_at(self, start_index UInt) Option[UInt] = {
        return self.scan_type_list_at(start_index);
    };

    parse_type_arg_list(self) Result[List[TypeNode]] = {
        when self.current().kind in {
            .LBracket() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error("Expected '[' to start type argument list"),
                );
            },
        };

        let mutable args = List[TypeNode].new();
        while true then {
            if self.current().kind is .RBracket() then {
                self.advance();
                break;
            };
            let arg = self.parse_type() or return;
            args.push(arg);

            when self.current().kind in {
                .Comma() then {
                    self.advance();
                },
                .RBracket() then {},
                _ then {
                    return .Error(
                        self.parser_error("Expected ',' or ']' in type argument list"),
                    );
                },
            };
        };

        return .Ok(args);
    };

    parse_function_type_param_list(self) Result[List[TypeNode]] = {
        when self.current().kind in {
            .LParen() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error(
                        "Expected '(' to start function type parameter list",
                    ),
                );
            },
        };

        let mutable params = List[TypeNode].new();
        while true then {
            if self.current().kind is .RParen() then {
                self.advance();
                break;
            };
            let mutable param_type = self.parse_type() or return;
            params.push(param_type);

            when self.current().kind in {
                .Comma() then {
                    self.advance();
                },
                .RParen() then {},
                _ then {
                    return .Error(
                        self.parser_error(
                            "Expected ',' or ')' in function type parameter list",
                        ),
                    );
                },
            };
        };

        return .Ok(params);
    };

    // A type-parameter bound. `None` means "no bound at all" -- `Any` is the
    // absence of a constraint, not a constraint, so it never reaches the AST.
    parse_trait_constraint(self) Result[Option[Bound]] = {
        if self.current().kind is .KwMut() then {
            self.advance();
            return .Ok(Option[Bound].Some(Bound.Mutable()));
        };
        if self.current().kind is .KwForeign() then {
            self.advance();
            return .Ok(Option[Bound].Some(Bound.Foreign()));
        };
        if self.is_type_start() then {
            let node = self.parse_type() or return;
            return .Ok(bound_from_type_node(node));
        };
        return .Error(self.parser_error("Expected type parameter constraint"));
    };

    parse_type(self) Result[TypeNode] = {
        // The type's span starts at its first token -- `?T` starts at the `?`,
        // `*T` at the `*`, `List[Int]` at the name. A diagnostic that
        // names the type points here.
        let start = self.current();
        when self.current().kind in {
            .QuestionMark() then {
                self.advance();
                if self.current().kind is .Star() then {
                    return .Error(
                        self.parser_error(
                            "Weak reference syntax is '?T', not legacy '?*T'",
                        ),
                    );
                };
                let inner = self.parse_type() or return;
                return .Ok(
                    TypeNode.WeakReference(inner, false, self.span_from_start(start)),
                );
            },
            .Star() then {
                self.advance();
                let mutable is_mutable = false;
                if self.current().kind is .KwMut() then {
                    self.advance();
                    is_mutable = true;
                };
                let inner = self.parse_type() or return;
                return .Ok(
                    TypeNode.Pointer(inner, is_mutable, self.span_from_start(start)),
                );
            },
            .KwSelfType() then {
                self.advance();
                return .Ok(TypeNode.InferredSelf(self.span_from_start(start)));
            },
            .LParen() then {
                // Two shapes behind one `(`: a function type
                // `(T1, T2) -> R` (the `->` after the closing `)` is the
                // tell), and a transparent GROUPING of exactly one type
                // `(T)`. A multi-type run and an empty `()` without `->`
                // are errors -- a parenthesized type holds exactly one type.
                if self.paren_run_followed_by_arrow_at(self.index) then {
                    let param_types = self.parse_function_type_param_list() or return;
                    if self.current().kind is not .Arrow() then {
                        return .Error(
                            self.parser_error_at_current(
                                "Expected '->' between parameter types and return type",
                            ),
                        );
                    };
                    self.advance();
                    if not self.is_type_start() then {
                        return .Error(
                            self.parser_error_at_current(
                                "Function type must include a return type, e.g. (Int, String) -> Bool",
                            ),
                        );
                    };
                    let return_type = self.parse_type() or return;
                    return .Ok(
                        TypeNode.FunctionType(
                            param_types,
                            return_type,
                            self.span_from_start(start),
                        ),
                    );
                };
                let paren_index = self.index;
                self.advance();
                let grouping_message = "A parenthesized type holds exactly one type: write '(T)', or a function type '(A, B) -> R'";
                // The complaint is anchored at the whole `(...)` group.
                let grouping_span = self.paren_group_span_at(paren_index) or else self.token_span(
                    start,
                );
                if self.current().kind is .RParen() then {
                    return .Error(
                        self.parser_error_at_span(grouping_message, grouping_span),
                    );
                };
                let inner = self.parse_type() or return;
                when self.current().kind in {
                    .RParen() then {
                        self.advance();
                        return .Ok(
                            type_node_with_span(inner, self.span_from_start(start)),
                        );
                    },
                    .Comma() then {
                        return .Error(
                            self.parser_error_at_span(grouping_message, grouping_span),
                        );
                    },
                    _ then {
                        return .Error(
                            self.unexpected_token_error_at(
                                token_text(self.current()),
                                "')'",
                                self.current(),
                            ),
                        );
                    },
                };
            },
            .Identifier(module_or_name) then {
                self.advance();


                if not self.is_upper_first(module_or_name) then {
                    let mutable message = StringBuilder.new();
                    message.push_string("Type name '");
                    message.push_string(module_or_name);
                    message.push_string("' must start with an uppercase letter");
                    return .Error(self.parser_error_at_current(message.to_string()));
                };

                if self.current().kind is .LBracket() then {
                    let args = self.parse_type_arg_list() or return;
                    return .Ok(
                        TypeNode.Generic(
                            module_or_name,
                            args,
                            self.span_from_start(start),
                        ),
                    );
                };

                return .Ok(
                    TypeNode.Identifier(module_or_name, self.span_from_start(start)),
                );
            },
            _ then {
                return .Error(
                    self.parser_error_at_current(
                        "Expected type identifier, got: \(token_kind_description(self.current()))",
                    ),
                );
            },
        };
    };

    parse_type_parameters(self) Result[List[TypeParameter]] = {
        let mutable params = List[TypeParameter].new();

        if self.current().kind is .LBracket() then {
            self.advance();
        } else {
            return .Ok(params);
        };

        while true then {
            if self.current().kind is .RBracket() then {
                self.advance();
                break;
            };

            // Accept both Identifier and LifetimeIdentifier as type parameter names
            let param_name = when self.current().kind in {
                .Identifier(name) then {
                    self.advance();
                    name
                },
                _ then {
                    return .Error(
                        self.parser_error_at(
                            self.format_context_position_error(
                                "Expected identifier for ",
                                "type parameter",
                                self.current(),
                            ),
                            self.current(),
                        ),
                    );
                },
            };

            // Reject lifetime parameters in generic parameter lists
            let is_lifetime_param = param_name.starts_with("'");
            if is_lifetime_param then {
                return .Error(
                    self.parser_error_at_current("Lifetime syntax has been removed."),
                );
            };
            if self.current().kind is not .KwMut() and is not .KwForeign() and not self.is_type_start() then {
                let t = self.current();
                let mutable message = StringBuilder.new();
                message.push_string("Type parameter '");
                message.push_string(param_name);
                message.push_string("' requires a constraint");
                return .Error(self.parser_error_at(message.to_string(), t));
            };
            let mutable constraints = List[Bound].new();
            let first_constraint = self.parse_trait_constraint() or return;
            when first_constraint in {
                .Some(b) then {
                    constraints.push(b);
                },
                .None() then {},
            };

            while self.current().kind is .KwAnd() then {
                self.advance();
                let next_constraint = self.parse_trait_constraint() or return;
                when next_constraint in {
                    .Some(b) then {
                        constraints.push(b);
                    },
                    .None() then {},
                };
            };

            params.push(TypeParameter(param_name, constraints));

            when self.current().kind in {
                .Comma() then {
                    self.advance();
                },
                .RBracket() then {},
                _ then {
                    return .Error(
                        self.parser_error("Expected ',' or ']' in type parameter list"),
                    );
                },
            };
        };

        return .Ok(params);
    };

    /// `reject_named_params` rejects `name: Type` parameters at the NAME, which
    /// is the token that makes the parameter named. Checking after the list is
    /// parsed reports at whatever follows the last parameter instead.
    /// Parse a default value literal for a named parameter or field.
    ///
    /// Mirrors the seed's `parseDefaultValueLiteral` exactly: the expressions it
    /// produces and the errors it raises.
    /// Supported literals: integer, float, bool, string, rune, empty collection
    /// (`[]`), full-range (`...`), null (`null`). A leading `-` is accepted for
    /// numeric literals (`x: Int = -1`).
    parse_default_value_literal(self) Result[Expr] = {
        let start_token = self.current();
        let start_span = self.token_span(start_token);
        if start_token.kind is .Minus() then {
            self.advance();
            when self.current().kind in {
                .IntegerLiteral(v) then {
                    self.advance();
                    return .Ok(Expr.IntegerLiteral("-\(v)", start_span));
                },
                .FloatLiteral(v) then {
                    self.advance();
                    return .Ok(Expr.FloatLiteral("-\(v)", start_span));
                },
                _ then {
                    return .Error(
                        self.unexpected_token_error_at(
                            "-",
                            "a literal default value (number, bool, string, rune, [], range, or null)",
                            start_token,
                        ),
                    );
                },
            };
        };
        when start_token.kind in {
            .IntegerLiteral(v) then {
                self.advance();
                return .Ok(Expr.IntegerLiteral(v, start_span));
            },
            .FloatLiteral(v) then {
                self.advance();
                return .Ok(Expr.FloatLiteral(v, start_span));
            },
            .StringLiteral(v) then {
                self.advance();
                return .Ok(Expr.StringLiteral(v, start_span));
            },
            .RuneLiteral(v) then {
                self.advance();
                return .Ok(Expr.RuneLiteral(v, start_span));
            },
            .KwTrue() then {
                self.advance();
                return .Ok(Expr.BoolLiteral(true, start_span));
            },
            .KwFalse() then {
                self.advance();
                return .Ok(Expr.BoolLiteral(false, start_span));
            },
            .KwNull() then {
                self.advance();
                return .Ok(Expr.NullLiteral(start_span));
            },
            .LBracket() then {
                self.advance();
                if self.current().kind is .RBracket() then {
                    self.advance();
                    return .Ok(Expr.EmptyLiteral(start_span));
                };
                return .Error(
                    self.unexpected_token_error_at(
                        token_kind_description(self.current()),
                        "empty default value '[]'",
                        start_token,
                    ),
                );
            },
            .Range() then {
                return .Error(
                    self.parser_error_at_current(
                        "open ranges are spelled with '...': write '...b', '...<b', or '...'",
                    ),
                );
            },
            .Ellipsis() then {
                self.advance();
                return .Ok(Expr.EmptyLiteral(start_span));
            },
            _ then {
                return .Error(
                    self.unexpected_token_error_at(
                        token_kind_description(start_token),
                        "a literal default value (number, bool, string, rune, [], range, or null)",
                        start_token,
                    ),
                );
            },
        };
    };

    parse_param_list(
        self,
        func_name String,
        reject_named_params Bool,
    ) Result[List[Param]] = {
        let mutable params = List[Param].new();
        // Positional params must come before named params (grammar.bnf
        // <func-param-list>): a declaration fixes one call shape, so the two
        // kinds may not be interleaved.
        let mutable seen_named = false;

        while true then {
            if self.current().kind is .RParen() then {
                return .Ok(params);
            };

            if self.current().kind is .Star() then {
                return .Error(
                    self.parser_error_at_current(
                        "Invalid receiver parameter syntax: use 'self' only",
                    ),
                );
            };

            let mutable is_mut = false;
            if self.current().kind is .KwMut() then {
                is_mut = true;
                self.advance();
            };

            // Check for self receiver
            if self.current().kind is .KwSelf() then {
                self.advance();
                let mutable self_type = TypeNode.InferredSelf(unknown_span());
                if self.current().kind is .KwSelfType() then {
                    return .Error(
                        self.parser_error_at_current(
                            "Invalid receiver parameter syntax: use 'self' only",
                        ),
                    );
                };
                if self.is_type_start() then {
                    return .Error(
                        self.parser_error_at_current(
                            "Invalid receiver parameter syntax: use 'self' only",
                        ),
                    );
                };
                params.push(Param("self", false, self_type, false, Option[Expr].None()));
            } else {
                let name_token = self.current();
                let name = self.expect_identifier("parameter") or return;
                if not self.is_valid_value_name(name) then {
                    return .Error(
                        self.parser_error_at(
                            self.invalid_parameter_name_error(name),
                            name_token,
                        ),
                    );
                };

                // Check for colon - indicates named parameter
                let mutable is_named = false;
                if self.current().kind is .Colon() then {
                    is_named = true;
                    self.advance();
                    if reject_named_params then {
                        return .Error(
                            self.parser_error_at(
                                "Named parameters are not supported in foreign declarations",
                                name_token,
                            ),
                        );
                    };
                    seen_named = true;
                } else if seen_named then {
                    return .Error(
                        self.parser_error_at_current(
                            "Positional parameter '\(name)' cannot appear after named parameters",
                        ),
                    );
                };

                if not self.is_type_start() then {
                    return .Error(
                        self.parser_error(
                            "Expected type identifier, got: \(token_kind_description(self.current()))",
                        ),
                    );
                };
                let mutable param_type = self.parse_type() or return;

                // Only named parameters can have default values
                let mutable default_value = Option[Expr].None();
                if self.current().kind is .Assign() then {
                    if not is_named then {
                        return .Error(
                            self.parser_error_at_current(
                                "Default values are only allowed for named parameters (use 'name: Type = value' syntax)",
                            ),
                        );
                    };
                    self.advance();
                    let default_expr = self.parse_default_value_literal() or return;
                    default_value = Option[Expr].Some(default_expr);
                };

                params.push(Param(name, is_mut, param_type, is_named, default_value));
            };

            when self.current().kind in {
                .Comma() then {
                    self.advance();
                },
                .RParen() then {
                    return .Ok(params);
                },
                .Eof() then {
                    return .Error(self.parser_error("Unexpected EOF in parameter list"));
                },
                _ then {
                    return .Error(
                        self.parser_error("Expected ',' or ')' in parameter list"),
                    );
                },
            };
        };

        return .Ok(params);
    };

    parse_let_decl(self, access AccessModifier) Result[Decl] = {
        let start = self.current();
        self.advance();

        // `foreign` / `intrinsic` sit immediately after `let`, before `mutable`:
        // `let foreign mutable errno Int32;`.
        let decl_qualifiers = self.parse_decl_qualifiers();
        let decl_is_foreign = decl_qualifiers.is_foreign;
        let decl_is_intrinsic = decl_qualifiers.is_intrinsic;

        let mutable is_mut = false;
        if self.current().kind is .KwMut() then {
            is_mut = true;
            self.advance();
        };

        let name_token = self.current();
        let name = self.expect_identifier("let declaration") or return;
        if self.current().kind is .LParen() then {
            if not self.is_valid_value_name(name) then {
                return .Error(
                    self.parser_error_at(
                        self.invalid_function_name_error(name),
                        name_token,
                    ),
                );
            };
        } else if not self.is_valid_value_name(name) then {
            return .Error(
                self.parser_error_at(self.invalid_variable_name_error(name), name_token),
            );
        };
        let type_params = self.parse_type_parameters() or return;

        // A `(` that opens a function TYPE's parameter list (`let f (Int) ->
        // Int = value`) is an annotation, not a signature: the first token
        // inside is a type head, and an empty `()` is decided by `->` after it.
        if self.current().kind is .LParen() and not self.paren_opens_type_at(self.index) then {
            if is_mut then {
                return .Error(
                    self.parser_error_at_current(
                        "Function declaration cannot use mutable before name",
                    ),
                );
            };

            if decl_is_foreign and not type_params.is_empty() then {
                return .Error(
                    self.parser_error_at_current(
                        "foreign function does not support generics",
                    ),
                );
            };

            self.advance();
            let params = self.parse_param_list(name, decl_is_foreign) or return;

            when self.current().kind in {
                .RParen() then {},
                _ then {
                    return .Error(self.parser_error("Expected ')' after parameters"));
                },
            };
            self.advance();

            if self.current().kind is .Assign() then {
                return .Error(
                    self.parser_error_at_current(
                        "Missing return type: function and method declarations must explicitly declare a return type",
                    ),
                );
            };
            if not self.is_type_start() then {
                return .Error(
                    self.parser_error_at_current(
                        "Missing return type: function and method declarations must explicitly declare a return type",
                    ),
                );
            };
            let mutable return_type = self.parse_type() or return;

            if decl_is_foreign or decl_is_intrinsic then {
                if self.current().kind is .Assign() then {
                    if decl_is_foreign then {
                        return .Error(
                            self.parser_error_at_current(
                                "foreign function cannot have a body",
                            ),
                        );
                    };
                    return .Error(
                        self.parser_error_at_current(
                            "intrinsic function declaration should not have body",
                        ),
                    );
                };
                let _ = self.require_semicolon() or return;
                let span = self.span_from_start(start);
                let base = Decl.FunctionDecl(
                    access,
                    name,
                    type_params,
                    params,
                    return_type,
                    Expr.Identifier("<intrinsic-body>", span),
                    span,
                    self.token_span(name_token),
                );
                return self.wrap_decl(access, decl_is_foreign, decl_is_intrinsic, base);
            };

            if self.current().kind is .Eof() then {
                return .Error(
                    self.parser_error("Unexpected EOF in function declaration"),
                );
            };
            if self.current().kind is not .Assign() then {
                return .Error(
                    self.parser_error(
                        "Unexpected token: \(token_text(self.current())), expected: '='",
                    ),
                );
            };
            self.advance();
            let body = self.parse_expression_checked("function body") or return;
            let _ = self.require_semicolon() or return;
            let base = Decl.FunctionDecl(
                access,
                name,
                type_params,
                params,
                return_type,
                body,
                self.span_from_start(start),
                self.token_span(name_token),
            );
            return self.wrap_decl(access, decl_is_foreign, decl_is_intrinsic, base);
        };

        // Variable declaration
        if not type_params.is_empty() then {
            return .Error(
                self.parser_error_at_current(
                    "variable declaration cannot use type parameters",
                ),
            );
        };

        if decl_is_foreign then {
            if not self.is_type_start() then {
                return .Error(
                    self.parser_error_at_current(
                        "foreign let declaration requires explicit type",
                    ),
                );
            };
            let mutable foreign_type = self.parse_type() or return;
            let _ = self.require_semicolon() or return;
            let span = self.span_from_start(start);
            let base = Decl.LetDecl(
                access,
                name,
                is_mut,
                .Some(foreign_type),
                Expr.Identifier("<foreign-init>", span),
                span,
                self.token_span(name_token),
            );
            return self.wrap_decl(access, decl_is_foreign, decl_is_intrinsic, base);
        };

        let mutable type_name = Option[TypeNode].None();
        if self.is_type_start() then {
            let parsed = self.parse_type() or return;
            type_name = .Some(parsed);
        };

        // expect '='
        if self.current().kind is .Eof() then {
            return .Error(self.parser_error("Expected '=' in let declaration"));
        };
        if self.current().kind is not .Assign() then {
            return .Error(
                self.parser_error(
                    "Expected '=' in let declaration, got \(token_text(self.current()))",
                ),
            );
        };
        self.advance();
        let initializer = self.parse_expression_checked("let declaration initializer") or return;
        let _ = self.require_semicolon() or return;
        let base = Decl.LetDecl(
            access,
            name,
            is_mut,
            type_name,
            initializer,
            self.span_from_start(start),
            self.token_span(name_token),
        );
        return self.wrap_decl(access, decl_is_foreign, decl_is_intrinsic, base);
    };

    parse_type_decl(self, access AccessModifier) Result[Decl] = {
        let start = self.current();
        self.advance();

        // `foreign` / `intrinsic` sit immediately after `type`, alongside
        // `mutable`: `type foreign ...`, `type intrinsic T;`.
        let decl_qualifiers = self.parse_decl_qualifiers();
        let decl_is_foreign = decl_qualifiers.is_foreign;
        let decl_is_intrinsic = decl_qualifiers.is_intrinsic;

        let mutable is_nominal_mutable = false;
        if self.current().kind is .KwMut() then {
            is_nominal_mutable = true;
            self.advance();
        };

        let name_token = self.current();
        let name = self.expect_identifier("type declaration") or return;
        if not self.is_upper_first(name) then {
            return .Error(
                self.parser_error_at(self.invalid_type_name_error(name), name_token),
            );
        };
        let type_params = self.parse_type_parameters() or return;

        // `type foreign` and `type mutable` are mutually exclusive: mutability
        // is a property of Koral's own nominal declarations, and an external
        // type's layout is C's, not ours.
        if is_nominal_mutable and decl_is_foreign then {
            return .Error(
                self.parser_error_at_current("Foreign type cannot be marked mutable"),
            );
        };

        when self.current().kind in {
            .Assign() then {
                if is_nominal_mutable then {
                    return .Error(
                        self.parser_error_at_current(
                            "Type alias cannot be marked mutable",
                        ),
                    );
                };
                self.advance();
                let target = self.parse_type() or return;
                self.consume_semicolon();
                let base = Decl.TypeAliasDecl(
                    access,
                    name,
                    target,
                    self.span_from_start(start),
                    self.token_span(name_token),
                );
                return self.wrap_decl(access, decl_is_foreign, decl_is_intrinsic, base);
            },
            .LParen() then {
                if is_nominal_mutable and decl_is_intrinsic then {
                    return .Error(
                        self.parser_error_at_current(
                            "intrinsic type cannot be marked mutable",
                        ),
                    );
                };
                self.advance();
                let mutable fields = List[Field].new();
                let mutable seen_named_field = false;
                while true then {
                    when self.current().kind in {
                        .RParen() then {
                            self.advance();
                            break;
                        },
                        .Eof() then {
                            return .Error(
                                self.parser_error(
                                    "Unexpected EOF in struct declaration",
                                ),
                            );
                        },
                        _ then {
                            let field_access = self.parse_access_modifier(
                                AccessModifier.Internal(),
                            ) or return;
                            let mutable field_mut = false;
                            if self.current().kind is .KwMut() then {
                                field_mut = true;
                                self.advance();
                            };

                            let field_name_token = self.current();
                            let field_name = self.expect_identifier("field name") or return;
                            if not self.is_valid_value_name(field_name) then {
                                return .Error(
                                    self.parser_error_at(
                                        self.invalid_field_name_error(field_name),
                                        field_name_token,
                                    ),
                                );
                            };

                            // Check for colon - indicates named field
                            let mutable field_named = false;
                            if self.current().kind is .Colon() then {
                                field_named = true;
                                seen_named_field = true;
                                self.advance();
                            } else if seen_named_field then {
                                return .Error(
                                    self.parser_error_at_current(
                                        "Positional field '\(field_name)' cannot appear after named fields",
                                    ),
                                );
                            };

                            let mutable field_type = self.parse_type() or return;

                            // Only named fields can have default values
                            let mutable field_default_value = Option[Expr].None();
                            if self.current().kind is .Assign() then {
                                if not field_named then {
                                    return .Error(
                                        self.parser_error_at_current(
                                            "Default values are only allowed for named parameters (use 'name: Type = value' syntax)",
                                        ),
                                    );
                                };
                                self.advance();
                                let field_default_expr = self.parse_default_value_literal() or return;
                                field_default_value = Option[Expr].Some(field_default_expr);
                            };

                            fields.push(
                                Field(
                                    field_access,
                                    field_name,
                                    field_mut,
                                    field_type,
                                    field_named,
                                    field_default_value,
                                ),
                            );
                            if self.current().kind is .Comma() then {
                                self.advance();
                            };
                        },
                    };
                };
                let _ = self.require_semicolon() or return;
                if decl_is_foreign then {
                    return .Ok(
                        Decl.ForeignTypeDecl(
                            access,
                            name,
                            Option[List[Field]].Some(fields),
                            self.span_from_start(start),
                            self.token_span(name_token),
                        ),
                    );
                };
                let base = Decl.TypeStructDecl(
                    access,
                    name,
                    is_nominal_mutable,
                    type_params,
                    fields,
                    self.span_from_start(start),
                    self.token_span(name_token),
                );
                return self.wrap_decl(access, decl_is_foreign, decl_is_intrinsic, base);
            },
            .LBrace() then {
                if is_nominal_mutable then {
                    return .Error(
                        self.parser_error_at_current(
                            "Enum type cannot be marked mutable",
                        ),
                    );
                };
                if decl_is_foreign then {
                    self.advance();
                    if self.current().kind is .RBrace() then {
                        self.advance();
                        let _ = self.require_semicolon() or return;
                        return .Ok(
                            Decl.ForeignTypeDecl(
                                access,
                                name,
                                Option[List[Field]].None(),
                                self.span_from_start(start),
                                self.token_span(name_token),
                            ),
                        );
                    };
                    return .Error(
                        self.parser_error_at_current(
                            "foreign type must use an empty body: {}",
                        ),
                    );
                };
                self.advance();
                let mutable cases = List[EnumCase].new();
                while true then {
                    when self.current().kind in {
                        .RBrace() then {
                            self.advance();
                            break;
                        },
                        .Eof() then {
                            return .Error(
                                self.parser_error("Unexpected EOF in enum declaration"),
                            );
                        },
                        _ then {
                            let case_name_token = self.current();
                            let case_name = self.expect_identifier("enum case") or return;
                            if not self.is_upper_first(case_name) then {
                                return .Error(
                                    self.parser_error_at(
                                        self.invalid_enum_case_name_error(case_name),
                                        case_name_token,
                                    ),
                                );
                            };
                            let mutable case_fields = List[EnumCaseField].new();

                            // A variant declaration always writes its parens --
                            // `Red()`, never bare `Red` -- so the declaration
                            // matches the expression (`.Red()`) and pattern
                            // (`.Red()`) spellings.
                            if self.current().kind is not .LParen() then {
                                return .Error(
                                    self.unexpected_token_error_at(
                                        token_text(self.current()),
                                        "'('",
                                        self.current(),
                                    ),
                                );
                            };
                            self.advance();
                            // Positional payload fields must come before named
                            // ones, same rule as <func-param-list>.
                            let mutable seen_named_payload = false;
                            while true then {
                                when self.current().kind in {
                                    .RParen() then {
                                        self.advance();
                                        break;
                                    },
                                    .Eof() then {
                                        return .Error(
                                            self.parser_error(
                                                "Unexpected EOF in enum payload",
                                            ),
                                        );
                                    },
                                    _ then {
                                        let payload_name_token = self.current();
                                        let payload_name = self.expect_identifier(
                                            "enum payload name",
                                        ) or return;
                                        if not self.is_valid_value_name(payload_name) then {
                                            return .Error(
                                                self.parser_error_at(
                                                    self.invalid_parameter_name_error(
                                                        payload_name,
                                                    ),
                                                    payload_name_token,
                                                ),
                                            );
                                        };
                                        // Check for colon - indicates named field
                                        let mutable payload_named = false;
                                        if self.current().kind is .Colon() then {
                                            payload_named = true;
                                            self.advance();
                                            seen_named_payload = true;
                                        } else if seen_named_payload then {
                                            return .Error(
                                                self.parser_error_at_current(
                                                    "Positional field '\(payload_name)' cannot appear after named fields",
                                                ),
                                            );
                                        };
                                        let mutable payload_type = self.parse_type() or return;
                                        // Parse optional default value for named fields
                                        let mutable payload_default_value = Option[Expr].None();
                                        if self.current().kind is .Assign() then {
                                            if not payload_named then {
                                                return .Error(
                                                    self.parser_error_at_current(
                                                        "Default values are only allowed for named parameters (use 'name: Type = value' syntax)",
                                                    ),
                                                );
                                            };
                                            self.advance();
                                            let payload_default_expr = self.parse_default_value_literal() or return;
                                            payload_default_value = Option[Expr].Some(
                                                payload_default_expr,
                                            );
                                        };
                                        case_fields.push(
                                            EnumCaseField(
                                                payload_name,
                                                payload_type,
                                                payload_named,
                                                payload_default_value,
                                            ),
                                        );
                                        when self.current().kind in {
                                            .Comma() then {
                                                self.advance();
                                            },
                                            .RParen() then {},
                                            _ then {
                                                return .Error(
                                                    self.parser_error(
                                                        "Expected ',' or ')' in enum payload",
                                                    ),
                                                );
                                            },
                                        };
                                    },
                                };
                            };

                            cases.push(EnumCase(case_name, case_fields));
                            if self.current().kind is .Comma() then {
                                self.advance();
                            };
                        },
                    };
                };
                let _ = self.require_semicolon() or return;
                let base = Decl.TypeEnumDecl(
                    access,
                    name,
                    type_params,
                    cases,
                    self.span_from_start(start),
                    self.token_span(name_token),
                );
                return self.wrap_decl(access, decl_is_foreign, decl_is_intrinsic, base);
            },
            .Semicolon() then {
                if decl_is_foreign then {
                    return .Error(
                        self.parser_error_at_current(
                            "foreign type cannot be declared without a body",
                        ),
                    );
                };
                if decl_is_intrinsic then {
                    let _ = self.require_semicolon() or return;
                    return .Ok(
                        Decl.IntrinsicTypeDecl(
                            access,
                            name,
                            type_params,
                            self.span_from_start(start),
                            self.token_span(name_token),
                        ),
                    );
                };
                return .Error(
                    self.parser_error("Expected '=', '(' or '{' after type name"),
                );
            },
            _ then {
                if decl_is_foreign then {
                    return .Error(
                        self.parser_error_at_current(
                            "foreign type cannot be declared without a body",
                        ),
                    );
                };
                if decl_is_intrinsic then {
                    return .Ok(
                        Decl.IntrinsicTypeDecl(
                            access,
                            name,
                            type_params,
                            self.span_from_start(start),
                            self.token_span(name_token),
                        ),
                    );
                };
                return .Error(
                    self.parser_error("Expected '=', '(' or '{' after type name"),
                );
            },
        };
    };

    parse_let_statement(self) Result[Statement] = {
        let start = self.current();
        self.advance();

        if self.current().kind is .LParen() then {
            return self.parse_tuple_let_statement(start);
        };

        let mutable is_mut = false;
        if self.current().kind is .KwMut() then {
            is_mut = true;
            self.advance();
        };

        let name_token = self.current();
        // The seed spells this slot "let declaration" in every context (the
        // `let` keyword names a declaration, statement position or not); the
        // message must match verbatim.
        let name = self.expect_identifier("let declaration") or return;
        if not self.is_valid_value_name(name) then {
            return .Error(
                self.parser_error_at(self.invalid_variable_name_error(name), name_token),
            );
        };

        let mutable type_name = Option[TypeNode].None();
        if self.is_type_start() then {
            let parsed_type_name = self.parse_type() or return;
            type_name = .Some(parsed_type_name);
        };

        // skip to '='
        if self.current().kind is .Eof() then {
            return .Error(self.parser_error("Expected '=' in let statement"));
        };
        if self.current().kind is not .Assign() then {
            return .Error(self.parser_error("Expected '=' in let statement"));
        };
        self.advance();
        let value = self.parse_expression_checked("let statement value") or return;
        let _ = self.require_semicolon() or return;
        return .Ok(
            Statement.LetStmt(name, is_mut, type_name, value, self.span_from_start(
                start,
            )),
        );
    };

    /// `let (a, b, c) = expr;` -- positional destructuring of a struct with
    /// exactly that many fields, in declaration order. At least two slots.
    parse_tuple_let_statement(self, start Token) Result[Statement] = {
        self.advance();

        let mutable bindings = List[PairBindingElement].new();
        bindings.push(self.parse_pair_binding_element() or return);

        if self.current().kind is not .Comma() then {
            return .Error(self.parser_error("Expected ',' in tuple let statement"));
        };
        while self.current().kind is .Comma() then {
            self.advance();
            bindings.push(self.parse_pair_binding_element() or return);
        };

        if self.current().kind is not .RParen() then {
            return .Error(self.parser_error("Expected ')' in tuple let statement"));
        };
        self.advance();

        if self.current().kind is .Eof() then {
            return .Error(self.parser_error("Expected '=' in tuple let statement"));
        };
        if self.current().kind is not .Assign() then {
            return .Error(self.parser_error("Expected '=' in tuple let statement"));
        };
        self.advance();

        let value = self.parse_expression_checked("tuple let statement value") or return;
        let _ = self.require_semicolon() or return;
        // Nested slots expand to extra flat tuple lets of synthetic temps,
        // spliced into the enclosing statement list after this one.
        let flattened = self.flatten_nested_bindings(bindings);
        let extras = self.nested_binding_extra_lets(
            flattened.second,
            self.span_from_start(start),
        );
        for extra in extras then {
            self.pending_statements.push(extra);
        };
        return .Ok(
            Statement.TupleLetStmt(flattened.first, value, self.span_from_start(start)),
        );
    };

    parse_pair_binding_element(self) Result[PairBindingElement] = {
        let start = self.current();

        // Nested tuple binding: `(a, (b, c))`. A parenthesized run of two or
        // more slots is a nested `<tuple-binding>`; `(x)` is not a binding.
        if self.current().kind is .LParen() then {
            self.advance();
            let mutable children = List[PairBindingElement].new();
            children.push(self.parse_pair_binding_element() or return);
            if self.current().kind is not .Comma() then {
                return .Error(self.parser_error("Expected ',' in tuple binding"));
            };
            while self.current().kind is .Comma() then {
                self.advance();
                children.push(self.parse_pair_binding_element() or return);
            };
            if self.current().kind is not .RParen() then {
                return .Error(self.parser_error("Expected ')' in tuple binding"));
            };
            self.advance();
            return .Ok(
                PairBindingElement(
                    "_",
                    false,
                    Option[TypeNode].None(),
                    true,
                    self.span_from_start(start),
                    Option[List[PairBindingElement]].Some(children),
                ),
            );
        };

        if start.kind is .Identifier(name) and name == "_" then {
            self.advance();
            return .Ok(
                PairBindingElement(
                    "_",
                    false,
                    Option[TypeNode].None(),
                    true,
                    self.span_from_start(start),
                    Option[List[PairBindingElement]].None(),
                ),
            );
        };

        let mutable is_mut = false;
        if self.current().kind is .KwMut() then {
            is_mut = true;
            self.advance();
        };

        let name_token = self.current();
        let name = self.expect_identifier("pair let binding") or return;
        if not self.is_valid_value_name(name) then {
            return .Error(
                self.parser_error_at(self.invalid_variable_name_error(name), name_token),
            );
        };

        let mutable type_name = Option[TypeNode].None();
        when self.current().kind in {
            .Comma() then {},
            .RParen() then {},
            .KwIn() then {},
            _ then {
                let parsed_type_name = self.parse_type() or return;
                type_name = .Some(parsed_type_name);
            },
        };

        return .Ok(
            PairBindingElement(
                name,
                is_mut,
                type_name,
                false,
                self.span_from_start(start),
                Option[List[PairBindingElement]].None(),
            ),
        );
    };

    /// Expand nested tuple-binding slots into a flat binding list plus the
    /// extra `let (..) = temp;` destructurings they imply. A nested slot
    /// `(b, c)` binds a synthetic temp at the outer level and is emitted as
    /// its own flat tuple let of that temp; deep nesting nests the temps the
    /// same way. The caller emits the outer statement first, then the extras.
    flatten_nested_bindings(
        self,
        bindings List[PairBindingElement],
    ) Pair[List[PairBindingElement], List[Pair[List[PairBindingElement], String]]] = {
        let mutable flat = List[PairBindingElement].new();
        let mutable extras = List[Pair[List[PairBindingElement], String]].new();
        for binding in bindings then {
            when binding.nested in {
                .Some(children) then {
                    let temp_name = "__koral_nslot_\(binding.span.start.line.to_string())_\(binding.span.start.column.to_string())";
                    flat.push(
                        PairBindingElement(
                            temp_name,
                            false,
                            Option[TypeNode].None(),
                            false,
                            binding.span,
                            Option[List[PairBindingElement]].None(),
                        ),
                    );
                    let child_flattened = self.flatten_nested_bindings(children);
                    extras.push(
                        Pair[List[PairBindingElement], String](
                            child_flattened.first,
                            temp_name,
                        ),
                    );
                    for extra in child_flattened.second then {
                        extras.push(extra);
                    };
                },
                .None() then {
                    flat.push(binding);
                },
            };
        };
        return Pair[List[PairBindingElement], List[Pair[List[PairBindingElement], String]]](
            flat,
            extras,
        );
    };

    /// The `let (b, c) = temp;` statements an expanded nested binding implies.
    nested_binding_extra_lets(
        self,
        extras List[Pair[List[PairBindingElement], String]],
        span SourceSpan,
    ) List[Statement] = {
        let mutable out = List[Statement].new();
        for extra in extras then {
            out.push(
                Statement.TupleLetStmt(
                    extra.first,
                    Expr.Identifier(extra.second, span),
                    span,
                ),
            );
        };
        return out;
    };

    is_assignment_operator(self) Bool = {
        return when self.current().kind in {
            .Assign() then true,
            .PlusAssign() then true,
            .MinusAssign() then true,
            .StarAssign() then true,
            .SlashAssign() then true,
            .PercentAssign() then true,
            .AmpersandAssign() then true,
            .PipeAssign() then true,
            .CaretAssign() then true,
            .LeftShiftAssign() then true,
            .RightShiftAssign() then true,
            _ then false,
        };
    };

    parse_assignment_operator(
        self,
    ) Result[Option[CompoundAssignmentOperator]] = {
        return when self.current().kind in {
            .Assign() then .Ok(Option[CompoundAssignmentOperator].None()),
            .PlusAssign() then .Ok(.Some(CompoundAssignmentOperator.AddAssign())),
            .MinusAssign() then .Ok(.Some(CompoundAssignmentOperator.SubtractAssign())),
            .StarAssign() then .Ok(.Some(CompoundAssignmentOperator.MultiplyAssign())),
            .SlashAssign() then .Ok(.Some(CompoundAssignmentOperator.DivideAssign())),
            .PercentAssign() then .Ok(
                .Some(CompoundAssignmentOperator.RemainderAssign()),
            ),
            .AmpersandAssign() then .Ok(
                .Some(CompoundAssignmentOperator.BitAndAssign()),
            ),
            .PipeAssign() then .Ok(.Some(CompoundAssignmentOperator.BitOrAssign())),
            .CaretAssign() then .Ok(.Some(CompoundAssignmentOperator.BitXorAssign())),
            .LeftShiftAssign() then .Ok(
                .Some(CompoundAssignmentOperator.LeftShiftAssign()),
            ),
            .RightShiftAssign() then .Ok(
                .Some(CompoundAssignmentOperator.RightShiftAssign()),
            ),
            _ then .Error(
                self.parser_error_at_current("token is not an assignment operator"),
            ),
        };
    };

    parse_expression_checked(self, context String) Result[Expr] = {
        let t = self.current();
        self.parse_debug("expr begin");
        let before = self.index;
        let parsed_expr = self.parse_expression() or return;
        if self.index == before then {
            let t = self.current();
            return .Error(
                self.parser_error_at(
                    self.format_progress_error(
                        "Parser made no progress while parsing ",
                        context,
                        t,
                    ),
                    t,
                ),
            );
        };
        let mutable expr = parsed_expr;
        // A cast result takes no postfix suffixes: `x as *T.m()` leaves the
        // `.m()` a stray token, and a method call on a cast needs parentheses,
        // `(x as *T).m()`.
        let cast_result = when parsed_expr in {
            .CastExpr(_, _, _) then true,
            _ then false,
        };
        if not cast_result and self.should_continue_postfix_after_expression() then {
            expr = self.parse_postfix_suffixes(expr) or return;
        };
        return .Ok(expr);
    };

    parse_statement(self) Result[Statement] = {
        let start = self.current();
        self.parse_debug("statement dispatch");
        when self.current().kind in {
            .KwLet() then {
                return self.parse_let_statement();
            },
            .KwReturn() then {
                self.advance();
                if self.current().kind is .Semicolon() then {
                    self.advance();
                    return .Ok(
                        Statement.ReturnStmt(
                            Option[Expr].None(),
                            self.span_from_start(start),
                        ),
                    );
                };
                let value = self.parse_expression_checked("return statement value") or return;
                let _ = self.require_semicolon() or return;
                return .Ok(
                    Statement.ReturnStmt(.Some(value), self.span_from_start(start)),
                );
            },
            .KwBreak() then {
                self.advance();
                let _ = self.require_semicolon() or return;
                return .Ok(Statement.BreakStmt(self.span_from_start(start)));
            },
            .KwContinue() then {
                self.advance();
                let _ = self.require_semicolon() or return;
                return .Ok(Statement.ContinueStmt(self.span_from_start(start)));
            },
            .KwDefer() then {
                self.advance();
                let value = self.parse_expression_checked("defer statement value") or return;
                let _ = self.require_semicolon() or return;
                return .Ok(Statement.DeferStmt(value, self.span_from_start(start)));
            },
            _ then {
                let value = self.parse_expression_checked("statement expression") or return;

                if self.is_assignment_operator() then {
                    let op = self.parse_assignment_operator() or else {
                        return .Error(
                            self.parser_error_at_current("Unknown assignment operator"),
                        );
                    };
                    self.advance();
                    let rhs = self.parse_expression_checked(
                        "assignment right-hand side",
                    ) or return;
                    let _ = self.require_semicolon() or return;
                    return .Ok(
                        Statement.AssignmentStmt(
                            value,
                            op,
                            rhs,
                            self.span_from_start(start),
                        ),
                    );
                };

                let _ = self.require_semicolon() or return;
                return .Ok(Statement.ExprStmt(value, self.span_from_start(start)));
            },
        };
    };

    // Lookahead: check if current position starts a lambda expression.
    // Lambda forms: () [RetType] ->  or  (name [Type], ...) [RetType] ->
};
