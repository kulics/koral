// core_expressions.koral - 表达式解析
//
// 实现 Parser 的表达式解析方法：
// - is_lambda_expression, parse_lambda_expression
// - parse_primary, parse_bracket_leading_expression
// - parse_parenthesized_expression, parse_block_expression
// - parse_when/if/while/for 表达式
// - parse_call_suffix, parse_subscript_suffix, parse_dot_suffix
// - parse_postfix_suffixes, parse_call, parse_unary

private type StaticDispatchReceiver(type_name String, type_args List[TypeNode]);

given Parser {
    /// Whether the `(` at the cursor opens a lambda.
    ///
    /// SHAPE, not a trial parse: a lambda is `(params) [Type] -> ...`, so the
    /// tell is a `->` immediately after the parameter list's `)`, or after an
    /// optional return type written there. Nothing is built and nothing is
    /// rolled back. This also closes two holes the trial had -- it used to
    /// accept `(...)` followed by ANY type as a lambda (no `->` required) and
    /// it skipped the first parameter token without checking it was a name.
    is_lambda_expression(self) Bool = {
        when self.current().kind in {
            .LParen() then {},
            _ then {
                return false;
            },
        };

        let mutable i = self.index + 1; // skip (

        // Empty params: `()`
        if i < self.tokens.count() and self.tokens[i].kind is .RParen() then {
            return self.lambda_return_clause_follows_at(i + 1);
        };

        // Non-empty params: the first token is a parameter name.
        if i >= self.tokens.count() then {
            return false;
        };
        if self.tokens[i].kind is not .Identifier(_) then {
            return false;
        };

        let mutable depth UInt = 1; // we already consumed the opening (
        while i < self.tokens.count() and depth > 0 then {
            when self.tokens[i].kind in {
                .LParen() then {
                    depth += 1;
                },
                .LBracket() then {
                    depth += 1;
                },
                .RParen() then {
                    depth -= 1;
                    if depth == 0 then {
                        break;
                    };
                },
                .RBracket() then {
                    if depth > 0 then {
                        depth -= 1;
                    };
                },
                .Eof() then {
                    return false;
                },
                _ then {},
            };
            i += 1;
        };
        if depth > 0 then {
            return false;
        };
        i += 1; // skip `)`

        return self.lambda_return_clause_follows_at(i);
    };

    /// After a lambda's parameter list: `=>`, or `<type> =>`.
    lambda_return_clause_follows_at(self, start_index UInt) Bool = {
        if start_index >= self.tokens.count() then {
            return false;
        };
        if self.tokens[start_index].kind is .FatArrow() then {
            return true;
        };
        let after_type = self.scan_type_shape_at(start_index) or else {
            return false;
        };
        return after_type < self.tokens.count() and self.tokens[after_type].kind is .FatArrow();
    };

    // Parse a lambda expression: (params) [ReturnType] => body
    parse_lambda_expression(self) Result[Expr] = {
        let start = self.current();

        if self.current().kind is .LParen() then {
            self.advance();
        } else {
            return .Error(self.parser_error("Expected '(' in lambda expression"));
        };

        let mutable params = List[LambdaParam].new();

        // Parse parameter list
        while true then {
            if self.current().kind is .RParen() then {
                break;
            };

            let name_token = self.current();
            let name = self.expect_identifier("lambda parameter") or return;
            if not self.is_valid_value_name(name) then {
                return .Error(
                    self.parser_error_at(
                        self.invalid_parameter_name_error(name),
                        name_token,
                    ),
                );
            };

            if self.current().kind is .Colon() then {
                return .Error(
                    self.parser_error(
                        "Lambda parameters use 'name Type', not 'name: Type'",
                    ),
                );
            };

            // Optional type annotation
            let mutable type_ann = Option[TypeNode].None();
            if self.is_type_start() then {
                let t = self.parse_type() or return;
                type_ann = Option[TypeNode].Some(t);
            };

            params.push(LambdaParam(name, type_ann));

            when self.current().kind in {
                .Comma() then {
                    self.advance();
                },
                .RParen() then {},
                _ then {
                    return .Error(
                        self.parser_error(
                            "Expected ',' or ')' in lambda parameter list",
                        ),
                    );
                },
            };
        };

        when self.current().kind in {
            .RParen() then {
                self.advance();
            },
            _ then {
                return .Error(self.parser_error("Expected ')' after lambda parameters"));
            },
        };

        // Optional return type
        let mutable return_type = Option[TypeNode].None();
        let has_arrow = self.current().kind is .FatArrow();
        if not has_arrow then {
            if self.is_type_start() then {
                let t = self.parse_type() or return;
                return_type = Option[TypeNode].Some(t);
            };
        };

        // `=>` opens the body.
        when self.current().kind in {
            .FatArrow() then {
                self.advance();
            },
            _ then {
                return .Error(self.parser_error("Expected '=>' in lambda expression"));
            },
        };

        let body = self.parse_expression() or return;

        return .Ok(
            Expr.LambdaExpr(params, return_type, body, self.span_from_start(start)),
        );
    };

    build_duration_literal_expression(
        self,
        value String,
        unit String,
        span SourceSpan,
    ) Result[Expr] = {
        let mutable secs_expr = Expr.IntegerLiteral("0", span);
        let mutable nanos_expr = Expr.IntegerLiteral("0", span);

        when unit in {
            "s" then {
                secs_expr = Expr.IntegerLiteral(value, span);
            },
            "ms" then {
                secs_expr = Expr.ArithmeticExpr(
                    Expr.IntegerLiteral(value, span),
                    ArithmeticOperator.Divide(),
                    Expr.IntegerLiteral("1000", span),
                    span,
                );
                nanos_expr = Expr.ArithmeticExpr(
                    Expr.ArithmeticExpr(
                        Expr.IntegerLiteral(value, span),
                        ArithmeticOperator.Remainder(),
                        Expr.IntegerLiteral("1000", span),
                        span,
                    ),
                    ArithmeticOperator.Multiply(),
                    Expr.IntegerLiteral("1000000", span),
                    span,
                );
            },
            "us" then {
                secs_expr = Expr.ArithmeticExpr(
                    Expr.IntegerLiteral(value, span),
                    ArithmeticOperator.Divide(),
                    Expr.IntegerLiteral("1000000", span),
                    span,
                );
                nanos_expr = Expr.ArithmeticExpr(
                    Expr.ArithmeticExpr(
                        Expr.IntegerLiteral(value, span),
                        ArithmeticOperator.Remainder(),
                        Expr.IntegerLiteral("1000000", span),
                        span,
                    ),
                    ArithmeticOperator.Multiply(),
                    Expr.IntegerLiteral("1000", span),
                    span,
                );
            },
            "ns" then {
                secs_expr = Expr.ArithmeticExpr(
                    Expr.IntegerLiteral(value, span),
                    ArithmeticOperator.Divide(),
                    Expr.IntegerLiteral("1000000000", span),
                    span,
                );
                nanos_expr = Expr.ArithmeticExpr(
                    Expr.IntegerLiteral(value, span),
                    ArithmeticOperator.Remainder(),
                    Expr.IntegerLiteral("1000000000", span),
                    span,
                );
            },
            _ then {
                return .Error(
                    self.parser_error_at_current("unsupported duration suffix: \(unit)"),
                );
            },
        };

        let mutable args = List[Expr].new();
        args.push(Expr.NamedArgument("seconds", secs_expr, span));
        args.push(Expr.NamedArgument("nanoseconds", nanos_expr, span));

        let ctor = Expr.StaticMethodCall(
            "Duration",
            List[TypeNode].new(),
            "new",
            args,
            span,
        );
        let mutable unwrap_path = List[String].new();
        unwrap_path.push("unwrap");
        let callee = Expr.MemberPath(ctor, unwrap_path, span);
        return .Ok(Expr.Call(callee, List[Expr].new(), span));
    };

    parse_primary(self) Result[Expr] = {
        let t = self.current();

        when t.kind in {
            .Identifier(name) then {
                self.advance();
                return .Ok(Expr.Identifier(name, self.token_span(t)));
            },
            .KwSelf() then {
                self.advance();
                return .Ok(Expr.Identifier("self", self.token_span(t)));
            },
            .IntegerLiteral(value) then {
                self.advance();
                return .Ok(Expr.IntegerLiteral(value, self.token_span(t)));
            },
            .DurationLiteral(value, unit) then {
                self.advance();
                return self.build_duration_literal_expression(
                    value,
                    unit,
                    self.token_span(t),
                );
            },
            .FloatLiteral(value) then {
                self.advance();
                return .Ok(Expr.FloatLiteral(value, self.token_span(t)));
            },
            .StringLiteral(value) then {
                self.advance();
                let parsed = self.parse_string_literal_expr(
                    value,
                    self.span_from_start(t),
                ) or return;
                return .Ok(parsed);
            },
            .InterpolatedString(parts) then {
                self.advance();
                let parsed = self.parse_interpolated_string_expr(
                    parts,
                    self.span_from_start(t),
                ) or return;
                return .Ok(parsed);
            },
            .RuneLiteral(value) then {
                self.advance();
                return .Ok(Expr.RuneLiteral(value, self.token_span(t)));
            },
            .KwTrue() then {
                self.advance();
                return .Ok(Expr.BoolLiteral(true, self.token_span(t)));
            },
            .KwFalse() then {
                self.advance();
                return .Ok(Expr.BoolLiteral(false, self.token_span(t)));
            },
            .KwNull() then {
                self.advance();
                return .Ok(Expr.NullLiteral(self.token_span(t)));
            },
            .LParen() then {
                return self.parse_parenthesized_expression();
            },
            .LBrace() then {
                return self.parse_block_expression();
            },
            .LBracket() then {
                return self.parse_bracket_leading_expression();
            },
            .KwIf() then {
                return self.parse_if_expression();
            },
            .KwWhile() then {
                return self.parse_while_expression();
            },
            .KwFor() then {
                return self.parse_for_expression();
            },
            .KwWhen() then {
                return self.parse_when_expression();
            },
            .Dot() then {
                // Implicit member expression: .SomeName or .SomeName(args)
                let span = self.span_from_start(t);
                self.advance(); // consume '.'
                let member_name = self.expect_identifier("implicit member name") or return;
                if self.current().kind is not .LParen() then {
                    return .Error(
                        self.parser_error(
                            "Unexpected token: \(token_text(self.current())), expected: '(' after implicit member name",
                        ),
                    );
                };

                self.advance(); // consume '('
                let call_args = self.parse_argument_list_until_rparen(
                    "implicit member call",
                ) or return;
                when self.current().kind in {
                    .RParen() then {
                        self.advance();
                    },
                    _ then {
                        return .Error(
                            self.parser_error(
                                "Expected ')' after implicit member call arguments",
                            ),
                        );
                    },
                };
                return .Ok(Expr.ImplicitMemberExpr(member_name, call_args, span));
            },
            // Prefix ranges (`..b`, `..<b`, `..`) are parsed at the range
            // layer in `parse_range`, not here: accepting them as a primary
            // lets `a < ..b` parse the `..b` as a comparison operand, which
            // then reaches codegen as a comparison against a range. Anything
            // else that starts a primary is an error.
            _ then {
                return .Error(
                    self.parser_error_at(
                        "Unexpected token: \(token_text(t)), expected: number, identifier, boolean literal, block expression, or collection literal",
                        t,
                    ),
                );
            },
        };
    };

    parse_bracket_leading_expression(self) Result[Expr] = {
        return self.parse_collection_or_dict_literal();
    };

    extract_static_dispatch_receiver(
        self,
        expr Expr,
    ) Option[StaticDispatchReceiver] = {
        return when expr in {
            .Identifier(base_name, _) then if self.is_upper_first(base_name) then Option[StaticDispatchReceiver].Some(
                StaticDispatchReceiver(base_name, List[TypeNode].new()),
            ) else Option[StaticDispatchReceiver].None(),
            .GenericInstantiation(base_name, type_args, _) then {
                Option[StaticDispatchReceiver].Some(
                    StaticDispatchReceiver(base_name, type_args),
                )
            },
            .MemberPath(base_expr, path, _) then {
                if not path.is_empty() then {
                    if self.extract_static_dispatch_receiver(base_expr) is .Some(base_receiver) then {
                        if base_receiver.type_args.is_empty() then {
                            let mutable qualified = base_receiver.type_name;
                            let mutable all_upper = true;
                            for seg in path then {
                                if not self.is_upper_first(seg) then {
                                    all_upper = false;
                                } else {
                                    qualified = qualified + "." + seg;
                                };
                            };
                            if all_upper then {
                                return Option[StaticDispatchReceiver].Some(
                                    StaticDispatchReceiver(
                                        qualified,
                                        List[TypeNode].new(),
                                    ),
                                );
                            };
                        };
                    };

                    let last = path[path.count() - 1];
                    if self.is_upper_first(last) then {
                        Option[StaticDispatchReceiver].Some(
                            StaticDispatchReceiver(last, List[TypeNode].new()),
                        )
                    } else {
                        Option[StaticDispatchReceiver].None()
                    };
                };
                Option[StaticDispatchReceiver].None()
            },
            _ then Option[StaticDispatchReceiver].None(),
        };
    };

    member_path_call_receiver_expr(self, base Expr, path List[String]) Expr = {
        return if path.count() == 1 then base
        else {
            let mutable receiver_path = List[String].new();
            let mutable idx UInt = 0;
            while idx + 1 < path.count() then {
                receiver_path.push(path[idx]);
                idx += 1;
            };
            Expr.MemberPath(base, receiver_path, self.span_from_expr_start(base))
        };
    };

    parse_parenthesized_expression(self) Result[Expr] = {
        let start = self.current();
        // `(` opens a lambda, a parenthesized TYPE head, or a parenthesized
        // expression. The shape classifiers decide BEFORE anything is built,
        // so there is no trial parse to roll back and no failed branch to
        // swallow the better diagnostic.
        if self.is_lambda_expression() then {
            return self.parse_lambda_expression();
        };
        // A type head: `(` <exactly one type> `)` -- `(Point)`, `(*Foo)`.
        // A trailing comma disqualifies. The head desugars to the
        // identifier-based nodes it names; a head with no name (`*Foo`,
        // `?Foo`, `(A) -> R`, `Self`) becomes a `TypeRef`.
        if self.scan_paren_type_suffix_at(self.index) is .Some(_) then {
            return self.parse_parenthesized_type_head();
        };

        self.advance();
        let first = self.parse_expression_checked("parenthesized expression") or else as e in {
            return .Error(e);
        };
        when self.current().kind in {
            .Comma() then {
                // There is no tuple/pair literal. A `Pair` is built with its
                // own constructor, like any other type.
                return .Error(
                    self.parser_error_at_current(
                        "A pair literal is not an expression: construct a Pair with 'Pair(first, second)'",
                    ),
                );
            },
            .RParen() then {
                self.advance();
                return .Ok(first);
            },
            _ then {
                return .Error(
                    self.unexpected_token_error_at(
                        token_text(self.current()),
                        "')'",
                        self.current(),
                    ),
                );
            },
        };
    };

    /// `( <type> )` in expression position: a type head. The SHAPE has already
    /// been decided by `scan_paren_type_suffix_at` -- this only builds the
    /// node. A nameable head desugars to the identifier-based nodes (`(Point)`
    /// is `Point`, `(List[Int])` is `List[Int]`); anything else is a `TypeRef`
    /// over the parenthesized type. The type node's span covers the parens,
    /// the same transparent grouping the type position does.
    parse_parenthesized_type_head(self) Result[Expr] = {
        let start = self.current();
        self.advance();
        let inner_type = self.parse_type() or return;
        when self.current().kind in {
            .RParen() then {
                self.advance();
            },
            _ then {
                return .Error(self.parser_error("Expected ')' after parenthesized type"));
            },
        };
        let span = self.span_from_start(start);
        let type_node = type_node_with_span(inner_type, span);
        return .Ok(self.expr_from_type_head(type_node, span));
    };

    /// The expression a parenthesized type head stands for. Identifier-based
    /// heads carry their name into the existing nodes; a head with no name is
    /// a `TypeRef`.
    expr_from_type_head(self, type_node TypeNode, span SourceSpan) Expr = {
        return when type_node in {
            .Identifier(name, _) then Expr.Identifier(name, span),
            .Generic(base, args, _) then Expr.GenericInstantiation(base, args, span),
            _ then Expr.TypeRef(type_node, span),
        };
    };

    parse_block_expression(self) Result[Expr] = {
        let start = self.current();
        when self.current().kind in {
            .LBrace() then {
                self.advance();
            },
            _ then {
                return .Error(self.parser_error("Expected '{' to start block"));
            },
        };

        self.parse_debug("block begin");
        // Mirrors Swift ParserExpressions.blockExpression(): statements are
        // ';'-terminated; a final expression with no ';' is the block's value.
        let mutable statements = List[Statement].new();
        let mutable tail_expression = Option[Expr].None();
        let mutable finished = false;
        while not finished then {
            when self.current().kind in {
                .RBrace() then {
                    finished = true;
                },
                .Eof() then {
                    return .Error(self.parser_error("Unexpected end of file"));
                },
                _ then {
                    let stmt_start = self.current();
                    let is_declaration_statement = self.current().kind is .KwLet() or is .KwReturn() or is .KwBreak() or is .KwContinue() or is .KwDefer();
                    if is_declaration_statement then {
                        let before = self.index;
                        let parsed = self.parse_statement() or return;
                        if self.index == before then {
                            let t = self.current();
                            return .Error(
                                self.parser_error_at(
                                    self.format_progress_error(
                                        "Parser made no progress in ",
                                        "block",
                                        t,
                                    ),
                                    t,
                                ),
                            );
                        };
                        statements.push(parsed);
                        while not self.pending_statements.is_empty() then {
                            statements.push(self.pending_statements.take_at(0));
                        };
                    } else {
                        let expr = self.parse_expression_checked("block expression") or return;
                        if self.is_assignment_operator() then {
                            let op = self.parse_assignment_operator() or else {
                                return .Error(
                                    self.parser_error_at_current(
                                        "Unknown assignment operator",
                                    ),
                                );
                            };
                            self.advance();
                            let rhs = self.parse_expression_checked(
                                "assignment right-hand side",
                            ) or return;
                            let _ = self.require_semicolon() or return;
                            statements.push(
                                Statement.AssignmentStmt(
                                    expr,
                                    op,
                                    rhs,
                                    self.span_from_start(stmt_start),
                                ),
                            );
                        } else {
                            when self.current().kind in {
                                .Semicolon() then {
                                    self.advance();
                                    statements.push(
                                        Statement.ExprStmt(
                                            expr,
                                            self.span_from_start(stmt_start),
                                        ),
                                    );
                                },
                                _ then {
                                    tail_expression = Option[Expr].Some(expr);
                                    finished = true;
                                },
                            };
                        };
                    };
                },
            };
        };
        when self.current().kind in {
            .RBrace() then {
                self.advance();
            },
            // An expression with no ';' is the block's value, so the block is
            // over: say so. "Unexpected token" alone leaves the reader guessing
            // whether a ';' or a '}' was wanted.
            _ then {
                let t = self.current();
                return .Error(
                    self.unexpected_token_error_at(token_kind_description(t), "'}'", t),
                );
            },
        };

        let span = self.span_from_start(start);
        return .Ok(Expr.Block(statements, tail_expression, span));
    };

    /// Named or positional? Decided by a BOUNDED two-token shape rule -- a
    /// lower-first `ident` immediately followed by `:` -- so nothing is parsed
    /// speculatively. The only rewind left is on the error path: the argument
    /// is reported at its first token, not after the label and colon.
    parse_call_argument(self, context String) Result[Expr] = {
        let start = self.current();

        when self.current_labeled_argument_name(true) in {
            .Some(label) then {
                let saved = self.save_state();
                self.advance();
                self.advance();
                let expr = when self.parse_expression_checked(
                    "named \(context) argument",
                ) in {
                    .Ok(parsed) then parsed,
                    .Error(inner) then {
                        self.restore_state(saved);
                        return .Error(inner);
                    },
                };
                return .Ok(Expr.NamedArgument(label, expr, self.span_from_start(start)));
            },
            .None() then {},
        };

        return self.parse_expression_checked("\(context) arguments");
    };

    parse_pattern_argument(self, stop_on_in Bool) Result[PatternElement] = {
        // The rest marker is a slot of its own: it is never labeled and never
        // a full pattern.
        if self.current().kind is .Ellipsis() then {
            let pattern = self.parse_rest_pattern_slot() or return;
            return .Ok(PatternElement(Option[String].None(), pattern));
        };
        when self.current_labeled_argument_name(false) in {
            .Some(label) then {
                // `label: ...` has no meaning -- the rest marker swallows
                // unnamed slots.
                let probe_saved = self.save_state();
                self.advance();
                self.advance();
                let labeled_rest = self.current().kind is .Ellipsis();
                self.restore_state(probe_saved);
                if labeled_rest then {
                    return .Error(
                        self.parser_error("Rest pattern cannot be labeled"),
                    );
                };
                let saved = self.save_state();
                self.advance();
                self.advance();
                let pattern = when self.parse_pattern_or(stop_on_in) in {
                    .Ok(parsed) then parsed,
                    .Error(inner) then {
                        self.restore_state(saved);
                        return .Error(inner);
                    },
                };
                return .Ok(PatternElement(Option[String].Some(label), pattern));
            },
            .None() then {},
        };

        let pattern = self.parse_pattern_or(stop_on_in) or return;
        return .Ok(PatternElement(Option[String].None(), pattern));
    };

    /// Parse the rest marker `...` as one slot of an element list. It swallows
    /// zero or more of the remaining slots and never binds, so anything that
    /// looks like a name after it is a mistake worth naming.
    parse_rest_pattern_slot(self) Result[PatternNode] = {
        let start = self.current();
        self.advance();
        if self.current().kind is .Identifier(_) then {
            return .Error(
                self.parser_error("Rest pattern cannot bind a name"),
            );
        };
        return .Ok(PatternNode.RestPattern(self.span_from_start(start)));
    };

    /// Parse one slot of an element list: a sub-pattern, or the rest marker `...`.
    parse_pattern_slot(self, stop_on_in Bool) Result[PatternNode] = {
        if self.current().kind is .Ellipsis() then {
            return self.parse_rest_pattern_slot();
        };
        return self.parse_pattern_or(stop_on_in);
    };

    /// Whether a rest slot may share its element list with other slots.
    ///
    /// In a LIST element list `...` swallows the unwritten middle, so it sits
    /// among the written slots. In a fixed-arity element list -- struct, enum
    /// case, tuple -- it is whole-list elision and nothing else, so it must be
    /// the only slot: the fields it would ignore are named by the declaration,
    /// and `...` has no per-field opinion to offer.
    check_rest_slots(
        self,
        elements List[PatternNode],
        rest_must_stand_alone Bool,
    ) Result[Void] = {
        let mutable seen = false;
        for element in elements then {
            if element is .RestPattern(_) then {
                if rest_must_stand_alone and elements.count() > 1 then {
                    return .Error(
                        self.parser_error_at_span(
                            "Rest pattern must be the only slot in a struct, enum or tuple pattern; use '_' for the other fields",
                            pattern_span(element),
                        ),
                    );
                };
                if seen then {
                    return .Error(
                        self.parser_error_at_span(
                            "Only one rest pattern is allowed per element list",
                            pattern_span(element),
                        ),
                    );
                };
                seen = true;
            };
        };
        return .Ok({});
    };

    parse_argument_list_until_rparen(
        self,
        context String,
    ) Result[List[Expr]] = {
        let mutable args = List[Expr].new();
        if self.current().kind is .RParen() then {
            return .Ok(args);
        };

        while true then {
            let parsed = self.parse_call_argument(context) or else as e in {
                return .Error(e);
            };
            args.push(parsed);
            if self.current().kind is .Comma() then {
                self.advance();
                if self.current().kind is .RParen() then {
                    break;
                };
            } else {
                break;
            };
        };

        return .Ok(args);
    };

    reject_non_constructor_call_args(
        self,
        args List[Expr],
    ) Result[List[Expr]] = {
        for arg in args then {
            when arg in {
                // Named labels are now allowed for all calls (functions,
                // methods, constructors); nothing is rejected per-argument.
                .NamedArgument(...) then {},
                _ then {},
            };
        };
        return .Ok(args);
    };

    call_target_allows_constructor_argument_syntax(self, callee Expr) Bool = {
        return when callee in {
            .Identifier(name, _) then self.is_upper_first(name),
            .GenericInstantiation(base, _, _) then self.is_upper_first(base),
            .MemberPath(_, path, _) then if not path.is_empty() then self.is_upper_first(
                path[path.count() - 1],
            ) else false,
            _ then false,
        };
    };

    static_dispatch_allows_constructor_argument_syntax(
        self,
        receiver Option[StaticDispatchReceiver],
        member String,
    ) Bool = {
        let _ = self;
        return self.is_upper_first(member) and receiver is .Some(_);
    };

    parse_control_flow_body(self) Result[Expr] = {
        return self.parse_expression_checked("control-flow body");
    };

    parse_when_arm_body(self) Result[Expr] = {
        // `when` arm body follows expression grammar; block is one expression form.
        if self.current().kind is .LBrace() then {
            let body = self.parse_block_expression() or return;
            return .Ok(body);
        };
        return self.parse_expression_checked("when arm body");
    };

    expect_kw_then(self, context String) Result[Token] = {
        let t = self.current();
        when t.kind in {
            .KwThen() then {
                self.advance();
                return .Ok(t);
            },
            _ then {
                return .Error(self.parser_error_at("Expected 'then' in \(context)", t));
            },
        };
    };

    expect_kw_in(self, context String) Result[Token] = {
        let t = self.current();
        when t.kind in {
            .KwIn() then {
                self.advance();
                return .Ok(t);
            },
            _ then {
                return .Error(self.parser_error_at("Expected 'in' in \(context)", t));
            },
        };
    };

    expect_lbrace(self, context String) Result[Token] = {
        let t = self.current();
        when t.kind in {
            .LBrace() then {
                self.advance();
                return .Ok(t);
            },
            _ then {
                return .Error(
                    self.parser_error_at("Expected '{' to start \(context)", t),
                );
            },
        };
    };

    parse_when_arm(self) Result[WhenArm] = {
        let arm_start_index = self.index;
        let arm_start = self.current();
        self.parse_debug(
            "when arm begin @ \(arm_start.line):\(arm_start.column) token=\(token_text(arm_start))",
        );
        let pattern = self.parse_pattern_or(false) or return;

        // Arm guard: `pat where cond then body`. The condition parses like an
        // `if` condition and stops before `then`.
        let mutable arm_guard = Option[Expr].None();
        when self.current().kind in {
            .KwWhere() then {
                self.advance();
                let guard_expr = self.parse_expression_checked("when arm guard") or return;
                arm_guard = .Some(guard_expr);
            },
            .KwIf() then {
                // The retired guard spelling. Letting it fall through would say
                // "Expected 'then' in when arm" -- true, but nowhere near the
                // mistake, so it names the replacement here the way the lexer
                // names `<>`.
                return .Error(
                    self.parser_error("Pattern guards use 'where', not 'if'"),
                );
            },
            _ then {},
        };

        let _ = self.expect_kw_then("when arm") or return;

        let body = self.parse_when_arm_body() or return;

        if self.index == arm_start_index then {
            let t = self.current();
            return .Error(
                self.parser_error_at(
                    self.format_progress_error(
                        "Parser made no progress in ",
                        "when arm",
                        t,
                    ),
                    t,
                ),
            );
        };

        return .Ok(WhenArm(pattern, arm_guard, body, false, false));
    };

    parse_when_arms(self) Result[List[WhenArm]] = {
        let mutable arms = List[WhenArm].new();
        while true then {
            when self.current().kind in {
                .RBrace() then {
                    self.advance();
                    break;
                },
                .Eof() then {
                    return .Error(
                        self.parser_error("Unexpected EOF in when expression"),
                    );
                },
                _ then {
                    let arm = self.parse_when_arm() or return;
                    arms.push(arm);
                    when self.current().kind in {
                        .Comma() then {
                            self.advance();
                        },
                        .RBrace() then {},
                        _ then {
                            let t = self.current();
                            return .Error(
                                self.unexpected_token_error_at(
                                    token_kind_description(t),
                                    "',' or '}' after when arm",
                                    t,
                                ),
                            );
                        },
                    };
                },
            };
        };
        return .Ok(arms);
    };

    /// `> n`, `< n`, `>= n`, `<= n`. The operand is an integer, float, or rune
    /// literal; a sign folds into a numeric value and a rune is never negative
    /// (grammar.bnf <comparison-pattern>).
    parse_comparison_pattern(
        self,
        start Token,
        op ComparisonPatternOperator,
    ) Result[PatternNode] = {
        self.advance();
        let mutable is_negative = false;
        if self.current().kind is .Minus() then {
            self.advance();
            is_negative = true;
        };
        when self.current().kind in {
            .IntegerLiteral(v) then {
                self.advance();
                return .Ok(
                    PatternNode.ComparisonPattern(
                        op,
                        if is_negative then "-\(v)" else v,
                        ComparisonPatternValueKind.Integer(),
                        self.span_from_start(start),
                    ),
                );
            },
            .FloatLiteral(v) then {
                self.advance();
                return .Ok(
                    PatternNode.ComparisonPattern(
                        op,
                        if is_negative then "-\(v)" else v,
                        ComparisonPatternValueKind.Float(),
                        self.span_from_start(start),
                    ),
                );
            },
            .RuneLiteral(v) then {
                if is_negative then {
                    return .Error(
                        self.parser_error(
                            "Expected integer or float literal after '-'",
                        ),
                    );
                };
                self.advance();
                return .Ok(
                    PatternNode.ComparisonPattern(
                        op,
                        v,
                        ComparisonPatternValueKind.Rune(),
                        self.span_from_start(start),
                    ),
                );
            },
            _ then {
                return .Error(
                    self.parser_error(
                        "Expected integer, float, or rune literal in comparison pattern",
                    ),
                );
            },
        };
    };

    parse_pattern_primary(self, stop_on_in Bool) Result[PatternNode] = {
        let start = self.current();

        when self.current().kind in {
            .Eof() then {
                return .Error(self.parser_error("Unexpected EOF while parsing pattern"));
            },
            .KwThen() then {
                if not stop_on_in then {
                    return .Error(self.parser_error("Expected pattern before 'then'"));
                };
            },
            .KwIn() then {
                if stop_on_in then {
                    return .Error(self.parser_error("Expected pattern before 'in'"));
                };
            },
            _ then {},
        };

        // The rest marker is only ever a slot of a list / enum-case / struct /
        // tuple element list, where it swallows the slots that were not written.
        // Everywhere else -- a whole arm, an `is` subject, `not ...`, a lone
        // `( ... )` -- there is no element list to swallow, so it is a mistake.
        if self.current().kind is .Ellipsis() then {
            return .Error(
                self.parser_error(
                    "Rest pattern must be inside a list, enum, struct, or tuple pattern",
                ),
            );
        };

        let mutable node = PatternNode.Wildcard(self.span_from_start(start));
        when self.current().kind in {
            .QuestionMark() then {
                // `?v` patterns are removed. Use `?expr` to get `Option[T]`
                // and match on `.Some` / `.None`.
                return .Error(
                    self.parser_error(
                        "Weak binding pattern '?v' is removed; use '?expr' to get Option[T]",
                    ),
                );
            },
            .KwMut() then {
                self.advance();
                let name = self.expect_identifier("mutable pattern variable") or return;
                if self.current().kind is .Identifier(type_name) and self.is_upper_first(
                    type_name,
                ) then {
                    self.advance();
                    return .Ok(
                        PatternNode.TraitObjectTypeBinding(
                            name,
                            true,
                            TypeNode.Identifier(type_name, unknown_span()),
                            self.span_from_start(start),
                        ),
                    );
                };
                return .Ok(
                    PatternNode.Variable(name, true, self.span_from_start(start)),
                );
            },
            .KwTrue() then {
                self.advance();
                node = PatternNode.BoolLiteral(true, self.span_from_start(start));
            },
            .KwFalse() then {
                self.advance();
                node = PatternNode.BoolLiteral(false, self.span_from_start(start));
            },
            .KwNull() then {
                self.advance();
                node = PatternNode.NullLiteral(self.span_from_start(start));
            },
            .Minus() then {
                self.advance();
                when self.current().kind in {
                    .FloatLiteral(v) then {
                        self.advance();
                        node = PatternNode.FloatLiteral(
                            "-\(v)",
                            self.span_from_start(start),
                        );
                    },
                    .IntegerLiteral(v) then {
                        self.advance();
                        node = PatternNode.NegativeIntegerLiteral(
                            v,
                            self.span_from_start(start),
                        );
                    },
                    _ then {
                        return .Error(
                            self.parser_error(
                                "Expected integer or float literal after '-'",
                            ),
                        );
                    },
                };
            },
            .IntegerLiteral(value) then {
                self.advance();
                node = PatternNode.IntegerLiteral(value, self.span_from_start(start));
            },
            .FloatLiteral(value) then {
                self.advance();
                node = PatternNode.FloatLiteral(value, self.span_from_start(start));
            },
            .StringLiteral(value) then {
                self.advance();
                node = PatternNode.StringLiteral(value, self.span_from_start(start));
            },
            .RuneLiteral(value) then {
                self.advance();
                node = PatternNode.RuneLiteral(value, self.span_from_start(start));
            },
            .Greater() then {
                return self.parse_comparison_pattern(
                    start,
                    ComparisonPatternOperator.Greater(),
                );
            },
            .Less() then {
                return self.parse_comparison_pattern(
                    start,
                    ComparisonPatternOperator.Less(),
                );
            },
            .GreaterEqual() then {
                return self.parse_comparison_pattern(
                    start,
                    ComparisonPatternOperator.GreaterEqual(),
                );
            },
            .LessEqual() then {
                return self.parse_comparison_pattern(
                    start,
                    ComparisonPatternOperator.LessEqual(),
                );
            },
            .Identifier(name) then {
                self.advance();
                if name == "_" then {
                    return .Ok(PatternNode.Wildcard(self.span_from_start(start)));
                };
                let mutable parsed_pattern = PatternNode.Variable(
                    name,
                    false,
                    self.span_from_start(start),
                );
                if self.current().kind is .Identifier(type_name) and self.is_upper_first(
                    type_name,
                ) then {
                    self.advance();
                    return .Ok(
                        PatternNode.TraitObjectTypeBinding(
                            name,
                            false,
                            TypeNode.Identifier(type_name, unknown_span()),
                            self.span_from_start(start),
                        ),
                    );
                };
                if self.is_upper_first(name) then {
                    let mutable resolved_named_type = TypeNode.Identifier(
                        name,
                        unknown_span(),
                    );
                    if self.current().kind is .LBracket() then {
                        let type_args = self.parse_type_arg_list() or return;
                        resolved_named_type = TypeNode.Generic(
                            name,
                            type_args,
                            unknown_span(),
                        );
                    };
                    if self.current().kind is not .LParen() then {
                        return .Ok(
                            PatternNode.TraitObjectType(
                                resolved_named_type,
                                self.span_from_start(start),
                            ),
                        );
                    };
                    if self.current().kind is .LParen() then {
                        self.advance();
                        let mutable elements = List[PatternElement].new();
                        if self.current().kind is .RParen() then {
                            self.advance();
                        } else {
                            while true then {
                                let elem = self.parse_pattern_argument(stop_on_in) or return;
                                elements.push(elem);
                                if self.current().kind is .Comma() then {
                                    self.advance();
                                } else {
                                    break;
                                };
                            };
                            when self.current().kind in {
                                .RParen() then {
                                    self.advance();
                                },
                                _ then {
                                    return .Error(
                                        self.parser_error(
                                            "Expected ')' in struct destructuring pattern",
                                        ),
                                    );
                                },
                            };
                        };
                        let mutable slot_patterns = List[PatternNode].new();
                        for elem in elements then {
                            slot_patterns.push(elem.pattern);
                        };
                        let _ = self.check_rest_slots(slot_patterns, true) or return;
                        parsed_pattern = PatternNode.StructPattern(
                            name,
                            elements,
                            self.span_from_start(start),
                        );
                    };
                };
                if not self.is_upper_first(name) and not self.is_valid_value_name(name) then {
                    // `start` is the identifier token itself; the check runs after
                    // parsing the rest of the pattern, so `current()` is long past it.
                    return .Error(
                        self.parser_error_at(
                            self.invalid_variable_name_error(name),
                            start,
                        ),
                    );
                };
                node = parsed_pattern;
            },
            .Dot() then {
                self.advance();
                let case_name_token = self.current();
                let case_name = self.expect_identifier("enum case pattern") or return;
                if not self.is_upper_first(case_name) then {
                    return .Error(
                        self.parser_error_at(
                            self.invalid_enum_case_name_error(case_name),
                            case_name_token,
                        ),
                    );
                };
                let mutable elements = List[PatternElement].new();

                if self.current().kind is not .LParen() then {
                    return .Error(
                        self.parser_error("Expected '(' after enum case name"),
                    );
                };
                self.advance();
                if self.current().kind is .RParen() then {
                    self.advance();
                } else {
                    while true then {
                        let elem = self.parse_pattern_argument(stop_on_in) or return;
                        elements.push(elem);
                        if self.current().kind is .Comma() then {
                            self.advance();
                        } else {
                            break;
                        };
                    };
                    when self.current().kind in {
                        .RParen() then {
                            self.advance();
                        },
                        _ then {
                            return .Error(
                                self.parser_error("Expected ')' in enum case pattern"),
                            );
                        },
                    };
                };

                let mutable slot_patterns = List[PatternNode].new();
                for elem in elements then {
                    slot_patterns.push(elem.pattern);
                };
                let _ = self.check_rest_slots(slot_patterns, true) or return;
                node = PatternNode.EnumCase(
                    case_name,
                    elements,
                    self.span_from_start(start),
                );
            },
            .LBracket() then {
                // List destructuring pattern: `[a, b]` against a `List[T]`.
                // A rest slot turns the exact length into a lower bound.
                self.advance();
                let mutable elements = List[PatternNode].new();
                while self.current().kind is not .RBracket() then {
                    let elem = self.parse_pattern_slot(stop_on_in) or return;
                    elements.push(elem);
                    if self.current().kind is .Comma() then {
                        self.advance();
                    };
                };
                self.advance();
                let _ = self.check_rest_slots(elements, false) or return;
                node = PatternNode.ListPattern(
                    elements,
                    self.span_from_start(start),
                );
            },
            .LParen() then {
                self.advance();
                let first = self.parse_pattern_slot(stop_on_in) or return;
                // `(p)` is a parenthesized pattern. `(p, q, ...)` is a TUPLE
                // pattern: positional destructuring of a struct with exactly
                // that many fields, in declaration order. There must be at
                // least two slots. `Pair` is destructured this way too -- it is
                // simply a two-field struct.
                let mutable parsed_pattern = first;
                if self.current().kind is .Comma() then {
                    let mutable slot_elements = List[PatternNode].new();
                    slot_elements.push(first);
                    while self.current().kind is .Comma() then {
                        self.advance();
                        let next = self.parse_pattern_slot(stop_on_in) or return;
                        slot_elements.push(next);
                    };
                    when self.current().kind in {
                        .RParen() then {
                            self.advance();
                        },
                        _ then {
                            return .Error(
                                self.parser_error("Expected ')' in tuple pattern"),
                            );
                        },
                    };
                    let _ = self.check_rest_slots(slot_elements, true) or return;
                    let mutable elements = List[PatternElement].new();
                    for slot in slot_elements then {
                        elements.push(PatternElement(Option[String].None(), slot));
                    };
                    parsed_pattern = PatternNode.TuplePattern(
                        elements,
                        self.span_from_start(start),
                    );
                } else {
                    // `(` in pattern position opens a tuple, which needs at
                    // least two slots. A single parenthesized pattern groups
                    // nothing to group: a `when` arm is already a full
                    // pattern, and under `is` the combinators are the
                    // connectors `or is` / `and is`, which live outside the
                    // slot.
                    return .Error(
                        self.parser_error_at(
                            "A parenthesized pattern groups nothing; `(` starts a tuple pattern with at least two slots. Under 'is', combine tests with 'or is' / 'and is'",
                            start,
                        ),
                    );
                };
                node = parsed_pattern;
            },
            _ then {
                // Same shape as every other "unexpected token" in the parser,
                // and the same one the frozen reference produces here. The span
                // already says the token is inside a pattern.
                return .Error(
                    self.parser_error("Unexpected token: \(token_text(self.current()))"),
                );
            },
        };
        return .Ok(node);
    };

    parse_pattern_not(self, stop_on_in Bool) Result[PatternNode] = {
        let start = self.current();
        if self.current().kind is .KwNot() then {
            self.advance();
            let inner = self.parse_pattern_not(stop_on_in) or return;
            return .Ok(PatternNode.NotPattern(inner, self.span_from_start(start)));
        };
        return self.parse_pattern_primary(stop_on_in);
    };

    parse_pattern_and(self, stop_on_in Bool) Result[PatternNode] = {
        let start = self.current();
        let mutable left = self.parse_pattern_not(stop_on_in) or return;

        while self.current().kind is .KwAnd() then {
            self.advance();
            let right = self.parse_pattern_primary(stop_on_in) or return;
            left = PatternNode.AndPattern(left, right, self.span_from_start(start));
        };

        return .Ok(left);
    };

    parse_pattern_or(self, stop_on_in Bool) Result[PatternNode] = {
        let start = self.current();
        let mutable left = self.parse_pattern_and(stop_on_in) or return;

        while true then {
            when self.current().kind in {
                .KwOr() then {
                    self.advance();
                },
                .Pipe() then {
                    return .Error(
                        self.parser_error(
                            "Pattern separator '|' is not supported; use 'or'",
                        ),
                    );
                },
                _ then {
                    break;
                },
            };
            let right = self.parse_pattern_and(stop_on_in) or return;
            left = PatternNode.OrPattern(left, right, self.span_from_start(start));
        };

        return .Ok(left);
    };

    collect_pattern_until_then(self) Result[PatternNode] = {
        let pattern = self.parse_pattern_or(false) or return;
        when self.current().kind in {
            .KwThen() then {
                return .Ok(pattern);
            },
            _ then {
                return .Error(self.parser_error("Expected 'then' after pattern"));
            },
        };
    };

    parse_single_pattern(self) Result[PatternNode] = {
        return self.parse_pattern_primary(false);
    };

    collect_pattern_until_clause_end(self) Result[PatternNode] = {
        let pattern = self.parse_pattern_or(false) or return;
        when self.current().kind in {
            .KwThen() then {
                return .Ok(pattern);
            },
            .Semicolon() then {
                return .Ok(pattern);
            },
            _ then {
                return .Error(self.parser_error("Expected ';' or 'then' after pattern"));
            },
        };
    };

    collect_pattern_until_in(self) Result[PatternNode] = {
        let pattern = self.parse_pattern_or(true) or return;
        when self.current().kind in {
            .KwIn() then {
                return .Ok(pattern);
            },
            _ then {
                return .Error(self.parser_error("Expected 'in' after pattern"));
            },
        };
    };

    parse_collection_or_dict_literal(self) Result[Expr] = {
        let start = self.current();
        self.advance();

        if self.current().kind is .RBracket() then {
            self.advance();
            return .Ok(Expr.EmptyLiteral(self.span_from_start(start)));
        };

        let first = self.parse_expression() or else as e in {
            return .Error(e);
        };

        if self.current().kind is .Colon() then {
            self.advance();
            let first_value = self.parse_expression() or else as e in {
                return .Error(e);
            };
            let mutable entries = List[ExprPair].new();
            entries.push(ExprPair(first, first_value));

            while self.current().kind is .Comma() then {
                self.advance();
                if self.current().kind is .RBracket() then {
                    break;
                };
                let key = self.parse_expression() or else as e in {
                    return .Error(e);
                };
                when self.current().kind in {
                    .Colon() then {
                        self.advance();
                    },
                    _ then {
                        return .Error(
                            self.unexpected_token_error_at(
                                token_text(self.current()),
                                "':' in dict literal entry",
                                self.current(),
                            ),
                        );
                    },
                };
                let value = self.parse_expression() or else as e in {
                    return .Error(e);
                };
                entries.push(ExprPair(key, value));
            };

            when self.current().kind in {
                .RBracket() then {
                    self.advance();
                },
                _ then {
                    return .Error(self.parser_error("Expected ']' after dict literal"));
                },
            };
            return .Ok(Expr.DictLiteral(entries, self.span_from_start(start)));
        };

        let mutable elements = List[Expr].new();
        elements.push(first);

        while self.current().kind is .Comma() then {
            self.advance();
            if self.current().kind is .RBracket() then {
                break;
            };
            let next = self.parse_expression() or else as e in {
                return .Error(e);
            };
            elements.push(next);
        };

        when self.current().kind in {
            .RBracket() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error("Expected ']' after collection literal"),
                );
            },
        };
        return .Ok(Expr.CollectionLiteral(elements, self.span_from_start(start)));
    };

    parse_when_expression(self) Result[Expr] = {
        let start = self.current();
        self.advance();
        let subject = self.parse_expression_checked("when subject") or return;

        let _ = self.expect_kw_in("when expression") or return;

        let _ = self.expect_lbrace("when arms") or return;

        let arms = self.parse_when_arms() or return;

        return .Ok(Expr.WhenExpr(subject, arms, self.span_from_start(start)));
    };

    parse_if_expression(self) Result[Expr] = {
        let start = self.current();
        self.advance();
        let condition = self.parse_expression_checked("if condition") or return;

        let _ = self.expect_kw_then("if expression") or return;
        let then_expr = self.parse_control_flow_body() or return;

        let mutable else_expr = Option[Expr].None();
        if self.current().kind is .KwElse() then {
            self.advance();
            let parsed_else = self.parse_expression_checked("if else body") or return;
            else_expr = .Some(parsed_else);
        };

        let span = self.span_from_start(start);
        return .Ok(Expr.IfExpr(condition, then_expr, else_expr, span));
    };

    parse_while_expression(self) Result[Expr] = {
        let start = self.current();
        self.advance();
        let condition = self.parse_expression_checked("while condition") or return;

        let _ = self.expect_kw_then("while expression") or return;
        let body = self.parse_control_flow_body() or return;

        let span = self.span_from_start(start);
        return .Ok(Expr.WhileExpr(condition, body, span));
    };

    /// `for <match-pattern> "in" <expression> ("where" <expression>)? "then" <body>`
    ///
    /// The binding is a full match pattern -- the same one a `when` arm takes.
    /// It must be IRREFUTABLE; that is the checker's business, not the
    /// parser's. The optional `where` guard sits after the iterable, right
    /// before `then`, the same slot a `when` arm guard takes before its `then`.
    parse_for_expression(self) Result[Expr] = {
        let start = self.current();
        self.advance();
        let pattern = self.parse_pattern_or(false) or return;

        let _ = self.expect_kw_in("for expression") or return;

        let iterable = self.parse_expression_checked("for iterable") or return;

        let mutable guard = Option[Expr].None();
        when self.current().kind in {
            .KwWhere() then {
                self.advance();
                let guard_expr = self.parse_expression_checked("for guard") or return;
                guard = .Some(guard_expr);
            },
            .KwIf() then {
                // The retired guard spelling, and the one a reader coming from
                // `when` arms reaches for first. Falling through would say
                // "Expected 'then' in for expression" -- true, but nowhere near
                // the mistake.
                return .Error(
                    self.parser_error("Pattern guards use 'where', not 'if'"),
                );
            },
            _ then {},
        };

        let _ = self.expect_kw_then("for expression") or return;

        let body = self.parse_control_flow_body() or return;

        return .Ok(
            Expr.ForExpr(pattern, iterable, body, guard, self.span_from_start(start)),
        );
    };

    parse_postfix_generic_application(self, base Expr) Result[Expr] = {
        return when base in {
            .Identifier(name, _) then {
                let type_args = self.parse_type_arg_list() or return;
                .Ok(
                    Expr.GenericInstantiation(
                        name,
                        type_args,
                        self.span_from_expr_start(base),
                    ),
                )
            },
            _ then .Error(
                self.parser_error_at_current(
                    "generic application requires a type-like base expression",
                ),
            ),
        };
    };

    // `m[T](...)` after a `.member`: `[` `<type-list>` `]` `(` is a generic
    // method call. The same `[` `<type-list>` `]` WITHOUT the `(` is type
    // arguments written on a method that takes none. Both are decided by one
    // bounded scan of the bracketed run plus the token after it -- no trial
    // parse, no rollback.
    method_type_args_shape(self) Option[Bool] = {
        if self.current().kind is not .LBracket() then {
            return Option[Bool].None();
        };
        let after_list = self.scan_type_list_at(self.index) or else {
            return Option[Bool].None();
        };
        if after_list >= self.tokens.count() then {
            return Option[Bool].None();
        };
        return Option[Bool].Some(self.tokens[after_list].kind is .LParen());
    };

    // Rust-style qualified path `Type(Trait)`: the base must be a type name and
    // the parenthesized part must be a trait reference. Swift parses this before
    // falling back to a call (ParserExpressions.swift:734-738). Without it
    // `Num(Tag)` becomes a constructor call, so `Tag` is resolved as an ordinary
    // type — which both mis-dispatches the method and trips the object-safety
    // check on a trait that is only being named for qualification.
    qualified_path_base_is_type_name(self, base Expr) Bool = {
        return when base in {
            .Identifier(name, _) then self.is_upper_first(name),
            .GenericInstantiation(_, _, _) then true,
            _ then false,
        };
    };

    /// Parses the `(Trait[Args])` qualification of a qualified call.
    /// The SHAPE has already been decided by `scan_paren_type_suffix_at` -- this
    /// only builds the node.
    parse_qualified_trait_ref(self) Result[TypeNode] = {
        self.advance();
        let trait_type = self.parse_type() or return;
        when self.current().kind in {
            .RParen() then {
                self.advance();
            },
            _ then {
                return .Error(self.parser_error("Expected ')' after qualified trait"));
            },
        };
        return .Ok(trait_type);
    };

    /// Parses the composite `base(Trait).method(...)` /
    /// `base(Trait).method[TypeArgs](...)` qualified call. The `(Trait)` SHAPE
    /// has already been decided by `scan_paren_type_suffix_at`; this consumes
    /// the qualification AND the method call, so the prefix never exists on its
    /// own. `base` is a type name for `Type(Trait).method` and any other
    /// expression for `expr(Trait).method`.
    parse_qualified_call_suffix(self, base Expr) Result[Expr] = {
        let trait_type = self.parse_qualified_trait_ref() or return;
        when self.current().kind in {
            .Dot() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error(
                        "A qualified call must include its method call: write 'base(Trait).method(...)'. Casts are written 'Type(expr)', not 'expr(Type)'",
                    ),
                );
            },
        };
        let member = self.expect_identifier("qualified method call") or return;
        let type_args_shape = self.method_type_args_shape();
        let method_type_args = when type_args_shape in {
            .Some(has_call) then if has_call then self.parse_type_arg_list() or return
            else List[TypeNode].new(),
            .None() then List[TypeNode].new(),
        };
        when self.current().kind in {
            .LParen() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error("Expected '(' after qualified method name"),
                );
            },
        };
        let args = self.parse_argument_list_until_rparen("qualified method call") or return;
        when self.current().kind in {
            .RParen() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error(
                        "Expected ')' after qualified method call arguments",
                    ),
                );
            },
        };
        when self.reject_non_constructor_call_args(args) in {
            .Ok(_) then {},
            .Error(e) then {
                return .Error(e);
            },
        };
        return if method_type_args.is_empty() then .Ok(
            Expr.QualifiedMethodCall(
                base,
                trait_type,
                member,
                args,
                self.span_from_expr_start(base),
            ),
        )
        else .Ok(
            Expr.QualifiedGenericMethodCall(
                base,
                trait_type,
                method_type_args,
                member,
                args,
                self.span_from_expr_start(base),
            ),
        );
    };

    parse_call_suffix(self, base Expr) Result[Expr] = {
        self.advance();
        let args = self.parse_argument_list_until_rparen("call") or return;
        when self.current().kind in {
            .RParen() then {
                self.advance();
            },
            _ then {
                return .Error(self.parser_error("Expected ')' after call arguments"));
            },
        };
        when base in {
            .MemberPath(receiver_base, path, _) then {
                if path.is_empty() then {
                    when self.reject_non_constructor_call_args(args) in {
                        .Ok(_) then {},
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    return .Ok(Expr.Call(base, args, self.span_from_expr_start(base)));
                };
                let member = path[path.count() - 1];
                let receiver_expr = self.member_path_call_receiver_expr(
                    receiver_base,
                    path,
                );
                let allows_constructor_args = self.static_dispatch_allows_constructor_argument_syntax(
                    self.extract_static_dispatch_receiver(receiver_expr),
                    member,
                );
                return when receiver_expr in {
                    .Identifier(type_name, _) then {
                        if not allows_constructor_args then {
                            when self.reject_non_constructor_call_args(args) in {
                                .Ok(_) then {},
                                .Error(e) then {
                                    return .Error(e);
                                },
                            };
                        };
                        let expr = if self.is_upper_first(type_name) and not self.is_upper_first(
                            member,
                        ) then Expr.StaticMethodCall(
                            type_name,
                            List[TypeNode].new(),
                            member,
                            args,
                            self.span_from_expr_start(base),
                        ) else Expr.Call(base, args, self.span_from_expr_start(base));
                        Result[Expr].Ok(expr)
                    },
                    .GenericInstantiation(type_name, type_args, _) then {
                        if not allows_constructor_args then {
                            when self.reject_non_constructor_call_args(args) in {
                                .Ok(_) then {},
                                .Error(e) then {
                                    return .Error(e);
                                },
                            };
                        };
                        Result[Expr].Ok(
                            Expr.StaticMethodCall(
                                type_name,
                                type_args,
                                member,
                                args,
                                self.span_from_expr_start(base),
                            ),
                        )
                    },
                    .MemberPath(_, _, _) then {
                        if not allows_constructor_args then {
                            when self.reject_non_constructor_call_args(args) in {
                                .Ok(_) then {},
                                .Error(e) then {
                                    return .Error(e);
                                },
                            };
                        };
                        let expr = when self.extract_static_dispatch_receiver(
                            receiver_expr,
                        ) in {
                            .Some(receiver) then Expr.StaticMethodCall(
                                receiver.type_name,
                                receiver.type_args,
                                member,
                                args,
                                self.span_from_expr_start(base),
                            ),
                            .None() then Expr.Call(
                                base,
                                args,
                                self.span_from_expr_start(base),
                            ),
                        };
                        Result[Expr].Ok(expr)
                    },
                    _ then {
                        when self.reject_non_constructor_call_args(args) in {
                            .Ok(_) then {},
                            .Error(e) then {
                                return .Error(e);
                            },
                        };
                        Result[Expr].Ok(
                            Expr.Call(base, args, self.span_from_expr_start(base)),
                        )
                    },
                };
            },
            _ then {},
        };

        if not self.call_target_allows_constructor_argument_syntax(base) then {
            when self.reject_non_constructor_call_args(args) in {
                .Ok(_) then {},
                .Error(e) then {
                    return .Error(e);
                },
            };
        };
        return .Ok(Expr.Call(base, args, self.span_from_expr_start(base)));
    };

    parse_subscript_suffix(self, base Expr) Result[Expr] = {
        self.advance();
        if self.current().kind is .RBracket() then {
            return .Error(
                self.parser_error("Subscript expression requires one index argument"),
            );
        };
        let index = self.parse_expression_checked("subscript index") or else as e in {
            return .Error(e);
        };
        if self.current().kind is .Comma() then {
            return .Error(
                self.parser_error("Subscript expression supports exactly one index"),
            );
        };
        when self.current().kind in {
            .RBracket() then {
                self.advance();
            },
            _ then {
                return .Error(
                    self.parser_error("Expected ']' after subscript argument"),
                );
            },
        };
        let mutable args = List[Expr].new();
        args.push(index);
        return .Ok(Expr.SubscriptExpr(base, args, self.span_from_expr_start(base)));
    };

    append_member_path_segment(self, base Expr, member String) Expr = {
        let span = self.span_from_expr_start(base);
        return when base in {
            .MemberPath(path_base, path, _) then {
                let mutable extended = List[String].new();
                for segment in path then {
                    extended.push(segment);
                };
                extended.push(member);
                Expr.MemberPath(path_base, extended, span)
            },
            _ then {
                let mutable path = List[String].new();
                path.push(member);
                Expr.MemberPath(base, path, span)
            },
        };
    };

    parse_dot_suffix(self, base Expr) Result[Expr] = {
        self.advance();

        let member = self.expect_identifier("member access") or return;
        self.parse_debug("dot suffix member=\(member)");
        // One shape scan answers both: `[` `<type-list>` `]` `(` is a generic
        // method call; the same without the `(` is type arguments on a method
        // that takes none (a diagnostic). Nothing is tried and rolled back.
        let type_args_shape = self.method_type_args_shape();
        let bare_method_type_args = when type_args_shape in {
            .Some(has_call) then not has_call,
            .None() then false,
        };
        let method_type_args = when type_args_shape in {
            .Some(has_call) then {
                if has_call then self.parse_type_arg_list() or return
                else List[TypeNode].new()
            },
            .None() then List[TypeNode].new(),
        };

        let has_lparen = when self.current().kind in {
            .LParen() then true,
            _ then false,
        };
        let static_receiver = self.extract_static_dispatch_receiver(base);
        let allows_constructor_args = self.static_dispatch_allows_constructor_argument_syntax(
            static_receiver,
            member,
        );

        // `(T).m(...)` -- the base is a parenthesized type head with no
        // identifier-based spelling. The static call keeps the TypeNode base;
        // the string-keyed `StaticMethodCall` is untouched.
        if has_lparen and base is .TypeRef(base_type_node, _) and not self.is_upper_first(
            member,
        ) then {
            self.advance();
            let args = self.parse_argument_list_until_rparen("static method call") or return;
            when self.current().kind in {
                .RParen() then {
                    self.advance();
                },
                _ then {
                    return .Error(
                        self.parser_error(
                            "Expected ')' after static method call arguments",
                        ),
                    );
                },
            };
            when self.reject_non_constructor_call_args(args) in {
                .Ok(_) then {},
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(
                Expr.TypeRefStaticMethodCall(
                    base_type_node,
                    method_type_args,
                    member,
                    args,
                    self.span_from_expr_start(base),
                ),
            );
        };

        if has_lparen and static_receiver is .Some(receiver) and method_type_args.is_empty(
        ) and not self.is_upper_first(member) then {
            self.parse_debug(
                "static dispatch receiver=\(receiver.type_name) member=\(member)",
            );
            self.advance();
            let args = self.parse_argument_list_until_rparen("static method call") or return;
            when self.current().kind in {
                .RParen() then {
                    self.advance();
                },
                _ then {
                    return .Error(
                        self.parser_error(
                            "Expected ')' after static method call arguments",
                        ),
                    );
                },
            };
            if not allows_constructor_args then {
                when self.reject_non_constructor_call_args(args) in {
                    .Ok(_) then {},
                    .Error(e) then {
                        return .Error(e);
                    },
                };
            };
            return .Ok(
                Expr.StaticMethodCall(
                    receiver.type_name,
                    receiver.type_args,
                    member,
                    args,
                    self.span_from_expr_start(base),
                ),
            );
        };

        if has_lparen and static_receiver is .Some(receiver) and not method_type_args.is_empty(
        ) and not self.is_upper_first(member) then {
            self.advance();
            let args = self.parse_argument_list_until_rparen("static method call") or return;
            when self.current().kind in {
                .RParen() then {
                    self.advance();
                },
                _ then {
                    return .Error(
                        self.parser_error(
                            "Expected ')' after static method call arguments",
                        ),
                    );
                },
            };
            if not allows_constructor_args then {
                when self.reject_non_constructor_call_args(args) in {
                    .Ok(_) then {},
                    .Error(e) then {
                        return .Error(e);
                    },
                };
            };
            return .Ok(
                Expr.StaticMethodCall(
                    receiver.type_name,
                    method_type_args,
                    member,
                    args,
                    self.span_from_expr_start(base),
                ),
            );
        };

        if has_lparen and not method_type_args.is_empty() then {
            self.advance();
            let args = self.parse_argument_list_until_rparen("generic method call") or return;
            when self.current().kind in {
                .RParen() then {
                    self.advance();
                },
                _ then {
                    return .Error(
                        self.parser_error(
                            "Expected ')' after generic method call arguments",
                        ),
                    );
                },
            };
            when self.reject_non_constructor_call_args(args) in {
                .Ok(_) then {},
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(
                Expr.GenericMethodCall(
                    base,
                    method_type_args,
                    member,
                    args,
                    self.span_from_expr_start(base),
                ),
            );
        };

        if not method_type_args.is_empty() then {
            return .Error(
                self.unexpected_token_error_at(
                    token_text(self.current()),
                    "'(' after generic method name",
                    self.current(),
                ),
            );
        };

        if bare_method_type_args then {
            return .Error(
                self.unexpected_token_error_at(
                    token_text(self.current()),
                    "'(' after generic method name",
                    self.current(),
                ),
            );
        };

        let member_path = self.append_member_path_segment(base, member);
        let _ = has_lparen;
        return .Ok(member_path);
    };

    parse_postfix_suffixes(self, base Expr) Result[Expr] = {
        let mutable expr = base;

        while true then {
            when self.current().kind in {
                .LParen() then {
                    if not self.should_continue_postfix_after_expression() then {
                        break;
                    };
                    // One bounded shape scan decides what `(` opens. `( <type> )`
                    // is the qualification of a composite qualified call
                    // `base(Trait).method(...)` -- the method call is parsed here
                    // too, so the prefix never stands alone. Anything else is a
                    // call, which includes the type application `Type(expr)` /
                    // `Type(args)` (the type checker decides cast vs
                    // construction). Trying each in turn and rolling back is what
                    // used to make `Num(Tag)` a cast of `Num` to `Tag` and made a
                    // failed branch eat the better diagnostic.
                    let is_type_suffix = self.scan_paren_type_suffix_at(self.index) is .Some(_);
                    if is_type_suffix then {
                        expr = self.parse_qualified_call_suffix(expr) or return;
                    } else {
                        expr = self.parse_call_suffix(expr) or return;
                    };
                },
                .LBracket() then {
                    if not self.should_continue_postfix_after_expression() then {
                        break;
                    };
                    // `[` `<type-list>` `]` is a generic application; anything
                    // else is a subscript. One bounded scan of the bracketed
                    // run decides -- no trial parse, no rollback. An upper-first
                    // base that is NOT followed by a type list is a type name
                    // written where a list was expected, so it keeps the
                    // dedicated complaint instead of silently subscripting.
                    let is_type_arg_list = self.scan_type_list_at(self.index) is .Some(_);
                    when expr in {
                        .Identifier(name, _) then {
                            if is_type_arg_list then {
                                expr = self.parse_postfix_generic_application(expr) or return;
                            } else if self.is_upper_first(name) then {
                                expr = self.parse_postfix_generic_application(expr) or return;
                            } else {
                                expr = self.parse_subscript_suffix(expr) or return;
                            };
                        },
                        _ then {
                            expr = self.parse_subscript_suffix(expr) or return;
                        },
                    };
                },
                .Dot() then {
                    if not self.can_continue_dot_postfix() then {
                        break;
                    };
                    expr = self.parse_dot_suffix(expr) or return;
                },
                _ then {
                    break;
                },
            };
        };

        return .Ok(expr);
    };

    parse_call(self) Result[Expr] = {
        let expr = self.parse_primary() or return;
        return self.parse_postfix_suffixes(expr);
    };

    parse_unary(self) Result[Expr] = {
        if self.current().kind is .Minus() then {
            let start = self.current();
            self.advance();
            // Fold `-` + numeric literal into a negative literal so the value
            // checker sees the signed text (matches the seed compiler).
            when self.current().kind in {
                .IntegerLiteral(v) then {
                    self.advance();
                    return .Ok(
                        Expr.IntegerLiteral("-\(v)", self.span_from_start(start)),
                    );
                },
                .FloatLiteral(v) then {
                    self.advance();
                    return .Ok(Expr.FloatLiteral("-\(v)", self.span_from_start(start)));
                },
                _ then {},
            };
            let operand = self.parse_unary() or return;
            return .Ok(
                Expr.Unary(UnaryOperator.Negate(), operand, self.span_from_start(start)),
            );
        };

        if self.current().kind is .Tilde() then {
            let start = self.current();
            self.advance();
            let operand = self.parse_unary() or return;
            return .Ok(
                Expr.Unary(
                    UnaryOperator.BitwiseNot(),
                    operand,
                    self.span_from_start(start),
                ),
            );
        };

        if self.current().kind is .Star() then {
            let start = self.current();
            // Expression-leading `*` is ALWAYS the dereference operator; a
            // prefixed type here (`*T(x)`) parses as `*(T(x))`.
            self.advance();
            let operand = self.parse_unary() or return;
            return .Ok(Expr.DerefExpr(operand, self.span_from_start(start)));
        };

        if self.current().kind is .QuestionMark() then {
            // Expression-leading `?` is ALWAYS the upgrade operator; a
            // prefixed type here (`?T(x)`) parses as `?(T(x))`.
            let start = self.current();
            self.advance();
            let operand = self.parse_unary() or return;
            return .Ok(Expr.UpgradeExpr(operand, self.span_from_start(start)));
        };

        if self.current().kind is .Ampersand() then {
            let start = self.current();
            self.advance();
            let is_mutable = self.current().kind is .KwMut();
            if is_mutable then {
                self.advance();
            };
            let operand = self.parse_unary() or return;
            return .Ok(Expr.PtrExpr(operand, is_mutable, self.span_from_start(start)));
        };

        return self.parse_call();
    };
};
