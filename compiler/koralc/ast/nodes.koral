public type Program(declarations: List[Decl]);

public type AccessModifier {
    Public(),
    Internal(),
    Protected(),
    Private(),
};

/// The label a diagnostic prints for an access modifier. It is the
/// DECLARATION SPELLING and nothing else: `protected` must never read as
/// `internal`, or the message tells the reader the wrong rule.
public let access_modifier_label(access: AccessModifier): String = {
    return when access in {
        .Public() then "public",
        .Internal() then "internal",
        .Protected() then "protected",
        .Private() then "private",
    };
};

public type TypeParameter(name: String, constraints: List[Bound]);

/// A type as WRITTEN.
///
/// `span` is where the type appears. A diagnostic that names a type
/// (`Undefined type: X`, `FFI incompatible type 'Y'`) has to point at the
/// spelling that is wrong; without it the only location available is whatever
/// declaration or statement happens to carry the annotation.
public type TypeNode {
    Identifier(name: String, span: SourceSpan),
    Reference(inner: TypeNode, is_mutable: Bool, span: SourceSpan),
    BorrowedReference(inner: TypeNode, is_mutable: Bool, span: SourceSpan),
    Pointer(inner: TypeNode, is_mutable: Bool, span: SourceSpan),
    WeakReference(inner: TypeNode, is_mutable: Bool, span: SourceSpan),
    Generic(base: String, args: List[TypeNode], span: SourceSpan),
    InferredSelf(span: SourceSpan),
    FunctionType(param_types: List[TypeNode], return_type: TypeNode, span: SourceSpan),
    /// 定长数组：`[N]Element`
    FixedArray(len: UInt, element: TypeNode, span: SourceSpan),
    /// foreign 函数指针：`foreign (A, B) -> R`
    ForeignFunction(param_types: List[TypeNode], return_type: TypeNode, span: SourceSpan),
};

/// Where a type is written.
public let type_node_span(node: TypeNode): SourceSpan = {
    return when node in {
        .Identifier(_, span) or .Reference(_, _, span) or .BorrowedReference(_, _, span)
        or .Pointer(_, _, span) or .WeakReference(_, _, span) or .Generic(_, _, span) or .InferredSelf(span)
        or .FunctionType(_, _, span) or .FixedArray(_, _, span) or .ForeignFunction(_, _, span) then span,
    };
};

/// The same type node blamed at a different span. A transparent grouping
/// `(T)` is the inner type with its span extended to cover the parens.
public let type_node_with_span(node: TypeNode, span: SourceSpan): TypeNode = {
    return when node in {
        .Identifier(name, _) then TypeNode.Identifier(name, span),
        .Reference(inner, is_mutable, _) then TypeNode.Reference(inner, is_mutable, span),
        .BorrowedReference(inner, is_mutable, _) then TypeNode.BorrowedReference(
            inner,
            is_mutable,
            span,
        ),
        .Pointer(inner, is_mutable, _) then TypeNode.Pointer(inner, is_mutable, span),
        .WeakReference(inner, is_mutable, _) then TypeNode.WeakReference(
            inner,
            is_mutable,
            span,
        ),
        .Generic(base, args, _) then TypeNode.Generic(base, args, span),
        .InferredSelf(_) then TypeNode.InferredSelf(span),
        .FunctionType(param_types, return_type, _) then TypeNode.FunctionType(
            param_types,
            return_type,
            span,
        ),
        .FixedArray(len, element, _) then TypeNode.FixedArray(len, element, span),
        .ForeignFunction(param_types, return_type, _) then TypeNode.ForeignFunction(param_types, return_type, span),
    };
};

/// How a type node is WRITTEN in source: `*Int`, `?T`, `(A, B) -> R`. This is
/// the spelling a diagnostic quotes when the type itself is the subject
/// (`Type '<T>' cannot be used as an expression`).
public let type_node_spelling(node: TypeNode): String = {
    return when node in {
        .Identifier(name, _) then name,
        .Reference(inner, is_mutable, _) then {
            if is_mutable then "&mutable \(type_node_spelling(inner))"
            else "&\(type_node_spelling(inner))"
        },
        .BorrowedReference(inner, is_mutable, _) then {
            if is_mutable then "ref mutable \(type_node_spelling(inner))"
            else "ref \(type_node_spelling(inner))"
        },
        .Pointer(inner, is_mutable, _) then {
            if is_mutable then "*mutable \(type_node_spelling(inner))"
            else "*\(type_node_spelling(inner))"
        },
        .WeakReference(inner, _, _) then "?\(type_node_spelling(inner))",
        .Generic(base, args, _) then {
            let mutable out = StringBuilder.new();
            out.push_string(base);
            out.push_byte('[');
            let mutable first = true;
            for a in args then {
                if not first then {
                    out.push_string(", ");
                };
                out.push_string(type_node_spelling(a));
                first = false;
            };
            out.push_byte(']');
            out.to_string()
        },
        .InferredSelf(_) then "Self",
        .FixedArray(len, element, _) then "[\(len)]\(type_node_spelling(element))",
        .ForeignFunction(param_types, return_type, _) then {
            let mutable out = StringBuilder.new();
            out.push_string("foreign (");
            let mutable first = true;
            for pt in param_types then {
                if not first then {
                    out.push_string(", ");
                };
                out.push_string(type_node_spelling(pt));
                first = false;
            };
            out.push_string(") -> ");
            out.push_string(type_node_spelling(return_type));
            out.to_string()
        },
        .FunctionType(param_types, return_type, _) then {
            let mutable out = StringBuilder.new();
            out.push_byte('(');
            let mutable first = true;
            for pt in param_types then {
                if not first then {
                    out.push_string(", ");
                };
                out.push_string(type_node_spelling(pt));
                first = false;
            };
            out.push_byte(')');
            out.push_string(" -> ");
            out.push_string(type_node_spelling(return_type));
            out.to_string()
        },
    };
};

/// A short display name for a type node, used to key default-value storage
/// so that same-name methods on different types do not overwrite each other.
public let type_node_name(node: TypeNode): String = {
    return when node in {
        .Identifier(name, _) then name,
        .Generic(base, _, _) then base,
        .Reference(inner, _, _) or .BorrowedReference(inner, _, _) or .Pointer(inner, _, _)
        or .WeakReference(inner, _, _) then type_node_name(inner),
        .InferredSelf(_) then "self",
        .FunctionType(_, _, _) then "fn",
        .FixedArray(_, element, _) then type_node_name(element),
        .ForeignFunction(_, _, _) then "fn",
    };
};

// ── Bounds ──────────────────────────────────────────────────────────────────
//
// A generic parameter's bound, as a SEMANTIC kind rather than as type syntax.
// Bounds used to be stored as `TypeNode`, which forced every consumer to
// recover the meaning by string-matching the bound's name (`== "Any"`,
// `== "mutable"`, a hard-coded primitive/trait table, ...). Making the kind
// explicit is what lets those special cases disappear.
//
// The source spellings `Any` and `mutable` are still read by name exactly once,
// in `bound_from_type_node` below -- the syntax writes them as ordinary
// identifiers (and `mutable` as a keyword), so some boundary must read the
// spelling. Everywhere after that boundary sees only the kind.

public type Bound {
    /// A real trait bound, e.g. `T Hash` or `T Add[Int]`.
    ///
    /// `def_id` is the DECLARATION identity and is what comparisons must use;
    /// `name` exists only so diagnostics can print it. It is `DefId(0)` until
    /// sema resolves the name.
    Trait(def_id: DefId, name: String, args: List[TypeNode]),
    /// `T mutable` -- the subject must have been declared `type mutable`.
    /// A shape requirement on the type itself, so it is not a trait.
    Mutable(),
    /// `T foreign` -- the subject's representation is fixed outside Koral's
    /// layout freedom and may cross the FFI boundary: a built-in scalar, a raw
    /// pointer, or a `foreign type` declaration. A shape requirement, not a
    /// trait: no user declaration can claim it.
    Foreign(),
};

/// Recognise a bound from its source spelling. `Any` produces no bound at all
/// -- it is the absence of a bound, not a bound. See `docs/design/traits-and-givens.md`.
///
/// Returns `None` for `Any` and for shapes that cannot be bounds (the other
/// `TypeNode` cases); those used to degrade into a `"?"` sentinel that every
/// consumer had to special-case.
public let bound_from_type_node(node: TypeNode): Option[Bound] = {
    return when node in {
        .Identifier(name, span) then {
            if name == "Any" then {
                Option[Bound].None()
            } else if name == "mutable" then {
                Option[Bound].Some(Bound.Mutable())
            } else {
                Option[Bound].Some(
                    Bound.Trait(DefId(UInt(0)), name, List[TypeNode].new()),
                )
            }
        },
        .Generic(base, args, span) then {
            if base == "Any" then {
                Option[Bound].None()
            } else {
                Option[Bound].Some(Bound.Trait(DefId(UInt(0)), base, args))
            }
        },
        _ then Option[Bound].None(),
    };
};

/// The trait arguments of a trait bound (`T Add[Int]` -> `[Int]`), empty for
/// shape bounds.
public let bound_trait_args(b: Bound): List[TypeNode] = {
    return when b in {
        .Trait(_, _, args) then args,
        .Mutable() or .Foreign() then List[TypeNode].new(),
    };
};

/// Render a type expression for diagnostics. Mirrors Swift's `TypeNode.description`
/// closely enough that constraint argument printing matches exactly.
public let type_node_display(node: TypeNode): String = {
    return when node in {
        .Identifier(name, span) then name,
        .Generic(base, args, span) then {
            let mutable out = StringBuilder.new();
            out.push_string(base);
            out.push_byte('[');
            let mutable first = true;
            for a in args then {
                if not first then {
                    out.push_string(", ");
                };
                out.push_string(type_node_display(a));
                first = false;
            };
            out.push_byte(']');
            out.to_string()
        },
        .Reference(inner, is_mutable, span) then (if is_mutable then "mutable &" else "&") + type_node_display(
            inner,
        ),
        .BorrowedReference(inner, is_mutable, _) then (if is_mutable then "mutable &"
        else "&") + type_node_display(inner),
        .Pointer(inner, is_mutable, _) then (if is_mutable then "mutable *" else "*") + type_node_display(
            inner,
        ),
        .WeakReference(inner, _, _) then "?" + type_node_display(inner),
        .InferredSelf(span) then "Self",
        .FunctionType(param_types, return_type, _) then {
            let mutable out = StringBuilder.new();
            out.push_byte('(');
            let mutable first = true;
            for pt in param_types then {
                if not first then {
                    out.push_string(", ");
                };
                out.push_string(type_node_display(pt));
                first = false;
            };
            out.push_byte(')');
            out.push_string(" -> ");
            out.push_string(type_node_display(return_type));
            out.to_string()
        },
        .FixedArray(len, element, _) then "[\(len)]\(type_node_display(element))",
        .ForeignFunction(param_types, return_type, _) then {
            let mutable out = StringBuilder.new();
            out.push_string("foreign (");
            let mutable first = true;
            for pt in param_types then {
                if not first then {
                    out.push_string(", ");
                };
                out.push_string(type_node_display(pt));
                first = false;
            };
            out.push_string(") -> ");
            out.push_string(type_node_display(return_type));
            out.to_string()
        },
    };
};

/// The one place allowed to turn a bound back into text. Must reproduce the
/// historical diagnostics exactly: bare names for simple traits, a PREFIXED
/// bracket for parameterised ones (`[Int]Iterator`, not `Iterator[Int]`), and
/// the keyword spellings for the type kinds.
public let bound_display(b: Bound): String = {
    return when b in {
        .Trait(_, name, args) then {
            if args.is_empty() then {
                name
            } else {
                let mutable inner = StringBuilder.new();
                inner.push_byte('[');
                let mutable first = true;
                for a in args then {
                    if not first then {
                        inner.push_string(", ");
                    };
                    inner.push_string(type_node_display(a));
                    first = false;
                };
                inner.push_byte(']');
                inner.push_string(name);
                inner.to_string()
            }
        },
        .Mutable() then "mutable",
        .Foreign() then "foreign",
    };
};

public type UnaryOperator {
    Not(),
    Negate(),
    BitwiseNot(),
};

public type ArithmeticOperator {
    Add(),
    Subtract(),
    Multiply(),
    Divide(),
    Remainder(),
};

public type ComparisonOperator {
    Equal(),
    NotEqual(),
    Greater(),
    GreaterEqual(),
    Less(),
    LessEqual(),
};

public type BitwiseOperator {
    BitAnd(),
    BitOr(),
    BitXor(),
    LeftShift(),
    RightShift(),
};

public type RangeOperator {
    Closed(),
    ClosedOpen(),
    OpenClosed(),
    Open(),
    From(),
    FromOpen(),
    To(),
    ToOpen(),
    Full(),
};

public type CompoundAssignmentOperator {
    AddAssign(),
    SubtractAssign(),
    MultiplyAssign(),
    DivideAssign(),
    RemainderAssign(),
    BitAndAssign(),
    BitOrAssign(),
    BitXorAssign(),
    LeftShiftAssign(),
    RightShiftAssign(),
};

public type ComparisonPatternOperator {
    Greater(),
    Less(),
    GreaterEqual(),
    LessEqual(),
};

/// Which literal kind a comparison pattern wrote (`> 5`, `> 1.5`, `> 'a'`).
/// The value's kind must match the subject's; the type checker desugars a
/// rune value to its code point, so the typed pattern stores only a spelling.
public type ComparisonPatternValueKind {
    Integer(),
    Float(),
    Rune(),
};

public type TraitMember(
    name: String,
    type_params: List[TypeParameter],
    access: AccessModifier,
    params: List[Param],
    return_type: TypeNode,
);

public type GivenMember(
    name: String,
    type_params: List[TypeParameter],
    access: AccessModifier,
    params: List[Param],
    return_type: TypeNode,
    body: Option[Expr],
    // Declaration identity of this method. Assigned once when the given block is
    // collected and reused at every later materialization — never re-minted.
    // Without it, "the same method arriving twice" and "two different methods with
    // the same name" are indistinguishable, which is what forced the
    // comparable / trait_same_name_method_conflict trade-off.
    def_id: DefId,
);

/// A top-level declaration.
///
/// `name_span` is where the declaration's NAME is written. A diagnostic that
/// names the symbol (`Duplicate definition: f`) has to point at `f`; the
/// declaration's own `span` starts at its first keyword and blames the whole
/// construct instead. The name was carried as a bare string, so the position
/// had to be reconstructed -- or, as here, carried.
public type Decl {
    LetDecl(access: AccessModifier, name: String, is_mutable: Bool, type_name: Option[TypeNode], initializer: Expr, span: SourceSpan, name_span: SourceSpan),
    FunctionDecl(access: AccessModifier, name: String, type_params: List[TypeParameter], params: List[Param], return_type: TypeNode, body: Expr, span: SourceSpan, name_span: SourceSpan),
    IntrinsicFunctionDecl(access: AccessModifier, name: String, type_params: List[TypeParameter], params: List[Param], return_type: TypeNode, span: SourceSpan, name_span: SourceSpan),
    ForeignFunctionDecl(access: AccessModifier, name: String, params: List[Param], return_type: TypeNode, body: Option[Expr], cname: Option[String], span: SourceSpan, name_span: SourceSpan),
    ForeignLetDecl(access: AccessModifier, name: String, is_mutable: Bool, type_name: TypeNode, initializer: Option[Expr], cname: Option[String], span: SourceSpan, name_span: SourceSpan),
    TypeStructDecl(access: AccessModifier, name: String, is_mutable_type: Bool, type_params: List[TypeParameter], fields: List[Field], span: SourceSpan, name_span: SourceSpan),
    TypeEnumDecl(access: AccessModifier, name: String, type_params: List[TypeParameter], cases: List[EnumCase], span: SourceSpan, name_span: SourceSpan),
    TypeAliasDecl(access: AccessModifier, name: String, type_params: List[TypeParameter], target: TypeNode, span: SourceSpan, name_span: SourceSpan),
    IntrinsicTypeDecl(access: AccessModifier, name: String, type_params: List[TypeParameter], span: SourceSpan, name_span: SourceSpan),
    ForeignTypeDecl(access: AccessModifier, name: String, fields: Option[List[Field]], span: SourceSpan, name_span: SourceSpan),
    UsingDecl(specifier: String, items: Option[List[UsingModuleItem]], import_all: Bool, span: SourceSpan),
    TraitDecl(access: AccessModifier, name: String, type_params: List[TypeParameter], parents: List[TypeNode], members: List[TraitMember], span: SourceSpan, name_span: SourceSpan),
    GivenDecl(target_type: TypeNode, type_params: List[TypeParameter], members: List[GivenMember], span: SourceSpan),
    GivenTraitDecl(target_type: TypeNode, type_params: List[TypeParameter], trait_type: TypeNode, members: List[GivenMember], span: SourceSpan),
    IntrinsicGivenDecl(target_type: TypeNode, type_params: List[TypeParameter], members: List[GivenMember], span: SourceSpan),
};

/// The name a declaration binds, when it binds one at all.
///
/// `given` blocks and `using` bind nothing under their own name.
public let decl_name(decl: Decl): Option[String] = when decl in {
    .LetDecl(_, name, _, _, _, _, _) or .FunctionDecl(_, name, _, _, _, _, _, _)
    or .IntrinsicFunctionDecl(_, name, _, _, _, _, _) or .ForeignFunctionDecl(_, name, _, _, _, _, _, _)
    or .ForeignLetDecl(_, name, _, _, _, _, _, _) or .TypeStructDecl(_, name, _, _, _, _, _)
    or .TypeEnumDecl(_, name, _, _, _, _) or .TypeAliasDecl(_, name, _, _, _, _)
    or .IntrinsicTypeDecl(_, name, _, _, _) or .ForeignTypeDecl(_, name, _, _, _)
    or .TraitDecl(_, name, _, _, _, _, _) then Option[String].Some(name),
    .UsingDecl(_, _, _, _) or .GivenDecl(_, _, _, _) or .GivenTraitDecl(_, _, _, _, _)
    or .IntrinsicGivenDecl(_, _, _, _) then Option[String].None(),
};

/// Where a declaration's name is written -- see `Decl`.
public let decl_name_span(decl: Decl): SourceSpan = {
    return when decl in {
        .LetDecl(_, _, _, _, _, _, name_span) or .FunctionDecl(_, _, _, _, _, _, _, name_span)
        or .IntrinsicFunctionDecl(_, _, _, _, _, _, name_span)
        or .ForeignFunctionDecl(_, _, _, _, _, _, _, name_span) or .ForeignLetDecl(_, _, _, _, _, _, _, name_span)
        or .TypeStructDecl(_, _, _, _, _, _, name_span) or .TypeEnumDecl(_, _, _, _, _, name_span)
        or .TypeAliasDecl(_, _, _, _, _, name_span) or .IntrinsicTypeDecl(_, _, _, _, name_span)
        or .ForeignTypeDecl(_, _, _, _, name_span) then name_span,
        .UsingDecl(_, _, _, span) then span,
        .TraitDecl(_, _, _, _, _, _, name_span) then name_span,
        .GivenDecl(_, _, _, span) or .GivenTraitDecl(_, _, _, _, span) or .IntrinsicGivenDecl(_, _, _, span) then span,
    };
};

/// The access level a declaration is written with, when it binds a name.
///
/// Pairs with `decl_name`: `given` blocks and `using` bind nothing and so have
/// no level. This is what an `import` consults to decide whether a name can be
/// brought into another file at all (§3.3).
public let decl_access(decl: Decl): Option[AccessModifier] = when decl in {
    .LetDecl(access, _, _, _, _, _, _) or .FunctionDecl(access, _, _, _, _, _, _, _) then Option[AccessModifier].Some(access),
    .IntrinsicFunctionDecl(access, _, _, _, _, _, _) then Option[AccessModifier].Some(
        access,
    ),
    .ForeignFunctionDecl(access, _, _, _, _, _, _, _) or .ForeignLetDecl(access, _, _, _, _, _, _, _)
    or .TypeStructDecl(access, _, _, _, _, _, _) or .TypeEnumDecl(access, _, _, _, _, _)
    or .TypeAliasDecl(access, _, _, _, _, _) or .IntrinsicTypeDecl(access, _, _, _, _)
    or .ForeignTypeDecl(access, _, _, _, _) or .TraitDecl(access, _, _, _, _, _, _) then Option[AccessModifier].Some(access),
    .UsingDecl(_, _, _, _) or .GivenDecl(_, _, _, _) or .GivenTraitDecl(_, _, _, _, _)
    or .IntrinsicGivenDecl(_, _, _, _) then Option[AccessModifier].None(),
};

/// One item of a `using` import list: `Name`, or `Name as Alias`.
///
/// There is no "everything" item -- `{ }` omitted already means that (§3), so
/// `{ * }` / `{ .. }` have nothing to be a spelling of.
/// One entry in an import list (§3.3).
///
/// `excluded` is only meaningful alongside `import_all`: `{ !a, ... }` takes
/// everything but `a`. A positive item with `import_all` is a rename that stays
/// in force while the rest of the module's surface comes along (`{ a as b, ... }`).
public type UsingModuleItem(name: String, alias: Option[String], excluded: Bool);

/// The body of `using "spec" { … }` -- a filter over a module's members (§3.3).
///
/// `import_all` marks the `...` base set: with it, the items are renames that
/// survive the sweep (`{ a as b, ... }`) or exclusions removed from it
/// (`{ !a, ... }`). Without it the items are the whole answer (`{ a, b }`).
public type UsingImportList(items: List[UsingModuleItem], import_all: Bool);

public type mutable Param(
    name: String,
    is_mutable: Bool,
    type_name: TypeNode,
    named: Bool,
    // The parameter's declared default value. Stored on the declaration node
    // itself -- the node IS the identity, so there is no key to collide.
    default_value: Option[Expr],
);

public type mutable Field(
    access: AccessModifier,
    name: String,
    is_mutable: Bool,
    type_name: TypeNode,
    named: Bool,
    // The field's declared default value; see `Param.default_value`.
    default_value: Option[Expr],
);

public type EnumCaseField(
    name: String,
    type_name: TypeNode,
    named: Bool,
    // The payload field's declared default value; see `Param.default_value`.
    default_value: Option[Expr],
);

public type EnumCase(name: String, fields: List[EnumCaseField]);

public type InterpolatedStringPart {
    Literal(value: String),
    Expression(expr: Expr),
};

// One `when` arm. The guard (`pat if cond then body`) sits between the pattern
// and `then`: the pattern's bindings are visible in `cond`, and a false guard
// falls through to the next arm.
public type WhenArm(
    pattern: PatternNode,
    guard: Option[Expr],
    body: Expr,
    /// Whether the compiler wrote this arm's BODY rather than the user: the
    /// wildcard else of a lowered `if ... is` with no `else`. Such a body has
    /// no type of its own to contribute, and a mismatch reported against it is
    /// a complaint about a branch that is not in the file.
    synthetic: Bool,
    /// Whether the compiler wrote this arm's PATTERN: the wildcard else-slot
    /// of a lowered `if ... is` / `while ... is`, which exists only so the
    /// `when` is exhaustive. It draws no unreachable or duplicate complaint --
    /// nothing anyone wrote can be "already covered" by it -- whether or not
    /// the user supplied the `else` body behind it.
    pattern_invented: Bool,
);

public type ExprPair(first: Expr, second: Expr);

public type PatternElement(label: Option[String], pattern: PatternNode);

public type LambdaParam(name: String, type_annotation: Option[TypeNode]);

public type PatternNode {
    Wildcard(span: SourceSpan),
    Variable(name: String, is_mutable: Bool, span: SourceSpan),
    BoolLiteral(value: Bool, span: SourceSpan),
    /// Null pointer literal pattern `null`: matches a null pointer. The
    /// pattern joins the SUBJECT's pointer type; it tests the pointer itself,
    /// so auto-deref must hand it the pointer, never the pointee.
    NullLiteral(span: SourceSpan),
    IntegerLiteral(value: String, span: SourceSpan),
    NegativeIntegerLiteral(value: String, span: SourceSpan),
    /// Float literal pattern (e.g., 1.5, -2.0). The sign is folded into the
    /// spelling: a float has no unsigned counterpart to exclude.
    FloatLiteral(value: String, span: SourceSpan),
    StringLiteral(value: String, span: SourceSpan),
    RuneLiteral(value: String, span: SourceSpan),
    TraitObjectType(target_type: TypeNode, span: SourceSpan),
    TraitObjectTypeBinding(name: String, is_mutable: Bool, target_type: TypeNode, span: SourceSpan),
    EnumCase(case_name: String, elements: List[PatternElement], span: SourceSpan),
    StructPattern(type_name: String, elements: List[PatternElement], span: SourceSpan),
    /// `(a, b, c)` -- positional destructuring of a struct with exactly that
    /// many fields. No type name is written, so identity comes from the subject.
    TuplePattern(elements: List[PatternElement], span: SourceSpan),
    /// `[a, b]` -- destructuring of a `List[T]`, each slot checked against `T`.
    /// Without a rest slot the length must match exactly; with one it is a
    /// lower bound instead.
    ListPattern(elements: List[PatternNode], span: SourceSpan),
    /// `...` -- in a list element list it swallows the unwritten slots; in a
    /// struct or enum-case element list it must be the ONLY slot and means
    /// "ignore every field", named or not. Never binds, so it is only ever a
    /// slot of an enclosing element list, at most one per list.
    RestPattern(span: SourceSpan),
    /// Comparison pattern. `value_kind` is the literal kind the source wrote
    /// (`> 5`, `> 1.5`, `> 'a'`); the value's kind must match the subject's,
    /// and the type checker desugars a rune to its code point.
    ComparisonPattern(op: ComparisonPatternOperator, value: String, value_kind: ComparisonPatternValueKind, span: SourceSpan),
    AndPattern(left: PatternNode, right: PatternNode, span: SourceSpan),
    OrPattern(left: PatternNode, right: PatternNode, span: SourceSpan),
    NotPattern(pattern: PatternNode, span: SourceSpan),
    /// `?name` / `?TypeName(name)` -- weak reference unpacking. The bare form
    /// binds the strong value; the typed form also checks the target type.
    WeakBinding(name: String, target_type: Option[TypeNode], span: SourceSpan),
};

/// A single slot of a `let (a, (b, c)) = ...` / `for (a, (b, c)) in ...`
/// binding. A leaf binds one field (`_`, `name`, `mutable name`, `name: Type`);
/// `nested` holds a nested tuple binding for that slot. Nested groups are
/// expanded by the parser into a sequence of flat tuple lets, so after parsing
/// every element the type checker sees has `nested == None`.
public type mutable PairBindingElement(
    name: String,
    is_mutable: Bool,
    type_name: Option[TypeNode],
    is_discard: Bool,
    span: SourceSpan,
    nested: Option[List[PairBindingElement]],
);

public type Statement {
    LetStmt(name: String, is_mutable: Bool, type_name: Option[TypeNode], value: Expr, span: SourceSpan),
    /// `let (a, b, c) = expr;` -- positional destructuring of a struct with
    /// exactly that many fields.
    TupleLetStmt(bindings: List[PairBindingElement], value: Expr, span: SourceSpan),
    AssignmentStmt(target: Expr, op: Option[CompoundAssignmentOperator], value: Expr, span: SourceSpan),
    ExprStmt(expr: Expr, span: SourceSpan),
    ReturnStmt(value: Option[Expr], span: SourceSpan),
    BreakStmt(span: SourceSpan),
    ContinueStmt(span: SourceSpan),
    DeferStmt(expr: Expr, span: SourceSpan),
};

public type Expr {
    Identifier(name: String, span: SourceSpan),
    IntegerLiteral(value: String, span: SourceSpan),
    FloatLiteral(value: String, span: SourceSpan),
    StringLiteral(value: String, span: SourceSpan),
    RuneLiteral(value: String, span: SourceSpan),
    InterpolatedString(parts: List[InterpolatedStringPart], span: SourceSpan),
    BoolLiteral(value: Bool, span: SourceSpan),
    /// Null pointer literal `null`. A pointer literal: it JOINS the expected
    /// pointer type (`*T` / `*mutable T`, any pointee incl. type parameters)
    /// and has no type of its own -- an unconstrained `null` is an inference
    /// error.
    NullLiteral(span: SourceSpan),
    CastExpr(type_node: TypeNode, expr: Expr, span: SourceSpan),
    /// `(T)` in expression position, where `T` has no identifier-based
    /// spelling (`*Foo`, `?Foo`, `(A) -> R`, `Self`). A nameable head
    /// desugars to `Identifier` / `GenericInstantiation` instead.
    TypeRef(type_node: TypeNode, span: SourceSpan),
    Unary(op: UnaryOperator, expr: Expr, span: SourceSpan),
    RefExpr(expr: Expr, is_mutable: Bool, span: SourceSpan),
    WeakrefExpr(inner: Expr, span: SourceSpan),
    PtrExpr(expr: Expr, is_mutable: Bool, span: SourceSpan),
    UpgradeExpr(expr: Expr, span: SourceSpan),
    DerefExpr(expr: Expr, span: SourceSpan),
    UnsafeDerefExpr(expr: Expr, span: SourceSpan),
    ArithmeticExpr(left: Expr, op: ArithmeticOperator, right: Expr, span: SourceSpan),
    ComparisonExpr(left: Expr, op: ComparisonOperator, right: Expr, span: SourceSpan),
    ComparisonChainExpr(operands: List[Expr], operators: List[ComparisonOperator], span: SourceSpan),
    BitwiseExpr(left: Expr, op: BitwiseOperator, right: Expr, span: SourceSpan),
    AndExpr(left: Expr, right: Expr, span: SourceSpan),
    OrExpr(left: Expr, right: Expr, span: SourceSpan),
    RangeExpr(op: RangeOperator, left: Option[Expr], right: Option[Expr], span: SourceSpan),
    OrElseExpr(operand: Expr, default_expr: Expr, span: SourceSpan),
    OrReturnExpr(operand: Expr, span: SourceSpan),
    AndThenExpr(operand: Expr, transform_expr: Expr, span: SourceSpan),
    // The elided receiver of an `and then .member()` chain: the unwrapped value.
    // Only ever the base of a postfix chain inside `and then`, never standalone.
    FlowReceiver(span: SourceSpan),
    // `and then .f(x).g` -- a postfix chain on the elided receiver. The wrapper
    // is what tells printer and sema that this is the chain form rather than an
    // implicit member; `chain`'s base is a `FlowReceiver`.
    FlowChainExpr(chain: Expr, span: SourceSpan),
    // `as name in body` -- an explicit binder for the flow payload. The body is
    // a layer operand, so an `or else` after it belongs to the outer chain.
    FlowBindExpr(name: String, body: Expr, span: SourceSpan),
    IsExpr(subject: Expr, pattern: PatternNode, span: SourceSpan),
    IsNotExpr(subject: Expr, pattern: PatternNode, span: SourceSpan),
    CollectionLiteral(elements: List[Expr], span: SourceSpan),
    DictLiteral(entries: List[ExprPair], span: SourceSpan),
    EmptyLiteral(span: SourceSpan),
    NamedArgument(label: String, expr: Expr, span: SourceSpan),
    Call(callee: Expr, args: List[Expr], span: SourceSpan),
    MemberPath(base: Expr, path: List[String], span: SourceSpan),
    TraitQualificationExpr(base: Expr, trait_type: TypeNode, span: SourceSpan),
    GenericMethodCall(base: Expr, method_type_args: List[TypeNode], method_name: String, args: List[Expr], span: SourceSpan),
    QualifiedMethodCall(base: Expr, trait_type: TypeNode, method_name: String, args: List[Expr], span: SourceSpan),
    QualifiedGenericMethodCall(base: Expr, trait_type: TypeNode, method_type_args: List[TypeNode], method_name: String, args: List[Expr], span: SourceSpan),
    GenericInstantiation(base: String, type_args: List[TypeNode], span: SourceSpan),
    StaticMethodCall(type_name: String, type_args: List[TypeNode], method_name: String, args: List[Expr], span: SourceSpan),
    /// `(T).m(...)` -- a static call whose base is a parenthesized type with
    /// no identifier-based spelling. The string-keyed `StaticMethodCall`
    /// stays as it is; this is the additive TypeNode-based twin.
    TypeRefStaticMethodCall(type_node: TypeNode, type_args: List[TypeNode], method_name: String, args: List[Expr], span: SourceSpan),
    SubscriptExpr(base: Expr, args: List[Expr], span: SourceSpan),
    Block(statements: List[Statement], tail_expression: Option[Expr], span: SourceSpan),
    IfExpr(condition: Expr, then_branch: Expr, else_branch: Option[Expr], span: SourceSpan),
    WhileExpr(condition: Expr, body: Expr, span: SourceSpan),
    /// `for pattern in iterable [where guard] then body`. The binding is a
    /// full match pattern, and it must be IRREFUTABLE -- a loop cannot skip an
    /// element the pattern refuses. The guard filters: a false guard skips the
    /// element and moves on to the next iteration.
    ForExpr(pattern: PatternNode, iterable: Expr, body: Expr, guard: Option[Expr], span: SourceSpan),
    WhenExpr(subject: Expr, arms: List[WhenArm], span: SourceSpan),
    LambdaExpr(params: List[LambdaParam], return_type: Option[TypeNode], body: Expr, span: SourceSpan),
    ImplicitMemberExpr(member_name: String, args: List[Expr], span: SourceSpan),
};

/// The span from the start of one pattern to the end of another -- the reach
/// of a combined pattern, which is its two sides joined.
public let span_across_patterns(left: PatternNode, right: PatternNode): SourceSpan = {
    let l = pattern_span(left);
    let r = pattern_span(right);
    return SourceSpan(l.start, r.end);
};

public let pattern_span(pattern: PatternNode): SourceSpan = {
    return when pattern in {
        .Wildcard(span) or .Variable(_, _, span) or .BoolLiteral(_, span) or .NullLiteral(span)
        or .IntegerLiteral(_, span) or .NegativeIntegerLiteral(_, span) or .FloatLiteral(_, span)
        or .StringLiteral(_, span) or .RuneLiteral(_, span) or .TraitObjectType(_, span)
        or .TraitObjectTypeBinding(_, _, _, span) or .EnumCase(_, _, span) or .StructPattern(_, _, span)
        or .TuplePattern(_, span) or .ListPattern(_, span) or .RestPattern(span)
        or .ComparisonPattern(_, _, _, span) or .AndPattern(_, _, span) or .OrPattern(_, _, span)
        or .NotPattern(_, span) or .WeakBinding(_, _, span) then span,
    };
};

public let expr_span(expr: Expr): SourceSpan = {
    return when expr in {
        .Identifier(_, span) or .IntegerLiteral(_, span) or .FloatLiteral(_, span) or .StringLiteral(_, span)
        or .RuneLiteral(_, span) or .InterpolatedString(_, span) or .BoolLiteral(_, span)
        or .NullLiteral(span) or .CastExpr(_, _, span) or .TypeRef(_, span) or .Unary(_, _, span)
        or .RefExpr(_, _, span) or .WeakrefExpr(_, span) or .PtrExpr(_, _, span) or .UpgradeExpr(_, span)
        or .DerefExpr(_, span) or .UnsafeDerefExpr(_, span) or .ArithmeticExpr(_, _, _, span)
        or .ComparisonExpr(_, _, _, span) or .ComparisonChainExpr(_, _, span) or .BitwiseExpr(_, _, _, span)
        or .AndExpr(_, _, span) or .OrExpr(_, _, span) or .RangeExpr(_, _, _, span) or .OrElseExpr(_, _, span)
        or .OrReturnExpr(_, span) or .AndThenExpr(_, _, span) or .FlowReceiver(span)
        or .FlowChainExpr(_, span) or .FlowBindExpr(_, _, span) or .IsExpr(_, _, span)
        or .IsNotExpr(_, _, span) or .CollectionLiteral(_, span) or .DictLiteral(_, span)
        or .EmptyLiteral(span) or .NamedArgument(_, _, span) or .Call(_, _, span) or .MemberPath(_, _, span)
        or .TraitQualificationExpr(_, _, span) or .GenericMethodCall(_, _, _, _, span)
        or .QualifiedMethodCall(_, _, _, _, span) or .QualifiedGenericMethodCall(_, _, _, _, _, span)
        or .GenericInstantiation(_, _, span) or .StaticMethodCall(_, _, _, _, span)
        or .TypeRefStaticMethodCall(_, _, _, _, span) or .SubscriptExpr(_, _, span) or .Block(_, _, span)
        or .IfExpr(_, _, _, span) or .WhileExpr(_, _, span) or .ForExpr(_, _, _, _, span)
        or .WhenExpr(_, _, span) or .LambdaExpr(_, _, _, span) or .ImplicitMemberExpr(_, _, span) then span,
    };
};
