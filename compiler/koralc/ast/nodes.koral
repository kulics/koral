public type Program(declarations List[Decl], parsed_defaults Dict[String, String]);

public type AccessModifier {
    Public(),
    ModulePrivate(),
    PackagePrivate(),
    FilePrivate(),
};

public type TypeParameter(name String, constraints List[Bound]);

/// A type as WRITTEN.
///
/// `span` is where the type appears. A diagnostic that names a type
/// (`Undefined type: X`, `FFI incompatible type 'Y'`) has to point at the
/// spelling that is wrong; without it the only location available is whatever
/// declaration or statement happens to carry the annotation.
public type TypeNode {
    Identifier(name String, span SourceSpan),
    Reference(inner TypeNode, is_mutable Bool, span SourceSpan),
    BorrowedReference(inner TypeNode, is_mutable Bool, span SourceSpan),
    Pointer(inner TypeNode, is_mutable Bool, span SourceSpan),
    WeakReference(inner TypeNode, is_mutable Bool, span SourceSpan),
    Generic(base String, args List[TypeNode], span SourceSpan),
    InferredSelf(span SourceSpan),
    FunctionType(param_types List[TypeNode], return_type TypeNode, span SourceSpan),
};

/// Where a type is written.
public let type_node_span(node TypeNode) SourceSpan = {
    return when node in {
        .Identifier(_, span) then span,
        .Reference(_, _, span) then span,
        .BorrowedReference(_, _, span) then span,
        .Pointer(_, _, span) then span,
        .WeakReference(_, _, span) then span,
        .Generic(_, _, span) then span,
        .InferredSelf(span) then span,
        .FunctionType(_, _, span) then span,
    };
};

// ── Bounds ──────────────────────────────────────────────────────────────────
//
// A generic parameter's bound, as a SEMANTIC kind rather than as type syntax.
// Bounds used to be stored as `TypeNode`, which forced every consumer to
// recover the meaning by string-matching the bound's name (`== "Any"`,
// `== "mutable"`, a hard-coded primitive/trait table, ...). Making the kind
// explicit is what lets those special cases disappear.
//
// The source spellings `Any` and `mutable` are still read by name exactly once,
// in `bound_from_type_node` below -- the syntax writes them as ordinary
// identifiers (and `mutable` as a keyword), so some boundary must read the
// spelling. Everywhere after that boundary sees only the kind.

public type Bound {
    /// A real trait bound, e.g. `T Hash` or `T Add[Int]`.
    ///
    /// `def_id` is the DECLARATION identity and is what comparisons must use;
    /// `name` exists only so diagnostics can print it. It is `DefId(0)` until
    /// sema resolves the name.
    Trait(def_id DefId, name String, args List[TypeNode]),
    /// `T mutable` -- the subject must have been declared `type mutable`.
    /// A shape requirement on the type itself, so it is not a trait.
    Mutable(),
    /// `T foreign` -- the subject's representation is fixed outside Koral's
    /// layout freedom and may cross the FFI boundary: a built-in scalar, a raw
    /// pointer, or a `foreign type` declaration. A shape requirement, not a
    /// trait: no user declaration can claim it.
    Foreign(),
};

/// Recognise a bound from its source spelling. `Any` produces no bound at all
/// -- it is the absence of a bound, not a bound. See `docs/design/traits-and-givens.md`.
///
/// Returns `None` for `Any` and for shapes that cannot be bounds (the other
/// `TypeNode` cases); those used to degrade into a `"?"` sentinel that every
/// consumer had to special-case.
public let bound_from_type_node(node TypeNode) Option[Bound] = {
    return when node in {
        .Identifier(name, span) then {
            if name == "Any" then {
                Option[Bound].None()
            } else if name == "mutable" then {
                Option[Bound].Some(Bound.Mutable())
            } else {
                Option[Bound].Some(
                    Bound.Trait(DefId(0(UInt)), name, List[TypeNode].new()),
                )
            }
        },
        .Generic(base, args, span) then {
            if base == "Any" then {
                Option[Bound].None()
            } else {
                Option[Bound].Some(Bound.Trait(DefId(0(UInt)), base, args))
            }
        },
        _ then Option[Bound].None(),
    };
};

/// The trait this bound requires, if it is a trait bound. `mutable` requires no
/// trait declaration and returns `None`.
public let bound_trait_name(b Bound) Option[String] = {
    return when b in {
        .Trait(_, name, _) then Option[String].Some(name),
        .Mutable() or .Foreign() then Option[String].None(),
    };
};

/// The trait arguments of a trait bound (`T Add[Int]` -> `[Int]`), empty for
/// shape bounds.
public let bound_trait_args(b Bound) List[TypeNode] = {
    return when b in {
        .Trait(_, _, args) then args,
        .Mutable() or .Foreign() then List[TypeNode].new(),
    };
};

/// The bare trait name, for messages that print it without type arguments.
public let bound_base_name(b Bound) String = {
    return when b in {
        .Trait(_, name, _) then name,
        .Mutable() then "mutable",
        .Foreign() then "foreign",
    };
};

/// Render a type expression for diagnostics. Mirrors Swift's `TypeNode.description`
/// closely enough that constraint argument printing matches exactly.
public let type_node_display(node TypeNode) String = {
    return when node in {
        .Identifier(name, span) then name,
        .Generic(base, args, span) then {
            let mutable out = StringBuilder.new();
            out.push_string(base);
            out.push_byte('[');
            let mutable first = true;
            for a in args then {
                if not first then {
                    out.push_string(", ");
                };
                out.push_string(type_node_display(a));
                first = false;
            };
            out.push_byte(']');
            out.to_string()
        },
        .Reference(inner, is_mutable, span) then (if is_mutable then "mutable &" else "&") + type_node_display(
            inner,
        ),
        .BorrowedReference(inner, is_mutable, _) then (if is_mutable then "mutable &"
        else "&") + type_node_display(inner),
        .Pointer(inner, is_mutable, _) then (if is_mutable then "mutable *" else "*") + type_node_display(
            inner,
        ),
        .WeakReference(inner, _, _) then "?" + type_node_display(inner),
        .InferredSelf(span) then "Self",
        .FunctionType(_, _, _) then "Func",
    };
};

/// The one place allowed to turn a bound back into text. Must reproduce the
/// historical diagnostics exactly: bare names for simple traits, a PREFIXED
/// bracket for parameterised ones (`[Int]Iterator`, not `Iterator[Int]`), and
/// the keyword spellings for the type kinds.
public let bound_display(b Bound) String = {
    return when b in {
        .Trait(_, name, args) then {
            if args.is_empty() then {
                name
            } else {
                let mutable inner = StringBuilder.new();
                inner.push_byte('[');
                let mutable first = true;
                for a in args then {
                    if not first then {
                        inner.push_string(", ");
                    };
                    inner.push_string(type_node_display(a));
                    first = false;
                };
                inner.push_byte(']');
                inner.push_string(name);
                inner.to_string()
            }
        },
        .Mutable() then "mutable",
        .Foreign() then "foreign",
    };
};

public type UnaryOperator {
    Not(),
    Negate(),
    BitwiseNot(),
};

public type ArithmeticOperator {
    Add(),
    Subtract(),
    Multiply(),
    Divide(),
    Remainder(),
};

public type ComparisonOperator {
    Equal(),
    NotEqual(),
    Greater(),
    GreaterEqual(),
    Less(),
    LessEqual(),
};

public type BitwiseOperator {
    BitAnd(),
    BitOr(),
    BitXor(),
    LeftShift(),
    RightShift(),
};

public type RangeOperator {
    Closed(),
    ClosedOpen(),
    OpenClosed(),
    Open(),
    From(),
    FromOpen(),
    To(),
    ToOpen(),
    Full(),
};

public type CompoundAssignmentOperator {
    AddAssign(),
    SubtractAssign(),
    MultiplyAssign(),
    DivideAssign(),
    RemainderAssign(),
    BitAndAssign(),
    BitOrAssign(),
    BitXorAssign(),
    LeftShiftAssign(),
    RightShiftAssign(),
};

public type ComparisonPatternOperator {
    Greater(),
    Less(),
    GreaterEqual(),
    LessEqual(),
};

public type TraitMember(
    name String,
    type_params List[TypeParameter],
    access AccessModifier,
    params List[Param],
    return_type TypeNode,
);

public type GivenMember(
    name String,
    type_params List[TypeParameter],
    access AccessModifier,
    params List[Param],
    return_type TypeNode,
    body Option[Expr],
    // Declaration identity of this method. Assigned once when the given block is
    // collected and reused at every later materialization — never re-minted.
    // Without it, "the same method arriving twice" and "two different methods with
    // the same name" are indistinguishable, which is what forced the
    // comparable / trait_same_name_method_conflict trade-off.
    def_id DefId,
);

/// A top-level declaration.
///
/// `name_span` is where the declaration's NAME is written. A diagnostic that
/// names the symbol (`Duplicate definition: f`) has to point at `f`; the
/// declaration's own `span` starts at its first keyword and blames the whole
/// construct instead. The name was carried as a bare string, so the position
/// had to be reconstructed -- or, as here, carried.
public type Decl {
    LetDecl(access AccessModifier, name String, is_mutable Bool, type_name Option[TypeNode], initializer Expr, span SourceSpan, name_span SourceSpan),
    FunctionDecl(access AccessModifier, name String, type_params List[TypeParameter], params List[Param], return_type TypeNode, body Expr, span SourceSpan, name_span SourceSpan),
    IntrinsicFunctionDecl(access AccessModifier, name String, type_params List[TypeParameter], params List[Param], return_type TypeNode, span SourceSpan, name_span SourceSpan),
    ForeignFunctionDecl(access AccessModifier, name String, params List[Param], return_type TypeNode, span SourceSpan, name_span SourceSpan),
    ForeignLetDecl(access AccessModifier, name String, is_mutable Bool, type_name TypeNode, span SourceSpan, name_span SourceSpan),
    TypeStructDecl(access AccessModifier, name String, is_mutable_type Bool, type_params List[TypeParameter], fields List[Field], span SourceSpan, name_span SourceSpan),
    TypeEnumDecl(access AccessModifier, name String, type_params List[TypeParameter], cases List[EnumCase], span SourceSpan, name_span SourceSpan),
    TypeAliasDecl(access AccessModifier, name String, target TypeNode, span SourceSpan, name_span SourceSpan),
    IntrinsicTypeDecl(access AccessModifier, name String, type_params List[TypeParameter], span SourceSpan, name_span SourceSpan),
    ForeignTypeDecl(access AccessModifier, name String, cname Option[String], fields Option[List[Field]], span SourceSpan, name_span SourceSpan),
    UsingDecl(specifier String, items Option[List[UsingModuleItem]], span SourceSpan),
    TraitDecl(access AccessModifier, name String, type_params List[TypeParameter], parents List[TypeNode], members List[TraitMember], span SourceSpan, name_span SourceSpan),
    GivenDecl(target_type TypeNode, type_params List[TypeParameter], members List[GivenMember], span SourceSpan),
    GivenTraitDecl(target_type TypeNode, type_params List[TypeParameter], trait_type TypeNode, members List[GivenMember], span SourceSpan),
    IntrinsicGivenDecl(target_type TypeNode, type_params List[TypeParameter], members List[GivenMember], span SourceSpan),
};

/// The name a declaration binds, when it binds one at all.
///
/// `given` blocks and `using` bind nothing under their own name.
public let decl_name(decl Decl) Option[String] = when decl in {
    .LetDecl(_, name, _, _, _, _, _) then Option[String].Some(name),
    .FunctionDecl(_, name, _, _, _, _, _, _) then Option[String].Some(name),
    .IntrinsicFunctionDecl(_, name, _, _, _, _, _) then Option[String].Some(name),
    .ForeignFunctionDecl(_, name, _, _, _, _) then Option[String].Some(name),
    .ForeignLetDecl(_, name, _, _, _, _) then Option[String].Some(name),
    .TypeStructDecl(_, name, _, _, _, _, _) then Option[String].Some(name),
    .TypeEnumDecl(_, name, _, _, _, _) then Option[String].Some(name),
    .TypeAliasDecl(_, name, _, _, _) then Option[String].Some(name),
    .IntrinsicTypeDecl(_, name, _, _, _) then Option[String].Some(name),
    .ForeignTypeDecl(_, name, _, _, _, _) then Option[String].Some(name),
    .TraitDecl(_, name, _, _, _, _, _) then Option[String].Some(name),
    .UsingDecl(_, _, _) then Option[String].None(),
    .GivenDecl(_, _, _, _) then Option[String].None(),
    .GivenTraitDecl(_, _, _, _, _) then Option[String].None(),
    .IntrinsicGivenDecl(_, _, _, _) then Option[String].None(),
};

/// Where a declaration's name is written -- see `Decl`.
public let decl_name_span(decl Decl) SourceSpan = {
    return when decl in {
        .LetDecl(_, _, _, _, _, _, name_span) then name_span,
        .FunctionDecl(_, _, _, _, _, _, _, name_span) then name_span,
        .IntrinsicFunctionDecl(_, _, _, _, _, _, name_span) then name_span,
        .ForeignFunctionDecl(_, _, _, _, _, name_span) then name_span,
        .ForeignLetDecl(_, _, _, _, _, name_span) then name_span,
        .TypeStructDecl(_, _, _, _, _, _, name_span) then name_span,
        .TypeEnumDecl(_, _, _, _, _, name_span) then name_span,
        .TypeAliasDecl(_, _, _, _, name_span) then name_span,
        .IntrinsicTypeDecl(_, _, _, _, name_span) then name_span,
        .ForeignTypeDecl(_, _, _, _, _, name_span) then name_span,
        .UsingDecl(_, _, span) then span,
        .TraitDecl(_, _, _, _, _, _, name_span) then name_span,
        .GivenDecl(_, _, _, span) then span,
        .GivenTraitDecl(_, _, _, _, span) then span,
        .IntrinsicGivenDecl(_, _, _, span) then span,
    };
};

/// The access level a declaration is written with, when it binds a name.
///
/// Pairs with `decl_name`: `given` blocks and `using` bind nothing and so have
/// no level. This is what an `import` consults to decide whether a name can be
/// brought into another file at all (§3.3).
public let decl_access(decl Decl) Option[AccessModifier] = when decl in {
    .LetDecl(access, _, _, _, _, _, _) then Option[AccessModifier].Some(access),
    .FunctionDecl(access, _, _, _, _, _, _, _) then Option[AccessModifier].Some(access),
    .IntrinsicFunctionDecl(access, _, _, _, _, _, _) then Option[AccessModifier].Some(
        access,
    ),
    .ForeignFunctionDecl(access, _, _, _, _, _) then Option[AccessModifier].Some(access),
    .ForeignLetDecl(access, _, _, _, _, _) then Option[AccessModifier].Some(access),
    .TypeStructDecl(access, _, _, _, _, _, _) then Option[AccessModifier].Some(access),
    .TypeEnumDecl(access, _, _, _, _, _) then Option[AccessModifier].Some(access),
    .TypeAliasDecl(access, _, _, _, _) then Option[AccessModifier].Some(access),
    .IntrinsicTypeDecl(access, _, _, _, _) then Option[AccessModifier].Some(access),
    .ForeignTypeDecl(access, _, _, _, _, _) then Option[AccessModifier].Some(access),
    .TraitDecl(access, _, _, _, _, _, _) then Option[AccessModifier].Some(access),
    .UsingDecl(_, _, _) then Option[AccessModifier].None(),
    .GivenDecl(_, _, _, _) then Option[AccessModifier].None(),
    .GivenTraitDecl(_, _, _, _, _) then Option[AccessModifier].None(),
    .IntrinsicGivenDecl(_, _, _, _) then Option[AccessModifier].None(),
};

/// One item of a `using` import list: `Name`, or `Name as Alias`.
///
/// There is no "everything" item -- `{ }` omitted already means that (§3), so
/// `{ * }` / `{ .. }` have nothing to be a spelling of.
public type UsingModuleItem(name String, alias Option[String]);

public type mutable Param(name String, is_mutable Bool, type_name TypeNode, named Bool);

public type mutable Field(
    access AccessModifier,
    name String,
    is_mutable Bool,
    type_name TypeNode,
    named Bool,
);

public type EnumCaseField(name String, type_name TypeNode, named Bool);

public type EnumCase(name String, fields List[EnumCaseField]);

public type InterpolatedStringPart {
    Literal(value String),
    Expression(expr Expr),
};

public type WhenArm(
    pattern PatternNode,
    body Expr,
    /// Whether the compiler wrote this arm rather than the user: the wildcard
    /// else of a lowered `if ... is` with no `else`. Such an arm exists only so
    /// the `when` is exhaustive -- it has no type of its own to contribute, and
    /// a mismatch reported against it is a complaint about a branch that is not
    /// in the file.
    synthetic Bool,
);

public type ExprPair(first Expr, second Expr);

public type PatternElement(label Option[String], pattern PatternNode);

public type LambdaParam(name String, type_annotation Option[TypeNode]);

public type PatternNode {
    Wildcard(span SourceSpan),
    Variable(name String, is_mutable Bool, span SourceSpan),
    BoolLiteral(value Bool, span SourceSpan),
    IntegerLiteral(value String, span SourceSpan),
    NegativeIntegerLiteral(value String, span SourceSpan),
    StringLiteral(value String, span SourceSpan),
    RuneLiteral(value String, span SourceSpan),
    TraitObjectType(target_type TypeNode, span SourceSpan),
    TraitObjectTypeBinding(name String, is_mutable Bool, target_type TypeNode, span SourceSpan),
    EnumCase(case_name String, elements List[PatternElement], span SourceSpan),
    StructPattern(type_name String, elements List[PatternElement], span SourceSpan),
    /// `(a, b, c)` -- positional destructuring of a struct with exactly that
    /// many fields. No type name is written, so identity comes from the subject.
    TuplePattern(elements List[PatternElement], span SourceSpan),
    ComparisonPattern(op ComparisonPatternOperator, value String, span SourceSpan),
    AndPattern(left PatternNode, right PatternNode, span SourceSpan),
    OrPattern(left PatternNode, right PatternNode, span SourceSpan),
    NotPattern(pattern PatternNode, span SourceSpan),
};

public type mutable PairBindingElement(
    name String,
    is_mutable Bool,
    type_name Option[TypeNode],
    is_discard Bool,
    span SourceSpan,
);

public type ForBindingPattern {
    Single(binding PairBindingElement),
    /// `(a, b, c)` -- positional destructuring of a struct with exactly that
    /// many fields.
    Tuple(bindings List[PairBindingElement], span SourceSpan),
};

public type Statement {
    LetStmt(name String, is_mutable Bool, type_name Option[TypeNode], value Expr, span SourceSpan),
    /// `let (a, b, c) = expr;` -- positional destructuring of a struct with
    /// exactly that many fields.
    TupleLetStmt(bindings List[PairBindingElement], value Expr, span SourceSpan),
    AssignmentStmt(target Expr, op Option[CompoundAssignmentOperator], value Expr, span SourceSpan),
    ExprStmt(expr Expr, span SourceSpan),
    ReturnStmt(value Option[Expr], span SourceSpan),
    BreakStmt(span SourceSpan),
    ContinueStmt(span SourceSpan),
    DeferStmt(expr Expr, span SourceSpan),
};

public type Expr {
    Identifier(name String, span SourceSpan),
    IntegerLiteral(value String, span SourceSpan),
    FloatLiteral(value String, span SourceSpan),
    StringLiteral(value String, span SourceSpan),
    RuneLiteral(value String, span SourceSpan),
    InterpolatedString(parts List[InterpolatedStringPart], span SourceSpan),
    BoolLiteral(value Bool, span SourceSpan),
    CastExpr(type_node TypeNode, expr Expr, span SourceSpan),
    Unary(op UnaryOperator, expr Expr, span SourceSpan),
    RefExpr(expr Expr, is_mutable Bool, span SourceSpan),
    WeakrefExpr(inner Expr, span SourceSpan),
    PtrExpr(expr Expr, is_mutable Bool, span SourceSpan),
    DerefExpr(expr Expr, span SourceSpan),
    UnsafeDerefExpr(expr Expr, span SourceSpan),
    ArithmeticExpr(left Expr, op ArithmeticOperator, right Expr, span SourceSpan),
    ComparisonExpr(left Expr, op ComparisonOperator, right Expr, span SourceSpan),
    ComparisonChainExpr(operands List[Expr], operators List[ComparisonOperator], span SourceSpan),
    BitwiseExpr(left Expr, op BitwiseOperator, right Expr, span SourceSpan),
    AndExpr(left Expr, right Expr, span SourceSpan),
    OrExpr(left Expr, right Expr, span SourceSpan),
    RangeExpr(op RangeOperator, left Option[Expr], right Option[Expr], span SourceSpan),
    OrElseExpr(operand Expr, default_expr Expr, span SourceSpan),
    OrReturnExpr(operand Expr, span SourceSpan),
    AndThenExpr(operand Expr, transform_expr Expr, span SourceSpan),
    IsExpr(subject Expr, pattern PatternNode, span SourceSpan),
    IsNotExpr(subject Expr, pattern PatternNode, span SourceSpan),
    CollectionLiteral(elements List[Expr], span SourceSpan),
    DictLiteral(entries List[ExprPair], span SourceSpan),
    EmptyLiteral(span SourceSpan),
    NamedArgument(label String, expr Expr, span SourceSpan),
    Call(callee Expr, args List[Expr], span SourceSpan),
    MemberPath(base Expr, path List[String], span SourceSpan),
    TraitQualificationExpr(base Expr, trait_type TypeNode, span SourceSpan),
    GenericMethodCall(base Expr, method_type_args List[TypeNode], method_name String, args List[Expr], span SourceSpan),
    QualifiedMethodCall(base Expr, trait_type TypeNode, method_name String, args List[Expr], span SourceSpan),
    QualifiedGenericMethodCall(base Expr, trait_type TypeNode, method_type_args List[TypeNode], method_name String, args List[Expr], span SourceSpan),
    GenericInstantiation(base String, type_args List[TypeNode], span SourceSpan),
    StaticMethodCall(type_name String, type_args List[TypeNode], method_name String, args List[Expr], span SourceSpan),
    SubscriptExpr(base Expr, args List[Expr], span SourceSpan),
    Block(statements List[Statement], tail_expression Option[Expr], span SourceSpan),
    IfExpr(condition Expr, then_branch Expr, else_branch Option[Expr], span SourceSpan),
    WhileExpr(condition Expr, body Expr, span SourceSpan),
    ForExpr(pattern ForBindingPattern, iterable Expr, body Expr, span SourceSpan),
    WhenExpr(subject Expr, arms List[WhenArm], span SourceSpan),
    LambdaExpr(params List[LambdaParam], return_type Option[TypeNode], body Expr, span SourceSpan),
    ImplicitMemberExpr(member_name String, args List[Expr], span SourceSpan),
};

public let pattern_span(pattern PatternNode) SourceSpan = {
    return when pattern in {
        .Wildcard(span) then span,
        .Variable(_, _, span) then span,
        .BoolLiteral(_, span) then span,
        .IntegerLiteral(_, span) then span,
        .NegativeIntegerLiteral(_, span) then span,
        .StringLiteral(_, span) then span,
        .RuneLiteral(_, span) then span,
        .TraitObjectType(_, span) then span,
        .TraitObjectTypeBinding(_, _, _, span) then span,
        .EnumCase(_, _, span) then span,
        .StructPattern(_, _, span) then span,
        .TuplePattern(_, span) then span,
        .ComparisonPattern(_, _, span) then span,
        .AndPattern(_, _, span) then span,
        .OrPattern(_, _, span) then span,
        .NotPattern(_, span) then span,
    };
};

public let expr_span(expr Expr) SourceSpan = {
    return when expr in {
        .Identifier(_, span) then span,
        .IntegerLiteral(_, span) then span,
        .FloatLiteral(_, span) then span,
        .StringLiteral(_, span) then span,
        .RuneLiteral(_, span) then span,
        .InterpolatedString(_, span) then span,
        .BoolLiteral(_, span) then span,
        .CastExpr(_, _, span) then span,
        .Unary(_, _, span) then span,
        .RefExpr(_, _, span) then span,
        .WeakrefExpr(_, span) then span,
        .PtrExpr(_, _, span) then span,
        .DerefExpr(_, span) then span,
        .UnsafeDerefExpr(_, span) then span,
        .ArithmeticExpr(_, _, _, span) then span,
        .ComparisonExpr(_, _, _, span) then span,
        .ComparisonChainExpr(_, _, span) then span,
        .BitwiseExpr(_, _, _, span) then span,
        .AndExpr(_, _, span) then span,
        .OrExpr(_, _, span) then span,
        .RangeExpr(_, _, _, span) then span,
        .OrElseExpr(_, _, span) then span,
        .OrReturnExpr(_, span) then span,
        .AndThenExpr(_, _, span) then span,
        .IsExpr(_, _, span) then span,
        .IsNotExpr(_, _, span) then span,
        .CollectionLiteral(_, span) then span,
        .DictLiteral(_, span) then span,
        .EmptyLiteral(span) then span,
        .NamedArgument(_, _, span) then span,
        .Call(_, _, span) then span,
        .MemberPath(_, _, span) then span,
        .TraitQualificationExpr(_, _, span) then span,
        .GenericMethodCall(_, _, _, _, span) then span,
        .QualifiedMethodCall(_, _, _, _, span) then span,
        .QualifiedGenericMethodCall(_, _, _, _, _, span) then span,
        .GenericInstantiation(_, _, span) then span,
        .StaticMethodCall(_, _, _, _, span) then span,
        .SubscriptExpr(_, _, span) then span,
        .Block(_, _, span) then span,
        .IfExpr(_, _, _, span) then span,
        .WhileExpr(_, _, span) then span,
        .ForExpr(_, _, _, span) then span,
        .WhenExpr(_, _, span) then span,
        .LambdaExpr(_, _, _, span) then span,
        .ImplicitMemberExpr(_, _, span) then span,
    };
};
