// type_handler.koral - 类型处理器系统
//
// 对应 compiler-reference/Sources/KoralCompiler/Sema/TypeHandler.swift
// - copy/drop 代码生成
// - 成员/方法查询
// - 泛型参数检测

// ── TypeHandlerKind ───────────────────────────────────────────────────────────

/// 类型处理器支持的类型种类
public type TypeHandlerKind {
    Primitive(),
    Structure(),
    Enum(),
    Function(),
    Reference(),
    MutableReference(),
    Pointer(),
    MutablePointer(),
    WeakReference(),
    GenericParameter(),
    GenericStruct(),
    GenericEnum(),
    Module(),
    TypeVariable(),
    Opaque(),
    FixedArray(),
};

/// 从 Type 获取对应的 TypeHandlerKind
public let type_handler_kind_from(t: Type): TypeHandlerKind = {
    return when t in {
        .IntType() or .Int8Type() or .Int16Type() or .Int32Type() or .Int64Type() or .UIntType()
        or .UInt8Type() or .UInt16Type() or .UInt32Type() or .UInt64Type() or .WrappingIntType()
        or .WrappingInt8Type() or .WrappingInt16Type() or .WrappingInt32Type() or .WrappingInt64Type()
        or .WrappingUIntType() or .WrappingUInt8Type() or .WrappingUInt16Type() or .WrappingUInt32Type()
        or .WrappingUInt64Type() or .Float32Type() or .Float64Type() or .BoolType() or .VoidType()
        or .NeverType() then TypeHandlerKind.Primitive(),
        .StructureType(_) then TypeHandlerKind.Structure(),
        .EnumType(_) then TypeHandlerKind.Enum(),
        .FunctionType(...) then TypeHandlerKind.Function(),
        .ReferenceType(_) then TypeHandlerKind.Reference(),
        .MutableReferenceType(_) then TypeHandlerKind.MutableReference(),
        .BorrowedReferenceType(_) then TypeHandlerKind.Reference(),
        .MutableBorrowedReferenceType(_) then TypeHandlerKind.MutableReference(),
        .PointerType(_) then TypeHandlerKind.Pointer(),
        .MutablePointerType(_) then TypeHandlerKind.MutablePointer(),
        .WeakReferenceType(_) or .MutableWeakReferenceType(_) then TypeHandlerKind.WeakReference(),
        .GenericParameter(_) then TypeHandlerKind.GenericParameter(),
        .GenericStruct(...) then TypeHandlerKind.GenericStruct(),
        .GenericEnum(...) then TypeHandlerKind.GenericEnum(),
        .ModuleType(_) then TypeHandlerKind.Module(),
        .OpaqueType(_) then TypeHandlerKind.Opaque(),
        .TraitObject(...) then TypeHandlerKind.Reference(),
        .TypeVar(_) then TypeHandlerKind.TypeVariable(),
        .Unknown() then TypeHandlerKind.Primitive(),
        .FixedArrayType(_, _) then TypeHandlerKind.FixedArray(),
        .ForeignFunctionType(_, _) then TypeHandlerKind.Function(),    };
};

// ── TypeHandlerResult types ───────────────────────────────────────────────────

/// 类型成员信息
public type mutable TypeMemberInfo(
    name: String,
    member_type: Type,
    is_mutable: Bool,
    access: AccessModifier,
);

// ── 句柄族（handle families）──────────────────────────────────────────────────
//
// 类型的「句柄形态」的内在性质。任何「这是不是引用/指针类类型」的判定都由
// 这四个族组合而来，而不是各自重新罗列 Type case——新增一个句柄族是这里
// 一处改动，不是每个阶段各改一遍。四个族是：
//
//   owned_ref   强引用（带 strong 计数）
//   borrowed_ref 借用引用（自己不带计数）
//   weak_ref    弱句柄（带 weak 计数）
//   raw_pointer 裸指针（纯地址，无计数）
//
// 组合集合（各自的语义）：
//   type_is_handle           四族全体
//   type_is_tracked_handle   运行时跟踪的句柄（引用 + 弱；裸指针的 NULL 合法，
//                            不算被跟踪）
//   type_is_counted_handle   自带引用计数（强 + 弱）：copy glue 非平凡的集合
//   type_is_any_ref          一切引用（强 + 借用）
//   type_is_mutable_handle   各族的 mutable 拼法

/// 强引用句柄（带 strong 计数）。
public let type_is_owned_ref(t: Type): Bool = {
    return when t in {
        .ReferenceType(_) or .MutableReferenceType(_) then true,
        _ then false,
    };
};

/// 借用引用句柄（不带自己的计数）。
public let type_is_borrowed_ref(t: Type): Bool = {
    return when t in {
        .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) then true,
        _ then false,
    };
};

/// 弱句柄（带 weak 计数）。
public let type_is_weak_ref(t: Type): Bool = {
    return when t in {
        .WeakReferenceType(_) or .MutableWeakReferenceType(_) then true,
        _ then false,
    };
};

/// 裸指针（纯地址，无计数）。
public let type_is_raw_pointer(t: Type): Bool = {
    return when t in {
        .PointerType(_) or .MutablePointerType(_) then true,
        _ then false,
    };
};

/// 一切句柄形态（四族全体）。
public let type_is_handle(t: Type): Bool = {
    return type_is_owned_ref(t) or type_is_borrowed_ref(t) or type_is_weak_ref(t) or type_is_raw_pointer(t);
};

/// 运行时跟踪的句柄：引用 + 弱。裸指针的 NULL 是合法值，不算被跟踪。
public let type_is_tracked_handle(t: Type): Bool = {
    return type_is_owned_ref(t) or type_is_borrowed_ref(t) or type_is_weak_ref(t);
};

/// 自带引用计数（强 + 弱）的句柄：copy glue 非平凡的集合。借用和裸指针
/// 的 copy 是平凡的。
public let type_is_counted_handle(t: Type): Bool = {
    return type_is_owned_ref(t) or type_is_weak_ref(t);
};

/// 一切引用（强 + 借用），不含弱和裸指针。
public let type_is_any_ref(t: Type): Bool = {
    return type_is_owned_ref(t) or type_is_borrowed_ref(t);
};

/// 各句柄族的 mutable 拼法。
public let type_is_mutable_handle(t: Type): Bool = {
    return when t in {
        .MutableReferenceType(_) or .MutableBorrowedReferenceType(_) or .MutableWeakReferenceType(_)
        or .MutablePointerType(_) then true,
        _ then false,
    };
};

/// 递归扫描：类型内部是否藏着 borrowed `ref`（种子的
/// `Type.containsBorrowedReference`）。
public let type_contains_borrowed_reference(t: Type): Bool = {
    return when t in {
        .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) then true,
        .FixedArrayType(_, inner) then type_contains_borrowed_reference(inner),
        .FunctionType(params, ret, _) then {
            for p in params then {
                if type_contains_borrowed_reference(p.param_type) then {
                    return true;
                };
            };
            type_contains_borrowed_reference(ret)
        },
        .ForeignFunctionType(params, ret) then {
            for p in params then {
                if type_contains_borrowed_reference(p.param_type) then {
                    return true;
                };
            };
            type_contains_borrowed_reference(ret)
        },
        .ReferenceType(inner) or .MutableReferenceType(inner) or .PointerType(inner)
        or .MutablePointerType(inner) or .WeakReferenceType(inner) or .MutableWeakReferenceType(inner) then {
            type_contains_borrowed_reference(inner)
        },
        .GenericStruct(_, args) or .GenericEnum(_, args) or .TraitObject(_, args, _) then {
            for a in args then {
                if type_contains_borrowed_reference(a) then {
                    return true;
                };
            };
            false
        },
        _ then false,
    };
};

/// 递归扫描：类型内部是否藏着 `Never`（种子的 `containsNeverType`）。
public let type_contains_never(t: Type): Bool = {
    return when t in {
        .NeverType() then true,
        .FixedArrayType(_, inner) then type_contains_never(inner),
        .FunctionType(params, ret, _) then {
            for p in params then {
                if type_contains_never(p.param_type) then {
                    return true;
                };
            };
            type_contains_never(ret)
        },
        .ForeignFunctionType(params, ret) then {
            for p in params then {
                if type_contains_never(p.param_type) then {
                    return true;
                };
            };
            type_contains_never(ret)
        },
        .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner)
        or .MutableBorrowedReferenceType(inner) or .PointerType(inner) or .MutablePointerType(inner)
        or .WeakReferenceType(inner) or .MutableWeakReferenceType(inner) then {
            type_contains_never(inner)
        },
        .GenericStruct(_, args) or .GenericEnum(_, args) or .TraitObject(_, args, _) then {
            for a in args then {
                if type_contains_never(a) then {
                    return true;
                };
            };
            false
        },
        _ then false,
    };
};

// ── TypeHandler 查询函数 ──────────────────────────────────────────────────────

/// 检查类型是否需要 copy 函数
public let type_needs_copy(t: Type): Bool = {
    return when t in {
        .StructureType(_) or .EnumType(_) or .FunctionType(...) or .GenericStruct(...) or .GenericEnum(...) then true,
        _ then type_is_counted_handle(t),
    };
};

/// 检查类型是否需要 drop 函数
public let type_needs_drop(t: Type): Bool = {
    return when t in {
        .StructureType(_) or .EnumType(_) or .FunctionType(...) or .GenericStruct(...) or .GenericEnum(...)
        or .TraitObject(...) or .TypeVar(_) then true,
        _ then type_is_tracked_handle(t),
    };
};

/// 生成原始类型的 C 类型名
public let primitive_c_type_name(t: Type): String = {
    return when t in {
        .IntType() then "intptr_t",
        .Int8Type() then "int8_t",
        .Int16Type() then "int16_t",
        .Int32Type() then "int32_t",
        .Int64Type() then "int64_t",
        .UIntType() then "uintptr_t",
        .UInt8Type() then "uint8_t",
        .UInt16Type() then "uint16_t",
        .UInt32Type() then "uint32_t",
        .UInt64Type() then "uint64_t",
        .WrappingIntType() then "intptr_t",
        .WrappingInt8Type() then "int8_t",
        .WrappingInt16Type() then "int16_t",
        .WrappingInt32Type() then "int32_t",
        .WrappingInt64Type() then "int64_t",
        .WrappingUIntType() then "uintptr_t",
        .WrappingUInt8Type() then "uint8_t",
        .WrappingUInt16Type() then "uint16_t",
        .WrappingUInt32Type() then "uint32_t",
        .WrappingUInt64Type() then "uint64_t",
        .Float32Type() then "float",
        .Float64Type() then "double",
        .BoolType() then "int",
        .VoidType() or .NeverType() then "void",
        _ then "void",
    };
};

/// 检查类型是否包含泛型参数（递归检查，带循环检测）
public let type_contains_generic_parameter(t: Type, context: CompilerContext): Bool = {
    let mutable visited = Set[UInt].new();
    return type_contains_generic_parameter_internal(t, context, visited);
};

/// 仅检查类型表面是否仍提及未解析的泛型占位。
///
/// 这与 `type_contains_generic_parameter` 的语义不同：它不会递归展开
/// 已定义的结构体/枚举，只用于判断当前类型节点是否还未完全具体化。
public let type_mentions_unresolved_generic_placeholder(t: Type): Bool = {
    let mutable worklist = List[Type].new();
    worklist.push(t);

    while not worklist.is_empty() then {
        let current_opt = worklist.pop();
        if current_opt is .None() then {
            break;
        };
        let current = current_opt.unwrap();
        when current in {
            .GenericParameter(_) or .TypeVar(_) then {
                return true;
            },
            .FunctionType(params, ret, _) then {
                worklist.push(ret);
                for entry in params then {
                    worklist.push(entry.param_type);
                };
            },
            .ForeignFunctionType(params, ret) then {
                worklist.push(ret);
                for entry in params then {
                    worklist.push(entry.param_type);
                };
            },
            .ReferenceType(inner) or .MutableReferenceType(inner) or .PointerType(inner)
            or .MutablePointerType(inner) or .WeakReferenceType(inner) or .MutableWeakReferenceType(inner) then {
                worklist.push(inner);
            },
            .GenericStruct(_, args) or .GenericEnum(_, args) then {
                for a in args then {
                    worklist.push(a);
                };
            },
            _ then {},
        };
    };
    return false;
};

/// Returns the children types that need to be checked for generic parameters.
/// This is used by the iterative version to avoid deep recursion.
private let collect_type_children(
    t: Type,
    context: CompilerContext,
    visited: Set[UInt],
): List[Type] = {
    let mutable children = List[Type].new();
    when t in {
        .FunctionType(params, ret, _) then {
            children.push(ret);
            for entry in params then {
                children.push(entry.param_type);
            };
        },
        .ForeignFunctionType(params, ret) then {
            children.push(ret);
            for entry in params then {
                children.push(entry.param_type);
            };
        },
        .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner)
        or .MutableBorrowedReferenceType(inner) or .PointerType(inner) or .MutablePointerType(inner)
        or .WeakReferenceType(inner) or .MutableWeakReferenceType(inner) then {
            children.push(inner);
        },
        .StructureType(def_id) then {
            if not visited.contains(def_id.id) then {
                visited.insert(def_id.id);
                when context.get_type_arguments(def_id) in {
                    .Some(args) then {
                        for a in args then {
                            children.push(a);
                        };
                    },
                    .None() then {
                        when context.get_struct_fields(def_id) in {
                            .Some(fields) then {
                                for f in fields then {
                                    children.push(f.field_type);
                                };
                            },
                            .None() then {},
                        };
                    },
                };
            };
        },
        .EnumType(def_id) then {
            if not visited.contains(def_id.id) then {
                visited.insert(def_id.id);
                when context.get_type_arguments(def_id) in {
                    .Some(args) then {
                        for a in args then {
                            children.push(a);
                        };
                    },
                    .None() then {
                        when context.get_enum_cases(def_id) in {
                            .Some(cases) then {
                                for c in cases then {
                                    for p in c.params then {
                                        children.push(p.param_type);
                                    };
                                };
                            },
                            .None() then {},
                        };
                    },
                };
            };
        },
        .GenericStruct(_, args) or .GenericEnum(_, args) then {
            for a in args then {
                children.push(a);
            };
        },
        _ then {},
    };
    return children;
};

/// Iterative version of type_contains_generic_parameter_internal.
/// Uses an explicit worklist to avoid stack overflow on deeply nested types.
private let type_contains_generic_parameter_internal(
    t: Type,
    context: CompilerContext,
    visited: Set[UInt],
): Bool = {
    let mutable worklist = List[Type].new();
    worklist.push(t);

    while not worklist.is_empty() then {
        let current_opt = worklist.pop();
        if current_opt is .None() then {
            break;
        };
        let current = current_opt.unwrap();
        when current in {
            .GenericParameter(_) or .TypeVar(_) then {
                return true;
            },
            _ then {
                let children = collect_type_children(current, context, visited);
                for child in children then {
                    worklist.push(child);
                };
            },
        };
    };
    return false;
};
