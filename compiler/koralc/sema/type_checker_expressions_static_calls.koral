using "std/os" { env };

given TypeChecker {
    /// The type-parameter names of a generic struct TEMPLATE.
    ///
    /// Identity is the carried `template_def_id`, and the template declaration is
    /// reached through it (`struct_by_def_id`) -- never through its spelling.
    /// Two sources, both keyed by that same DefId: the recorded `type_arguments`
    /// when the declaration carried them, otherwise the template's own parameter
    /// list. (rustc: `tcx.generics_of(def_id)` -- keyed by the DefId.)
    generic_struct_type_parameter_names(self, template_def_id: DefId): List[String] = {
        let mutable names = List[String].new();
        when self.context().get_type_arguments(template_def_id) in {
            .Some(type_args) then {
                for arg in type_args then {
                    when arg in {
                        .GenericParameter(name) then names.push(name),
                        _ then {},
                    };
                };
                return names;
            },
            .None() then {},
        };
        when self.storage.generic_templates.struct_by_def_id(template_def_id) in {
            .Some(template) then {
                for parameter in template.type_parameters then {
                    names.push(parameter.name);
                };
            },
            .None() then {},
        };
        return names;
    };

    semantic_method_name_for_symbol(self, method: Symbol): String = {
        if method.def_id.id > 0 then {
            when self.storage.generic_templates.receiver_method_dispatch.get(
                method.def_id,
            ) in {
                .Some(info) then {
                    return info.method_name;
                },
                .None() then {},
            };
        };
        return self.context().symbol_name(method);
    };

    type_construction_arg_types(self, constructed_type: Type): List[Type] = {
        return when constructed_type in {
            .StructureType(def_id) then when self.context().get_struct_fields(def_id) in {
                .Some(fields) then {
                    let mutable types = List[Type].new();
                    for field in fields then {
                        types.push(field.field_type);
                    };
                    types
                },
                .None() then List[Type].new(),
            },
            .GenericStruct(template_def_id, args) then {
                // Same as the `.StructureType` branch above: the carried DefId
                // is the field table's key.
                let fields = self.context().get_struct_fields(template_def_id) or else List[StructField].new(
                );
                let parameter_names = self.generic_struct_type_parameter_names(
                    template_def_id,
                );
                let mutable bindings = Dict[String, Type].new();
                let mutable index: UInt = 0;
                let param_count = parameter_names.count();
                let arg_count = args.count();
                let n = if param_count < arg_count then param_count else arg_count;
                while index < n then {
                    bindings.insert(parameter_names[index], args[index]);
                    index += 1;
                };
                let mutable types = List[Type].new();
                for field in fields then {
                    types.push(self.apply_type_bindings(field.field_type, bindings));
                };
                return types;
            },
            _ then List[Type].new(),
        };
    };

    recheck_type_construction_args(
        self,
        args: List[Expr],
        constructed_type: Type,
        scope: Scope,
        blame_span: SourceSpan,
    ): List[TypedExpr] = {
        let expected_types = self.type_construction_arg_types(constructed_type);
        let mutable typed_args = List[TypedExpr].new();
        let mutable index: UInt = 0;
        for arg in args then {
            let mutable expected_type = if index < expected_types.count() then Option[Type].Some(
                expected_types[index],
            ) else Option[Type].None();
            // The reference compiler fits construction arguments after they
            // are checked and blames the CALL for what does not fit -- a
            // literal's range violation included.
            let saved_range_blame = self.storage.range_blame_span;
            if arg is .IntegerLiteral(...) then {
                self.storage.range_blame_span = Option[SourceSpan].Some(blame_span);
            };
            let typed_arg = self.check_expr_scoped_ref(arg, expected_type, scope);
            let adapted = self.adapt_expr_to_expected_type_at(
                typed_arg,
                expected_type,
                Option[SourceSpan].Some(blame_span),
            );
            self.storage.range_blame_span = saved_range_blame;
            // The seed's post-coerce row: an argument whose coerced type still
            // disagrees with its field is a conflict at the call.
            if expected_type is .Some(expected_t) then {
                if not self.same_expr_type(adapted.expr_type, expected_t) and not self.type_matches_expected_pattern(
                    expected_t,
                    adapted.expr_type,
                ) and not self.contains_generic_parameter(expected_t) and not self.is_unresolved_expr_type(
                    expected_t,
                ) and not self.is_unresolved_expr_type(adapted.expr_type) then {
                    self.push_diagnostic(
                        self.format_call_type_mismatch_message(
                            Expr.IntegerLiteral("", blame_span),
                            args,
                            expected_t,
                            adapted.expr_type,
                        ),
                        blame_span,
                    );
                };
            };
            typed_args.push(adapted);
            index += 1;
        };
        return typed_args;
    };

    constructor_field_names(self, constructed_type: Type): List[String] = {
        return when constructed_type in {
            .StructureType(def_id) then when self.context().get_struct_fields(def_id) in {
                .Some(fields) then {
                    let mutable names = List[String].new();
                    for field in fields then {
                        names.push(field.name);
                    };
                    names
                },
                .None() then List[String].new(),
            },
            .GenericStruct(template_def_id, _) then {
                // Same as the `.StructureType` branch above: the carried DefId
                // is the field table's key.
                let fields = self.context().get_struct_fields(template_def_id) or else List[StructField].new(
                );
                let mutable names = List[String].new();
                for field in fields then {
                    names.push(field.name);
                };
                return names;
            },
            .EnumType(def_id) then when self.context().get_enum_cases(def_id) in {
                .Some(cases) then {
                    let mutable names = List[String].new();
                    if not cases.is_empty() then {
                        for param in cases[UInt(0)].params then {
                            names.push(param.name);
                        };
                    };
                    names
                },
                .None() then List[String].new(),
            },
            _ then List[String].new(),
        };
    };

    reorder_constructor_args(self, args: List[Expr], constructed_type: Type): List[Expr] = {
        let field_names = self.constructor_field_names(constructed_type);
        let mutable has_named = false;
        let mutable has_positional = false;
        for arg in args then {
            when arg in {
                .NamedArgument(...) then {
                    has_named = true;
                },
                _ then {
                    has_positional = true;
                },
            };
        };

        if not has_named or has_positional then {
            return args;
        };

        let mutable ordered = List[Expr].new();
        for field_name in field_names then {
            for arg in args then {
                when arg in {
                    .NamedArgument(label, inner, _) then if label == field_name then {
                        ordered.push(inner);
                        break;
                    },
                    _ then {},
                };
            };
        };
        return ordered;
    };

    type_node_for_type(self, t: Type): TypeNode = {
        return when t in {
            .IntType() then TypeNode.Identifier("Int", unknown_span()),
            .Int8Type() then TypeNode.Identifier("Int8", unknown_span()),
            .Int16Type() then TypeNode.Identifier("Int16", unknown_span()),
            .Int32Type() then TypeNode.Identifier("Int32", unknown_span()),
            .Int64Type() then TypeNode.Identifier("Int64", unknown_span()),
            .UIntType() then TypeNode.Identifier("UInt", unknown_span()),
            .UInt8Type() then TypeNode.Identifier("UInt8", unknown_span()),
            .UInt16Type() then TypeNode.Identifier("UInt16", unknown_span()),
            .UInt32Type() then TypeNode.Identifier("UInt32", unknown_span()),
            .UInt64Type() then TypeNode.Identifier("UInt64", unknown_span()),
            .WrappingIntType() then TypeNode.Identifier("WrappingInt", unknown_span()),
            .WrappingInt8Type() then TypeNode.Identifier("WrappingInt8", unknown_span()),
            .WrappingInt16Type() then TypeNode.Identifier(
                "WrappingInt16",
                unknown_span(),
            ),
            .WrappingInt32Type() then TypeNode.Identifier(
                "WrappingInt32",
                unknown_span(),
            ),
            .WrappingInt64Type() then TypeNode.Identifier(
                "WrappingInt64",
                unknown_span(),
            ),
            .WrappingUIntType() then TypeNode.Identifier("WrappingUInt", unknown_span()),
            .WrappingUInt8Type() then TypeNode.Identifier(
                "WrappingUInt8",
                unknown_span(),
            ),
            .WrappingUInt16Type() then TypeNode.Identifier(
                "WrappingUInt16",
                unknown_span(),
            ),
            .WrappingUInt32Type() then TypeNode.Identifier(
                "WrappingUInt32",
                unknown_span(),
            ),
            .WrappingUInt64Type() then TypeNode.Identifier(
                "WrappingUInt64",
                unknown_span(),
            ),
            .Float32Type() then TypeNode.Identifier("Float32", unknown_span()),
            .Float64Type() then TypeNode.Identifier("Float64", unknown_span()),
            .BoolType() then TypeNode.Identifier("Bool", unknown_span()),
            .VoidType() then TypeNode.Identifier("Void", unknown_span()),
            .NeverType() then TypeNode.Identifier("Never", unknown_span()),
            .StructureType(def_id) then TypeNode.Identifier(
                self.context().get_name(def_id) or else self.context().type_display_name(
                    t,
                ),
                unknown_span(),
            ),
            .EnumType(def_id) then TypeNode.Identifier(
                self.context().get_name(def_id) or else self.context().type_display_name(
                    t,
                ),
                unknown_span(),
            ),
            .ReferenceType(inner) then TypeNode.Reference(
                self.type_node_for_type(inner),
                false,
                unknown_span(),
            ),
            .MutableReferenceType(inner) then TypeNode.Reference(
                self.type_node_for_type(inner),
                true,
                unknown_span(),
            ),
            .BorrowedReferenceType(inner) then TypeNode.BorrowedReference(
                self.type_node_for_type(inner),
                false,
                unknown_span(),
            ),
            .MutableBorrowedReferenceType(inner) then TypeNode.BorrowedReference(
                self.type_node_for_type(inner),
                true,
                unknown_span(),
            ),
            .PointerType(inner) then TypeNode.Pointer(
                self.type_node_for_type(inner),
                false,
                unknown_span(),
            ),
            .MutablePointerType(inner) then TypeNode.Pointer(
                self.type_node_for_type(inner),
                true,
                unknown_span(),
            ),
            .WeakReferenceType(inner) then TypeNode.WeakReference(
                self.type_node_for_type(inner),
                false,
                unknown_span(),
            ),
            .MutableWeakReferenceType(inner) then TypeNode.WeakReference(
                self.type_node_for_type(inner),
                true,
                unknown_span(),
            ),
            .GenericParameter(name) then TypeNode.Identifier(name, unknown_span()),
            .GenericStruct(tplDefId, type_args) then {
                let mutable arg_nodes = List[TypeNode].new();
                for arg in type_args then {
                    arg_nodes.push(self.type_node_for_type(arg));
                };
                TypeNode.Generic(def_id_spelling(tplDefId), arg_nodes, unknown_span())
            },
            .GenericEnum(tplDefId, type_args) then {
                let mutable arg_nodes = List[TypeNode].new();
                for arg in type_args then {
                    arg_nodes.push(self.type_node_for_type(arg));
                };
                // A TypeNode is syntax and carries a spelling; read it from the
                // declaration. This is display/serialization, not identity.
                TypeNode.Generic(def_id_spelling(tplDefId), arg_nodes, unknown_span())
            },
            _ then TypeNode.Identifier(
                self.context().type_display_name(t),
                unknown_span(),
            ),
        };
    };

    normalize_constructor_call_args(
        self,
        args: List[Expr],
        param_specs: List[FunctionParamSpec],
        field_types: List[Type],
        constructor_description: String,
    ): Option[List[Expr]] = {
        let effective_specs = if param_specs.is_empty() and not field_types.is_empty() then self.positional_param_specs_for_count(
            field_types.count(),
        ) else param_specs;
        return self.plan_call_argument_exprs(
            args,
            effective_specs,
            constructor_description,
        );
    };

    should_suppress_missing_member_call_diagnostic(self, typed_callee: TypedExpr): Bool = {
        let _ = self;
        return when typed_callee.expr_kind in {
            .Block(statements, tail_expression) then statements.is_empty() and tail_expression is .None() and typed_callee.expr_type is .Unknown(),
            _ then false,
        };
    };

    dispatches_via_trait_object_for_static_call(self, receiver_type: Type): Bool = {
        return when receiver_type in {
            .TraitObject(...) then true,
            .ReferenceType(inner) then self.dispatches_via_trait_object_for_static_call(
                inner,
            ),
            .MutableReferenceType(inner) then self.dispatches_via_trait_object_for_static_call(
                inner,
            ),
            _ then false,
        };
    };

    trait_object_type_for_static_call(self, receiver_type: Type): Option[Type] = {
        return when receiver_type in {
            .TraitObject(...) then Option[Type].Some(receiver_type),
            .ReferenceType(inner) then self.trait_object_type_for_static_call(inner),
            .MutableReferenceType(inner) then self.trait_object_type_for_static_call(
                inner,
            ),
            _ then Option[Type].None(),
        };
    };

    trait_type_declares_static_call_method(
        self,
        trait_type: Type,
        method_name: String,
    ): Bool = {
        return self.trait_vtable_method_index_for_type(trait_type, method_name) is .Some(_);
    };

    check_static_call_arg_ref(
        self,
        arg: Expr,
        callee_def_id: DefId,
        arg_index: UInt,
        scope: Scope,
    ): TypedExpr = {
        let mutable param_type = self.context().signature_param_type_or_unknown(
            callee_def_id,
            arg_index,
        );
        return when param_type in {
            .Unknown() then self.check_expr_scoped_ref(arg, Option[Type].None(), scope),
            _ then self.check_expr_scoped_ref(arg, Option[Type].Some(param_type), scope),
        };
    };

    first_type_arg_or_unknown(self, type_args: List[Type]): Type = {
        if type_args.count() > 0 then {
            return type_args[UInt(0)];
        };
        return Type.Unknown();
    };

    split_typed_member_path_call_callee(
        self,
        typed_callee: TypedExpr,
    ): Option[Pair[TypedExpr, String]] = {
        return when typed_callee.expr_kind in {
            .MemberPath(base_ref, path) then {
                if path.is_empty() then {
                    return Option[Pair[TypedExpr, String]].None();
                };
                let method_name = self.context().symbol_name(path[path.count() - 1]);
                let receiver_expr = if path.count() == 1 then base_ref
                else {
                    let mutable receiver_path = List[Symbol].new();
                    let mutable receiver_type = base_ref.expr_type;
                    let mutable idx: UInt = 0;
                    while idx + 1 < path.count() then {
                        let segment = path[idx];
                        receiver_path.push(segment);
                        receiver_type = segment.symbol_type;
                        idx += 1;
                    };
                    make_typed_expr(
                        TypedExprKind.MemberPath(base_ref, receiver_path),
                        receiver_type,
                    )
                };
                Option[Pair[TypedExpr, String]].Some(
                    Pair[TypedExpr, String](receiver_expr, method_name),
                )
            },
            _ then Option[Pair[TypedExpr, String]].None(),
        };
    };

    missing_member_call_expr(
        self,
        typed_callee: TypedExpr,
        typed_args: List[TypedExpr],
        base_expr: Expr,
        member: String,
        scope: Scope,
    ): TypedExpr = {
        if self.should_suppress_missing_member_call_diagnostic(typed_callee) then {
            return make_typed_expr(
                TypedExprKind.Call(typed_callee, typed_args),
                Type.Unknown(),
            );
        };
        let typed_base = self.check_child_expr_ref(base_expr, .None(), scope);
        let raw_method = self.resolve_method_signature(typed_base.expr_type, member);
        let visible_method = self.resolve_source_method_signature(
            typed_base.expr_type,
            member,
        );
        let inaccessible_method = when raw_method in {
            .Some(method) then visible_method is .None() and self.reject_inaccessible_method_from_current_context(
                method,
                member,
                expr_span(base_expr),
            ),
            .None() then false,
        };
        if not inaccessible_method then {
            self.push_diagnostic(
                "Member '\(member)' not found in type '\(self.context().type_display_name(typed_base.expr_type))'",
                self.typed_expr_span(typed_callee),
            );
        };
        return make_typed_expr(
            TypedExprKind.Call(typed_callee, typed_args),
            Type.Unknown(),
        );
    };

    check_alloc_memory_intrinsic(
        self,
        intrinsic_type_args: List[Type],
        args: List[Expr],
        scope: Scope,
    ): Option[TypedExpr] = {
        if args.count() != 1 then {
            return Option[TypedExpr].None();
        };
        let mutable elem_type = self.first_type_arg_or_unknown(intrinsic_type_args);
        when elem_type in {
            .Unknown() then {
                return Option[TypedExpr].None();
            },
            _ then {},
        };
        let count_expr = (args[UInt(0)]);
        let count = self.check_expr_scoped_ref(count_expr, .None(), scope);
        let mutable result_type = Type.MutablePointerType(elem_type);
        return Option[TypedExpr].Some(
            make_typed_expr(
                TypedExprKind.IntrinsicCall(
                    TypedIntrinsic.AllocMemory(count, result_type),
                ),
                result_type,
            ),
        );
    };

    check_spawn_thread_intrinsic(
        self,
        args: List[Expr],
        scope: Scope,
    ): Option[TypedExpr] = {
        if args.count() != 4 then {
            return Option[TypedExpr].None();
        };
        let out_handle_arg = args[UInt(0)];
        let out_tid_arg = args[UInt(1)];
        let closure_arg = args[UInt(2)];
        let stack_size_arg = args[UInt(3)];
        let out_handle = self.check_expr_scoped_ref(out_handle_arg, .None(), scope);
        let out_tid = self.check_expr_scoped_ref(out_tid_arg, .None(), scope);
        let closure = self.check_expr_scoped_ref(closure_arg, .None(), scope);
        let stack_size = self.check_expr_scoped_ref(stack_size_arg, .None(), scope);
        let out_handle_ok = when out_handle.expr_type in {
            .MutablePointerType(inner) then when inner in {
                .PointerType(pointee) then pointee is .UInt8Type(),
                _ then false,
            },
            _ then false,
        };
        if not out_handle_ok then {
            let first_arg = args[UInt(0)];
            self.push_diagnostic_at_span(
                "spawn_thread: first argument must be *mutable *UInt8",
                expr_span(first_arg),
            );
        };
        let out_tid_ok = when out_tid.expr_type in {
            .MutablePointerType(inner) then inner is .UInt64Type(),
            _ then false,
        };
        if not out_tid_ok then {
            let second_arg = args[UInt(1)];
            self.push_diagnostic_at_span(
                "spawn_thread: second argument must be *mutable UInt64",
                expr_span(second_arg),
            );
        };
        let closure_ok = when closure.expr_type in {
            .FunctionType(fn_params, return_type) then fn_params.is_empty() and return_type is .VoidType(),
            _ then false,
        };
        if not closure_ok then {
            let third_arg = args[UInt(2)];
            self.push_diagnostic_at_span(
                "spawn_thread: third argument must be [Void]Func",
                expr_span(third_arg),
            );
        };
        if stack_size.expr_type is not .UInt64Type() then {
            let fourth_arg = args[UInt(3)];
            self.push_diagnostic_at_span(
                "spawn_thread: fourth argument must be UInt64",
                expr_span(fourth_arg),
            );
        };
        return Option[TypedExpr].Some(
            make_typed_expr(
                TypedExprKind.IntrinsicCall(
                    TypedIntrinsic.SpawnThread(out_handle, out_tid, closure, stack_size),
                ),
                Type.Int32Type(),
            ),
        );
    };

    check_take_memory_intrinsic(
        self,
        intrinsic_type_args: List[Type],
        args: List[Expr],
        scope: Scope,
    ): Option[TypedExpr] = {
        if args.count() != 1 then {
            return Option[TypedExpr].None();
        };
        let pointer_arg = args[UInt(0)];
        let pointer_expr = self.check_expr_scoped_ref(pointer_arg, .None(), scope);
        let result_type = when pointer_expr.expr_type in {
            .PointerType(inner) then inner,
            .MutablePointerType(inner) then inner,
            _ then self.first_type_arg_or_unknown(intrinsic_type_args),
        };
        // Deref bound check removed: in the simplified type system,
        // take_memory works on any type parameter without Deref constraint.
        let checked_result_type = result_type;
        return Option[TypedExpr].Some(
            make_typed_expr(
                TypedExprKind.IntrinsicCall(
                    TypedIntrinsic.TakeMemory(pointer_expr, checked_result_type),
                ),
                checked_result_type,
            ),
        );
    };

    check_init_memory_value_expr(
        self,
        value_expr: Expr,
        pointer_type: Type,
        scope: Scope,
    ): TypedExpr = {
        return when pointer_type in {
            .PointerType(inner) then self.check_expr_scoped_ref(
                value_expr,
                Option[Type].Some(inner),
                scope,
            ),
            .MutablePointerType(inner) then self.check_expr_scoped_ref(
                value_expr,
                Option[Type].Some(inner),
                scope,
            ),
            _ then self.check_expr_scoped_ref(value_expr, Option[Type].None(), scope),
        };
    };

    check_init_memory_intrinsic(self, args: List[Expr], scope: Scope): Option[TypedExpr] = {
        if args.count() != 2 then {
            return Option[TypedExpr].None();
        };
        let pointer_arg = args[UInt(0)];
        let value_arg = args[UInt(1)];
        let pointer_expr = self.check_expr_scoped_ref(pointer_arg, .None(), scope);
        let value = self.check_init_memory_value_expr(
            value_arg,
            pointer_expr.expr_type,
            scope,
        );
        return Option[TypedExpr].Some(
            make_typed_expr(
                TypedExprKind.IntrinsicCall(
                    TypedIntrinsic.InitMemory(pointer_expr, value),
                ),
                Type.VoidType(),
            ),
        );
    };

    check_copy_or_move_memory_intrinsic(
        self,
        intrinsic_name: String,
        args: List[Expr],
        scope: Scope,
    ): Option[TypedExpr] = {
        if args.count() != 3 then {
            return Option[TypedExpr].None();
        };
        let dest_arg = args[UInt(0)];
        let source_arg = args[UInt(1)];
        let count_arg = args[UInt(2)];
        let dest = self.check_expr_scoped_ref(dest_arg, .None(), scope);
        let source = self.check_expr_scoped_ref(source_arg, .None(), scope);
        let count = self.check_expr_scoped_ref(count_arg, .None(), scope);
        let intrinsic_node = if intrinsic_name == "copy_memory" then TypedIntrinsic.CopyMemory(
            dest,
            source,
            count,
        ) else TypedIntrinsic.MoveMemory(dest, source, count);
        return Option[TypedExpr].Some(
            make_typed_expr(TypedExprKind.IntrinsicCall(intrinsic_node), Type.VoidType()),
        );
    };

    constrained_trait_object_type_for_static_call(
        self,
        receiver_type: Type,
        trait_name: String,
    ): Type = {
        let normalized = when receiver_type in {
            .ReferenceType(inner) then self.trait_object_type_for_static_call(inner) or else inner,
            .MutableReferenceType(inner) then self.trait_object_type_for_static_call(
                inner,
            ) or else inner,
            .BorrowedReferenceType(inner) then self.trait_object_type_for_static_call(
                inner,
            ) or else inner,
            .MutableBorrowedReferenceType(inner) then self.trait_object_type_for_static_call(
                inner,
            ) or else inner,
            .WeakReferenceType(inner) then self.trait_object_type_for_static_call(inner) or else inner,
            .MutableWeakReferenceType(inner) then self.trait_object_type_for_static_call(
                inner,
            ) or else inner,
            _ then receiver_type,
        };
        let requested_trait_id = self.trait_def_id_by_name(trait_name);
        return when normalized in {
            .TraitObject(existing_trait_def_id, existing_args) then {
                if existing_trait_def_id == requested_trait_id then Type.TraitObject(
                    existing_trait_def_id,
                    existing_args,
                ) else self.canonical_trait_object_type(trait_name)
            },
            _ then self.canonical_trait_object_type(trait_name),
        };
    };

    trait_method_call_receiver(self, base: TypedExpr): TypedExpr = {
        return when base.expr_kind in {
            .DerefExpr(inner) then when inner.expr_type in {
                .ReferenceType(inner_ref) then when inner_ref in {
                    .TraitObject(...) then inner,
                    _ then base,
                },
                .MutableReferenceType(inner_ref) then when inner_ref in {
                    .TraitObject(...) then inner,
                    _ then base,
                },
                _ then base,
            },
            _ then base,
        };
    };

    /// Declaration identity of the enum template named `name`.
    ///
    /// Prefers the type symbol table, which name collection fills before any
    /// signature is resolved -- so the identity cannot depend on declaration
    /// order. `fallback` is the id the lookup already carried, and is used only
    /// when the name is not in the symbol table at all.
    named_enum_template_def_id(self, name: String, fallback: DefId): DefId = {
        let declared = self.generic_template_def_id(name);
        return if declared.is_valid() then declared else fallback;
    };

    /// `span` is the TYPE NAME as written. Every complaint here is about that
    /// name -- it is module-prefixed, it is not visible, it is not a type --
    /// and falling back to the ambient cursor blamed whatever statement the
    /// call happened to sit in.
    /// Enum-case construction returns before the call-shape check in
    /// `check_static_method_call_ref`, so its arguments are checked here.
    /// Same predicate as that check: a real mismatch is reported, an unsolved
    /// generic parameter or an unresolved type is not.
    reject_enum_constructor_arg_mismatches(
        self,
        constructor_name: String,
        call_args: List[Expr],
        typed_args: List[TypedExpr],
        expected_types: List[Type],
    ): Void = {
        let mutable arg_i: UInt = 0;
        while arg_i < typed_args.count() then {
            let typed_arg = typed_args[arg_i];
            when expected_types.get(arg_i) in {
                .Some(expected_t) then {
                    if not self.same_expr_type(typed_arg.expr_type, expected_t) and not self.type_matches_expected_pattern(
                        expected_t,
                        typed_arg.expr_type,
                    ) and not self.contains_generic_parameter(expected_t) and not self.is_unresolved_expr_type(
                        expected_t,
                    ) and not self.is_unresolved_expr_type(typed_arg.expr_type) then {
                        self.push_diagnostic(
                            self.format_call_type_mismatch_message(
                                Expr.ImplicitMemberExpr(
                                    constructor_name,
                                    call_args,
                                    unknown_span(),
                                ),
                                call_args,
                                expected_t,
                                typed_arg.expr_type,
                            ),
                            self.typed_expr_span(typed_arg),
                        );
                    };
                },
                .None() then {},
            };
            arg_i += 1;
        };
    };

    /// The seed's owner type-argument rule for a static call spelled without
    /// type arguments: every owner parameter must be pinned by the call's OWN
    /// arguments (or already concrete in the resolved receiver). `List.new()`
    /// alone is the complaint "expected 1 type arguments, got 0" -- an
    /// expected type never names the owner's parameters.
    reject_unpinned_owner_type_arguments(
        self,
        effective_type_name: String,
        receiver_type_args: List[Type],
        declared_receiver_type: Type,
        sig: Symbol,
        method_type_args: List[Type],
        typed_args: List[TypedExpr],
        call_span: SourceSpan,
    ): Void = {
        if not receiver_type_args.is_empty() then {
            return;
        };
        let mutable owner_params = List[String].new();
        let mutable declared_args = List[Type].new();
        when declared_receiver_type in {
            .GenericStruct(tpl_def_id, args) then {
                owner_params = self.generic_struct_type_parameter_names(tpl_def_id);
                for arg in args then {
                    declared_args.push(arg);
                };
            },
            .GenericEnum(tpl_def_id, args) then {
                when self.storage.generic_templates.enum_by_def_id(tpl_def_id) in {
                    .Some(template) then {
                        for parameter in template.type_parameters then {
                            owner_params.push(parameter.name);
                        };
                    },
                    .None() then {},
                };
                for arg in args then {
                    declared_args.push(arg);
                };
            },
            _ then {},
        };
        if owner_params.is_empty() then {
            return;
        };
        // Pin from the call's own arguments alone -- the same inference the
        // seed does before it resolves the extension method.
        let bindings = self.resolve_static_call_type_bindings(
            effective_type_name,
            receiver_type_args,
            sig,
            typed_args,
            method_type_args,
            Option[Type].None(),
        );
        let mutable index: UInt = 0;
        while index < owner_params.count() then {
            let mutable pinned = false;
            when declared_args.get(index) in {
                .Some(arg_type) then {
                    if not (arg_type is .GenericParameter(_)) and not self.contains_generic_parameter(
                        arg_type,
                    ) and not self.is_unresolved_expr_type(arg_type) then {
                        pinned = true;
                    };
                },
                .None() then {},
            };
            if not pinned then {
                when bindings.get(owner_params[index]) in {
                    .Some(bound_type) then {
                        if not self.is_unresolved_expr_type(bound_type) and not self.contains_generic_parameter(
                            bound_type,
                        ) then {
                            pinned = true;
                        };
                    },
                    .None() then {},
                };
            };
            if not pinned then {
                self.push_diagnostic(
                    "Type mismatch: expected \(owner_params.count()) type arguments, got \(receiver_type_args.count())",
                    call_span,
                );
                return;
            };
            index += 1;
        };
    };

    check_static_method_call_ref(
        self,
        type_name: String,
        type_name_span: SourceSpan,
        type_args: List[TypeNode],
        method_name: String,
        args: List[Expr],
        expected: Option[Type],
        scope: Scope,
    ): TypedExpr = {
        let effective_type_name = type_name;
        let mutable call_args = List[Expr].new();
        for arg in args then {
            call_args.push(arg);
        };
        if type_name.contains(".") then {
            self.push_diagnostic(
                "Module-prefixed access is not supported; import the symbol explicitly with using \"package/subpath\" { Symbol }",
                type_name_span,
            );
            return self.empty_typed_block(Type.Unknown());
        };

        let scoped_receiver_type_opt = self.try_resolve_named_type_in_scope_without_diag(
            effective_type_name,
            scope,
        );
        if scoped_receiver_type_opt is .Some(receiver_type) then {
            self.check_type_visibility(
                receiver_type,
                effective_type_name,
                scope,
                type_name_span,
            );
        };

        let mutable resolved_type_args = List[Type].new();
        for ta in type_args then {
            resolved_type_args.push(self.resolve_type_in_scope(ta, scope));
        };
        if scoped_receiver_type_opt is .None() and resolved_type_args.is_empty() then {
            self.push_diagnostic(
                "Undefined type: \(effective_type_name)",
                type_name_span,
            );
            return self.empty_typed_block(Type.Unknown());
        };
        let receiver_type_param_count = when self.storage.generic_templates.lookup_struct(
            effective_type_name,
        ) in {
            .Some(struct_template) then struct_template.type_parameters.count(),
            .None() then when self.storage.generic_templates.lookup_enum(
                effective_type_name,
            ) in {
                .Some(enum_template) then enum_template.type_parameters.count(),
                .None() then UInt(0),
            },
        };
        let mutable receiver_type_args = List[Type].new();
        let mutable method_type_args = List[Type].new();
        let mutable resolved_type_arg_idx: UInt = 0;
        while resolved_type_arg_idx < resolved_type_args.count() then {
            let resolved_type_arg = resolved_type_args[resolved_type_arg_idx];
            if resolved_type_arg_idx < receiver_type_param_count then {
                receiver_type_args.push(resolved_type_arg);
            } else {
                method_type_args.push(resolved_type_arg);
            };
            resolved_type_arg_idx += 1;
        };
        let mutable receiver_type_arg_refs = List[Type].new();
        for rt in receiver_type_args then {
            receiver_type_arg_refs.push(rt);
        };
        // `Random[NotRandom].new(..)` is spelled as a static call, not a bare
        // generic instantiation, so the template's bounds have to be checked
        // here too. Without this a bad argument type slipped through.
        if self.storage.generic_templates.lookup_struct(effective_type_name) is .Some(struct_template) then {
            self.validate_template_bounds(
                struct_template.def_id,
                receiver_type_args,
                type_name_span,
                true,
            );
        } else if self.storage.generic_templates.lookup_enum(effective_type_name) is .Some(enum_template) then {
            self.validate_template_bounds(
                enum_template.def_id,
                receiver_type_args,
                type_name_span,
                true,
            );
        };

        let raw_declared_receiver_type = self.resolve_static_declared_receiver_type(
            effective_type_name,
            receiver_type_args,
        );
        let declared_receiver_type = when raw_declared_receiver_type in {
            .Unknown() then when scoped_receiver_type_opt in {
                .Some(scoped_receiver_type) then scoped_receiver_type,
                .None() then raw_declared_receiver_type,
            },
            _ then raw_declared_receiver_type,
        };
        let enum_type_opt = when self.try_resolve_named_type_in_scope_without_diag(
            effective_type_name,
            scope,
        ) in {
            .Some(t) then when t in {
                .EnumType(def_id) then {
                    // Declaration identity of the template this NAME denotes.
                    // `generic_template_def_id` reads the type symbol table that
                    // name collection fills before any signature is resolved, so
                    // it cannot depend on declaration order. It must not be
                    // `get_template_def_id(def_id)`: that one answers "which
                    // template is this DefId an INSTANCE of", which is invalid
                    // for a template's own declaration -- and an invalid id makes
                    // every identity comparison below silently fail, handing back
                    // the bare `Res` where `Res[Int]` was wanted.
                    let template_def_id = self.named_enum_template_def_id(
                        effective_type_name,
                        def_id,
                    );
                    if not receiver_type_arg_refs.is_empty() then {
                        Option[Type].Some(
                            Type.GenericEnum(
                                if template_def_id.is_valid() then template_def_id
                                else def_id,
                                receiver_type_arg_refs,
                            ),
                        )
                    } else when expected in {
                        .Some(et) then when et in {
                            // Identity: compare declarations, never spellings.
                            .GenericEnum(expected_def_id, _) then {
                                if expected_def_id == template_def_id then Option[Type].Some(
                                    et,
                                ) else Option[Type].Some(t)
                            },
                            .EnumType(expected_def_id) then {
                                if expected_def_id.id == template_def_id.id then Option[Type].Some(
                                    et,
                                ) else Option[Type].Some(t)
                            },
                            _ then Option[Type].Some(t),
                        },
                        .None() then Option[Type].Some(t),
                    }
                },
                .GenericEnum(template_def_id, existing_args) then {
                    // Same identity rule as above: the registry key can carry an
                    // invalid id, so prefer the declaration the name denotes.
                    let resolved_template_def_id = self.named_enum_template_def_id(
                        effective_type_name,
                        template_def_id,
                    );
                    if not receiver_type_arg_refs.is_empty() then {
                        Option[Type].Some(
                            Type.GenericEnum(
                                resolved_template_def_id,
                                receiver_type_arg_refs,
                            ),
                        )
                    } else when expected in {
                        .Some(et) then when et in {
                            // Identity: compare declarations, never spellings.
                            .GenericEnum(expected_def_id, _) then {
                                if expected_def_id == resolved_template_def_id then Option[Type].Some(
                                    et,
                                ) else Option[Type].Some(t)
                            },
                            _ then Option[Type].Some(t),
                        },
                        .None() then Option[Type].Some(t),
                    }
                },
                _ then Option[Type].None(),
            },
            .None() then Option[Type].None(),
        };
        let enum_constructor_type_opt = when enum_type_opt in {
            .Some(enum_type) then if self.static_member_is_enum_case(
                enum_type,
                method_name,
            ) then Option[Type].Some(enum_type) else Option[Type].None(),
            .None() then Option[Type].None(),
        };
        when enum_constructor_type_opt in {
            .Some(enum_type) then {
                let param_specs = self.get_enum_case_param_specs(enum_type, method_name);
                let field_types = self.get_enum_case_field_types(enum_type, method_name);
                call_args = self.normalize_constructor_call_args(
                    call_args,
                    param_specs,
                    field_types,
                    "\(effective_type_name).\(method_name)",
                ) or else {
                    return self.empty_typed_block(Type.Unknown());
                };
            },
            .None() then {},
        };
        let raw_static_sig_opt = self.resolve_static_method_signature_for_receiver(
            effective_type_name,
            declared_receiver_type,
            method_name,
        );
        let static_sig_opt = when raw_static_sig_opt in {
            .Some(sig) then {
                // Same separation as `resolve_source_method_signature_from_raw`:
                // a method the lookup FOUND but that is NOT accessible here is
                // reported, not rescued by a conformance lookup. The old `else
                // if resolve_conformance_method_signature(...) is .Some(_)`
                // branch re-admitted an invisible static method.
                if self.is_method_accessible_from_current_context(sig) then {
                    Option[Symbol].Some(sig)
                } else {
                    let _ = self.reject_inaccessible_method_from_current_context(
                        sig,
                        method_name,
                        unknown_span(),
                    );
                    Option[Symbol].None()
                }
            },
            .None() then Option[Symbol].None(),
        };
        if raw_static_sig_opt is .Some(_) and static_sig_opt is .None() and enum_constructor_type_opt is .None() then {
            return self.empty_typed_block(Type.Unknown());
        };
        let static_param_types = when static_sig_opt in {
            .Some(sig) then {
                let bindings = self.resolve_static_call_type_bindings(
                    effective_type_name,
                    receiver_type_args,
                    sig,
                    List[TypedExpr].new(),
                    method_type_args,
                    expected,
                );
                let mutable bound_params = List[Type].new();
                let mutable param_i: UInt = 0;
                while param_i < self.method_param_count(sig) then {
                    let mutable param_type = self.method_param_type(sig, param_i) or else Type.Unknown(
                    );
                    bound_params.push(self.apply_type_bindings(param_type, bindings));
                    param_i += 1;
                };
                bound_params
            },
            .None() then {
                when enum_constructor_type_opt in {
                    .Some(enum_type) then self.get_enum_case_field_types(
                        enum_type,
                        method_name,
                    ),
                    .None() then {
                        let raw_static_param_types = self.resolve_static_method_param_types(
                            effective_type_name,
                            method_name,
                        );
                        self.bind_static_method_param_types(
                            effective_type_name,
                            receiver_type_arg_refs,
                            raw_static_param_types,
                        )
                    },
                }
            },
        };
        let mutable static_param_specs = self.resolve_static_call_param_specs(
            effective_type_name,
            method_name,
        );
        if static_param_specs.is_empty() then {
            static_param_specs = when static_sig_opt in {
                .Some(sig) then self.context().get_param_specs(sig.def_id) or else List[FunctionParamSpec].new(
                ),
                .None() then List[FunctionParamSpec].new(),
            };
        };
        if static_param_specs.is_empty() then {
            let fallback_count = if static_param_types.is_empty() then call_args.count()
            else static_param_types.count();
            static_param_specs = self.positional_param_specs_for_count(fallback_count);
        };
        let expected_static_count = if static_param_types.is_empty() then call_args.count(
        ) else static_param_types.count();
        static_param_specs = self.normalize_param_specs_for_count(
            static_param_specs,
            expected_static_count,
        );
        call_args = self.plan_call_argument_exprs(
            call_args,
            static_param_specs,
            method_name,
        ) or else {
            return self.empty_typed_block(Type.Unknown());
        };
        let mutable typed_args = List[TypedExpr].new();
        let mutable static_arg_idx: UInt = 0;
        for a in call_args then {
            let static_param_expected = when static_param_types.get(static_arg_idx) in {
                .Some(pt) then Option[Type].Some(pt),
                .None() then Option[Type].None(),
            };
            let typed_arg = when a in {
                .Identifier(name, span) then self.check_identifier_expr_at(
                    name,
                    span,
                    scope,
                    false,
                ),
                .ArithmeticExpr(left, op, right, _) then self.check_arithmetic_expr_ref(
                    left,
                    op,
                    right,
                    static_param_expected,
                    scope,
                ),
                .ComparisonExpr(left, op, right, _) then self.check_comparison_expr_ref(
                    left,
                    op,
                    right,
                    scope,
                ),
                .BitwiseExpr(left, op, right, _) then self.check_bitwise_expr_ref(
                    left,
                    op,
                    right,
                    static_param_expected,
                    scope,
                ),
                .CastExpr(type_node, inner, cast_span) then {
                    let target = self.resolve_type_in_scope(type_node, scope);
                    self.lower_as_cast_target(target, inner, cast_span, scope, false)
                },
                .DerefExpr(inner, _) then {
                    let typed_inner = self.check_child_expr_ref(inner, .None(), scope);
                    let inner_t = when typed_inner.expr_type in {
                        .ReferenceType(inner_ref) then inner_ref,
                        .MutableReferenceType(inner_ref) then inner_ref,
                        .WeakReferenceType(inner_ref) then inner_ref,
                        .MutableWeakReferenceType(inner_ref) then inner_ref,
                        .PointerType(inner_ref) then inner_ref,
                        .MutablePointerType(inner_ref) then inner_ref,
                        _ then Type.Unknown(),
                    };
                    make_typed_expr(TypedExprKind.DerefExpr(typed_inner), inner_t)
                },
                .UnsafeDerefExpr(inner, _) then {
                    let typed_inner = self.check_child_expr_ref(inner, .None(), scope);
                    let inner_t = when typed_inner.expr_type in {
                        .ReferenceType(inner_ref) then inner_ref,
                        .MutableReferenceType(inner_ref) then inner_ref,
                        .WeakReferenceType(inner_ref) then inner_ref,
                        .MutableWeakReferenceType(inner_ref) then inner_ref,
                        .PointerType(inner_ref) then inner_ref,
                        .MutablePointerType(inner_ref) then inner_ref,
                        _ then Type.Unknown(),
                    };
                    make_typed_expr(TypedExprKind.UnsafeDerefExpr(typed_inner), inner_t)
                },
                .Call(nested_callee, nested_args, _) then self.check_call_expr_ref(
                    nested_callee,
                    nested_args,
                    .None(),
                    scope,
                ),
                .StaticMethodCall(nested_type_name, nested_type_args, nested_method_name, nested_args, call_span) then self.check_static_method_call_ref(
                    nested_type_name,
                    call_span,
                    nested_type_args,
                    nested_method_name,
                    nested_args,
                    .None(),
                    scope,
                ),
                .RangeExpr(op, left, right, _) then {
                    self.check_range_expr_ref(op, left, right, static_param_expected, scope)
                },
                _ then self.check_expr_scoped_ref(a, static_param_expected, scope),
            };
            typed_args.push(
                self.adapt_expr_to_expected_type_at(
                    typed_arg,
                    static_param_expected,
                    Option[SourceSpan].Some(expr_span(a)),
                ),
            );
            static_arg_idx += 1;
        };
        when enum_constructor_type_opt in {
            .Some(enum_type) then {
                self.reject_enum_constructor_arg_mismatches(
                    method_name,
                    call_args,
                    typed_args,
                    static_param_types,
                );
                return self.lower_enum_constructor_expr(
                    enum_type,
                    method_name,
                    typed_args,
                );
            },
            .None() then {
                // The call-shape check the general call path makes: a real
                // mismatch is reported, an unsolved generic parameter or an
                // unresolved type is not. The static spelling checks its
                // arguments here because it never reaches that loop -- and the
                // first explicit argument is the receiver.
                let mutable mismatch_i: UInt = 0;
                while mismatch_i < typed_args.count() then {
                    let typed_arg = typed_args[mismatch_i];
                    when static_param_types.get(mismatch_i) in {
                        .Some(expected_t) then {
                            if not self.same_expr_type(typed_arg.expr_type, expected_t) and not self.type_matches_expected_pattern(
                                expected_t,
                                typed_arg.expr_type,
                            ) and not self.contains_generic_parameter(expected_t) and not self.is_unresolved_expr_type(
                                expected_t,
                            ) and not self.is_unresolved_expr_type(typed_arg.expr_type) then {
                                self.push_diagnostic(
                                    self.format_call_type_mismatch_message(
                                        Expr.ImplicitMemberExpr(
                                            method_name,
                                            call_args,
                                            unknown_span(),
                                        ),
                                        call_args,
                                        expected_t,
                                        typed_arg.expr_type,
                                    ),
                                    type_name_span,
                                );
                            };
                        },
                        .None() then {},
                    };
                    mismatch_i += 1;
                };
                when static_sig_opt in {
                    .Some(sig) then self.reject_unpinned_owner_type_arguments(
                        effective_type_name,
                        receiver_type_args,
                        declared_receiver_type,
                        sig,
                        method_type_args,
                        typed_args,
                        type_name_span,
                    ),
                    .None() then {},
                };
                let resolved_method_type_args = when static_sig_opt in {
                    .Some(sig) then self.resolve_static_method_type_args_for_call(
                        effective_type_name,
                        receiver_type_args,
                        sig,
                        typed_args,
                        method_type_args,
                        expected,
                    ),
                    .None() then method_type_args,
                };
                let receiver_type = when static_sig_opt in {
                    .Some(sig) then {
                        // `declared_receiver_type` is already instantiated when the
                        // call carries type arguments (`List[Pair[UInt, T]]`); the
                        // substitution map still maps `T -> Pair[UInt, T]`, so
                        // applying it again inflates the type. Only substitute when
                        // the receiver was left in declaration form.
                        if receiver_type_args.is_empty() then {
                            let bindings = self.resolve_static_call_type_bindings(
                                effective_type_name,
                                receiver_type_args,
                                sig,
                                typed_args,
                                resolved_method_type_args,
                                expected,
                            );
                            self.apply_type_bindings(declared_receiver_type, bindings)
                        } else {
                            declared_receiver_type
                        }
                    },
                    .None() then declared_receiver_type,
                };
                if receiver_type is not .Unknown() then {
                    self.maybe_record_extension_method_instantiation(
                        receiver_type,
                        method_name,
                        resolved_method_type_args,
                    );
                };
                let raw_static_ret_type = when static_sig_opt in {
                    .Some(sig) then self.resolve_static_method_return_type_for_call(
                        effective_type_name,
                        receiver_type_args,
                        sig,
                        typed_args,
                        resolved_method_type_args,
                        expected,
                    ),
                    .None() then self.resolve_static_method_return_type(
                        effective_type_name,
                        method_name,
                    ),
                };
                let raw_ret_type = when raw_static_ret_type in {
                    .Unknown() then self.resolve_method_return_type(
                        receiver_type,
                        method_name,
                    ),
                    _ then raw_static_ret_type,
                };
                // When a signature was resolved, `resolve_static_method_return_type_for_call`
                // already applied the receiver substitution exactly once (Swift's
                // lookup returns the final type). Applying `apply_static_method_type_bindings`
                // again inflates `T -> Pair[UInt, T]` maps. Only the raw
                // registered return type still needs it.
                let resolved_ret_type = when static_sig_opt in {
                    .Some(_) then raw_ret_type,
                    .None() then self.apply_static_method_type_bindings(
                        effective_type_name,
                        receiver_type_arg_refs,
                        raw_ret_type,
                    ),
                };
                let with_type_args = when resolved_ret_type in {
                    .Unknown() then if not receiver_type_arg_refs.is_empty() then when self.try_resolve_named_type_without_diag(
                        effective_type_name,
                    ) in {
                        .Some(t) then when t in {
                            .StructureType(def_id) then {
                                let template_def_id = self.context().get_template_def_id(
                                    def_id,
                                );
                                Type.GenericStruct(
                                    if template_def_id.is_valid() then template_def_id
                                    else def_id,
                                    receiver_type_arg_refs,
                                )
                            },
                            .EnumType(def_id) then {
                                let template_def_id = self.context().get_template_def_id(
                                    def_id,
                                );
                                Type.GenericEnum(
                                    if template_def_id.is_valid() then template_def_id
                                    else def_id,
                                    receiver_type_arg_refs,
                                )
                            },
                            _ then resolved_ret_type,
                        },
                        .None() then resolved_ret_type,
                    } else resolved_ret_type,
                    _ then resolved_ret_type,
                };
                let ret_type = when with_type_args in {
                    .Unknown() then when expected in {
                        .Some(et) then et,
                        .None() then with_type_args,
                    },
                    _ then with_type_args,
                };
                let method_symbol = when static_sig_opt in {
                    .Some(sig) then sig,
                    .None() then self.make_method_symbol_for_receiver(
                        declared_receiver_type,
                        method_name,
                        ret_type,
                    ),
                };
                return make_typed_expr(
                    TypedExprKind.StaticMethodCall(
                        receiver_type,
                        method_name,
                        method_symbol,
                        receiver_type_args,
                        resolved_method_type_args,
                        typed_args,
                    ),
                    ret_type,
                );
            },
        };
    };

    /// `(T).m(...)` -- the additive static-call case whose base is a
    /// parenthesized type with no identifier-based spelling. The lookup is
    /// keyed on the RESOLVED type (the string-keyed `StaticMethodCall` keeps
    /// its name-keyed path). A miss is the ordinary missing-member complaint,
    /// naming the type AS WRITTEN. A hit runs the ordinary call-shape and
    /// argument checks -- their messages are the call machinery's own -- but
    /// the call itself never lowers: the operand fails expression inference
    /// (the seed's failedExpression intent), so it silently poisons the
    /// enclosing declaration rather than producing a value.
    check_type_ref_static_method_call_ref(
        self,
        type_node: TypeNode,
        method_type_arg_nodes: List[TypeNode],
        method_name: String,
        args: List[Expr],
        call_span: SourceSpan,
        scope: Scope,
    ): TypedExpr = {
        let receiver_type = self.canonicalize_alias_type(
            self.resolve_type_in_scope(type_node, scope),
        );
        let mutable method_type_args = List[Type].new();
        for ta in method_type_arg_nodes then {
            method_type_args.push(self.resolve_type_in_scope(ta, scope));
        };
        let static_sig_opt = self.resolve_method_signature(receiver_type, method_name);
        if static_sig_opt is .None() then {
            // A cascade, not a second mistake: a receiver that failed to
            // resolve, or a complaint already raised at this call, has said
            // everything.
            if not self.is_unresolved_expr_type(receiver_type) and not self.storage.diagnostics.has_error_at(
                self.storage.file_path,
                call_span,
            ) then {
                let face_hint = self.method_face_hint(
                    self.extension_template_key(
                        self.normalize_method_receiver_type(receiver_type),
                    ),
                    method_name,
                );
                let message = "Member '\(method_name)' not found in type '\(type_node_spelling(type_node))'";
                self.push_diagnostic_at_span(
                    when face_hint in {
                        .Some(hint) then "\(message). \(hint)",
                        .None() then message,
                    },
                    call_span,
                );
            };
            return self.empty_typed_block(Type.Unknown());
        };
        when static_sig_opt in {
            .Some(sig) then {
                let param_specs = self.context().get_param_specs(sig.def_id) or else self.positional_param_specs_for_count(
                    self.method_param_count(sig),
                );
                // The full declaration list, `self` included: `(T).m()` is not
                // a method call with a receiver, so nothing is consumed off
                // the front.
                when self.plan_call_argument_exprs(args, param_specs, method_name) in {
                    .Some(planned_args) then {
                        let mutable arg_idx: UInt = 0;
                        for a in planned_args then {
                            let param_expected = when self.method_param_type(
                                sig,
                                arg_idx,
                            ) in {
                                .Some(pt) then Option[Type].Some(pt),
                                .None() then Option[Type].None(),
                            };
                            let typed_arg = self.check_expr_scoped_ref(
                                a,
                                param_expected,
                                scope,
                            );
                            let _ = self.adapt_expr_to_expected_type_at(
                                typed_arg,
                                param_expected,
                                Option[SourceSpan].Some(call_span),
                            );
                            arg_idx += 1;
                        };
                    },
                    .None() then {},
                };
            },
            .None() then {},
        };
        return self.empty_typed_block(Type.Unknown());
    };

    check_intrinsic_call_ref(
        self,
        callee: Expr,
        args: List[Expr],
        expected: Option[Type],
        scope: Scope,
    ): Option[TypedExpr] = {
        let mutable intrinsic_name = "";
        let mutable intrinsic_type_args = List[Type].new();

        when callee in {
            .Identifier(name, _) then {
                intrinsic_name = name;
            },
            .GenericInstantiation(base_name, type_args, _) then {
                intrinsic_name = base_name;
                for ta in type_args then {
                    intrinsic_type_args.push(self.resolve_type_in_scope(ta, scope));
                };
            },
            _ then {
                return Option[TypedExpr].None();
            },
        };

        if intrinsic_name.is_empty() then {
            return Option[TypedExpr].None();
        };

        if intrinsic_name == "downgrade" or intrinsic_name == "upgrade" then {
            if self.storage.generic_templates.lookup_function(intrinsic_name) is .None() then {
                return Option[TypedExpr].None();
            };
        };

        if intrinsic_name == "alloc_memory" then {
            return self.check_alloc_memory_intrinsic(intrinsic_type_args, args, scope);
        };

        if intrinsic_name == "downgrade" then {
            if args.count() != 1 then {
                return Option[TypedExpr].None();
            };
            let arg_expr = (args[UInt(0)]);
            let inner = self.check_expr_scoped_ref(arg_expr, .None(), scope);
            if not self.enforce_mutable_constraint_for_call(
                inner.expr_type,
                "downgrade",
                expr_span(arg_expr),
            ) then {
                return Option[TypedExpr].Some(
                    make_typed_expr(
                        TypedExprKind.IntrinsicCall(
                            TypedIntrinsic.DowngradeRef(inner, Type.Unknown()),
                        ),
                        Type.Unknown(),
                    ),
                );
            };
            let weak_type = Type.WeakReferenceType(inner.expr_type);
            let result = Option[TypedExpr].Some(
                make_typed_expr(
                    TypedExprKind.IntrinsicCall(
                        TypedIntrinsic.DowngradeRef(inner, weak_type),
                    ),
                    weak_type,
                ),
            );
            return result;
        };

        if intrinsic_name == "upgrade" then {
            if args.count() != 1 then {
                return Option[TypedExpr].None();
            };
            let arg_expr = (args[UInt(0)]);
            let inner = self.check_expr_scoped_ref(arg_expr, .None(), scope);
            let result = when inner.expr_type in {
                .WeakReferenceType(inner_ref) then {
                    let mutable opt_args = List[Type].new();
                    opt_args.push(inner_ref);
                    // Std's `Option` is a LANG ITEM, reached by declaration.
                    let mutable result_type = Type.GenericEnum(
                        self.context().std_type_def_id("Option") or else def_id_invalid(),
                        opt_args,
                    );
                    Option[TypedExpr].Some(
                        make_typed_expr(
                            TypedExprKind.IntrinsicCall(
                                TypedIntrinsic.UpgradeRef(inner, result_type),
                            ),
                            result_type,
                        ),
                    )
                },
                _ then {
                    self.push_expr_diagnostic(
                        arg_expr,
                        "'upgrade' expects a weak reference (?T), got \(self.display_type_name(inner.expr_type))",
                    );
                    Option[TypedExpr].Some(
                        make_typed_expr(
                            TypedExprKind.IntrinsicCall(
                                TypedIntrinsic.UpgradeRef(inner, Type.Unknown()),
                            ),
                            Type.Unknown(),
                        ),
                    )
                },
            };
            return result;
        };

        if intrinsic_name == "spawn_thread" then {
            return self.check_spawn_thread_intrinsic(args, scope);
        };

        if intrinsic_name == "take_memory" then {
            return self.check_take_memory_intrinsic(intrinsic_type_args, args, scope);
        };

        if intrinsic_name == "dealloc_memory" then {
            if args.count() != 1 then {
                return Option[TypedExpr].None();
            };
            let pointer_arg = args[UInt(0)];
            let pointer_expr = self.check_expr_scoped_ref(pointer_arg, .None(), scope);
            return Option[TypedExpr].Some(
                make_typed_expr(
                    TypedExprKind.IntrinsicCall(
                        TypedIntrinsic.DeallocMemory(pointer_expr),
                    ),
                    Type.VoidType(),
                ),
            );
        };

        if intrinsic_name == "init_memory" then {
            return self.check_init_memory_intrinsic(args, scope);
        };

        if intrinsic_name == "deinit_memory" then {
            if args.count() != 1 then {
                return Option[TypedExpr].None();
            };
            let pointer_arg = args[UInt(0)];
            let pointer_expr = self.check_expr_scoped_ref(pointer_arg, .None(), scope);
            return Option[TypedExpr].Some(
                make_typed_expr(
                    TypedExprKind.IntrinsicCall(
                        TypedIntrinsic.DeinitMemory(pointer_expr),
                    ),
                    Type.VoidType(),
                ),
            );
        };

        if intrinsic_name == "copy_memory" or intrinsic_name == "move_memory" then {
            return self.check_copy_or_move_memory_intrinsic(intrinsic_name, args, scope);
        };

        return Option[TypedExpr].None();
    };

    method_requires_mut_ref(self, self_type: Type, method_name: String): Bool = {
        let method_opt = self.resolve_method_signature(self_type, method_name);
        return when method_opt in {
            .Some(method) then when method.symbol_type in {
                .FunctionType(params, _) then {
                    if params.count() > UInt(0) then {
                        when (params[UInt(0)]).param_type in {
                            .MutableReferenceType(_) then true,
                            .MutableBorrowedReferenceType(_) then true,
                            _ then false,
                        }
                    } else {
                        false
                    }
                },
                _ then false,
            },
            .None() then false,
        };
    };

    /// The enum type a constructor should build when the receiver was written
    /// as a bare template name.
    ///
    /// `Res.Ok(1)` resolves `Res` to its TEMPLATE form, which carries no type
    /// arguments. When the context supplies an instance of that same template
    /// (`Res[Int]`), that instance is what gets constructed. This is the same
    /// rule the `Res[Int].Ok(1)` spelling and `check_static_method_call_ref`
    /// already follow -- only the bare spelling was missing it, so it handed
    /// back `Res` where `Res[Int]` was wanted.
    ///
    /// Identity is the template's DECLARATION, via `named_enum_template_def_id`.
    /// An invalid id makes the comparison below silently fail and the bare form
    /// win, which is exactly the defect this closes.
    enum_constructor_type_from_expected(
        self,
        resolved: Type,
        expected: Option[Type],
        base_name: String,
    ): Type = {
        let canonical = self.canonicalize_alias_type(resolved);
        return when canonical in {
            .EnumType(def_id) then {
                let template_def_id = self.named_enum_template_def_id(base_name, def_id);
                when expected in {
                    .Some(et) then when et in {
                        // Identity: compare declarations, never spellings.
                        .GenericEnum(expected_def_id, _) then {
                            if expected_def_id == template_def_id then et else canonical
                        },
                        .EnumType(expected_def_id) then {
                            if expected_def_id.id == template_def_id.id then et
                            else canonical
                        },
                        _ then canonical,
                    },
                    .None() then canonical,
                }
            },
            _ then canonical,
        };
    };

    is_unsigned_integer_type(self, t: Type): Bool = {
        return when t in {
            .UIntType() then true,
            .UInt8Type() then true,
            .UInt16Type() then true,
            .UInt32Type() then true,
            .UInt64Type() then true,
            .WrappingUIntType() then true,
            .WrappingUInt8Type() then true,
            .WrappingUInt16Type() then true,
            .WrappingUInt32Type() then true,
            .WrappingUInt64Type() then true,
            _ then false,
        };
    };

    // MARK: - Integer literal range checking

    parse_integer_literal_text(self, text: String): Pair[Bool, Pair[UInt64, Bool]] = {
        let _ = text;
        return Pair[Bool, Pair[UInt64, Bool]](false, Pair[UInt64, Bool](0, true));
    };

    check_integer_literal_range(
        self,
        value: String,
        target_type: Type,
        span: SourceSpan,
    ): Bool = {
        // A construction blames its CALL for an argument's range violation
        // (the reference compiler coerces after checking and names the
        // construct it is inside); every other path names the literal.
        let blame = when self.storage.range_blame_span in {
            .Some(blame_span) then blame_span,
            .None() then span,
        };
        // Several paths ask about the same literal (the literal itself, then
        // the declaration that gives it a type). One diagnostic per span: the
        // seed reports it once and the two must agree verbatim.
        if self.storage.diagnostics.has_error_at(self.storage.file_path, blame) then {
            return true;
        };
        let i64max = UInt64(9223372036854775807);
        let u64max = i64max * UInt64(2) + UInt64(1);
        let bounds = when target_type in {
            .IntType() or .WrappingIntType() then Pair[UInt64, UInt64](
                i64max + UInt64(1),
                i64max,
            ),
            .Int64Type() or .WrappingInt64Type() then Pair[UInt64, UInt64](
                i64max + UInt64(1),
                i64max,
            ),
            .Int8Type() or .WrappingInt8Type() then Pair[UInt64, UInt64](
                UInt64(128),
                UInt64(127),
            ),
            .Int16Type() or .WrappingInt16Type() then Pair[UInt64, UInt64](
                UInt64(32768),
                UInt64(32767),
            ),
            .Int32Type() or .WrappingInt32Type() then Pair[UInt64, UInt64](
                UInt64(2147483648),
                UInt64(2147483647),
            ),
            .UIntType() or .WrappingUIntType() then Pair[UInt64, UInt64](
                UInt64(0),
                u64max,
            ),
            .UInt64Type() or .WrappingUInt64Type() then Pair[UInt64, UInt64](
                UInt64(0),
                u64max,
            ),
            .UInt8Type() or .WrappingUInt8Type() then Pair[UInt64, UInt64](
                UInt64(0),
                UInt64(255),
            ),
            .UInt16Type() or .WrappingUInt16Type() then Pair[UInt64, UInt64](
                UInt64(0),
                UInt64(65535),
            ),
            .UInt32Type() or .WrappingUInt32Type() then Pair[UInt64, UInt64](
                UInt64(0),
                UInt64(4294967295),
            ),
            _ then Pair[UInt64, UInt64](UInt64(0), UInt64(0)),
        };
        if bounds.first == UInt64(0) and bounds.second == UInt64(0) and not self.is_integer_type(
            target_type,
        ) then {
            return true;
        };
        let s = value.replace_all("_", with = "");
        let mutable is_negative = false;
        let mutable rest = s;
        if s.starts_with("-") then {
            is_negative = true;
            rest = s.substring(1...);
        };
        let mutable radix: UInt64 = 10;
        let mutable digits = rest;
        if rest.starts_with("0x") or rest.starts_with("0X") then {
            radix = 16;
            digits = rest.substring(2...);
        } else if rest.starts_with("0b") or rest.starts_with("0B") then {
            radix = 2;
            digits = rest.substring(2...);
        } else if rest.starts_with("0o") or rest.starts_with("0O") then {
            radix = 8;
            digits = rest.substring(2...);
        };
        let mutable magnitude: UInt64 = UInt64(0);
        let mutable overflow = digits.is_empty();
        for ch in digits.to_runes() then {
            let mutable digit: UInt64 = UInt64(0);
            let mutable valid = true;
            if ch >= '0' and ch <= '9' then {
                digit = UInt64(ch.to_uint32() - '0'.to_uint32());
            } else if ch >= 'a' and ch <= 'f' then {
                digit = UInt64(ch.to_uint32() - 'a'.to_uint32() + 10);
            } else if ch >= 'A' and ch <= 'F' then {
                digit = UInt64(ch.to_uint32() - 'A'.to_uint32() + 10);
            } else {
                valid = false;
            };
            if not valid or digit >= radix then {
                overflow = true;
            } else {
                if magnitude > (u64max - digit) / radix then {
                    overflow = true;
                } else {
                    magnitude = magnitude * radix + digit;
                };
            };
        };
        let fits = if overflow then false
        else if is_negative then magnitude <= bounds.first
        else magnitude <= bounds.second;
        if not fits then {
            let sign = if is_negative then "-" else "";
            let display = if overflow then s else sign + magnitude.to_string();
            self.push_diagnostic_at_span(
                "Integer literal \(display) is out of range for \(type_to_string(plain_width_counterpart(target_type)))",
                blame,
            );
            return false;
        };
        return true;
    };

    // ── `as` casts ───────────────────────────────────────────────────────────
    //
    // `e as T` -- a new type view on the same value. The RESOLVED target type
    // (aliases expanded) decides which cast this is: weak construction (`?U`),
    // an explicit trait-object upcast (trait name), or pointer reinterpretation
    // (`*U`, and `Int`/`UInt` in both directions). Numeric conversion and
    // nominal construction are `Type(expr)` and are refused here with a
    // pointer at that spelling. All three CastExpr sites route through
    // `lower_as_cast_target` so the rows cannot drift again.

    /// One managed-reference layer is a VALUE here: `&x as *T` reinterprets
    /// the pointee, the same auto-dereference the implicit coercions do.
    as_cast_auto_deref(self, expr: TypedExpr): TypedExpr = {
        return when expr.expr_type in {
            .ReferenceType(inner) then make_typed_expr(
                TypedExprKind.DerefExpr(expr),
                inner,
            ),
            .MutableReferenceType(inner) then make_typed_expr(
                TypedExprKind.DerefExpr(expr),
                inner,
            ),
            .BorrowedReferenceType(inner) then make_typed_expr(
                TypedExprKind.DerefExpr(expr),
                inner,
            ),
            .MutableBorrowedReferenceType(inner) then make_typed_expr(
                TypedExprKind.DerefExpr(expr),
                inner,
            ),
            _ then expr,
        };
    };

    /// Strips managed-reference wrappers to find the value underneath.
    as_cast_peel_ref_wrappers(self, t: Type): Type = {
        return when t in {
            .ReferenceType(inner) then self.as_cast_peel_ref_wrappers(inner),
            .MutableReferenceType(inner) then self.as_cast_peel_ref_wrappers(inner),
            .BorrowedReferenceType(inner) then self.as_cast_peel_ref_wrappers(inner),
            .MutableBorrowedReferenceType(inner) then self.as_cast_peel_ref_wrappers(
                inner,
            ),
            _ then t,
        };
    };

    /// The `as` trait-object row: a resolved trait-object reference target.
    as_cast_trait_object_target(self, t: Type): Option[Type] = {
        return when t in {
            .TraitObject(_, _) then Option[Type].Some(t),
            .ReferenceType(inner) then when inner in {
                .TraitObject(_, _) then Option[Type].Some(inner),
                _ then Option[Type].None(),
            },
            .MutableReferenceType(inner) then when inner in {
                .TraitObject(_, _) then Option[Type].Some(inner),
                _ then Option[Type].None(),
            },
            _ then Option[Type].None(),
        };
    };

    /// Whether `type` is one of the reinterpretation families -- pointer, weak,
    /// or trait-object -- that `as` casts to and `Type(expr)` must refuse.
    is_pointer_weak_or_trait_cast_target(self, t: Type): Bool = {
        let canonical = self.canonicalize_alias_type(t);
        return when canonical in {
            .PointerType(_) then true,
            .MutablePointerType(_) then true,
            .WeakReferenceType(_) then true,
            .MutableWeakReferenceType(_) then true,
            .TraitObject(...) then true,
            .ReferenceType(inner) then when inner in {
                .TraitObject(...) then true,
                _ then false,
            },
            .MutableReferenceType(inner) then when inner in {
                .TraitObject(...) then true,
                _ then false,
            },
            _ then false,
        };
    };

    /// Whether `from` is a raw pointer type (`*U` / `*mutable U`), any pointee.
    as_cast_source_is_pointer(self, from: Type): Bool = {
        let source = self.canonicalize_alias_type(from);
        return when source in {
            .PointerType(_) then true,
            .MutablePointerType(_) then true,
            _ then false,
        };
    };

    /// Legality for the `expr as Type` reinterpretation rows: any pointer
    /// flavor to any pointer flavor (element-type-agnostic), `Int`/`UInt` to
    /// pointers and back, and identity. Numeric conversion and nominal
    /// construction stay on `Type(expr)`.
    is_valid_as_cast(self, from: Type, to: Type): Bool = {
        let source = self.canonicalize_alias_type(from);
        let target = self.canonicalize_alias_type(to);
        if self.same_expr_type(source, target) then {
            return true;
        };
        let source_is_pointer = self.as_cast_source_is_pointer(source);
        let target_is_pointer = target is .PointerType(_) or is .MutablePointerType(_);
        let target_is_address = target is .IntType() or is .UIntType();
        if target_is_pointer then {
            if source_is_pointer then {
                return true;
            };
            if source is .IntType() or is .UIntType() then {
                return true;
            };
            return false;
        };
        if target_is_address then {
            return source_is_pointer;
        };
        return false;
    };

    /// `e as ?U` -- weak-reference construction: a handle wrap, not a bit
    /// reinterpretation. The same checks and the same `downgrade` intrinsic
    /// the `?U(expr)` spelling used.
    lower_as_weak_construction(
        self,
        target: Type,
        typed_inner: TypedExpr,
        cast_span: SourceSpan,
        inner_span: SourceSpan,
    ): TypedExpr = {
        let mutable result_type = target;
        if typed_inner.expr_type is .Unknown() then {
            // The inner already reported; Swift stops there. Neutralise the
            // cascade rather than complain about a value that failed.
            result_type = Type.Unknown();
        } else {
            if not self.enforce_mutable_constraint_for_call(
                typed_inner.expr_type,
                "downgrade",
                inner_span,
            ) then {
                result_type = Type.Unknown();
            };
            // The referent is `U`, so the argument has to be a `U`. Mutability
            // alone would let `a as ?B` build a `?B` out of an `A` -- two
            // unrelated mutable types.
            if result_type is not .Unknown() then {
                let weak_referent = when target in {
                    .WeakReferenceType(r) then r,
                    .MutableWeakReferenceType(r) then r,
                    _ then Type.Unknown(),
                };
                if not self.same_expr_type(typed_inner.expr_type, weak_referent) then {
                    self.push_diagnostic_at_span(
                        "Type mismatch: expected \(self.display_type_name(weak_referent)), got \(self.display_type_name(typed_inner.expr_type))",
                        cast_span,
                    );
                    result_type = Type.Unknown();
                };
            };
        };
        return make_typed_expr(
            TypedExprKind.IntrinsicCall(
                TypedIntrinsic.DowngradeRef(typed_inner, result_type),
            ),
            result_type,
        );
    };

    /// The trait-object upcast: the shared body of the call form
    /// (`Drawable(c)`). The conversion machinery carries the object-safety and
    /// conformance checks; the silent declines it leaves behind (trait object
    /// to trait object, rvalue to mutable reference) are errors here. The `as`
    /// spelling of this row is an error now; this helper's caller is the call
    /// form.
    lower_trait_object_upcast(
        self,
        target: Type,
        trait_obj: Type,
        typed_inner: TypedExpr,
        cast_span: SourceSpan,
    ): TypedExpr = {
        let source_type = typed_inner.expr_type;
        if source_type is .Unknown() then {
            return make_typed_expr(
                TypedExprKind.CastExpr(Type.Unknown(), typed_inner),
                Type.Unknown(),
            );
        };
        // Identity: the source already IS that trait object.
        if self.same_expr_type(source_type, target) then {
            return make_typed_expr_ref(typed_inner.expr_kind, target);
        };
        if self.as_cast_peel_ref_wrappers(source_type) is .TraitObject(...) then {
            self.push_diagnostic_at_span(
                "Cannot cast a trait object to another trait object",
                cast_span,
            );
            return make_typed_expr(
                TypedExprKind.CastExpr(Type.Unknown(), typed_inner),
                Type.Unknown(),
            );
        };
        let converted = self.try_as_trait_object_conversion(
            typed_inner,
            trait_obj,
            target,
            cast_span,
        );
        if not self.same_expr_type(converted.expr_type, target) then {
            self.push_diagnostic_at_span(
                "Invalid operation cast between types \(self.display_type_name(source_type)) and \(self.display_type_name(target))",
                cast_span,
            );
            return make_typed_expr(
                TypedExprKind.CastExpr(Type.Unknown(), typed_inner),
                Type.Unknown(),
            );
        };
        return converted;
    };

    /// The call form of a trait-object upcast: `Drawable(c)` /
    /// `(Drawable)(c)` / `Transform[Int](c)`. Exactly one positional
    /// argument; the upcast itself is `lower_trait_object_upcast`. The trait
    /// object is taken from the RESOLVED target, so a generic trait keeps its
    /// type arguments for the conformance check.
    lower_type_application_upcast_call(
        self,
        target: Type,
        call_args: List[Expr],
        span: SourceSpan,
        scope: Scope,
    ): TypedExpr = {
        let trait_obj = when self.as_cast_trait_object_target(target) in {
            .Some(trait_object_type) then trait_object_type,
            .None() then target,
        };
        if call_args.count() != 1 then {
            self.push_diagnostic_at_span(
                "A cast takes exactly one positional argument: write 'Type(expr)'",
                span,
            );
            return make_typed_expr(
                TypedExprKind.CastExpr(target, self.empty_typed_block(Type.Unknown())),
                target,
            );
        };
        let arg = call_args[UInt(0)];
        when arg in {
            .NamedArgument(_, _, _) then {
                self.push_diagnostic_at_span(
                    "A cast takes exactly one positional argument: write 'Type(expr)'",
                    span,
                );
                return make_typed_expr(
                    TypedExprKind.CastExpr(
                        target,
                        self.empty_typed_block(Type.Unknown()),
                    ),
                    target,
                );
            },
            _ then {},
        };
        // The argument is checked in synthesis mode: the upcast target is not
        // an expectation the argument joins.
        let typed_inner = self.check_expr_scoped_ref(arg, .None(), scope);
        return self.lower_trait_object_upcast(target, trait_obj, typed_inner, span);
    };

    /// The trait-object conversion the implicit coercions run, with its silent
    /// declines returned as an unchanged expression so the `as` row can raise
    /// on them. Conformance problems keep the conversion machinery's own
    /// messages.
    try_as_trait_object_conversion(
        self,
        typed_inner: TypedExpr,
        trait_obj: Type,
        target: Type,
        cast_span: SourceSpan,
    ): TypedExpr = {
        let trait_def_id = when trait_obj in {
            .TraitObject(d, _) then d,
            _ then DefId(UInt(0)),
        };
        let trait_name = def_id_spelling(trait_def_id);
        let trait_args = self.trait_object_type_args(trait_obj);
        let source_type = typed_inner.expr_type;
        let expects_mutable_ref = target is .MutableReferenceType(_);
        let mutable concrete_type = source_type;
        let mutable source_for_conversion = typed_inner;
        when source_type in {
            .ReferenceType(inner) then {
                if expects_mutable_ref then {
                    // An immutable reference is not widened in place.
                    return typed_inner;
                };
                concrete_type = inner;
            },
            .MutableReferenceType(inner) then {
                concrete_type = inner;
            },
            _ then {
                if expects_mutable_ref then {
                    let source_is_lvalue = when typed_expr_value_category(typed_inner) in {
                        .LValue() then true,
                        .RValue() then false,
                    };
                    if source_is_lvalue and self.can_take_mutable_ref_of_expr(
                        typed_inner,
                    ) then {
                        source_for_conversion = make_typed_expr(
                            TypedExprKind.RefExpr(typed_inner),
                            Type.MutableReferenceType(source_type),
                        );
                    } else {
                        return typed_inner;
                    };
                } else {
                    source_for_conversion = make_typed_expr(
                        TypedExprKind.RefExpr(typed_inner),
                        Type.ReferenceType(source_type),
                    );
                };
            },
        };
        if trait_args.is_empty() then {
            let _ = self.enforce_explicit_trait_requirement(
                concrete_type,
                trait_def_id,
                trait_name,
                cast_span,
            );
        } else {
            let _ = self.enforce_explicit_generic_trait_conformance_with_note(
                concrete_type,
                trait_def_id,
                trait_name,
                trait_args,
                "",
                cast_span,
            );
        };
        return self.wrap_trait_object_conversion(source_for_conversion, trait_obj, target);
    };

    /// The inner expression of an `as` cast, checked in synthesis mode: the
    /// cast target is not an expectation the inner joins. The three CastExpr
    /// sites keep their own checker via `use_bidi`.
    as_cast_check_inner(
        self,
        inner: Expr,
        expected: Option[Type],
        scope: Scope,
        use_bidi: Bool,
    ): TypedExpr = {
        if use_bidi then {
            return self.bidirectional_check(inner, expected, scope);
        };
        return self.check_expr_scoped_ref(inner, expected, scope);
    };

    /// `e as T` -- one shared lowering for all three CastExpr sites. The inner
    /// keeps its own checking flavor; the rows, the messages and the typed
    /// output shapes are shared.
    lower_as_cast_target(
        self,
        target: Type,
        inner: Expr,
        cast_span: SourceSpan,
        scope: Scope,
        use_bidi: Bool,
    ): TypedExpr = {
        let resolved_target = self.canonicalize_alias_type(target);

        // A `null` source is a pointer literal aimed at the cast target. It
        // joins a pointer target directly, takes the pointer→integer
        // reinterpretation row (reading as 0) for `Int`/`UInt`, and meets the
        // weak path's referent check for `?U` -- which reports the REFERENT,
        // spelled `null` on the got-side. Every other target refuses the cast
        // the way the rows below do for a `*void` source.
        when inner in {
            .NullLiteral(literal_span) then {
                when resolved_target in {
                    .Unknown() then {
                        // The target already reported; a literal that could
                        // not be aimed is a consequence, not a second mistake.
                        return self.empty_typed_block(Type.Unknown());
                    },
                    .PointerType(_) then {
                        return make_typed_expr(
                            TypedExprKind.IntrinsicCall(
                                TypedIntrinsic.NullPtr(resolved_target),
                            ),
                            resolved_target,
                        );
                    },
                    .MutablePointerType(_) then {
                        return make_typed_expr(
                            TypedExprKind.IntrinsicCall(
                                TypedIntrinsic.NullPtr(resolved_target),
                            ),
                            resolved_target,
                        );
                    },
                    .WeakReferenceType(referent) or .MutableWeakReferenceType(referent) then {
                        self.push_diagnostic_at_span(
                            "Type mismatch: expected \(self.display_type_name(referent)), got null",
                            literal_span,
                        );
                        return self.empty_typed_block(Type.Unknown());
                    },
                    .IntType() or .UIntType() then {
                        let null_source = make_typed_expr(
                            TypedExprKind.IntrinsicCall(
                                TypedIntrinsic.NullPtr(
                                    Type.PointerType(Type.VoidType()),
                                ),
                            ),
                            Type.PointerType(Type.VoidType()),
                        );
                        return make_typed_expr(
                            TypedExprKind.CastExpr(resolved_target, null_source),
                            resolved_target,
                        );
                    },
                    _ then {
                        if self.as_cast_trait_object_target(resolved_target) is .Some(_) then {
                            self.push_diagnostic_at_span(
                                "Construction is written 'Type(args)', not 'expr as Type'",
                                cast_span,
                            );
                            return self.empty_typed_block(Type.Unknown());
                        };
                        if self.is_integer_type(resolved_target) or self.is_float_type(
                            resolved_target,
                        ) then {
                            self.push_diagnostic_at_span(
                                "Invalid operation cast between types \(self.display_type_name(Type.PointerType(Type.VoidType()))) and \(self.display_type_name(resolved_target))",
                                cast_span,
                            );
                            return self.empty_typed_block(Type.Unknown());
                        };
                        if self.is_nominal_type(resolved_target) and not self.is_string_type(
                            resolved_target,
                        ) then {
                            self.push_diagnostic_at_span(
                                "Construction is written 'Type(args)', not 'expr as Type'",
                                cast_span,
                            );
                            return self.empty_typed_block(Type.Unknown());
                        };
                        self.push_diagnostic_at_span(
                            "'as' casts to pointer or weak types",
                            cast_span,
                        );
                        return self.empty_typed_block(Type.Unknown());
                    },
                }
            },
            _ then {},
        };

        // A target that failed to resolve already reported (Swift throws at
        // resolution). Keep the caller's shape and stop the cascade.
        if resolved_target is .Unknown() then {
            let typed_inner = self.as_cast_check_inner(inner, .None(), scope, use_bidi);
            return make_typed_expr(
                TypedExprKind.CastExpr(resolved_target, typed_inner),
                resolved_target,
            );
        };

        // Weak construction (`?U`): a handle wrap, not a bit reinterpretation.
        let target_is_weak = resolved_target is .WeakReferenceType(_) or is .MutableWeakReferenceType(_);
        if target_is_weak then {
            let typed_inner = self.as_cast_auto_deref(
                self.as_cast_check_inner(inner, .None(), scope, use_bidi),
            );
            return self.lower_as_weak_construction(
                resolved_target,
                typed_inner,
                cast_span,
                expr_span(inner),
            );
        };

        // Trait-object upcast moved to the call form (`Trait(c)`); the `as`
        // spelling of a trait target is a construction hint now, the same
        // complaint a nominal target gets.
        when self.as_cast_trait_object_target(resolved_target) in {
            .Some(_) then {
                self.push_diagnostic_at_span(
                    "Construction is written 'Type(args)', not 'expr as Type'",
                    cast_span,
                );
                return self.empty_typed_block(Type.Unknown());
            },
            .None() then {},
        };

        // Pointer reinterpretation: any pointer flavor/pointee in either
        // direction, or `Int`/`UInt` as an address.
        let target_is_pointer = resolved_target is .PointerType(_) or is .MutablePointerType(_);
        if target_is_pointer then {
            let typed_inner = self.as_cast_auto_deref(
                self.as_cast_check_inner(inner, .None(), scope, use_bidi),
            );
            let source_type = typed_inner.expr_type;
            if source_type is .Unknown() then {
                return make_typed_expr(
                    TypedExprKind.CastExpr(Type.Unknown(), typed_inner),
                    Type.Unknown(),
                );
            };
            if self.is_valid_as_cast(source_type, resolved_target) then {
                // Cast always produces an rvalue.
                return make_typed_expr(
                    TypedExprKind.CastExpr(resolved_target, typed_inner),
                    resolved_target,
                );
            };
            self.push_diagnostic_at_span(
                "Invalid operation cast between types \(self.display_type_name(source_type)) and \(self.display_type_name(resolved_target))",
                cast_span,
            );
            return make_typed_expr(
                TypedExprKind.CastExpr(Type.Unknown(), typed_inner),
                Type.Unknown(),
            );
        };

        // `Int`/`UInt` (and the other numeric spellings): pointer bits read as
        // an integer for `Int`/`UInt`, a pointer at `Type(expr)` for anything
        // numeric, and no numeric conversion through `as` at all.
        let target_is_numeric = self.is_integer_type(resolved_target) or self.is_float_type(
            resolved_target,
        );
        if target_is_numeric then {
            let typed_inner = self.as_cast_auto_deref(
                self.as_cast_check_inner(inner, .None(), scope, use_bidi),
            );
            let source_type = typed_inner.expr_type;
            if source_type is .Unknown() then {
                return make_typed_expr(
                    TypedExprKind.CastExpr(Type.Unknown(), typed_inner),
                    Type.Unknown(),
                );
            };
            if self.as_cast_source_is_pointer(source_type) then {
                if resolved_target is .IntType() or is .UIntType() then {
                    return make_typed_expr(
                        TypedExprKind.CastExpr(resolved_target, typed_inner),
                        resolved_target,
                    );
                };
            } else {
                let source_is_numeric = self.is_integer_type(source_type) or self.is_float_type(
                    source_type,
                );
                if source_is_numeric then {
                    self.push_diagnostic_at_span(
                        "Numeric conversion is written 'Type(expr)', not 'expr as Type'",
                        cast_span,
                    );
                    return make_typed_expr(
                        TypedExprKind.CastExpr(Type.Unknown(), typed_inner),
                        Type.Unknown(),
                    );
                };
            };
            self.push_diagnostic_at_span(
                "Invalid operation cast between types \(self.display_type_name(source_type)) and \(self.display_type_name(resolved_target))",
                cast_span,
            );
            return make_typed_expr(
                TypedExprKind.CastExpr(Type.Unknown(), typed_inner),
                Type.Unknown(),
            );
        };

        // Nominals are built, not cast. Std's String is nominal in the type
        // system but reads as a builtin (literal syntax), so it takes the
        // wrong-target message rather than a construction hint.
        let target_is_nominal = self.is_nominal_type(resolved_target) and not self.is_string_type(
            resolved_target,
        );
        if target_is_nominal then {
            self.push_diagnostic_at_span(
                "Construction is written 'Type(args)', not 'expr as Type'",
                cast_span,
            );
            return self.empty_typed_block(Type.Unknown());
        };
        self.push_diagnostic_at_span("'as' casts to pointer or weak types", cast_span);
        return self.empty_typed_block(Type.Unknown());
    };

    /// Legality for the `Type(expr)` cast path: identity and numeric
    /// conversion. Pointer reinterpretation and weak/trait construction are
    /// `expr as Type` now (see `is_valid_as_cast`); nominal values are built by
    /// the construction path.
    is_valid_explicit_cast(self, from: Type, to: Type): Bool = {
        if self.same_expr_type(from, to) then {
            return true;
        };
        let from_numeric = self.is_integer_type(from) or self.is_float_type(from);
        let to_numeric = self.is_integer_type(to) or self.is_float_type(to);
        if from_numeric and to_numeric then {
            return true;
        };
        return false;
    };

    /// `Type(expr)` -- the explicit cast form of a type application. The parser
    /// leaves `Type(...)` as a call; the type checker routes builtin scalar
    /// targets here and structural targets to the constructor path.
    infer_type_application_cast(
        self,
        target_type: Type,
        call_args: List[Expr],
        span: SourceSpan,
        scope: Scope,
    ): TypedExpr = {
        if call_args.count() != 1 then {
            self.push_diagnostic_at_span(
                "A cast takes exactly one positional argument: write 'Type(expr)'",
                span,
            );
            return make_typed_expr(
                TypedExprKind.CastExpr(
                    target_type,
                    self.empty_typed_block(Type.Unknown()),
                ),
                target_type,
            );
        };
        let arg = call_args[UInt(0)];
        when arg in {
            .NamedArgument(_, _, arg_span) then {
                self.push_diagnostic_at_span(
                    "A cast takes exactly one positional argument: write 'Type(expr)'",
                    arg_span,
                );
                return make_typed_expr(
                    TypedExprKind.CastExpr(
                        target_type,
                        self.empty_typed_block(Type.Unknown()),
                    ),
                    target_type,
                );
            },
            _ then {},
        };
        // Literal optimization: fold integer/float literals to the target type.
        let raw_typed_inner = when arg in {
            .IntegerLiteral(value, lit_span) then {
                let _ = self.check_integer_literal_range(value, target_type, lit_span);
                make_typed_expr(TypedExprKind.IntegerLiteral(value), target_type)
            },
            .FloatLiteral(value, _) then make_typed_expr(
                TypedExprKind.FloatLiteral(value),
                target_type,
            ),
            .RuneLiteral(value, rune_span) then {
                let outer_span = self.enter_current_span(rune_span);
                let lowered = self.lower_rune_literal_for_cast(value, target_type);
                self.leave_current_span(outer_span);
                lowered
            },
            _ then self.check_expr_scoped_ref(arg, .Some(target_type), scope),
        };
        // A managed-reference source is its pointee here, the same
        // auto-dereference the `as` rows do. The rows see the dereferenced
        // type -- `UInt(r)` with `r &Int` is a numeric conversion, and a
        // POINTER source is reinterpretation, not numeric conversion:
        // `UInt(p)` is the retired spelling for `p as UInt`.
        let source_view = self.as_cast_peel_ref_wrappers(raw_typed_inner.expr_type);
        if self.as_cast_source_is_pointer(source_view) then {
            self.push_diagnostic_at_span(
                "Pointer and integer casts are written 'expr as Type', not 'Type(expr)'",
                span,
            );
            return make_typed_expr(
                TypedExprKind.CastExpr(target_type, raw_typed_inner),
                target_type,
            );
        };
        if not self.is_valid_explicit_cast(source_view, target_type) then {
            self.push_diagnostic_at_span(
                "Invalid operation cast between types \(self.display_type_name(source_view)) and \(self.display_type_name(target_type))",
                span,
            );
        };
        let adapted_inner = self.adapt_expr_to_expected_type_at(
            raw_typed_inner,
            .Some(target_type),
            Option[SourceSpan].Some(expr_span(arg)),
        );
        // Same rule as the named-argument form: re-type to the pointee only
        // when the target is not itself reference-like.
        let typed_inner = when adapted_inner.expr_type in {
            .ReferenceType(inner_ref) or .MutableReferenceType(inner_ref) or .WeakReferenceType(inner_ref) or .MutableWeakReferenceType(inner_ref) where not self.is_ref_or_pointer_type(
                target_type,
            ) then self.adapt_expr_to_expected_type_at(
                adapted_inner,
                .Some(inner_ref),
                Option[SourceSpan].Some(expr_span(arg)),
            ),
            _ then adapted_inner,
        };
        make_typed_expr(TypedExprKind.CastExpr(target_type, typed_inner), target_type)
    };

    check_call_expr_ref(
        self,
        callee: Expr,
        args: List[Expr],
        expected: Option[Type],
        scope: Scope,
    ): TypedExpr = {
        let mutable call_args = List[Expr].new();
        for arg in args then {
            call_args.push(arg);
        };

        let mutable is_memory_intrinsic = false;
        when callee in {
            .Identifier(name, _) then {
                if name == "copy_memory" or name == "move_memory" then {
                    is_memory_intrinsic = true;
                };
            },
            .GenericInstantiation(base_name, _, _) then {
                if base_name == "copy_memory" or base_name == "move_memory" then {
                    is_memory_intrinsic = true;
                };
            },
            _ then {},
        };
        if is_memory_intrinsic then {
            when self.check_intrinsic_call_ref(callee, args, expected, scope) in {
                .Some(intrinsic_expr) then {
                    return intrinsic_expr;
                },
                .None() then {},
            };
        };

        let constructor_type_probe = self.resolved_constructor_type_or_unknown(
            callee,
            scope,
        );
        // `Type(expr)` on a builtin scalar is the explicit cast form. Cast and
        // construction share `Type(...)`; the type's kind decides which it is.
        // The call family is keyed on the RESOLVED target (alias-expanded) and
        // covers the bare identifier, the alias-resolved identifier, the
        // generic instantiation `Transform[Int](c)`, and the paren form
        // `(T)(args)`. A trait target is the trait-object upcast; a pointer or
        // weak target is the retired cast spelling.
        when callee in {
            .Identifier(name, name_span) then {
                when self.try_resolve_named_type_in_scope_without_diag(name, scope) in {
                    .Some(resolved_type) then {
                        let resolved_target = self.canonicalize_alias_type(
                            resolved_type,
                        );
                        if self.is_integer_type(resolved_target) or self.is_float_type(
                            resolved_target,
                        ) then {
                            return self.infer_type_application_cast(
                                resolved_target,
                                call_args,
                                name_span,
                                scope,
                            );
                        };
                        // Trait target: the upcast `Drawable(c)`. The target is
                        // resolved exactly as `c as Drawable` resolved it, so
                        // the object-safety check and the trait-object wrapper
                        // come out unchanged.
                        when self.as_cast_trait_object_target(resolved_target) in {
                            .Some(_) then {
                                let target = self.resolve_type_in_scope(
                                    TypeNode.Identifier(name, name_span),
                                    scope,
                                );
                                return self.lower_type_application_upcast_call(
                                    target,
                                    call_args,
                                    name_span,
                                    scope,
                                );
                            },
                            .None() then {},
                        };
                        // A resolved pointer/weak target is the retired cast
                        // spelling, even when it arrives through an alias
                        // (`MyPtr(x)`). It must not fall into the construction
                        // path or the generic message below.
                        if self.is_pointer_weak_or_trait_cast_target(resolved_target) then {
                            self.push_diagnostic_at_span(
                                "Pointer and weak casts are written 'expr as Type', not 'Type(expr)'",
                                name_span,
                            );
                            return self.empty_typed_block(Type.Unknown());
                        };
                        // Non-constructible, non-castable types error.
                        if not self.is_nominal_type(resolved_target) and resolved_target is not .Unknown() then {
                            self.push_diagnostic_at_span(
                                "Type '\(name)' does not support cast: only numeric and pointer types can be cast",
                                name_span,
                            );
                            return self.empty_typed_block(Type.Unknown());
                        };
                    },
                    .None() then {},
                };
            },
            // The same family for the generic instantiation call shape:
            // `Transform[Int](c)` is the upcast to `Transform[Int]`.
            .GenericInstantiation(base_name, type_args, inst_span) then {
                when self.try_resolve_named_type_in_scope_without_diag(base_name, scope) in {
                    .Some(resolved_type) then {
                        let resolved_target = self.canonicalize_alias_type(
                            resolved_type,
                        );
                        when self.as_cast_trait_object_target(resolved_target) in {
                            .Some(_) then {
                                let target = self.resolve_type_in_scope(
                                    TypeNode.Generic(base_name, type_args, inst_span),
                                    scope,
                                );
                                return self.lower_type_application_upcast_call(
                                    target,
                                    call_args,
                                    inst_span,
                                    scope,
                                );
                            },
                            .None() then {},
                        };
                        if self.is_pointer_weak_or_trait_cast_target(resolved_target) then {
                            self.push_diagnostic_at_span(
                                "Pointer and weak casts are written 'expr as Type', not 'Type(expr)'",
                                inst_span,
                            );
                            return self.empty_typed_block(Type.Unknown());
                        };
                    },
                    .None() then {},
                };
            },
            // The paren form `(T)(args)`: the family keyed on the resolved
            // target, with no name to leak into the message.
            .TypeRef(type_node, _) then {
                let call_span = expr_span(callee);
                let target = self.resolve_type_in_scope(type_node, scope);
                let resolved_target = self.canonicalize_alias_type(target);
                when self.as_cast_trait_object_target(resolved_target) in {
                    .Some(_) then {
                        return self.lower_type_application_upcast_call(
                            target,
                            call_args,
                            call_span,
                            scope,
                        );
                    },
                    .None() then {},
                };
                if self.is_pointer_weak_or_trait_cast_target(resolved_target) then {
                    self.push_diagnostic_at_span(
                        "Pointer and weak casts are written 'expr as Type', not 'Type(expr)'",
                        call_span,
                    );
                    return self.empty_typed_block(Type.Unknown());
                };
                if self.is_integer_type(resolved_target) or self.is_float_type(
                    resolved_target,
                ) then {
                    return self.infer_type_application_cast(
                        resolved_target,
                        call_args,
                        call_span,
                        scope,
                    );
                };
                // Everything else -- including a nominal `(Self)` -- is
                // special-cased before any construction row: a non-nameable
                // type head in call position has no constructor spelling.
                if resolved_target is not .Unknown() then {
                    self.push_diagnostic_at_span(
                        "Type '\(type_node_spelling(type_node))' does not support cast: only numeric and pointer types can be cast",
                        call_span,
                    );
                    return self.empty_typed_block(Type.Unknown());
                };
            },
            _ then {},
        };
        let probe_is_constructor_type = constructor_type_probe is .StructureType(_) or is .GenericStruct(...);
        let constructor_plan_type = when expected in {
            .Some(expected_t) then when expected_t in {
                .StructureType(_) then if probe_is_constructor_type then expected_t
                else constructor_type_probe,
                .GenericStruct(...) then if probe_is_constructor_type then expected_t
                else constructor_type_probe,
                _ then constructor_type_probe,
            },
            .None() then constructor_type_probe,
        };
        let mutable constructor_already_normalized = false;
        if constructor_plan_type is .StructureType(_) or is .GenericStruct(...) then {
            let constructor_param_specs = self.struct_constructor_param_specs(
                constructor_plan_type,
            );
            let constructor_field_types = self.type_construction_arg_types(
                constructor_plan_type,
            );
            // The seed names a construction by the callee's base name -- `G`
            // for `G[Int8](...)` -- never by the instantiated spelling.
            let ctor_description = when callee in {
                .Identifier(name, _) then name,
                .GenericInstantiation(base, _, _) then base,
                _ then self.context().type_display_name(constructor_plan_type),
            };
            // A hidden field forces a factory method: construction is allowed
            // only when every field is visible from this call site. The plain
            // identifier entry checks this at its own arm; generic
            // instantiations used to skip the check entirely.
            let construction_def_id = when constructor_plan_type in {
                .StructureType(def_id) then Option[DefId].Some(def_id),
                .GenericStruct(tpl_def_id, _) then {
                    when self.storage.generic_templates.struct_by_def_id(tpl_def_id) in {
                        .Some(struct_template) then Option[DefId].Some(
                            struct_template.def_id,
                        ),
                        .None() then Option[DefId].None(),
                    }
                },
                _ then Option[DefId].None(),
            };
            when construction_def_id in {
                .Some(def_id) then {
                    if not self.ensure_struct_construction_access(
                        ctor_description,
                        def_id,
                        expr_span(callee),
                    ) then {
                        return self.empty_typed_block(Type.Unknown());
                    };
                },
                .None() then {},
            };
            call_args = self.normalize_constructor_call_args(
                call_args,
                constructor_param_specs,
                constructor_field_types,
                ctor_description,
            ) or else {
                return make_typed_expr(
                    TypedExprKind.Call(
                        self.check_call_callee_expr_ref(callee, scope),
                        List[TypedExpr].new(),
                    ),
                    Type.Unknown(),
                );
            };
            constructor_already_normalized = true;
        };

        when callee in {
            .Identifier(name, _) then {
                when self.try_resolve_named_type_in_scope_without_diag(name, scope) in {
                    .Some(t) then {
                        when t in {
                            .StructureType(def_id) then {
                                if not self.ensure_struct_construction_access(
                                    name,
                                    def_id,
                                    expr_span(callee),
                                ) then {
                                    return self.empty_typed_block(Type.Unknown());
                                };
                            },
                            _ then {},
                        };
                    },
                    .None() then {},
                };
            },
            _ then {},
        };

        // Handle enum constructor calls directly (e.g., MyEnum.Case(42) or [T]Result.Ok(42))
        when callee in {
            .MemberPath(base_expr, path, _) then {
                if path.count() == UInt(1) then {
                    let member_name = path[UInt(0)];
                    when base_expr in {
                        .Identifier(base_name, _) then {
                            let resolved_type_opt = self.try_resolve_named_type_in_scope_without_diag(
                                base_name,
                                scope,
                            );
                            when resolved_type_opt in {
                                .Some(resolved_type) then {
                                    let canonical = self.enum_constructor_type_from_expected(
                                        resolved_type,
                                        expected,
                                        base_name,
                                    );
                                    if self.static_member_is_enum_case(
                                        canonical,
                                        member_name,
                                    ) then {
                                        let field_types = self.get_enum_case_field_types(
                                            canonical,
                                            member_name,
                                        );
                                        let param_specs = self.get_enum_case_param_specs(
                                            canonical,
                                            member_name,
                                        );
                                        call_args = self.normalize_constructor_call_args(
                                            call_args,
                                            param_specs,
                                            field_types,
                                            "\(base_name).\(member_name)",
                                        ) or else {
                                            return make_typed_expr(
                                                TypedExprKind.Call(
                                                    self.check_call_callee_expr_ref(
                                                        callee,
                                                        scope,
                                                    ),
                                                    List[TypedExpr].new(),
                                                ),
                                                Type.Unknown(),
                                            );
                                        };
                                        let typed_args = self.check_implicit_member_args(
                                            call_args,
                                            field_types,
                                            scope,
                                            Option[SourceSpan].Some(expr_span(callee)),
                                        );
                                        self.reject_enum_constructor_arg_mismatches(
                                            member_name,
                                            call_args,
                                            typed_args,
                                            field_types,
                                        );
                                        return self.lower_enum_constructor_expr(
                                            canonical,
                                            member_name,
                                            typed_args,
                                        );
                                    };
                                },
                                .None() then {},
                            };
                        },
                        .GenericInstantiation(base_name, type_args, _) then {
                            let resolved_base = self.try_resolve_named_type_in_scope_without_diag(
                                base_name,
                                scope,
                            );
                            when resolved_base in {
                                .Some(base_type) then {
                                    let mutable resolved_args = List[Type].new();
                                    for type_arg in type_args then {
                                        resolved_args.push(
                                            self.resolve_type_in_scope(type_arg, scope),
                                        );
                                    };
                                    let enum_type = when base_type in {
                                        .EnumType(def_id) then {
                                            let template_def_id = self.named_enum_template_def_id(
                                                base_name,
                                                def_id,
                                            );
                                            Type.GenericEnum(
                                                if template_def_id.is_valid() then template_def_id
                                                else def_id,
                                                resolved_args,
                                            )
                                        },
                                        .GenericEnum(template_def_id, _) then Type.GenericEnum(
                                            self.named_enum_template_def_id(
                                                base_name,
                                                template_def_id,
                                            ),
                                            resolved_args,
                                        ),
                                        _ then Type.Unknown(),
                                    };
                                    if enum_type is not .Unknown() then {
                                        if self.static_member_is_enum_case(
                                            enum_type,
                                            member_name,
                                        ) then {
                                            let field_types = self.get_enum_case_field_types(
                                                enum_type,
                                                member_name,
                                            );
                                            let param_specs = self.get_enum_case_param_specs(
                                                enum_type,
                                                member_name,
                                            );
                                            call_args = self.normalize_constructor_call_args(
                                                call_args,
                                                param_specs,
                                                field_types,
                                                "\(base_name).\(member_name)",
                                            ) or else {
                                                return make_typed_expr(
                                                    TypedExprKind.Call(
                                                        self.check_call_callee_expr_ref(
                                                            callee,
                                                            scope,
                                                        ),
                                                        List[TypedExpr].new(),
                                                    ),
                                                    Type.Unknown(),
                                                );
                                            };
                                            let typed_args = self.check_implicit_member_args(
                                                call_args,
                                                field_types,
                                                scope,
                                                Option[SourceSpan].Some(
                                                    expr_span(callee),
                                                ),
                                            );
                                            return self.lower_enum_constructor_expr(
                                                enum_type,
                                                member_name,
                                                typed_args,
                                            );
                                        };
                                    };
                                },
                                .None() then {},
                            };
                        },
                        _ then {},
                    };
                };
            },
            _ then {},
        };

        if self.check_intrinsic_call_ref(callee, call_args, expected, scope) is .Some(intrinsic_expr) then {
            return intrinsic_expr;
        };

        // When a subscript expression is used as a mutable method receiver
        // (e.g. d[key].push(v)), re-evaluate with __index_mut_ptr so the
        // method can mutate the value in-place.
        when callee in {
            .MemberPath(base_expr, path, _) then {
                if path.count() == UInt(1) then {
                    when base_expr in {
                        .SubscriptExpr(sub_base, sub_args, _) then {
                            let typed_sub_base = self.check_expr_scoped_ref(
                                sub_base,
                                .None(),
                                scope,
                            );
                            let member_name = path[UInt(0)];
                            let subscript_kind = self.resolve_builtin_subscript_kind(
                                typed_sub_base.expr_type,
                            );
                            when subscript_kind in {
                                .Some(kind) then when kind in {
                                    .List(element_type) or .Deque(element_type) then {
                                        if self.method_requires_mut_ref(
                                            element_type,
                                            member_name,
                                        ) then {
                                            let mutable typed_sub_args = List[TypedExpr].new(
                                            );
                                            for a in sub_args then {
                                                typed_sub_args.push(
                                                    self.check_expr_scoped_ref(
                                                        a,
                                                        Option[Type].Some(
                                                            Type.UIntType(),
                                                        ),
                                                        scope,
                                                    ),
                                                );
                                            };
                                            // Use __index_mut_ref to get V directly
                                            let ref_result = self.build_builtin_subscript_helper_call(
                                                typed_sub_base,
                                                typed_sub_args,
                                                "__index_mut_ref",
                                            );
                                            when ref_result.expr_type in {
                                                .MutableReferenceType(ref_el) then {
                                                    let method_sym_opt = self.resolve_method_signature(
                                                        ref_el,
                                                        member_name,
                                                    );
                                                    when method_sym_opt in {
                                                        .Some(method_sym) then {
                                                            let sym_type = method_sym.symbol_type;
                                                            let typed_method_ref = make_typed_expr(
                                                                TypedExprKind.MethodReference(
                                                                    ref_result,
                                                                    ref_el,
                                                                    method_sym,
                                                                    List[Type].new(),
                                                                    List[Type].new(),
                                                                    Option[DefId].None(),
                                                                ),
                                                                sym_type,
                                                            );
                                                            let mutable typed_call_args = List[TypedExpr].new(
                                                            );
                                                            let param_types = self.resolve_method_param_types(
                                                                ref_el,
                                                                member_name,
                                                            );
                                                            let expected_count = if param_types.count(
                                                            ) > UInt(0) then param_types.count(
                                                            ) - UInt(1) else UInt(0);
                                                            let mutable a_idx: UInt = 0;
                                                            for a in call_args then {
                                                                let arg_expected = if a_idx < expected_count then Option[Type].Some(
                                                                    param_types[
                                                                        a_idx + UInt(1)
                                                                    ],
                                                                )
                                                                else Option[Type].None();
                                                                typed_call_args.push(
                                                                    self.check_expr_scoped_ref(
                                                                        a,
                                                                        arg_expected,
                                                                        scope,
                                                                    ),
                                                                );
                                                                a_idx += 1;
                                                            };
                                                            return make_typed_expr(
                                                                TypedExprKind.Call(
                                                                    typed_method_ref,
                                                                    typed_call_args,
                                                                ),
                                                                self.method_return_type(
                                                                    method_sym,
                                                                ),
                                                            );
                                                        },
                                                        .None() then {},
                                                    };
                                                },
                                                _ then {},
                                            };
                                        };
                                    },
                                    .Dict(_, value_type) then {
                                        if self.method_requires_mut_ref(
                                            value_type,
                                            member_name,
                                        ) then {
                                            let mutable typed_sub_args = List[TypedExpr].new(
                                            );
                                            for a in sub_args then {
                                                typed_sub_args.push(
                                                    self.check_expr_scoped_ref(
                                                        a,
                                                        .None(),
                                                        scope,
                                                    ),
                                                );
                                            };
                                            // Use __index_mut_ref to get V directly
                                            let ref_result = self.build_builtin_subscript_helper_call(
                                                typed_sub_base,
                                                typed_sub_args,
                                                "__index_mut_ref",
                                            );
                                            when ref_result.expr_type in {
                                                .MutableReferenceType(ref_el) then {
                                                    let method_sym_opt = self.resolve_method_signature(
                                                        ref_el,
                                                        member_name,
                                                    );
                                                    when method_sym_opt in {
                                                        .Some(method_sym) then {
                                                            let sym_type = method_sym.symbol_type;
                                                            let typed_method_ref = make_typed_expr(
                                                                TypedExprKind.MethodReference(
                                                                    ref_result,
                                                                    ref_el,
                                                                    method_sym,
                                                                    List[Type].new(),
                                                                    List[Type].new(),
                                                                    Option[DefId].None(),
                                                                ),
                                                                sym_type,
                                                            );
                                                            let mutable typed_call_args = List[TypedExpr].new(
                                                            );
                                                            let param_types = self.resolve_method_param_types(
                                                                ref_el,
                                                                member_name,
                                                            );
                                                            let expected_count = if param_types.count(
                                                            ) > UInt(0) then param_types.count(
                                                            ) - UInt(1) else UInt(0);
                                                            let mutable a_idx: UInt = 0;
                                                            for a in call_args then {
                                                                let arg_expected = if a_idx < expected_count then Option[Type].Some(
                                                                    param_types[
                                                                        a_idx + UInt(1)
                                                                    ],
                                                                )
                                                                else Option[Type].None();
                                                                typed_call_args.push(
                                                                    self.check_expr_scoped_ref(
                                                                        a,
                                                                        arg_expected,
                                                                        scope,
                                                                    ),
                                                                );
                                                                a_idx += 1;
                                                            };
                                                            return make_typed_expr(
                                                                TypedExprKind.Call(
                                                                    typed_method_ref,
                                                                    typed_call_args,
                                                                ),
                                                                self.method_return_type(
                                                                    method_sym,
                                                                ),
                                                            );
                                                        },
                                                        .None() then {},
                                                    };
                                                },
                                                _ then {},
                                            };
                                        };
                                    },
                                    _ then {},
                                },
                                .None() then {},
                            }
                        },
                        _ then {},
                    };
                };
            },
            _ then {},
        };

        let typed_callee = when self.typed_generic_function_callee_for_call(callee) in {
            .Some(resolved_callee) then resolved_callee,
            .None() then self.check_call_callee_expr_ref(callee, scope),
        };
        when callee in {
            .MemberPath(_, path, _) then {
                if not path.is_empty() and path[path.count() - UInt(1)] == "drop" then {
                    when self.split_member_path_call_callee(callee) in {
                        .Some(parts) then {
                            let typed_receiver = self.check_child_expr_ref(
                                parts.first,
                                .None(),
                                scope,
                            );
                            if self.has_explicit_std_drop_conformance(
                                typed_receiver.expr_type,
                            ) then {
                                self.push_diagnostic(
                                    "compiler protocol method drop cannot be called explicitly",
                                    expr_span(callee),
                                );
                                return make_typed_expr(
                                    TypedExprKind.Call(
                                        typed_callee,
                                        List[TypedExpr].new(),
                                    ),
                                    Type.Unknown(),
                                );
                            };
                        },
                        .None() then {},
                    };
                };
            },
            _ then {},
        };
        let typed_callee_ref = typed_callee;
        let callee_param_specs = self.resolve_call_param_specs(
            callee,
            typed_callee_ref,
            scope,
        );
        if not constructor_already_normalized and not callee_param_specs.is_empty() then {
            call_args = self.plan_call_argument_exprs(
                call_args,
                callee_param_specs,
                self.call_description_for_expr(callee),
            ) or else {
                return make_typed_expr(
                    TypedExprKind.Call(typed_callee_ref, List[TypedExpr].new()),
                    Type.Unknown(),
                );
            };
        };
        if not self.validate_function_expression_argument_count(
            typed_callee_ref,
            call_args,
        ) then {
            return make_typed_expr(
                TypedExprKind.Call(typed_callee_ref, List[TypedExpr].new()),
                Type.Unknown(),
            );
        };

        let generic_function_template_opt = self.generic_function_template_for_callee(
            typed_callee_ref,
        );
        let mutable generic_function_bindings = Dict[String, Type].new();
        let mutable has_generic_function_bindings = false;
        when self.initial_generic_function_bindings(callee, typed_callee_ref, scope) in {
            .Some(bindings) then {
                generic_function_bindings = bindings;
                has_generic_function_bindings = true;
            },
            .None() then {},
        };
        let mutable method_param_types_for_inference = List[Type].new();
        let mutable method_call_bindings = Dict[String, Type].new();
        let mutable has_method_call_bindings = false;
        // Cache for resolved method signature to avoid triple resolution
        let mutable cached_method_sig = Option[Symbol].None();
        let mutable cached_adapted_base_type = Type.Unknown();
        let mutable cached_adapted_base_expr = Option[TypedExpr].None();
        let mutable cached_materialized_receiver_binding = Option[Symbol].None();
        when typed_callee.expr_kind in {
            .MethodReference(base_ref, _, method, _, _, _) then {
                let method_val = method;
                let method_name = self.semantic_method_name_for_symbol(method_val);
                let mutable expected_self_type = self.resolve_method_self_type(
                    base_ref.expr_type,
                    method_name,
                );
                let prepared_base = self.prepare_call_receiver(
                    base_ref,
                    expected_self_type,
                );
                let adapted = self.adapt_receiver_to_expected_self_type_for_method(
                    prepared_base.first,
                    expected_self_type,
                    method_name,
                );
                let receiver_type = adapted.expr_type;
                cached_adapted_base_type = receiver_type;
                cached_adapted_base_expr = Option[TypedExpr].Some(adapted);
                cached_materialized_receiver_binding = prepared_base.second;
                let bound_bindings = self.resolve_signature_method_type_bindings(
                    receiver_type,
                    method_val,
                    List[Type].new(),
                );
                let bound_method = self.bind_method_symbol_type(
                    method_val,
                    bound_bindings,
                );
                cached_method_sig = Option[Symbol].Some(bound_method);
                method_param_types_for_inference = List[Type].new();
                let param_types = when bound_method.symbol_type in {
                    .FunctionType(params, _) then param_entry_types(params),
                    _ then List[Type].new(),
                };
                let mutable param_i: UInt = 1;
                while param_i < param_types.count() then {
                    method_param_types_for_inference.push((param_types[param_i]));
                    param_i += 1;
                };
                method_call_bindings = bound_bindings;
                has_method_call_bindings = true;
            },
            .MemberPath(...) then when self.split_typed_member_path_call_callee(
                typed_callee,
            ) in {
                .Some(parts) then {
                    let method_name = parts.second;
                    let receiver_expr = parts.first;
                    let mutable expected_self_type = self.resolve_method_self_type(
                        receiver_expr.expr_type,
                        method_name,
                    );
                    let prepared_base = self.prepare_call_receiver(
                        receiver_expr,
                        expected_self_type,
                    );
                    let adapted = self.adapt_receiver_to_expected_self_type_for_method(
                        prepared_base.first,
                        expected_self_type,
                        method_name,
                    );
                    let receiver_type = adapted.expr_type;
                    when self.resolve_source_method_signature(receiver_type, method_name) in {
                        .Some(method) then {
                            cached_adapted_base_type = receiver_type;
                            cached_adapted_base_expr = Option[TypedExpr].Some(adapted);
                            cached_materialized_receiver_binding = prepared_base.second;
                            cached_method_sig = Option[Symbol].Some(method);
                            method_param_types_for_inference = List[Type].new();
                            let param_types = when method.symbol_type in {
                                .FunctionType(params, _) then param_entry_types(params),
                                _ then List[Type].new(),
                            };
                            let mutable param_i: UInt = 1;
                            while param_i < param_types.count() then {
                                method_param_types_for_inference.push(
                                    (param_types[param_i]),
                                );
                                param_i += 1;
                            };
                            method_call_bindings = self.resolve_signature_method_type_bindings(
                                receiver_type,
                                method,
                                List[Type].new(),
                            );
                            has_method_call_bindings = true;
                        },
                        .None() then {},
                    };
                },
                .None() then {},
            },
            _ then {},
        };
        if not has_method_call_bindings and typed_callee.expr_type is not .FunctionType(...) then {
            when callee in {
                .MemberPath(base_expr, path, _) then if not path.is_empty() then {
                    let method_name = path[path.count() - 1];
                    let typed_base = self.check_child_expr_ref(base_expr, .None(), scope);
                    let mutable expected_self_type = self.resolve_method_self_type(
                        typed_base.expr_type,
                        method_name,
                    );
                    let prepared_base = self.prepare_call_receiver(
                        typed_base,
                        expected_self_type,
                    );
                    let adapted = self.adapt_receiver_to_expected_self_type_for_method(
                        prepared_base.first,
                        expected_self_type,
                        method_name,
                    );
                    let receiver_type = adapted.expr_type;
                    when self.resolve_source_method_signature(receiver_type, method_name) in {
                        .Some(method) then {
                            cached_adapted_base_type = receiver_type;
                            cached_adapted_base_expr = Option[TypedExpr].Some(adapted);
                            cached_materialized_receiver_binding = prepared_base.second;
                            cached_method_sig = Option[Symbol].Some(method);
                            method_param_types_for_inference = List[Type].new();
                            let param_types = when method.symbol_type in {
                                .FunctionType(params, _) then param_entry_types(params),
                                _ then List[Type].new(),
                            };
                            let mutable param_i: UInt = 1;
                            while param_i < param_types.count() then {
                                method_param_types_for_inference.push(
                                    (param_types[param_i]),
                                );
                                param_i += 1;
                            };
                            method_call_bindings = self.resolve_signature_method_type_bindings(
                                receiver_type,
                                method,
                                List[Type].new(),
                            );
                            has_method_call_bindings = true;
                        },
                        .None() then {},
                    };
                },
                _ then {},
            };
        };
        // 从 callee 签名中提取参数类型，用于向调用参数传播期望类型。
        // 当 generic / method bindings 已经决定参数期望时，避免再做一轮通用 metadata 解析。
        let callee_param_types = if call_args.is_empty() or has_generic_function_bindings or has_method_call_bindings then List[Type].new(
        ) else self.resolve_call_param_types(typed_callee_ref);
        let expected_constructor_param_types = if call_args.is_empty() or has_generic_function_bindings or has_method_call_bindings then List[Type].new(
        )
        else when typed_callee.expr_kind in {
            .Variable(sym) then when sym.kind in {
                .TypeSymbol() then self.resolve_expected_constructor_param_types(
                    callee,
                    expected,
                    scope,
                ),
                _ then List[Type].new(),
            },
            .GenericInstantiation(_, _) then self.resolve_expected_constructor_param_types(
                callee,
                expected,
                scope,
            ),
            .StaticMethodCall(_, _, _, _, _, _) then self.resolve_expected_constructor_param_types(
                callee,
                expected,
                scope,
            ),
            .MemberPath(...) then self.resolve_expected_constructor_param_types(
                callee,
                expected,
                scope,
            ),
            _ then List[Type].new(),
        };
        let mutable typed_args = List[TypedExpr].new();
        let mutable arg_idx: UInt = 0;
        for a in call_args then {
            let fallback_param_expected = when expected_constructor_param_types.get(
                arg_idx,
            ) in {
                .Some(pt) then Option[Type].Some(pt),
                .None() then when callee_param_types.get(arg_idx) in {
                    .Some(pt) then Option[Type].Some(pt),
                    .None() then Option[Type].None(),
                },
            };
            let raw_param_expected = if has_generic_function_bindings then {
                when generic_function_template_opt in {
                    .Some(template) then {
                        when self.raw_generic_function_param_type(template, arg_idx) in {
                            .Some(raw_param_type) then Option[Type].Some(
                                self.apply_type_bindings(
                                    raw_param_type,
                                    generic_function_bindings,
                                ),
                            ),
                            .None() then fallback_param_expected,
                        }
                    },
                    .None() then fallback_param_expected,
                }
            } else if has_method_call_bindings then {
                when method_param_types_for_inference.get(arg_idx) in {
                    .Some(raw_param_type) then Option[Type].Some(
                        self.apply_type_bindings(raw_param_type, method_call_bindings),
                    ),
                    .None() then fallback_param_expected,
                }
            } else {
                fallback_param_expected
            };
            // An argument's aim: a bare type parameter is no expectation at
            // all -- the argument is what infers it -- and an implicit generic
            // construction infers its type arguments from the arguments alone.
            // The seed aims NONE of its arguments: not at the expected type's
            // fields and not at the declared ones either. Explicit type
            // arguments name the parameters and aim as usual.
            let callee_is_implicit_type_ctor = when typed_callee.expr_kind in {
                .Variable(sym) then sym.kind is .TypeSymbol(),
                _ then false,
            };
            let ctor_probe_def_id = when constructor_plan_type in {
                .StructureType(def_id) then def_id,
                .GenericStruct(tpl_def_id, _) then tpl_def_id,
                _ then when constructor_type_probe in {
                    .StructureType(def_id) then def_id,
                    .GenericStruct(tpl_def_id, _) then tpl_def_id,
                    _ then def_id_invalid(),
                },
            };
            let callee_is_implicit_generic_ctor = when typed_callee.expr_kind in {
                .Variable(sym) then sym.kind is .TypeSymbol() and not self.generic_struct_type_parameter_names(
                    ctor_probe_def_id,
                ).is_empty(),
                _ then false,
            };
            let param_expected = when raw_param_expected in {
                .Some(pt) then {
                    let bare_type_param = pt is .GenericParameter(_);
                    let inferred_construction_param = callee_is_implicit_type_ctor and expected_constructor_param_types.get(
                        arg_idx,
                    ) is .Some(_) and self.contains_generic_parameter(pt);
                    if bare_type_param or inferred_construction_param or callee_is_implicit_generic_ctor then Option[Type].None(
                    ) else Option[Type].Some(pt)
                },
                .None() then Option[Type].None(),
            };
            // A construction blames its CALL for an argument literal's range
            // violation -- the reference compiler coerces construction
            // arguments after they are checked and names the construct it is
            // inside. Only the argument's OWN literal is redirected; literals
            // inside a nested call keep their own spans.
            let saved_range_blame = self.storage.range_blame_span;
            if (constructor_plan_type is .StructureType(_) or is .GenericStruct(...)) and a is .IntegerLiteral(...) then {
                self.storage.range_blame_span = Option[SourceSpan].Some(
                    expr_span(callee),
                );
            };
            let typed_arg = when a in {
                .Identifier(name, span) then self.check_identifier_expr_at(
                    name,
                    span,
                    scope,
                    false,
                ),
                .ArithmeticExpr(left, op, right, _) then self.check_arithmetic_expr_ref(
                    left,
                    op,
                    right,
                    param_expected,
                    scope,
                ),
                .ComparisonExpr(left, op, right, _) then self.check_comparison_expr_ref(
                    left,
                    op,
                    right,
                    scope,
                ),
                .BitwiseExpr(left, op, right, _) then self.check_bitwise_expr_ref(
                    left,
                    op,
                    right,
                    param_expected,
                    scope,
                ),
                .DerefExpr(inner, _) then {
                    let typed_inner = self.check_child_expr_ref(inner, .None(), scope);
                    let inner_t = when typed_inner.expr_type in {
                        .ReferenceType(inner_ref) then inner_ref,
                        .MutableReferenceType(inner_ref) then inner_ref,
                        .WeakReferenceType(inner_ref) then inner_ref,
                        .MutableWeakReferenceType(inner_ref) then inner_ref,
                        .PointerType(inner_ref) then inner_ref,
                        .MutablePointerType(inner_ref) then inner_ref,
                        _ then Type.Unknown(),
                    };
                    make_typed_expr(TypedExprKind.DerefExpr(typed_inner), inner_t)
                },
                .UnsafeDerefExpr(inner, _) then {
                    let typed_inner = self.check_child_expr_ref(inner, .None(), scope);
                    let inner_t = when typed_inner.expr_type in {
                        .ReferenceType(inner_ref) then inner_ref,
                        .MutableReferenceType(inner_ref) then inner_ref,
                        .WeakReferenceType(inner_ref) then inner_ref,
                        .MutableWeakReferenceType(inner_ref) then inner_ref,
                        .PointerType(inner_ref) then inner_ref,
                        .MutablePointerType(inner_ref) then inner_ref,
                        _ then Type.Unknown(),
                    };
                    make_typed_expr(TypedExprKind.UnsafeDerefExpr(typed_inner), inner_t)
                },
                .Call(nested_callee, nested_args, _) then self.check_call_expr_ref(
                    nested_callee,
                    nested_args,
                    param_expected,
                    scope,
                ),
                .RangeExpr(op, left, right, _) then self.check_range_expr_ref(
                    op,
                    left,
                    right,
                    param_expected,
                    scope,
                ),
                .MemberPath(_, _, _) then self.check_expr_scoped_ref(
                    a,
                    param_expected,
                    scope,
                ),
                .StaticMethodCall(_, _, _, _, _) then self.check_expr_scoped_ref(
                    a,
                    param_expected,
                    scope,
                ),
                .IntegerLiteral(...) then self.check_expr_scoped_ref(
                    a,
                    param_expected,
                    scope,
                ),
                .FloatLiteral(...) then self.check_expr_scoped_ref(
                    a,
                    param_expected,
                    scope,
                ),
                .BoolLiteral(...) then self.check_expr_scoped_ref(
                    a,
                    param_expected,
                    scope,
                ),
                .StringLiteral(...) then self.check_expr_scoped_ref(
                    a,
                    param_expected,
                    scope,
                ),
                .RuneLiteral(...) then self.check_expr_scoped_ref(
                    a,
                    param_expected,
                    scope,
                ),
                _ then self.check_expr_scoped_ref(a, param_expected, scope),
            };
            let adjusted_arg = when param_expected in {
                .None() then typed_arg,
                .Some(expected_t) then {
                    let expected_requires_ref_like = when expected_t in {
                        .ReferenceType(_) then true,
                        .MutableReferenceType(_) then true,
                        .BorrowedReferenceType(_) then true,
                        .MutableBorrowedReferenceType(_) then true,
                        _ then false,
                    };
                    let actual_is_ref_like = when typed_arg.expr_type in {
                        .ReferenceType(_) then true,
                        .MutableReferenceType(_) then true,
                        .BorrowedReferenceType(_) then true,
                        .MutableBorrowedReferenceType(_) then true,
                        .WeakReferenceType(_) then true,
                        .MutableWeakReferenceType(_) then true,
                        .PointerType(_) then true,
                        .MutablePointerType(_) then true,
                        _ then false,
                    };
                    let expected_is_trait_object_ref = when expected_t in {
                        .ReferenceType(inner) then inner is .TraitObject(...),
                        .MutableReferenceType(inner) then inner is .TraitObject(...),
                        .BorrowedReferenceType(inner) then inner is .TraitObject(...),
                        .MutableBorrowedReferenceType(inner) then inner is .TraitObject(...),
                        _ then false,
                    };
                    if self.same_expr_type(typed_arg.expr_type, expected_t) then typed_arg
                    else if expected_requires_ref_like and not actual_is_ref_like and not expected_is_trait_object_ref then typed_arg
                    else self.adapt_expr_to_expected_type_at(
                        typed_arg,
                        Option[Type].Some(expected_t),
                        Option[SourceSpan].Some(expr_span(a)),
                    )
                },
            };
            if param_expected is .Some(expected_t) then {
                if not self.same_expr_type(adjusted_arg.expr_type, expected_t) and not self.type_matches_expected_pattern(
                    expected_t,
                    adjusted_arg.expr_type,
                ) and not self.contains_generic_parameter(expected_t) and not self.is_unresolved_expr_type(
                    expected_t,
                ) and not self.is_unresolved_expr_type(adjusted_arg.expr_type) then {
                    self.push_diagnostic(
                        self.format_call_type_mismatch_message(
                            callee,
                            call_args,
                            expected_t,
                            adjusted_arg.expr_type,
                        ),
                        expr_span(callee),
                    );
                };
            };
            if has_generic_function_bindings then {
                when generic_function_template_opt in {
                    .Some(template) then {
                        when self.raw_generic_function_param_type(template, arg_idx) in {
                            .Some(raw_param_type) then {
                                self.infer_type_bindings(
                                    raw_param_type,
                                    typed_arg.expr_type,
                                    generic_function_bindings,
                                );
                            },
                            .None() then {},
                        };
                    },
                    .None() then {},
                };
            } else if has_method_call_bindings then {
                when method_param_types_for_inference.get(arg_idx) in {
                    .Some(raw_param_type) then {
                        self.infer_type_bindings(
                            raw_param_type,
                            typed_arg.expr_type,
                            method_call_bindings,
                        );
                    },
                    .None() then {},
                };
            };
            self.storage.range_blame_span = saved_range_blame;
            typed_args.push(adjusted_arg);
            arg_idx += 1;
        };

        // Build the trait-object dispatch call AFTER all arguments are collected.
        // This used to run inside the per-argument loop, so `typed_args` was still
        // empty when the call was built and every argument except the implicit
        // receiver was dropped from the generated C.
        when typed_callee.expr_kind in {
            .TraitMethodPlaceholder(base, trait_type, method, _, _, _) then {
                when self.trait_object_dispatch_type(base.expr_type) in {
                    .Some(dispatch_trait_type) then {
                        let method_name = self.semantic_method_name_for_symbol(method);
                        when self.trait_vtable_method_index_for_type(
                            dispatch_trait_type,
                            method_name,
                        ) in {
                            .Some(method_index) then {
                                let return_type = when typed_callee.expr_type in {
                                    .FunctionType(_, return_type_ref) then return_type_ref,
                                    _ then Type.Unknown(),
                                };
                                let trait_receiver = when base.expr_kind in {
                                    .DerefExpr(inner) then when inner.expr_type in {
                                        .ReferenceType(inner_ref) then when inner_ref in {
                                            .TraitObject(...) then inner,
                                            _ then base,
                                        },
                                        .MutableReferenceType(inner_ref) then when inner_ref in {
                                            .TraitObject(...) then inner,
                                            _ then base,
                                        },
                                        _ then base,
                                    },
                                    _ then base,
                                };
                                return make_typed_expr(
                                    TypedExprKind.TraitMethodCall(
                                        trait_receiver,
                                        dispatch_trait_type,
                                        method_name,
                                        method_index,
                                        typed_args,
                                    ),
                                    return_type,
                                );
                            },
                            .None() then {},
                        };
                    },
                    .None() then {},
                };
            },
            _ then {},
        };

        if typed_callee.expr_type is .Unknown() then {
            return make_typed_expr(
                TypedExprKind.Call(typed_callee_ref, typed_args),
                Type.Unknown(),
            );
        };

        when callee in {
            .Identifier(_, _) then when typed_callee.expr_kind in {
                .Variable(sym) then {
                    if sym.kind is not .TypeSymbol() and not self.validate_call_argument_order(
                        call_args,
                    ) then {
                        return make_typed_expr(
                            TypedExprKind.Call(typed_callee_ref, typed_args),
                            Type.Unknown(),
                        );
                    };
                },
                _ then if not self.validate_call_argument_order(call_args) then {
                    return make_typed_expr(
                        TypedExprKind.Call(typed_callee_ref, typed_args),
                        Type.Unknown(),
                    );
                },
            },
            _ then if not self.validate_call_argument_order(call_args) then {
                return make_typed_expr(
                    TypedExprKind.Call(typed_callee_ref, typed_args),
                    Type.Unknown(),
                );
            },
        };

        when generic_function_template_opt in {
            .Some(_) then self.validate_generic_function_call_constraints(
                callee,
                typed_callee_ref,
                typed_args,
                scope,
                generic_function_bindings,
            ),
            .None() then {},
        };

        let inferred_method_call_info = when typed_callee.expr_kind in {
            .MethodReference(base_ref, _, method, _, _, _) then {
                // Use cached method signature if available, otherwise resolve
                let method_name = self.semantic_method_name_for_symbol(method);
                when cached_method_sig in {
                    .Some(sig) then {
                        // Reuse cached resolution — no re-resolve needed
                        let inferred_method_type_args = self.resolve_method_type_args_for_call_with_expected(
                            cached_adapted_base_type,
                            sig,
                            typed_args,
                            List[Type].new(),
                            expected,
                            expr_span(callee),
                        );
                        self.maybe_record_extension_method_instantiation(
                            cached_adapted_base_type,
                            method_name,
                            inferred_method_type_args,
                        );
                        let mutable inferred_return_type = self.resolve_method_return_type_for_call(
                            cached_adapted_base_type,
                            sig,
                            typed_args,
                            inferred_method_type_args,
                        );
                        Option[Pair[Type, List[Type]]].Some(
                            Pair[Type, List[Type]](
                                inferred_return_type,
                                inferred_method_type_args,
                            ),
                        )
                    },
                    .None() then {
                        // Fallback: resolve if not cached
                        let mutable expected_self_type = self.resolve_method_self_type(
                            base_ref.expr_type,
                            method_name,
                        );
                        let prepared_base = self.prepare_call_receiver(
                            base_ref,
                            expected_self_type,
                        );
                        let typed_base = self.adapt_receiver_to_expected_self_type_for_method(
                            prepared_base.first,
                            expected_self_type,
                            method_name,
                        );
                        when self.resolve_source_method_signature(
                            typed_base.expr_type,
                            method_name,
                        ) in {
                            .Some(sig) then {
                                let inferred_method_type_args = self.resolve_method_type_args_for_call_with_expected(
                                    typed_base.expr_type,
                                    sig,
                                    typed_args,
                                    List[Type].new(),
                                    expected,
                                    expr_span(callee),
                                );
                                self.maybe_record_extension_method_instantiation(
                                    typed_base.expr_type,
                                    method_name,
                                    inferred_method_type_args,
                                );
                                let mutable inferred_return_type = self.resolve_method_return_type_for_call(
                                    typed_base.expr_type,
                                    sig,
                                    typed_args,
                                    inferred_method_type_args,
                                );
                                Option[Pair[Type, List[Type]]].Some(
                                    Pair[Type, List[Type]](
                                        inferred_return_type,
                                        inferred_method_type_args,
                                    ),
                                )
                            },
                            .None() then Option[Pair[Type, List[Type]]].None(),
                        }
                    },
                }
            },
            .MemberPath(...) then when self.split_typed_member_path_call_callee(
                typed_callee,
            ) in {
                .Some(parts) then {
                    let method_name = parts.second;
                    let receiver_expr = parts.first;
                    when cached_method_sig in {
                        .Some(sig) then {
                            let inferred_method_type_args = self.resolve_method_type_args_for_call_with_expected(
                                cached_adapted_base_type,
                                sig,
                                typed_args,
                                List[Type].new(),
                                expected,
                                expr_span(callee),
                            );
                            let mutable inferred_return_type = self.resolve_method_return_type_for_call(
                                cached_adapted_base_type,
                                sig,
                                typed_args,
                                inferred_method_type_args,
                            );
                            Option[Pair[Type, List[Type]]].Some(
                                Pair[Type, List[Type]](
                                    inferred_return_type,
                                    inferred_method_type_args,
                                ),
                            )
                        },
                        .None() then {
                            let mutable expected_self_type = self.resolve_method_self_type(
                                receiver_expr.expr_type,
                                method_name,
                            );
                            let prepared_base = self.prepare_call_receiver(
                                receiver_expr,
                                expected_self_type,
                            );
                            let typed_base = self.adapt_receiver_to_expected_self_type_for_method(
                                prepared_base.first,
                                expected_self_type,
                                method_name,
                            );
                            when self.resolve_source_method_signature(
                                typed_base.expr_type,
                                method_name,
                            ) in {
                                .Some(sig) then {
                                    let inferred_method_type_args = self.resolve_method_type_args_for_call_with_expected(
                                        typed_base.expr_type,
                                        sig,
                                        typed_args,
                                        List[Type].new(),
                                        expected,
                                        expr_span(callee),
                                    );
                                    self.maybe_record_extension_method_instantiation(
                                        typed_base.expr_type,
                                        method_name,
                                        inferred_method_type_args,
                                    );
                                    let mutable inferred_return_type = self.resolve_method_return_type_for_call(
                                        typed_base.expr_type,
                                        sig,
                                        typed_args,
                                        inferred_method_type_args,
                                    );
                                    Option[Pair[Type, List[Type]]].Some(
                                        Pair[Type, List[Type]](
                                            inferred_return_type,
                                            inferred_method_type_args,
                                        ),
                                    )
                                },
                                .None() then Option[Pair[Type, List[Type]]].None(),
                            }
                        },
                    }
                },
                .None() then Option[Pair[Type, List[Type]]].None(),
            },
            _ then Option[Pair[Type, List[Type]]].None(),
        };

        let generic_return_type = when generic_function_template_opt in {
            .Some(_) then self.resolve_generic_function_call_return_type(
                callee,
                typed_callee_ref,
                typed_args,
                expected,
                scope,
                generic_function_bindings,
            ),
            .None() then Option[Type].None(),
        };
        let mutable generic_struct_constructor_return_type = Option[Type].None();
        let callee_is_implicit_ctor_for_result = when typed_callee.expr_kind in {
            .Variable(sym) then sym.kind is .TypeSymbol(),
            _ then false,
        };
        generic_struct_constructor_return_type = when constructor_plan_type in {
            .StructureType(def_id) then self.infer_generic_struct_constructor_return_type_for_def_id(
                def_id,
                typed_args,
                expr_span(callee),
            ),
            .GenericStruct(tpl_def_id, _) then {
                if callee_is_implicit_ctor_for_result then {
                    // The seed's implicit generic construction infers its type
                    // arguments from the arguments alone; the expected type
                    // never names them. `let g G[Int8] = G(5)` really is
                    // `G[Int]` delivered against `G[Int8]`, and the mismatch
                    // is the whole point.
                    self.infer_generic_struct_constructor_return_type_for_def_id(
                        tpl_def_id,
                        typed_args,
                        expr_span(callee),
                    )
                } else {
                    Option[Type].Some(constructor_plan_type)
                }
            },
            _ then self.infer_generic_struct_constructor_return_type(callee, typed_args),
        };
        let mutable has_direct_generic_instantiation_return_type = false;
        let mutable direct_generic_instantiation_return_type = Type.Unknown();
        when typed_callee.expr_kind in {
            .GenericInstantiation(_, _) then {
                direct_generic_instantiation_return_type = typed_callee.expr_type;
                has_direct_generic_instantiation_return_type = true;
            },
            _ then {},
        };
        let resolved_ret_type = if has_direct_generic_instantiation_return_type then direct_generic_instantiation_return_type
        else when typed_callee.expr_kind in {
            .Variable(_) then when generic_return_type in {
                .Some(ret_type) then ret_type,
                .None() then when generic_struct_constructor_return_type in {
                    .Some(ret_type) then ret_type,
                    .None() then when inferred_method_call_info in {
                        .Some(info) then info.first,
                        .None() then self.resolve_call_return_type(typed_callee_ref),
                    },
                },
            },
            _ then when generic_return_type in {
                .Some(ret_type) then ret_type,
                .None() then when inferred_method_call_info in {
                    .Some(info) then info.first,
                    .None() then self.resolve_call_return_type(typed_callee_ref),
                },
            },
        };
        let mutable ret_type = when resolved_ret_type in {
            .Unknown() then when expected in {
                .Some(et) then et,
                .None() then resolved_ret_type,
            },
            _ then resolved_ret_type,
        };
        let inferred_method_type_args_for_call = when inferred_method_call_info in {
            .Some(info) then info.second,
            .None() then List[Type].new(),
        };
        let skip_zero_arg_member_expected_refine = args.is_empty() and when typed_callee.expr_kind in {
            .MethodReference(_, _, _, _, _, _) then true,
            .MemberPath(...) then true,
            _ then false,
        };
        if not skip_zero_arg_member_expected_refine then {
            when expected in {
                .Some(expected_t) then {
                    if self.mentions_unresolved_generic_placeholder(ret_type) and not self.mentions_unresolved_generic_placeholder(
                        expected_t,
                    ) and not self.is_unresolved_expr_type(expected_t) then {
                        ret_type = expected_t;
                    };
                },
                .None() then {},
            };
        };
        when typed_callee.expr_kind in {
            .GenericInstantiation(base_type, type_args) then {
                if self.is_nominal_type(ret_type) then {
                    let identifier = self.type_construction_symbol_for_type(
                        base_type,
                        ret_type,
                    );
                    let param_specs = self.struct_constructor_param_specs(ret_type);
                    let field_types = self.type_construction_arg_types(ret_type);
                    let normalized_args = if constructor_already_normalized then call_args
                    else self.normalize_constructor_call_args(
                        args,
                        param_specs,
                        field_types,
                        self.context().type_display_name(ret_type),
                    ) or else {
                        return make_typed_expr(
                            TypedExprKind.Call(typed_callee_ref, typed_args),
                            Type.Unknown(),
                        );
                    };
                    let constructor_args = self.recheck_type_construction_args(
                        normalized_args,
                        ret_type,
                        scope,
                        expr_span(callee),
                    );
                    return make_typed_expr(
                        TypedExprKind.TypeConstruction(
                            identifier,
                            type_args,
                            constructor_args,
                        ),
                        ret_type,
                    );
                };
            },
            .Variable(sym) then {
                if sym.kind is .TypeSymbol() then {
                    if self.is_nominal_type(ret_type) then {
                        let identifier = Symbol(
                            sym.def_id,
                            ret_type,
                            SymbolKind.TypeSymbol(),
                        );
                        let param_specs = self.struct_constructor_param_specs(ret_type);
                        let field_types = self.type_construction_arg_types(ret_type);
                        let normalized_args = if constructor_already_normalized then call_args
                        else self.normalize_constructor_call_args(
                            args,
                            param_specs,
                            field_types,
                            self.context().symbol_name(sym),
                        ) or else {
                            return make_typed_expr(
                                TypedExprKind.Call(typed_callee_ref, typed_args),
                                Type.Unknown(),
                            );
                        };
                        // The seed's construction re-fit: the arguments land
                        // on the substituted field types at the CALL's span.
                        // An implicit generic construction whose type
                        // arguments never inferred has no fields to fit -- the
                        // missing-inference complaint stands alone -- and an
                        // argument that already failed is left alone: its own
                        // complaint stands for the row.
                        let recheck_fields = self.type_construction_arg_types(ret_type);
                        let ctor_probe_def_id = when constructor_plan_type in {
                            .StructureType(def_id) then def_id,
                            .GenericStruct(tpl_def_id, _) then tpl_def_id,
                            _ then when constructor_type_probe in {
                                .StructureType(def_id) then def_id,
                                .GenericStruct(tpl_def_id, _) then tpl_def_id,
                                _ then def_id_invalid(),
                            },
                        };
                        let ctor_is_implicit_generic = not self.generic_struct_type_parameter_names(
                            ctor_probe_def_id,
                        ).is_empty();
                        let mutable constructor_args = List[TypedExpr].new();
                        if ctor_is_implicit_generic and generic_struct_constructor_return_type is .None() then {
                            constructor_args = typed_args;
                        } else if ctor_is_implicit_generic and constructor_already_normalized then {
                            let mutable fit_idx: UInt = 0;
                            while fit_idx < typed_args.count() then {
                                let arg_node = typed_args[fit_idx];
                                if fit_idx < recheck_fields.count() and not self.is_unresolved_expr_type(
                                    arg_node.expr_type,
                                ) then {
                                    let expected_fit = recheck_fields[fit_idx];
                                    let fitted = self.adapt_expr_to_expected_type_at(
                                        arg_node,
                                        Option[Type].Some(expected_fit),
                                        Option[SourceSpan].Some(expr_span(callee)),
                                    );
                                    // The seed's post-coerce row: an argument
                                    // whose coerced type still disagrees with
                                    // its substituted field type is a conflict
                                    // at the call.
                                    if not self.same_expr_type(
                                        fitted.expr_type,
                                        expected_fit,
                                    ) and not self.type_matches_expected_pattern(
                                        expected_fit,
                                        fitted.expr_type,
                                    ) and not self.contains_generic_parameter(
                                        expected_fit,
                                    ) and not self.is_unresolved_expr_type(expected_fit) and not self.is_unresolved_expr_type(
                                        fitted.expr_type,
                                    ) then {
                                        self.push_diagnostic(
                                            self.format_call_type_mismatch_message(
                                                Expr.IntegerLiteral(
                                                    "",
                                                    expr_span(callee),
                                                ),
                                                args,
                                                expected_fit,
                                                fitted.expr_type,
                                            ),
                                            expr_span(callee),
                                        );
                                    };
                                    constructor_args.push(fitted);
                                } else {
                                    constructor_args.push(arg_node);
                                };
                                fit_idx += 1;
                            };
                        } else {
                            constructor_args = self.recheck_type_construction_args(
                                normalized_args,
                                ret_type,
                                scope,
                                expr_span(callee),
                            );
                        };
                        return make_typed_expr(
                            TypedExprKind.TypeConstruction(
                                identifier,
                                List[Type].new(),
                                constructor_args,
                            ),
                            ret_type,
                        );
                    };
                };
            },
            _ then {},
        };
        when typed_callee.expr_kind in {
            .Variable(sym) then {
                when sym.kind in {
                    .TypeSymbol() then {
                        when ret_type in {
                            .StructureType(def_id) then {
                                if not self.ensure_struct_construction_access(
                                    self.context().symbol_name(sym),
                                    def_id,
                                    expr_span(callee),
                                ) then {
                                    return self.empty_typed_block(Type.Unknown());
                                };
                            },
                            // Identity: the template's DECLARATION, not its spelling.
                            .GenericStruct(template_def_id, _) then {
                                when self.storage.generic_templates.struct_by_def_id(
                                    template_def_id,
                                ) in {
                                    .Some(template) then {
                                        if not self.ensure_struct_construction_access(
                                            self.context().symbol_name(sym),
                                            template.def_id,
                                            expr_span(callee),
                                        ) then {
                                            return self.empty_typed_block(
                                                Type.Unknown(),
                                            );
                                        };
                                    },
                                    .None() then {},
                                };
                            },
                            _ then {},
                        };
                    },
                    _ then {},
                };
            },
            _ then {},
        };
        let generic_call_type_args = when generic_function_template_opt in {
            .Some(template) then {
                let mutable resolved = List[Type].new();
                for tp in template.type_parameters then {
                    resolved.push(
                        generic_function_bindings.get(tp.name) or else Type.GenericParameter(
                            tp.name,
                        ),
                    );
                };
                resolved
            },
            .None() then List[Type].new(),
        };
        when generic_function_template_opt in {
            .Some(template) then if not template.type_parameters.is_empty() then when typed_callee.expr_kind in {
                .Variable(sym) then when sym.kind in {
                    .Function() then {
                        let generic_symbol = Symbol(
                            sym.def_id,
                            typed_callee.expr_type,
                            sym.kind,
                        );
                        let generic_call = make_typed_expr(
                            TypedExprKind.GenericCall(
                                generic_symbol,
                                generic_call_type_args,
                                typed_args,
                            ),
                            ret_type,
                        );
                        return generic_call;
                    },
                    _ then {},
                },
                _ then {},
            },
            .None() then {},
        };
        let structured_call_opt = when typed_callee.expr_kind in {
            .MethodReference(base_ref, _, method, method_type_args, callee_method_type_args, _) then {
                let base = base_ref;
                let method_name = self.semantic_method_name_for_symbol(method);
                let base_type = base.expr_type;
                let normalized_base_type = base_type;
                let trait_constraint_opt = self.find_trait_constraint_for_method(
                    base_type,
                    method_name,
                );
                // Use cached method signature if available, otherwise resolve
                let direct_method_signature_opt = when cached_method_sig in {
                    .Some(sig) then Option[Symbol].Some(sig),
                    .None() then self.resolve_source_method_signature(
                        base_type,
                        method_name,
                    ),
                };
                let trait_dispatch_requires_object = self.dispatches_via_trait_object_for_static_call(
                    normalized_base_type,
                );
                let is_generic_receiver = self.contains_generic_parameter(
                    normalized_base_type,
                );
                let expected_self_type = when trait_constraint_opt in {
                    .Some(_) then Option[Type].None(),
                    .None() then self.resolve_method_self_type(base_type, method_name),
                };
                let mutable prepared_base_binding = cached_materialized_receiver_binding;
                let adapted_base = when cached_adapted_base_expr in {
                    .Some(cached) then cached,
                    .None() then {
                        let prepared_base = self.prepare_call_receiver(
                            base,
                            expected_self_type,
                        );
                        prepared_base_binding = prepared_base.second;
                        cached_materialized_receiver_binding = prepared_base.second;
                        self.adapt_receiver_to_expected_self_type_for_method(
                            prepared_base.first,
                            expected_self_type,
                            method_name,
                        )
                    },
                };
                let inferred_method_type_args = if not callee_method_type_args.is_empty() then callee_method_type_args
                else inferred_method_type_args_for_call;
                let method_ret_type = when ret_type in {
                    .Unknown() then when direct_method_signature_opt in {
                        .Some(method_symbol) then when method_symbol.symbol_type in {
                            .FunctionType(_, ret) then ret,
                            _ then self.resolve_method_return_type(
                                adapted_base.expr_type,
                                method_name,
                            ),
                        },
                        .None() then self.resolve_method_return_type(
                            adapted_base.expr_type,
                            method_name,
                        ),
                    },
                    _ then ret_type,
                };
                let lowered_method_symbol = when direct_method_signature_opt in {
                    .Some(method_symbol) then method_symbol,
                    .None() then self.make_method_symbol_for_receiver(
                        base_type,
                        method_name,
                        method_ret_type,
                    ),
                };
                let mutable structured_call = Option[TypedExpr].None();
                let should_lower_to_method_call = self.is_unresolved_expr_type(
                    base_type,
                ) or trait_constraint_opt is .Some(_) or direct_method_signature_opt is .Some(_);
                if should_lower_to_method_call and self.is_unresolved_expr_type(
                    base_type,
                ) then {
                    let static_receiver_opt = self.resolve_static_receiver_type(
                        adapted_base,
                    );
                    when static_receiver_opt in {
                        .Some(receiver_type) then {
                            let mutable static_args = List[TypedExpr].new();
                            static_args.push(adapted_base);
                            for arg in typed_args then {
                                static_args.push(arg);
                            };
                            structured_call = Option[TypedExpr].Some(
                                make_typed_expr(
                                    TypedExprKind.StaticMethodCall(
                                        receiver_type,
                                        method_name,
                                        lowered_method_symbol,
                                        List[Type].new(),
                                        inferred_method_type_args,
                                        static_args,
                                    ),
                                    method_ret_type,
                                ),
                            );
                        },
                        .None() then {
                            let callee = make_typed_expr(
                                TypedExprKind.MethodReference(
                                    adapted_base,
                                    adapted_base.expr_type,
                                    lowered_method_symbol,
                                    List[Type].new(),
                                    inferred_method_type_args,
                                    .None(),
                                ),
                                lowered_method_symbol.symbol_type,
                            );
                            structured_call = Option[TypedExpr].Some(
                                make_typed_expr(
                                    TypedExprKind.Call(callee, typed_args),
                                    method_ret_type,
                                ),
                            );
                        },
                    };
                } else if should_lower_to_method_call then {
                    when trait_constraint_opt in {
                        .Some(trait_name) then {
                            self.maybe_record_trait_method_instantiation(
                                adapted_base.expr_type,
                                method_name,
                                List[Type].new(),
                            );
                            let trait_type = self.constrained_trait_object_type_for_static_call(
                                adapted_base.expr_type,
                                trait_name,
                            );
                            structured_call = if is_generic_receiver then {
                                let callee = make_typed_expr(
                                    TypedExprKind.TraitMethodPlaceholder(
                                        adapted_base,
                                        trait_type,
                                        lowered_method_symbol,
                                        self.trait_method_def_id_of(
                                            trait_type,
                                            method_name,
                                        ),
                                        inferred_method_type_args,
                                        .None(),
                                    ),
                                    lowered_method_symbol.symbol_type,
                                );
                                Option[TypedExpr].Some(
                                    make_typed_expr(
                                        TypedExprKind.Call(callee, typed_args),
                                        method_ret_type,
                                    ),
                                )
                            } else if trait_dispatch_requires_object then {
                                if self.trait_vtable_method_index_for_type(
                                    trait_type,
                                    method_name,
                                ) is .Some(method_index) then {
                                    Option[TypedExpr].Some(
                                        make_typed_expr(
                                            TypedExprKind.TraitMethodCall(
                                                self.trait_method_call_receiver(
                                                    adapted_base,
                                                ),
                                                trait_type,
                                                method_name,
                                                method_index,
                                                typed_args,
                                            ),
                                            method_ret_type,
                                        ),
                                    )
                                } else {
                                    let callee = make_typed_expr(
                                        TypedExprKind.TraitMethodPlaceholder(
                                            adapted_base,
                                            trait_type,
                                            lowered_method_symbol,
                                            self.trait_method_def_id_of(
                                                trait_type,
                                                method_name,
                                            ),
                                            inferred_method_type_args,
                                            .None(),
                                        ),
                                        lowered_method_symbol.symbol_type,
                                    );
                                    Option[TypedExpr].Some(
                                        make_typed_expr(
                                            TypedExprKind.Call(callee, typed_args),
                                            method_ret_type,
                                        ),
                                    )
                                }
                            } else {
                                let callee = make_typed_expr(
                                    TypedExprKind.MethodReference(
                                        adapted_base,
                                        adapted_base.expr_type,
                                        lowered_method_symbol,
                                        List[Type].new(),
                                        inferred_method_type_args,
                                        .None(),
                                    ),
                                    lowered_method_symbol.symbol_type,
                                );
                                Option[TypedExpr].Some(
                                    make_typed_expr(
                                        TypedExprKind.Call(callee, typed_args),
                                        method_ret_type,
                                    ),
                                )
                            };
                        },
                        .None() then {
                            when self.trait_object_type_for_static_call(
                                normalized_base_type,
                            ) in {
                                .Some(trait_type) then {
                                    if self.trait_type_declares_static_call_method(
                                        trait_type,
                                        method_name,
                                    ) then {
                                        let callee = make_typed_expr(
                                            TypedExprKind.TraitMethodPlaceholder(
                                                adapted_base,
                                                trait_type,
                                                lowered_method_symbol,
                                                self.trait_method_def_id_of(
                                                    trait_type,
                                                    method_name,
                                                ),
                                                inferred_method_type_args,
                                                .None(),
                                            ),
                                            lowered_method_symbol.symbol_type,
                                        );
                                        structured_call = Option[TypedExpr].Some(
                                            make_typed_expr(
                                                TypedExprKind.Call(callee, typed_args),
                                                method_ret_type,
                                            ),
                                        );
                                    } else {
                                        let callee = make_typed_expr(
                                            TypedExprKind.MethodReference(
                                                adapted_base,
                                                adapted_base.expr_type,
                                                lowered_method_symbol,
                                                List[Type].new(),
                                                inferred_method_type_args,
                                                .None(),
                                            ),
                                            lowered_method_symbol.symbol_type,
                                        );
                                        structured_call = Option[TypedExpr].Some(
                                            make_typed_expr(
                                                TypedExprKind.Call(callee, typed_args),
                                                method_ret_type,
                                            ),
                                        );
                                    };
                                },
                                .None() then if not self.dispatches_via_trait_object_for_static_call(
                                    normalized_base_type,
                                ) then {
                                    let callee = make_typed_expr(
                                        TypedExprKind.MethodReference(
                                            adapted_base,
                                            adapted_base.expr_type,
                                            lowered_method_symbol,
                                            List[Type].new(),
                                            inferred_method_type_args,
                                            .None(),
                                        ),
                                        lowered_method_symbol.symbol_type,
                                    );
                                    structured_call = Option[TypedExpr].Some(
                                        make_typed_expr(
                                            TypedExprKind.Call(callee, typed_args),
                                            method_ret_type,
                                        ),
                                    );
                                },
                            };
                        },
                    };
                };
                when structured_call in {
                    .Some(call_expr) then Option[TypedExpr].Some(
                        self.wrap_receiver_materialized_call(
                            prepared_base_binding,
                            base,
                            call_expr,
                        ),
                    ),
                    .None() then Option[TypedExpr].None(),
                }
            },
            .MemberPath(...) then when self.split_typed_member_path_call_callee(
                typed_callee,
            ) in {
                .Some(parts) then {
                    let base = parts.first;
                    let method_name = parts.second;
                    let base_type = base.expr_type;
                    let normalized_base_type = base_type;
                    let trait_constraint_opt = self.find_trait_constraint_for_method(
                        base_type,
                        method_name,
                    );
                    let direct_method_signature_opt = when cached_method_sig in {
                        .Some(sig) then Option[Symbol].Some(sig),
                        .None() then self.resolve_source_method_signature(
                            base_type,
                            method_name,
                        ),
                    };
                    let trait_dispatch_requires_object = self.dispatches_via_trait_object_for_static_call(
                        normalized_base_type,
                    );
                    let is_generic_receiver = self.contains_generic_parameter(
                        normalized_base_type,
                    );
                    let expected_self_type = when trait_constraint_opt in {
                        .Some(_) then Option[Type].None(),
                        .None() then self.resolve_method_self_type(
                            base_type,
                            method_name,
                        ),
                    };
                    let mutable prepared_base_binding = cached_materialized_receiver_binding;
                    let adapted_base = when cached_adapted_base_expr in {
                        .Some(cached) then cached,
                        .None() then {
                            let prepared_base = self.prepare_call_receiver(
                                base,
                                expected_self_type,
                            );
                            prepared_base_binding = prepared_base.second;
                            cached_materialized_receiver_binding = prepared_base.second;
                            self.adapt_receiver_to_expected_self_type_for_method(
                                prepared_base.first,
                                expected_self_type,
                                method_name,
                            )
                        },
                    };
                    let inferred_method_type_args = inferred_method_type_args_for_call;
                    let method_ret_type = when ret_type in {
                        .Unknown() then when direct_method_signature_opt in {
                            .Some(method_symbol) then when method_symbol.symbol_type in {
                                .FunctionType(_, ret) then ret,
                                _ then self.resolve_method_return_type(
                                    adapted_base.expr_type,
                                    method_name,
                                ),
                            },
                            .None() then self.resolve_method_return_type(
                                adapted_base.expr_type,
                                method_name,
                            ),
                        },
                        _ then ret_type,
                    };
                    let lowered_method_symbol = when direct_method_signature_opt in {
                        .Some(method_symbol) then method_symbol,
                        .None() then self.make_method_symbol_for_receiver(
                            adapted_base.expr_type,
                            method_name,
                            method_ret_type,
                        ),
                    };
                    let mutable structured_call = Option[TypedExpr].None();
                    let should_lower_to_method_call = self.is_unresolved_expr_type(
                        base_type,
                    ) or trait_constraint_opt is .Some(_) or direct_method_signature_opt is .Some(_);
                    if should_lower_to_method_call and self.is_unresolved_expr_type(
                        base_type,
                    ) then {
                        let static_receiver_opt = self.resolve_static_receiver_type(
                            adapted_base,
                        );
                        when static_receiver_opt in {
                            .Some(receiver_type) then {
                                let mutable static_args = List[TypedExpr].new();
                                static_args.push(adapted_base);
                                for arg in typed_args then {
                                    static_args.push(arg);
                                };
                                structured_call = Option[TypedExpr].Some(
                                    make_typed_expr(
                                        TypedExprKind.StaticMethodCall(
                                            receiver_type,
                                            method_name,
                                            lowered_method_symbol,
                                            List[Type].new(),
                                            inferred_method_type_args,
                                            static_args,
                                        ),
                                        method_ret_type,
                                    ),
                                );
                            },
                            .None() then {
                                let callee = make_typed_expr(
                                    TypedExprKind.MethodReference(
                                        adapted_base,
                                        adapted_base.expr_type,
                                        lowered_method_symbol,
                                        List[Type].new(),
                                        inferred_method_type_args,
                                        .None(),
                                    ),
                                    lowered_method_symbol.symbol_type,
                                );
                                structured_call = Option[TypedExpr].Some(
                                    make_typed_expr(
                                        TypedExprKind.Call(callee, typed_args),
                                        method_ret_type,
                                    ),
                                );
                            },
                        };
                    } else if should_lower_to_method_call then {
                        when trait_constraint_opt in {
                            .Some(trait_name) then {
                                self.maybe_record_trait_method_instantiation(
                                    adapted_base.expr_type,
                                    method_name,
                                    List[Type].new(),
                                );
                                let trait_type = self.constrained_trait_object_type_for_static_call(
                                    adapted_base.expr_type,
                                    trait_name,
                                );
                                structured_call = if is_generic_receiver then {
                                    let callee = make_typed_expr(
                                        TypedExprKind.TraitMethodPlaceholder(
                                            adapted_base,
                                            trait_type,
                                            lowered_method_symbol,
                                            self.trait_method_def_id_of(
                                                trait_type,
                                                method_name,
                                            ),
                                            inferred_method_type_args,
                                            .None(),
                                        ),
                                        lowered_method_symbol.symbol_type,
                                    );
                                    Option[TypedExpr].Some(
                                        make_typed_expr(
                                            TypedExprKind.Call(callee, typed_args),
                                            method_ret_type,
                                        ),
                                    )
                                } else if trait_dispatch_requires_object then {
                                    if self.trait_vtable_method_index_for_type(
                                        trait_type,
                                        method_name,
                                    ) is .Some(method_index) then {
                                        Option[TypedExpr].Some(
                                            make_typed_expr(
                                                TypedExprKind.TraitMethodCall(
                                                    self.trait_method_call_receiver(
                                                        adapted_base,
                                                    ),
                                                    trait_type,
                                                    method_name,
                                                    method_index,
                                                    typed_args,
                                                ),
                                                method_ret_type,
                                            ),
                                        )
                                    } else {
                                        let callee = make_typed_expr(
                                            TypedExprKind.TraitMethodPlaceholder(
                                                adapted_base,
                                                trait_type,
                                                lowered_method_symbol,
                                                self.trait_method_def_id_of(
                                                    trait_type,
                                                    method_name,
                                                ),
                                                inferred_method_type_args,
                                                .None(),
                                            ),
                                            lowered_method_symbol.symbol_type,
                                        );
                                        Option[TypedExpr].Some(
                                            make_typed_expr(
                                                TypedExprKind.Call(callee, typed_args),
                                                method_ret_type,
                                            ),
                                        )
                                    }
                                } else {
                                    let callee = make_typed_expr(
                                        TypedExprKind.MethodReference(
                                            adapted_base,
                                            adapted_base.expr_type,
                                            lowered_method_symbol,
                                            List[Type].new(),
                                            inferred_method_type_args,
                                            .None(),
                                        ),
                                        lowered_method_symbol.symbol_type,
                                    );
                                    Option[TypedExpr].Some(
                                        make_typed_expr(
                                            TypedExprKind.Call(callee, typed_args),
                                            method_ret_type,
                                        ),
                                    )
                                };
                            },
                            .None() then {
                                when self.trait_object_type_for_static_call(
                                    normalized_base_type,
                                ) in {
                                    .Some(trait_type) then {
                                        if self.trait_type_declares_static_call_method(
                                            trait_type,
                                            method_name,
                                        ) then {
                                            let callee = make_typed_expr(
                                                TypedExprKind.TraitMethodPlaceholder(
                                                    adapted_base,
                                                    trait_type,
                                                    lowered_method_symbol,
                                                    self.trait_method_def_id_of(
                                                        trait_type,
                                                        method_name,
                                                    ),
                                                    inferred_method_type_args,
                                                    .None(),
                                                ),
                                                lowered_method_symbol.symbol_type,
                                            );
                                            structured_call = Option[TypedExpr].Some(
                                                make_typed_expr(
                                                    TypedExprKind.Call(
                                                        callee,
                                                        typed_args,
                                                    ),
                                                    method_ret_type,
                                                ),
                                            );
                                        } else {
                                            let callee = make_typed_expr(
                                                TypedExprKind.MethodReference(
                                                    adapted_base,
                                                    adapted_base.expr_type,
                                                    lowered_method_symbol,
                                                    List[Type].new(),
                                                    inferred_method_type_args,
                                                    .None(),
                                                ),
                                                lowered_method_symbol.symbol_type,
                                            );
                                            structured_call = Option[TypedExpr].Some(
                                                make_typed_expr(
                                                    TypedExprKind.Call(
                                                        callee,
                                                        typed_args,
                                                    ),
                                                    method_ret_type,
                                                ),
                                            );
                                        };
                                    },
                                    .None() then if not self.dispatches_via_trait_object_for_static_call(
                                        normalized_base_type,
                                    ) then {
                                        let callee = make_typed_expr(
                                            TypedExprKind.MethodReference(
                                                adapted_base,
                                                adapted_base.expr_type,
                                                lowered_method_symbol,
                                                List[Type].new(),
                                                inferred_method_type_args,
                                                .None(),
                                            ),
                                            lowered_method_symbol.symbol_type,
                                        );
                                        structured_call = Option[TypedExpr].Some(
                                            make_typed_expr(
                                                TypedExprKind.Call(callee, typed_args),
                                                method_ret_type,
                                            ),
                                        );
                                    },
                                };
                            },
                        };
                    };
                    when structured_call in {
                        .Some(call_expr) then Option[TypedExpr].Some(
                            self.wrap_receiver_materialized_call(
                                prepared_base_binding,
                                base,
                                call_expr,
                            ),
                        ),
                        .None() then Option[TypedExpr].None(),
                    }
                },
                .None() then Option[TypedExpr].None(),
            },
            _ then when typed_callee.expr_kind in {
                .TraitMethodPlaceholder(receiver, trait_type, method, _, method_type_args, _) then {
                    let trait_name = self.trait_name_from_type(trait_type);
                    let method_name = self.semantic_method_name_for_symbol(method);
                    let mutable expected_self_type = self.resolve_trait_method_self_type(
                        self.trait_def_id_from_type(trait_type),
                        method_name,
                        receiver.expr_type,
                    );
                    let prepared_receiver = self.prepare_call_receiver(
                        receiver,
                        expected_self_type,
                    );
                    let adapted_receiver = self.adapt_receiver_to_expected_self_type_for_method(
                        prepared_receiver.first,
                        expected_self_type,
                        method_name,
                    );
                    self.maybe_record_trait_method_instantiation(
                        adapted_receiver.expr_type,
                        method_name,
                        List[Type].new(),
                    );
                    let adjusted_callee = make_typed_expr(
                        TypedExprKind.TraitMethodPlaceholder(
                            adapted_receiver,
                            trait_type,
                            method,
                            self.trait_method_def_id_of(trait_type, method_name),
                            method_type_args,
                            .None(),
                        ),
                        method.symbol_type,
                    );
                    let call_expr = make_typed_expr(
                        TypedExprKind.Call(adjusted_callee, typed_args),
                        ret_type,
                    );
                    Option[TypedExpr].Some(
                        self.wrap_receiver_materialized_call(
                            prepared_receiver.second,
                            receiver,
                            call_expr,
                        ),
                    )
                },
                .TraitMethodCall(receiver, trait_type, method_name, method_index, _) then {
                    let expected_self_type = when trait_type in {
                        // The DECLARATION travels; the spelling is display-only.
                        .TraitObject(trait_def_id, _) then self.resolve_trait_method_self_type(
                            trait_def_id,
                            method_name,
                            receiver.expr_type,
                        ),
                        _ then Option[Type].None(),
                    };
                    let prepared_receiver = self.prepare_call_receiver(
                        receiver,
                        expected_self_type,
                    );
                    let adapted_receiver = self.adapt_receiver_to_expected_self_type_for_method(
                        prepared_receiver.first,
                        expected_self_type,
                        method_name,
                    );
                    self.maybe_record_trait_method_instantiation(
                        adapted_receiver.expr_type,
                        method_name,
                        List[Type].new(),
                    );
                    let call_expr = make_typed_expr(
                        TypedExprKind.TraitMethodCall(
                            adapted_receiver,
                            trait_type,
                            method_name,
                            method_index,
                            typed_args,
                        ),
                        ret_type,
                    );
                    Option[TypedExpr].Some(
                        self.wrap_receiver_materialized_call(
                            prepared_receiver.second,
                            receiver,
                            call_expr,
                        ),
                    )
                },
                _ then Option[TypedExpr].None(),
            },
        };
        let result = when structured_call_opt in {
            .Some(structured_call) then structured_call,
            .None() then if typed_callee.expr_type is not .FunctionType(...) then {
                when callee in {
                    .MemberPath(base_expr, path, _) then if not path.is_empty() then self.missing_member_call_expr(
                        typed_callee,
                        typed_args,
                        base_expr,
                        path[path.count() - 1],
                        scope,
                    )
                    else make_typed_expr(
                        TypedExprKind.Call(typed_callee, typed_args),
                        ret_type,
                    ),
                    _ then make_typed_expr(
                        TypedExprKind.Call(typed_callee, typed_args),
                        ret_type,
                    ),
                }
            } else make_typed_expr(
                TypedExprKind.Call(typed_callee, typed_args),
                ret_type,
            ),
        };
        return result;
    };

    infer_generic_struct_constructor_return_type_for_def_id(
        self,
        template_def_id: DefId,
        typed_args: List[TypedExpr],
        call_span: SourceSpan,
    ): Option[Type] = {
        let fields = self.context().get_struct_fields(template_def_id) or else {
            return Option[Type].None();
        };
        let type_parameter_names = self.generic_struct_type_parameter_names(
            template_def_id,
        );
        if type_parameter_names.is_empty() then {
            return Option[Type].None();
        };
        let mutable bindings = Dict[String, Type].new();
        let mutable field_index: UInt = 0;
        let field_limit = if fields.count() < typed_args.count() then fields.count()
        else typed_args.count();
        while field_index < field_limit then {
            let field = fields[field_index];
            let mutable arg_type = self.concretize_default_literal_type(
                typed_args[field_index].expr_type,
            );
            self.infer_type_bindings(field.field_type, arg_type, bindings);
            field_index += 1;
        };
        let mutable resolved_args = List[Type].new();
        for type_param_name in type_parameter_names then {
            // A binding of a parameter to ITSELF learns nothing -- the
            // pointee of a joined pointer literal being the parameter itself
            // -- so it counts as unbound here.
            let bound_ok = when bindings.get(type_param_name) in {
                .None() then false,
                .Some(bound_type) then when bound_type in {
                    .GenericParameter(bound_name) then bound_name != type_param_name,
                    _ then true,
                },
            };
            if not bound_ok then {
                // Every type parameter needs a value from the arguments: an
                // unbound one is the ordinary missing-inference error.
                if not self.storage.diagnostics.has_error_at(
                    self.storage.file_path,
                    call_span,
                ) then {
                    self.push_diagnostic_at_span(
                        "Type mismatch: expected inferred type for \(type_param_name), got unknown",
                        call_span,
                    );
                };
                return Option[Type].None();
            };
            when bindings.get(type_param_name) in {
                .Some(bound_type) then resolved_args.push(bound_type),
                .None() then {
                    return Option[Type].None();
                },
            };
        };
        return Option[Type].Some(Type.GenericStruct(template_def_id, resolved_args));
    };

    infer_generic_struct_constructor_return_type(
        self,
        callee: Expr,
        typed_args: List[TypedExpr],
    ): Option[Type] = {
        return when callee in {
            .Identifier(name, _) then {
                let local_type = self.lookup_current_file_type_symbol(name);
                let template_def_id = when local_type in {
                    .Some(type_ref) then when type_ref in {
                        .StructureType(def_id) then def_id,
                        _ then self.storage.generic_templates.lookup_struct_def_id(name),
                    },
                    _ then self.storage.generic_templates.lookup_struct_def_id(name),
                };
                self.infer_generic_struct_constructor_return_type_for_def_id(
                    template_def_id,
                    typed_args,
                    expr_span(callee),
                )
            },
            _ then Option[Type].None(),
        };
    };
};
