given TypeChecker {
    module_private spans_equal(self, left SourceSpan, right SourceSpan) Bool = {
        let _ = self;
        return left.start.line == right.start.line and left.start.column == right.start.column and left.end.line == right.end.line and left.end.column == right.end.column;
    };

    /// Whether this exact problem has already been recorded anywhere in the run.
    ///
    /// Looking only at the head of the list is not enough: a repeat separated
    /// from its original by another diagnostic is still a repeat.
    module_private already_reported_diagnostic(self, message String, span SourceSpan) Bool = {
        return self.storage.diagnostics.has_error(self.storage.file_path, message, span);
    };

    module_private trait_missing_constraint_message(
        self,
        bound_type Type,
        constraint_param String,
        constraint String,
    ) String = {
        let mutable msg = StringBuilder.new();
        msg.push_string("Type ");
        msg.push_string(self.context().type_display_name(bound_type));
        msg.push_string(" does not explicitly implement trait ");
        msg.push_string(constraint);
        if not constraint_param.is_empty() then {
            msg.push_string(" (checking constraint ");
            msg.push_string(constraint_param);
            msg.push_string(": ");
            msg.push_string(constraint);
            msg.push_string(")");
        };
        return msg.to_string();
    };

    /// `note` says WHY the trait is needed -- `(operator 'equals')`. It is
    /// what tells the reader which construct demanded the trait; without it
    /// the message names a requirement and leaves the cause unstated.
    module_private trait_missing_conformance_message(
        self,
        target_type Type,
        trait_name String,
        trait_args List[Type],
        note String,
    ) String = {
        let mutable msg = StringBuilder.new();
        msg.push_string("Type ");
        msg.push_string(self.context().type_display_name(target_type));
        msg.push_string(" does not explicitly implement trait ");
        if not trait_args.is_empty() then {
            let mutable args_display = StringBuilder.new();
            let mutable first = true;
            for arg in trait_args then {
                if not first then {
                    args_display.push_string(", ");
                };
                args_display.push_string(self.context().type_display_name(arg));
                first = false;
            };
            msg.push_string("[");
            msg.push_string(args_display.to_string());
            msg.push_string("]");
        };
        msg.push_string(trait_name);
        if not note.is_empty() then {
            msg.push_string(" (");
            msg.push_string(note);
            msg.push_string(")");
        };
        return msg.to_string();
    };

    module_private trait_requirement_missing_constraint_message(
        self,
        target_type Type,
        trait_name String,
        bound_type Type,
        constraint String,
    ) String = {
        let mutable msg = StringBuilder.new();
        msg.push_string("Type '");
        msg.push_string(self.context().type_display_name(target_type));
        msg.push_string("' does not satisfy trait '");
        msg.push_string(trait_name);
        msg.push_string("' because inner type '");
        msg.push_string(self.context().type_display_name(bound_type));
        msg.push_string("' does not implement '");
        msg.push_string(constraint);
        msg.push_string("'");
        return msg.to_string();
    };

    module_private trait_requirement_missing_blanket_given_message(
        self,
        target_type Type,
        trait_name String,
        modifier_name String,
    ) String = {
        let mutable msg = StringBuilder.new();
        msg.push_string("Type '");
        msg.push_string(self.context().type_display_name(target_type));
        msg.push_string("' does not satisfy trait '");
        msg.push_string(trait_name);
        msg.push_string("'. No blanket given exists for '");
        msg.push_string(modifier_name);
        msg.push_string("' and '");
        msg.push_string(trait_name);
        msg.push_string("'");
        return msg.to_string();
    };

    /// Whether the type parameter `name` was itself declared `T foreign`.
    module_private generic_param_is_foreign_bounded(self, name String) Bool = {
        return when self.storage.generic_param_shape_bounds.get(name) in {
            .Some(bounds) then {
                for bound in bounds then {
                    when bound in {
                        .Foreign() then {
                            return true;
                        },
                        _ then {},
                    };
                };
                false
            },
            .None() then false,
        };
    };

    /// Whether `target_type`'s representation is fixed outside Koral's layout
    /// freedom and may therefore cross the FFI boundary.
    ///
    /// A CLOSED set, decided by the compiler and not claimable by any user
    /// declaration: the built-in scalars (including std's `Rune`), raw pointers,
    /// and `foreign type` declarations. A Koral `type` is not in it -- its
    /// layout is chosen by the compiler, so a raw pointer to one carries no
    /// meaning across the boundary. Write `foreign type` for a struct whose
    /// layout is the C one. See `docs/design/type-semantics.md`.
    module_private satisfies_foreign_constraint(self, target_type Type) Bool = {
        return when target_type in {
            .IntType() or .Int8Type() or .Int16Type() or .Int32Type() or .Int64Type() or .UIntType() or .UInt8Type() or .UInt16Type() or .UInt32Type() or .UInt64Type() or .Float32Type() or .Float64Type() or .BoolType() then true,
            .PointerType(_) or .MutablePointerType(_) then true,
            .StructureType(def_id) then {
                if self.context().is_foreign_struct(def_id) then {
                    true
                } else {
                    // std's `Rune` is the one nominal type in the `foreign`
                    // set: nominal only so it can carry methods, with the fixed
                    // Unicode scalar representation. Identity only.
                    is_std_rune_def_id(self.context(), def_id)
                }
            },
            .GenericParameter(name) then self.generic_param_is_foreign_bounded(name),
            _ then false,
        };
    };

    module_private foreign_constraint_violation_message(
        self,
        target_type Type,
        context String,
    ) String = {
        let mutable msg = StringBuilder.new();
        msg.push_string("Type '");
        msg.push_string(self.context().type_display_name(target_type));
        msg.push_string("' does not satisfy the 'foreign' constraint");
        if not context.is_empty() then {
            msg.push_string(" (");
            msg.push_string(context);
            msg.push_string(")");
        };
        msg.push_string(
            ". Only built-in scalars, raw pointers and 'foreign type' declarations cross the FFI boundary.",
        );
        return msg.to_string();
    };

    module_private mutable_constraint_violation_message(
        self,
        target_type Type,
        context String,
    ) String = {
        let mutable msg = StringBuilder.new();
        msg.push_string("Type '");
        msg.push_string(self.context().type_display_name(target_type));
        msg.push_string("' does not satisfy the 'mutable' constraint");
        if not context.is_empty() then {
            msg.push_string(" (");
            msg.push_string(context);
            msg.push_string(")");
        };
        msg.push_string(
            ". Only types declared with 'type mutable' can be used as weak references.",
        );
        return msg.to_string();
    };

    /// Whether the type parameter `name` was itself declared `T mutable`.
    /// A bare `T` gets no free pass -- otherwise `f[T Any]` could satisfy a
    /// `g[T mutable]` requirement by forwarding its own unconstrained `T`.
    module_private generic_param_is_mutable_bounded(self, name String) Bool = {
        return when self.storage.generic_param_shape_bounds.get(name) in {
            .Some(bounds) then {
                for bound in bounds then {
                    when bound in {
                        .Mutable() then {
                            return true;
                        },
                        _ then {},
                    };
                };
                false
            },
            .None() then false,
        };
    };

    module_private satisfies_mutable_constraint(self, target_type Type) Bool = {
        return when target_type in {
            .StructureType(def_id) then self.context().def_id_map.is_struct_mutable(
                def_id,
            ),
            // Identity: the template's DECLARATION decides mutability.
            .GenericStruct(template_def_id, _) then self.context().def_id_map.is_struct_mutable(
                template_def_id,
            ),
            .GenericParameter(name) then self.generic_param_is_mutable_bounded(name),
            _ then false,
        };
    };

    module_private is_upper_first_char(self, s String) Bool = {
        if s.is_empty() then {
            return false;
        };
        when s.get(0) in {
            .Some(c) then {
                return c >= 'A' and c <= 'Z';
            },
            .None() then {
                return false;
            },
        };
    };

    module_private make_visibility_checker(self) Option[VisibilityChecker] = {
        return when self.storage.import_graph in {
            .Some(graph) then Option[VisibilityChecker].Some(
                VisibilityChecker.new(
                    graph,
                    self.storage.module_path,
                    self.storage.file_path,
                ),
            ),
            .None() then Option[VisibilityChecker].None(),
        };
    };

    /// `span` is where the type is written. A message about the type belongs
    /// at the spelling, not at whatever declaration happens to carry it.
    module_private check_type_visibility(
        self,
        t Type,
        type_name String,
        scope Scope,
        span SourceSpan,
    ) Void = {
        if self.make_visibility_checker() is .Some(checker) then {
            let is_local_binding = scope.is_local_type_binding(type_name);
            let is_generic_param = scope.is_generic_param(type_name);
            when checker.check_type(
                t,
                type_name,
                self.context(),
                is_local_binding,
                is_generic_param,
            ) in {
                .Ok(_) then {},
                .Error(message) then {
                    self.push_diagnostic(message.message(), span);
                },
            };
        };
    };

    /// `span` is where the symbol is USED. The message names the symbol and
    /// tells the reader to import it -- pointing anywhere but the use leaves
    /// them searching the file for the thing they must add a `using` for.
    module_private check_symbol_visibility(self, sym Symbol, span SourceSpan) Void = {
        if self.make_visibility_checker() is .Some(checker) and self.context().get_module_path(
            sym.def_id,
        ) is .Some(module_path) then {
            when checker.check_symbol(module_path, self.context().symbol_name(sym), false) in {
                .Ok(_) then {},
                .Error(message) then {
                    self.push_diagnostic(message.message(), span);
                },
            };
        };
    };

    module_private signature_visibility_level(self, access AccessModifier) Int = {
        let _ = self;
        return when access in {
            .FilePrivate() then 0,
            .ModulePrivate() then 1,
            .PackagePrivate() then 2,
            .Public() then 3,
        };
    };

    module_private first_signature_visibility_violation(
        self,
        t Type,
        required_access AccessModifier,
    ) Option[Pair[String, AccessModifier]] = {
        return when t in {
            .StructureType(def_id) then {
                when self.context().get_access(def_id) in {
                    .Some(type_access) then {
                        if self.signature_visibility_level(type_access) < self.signature_visibility_level(
                            required_access,
                        ) then {
                            let type_name = self.context().get_name(def_id) or else self.context(
                            ).type_display_name(t);
                            return Option[Pair[String, AccessModifier]].Some(
                                Pair[String, AccessModifier](type_name, type_access),
                            );
                        };
                        Option[Pair[String, AccessModifier]].None()
                    },
                    .None() then Option[Pair[String, AccessModifier]].None(),
                }
            },
            .EnumType(def_id) then {
                when self.context().get_access(def_id) in {
                    .Some(type_access) then {
                        if self.signature_visibility_level(type_access) < self.signature_visibility_level(
                            required_access,
                        ) then {
                            let type_name = self.context().get_name(def_id) or else self.context(
                            ).type_display_name(t);
                            return Option[Pair[String, AccessModifier]].Some(
                                Pair[String, AccessModifier](type_name, type_access),
                            );
                        };
                        Option[Pair[String, AccessModifier]].None()
                    },
                    .None() then Option[Pair[String, AccessModifier]].None(),
                }
            },
            .OpaqueType(def_id) then {
                when self.context().get_access(def_id) in {
                    .Some(type_access) then {
                        if self.signature_visibility_level(type_access) < self.signature_visibility_level(
                            required_access,
                        ) then {
                            let type_name = self.context().get_name(def_id) or else self.context(
                            ).type_display_name(t);
                            return Option[Pair[String, AccessModifier]].Some(
                                Pair[String, AccessModifier](type_name, type_access),
                            );
                        };
                        Option[Pair[String, AccessModifier]].None()
                    },
                    .None() then Option[Pair[String, AccessModifier]].None(),
                }
            },
            .ReferenceType(inner) then self.first_signature_visibility_violation(
                inner,
                required_access,
            ),
            .MutableReferenceType(inner) then self.first_signature_visibility_violation(
                inner,
                required_access,
            ),
            .BorrowedReferenceType(inner) then self.first_signature_visibility_violation(
                inner,
                required_access,
            ),
            .MutableBorrowedReferenceType(inner) then self.first_signature_visibility_violation(
                inner,
                required_access,
            ),
            .PointerType(inner) then self.first_signature_visibility_violation(
                inner,
                required_access,
            ),
            .MutablePointerType(inner) then self.first_signature_visibility_violation(
                inner,
                required_access,
            ),
            .WeakReferenceType(inner) then self.first_signature_visibility_violation(
                inner,
                required_access,
            ),
            .MutableWeakReferenceType(inner) then self.first_signature_visibility_violation(
                inner,
                required_access,
            ),
            .FunctionType(params, return_type) then {
                for param in params then {
                    when self.first_signature_visibility_violation(
                        param.param_type,
                        required_access,
                    ) in {
                        .Some(violation) then {
                            return .Some(violation);
                        },
                        .None() then {},
                    };
                };
                self.first_signature_visibility_violation(return_type, required_access)
            },
            .GenericStruct(_, args) then {
                for arg in args then {
                    when self.first_signature_visibility_violation(arg, required_access) in {
                        .Some(violation) then {
                            return Option[Pair[String, AccessModifier]].Some(violation);
                        },
                        .None() then {},
                    };
                };
                Option[Pair[String, AccessModifier]].None()
            },
            .GenericEnum(_, args) then {
                for arg in args then {
                    when self.first_signature_visibility_violation(arg, required_access) in {
                        .Some(violation) then {
                            return Option[Pair[String, AccessModifier]].Some(violation);
                        },
                        .None() then {},
                    };
                };
                Option[Pair[String, AccessModifier]].None()
            },
            .TraitObject(_, type_args) then {
                for arg in type_args then {
                    when self.first_signature_visibility_violation(arg, required_access) in {
                        .Some(violation) then {
                            return Option[Pair[String, AccessModifier]].Some(violation);
                        },
                        .None() then {},
                    };
                };
                Option[Pair[String, AccessModifier]].None()
            },
            _ then Option[Pair[String, AccessModifier]].None(),
        };
    };

    module_private validate_signature_type_visibility(
        self,
        symbol_name String,
        symbol_access AccessModifier,
        signature_types List[Type],
        span SourceSpan,
    ) Void = {
        if symbol_access is .FilePrivate() then {
            return;
        };
        for t in signature_types then {
            when self.first_signature_visibility_violation(t, symbol_access) in {
                .Some(violation) then {
                    let symbol_text = when symbol_access in {
                        .FilePrivate() then "file_private",
                        .ModulePrivate() then "module_private",
                        .PackagePrivate() then "package_private",
                        .Public() then "public",
                    };
                    let type_text = when violation.second in {
                        .FilePrivate() then "file_private",
                        .ModulePrivate() then "module_private",
                        .PackagePrivate() then "package_private",
                        .Public() then "public",
                    };
                    let message = "\(symbol_text) symbol '\(symbol_name)' uses \(type_text) type '\(violation.first)' in its signature";
                    if not self.already_reported_diagnostic(message, span) then {
                        self.push_diagnostic_at_span(message, span);
                    };
                    return;
                },
                .None() then {},
            };
        };
    };

    module_private ensure_generic_template_visible(
        self,
        template_name String,
        template_def_id DefId,
        span SourceSpan,
    ) Bool = {
        let access = self.context().get_access(template_def_id) or else AccessModifier.ModulePrivate(
        );
        let module_path = self.context().get_module_path(template_def_id) or else List[String].new(
        );

        let access_allowed = when access in {
            .Public() then true,
            .FilePrivate() then {
                let def_source_file = self.context().get_source_file(template_def_id) or else "";
                def_source_file == self.storage.file_path
            },
            .ModulePrivate() then string_list_eq(module_path, self.storage.module_path),
            .PackagePrivate() then {
                let def_package_id = self.context().get_package_id(template_def_id) or else "";
                not self.storage.package_id.is_empty() and def_package_id == self.storage.package_id
            },
        };

        if not access_allowed then {
            let message = "Undefined type: \(template_name)";
            if not self.already_reported_diagnostic(message, span) then {
                self.push_diagnostic_at_span(message, span);
            };
            return false;
        };

        if module_path.is_empty() or string_list_eq(
            module_path,
            self.storage.module_path,
        ) then {
            return true;
        };

        if self.make_visibility_checker() is .Some(checker) then {
            return when checker.check_symbol(module_path, template_name, false) in {
                .Ok(_) then true,
                .Error(message) then {
                    if not self.already_reported_diagnostic(message.message(), span) then {
                        self.push_diagnostic_at_span(message.message(), span);
                    };
                    false
                },
            };
        };

        return true;
    };

    module_private is_field_accessible_from_current_context(
        self,
        field_access AccessModifier,
        def_id DefId,
    ) Bool = {
        return when field_access in {
            .Public() then true,
            .FilePrivate() then {
                let def_source_file = self.context().get_source_file(def_id) or else "";
                def_source_file == self.storage.file_path
            },
            .ModulePrivate() then {
                let def_module_path = self.context().get_module_path(def_id) or else List[String].new(
                );
                string_list_eq(def_module_path, self.storage.module_path)
            },
            .PackagePrivate() then {
                let def_package_id = self.context().get_package_id(def_id) or else "";
                not self.storage.package_id.is_empty() and def_package_id == self.storage.package_id
            },
        };
    };

    module_private is_method_accessible_from_current_context(self, method Symbol) Bool = {
        if self.storage.generic_templates.receiver_method_dispatch.get(method.def_id) is .Some(info) and info.conformance_trait_name is .Some(_) then {
            return true;
        };
        return when self.context().get_access(method.def_id) in {
            .Some(access) then when access in {
                .Public() then true,
                .FilePrivate() then {
                    let def_source_file = self.context().get_source_file(method.def_id) or else "";
                    def_source_file == self.storage.file_path
                },
                .ModulePrivate() then {
                    let def_module_path = self.context().get_module_path(method.def_id) or else List[String].new(
                    );
                    string_list_eq(def_module_path, self.storage.module_path)
                },
                .PackagePrivate() then {
                    let def_package_id = self.context().get_package_id(method.def_id) or else "";
                    not self.storage.package_id.is_empty() and def_package_id == self.storage.package_id
                },
            },
            .None() then true,
        };
    };

    module_private reject_inaccessible_method_from_current_context(
        self,
        method Symbol,
        method_name String,
        span SourceSpan,
    ) Bool = {
        return when self.context().get_access(method.def_id) in {
            .Some(access) then {
                if self.is_method_accessible_from_current_context(method) then {
                    return false;
                };
                let access_label = when access in {
                    .FilePrivate() then "file_private",
                    .ModulePrivate() then "module_private",
                    .PackagePrivate() then "package_private",
                    .Public() then "public",
                };
                let message = "Cannot access \(access_label) method '\(method_name)'";
                if not self.already_reported_diagnostic(message, span) then {
                    self.push_diagnostic_at_span(message, span);
                };
                true
            },
            .None() then false,
        };
    };

    /// Whether every field of `def_id` is visible here, so the type may be
    /// constructed directly. False means it may not, and the value that would
    /// have been built has no type: the caller must poison the result, or the
    /// next line of the program gets checked against a value that cannot exist.
    module_private ensure_struct_construction_access(
        self,
        type_name String,
        def_id DefId,
        span SourceSpan,
    ) Bool = {
        when self.context().get_struct_fields(def_id) in {
            .Some(fields) then {
                for field in fields then {
                    if not self.is_field_accessible_from_current_context(
                        field.access,
                        def_id,
                    ) then {
                        let access_label = when field.access in {
                            .FilePrivate() then "file_private",
                            .PackagePrivate() then "package_private",
                            _ then "module_private",
                        };
                        self.push_diagnostic(
                            "Cannot directly construct type '\(type_name)' because field '\(field.name)' is \(access_label). Use a public factory method instead.",
                            span,
                        );
                        return false;
                    };
                };
            },
            .None() then {},
        };
        return true;
    };

    // 声明身份查找：用 `allocate_full` 注册时建的 (module, name, source_file) 键表，
    // O(1)。不做「按名字扫全部 DefId」——那既是热路径上的性能黑洞，也违反
    // 「身份判定走 DefId、名字只作索引键」的约定。
    module_private lookup_current_file_def_id(self, name String) Option[DefId] = {
        return self.context().lookup_def_id(
            self.storage.module_path,
            name,
            Option[String].Some(self.storage.file_path),
        );
    };

    module_private lookup_current_file_symbol(self, name String) Option[Symbol] = {
        return when self.lookup_current_file_def_id(name) in {
            .Some(def_id) then self.symbol_for_def_id(def_id),
            .None() then Option[Symbol].None(),
        };
    };

    /// The `Type` a DECLARATION denotes, built from its recorded kind.
    ///
    /// An imported generic TEMPLATE has no `symbol_type` -- it is a declaration
    /// waiting for type arguments, not a monomorphic value -- so reading
    /// `get_symbol_type` alone loses it and the lookup falls through to a
    /// last-wins name table. This is the same construction
    /// `lookup_current_file_type_symbol` does.
    module_private type_for_declared_def_id(self, def_id DefId) Option[Type] = {
        return when self.context().get_kind(def_id) in {
            .Some(kind) then when kind in {
                .TypeDef(type_kind) then when type_kind in {
                    .Structure() then Option[Type].Some(Type.StructureType(def_id)),
                    .Enum() then Option[Type].Some(Type.EnumType(def_id)),
                    .Opaque() then Option[Type].Some(Type.OpaqueType(def_id)),
                    .Trait() then Option[Type].Some(
                        Type.TraitObject(def_id, List[Type].new()),
                    ),
                },
                .GenericTemplate(template_kind) then when template_kind in {
                    .Structure() then Option[Type].Some(Type.StructureType(def_id)),
                    .Enum() then Option[Type].Some(Type.EnumType(def_id)),
                    _ then Option[Type].None(),
                },
                _ then Option[Type].None(),
            },
            .None() then self.context().get_symbol_type(def_id),
        };
    };

    module_private lookup_current_file_type_symbol(self, name String) Option[Type] = {
        return when self.lookup_current_file_def_id(name) in {
            .Some(def_id) then when self.context().get_kind(def_id) in {
                .Some(kind) then when kind in {
                    .TypeDef(type_kind) then when type_kind in {
                        .Structure() then Option[Type].Some(Type.StructureType(def_id)),
                        .Enum() then Option[Type].Some(Type.EnumType(def_id)),
                        .Opaque() then Option[Type].Some(Type.OpaqueType(def_id)),
                        .Trait() then {
                            let trait_name = self.context().get_name(def_id) or else name;
                            Option[Type].Some(
                                Type.TraitObject(def_id, List[Type].new()),
                            )
                        },
                    },
                    .GenericTemplate(template_kind) then when template_kind in {
                        .Structure() then Option[Type].Some(Type.StructureType(def_id)),
                        .Enum() then Option[Type].Some(Type.EnumType(def_id)),
                        _ then Option[Type].None(),
                    },
                    _ then Option[Type].None(),
                },
                .None() then Option[Type].None(),
            },
            .None() then Option[Type].None(),
        };
    };

    module_private symbol_for_def_id(self, def_id DefId) Option[Symbol] = {
        return when self.context().get_name(def_id) in {
            .Some(name) then {
                let kind_opt = self.context().get_kind(def_id);
                let mutable symbol_type = when self.context().get_symbol_type(def_id) in {
                    .Some(t) then t,
                    .None() then when kind_opt in {
                        .Some(kind) then when kind in {
                            .TypeDef(type_kind) then when type_kind in {
                                .Structure() then Type.StructureType(def_id),
                                .Enum() then Type.EnumType(def_id),
                                .Opaque() then Type.OpaqueType(def_id),
                                .Trait() then Type.TraitObject(def_id, List[Type].new()),
                            },
                            .GenericTemplate(template_kind) then when template_kind in {
                                .Structure() then Type.StructureType(def_id),
                                .Enum() then Type.EnumType(def_id),
                                _ then Type.Unknown(),
                            },
                            _ then Type.Unknown(),
                        },
                        .None() then Type.Unknown(),
                    },
                };
                let symbol_kind = when self.context().get_symbol_kind(def_id) in {
                    .Some(kind) then kind,
                    .None() then when kind_opt in {
                        .Some(kind) then when kind in {
                            .Function() then SymbolKind.Function(),
                            .Variable() then SymbolKind.Variable(VariableKind.Value()),
                            .TypeDef(_) then SymbolKind.TypeSymbol(),
                            .GenericTemplate(template_kind) then when template_kind in {
                                .Function() then SymbolKind.Function(),
                                _ then SymbolKind.TypeSymbol(),
                            },
                            _ then SymbolKind.Variable(VariableKind.Value()),
                        },
                        .None() then SymbolKind.Variable(VariableKind.Value()),
                    },
                };
                Option[Symbol].Some(Symbol(def_id, symbol_type, symbol_kind))
            },
            .None() then Option[Symbol].None(),
        };
    };

    module_private imported_alias_original_name(self, alias String) Option[String] = {
        return when self.storage.import_graph in {
            .Some(graph) then {
                let current_module = self.storage.module_path;
                let current_file = Option[String].Some(self.storage.file_path);
                when graph.symbol_import_candidates(alias) in {
                    .Some(candidates) then {
                        // 候选按 symbol_imports 的顺序排列，这里倒序遍历以保持
                        // 「同名多条时取靠后者」的既有语义。
                        let mutable index Int = candidates.count()(Int);
                        while index > 0 then {
                            index -= 1;
                            let entry = candidates[index(UInt)];
                            if string_list_eq(entry.module, current_module) and source_file_matches(
                                entry.source_file,
                                current_file,
                            ) and entry.symbol == alias then {
                                return Option[String].Some(entry.original_symbol);
                            };
                        };
                    },
                    .None() then {},
                };
                Option[String].None()
            },
            .None() then Option[String].None(),
        };
    };

    module_private resolve_imported_alias_symbol(self, alias String) Option[Symbol] = {
        return when self.storage.import_graph in {
            .Some(graph) then {
                let current_module = self.storage.module_path;
                let current_file = Option[String].Some(self.storage.file_path);
                when graph.symbol_import_candidates(alias) in {
                    .Some(candidates) then {
                        let mutable index Int = candidates.count()(Int);
                        while index > 0 then {
                            index -= 1;
                            let entry = candidates[index(UInt)];
                            if string_list_eq(entry.module, current_module) and source_file_matches(
                                entry.source_file,
                                current_file,
                            ) and entry.symbol == alias then {
                                return when self.context().lookup_def_id(
                                    entry.target,
                                    entry.original_symbol,
                                    Option[String].None(),
                                ) in {
                                    .Some(def_id) then self.context().get_symbol(def_id),
                                    .None() then Option[Symbol].None(),
                                };
                            };
                        };
                    },
                    .None() then {},
                };
                Option[Symbol].None()
            },
            .None() then Option[Symbol].None(),
        };
    };

    module_private resolve_imported_alias_type(self, alias String) Option[Type] = {
        return when self.storage.import_graph in {
            .Some(graph) then {
                let current_module = self.storage.module_path;
                let current_file = Option[String].Some(self.storage.file_path);
                when graph.symbol_import_candidates(alias) in {
                    .Some(candidates) then {
                        let mutable index Int = candidates.count()(Int);
                        while index > 0 then {
                            index -= 1;
                            let entry = candidates[index(UInt)];
                            if string_list_eq(entry.module, current_module) and source_file_matches(
                                entry.source_file,
                                current_file,
                            ) and entry.symbol == alias then {
                                return when self.context().lookup_def_id(
                                    entry.target,
                                    entry.original_symbol,
                                    Option[String].None(),
                                ) in {
                                    .Some(def_id) then self.type_for_declared_def_id(
                                        def_id,
                                    ),
                                    .None() then Option[Type].None(),
                                };
                            };
                        };
                    },
                    .None() then {},
                };
                Option[Type].None()
            },
            .None() then Option[Type].None(),
        };
    };

    /// Build the conformance key. Name -> declaration identity happens here,
    /// once, and every record and lookup goes through this function, so both
    /// sides always agree on the identity.
    module_private trait_conformance_key(
        self,
        target_type Type,
        trait_name String,
        trait_arg_types List[Type],
    ) ExplicitTraitConformanceKey = {
        let def_id = self.trait_def_id_of(trait_name) or else DefId(0(UInt));
        return ExplicitTraitConformanceKey(
            target_type,
            def_id,
            trait_name,
            trait_arg_types,
        );
    };

    module_private trait_args_match(self, expected List[Type], actual List[Type]) Bool = {
        let _ = self;
        if not (expected.count() == actual.count()) then {
            return false;
        };
        let mutable i UInt = 0;
        while i < expected.count() then {
            if not self.same_expr_type(expected[i], actual[i]) then {
                return false;
            };
            i += 1;
        };
        return true;
    };

    module_private generic_param_has_trait_bound(
        self,
        name String,
        trait_name String,
        trait_arg_types List[Type],
    ) Bool = {
        return when self.storage.generic_param_constraints.get(name) in {
            .Some(constraints) then {
                for constraint in constraints then {
                    if self.generic_constraint_satisfies_trait_bound(
                        constraint,
                        Type.GenericParameter(name),
                        trait_name,
                        trait_arg_types,
                    ) then {
                        return true;
                    };
                };
                false
            },
            .None() then false,
        };
    };

    module_private generic_constraint_satisfies_trait_bound(
        self,
        constraint GenericConstraintBound,
        self_type Type,
        trait_name String,
        trait_arg_types List[Type],
    ) Bool = {
        // Match on declaration identity, not on spelling.
        let want = self.trait_def_id_of(trait_name) or else DefId(0(UInt));
        if constraint.trait_def_id == want and constraint.trait_def_id.id > 0(UInt) then {
            return trait_arg_types.is_empty() or self.trait_args_match(
                constraint.type_args,
                trait_arg_types,
            );
        };

        return when self.storage.trait_registry.get_in_module(
            constraint.trait_name,
            self.storage.module_path,
        ) in {
            .Some(info) then {
                let previous_scope = self.storage.current_scope;
                defer {
                    self.storage.current_scope = previous_scope;
                };

                let child_scope = Scope.new_child(self.storage.current_scope);
                child_scope.define_type("Self", self_type);
                self.storage.current_scope = child_scope;

                let mutable index UInt = 0;
                while index < info.type_params.count() and index < constraint.type_args.count(
                ) then {
                    child_scope.define_type(
                        info.type_params[index],
                        constraint.type_args[index],
                    );
                    index += 1;
                };

                for parent in info.parent_traits then {
                    let mutable parent_args = List[Type].new();
                    for arg_node in parent.type_arg_nodes then {
                        parent_args.push(self.resolve_type(arg_node));
                    };
                    if self.generic_constraint_satisfies_trait_bound(
                        GenericConstraintBound(parent.def_id, parent.name, parent_args),
                        self_type,
                        trait_name,
                        trait_arg_types,
                    ) then {
                        return true;
                    };
                };
                false
            },
            .None() then false,
        };
    };

    module_private record_explicit_trait_conformance(
        self,
        target_type Type,
        trait_name String,
        trait_arg_types List[Type],
    ) Void = {
        self.invalidate_trait_requirement_caches();
        self.storage.explicit_trait_conformances.insert(
            self.trait_conformance_key(target_type, trait_name, trait_arg_types),
        );
    };

    module_private is_implicitly_satisfied_trait_requirement(
        self,
        target_type Type,
        trait_name String,
    ) Bool = {
        let target_id = self.trait_def_id_of(trait_name) or else DefId(0(UInt));
        when target_type in {
            .TraitObject(trait_object_def_id, _) then {
                return self.storage.trait_registry.has_inheritance(
                    trait_object_def_id,
                    target_id,
                );
            },
            _ then {},
        };
        return false;
    };

    /// Does `subject` satisfy `b` right now? The single satisfaction predicate:
    /// every consumer asks this question here, dispatching on the bound's KIND
    /// rather than on its spelling.
    module_private satisfies_bound(
        self,
        subject Type,
        b Bound,
        bindings Dict[String, Type],
    ) Bool = {
        return when b in {
            .Mutable() then self.satisfies_mutable_constraint(subject),
            .Foreign() then self.satisfies_foreign_constraint(subject),
            .Trait(_, trait_name, _) then self.satisfies_trait_requirement_with_args(
                subject,
                trait_name,
                self.bound_trait_args_with_bindings(b, bindings),
            ),
        };
    };

    /// Could `subject` still satisfy `b` after type substitution? Distinct from
    /// `satisfies_bound` on purpose: materialization decisions need "might
    /// become true later", call sites need "is true now". Never merge the two.
    /// See `docs/design/generics-and-monomorphization.md`.
    module_private bound_may_hold(
        self,
        subject Type,
        b Bound,
        bindings Dict[String, Type],
    ) Bool = {
        return when b in {
            .Mutable() then self.satisfies_mutable_constraint(subject),
            .Foreign() then self.satisfies_foreign_constraint(subject),
            .Trait(_, trait_name, _) then self.trait_bound_may_hold(
                subject,
                trait_name,
                self.bound_trait_args_with_bindings(b, bindings),
            ),
        };
    };

    /// Enforce one bound on one type argument. Dispatches on the bound's KIND,
    /// so consumers never string-match a bound's spelling. Shape bounds use
    /// their canonical name only to format the (unchanged) diagnostic.
    module_private enforce_bound_requirement(
        self,
        bound_type Type,
        b Bound,
        param_name String,
        bindings Dict[String, Type],
        span SourceSpan,
    ) Bool = {
        return when b in {
            .Mutable() then {
                if self.satisfies_mutable_constraint(bound_type) then {
                    true
                } else {
                    self.push_diagnostic_at_span(
                        self.mutable_constraint_violation_message(
                            bound_type,
                            "checking constraint \(param_name): mutable",
                        ),
                        span,
                    );
                    false
                }
            },
            .Foreign() then {
                if self.satisfies_foreign_constraint(bound_type) then {
                    true
                } else {
                    self.push_diagnostic_at_span(
                        self.foreign_constraint_violation_message(
                            bound_type,
                            "checking constraint \(param_name): foreign",
                        ),
                        span,
                    );
                    false
                }
            },
            .Trait(_, trait_name, _) then {
                let trait_args = self.bound_trait_args_with_bindings(b, bindings);
                if trait_args.is_empty() then {
                    self.enforce_explicit_trait_requirement_with_context(
                        bound_type,
                        trait_name,
                        param_name,
                        "",
                        span,
                    )
                } else {
                    self.enforce_explicit_generic_trait_conformance(
                        bound_type,
                        trait_name,
                        trait_args,
                        span,
                    )
                }
            },
        };
    };

    module_private satisfies_trait_requirement(
        self,
        target_type Type,
        trait_name String,
    ) Bool = {
        return self.satisfies_trait_requirement_with_args(
            target_type,
            trait_name,
            List[Type].new(),
        );
    };

    module_private satisfies_trait_requirement_with_args(
        self,
        target_type Type,
        trait_name String,
        trait_args List[Type],
    ) Bool = {
        let key = self.trait_conformance_key(target_type, trait_name, trait_args);
        if self.storage.trait_requirement_in_progress.contains(key) then {
            return false;
        };
        when self.storage.trait_requirement_cache.get(key) in {
            .Some(cached) then {
                return cached;
            },
            .None() then {},
        };
        self.storage.trait_requirement_in_progress.insert(key);
        let result = if trait_args.is_empty() and self.is_implicitly_satisfied_trait_requirement(
            target_type,
            trait_name,
        ) then true
        else if self.has_explicit_trait_conformance_with_args(
            target_type,
            trait_name,
            trait_args,
        ) then true
        else {
            when self.generic_trait_conformance_status(
                target_type,
                trait_name,
                trait_args,
            ) in {
                .Satisfied() then true,
                _ then false,
            }
        };
        self.storage.trait_requirement_in_progress.remove(key);
        self.storage.trait_requirement_cache.insert(key, result);
        return result;
    };

    module_private has_explicit_trait_conformance(
        self,
        target_type Type,
        trait_name String,
    ) Bool = {
        return self.has_explicit_trait_conformance_with_args(
            target_type,
            trait_name,
            List[Type].new(),
        );
    };

    /// Direct conformance to the trait declared at `trait_def_id`. The name is
    /// kept only because the conformance key records it for display; identity
    /// comes from the declaration.
    module_private has_direct_explicit_trait_conformance(
        self,
        target_type Type,
        trait_def_id DefId,
        trait_name String,
        trait_arg_types List[Type],
    ) Bool = {
        return self.storage.explicit_trait_conformances.contains(
            ExplicitTraitConformanceKey(
                target_type,
                trait_def_id,
                trait_name,
                trait_arg_types,
            ),
        );
    };

    module_private has_explicit_trait_conformance_with_args(
        self,
        target_type Type,
        trait_name String,
        trait_arg_types List[Type],
    ) Bool = {
        when target_type in {
            .GenericParameter(name) then {
                return self.generic_param_has_trait_bound(
                    name,
                    trait_name,
                    trait_arg_types,
                );
            },
            _ then {},
        };
        // Check direct explicit conformance
        if self.storage.explicit_trait_conformances.contains(
            self.trait_conformance_key(target_type, trait_name, trait_arg_types),
        ) then {
            return true;
        };
        // Check trait hierarchy: if target_type conforms to a child trait that
        // extends trait_name, then target_type also satisfies trait_name.
        // For example, if Int conforms to Integer and Integer extends Div[Self],
        // then Int satisfies Div.
        // Use the type-keyed index for O(1) lookup instead of O(N) scan
        let key = self.conformance_template_key(target_type);
        let templates = when self.storage.conformance_index.get(key) in {
            .Some(list) then list,
            .None() then {
                return false;
            },
        };
        let requested_trait_id = self.trait_def_id_of(trait_name) or else DefId(0(UInt));
        for template in templates then {
            let bindings = self.conformance_type_key_bindings(
                template.target_type,
                target_type,
            ) or else {
                continue;
            };

            let is_direct = template.trait_def_id == requested_trait_id;
            if is_direct then {
                // Direct conformance declared by a GENERIC given. Its own trait
                // arguments are expressed in the owner's type parameters
                // (`given[T] Box[T] as Sink[T]` declares `[T]`), so they are
                // substituted with the bindings that turn the declared target
                // into this receiver before comparing. The exact-key lookup
                // above compares `Box[Int]` against the declaration's `Box[T]`
                // and misses, so without this every generic conformance whose
                // trait arguments mention an owner parameter is rejected --
                // `let s Sink[Int] = b` used to fail with `Type mismatch`.
                if not self.trait_args_match_under(
                    template.trait_arg_types,
                    trait_arg_types,
                    bindings,
                ) then {
                    continue;
                };
            } else {
                if not trait_arg_types.is_empty() then {
                    continue;
                };
                if not self.storage.trait_registry.has_inheritance(
                    template.trait_def_id,
                    requested_trait_id,
                ) then {
                    continue;
                };
            };

            let mutable satisfies_owner_constraints = true;
            for tp in template.owner_type_params then {
                if bindings.get(tp.name) is .Some(bound_type) then {
                    for constraint in tp.constraints then {
                        when bound_trait_name(constraint) in {
                            .Some(required_trait_name) then {
                                let required_trait_args = self.bound_trait_args_with_bindings(
                                    constraint,
                                    bindings,
                                );
                                if not self.satisfies_trait_requirement_with_args(
                                    bound_type,
                                    required_trait_name,
                                    required_trait_args,
                                ) then {
                                    satisfies_owner_constraints = false;
                                };
                            },
                            // Shape bounds (`mutable`, `Deref`) are not trait
                            // conformances, so they are not owner requirements here.
                            .None() then {},
                        };
                    };
                };
            };
            if not satisfies_owner_constraints then {
                continue;
            };
            return true;
        };
        return false;
    };

    /// Do the template's declared trait arguments match the requested ones once
    /// the owner's type parameters are bound?
    ///
    /// `given[T] Box[T] as Sink[T]` declares `[T]`; asking about `Box[Int]`
    /// binds `T := Int`, so the declaration's `[T]` means `[Int]` here.
    module_private trait_args_match_under(
        self,
        declared_args List[Type],
        requested_args List[Type],
        bindings Dict[String, Type],
    ) Bool = {
        if declared_args.count() <> requested_args.count() then {
            return false;
        };
        let mutable index UInt = 0;
        while index < declared_args.count() then {
            if not self.same_expr_type(
                self.apply_type_bindings(declared_args[index], bindings),
                requested_args[index],
            ) then {
                return false;
            };
            index += 1;
        };
        return true;
    };

    module_private trait_type_args(self, trait_type TypeNode) List[Type] = {
        return self.trait_type_args_with_bindings(trait_type, Dict[String, Type].new());
    };

    module_private bound_trait_args_with_bindings(
        self,
        b Bound,
        bindings Dict[String, Type],
    ) List[Type] = {
        let mutable out = List[Type].new();
        for arg in bound_trait_args(b) then {
            out.push(self.resolve_type_with_bindings(arg, bindings));
        };
        return out;
    };

    module_private trait_type_args_with_bindings(
        self,
        trait_type TypeNode,
        bindings Dict[String, Type],
    ) List[Type] = {
        return when trait_type in {
            .Generic(_, trait_args, span) then {
                let mutable out = List[Type].new();
                for arg in trait_args then {
                    out.push(self.resolve_type_with_bindings(arg, bindings));
                };
                out
            },
            _ then List[Type].new(),
        };
    };

    module_private record_generic_trait_conformance_template(
        self,
        target_type Type,
        owner_type_params List[TypeParameter],
        trait_name String,
        trait_args List[Type],
    ) Void = {
        self.invalidate_trait_requirement_caches();
        let template = GenericTraitConformanceTemplate(
            target_type,
            self.to_template_type_params(owner_type_params),
            trait_name,
            self.trait_def_id_of(trait_name) or else DefId(0(UInt)),
            trait_args,
        );
        self.storage.generic_trait_conformance_templates.push(template);
        // Also insert into the type-keyed index for O(1) lookup
        let key = self.conformance_template_key(target_type);
        when self.storage.conformance_index.take(key) in {
            .Some(mutable existing_list) then {
                existing_list.push(template);
                self.storage.conformance_index.insert(key, existing_list);
            },
            .None() then {
                let mutable list = List[GenericTraitConformanceTemplate].new();
                list.push(template);
                self.storage.conformance_index.insert(key, list);
            },
        };
    };

    /// The owner identity a conformance is indexed by -- the same key the
    /// method table uses. A conformance is attached to a TYPE, not a type NAME.
    module_private conformance_template_key(self, target_type Type) MethodOwner = {
        return self.extension_template_key(target_type);
    };

    module_private type_modifier_inner_type(self, target_type Type) Option[Type] = {
        let _ = self;
        return when target_type in {
            .ReferenceType(inner) then Option[Type].Some(inner),
            .MutableReferenceType(inner) then Option[Type].Some(inner),
            .BorrowedReferenceType(inner) then Option[Type].Some(inner),
            .MutableBorrowedReferenceType(inner) then Option[Type].Some(inner),
            .PointerType(inner) then Option[Type].Some(inner),
            .MutablePointerType(inner) then Option[Type].Some(inner),
            .WeakReferenceType(inner) then Option[Type].Some(inner),
            .MutableWeakReferenceType(inner) then Option[Type].Some(inner),
            _ then Option[Type].None(),
        };
    };

    module_private modifier_blanket_trait_conformance_status(
        self,
        target_type Type,
        trait_name String,
        trait_args List[Type],
    ) Option[GenericTraitConformanceStatus] = {
        let mutable inner_type = self.type_modifier_inner_type(target_type) or else {
            return Option[GenericTraitConformanceStatus].None();
        };
        when inner_type in {
            .GenericParameter(_) then {
                return Option[GenericTraitConformanceStatus].Some(
                    GenericTraitConformanceStatus.Satisfied(),
                );
            },
            _ then {},
        };
        if self.satisfies_trait_requirement_with_args(inner_type, trait_name, trait_args) then {
            return Option[GenericTraitConformanceStatus].Some(
                GenericTraitConformanceStatus.Satisfied(),
            );
        };
        let modifier_owner = self.conformance_template_key(target_type);
        // Display only: the diagnostic names the modifier ("ref", "mutptr", ...).
        // Identity was already decided by `conformance_template_key`.
        let modifier_display_name = modifier_owner.display().to_ascii_lowercase();
        let templates = when self.storage.conformance_index.get(modifier_owner) in {
            .Some(list) then list,
            .None() then {
                return Option[GenericTraitConformanceStatus].Some(
                    GenericTraitConformanceStatus.MissingBlanketGiven(
                        modifier_display_name,
                    ),
                );
            },
        };
        let requested_trait_id = self.trait_def_id_of(trait_name) or else DefId(0(UInt));
        let mutable matched_template = false;
        for template in templates then {
            if template.trait_def_id <> requested_trait_id then {
                continue;
            };
            let bindings = self.conformance_type_key_bindings(
                template.target_type,
                target_type,
            ) or else {
                continue;
            };
            if not (template.trait_arg_types.count() == trait_args.count()) then {
                continue;
            };
            let mutable i UInt = 0;
            let mutable trait_args_match = true;
            while i < trait_args.count() then {
                let expected_arg = self.apply_type_bindings(
                    template.trait_arg_types[i],
                    bindings,
                );
                if not self.same_expr_type(expected_arg, trait_args[i]) then {
                    trait_args_match = false;
                    break;
                };
                i += 1;
            };
            if not trait_args_match then {
                continue;
            };
            matched_template = true;
            for tp in template.owner_type_params then {
                if bindings.get(tp.name) is .Some(bound_type) then {
                    for constraint in tp.constraints then {
                        when bound_trait_name(constraint) in {
                            .Some(required_trait_name) then {
                                let required_trait_args = self.bound_trait_args_with_bindings(
                                    constraint,
                                    bindings,
                                );
                                if not self.satisfies_trait_requirement_with_args(
                                    bound_type,
                                    required_trait_name,
                                    required_trait_args,
                                ) then {
                                    return Option[GenericTraitConformanceStatus].Some(
                                        GenericTraitConformanceStatus.MissingConstraint(
                                            bound_type,
                                            tp.name,
                                            required_trait_name,
                                        ),
                                    );
                                };
                            },
                            .None() then {},
                        };
                    };
                };
            };
            return Option[GenericTraitConformanceStatus].Some(
                GenericTraitConformanceStatus.Satisfied(),
            );
        };
        if matched_template then {
            return Option[GenericTraitConformanceStatus].Some(
                GenericTraitConformanceStatus.MissingConformance(),
            );
        };
        return Option[GenericTraitConformanceStatus].Some(
            GenericTraitConformanceStatus.MissingBlanketGiven(modifier_display_name),
        );
    };

    module_private conformance_type_key_matches(
        self,
        pattern Type,
        actual Type,
        bindings Dict[String, Type],
    ) Bool = {
        return when pattern in {
            .GenericParameter(name) then {
                return when bindings.get(name) in {
                    .Some(bound) then self.same_expr_type(bound, actual),
                    .None() then {
                        bindings.insert(name, actual);
                        true
                    },
                };
            },
            .ReferenceType(p_inner) then when actual in {
                .ReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .BorrowedReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then false,
            },
            .MutableReferenceType(p_inner) then when actual in {
                .MutableReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then false,
            },
            .BorrowedReferenceType(p_inner) then when actual in {
                .ReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .BorrowedReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then false,
            },
            .MutableBorrowedReferenceType(p_inner) then when actual in {
                .MutableReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then false,
            },
            .WeakReferenceType(p_inner) then when actual in {
                .WeakReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableWeakReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then false,
            },
            .MutableWeakReferenceType(p_inner) then when actual in {
                .MutableWeakReferenceType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then false,
            },
            .PointerType(p_inner) then when actual in {
                .PointerType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutablePointerType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then false,
            },
            .MutablePointerType(p_inner) then when actual in {
                .MutablePointerType(a_inner) then self.conformance_type_key_matches(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then false,
            },
            // Identity: the template's DECLARATION, not its spelling.
            .GenericStruct(p_def_id, p_args) then when actual in {
                .GenericStruct(a_def_id, a_args) then {
                    if not (p_def_id == a_def_id and p_args.count() == a_args.count()) then {
                        return false;
                    };
                    let mutable i UInt = 0;
                    while i < p_args.count() then {
                        if not self.conformance_type_key_matches(
                            (p_args[i]),
                            (a_args[i]),
                            bindings,
                        ) then {
                            return false;
                        };
                        i += 1;
                    };
                    return true;
                },
                .StructureType(def_id) then {
                    // Identity: the instance points at its template's DECLARATION.
                    let actual_def_id = self.context().get_template_def_id(def_id);
                    let actual_args = self.context().get_type_arguments(def_id) or else {
                        return false;
                    };
                    if not (p_def_id == actual_def_id and p_args.count() == actual_args.count(
                    )) then {
                        return false;
                    };
                    let mutable i UInt = 0;
                    while i < p_args.count() then {
                        if not self.conformance_type_key_matches(
                            (p_args[i]),
                            actual_args[i],
                            bindings,
                        ) then {
                            return false;
                        };
                        i += 1;
                    };
                    return true;
                },
                _ then false,
            },
            // Identity: the template's DECLARATION, not its spelling.
            .GenericEnum(p_def_id, p_args) then when actual in {
                .GenericEnum(a_def_id, a_args) then {
                    if not (p_def_id == a_def_id and p_args.count() == a_args.count()) then {
                        return false;
                    };
                    let mutable i UInt = 0;
                    while i < p_args.count() then {
                        if not self.conformance_type_key_matches(
                            (p_args[i]),
                            (a_args[i]),
                            bindings,
                        ) then {
                            return false;
                        };
                        i += 1;
                    };
                    return true;
                },
                .EnumType(def_id) then {
                    // Identity: the instance points at its template's DECLARATION.
                    let actual_def_id = self.context().get_template_def_id(def_id);
                    let actual_args = self.context().get_type_arguments(def_id) or else {
                        return false;
                    };
                    if not (p_def_id == actual_def_id and p_args.count() == actual_args.count(
                    )) then {
                        return false;
                    };
                    let mutable i UInt = 0;
                    while i < p_args.count() then {
                        if not self.conformance_type_key_matches(
                            (p_args[i]),
                            actual_args[i],
                            bindings,
                        ) then {
                            return false;
                        };
                        i += 1;
                    };
                    return true;
                },
                _ then false,
            },
            _ then self.same_expr_type(pattern, actual),
        };
    };

    module_private generic_trait_conformance_status(
        self,
        target_type Type,
        trait_name String,
        trait_args List[Type],
    ) GenericTraitConformanceStatus = {
        let key = self.trait_conformance_key(target_type, trait_name, trait_args);
        if self.storage.generic_trait_status_in_progress.contains(key) then {
            return GenericTraitConformanceStatus.MissingConformance();
        };
        when self.storage.generic_trait_status_cache.get(key) in {
            .Some(cached) then {
                return cached;
            },
            .None() then {},
        };
        self.storage.generic_trait_status_in_progress.insert(key);
        let result = self.compute_generic_trait_conformance_status(
            target_type,
            trait_name,
            trait_args,
        );
        self.storage.generic_trait_status_in_progress.remove(key);
        self.storage.generic_trait_status_cache.insert(key, result);
        return result;
    };

    module_private compute_generic_trait_conformance_status(
        self,
        target_type Type,
        trait_name String,
        trait_args List[Type],
    ) GenericTraitConformanceStatus = {
        when self.modifier_blanket_trait_conformance_status(
            target_type,
            trait_name,
            trait_args,
        ) in {
            .Some(status) then {
                return status;
            },
            .None() then {},
        };
        let mutable matched_template = false;
        let mutable result = GenericTraitConformanceStatus.MissingConformance();
        // Use the type-keyed index for O(1) lookup instead of O(N) scan
        let key = self.conformance_template_key(target_type);
        let templates = when self.storage.conformance_index.get(key) in {
            .Some(list) then list,
            .None() then {
                return GenericTraitConformanceStatus.MissingConformance();
            },
        };
        let requested_trait_id = self.trait_def_id_of(trait_name) or else DefId(0(UInt));
        for template in templates then {
            if template.trait_def_id <> requested_trait_id then {
                continue;
            };
            let bindings = self.conformance_type_key_bindings(
                template.target_type,
                target_type,
            ) or else {
                continue;
            };
            if not (template.trait_arg_types.count() == trait_args.count()) then {
                continue;
            };
            let mutable i UInt = 0;
            let mutable trait_args_match = true;
            while i < trait_args.count() then {
                let expected_arg = self.apply_type_bindings(
                    template.trait_arg_types[i],
                    bindings,
                );
                if not self.same_expr_type(expected_arg, trait_args[i]) then {
                    trait_args_match = false;
                    break;
                };
                i += 1;
            };
            if not trait_args_match then {
                continue;
            };
            matched_template = true;
            for tp in template.owner_type_params then {
                if bindings.get(tp.name) is .Some(bound_type) then {
                    for constraint in tp.constraints then {
                        when bound_trait_name(constraint) in {
                            .Some(required_trait_name) then {
                                let required_trait_args = self.bound_trait_args_with_bindings(
                                    constraint,
                                    bindings,
                                );
                                if not self.satisfies_trait_requirement_with_args(
                                    bound_type,
                                    required_trait_name,
                                    required_trait_args,
                                ) then {
                                    result = GenericTraitConformanceStatus.MissingConstraint(
                                        bound_type,
                                        tp.name,
                                        required_trait_name,
                                    );
                                    return result;
                                };
                            },
                            .None() then {},
                        };
                    };
                };
            };
            result = GenericTraitConformanceStatus.Satisfied();
            return result;
        };
        let final_result = if matched_template then result
        else GenericTraitConformanceStatus.MissingConformance();
        return final_result;
    };

    module_private conformance_type_key_bindings(
        self,
        pattern Type,
        actual Type,
    ) Option[Dict[String, Type]] = {
        return self.conformance_type_key_bindings_with(
            pattern,
            actual,
            Dict[String, Type].new(),
        );
    };

    module_private conformance_type_key_bindings_with(
        self,
        pattern Type,
        actual Type,
        bindings Dict[String, Type],
    ) Option[Dict[String, Type]] = {
        return when pattern in {
            .GenericParameter(name) then {
                when bindings.get(name) in {
                    .Some(bound) then if self.same_expr_type(bound, actual) then Option[Dict[String, Type]].Some(
                        bindings,
                    ) else Option[Dict[String, Type]].None(),
                    .None() then {
                        let mutable next_bindings = bindings;
                        next_bindings.insert(name, actual);
                        Option[Dict[String, Type]].Some(next_bindings)
                    },
                }
            },
            .ReferenceType(p_inner) then when actual in {
                .ReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .BorrowedReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then Option[Dict[String, Type]].None(),
            },
            .MutableReferenceType(p_inner) then when actual in {
                .MutableReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then Option[Dict[String, Type]].None(),
            },
            .BorrowedReferenceType(p_inner) then when actual in {
                .ReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .BorrowedReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then Option[Dict[String, Type]].None(),
            },
            .MutableBorrowedReferenceType(p_inner) then when actual in {
                .MutableReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then Option[Dict[String, Type]].None(),
            },
            .WeakReferenceType(p_inner) then when actual in {
                .WeakReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutableWeakReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then Option[Dict[String, Type]].None(),
            },
            .MutableWeakReferenceType(p_inner) then when actual in {
                .MutableWeakReferenceType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then Option[Dict[String, Type]].None(),
            },
            .PointerType(p_inner) then when actual in {
                .PointerType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                .MutablePointerType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then Option[Dict[String, Type]].None(),
            },
            .MutablePointerType(p_inner) then when actual in {
                .MutablePointerType(a_inner) then self.conformance_type_key_bindings_with(
                    p_inner,
                    a_inner,
                    bindings,
                ),
                _ then Option[Dict[String, Type]].None(),
            },
            // Identity: the template's DECLARATION, not its spelling.
            .GenericStruct(p_def_id, p_args) then when actual in {
                .GenericStruct(a_def_id, a_args) then {
                    if not (p_def_id == a_def_id and p_args.count() == a_args.count()) then {
                        return Option[Dict[String, Type]].None();
                    };
                    let mutable current_bindings = bindings;
                    let mutable i UInt = 0;
                    while i < p_args.count() then {
                        current_bindings = self.conformance_type_key_bindings_with(
                            (p_args[i]),
                            (a_args[i]),
                            current_bindings,
                        ) or else {
                            return Option[Dict[String, Type]].None();
                        };
                        i += 1;
                    };
                    Option[Dict[String, Type]].Some(current_bindings)
                },
                .StructureType(def_id) then {
                    // Identity: the instance points at its template's DECLARATION.
                    let actual_def_id = self.context().get_template_def_id(def_id);
                    let actual_args = self.context().get_type_arguments(def_id) or else {
                        return Option[Dict[String, Type]].None();
                    };
                    if not (p_def_id == actual_def_id and p_args.count() == actual_args.count(
                    )) then {
                        return Option[Dict[String, Type]].None();
                    };
                    let mutable current_bindings = bindings;
                    let mutable i UInt = 0;
                    while i < p_args.count() then {
                        current_bindings = self.conformance_type_key_bindings_with(
                            (p_args[i]),
                            actual_args[i],
                            current_bindings,
                        ) or else {
                            return Option[Dict[String, Type]].None();
                        };
                        i += 1;
                    };
                    Option[Dict[String, Type]].Some(current_bindings)
                },
                _ then Option[Dict[String, Type]].None(),
            },
            // Identity: the template's DECLARATION, not its spelling.
            .GenericEnum(p_def_id, p_args) then when actual in {
                .GenericEnum(a_def_id, a_args) then {
                    if not (p_def_id == a_def_id and p_args.count() == a_args.count()) then {
                        return Option[Dict[String, Type]].None();
                    };
                    let mutable current_bindings = bindings;
                    let mutable i UInt = 0;
                    while i < p_args.count() then {
                        current_bindings = self.conformance_type_key_bindings_with(
                            (p_args[i]),
                            (a_args[i]),
                            current_bindings,
                        ) or else {
                            return Option[Dict[String, Type]].None();
                        };
                        i += 1;
                    };
                    Option[Dict[String, Type]].Some(current_bindings)
                },
                .EnumType(def_id) then {
                    // Identity: the instance points at its template's DECLARATION.
                    let actual_def_id = self.context().get_template_def_id(def_id);
                    let actual_args = self.context().get_type_arguments(def_id) or else {
                        return Option[Dict[String, Type]].None();
                    };
                    if not (p_def_id == actual_def_id and p_args.count() == actual_args.count(
                    )) then {
                        return Option[Dict[String, Type]].None();
                    };
                    let mutable current_bindings = bindings;
                    let mutable i UInt = 0;
                    while i < p_args.count() then {
                        current_bindings = self.conformance_type_key_bindings_with(
                            (p_args[i]),
                            actual_args[i],
                            current_bindings,
                        ) or else {
                            return Option[Dict[String, Type]].None();
                        };
                        i += 1;
                    };
                    Option[Dict[String, Type]].Some(current_bindings)
                },
                _ then Option[Dict[String, Type]].None(),
            },
            _ then if self.same_expr_type(pattern, actual) then Option[Dict[String, Type]].Some(
                bindings,
            ) else Option[Dict[String, Type]].None(),
        };
    };

    module_private enforce_explicit_generic_trait_conformance(
        self,
        target_type Type,
        trait_name String,
        trait_args List[Type],
        span SourceSpan,
    ) Bool = {
        return self.enforce_explicit_generic_trait_conformance_with_note(
            target_type,
            trait_name,
            trait_args,
            "",
            span,
        );
    };

    /// `note` names the construct that demanded the trait --
    /// `for-in iterator result check`, `operator 'add'`. Without it the message
    /// states a requirement and leaves the cause unstated.
    module_private enforce_explicit_generic_trait_conformance_with_note(
        self,
        target_type Type,
        trait_name String,
        trait_args List[Type],
        note String,
        span SourceSpan,
    ) Bool = {
        // Check generic parameter constraints first (like Swift's hasTraitBound)
        when target_type in {
            .GenericParameter(name) then {
                if self.generic_param_has_trait_bound(name, trait_name, trait_args) then {
                    return true;
                };
            },
            _ then {},
        };
        return when self.generic_trait_conformance_status(
            target_type,
            trait_name,
            trait_args,
        ) in {
            .Satisfied() then true,
            .MissingConstraint(bound_type, constraint_param, constraint) then {
                if self.constraint_enforcement_is_deferred() then {
                    return true;
                };
                self.push_diagnostic(
                    self.trait_missing_constraint_message(
                        bound_type,
                        constraint_param,
                        constraint,
                    ),
                    span,
                );
                false
            },
            .MissingBlanketGiven(modifier_name) then {
                if self.constraint_enforcement_is_deferred() then {
                    return true;
                };
                self.push_diagnostic(
                    self.trait_requirement_missing_blanket_given_message(
                        target_type,
                        trait_name,
                        modifier_name,
                    ),
                    span,
                );
                false
            },
            .MissingConformance() then {
                if self.constraint_enforcement_is_deferred() then {
                    return true;
                };
                let message = self.trait_missing_conformance_message(
                    target_type,
                    trait_name,
                    trait_args,
                    note,
                );
                self.push_diagnostic(message, span);
                false
            },
        };
    };

    module_private enforce_explicit_trait_requirement(
        self,
        target_type Type,
        trait_name String,
        span SourceSpan,
    ) Bool = {
        return self.enforce_explicit_trait_requirement_with_context(
            target_type,
            trait_name,
            "",
            "",
            span,
        );
    };

    module_private enforce_mutable_constraint_for_call(
        self,
        target_type Type,
        function String,
        span SourceSpan,
    ) Bool = {
        let satisfied = when target_type in {
            .StructureType(def_id) then self.context().is_struct_mutable(def_id),
            // Identity: the template's DECLARATION decides mutability. There is
            // no spelling fallback -- the type carries the declaration.
            .GenericStruct(template_def_id, _) then {
                template_def_id.is_valid() and self.context().is_struct_mutable(
                    template_def_id,
                )
            },
            _ then false,
        };
        if not satisfied then {
            self.push_diagnostic_at_span(
                "'\(function)' requires a 'type mutable' argument, but '\(type_to_string(target_type))' is not declared as 'type mutable'",
                span,
            );
        };
        return satisfied;
    };

    // Swift calls `enforceGenericConstraints` only from
    // `resolveGenericExtensionMethod` (TypeCheckerMethods.swift:572) — a CALL
    // SITE, where the type arguments are concrete. Re-checking a body while
    // materializing a trait-tool method for a conformance is a DECLARATION
    // activity and must not report: `contains` materialized for
    // `EnumerateIterator[T, R] as Iterator[Pair[UInt, T]]` would otherwise
    // demand `Pair[UInt, T]: Eq` before `T` is known. The call site enforces.
    module_private constraint_enforcement_is_deferred(self) Bool = {
        return self.storage.constraint_enforcement_deferred;
    };

    /// `span` is where the requirement was asserted -- the call, the operator,
    /// the generic argument. A requirement that cannot point at the thing that
    /// demanded it cannot be acted on, so this is not optional.
    /// `note` names the construct that demanded the trait -- `operator 'equals'`
    /// -- and is printed with the message. `constraint_param` names a generic
    /// parameter whose bound is unmet and takes the `(checking constraint ...)`
    /// form instead. The two are different reasons and print differently.
    module_private enforce_explicit_trait_requirement_with_context(
        self,
        target_type Type,
        trait_name String,
        constraint_param String,
        note String,
        span SourceSpan,
    ) Bool = {
        when target_type in {
            .Unknown() then {
                return true;
            },
            .TypeVar(_) then {
                return true;
            },
            _ then {},
        };

        // Check generic parameter constraints first (like Swift's hasTraitBound)
        when target_type in {
            .GenericParameter(name) then {
                if self.generic_param_has_trait_bound(name, trait_name, List[Type].new()) then {
                    return true;
                };
            },
            _ then {},
        };

        if self.is_implicitly_satisfied_trait_requirement(target_type, trait_name) then {
            return true;
        };

        if self.has_explicit_trait_conformance(target_type, trait_name) then {
            return true;
        };

        let empty_trait_args = List[Type].new();
        return when self.generic_trait_conformance_status(
            target_type,
            trait_name,
            empty_trait_args,
        ) in {
            .Satisfied() then true,
            .MissingConstraint(bound_type, constraint_param, constraint) then {
                if self.constraint_enforcement_is_deferred() then {
                    return true;
                };
                self.push_diagnostic(
                    self.trait_requirement_missing_constraint_message(
                        target_type,
                        trait_name,
                        bound_type,
                        constraint,
                    ),
                    span,
                );
                false
            },
            .MissingBlanketGiven(modifier_name) then {
                if self.constraint_enforcement_is_deferred() then {
                    return true;
                };
                self.push_diagnostic(
                    self.trait_requirement_missing_blanket_given_message(
                        target_type,
                        trait_name,
                        modifier_name,
                    ),
                    span,
                );
                false
            },
            .MissingConformance() then {
                if self.constraint_enforcement_is_deferred() then {
                    return true;
                };
                let message = if constraint_param.is_empty() then self.trait_missing_conformance_message(
                    target_type,
                    trait_name,
                    List[Type].new(),
                    note,
                )
                else self.trait_missing_constraint_message(
                    target_type,
                    constraint_param,
                    trait_name,
                );
                self.push_diagnostic(message, span);
                false
            },
        };
    };
};
