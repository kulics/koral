// 可见性检查器
// 检查符号是否已通过当前文件的 using 声明显式可见

// ── VisibilityChecker ─────────────────────────────────────────────────────────

public type VisibilityChecker(
    import_graph: ImportGraph,
    current_module_path: List[String],
    current_source_file: String,
);

given VisibilityChecker {
    public new(
        import_graph: ImportGraph,
        current_module_path: List[String],
        current_source_file: String,
    ): VisibilityChecker = {
        return VisibilityChecker(import_graph, current_module_path, current_source_file);
    };

    private is_std_root(self, module_path: List[String]): Bool = {
        let _ = self;
        if module_path.count() != UInt(1) then {
            return false;
        };
        return module_path[UInt(0)] == "Std" or module_path[UInt(0)] == "std";
    };

    private is_std_module(self, module_path: List[String]): Bool = {
        let _ = self;
        if module_path.is_empty() then {
            return false;
        };
        return module_path[UInt(0)] == "Std" or module_path[UInt(0)] == "std";
    };

    // 检查符号是否可以直接访问
    // 返回 Ok 或 Error(显式导入建议)
    public check_symbol(
        self,
        symbol_module_path: List[String],
        symbol_name: String,
        is_generic_param: Bool,
    ): Result[Void] = {
        // 泛型参数跳过验证
        if is_generic_param then {
            return Result[Void].Ok({});
        };

        if self.can_access_directly(symbol_module_path, Option[String].Some(symbol_name)) then {
            return Result[Void].Ok({});
        };

        let spec = module_path_to_using_specifier(symbol_module_path);
        return Result[Void].Error(
            "'\(symbol_name)' is defined in module '\(spec)'. Import it explicitly with using \"\(spec)\" { \(symbol_name) };",
        );
    };

    // 检查类型的可见性
    public check_type(
        self,
        t: Type,
        type_name: String,
        context: CompilerContext,
        is_local_binding: Bool,
        is_generic_param: Bool,
    ): Result[Void] = {
        // 局部绑定或泛型参数跳过验证
        if is_local_binding or is_generic_param then {
            return Result[Void].Ok({});
        };

        // 获取类型的模块路径
        let module_path = when t in {
            .StructureType(def_id) then {
                when context.get_module_path(def_id) in {
                    .Some(p) then p,
                    .None() then List[String].new(),
                }
            },
            .EnumType(def_id) then {
                when context.get_module_path(def_id) in {
                    .Some(p) then p,
                    .None() then List[String].new(),
                }
            },
            .OpaqueType(def_id) then {
                when context.get_module_path(def_id) in {
                    .Some(p) then p,
                    .None() then List[String].new(),
                }
            },
            .GenericParameter(_) then {
                return Result[Void].Ok({});
            },
            _ then {
                return Result[Void].Ok({});
            },
        };

        return self.check_symbol(module_path, type_name, false);
    };

    // 判断是否可以直接访问
    private can_access_directly(
        self,
        symbol_module_path: List[String],
        symbol_name: Option[String],
    ): Bool = {
        // 空路径：局部变量，总是可访问
        if symbol_module_path.count() == 0 then {
            return true;
        };

        // 同一模块
        if string_list_eq(symbol_module_path, self.current_module_path) then {
            return true;
        };

        // std root is a compiler-provided prelude for non-std modules only.
        if self.is_std_root(symbol_module_path) and not self.is_std_module(
            self.current_module_path,
        ) then {
            return true;
        };

        // 查询 ImportGraph
        let kind = self.import_graph.get_import_kind(
            symbol_module_path,
            symbol_name,
            self.current_module_path,
            Option[String].Some(self.current_source_file),
        );

        return when kind in {
            .Local() then true,
            .MemberImport() then true,
            .BatchImport() then true,
            .ModuleImport() then false,
        };
    };

    /// METHOD FACE (§3.4): is this trait DECLARATION in scope in this file?
    ///
    /// Deliberately NOT `can_access_directly`: that answers "can this file
    /// WRITE the spelling", and `{ IntoPath as IT }` leaves `IntoPath`
    /// unwritable. A trait in scope under any spelling still opens its methods
    /// -- the method is called by its own name (`f.read()`), and Rust agrees
    /// (`use std::io::Read as R;` still permits `f.read()`). So this asks
    /// whether the declaration is REACHABLE here, under whatever spelling.
    ///
    /// `{ }` answers no: it is a dependency edge with no member surface, and
    /// §3.3 gives it no methods either.
    public trait_declaration_in_scope(
        self,
        trait_module_path: List[String],
        trait_name: String,
    ): Bool = {
        if trait_module_path.count() == 0 then {
            return true;
        };
        if string_list_eq(trait_module_path, self.current_module_path) then {
            return true;
        };
        if self.is_std_root(trait_module_path) and not self.is_std_module(
            self.current_module_path,
        ) then {
            return true;
        };

        // A symbol import reaches this file under either spelling: `{ T }`
        // brings `T`, `{ T as A }` brings the declaration under `A` and leaves
        // `T` unwritable -- but the TRAIT is in scope either way.
        when self.import_graph.symbol_import_candidates(trait_name) in {
            .Some(candidates) then {
                for si in candidates then {
                    if string_list_eq(si.module, self.current_module_path) and string_list_eq(
                        si.target,
                        trait_module_path,
                    ) and source_file_matches(
                        si.source_file,
                        Option[String].Some(self.current_source_file),
                    ) then {
                        return true;
                    };
                };
            },
            .None() then {},
        };

        // Batch import: `{ ... }` and `{ !a, ... }` arrive whole minus the
        // filter; `{ a as b, ... }` is covered by its own symbol edge above.
        for edge in self.import_graph.edges then {
            if string_list_eq(edge.source, self.current_module_path) and string_list_eq(
                edge.target,
                trait_module_path,
            ) and source_file_matches(
                edge.source_file,
                Option[String].Some(self.current_source_file),
            ) then {
                when edge.kind in {
                    .BatchImport() then {
                        if batch_filter_allows(edge.filter, trait_name) then {
                            return true;
                        };
                    },
                    _ then {},
                };
            };
        };

        return false;
    };
};
