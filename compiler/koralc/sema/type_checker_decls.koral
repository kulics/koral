// ============================================================================
// `self` must not escape a `drop` body
// ============================================================================
//
// `drop(self)` runs while the object is being destroyed. Letting `self` out --
// returning it, storing it, passing it on, capturing it in a closure -- either
// resurrects a dying value or moves fields out from under the destructor. So
// inside a `drop` body `self` may appear ONLY as the receiver of a member
// access (`self.x`, `self.x = v`) or a method call (`self.close()`). Every
// other occurrence is an escape. A lambda body is a special case: anything the
// lambda mentions it captures, so ANY `self` there escapes.

/// The span of the first `self` in `e` that escapes the destructor, if any.
///
/// "Escapes" is structural: `self` is legal ONLY as the base of a member path
/// (`self.x`, `self.x.y`) or as the receiver of a method call (`self.m(...)`).
/// Everywhere else -- an argument, a `let` initializer, a return value -- it is
/// a bare value and escapes. Under a lambda (`in_lambda`) even a receiver use
/// escapes, because the closure captures it.
module_private let drop_self_escape_span(e Expr) Option[SourceSpan] = {
    return drop_self_escape_span_in(e, false);
};

/// Whether `base` is a legal receiver use of `self`.
module_private let drop_self_receiver_span(base Expr, in_lambda Bool) Option[SourceSpan] = {
    if in_lambda then {
        return drop_self_escape_span_in(base, in_lambda);
    };
    return when base in {
        .Identifier(name, span) then if name == "self" then {
            Option[SourceSpan].None()
        } else {
            drop_self_escape_span_in(base, in_lambda)
        },
        _ then drop_self_escape_span_in(base, in_lambda),
    };
};

module_private let drop_self_escape_span_in(e Expr, in_lambda Bool) Option[SourceSpan] = {
    return when e in {
        .Identifier(name, span) then if name == "self" then {
            Option[SourceSpan].Some(span)
        } else {
            Option[SourceSpan].None()
        },
        // `self.x` / `self.x.y` -- the whole path is one receiver use.
        .MemberPath(base, _, _) then drop_self_receiver_span(base, in_lambda),
        // The callee of a call is a value use -- `self()` escapes -- but the
        // base of `self.m(...)` / `self.m[T](...)` is a receiver.
        .Call(callee, args, _) then {
            when drop_self_escape_span_in(callee, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then drop_self_escape_in_list(args, in_lambda),
            }
        },
        .GenericMethodCall(base, _, _, args, _) then {
            when drop_self_receiver_span(base, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then drop_self_escape_in_list(args, in_lambda),
            }
        },
        // `Type(Trait).method(recv, ...)` -- the base is the TYPE name and the
        // receiver travels in the argument list, so every part of it is an
        // ordinary use. Only `self.m(...)` makes `self` a receiver.
        .QualifiedMethodCall(base, _, _, args, _) then {
            when drop_self_escape_span_in(base, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then drop_self_escape_in_list(args, in_lambda),
            }
        },
        .QualifiedGenericMethodCall(base, _, _, _, args, _) then {
            when drop_self_escape_span_in(base, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then drop_self_escape_in_list(args, in_lambda),
            }
        },
        // A closure captures whatever it mentions; `self` may not be captured.
        .LambdaExpr(_, _, body, _) then drop_self_escape_span_in(body, true),
        .CastExpr(_, inner, _) then drop_self_escape_span_in(inner, in_lambda),
        .Unary(_, inner, _) then drop_self_escape_span_in(inner, in_lambda),
        .RefExpr(inner, _, _) then drop_self_escape_span_in(inner, in_lambda),
        .WeakrefExpr(inner, _) then drop_self_escape_span_in(inner, in_lambda),
        .PtrExpr(inner, _, _) then drop_self_escape_span_in(inner, in_lambda),
        .DerefExpr(inner, _) then drop_self_escape_span_in(inner, in_lambda),
        .UnsafeDerefExpr(inner, _) then drop_self_escape_span_in(inner, in_lambda),
        .NamedArgument(_, inner, _) then drop_self_escape_span_in(inner, in_lambda),
        .TraitQualificationExpr(base, _, _) then drop_self_escape_span_in(
            base,
            in_lambda,
        ),
        .OrReturnExpr(operand, _) then drop_self_escape_span_in(operand, in_lambda),
        .IsExpr(subject, _, _) then drop_self_escape_span_in(subject, in_lambda),
        .IsNotExpr(subject, _, _) then drop_self_escape_span_in(subject, in_lambda),
        .StaticMethodCall(_, _, _, args, _) then drop_self_escape_in_list(
            args,
            in_lambda,
        ),
        .ImplicitMemberExpr(_, args, _) then drop_self_escape_in_list(args, in_lambda),
        .CollectionLiteral(elements, _) then drop_self_escape_in_list(
            elements,
            in_lambda,
        ),
        .ComparisonChainExpr(operands, _, _) then drop_self_escape_in_list(
            operands,
            in_lambda,
        ),
        .DictLiteral(entries, _) then drop_self_escape_in_pairs(entries, in_lambda),
        .InterpolatedString(parts, _) then drop_self_escape_in_parts(parts, in_lambda),
        .Block(statements, tail_expression, _) then {
            when drop_self_escape_in_statements(statements, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then when tail_expression in {
                    .Some(inner) then drop_self_escape_span_in(inner, in_lambda),
                    .None() then Option[SourceSpan].None(),
                },
            }
        },
        .SubscriptExpr(base, args, _) then {
            when drop_self_escape_span_in(base, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then drop_self_escape_in_list(args, in_lambda),
            }
        },
        // Binary operators are one arm each: an `or`-pattern that mixes case
        // shapes with different payload layouts binds from the first case and
        // reads the wrong slot on the others.
        .OrElseExpr(operand, default_expr, _) or .AndThenExpr(operand, default_expr, _) or .AndExpr(operand, default_expr, _) or .OrExpr(operand, default_expr, _) then {
            when drop_self_escape_span_in(operand, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then drop_self_escape_span_in(default_expr, in_lambda),
            }
        },
        .ArithmeticExpr(operand, _, right, _) or .ComparisonExpr(operand, _, right, _) or .BitwiseExpr(operand, _, right, _) then {
            when drop_self_escape_span_in(operand, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then drop_self_escape_span_in(right, in_lambda),
            }
        },
        .RangeExpr(_, left, right, _) then {
            let found = when left in {
                .Some(inner) then drop_self_escape_span_in(inner, in_lambda),
                .None() then Option[SourceSpan].None(),
            };
            when found in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then when right in {
                    .Some(inner) then drop_self_escape_span_in(inner, in_lambda),
                    .None() then Option[SourceSpan].None(),
                },
            }
        },
        .IfExpr(condition, then_branch, else_branch, _) then {
            when drop_self_escape_span_in(condition, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then {
                    when drop_self_escape_span_in(then_branch, in_lambda) in {
                        .Some(span) then Option[SourceSpan].Some(span),
                        .None() then when else_branch in {
                            .Some(inner) then drop_self_escape_span_in(inner, in_lambda),
                            .None() then Option[SourceSpan].None(),
                        },
                    }
                },
            }
        },
        .WhileExpr(condition, body, _) then {
            when drop_self_escape_span_in(condition, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then drop_self_escape_span_in(body, in_lambda),
            }
        },
        .ForExpr(_, iterable, body, _) then {
            when drop_self_escape_span_in(iterable, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then drop_self_escape_span_in(body, in_lambda),
            }
        },
        .WhenExpr(subject, arms, _) then {
            when drop_self_escape_span_in(subject, in_lambda) in {
                .Some(span) then Option[SourceSpan].Some(span),
                .None() then drop_self_escape_in_arms(arms, in_lambda),
            }
        },
        // Literals, the empty literal and generic instantiations carry no
        // expression that could name `self`.
        .IntegerLiteral(_, _) or .FloatLiteral(_, _) or .StringLiteral(_, _) or .RuneLiteral(_, _) or .BoolLiteral(_, _) or .EmptyLiteral(_) or .GenericInstantiation(_, _, _) then Option[SourceSpan].None(
        ),
    };
};

module_private let drop_self_escape_in_list(
    exprs List[Expr],
    in_lambda Bool,
) Option[SourceSpan] = {
    for e in exprs then {
        let found = drop_self_escape_span_in(e, in_lambda);
        if found is .Some(_) then {
            return found;
        };
    };
    return Option[SourceSpan].None();
};

module_private let drop_self_escape_in_pairs(
    entries List[ExprPair],
    in_lambda Bool,
) Option[SourceSpan] = {
    for entry in entries then {
        let found = drop_self_escape_span_in(entry.first, in_lambda);
        if found is .Some(_) then {
            return found;
        };
        let found_second = drop_self_escape_span_in(entry.second, in_lambda);
        if found_second is .Some(_) then {
            return found_second;
        };
    };
    return Option[SourceSpan].None();
};

module_private let drop_self_escape_in_parts(
    parts List[InterpolatedStringPart],
    in_lambda Bool,
) Option[SourceSpan] = {
    for part in parts then {
        let found = when part in {
            .Literal(_) then Option[SourceSpan].None(),
            .Expression(e) then drop_self_escape_span_in(e, in_lambda),
        };
        if found is .Some(_) then {
            return found;
        };
    };
    return Option[SourceSpan].None();
};

module_private let drop_self_escape_in_arms(
    arms List[WhenArm],
    in_lambda Bool,
) Option[SourceSpan] = {
    for arm in arms then {
        let found = drop_self_escape_span_in(arm.body, in_lambda);
        if found is .Some(_) then {
            return found;
        };
    };
    return Option[SourceSpan].None();
};

module_private let drop_self_escape_in_statements(
    statements List[Statement],
    in_lambda Bool,
) Option[SourceSpan] = {
    for statement in statements then {
        let found = when statement in {
            .LetStmt(_, _, _, value, _) then drop_self_escape_span_in(value, in_lambda),
            .TupleLetStmt(_, value, _) then drop_self_escape_span_in(value, in_lambda),
            // `self.x = v` is a receiver write; anything else in the target
            // position is a use like any other.
            .AssignmentStmt(target, _, value, _) then {
                let target_found = when target in {
                    .MemberPath(base, _, _) then drop_self_receiver_span(base, in_lambda),
                    _ then drop_self_escape_span_in(target, in_lambda),
                };
                when target_found in {
                    .Some(span) then Option[SourceSpan].Some(span),
                    .None() then drop_self_escape_span_in(value, in_lambda),
                }
            },
            .ExprStmt(expr, _) then drop_self_escape_span_in(expr, in_lambda),
            .ReturnStmt(value, _) then when value in {
                .Some(inner) then drop_self_escape_span_in(inner, in_lambda),
                .None() then Option[SourceSpan].None(),
            },
            .BreakStmt(_) or .ContinueStmt(_) then Option[SourceSpan].None(),
            .DeferStmt(expr, _) then drop_self_escape_span_in(expr, in_lambda),
        };
        if found is .Some(_) then {
            return found;
        };
    };
    return Option[SourceSpan].None();
};

given TypeChecker {
    module_private validate_drop_member_signature(
        self,
        target_type Type,
        members List[TypedGivenMember],
    ) Void = {
        // In the simplified type system, drop(self) is the accepted signature.
        // The parameter type is Self (the type itself), not *unsafe mutable Self.
        let mutable expected_param_type = target_type;
        for member_ref in members then {
            let member = member_ref;
            if member.name <> "drop" then {
                continue;
            };
            if member.params.count() <> 1(UInt) then {
                self.push_diagnostic(
                    "drop must have exactly one parameter",
                    unknown_span(),
                );
                return;
            };
            let param = member.params[0(UInt)];
            if param.name <> "self" then {
                self.push_diagnostic(
                    "drop parameter must be named 'self', got '\(param.name)'",
                    unknown_span(),
                );
                return;
            };
            let actual_param_type = param.param_type;
            if not self.same_expr_type(actual_param_type, expected_param_type) then {
                self.push_diagnostic(
                    "drop parameter must have type '\(self.context().type_display_name(expected_param_type))', got '\(self.context().type_display_name(actual_param_type))'",
                    unknown_span(),
                );
                return;
            };
            if member.return_type is not .VoidType() then {
                self.push_diagnostic("drop must return Void", unknown_span());
            };
            return;
        };
    };

    /// `self` in a `drop` body may only be the receiver of a field access or a
    /// method call. Everything else -- returning it, binding it, storing it,
    /// passing it on, capturing it -- would let a dying object outlive its own
    /// destructor. See `docs/guide/document.md` "Drop".
    module_private validate_drop_member_body_escape(
        self,
        members List[GivenMember],
    ) Void = {
        for member in members then {
            if member.name <> "drop" then {
                continue;
            };
            let body = member.body or else {
                continue;
            };
            when drop_self_escape_span(body) in {
                .Some(span) then {
                    self.push_diagnostic_at_span(
                        "'self' cannot escape a drop body: it may only be the receiver of a field access or a method call",
                        span,
                    );
                },
                .None() then {},
            };
            return;
        };
    };

    /// Mark the target type as having explicit Drop conformance.
    /// This ensures the nominal layout analysis treats it as managed (ARC-backed).
    module_private mark_explicit_drop_conformance(self, target_type Type) Void = {
        when target_type in {
            .StructureType(def_id) then self.context().set_explicit_drop(def_id),
            .EnumType(def_id) then self.context().set_explicit_drop(def_id),
            // Identity is the carried template DefId. Going
            // DefId -> spelling -> name-keyed lookup -> `template.def_id` is a
            // round trip that can only lose: two same-named templates in
            // different modules collapse to one entry. The DefId we need is
            // already in hand (rustc: `Ty::Adt` carries its `DefId`).
            .GenericStruct(tplDefId, _) then self.context().set_explicit_drop(tplDefId),
            .GenericEnum(tplDefId, _) then self.context().set_explicit_drop(tplDefId),
            _ then {},
        };
    };

    module_private check_decl(
        self,
        decl Decl,
        retain_checked_template_bodies Bool,
    ) TypedDecl = {
        let outer_span = self.enter_current_span(self.decl_span(decl));
        defer {
            self.leave_current_span(outer_span);
        };
        return when decl in {
            .LetDecl(access, name, is_mutable, type_name, initializer, span, name_span) then {
                let expected_type = when type_name in {
                    .Some(ta) then Option[Type].Some(self.resolve_type(ta)),
                    .None() then Option[Type].None(),
                };
                let typed_init = self.check_expr_global_ref(initializer, expected_type);
                let resolved = when expected_type in {
                    .Some(t) then t,
                    .None() then typed_init.expr_type,
                };
                self.validate_signature_type_visibility(
                    name,
                    access,
                    [resolved],
                    name_span,
                );
                if self.contains_borrowed_reference_type(resolved) then {
                    self.push_diagnostic(
                        "global variable type cannot contain borrowed reference type '\(self.context().type_display_name(resolved))'",
                        unknown_span(),
                    );
                };
                let stable_initializer = if retain_checked_template_bodies then {
                    let mutable context = self.context();
                    let placeholder_id = self.get_or_allocate_top_level_def_id(
                        name,
                        DefKind.Variable(),
                        access,
                        span,
                    );
                    context.set_concrete_global_initializer(placeholder_id, typed_init);
                    TypedExpr(
                        TypedExprKind.Block(
                            List[TypedStatement].new(),
                            Option[TypedExpr].None(),
                        ),
                        resolved,
                        span,
                    )
                } else typed_init;
                let variable_kind = if is_mutable then VariableKind.MutableValue()
                else VariableKind.Value();
                let sym = self.make_top_level_symbol(
                    name,
                    resolved,
                    SymbolKind.Variable(variable_kind),
                    access,
                    span,
                    is_mutable,
                );
                TypedDecl.LetDecl(
                    access,
                    name,
                    is_mutable,
                    resolved,
                    stable_initializer,
                    span,
                    sym,
                )
            },
            .FunctionDecl(access, name, type_params, params, return_type, body, span, name_span) then {
                // Enter function context — cleanup via defer (Swift: withNewScope pattern)
                let prev_function_return_context = self.clone_function_return_context();
                let prev_in_loop = self.storage.in_loop;
                let prev_in_defer = self.storage.in_defer;
                self.storage.in_loop = false;
                self.storage.in_defer = false;
                self.storage.function_return_context.inferred_return_type = Option[Type].None(
                );
                self.storage.function_return_context.is_inferring = false;
                defer {
                    self.storage.function_return_context = prev_function_return_context;
                    self.storage.in_loop = prev_in_loop;
                    self.storage.in_defer = prev_in_defer;
                };
                let generic_constraint_snapshot = self.snapshot_generic_constraints(
                    type_params,
                );
                self.register_generic_constraints(type_params);
                defer {
                    self.restore_generic_constraints(generic_constraint_snapshot);
                };
                let result = if type_params.is_empty() then {
                    let resolved_ret = self.resolve_type(return_type);
                    if self.contains_borrowed_reference_type(resolved_ret) then {
                        self.push_diagnostic(
                            "function return type cannot contain borrowed reference type '\(self.context().type_display_name(resolved_ret))'",
                            unknown_span(),
                        );
                        if self.contains_never_type(resolved_ret) then {
                            self.push_diagnostic(
                                "function return type cannot contain Never type: '\(self.context().type_display_name(resolved_ret))'",
                                unknown_span(),
                            );
                        };
                    };
                    self.storage.function_return_context.expected_return_type = Option[Type].Some(
                        resolved_ret,
                    );
                    let typed_params = self.check_params(params);
                    let mutable signature_types = List[Type].new();
                    for param in typed_params then {
                        signature_types.push(param.param_type);
                    };
                    signature_types.push(resolved_ret);

                    for p in typed_params then {
                        if self.contains_never_type(p.param_type) then {
                            self.push_diagnostic(
                                "function parameter '\(p.name)' cannot contain Never type: '\(self.context().type_display_name(p.param_type))'",
                                unknown_span(),
                            );
                        };
                    };
                    self.validate_signature_type_visibility(
                        name,
                        access,
                        signature_types,
                        name_span,
                    );
                    let mutable fn_scope = self.make_fn_scope(typed_params);
                    let raw_typed_body = self.check_expr_scoped_ref(
                        body,
                        .Some(resolved_ret),
                        fn_scope,
                    );
                    let typed_body = self.adapt_expr_to_expected_type_at(
                        raw_typed_body,
                        Option[Type].Some(resolved_ret),
                        Option[SourceSpan].Some(span),
                    );
                    let stable_params = typed_params;
                    let stable_ret = resolved_ret;
                    let mutable param_refs = List[Type].new();
                    for param in stable_params then {
                        param_refs.push(param.param_type);
                    };
                    let mutable fn_type = make_function_type(param_refs, stable_ret);
                    let fn_sym = self.make_top_level_symbol(
                        name,
                        fn_type,
                        SymbolKind.Function(),
                        access,
                        span,
                        false,
                    );
                    // Validate entry point signature
                    if name == "main" then {
                        if stable_params.count() > 0 then {
                            self.push_diagnostic(
                                "entry function 'main' must not take parameters",
                                unknown_span(),
                            );
                        };
                        let ret_is_valid = stable_ret is .IntType() or stable_ret is .VoidType();
                        if not ret_is_valid then {
                            self.push_diagnostic(
                                "entry function 'main' must return Int or Void",
                                unknown_span(),
                            );
                        };
                    };
                    let stable_body = if retain_checked_template_bodies then {
                        let mutable context = self.context();
                        context.set_concrete_function_body(fn_sym.def_id, typed_body);
                        context.set_concrete_function_source(
                            fn_sym.def_id,
                            ConcreteExprSource(
                                body,
                                self.storage.file_path,
                                self.storage.package_id,
                                self.storage.module_path,
                            ),
                        );
                        TypedExpr(
                            TypedExprKind.Block(
                                List[TypedStatement].new(),
                                Option[TypedExpr].None(),
                            ),
                            stable_ret,
                            span,
                        )
                    } else typed_body;
                    TypedDecl.FunctionDecl(
                        access,
                        name,
                        stable_params,
                        stable_ret,
                        stable_body,
                        span,
                        fn_sym,
                    )
                } else {
                    let mutable generic_type_scope = Scope.new_child(
                        self.storage.global_scope,
                    );
                    for tp in type_params then {
                        generic_type_scope.define_generic_param(tp.name);
                    };
                    // Set current_scope so resolve_type mutable sees generic params (like Swift's withNewScope)
                    let prev_scope = self.storage.current_scope;
                    self.storage.current_scope = generic_type_scope;
                    let typed_params = self.check_params(params);
                    let resolved_ret = self.resolve_type(return_type);
                    let mutable signature_types = List[Type].new();
                    for param in typed_params then {
                        signature_types.push(param.param_type);
                    };
                    signature_types.push(resolved_ret);
                    self.validate_signature_type_visibility(
                        name,
                        access,
                        signature_types,
                        name_span,
                    );
                    if self.contains_borrowed_reference_type(resolved_ret) then {
                        self.push_diagnostic(
                            "function return type cannot contain borrowed reference type '\(self.context().type_display_name(resolved_ret))'",
                            unknown_span(),
                        );
                    };
                    self.storage.function_return_context.expected_return_type = Option[Type].Some(
                        resolved_ret,
                    );
                    let mutable fn_scope = self.make_generic_fn_scope(
                        typed_params,
                        type_params,
                    );
                    // Keep current_scope pointing to fn_scope during body checking
                    // so resolve_type sees generic params (matches Swift's withNewScope pattern)
                    self.storage.current_scope = fn_scope;
                    if self.template_retain_debug_enabled() then {
                        println(
                            "[template-retain] generic-fn begin file=\(self.storage.file_path) name=\(name)",
                        );
                    };
                    let raw_typed_body = self.check_expr_scoped_ref(
                        body,
                        .Some(resolved_ret),
                        fn_scope,
                    );
                    let typed_body = self.adapt_expr_to_expected_type_at(
                        raw_typed_body,
                        Option[Type].Some(resolved_ret),
                        Option[SourceSpan].Some(span),
                    );
                    self.storage.current_scope = prev_scope;
                    if self.template_retain_debug_enabled() then {
                        println(
                            "[template-retain] generic-fn checked-body file=\(self.storage.file_path) name=\(name)",
                        );
                    };
                    let generic_fn_checked_body = if self.skip_template_typed_body_boxing_debug_enabled(
                    ) then Option[TypedExpr].None()
                    else Option[TypedExpr].Some(typed_body);
                    self.register_generic_function_template(
                        name,
                        type_params,
                        params,
                        return_type,
                        self.template_checked_body(
                            generic_fn_checked_body,
                            retain_checked_template_bodies,
                        ),
                        Option[List[Symbol]].Some(
                            self.typed_params_to_checked_symbols(typed_params),
                        ),
                        Option[Type].Some(resolved_ret),
                    );
                    if self.template_retain_debug_enabled() then {
                        println(
                            "[template-retain] generic-fn registered file=\(self.storage.file_path) name=\(name)",
                        );
                    };
                    return TypedDecl.GenericFunctionDecl(access, name, span);
                };
                result
            },
            .IntrinsicFunctionDecl(access, name, type_params, params, return_type, span, name_span) then {
                let generic_constraint_snapshot = self.snapshot_generic_constraints(
                    type_params,
                );
                self.register_generic_constraints(type_params);
                defer {
                    self.restore_generic_constraints(generic_constraint_snapshot);
                };
                // Resolve signature in a generic scope if type mutable params exist (Swift: withNewScope)
                let prev = self.storage.current_scope;
                if not type_params.is_empty() then {
                    let mutable s = Scope.new_child(self.storage.current_scope);
                    for tp in type_params then {
                        s.define_generic_param(tp.name);
                    };
                    self.storage.current_scope = s;
                };
                let resolved_ret = self.resolve_type(return_type);
                let typed_params = self.check_params(params);
                let mutable signature_types = List[Type].new();
                for param in typed_params then {
                    signature_types.push(param.param_type);
                };
                signature_types.push(resolved_ret);
                self.validate_signature_type_visibility(
                    name,
                    access,
                    signature_types,
                    name_span,
                );
                self.storage.current_scope = prev;
                let mutable param_refs = List[Type].new();
                for param in typed_params then {
                    param_refs.push(param.param_type);
                };
                let mutable fn_type = make_function_type(param_refs, resolved_ret);
                TypedDecl.IntrinsicFunctionDecl(
                    access,
                    name,
                    typed_params,
                    resolved_ret,
                    span,
                    self.make_top_level_symbol(
                        name,
                        fn_type,
                        SymbolKind.Function(),
                        access,
                        span,
                        false,
                    ),
                )
            },
            .ForeignFunctionDecl(access, name, params, return_type, span, name_span) then {
                let resolved_ret = self.resolve_type(return_type);
                let typed_params = self.check_params(params);
                let mutable signature_types = List[Type].new();
                for param in typed_params then {
                    signature_types.push(param.param_type);
                };
                signature_types.push(resolved_ret);
                self.validate_signature_type_visibility(
                    name,
                    access,
                    signature_types,
                    name_span,
                );
                if not self.is_ffi_compatible_type(resolved_ret) then {
                    self.push_diagnostic(
                        "FFI incompatible type '\(self.context().type_display_name(resolved_ret))': \(self.ffi_type_error(resolved_ret))",
                        type_node_span(return_type),
                    );
                };
                for param in params then {
                    let param_type = self.resolve_type(param.type_name);
                    if not self.is_ffi_compatible_type(param_type) then {
                        self.push_diagnostic(
                            "FFI incompatible type '\(self.context().type_display_name(param_type))': \(self.ffi_type_error(param_type))",
                            type_node_span(param.type_name),
                        );
                    };
                };
                let mutable param_refs = List[Type].new();
                for param in typed_params then {
                    param_refs.push(param.param_type);
                };
                let fn_type = make_function_type(param_refs, resolved_ret);
                TypedDecl.ForeignFunctionDecl(
                    access,
                    name,
                    typed_params,
                    resolved_ret,
                    span,
                    self.make_top_level_symbol(
                        name,
                        fn_type,
                        SymbolKind.Function(),
                        access,
                        span,
                        false,
                    ),
                )
            },
            .ForeignLetDecl(access, name, is_mutable, type_name, span, name_span) then {
                let resolved = self.resolve_type(type_name);
                self.validate_signature_type_visibility(
                    name,
                    access,
                    [resolved],
                    name_span,
                );
                if not self.is_ffi_compatible_type(resolved) then {
                    self.push_diagnostic(
                        "FFI incompatible type '\(self.context().type_display_name(resolved))': \(self.ffi_type_error(resolved))",
                        type_node_span(type_name),
                    );
                };
                let variable_kind = if is_mutable then VariableKind.MutableValue()
                else VariableKind.Value();
                TypedDecl.ForeignLetDecl(
                    access,
                    name,
                    is_mutable,
                    resolved,
                    span,
                    self.make_top_level_symbol(
                        name,
                        resolved,
                        SymbolKind.Variable(variable_kind),
                        access,
                        span,
                        is_mutable,
                    ),
                )
            },
            .TypeStructDecl(access, name, is_mutable_type, type_params, fields, span, name_span) then {
                let typed_fields = if type_params.is_empty() then {
                    self.check_fields(fields)
                } else {
                    let mutable type_scope = Scope.new_child(self.storage.global_scope);
                    for tp in type_params then {
                        type_scope.define_generic_param(tp.name);
                    };
                    self.check_fields_in_scope(fields, type_scope)
                };
                for field in typed_fields then {
                    if self.contains_borrowed_reference_type(field.field_type) then {
                        self.push_diagnostic(
                            "struct field '\(field.name)' cannot contain borrowed reference type '\(self.context().type_display_name(field.field_type))'",
                            unknown_span(),
                        );
                    };
                    if self.contains_never_type(field.field_type) then {
                        self.push_diagnostic(
                            "struct field '\(field.name)' cannot contain Never type: '\(self.context().type_display_name(field.field_type))'",
                            unknown_span(),
                        );
                    };
                    if field.is_mutable and not is_mutable_type then {
                        self.push_diagnostic(
                            "Value type '\(name)' cannot have mutable field '\(field.name)'",
                            unknown_span(),
                        );
                    };
                };
                if type_params.is_empty() then {
                    let fallback_type = Type.StructureType(
                        self.get_or_allocate_top_level_def_id(
                            name,
                            DefKind.TypeDef(TypeDefKind.Structure()),
                            access,
                            span,
                        ),
                    );
                    let resolved_struct_type = self.lookup_current_file_type_symbol(
                        name,
                    ) or else fallback_type;
                    when resolved_struct_type in {
                        .StructureType(def_id) then {
                            let mutable context = self.context();
                            context.set_struct_mutable(def_id, is_mutable_type);
                        },
                        _ then {},
                    };
                    let type_sym = self.make_top_level_type_symbol(
                        name,
                        TypeDefKind.Structure(),
                        resolved_struct_type,
                        access,
                        span,
                    );
                    TypedDecl.TypeStructDecl(access, name, typed_fields, span, type_sym)
                } else TypedDecl.GenericTypeStructDecl(access, name, span)
            },
            .TypeEnumDecl(access, name, type_params, cases, span, name_span) then {
                let typed_cases = if type_params.is_empty() then {
                    self.check_enum_cases(cases)
                } else {
                    let mutable type_scope = Scope.new_child(self.storage.global_scope);
                    for tp in type_params then {
                        type_scope.define_generic_param(tp.name);
                    };
                    self.check_enum_cases_in_scope(cases, type_scope)
                };
                for enum_case in typed_cases then {
                    for field in enum_case.fields then {
                        if self.contains_borrowed_reference_type(field.field_type) then {
                            self.push_diagnostic(
                                "enum payload '\(name).\(enum_case.name).\(field.name)' cannot contain borrowed reference type '\(self.context().type_display_name(field.field_type))'",
                                unknown_span(),
                            );
                        };
                        if self.contains_never_type(field.field_type) then {
                            self.push_diagnostic(
                                "enum payload '\(name).\(enum_case.name).\(field.name)' cannot contain Never type: '\(self.context().type_display_name(field.field_type))'",
                                unknown_span(),
                            );
                        };
                    };
                };
                if type_params.is_empty() then {
                    let fallback_type = Type.EnumType(
                        self.get_or_allocate_top_level_def_id(
                            name,
                            DefKind.TypeDef(TypeDefKind.Enum()),
                            access,
                            span,
                        ),
                    );
                    let type_sym = self.make_top_level_type_symbol(
                        name,
                        TypeDefKind.Enum(),
                        self.lookup_current_file_type_symbol(name) or else fallback_type,
                        access,
                        span,
                    );
                    TypedDecl.TypeEnumDecl(access, name, typed_cases, span, type_sym)
                } else TypedDecl.GenericTypeEnumDecl(access, name, span)
            },
            .TypeAliasDecl(access, name, target, span, name_span) then {
                let self_referential_target = when target in {
                    .Identifier(target_name, span) then target_name == name,
                    .Generic(base, _, span) then base == name,
                    _ then false,
                };
                let mutable resolved_target = self.resolve_type(target);
                if self_referential_target then {
                    // The message names the TARGET spelling -- `type A = A;`
                    // blames the second `A`, not the declaration.
                    self.push_diagnostic(
                        "Undefined type: \(name)",
                        type_node_span(target),
                    );
                    resolved_target = Type.Unknown();
                };
                self.storage.global_scope.define_scoped_type(
                    self.storage.module_path,
                    name,
                    resolved_target,
                );
                TypedDecl.TypeAliasDecl(access, name, resolved_target, span)
            },
            .IntrinsicTypeDecl(access, name, type_params, span, name_span) then {
                TypedDecl.IntrinsicTypeDecl(access, name, span)
            },
            .ForeignTypeDecl(access, name, cname, fields, span, name_span) then {
                let typed_fields = when fields in {
                    .Some(raw_fields) then {
                        let mutable out = List[TypedField].new();
                        for f in raw_fields then {
                            out.push(
                                TypedField(
                                    f.access,
                                    f.name,
                                    f.is_mutable,
                                    self.resolve_type(f.type_name),
                                    f.named,
                                ),
                            );
                        };
                        Option[List[TypedField]].Some(out)
                    },
                    .None() then Option[List[TypedField]].None(),
                };
                let type_kind = when typed_fields in {
                    .Some(_) then TypeDefKind.Structure(),
                    .None() then TypeDefKind.Opaque(),
                };
                let fallback_type = when type_kind in {
                    .Structure() then Type.StructureType(
                        self.get_or_allocate_top_level_def_id(
                            name,
                            DefKind.TypeDef(type_kind),
                            access,
                            span,
                        ),
                    ),
                    .Opaque() then Type.OpaqueType(
                        self.get_or_allocate_top_level_def_id(
                            name,
                            DefKind.TypeDef(type_kind),
                            access,
                            span,
                        ),
                    ),
                    _ then Type.OpaqueType(
                        self.get_or_allocate_top_level_def_id(
                            name,
                            DefKind.TypeDef(type_kind),
                            access,
                            span,
                        ),
                    ),
                };
                let mutable symbol_type = self.lookup_current_file_type_symbol(name) or else fallback_type;
                TypedDecl.ForeignTypeDecl(
                    access,
                    name,
                    typed_fields,
                    span,
                    self.make_top_level_type_symbol(
                        name,
                        type_kind,
                        symbol_type,
                        access,
                        span,
                    ),
                )
            },
            .UsingDecl(specifier, _, span) then {
                let mutable path_segments = List[String].new();
                path_segments.push(specifier);
                TypedDecl.UsingDecl(AccessModifier.FilePrivate(), path_segments, span)
            },
            .TraitDecl(access, name, type_params, parents, members, span, name_span) then {
                let generic_constraint_snapshot = self.snapshot_generic_constraints(
                    type_params,
                );
                self.register_generic_constraints(type_params);
                let mutable trait_scope = Scope.new_child(self.storage.global_scope);
                trait_scope.define_generic_param("Self");
                for tp in type_params then {
                    trait_scope.define_generic_param(tp.name);
                };
                self.validate_trait_parent_type_arguments_in_scope(parents, trait_scope);
                // 注册 Trait 到 TraitRegistry
                let mutable parent_constraints = List[ParentTraitConstraint].new();
                let mutable seen_parent_keys = List[String].new();
                for p in parents then {
                    let pname = self.type_node_name(p);
                    let type_arg_nodes = when p in {
                        .Generic(_, args, span) then {
                            let mutable nodes = List[TypeNode].new();
                            for arg in args then {
                                nodes.push(arg);
                            };
                            nodes
                        },
                        _ then List[TypeNode].new(),
                    };
                    let parent_key = when p in {
                        .Generic(_, args, span) then {
                            let mutable out = StringBuilder.new();
                            out.push_string("[");
                            let mutable first = true;
                            for arg in args then {
                                if not first then {
                                    out.push_string(", ");
                                };
                                first = false;
                                let resolved_arg = self.resolve_type_in_scope(
                                    arg,
                                    trait_scope,
                                );
                                out.push_string(self.display_type_name(resolved_arg));
                            };
                            out.push_string("]");
                            out.push_string(pname);
                            out.to_string()
                        },
                        _ then pname,
                    };
                    if self.string_list_contains(seen_parent_keys, parent_key) then {
                        self.push_diagnostic(
                            "Duplicate parent trait '\(parent_key)' in trait '\(name)'",
                            unknown_span(),
                        );
                        continue;
                    };
                    seen_parent_keys.push(parent_key);
                    parent_constraints.push(
                        ParentTraitConstraint(
                            pname,
                            type_arg_nodes,
                            self.trait_def_id_of(pname) or else def_id_invalid(),
                        ),
                    );
                };
                let typed_members = self.check_trait_members(members, type_params);
                let trait_def_id = self.lookup_current_file_def_id(name) or else def_id_invalid(
                );
                self.register_trait_metadata(
                    name,
                    trait_def_id,
                    type_params,
                    parent_constraints,
                    members,
                    typed_members,
                );
                when self.storage.trait_registry.validate_inheritance_graph(name) in {
                    .Ok(_) then {},
                    .Error(message) then {
                        self.push_diagnostic(message.message(), unknown_span());
                    },
                };
                self.restore_generic_constraints(generic_constraint_snapshot);
                TypedDecl.TraitDecl(access, name, typed_members, span)
            },
            .GivenDecl(target_type, type_params, members, span) then {
                if self.reject_concrete_type_modifier_given_if_needed(
                    target_type,
                    type_params,
                ) or self.reject_invalid_generic_given_target_if_needed(
                    target_type,
                    type_params,
                ) then {
                    TypedDecl.GivenDecl(
                        Type.Unknown(),
                        List[TypedGivenMember].new(),
                        span,
                    )
                } else {
                    let trait_tool_name = self.trait_tool_target_name(
                        target_type,
                        type_params,
                    );
                    let generic_constraint_snapshot = self.snapshot_generic_constraints(
                        type_params,
                    );
                    self.register_generic_constraints(type_params);
                    let bindings = self.generic_type_param_bindings(type_params);
                    let resolved_target = if trait_tool_name is .Some(_) or not type_params.is_empty(
                    ) then self.resolve_type_with_bindings(target_type, bindings)
                    else self.resolve_type(target_type);
                    // Given locality check: target type must be in current module
                    let locality_checker = GivenLocalityChecker.new(
                        self.context(),
                        self.storage.trait_registry,
                        self.storage.module_path,
                        self.storage.generic_templates,
                        self.storage.global_scope,
                    );
                    if locality_checker.check_given_owner_locality(resolved_target) is .Some(msg) then {
                        self.push_diagnostic(msg, span);
                    };
                    let mutable typed_members = self.check_given_members_for_type(
                        members,
                        resolved_target,
                        type_params,
                        type_params,
                        Option[String].None(),
                        retain_checked_template_bodies,
                        List[TypeParameterDecl].new(),
                    );
                    if not self.contains_generic_parameter(resolved_target) then {
                        self.register_conformance_method_signatures_for_concrete_type(
                            resolved_target,
                            typed_members,
                            true,
                            Option[DefId].None(),
                        );
                    };
                    self.register_receiver_dispatch_for_given_members(
                        resolved_target,
                        Option[String].None(),
                        Option[DefId].None(),
                        typed_members,
                    );
                    self.restore_generic_constraints(generic_constraint_snapshot);
                    TypedDecl.GivenDecl(resolved_target, typed_members, span)
                }
            },
            .GivenTraitDecl(target_type, type_params, trait_type, members, span) then {
                let mutable result_decl = TypedDecl.GivenTraitDecl(
                    Type.Unknown(),
                    self.type_node_name(trait_type),
                    List[Type].new(),
                    List[TypedGivenMember].new(),
                    span,
                    self.trait_def_id_of(self.type_node_name(trait_type)) or else DefId(
                        0(UInt),
                    ),
                );
                if not self.reject_concrete_type_modifier_given_if_needed(
                    target_type,
                    type_params,
                ) and not self.reject_invalid_generic_given_target_if_needed(
                    target_type,
                    type_params,
                ) then {
                    let generic_constraint_snapshot = self.snapshot_generic_constraints(
                        type_params,
                    );
                    self.register_generic_constraints(type_params);
                    let trait_name = self.type_node_name(trait_type);
                    let bindings = self.generic_type_param_bindings(type_params);
                    let resolved_target = if type_params.is_empty() then self.resolve_type(
                        target_type,
                    ) else self.resolve_type_with_bindings(target_type, bindings);
                    let resolved_trait_args = self.trait_type_args_with_bindings(
                        trait_type,
                        bindings,
                    );
                    self.record_explicit_trait_conformance(
                        resolved_target,
                        trait_name,
                        resolved_trait_args,
                    );
                    self.record_generic_trait_conformance_template(
                        resolved_target,
                        type_params,
                        trait_name,
                        resolved_trait_args,
                    );
                    // Given conformance locality check (orphan rule)
                    let locality_checker = GivenLocalityChecker.new(
                        self.context(),
                        self.storage.trait_registry,
                        self.storage.module_path,
                        self.storage.generic_templates,
                        self.storage.global_scope,
                    );
                    if locality_checker.check_given_conformance_locality(
                        resolved_target,
                        trait_name,
                    ) is .Some(msg) then {
                        self.push_diagnostic(msg, span);
                    };
                    let mutable typed_members = self.check_given_members_for_type(
                        members,
                        resolved_target,
                        type_params,
                        type_params,
                        Option[String].Some(trait_name),
                        retain_checked_template_bodies,
                        List[TypeParameterDecl].new(),
                    );
                    if self.is_std_drop_trait(trait_name) then {
                        self.validate_drop_member_signature(
                            resolved_target,
                            typed_members,
                        );
                        self.validate_drop_member_body_escape(members);
                        // Mark the target type as having explicit Drop conformance.
                        // This is needed for nominal layout analysis: types with explicit Drop
                        // must use managed nominal representation (ARC-backed).
                        self.mark_explicit_drop_conformance(resolved_target);
                    };
                    // 检查 Trait 一致性
                    let checker = TraitChecker.new(
                        self.storage.trait_registry,
                        self.storage.method_table,
                        self.context(),
                    );
                    when self.storage.trait_registry.get_in_module(
                        trait_name,
                        self.storage.module_path,
                    ) in {
                        .Some(info) then {
                            for parent in info.parent_traits then {
                                if parent.type_arg_nodes.is_empty() then {
                                    // Simple parent trait (no generic args)
                                    if not self.has_direct_explicit_trait_conformance(
                                        resolved_target,
                                        parent.def_id,
                                        parent.name,
                                        List[Type].new(),
                                    ) then {
                                        self.push_diagnostic(
                                            "Parent trait '\(parent.name)' must be explicitly implemented for child trait '\(trait_name)'",
                                            unknown_span(),
                                        );
                                    };
                                } else {
                                    // Generic parent trait — resolve args with explicit substitution.
                                    let mutable parent_bindings = Dict[String, Type].new(
                                    );
                                    parent_bindings.insert("Self", resolved_target);
                                    when self.storage.trait_registry.get_in_module(
                                        trait_name,
                                        self.storage.module_path,
                                    ) in {
                                        .Some(ti) then {
                                            let targs = resolved_trait_args;
                                            let mutable tidx UInt = 0;
                                            while tidx < ti.type_params.count() and tidx < targs.count(
                                            ) then {
                                                parent_bindings.insert(
                                                    ti.type_params[tidx],
                                                    targs[tidx],
                                                );
                                                tidx += 1;
                                            };
                                        },
                                        .None() then {},
                                    };
                                    let mutable resolved_parent_args = List[Type].new();
                                    for arg_node in parent.type_arg_nodes then {
                                        resolved_parent_args.push(
                                            self.resolve_type_with_bindings(
                                                arg_node,
                                                parent_bindings,
                                            ),
                                        );
                                    };
                                    if not self.has_direct_explicit_trait_conformance(
                                        resolved_target,
                                        parent.def_id,
                                        parent.name,
                                        resolved_parent_args,
                                    ) then {
                                        // Build display key for error message
                                        let mutable parent_display = StringBuilder.new();
                                        parent_display.push_string("[");
                                        let mutable first = true;
                                        for arg in resolved_parent_args then {
                                            if not first then {
                                                parent_display.push_string(", ");
                                            };
                                            first = false;
                                            parent_display.push_string(
                                                self.context().type_display_name(arg),
                                            );
                                        };
                                        parent_display.push_string("]");
                                        parent_display.push_string(parent.name);
                                        self.push_diagnostic(
                                            "Parent trait '\(parent_display.to_string())' must be explicitly implemented for child trait '\(trait_name)'",
                                            unknown_span(),
                                        );
                                    };
                                };
                            };
                        },
                        .None() then {},
                    };
                    if checker.check_conformance_in_module(
                        resolved_target,
                        trait_name,
                        resolved_trait_args,
                        typed_members,
                        span,
                        self.storage.module_path,
                    ) is .Error(e) then {
                        self.push_diagnostic(e.message(), span);
                    };
                    if not self.contains_generic_parameter(resolved_target) then {
                        self.register_conformance_method_signatures_for_concrete_type(
                            resolved_target,
                            typed_members,
                            false,
                            self.trait_def_id_of(trait_name),
                        );
                    };
                    let tool_members = self.materialize_trait_tool_members_for_conformance(
                        trait_name,
                        resolved_target,
                        resolved_trait_args,
                        type_params,
                        typed_members,
                        retain_checked_template_bodies,
                        span,
                    );
                    for tool_member in tool_members then {
                        typed_members.push(tool_member);
                    };
                    // Record a witness for EVERY conformance, generic ones included.
                    //
                    // A generic conformance's witness is keyed on its DECLARED
                    // shape (`given[T] Box[T] as Show` is filed under `Box[T]`),
                    // so nothing downstream can mistake it for an instance --
                    // consumers ask for `Box[Int]` and would not find it. It is
                    // the SOURCE mono specializes from: see
                    // `materialize_conformance_witness_for_instance`, which
                    // re-keys it onto the concrete receiver with the type
                    // parameters substituted. rustc does the same split: the
                    // `impl` is a declaration, the witness belongs to
                    // `Instance { def, args }`.
                    self.record_conformance_witness(
                        resolved_target,
                        trait_name,
                        resolved_trait_args,
                        typed_members,
                    );
                    if not self.contains_generic_parameter(resolved_target) then {
                        self.register_conformance_method_signatures_for_concrete_type(
                            resolved_target,
                            tool_members,
                            false,
                            self.trait_def_id_of(trait_name),
                        );
                    };
                    // Validate default value consistency between trait and implementation
                    when self.storage.trait_registry.flatten_methods_in_module(
                        trait_name,
                        self.storage.module_path,
                    ) in {
                        .Ok(trait_methods) then {
                            for member in members then {
                                when trait_methods.get(member.name) in {
                                    .Some(trait_method) then {
                                        let param_count = if trait_method.params.count() < member.params.count(
                                        ) then trait_method.params.count()
                                        else member.params.count();
                                        let mutable pi UInt = 1;
                                        while pi < param_count then {
                                            let trait_param = trait_method.params[pi];
                                            let impl_param = member.params[pi];
                                            if trait_param.named and impl_param.named then {
                                                let trait_key = "\(member.name).\(trait_param.name)";
                                                let impl_key = "\(member.name).\(impl_param.name)";
                                                let trait_has_default = self.context().parsed_default_values.contains_key(
                                                    trait_key,
                                                );
                                                let impl_has_default = self.context().parsed_default_values.contains_key(
                                                    impl_key,
                                                );
                                                if trait_has_default and impl_has_default then {
                                                    self.push_diagnostic(
                                                        "Trait method '\(member.name)' has default value for parameter '\(trait_param.name)', implementation must not also declare a default value",
                                                        unknown_span(),
                                                    );
                                                };
                                                if not trait_has_default and impl_has_default then {
                                                    self.push_diagnostic(
                                                        "Trait method '\(member.name)' has no default value for parameter '\(trait_param.name)', implementation cannot add a default value",
                                                        unknown_span(),
                                                    );
                                                };
                                            };
                                            pi += 1;
                                        };
                                    },
                                    .None() then {},
                                };
                            };
                        },
                        .Error(_) then {},
                    };
                    if not self.contains_generic_parameter(resolved_target) then {};
                    // Resolve the trait's declaration identity once at the boundary (Swift does the
                    // same via `visibleTraitInfo(name)?.defId`); everything downstream matches on
                    // this DefId rather than re-deriving identity from the name string.
                    let conformance_trait_def_id = when self.storage.trait_registry.get_in_module(
                        trait_name,
                        self.storage.module_path,
                    ) in {
                        .Some(trait_info) then Option[DefId].Some(trait_info.def_id),
                        .None() then Option[DefId].None(),
                    };
                    self.register_receiver_dispatch_for_given_members(
                        resolved_target,
                        Option[String].Some(trait_name),
                        conformance_trait_def_id,
                        typed_members,
                    );
                    self.register_receiver_dispatch_for_given_members(
                        resolved_target,
                        Option[String].Some(trait_name),
                        conformance_trait_def_id,
                        tool_members,
                    );
                    self.restore_generic_constraints(generic_constraint_snapshot);
                    result_decl = TypedDecl.GivenTraitDecl(
                        resolved_target,
                        trait_name,
                        resolved_trait_args,
                        typed_members,
                        span,
                        self.trait_def_id_of(trait_name) or else DefId(0(UInt)),
                    );
                };
                result_decl
            },
            .IntrinsicGivenDecl(target_type, type_params, members, span) then {
                if self.reject_concrete_type_modifier_given_if_needed(
                    target_type,
                    type_params,
                ) then {
                    TypedDecl.IntrinsicGivenDecl(
                        Type.Unknown(),
                        List[TypedGivenMember].new(),
                        span,
                    )
                } else {
                    let generic_constraint_snapshot = self.snapshot_generic_constraints(
                        type_params,
                    );
                    self.register_generic_constraints(type_params);
                    let bindings = self.generic_type_param_bindings(type_params);
                    let resolved_target = if type_params.is_empty() then self.resolve_type(
                        target_type,
                    ) else self.resolve_type_with_bindings(target_type, bindings);
                    let mutable typed_members = self.check_given_members_for_type(
                        members,
                        resolved_target,
                        type_params,
                        type_params,
                        Option[String].None(),
                        retain_checked_template_bodies,
                        List[TypeParameterDecl].new(),
                    );
                    if not self.contains_generic_parameter(resolved_target) then {
                        self.register_conformance_method_signatures_for_concrete_type(
                            resolved_target,
                            typed_members,
                            true,
                            Option[DefId].None(),
                        );
                    };
                    self.register_receiver_dispatch_for_given_members(
                        resolved_target,
                        Option[String].None(),
                        Option[DefId].None(),
                        typed_members,
                    );
                    self.restore_generic_constraints(generic_constraint_snapshot);
                    TypedDecl.IntrinsicGivenDecl(resolved_target, typed_members, span)
                }
            },
        };
    };

    module_private type_node_name(self, node TypeNode) String = {
        return when node in {
            .Identifier(name, span) then name,
            .Generic(base, _, span) then base,
            _ then "?",
        };
    };

    module_private concrete_type_modifier_given_message(self) String = {
        return "Concrete type modifier given declarations are not allowed. Use generic form instead, e.g., 'given [T SomeTrait] T as SomeTrait { ... }'";
    };

    /// A generic given must target a generic type constructor applied to
    /// exactly its own type parameters: `given [T Any] Box[T] { ... }`.
    ///
    /// A bare type name (`given [T Any] One { ... }`) leaves `T` unbound, and a
    /// concrete specialization (`given [T Any] Box[Int]`) is not supported.
    /// Type modifiers (`ref`, `ptr`, `?`) are the one non-nominal shape allowed.
    ///
    /// Returns true when the target was rejected. Mirrors Swift's
    /// `decomposeGenericGivenTypeNode` and the checks around it.
    module_private reject_invalid_generic_given_target_if_needed(
        self,
        target_type TypeNode,
        type_params List[TypeParameter],
    ) Bool = {
        if type_params.is_empty() then {
            return false;
        };
        let (base_name, args) = when target_type in {
            .Generic(base, args, span) then Pair(base, args),
            .Reference(_, _, span) then Pair("Ref", List[TypeNode].new()),
            .Pointer(_, _, span) then Pair("Ptr", List[TypeNode].new()),
            .WeakReference(_, _, _) then Pair("WeakRef", List[TypeNode].new()),
            _ then {
                self.push_diagnostic(
                    "Invalid operation generic given on non-generic type between types  and ",
                    unknown_span(),
                );
                return true;
            },
        };
        when target_type in {
            .Generic(_, _, span) then {
                if args.count() <> type_params.count() then {
                    self.push_diagnostic(
                        "Type mismatch: expected \(type_params.count()) generic params, got \(args.count())",
                        unknown_span(),
                    );
                    return true;
                };
                let mutable i UInt = 0;
                while i < args.count() then {
                    let arg_matches = when args[i] in {
                        .Identifier(arg_name, span) then arg_name == type_params[i].name,
                        _ then false,
                    };
                    if not arg_matches then {
                        self.push_diagnostic(
                            "Invalid operation generic given specialization not supported between types \(type_node_display(args[i])) and ",
                            unknown_span(),
                        );
                        return true;
                    };
                    i += 1;
                };
            },
            _ then {},
        };
        // `given [T Any] Iterator[T] { ... }` is a trait-ENTITY given -- it adds
        // members to the trait itself. That shape is validated on its own path,
        // so it is not subject to the nominal-target rule below.
        let is_trait_entity = self.storage.trait_registry.get_in_module(
            base_name,
            self.storage.module_path,
        ) is .Some(_) or self.storage.trait_registry.get_in_module(
            base_name,
            self.storage.module_path,
        ) is .Some(_);
        let is_type_constructor = self.storage.generic_templates.lookup_struct_def_id(
            base_name,
        ).is_valid() or self.storage.generic_templates.lookup_enum_def_id(base_name).is_valid(
        );
        let is_type_modifier = base_name == "Ref" or base_name == "Ptr" or base_name == "WeakRef";
        if not is_trait_entity and not is_type_constructor and not is_type_modifier then {
            self.push_diagnostic(
                "Invalid operation generic given on non-generic type between types \(base_name) and ",
                unknown_span(),
            );
            return true;
        };
        return false;
    };

    module_private is_concrete_type_modifier_given_target(
        self,
        target_type TypeNode,
        type_params List[TypeParameter],
    ) Bool = {
        if not type_params.is_empty() then {
            return false;
        };
        return when target_type in {
            .Reference(_, _, span) then true,
            .Pointer(_, _, span) then true,
            .WeakReference(_, _, span) then true,
            _ then false,
        };
    };

    module_private reject_concrete_type_modifier_given_if_needed(
        self,
        target_type TypeNode,
        type_params List[TypeParameter],
    ) Bool = {
        if self.is_concrete_type_modifier_given_target(target_type, type_params) then {
            self.push_diagnostic(
                self.concrete_type_modifier_given_message(),
                unknown_span(),
            );
            return true;
        };
        return false;
    };

    module_private validate_trait_parent_arity(
        self,
        trait_name String,
        actual_count UInt,
    ) Void = {
        if actual_count == 0(UInt) then {
            return;
        };
        when self.storage.trait_registry.get_in_module(
            trait_name,
            self.storage.module_path,
        ) in {
            .Some(info) then {
                let expected_count = info.type_params.count();
                if expected_count <> actual_count then {
                    self.push_diagnostic(
                        "Type mismatch: expected \(expected_count) generic arguments, got \(actual_count)",
                        unknown_span(),
                    );
                };
            },
            .None() then {},
        };
    };

    module_private validate_trait_parent_type_arguments(self, parents List[TypeNode]) Void = {
        let scope = Scope.new_child(self.storage.global_scope);
        self.validate_trait_parent_type_arguments_in_scope(parents, scope);
    };

    module_private validate_trait_parent_type_arguments_in_scope(
        self,
        parents List[TypeNode],
        scope Scope,
    ) Void = {
        for parent in parents then {
            when parent in {
                .Identifier(name, span) then {
                    self.validate_trait_parent_arity(name, 0(UInt));
                },
                .Generic(base, args, span) then {
                    self.validate_trait_parent_arity(base, args.count());
                    for arg in args then {
                        let _ = self.resolve_type_in_scope(arg, scope);
                    };
                },
                _ then {},
            };
        };
    };
};
