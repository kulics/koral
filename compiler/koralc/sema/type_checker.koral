// Type Checker - Pass 2 + 3

using "std/os" { env };

// Pass 2: collect_signatures - resolves type members and function signatures
// Pass 3: check_decl - checks function bodies and generates TypedAST
// All mutable checker state lives in storage so TypeChecker can be passed by
// value without losing mutations (mirrors the List/storage ref pattern).

/// Compile-time mirror of the runtime global-accessor state machine: a global
/// initializer is checked on demand and `Checking` re-entrance is an inference
/// cycle -- only a type annotation can break one.
type GlobalInitState {
    Unchecked(),
    Checking(),
    Done(),
};

/// A pending global-initializer check: the declaration to run, and what came
/// out of it once it has run. `annotated_type` is the declared type resolved
/// once up front -- a reference may use it before the initializer is checked.
type mutable GlobalInitEntry(
    decl: Decl,
    retain_templates: Bool,
    annotated_type: Option[Type],
    mutable state: GlobalInitState,
    mutable checked: Option[TypedDecl],
);

type mutable TypeCheckerStorage(
    mutable global_scope: Scope,
    mutable context: CompilerContext,
    mutable method_table: MethodTable,
    // One DefId per `given` member, assigned once and reused by every later
    // pass. The parser cannot allocate, so `GivenMember.def_id` arrives invalid;
    // if each pass minted its own the typed member and the AST member would
    // disagree and a call site bound to one could not find a table keyed by the
    // other.
    mutable given_member_def_ids: Dict[String, DefId],
    mutable diagnostics: DiagnosticCollector,
    mutable file_path: String,
    mutable module_path: List[String],
    mutable package_id: String,
    mutable function_return_context: FunctionReturnContext,
    mutable in_loop: Bool,
    mutable in_defer: Bool,
    mutable constraint_solver: ConstraintSolver,
    mutable trait_registry: TraitRegistry,
    mutable generic_param_constraints: Dict[String, List[GenericConstraintBound]],
    /// Shape bounds on a type parameter -- `T mutable`, `T foreign` -- keyed by
    /// parameter name. These are not traits and cannot live in
    /// `generic_param_constraints`; without them a bare `T` would appear to
    /// satisfy every shape bound, which is how `f[T Any]` used to call
    /// `g[T mutable]` unchecked.
    mutable generic_param_shape_bounds: Dict[String, List[Bound]],
    /// A method's OWN type parameters -- `get[T mutable]` inside a `given` --
    /// keyed by the method symbol's declaration identity. The call site holds a
    /// `Symbol`; this is the only way back to the bound list it must enforce.
    /// Registered whenever a method symbol is built from a declaration that
    /// carries type parameters; empty lists are never stored.
    mutable method_type_params: Dict[DefId, List[TypeParameterDecl]],
    mutable generic_templates: GenericTemplateRegistry,
    mutable instantiation_requests: Set[InstantiationRequest],
    mutable import_graph: Option[ImportGraph],
    mutable explicit_trait_conformances: Set[ExplicitTraitConformanceKey],
    /// Where each conformance was FIRST declared, keyed like
    /// `explicit_trait_conformances`. Conflict detection compares the stored
    /// span against the visiting declaration's: the same declaration arrives
    /// once per pass and re-registering its own span is not a conflict, while a
    /// second declaration of the same (self type, trait) pair is.
    mutable conformance_decl_origins: Dict[ExplicitTraitConformanceKey, SourceSpan],
    mutable generic_trait_conformance_templates: List[GenericTraitConformanceTemplate],
    mutable conformance_index: Dict[MethodOwner, List[GenericTraitConformanceTemplate]],
    mutable trait_requirement_in_progress: Set[ExplicitTraitConformanceKey],
    mutable generic_trait_status_in_progress: Set[ExplicitTraitConformanceKey],
    mutable trait_requirement_cache: Dict[ExplicitTraitConformanceKey, Bool],
    mutable generic_trait_status_cache: Dict[ExplicitTraitConformanceKey, GenericTraitConformanceStatus],
    /// Constraint enforcement phase. Swift calls `enforceGenericConstraints`
    /// only from `resolveGenericExtensionMethod` — i.e. at a CALL SITE, where
    /// type arguments are concrete. Checking a body while materializing a
    /// trait-tool method for a conformance is a DECLARATION activity and must
    /// not report constraint violations: `contains` materialized for
    /// `EnumerateIterator[T, R] as Iterator[Pair[UInt, T]]` would otherwise
    /// demand `Pair[UInt, T]: Eq` before `T` is known. True = defer.
    mutable constraint_enforcement_deferred: Bool,
    mutable conformance_witnesses: Dict[String, ConformanceWitness],
    /// Current scope for type resolution — analogous to Swift's `currentScope`.
    /// Always points to the innermost scope. Type resolution walks up the scope chain.
    /// Initialized to global_scope in the constructor.
    mutable current_scope: Scope,
    /// Where the checker currently is, for a diagnostic that has no more
    /// specific place to blame.
    ///
    /// A rule that finds a problem "while checking X" reports a problem AT X.
    /// The walker records the construct it has entered, and a message that
    /// arrives without a location inherits that one -- so a resolver several
    /// calls deep (`resolve_type` does not know what asked it) still points at
    /// the declaration or statement that is wrong. The alternative is threading
    /// a span through every resolver in the compiler, and every call site
    /// re-deciding which construct it is inside.
    ///
    /// Set on entry to a declaration, statement or expression and restored on
    /// the way out. The innermost construct wins, which is what keeps a
    /// statement from swallowing an expression's location.
    mutable current_span: SourceSpan,
    /// While a construction's arguments are being checked, the span a literal
    /// range violation blames: the construction CALL, not the literal. The
    /// reference compiler coerces construction arguments after they are
    /// checked and blames the ambient call, so `Point(300, 0)` points at
    /// `Point` while `let x UInt8 = 300` still points at the literal.
    mutable range_blame_span: Option[SourceSpan],
    /// Global initializers are checked on demand -- a reference to a global
    /// whose initializer is still pending forces its check first (the
    /// compile-time mirror of the runtime accessor). Keyed by DefId.
    mutable pending_global_inits: Dict[UInt, GlobalInitEntry],
    /// The chain of global initializers being checked right now (DefIds,
    /// outermost first) -- the compile-time cycle path.
    mutable global_init_force_stack: List[UInt],
    /// The first unresolvable dot-form name a pattern lowering met. The
    /// when/is checker consumes it (`take_pattern_case_miss`) and reports it
    /// at ITS span -- the seed blames the whole `when`, not the pattern -- so
    /// the lowering itself stays silent and cannot race the caller's anchor.
    mutable pattern_case_miss: Option[PatternCaseMiss],
    /// Armed by a FATAL diagnostic -- the mirror of Swift's `throw
    /// SemanticError`, which `BodyChecker.checkDeclarationEntry` catches per
    /// declaration: the rest of the declaration is abandoned. The walk keeps
    /// running (Koral has no exceptions), so the gate at `push_diagnostic`
    /// drops whatever it would still report. Cleared at each top-level
    /// declaration, never by nested `check_decl` (a forced global initializer
    /// aborts its forcer too in Swift -- the throw re-propagates).
    mutable fatal_diagnostic_fired: Bool,
    /// Nesting depth of CALL-CALLEE checking. The reference compiler catches
    /// a callee-resolution failure at the call (`handleError` records it and
    /// the call stands in with a failed expression), so the very SAME throw
    /// that is fatal in value position (`let a = p.nope;`) is recoverable in
    /// call position (`p.nope()` plus more diagnostics afterwards). The
    /// member-not-found pushes consult this to pick the channel.
    mutable call_callee_check_depth: Int,
);

/// A dot-form pattern that names nothing the subject can be: a case-miss, or
/// a struct destructure against the wrong subject. Reported once per `when`,
/// either at the `when` (the seed's ambient span) or at the pattern itself
/// when the complaint's own shape points there.
type PatternCaseMiss(message: String, span: Option[SourceSpan]);

public type mutable TypeChecker(mutable storage: TypeCheckerStorage);

type IfChain(arms: List[Pair[Expr, Expr]], final_else: Option[Expr]);

type mutable FunctionReturnContext(
    mutable expected_return_type: Option[Type],
    mutable inferred_return_type: Option[Type],
    mutable is_inferring: Bool,
);

/// A single trait bound on a generic parameter, preserving type arguments.
/// For example, `[R Iterator[T]]` produces GenericConstraintBound("Iterator", [GenericParameter("T")]).
///
/// `trait_def_id` is the declaration identity used for matching; `trait_name` is
/// display-only. A shape bound (`mutable` / `foreign`) has no declaration: it is
/// matched by its KIND and keeps `DefId(0)`, and nothing may read its spelling
/// to decide anything.
public type GenericConstraintBound(
    trait_def_id: DefId,
    trait_name: String,
    type_args: List[Type],
);

type GenericConstraintSnapshot(
    previous_constraints: Dict[String, Option[List[GenericConstraintBound]]],
    previous_shape_bounds: Dict[String, Option[List[Bound]]],
);

/// A blanket/direct conformance pattern. `trait_def_id` is the trait
/// DECLARATION's identity and is what every match compares; `trait_name` is
/// display-only. Two same-named traits from different modules must never share
/// a template match.
type GenericTraitConformanceTemplate(
    target_type: Type,
    owner_type_params: List[TypeParameterDecl],
    trait_name: String,
    trait_def_id: DefId,
    trait_arg_types: List[Type],
);

/// A conformance fact, keyed on the trait's DECLARATION identity.
///
/// `trait_name` is kept only so diagnostics can print it; `trait_def_id` is what
/// `equals`/`hash` use. Two same-named traits in different modules must not
/// alias, and renaming a trait must not invalidate the conformance set.
type ExplicitTraitConformanceKey(
    target_type: Type,
    trait_def_id: DefId,
    trait_name: String,
    trait_arg_types: List[Type],
);

/// A trait reference normalised to (declaration identity, type arguments).
///
/// `trait_def_id` is the DECLARATION identity and is what decides equality of
/// the reference. `trait_name` exists only so diagnostics and C-mangling can
/// print it. Two spellings that resolve to the same declaration are the same
/// reference; two same-named traits from different modules are not.
public type CanonicalTraitRef(
    trait_name: String,
    trait_def_id: DefId,
    trait_type_args: List[Type],
);

given CanonicalTraitRef {
    /// A cache/visit key within one compilation.
    ///
    /// Keyed on the trait's DECLARATION identity and its type arguments and
    /// nothing else. The spelling is deliberately absent: `trait_name` is for
    /// diagnostics and C-mangling only, and folding it in would split one
    /// declaration into several keys whenever two call sites spell it
    /// differently (a source spelling vs. `def_id_spelling`, an import alias,
    /// a qualified path) -- so a witness recorded under one spelling would not
    /// be found under another. Identity is the DefId (rustc: `Res::Def(..,
    /// DefId)`; `trait_name` is the equivalent of a `Symbol` kept for printing).
    /// See `docs/design/traits-and-givens.md`.
    public cache_key(self): String = {
        if self.trait_type_args.is_empty() then {
            return self.trait_def_id.id.to_string();
        };
        let mutable out = StringBuilder.new();
        out.push_string(self.trait_def_id.id.to_string());
        out.push_string("#[");
        let mutable first = true;
        for arg in self.trait_type_args then {
            if not first then {
                out.push_string(",");
            };
            first = false;
            out.push_string(stable_type_key(arg));
        };
        out.push_string("]");
        return out.to_string();
    };

    public key(self, self_type: Type): String = {
        return "\(stable_type_key(self_type)):\(self.cache_key())";
    };
};

public type RequirementSlotParameter(
    name: String,
    is_mutable: Bool,
    param_type: Type,
    named: Bool,
);

public type RequirementSlot(
    declaring_trait_ref: CanonicalTraitRef,
    trait_method_def_id: DefId,
    method_name: String,
    parameters: List[RequirementSlotParameter],
    return_type: Type,
    index: Int,
);

public type ConformanceWitness(
    self_type: Type,
    trait_ref: CanonicalTraitRef,
    direct_parent_trait_refs: List[CanonicalTraitRef],
    requirement_slots: List[RequirementSlot],
    local_implementation_def_ids_by_method_name: Dict[String, DefId],
    local_implementation_def_ids_by_trait_method_def_id: Dict[DefId, DefId],
);

given ConformanceWitness {
    public key(self): String = self.trait_ref.key(self.self_type);
};

given ExplicitTraitConformanceKey: Eq {
    public equals(self, other: ExplicitTraitConformanceKey): Bool = {
        return self.target_type == other.target_type and self.trait_def_id == other.trait_def_id and self.trait_arg_types == other.trait_arg_types;
    };
};

given ExplicitTraitConformanceKey: Hash {
    public hash(self): UInt = {
        let mutable h = UInt(14695981039346656037);
        h = stable_hash_combine_value(h, stable_type_hash(self.target_type));
        h = stable_hash_combine_value(h, self.trait_def_id.id);
        for arg in self.trait_arg_types then {
            h = stable_hash_combine_value(h, stable_type_hash(arg));
        };
        return h;
    };
};

type GenericTraitConformanceStatus {
    Satisfied(),
    MissingConstraint(target_type: Type, constraint_param: String, trait_name: String),
    MissingBlanketGiven(modifier_name: String),
    MissingConformance(),
};

given TypeChecker {
    public new(
        global_scope: Scope,
        context: CompilerContext,
        file_path: String,
    ): TypeChecker = {
        // Install the ambient display context so free functions holding only a
        // `Type` can spell a declaration. Mirrors Swift's
        // `SemanticErrorContext.currentCompilerContext = context`, set in both
        // `TypeChecker.init` overloads (Sema/TypeChecker.swift -- anchor on the
        // statement, not a line number, it moves) and rustc's thread-local `tcx`.
        // DISPLAY only -- identity still travels on the `DefId`.
        set_display_context(context.def_id_map);
        let s = TypeCheckerStorage(
            global_scope,
            context,
            MethodTable.new(),
            Dict[String, DefId].new(),
            DiagnosticCollector.new(),
            file_path,
            List[String].new(),
            "",
            FunctionReturnContext(Option[Type].None(), Option[Type].None(), false),
            false,
            false,
            ConstraintSolver.new(context),
            TraitRegistry.new(),
            Dict[String, List[GenericConstraintBound]].new(),
            Dict[String, List[Bound]].new(),
            Dict[DefId, List[TypeParameterDecl]].new(),
            GenericTemplateRegistry.new(),
            Set[InstantiationRequest].new(),
            Option[ImportGraph].None(),
            Set[ExplicitTraitConformanceKey].new(),
            Dict[ExplicitTraitConformanceKey, SourceSpan].new(),
            List[GenericTraitConformanceTemplate].new(),
            Dict[MethodOwner, List[GenericTraitConformanceTemplate]].new(),
            Set[ExplicitTraitConformanceKey].new(),
            Set[ExplicitTraitConformanceKey].new(),
            Dict[ExplicitTraitConformanceKey, Bool].new(),
            Dict[ExplicitTraitConformanceKey, GenericTraitConformanceStatus].new(),
            false,
            Dict[String, ConformanceWitness].new(),
            global_scope,
            unknown_span(),
            Option[SourceSpan].None(),
            Dict[UInt, GlobalInitEntry].new(),
            List[UInt].new(),
            Option[PatternCaseMiss].None(),
            false,
            0,
        );
        return TypeChecker(s);
    };

    /// Install the ambient name-resolution context on the template registry.
    ///
    /// A spelling resolves through THIS module's imports, not through a global
    /// name table -- see `GenericTemplateRegistry.candidate_keys`. Identity
    /// still travels on the `DefId`; this only decides which declaration a
    /// spelling denotes.
    install_name_resolution_context(self): Void = {
        let source_file = Option[String].Some(self.storage.file_path);
        self.storage.generic_templates.current_module_path = self.storage.module_path;
        self.storage.generic_templates.current_source_file = source_file;
        self.storage.generic_templates.current_import_graph = self.storage.import_graph;
        self.storage.global_scope.set_import_context(
            self.storage.import_graph,
            source_file,
        );
    };

    clone_function_return_context(self): FunctionReturnContext = {
        let current = self.storage.function_return_context;
        return FunctionReturnContext(
            current.expected_return_type,
            current.inferred_return_type,
            current.is_inferring,
        );
    };

    public has_errors(self): Bool = self.storage.diagnostics.has_errors();

    public compiler_context(self): CompilerContext = {
        return self.context();
    };

    register_receiver_dispatch_for_given_members(
        self,
        target_type: Type,
        trait_name: Option[String],
        trait_def_id: Option[DefId],
        members: List[TypedGivenMember],
    ): Void = {
        let owner = Option[ReceiverMethodOwner].Some(
            ReceiverMethodOwner.ConcreteType(target_type),
        );
        for member_ref in members then {
            let is_receiver_style = member_ref.params.count() > 0 and member_ref.params[
                0
            ].name == "self";
            if is_receiver_style then {
                // rustc's `trait_item_def_id`: the trait METHOD this given
                // member implements. Looked up by declaration identity so two
                // same-named traits cannot answer for each other.
                let trait_method_def_id = when trait_def_id in {
                    .Some(trait_def_id) then self.storage.generic_templates.trait_method_def_id(
                        trait_def_id,
                        member_ref.name,
                    ),
                    .None() then Option[DefId].None(),
                };
                let resolved_trait_method_def_id = when trait_method_def_id in {
                    .Some(_) then trait_method_def_id,
                    // Swift TypeChecker.registerReceiverStyleMethod: with a
                    // conformance trait but no separate trait-method lookup hit,
                    // the impl method IS the trait method's identity.
                    .None() then if trait_name is .Some(_) then Option[DefId].Some(
                        member_ref.def_id,
                    ) else Option[DefId].None(),
                };
                self.storage.generic_templates.receiver_method_dispatch.insert(
                    member_ref.def_id,
                    ReceiverMethodDispatchInfo(
                        member_ref.def_id,
                        member_ref.name,
                        owner,
                        trait_name,
                        trait_def_id,
                        resolved_trait_method_def_id,
                    ),
                );
            } else {
                self.storage.generic_templates.receiver_method_dispatch.remove(
                    member_ref.def_id,
                );
            };
        };
    };

    duplicate_definition_message(self, name: String): String = {
        let _ = self;
        let mutable message = StringBuilder.new();
        message.push_string("Duplicate definition: ");
        message.push_string(name);
        return message.to_string();
    };

    invalidate_trait_requirement_caches(self): Void = {
        self.storage.trait_requirement_in_progress = Set[ExplicitTraitConformanceKey].new(
        );
        self.storage.generic_trait_status_in_progress = Set[ExplicitTraitConformanceKey].new(
        );
        self.storage.trait_requirement_cache = Dict[ExplicitTraitConformanceKey, Bool].new(
        );
        self.storage.generic_trait_status_cache = Dict[ExplicitTraitConformanceKey, GenericTraitConformanceStatus].new(
        );
    };

    /// Report at a source location. Every diagnostic needs one -- a message
    /// with no span cannot be jumped to, and the CLI has nowhere to put it in
    /// the `file:line:col: stage: message` envelope. There is no span-less
    /// variant; if you think you have no span, `typed_expr_span` recovers one
    /// from a typed expression and `expr_span` from an AST node.
    /// Report a semantic diagnostic at a source location.
    ///
    /// The same problem at the same place is reported ONCE. A rule that runs
    /// again for the same expression -- a second generic instantiation attempt,
    /// a receiver rewrite, a re-check of the same binding -- must not multiply
    /// its message.
    /// A mismatch with a poisoned side ("?" -- the unknown type) disagrees
    /// with nothing: that side's own complaint is already on the record.
    /// Weak references render as `?Name`, so only a bare `?` counts.
    message_is_poisoned_mismatch(self, message: String): Bool = {
        if not message.starts_with("Type mismatch: ") and not message.contains(" does not explicitly implement trait ") and not message.contains("Type ? does not") and not message.contains("Type Unknown does not") then {
            return false;
        };
        return message.contains("expected ?,") or message.contains("expected Unknown,") or message.ends_with("got ?") or message.contains("got ?,") or message.contains("got ? ") or message.ends_with("got Unknown") or message.contains("got Unknown,") or message.contains("trait [?]") or message.contains("trait [Unknown]") or message.ends_with("trait ?") or message.ends_with("trait Unknown");
    };

    push_diagnostic(self, message: String, span: SourceSpan): Void = {
        // A fatal diagnostic already fired this declaration: Swift's throw
        // abandoned the rest of the check (BodyChecker catches per
        // declaration), so anything the walk would still report is a cascade
        // the reference compiler never prints.
        if self.storage.fatal_diagnostic_fired then {
            return;
        };
        // A message that arrives without a location is a problem at whatever
        // construct the walker is inside -- see `current_span`. A message that
        // arrives with one keeps it: the call site knows better than the cursor
        // which token is at fault.
        if self.message_is_poisoned_mismatch(message) then {
            return;
        };
        let effective = if is_known_span(span) then span else self.storage.current_span;
        if self.already_reported_diagnostic(message, effective) then {
            return;
        };
        self.storage.diagnostics.push(
            make_diagnostic(
                DiagnosticStage.Semantic(),
                self.storage.file_path,
                message,
                effective,
            ),
        );
    };

    report_pass2_decl_consistency_error(
        self,
        decl_kind: String,
        name: String,
        detail: String,
    ): Void = {
        let mutable message = StringBuilder.new();
        message.push_string("internal consistency error while collecting ");
        message.push_string(decl_kind);
        message.push_string(" '");
        message.push_string(name);
        message.push_string("': ");
        message.push_string(detail);
        // Pass 2 works on declarations the collector already accepted; there is
        // no source position at this level to blame. Said out loud rather than
        // defaulted away.
        self.push_diagnostic(message.to_string(), unknown_span());
    };

    sema_progress_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SEMA_PROGRESS") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    skip_given_body_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_GIVEN_BODY") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    skip_decl_check_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_DECL_CHECK") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    skip_function_decl_check_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_FUNCTION_DECL_CHECK") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    skip_let_decl_check_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_LET_DECL_CHECK") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    skip_given_decl_check_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_GIVEN_DECL_CHECK") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    reset_constraint_solver_each_decl_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_RESET_CONSTRAINT_SOLVER_EACH_DECL") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    clear_variable_symbol_types_each_decl_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_CLEAR_VARIABLE_SYMBOL_TYPES_EACH_DECL") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    skip_typed_decl_retention_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_TYPED_DECL_RETENTION") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    skip_trait_tool_template_backfill_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_TRAIT_TOOL_TEMPLATE_BACKFILL") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    skip_checked_decl_substitution_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_CHECKED_DECL_SUBSTITUTION") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    skip_template_typed_body_boxing_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_TEMPLATE_TYPED_BODY_BOXING") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    skip_concrete_given_program_body_retention_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_CONCRETE_GIVEN_PROGRAM_BODY_RETENTION") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    drop_template_body_debug_enabled(self): Bool = {
        let file_filter = env("KORAL_DEBUG_DROP_TEMPLATE_BODY_FILE_CONTAINS");
        return when file_filter in {
            .Some(value) then self.storage.file_path.contains(value),
            .None() then false,
        };
    };

    skip_call_family_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_CALL_FAMILY") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    skip_member_path_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_SKIP_MEMBER_PATH") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    template_retain_debug_enabled(self): Bool = {
        let _ = self;
        if env("KORAL_DEBUG_TEMPLATE_RETAIN") is .Some(value) and (value == "1" or value == "true" or value == "TRUE") then {
            return true;
        };
        return false;
    };

    log_sema_progress(self, checked_decl_count: Int, total_nodes: Int): Void = {
        let pending_constraints = self.storage.constraint_solver.constraints.count();
        let pending_default_constraints = self.storage.constraint_solver.default_constraints.count(
        );
        let next_def_id = self.context().next_def_id();
        let instantiation_request_count = self.storage.instantiation_requests.count();
        let generic_param_constraint_name_count = self.storage.generic_param_constraints.count(
        );
        let extension_key_count = self.storage.generic_templates.extension_methods.count(
        );
        let mutable extension_template_count = 0;
        for entry in self.storage.generic_templates.extension_methods then {
            extension_template_count += entry.second.count();
        };
        let method_type_key_count = self.storage.method_table.methods.count();
        let global_scope_entry_count = self.storage.global_scope.entry_count();
        let global_scope_local_entry_count = self.storage.global_scope.local_entry_count(
        );
        let global_scope_type_count = self.storage.global_scope.type_entry_count();
        let global_scope_generic_param_count = self.storage.global_scope.generic_param_count(
        );
        let context = self.context();
        let def_id_name_count = context.def_id_map.names.count();
        let def_id_symbol_type_count = context.def_id_map.symbol_types.count();
        let def_id_symbol_kind_count = context.def_id_map.symbol_kinds.count();
        let def_id_param_spec_count = context.def_id_map.param_specs.count();
        let def_id_module_path_count = context.def_id_map.module_paths.count();
        let mutable binding_count = 0;
        for _entry in self.storage.constraint_solver.unifier.current_bindings() then {
            binding_count += 1;
        };
        println(
            "[sema-progress] checked=\(checked_decl_count)/\(total_nodes) file=\(self.storage.file_path) constraints=\(pending_constraints) bindings=\(binding_count) diagnostics=\(self.storage.diagnostics.count()) next_def_id=\(next_def_id) extension_keys=\(extension_key_count) extension_templates=\(extension_template_count) method_type_keys=\(method_type_key_count) instantiation_requests=\(instantiation_request_count) global_scope_entries=\(global_scope_entry_count) global_scope_types=\(global_scope_type_count) def_names=\(def_id_name_count) def_symbol_types=\(def_id_symbol_type_count) def_symbol_kinds=\(def_id_symbol_kind_count) def_param_specs=\(def_id_param_spec_count) def_module_paths=\(def_id_module_path_count)",
        );
    };

    decl_debug_label(self, decl: Decl): String = {
        let _ = self;
        return when decl in {
            .LetDecl(_, name, _, _, _, _, _) then "let \(name)",
            .FunctionDecl(_, name, _, _, _, _, _, _) then "fn \(name)",
            .IntrinsicFunctionDecl(_, name, _, _, _, _, _) then "fn intrinsic \(name)",
            .ForeignFunctionDecl(_, name, _, _, _, _, _, _) then "fn foreign \(name)",
            .ForeignLetDecl(_, name, _, _, _, _, _, _) then "let foreign \(name)",
            .TypeStructDecl(_, name, _, _, _, _, _, _) then "struct \(name)",
            .TypeEnumDecl(_, name, _, _, _, _, _) then "enum \(name)",
            .TypeAliasDecl(_, name, _, _, _, _) then "type \(name)",
            .IntrinsicTypeDecl(_, name, _, _, _) then "type intrinsic \(name)",
            .ForeignTypeDecl(_, name, _, _, _, _, _) then "type foreign \(name)",
            .UsingDecl(specifier, _, _, _) then "using \(specifier)",
            .TraitDecl(_, name, _, _, _, _, _, _) then "trait \(name)",
            .GivenDecl(_, _, _, _) then "given",
            .GivenTraitDecl(_, _, _, _, _) then "given as trait",
            .IntrinsicGivenDecl(_, _, _, _) then "given intrinsic",
        };
    };

    record_instantiation_request(self, request: InstantiationRequest): Void = {
        self.storage.instantiation_requests.insert(request);
    };

    /// Bind every trait name a module can see without writing it, plus the ones
    /// its `using` brings in. Runs after every trait is registered and before
    /// any body is checked.
    ///
    /// Two sources, both binding under **(importing module, local spelling)**:
    ///
    /// - the **prelude**. std's root traits (`Eq`, `Ord`, `Default`, ...) are
    ///   nameable from any module without an import. That used to happen by
    ///   accident -- the unqualified index answered for any name -- which is
    ///   also what let a trait from ANY module be named without importing it.
    ///   Spelling the prelude out keeps the first and drops the second.
    /// - **`using`**. An explicit list binds those names; a batch import
    ///   (`using "std" { ... };`) has no symbol edges and binds every importable trait
    ///   the target declares.
    register_imported_trait_names(
        self,
        nodes: List[Pair[LoadedNode, List[String]]],
    ): Void = {
        for pair in nodes then {
            self.bind_prelude_trait_names(pair.second);
        };
        let graph = self.storage.import_graph or else {
            return;
        };
        for edge in graph.symbol_imports then {
            // The DECLARATION, reached through the target module's own spelling
            // for it. The unqualified index is not consulted: it is last-wins
            // across modules and cannot say which `Tag` the target exported.
            let info = when self.storage.trait_registry.get_in_module(
                edge.original_symbol,
                edge.target,
            ) in {
                .Some(found) then found,
                .None() then {
                    continue;
                },
            };
            // An explicit list is not a hole in the access rule (§3.3): only
            // `public` and `protected` traits travel, exactly like the
            // batch path below. A name that cannot be imported is not in the
            // file's scope to begin with, so its use is refused just like an
            // un-imported one.
            if not self.importable_trait_access(info.def_id) then {
                continue;
            };
            self.bind_imported_trait_name(edge.symbol, edge.module, info.def_id);
        };
        // A batch import (`using "std" { ... };`) has no symbol edges at all -- the
        // spelling is the target's own for every member.
        for edge in graph.edges then {
            when edge.kind in {
                .BatchImport() then {
                    for entry in self.storage.trait_registry.traits_by_def_id.iterator() then {
                        let info = entry.second;
                        if info.module_path != edge.target then {
                            continue;
                        };
                        if not self.importable_trait_access(info.def_id) then {
                            continue;
                        };
                        // `{ !a, ... }` drops a name and `{ a as b, ... }`
                        // re-spells it; the re-spelling arrived as its own
                        // symbol edge above, so the target's spelling is not
                        // bound again here (§3.3).
                        if not batch_filter_allows(edge.filter, info.name) then {
                            continue;
                        };
                        self.bind_imported_trait_name(info.name, edge.source, info.def_id);
                    };
                },
                _ then {},
            };
        };
    };

    /// std's root traits, bound into `importing_module`. The prelude is a real
    /// import -- just one the language writes for you.
    bind_prelude_trait_names(self, importing_module: List[String]): Void = {
        for entry in self.storage.trait_registry.traits_by_def_id.iterator() then {
            let info = entry.second;
            if not self.is_std_root_module_decl(info.def_id, info.module_path) then {
                continue;
            };
            if not self.importable_trait_access(info.def_id) then {
                continue;
            };
            self.bind_imported_trait_name(info.name, importing_module, info.def_id);
        };
    };

    /// Whether `def_id` is declared in the root module of the std package.
    ///
    /// std-ness comes from the PACKAGE identity `package_id_for_kind` mints, not
    /// from the module being spelled `Std` -- a package chooses its own names.
    /// Root-ness is the module's shape: std's root is the single-segment module
    /// in that package, the one its manifest names as the main module. Submodules
    /// (`std::io` and friends) are imported explicitly and are not prelude.
    is_std_root_module_decl(self, def_id: DefId, module_path: List[String]): Bool = {
        if not module_path.count() == 1 then {
            return false;
        };
        return when self.storage.context.get_package_id(def_id) in {
            .Some(package_id) then is_std_package_id(package_id),
            .None() then false,
        };
    };

    /// Whether a batch import may bring this trait in. `internal` /
    /// `private` never travel; `protected` travels within a package
    /// and is re-checked at use by the visibility checker.
    importable_trait_access(self, def_id: DefId): Bool = {
        return when self.storage.context.get_access(def_id) in {
            .Some(access) then when access in {
                .Public() or .Protected() then true,
                .Internal() or .Private() then false,
            },
            .None() then true,
        };
    };

    /// Bind `local_name` to the trait declared at `trait_def_id`, in the module
    /// that IMPORTED it. Both name tables need it: sema resolves through
    /// `trait_registry`, monomorphization through `generic_templates.traits`.
    bind_imported_trait_name(
        self,
        local_name: String,
        importing_module: List[String],
        trait_def_id: DefId,
    ): Void = {
        when self.storage.trait_registry.get_by_def_id(trait_def_id) in {
            .Some(info) then self.storage.trait_registry.register_imported_name(
                local_name,
                importing_module,
                info,
            ),
            .None() then {},
        };
        when self.storage.generic_templates.lookup_trait_by_def_id(trait_def_id) in {
            .Some(decl) then {
                self.storage.generic_templates.traits.insert(
                    qualified_symbol_key(importing_module, local_name),
                    decl,
                );
                // The unqualified name index (`bare_symbol_key`) -- separate key
                // space so it cannot clobber a real empty-path symbol; see
                // `bare_symbol_key`. Skipped when the qualified key already IS
                // the plain name.
                if not importing_module.is_empty() then {
                    self.storage.generic_templates.traits.insert(
                        bare_symbol_key(local_name),
                        decl,
                    );
                };
            },
            .None() then {},
        };
    };

    register_trait_metadata(
        self,
        name: String,
        trait_def_id: DefId,
        type_params: List[TypeParameter],
        parent_constraints: List[ParentTraitConstraint],
        raw_members: List[TraitMember],
        typed_members: List[TypedTraitMember],
    ): Void = {
        let mutable param_names = List[String].new();
        for tp in type_params then {
            param_names.push(tp.name);
        };
        let info = TraitInfo(
            trait_def_id,
            name,
            param_names,
            parent_constraints,
            typed_members,
            self.storage.module_path,
        );
        let mutable method_def_ids_by_name = Dict[String, DefId].new();
        for member in typed_members then {
            method_def_ids_by_name.insert(member.name, member.def_id);
        };
        self.storage.trait_registry.register(info);
        let decl_info = TraitDeclInfo(
            trait_def_id,
            name,
            self.to_template_type_params(type_params),
            parent_constraints,
            raw_members,
            typed_members,
            method_def_ids_by_name,
            self.storage.module_path,
        );
        self.storage.generic_templates.traits.insert(
            qualified_symbol_key(self.storage.module_path, name),
            decl_info,
        );
        // The unqualified name index (`bare_symbol_key`) -- see
        // `bind_imported_trait_name`. Skipped when the qualified key already IS
        // the plain name.
        if not self.storage.module_path.is_empty() then {
            self.storage.generic_templates.traits.insert(
                bare_symbol_key(name),
                decl_info,
            );
        };
        self.storage.generic_templates.register_trait_decl(
            TraitDeclInfo(
                trait_def_id,
                name,
                self.to_template_type_params(type_params),
                parent_constraints,
                raw_members,
                typed_members,
                method_def_ids_by_name,
                self.storage.module_path,
            ),
        );
    };

    /// Builds a canonical trait reference. The spelling is resolved to the trait
    /// declaration's identity here, once; every later comparison uses the
    /// identity, not the spelling. An unresolvable spelling carries
    /// `def_id_invalid()`, which is always on its way to a diagnostic.
    canonical_trait_ref(
        self,
        trait_name: String,
        trait_type_args: List[Type],
    ): CanonicalTraitRef = {
        return CanonicalTraitRef(
            trait_name,
            self.trait_def_id_by_name(trait_name),
            trait_type_args,
        );
    };

    /// Same, when the caller already holds the declaration identity.
    canonical_trait_ref_with_def_id(
        self,
        trait_name: String,
        trait_def_id: DefId,
        trait_type_args: List[Type],
    ): CanonicalTraitRef = {
        let resolved = if trait_def_id.is_valid() then trait_def_id
        else self.trait_def_id_by_name(trait_name);
        return CanonicalTraitRef(trait_name, resolved, trait_type_args);
    };

    trait_extension_self_type(self, resolved_target: Type): Type = {
        return when resolved_target in {
            .TraitObject(...) then Type.GenericParameter("Self"),
            .ReferenceType(inner) or .MutableReferenceType(inner) or .BorrowedReferenceType(inner)
            or .MutableBorrowedReferenceType(inner) then when inner in {
                .TraitObject(...) then Type.GenericParameter("Self"),
                _ then resolved_target,
            },
            _ then resolved_target,
        };
    };

    trait_type_substitution(
        self,
        trait_ref: CanonicalTraitRef,
        self_type: Type,
    ): Dict[String, Type] = {
        let mutable substitution = Dict[String, Type].new();
        substitution.insert("Self", self_type);
        // Identity: the reference carries the trait's DECLARATION.
        when self.storage.generic_templates.lookup_trait_by_def_id(
            trait_ref.trait_def_id,
        ) in {
            .Some(trait_info) then {
                for pair in trait_info.type_params.lazy().zip[
                    Type,
                    ListIterator[Type],
                    List[Type],
                ](trait_ref.trait_type_args) then {
                    substitution.insert(
                        pair.first.name,
                        (pair.second),
                    );
                };
            },
            .None() then {},
        };
        return substitution;
    };

    direct_parent_trait_refs(
        self,
        trait_ref: CanonicalTraitRef,
        self_type: Type,
    ): List[CanonicalTraitRef] = {
        let mutable parents = List[CanonicalTraitRef].new();
        // Identity: the reference carries the trait's DECLARATION.
        when self.storage.generic_templates.lookup_trait_by_def_id(
            trait_ref.trait_def_id,
        ) in {
            .Some(trait_info) then {
                let bindings = self.trait_type_substitution(trait_ref, self_type);
                for parent in trait_info.parent_traits then {
                    let mutable parent_args = List[Type].new();
                    for arg in parent.type_arg_nodes then {
                        parent_args.push(
                            self.resolve_type_with_self_and_bindings(
                                arg,
                                self_type,
                                bindings,
                            ),
                        );
                    };
                    parents.push(
                        self.canonical_trait_ref_with_def_id(
                            parent.name,
                            parent.def_id,
                            parent_args,
                        ),
                    );
                };
            },
            .None() then {},
        };
        return parents;
    };

    /// The flattened requirement list, PARENTS FIRST.
    ///
    /// The order is the layout contract of a generated vtable: the struct lays
    /// its method fields out in exactly this order, and a call through a trait
    /// object reaches one by its offset. A witness filed in any other order
    /// dispatches to the wrong method -- a child trait with both its own methods
    /// and a parent's used to send `show` to `base`.
    requirement_slots(
        self,
        trait_ref: CanonicalTraitRef,
        self_type: Type,
    ): List[RequirementSlot] = {
        let mutable slots = List[RequirementSlot].new();
        let mutable seen_methods = Set[String].new();
        let mutable visited_trait_refs = Set[String].new();
        self.collect_requirement_slots(
            trait_ref,
            self_type,
            slots,
            seen_methods,
            visited_trait_refs,
        );
        return slots;
    };

    /// Depth-first over the parent graph, parents before the trait's own members,
    /// matching `ordered_trait_method_names_helper_from_def` on the mono side.
    /// Two same-named traits from different modules are different declarations
    /// and must not share a visit slot.
    collect_requirement_slots(
        self,
        trait_ref: CanonicalTraitRef,
        self_type: Type,
        slots: List[RequirementSlot],
        seen_methods: Set[String],
        visited_trait_refs: Set[String],
    ): Void = {
        let current_key = trait_ref.cache_key();
        if visited_trait_refs.contains(current_key) then {
            return;
        };
        visited_trait_refs.insert(current_key);

        for parent in self.direct_parent_trait_refs(trait_ref, self_type) then {
            self.collect_requirement_slots(
                parent,
                self_type,
                slots,
                seen_methods,
                visited_trait_refs,
            );
        };

        // Identity: the reference carries the trait's DECLARATION.
        when self.storage.generic_templates.lookup_trait_by_def_id(
            trait_ref.trait_def_id,
        ) in {
            .Some(trait_info) then {
                let bindings = self.trait_type_substitution(trait_ref, self_type);
                for method in trait_info.raw_members then {
                    if seen_methods.contains(method.name) then {
                        continue;
                    };
                    seen_methods.insert(method.name);

                    let mutable method_bindings = Dict[String, Type].new();
                    for entry in bindings.iterator() then {
                        method_bindings.insert(entry.first, entry.second);
                    };
                    for method_type_param in method.type_params then {
                        method_bindings.insert(
                            method_type_param.name,
                            Type.GenericParameter(method_type_param.name),
                        );
                    };

                    let mutable parameters = List[RequirementSlotParameter].new();
                    for parameter in method.params then {
                        parameters.push(
                            RequirementSlotParameter(
                                parameter.name,
                                parameter.is_mutable,
                                self.resolve_type_with_self_and_bindings(
                                    parameter.type_name,
                                    self_type,
                                    method_bindings,
                                ),
                                parameter.named,
                            ),
                        );
                    };
                    slots.push(
                        RequirementSlot(
                            trait_ref,
                            trait_info.method_def_ids_by_name.get(method.name) or else def_id_invalid(
                            ),
                            method.name,
                            parameters,
                            self.resolve_type_with_self_and_bindings(
                                method.return_type,
                                self_type,
                                method_bindings,
                            ),
                            slots.count(),
                        ),
                    );
                };
            },
            .None() then {},
        };
    };

    record_conformance_witness(
        self,
        self_type: Type,
        trait_name: String,
        trait_type_args: List[Type],
        members: List[TypedGivenMember],
    ): Void = {
        let trait_ref = self.canonical_trait_ref(trait_name, trait_type_args);
        let mutable implementations = Dict[String, DefId].new();
        for member in members then {
            implementations.insert(member.name, member.def_id);
        };
        let mutable implementations_by_trait_method_def_id = Dict[DefId, DefId].new();
        when self.storage.generic_templates.lookup_trait_by_def_id(
            trait_ref.trait_def_id,
        ) in {
            .Some(trait_info) then {
                for member in members then {
                    when trait_info.method_def_ids_by_name.get(member.name) in {
                        .Some(trait_method_def_id) then {
                            implementations_by_trait_method_def_id.insert(
                                trait_method_def_id,
                                member.def_id,
                            );
                        },
                        .None() then {},
                    };
                };
            },
            .None() then {},
        };
        let witness = ConformanceWitness(
            self_type,
            trait_ref,
            self.direct_parent_trait_refs(trait_ref, self_type),
            self.requirement_slots(trait_ref, self_type),
            implementations,
            implementations_by_trait_method_def_id,
        );
        self.storage.conformance_witnesses.insert(witness.key(), witness);
    };

    template_checked_body(
        self,
        body: Option[TypedExpr],
        retain_checked_template_bodies: Bool,
    ): Option[TypedExpr] = {
        if self.drop_template_body_debug_enabled() then {
            return Option[TypedExpr].None();
        };
        return if retain_checked_template_bodies then when body in {
            .Some(typed_body) then Option[TypedExpr].Some(typed_body),
            .None() then Option[TypedExpr].None(),
        } else Option[TypedExpr].None();
    };

    push_diagnostic_at_span(self, message: String, span: SourceSpan): Void = {
        self.push_diagnostic(message, span);
    };

    push_expr_diagnostic(self, expr: Expr, message: String): Void = {
        self.push_diagnostic_at_span(message, expr_span(expr));
    };

    push_pattern_diagnostic(self, pattern: PatternNode, message: String): Void = {
        self.push_diagnostic_at_span(message, pattern_span(pattern));
    };

    /// Whether one lowered pattern covers every value of its subject type --
    /// the `for`-binding question, judged by the exhaustiveness checker's own
    /// coverage machinery rather than the syntactic irrefutability shortcut.
    pattern_covers_full_space(self, pattern: TypedPattern, subject_type: Type): Bool = {
        let mutable patterns = List[TypedPattern].new();
        patterns.push(pattern);
        let checker = ExhaustivenessChecker.new(
            self.concretize_default_literal_type(subject_type),
            patterns,
            self.context(),
            self.storage.generic_templates,
            unknown_span(),
        );
        return checker.covers_full_space();
    };

    context(self): CompilerContext = {
        return self.storage.context;
    };

    in_function_context(self): Bool = {
        if self.storage.function_return_context.is_inferring then {
            return true;
        };
        return self.storage.function_return_context.expected_return_type is .Some(_);
    };

    allocate_unindexed_def_id(self, name: String, kind: DefKind): DefId = {
        let mutable context = self.context();
        return context.allocate_unindexed(name, kind);
    };

    make_member_path_symbol(
        self,
        name: String,
        member_type: Type,
        is_mutable: Bool,
    ): Symbol = {
        let kind = SymbolKind.Variable(
            if is_mutable then VariableKind.MutableValue() else VariableKind.Value(),
        );
        return Symbol(
            self.allocate_unindexed_def_id(name, DefKind.Variable()),
            member_type,
            kind,
        );
    };

    // Reuse the pass1 DefId for top-level declarations, matching Swift's
    // makeGlobalSymbol/getOrAllocateTypeDefId flow instead of allocating fallback ids.
    get_or_allocate_top_level_def_id(
        self,
        name: String,
        kind: DefKind,
        access: AccessModifier,
        span: SourceSpan,
    ): DefId = {
        let mutable context = self.context();
        return when access in {
            .Private() then when context.lookup_def_id(
                self.storage.module_path,
                name,
                Option[String].Some(self.storage.file_path),
            ) in {
                .Some(existing) then existing,
                .None() then context.allocate_full_in_package(
                    name,
                    kind,
                    self.storage.module_path,
                    self.storage.file_path,
                    self.storage.package_id,
                    access,
                    span,
                ),
            },
            _ then when context.lookup_def_id(
                self.storage.module_path,
                name,
                Option[String].None(),
            ) in {
                .Some(existing) then existing,
                .None() then context.allocate_full_in_package(
                    name,
                    kind,
                    self.storage.module_path,
                    self.storage.file_path,
                    self.storage.package_id,
                    access,
                    span,
                ),
            },
        };
    };

    make_top_level_symbol(
        self,
        name: String,
        symbol_type: Type,
        kind: SymbolKind,
        access: AccessModifier,
        span: SourceSpan,
        is_mutable: Bool,
    ): Symbol = {
        let def_kind = when kind in {
            .Function() then DefKind.Function(),
            .Variable(_) then DefKind.Variable(),
            .TypeSymbol() then when symbol_type in {
                .StructureType(_) then DefKind.TypeDef(TypeDefKind.Structure()),
                .EnumType(_) then DefKind.TypeDef(TypeDefKind.Enum()),
                .OpaqueType(_) then DefKind.TypeDef(TypeDefKind.Opaque()),
                .TraitObject(...) then DefKind.TypeDef(TypeDefKind.Trait()),
                _ then {
                    self.report_pass2_decl_consistency_error(
                        "type symbol",
                        name,
                        "cannot infer top-level type kind from symbol type '",
                    );
                    DefKind.TypeDef(TypeDefKind.Structure())
                },
            },
            .Module() then DefKind.Module(),
        };
        let def_id = self.get_or_allocate_top_level_def_id(name, def_kind, access, span);
        let symbol = Symbol(def_id, symbol_type, kind);
        let mutable context = self.context();
        context.set_symbol_info(
            def_id,
            SymbolInfo(symbol_type, kind, MethodKind.Normal(), is_mutable),
        );
        self.storage.global_scope.define(context, symbol);
        return symbol;
    };

    make_top_level_type_symbol(
        self,
        name: String,
        type_kind: TypeDefKind,
        symbol_type: Type,
        access: AccessModifier,
        span: SourceSpan,
    ): Symbol = {
        let def_id = self.get_or_allocate_top_level_def_id(
            name,
            DefKind.TypeDef(type_kind),
            access,
            span,
        );
        let symbol = Symbol(def_id, symbol_type, SymbolKind.TypeSymbol());
        let mutable context = self.context();
        context.set_symbol_info(
            def_id,
            SymbolInfo(symbol_type, SymbolKind.TypeSymbol(), MethodKind.Normal(), false),
        );
        return symbol;
    };

    fresh_type_variable(self, name: Option[String], span: SourceSpan): TypeVariable = {
        return self.storage.constraint_solver.fresh_type_variable(name, span);
    };

    fresh_literal_type_variable(
        self,
        kind: LiteralDefaultKind,
        span: SourceSpan,
    ): TypeVariable = {
        return self.storage.constraint_solver.fresh_literal_type_variable(kind, span);
    };

    /// The span of a typed expression.
    ///
    /// The RECORDED span wins. The derivation below is a fallback for
    /// construction sites that have not yet been migrated to
    /// `make_typed_expr_at`: it only ever succeeds by borrowing a span from a
    /// child, which is exactly the case the recorded span exists to fix.
    typed_expr_span(self, expr: TypedExpr): SourceSpan = {
        return typed_expr_span_at(expr, self.context());
    };

    push_typed_expr_diagnostic(self, expr: TypedExpr, message: String): Void = {
        self.push_diagnostic_at_span(message, self.typed_expr_span(expr));
    };

    statement_span(self, stmt: Statement): SourceSpan = {
        return when stmt in {
            .LetStmt(_, _, _, _, span) or .TupleLetStmt(_, _, span) or .AssignmentStmt(_, _, _, span)
            or .ExprStmt(_, span) or .ReturnStmt(_, span) or .BreakStmt(span) or .ContinueStmt(span)
            or .DeferStmt(_, span) then span,
        };
    };

    /// The source location of a declaration.
    ///
    /// Every declaration carries its span; this just names which field that
    /// is, so `check_decl` can record it as the place a diagnostic belongs to.
    decl_span(self, decl: Decl): SourceSpan = {
        return when decl in {
            .LetDecl(_, _, _, _, _, span, _) or .FunctionDecl(_, _, _, _, _, _, span, _)
            or .IntrinsicFunctionDecl(_, _, _, _, _, span, _) or .ForeignFunctionDecl(_, _, _, _, _, _, span, _)
            or .ForeignLetDecl(_, _, _, _, _, _, span, _) or .TypeStructDecl(_, _, _, _, _, _, span, _)
            or .TypeEnumDecl(_, _, _, _, _, span, _) or .TypeAliasDecl(_, _, _, _, span, _)
            or .IntrinsicTypeDecl(_, _, _, span, _) or .ForeignTypeDecl(_, _, _, _, _, span, _)
            or .UsingDecl(_, _, _, span) or .TraitDecl(_, _, _, _, _, _, span, _) or .GivenDecl(_, _, _, span)
            or .GivenTraitDecl(_, _, _, _, span) or .IntrinsicGivenDecl(_, _, _, span) then span,
        };
    };

    /// Record where the checker is while checking `span`, restoring the
    /// enclosing location on the way out.
    ///
    /// The innermost construct always wins: a statement inside a declaration
    /// blames the statement, and an expression inside the statement blames the
    /// expression. Restoring is what keeps a nested check from leaving a stale
    /// location behind for whatever is checked next.
    ///
    /// Returns the location to hand back to `leave_current_span`.
    enter_current_span(self, span: SourceSpan): SourceSpan = {
        let outer = self.storage.current_span;
        if is_known_span(span) then {
            self.storage.current_span = span;
        };
        return outer;
    };

    leave_current_span(self, outer: SourceSpan): Void = {
        self.storage.current_span = outer;
    };

    /// A fatal diagnostic: report it, then arm the abandon gate. Mirrors
    /// Swift's `throw SemanticError` out of the checker -- the error surfaces
    /// at the declaration boundary and nothing after it in the declaration
    /// does. Call this INSTEAD of `push_diagnostic_at_span` at the sites where
    /// the reference compiler throws.
    push_fatal_diagnostic(self, message: String, span: SourceSpan): Void = {
        self.push_diagnostic_at_span(message, span);
        self.storage.fatal_diagnostic_fired = true;
    };

    /// The member-not-found complaint. Fatal in value position -- the
    /// reference compiler's throw reaches the declaration boundary -- but
    /// recoverable while resolving a CALL's callee, where its callee catch
    /// records the error and the call stands in with a failed expression.
    push_member_not_found_diagnostic(self, message: String, span: SourceSpan): Void = {
        if self.storage.call_callee_check_depth > 0 then {
            self.push_diagnostic_at_span(message, span);
        } else {
            self.push_fatal_diagnostic(message, span);
        };
    };

    trait_def_id_by_name(self, trait_name: String): DefId = {
        when self.storage.generic_templates.traits.get(
            qualified_symbol_key(self.storage.module_path, trait_name),
        ) in {
            .Some(info) then {
                return info.def_id;
            },
            .None() then {},
        };
        when self.storage.global_scope.lookup_type(trait_name) in {
            .Some(resolved_type) then {
                // A hidden trait is undeclared here (§3.3).
                if not self.is_hidden_type(resolved_type) then {
                    when resolved_type in {
                        .TraitObject(trait_object_def_id, _, _) then {
                            if trait_object_def_id.is_valid() then {
                                return trait_object_def_id;
                            };
                        },
                        _ then {},
                    };
                };
            },
            _ then {},
        };
        when self.storage.generic_templates.resolve_trait_name(trait_name) in {
            .Some(resolved_name) then when self.storage.generic_templates.traits.get(
                resolved_name,
            ) in {
                .Some(info) then {
                    return info.def_id;
                },
                .None() then {},
            },
            .None() then {},
        };
        return def_id_invalid();
    };

    make_trait_object_type(self, trait_name: String, type_args: List[Type]): Type = {
        return Type.TraitObject(self.trait_def_id_by_name(trait_name), type_args, false);
    };

    canonical_trait_object_type(self, trait_name: String): Type = {
        when self.lookup_current_file_type_symbol(trait_name) in {
            .Some(resolved_type) then when resolved_type in {
                .TraitObject(trait_object_def_id, _, _) then {
                    return Type.TraitObject(
                        trait_object_def_id,
                        List[Type].new(),
                        self.context().is_sendable_type(resolved_type),
                    );
                },
                _ then {},
            },
            _ then {},
        };
        let requested_trait_id = self.trait_def_id_by_name(trait_name);
        return when self.storage.global_scope.lookup_type(trait_name) in {
            .Some(resolved_type) then {
                // A hidden trait is undeclared here (§3.3).
                if self.is_hidden_type(resolved_type) then {
                    self.make_trait_object_type(trait_name, List[Type].new())
                } else {
                    when resolved_type in {
                        .TraitObject(trait_def_id, existing_args, _) then {
                            if trait_def_id == requested_trait_id then Type.TraitObject(
                                trait_def_id,
                                existing_args,
                                self.context().is_sendable_type(resolved_type),
                            ) else self.make_trait_object_type(trait_name, List[Type].new())
                        },
                        _ then self.make_trait_object_type(trait_name, List[Type].new()),
                    }
                }
            },
            _ then self.make_trait_object_type(trait_name, List[Type].new()),
        };
    };

    // Treat both Unknown and TypeVar as unresolved so they do not leak into codegen.
    is_unresolved_expr_type(self, t: Type): Bool = when t in {
        .Unknown() or .TypeVar(_) then true,
        _ then false,
    };

    is_value_expr_type(self, t: Type): Bool = when t in {
        .VoidType() or .NeverType() then false,
        _ then not self.is_unresolved_expr_type(t),
    };

    is_ffi_compatible_type(self, t: Type): Bool = {
        return when t in {
            .IntType() or .Int8Type() or .Int16Type() or .Int32Type() or .Int64Type() or .UIntType()
            or .UInt8Type() or .UInt16Type() or .UInt32Type() or .UInt64Type() or .WrappingIntType()
            or .WrappingInt8Type() or .WrappingInt16Type() or .WrappingInt32Type() or .WrappingInt64Type()
            or .WrappingUIntType() or .WrappingUInt8Type() or .WrappingUInt16Type() or .WrappingUInt32Type()
            or .WrappingUInt64Type() or .Float32Type() or .Float64Type() or .BoolType() or .VoidType()
            or .NeverType() or .OpaqueType(_) then true,
            // std's `Rune` is a nominal like `String` and never crosses:
            // its representation is the compiler's business (guide §6).
            .StructureType(_) then false,
            // A raw pointer crosses only as far as what it POINTS AT does:
            // `*Bad` hands a Koral-managed pointee to C just as much as `Bad`
            // would. `*Void` is C's `void*` and stays legal.
            .PointerType(inner) or .MutablePointerType(inner) then {
                inner is .VoidType() or self.satisfies_foreign_constraint(inner)
            },
            // A bare C function pointer crosses; its components are gated at
            // type resolution.
            .ForeignFunctionType(_, _) then true,
            _ then false,
        };
    };

    /// An opaque `type foreign X {}` has no layout: it may only live behind `*`.
    /// A bare one -- including one sitting inside a by-value `[N]T` -- names an
    /// incomplete-type object that no C declaration can hold.
    opaque_by_value_type(self, t: Type): Option[Type] = {
        return when t in {
            .OpaqueType(_) then Option[Type].Some(t),
            .FixedArrayType(_, inner) then self.opaque_by_value_type(inner),
            // A generic argument is a by-value slot in the instantiated
            // layout (`List[FILE]`'s element has no more layout than `FILE`
            // itself). An argument behind `*` is a pointer and falls through.
            .GenericStruct(_, args) or .GenericEnum(_, args) then self
                .opaque_in_type_arguments(args),
            .StructureType(def_id) or .EnumType(def_id) then self
                .opaque_in_type_arguments(
                    self.context().get_type_arguments(def_id) or else List[Type].new(),
                ),
            _ then Option[Type].None(),
        };
    };

    /// The first opaque-by-value type argument, if any.
    opaque_in_type_arguments(self, args: List[Type]): Option[Type] = {
        for arg in args then {
            let found = self.opaque_by_value_type(arg);
            if found is .Some(_) then {
                return found;
            };
        };
        return Option[Type].None();
    };

    opaque_instantiation_message(self, t: Type): String = {
        let spelled = self.context().type_display_name(t);
        return "opaque type '\(spelled)' cannot be instantiated directly, use '\(spelled) ptr' instead";
    };

    contains_borrowed_reference_type(self, t: Type): Bool = {
        return when t in {
            .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) then true,
            .ReferenceType(inner) then self.contains_borrowed_reference_type(inner),
            .MutableReferenceType(inner) then self.contains_borrowed_reference_type(
                inner,
            ),
            .PointerType(inner) or .MutablePointerType(inner) or .WeakReferenceType(inner) then self.contains_borrowed_reference_type(inner),
            .MutableWeakReferenceType(inner) then self.contains_borrowed_reference_type(
                inner,
            ),
            .FunctionType(params, return_type, _) then {
                for param in params then {
                    if self.contains_borrowed_reference_type(param.param_type) then {
                        return true;
                    };
                };
                self.contains_borrowed_reference_type(return_type)
            },
            .ForeignFunctionType(params, return_type) then {
                for param in params then {
                    if self.contains_borrowed_reference_type(param.param_type) then {
                        return true;
                    };
                };
                self.contains_borrowed_reference_type(return_type)
            },
            .GenericStruct(_, args) or .GenericEnum(_, args) or .TraitObject(_, args, _) then {
                for arg in args then {
                    if self.contains_borrowed_reference_type(arg) then {
                        return true;
                    };
                };
                false
            },
            _ then false,
        };
    };

    contains_never_type(self, t: Type): Bool = {
        return when t in {
            .NeverType() then true,
            .ReferenceType(inner) or .MutableReferenceType(inner) or .PointerType(inner)
            or .MutablePointerType(inner) or .WeakReferenceType(inner) or .MutableWeakReferenceType(inner) then self.contains_never_type(inner),
            .FunctionType(params, return_type, _) then {
                for param in params then {
                    if self.contains_never_type(param.param_type) then {
                        return true;
                    };
                };
                self.contains_never_type(return_type)
            },
            .ForeignFunctionType(params, return_type) then {
                for param in params then {
                    if self.contains_never_type(param.param_type) then {
                        return true;
                    };
                };
                self.contains_never_type(return_type)
            },
            .GenericStruct(_, args) or .GenericEnum(_, args) or .TraitObject(_, args, _) then {
                for arg in args then {
                    if self.contains_never_type(arg) then {
                        return true;
                    };
                };
                false
            },
            _ then false,
        };
    };

    ffi_type_error(self, t: Type): String = {
        return when t in {
            .StructureType(_) then "Koral struct types cannot be used in foreign functions",
            .EnumType(_) then "Koral enum types cannot be used in foreign functions",
            .ReferenceType(_) then "Managed reference types (* / *mutable) cannot be used in foreign functions",
            .BorrowedReferenceType(_) or .MutableBorrowedReferenceType(_) then "Borrowed `ref` / `ref mutable` types cannot be used in foreign functions",
            .PointerType(inner) or .MutablePointerType(inner) then "pointee type '\(self.context().type_display_name(inner))' does not satisfy the 'foreign' constraint",
            .VoidType() then "a parameter cannot be 'Void' (C has no void values)",
            .NeverType() then "a parameter cannot be 'Never'",
            .FunctionType(...) then "Function types cannot be used in foreign functions",
            .GenericParameter(_) or .GenericStruct(_, _) or .GenericEnum(_, _) then "Generic parameters cannot be used in foreign functions",
            _ then "Type '\(self.context().type_display_name(t))' is not compatible with FFI",
        };
    };

    same_expr_type(self, left: Type, right: Type): Bool = {
        let normalized_left = self.canonicalize_alias_type(
            self.concretize_default_literal_type(left),
        );
        let normalized_right = self.canonicalize_alias_type(
            self.concretize_default_literal_type(right),
        );
        if normalized_left == normalized_right then {
            // `sendable` 槽按放宽方向核对：left 是实际类型、right 是期望类型，
            // `sendable (A) -> R` 可用在 `(A) -> R` 的位置，反向拒绝
            // （concurrency-design.md §派生规则 5）。
            return self.sendable_slots_compatible(normalized_left, normalized_right);
        };
        if self.nominal_instantiation_matches_generic(normalized_left, normalized_right) then {
            return self.sendable_slots_compatible(normalized_left, normalized_right);
        };
        if self.nominal_instantiation_matches_generic(normalized_right, normalized_left) then {
            return self.sendable_slots_compatible(normalized_left, normalized_right);
        };
        return false;
    };

    /// 宽放规则（concurrency-design.md §派生规则 5、6）：`sendable (A) -> R`
    /// 可用在 `(A) -> R` 的位置，反向拒绝；trait object 同规则。逐节点比较
    /// `sendable` 槽——期望侧为 true 的槽实际侧必须也是 true。逐节点（含泛型
    /// 实参与引用层）是条件 sendable 的反走私口：`List[sendable () -> V]` 的
    /// 位置不收 `List[() -> V]`。
    sendable_slots_compatible(self, actual: Type, expected: Type): Bool = {
        return when expected in {
            .FunctionType(expected_params, expected_ret, _) then {
                if self.context().is_sendable_type(expected) and not self.satisfies_sendable_constraint(
                    actual,
                ) then {
                    return false;
                };
                when actual in {
                    .FunctionType(actual_params, actual_ret, _) then {
                        if actual_params.count() != expected_params.count() then {
                            return false;
                        };
                        for pair in actual_params.lazy().zip[
                            FunctionParamEntry,
                            ListIterator[FunctionParamEntry],
                            List[FunctionParamEntry],
                        ](expected_params) then {
                            if not self.sendable_slots_compatible(
                                (pair.first).param_type,
                                (pair.second).param_type,
                            ) then {
                                return false;
                            };
                        };
                        return self.sendable_slots_compatible(actual_ret, expected_ret);
                    },
                    _ then {},
                };
                true
            },
            .TraitObject(_, expected_args, _) then {
                if self.context().is_sendable_type(expected) and not self.satisfies_sendable_constraint(
                    actual,
                ) then {
                    return false;
                };
                when actual in {
                    .TraitObject(_, actual_args, _) then {
                        if actual_args.count() != expected_args.count() then {
                            return false;
                        };
                        for pair in actual_args.lazy().zip[
                            Type,
                            ListIterator[Type],
                            List[Type],
                        ](expected_args) then {
                            if not self.sendable_slots_compatible(pair.first, pair.second) then {
                                return false;
                            };
                        };
                        return true;
                    },
                    _ then {},
                };
                true
            },
            .ReferenceType(expected_inner) then when actual in {
                .ReferenceType(actual_inner) then self.sendable_slots_compatible(
                    actual_inner,
                    expected_inner,
                ),
                _ then true,
            },
            .MutableReferenceType(expected_inner) then when actual in {
                .MutableReferenceType(actual_inner) then self.sendable_slots_compatible(
                    actual_inner,
                    expected_inner,
                ),
                _ then true,
            },
            .BorrowedReferenceType(expected_inner) then when actual in {
                .BorrowedReferenceType(actual_inner) then self.sendable_slots_compatible(
                    actual_inner,
                    expected_inner,
                ),
                _ then true,
            },
            .MutableBorrowedReferenceType(expected_inner) then when actual in {
                .MutableBorrowedReferenceType(actual_inner) then self.sendable_slots_compatible(
                    actual_inner,
                    expected_inner,
                ),
                _ then true,
            },
            .WeakReferenceType(expected_inner) then when actual in {
                .WeakReferenceType(actual_inner) then self.sendable_slots_compatible(
                    actual_inner,
                    expected_inner,
                ),
                _ then true,
            },
            .MutableWeakReferenceType(expected_inner) then when actual in {
                .MutableWeakReferenceType(actual_inner) then self.sendable_slots_compatible(
                    actual_inner,
                    expected_inner,
                ),
                _ then true,
            },
            .GenericStruct(_, expected_args) or .GenericEnum(_, expected_args) then {
                when actual in {
                    .GenericStruct(_, actual_args) or .GenericEnum(_, actual_args) then {
                        if actual_args.count() != expected_args.count() then {
                            return false;
                        };
                        for pair in actual_args.lazy().zip[
                            Type,
                            ListIterator[Type],
                            List[Type],
                        ](expected_args) then {
                            if not self.sendable_slots_compatible(pair.first, pair.second) then {
                                return false;
                            };
                        };
                        true
                    },
                    _ then true,
                }
            },
            .FixedArrayType(_, expected_inner) then when actual in {
                .FixedArrayType(_, actual_inner) then self.sendable_slots_compatible(
                    actual_inner,
                    expected_inner,
                ),
                _ then true,
            },
            .ForeignFunctionType(expected_params, expected_ret) then {
                when actual in {
                    .ForeignFunctionType(actual_params, actual_ret) then {
                        if actual_params.count() != expected_params.count() then {
                            return false;
                        };
                        for pair in actual_params.lazy().zip[
                            FunctionParamEntry,
                            ListIterator[FunctionParamEntry],
                            List[FunctionParamEntry],
                        ](expected_params) then {
                            if not self.sendable_slots_compatible(
                                (pair.first).param_type,
                                (pair.second).param_type,
                            ) then {
                                return false;
                            };
                        };
                        return self.sendable_slots_compatible(actual_ret, expected_ret);
                    },
                    _ then true,
                }
            },
            _ then true,
        };
    };

    /// 合流用：两个等形类型逐位与出 `sendable` 槽（取弱者，不放大
    /// sendability）。分支一边 sendable 一边不 sendable 时，合流结果是弱者。
    type_with_and_sendable_slots(self, a: Type, b: Type): Type = {
        return when a in {
            .FunctionType(a_params, a_ret, _) then when b in {
                .FunctionType(b_params, b_ret, _) then {
                    let mutable merged_params = List[FunctionParamEntry].with_capacity(
                        a_params.count(),
                    );
                    for pair in a_params.lazy().zip[
                        FunctionParamEntry,
                        ListIterator[FunctionParamEntry],
                        List[FunctionParamEntry],
                    ](b_params) then {
                        merged_params.push(
                            FunctionParamEntry(
                                self.type_with_and_sendable_slots(
                                    (pair.first).param_type,
                                    (pair.second).param_type,
                                ),
                                (pair.first).pass_kind,
                            ),
                        );
                    };
                    Type.FunctionType(
                        merged_params,
                        self.type_with_and_sendable_slots(a_ret, b_ret),
                        self.context().is_sendable_type(a) and self.context().is_sendable_type(b),
                    )
                },
                _ then a,
            },
            .TraitObject(a_trait_def_id, a_args, _) then when b in {
                .TraitObject(_, b_args, _) then {
                    let mutable merged_args = List[Type].with_capacity(a_args.count());
                    for pair in a_args.lazy().zip[
                        Type,
                        ListIterator[Type],
                        List[Type],
                    ](b_args) then {
                        merged_args.push(self.type_with_and_sendable_slots(pair.first, pair.second));
                    };
                    Type.TraitObject(
                        a_trait_def_id,
                        merged_args,
                        self.context().is_sendable_type(a) and self.context().is_sendable_type(b),
                    )
                },
                _ then a,
            },
            .ReferenceType(a_inner) then when b in {
                .ReferenceType(b_inner) then Type.ReferenceType(
                    self.type_with_and_sendable_slots(a_inner, b_inner),
                ),
                _ then a,
            },
            .MutableReferenceType(a_inner) then when b in {
                .MutableReferenceType(b_inner) then Type.MutableReferenceType(
                    self.type_with_and_sendable_slots(a_inner, b_inner),
                ),
                _ then a,
            },
            .BorrowedReferenceType(a_inner) then when b in {
                .BorrowedReferenceType(b_inner) then Type.BorrowedReferenceType(
                    self.type_with_and_sendable_slots(a_inner, b_inner),
                ),
                _ then a,
            },
            .MutableBorrowedReferenceType(a_inner) then when b in {
                .MutableBorrowedReferenceType(b_inner) then Type.MutableBorrowedReferenceType(
                    self.type_with_and_sendable_slots(a_inner, b_inner),
                ),
                _ then a,
            },
            .WeakReferenceType(a_inner) then when b in {
                .WeakReferenceType(b_inner) then Type.WeakReferenceType(
                    self.type_with_and_sendable_slots(a_inner, b_inner),
                ),
                _ then a,
            },
            .MutableWeakReferenceType(a_inner) then when b in {
                .MutableWeakReferenceType(b_inner) then Type.MutableWeakReferenceType(
                    self.type_with_and_sendable_slots(a_inner, b_inner),
                ),
                _ then a,
            },
            .GenericStruct(a_def_id, a_args) then when b in {
                .GenericStruct(_, b_args) then {
                    let mutable merged_args = List[Type].with_capacity(a_args.count());
                    for pair in a_args.lazy().zip[
                        Type,
                        ListIterator[Type],
                        List[Type],
                    ](b_args) then {
                        merged_args.push(self.type_with_and_sendable_slots(pair.first, pair.second));
                    };
                    Type.GenericStruct(a_def_id, merged_args)
                },
                _ then a,
            },
            .GenericEnum(a_def_id, a_args) then when b in {
                .GenericEnum(_, b_args) then {
                    let mutable merged_args = List[Type].with_capacity(a_args.count());
                    for pair in a_args.lazy().zip[
                        Type,
                        ListIterator[Type],
                        List[Type],
                    ](b_args) then {
                        merged_args.push(self.type_with_and_sendable_slots(pair.first, pair.second));
                    };
                    Type.GenericEnum(a_def_id, merged_args)
                },
                _ then a,
            },
            .FixedArrayType(len, a_inner) then when b in {
                .FixedArrayType(_, b_inner) then Type.FixedArrayType(
                    len,
                    self.type_with_and_sendable_slots(a_inner, b_inner),
                ),
                _ then a,
            },
            .ForeignFunctionType(a_params, a_ret) then when b in {
                .ForeignFunctionType(b_params, b_ret) then {
                    let mutable merged_params = List[FunctionParamEntry].with_capacity(
                        a_params.count(),
                    );
                    for pair in a_params.lazy().zip[
                        FunctionParamEntry,
                        ListIterator[FunctionParamEntry],
                        List[FunctionParamEntry],
                    ](b_params) then {
                        merged_params.push(
                            FunctionParamEntry(
                                self.type_with_and_sendable_slots(
                                    (pair.first).param_type,
                                    (pair.second).param_type,
                                ),
                                (pair.first).pass_kind,
                            ),
                        );
                    };
                    Type.ForeignFunctionType(
                        merged_params,
                        self.type_with_and_sendable_slots(a_ret, b_ret),
                    )
                },
                _ then a,
            },
            _ then a,
        };
    };

    nominal_instantiation_matches_generic(
        self,
        nominal: Type,
        generic_candidate: Type,
    ): Bool = {
        return when nominal in {
            // Identity: the template's DECLARATION, not its spelling.
            .StructureType(def_id) then when generic_candidate in {
                .GenericStruct(expected_def_id, expected_args) then {
                    let template_def_id = self.context().get_template_def_id(def_id);
                    if not template_def_id.is_valid() or template_def_id != expected_def_id then {
                        return false;
                    };
                    let actual_args = self.context().get_type_arguments(def_id) or else {
                        return false;
                    };
                    if actual_args.count() != expected_args.count() then {
                        return false;
                    };
                    for pair in actual_args.lazy().zip[
                        Type,
                        ListIterator[Type],
                        List[Type],
                    ](expected_args) then {
                        if not self.same_expr_type(
                            (pair.first),
                            (pair.second),
                        ) then {
                            return false;
                        };
                    };
                    true
                },
                _ then false,
            },
            .EnumType(def_id) then when generic_candidate in {
                .GenericEnum(expected_def_id, expected_args) then {
                    let template_def_id = self.context().get_template_def_id(def_id);
                    if not template_def_id.is_valid() or template_def_id != expected_def_id then {
                        return false;
                    };
                    let actual_args = self.context().get_type_arguments(def_id) or else {
                        return false;
                    };
                    if actual_args.count() != expected_args.count() then {
                        return false;
                    };
                    for pair in actual_args.lazy().zip[
                        Type,
                        ListIterator[Type],
                        List[Type],
                    ](expected_args) then {
                        if not self.same_expr_type(
                            (pair.first),
                            (pair.second),
                        ) then {
                            return false;
                        };
                    };
                    true
                },
                _ then false,
            },
            _ then false,
        };
    };

    canonicalize_alias_type(self, t: Type): Type = {
        return when t in {
            .StructureType(def_id) or .EnumType(def_id) or .OpaqueType(def_id) then when self.context().lookup_type(def_id) in {
                .Some(mapped) then {
                    if mapped == t then {
                        return t;
                    };
                    return self.canonicalize_alias_type(mapped);
                },
                .None() then t,
            },
            .ReferenceType(inner) then Type.ReferenceType(
                self.canonicalize_alias_type(inner),
            ),
            .MutableReferenceType(inner) then Type.MutableReferenceType(
                self.canonicalize_alias_type(inner),
            ),
            .PointerType(inner) then Type.PointerType(
                self.canonicalize_alias_type(inner),
            ),
            .MutablePointerType(inner) then Type.MutablePointerType(
                self.canonicalize_alias_type(inner),
            ),
            .WeakReferenceType(inner) then Type.WeakReferenceType(
                self.canonicalize_alias_type(inner),
            ),
            .MutableWeakReferenceType(inner) then Type.MutableWeakReferenceType(
                self.canonicalize_alias_type(inner),
            ),
            .FunctionType(fn_params, return_type, _) then {
                let param_types = param_entry_types(fn_params);
                let mutable resolved_params = List[Type].new();
                for pt in param_types then {
                    resolved_params.push(intern_type(self.canonicalize_alias_type(pt)));
                };
                let resolved_ret = self.canonicalize_alias_type(return_type);
                make_function_type_with_flag(
                    resolved_params,
                    resolved_ret,
                    self.context().is_sendable_type(t),
                )
            },
            .ForeignFunctionType(fn_params, return_type) then {
                let param_types = param_entry_types(fn_params);
                let mutable resolved_params = List[Type].new();
                for pt in param_types then {
                    resolved_params.push(intern_type(self.canonicalize_alias_type(pt)));
                };
                let resolved_ret = self.canonicalize_alias_type(return_type);
                Type.ForeignFunctionType(types_to_param_entries(resolved_params), resolved_ret)
            },
            _ then t,
        };
    };

    concretize_default_literal_type(self, t: Type): Type = {
        let resolved = self.storage.constraint_solver.resolve(t);
        return when resolved in {
            .TypeVar(tv) then when tv.literal_default_kind in {
                .Some(kind) then when kind in {
                    .Int() then Type.IntType(),
                    .Float() then Type.Float64Type(),
                },
                .None() then resolved,
            },
            .ReferenceType(inner) then Type.ReferenceType(
                self.concretize_default_literal_type(inner),
            ),
            .MutableReferenceType(inner) then Type.MutableReferenceType(
                self.concretize_default_literal_type(inner),
            ),
            .PointerType(inner) then Type.PointerType(
                self.concretize_default_literal_type(inner),
            ),
            .MutablePointerType(inner) then Type.MutablePointerType(
                self.concretize_default_literal_type(inner),
            ),
            .WeakReferenceType(inner) then Type.WeakReferenceType(
                self.concretize_default_literal_type(inner),
            ),
            .MutableWeakReferenceType(inner) then Type.MutableWeakReferenceType(
                self.concretize_default_literal_type(inner),
            ),
            .FunctionType(fn_params, return_type, _) then {
                let param_types = param_entry_types(fn_params);
                let mutable resolved_params = List[Type].new();
                for pt in param_types then {
                    resolved_params.push(self.concretize_default_literal_type(pt));
                };
                Type.FunctionType(
                    types_to_param_entries(resolved_params),
                    self.concretize_default_literal_type(return_type),
                    self.context().is_sendable_type(resolved),
                )
            },
            .ForeignFunctionType(fn_params, return_type) then {
                let param_types = param_entry_types(fn_params);
                let mutable resolved_params = List[Type].new();
                for pt in param_types then {
                    resolved_params.push(self.concretize_default_literal_type(pt));
                };
                Type.ForeignFunctionType(
                    types_to_param_entries(resolved_params),
                    self.concretize_default_literal_type(return_type),
                )
            },
            .GenericStruct(template_def_id, args) then {
                let mutable resolved_args = List[Type].new();
                for arg in args then {
                    resolved_args.push(self.concretize_default_literal_type(arg));
                };
                Type.GenericStruct(template_def_id, resolved_args)
            },
            .GenericEnum(template_def_id, args) then {
                let mutable resolved_args = List[Type].new();
                for arg in args then {
                    resolved_args.push(self.concretize_default_literal_type(arg));
                };
                Type.GenericEnum(template_def_id, resolved_args)
            },
            .TraitObject(trait_def_id, args, _) then {
                let mutable resolved_args = List[Type].new();
                for arg in args then {
                    resolved_args.push(self.concretize_default_literal_type(arg));
                };
                Type.TraitObject(trait_def_id, resolved_args, self.context().is_sendable_type(resolved))
            },
            _ then resolved,
        };
    };

    display_type_name(self, t: Type): String = {
        let resolved = self.canonicalize_alias_type(
            self.concretize_default_literal_type(t),
        );
        // Wrapper prefixes come from `type_string_prefixes`, the one spelling
        // table; this function only decides what the base type is called.
        // Peeling first is also what lets a name nested under `?` or `*`
        // resolve to its declaration instead of falling through to `struct#N`.
        let chain = split_type_string_wrappers(resolved);
        return type_string_prefixes(chain) + self.display_type_base_name(chain.inner);
    };

    /// The innermost type's name. Alias and default-literal preprocessing have
    /// already happened in `display_type_name`; this names what is left.
    display_type_base_name(self, resolved: Type): String = {
        return when resolved in {
            .StructureType(def_id) or .EnumType(def_id) then when self.context().get_name(def_id) in {
                .Some(name) then name,
                .None() then when self.context().get_original_def_id(def_id) in {
                    .Some(original_def_id) then when self.context().get_name(
                        original_def_id,
                    ) in {
                        .Some(original_name) then original_name,
                        .None() then type_to_string(resolved),
                    },
                    .None() then type_to_string(resolved),
                },
            },
            .OpaqueType(def_id) then when self.context().lookup_type(def_id) in {
                .Some(mapped) then self.display_type_name(mapped),
                .None() then type_to_string(resolved),
            },
            .FunctionType(fn_params, return_type, is_sendable) then {
                let param_types = param_entry_types(fn_params);
                let mutable out = StringBuilder.new();
                out.push_string(sendable_prefix_text(is_sendable));
                out.push_byte('(');
                let mutable first = true;
                for pt in param_types then {
                    if not first then {
                        out.push_string(", ");
                    };
                    out.push_string(self.display_type_name(pt));
                    first = false;
                };
                out.push_byte(')');
                out.push_string(" -> ");
                out.push_string(self.display_type_name(return_type));
                out.to_string()
            },
            .ForeignFunctionType(fn_params, return_type) then {
                let param_types = param_entry_types(fn_params);
                let mutable out = StringBuilder.new();
                out.push_string("foreign ");
                out.push_byte('(');
                let mutable first = true;
                for pt in param_types then {
                    if not first then {
                        out.push_string(", ");
                    };
                    out.push_string(self.display_type_name(pt));
                    first = false;
                };
                out.push_byte(')');
                out.push_string(" -> ");
                out.push_string(self.display_type_name(return_type));
                out.to_string()
            },
            // Display only: the spelling is read from the declaration.
            .GenericStruct(tplDefId, args) then {
                let mutable out = StringBuilder.new();
                out.push_string(def_id_spelling(tplDefId));
                out.push_byte('[');
                let mutable first = true;
                for arg in args then {
                    if not first then {
                        out.push_string(", ");
                    };
                    out.push_string(self.display_type_name(arg));
                    first = false;
                };
                out.push_byte(']');
                out.to_string()
            },
            .GenericEnum(tplDefId, args) then {
                let mutable out = StringBuilder.new();
                out.push_string(def_id_spelling(tplDefId));
                out.push_byte('[');
                let mutable first = true;
                for arg in args then {
                    if not first then {
                        out.push_string(", ");
                    };
                    out.push_string(self.display_type_name(arg));
                    first = false;
                };
                out.push_byte(']');
                out.to_string()
            },
            .TraitObject(trait_def_id, _, is_sendable) then "\(sendable_prefix_text(is_sendable))\(def_id_spelling(trait_def_id))",
            _ then type_to_string(resolved),
        };
    };

    choose_conditional_result_type(
        self,
        expected: Option[Type],
        then_type: Type,
        else_type: Option[Type],
    ): Type = {
        when expected in {
            .Some(et) then {
                if not self.contains_generic_parameter(et) then {
                    return et;
                };
            },
            .None() then {},
        };
        if else_type is .None() then {
            return Type.VoidType();
        };

        let else_t = else_type or else {
            return Type.VoidType();
        };

        // 分支合流：两向都试（槽位方向只允许放宽），合流结果按位取弱者，
        // 不放大 sendability。
        if self.same_expr_type(then_type, else_t) or self.same_expr_type(else_t, then_type) then {
            return self.type_with_and_sendable_slots(then_type, else_t);
        };

        when then_type in {
            .ReferenceType(then_inner_ref) then when else_t in {
                .ReferenceType(else_inner_ref) then {
                    when else_inner_ref in {
                        .TraitObject(...) then {
                            if self.can_convert_to_trait_object(
                                then_inner_ref,
                                else_inner_ref,
                            ) then {
                                return else_t;
                            };
                        },
                        _ then {},
                    };
                    when then_inner_ref in {
                        .TraitObject(...) then {
                            if self.can_convert_to_trait_object(
                                else_inner_ref,
                                then_inner_ref,
                            ) then {
                                return then_type;
                            };
                        },
                        _ then {},
                    };
                },
                .MutableReferenceType(else_inner_ref) then {
                    when then_inner_ref in {
                        .TraitObject(...) then {
                            if self.can_convert_to_trait_object(
                                else_inner_ref,
                                then_inner_ref,
                            ) then {
                                return then_type;
                            };
                        },
                        _ then {},
                    };
                },
                _ then {},
            },
            .MutableReferenceType(then_inner_ref) then when else_t in {
                .ReferenceType(else_inner_ref) then {
                    when else_inner_ref in {
                        .TraitObject(...) then {
                            if self.can_convert_to_trait_object(
                                then_inner_ref,
                                else_inner_ref,
                            ) then {
                                return else_t;
                            };
                        },
                        _ then {},
                    };
                },
                .MutableReferenceType(else_inner_ref) then {
                    when else_inner_ref in {
                        .TraitObject(...) then {
                            if self.can_convert_to_trait_object(
                                then_inner_ref,
                                else_inner_ref,
                            ) then {
                                return else_t;
                            };
                        },
                        _ then {},
                    };
                    when then_inner_ref in {
                        .TraitObject(...) then {
                            if self.can_convert_to_trait_object(
                                else_inner_ref,
                                then_inner_ref,
                            ) then {
                                return then_type;
                            };
                        },
                        _ then {},
                    };
                },
                _ then {},
            },
            _ then {},
        };

        if then_type is .NeverType() then {
            return else_t;
        };
        if else_t is .NeverType() then {
            return then_type;
        };

        let then_unresolved = self.is_unresolved_expr_type(then_type);
        let else_unresolved = self.is_unresolved_expr_type(else_t);
        if then_unresolved and not else_unresolved then {
            return else_t;
        };
        if else_unresolved and not then_unresolved then {
            return then_type;
        };
        when expected in {
            .Some(et) then {
                if not self.is_unresolved_expr_type(et) then {
                    return et;
                };
            },
            .None() then {},
        };
        return then_type;
    };

    is_enum_decl_type(self, t: Type): Bool = when t in {
        .EnumType(_) then true,
        _ then false,
    };

    is_enum_base_name(self, base: String): Bool = {
        if self.resolve_type_name_binding(base) is .Some(t) then {
            return self.is_enum_decl_type(t);
        };
        return false;
    };

    is_enum_base_name_in_scope(self, base: String, scope: Scope): Bool = {
        if self.try_resolve_named_type_in_scope_without_diag(base, scope) is .Some(t) then {
            return self.is_enum_decl_type(t);
        };
        return false;
    };

    retained_given_member_skeleton(self, member: TypedGivenMember): TypedGivenMember = {
        let _ = self;
        return TypedGivenMember(
            member.def_id,
            member.name,
            List[TypedParam].new(),
            Type.Unknown(),
            Option[TypedExpr].None(),
            member.trait_method_def_id,
        );
    };

    retained_decl_skeleton(self, typed_decl: TypedDecl): TypedDecl = {
        return when typed_decl in {
            .FunctionDecl(access, name, _, _, body, span, id) then {
                TypedDecl.FunctionDecl(
                    access,
                    name,
                    List[TypedParam].new(),
                    Type.Unknown(),
                    body,
                    span,
                    id,
                )
            },
            .IntrinsicFunctionDecl(access, name, _, _, span, id) then {
                TypedDecl.IntrinsicFunctionDecl(
                    access,
                    name,
                    List[TypedParam].new(),
                    Type.Unknown(),
                    span,
                    id,
                )
            },
            .ForeignFunctionDecl(access, name, _, _, body, span, id) then {
                TypedDecl.ForeignFunctionDecl(
                    access,
                    name,
                    List[TypedParam].new(),
                    Type.Unknown(),
                    body,
                    span,
                    id,
                )
            },
            .TypeStructDecl(access, name, _, span, id) then {
                TypedDecl.TypeStructDecl(access, name, List[TypedField].new(), span, id)
            },
            .TypeEnumDecl(access, name, _, span, id) then {
                TypedDecl.TypeEnumDecl(access, name, List[TypedEnumCase].new(), span, id)
            },
            .GivenDecl(target_type, members, span) then {
                let mutable skeleton_members = List[TypedGivenMember].new();
                for member_ref in members then {
                    skeleton_members.push(
                        self.retained_given_member_skeleton(member_ref),
                    );
                };
                TypedDecl.GivenDecl(target_type, skeleton_members, span)
            },
            .GivenTraitDecl(target_type, trait_name, trait_args, members, span, _) then {
                let mutable skeleton_members = List[TypedGivenMember].new();
                for member_ref in members then {
                    skeleton_members.push(
                        self.retained_given_member_skeleton(member_ref),
                    );
                };
                TypedDecl.GivenTraitDecl(
                    target_type,
                    trait_name,
                    trait_args,
                    skeleton_members,
                    span,
                    self.trait_def_id_of(trait_name) or else DefId(UInt(0)),
                )
            },
            .IntrinsicGivenDecl(target_type, members, span) then {
                let mutable skeleton_members = List[TypedGivenMember].new();
                for member_ref in members then {
                    skeleton_members.push(
                        self.retained_given_member_skeleton(member_ref),
                    );
                };
                TypedDecl.IntrinsicGivenDecl(target_type, skeleton_members, span)
            },
            _ then typed_decl,
        };
    };

    decl_can_clear_local_symbol_types_in_build(self, decl: Decl): Bool = {
        let _ = self;
        return when decl in {
            .LetDecl(_, _, _, _, _, _, _) then true,
            .FunctionDecl(_, _, type_params, _, _, _, _, _) then type_params.is_empty(),
            .GivenDecl(_, type_params, members, _) or .GivenTraitDecl(_, type_params, _, members, _)
            or .IntrinsicGivenDecl(_, type_params, members, _) then {
                if not type_params.is_empty() then {
                    return false;
                };
                for member in members then {
                    if not member.type_params.is_empty() then {
                        return false;
                    };
                };
                true
            },
            _ then false,
        };
    };

    public check_program(
        self,
        program: Program,
        retain_checked_template_bodies: Bool,
    ): TypedProgram = {
        self.collect_signatures(program);
        let mutable typed_decls = List[TypedDecl].new();
        let skip_typed_decl_retention = self.skip_typed_decl_retention_debug_enabled();
        // Register every top-level `let` before any check runs, so a reference
        // can force the check of the global it names.
        for decl in program.declarations then {
            self.register_pending_global_init(decl, retain_checked_template_bodies);
        };
        for decl in program.declarations then {
            when decl in {
                _ then {
                    // Fresh declaration boundary: the abandon gate re-arms per
                    // declaration, exactly where Swift's per-declaration catch
                    // starts a clean slate.
                    self.storage.fatal_diagnostic_fired = false;
                    let td = self.check_decl(decl, retain_checked_template_bodies);
                    let finalized_decl = self.finalize_checked_decl_constraints(
                        if retain_checked_template_bodies then Option[TypedDecl].Some(
                            td,
                        ) else Option[TypedDecl].None(),
                    );
                    if retain_checked_template_bodies and not skip_typed_decl_retention then when finalized_decl in {
                        .Some(resolved) then typed_decls.push(
                            self.retained_decl_skeleton(resolved),
                        ),
                        .None() then {},
                    }
                },
            };
        };
        if self.has_errors() then {
            return TypedProgram(typed_decls, self.context().get_names());
        };
        return TypedProgram(typed_decls, self.context().get_names());
    };

    // Multi-module variant: check a flat list of LoadedNodes (std + user combined).
    // Each node carries its own source_file for accurate diagnostics.
    public check_loaded_nodes(
        self,
        nodes: List[Pair[LoadedNode, List[String]]],
        retain_checked_template_bodies: Bool,
    ): TypedProgram = {
        let debug_progress = self.sema_progress_debug_enabled();
        if debug_progress then {
            println(
                "[sema-phase] pass2: collect signatures begin nodes=\(nodes.count())",
            );
        };

        // Pass 2: collect signatures (with per-node file_path context)
        // Match the Swift pipeline and the single-program path by registering
        // all traits first. Otherwise cross-file references like
        // `ref Error` inside generic enum templates can degrade to Unknown
        // when the owning declaration is visited before the trait file.
        for pair in nodes then {
            when pair.first.decl in {
                .TraitDecl(_, _, _, _, _, _, _, _) then {
                    self.storage.file_path = pair.first.source_file;
                    self.storage.module_path = pair.second;
                    self.install_name_resolution_context();
                    self.storage.package_id = pair.first.package_id;
                    if debug_progress then {
                        println(
                            "[sema-pass2] trait file=\(self.storage.file_path) label=\(self.decl_debug_label(pair.first.decl))",
                        );
                    };
                    self.collect_decl_signature(pair.first.decl);
                },
                _ then {},
            };
        };
        // Every trait is registered by now, so a `using` that names one can
        // bind its local spelling to the same declaration before any body is
        // checked.
        self.register_imported_trait_names(nodes);

        // Every trait is registered by now, so a parent list can be resolved.
        // `Any` gets no free pass here: it is an ordinary trait name and, like
        // any other, is an error when nothing declares it.
        for pair in nodes then {
            when pair.first.decl in {
                .TraitDecl(_, trait_name, trait_is_sendable, _, parents, _, span, name_span) then {
                    self.storage.file_path = pair.first.source_file;
                    self.storage.module_path = pair.second;
                    self.install_name_resolution_context();
                    self.storage.package_id = pair.first.package_id;
                    self.validate_trait_parent_existence(parents, span);
                    self.enforce_sendable_trait_inheritance(
                        trait_name,
                        trait_is_sendable,
                        parents,
                        name_span,
                    );
                },
                _ then {},
            };
        };
        for pair in nodes then {
            when pair.first.decl in {
                .TraitDecl(_, _, _, _, _, _, _, _) then {},
                _ then {
                    self.storage.file_path = pair.first.source_file;
                    self.storage.module_path = pair.second;
                    self.install_name_resolution_context();
                    self.storage.package_id = pair.first.package_id;
                    if debug_progress then {
                        println(
                            "[sema-pass2] decl file=\(self.storage.file_path) label=\(self.decl_debug_label(pair.first.decl))",
                        );
                    };
                    self.collect_decl_signature(pair.first.decl);
                },
            };
        };
        if debug_progress then {
            println(
                "[sema-phase] pass2: collect signatures done next_def_id=\(self.context().next_def_id())",
            );
            println("[sema-phase] pass3: check decl begin");
        };
        // Register every top-level `let` before any check runs, so a reference
        // can force the check of the global it names -- in any module.
        for pair in nodes then {
            self.storage.file_path = pair.first.source_file;
            self.storage.module_path = pair.second;
            self.install_name_resolution_context();
            self.storage.package_id = pair.first.package_id;
            self.register_pending_global_init(pair.first.decl, retain_checked_template_bodies);
        };
        // Pass 3: check bodies
        let mutable typed_decls = List[TypedDecl].new();
        let total_nodes = nodes.count();
        let mutable checked_decl_count = 0;
        let skip_typed_decl_retention = self.skip_typed_decl_retention_debug_enabled();
        let skip_decl_check = self.skip_decl_check_debug_enabled();
        let skip_function_decl_check = self.skip_function_decl_check_debug_enabled();
        let skip_let_decl_check = self.skip_let_decl_check_debug_enabled();
        let skip_given_decl_check = self.skip_given_decl_check_debug_enabled();
        let reset_constraint_solver_each_decl = self.reset_constraint_solver_each_decl_debug_enabled(
        );
        let clear_variable_symbol_types_each_decl = self.clear_variable_symbol_types_each_decl_debug_enabled(
        );
        let skip_call_family = self.skip_call_family_debug_enabled();
        let skip_member_path = self.skip_member_path_debug_enabled();
        for pair in nodes then {
            self.storage.file_path = pair.first.source_file;
            self.storage.module_path = pair.second;
            self.install_name_resolution_context();
            self.storage.package_id = pair.first.package_id;
            // Fresh declaration boundary: the abandon gate re-arms per
            // declaration, exactly where Swift's per-declaration catch starts a
            // clean slate.
            self.storage.fatal_diagnostic_fired = false;
            let decl_start_def_id = self.context().next_def_id();
            if debug_progress then {
                println(
                    "[sema-decl] next=\(checked_decl_count + 1)/\(total_nodes) file=\(self.storage.file_path) label=\(self.decl_debug_label(pair.first.decl))",
                );
            };
            when pair.first.decl in {
                _ then {
                    let skip_this_decl = if skip_decl_check then true
                    else when pair.first.decl in {
                        .FunctionDecl(_, _, _, _, _, _, _, _) then skip_function_decl_check,
                        .LetDecl(_, _, _, _, _, _, _) then skip_let_decl_check,
                        .GivenDecl(_, _, _, _) or .GivenTraitDecl(_, _, _, _, _)
                        or .IntrinsicGivenDecl(_, _, _, _) then skip_given_decl_check,
                        _ then false,
                    };
                    if not skip_this_decl then {
                        let td = self.check_decl(
                            pair.first.decl,
                            retain_checked_template_bodies,
                        );
                        let finalized_decl = self.finalize_checked_decl_constraints(
                            if retain_checked_template_bodies then Option[TypedDecl].Some(
                                td,
                            ) else Option[TypedDecl].None(),
                        );
                        if retain_checked_template_bodies and not skip_typed_decl_retention then when finalized_decl in {
                            .Some(resolved) then typed_decls.push(
                                self.retained_decl_skeleton(resolved),
                            ),
                            .None() then {},
                        }
                    };
                    checked_decl_count += 1;
                },
            };
            if reset_constraint_solver_each_decl then {
                self.storage.constraint_solver.clear_debug_state();
            };
            let can_clear_local_symbol_types = clear_variable_symbol_types_each_decl or not retain_checked_template_bodies or (retain_checked_template_bodies and self.decl_can_clear_local_symbol_types_in_build(
                pair.first.decl,
            ));
            if can_clear_local_symbol_types then {
                let decl_end_def_id = self.context().next_def_id();
                let mutable context = self.context();
                context.clear_variable_symbol_types_in_range(
                    decl_start_def_id,
                    decl_end_def_id,
                );
            };
            if debug_progress and checked_decl_count % 8 == 0 then {
                self.log_sema_progress(checked_decl_count, total_nodes);
            };
        };
        if self.has_errors() then {
            return TypedProgram(typed_decls, self.context().get_names());
        };
        if debug_progress then {
            println(
                "[sema-phase] pass3: check decl done next_def_id=\(self.context().next_def_id())",
            );
        };
        return TypedProgram(typed_decls, self.context().get_names());
    };

    finalize_checked_decl_constraints(
        self,
        typed_decl: Option[TypedDecl],
    ): Option[TypedDecl] = {
        let subst_result = self.storage.constraint_solver.solve();
        let skip_checked_decl_substitution = self.skip_checked_decl_substitution_debug_enabled(
        );
        return when subst_result in {
            .Ok(subst) then {
                let resolved_decl = when typed_decl in {
                    .Some(td) then {
                        if not subst.mapping.is_empty() then {
                            self.refresh_concrete_stored_exprs(subst, td);
                        };
                        if skip_checked_decl_substitution then Option[TypedDecl].Some(
                            td,
                        )
                        else Option[TypedDecl].Some(self.apply_subst_to_decl(subst, td))
                    },
                    .None() then Option[TypedDecl].None(),
                };
                self.storage.constraint_solver.clear_debug_state();
                resolved_decl
            },
            .Error(e) then {
                let partial_bindings = self.storage.constraint_solver.unifier.current_bindings(
                );
                let mutable resolved_bindings = Dict[UInt, Type].new();
                for entry in partial_bindings then {
                    resolved_bindings.insert(
                        entry.first,
                        self.storage.constraint_solver.unifier.resolve_deep(
                            entry.second,
                        ),
                    );
                };
                let partial_subst = TypeSubstitution(resolved_bindings);
                let resolved_decl = when typed_decl in {
                    .Some(td) then {
                        if not partial_subst.mapping.is_empty() then {
                            self.refresh_concrete_stored_exprs(partial_subst, td);
                        };
                        if skip_checked_decl_substitution then Option[TypedDecl].Some(
                            td,
                        )
                        else Option[TypedDecl].Some(
                            self.apply_subst_to_decl(partial_subst, td),
                        )
                    },
                    .None() then Option[TypedDecl].None(),
                };
                self.push_diagnostic(e.message(), unknown_span());
                self.storage.constraint_solver.clear_debug_state();
                resolved_decl
            },
        };
    };

    refresh_concrete_stored_exprs(
        self,
        subst: TypeSubstitution,
        typed_decl: TypedDecl,
    ): Void = {
        when typed_decl in {
            .LetDecl(_, _, _, _, _, _, id) then {
                let mutable context = self.context();
                when context.get_concrete_global_initializer(id.def_id) in {
                    .Some(initializer) then {
                        context.set_concrete_global_initializer(
                            id.def_id,
                            self.apply_subst_to_expr(subst, initializer),
                        );
                    },
                    .None() then {},
                };
            },
            .FunctionDecl(_, _, _, _, _, _, id) then {
                let mutable context = self.context();
                when context.get_concrete_function_body(id.def_id) in {
                    .Some(body) then {
                        context.set_concrete_function_body(
                            id.def_id,
                            self.apply_subst_to_expr(subst, body),
                        );
                    },
                    .None() then {},
                };
            },
            .GivenDecl(_, members, _) or .GivenTraitDecl(_, _, _, members, _, _)
            or .IntrinsicGivenDecl(_, members, _) then {
                self.refresh_concrete_given_member_body_list(subst, members);
            },
            _ then {},
        };
    };

    refresh_concrete_given_member_body_list(
        self,
        subst: TypeSubstitution,
        members: List[TypedGivenMember],
    ): Void = {
        let mutable context = self.context();
        for member_ref in members then {
            when context.get_concrete_given_member_body(member_ref.def_id) in {
                .Some(body) then {
                    context.set_concrete_given_member_body(
                        member_ref.def_id,
                        self.apply_subst_to_expr(subst, body),
                    );
                },
                .None() then {},
            };
        };
    };

    /// The trait a `given Trait { ... }` block extends, when it is a TRAIT TOOL
    /// BLOCK — or a generic `given[T Any] Iterator[T] { ... }`, which is one
    /// for LOOKUP purposes but must not be one for MATERIALISATION.
    ///
    /// Swift draws the line at `TypeCheckerPasses.swift:1173`
    /// (`if typeParams.isEmpty`) and never registers a generic block as a tool
    /// block at all; its methods live as generic extension templates and are
    /// instantiated from call sites. Bootstrap keeps generic blocks in
    /// `trait_tool_blocks` because `resolve_trait_tool_method_signature` is what
    /// binds the TRAIT's type parameters to a receiver's conformance arguments,
    /// and that binding is what trait-object and generic-parameter receivers
    /// resolve through. The divergence is closed at the other end: see
    /// `materialize_trait_tool_members_for_conformance`, which refuses to copy a
    /// generic block's methods onto every conformance.
    ///
    /// Getting that end wrong is expensive. A tool block's methods are copied
    /// onto EVERY conformance of the trait at declaration time, so stamping
    /// `given[T] Iterator[T]` tools onto every iterator drags the whole adapter
    /// family into every binary — ~21k lines of C for a program that sorts a
    /// list.
    trait_tool_target_name(
        self,
        target_type: TypeNode,
        type_params: List[TypeParameter],
    ): Option[String] = {
        let candidate = when target_type in {
            .Identifier(name, span) then {
                if not type_params.is_empty() then {
                    return Option[String].None();
                };
                name
            },
            .Generic(base, args, span) then {
                if args.count() != type_params.count() then {
                    return Option[String].None();
                };
                for pair in type_params.lazy().zip[
                    TypeNode,
                    ListIterator[TypeNode],
                    List[TypeNode],
                ](args) then {
                    let expected_name = pair.first.name;
                    let matches = when pair.second in {
                        .Identifier(actual_name, span) then actual_name == expected_name,
                        _ then false,
                    };
                    if not matches then {
                        return Option[String].None();
                    };
                };
                base
            },
            _ then "",
        };
        if candidate.is_empty() then {
            return Option[String].None();
        };
        return when self.storage.trait_registry.get_in_module(
            candidate,
            self.storage.module_path,
        ) in {
            .Some(info) then if info.type_params.count() == type_params.count() then Option[String].Some(
                candidate,
            ) else Option[String].None(),
            .None() then Option[String].None(),
        };
    };

    register_trait_tool_block(
        self,
        trait_name: String,
        type_params: List[TypeParameter],
        members: List[GivenMember],
        span: SourceSpan,
    ): Bool = {
        let trait_info = when self.storage.trait_registry.get_in_module(
            trait_name,
            self.storage.module_path,
        ) in {
            .Some(info) then info,
            .None() then {
                self.push_diagnostic("Undefined trait: \(trait_name)", span);
                return false;
            },
        };
        if trait_info.type_params.count() != type_params.count() then {
            self.push_diagnostic(
                "Type mismatch: expected \(trait_info.type_params.count()) generic params, got \(type_params.count())",
                span,
            );
            return false;
        };

        let mutable seen_names = List[String].new();
        for member in members then {
            if self.string_list_contains(seen_names, member.name) then {
                self.push_diagnostic(
                    self.duplicate_definition_message(member.name),
                    span,
                );
                return false;
            };
            seen_names.push(member.name);
            // Requirements of the trait AND its parents: a tool named like any
            // inherited requirement is the same conflict as one named like the
            // trait's own.
            if self.trait_declares_requirement_in_trait(
                trait_info.def_id,
                member.name,
                Set[UInt].new(),
            ) then {
                self.push_diagnostic(
                    "Trait entity method '\(member.name)' conflicts with requirement in trait '\(trait_name)'",
                    span,
                );
                return false;
            };
        };

        let existing_blocks = self.storage.generic_templates.trait_tool_blocks.get(
            trait_name,
        ) or else List[TraitToolBlock].new();
        for block in existing_blocks then {
            for existing_method in block.methods then {
                if self.string_list_contains(seen_names, existing_method.name) then {
                    self.push_diagnostic(
                        self.duplicate_definition_message(existing_method.name),
                        span,
                    );
                    return false;
                };
            };
        };

        let mutable updated_blocks = List[TraitToolBlock].with_capacity(
            existing_blocks.count() + 1,
        );
        for block in existing_blocks then {
            updated_blocks.push(block);
        };
        // Assign each tool method its declaration identity HERE, exactly once. Every
        // later materialization (a conformance of a type implementing this trait, reached
        // along any number of trait paths) reuses this same DefId. Re-minting per
        // materialization is what made one method look like several, forcing the choice
        // between reporting a false ambiguity (`comparable`) and missing a real one
        // (`trait_same_name_method_conflict`).
        let mutable members_with_ids = List[GivenMember].with_capacity(members.count());
        for member in members then {
            let member_id = if member.def_id.is_valid() then member.def_id
            else self.allocate_unindexed_def_id(member.name, DefKind.Function());
            members_with_ids.push(
                GivenMember(
                    member.name,
                    member.type_params,
                    member.access,
                    member.params,
                    member.return_type,
                    member.body,
                    member_id,
                ),
            );
        };
        let new_block = TraitToolBlock(
            trait_name,
            self.to_template_type_params(type_params),
            members_with_ids,
            self.storage.file_path,
            self.storage.module_path,
            self.storage.package_id,
        );
        updated_blocks.push(new_block);
        self.storage.generic_templates.trait_tool_blocks.insert(
            trait_name,
            updated_blocks,
        );
        // Indexed by the trait DECLARATION too: the spelling bucket cannot
        // answer "which trait?" for a same-named or aliased trait, and the
        // identity walk reads this one.
        let def_key = trait_info.def_id.id;
        let mutable def_blocks = self.storage.generic_templates.trait_tool_blocks_by_def_id.get(
            def_key,
        ) or else List[TraitToolBlock].new();
        def_blocks.push(new_block);
        self.storage.generic_templates.trait_tool_blocks_by_def_id.insert(
            def_key,
            def_blocks,
        );
        return true;
    };

    /// Who owns a method name on a concrete type's method table.
    ///
    /// An INHERENT method (`given X { m }`) or a trait REQUIREMENT witness owns
    /// the name; a materialized trait TOOL never does -- an inherent method
    /// simply overrides a tool (guide: "Inherent type methods win over trait
    /// tool methods"). An inherent name colliding with a requirement name is a
    /// definition error in every registration order, never a priority contest.
    slot_owned_by_inherent_or_requirement(
        self,
        type_key: MethodOwner,
        method_name: String,
    ): Bool = {
        if self.storage.method_table.is_inherent(type_key, method_name) then {
            return true;
        };
        for trait_def_id in self.storage.method_table.providing_traits(
            type_key,
            method_name,
        ) then {
            if self.trait_declares_requirement_in_trait(
                trait_def_id,
                method_name,
                Set[UInt].new(),
            ) then {
                return true;
            };
        };
        return false;
    };

    // Swift `ownRequirements` — methods a trait declares as requirements, as opposed
    // to trait-tool entity methods. Parent requirements are inherited, so recurse.
    trait_declares_requirement(self, trait_name: String, method_name: String): Bool = {
        // The spelling is resolved once, here; the walk is by declaration.
        let trait_def_id = self.trait_def_id_of(trait_name) or else def_id_invalid();
        let mutable visited = Set[UInt].new();
        return self.trait_declares_requirement_in_trait(
            trait_def_id,
            method_name,
            visited,
        );
    };

    /// Walks the DECLARATION and its parents. Two same-named traits from
    /// different modules are different nodes and must not share a visit slot.
    trait_declares_requirement_in_trait(
        self,
        trait_def_id: DefId,
        method_name: String,
        visited: Set[UInt],
    ): Bool = {
        if visited.contains(trait_def_id.id) then {
            return false;
        };
        visited.insert(trait_def_id.id);
        let info = self.storage.trait_registry.get_by_def_id(trait_def_id) or else {
            return false;
        };
        for m in info.methods then {
            if m.name == method_name then {
                return true;
            };
        };
        for parent in info.parent_traits then {
            if self.trait_declares_requirement_in_trait(
                parent.def_id,
                method_name,
                visited,
            ) then {
                return true;
            };
        };
        return false;
    };

    flattened_trait_tool_methods(
        self,
        trait_name: String,
    ): Result[Dict[String, TraitToolMethodEntry]] = {
        // The spelling is resolved once, here; the walk is by declaration.
        let trait_def_id = self.trait_def_id_of(trait_name) or else def_id_invalid();
        let mutable visited = Set[UInt].new();
        return self.flattened_trait_tool_methods_in_trait(
            trait_def_id,
            trait_name,
            visited,
        );
    };

    /// Walks the DECLARATION and its parents. Two same-named traits from
    /// different modules are different nodes and must not share a visit slot.
    /// `trait_name` survives only to print diagnostics.
    flattened_trait_tool_methods_in_trait(
        self,
        trait_def_id: DefId,
        trait_name: String,
        visited: Set[UInt],
    ): Result[Dict[String, TraitToolMethodEntry]] = {
        if visited.contains(trait_def_id.id) then {
            return Result[Dict[String, TraitToolMethodEntry]].Ok(
                Dict[String, TraitToolMethodEntry].new(),
            );
        };
        visited.insert(trait_def_id.id);
        let trait_info = self.storage.trait_registry.get_by_def_id(trait_def_id) or else {
            return Result[Dict[String, TraitToolMethodEntry]].Error(
                "Undefined trait: \(trait_name)",
            );
        };

        let mutable result = Dict[String, TraitToolMethodEntry].new();
        for parent in trait_info.parent_traits then {
            // An unresolved parent contributes no methods. Whether it should
            // exist at all is the parent list's business --
            // `validate_trait_parent_existence` has already named it -- and
            // reporting it again from here repeats that line at every
            // conformance site that mentions the child.
            if not parent.def_id.is_valid() then {
                continue;
            };
            let parent_methods = self.flattened_trait_tool_methods_in_trait(
                parent.def_id,
                parent.name,
                visited,
            ) or return;
            for entry in parent_methods then {
                if result.contains_key(entry.first) then {
                    let existing = result.get(entry.first) or else entry.second;
                    if existing.method.def_id != entry.second.method.def_id then {
                        return Result[Dict[String, TraitToolMethodEntry]].Error(
                            "Ambiguous tool method '\(entry.first)' inherited in trait '\(trait_name)'",
                        );
                    };
                    continue;
                };
                result.insert(entry.first, entry.second);
            };
        };

        // The DECLARATION's own bucket: the spelling bucket is keyed by what
        // the `given Trait { ... }` site wrote and cannot answer for a trait
        // reached under an alias or a same-named sibling.
        let blocks = self.storage.generic_templates.trait_tool_blocks_by_def_id.get(
            trait_def_id.id,
        ) or else List[TraitToolBlock].new();
        for block in blocks then {
            for method in block.methods then {
                if result.contains_key(method.name) then {
                    let existing = result.get(method.name) or else TraitToolMethodEntry(
                        block.trait_name,
                        method,
                        block.type_params,
                        block.source_file,
                        block.module_path,
                        block.package_id,
                    );
                    if existing.method.def_id != method.def_id then {
                        return Result[Dict[String, TraitToolMethodEntry]].Error(
                            "Trait tool method conflict '\(method.name)' in trait '\(trait_name)'",
                        );
                    };
                    continue;
                };
                result.insert(
                    method.name,
                    TraitToolMethodEntry(
                        block.trait_name,
                        method,
                        block.type_params,
                        block.source_file,
                        block.module_path,
                        block.package_id,
                    ),
                );
            };
        };
        return Result[Dict[String, TraitToolMethodEntry]].Ok(result);
    };

    trait_tool_method_is_receiver_style(self, method: GivenMember): Bool = {
        return not method.params.is_empty() and method.params[0].name == "self";
    };

    collect_signatures(self, program: Program): Void = {
        for decl in program.declarations then {
            when decl in {
                .TraitDecl(_, _, _, _, _, _, _, _) then self.collect_decl_signature(decl),
                _ then {},
            };
        };
        // Every trait is registered by now, so a parent list can be resolved.
        // `Any` gets no free pass here: it is an ordinary trait name and, like
        // any other, is an error when nothing declares it.
        for decl in program.declarations then {
            when decl in {
                .TraitDecl(_, trait_name, trait_is_sendable, _, parents, _, span, name_span) then {
                    self.validate_trait_parent_existence(parents, span);
                    self.enforce_sendable_trait_inheritance(
                        trait_name,
                        trait_is_sendable,
                        parents,
                        name_span,
                    );
                },
                _ then {},
            };
        };
        for decl in program.declarations then {
            when decl in {
                .TraitDecl(_, _, _, _, _, _, _, _) then {},
                _ then self.collect_decl_signature(decl),
            };
        };
        self.link_parent_trait_def_ids();
    };

    /// Bind every parent constraint to the DECLARATION its spelling names.
    ///
    /// Runs after the trait sub-pass so a parent declared later in the file is
    /// already registered. Resolving during construction would depend on
    /// declaration order and leave a forward reference unbound; this back-fills
    /// those so nothing downstream has to re-resolve a spelling.
    link_parent_trait_def_ids(self): Void = {
        let mutable pending = List[TraitInfo].new();
        for entry in self.storage.trait_registry.traits_by_def_id.iterator() then {
            pending.push(entry.second);
        };
        for info in pending then {
            let mutable linked = List[ParentTraitConstraint].new();
            let mutable changed = false;
            for parent in info.parent_traits then {
                if parent.def_id.is_valid() then {
                    linked.push(parent);
                    continue;
                };
                let resolved = self.storage.trait_registry.get_in_module(
                    parent.name,
                    info.module_path,
                );
                let parent_def_id = when resolved in {
                    .Some(parent_info) then parent_info.def_id,
                    .None() then def_id_invalid(),
                };
                linked.push(
                    ParentTraitConstraint(
                        parent.name,
                        parent.type_arg_nodes,
                        parent_def_id,
                    ),
                );
                changed = true;
            };
            if not changed then {
                continue;
            };
            self.storage.trait_registry.register(
                TraitInfo(
                    info.def_id,
                    info.name,
                    info.type_params,
                    linked,
                    info.methods,
                    info.module_path,
                ),
            );
            // The codegen view carries its own copies under name keys; rewrite
            // every entry that is this declaration.
            let mutable rewrite_keys = List[String].new();
            for entry in self.storage.generic_templates.traits.iterator() then {
                if entry.second.def_id == info.def_id then {
                    rewrite_keys.push(entry.first);
                };
            };
            for key in rewrite_keys then {
                let decl = self.storage.generic_templates.traits.get(key) or else {
                    continue;
                };
                self.storage.generic_templates.traits.insert(
                    key,
                    TraitDeclInfo(
                        decl.def_id,
                        decl.name,
                        decl.type_params,
                        linked,
                        decl.raw_members,
                        decl.members,
                        decl.method_def_ids_by_name,
                        decl.module_path,
                    ),
                );
            };
            when self.storage.generic_templates.lookup_trait_by_def_id(info.def_id) in {
                .Some(decl) then self.storage.generic_templates.register_trait_decl(
                    TraitDeclInfo(
                        decl.def_id,
                        decl.name,
                        decl.type_params,
                        linked,
                        decl.raw_members,
                        decl.members,
                        decl.method_def_ids_by_name,
                        decl.module_path,
                    ),
                ),
                .None() then {},
            };
        };
    };

    /// Reject parent trait names that no declaration binds. Runs after the
    /// trait sub-pass so a parent may be declared later in the file.
    ///
    /// `span` is the trait declaration whose parent list is wrong -- this runs
    /// outside `collect_decl_signature`, so the walker is not inside the trait
    /// and the declaration has to be named.
    validate_trait_parent_existence(
        self,
        parents: List[TypeNode],
        span: SourceSpan,
    ): Void = {
        for parent in parents then {
            let pname = self.type_node_name(parent);
            let resolved = when self.storage.trait_registry.get_in_module(
                pname,
                self.storage.module_path,
            ) in {
                .Some(info) then Option[TraitInfo].Some(info),
                .None() then self.storage.trait_registry.get_in_module(
                    pname,
                    self.storage.module_path,
                ),
            };
            when resolved in {
                .Some(_) then {},
                .None() then {
                    self.push_diagnostic("Undefined trait: \(pname)", span);
                },
            };
        };
    };

    /// `trait A: B` where B is `trait sendable` forces A to declare `sendable`
    /// as well (concurrency-design.md): an always-sendable trait object family
    /// must not grow a non-sendable branch. Explicit, no inference.
    ///
    /// `name_span` is where the trait's NAME is written -- the fix (adding
    /// `sendable`) belongs at the declaration's head, so that is where the
    /// diagnostic points. Only the first offending parent is named: the fix is
    /// the same for every parent, and one declaration reports one error.
    enforce_sendable_trait_inheritance(
        self,
        trait_name: String,
        is_sendable: Bool,
        parents: List[TypeNode],
        name_span: SourceSpan,
    ): Void = {
        if is_sendable then {
            return;
        };
        for parent in parents then {
            let pname = self.type_node_name(parent);
            when self.storage.trait_registry.get_in_module(
                pname,
                self.storage.module_path,
            ) in {
                .Some(parent_info) then {
                    if self.context().is_sendable_trait(parent_info.def_id) then {
                        self.push_diagnostic(
                            "Trait '\(trait_name)' extends sendable trait '\(pname)' and must be declared sendable",
                            name_span,
                        );
                        return;
                    };
                },
                .None() then {},
            };
        };
    };

    collect_decl_signature(self, decl: Decl): Void = {
        let outer_span = self.enter_current_span(self.decl_span(decl));
        defer {
            self.leave_current_span(outer_span);
        };
        when decl in {
            .TypeStructDecl(access, name, is_mutable_type, sendability, type_params, fields, span, _) then {
                let mutable resolved_type = self.lookup_current_file_type_symbol(name) or else {
                    self.report_pass2_decl_consistency_error(
                        "struct declaration",
                        name,
                        "missing struct symbol",
                    );
                    return;
                };
                if type_params.is_empty() then {
                    self.storage.generic_templates.concrete_struct_types.insert(
                        name,
                        resolved_type,
                    );
                } else when resolved_type in {
                    .StructureType(def_id) then {
                        let mutable template_fields = List[TemplateField].new();
                        for field in fields then {
                            template_fields.push(
                                TemplateField(
                                    field.access,
                                    field.name,
                                    field.is_mutable,
                                    self.copy_type_node(field.type_name),
                                    field.named,
                                    field.default_value,
                                ),
                            );
                        };
                        let struct_template = GenericStructTemplate(
                            def_id,
                            name,
                            self.to_template_type_params(type_params),
                            template_fields,
                        );
                        // Under its MODULE key. Only the module-qualified key
                        // identifies the declaration (a top-level symbol is
                        // (module, name)).
                        self.storage.generic_templates.struct_templates.insert(
                            qualified_symbol_key(self.storage.module_path, name),
                            struct_template,
                        );
                        // The unqualified name index (`bare_symbol_key`) is
                        // last-wins when two modules declare `Box` and exists
                        // only for the "Import it explicitly" diagnostic. Its
                        // own key space keeps it from clobbering a real
                        // empty-path symbol of the same name.
                        if not self.storage.module_path.is_empty() then {
                            self.storage.generic_templates.struct_templates.insert(
                                bare_symbol_key(name),
                                struct_template,
                            );
                        };
                        // By DECLARATION as well: `struct_templates` is keyed by
                        // spelling and two modules' `Box` would collide there.
                        self.storage.generic_templates.struct_templates_by_def_id.insert(
                            def_id.id,
                            struct_template,
                        );
                    },
                    _ then {
                        self.report_pass2_decl_consistency_error(
                            "struct declaration",
                            name,
                            "generic struct symbol is not a structure",
                        );
                        return;
                    },
                };
                if resolved_type is .StructureType(def_id) then {
                    let mutable context = self.context();
                    context.set_struct_mutable(def_id, is_mutable_type);
                    context.set_type_sendability(def_id, sendability);
                    // Lang-item link point: a struct declared in std is recorded
                    // by its DECLARATION identity, so built-in operator behaviour
                    // can be attached without matching on the spelling later.
                    if self.is_std_module_path(self.storage.module_path) then {
                        context.set_std_type_def_id(name, def_id);
                    };
                    let mutable sf = List[StructField].new();
                    if type_params.is_empty() then {
                        for f in fields then {
                            sf.push(
                                StructField(
                                    f.name,
                                    self.resolve_type(f.type_name),
                                    f.is_mutable,
                                    f.access,
                                    f.named,
                                    f.default_value,
                                ),
                            );
                        };
                    } else {
                        let bindings = self.generic_type_param_bindings(type_params);
                        for f in fields then {
                            sf.push(
                                StructField(
                                    f.name,
                                    self.resolve_type_with_bindings(
                                        f.type_name,
                                        bindings,
                                    ),
                                    f.is_mutable,
                                    f.access,
                                    f.named,
                                    f.default_value,
                                ),
                            );
                        };
                    };
                    let mutable template_args = Option[List[Type]].None();
                    let mutable template_name = Option[String].None();
                    let mutable template_def_id = def_id_invalid();
                    if not type_params.is_empty() then {
                        let mutable args = List[Type].new();
                        for type_param in type_params then {
                            args.push(Type.GenericParameter(type_param.name));
                        };
                        template_args = Option[List[Type]].Some(args);
                        template_name = Option[String].Some(name);
                        template_def_id = def_id;
                    };
                    context.update_struct_info(
                        def_id,
                        sf,
                        not type_params.is_empty(),
                        template_args,
                        template_name,
                        template_def_id,
                    );
                } else {
                    self.report_pass2_decl_consistency_error(
                        "struct declaration",
                        name,
                        "resolved to non-structure type",
                    );
                    return;
                };
            },
            .TypeEnumDecl(access, name, _, type_params, cases, span, name_span) then {
                let mutable resolved_type = self.lookup_current_file_type_symbol(name) or else {
                    self.report_pass2_decl_consistency_error(
                        "enum declaration",
                        name,
                        "missing enum symbol",
                    );
                    return;
                };
                if type_params.is_empty() then {
                    self.storage.generic_templates.concrete_enum_types.insert(
                        name,
                        resolved_type,
                    );
                } else when resolved_type in {
                    .EnumType(def_id) then {
                        let mutable template_cases = List[TemplateCase].new();
                        for case_ in cases then {
                            let mutable template_params = List[TemplateParam].new();
                            for field in case_.fields then {
                                template_params.push(
                                    TemplateParam(
                                        field.name,
                                        false,
                                        self.copy_type_node(field.type_name),
                                        field.named,
                                        field.default_value,
                                    ),
                                );
                            };
                            template_cases.push(
                                TemplateCase(case_.name, template_params),
                            );
                        };
                        let enum_template = GenericEnumTemplate(
                            def_id,
                            name,
                            self.to_template_type_params(type_params),
                            template_cases,
                        );
                        // Under its MODULE key -- see the struct case above.
                        self.storage.generic_templates.enum_templates.insert(
                            qualified_symbol_key(self.storage.module_path, name),
                            enum_template,
                        );
                        // The unqualified name index (`bare_symbol_key`) -- see
                        // the struct case above.
                        if not self.storage.module_path.is_empty() then {
                            self.storage.generic_templates.enum_templates.insert(
                                bare_symbol_key(name),
                                enum_template,
                            );
                        };
                        // By DECLARATION as well: `enum_templates` is keyed by
                        // spelling and two same-named enums would collide there.
                        self.storage.generic_templates.enum_templates_by_def_id.insert(
                            def_id.id,
                            enum_template,
                        );
                        // Lang-item link point: a generic enum declared in std is
                        // recorded by its DECLARATION identity, so `and then` /
                        // `or else` can recognise std's `Option` / `Result`
                        // without matching on the spelling afterwards.
                        if self.is_std_module_path(self.storage.module_path) then {
                            self.context().set_std_type_def_id(name, def_id);
                        };
                    },
                    _ then {
                        self.report_pass2_decl_consistency_error(
                            "enum declaration",
                            name,
                            "generic enum symbol is not an enum",
                        );
                        return;
                    },
                };
                if resolved_type is .EnumType(def_id) then {
                    let mutable uc = List[EnumCaseInfo].new();
                    if type_params.is_empty() then {
                        for c in cases then {
                            let mutable params = List[EnumCaseParam].new();
                            for f in c.fields then {
                                params.push(
                                    EnumCaseParam(
                                        f.name,
                                        self.resolve_type(f.type_name),
                                        f.named,
                                        f.default_value,
                                    ),
                                );
                            };
                            uc.push(EnumCaseInfo(c.name, params));
                        };
                    } else {
                        let bindings = self.generic_type_param_bindings(type_params);
                        for c in cases then {
                            let mutable params = List[EnumCaseParam].new();
                            for f in c.fields then {
                                params.push(
                                    EnumCaseParam(
                                        f.name,
                                        self.resolve_type_with_bindings(
                                            f.type_name,
                                            bindings,
                                        ),
                                        f.named,
                                        f.default_value,
                                    ),
                                );
                            };
                            uc.push(EnumCaseInfo(c.name, params));
                        };
                    };
                    let mutable context = self.context();
                    let mutable template_args = Option[List[Type]].None();
                    let mutable template_name = Option[String].None();
                    let mutable template_def_id = def_id_invalid();
                    if not type_params.is_empty() then {
                        let mutable args = List[Type].new();
                        for type_param in type_params then {
                            args.push(Type.GenericParameter(type_param.name));
                        };
                        template_args = Option[List[Type]].Some(args);
                        template_name = Option[String].Some(name);
                        template_def_id = def_id;
                    };
                    context.update_union_info(
                        def_id,
                        uc,
                        not type_params.is_empty(),
                        template_args,
                        template_name,
                        template_def_id,
                    );
                } else {
                    self.report_pass2_decl_consistency_error(
                        "enum declaration",
                        name,
                        "resolved to non-enum type",
                    );
                    return;
                };
            },
            .FunctionDecl(access, name, type_params, params, return_type, body, span, name_span) then {
                if not type_params.is_empty() then {
                    let bindings = self.generic_type_param_bindings(type_params);
                    let mutable checked_param_types = List[Type].new();
                    for p in params then {
                        checked_param_types.push(
                            self.resolve_type_with_bindings(p.type_name, bindings),
                        );
                    };
                    let checked_params = self.typed_params_to_checked_symbols(
                        self.build_typed_params_from_resolved(
                            params,
                            checked_param_types,
                        ),
                    );
                    let checked_return_type = self.resolve_type_with_bindings(
                        return_type,
                        bindings,
                    );
                    self.register_generic_function_template(
                        name,
                        type_params,
                        params,
                        return_type,
                        Option[TypedExpr].None(),
                        Option[List[Symbol]].Some(checked_params),
                        Option[Type].Some(checked_return_type),
                    );
                };
                let mutable param_types = List[Type].new();
                let resolved_ret = if type_params.is_empty() then {
                    for p in params then {
                        param_types.push(self.resolve_type(p.type_name));
                    };
                    self.resolve_type(return_type)
                } else {
                    let bindings = self.generic_type_param_bindings(type_params);
                    for p in params then {
                        param_types.push(
                            self.resolve_type_with_bindings(p.type_name, bindings),
                        );
                    };
                    self.resolve_type_with_bindings(return_type, bindings)
                };
                let mutable stable_param_types = List[Type].new();
                for param_type in param_types then {
                    stable_param_types.push(param_type);
                };
                let stable_ret = resolved_ret;
                let mutable context = self.context();
                let typed_params_for_specs = self.build_typed_params_from_resolved(
                    params,
                    param_types,
                );
                let mutable pt_refs = List[Type].new();
                for pt in stable_param_types then {
                    pt_refs.push(pt);
                };
                // 顶层函数引用无环境可捕获，值类型天然 `sendable`
                // （concurrency-design.md §派生规则 5）。
                let mutable fn_type = make_function_type_with_flag(pt_refs, stable_ret, true);
                let sym = self.make_top_level_symbol(
                    name,
                    fn_type,
                    SymbolKind.Function(),
                    access,
                    span,
                    false,
                );
                context.set_param_specs(
                    sym.def_id,
                    self.function_param_specs_from_typed_params(typed_params_for_specs),
                );
            },
            .IntrinsicFunctionDecl(access, name, type_params, params, return_type, span, name_span) then {
                if not type_params.is_empty() then {
                    // Generic intrinsic: only register template, defer type mutable resolution to instantiation (Swift alignment)
                    let bindings = self.generic_type_param_bindings(type_params);
                    let mutable checked_param_types = List[Type].new();
                    for p in params then {
                        checked_param_types.push(
                            self.resolve_type_with_bindings(p.type_name, bindings),
                        );
                    };
                    let checked_params = self.typed_params_to_checked_symbols(
                        self.build_typed_params_from_resolved(
                            params,
                            checked_param_types,
                        ),
                    );
                    let checked_return_type = self.resolve_type_with_bindings(
                        return_type,
                        bindings,
                    );
                    self.register_generic_function_template(
                        name,
                        type_params,
                        params,
                        return_type,
                        Option[TypedExpr].None(),
                        Option[List[Symbol]].Some(checked_params),
                        Option[Type].Some(checked_return_type),
                    );
                } else {
                    // Non-generic intrinsic: resolve types eagerly
                    let mutable param_types = List[Type].new();
                    for p in params then {
                        param_types.push(self.resolve_type(p.type_name));
                    };
                    let resolved_ret = self.resolve_type(return_type);
                    let mutable stable_param_types = List[Type].new();
                    for param_type in param_types then {
                        stable_param_types.push(param_type);
                    };
                    let stable_ret = resolved_ret;
                    let mutable context = self.context();
                    let typed_params_for_specs = self.build_typed_params_from_resolved(
                        params,
                        param_types,
                    );
                    let mutable fn_type = Type.FunctionType(
                        types_to_param_entries(
                            self.to_type_ref_list(stable_param_types),
                        ),
                        stable_ret,
                        true,
                    );
                    let sym = self.make_top_level_symbol(
                        name,
                        fn_type,
                        SymbolKind.Function(),
                        access,
                        span,
                        false,
                    );
                    context.set_param_specs(
                        sym.def_id,
                        self.function_param_specs_from_typed_params(
                            typed_params_for_specs,
                        ),
                    );
                };
            },
            .ForeignFunctionDecl(access, name, params, return_type, _, _, span, name_span) then {
                let resolved_ret = self.resolve_type(return_type);
                let mutable param_types = List[Type].new();
                for p in params then {
                    param_types.push(self.resolve_type(p.type_name));
                };
                let mutable stable_param_types = List[Type].new();
                for param_type in param_types then {
                    stable_param_types.push(param_type);
                };
                let stable_ret = resolved_ret;
                let mutable context = self.context();
                // A `let foreign` function IS a bare C function pointer: its
                // value type is `foreign (..) -> ..`, not a Koral closure.
                let mutable fn_type = Type.ForeignFunctionType(
                    types_to_param_entries(self.to_type_ref_list(stable_param_types)),
                    stable_ret,
                );
                let sym = self.make_top_level_symbol(
                    name,
                    fn_type,
                    SymbolKind.Function(),
                    access,
                    span,
                    false,
                );
                context.set_param_specs(
                    sym.def_id,
                    self.function_param_specs_from_typed_params(
                        self.check_params(params),
                    ),
                );
            },
            .ForeignTypeDecl(access, name, _, fields, _, span, name_span) then {
                if fields is .Some(raw_fields) and self.lookup_current_file_type_symbol(
                    name,
                ) is .Some(t) and t is .StructureType(def_id) then {
                    let mutable sf = List[StructField].new();
                    for f in raw_fields then {
                        let field_type = self.resolve_type(f.type_name);
                        // Foreign struct fields must be FFI-shaped. The three
                        // bans the seed checks, in its order: borrowed
                        // references, Never, and direct self-recursion (write
                        // `*Self`) -- then the `foreign` constraint itself.
                        if type_contains_borrowed_reference(field_type) then {
                            self.push_diagnostic(
                                "foreign struct field '\(f.name)' cannot contain borrowed `ref` / `ref mutable` types: '\(self.context().type_display_name(field_type))'",
                                span,
                            );
                        };
                        if type_contains_never(field_type) then {
                            self.push_diagnostic(
                                "foreign struct field '\(f.name)' cannot contain Never type: '\(self.context().type_display_name(field_type))'",
                                span,
                            );
                        };
                        // An opaque field has no layout; only `*FILE` can hold one.
                        if self.opaque_by_value_type(field_type) is .Some(opaque_t) then {
                            self.push_diagnostic(
                                self.opaque_instantiation_message(opaque_t),
                                span,
                            );
                        };
                        if field_type is .StructureType(field_def) and field_def == def_id then {
                            self.push_diagnostic(
                                "Invalid operation Direct recursion in foreign struct \(name) not allowed (use ptr) between types \(f.name) and ",
                                span,
                            );
                        };
                        if not self.satisfies_foreign_constraint(field_type) then {
                            self.push_diagnostic(
                                self.foreign_constraint_violation_message(
                                    field_type,
                                    "foreign struct field '\(f.name)'",
                                ),
                                span,
                            );
                        };
                        sf.push(
                            StructField(
                                f.name,
                                field_type,
                                true,
                                f.access,
                                f.named,
                                f.default_value,
                            ),
                        );
                    };
                    let mutable context = self.context();
                    context.set_struct_fields(def_id, sf);
                    context.set_foreign_struct_fields(def_id, sf);
                };
            },
            .TypeAliasDecl(_, name, type_params, target, _, _) then {
                if not type_params.is_empty() then {
                    // Generic alias: re-register the template (idempotent with
                    // the signature pass) and leave the name's placeholder type
                    // alone -- binding `add_type` here would make the alias
                    // indistinguishable from a nominal type at instantiation.
                    if self.lookup_current_file_def_id(name) is .Some(def_id) then {
                        let alias_template = GenericAliasTemplate(
                            def_id,
                            name,
                            self.to_template_type_params(type_params),
                            self.copy_type_node(target),
                        );
                        self.storage.generic_templates.alias_templates_by_def_id.insert(
                            def_id.id,
                            alias_template,
                        );
                    };
                } else {
                    let resolved_target = self.canonicalize_alias_type(
                        self.resolve_type(target),
                    );
                    if self.lookup_current_file_def_id(name) is .Some(def_id) then {
                        let mutable context = self.context();
                        context.add_type(def_id, resolved_target);
                    };
                    if self.lookup_current_file_def_id(name) is .Some(_) then {
                        self.storage.global_scope.define_scoped_type(
                            self.storage.module_path,
                            name,
                            resolved_target,
                        );
                    };
                };
            },
            .GivenDecl(target_type, type_params, members, span) then {
                if self.reject_concrete_type_modifier_given_if_needed(
                    target_type,
                    type_params,
                ) then {} else {
                    when self.trait_tool_target_name(target_type, type_params) in {
                        .Some(trait_name) then {
                            self.register_trait_tool_block(
                                trait_name,
                                type_params,
                                members,
                                span,
                            );
                            // A NON-GENERIC `given Trait { ... }` stops here: its
                            // methods are copied onto each conformance and never
                            // need an extension template. A generic
                            // `given[T Any] Iterator[T] { ... }` falls through and
                            // ALSO registers generic extension templates, which is
                            // the path a call site instantiates from — without them
                            // the method has a signature but no body to monomorphize.
                            if type_params.is_empty() then {
                                return;
                            };
                        },
                        .None() then {},
                    };
                    let bindings = self.generic_type_param_bindings(type_params);
                    // The given's own bounds are in scope while its target is
                    // resolved: `[T mutable]` satisfies the `?T` referent rule
                    // and a bare `[T Any]` does not. Without them the referent
                    // check sees an unbounded parameter and rejects the shape
                    // the seed accepts.
                    let given_constraint_snapshot = self.snapshot_generic_constraints(
                        type_params,
                    );
                    self.register_generic_constraints(type_params);
                    defer {
                        self.restore_generic_constraints(given_constraint_snapshot);
                    };
                    let resolved_target = if type_params.is_empty() then self.resolve_type(
                        target_type,
                    ) else self.resolve_type_with_bindings(target_type, bindings);
                    let template_target_type = self.trait_extension_self_type(
                        resolved_target,
                    );
                    let extension_type_key = self.extension_template_key_for_target_node(
                        target_type,
                        resolved_target,
                    );
                    let target_type_name = self.type_node_name(target_type);
                    let trait_tool_target_name = if type_params.is_empty() and self.storage.trait_registry.get_in_module(
                        target_type_name,
                        self.storage.module_path,
                    ) is .Some(_) then Option[String].Some(target_type_name)
                    else Option[String].None();
                    // A given that fails its locality rule has no methods.
                    // The seed throws from this signature pass BEFORE
                    // registering anything, so every call site of its members
                    // says `Member 'm' not found in type '<T>'`; registering
                    // first would make the failure invisible at the call
                    // sites. The complaint itself lands in the decl pass --
                    // same message, same span, reported once.
                    let signature_locality_checker = GivenLocalityChecker.new(
                        self.context(),
                        self.storage.trait_registry,
                        self.storage.module_path,
                        self.storage.generic_templates,
                        self.storage.global_scope,
                    );
                    if signature_locality_checker.check_given_owner_locality(
                        resolved_target,
                    ) is .Some(_) then {
                        return;
                    };
                    self.collect_given_signatures(
                        members,
                        template_target_type,
                        type_params,
                        Option[String].None(),
                    );
                    for member in members then {
                        let method_name = member.name;
                        let method_access = member.access;
                        let method_type_params = member.type_params;
                        let method_params = member.params;
                        let method_return_type_node = member.return_type;
                        let member_bindings = self.merged_type_param_bindings(
                            type_params,
                            method_type_params,
                        );
                        let checked_return_type = self.resolve_given_member_type_with_bindings(
                            method_return_type_node,
                            template_target_type,
                            member_bindings,
                        );
                        let checked_params = self.typed_params_to_checked_symbols(
                            self.check_given_member_params_with_bindings(
                                method_params,
                                template_target_type,
                                member_bindings,
                            ),
                        );
                        let no_checked_body = Option[TypedExpr].None();
                        let should_register_template = if not type_params.is_empty() then true
                        else if not member.type_params.is_empty() then true
                        else when resolved_target in {
                            .TraitObject(...) then true,
                            _ then self.mentions_unresolved_generic_placeholder(
                                resolved_target,
                            ),
                        };
                        if should_register_template then {
                            self.register_extension_method_template(
                                extension_type_key,
                                type_params,
                                Option[Type].None(),
                                List[Type].new(),
                                method_name,
                                member.def_id,
                                method_access,
                                method_type_params,
                                method_params,
                                method_return_type_node,
                                Option[String].None(),
                                Option[DefId].None(),
                                no_checked_body,
                                Option[List[Symbol]].Some(checked_params),
                                Option[Type].Some(checked_return_type),
                                List[TypeParameterDecl].new(),
                            );
                        };
                        when trait_tool_target_name in {
                            .Some(trait_name) then {
                                let all_bindings = self.merged_type_param_bindings(
                                    type_params,
                                    method_type_params,
                                );
                            },
                            .None() then {},
                        };
                    };
                };
            },
            .GivenTraitDecl(target_type, type_params, trait_type, members, span) then {
                if self.reject_concrete_type_modifier_given_if_needed(
                    target_type,
                    type_params,
                ) then {} else {
                    let bindings = self.generic_type_param_bindings(type_params);
                    // The given's own bounds are in scope while its target is
                    // resolved: `[T mutable]` satisfies the `?T` referent rule
                    // and a bare `[T Any]` does not. Without them the referent
                    // check sees an unbounded parameter and rejects the shape
                    // the seed accepts.
                    let given_constraint_snapshot = self.snapshot_generic_constraints(
                        type_params,
                    );
                    self.register_generic_constraints(type_params);
                    defer {
                        self.restore_generic_constraints(given_constraint_snapshot);
                    };
                    let resolved_target = if type_params.is_empty() then self.resolve_type(
                        target_type,
                    ) else self.resolve_type_with_bindings(target_type, bindings);
                    let template_target_type = self.trait_extension_self_type(
                        resolved_target,
                    );
                    let extension_type_key = self.extension_template_key_for_target_node(
                        target_type,
                        resolved_target,
                    );
                    let trait_name = self.type_node_name(trait_type);
                    // The name is written in THIS module -- this is where it
                    // becomes a declaration. Downstream only compares that.
                    let trait_def_id = self.trait_def_id_of(trait_name) or else DefId(
                        UInt(0),
                    );
                    let resolved_trait_args = self.trait_type_args_with_bindings(
                        trait_type,
                        bindings,
                    );
                    // Locality (orphan rule) first, then conflict detection --
                    // the same order `check_decl` uses. Both are terminal here
                    // too: Swift's signature pass throws before recording the
                    // conformance and before registering member signatures, so
                    // an illegal or conflicting given must contribute exactly
                    // one diagnostic and no registrations.
                    let locality_checker = GivenLocalityChecker.new(
                        self.context(),
                        self.storage.trait_registry,
                        self.storage.module_path,
                        self.storage.generic_templates,
                        self.storage.global_scope,
                    );
                    if locality_checker.check_given_conformance_locality(
                        resolved_target,
                        trait_name,
                    ) is .Some(msg) then {
                        self.push_diagnostic(msg, span);
                        return;
                    };
                    let conformance_key = self.trait_conformance_key(
                        resolved_target,
                        trait_def_id,
                        trait_name,
                        resolved_trait_args,
                    );
                    if not self.declare_conformance_origin(
                        conformance_key,
                        self.context().type_display_name(resolved_target),
                        trait_name,
                        span,
                    ) then {
                        return;
                    };
                    if self.sema_progress_debug_enabled() then {
                        println(
                            "[sema-pass2-giventrait] target=\(self.context().type_display_name(resolved_target)) step=record-conformance trait=\(trait_name)",
                        );
                    };
                    self.record_explicit_trait_conformance(
                        resolved_target,
                        trait_def_id,
                        trait_name,
                        resolved_trait_args,
                    );
                    self.record_generic_trait_conformance_template(
                        resolved_target,
                        type_params,
                        trait_def_id,
                        trait_name,
                        resolved_trait_args,
                    );
                    if self.sema_progress_debug_enabled() then {
                        println(
                            "[sema-pass2-giventrait] target=\(self.context().type_display_name(resolved_target)) step=iterator-conformance trait=\(trait_name)",
                        );
                    };
                    if self.sema_progress_debug_enabled() then {
                        println(
                            "[sema-pass2-giventrait] target=\(self.context().type_display_name(resolved_target)) step=collect-signatures trait=\(trait_name)",
                        );
                    };
                    self.collect_given_signatures(
                        members,
                        resolved_target,
                        type_params,
                        Option[String].Some(trait_name),
                    );
                    if self.sema_progress_debug_enabled() then {
                        println(
                            "[sema-pass2-giventrait] target=\(self.context().type_display_name(resolved_target)) step=collect-signatures-done trait=\(trait_name)",
                        );
                    };
                    let mutable needs_template_registration = not type_params.is_empty();
                    if not needs_template_registration then {
                        for member in members then {
                            if not member.type_params.is_empty() then {
                                needs_template_registration = true;
                            } else when resolved_target in {
                                .TraitObject(...) then {
                                    needs_template_registration = true;
                                },
                                _ then {
                                    if self.mentions_unresolved_generic_placeholder(
                                        resolved_target,
                                    ) then {
                                        needs_template_registration = true;
                                    };
                                },
                            };
                        };
                    };
                    if needs_template_registration then {
                        // Only the template-registration path needs trait generic bindings in scope.
                        if self.sema_progress_debug_enabled() then {
                            println(
                                "[sema-pass2-giventrait] target=\(self.context().type_display_name(resolved_target)) step=inject-trait-type-args trait=\(trait_name)",
                            );
                        };
                        let prev_scope = self.storage.current_scope;
                        defer {
                            self.storage.current_scope = prev_scope;
                        };
                        self.inject_trait_type_args_with_bindings(
                            trait_type,
                            trait_name,
                            bindings,
                        );
                        for member in members then {
                            let should_register_template = if not type_params.is_empty() then true
                            else if not member.type_params.is_empty() then true
                            else when resolved_target in {
                                .TraitObject(...) then true,
                                _ then self.mentions_unresolved_generic_placeholder(
                                    resolved_target,
                                ),
                            };
                            if not should_register_template then {
                                continue;
                            };
                            let method_name = member.name;
                            // Swift `registeredMethodDeclaration(..., access:
                            // requirementAccess)`: a trait requirement is
                            // registered at the requirement's level; the access
                            // spelling on the impl is not a symbol-visibility
                            // input. Non-requirement helpers keep their own.
                            let method_access = self.conformance_member_registration_access(
                                self.trait_def_id_of(trait_name),
                                method_name,
                                member.access,
                            );
                            let method_type_params = member.type_params;
                            let method_params = member.params;
                            let method_return_type_node = member.return_type;
                            let member_bindings = self.merged_type_param_bindings(
                                type_params,
                                method_type_params,
                            );
                            let checked_return_type = self.resolve_given_member_type_with_bindings(
                                method_return_type_node,
                                template_target_type,
                                member_bindings,
                            );
                            let checked_params = self.typed_params_to_checked_symbols(
                                self.check_given_member_params_with_bindings(
                                    method_params,
                                    template_target_type,
                                    member_bindings,
                                ),
                            );
                            let checked_body = Option[TypedExpr].None();
                            self.register_extension_method_template(
                                extension_type_key,
                                type_params,
                                Option[Type].Some(resolved_target),
                                resolved_trait_args,
                                method_name,
                                member.def_id,
                                method_access,
                                method_type_params,
                                method_params,
                                method_return_type_node,
                                Option[String].Some(trait_name),
                                self.trait_def_id_of(trait_name),
                                checked_body,
                                Option[List[Symbol]].Some(checked_params),
                                Option[Type].Some(checked_return_type),
                                List[TypeParameterDecl].new(),
                            );
                        };
                    };
                    if self.sema_progress_debug_enabled() then {
                        println(
                            "[sema-pass2-giventrait] target=\(self.context().type_display_name(resolved_target)) step=restore trait=\(trait_name)",
                        );
                    };
                };
            },
            .IntrinsicGivenDecl(target_type, type_params, members, span) then {
                if self.reject_concrete_type_modifier_given_if_needed(
                    target_type,
                    type_params,
                ) then {} else {
                    let bindings = self.generic_type_param_bindings(type_params);
                    // The given's own bounds are in scope while its target is
                    // resolved: `[T mutable]` satisfies the `?T` referent rule
                    // and a bare `[T Any]` does not. Without them the referent
                    // check sees an unbounded parameter and rejects the shape
                    // the seed accepts.
                    let given_constraint_snapshot = self.snapshot_generic_constraints(
                        type_params,
                    );
                    self.register_generic_constraints(type_params);
                    defer {
                        self.restore_generic_constraints(given_constraint_snapshot);
                    };
                    let resolved_target = if type_params.is_empty() then self.resolve_type(
                        target_type,
                    ) else self.resolve_type_with_bindings(target_type, bindings);
                    let template_target_type = self.trait_extension_self_type(
                        resolved_target,
                    );
                    let extension_type_key = self.extension_template_key_for_target_node(
                        target_type,
                        resolved_target,
                    );
                    // For non-generic intrinsic given, resolve member signatures eagerly.
                    // For generic intrinsic given, defer to instantiation (Swift alignment).
                    if type_params.is_empty() then {
                        self.collect_given_signatures(
                            members,
                            resolved_target,
                            type_params,
                            Option[String].None(),
                        );
                    };
                    for member in members then {
                        let should_register_template = if not type_params.is_empty() then true
                        else if not member.type_params.is_empty() then true
                        else when resolved_target in {
                            .TraitObject(...) then true,
                            _ then self.mentions_unresolved_generic_placeholder(
                                resolved_target,
                            ),
                        };
                        if not should_register_template then {
                            continue;
                        };
                        let method_name = member.name;
                        let method_access = member.access;
                        let method_type_params = member.type_params;
                        let method_params = member.params;
                        let method_return_type_node = member.return_type;
                        let member_bindings = self.merged_type_param_bindings(
                            type_params,
                            method_type_params,
                        );
                        let checked_return_type = self.resolve_given_member_type_with_bindings(
                            method_return_type_node,
                            template_target_type,
                            member_bindings,
                        );
                        let checked_params = self.typed_params_to_checked_symbols(
                            self.check_given_member_params_with_bindings(
                                method_params,
                                template_target_type,
                                member_bindings,
                            ),
                        );
                        let checked_body = Option[TypedExpr].None();
                        self.register_extension_method_template(
                            extension_type_key,
                            type_params,
                            Option[Type].None(),
                            List[Type].new(),
                            method_name,
                            member.def_id,
                            method_access,
                            method_type_params,
                            method_params,
                            method_return_type_node,
                            Option[String].None(),
                            Option[DefId].None(),
                            checked_body,
                            Option[List[Symbol]].Some(checked_params),
                            Option[Type].Some(checked_return_type),
                            List[TypeParameterDecl].new(),
                        );
                    };
                };
            },
            .LetDecl(access, name, is_mutable, _, _, span, _) then {
                // `let` 的类型在注册阶段（register_pending_global_init）沉定：
                // 签到阶段只登记名字与 DefId（与参考编译器同形——"the type is
                // settled at its definition pass"）。这里再解析一遍会把标注
                // 诊断提前到签到阶段，并因去重让注册阶段的失败降级失灵。
                let resolved = Type.Unknown();
                let variable_kind = if is_mutable then VariableKind.MutableValue()
                else VariableKind.Value();
                let _ = self.make_top_level_symbol(
                    name,
                    resolved,
                    SymbolKind.Variable(variable_kind),
                    access,
                    span,
                    is_mutable,
                );
            },
            .ForeignLetDecl(access, name, is_mutable, type_name, _, _, span, name_span) then {
                let resolved = self.resolve_type(type_name);
                let variable_kind = if is_mutable then VariableKind.MutableValue()
                else VariableKind.Value();
                let _ = self.make_top_level_symbol(
                    name,
                    resolved,
                    SymbolKind.Variable(variable_kind),
                    access,
                    span,
                    is_mutable,
                );
            },
            .TraitDecl(access, name, _, type_params, parents, members, span, name_span) then {
                // 在 signature 收集阶段注册完整 Trait（包含方法）,
                // 确保跨模块 given 检查能读取到正确的 requirement 集合。
                let mutable parent_constraints = List[ParentTraitConstraint].new();
                for p in parents then {
                    let pname = self.type_node_name(p);
                    let type_arg_nodes = when p in {
                        .Generic(_, args, span) then {
                            let mutable nodes = List[TypeNode].new();
                            for arg in args then {
                                nodes.push(arg);
                            };
                            nodes
                        },
                        _ then List[TypeNode].new(),
                    };
                    // Resolved here when the parent is already registered;
                    // `link_parent_trait_def_ids` covers forward references.
                    parent_constraints.push(
                        ParentTraitConstraint(
                            pname,
                            type_arg_nodes,
                            self.trait_def_id_of(pname) or else def_id_invalid(),
                        ),
                    );
                };
                let trait_def_id = self.lookup_current_file_def_id(name) or else def_id_invalid(
                );
                let typed_members = self.check_trait_members(
                    members,
                    type_params,
                    trait_def_id,
                );
                self.register_trait_metadata(
                    name,
                    trait_def_id,
                    type_params,
                    parent_constraints,
                    members,
                    typed_members,
                );
            },
            _ then {},
        };
    };

    /// Assign each `given` member its DECLARATION identity exactly once,
    /// stably across passes.
    ///
    /// The parser cannot allocate DefIds, so `GivenMember.def_id` arrives
    /// invalid. `type_checker` and `type_checker_decls` each walk the same
    /// block; if each minted its own the two would disagree and a call site
    /// bound to one could not find a table keyed by the other. The map keys on
    /// (owner, member name) -- one given block, one name per member -- and is
    /// read before allocating, so the second pass reuses the first's answer.
    members_with_def_ids(
        self,
        members: List[GivenMember],
        target_type: Type,
        conformance_trait_name: Option[String],
    ): List[GivenMember] = {
        // Two traits may declare the same method name on one type
        // (`Greet.greet` and `Farewell.greet`). Keying on (owner, name) alone
        // collapses them into one DefId, and the method table can then no
        // longer tell two declarations apart -- which is exactly what
        // `trait_same_name_method_conflict` has to report.
        let trait_part = conformance_trait_name or else "";
        let mutable out = List[GivenMember].with_capacity(members.count());
        for member in members then {
            let map_key = "\(self.context().method_owner_of(target_type).display())#\(trait_part)#\(member.name)";
            let member_id = when member.def_id.is_valid() in {
                true then member.def_id,
                false then self.storage.given_member_def_ids.get(map_key) or else {
                    let allocated = self.allocate_unindexed_def_id(
                        member.name,
                        DefKind.Function(),
                    );
                    self.storage.given_member_def_ids.insert(map_key, allocated);
                    // A call site that does not name the trait still needs a
                    // declaration identity. The first writer wins this
                    // alias; two same-named trait methods colliding here is
                    // already an error reported at registration.
                    let alias_key = "\(self.context().method_owner_of(target_type).display())#\(member.name)";
                    if not self.storage.given_member_def_ids.contains_key(alias_key) then {
                        self.storage.given_member_def_ids.insert(
                            alias_key,
                            allocated,
                        );
                    };
                    allocated
                },
            };
            out.push(
                GivenMember(
                    member.name,
                    member.type_params,
                    member.access,
                    member.params,
                    member.return_type,
                    member.body,
                    member_id,
                ),
            );
        };
        return out;
    };

    collect_given_signatures(
        self,
        members: List[GivenMember],
        target_type: Type,
        owner_type_params: List[TypeParameter],
        conformance_trait_name: Option[String],
    ): Void = {
        // Build a scope with owner type params so resolve_type sees them
        // Always set current_scope (like Swift's withNewScope) so generic params are visible
        let prev_scope = self.storage.current_scope;
        defer {
            self.storage.current_scope = prev_scope;
        };
        let mutable sig_scope = Scope.new_child(self.storage.current_scope);
        for tp in owner_type_params then {
            sig_scope.define_generic_param(tp.name);
        };
        self.storage.current_scope = sig_scope;
        let type_key = self.extension_template_key(target_type);
        let mutable seen_names = List[String].new();
        // Same member list the body-checking pass will see, with each member's
        // DECLARATION identity already assigned and stable.
        let id_members = self.members_with_def_ids(
            members,
            target_type,
            conformance_trait_name,
        );
        for m in id_members then {
            if self.sema_progress_debug_enabled() then {
                println(
                    "[sema-pass2-given] target=\(self.context().type_display_name(target_type)) member=\(m.name)",
                );
            };
            if self.string_list_contains(seen_names, m.name) then {
                self.push_diagnostic(
                    self.duplicate_definition_message(m.name),
                    unknown_span(),
                );
                continue;
            };
            seen_names.push(m.name);
            let should_register_as_inherent = when conformance_trait_name in {
                .Some(_) then false,
                .None() then owner_type_params.is_empty() and m.type_params.is_empty(),
            };
            if should_register_as_inherent then {
                // An inherent method colliding with another INHERENT method or
                // with a trait REQUIREMENT witness is a definition error in
                // every registration order. A trait TOOL occupying the name is
                // not a conflict: the inherent method simply overrides it.
                if self.lookup_method_signature(type_key, m.name) is .Some(_)
                    and self.slot_owned_by_inherent_or_requirement(type_key, m.name) then {
                    self.push_diagnostic(
                        self.duplicate_definition_message(m.name),
                        unknown_span(),
                    );
                    continue;
                };
            };
            // Always resolve types for all members (inherent + conformance)
            // so cross-references within the same given block work.
            let member_bindings = self.merged_type_param_bindings(
                owner_type_params,
                m.type_params,
            );
            if self.sema_progress_debug_enabled() then {
                println("[sema-pass2-given-step] member=\(m.name) step=resolve-return");
            };
            let ret = self.resolve_given_member_type_with_bindings(
                m.return_type,
                target_type,
                member_bindings,
            );
            let mutable param_types = List[Type].new();
            for param in m.params then {
                param_types.push(
                    self.resolve_given_member_type_with_bindings(
                        param.type_name,
                        target_type,
                        member_bindings,
                    ),
                );
            };
            if not should_register_as_inherent then {
                // Only CONCRETE-TYPE CONFORMANCE members are registered here
                // (the gap: a cross-module static-requirement call must resolve
                // to the impl). Generic targets (`given List[T] { … }`) and
                // generic conformances route through extension templates
                // elsewhere; non-conformance helpers keep their own annotation
                // and must NOT be stamped here (stamping a private generic
                // helper's access without its home made it read as denied).
                if conformance_trait_name is .Some(_) and owner_type_params.is_empty() then {
                    // PASS-2 CONFORMANCE REGISTRATION (mirror of
                    // `register_conformance_method_signatures_for_concrete_type`,
                    // which otherwise runs in pass 3). A `given X as T { m }` member
                    // is registered NOW so a cross-module static-requirement call
                    // resolves to the IMPL at any module ordering -- the pass-3
                    // registration lands after the root module's check when a
                    // submodule sorts later, and the call then bound a DefId no
                    // instance table answered for. Resolving to the impl routes
                    // visibility to its requirement-level stamp
                    // (`conformance_member_registration_access`), so an internal
                    // trait's requirement is denied cross-module and a public
                    // trait's is allowed -- matching Swift, which resolves the method
                    // then judges `effectiveMethodAccessForMemberAccess`. Static
                    // calls reach this via `lookup_named_method_signature` (no method
                    // face gate) = "resolve, then judge visibility"; the receiver
                    // face gate is applied at lookup and is untouched here.
                    //
                    // ONLY when the slot is EMPTY: a second, distinct declaration
                    // reaching one slot must stay visible to pass 3's ambiguity
                    // report, so this never consumes that collision.
                    if self.lookup_method_signature(type_key, m.name) is .None() then {
                        let conformance_symbol = Symbol(
                            m.def_id,
                            make_function_type(param_types, ret),
                            SymbolKind.Function(),
                        );
                        let source_def_id = self.context().get_original_def_id(m.def_id) or else m.def_id;
                        let _ = self.storage.method_table.register_with_source(
                            type_key,
                            m.name,
                            conformance_symbol,
                            source_def_id,
                        );
                        let conformance_trait_def_id = when conformance_trait_name in {
                            .Some(trait_name) then self.trait_def_id_of(trait_name),
                            .None() then Option[DefId].None(),
                        };
                        // STAMP the impl's effective ACCESS (requirement level) here
                        // too -- the pass-3 stamp in `check_given_members_for_type`
                        // lands after a submodule sorts later than the root, so a
                        // cross-module call saw an un-stamped (permissive) DefId and
                        // admitted an internal trait's requirement. The requirement
                        // level comes from `conformance_member_registration_access`
                        // (the trait's declaration level), NOT an ambient home -- so
                        // this is the impl-stamp route and never touches
                        // `storage.module_path`. The impl's home stays as the existing
                        // pass-3 stamp sets it.
                        let stamp_access = self.conformance_member_registration_access(
                            conformance_trait_def_id,
                            m.name,
                            m.access,
                        );
                        self.context().set_access(m.def_id, stamp_access);
                        when conformance_trait_def_id in {
                            .Some(tid) then self.storage.method_table.register_providing_trait(
                                type_key,
                                m.name,
                                tid,
                            ),
                            .None() then {},
                        };
                    } else {
                        // The slot is taken. A REQUIREMENT witness may not share
                        // its name with an INHERENT method on the same type --
                        // that is a definition error in every declaration order
                        // (the reverse order is caught by the inherent path
                        // above), never a priority contest. Other occupants stay
                        // silent here; pass 3 reports the ambiguity.
                        when conformance_trait_name in {
                            .Some(trait_name) then {
                                if self.storage.method_table.is_inherent(
                                    type_key,
                                    m.name,
                                ) and self.trait_declares_requirement(trait_name, m.name) then {
                                    self.push_diagnostic(
                                        self.duplicate_definition_message(m.name),
                                        unknown_span(),
                                    );
                                };
                            },
                            .None() then {},
                        };
                    };
                };
                continue;
            };
            if self.sema_progress_debug_enabled() then {
                println("[sema-pass2-given-step] member=\(m.name) step=make-symbol");
            };
            let param_specs = self.merge_trait_param_defaults(
                self.function_param_specs_from_params(m.params),
                conformance_trait_name,
                m.name,
            );
            let method_symbol = self.make_method_callable_symbol_with_param_types(
                m.def_id,
                m.name,
                param_types,
                param_specs,
                ret,
                m.access,
                self.storage.module_path,
                self.storage.file_path,
                self.storage.package_id,
            );
            self.context().register_method_param_specs(type_key, m.name, param_specs);
            if should_register_as_inherent then {
                if self.sema_progress_debug_enabled() then {
                    println("[sema-pass2-given-step] member=\(m.name) step=register");
                };
                self.storage.method_table.register(type_key, m.name, method_symbol);
                // Mark the slot INHERENT at the signature pass already: a later
                // tool materialization must see it (an inherent method owns the
                // name) no matter which pass or module order runs first.
                self.storage.method_table.mark_inherent(type_key, m.name);
            };
        };
    };

    string_list_contains(self, values: List[String], target: String): Bool = {
        return values.lazy().any((x) => x == target);
    };

    to_template_type_params(
        self,
        type_params: List[TypeParameter],
    ): List[TypeParameterDecl] = {
        let mutable out = List[TypeParameterDecl].new();
        for tp in type_params then {
            let mutable constraints = List[Bound].new();
            for constraint in tp.constraints then {
                // The spelling becomes a declaration HERE. Monomorphization
                // reads these constraints back off the registry and decides
                // whether a type argument satisfies them; if the bound still
                // carried only a name it would have to look the name up again
                // in a table that is last-wins across modules.
                constraints.push(self.resolved_bound(constraint));
            };
            out.push(TypeParameterDecl(tp.name, constraints));
        };
        return out;
    };

    generic_type_param_bindings(
        self,
        type_params: List[TypeParameter],
    ): Dict[String, Type] = {
        let mutable bindings = Dict[String, Type].new();
        for tp in type_params then {
            bindings.insert(tp.name, Type.GenericParameter(tp.name));
        };
        return bindings;
    };

    merged_type_param_bindings(
        self,
        owner_params: List[TypeParameter],
        method_params: List[TypeParameter],
    ): Dict[String, Type] = {
        let mutable bindings = Dict[String, Type].new();
        for tp in owner_params then {
            bindings.insert(tp.name, Type.GenericParameter(tp.name));
        };
        for tp in method_params then {
            bindings.insert(tp.name, Type.GenericParameter(tp.name));
        };
        return bindings;
    };

    to_template_params(self, params: List[Param]): List[TemplateParam] = {
        let mutable out = List[TemplateParam].new();
        for p in params then {
            out.push(
                TemplateParam(
                    p.name,
                    p.is_mutable,
                    self.copy_type_node(p.type_name),
                    p.named,
                    p.default_value,
                ),
            );
        };
        return out;
    };

    copy_type_node_ref(self, type_node: TypeNode): TypeNode = {
        return self.copy_type_node(type_node);
    };

    copy_type_node_ref_list(self, type_nodes: List[TypeNode]): List[TypeNode] = {
        let mutable copied = List[TypeNode].with_capacity(type_nodes.count());
        for type_node in type_nodes then {
            copied.push(self.copy_type_node_ref(type_node));
        };
        return copied;
    };

    copy_type_node(self, type_node: TypeNode): TypeNode = {
        return when type_node in {
            .Identifier(name, span) then TypeNode.Identifier(name, span),
            .Reference(inner, is_mutable, span) then TypeNode.Reference(
                self.copy_type_node_ref(inner),
                is_mutable,
                span,
            ),
            .BorrowedReference(inner, is_mutable, span) then TypeNode.BorrowedReference(
                self.copy_type_node_ref(inner),
                is_mutable,
                span,
            ),
            .Pointer(inner, is_mutable, span) then TypeNode.Pointer(
                self.copy_type_node_ref(inner),
                is_mutable,
                span,
            ),
            .WeakReference(inner, is_mutable, span) then TypeNode.WeakReference(
                self.copy_type_node_ref(inner),
                is_mutable,
                span,
            ),
            .Generic(base, args, span) then TypeNode.Generic(
                base,
                self.copy_type_node_ref_list(args),
                span,
            ),
            .InferredSelf(span) then TypeNode.InferredSelf(span),
            .FunctionType(param_types, return_type, span) then TypeNode.FunctionType(
                self.copy_type_node_ref_list(param_types),
                self.copy_type_node_ref(return_type),
                span,
            ),
            .FixedArray(len, element, span) then TypeNode.FixedArray(len, self.copy_type_node_ref(element), span),
            .ForeignFunction(param_types, return_type, span) then {
                let mutable copied_params = List[TypeNode].new();
                for pt in param_types then {
                    copied_params.push(self.copy_type_node_ref(pt));
                };
                TypeNode.ForeignFunction(copied_params, self.copy_type_node_ref(return_type), span)
            },
            .SendableQualified(inner) then TypeNode.SendableQualified(
                self.copy_type_node_ref(inner),
            ),
        };
    };

    to_type_ref_list(self, types: List[Type]): List[Type] = {
        let mutable out = List[Type].new();
        for t in types then {
            out.push(t);
        };
        return out;
    };

    from_template_type_params(
        self,
        type_params: List[TypeParameterDecl],
    ): List[TypeParameter] = {
        let mutable out = List[TypeParameter].new();
        for tp in type_params then {
            let mutable constraints = List[Bound].new();
            for constraint in tp.constraints then {
                constraints.push(constraint);
            };
            out.push(TypeParameter(tp.name, constraints));
        };
        return out;
    };

    constraint_bounds_for_type_param(
        self,
        tp: TypeParameter,
        param_names: List[String],
    ): List[GenericConstraintBound] = {
        let mutable constraints = List[GenericConstraintBound].new();
        for c in tp.constraints then {
            constraints.push(self.resolve_constraint_bound(c, param_names));
        };
        return constraints;
    };

    /// Resolve a bound into a GenericConstraintBound, preserving type arguments.
    /// Unlike resolve_type, this does NOT emit diagnostics for unresolved names —
    /// forward-referenced generic params (e.g. T in [R Iterator[T], T]) fall back
    /// to GenericParameter. Shape bounds carry their canonical name here because
    /// GenericConstraintBound is still name-keyed; that collapses in the identity step.
    resolve_constraint_bound(
        self,
        b: Bound,
        param_names: List[String],
    ): GenericConstraintBound = {
        return when b in {
            .Trait(_, name, args) then {
                let mutable resolved_args = List[Type].new();
                for arg in args then {
                    resolved_args.push(
                        self.resolve_constraint_type_arg(arg, param_names),
                    );
                };
                self.validate_trait_name(name);
                GenericConstraintBound(
                    self.trait_def_id_of(name) or else DefId(UInt(0)),
                    name,
                    resolved_args,
                )
            },
            .Mutable() then GenericConstraintBound(
                DefId(UInt(0)),
                "mutable",
                List[Type].new(),
            ),
            .Foreign() then GenericConstraintBound(
                DefId(UInt(0)),
                "foreign",
                List[Type].new(),
            ),
            .Sendable() then GenericConstraintBound(
                DefId(UInt(0)),
                "sendable",
                List[Type].new(),
            ),
        };
    };

    /// Lightweight type arg resolution for constraint bounds — no diagnostics on miss.
    resolve_constraint_type_arg(self, node: TypeNode, param_names: List[String]): Type = {
        return when node in {
            .Identifier(name, span) then self.resolve_constraint_identifier(
                name,
                param_names,
            ),
            .Generic(base, args, span) then self.resolve_constraint_generic_type(
                base,
                args,
                param_names,
            ),
            .Reference(inner, is_mutable, span) then self.resolve_constraint_ref_type(
                inner,
                is_mutable,
                param_names,
            ),
            // `sendable` 前缀限定：与主解析路径同一裁定（此处 miss 不报）。
            .SendableQualified(inner) then {
                when type_with_sendable_qualifier(
                    self.resolve_constraint_type_arg(inner, param_names),
                ) in {
                    .Some(sendable_t) then sendable_t,
                    .None() then Type.Unknown(),
                }
            },
            _ then Type.Unknown(),
        };
    };

    /// Resolve a bare name written inside a constraint's type arguments.
    ///
    /// The enclosing generic declaration's own type parameters win -- `[R
    /// Iterator[T], T Any]` names the `T` being declared, and a global type that
    /// happens to be called `T` is a different thing entirely. Only when the
    /// name is not one of those does it become an ordinary type reference.
    resolve_constraint_identifier(self, name: String, param_names: List[String]): Type = {
        for param_name in param_names then {
            if param_name == name then {
                return Type.GenericParameter(name);
            };
        };
        return self.storage.global_scope.lookup_type(name) or else Type.GenericParameter(name);
    };

    /// Declaration identity of the generic template named `base`.
    ///
    /// Taken from the type symbol table first, which name collection fills
    /// before any signature is resolved -- so the identity cannot depend on
    /// declaration order. The template registry is the fallback, for names the
    /// symbol table does not hold. Never returns a name-only match.
    generic_template_def_id(self, base: String): DefId = {
        let from_global = when self.resolve_type_name_binding(base) in {
            .Some(t) then when t in {
                .StructureType(def_id) or .EnumType(def_id) then def_id,
                _ then def_id_invalid(),
            },
            .None() then def_id_invalid(),
        };
        if from_global.is_valid() then {
            return from_global;
        };
        let from_file = when self.lookup_current_file_type_symbol(base) in {
            .Some(t) then when t in {
                .StructureType(def_id) or .EnumType(def_id) then def_id,
                _ then def_id_invalid(),
            },
            .None() then def_id_invalid(),
        };
        if from_file.is_valid() then {
            return from_file;
        };
        let struct_id = self.storage.generic_templates.lookup_struct_def_id(base);
        return if struct_id.is_valid() then struct_id
        else self.storage.generic_templates.lookup_enum_def_id(base);
    };

    resolve_constraint_generic_type(
        self,
        base: String,
        args: List[TypeNode],
        param_names: List[String],
    ): Type = {
        let mutable resolved_args = List[Type].new();
        for arg in args then {
            resolved_args.push(self.resolve_constraint_type_arg(arg, param_names));
        };
        let struct_def_id = self.storage.generic_templates.lookup_struct_def_id(base);
        if struct_def_id.is_valid() then {
            return Type.GenericStruct(
                self.generic_template_def_id(base),
                self.to_type_ref_list_in_resolution(resolved_args),
            );
        };
        return Type.GenericEnum(
            self.generic_template_def_id(base),
            self.to_type_ref_list_in_resolution(resolved_args),
        );
    };

    resolve_constraint_ref_type(
        self,
        inner: TypeNode,
        is_mutable: Bool,
        param_names: List[String],
    ): Type = {
        let resolved_inner = self.resolve_constraint_type_arg(inner, param_names);
        if is_mutable then {
            return Type.MutableReferenceType(resolved_inner);
        };
        return Type.ReferenceType(resolved_inner);
    };

    snapshot_generic_constraints(
        self,
        type_params: List[TypeParameter],
    ): GenericConstraintSnapshot = {
        let mutable previous_constraints = Dict[String, Option[List[GenericConstraintBound]]].new(
        );
        let mutable previous_shape_bounds = Dict[String, Option[List[Bound]]].new();
        for tp in type_params then {
            let previous = when self.storage.generic_param_constraints.get(tp.name) in {
                .Some(existing) then {
                    let mutable copied = List[GenericConstraintBound].with_capacity(
                        existing.count(),
                    );
                    for constraint in existing then {
                        copied.push(constraint);
                    };
                    Option[List[GenericConstraintBound]].Some(copied)
                },
                .None() then Option[List[GenericConstraintBound]].None(),
            };
            previous_constraints.insert(tp.name, previous);
            let previous_shape = when self.storage.generic_param_shape_bounds.get(
                tp.name,
            ) in {
                .Some(existing) then {
                    let mutable copied = List[Bound].with_capacity(existing.count());
                    for bound in existing then {
                        copied.push(bound);
                    };
                    Option[List[Bound]].Some(copied)
                },
                .None() then Option[List[Bound]].None(),
            };
            previous_shape_bounds.insert(tp.name, previous_shape);
        };
        return GenericConstraintSnapshot(previous_constraints, previous_shape_bounds);
    };

    register_generic_constraints(self, type_params: List[TypeParameter]): Void = {
        self.invalidate_trait_requirement_caches();
        // Collect the whole parameter list first: a constraint may name a
        // parameter declared after it (`[R Iterator[T], T Any]`), and lexical
        // scoping says the binder wins over any same-named global.
        let mutable param_names = List[String].new();
        for tp in type_params then {
            param_names.push(tp.name);
        };
        for tp in type_params then {
            self.storage.generic_param_constraints.insert(
                tp.name,
                self.constraint_bounds_for_type_param(tp, param_names),
            );
            // Shape bounds (`mutable`, `foreign`) are kept apart from trait
            // bounds: `satisfies_mutable_constraint` must be able to tell a
            // parameter declared `T mutable` from a bare `T`.
            let mutable shape_bounds = List[Bound].new();
            for constraint in tp.constraints then {
                when constraint in {
                    .Mutable() or .Foreign() or .Sendable() then shape_bounds.push(constraint),
                    .Trait(_, _, _) then {},
                };
            };
            self.storage.generic_param_shape_bounds.insert(tp.name, shape_bounds);
        };
    };

    restore_generic_constraints(self, snapshot: GenericConstraintSnapshot): Void = {
        self.invalidate_trait_requirement_caches();
        for entry in snapshot.previous_constraints then {
            let name = entry.first;
            when entry.second in {
                .Some(previous) then self.storage.generic_param_constraints.insert(
                    name,
                    previous,
                ),
                .None() then self.storage.generic_param_constraints.remove(name),
            };
        };
        for entry in snapshot.previous_shape_bounds then {
            let name = entry.first;
            when entry.second in {
                .Some(previous) then self.storage.generic_param_shape_bounds.insert(
                    name,
                    previous,
                ),
                .None() then self.storage.generic_param_shape_bounds.remove(name),
            };
        };
    };

    nominal_def_id_for_type(self, t: Type): Option[DefId] = {
        return when t in {
            .StructureType(def_id) or .EnumType(def_id) or .OpaqueType(def_id) then .Some(def_id),
            // Identity: the template's DECLARATION, not its spelling.
            .GenericStruct(template_def_id, _) then Option[DefId].Some(template_def_id),
            .GenericEnum(template_def_id, _) then Option[DefId].Some(template_def_id),
            _ then Option[DefId].None(),
        };
    };
};
