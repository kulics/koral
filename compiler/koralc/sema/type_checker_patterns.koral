/// Names in a binding list, de-duplicated and sorted. This is the shape the
/// pattern-binding diagnostics spell them in, and two sorted lists are equal
/// exactly when the name sets behind them are.
file_private let sorted_binding_names(bindings List[Pair[String, Type]]) List[String] = {
    let mutable names = List[String].new();
    let mutable seen = Set[String].new();
    for binding in bindings then {
        if not seen.contains(binding.first) then {
            seen.insert(binding.first);
            names.push(binding.first);
        };
    };
    names.sort();
    return names;
};

file_private let binding_names_equal(left List[String], right List[String]) Bool = {
    if not (left.count() == right.count()) then {
        return false;
    };
    let mutable i UInt = 0;
    while i < left.count() then {
        if not (left[i] == right[i]) then {
            return false;
        };
        i += 1;
    };
    return true;
};

file_private let join_binding_names(names List[String]) String = {
    let mutable out = StringBuilder.new();
    let mutable i UInt = 0;
    while i < names.count() then {
        if i > 0(UInt) then {
            out.push_string(", ");
        };
        out.push_string(names[i]);
        i += 1;
    };
    return out.to_string();
};

given TypeChecker {
    module_private pattern_binding_symbol(
        self,
        name String,
        is_mutable Bool,
        subject_type Type,
        scope Scope,
        span SourceSpan,
    ) Symbol = {
        if name == "_" then {
            let kind = if is_mutable then SymbolKind.Variable(
                VariableKind.MutableValue(),
            ) else SymbolKind.Variable(VariableKind.Value());
            let def_id = self.allocate_unindexed_def_id(name, DefKind.Variable());
            return Symbol(def_id, subject_type, kind);
        };
        return when scope.lookup_local(name) in {
            .Some(existing) then existing,
            .None() then {
                let kind = if is_mutable then SymbolKind.Variable(
                    VariableKind.MutableValue(),
                ) else SymbolKind.Variable(VariableKind.Value());
                let def_id = self.allocate_unindexed_def_id(name, DefKind.Variable());
                let mutable context = self.context();
                context.set_span(def_id, span);
                let sym = Symbol(def_id, subject_type, kind);
                scope.define(self.context(), sym);
                sym
            },
        };
    };

    module_private get_enum_case_tag_index(self, subject_type Type, case_name String) UInt = {
        let zero UInt = 0;
        let inner_type = when subject_type in {
            .ReferenceType(inner) then inner,
            .MutableReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then subject_type,
        };
        return when inner_type in {
            .EnumType(DefId(def_id)) then self.context().enum_case_tag_index_by_raw_id(
                def_id(UInt),
                case_name,
            ),
            // Identity: the template's DECLARATION, not its spelling.
            .GenericEnum(tplDefId, _) then when self.storage.generic_templates.enum_by_def_id(
                tplDefId,
            ) in {
                .Some(enum_template) then self.context().enum_case_tag_index_by_raw_id(
                    enum_template.def_id.id,
                    case_name,
                ),
                .None() then zero,
            },
            _ then zero,
        };
    };

    module_private pattern_match_subject_type(self, subject_type Type) Type = {
        let _ = self;
        return when subject_type in {
            .ReferenceType(inner) then inner,
            .MutableReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then subject_type,
        };
    };

    module_private pattern_requires_raw_subject(self, pattern PatternNode) Bool = {
        return when pattern in {
            .TraitObjectType(_, _) then true,
            .TraitObjectTypeBinding(_, _, _, _) then true,
            .EnumCase(_, elements, _) then {
                for element in elements then {
                    if self.pattern_requires_raw_subject(element.pattern) then {
                        return true;
                    };
                };
                false
            },
            .StructPattern(_, elements, _) then {
                for element in elements then {
                    if self.pattern_requires_raw_subject(element.pattern) then {
                        return true;
                    };
                };
                false
            },
            .AndPattern(left, right, _) then self.pattern_requires_raw_subject(left) or self.pattern_requires_raw_subject(
                right,
            ),
            .OrPattern(left, right, _) then self.pattern_requires_raw_subject(left) or self.pattern_requires_raw_subject(
                right,
            ),
            .NotPattern(inner, _) then self.pattern_requires_raw_subject(inner),
            _ then false,
        };
    };

    module_private resolve_trait_object_pattern_target_type(
        self,
        target_type_node TypeNode,
        subject_type Type,
        span SourceSpan,
    ) Type = {
        let subject_is_mutable = when subject_type in {
            .ReferenceType(inner) then if inner is .TraitObject(_, _) then Option[Bool].Some(
                false,
            ) else Option[Bool].None(),
            .MutableReferenceType(inner) then if inner is .TraitObject(_, _) then Option[Bool].Some(
                true,
            ) else Option[Bool].None(),
            _ then Option[Bool].None(),
        };
        when subject_is_mutable in {
            .None() then {
                self.push_diagnostic_at_span(
                    "Trait object type patterns require a trait object subject, got '\(type_to_string(subject_type))'",
                    span,
                );
                return Type.Unknown();
            },
            _ then {},
        };

        let resolved_target = self.resolve_type(target_type_node);
        return when resolved_target in {
            .ReferenceType(inner) then {
                if self.is_valid_trait_object_pattern_concrete_type(inner) then {
                    return resolved_target;
                };
                self.push_diagnostic_at_span(
                    "Trait object type pattern target must be a concrete nominal type, got '\(type_to_string(inner))'",
                    span,
                );
                Type.Unknown()
            },
            .MutableReferenceType(inner) then {
                if subject_is_mutable is .Some(false) then {
                    self.push_diagnostic_at_span(
                        "Trait object type pattern '\(type_to_string(resolved_target))' requires a mutable trait object subject",
                        span,
                    );
                    return Type.Unknown();
                };
                if self.is_valid_trait_object_pattern_concrete_type(inner) then {
                    return resolved_target;
                };
                self.push_diagnostic_at_span(
                    "Trait object type pattern target must be a concrete nominal type, got '\(type_to_string(inner))'",
                    span,
                );
                Type.Unknown()
            },
            .StructureType(_) or .EnumType(_) or .OpaqueType(_) or .GenericStruct(_, _) or .GenericEnum(_, _) then {
                if self.is_valid_trait_object_pattern_concrete_type(resolved_target) then {
                    return resolved_target;
                };
                self.push_diagnostic_at_span(
                    "Trait object type pattern target must be a concrete nominal type, got '\(type_to_string(resolved_target))'",
                    span,
                );
                Type.Unknown()
            },
            _ then {
                self.push_diagnostic_at_span(
                    "Trait object type pattern must be a concrete type name or a trait name, got '\(type_to_string(resolved_target))'",
                    span,
                );
                Type.Unknown()
            },
        };
    };

    module_private is_valid_trait_object_pattern_concrete_type(self, t Type) Bool = {
        let _ = self;
        return when t in {
            .StructureType(_) then true,
            .EnumType(_) then true,
            .OpaqueType(_) then true,
            .GenericStruct(_, _) then true,
            .GenericEnum(_, _) then true,
            _ then false,
        };
    };

    /// A string literal pattern only matches std's `String`.
    ///
    /// The subject's DECLARATION identity decides, never its spelling -- a user
    /// type is not a string pattern however it is named. Without this check the
    /// pattern was lowered unconditionally and monomorphization then emitted C
    /// for a `String`-shaped access against the user's layout.
    module_private lower_string_literal_pattern(
        self,
        value String,
        subject_type Type,
        span SourceSpan,
    ) TypedPattern = {
        let matched_type = self.pattern_match_subject_type(subject_type);
        if not self.is_string_type(matched_type) then {
            self.push_diagnostic_at_span(
                "Type mismatch: expected String, got \(self.display_type_name(matched_type))",
                span,
            );
        };
        return TypedPattern.StringLiteral(value);
    };

    module_private lower_rune_literal_pattern(
        self,
        value String,
        subject_type Type,
        span SourceSpan,
    ) TypedPattern = {
        let matched_type = self.pattern_match_subject_type(subject_type);
        let rune_count = value.to_runes().count();
        if rune_count == 0(UInt) then {
            self.push_diagnostic_at_span("Rune literal cannot be empty", span);
            return TypedPattern.IntegerLiteral("0");
        };
        if rune_count <> 1(UInt) then {
            self.push_diagnostic_at_span(
                "Rune literal must contain exactly one Unicode code point, but '\(value)' contains \(rune_count.to_string())'",
                span,
            );
            return TypedPattern.IntegerLiteral("0");
        };

        let scalar_value = self.rune_literal_scalar_value(value);
        if self.is_rune_type(matched_type) then {
            return TypedPattern.IntegerLiteral(scalar_value);
        };
        if matched_type is .UInt8Type() then {
            let bytes = value.to_bytes();
            if bytes.count() == 1(UInt) and bytes[0(UInt)] <= 127(UInt8) then {
                return TypedPattern.IntegerLiteral(scalar_value);
            };
            self.push_diagnostic_at_span(
                "Rune literal pattern must be a single ASCII character when matching UInt8",
                span,
            );
            return TypedPattern.IntegerLiteral("0");
        };

        self.push_diagnostic_at_span(
            "Type mismatch: expected Rune or UInt8, got \(type_to_string(matched_type))",
            span,
        );
        return TypedPattern.IntegerLiteral("0");
    };

    /// Whether a pattern TESTS the shape of its subject, as opposed to simply
    /// binding whatever is there. A weak reference is opaque until `upgrade`d --
    /// it carries no fields, no cases and no payload -- so testing one's shape
    /// is not meaningful. Binding the handle whole is fine.
    file_private pattern_tests_subject_shape(self, pattern PatternNode) Bool = {
        let _ = self;
        return when pattern in {
            .Variable(_, _, _) then false,
            .Wildcard(_) then false,
            _ then true,
        };
    };

    file_private is_weak_reference_type(self, t Type) Bool = {
        let _ = self;
        return when t in {
            .WeakReferenceType(_) then true,
            .MutableWeakReferenceType(_) then true,
            _ then false,
        };
    };

    module_private lower_typed_pattern(
        self,
        pattern PatternNode,
        subject_type Type,
        scope Scope,
    ) TypedPattern = {
        if self.pattern_tests_subject_shape(pattern) and self.is_weak_reference_type(subject_type) then {
            self.push_diagnostic_at_span(
                "Cannot match a pattern against a weak reference: upgrade it first",
                pattern_span(pattern),
            );
            // Keep lowering the pattern the caller wrote: substituting a
            // wildcard here would make a later arm look like a duplicate of it
            // and pile diagnostics on top of the real one.
        };
        return when pattern in {
            .Wildcard(_) then TypedPattern.Wildcard(),
            .Variable(name, is_mutable, span) then {
                let symbol = self.pattern_binding_symbol(
                    name,
                    is_mutable,
                    subject_type,
                    scope,
                    span,
                );
                TypedPattern.Variable(symbol)
            },
            .TraitObjectType(target_type, span) then TypedPattern.TraitObjectType(
                self.resolve_trait_object_pattern_target_type(
                    target_type,
                    subject_type,
                    span,
                ),
            ),
            .TraitObjectTypeBinding(name, is_mutable, target_type, span) then {
                let bound_type = self.resolve_trait_object_pattern_target_type(
                    target_type,
                    subject_type,
                    span,
                );
                let symbol = self.pattern_binding_symbol(
                    name,
                    is_mutable,
                    bound_type,
                    scope,
                    span,
                );
                TypedPattern.TraitObjectTypeBinding(symbol, bound_type)
            },
            .BoolLiteral(value, _) then TypedPattern.BoolLiteral(value),
            .IntegerLiteral(value, _) then TypedPattern.IntegerLiteral(value),
            .NegativeIntegerLiteral(value, _) then TypedPattern.NegativeIntegerLiteral(
                value,
            ),
            .StringLiteral(value, span) then self.lower_string_literal_pattern(
                value,
                subject_type,
                span,
            ),
            .RuneLiteral(value, span) then self.lower_rune_literal_pattern(
                value,
                subject_type,
                span,
            ),
            .ComparisonPattern(op, value, _) then TypedPattern.ComparisonPattern(
                op,
                value,
            ),
            .AndPattern(left, right, _) then {
                TypedPattern.AndPattern(
                    self.lower_typed_pattern(left, subject_type, scope),
                    self.lower_typed_pattern(right, subject_type, scope),
                )
            },
            .OrPattern(left, right, _) then {
                TypedPattern.OrPattern(
                    self.lower_typed_pattern(left, subject_type, scope),
                    self.lower_typed_pattern(right, subject_type, scope),
                )
            },
            .NotPattern(inner, _) then {
                TypedPattern.NotPattern(
                    self.lower_typed_pattern(inner, subject_type, scope),
                )
            },
            .EnumCase(case_name, elements, span) then {
                // When subject is a struct type, redirect .StructName(...) to StructPattern
                let pattern_def_id = self.struct_pattern_def_id(case_name);
                let struct_param_specs = self.get_struct_pattern_param_specs(
                    subject_type,
                    pattern_def_id,
                );
                if not struct_param_specs.is_empty() then {
                    let mutable ordered_elements = List[PatternElement].new();
                    when self.order_pattern_arguments(
                        elements,
                        struct_param_specs,
                        case_name,
                        span,
                    ) in {
                        .Some(ordered) then {
                            for elem in ordered then {
                                ordered_elements.push(elem);
                            };
                        },
                        .None() then { return TypedPattern.Wildcard(); },
                    };
                    let field_types = self.get_struct_pattern_field_types(
                        subject_type,
                        pattern_def_id,
                    );
                    let mutable typed_elements = List[TypedPatternElement].new();
                    let mutable i UInt = 0;
                    for elem in ordered_elements then {
                        let mutable field_type = when field_types.get(i) in {
                            .Some(t) then t,
                            .None() then Type.Unknown(),
                        };
                        typed_elements.push(
                            TypedPatternElement(
                                elem.label,
                                self.lower_typed_pattern(elem.pattern, field_type, scope),
                            ),
                        );
                        i += 1;
                    };
                    TypedPattern.StructPattern(case_name, typed_elements)
                } else {
                    let param_specs = self.get_enum_case_param_specs(
                        subject_type,
                        case_name,
                    );
                    let mutable ordered_elements = List[PatternElement].new();
                    when self.order_pattern_arguments(
                        elements,
                        param_specs,
                        ".\(case_name)",
                        span,
                    ) in {
                        .Some(ordered) then {
                            for elem in ordered then {
                                ordered_elements.push(elem);
                            };
                        },
                        .None() then { return TypedPattern.Wildcard(); },
                    };
                    let case_field_types = self.get_enum_case_field_types(
                        subject_type,
                        case_name,
                    );
                    let tag_index = self.get_enum_case_tag_index(subject_type, case_name);
                    let mutable typed_elements = List[TypedPatternElement].new();
                    let mutable i UInt = 0;
                    for elem in ordered_elements then {
                        let mutable field_type = when case_field_types.get(i) in {
                            .Some(t) then t,
                            .None() then Type.Unknown(),
                        };
                        typed_elements.push(
                            TypedPatternElement(
                                elem.label,
                                self.lower_typed_pattern(elem.pattern, field_type, scope),
                            ),
                        );
                        i += 1;
                    };
                    TypedPattern.EnumCase(case_name, tag_index, typed_elements)
                }
            },
            .StructPattern(type_name, elements, span) then {
                let pattern_def_id = self.struct_pattern_def_id(type_name);
                let param_specs = self.get_struct_pattern_param_specs(
                    subject_type,
                    pattern_def_id,
                );
                let mutable ordered_elements = List[PatternElement].new();
                when self.order_pattern_arguments(
                    elements,
                    param_specs,
                    type_name,
                    span,
                ) in {
                    .Some(ordered) then {
                        for elem in ordered then {
                            ordered_elements.push(elem);
                        };
                    },
                    .None() then { return TypedPattern.Wildcard(); },
                };
                let field_types = self.get_struct_pattern_field_types(
                    subject_type,
                    pattern_def_id,
                );
                let mutable typed_elements = List[TypedPatternElement].new();
                let mutable i UInt = 0;
                for elem in ordered_elements then {
                    let mutable field_type = when field_types.get(i) in {
                        .Some(t) then t,
                        .None() then Type.Unknown(),
                    };
                    typed_elements.push(
                        TypedPatternElement(
                            elem.label,
                            self.lower_typed_pattern(elem.pattern, field_type, scope),
                        ),
                    );
                    i += 1;
                };
                TypedPattern.StructPattern(type_name, typed_elements)
            },
            // `(a, b, c)` -- positional destructuring of a struct with exactly
            // that many fields. The SUBJECT decides which struct this is, so no
            // name is written and none is looked up: identity comes from the
            // type being matched, never from a spelling.
            .TuplePattern(elements, span) then {
                let inner_type = when subject_type in {
                    .ReferenceType(inner) then inner,
                    .MutableReferenceType(inner) then inner,
                    .BorrowedReferenceType(inner) then inner,
                    .MutableBorrowedReferenceType(inner) then inner,
                    .WeakReferenceType(inner) then inner,
                    .MutableWeakReferenceType(inner) then inner,
                    _ then subject_type,
                };
                let pattern_def_id = when inner_type in {
                    .StructureType(def_id) then self.struct_pattern_decl_def_id(def_id),
                    .GenericStruct(template_def_id, _) then self.struct_pattern_decl_def_id(
                        template_def_id,
                    ),
                    _ then def_id_invalid(),
                };
                if pattern_def_id == def_id_invalid() then {
                    self.push_diagnostic_at_span(
                        "Type mismatch: expected a struct, got \(type_to_string(inner_type))",
                        span,
                    );
                    return TypedPattern.Wildcard();
                };
                let param_specs = self.get_struct_pattern_param_specs(
                    subject_type,
                    pattern_def_id,
                );
                if elements.count() <> param_specs.count() then {
                    self.push_diagnostic_at_span(
                        "Type mismatch: expected \(param_specs.count()) pattern elements, got \(elements.count())",
                        span,
                    );
                    return TypedPattern.Wildcard();
                };
                for elem in elements then {
                    if elem.label is .Some(label) then {
                        self.push_diagnostic_at_span(
                            "Type mismatch: tuple destructuring is positional, got a named element '\(label)'",
                            span,
                        );
                        return TypedPattern.Wildcard();
                    };
                };
                let mutable binds = List[Bool].new();
                let mutable slot_spans = List[SourceSpan].new();
                for elem in elements then {
                    binds.push(not (elem.pattern is .Wildcard(_)));
                    slot_spans.push(pattern_span(elem.pattern));
                };
                // Keep lowering the pattern the caller wrote even when this
                // rejects it: substituting a wildcard would make the arm look
                // like a duplicate of some other `_` and pile a second
                // diagnostic on top of the real one.
                let _ = self.check_positional_destructuring(
                    self.get_struct_pattern_fields(subject_type, pattern_def_id),
                    self.get_struct_pattern_owner_def_id(subject_type, pattern_def_id),
                    type_to_string(inner_type),
                    binds,
                    slot_spans,
                    span,
                );
                let field_types = self.get_struct_pattern_field_types(
                    subject_type,
                    pattern_def_id,
                );
                let mutable typed_elements = List[TypedPatternElement].new();
                let mutable i UInt = 0;
                for elem in elements then {
                    let field_type = when field_types.get(i) in {
                        .Some(t) then t,
                        .None() then Type.Unknown(),
                    };
                    typed_elements.push(
                        TypedPatternElement(
                            Option[String].None(),
                            self.lower_typed_pattern(elem.pattern, field_type, scope),
                        ),
                    );
                    i += 1;
                };
                // The name here is display-only (exhaustiveness messages); the
                // match itself is against the subject's declaration identity.
                TypedPattern.StructPattern(
                    self.context().type_display_name(inner_type),
                    typed_elements,
                )
            },
        };
    };

    /// Define a pattern's bindings in `scope` and report, per name, the type it
    /// was bound at.
    ///
    /// The type list is what makes the `or` / `and` / `not` rules checkable:
    /// each branch still has its own payload types here, whereas by the time the
    /// pattern is lowered an `or`'s branches already share one symbol per name.
    module_private bind_pattern_vars(
        self,
        pattern PatternNode,
        subject_type Type,
        scope Scope,
    ) List[Pair[String, Type]] = {
        let mutable bound = List[Pair[String, Type]].new();
        when pattern in {
            .Variable(name, is_mutable, span) then {
                if not (name == "_") then {
                    let kind = if is_mutable then SymbolKind.Variable(
                        VariableKind.MutableValue(),
                    ) else SymbolKind.Variable(VariableKind.Value());
                    let def_id = self.allocate_unindexed_def_id(name, DefKind.Variable());
                    let mutable context = self.context();
                    context.set_span(def_id, span);
                    scope.define(self.context(), Symbol(def_id, subject_type, kind));
                    bound.push(Pair[String, Type](name, subject_type));
                };
            },
            .TraitObjectTypeBinding(name, is_mutable, target_type, span) then {
                if not (name == "_") then {
                    let kind = if is_mutable then SymbolKind.Variable(
                        VariableKind.MutableValue(),
                    ) else SymbolKind.Variable(VariableKind.Value());
                    let def_id = self.allocate_unindexed_def_id(name, DefKind.Variable());
                    let mutable context = self.context();
                    context.set_span(def_id, span);
                    let mutable bound_type = self.resolve_trait_object_pattern_target_type(
                        target_type,
                        subject_type,
                        span,
                    );
                    scope.define(self.context(), Symbol(def_id, bound_type, kind));
                    bound.push(Pair[String, Type](name, bound_type));
                };
            },
            .EnumCase(case_name, elements, span) then {
                let param_specs = self.get_enum_case_param_specs(subject_type, case_name);
                when self.order_pattern_arguments(
                    elements,
                    param_specs,
                    ".\(case_name)",
                    span,
                ) in {
                    .Some(ordered_elements) then {
                        let case_field_types = self.get_enum_case_field_types(
                            subject_type,
                            case_name,
                        );
                        let mutable i UInt = 0;
                        for elem in ordered_elements then {
                            let mutable field_type = when case_field_types.get(i) in {
                                .Some(t) then t,
                                .None() then Type.Unknown(),
                            };
                            for b in self.bind_pattern_vars(elem.pattern, field_type, scope) then {
                                bound.push(b);
                            };
                            i += 1;
                        };
                    },
                    // The argument shape is already rejected. Bind what is
                    // written anyway so the arm body still has its names --
                    // otherwise every one of them reads as undefined and piles
                    // on top of the real diagnostic.
                    .None() then {
                        for elem in elements then {
                            for b in self.bind_pattern_vars(
                                elem.pattern,
                                Type.Unknown(),
                                scope,
                            ) then {
                                bound.push(b);
                            };
                        };
                    },
                };
            },
            .StructPattern(type_name, elements, span) then {
                let pattern_def_id = self.struct_pattern_def_id(type_name);
                let param_specs = self.get_struct_pattern_param_specs(
                    subject_type,
                    pattern_def_id,
                );
                let mutable ordered_elements = List[PatternElement].new();
                let mutable args_ok = true;
                when self.order_pattern_arguments(
                    elements,
                    param_specs,
                    type_name,
                    span,
                ) in {
                    .Some(ordered) then {
                        for elem in ordered then {
                            ordered_elements.push(elem);
                        };
                    },
                    // The argument shape is already rejected. Bind what is
                    // written anyway so the arm body still has its names --
                    // otherwise every one of them reads as undefined and piles
                    // on top of the real diagnostic.
                    .None() then {
                        args_ok = false;
                        for elem in elements then {
                            ordered_elements.push(elem);
                        };
                    },
                };
                let field_types = self.get_struct_pattern_field_types(
                    subject_type,
                    pattern_def_id,
                );
                let mutable i UInt = 0;
                for elem in ordered_elements then {
                    // An unordered fallback has no field to point at, so the
                    // name is bound at `Unknown` rather than at a neighbour's
                    // field type.
                    let mutable field_type = when field_types.get(i) in {
                        .Some(t) then if args_ok then t else Type.Unknown(),
                        .None() then Type.Unknown(),
                    };
                    for b in self.bind_pattern_vars(elem.pattern, field_type, scope) then {
                        bound.push(b);
                    };
                    i += 1;
                };
            },
            // `(a, b, c)` -- positional destructuring. The subject decides
            // which struct this is; identity comes from the type being matched.
            .TuplePattern(elements, _) then {
                let inner_type = when subject_type in {
                    .ReferenceType(inner) then inner,
                    .MutableReferenceType(inner) then inner,
                    .BorrowedReferenceType(inner) then inner,
                    .MutableBorrowedReferenceType(inner) then inner,
                    .WeakReferenceType(inner) then inner,
                    .MutableWeakReferenceType(inner) then inner,
                    _ then subject_type,
                };
                let pattern_def_id = when inner_type in {
                    .StructureType(def_id) then self.struct_pattern_decl_def_id(def_id),
                    .GenericStruct(template_def_id, _) then self.struct_pattern_decl_def_id(
                        template_def_id,
                    ),
                    _ then def_id_invalid(),
                };
                let field_types = self.get_struct_pattern_field_types(
                    subject_type,
                    pattern_def_id,
                );
                let mutable i UInt = 0;
                for elem in elements then {
                    let field_type = when field_types.get(i) in {
                        .Some(t) then t,
                        .None() then Type.Unknown(),
                    };
                    for b in self.bind_pattern_vars(elem.pattern, field_type, scope) then {
                        bound.push(b);
                    };
                    i += 1;
                };
            },
            // `and` runs both sides, so a name cannot be bound by both: there
            // would be two values for one binding.
            .AndPattern(left, right, span) then {
                let left_bound = self.bind_pattern_vars(left, subject_type, scope);
                let right_bound = self.bind_pattern_vars(right, subject_type, scope);
                let left_names = sorted_binding_names(left_bound);
                let right_names = sorted_binding_names(right_bound);
                let mutable shared = List[String].new();
                for name in left_names then {
                    for other in right_names then {
                        if name == other then {
                            shared.push(name);
                        };
                    };
                };
                if not shared.is_empty() then {
                    self.push_diagnostic_at_span(
                        "And pattern cannot bind the same variable in both branches: \(join_binding_names(shared))",
                        span,
                    );
                };
                for b in left_bound then {
                    bound.push(b);
                };
                for b in right_bound then {
                    bound.push(b);
                };
            },
            // `or` matches one side or the other, so both sides must offer the
            // same names, and each name must mean the same type on both sides.
            // The right side is bound into a throw-away scope: it must NOT
            // contribute symbols, or it would shadow the left side's and the two
            // branches would stop sharing one binding per name.
            .OrPattern(left, right, span) then {
                let left_bound = self.bind_pattern_vars(left, subject_type, scope);
                let right_bound = self.bind_pattern_vars(
                    right,
                    subject_type,
                    Scope.new_child(scope),
                );
                let left_names = sorted_binding_names(left_bound);
                let right_names = sorted_binding_names(right_bound);
                if binding_names_equal(left_names, right_names) then {
                    let mutable right_type_by_name = Dict[String, Type].new();
                    for b in right_bound then {
                        right_type_by_name.insert(b.first, b.second);
                    };
                    let mutable mismatch = Option[Pair[String, String]].None();
                    for b in left_bound then {
                        if mismatch is .None() then {
                            when right_type_by_name.get(b.first) in {
                                .Some(right_type) then {
                                    if not (
                                        stable_type_key(b.second) == stable_type_key(
                                            right_type,
                                        )
                                    ) then {
                                        mismatch = Option[Pair[String, String]].Some(
                                            Pair[String, String](
                                                self.display_type_name(b.second),
                                                self.display_type_name(right_type),
                                            ),
                                        );
                                    };
                                },
                                .None() then {},
                            };
                        };
                    };
                    when mismatch in {
                        .Some(found) then self.push_diagnostic_at_span(
                            "Type mismatch: expected \(found.first), got \(found.second)",
                            span,
                        ),
                        .None() then {},
                    };
                } else {
                    self.push_diagnostic_at_span(
                        "Or pattern branches must bind the same variables. Left binds: {\(join_binding_names(left_names))}, Right binds: {\(join_binding_names(right_names))}",
                        span,
                    );
                };
                for b in left_bound then {
                    bound.push(b);
                };
            },
            // A `not` pattern matches by the ABSENCE of a shape, so nothing is
            // extracted for it to bind.
            .NotPattern(inner, span) then {
                let inner_bound = self.bind_pattern_vars(
                    inner,
                    subject_type,
                    Scope.new_child(scope),
                );
                if not inner_bound.is_empty() then {
                    self.push_diagnostic_at_span(
                        "Not pattern cannot contain variable bindings",
                        span,
                    );
                };
            },
            _ then {},
        };
        return bound;
    };

    module_private ensure_pattern_bindings_present(
        self,
        pattern PatternNode,
        subject_type Type,
        scope Scope,
    ) Void = {
        when pattern in {
            .Variable(name, is_mutable, span) then {
                if not (name == "_") then {
                    if scope.lookup_local(name) is .None() then {
                        let kind = if is_mutable then SymbolKind.Variable(
                            VariableKind.MutableValue(),
                        ) else SymbolKind.Variable(VariableKind.Value());
                        let def_id = self.allocate_unindexed_def_id(
                            name,
                            DefKind.Variable(),
                        );
                        let mutable context = self.context();
                        context.set_span(def_id, span);
                        scope.define(self.context(), Symbol(def_id, subject_type, kind));
                    };
                };
            },
            .TraitObjectTypeBinding(name, is_mutable, target_type, span) then {
                if not (name == "_") then {
                    if scope.lookup_local(name) is .None() then {
                        let kind = if is_mutable then SymbolKind.Variable(
                            VariableKind.MutableValue(),
                        ) else SymbolKind.Variable(VariableKind.Value());
                        let def_id = self.allocate_unindexed_def_id(
                            name,
                            DefKind.Variable(),
                        );
                        let mutable context = self.context();
                        context.set_span(def_id, span);
                        let mutable bound_type = self.resolve_trait_object_pattern_target_type(
                            target_type,
                            subject_type,
                            span,
                        );
                        scope.define(self.context(), Symbol(def_id, bound_type, kind));
                    };
                };
            },
            .EnumCase(case_name, elements, span) then {
                let param_specs = self.get_enum_case_param_specs(subject_type, case_name);
                when self.order_pattern_arguments(
                    elements,
                    param_specs,
                    ".\(case_name)",
                    span,
                ) in {
                    .Some(ordered_elements) then {
                        let case_field_types = self.get_enum_case_field_types(
                            subject_type,
                            case_name,
                        );
                        let mutable i UInt = 0;
                        for elem in ordered_elements then {
                            let mutable field_type = when case_field_types.get(i) in {
                                .Some(t) then t,
                                .None() then Type.Unknown(),
                            };
                            self.ensure_pattern_bindings_present(elem.pattern, field_type, scope);
                            i += 1;
                        };
                    },
                    .None() then {},
                };
            },
            .StructPattern(type_name, elements, span) then {
                let pattern_def_id = self.struct_pattern_def_id(type_name);
                let param_specs = self.get_struct_pattern_param_specs(
                    subject_type,
                    pattern_def_id,
                );
                let mutable ordered_elements = List[PatternElement].new();
                when self.order_pattern_arguments(
                    elements,
                    param_specs,
                    type_name,
                    span,
                ) in {
                    .Some(ordered) then {
                        for elem in ordered then {
                            ordered_elements.push(elem);
                        };
                    },
                    .None() then { return; },
                };
                if not self.check_struct_pattern_field_visibility(
                    subject_type,
                    pattern_def_id,
                    type_name,
                    ordered_elements,
                ) then {
                    return;
                };
                let field_types = self.get_struct_pattern_field_types(
                    subject_type,
                    pattern_def_id,
                );
                let mutable i UInt = 0;
                for elem in ordered_elements then {
                    let mutable field_type = when field_types.get(i) in {
                        .Some(t) then t,
                        .None() then Type.Unknown(),
                    };
                    self.ensure_pattern_bindings_present(elem.pattern, field_type, scope);
                    i += 1;
                };
            },
            .AndPattern(left, right, span) then {
                self.ensure_pattern_bindings_present(left, subject_type, scope);
                self.ensure_pattern_bindings_present(right, subject_type, scope);
            },
            .OrPattern(left, right, span) then {
                self.ensure_pattern_bindings_present(left, subject_type, scope);
            },
            .NotPattern(inner, span) then {
                self.ensure_pattern_bindings_present(inner, subject_type, scope);
            },
            _ then {},
        };
    };

    /// Pattern arguments follow the call rules exactly -- same shape, same
    /// reason: the DECLARATION decides whether a name is written at the use
    /// site, and the use site does not get to disagree.
    ///
    ///   - a labeled argument names a field, which must be declared NAMED, and
    ///     may do so at most once;
    ///   - an unlabeled argument fills the next field NOT declared named, in
    ///     declaration order, and may not appear after a labeled one;
    ///   - every field is matched exactly once -- a pattern has no defaults.
    ///
    /// The result is one argument per field, in DECLARATION ORDER. `.None()`
    /// means the pattern is not a legal match and a diagnostic has been pushed.
    module_private order_pattern_arguments(
        self,
        elements List[PatternElement],
        param_specs List[FunctionParamSpec],
        pattern_description String,
        span SourceSpan,
    ) Option[List[PatternElement]] = {
        // No registered fields means the subject is not the constructor this
        // pattern names. That is a type error, reported by the type check --
        // saying anything about the arguments here would name the wrong fault.
        if param_specs.is_empty() then {
            return Option[List[PatternElement]].Some(elements);
        };
        let mutable ordered = List[Option[PatternElement]].new();
        for _ in param_specs then {
            ordered.push(Option[PatternElement].None());
        };
        let mutable positional_index UInt = 0;
        let mutable seen_named = false;
        for element in elements then {
            let arg_span = pattern_span(element.pattern);
            when element.label in {
                .Some(label) then {
                    seen_named = true;
                    let mutable field_index UInt = 0;
                    let mutable found = false;
                    while field_index < param_specs.count() then {
                        if param_specs[field_index].name == label then {
                            found = true;
                            break;
                        };
                        field_index += 1;
                    };
                    if not found then {
                        self.push_diagnostic_at_span(
                            "Unknown pattern label '\(label)' for '\(pattern_description)'",
                            arg_span,
                        );
                        return Option[List[PatternElement]].None();
                    };
                    if not param_specs[field_index].named then {
                        self.push_diagnostic_at_span(
                            "Field '\(label)' is positional and cannot be matched by label",
                            arg_span,
                        );
                        return Option[List[PatternElement]].None();
                    };
                    if ordered[field_index] is .Some(_) then {
                        self.push_diagnostic_at_span(
                            "Duplicate pattern label '\(label)'",
                            arg_span,
                        );
                        return Option[List[PatternElement]].None();
                    };
                    ordered[field_index] = Option[PatternElement].Some(element);
                },
                .None() then {
                    if seen_named then {
                        self.push_diagnostic_at_span(
                            "Positional pattern cannot appear after named pattern in '\(pattern_description)'",
                            arg_span,
                        );
                        return Option[List[PatternElement]].None();
                    };
                    while positional_index < param_specs.count() and param_specs[
                        positional_index
                    ].named then {
                        positional_index += 1;
                    };
                    if positional_index >= param_specs.count() then {
                        let mutable required_index UInt = 0;
                        let mutable reported = false;
                        while required_index < param_specs.count() then {
                            if param_specs[required_index].named and ordered[
                                required_index
                            ] is .None() then {
                                self.push_diagnostic_at_span(
                                    "Named pattern field '\(param_specs[required_index].name)' must be matched by label",
                                    span,
                                );
                                reported = true;
                                break;
                            };
                            required_index += 1;
                        };
                        if not reported then {
                            self.push_diagnostic_at_span(
                                "Too many positional pattern arguments for '\(pattern_description)'",
                                arg_span,
                            );
                        };
                        return Option[List[PatternElement]].None();
                    };
                    ordered[positional_index] = Option[PatternElement].Some(element);
                    positional_index += 1;
                },
            };
        };

        let mutable elements_out = List[PatternElement].new();
        let mutable index UInt = 0;
        while index < param_specs.count() then {
            when ordered[index] in {
                .Some(element) then elements_out.push(element),
                .None() then {
                    self.push_diagnostic_at_span(
                        "Missing pattern field '\(param_specs[index].name)' in '\(pattern_description)'",
                        span,
                    );
                    return Option[List[PatternElement]].None();
                },
            };
            index += 1;
        };
        return Option[List[PatternElement]].Some(elements_out);
    };

    module_private enum_case_name_matches(
        self,
        pattern_case_name String,
        enum_case_name String,
    ) Bool = {
        if enum_case_name == pattern_case_name then {
            return true;
        };
        if enum_case_name.ends_with("_" + pattern_case_name) then {
            return true;
        };

        let pattern_tail = when pattern_case_name.split_last_once(".") in {
            .Some(parts) then parts.second,
            .None() then pattern_case_name,
        };
        if enum_case_name == pattern_tail then {
            return true;
        };
        if enum_case_name.ends_with("_" + pattern_tail) then {
            return true;
        };

        let enum_tail = when enum_case_name.split_last_once("_") in {
            .Some(parts) then parts.second,
            .None() then enum_case_name,
        };
        return enum_tail == pattern_tail;
    };

    module_private get_enum_case_field_types(
        self,
        subject_type Type,
        case_name String,
    ) List[Type] = {
        let inner_type = when subject_type in {
            .ReferenceType(inner) then inner,
            .MutableReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then subject_type,
        };
        let raw_case_params = when inner_type in {
            .EnumType(DefId(def_id)) then self.context().enum_case_params_by_raw_id(
                def_id(UInt),
                case_name,
            ),
            // Identity: the template's DECLARATION, not its spelling.
            .GenericEnum(template_def_id, _) then when self.storage.generic_templates.enum_by_def_id(
                template_def_id,
            ) in {
                .Some(enum_template) then self.context().enum_case_params_by_raw_id(
                    enum_template.def_id.id,
                    case_name,
                ),
                .None() then List[EnumCaseParam].new(),
            },
            _ then List[EnumCaseParam].new(),
        };
        let mutable bindings = Dict[String, Type].new();
        when inner_type in {
            .GenericEnum(template_def_id, args) then {
                if self.storage.generic_templates.enum_by_def_id(template_def_id) is .Some(enum_template) then {
                    let mutable i UInt = 0;
                    let param_count = enum_template.type_parameters.count();
                    let arg_count = args.count();
                    let n = if param_count < arg_count then param_count else arg_count;
                    while i < n then {
                        let tp = enum_template.type_parameters[i];
                        bindings.insert(tp.name, (args[i]));
                        i += 1;
                    };
                };
            },
            _ then {},
        };
        let mutable result = List[Type].new();
        for p in raw_case_params then {
            let mutable concrete_param_type = self.apply_type_bindings(
                p.param_type,
                bindings,
            );
            result.push(concrete_param_type);
        };
        return result;
    };

    module_private get_enum_case_param_specs(
        self,
        subject_type Type,
        case_name String,
    ) List[FunctionParamSpec] = {
        let inner_type = when subject_type in {
            .ReferenceType(inner) then inner,
            .MutableReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then subject_type,
        };
        return when inner_type in {
            .EnumType(DefId(def_id)) then self.context().enum_case_param_specs_by_raw_id(
                def_id(UInt),
                case_name,
            ),
            // Identity: the template's DECLARATION, not its spelling.
            .GenericEnum(template_def_id, _) then when self.storage.generic_templates.enum_by_def_id(
                template_def_id,
            ) in {
                .Some(enum_template) then self.context().enum_case_param_specs_by_raw_id(
                    enum_template.def_id.id,
                    case_name,
                ),
                .None() then List[FunctionParamSpec].new(),
            },
            _ then List[FunctionParamSpec].new(),
        };
    };

    /// The DECLARATION a struct pattern names, resolved once from its source
    /// spelling through this module's imports. Everything below compares this
    /// DefId; the spelling survives only to print diagnostics.
    module_private struct_pattern_def_id(self, type_name String) DefId = {
        when self.resolve_type_name_binding(type_name) in {
            .Some(t) then {
                let declared = self.nominal_decl_def_id(t);
                if declared <> def_id_invalid() then {
                    return declared;
                };
            },
            .None() then {},
        };
        // A generic template is registered in the template registry rather than
        // the type table, so the one lookup consults whichever answers.
        return when self.storage.generic_templates.lookup_struct(type_name) in {
            .Some(struct_template) then struct_template.def_id,
            .None() then def_id_invalid(),
        };
    };

    /// The declaration a resolved nominal type stands for. Builtins and type
    /// parameters have none, so they report the invalid DefId.
    module_private nominal_decl_def_id(self, t Type) DefId = {
        return when t in {
            .StructureType(def_id) then def_id,
            .EnumType(def_id) then def_id,
            .GenericStruct(template_def_id, _) then template_def_id,
            .GenericEnum(template_def_id, _) then template_def_id,
            .TraitObject(trait_def_id, _) then trait_def_id,
            _ then def_id_invalid(),
        };
    };

    /// The declaration a `Type.StructureType` stands for: the template it was
    /// instantiated from, or the struct itself when it was never generic.
    module_private struct_pattern_decl_def_id(self, def_id DefId) DefId = {
        let template_def_id = self.context().get_template_def_id(def_id);
        if template_def_id == def_id_invalid() then def_id else template_def_id
    };

    module_private get_struct_pattern_field_types(
        self,
        subject_type Type,
        pattern_def_id DefId,
    ) List[Type] = {
        let inner_type = when subject_type in {
            .ReferenceType(inner) then inner,
            .MutableReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then subject_type,
        };

        return when inner_type in {
            .StructureType(def_id) then {
                let mutable result = List[Type].new();
                if self.struct_pattern_decl_def_id(def_id) == pattern_def_id then {
                    let template_name_opt = self.context().get_template_name(def_id);
                    let type_args_opt = self.context().get_type_arguments(def_id);
                    when template_name_opt in {
                        .Some(template_name) then when type_args_opt in {
                            .Some(type_args) then when self.storage.generic_templates.lookup_struct(
                                template_name,
                            ) in {
                                .Some(struct_template) then when self.context().get_struct_fields(
                                    struct_template.def_id,
                                ) in {
                                    .Some(fields) then {
                                        let mutable bindings = Dict[String, Type].new();
                                        let mutable i UInt = 0;
                                        let param_count = struct_template.type_parameters.count(
                                        );
                                        let arg_count = type_args.count();
                                        let n = if param_count < arg_count then param_count
                                        else arg_count;
                                        while i < n then {
                                            let tp = struct_template.type_parameters[i];
                                            bindings.insert(tp.name, type_args[i]);
                                            i += 1;
                                        };
                                        for field in fields then {
                                            result.push(
                                                self.apply_type_bindings(
                                                    field.field_type,
                                                    bindings,
                                                ),
                                            );
                                        };
                                    },
                                    .None() then {},
                                },
                                .None() then {},
                            },
                            .None() then when self.context().get_struct_fields(def_id) in {
                                .Some(fields) then {
                                    for field in fields then {
                                        result.push(field.field_type);
                                    };
                                },
                                .None() then {},
                            },
                        },
                        .None() then when self.context().get_struct_fields(def_id) in {
                            .Some(fields) then {
                                for field in fields then {
                                    result.push(field.field_type);
                                };
                            },
                            .None() then {},
                        },
                    }
                };
                result
            },
            // Identity: the template's DECLARATION.
            .GenericStruct(template_def_id, args) then {
                let mutable result = List[Type].new();
                if template_def_id == pattern_def_id then {
                    when self.storage.generic_templates.struct_by_def_id(
                        template_def_id,
                    ) in {
                        .Some(struct_template) then when self.context().get_struct_fields(
                            struct_template.def_id,
                        ) in {
                            .Some(fields) then {
                                let mutable bindings = Dict[String, Type].new();
                                let mutable i UInt = 0;
                                let param_count = struct_template.type_parameters.count();
                                let arg_count = args.count();
                                let n = if param_count < arg_count then param_count
                                else arg_count;
                                while i < n then {
                                    let tp = struct_template.type_parameters[i];
                                    bindings.insert(tp.name, (args[i]));
                                    i += 1;
                                };
                                for field in fields then {
                                    result.push(
                                        self.apply_type_bindings(
                                            field.field_type,
                                            bindings,
                                        ),
                                    );
                                };
                            },
                            .None() then {},
                        },
                        .None() then {},
                    };
                };
                result
            },
            _ then List[Type].new(),
        };
    };

    module_private get_struct_pattern_owner_def_id(
        self,
        subject_type Type,
        pattern_def_id DefId,
    ) Option[DefId] = {
        let inner_type = when subject_type in {
            .ReferenceType(inner) then inner,
            .MutableReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then subject_type,
        };

        return when inner_type in {
            .StructureType(def_id) then {
                if self.struct_pattern_decl_def_id(def_id) == pattern_def_id then Option[DefId].Some(
                    def_id,
                ) else Option[DefId].None()
            },
            // Identity: the template's DECLARATION.
            .GenericStruct(template_def_id, _) then {
                if template_def_id == pattern_def_id then Option[DefId].Some(
                    template_def_id,
                ) else Option[DefId].None()
            },
            _ then Option[DefId].None(),
        };
    };

    /// The registered fields behind a destructuring, in declaration order.
    /// Identity comes from the SUBJECT's own DECLARATION, never from a name.
    module_private get_struct_pattern_fields(
        self,
        subject_type Type,
        pattern_def_id DefId,
    ) List[StructField] = {
        let inner_type = when subject_type in {
            .ReferenceType(inner) then inner,
            .MutableReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then subject_type,
        };

        return when inner_type in {
            .StructureType(def_id) then {
                let mutable out = List[StructField].new();
                if self.struct_pattern_decl_def_id(def_id) == pattern_def_id then {
                    when self.context().get_struct_fields(def_id) in {
                        .Some(fields) then {
                            for field in fields then {
                                out.push(field);
                            };
                        },
                        .None() then {},
                    };
                };
                out
            },
            // Identity: the template's DECLARATION.
            .GenericStruct(template_def_id, _) then {
                let mutable out = List[StructField].new();
                if template_def_id == pattern_def_id then {
                    when self.storage.generic_templates.struct_by_def_id(
                        template_def_id,
                    ) in {
                        .Some(struct_template) then when self.context().get_struct_fields(
                            struct_template.def_id,
                        ) in {
                            .Some(fields) then {
                                for field in fields then {
                                    out.push(field);
                                };
                            },
                            .None() then {},
                        },
                        .None() then {},
                    };
                };
                out
            },
            _ then List[StructField].new(),
        };
    };

    /// `ordered_elements` is the DECLARATION-ORDER argument list that
    /// `order_pattern_arguments` produced; slot i corresponds to field i.
    module_private check_struct_pattern_field_visibility(
        self,
        subject_type Type,
        pattern_def_id DefId,
        type_name String,
        ordered_elements List[PatternElement],
    ) Bool = {
        let fields = self.get_struct_pattern_fields(subject_type, pattern_def_id);
        return when self.get_struct_pattern_owner_def_id(subject_type, pattern_def_id) in {
            .Some(def_id) then {
                let mutable idx UInt = 0;
                while idx < ordered_elements.count() and idx < fields.count() then {
                    let field = fields[idx];
                    if not self.is_field_accessible_from_current_context(
                        field.access,
                        def_id,
                    ) then {
                        when ordered_elements[idx].pattern in {
                            .Wildcard(_) then {},
                            _ then {
                                let access_label = access_modifier_label(field.access);
                                self.push_diagnostic(
                                    "Cannot access \(access_label) field '\(field.name)' of type '\(type_name)' in destructuring pattern",
                                    pattern_span(ordered_elements[idx].pattern),
                                );
                                return false;
                            },
                        };
                    };
                    idx += 1;
                };
                true
            },
            .None() then true,
        };
    };

    /// `(a, b, c)` binds fields in DECLARATION ORDER, so it can only reach a
    /// field declared POSITIONAL. Two rules, both already owed to the named
    /// struct pattern:
    ///
    ///   - a NAMED field has to be matched by label, which a positional slot
    ///     cannot do;
    ///   - a field this file may not read may only be ignored, never bound.
    ///
    /// `binds[i]` says whether slot i reads field i -- `_` does not -- and
    /// `slot_spans[i]` is where that slot is written.
    module_private check_positional_destructuring(
        self,
        fields List[StructField],
        owner_def_id Option[DefId],
        type_name String,
        binds List[Bool],
        slot_spans List[SourceSpan],
        span SourceSpan,
    ) Bool = {
        let mutable idx UInt = 0;
        while idx < fields.count() then {
            if fields[idx].named then {
                self.push_diagnostic_at_span(
                    "Named pattern field '\(fields[idx].name)' must be matched by label",
                    span,
                );
                return false;
            };
            idx += 1;
        };
        return when owner_def_id in {
            .None() then true,
            .Some(owner) then {
                let mutable slot UInt = 0;
                while slot < fields.count() and slot < binds.count() and slot < slot_spans.count() then {
                    let field = fields[slot];
                    if binds[slot] and not self.is_field_accessible_from_current_context(
                        field.access,
                        owner,
                    ) then {
                        self.push_diagnostic_at_span(
                            "Cannot access \(access_modifier_label(field.access)) field '\(field.name)' of type '\(type_name)' in destructuring pattern",
                            slot_spans[slot],
                        );
                        return false;
                    };
                    slot += 1;
                };
                true
            },
        };
    };

    module_private get_struct_pattern_param_specs(
        self,
        subject_type Type,
        pattern_def_id DefId,
    ) List[FunctionParamSpec] = {
        let inner_type = when subject_type in {
            .ReferenceType(inner) then inner,
            .MutableReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then subject_type,
        };

        return when inner_type in {
            .StructureType(def_id) then {
                let mutable specs = List[FunctionParamSpec].new();
                if self.struct_pattern_decl_def_id(def_id) == pattern_def_id then {
                    when self.context().get_struct_fields(def_id) in {
                        .Some(fields) then {
                            for field in fields then {
                                specs.push(
                                    FunctionParamSpec(
                                        field.name,
                                        field.is_mutable,
                                        field.named,
                                        false,
                                    ),
                                );
                            };
                        },
                        .None() then {},
                    };
                };
                specs
            },
            // Identity: the template's DECLARATION.
            .GenericStruct(template_def_id, _) then {
                let mutable specs = List[FunctionParamSpec].new();
                if template_def_id == pattern_def_id then {
                    when self.storage.generic_templates.struct_by_def_id(
                        template_def_id,
                    ) in {
                        .Some(struct_template) then when self.context().get_struct_fields(
                            struct_template.def_id,
                        ) in {
                            .Some(fields) then {
                                for field in fields then {
                                    specs.push(
                                        FunctionParamSpec(
                                            field.name,
                                            field.is_mutable,
                                            field.named,
                                            false,
                                        ),
                                    );
                                };
                            },
                            .None() then {},
                        },
                        .None() then {},
                    };
                };
                specs
            },
            _ then List[FunctionParamSpec].new(),
        };
    };

    module_private infer_for_pattern_item_type(self, iter_type Type) Type = {
        let inner_iter_type = when iter_type in {
            .ReferenceType(inner) then inner,
            .MutableReferenceType(inner) then inner,
            .BorrowedReferenceType(inner) then inner,
            .MutableBorrowedReferenceType(inner) then inner,
            .WeakReferenceType(inner) then inner,
            .MutableWeakReferenceType(inner) then inner,
            _ then iter_type,
        };

        if self.is_string_type(inner_iter_type) then {
            return self.builtin_rune_type();
        };

        let direct_next_type = self.resolve_method_return_type(inner_iter_type, "next");
        let direct_item_type = self.extract_option_result_inner(direct_next_type);
        if direct_item_type is not .Unknown() then {
            return direct_item_type;
        };

        let iterator_type = self.resolve_method_return_type(inner_iter_type, "iterator");
        let next_type = self.resolve_method_return_type(iterator_type, "next");
        let item_type = self.extract_option_result_inner(next_type);
        return item_type;
    };

    // 注入 trait 类型参数到 global_scope
    // 例：given Duration [Int]Mul，trait_type = Generic("Mul", [Int])
    // Mul 的 type_params = ["R"]，则把 R -> Int 注入
};
