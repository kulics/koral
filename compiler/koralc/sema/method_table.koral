// Method table: maps (owner type -> method name -> Symbol).
//
// The owner is identified by `MethodOwner`, never by a type NAME: two modules
// may each declare `Plain`, and `given Plain { tag }` in each is a different
// method on a different type.

public type mutable MethodTable(
    mutable methods Dict[MethodOwner, Dict[String, Symbol]],
    mutable inherent_keys Dict[MethodOwner, Set[String]],
    // Declaration identity of each trait that has provided a given
    // (owner, method_name). The DefId form of Swift's
    // `extensionMethodTraitSources[typeName][methodName]`.
    mutable method_sources Dict[MethodOwner, Dict[String, List[DefId]]],
    // METHOD FACE (§3.4): which TRAIT provides a non-inherent method.
    // Empty means "no trait claimed it" -- an inherent `given X { }` or a
    // declaration whose provenance was never stamped -- and such a method is
    // always callable. A method listed here is callable only when one of these
    // traits is in scope at the call site (Rust: "items from traits can only be
    // used if the trait is in scope").
    mutable method_traits Dict[MethodOwner, Dict[String, List[DefId]]],
);

given MethodTable {
    public new() MethodTable = {
        return MethodTable(
            Dict[MethodOwner, Dict[String, Symbol]].new(),
            Dict[MethodOwner, Set[String]].new(),
            Dict[MethodOwner, Dict[String, List[DefId]]].new(),
            Dict[MethodOwner, Dict[String, List[DefId]]].new(),
        );
    };

    file_private method_names(self, owner MethodOwner) Dict[String, Symbol] = {
        return when self.methods.get(owner) in {
            .Some(m) then m,
            .None() then Dict[String, Symbol].new(),
        };
    };

    file_private name_set(
        self,
        table Dict[MethodOwner, Set[String]],
        owner MethodOwner,
    ) Set[String] = {
        return when table.get(owner) in {
            .Some(s) then s,
            .None() then Set[String].new(),
        };
    };

    // Identity is the METHOD's declaration DefId, not its name and not the
    // trait's name: one declaration arriving twice is a re-registration, two
    // declarations sharing a name are ambiguous.
    /// Register `method` under `owner`, arriving from declaration `source_def_id`.
    ///
    /// Returns true when this registration made the name AMBIGUOUS: a second,
    /// distinct declaration reaching the same slot. One declaration arriving
    /// twice is a re-registration and returns false. The caller reports the
    /// conflict at the declaration -- this table has no diagnostic channel --
    /// and lookups afterwards read the slot as they would an uncontested name.
    public register_with_source(
        self,
        owner MethodOwner,
        method_name String,
        method Symbol,
        source_def_id DefId,
    ) Bool = {
        let mutable sources = when self.method_sources.get(owner) in {
            .Some(by_name) then by_name,
            .None() then Dict[String, List[DefId]].new(),
        };
        let mutable source_list = sources.get(method_name) or else List[DefId].new();
        let mutable already_known = false;
        for existing_source in source_list then {
            if existing_source == source_def_id then {
                already_known = true;
            };
        };
        let mutable made_ambiguous = false;
        if not already_known then {
            if not source_list.is_empty() then {
                made_ambiguous = true;
            };
            source_list.push(source_def_id);
            sources.insert(method_name, source_list);
            self.method_sources.insert(owner, sources);
        };
        let mutable m = self.method_names(owner);
        m.insert(method_name, method);
        self.methods.insert(owner, m);
        return made_ambiguous;
    };

    public register(self, owner MethodOwner, method_name String, method Symbol) Void = {
        let _ = self.register_with_source(owner, method_name, method, method.def_id);
    };

    public lookup(self, owner MethodOwner, method_name String) Option[Symbol] = {
        return self.method_names(owner).get(method_name);
    };

    public mark_inherent(self, owner MethodOwner, method_name String) Void = {
        let mutable inherent = self.name_set(self.inherent_keys, owner);
        inherent.insert(method_name);
        self.inherent_keys.insert(owner, inherent);
    };

    public is_inherent(self, owner MethodOwner, method_name String) Bool = {
        return self.name_set(self.inherent_keys, owner).contains(method_name);
    };

    /// Stamp the TRAIT that provides this method (§3.4 method face).
    /// `given X as T { m }` and a `given T { … }` tool member materialised onto
    /// `X` both stamp `T`; an inherent `given X { m }` stamps nothing and stays
    /// in `inherent_keys`. One method may be stamped by several traits -- the
    /// slot is then open if ANY of them is in scope.
    public register_providing_trait(
        self,
        owner MethodOwner,
        method_name String,
        trait_def_id DefId,
    ) Void = {
        let mutable by_name = when self.method_traits.get(owner) in {
            .Some(m) then m,
            .None() then Dict[String, List[DefId]].new(),
        };
        let mutable traits = when by_name.get(method_name) in {
            .Some(list) then list,
            .None() then List[DefId].new(),
        };
        for existing in traits then {
            if existing == trait_def_id then {
                return;
            };
        };
        traits.push(trait_def_id);
        by_name.insert(method_name, traits);
        self.method_traits.insert(owner, by_name);
    };

    /// Traits that provide `method_name` on `owner`. Empty when the method is
    /// inherent or its provenance was never stamped -- the caller treats that
    /// as always callable.
    public providing_traits(self, owner MethodOwner, method_name String) List[DefId] = {
        return when self.method_traits.get(owner) in {
            .Some(by_name) then when by_name.get(method_name) in {
                .Some(list) then list,
                .None() then List[DefId].new(),
            },
            .None() then List[DefId].new(),
        };
    };
};
