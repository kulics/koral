// Method table: maps (owner type -> method name -> Symbol).
//
// The owner is identified by `MethodOwner`, never by a type NAME: two modules
// may each declare `Plain`, and `given Plain { tag }` in each is a different
// method on a different type.

/// One method declared for a SPECIFIC instantiation of a generic owner
/// (`given List[Int] { ... }`). The slot applies to exactly the owner
/// arguments in `self_args` and to no other instantiation -- the `GenericArgs`
/// half of rustc's `Instance { def, args }` on the declaration side.
public type MethodInstanceSlot(
    self_args: List[Type],
    symbol: Symbol,
    source_def_id: DefId,
    inherent: Bool,
    providing_traits: List[DefId],
);

public type mutable MethodTable(
    mutable methods: Dict[MethodOwner, Dict[String, Symbol]],
    // Instance-scoped slots: (owner -> method name -> slots). A slot matches a
    // lookup only for the exact owner arguments it was declared for. Consulted
    // BEFORE `methods` (the universal slots). The two kinds of `given` may not
    // declare the same name for one owner (reported as a duplicate at the
    // declaration), so the ordering never picks between contenders.
    mutable instance_methods: Dict[MethodOwner, Dict[String, List[MethodInstanceSlot]]],
    mutable inherent_keys: Dict[MethodOwner, Set[String]],
    // Declaration identity of each trait that has provided a given
    // (owner, method_name). The DefId form of Swift's
    // `extensionMethodTraitSources[typeName][methodName]`.
    mutable method_sources: Dict[MethodOwner, Dict[String, List[DefId]]],
    // METHOD FACE (§3.4): which TRAIT provides a non-inherent method.
    // Empty means "no trait claimed it" -- an inherent `given X { }` or a
    // declaration whose provenance was never stamped -- and such a method is
    // always callable. A method listed here is callable only when one of these
    // traits is in scope at the call site (Rust: "items from traits can only be
    // used if the trait is in scope").
    mutable method_traits: Dict[MethodOwner, Dict[String, List[DefId]]],
);

given MethodTable {
    public new(): MethodTable = {
        return MethodTable(
            Dict[MethodOwner, Dict[String, Symbol]].new(),
            Dict[MethodOwner, Dict[String, List[MethodInstanceSlot]]].new(),
            Dict[MethodOwner, Set[String]].new(),
            Dict[MethodOwner, Dict[String, List[DefId]]].new(),
            Dict[MethodOwner, Dict[String, List[DefId]]].new(),
        );
    };

    private method_names(self, owner: MethodOwner): Dict[String, Symbol] = {
        return self.methods.get(owner) or else Dict[String, Symbol].new();
    };

    private name_set(
        self,
        table: Dict[MethodOwner, Set[String]],
        owner: MethodOwner,
    ): Set[String] = {
        return table.get(owner) or else Set[String].new();
    };

    // Identity is the METHOD's declaration DefId, not its name and not the
    // trait's name: one declaration arriving twice is a re-registration, two
    // declarations sharing a name are ambiguous.
    /// Register `method` under `owner`, arriving from declaration `source_def_id`.
    ///
    /// Returns true when this registration made the name AMBIGUOUS: a second,
    /// distinct declaration reaching the same slot. One declaration arriving
    /// twice is a re-registration and returns false. The caller reports the
    /// conflict at the declaration -- this table has no diagnostic channel --
    /// and lookups afterwards read the slot as they would an uncontested name.
    public register_with_source(
        self,
        owner: MethodOwner,
        method_name: String,
        method: Symbol,
        source_def_id: DefId,
    ): Bool = {
        let mutable sources = self.method_sources.get(owner) or else Dict[String, List[DefId]].new();
        let mutable source_list = sources.get(method_name) or else List[DefId].new();
        let mutable already_known = false;
        for existing_source in source_list then {
            if existing_source == source_def_id then {
                already_known = true;
            };
        };
        let mutable made_ambiguous = false;
        if not already_known then {
            if not source_list.is_empty() then {
                made_ambiguous = true;
            };
            source_list.push(source_def_id);
            sources.insert(method_name, source_list);
            self.method_sources.insert(owner, sources);
        };
        let mutable m = self.method_names(owner);
        m.insert(method_name, method);
        self.methods.insert(owner, m);
        return made_ambiguous;
    };

    public register(self, owner: MethodOwner, method_name: String, method: Symbol): Void = {
        let _ = self.register_with_source(owner, method_name, method, method.def_id);
    };

    public lookup(self, owner: MethodOwner, method_name: String): Option[Symbol] = {
        return self.method_names(owner).get(method_name);
    };

    public mark_inherent(self, owner: MethodOwner, method_name: String): Void = {
        let mutable inherent = self.name_set(self.inherent_keys, owner);
        inherent.insert(method_name);
        self.inherent_keys.insert(owner, inherent);
    };

    public is_inherent(self, owner: MethodOwner, method_name: String): Bool = {
        return self.name_set(self.inherent_keys, owner).contains(method_name);
    };

    /// Stamp the TRAIT that provides this method (§3.4 method face).
    /// `given X as T { m }` and a `given T { … }` tool member materialised onto
    /// `X` both stamp `T`; an inherent `given X { m }` stamps nothing and stays
    /// in `inherent_keys`. One method may be stamped by several traits -- the
    /// slot is then open if ANY of them is in scope.
    public register_providing_trait(
        self,
        owner: MethodOwner,
        method_name: String,
        trait_def_id: DefId,
    ): Void = {
        let mutable by_name = self.method_traits.get(owner) or else Dict[String, List[DefId]].new();
        let mutable traits = by_name.get(method_name) or else List[DefId].new();
        for existing in traits then {
            if existing == trait_def_id then {
                return;
            };
        };
        traits.push(trait_def_id);
        by_name.insert(method_name, traits);
        self.method_traits.insert(owner, by_name);
    };

    /// Traits that provide `method_name` on `owner`. Empty when the method is
    /// inherent or its provenance was never stamped -- the caller treats that
    /// as always callable.
    public providing_traits(self, owner: MethodOwner, method_name: String): List[DefId] = {
        return when self.method_traits.get(owner) in {
            .Some(by_name) then by_name.get(method_name) or else List[DefId].new(),
            .None() then List[DefId].new(),
        };
    };

    // ── Instance-scoped slots ─────────────────────────────────────────────────

    /// The instance slot declaring `method_name` for exactly `self_args`, if
    /// any. No fallback: an instance slot answers for one instantiation only.
    public instance_slot(
        self,
        owner: MethodOwner,
        method_name: String,
        self_args: List[Type],
    ): Option[MethodInstanceSlot] = {
        let slots = when self.instance_methods.get(owner) in {
            .Some(by_name) then by_name.get(method_name) or else List[MethodInstanceSlot].new(),
            .None() then List[MethodInstanceSlot].new(),
        };
        for slot in slots then {
            if slot.self_args == self_args then {
                return Option[MethodInstanceSlot].Some(slot);
            };
        };
        return Option[MethodInstanceSlot].None();
    };

    /// Register `method` for the single instantiation named by `self_args`.
    ///
    /// `inherent` stamps the method as `given X { m }` (always callable); a
    /// `providing_trait` stamps the trait that delivers it (`given X as T { m }`),
    /// whose face gate the caller honours. Returns true when this registration
    /// made the slot AMBIGUOUS: a second, distinct declaration reaching the
    /// same (owner, args, name) slot. One declaration arriving twice is a
    /// re-registration and returns false.
    public register_instance(
        self,
        owner: MethodOwner,
        method_name: String,
        self_args: List[Type],
        method: Symbol,
        source_def_id: DefId,
        inherent: Bool,
        providing_trait: Option[DefId],
    ): Bool = {
        let mutable by_name = self.instance_methods.get(owner) or else Dict[
            String,
            List[MethodInstanceSlot],
        ].new();
        let mutable slots = by_name.get(method_name) or else List[MethodInstanceSlot].new();
        let mutable made_ambiguous = false;
        let mutable replaced_index = Option[Int].None();
        for pair in slots.lazy().enumerate() then {
            let slot = pair.second;
            if slot.self_args == self_args then {
                if slot.source_def_id == source_def_id then {
                    replaced_index = Option[Int].Some(pair.first);
                } else {
                    made_ambiguous = true;
                };
            };
        };
        let mutable traits = List[DefId].new();
        when providing_trait in {
            .Some(trait_def_id) then {
                traits.push(trait_def_id);
            },
            .None() then {},
        };
        let slot = MethodInstanceSlot(
            self_args,
            method,
            source_def_id,
            inherent,
            traits,
        );
        when replaced_index in {
            .Some(index) then {
                slots[index] = slot;
            },
            .None() then {
                slots.push(slot);
            },
        };
        by_name.insert(method_name, slots);
        self.instance_methods.insert(owner, by_name);
        return made_ambiguous;
    };

    /// The instance-scoped `method_name` symbol declared for exactly
    /// `self_args`, if any. Consulted before the universal slots; an overlap
    /// with a universal name is a declaration error, so no same-named universal
    /// method exists to shadow.
    public lookup_instance(
        self,
        owner: MethodOwner,
        method_name: String,
        self_args: List[Type],
    ): Option[Symbol] = {
        return when self.instance_slot(owner, method_name, self_args) in {
            .Some(slot) then Option[Symbol].Some(slot.symbol),
            .None() then Option[Symbol].None(),
        };
    };

    /// Is the instance slot for exactly `self_args` an inherent `given X { m }`?
    public instance_is_inherent(
        self,
        owner: MethodOwner,
        method_name: String,
        self_args: List[Type],
    ): Bool = {
        return when self.instance_slot(owner, method_name, self_args) in {
            .Some(slot) then slot.inherent,
            .None() then false,
        };
    };

    /// Traits that provide the instance-scoped `method_name` for `self_args`.
    /// Empty when the slot is inherent or absent.
    public instance_providing_traits(
        self,
        owner: MethodOwner,
        method_name: String,
        self_args: List[Type],
    ): List[DefId] = {
        return when self.instance_slot(owner, method_name, self_args) in {
            .Some(slot) then slot.providing_traits,
            .None() then List[DefId].new(),
        };
    };
};
