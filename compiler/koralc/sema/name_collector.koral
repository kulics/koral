// Pass 1 – Name Collector
// Scans all top-level declarations and registers their names in the global scope.
// Does NOT inspect function bodies.

public type mutable NameCollector(
    mutable context: CompilerContext,
    mutable global_scope: Scope,
    mutable diagnostics: DiagnosticCollector,
    mutable module_path: List[String],
    mutable source_file: String,
    mutable package_id: String,
    // Generic template names that belong to the standard library. The compiler
    // builds std's containers and `Option` by name (`genericEnumType(template:
    // "Option", ...)`), so a user template with one of those names would take
    // the lang item out from under inference. Nothing else is reserved: two
    // user modules may both declare `Box[T]`, and a non-generic `Duration` may
    // share std's name freely -- both are pinned by cross-module tests.
    mutable std_generic_template_names: Set[String],
    // 同名顶层定义注册表（name-resolution.md §同名顶层定义的冲突规则）：
    // 模块级（非 private）名字 → 声明的**名字 span**；private 名字 → 每个文件
    // 的名字 span。检查与锚点都在名字 span 上做——与种子侧逐字一致。
    mutable module_top_level_names: Dict[String, SourceSpan],
    mutable private_top_level_names: Dict[String, Dict[String, SourceSpan]],
    // 本次冲突的诊断锚点（check_top_level_name_conflict 置位，调用方取用）。
    mutable duplicate_anchor: Option[SourceSpan],
);

given NameCollector {
    public new(): NameCollector = {
        return NameCollector(
            CompilerContext.new(),
            Scope.new_root(),
            DiagnosticCollector.new(),
            List[String].new(),
            "",
            "",
            Set[String].new(),
            Dict[String, SourceSpan].new(),
            Dict[String, Dict[String, SourceSpan]].new(),
            Option[SourceSpan].None(),
        );
    };

    public new_with_context(module_path: List[String], source_file: String): NameCollector = {
        return NameCollector(
            CompilerContext.new(),
            Scope.new_root(),
            DiagnosticCollector.new(),
            module_path,
            source_file,
            "",
            Set[String].new(),
            Dict[String, SourceSpan].new(),
            Dict[String, Dict[String, SourceSpan]].new(),
            Option[SourceSpan].None(),
        );
    };

    // Register all top-level names from a program.
    public collect(self, program: Program): Void = {
        for decl in program.declarations then {
            self.collect_decl(decl);
        };
    };

    // Register all top-level names from a list of LoadedNodes (multi-module compilation).
    // Each node carries its own source_file; module_path is provided per-node via pairs.
    public collect_loaded_nodes_with_path(
        self,
        pairs: List[Pair[LoadedNode, List[String]]],
    ): Void = {
        let saved_module_path = self.module_path;
        let saved_source_file = self.source_file;
        let saved_package_id = self.package_id;
        for pair in pairs then {
            self.module_path = pair.second;
            self.source_file = pair.first.source_file;
            self.package_id = pair.first.package_id;
            self.collect_decl(pair.first.decl);
        };
        self.module_path = saved_module_path;
        self.source_file = saved_source_file;
        self.package_id = saved_package_id;
    };

    private make_var_symbol(
        self,
        name: String,
        is_mutable: Bool,
        access: AccessModifier,
        span: SourceSpan,
    ): Symbol = {
        let kind = if is_mutable then SymbolKind.Variable(VariableKind.MutableValue())
        else SymbolKind.Variable(VariableKind.Value());
        let mutable context = self.context;
        let def_id = context.allocate_full_in_package(
            name,
            DefKind.Variable(),
            self.module_path,
            self.source_file,
            self.package_id,
            access,
            span,
        );
        return Symbol(def_id, Type.Unknown(), kind);
    };

    private make_fn_symbol(
        self,
        name: String,
        access: AccessModifier,
        span: SourceSpan,
    ): Symbol = {
        let mutable context = self.context;
        let def_id = context.allocate_full_in_package(
            name,
            DefKind.Function(),
            self.module_path,
            self.source_file,
            self.package_id,
            access,
            span,
        );
        return Symbol(def_id, Type.Unknown(), SymbolKind.Function());
    };

    private duplicate_definition_message(self, name: String): String = {
        let _ = self;
        let mutable message = StringBuilder.new();
        message.push_string("Duplicate definition: ");
        message.push_string(name);
        return message.to_string();
    };

    private is_std_package(self): Bool = {
        return is_std_package_id(self.package_id);
    };

    /// `intrinsic` names something the compiler provides. Letting user code
    /// declare one would let anyone claim a builtin, so it is std-only.
    /// Returns true when the declaration has been rejected.
    private reject_intrinsic_outside_std(self, span: SourceSpan): Bool = {
        if self.is_std_package() then {
            return false;
        };
        self.push_name_diagnostic(
            "'intrinsic' declarations are only allowed in the standard library",
            span,
        );
        return true;
    };

    /// Whether declaring this name would take one of std's generic templates.
    private shadows_std_generic_template(self, name: String, is_generic: Bool): Bool = {
        if not is_generic then {
            return false;
        };
        if self.is_std_package() then {
            self.std_generic_template_names.insert(name);
            return false;
        };
        return self.std_generic_template_names.contains(name);
    };

    /// Report at a source location. A name-collection diagnostic with no span
    /// cannot be jumped to, so every caller must say where the offending
    /// declaration is.
    private push_name_diagnostic(self, message: String, span: SourceSpan): Void = {
        self.diagnostics.push(
            make_diagnostic(DiagnosticStage.Semantic(), self.source_file, message, span),
        );
    };

    private has_conflicting_top_level_name(
        self,
        name: String,
        access: AccessModifier,
        new_span: SourceSpan,
    ): Bool = {
        return self.check_top_level_name_conflict(name, access, new_span);
    };

    private has_conflicting_top_level_type_name(
        self,
        name: String,
        access: AccessModifier,
        new_span: SourceSpan,
    ): Bool = {
        return self.check_top_level_name_conflict(name, access, new_span);
    };

    /// 源码顺序比较（文件, 行, 列）——与种子侧同尺子（它同样带 fileName），
    /// 锚点才逐字一致。合成 span 无文件名，两侧都按空串参与比较。
    private span_is_later(self, a: SourceSpan, b: SourceSpan): Bool = {
        let _ = self;
        let af = a.start.file or else "";
        let bf = b.start.file or else "";
        if af != bf then {
            return af > bf;
        };
        if a.start.line != b.start.line then {
            return a.start.line > b.start.line;
        };
        return a.start.column > b.start.column;
    };

    /// §同名顶层定义的冲突规则（name-resolution.md，2026-11-12）：同一模块内
    /// 两个同名顶层定义在「同文件」或「任一方非 private」时冲突——private 不得
    /// 遮蔽模块级同名。对称、与收集顺序无关；诊断锚在两者里源码位置较后的
    /// **名字 span** 上（两个编译器的合并收集顺序不同，锚新声明会各指一处）。
    private check_top_level_name_conflict(
        self,
        name: String,
        access: AccessModifier,
        new_span: SourceSpan,
    ): Bool = {
        let is_private = access is .Private();
        // 键带模块前缀：一个收集器可跑多个模块，裸名会跨模块撞（与种子侧
        // qualifiedName 同规则）。
        let qualified = if self.module_path.is_empty() then name
        else join_path(self.module_path, ".") + "." + name;
        let mutable anchor = Option[SourceSpan].None();
        when self.module_top_level_names.get(qualified) in {
            .Some(existing_span) then {
                let candidate = if self.span_is_later(existing_span, new_span) then {
                    existing_span
                } else {
                    new_span
                };
                anchor = Option[SourceSpan].Some(candidate);
            },
            .None() then {},
        };
        when self.private_top_level_names.get(qualified) in {
            .Some(per_file) then {
                if not is_private or per_file.get(self.source_file) is .Some(_) then {
                    for kv in per_file.iterator() then {
                        let candidate = if self.span_is_later(kv.second, new_span) then {
                            kv.second
                        } else {
                            new_span
                        };
                        anchor = when anchor in {
                            .Some(best) then Option[SourceSpan].Some(
                                if self.span_is_later(best, candidate) then best else candidate,
                            ),
                            .None() then Option[SourceSpan].Some(candidate),
                        };
                    };
                };
            },
            .None() then {},
        };
        when anchor in {
            .Some(best) then {
                self.duplicate_anchor = Option[SourceSpan].Some(best);
                return true;
            },
            .None() then {},
        };
        if is_private then {
            when self.private_top_level_names.get(qualified) in {
                .Some(per_file) then {
                    per_file.insert(self.source_file, new_span);
                },
                .None() then {
                    let per_file = Dict[String, SourceSpan].new();
                    per_file.insert(self.source_file, new_span);
                    self.private_top_level_names.insert(qualified, per_file);
                },
            };
        } else {
            self.module_top_level_names.insert(qualified, new_span);
        };
        return false;
    };

    private collect_decl(self, decl: Decl): Void = {
        when decl in {
            .TypeStructDecl(access, name, is_mutable_type, sendability, type_params, fields, span, name_span) then {
                if self.shadows_std_generic_template(name, not type_params.is_empty()) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                if self.has_conflicting_top_level_type_name(name, access, name_span) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                let kind = if type_params.is_empty() then DefKind.TypeDef(
                    TypeDefKind.Structure(),
                ) else DefKind.GenericTemplate(GenericTemplateKind.Structure());
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(
                    name,
                    kind,
                    self.module_path,
                    self.source_file,
                    self.package_id,
                    access,
                    span,
                );
                context.set_struct_mutable(def_id, is_mutable_type);
                context.set_type_sendability(def_id, sendability);
                let t = Type.StructureType(def_id);
                self.global_scope.define_scoped_type(self.module_path, name, t);
            },
            .TypeEnumDecl(access, name, sendability, type_params, cases, span, name_span) then {
                if self.shadows_std_generic_template(name, not type_params.is_empty()) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                if self.has_conflicting_top_level_type_name(name, access, name_span) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                let kind = if type_params.is_empty() then DefKind.TypeDef(
                    TypeDefKind.Enum(),
                ) else DefKind.GenericTemplate(GenericTemplateKind.Enum());
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(
                    name,
                    kind,
                    self.module_path,
                    self.source_file,
                    self.package_id,
                    access,
                    span,
                );
                let t = Type.EnumType(def_id);
                context.set_type_sendability(def_id, sendability);
                self.global_scope.define_scoped_type(self.module_path, name, t);
            },
            .TypeAliasDecl(access, name, _, target, span, name_span) then {
                if self.has_conflicting_top_level_type_name(name, access, name_span) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(
                    name,
                    DefKind.TypeDef(TypeDefKind.Structure()),
                    self.module_path,
                    self.source_file,
                    self.package_id,
                    access,
                    span,
                );
                self.global_scope.define_scoped_type(
                    self.module_path,
                    name,
                    Type.StructureType(def_id),
                );
            },
            .IntrinsicTypeDecl(access, name, type_params, span, name_span) then {
                if self.reject_intrinsic_outside_std(span) then {
                    return;
                };
                if self.has_conflicting_top_level_type_name(name, access, name_span) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                // Register intrinsic types as their dedicated enum cases (matching Swift compiler)
                // so that conformance keys are consistent between scope lookup and hardcoded checks.
                let intrinsic_type = when name in {
                    "Bool" then Type.BoolType(),
                    "Never" then Type.NeverType(),
                    "Int" then Type.IntType(),
                    "Int8" then Type.Int8Type(),
                    "Int16" then Type.Int16Type(),
                    "Int32" then Type.Int32Type(),
                    "Int64" then Type.Int64Type(),
                    "UInt" then Type.UIntType(),
                    "UInt8" then Type.UInt8Type(),
                    "UInt16" then Type.UInt16Type(),
                    "UInt32" then Type.UInt32Type(),
                    "UInt64" then Type.UInt64Type(),
                    "WrappingInt" then Type.WrappingIntType(),
                    "WrappingInt8" then Type.WrappingInt8Type(),
                    "WrappingInt16" then Type.WrappingInt16Type(),
                    "WrappingInt32" then Type.WrappingInt32Type(),
                    "WrappingInt64" then Type.WrappingInt64Type(),
                    "WrappingUInt" then Type.WrappingUIntType(),
                    "WrappingUInt8" then Type.WrappingUInt8Type(),
                    "WrappingUInt16" then Type.WrappingUInt16Type(),
                    "WrappingUInt32" then Type.WrappingUInt32Type(),
                    "WrappingUInt64" then Type.WrappingUInt64Type(),
                    "Float32" then Type.Float32Type(),
                    "Float64" then Type.Float64Type(),
                    _ then {
                        // Unknown intrinsic type - allocate as OpaqueType
                        let mutable context = self.context;
                        let def_id = context.allocate_full_in_package(
                            name,
                            DefKind.TypeDef(TypeDefKind.Opaque()),
                            self.module_path,
                            self.source_file,
                            self.package_id,
                            access,
                            span,
                        );
                        Type.OpaqueType(def_id)
                    },
                };
                self.global_scope.define_scoped_type(
                    self.module_path,
                    name,
                    intrinsic_type,
                );
            },
            .ForeignTypeDecl(access, name, sendability, fields, cname, span, name_span) then {
                if self.has_conflicting_top_level_type_name(name, access, name_span) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                let kind = when fields in {
                    .Some(_) then DefKind.TypeDef(TypeDefKind.Structure()),
                    .None() then DefKind.TypeDef(TypeDefKind.Opaque()),
                };
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(
                    name,
                    kind,
                    self.module_path,
                    self.source_file,
                    self.package_id,
                    access,
                    span,
                );
                if cname is .Some(c) then {
                    // The C-name slot: this type's name in the C world -- a
                    // struct tag for the struct form, the C type's own
                    // spelling for the opaque form.
                    context.set_declared_cname(def_id, c);
                };
                context.set_type_sendability(def_id, sendability);
                let t = when fields in {
                    .Some(_) then Type.StructureType(def_id),
                    .None() then Type.OpaqueType(def_id),
                };
                if fields is .Some(_) then {
                    // Mark the type as foreign NOW: field types are checked
                    // for FFI compatibility later, and a foreign struct's own
                    // `*Self` fields (or mutual `*Other` pointers between
                    // foreign structs) must see it as foreign. The real field
                    // list replaces this placeholder at type-check time.
                    self.context.set_foreign_struct_fields(def_id, List[StructField].new());
                };
                self.global_scope.define_scoped_type(self.module_path, name, t);
            },
            .TraitDecl(access, name, is_sendable, type_params, parents, members, span, name_span) then {
                let trait_source_file = when access in {
                    .Private() then Option[String].Some(self.source_file),
                    _ then Option[String].None(),
                };
                if self.check_top_level_name_conflict(name, access, name_span) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(
                    name,
                    DefKind.TypeDef(TypeDefKind.Trait()),
                    self.module_path,
                    self.source_file,
                    self.package_id,
                    access,
                    span,
                );
                // `trait sendable` (concurrency-design.md): the trait's objects
                // are always sendable, so the declaration registers the same
                // sendability slot a nominal type would.
                if is_sendable then {
                    context.set_type_sendability(def_id, Sendability.Sendable());
                };
                let mutable trait_type_args = List[Type].new();
                for type_param in type_params then {
                    trait_type_args.push(Type.GenericParameter(type_param.name));
                };
                self.global_scope.define_scoped_type(
                    self.module_path,
                    name,
                    Type.TraitObject(def_id, trait_type_args, false),
                );
            },
            .FunctionDecl(access, name, type_params, params, return_type, body, span, name_span) then {
                if self.has_conflicting_top_level_name(name, access, name_span) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                let kind = if type_params.is_empty() then DefKind.Function()
                else DefKind.GenericTemplate(GenericTemplateKind.Function());
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(
                    name,
                    kind,
                    self.module_path,
                    self.source_file,
                    self.package_id,
                    access,
                    span,
                );
                let sym = Symbol(def_id, Type.Unknown(), SymbolKind.Function());
                self.global_scope.define(self.context, sym);
            },
            .IntrinsicFunctionDecl(access, name, type_params, params, return_type, span, name_span) then {
                if self.reject_intrinsic_outside_std(span) then {
                    return;
                };
                if self.has_conflicting_top_level_name(name, access, name_span) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(
                    name,
                    DefKind.Function(),
                    self.module_path,
                    self.source_file,
                    self.package_id,
                    access,
                    span,
                );
                let sym = Symbol(def_id, Type.Unknown(), SymbolKind.Function());
                self.global_scope.define(self.context, sym);
            },
            .ForeignFunctionDecl(access, name, params, return_type, body, cname, span, name_span) then {
                if self.has_conflicting_top_level_name(name, access, name_span) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                let mutable context = self.context;
                let def_id = context.allocate_full_in_package(
                    name,
                    DefKind.Function(),
                    self.module_path,
                    self.source_file,
                    self.package_id,
                    access,
                    span,
                );
                let _ = body;
                if cname is .Some(c) then {
                    context.set_declared_cname(def_id, c);
                };
                let sym = Symbol(def_id, Type.Unknown(), SymbolKind.Function());
                self.global_scope.define(self.context, sym);
            },
            .LetDecl(access, name, is_mutable, type_name, initializer, span, name_span) then {
                if self.has_conflicting_top_level_name(name, access, name_span) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                let sym = self.make_var_symbol(name, is_mutable, access, span);
                self.global_scope.define(self.context, sym);
            },
            .ForeignLetDecl(access, name, is_mutable, type_name, initializer, cname, span, name_span) then {
                if self.has_conflicting_top_level_name(name, access, name_span) then {
                    self.push_name_diagnostic(
                        self.duplicate_definition_message(name),
                        self.duplicate_anchor or else name_span,
                    );
                    return;
                };
                let _ = type_name;
                let _ = initializer;
                let sym = self.make_var_symbol(name, is_mutable, access, span);
                if cname is .Some(c) then {
                    let mutable context = self.context;
                    context.set_declared_cname(sym.def_id, c);
                };
                self.global_scope.define(self.context, sym);
            },
            // Declarations that don't introduce names into the value/type namespace
            .UsingDecl(_, _, _, _) then {},
            .GivenDecl(_, _, _, _) or .GivenTraitDecl(_, _, _, _, _) then {},
            .IntrinsicGivenDecl(_, _, _, span) then {
                let _ = self.reject_intrinsic_outside_std(span);
            },
        };
    };
};
