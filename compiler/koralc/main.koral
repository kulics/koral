using "./ast/ast.koral";
using "./lexer/lexer.koral";
using "./parser/parser.koral";
using "./diagnostics/diagnostics.koral";
using "./typed/typed.koral";
using "./sema/sema.koral";
using "./module/module.koral";
using "./mono/mono.koral";
using "./mir/mir.koral";
using "./codegen/codegen.koral";
using "./driver/driver.koral";

// The compiler's own hashing is pinned at startup: its emitted C must be
// reproducible byte for byte (the fixed point compares self-host rounds)
// and several internal tables are walked in hash order. User programs keep
// the per-process random seed -- this pins only this process.
let foreign __koral_hash_seed_pin(value: UInt): Void;

public let main(): Int = {
    __koral_hash_seed_pin(UInt(7046029254386353131));
    return run_driver();
};
