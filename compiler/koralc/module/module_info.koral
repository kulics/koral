// Module system data structures.
// Mirrors compiler-reference/Sources/KoralCompiler/Module/ModuleResolver.swift

using "std/os";

// ── ImportKind ────────────────────────────────────────────────────────────────

public type ImportKind {
    Local(),
    MemberImport(),
    ModuleImport(),
    BatchImport(),
};

// ── ImportEdge ────────────────────────────────────────────────────────────────

/// `span` is where the `using` is written. A collision between an imported
/// name and something already in scope is reported there -- that is the line
/// the reader has to edit (§3.3).
public type ImportEdge(
    source List[String],
    target List[String],
    kind ImportKind,
    source_file Option[String],
    span SourceSpan,
);

public type SymbolImportEdge(
    module List[String],
    target List[String],
    symbol String,
    original_symbol String,
    kind ImportKind,
    source_file Option[String],
    span SourceSpan,
);

// ── ImportGraph ───────────────────────────────────────────────────────────────

public type mutable ImportGraph(
    mutable edges List[ImportEdge],
    mutable symbol_imports List[SymbolImportEdge],
    // symbol_imports 的按名字索引：name -> 所有 `symbol` 或 `original_symbol` 命中该名的边，
    // 顺序与 symbol_imports 中一致。命名类型解析原先每次都要线性扫完整个 symbol_imports，
    // 且每一项都要比较源文件路径（还分配两个规范化字符串），占了类型检查的三分之一以上。
    mutable symbol_imports_by_name Dict[String, List[SymbolImportEdge]],
);

given ImportGraph {
    public new() ImportGraph = {
        return ImportGraph(
            [],
            [],
            Dict[String, List[SymbolImportEdge]].new(),
        );
    };

    public add_module_import(self, from List[String], to List[String], kind ImportKind, source_file Option[String], span SourceSpan) Void = {
        self.edges.push(ImportEdge(from, to, kind, source_file, span));
    };

    public add_symbol_import(
        self,
        module List[String],
        target List[String],
        symbol String,
        kind ImportKind,
        source_file Option[String],
        original_symbol Option[String],
        span SourceSpan,
    ) Void = {
        let edge = SymbolImportEdge(module, target, symbol, original_symbol or else symbol, kind, source_file, span);
        self.symbol_imports.push(edge);
        self.index_symbol_import(edge);
    };

    file_private index_symbol_import(self, edge SymbolImportEdge) Void = {
        self.index_symbol_import_name(edge, edge.symbol);
        if edge.original_symbol <> edge.symbol then {
            self.index_symbol_import_name(edge, edge.original_symbol);
        };
    };

    file_private index_symbol_import_name(self, edge SymbolImportEdge, name String) Void = {
        when self.symbol_imports_by_name.get(name) in {
            .Some(bucket) then { bucket.push(edge); },
            .None() then {
                let mutable bucket = List[SymbolImportEdge].new();
                bucket.push(edge);
                self.symbol_imports_by_name.insert(name, bucket);
            },
        };
    };

    /// 名字命中 `name` 的候选符号导入边（`symbol` 或 `original_symbol` 与之相等）。
    /// 只做哈希查找；调用方仍按模块 / 源文件 / 具体字段过滤，语义不变。
    /// 找不到时返回 `.None()`，不分配空列表。
    public symbol_import_candidates(self, name String) Option[List[SymbolImportEdge]] = {
        return self.symbol_imports_by_name.get(name);
    };

    // 合并另一个 ImportGraph 的所有边
    // 用于将标准库导入图合并到用户代码导入图
    public merge(self, other ImportGraph) Void = {
        for edge in other.edges then {
            self.edges.push(edge);
        };
        for si in other.symbol_imports then {
            self.symbol_imports.push(si);
            self.index_symbol_import(si);
        };
    };

    public get_import_kind(self, symbol_module_path List[String], symbol_name Option[String], in_module List[String], in_source_file Option[String]) ImportKind = {
        // Local definition
        if string_list_eq(symbol_module_path, in_module) then {
            return ImportKind.Local();
        };

        // Symbol import
        when symbol_name in {
            .Some(name) then {
                when self.symbol_import_candidates(name) in {
                    .Some(candidates) then {
                        for si in candidates then {
                            if string_list_eq(si.module, in_module) and string_list_eq(si.target, symbol_module_path) and (si.symbol == name or si.original_symbol == name) and source_file_matches(si.source_file, in_source_file) then {
                                return si.kind;
                            };
                        };
                    },
                    .None() then {},
                };
            },
            .None() then {},
        };

        // Module/batch import
        for edge in self.edges then {
            if string_list_eq(edge.source, in_module) and source_file_matches(edge.source_file, in_source_file) then {
                when edge.kind in {
                    .BatchImport() then {
                        if string_list_eq(symbol_module_path, edge.target) then {
                            return edge.kind;
                        };
                    },
                    .ModuleImport() then {
                        if string_list_eq(symbol_module_path, edge.target) then {
                            return edge.kind;
                        };
                    },
                    _ then {},
                };
            };
        };

        return ImportKind.ModuleImport();
    };
};

// ── LoadedFile ────────────────────────────────────────────────────────────────

// A parsed global node with its source file.
public type LoadedNode(
    decl Decl,
    source_file String,
    package_id String,
);

// ── ModuleInfo ────────────────────────────────────────────────────────────────

// Mutable module state lives in storage so ModuleInfo can be passed by value.
module_private type mutable ModuleInfoStorage(
    path List[String],
    entry_file String,
    is_external Bool,
    // Root-view full name (`std/io`, `game_utils`) -- the key the module is
    // known by, and the sort key for emitting nodes. Load order is `using`
    // discovery order; the symbol tables must not depend on it.
    full_name String,
    // "std:std" / "root:x" / "dependency:key", set from the owning package.
    package_id String,
    mutable merged_submodules List[String],
    mutable global_nodes List[LoadedNode],
);

public type mutable ModuleInfo(module_private mutable storage ModuleInfoStorage);

given ModuleInfo {
    public new(path List[String], entry_file String, is_external Bool) ModuleInfo =
        ModuleInfo.named(path, entry_file, is_external, join_path(path, "."), "");

    public named(
        path List[String],
        entry_file String,
        is_external Bool,
        full_name String,
        package_id String,
    ) ModuleInfo = {
        let s = ModuleInfoStorage(
            path,
            entry_file,
            is_external,
            full_name,
            package_id,
            [],
            [],
        );
        return ModuleInfo(s);
    };

    public path(self) List[String] = self.storage.path;
    public entry_file(self) String = self.storage.entry_file;
    public is_external(self) Bool = self.storage.is_external;
    public full_name(self) String = self.storage.full_name;
    public package_id(self) String = self.storage.package_id;
    public merged_submodules(self) List[String] = self.storage.merged_submodules;
    public global_nodes(self) List[LoadedNode] = self.storage.global_nodes;

    public path_string(self) String = {
        let mutable out = StringBuilder.new();
        out.push_string("");
        let mutable first = true;
        for seg in self.storage.path then {
            if not first then { out.push_byte('.');};
            out.push_string(seg);
            first = false;
        };
        return out.to_string();
    };

    public directory(self) String = {
        let p = self.storage.entry_file.into_path();
        return p.dir_name().to_string();
    };

    public add_merged_submodule(self, file String) Void = {
        self.storage.merged_submodules.push(file);
    };

    public has_merged_submodule(self, file String) Bool = {
        for f in self.storage.merged_submodules then {
            if f == file then { return true;};
        };
        return false;
    };

    public add_node(self, decl Decl, source_file String) Void = {
        self.storage.global_nodes.push(LoadedNode(decl, source_file, self.storage.package_id));
    };
};

// ── CompilationUnit ───────────────────────────────────────────────────────────

module_private type mutable CompilationUnitStorage(
    root_module ModuleInfo,
    mutable loaded_module_paths List[String],
    mutable loaded_modules List[ModuleInfo],
    mutable import_graph ImportGraph,
    mutable parsed_defaults Dict[String, String],
);

public type mutable CompilationUnit(module_private mutable storage CompilationUnitStorage);

given CompilationUnit {
    public new(root_module ModuleInfo) CompilationUnit = {
        let s = CompilationUnitStorage(
            root_module,
            [root_module.path_string()],
            [root_module],
            ImportGraph.new(),
            Dict[String, String].new()
        );
        return CompilationUnit(s);
    };

    /// A unit with no modules in it yet. Used when modules are loaded by
    /// manifest spec rather than from a single entry file -- the first module
    /// loaded is not privileged, so there is no root to pre-install.
    public empty() CompilationUnit = {
        let placeholder = ModuleInfo.new(List[String].new(), "", false);
        let s = CompilationUnitStorage(
            placeholder,
            List[String].new(),
            List[ModuleInfo].new(),
            ImportGraph.new(),
            Dict[String, String].new()
        );
        return CompilationUnit(s);
    };

    public root_module(self) ModuleInfo = self.storage.root_module;
    public import_graph(self) ImportGraph = self.storage.import_graph;

    public add_import_edge(self, from List[String], to List[String], kind ImportKind, source_file Option[String], span SourceSpan) Void = {
        self.storage.import_graph.add_module_import(from, to, kind, source_file, span);
    };

    public add_symbol_import_edge(
        self,
        module List[String],
        target List[String],
        symbol String,
        kind ImportKind,
        source_file Option[String],
        original_symbol Option[String],
        span SourceSpan,
    ) Void = {
        self.storage.import_graph.add_symbol_import(module, target, symbol, kind, source_file, original_symbol, span);
    };

    // 合并另一个编译单元的导入图（用于标准库合并）
    public merge_import_graph(self, other CompilationUnit) Void = {
        self.storage.import_graph.merge(other.import_graph());
    };

    // Accumulate parsed parameter defaults from each file
    public add_parsed_defaults(self, defaults Dict[String, String]) Void = {
        for kv in defaults.iterator() then {
            self.storage.parsed_defaults.insert(kv.first, kv.second);
        };
    };

    // Collect all accumulated parsed parameter defaults
    public collect_parsed_defaults(self) Dict[String, String] = {
        return self.storage.parsed_defaults;
    };

    /// Insert a module keeping `loaded_modules` in MODULE-PATH order.
    ///
    /// Modules are discovered in `using` order, and which `using` is seen first
    /// must not leak into the symbol tables. Keeping the collection ordered by
    /// construction makes every later emission deterministic without a sort.
    /// (A `sort_by` here would be the obvious spelling, but instantiating
    /// `List.sort_by` for a mutable newtype wrapper overflows the compiler's
    /// stack -- see docs/module-design-implementation.md.)
    public add_module(self, module ModuleInfo) Void = {
        let key = module.path_string();
        for p in self.storage.loaded_module_paths then {
            if p == key then { return;};
        };

        let mutable insert_at = self.storage.loaded_modules.count();
        let mutable i UInt = 0;
        while i < self.storage.loaded_modules.count() then {
            if self.storage.loaded_modules[i].path_string() > module.path_string() then {
                insert_at = i;
                break;
            };
            i += 1;
        };

        self.storage.loaded_module_paths.insert_at(insert_at, key);
        self.storage.loaded_modules.insert_at(insert_at, module);
    };

    public has_module(self, path_string String) Bool = {
        for p in self.storage.loaded_module_paths then {
            if p == path_string then { return true;};
        };
        return false;
    };

    public get_module(self, path_string String) Option[ModuleInfo] = {
        let mutable i UInt = 0;
        for p in self.storage.loaded_module_paths then {
            if p == path_string then {
                return Option[ModuleInfo].Some(self.storage.loaded_modules[i]);
            };
            i += 1;
        };
        return Option[ModuleInfo].None();
    };

    // Collect all global nodes in dependency order.
    public collect_all_nodes(self) List[LoadedNode] = {
        let mutable result = List[LoadedNode].new();
        for module in self.storage.loaded_modules then {
            for node in module.global_nodes().iterator() then {
                result.push(node);
            };
        };
        return result;
    };

    // Collect all global nodes with their module path, in dependency order.
    // Returns a list of (LoadedNode, module_path) pairs.
    public collect_all_nodes_with_path(self) List[Pair[LoadedNode, List[String]]] = {
        let mutable result = List[Pair[LoadedNode, List[String]]].new();
        for module in self.storage.loaded_modules then {
            let module_path = module.path();
            for node in module.global_nodes().iterator() then {
                result.push(Pair[LoadedNode, List[String]](node, module_path));
            };
        };
        return result;
    };

    /// Same, but emitted in FULL-NAME order.
    ///
    /// Modules get loaded in `using` discovery order, and which `using` is seen
    /// first is not something a symbol table may depend on. Both compilers emit
    /// by full name so the same program always yields the same tables.
    public collect_all_nodes_with_path_sorted(self) List[Pair[LoadedNode, List[String]]] =
        self.collect_all_nodes_with_path();

    public collect_nodes_with_path_for_module(self, path_string String) List[Pair[LoadedNode, List[String]]] = {
        let mutable result = List[Pair[LoadedNode, List[String]]].new();
        when self.get_module(path_string) in {
            .Some(module) then {
                let module_path = module.path();
                for node in module.global_nodes().iterator() then {
                    result.push(Pair[LoadedNode, List[String]](node, module_path));
                };
            },
            .None() then {},
        };
        return result;
    };
};

// ── Helpers ───────────────────────────────────────────────────────────────────

public let string_list_eq(a List[String], b List[String]) Bool = {
    if a.count() <> b.count() then { return false;};
    for i in 0..<a.count() then {
        if a[i] <> b[i] then { return false;};
    };
    return true;
};

public let source_file_matches(stored Option[String], current Option[String]) Bool =
    when stored in {
        .None() then true,
        .Some(s) then when current in {
            .Some(c) then source_file_paths_equal(s, c),
            .None() then false,
        },
    };

/// 与「两侧各自做 `\`→`/` 规范化后比较」等价，但不分配。
///
/// 规范化只替换一个码点（`\` → `/`），而这两个都是单字节、且不会出现在 UTF-8
/// 多字节序列的续字节里，规范化也不改变字节长度——所以逐字节比较、把 `\` 当作 `/`
/// 就是同一回事。原先的实现对每一次比较都把两个路径各自 `to_runes()` + `StringBuilder`
/// 重建一遍，光这项就占了类型检查的三成。
file_private let source_file_paths_equal(a String, b String) Bool = {
    if a == b then {
        return true;
    };
    let len = a.count();
    if len <> b.count() then {
        return false;
    };
    let ap = a.borrow_ptr();
    let bp = b.borrow_ptr();
    let mutable i UInt = 0;
    while i < len then {
        let mutable x = ap[i];
        let mutable y = bp[i];
        if x == 92(UInt8) then { x = 47(UInt8); };
        if y == 92(UInt8) then { y = 47(UInt8); };
        if x <> y then {
            return false;
        };
        i += 1;
    };
    return true;
};

// Join path segments with separator
public let join_path(segments List[String], sep String) String = {
    let mutable out = StringBuilder.new();
    out.push_string("");
    let mutable first = true;
    for seg in segments then {
        if not first then { out.push_string(sep);};
        out.push_string(seg);
        first = false;
    };
    return out.to_string();
};

// Validate module name: lowercase letter start, only [a-z0-9_]
public let validate_module_name(name String) Option[String] = {
    if name.count() == 0 then {
        return Option[String].Some("Module name cannot be empty");
    };
    let mutable first = true;
    for c in name.runes() then {
        if first then {
            if c < 'a' or c > 'z' then {
                return Option[String].Some("Module name must start with a lowercase letter");
            };
            first = false;
        } else {
            let is_lower = c >= 'a' and c <= 'z';
            let is_digit = c >= '0' and c <= '9';
            let is_underscore = c == '_';
            if not is_lower and not is_digit and not is_underscore then {
                return Option[String].Some("Module name can only contain [a-z0-9_]");
            };
        };
    };
    return Option[String].None();
};
