// Module Resolver - resolves `using` declarations and builds the module graph.
// Mirrors compiler-reference/Sources/KoralCompiler/Module/ModuleResolver.swift
//
// The module graph is not declared anywhere -- it is the `using` statements
// (§5.4). Loading a module therefore means following its imports, which is also
// what makes a cycle detectable: the cycle is in the load stack.
//
// A module import names a PACKAGE and a subpath inside it (§4). The first
// segment is a package name; everything after it is the subpath. There is no
// lookup that skips the package: a bare subpath is not a spelling of anything.

using "std/os" { ... };

// ── ModuleError ───────────────────────────────────────────────────────────────

public type ModuleError {
    FileNotFound(file: String, search_path: String),
    CircularDependency(path: List[String]),
    InvalidModulePath(path: String),
    DuplicateUsing(name: String, span: SourceSpan),
    ParseError(file: String, message: String),
    InvalidEntryFileName(filename: String, reason: String),
    UnknownPackageName(name: String, known: List[String], span: SourceSpan),
    UnknownModule(name: String, package_name: String, declared: List[String], span: SourceSpan),
    NoMainModule(package_name: String, declared: List[String], span: SourceSpan),
    InvalidModuleSpecifier(specifier: String, span: SourceSpan),
    CrossPackageMerge(specifier: String, span: SourceSpan),
    FileClaimedTwice(file: String, owner: String, claimant: String),
};

given ModuleError {
    /// Where the failure is written, when it points at a token. A failure that
    /// names files rather than source (a missing file, a merge ring) has none.
    public span(self): Option[SourceSpan] = when self in {
        .DuplicateUsing(_, span) then Option[SourceSpan].Some(span),
        .UnknownPackageName(_, _, span) then Option[SourceSpan].Some(span),
        .UnknownModule(_, _, _, span) then Option[SourceSpan].Some(span),
        .NoMainModule(_, _, span) then Option[SourceSpan].Some(span),
        .InvalidModuleSpecifier(_, span) then Option[SourceSpan].Some(span),
        .CrossPackageMerge(_, span) then Option[SourceSpan].Some(span),
        _ then Option[SourceSpan].None(),
    };

    /// `path:line:col: error: msg` when it points at a token, `path: error: msg`
    /// when it only names a file. The stage is `error` either way: these are
    /// module-resolution failures, not lexer or parser ones.
    public render(self, fallback_file: String): String = {
        let msg = self.message();
        when self.span() in {
            .Some(span) then {
                if is_known_span(span) then {
                    return "\(fallback_file):\(span.start.line):\(span.start.column): error: \(msg)";
                };
                return "\(fallback_file): error: \(msg)";
            },
            .None() then {
                return "\(fallback_file): error: \(msg)";
            },
        };
    };
};

given ModuleError: Error {
    public message(self): String = {
        return when self in {
            .FileNotFound(file, search_path) then "File '\(file)' not found in '\(search_path)'",
            .CircularDependency(path) then {
                let path_text = join_path(path, " -> ");
                "Circular dependency detected: \(path_text)"
            },
            .InvalidModulePath(path) then "Invalid module path: '\(path)'",
            .DuplicateUsing(name, _) then "Duplicate using declaration for '\(name)'",
            .ParseError(file, message) then "\(file): \(message)",
            .InvalidEntryFileName(filename, reason) then "Invalid entry file name '\(filename)': \(reason)",
            .UnknownPackageName(name, known, _) then {
                let known_list = join_sorted(known);
                let mutable text = "Unknown package name \"\(name)\"\nA name in 'using' is a package name: this package's 'package', one of its 'dependencies' keys, or the reserved \"std\".";
                // The old spelling for merging a file was a bare name. It now
                // reads as a package name that does not exist, so say what each
                // reading would need (§8) instead of leaving the reader to guess.
                if not name.contains("/") then {
                    text = text + "\n  to merge a file, write: using \"./\(name).koral\";\n  to import a module, declare the package in koral.json's dependencies first.";
                };
                text + "\nKnown package names: \(known_list)"
            },
            .UnknownModule(name, package_name, declared, _) then {
                let declared_list = join_sorted(declared);
                "Module '\(name)' does not exist in package '\(package_name)'; declared modules: \(declared_list)"
            },
            .NoMainModule(package_name, declared, _) then {
                let declared_list = join_sorted(declared);
                "Package '\(package_name)' has no main module; write a module subpath like 'pkg/name' instead; declared modules: \(declared_list)"
            },
            .InvalidModuleSpecifier(specifier, _) then "Invalid module name '\(specifier)'; a module name is 'package[/subpath]' with lowercase identifier segments",
            .CrossPackageMerge(specifier, _) then "cannot merge '\(specifier)': merge is limited to the current package; import it with 'using \"\(specifier)\" { ... };'",
            .FileClaimedTwice(file, owner, claimant) then "source file '\(file)' is already part of module '\(owner)' and cannot also join '\(claimant)'",
        };
    };
};

private type PendingUsing {
    Module(specifier: String, span: SourceSpan, items: Option[List[UsingModuleItem]], import_all: Bool),
    LocalModule(specifier: String, span: SourceSpan, items: Option[List[UsingModuleItem]], import_all: Bool),
    File(specifier: String, span: SourceSpan),
};

// ── ModuleResolver ────────────────────────────────────────────────────────────

type mutable ModuleResolverStorage(
    mutable resolving_files: List[String],
    // The packages a `using` name can name. Absent for a bare-file compile,
    // where `using` can only merge files.
    mutable registry: Option[PackageRegistry],
    mutable root_package: Option[LoadedPackage],
    // Root-view full name -> the module it names, as loaded.
    mutable module_index: Dict[String, ResolvedModuleSpec],
    // Modules currently being loaded, for import-cycle detection.
    mutable module_stack: List[String],
    // Which module's closure already claims each source file (§7). A file is
    // compiled into exactly one module; a second claim is an error rather than
    // a second copy of the same declarations under a different identity.
    mutable claimed_files: Dict[String, String],
);

public type mutable ModuleResolver(mutable storage: ModuleResolverStorage);

public type ResolvedModuleGraph(
    root_module_path: String,
    import_graph: ImportGraph,
    loaded_nodes: List[LoadedNode],
    loaded_nodes_with_path: List[Pair[LoadedNode, List[String]]],
    node_source_paths: List[String],
    module_paths: List[List[String]],
    source_files: List[String],
    // Module path (dotted) -> derived symbol key (§5.3.1): what C symbol
    // prefixes derive from, kept beside the name-based `module_paths`.
    module_symbol_keys: Dict[String, String],
);

given ModuleResolver {
    public new(): ModuleResolver = {
        let s = ModuleResolverStorage(
            List[String].new(),
            Option[PackageRegistry].None(),
            Option[LoadedPackage].None(),
            Dict[String, ResolvedModuleSpec].new(),
            List[String].new(),
            Dict[String, String].new(),
        );
        return ModuleResolver(s);
    };

    /// Install the package table `using` names resolve against. Without one,
    /// a module import has nothing it could name and is reported as an unknown
    /// package.
    public set_packages(self, registry: PackageRegistry, root: LoadedPackage): Void = {
        self.storage.registry = Option[PackageRegistry].Some(registry);
        self.storage.root_package = Option[LoadedPackage].Some(root);
    };

    /// Load a module declared in a manifest, and everything its `using`
    /// statements reach, into `unit`.
    public resolve_module_spec(
        self,
        spec: ResolvedModuleSpec,
        unit: CompilationUnit,
    ): Result[ModuleInfo] = {
        // `CompilationUnit` keys modules by their dotted path, so that is the
        // key to look up by -- not the display full name. Two spellings for one
        // module means loading it twice.
        let unit_key = join_path(spec.path_segments, ".");
        when unit.get_module(unit_key) in {
            .Some(existing) then {
                return Result[ModuleInfo].Ok(existing);
            },
            .None() then {},
        };

        // Register before descending so a self-import is a cycle, not a hang.
        let module = ModuleInfo.named(
            spec.path_segments,
            spec.entry_file,
            false,
            spec.full_name,
            package_id_for_kind(spec.package_kind),
            spec.symbol_key,
        );
        unit.add_module(module);
        let key = spec.full_name;
        self.storage.module_index.insert(key, spec);
        self.storage.module_stack.push(key);

        let outcome = self.resolve_file(spec.entry_file, module, unit);
        self.storage.module_stack.pop();
        when outcome in {
            .Ok(_) then {},
            .Error(e) then {
                return Result[ModuleInfo].Error(e);
            },
        };
        return Result[ModuleInfo].Ok(module);
    };

    /// Parse and process a single file into a module.
    private resolve_file(
        self,
        file: String,
        module: ModuleInfo,
        unit: CompilationUnit,
    ): Result[Void] = {
        let normalized_file = when absolute_path(file.into_path()) in {
            .Ok(p) then p.to_string(),
            .Error(_) then file,
        };

        // Circular dependency: same compilation unit, just return
        for f in self.storage.resolving_files then {
            if f == normalized_file then {
                module_debug("[module] circular-skip: \(normalized_file)");
                return Result[Void].Ok({});
            };
        };

        // A source file is compiled into exactly one module's closure (§7).
        // A second claim would give the same declarations two identities.
        let claim_key = join_path(module.path(), ".");
        when self.storage.claimed_files.get(normalized_file) in {
            .Some(owner_key) then {
                if owner_key != claim_key then {
                    return Result[Void].Error(
                        // `Error: ` envelope with no location prefix: the
                        // message names the file and both modules, and the
                        // driver prints a module-resolution failure as text
                        // rather than as a source diagnostic. Both compilers
                        // use this exact shape (§7).
                        "Error: source file '\(normalized_file)' is already part of module '\(owner_key)' and cannot also join '\(claim_key)'",
                    );
                };
            },
            .None() then {
                self.storage.claimed_files.insert(normalized_file, claim_key);
            },
        };

        self.storage.resolving_files.push(normalized_file);
        module_debug("[module] resolve_file: \(normalized_file)");
        // A module is imported once per file (§3.3). A second `using` for the
        // same module cannot mean anything the first did not, and two spellings
        // of one import is exactly the ambiguity the rule exists to prevent.
        let mutable imported_this_file = Set[String].new();
        let pending = self.collect_pending_usings(normalized_file, module, unit) or else as e in {
            self.storage.resolving_files.pop();
            return Result[Void].Error(e);
        };

        for using_decl in pending then {
            when using_decl in {
                .Module(specifier, using_span, items, import_all) then {
                    when self.record_module_using(
                        specifier,
                        using_span,
                        items,
                        import_all,
                        module,
                        unit,
                        normalized_file,
                        imported_this_file,
                    ) in {
                        .Ok(_) then {},
                        .Error(e) then {
                            self.storage.resolving_files.pop();
                            return Result[Void].Error(e);
                        },
                    };
                },
                .LocalModule(specifier, using_span, items, import_all) then {
                    when self.record_local_module_using(
                        specifier,
                        using_span,
                        items,
                        import_all,
                        module,
                        unit,
                        normalized_file,
                        imported_this_file,
                    ) in {
                        .Ok(_) then {},
                        .Error(e) then {
                            self.storage.resolving_files.pop();
                            return Result[Void].Error(e);
                        },
                    };
                },
                .File(specifier, using_span) then {
                    when self.resolve_file_merge(
                        specifier,
                        using_span,
                        module,
                        unit,
                        normalized_file,
                    ) in {
                        .Ok(_) then {},
                        .Error(e) then {
                            self.storage.resolving_files.pop();
                            return Result[Void].Error(e);
                        },
                    };
                },
            };
        };

        self.storage.resolving_files.pop();
        return Result[Void].Ok({});
    };

    private collect_pending_usings(
        self,
        normalized_file: String,
        module: ModuleInfo,
        unit: CompilationUnit,
    ): Result[List[PendingUsing]] = {
        module_debug("[module] read: begin");

        let source = read_text_file(normalized_file.into_path()) or else {
            return Result[List[PendingUsing]].Error(
                "Error: Failed to read file: \(normalized_file)",
            );
        };
        module_debug("[module] read: done");
        module_debug("[module] lex: begin");

        let tokens = lex_in_file(source, normalized_file) or else as e in {
            return Result[List[PendingUsing]].Error(e);
        };
        module_debug("[module] lex: done");
        module_debug("[module] parse: begin");

        let program = parse_in_file(tokens, normalized_file) or else as e in {
            return Result[List[PendingUsing]].Error(e);
        };
        module_debug("[module] parse: done");

        module_debug("[module] decl-loop: begin");

        let mutable pending = List[PendingUsing].new();
        for decl in program.declarations then {
            when decl in {
                .UsingDecl(specifier, items, import_all, span) then {
                    let is_path = specifier.starts_with("./") or specifier.starts_with(
                        "../",
                    ) or specifier.starts_with(".\\") or specifier.starts_with("..\\");
                    if is_path and items is .Some(_) then {
                        // A local path with braces imports from the module
                        // rooted at that entry file (§3.1). The entry file is
                        // the module's identity; no manifest entry is needed.
                        pending.push(.LocalModule(specifier, span, items, import_all));
                    } else if is_path then {
                        pending.push(.File(specifier, span));
                    } else {
                        pending.push(.Module(specifier, span, items, import_all));
                    };
                },
                _ then {
                    module.add_node(decl, normalized_file);
                },
            };
        };

        module_debug("[module] decl-loop: done");
        module_debug(
            "[module] current module node count: \(module.global_nodes().count())",
        );
        return Result[List[PendingUsing]].Ok(pending);
    };

    /// Turn the specifier written in `using` into a declared module and load
    /// it. The first segment names a package in the OWNING package's table --
    /// a dependency's source names its own packages, not the consumer's (§4).
    private resolve_module_import(
        self,
        specifier: String,
        specifier_span: SourceSpan,
        module: ModuleInfo,
        unit: CompilationUnit,
        load: Bool,
    ): Result[ResolvedModuleSpec] = {
        // The specifier is `package[/subpath]`. The first segment is a package
        // name; the rest is the subpath inside it (§4). There is no lookup that
        // skips the package -- a bare subpath is not a spelling of anything.
        let mutable head_name = specifier;
        let mutable tail_segments = List[String].new();
        when specifier.split_once("/") in {
            .Some(pair) then {
                head_name = pair.first;
                for segment in pair.second.split("/") then {
                    tail_segments.push(segment);
                };
            },
            .None() then {},
        };
        if head_name.is_empty() then {
            return Result[ResolvedModuleSpec].Error(
                ModuleError.InvalidModuleSpecifier(specifier, specifier_span).render(
                    module.entry_file(),
                ),
            );
        };

        let registry = self.storage.registry or else {
            return Result[ResolvedModuleSpec].Error(
                ModuleError.UnknownPackageName(head_name, [], specifier_span).render(
                    module.entry_file(),
                ),
            );
        };
        let owner = self.storage.root_package or else {
            return Result[ResolvedModuleSpec].Error(
                ModuleError.UnknownPackageName(head_name, [], specifier_span).render(
                    module.entry_file(),
                ),
            );
        };

        let target_package = registry.resolve_name(head_name, owner) or else {
            return Result[ResolvedModuleSpec].Error(
                ModuleError.UnknownPackageName(
                    head_name,
                    registry.known_names(owner),
                    specifier_span,
                ).render(module.entry_file()),
            );
        };

        // The subpath is what the package calls the module: `"."` written as
        // nothing at all, otherwise the segments joined by `/`.
        let key = if tail_segments.is_empty() then "."
        else tail_segments.join_to_string("/");
        let config = target_package.manifest.modules.get(key) or else {
            if tail_segments.is_empty() then {
                return Result[ResolvedModuleSpec].Error(
                    ModuleError.NoMainModule(
                        target_package.self_name,
                        declared_module_keys(target_package.manifest),
                        specifier_span,
                    ).render(module.entry_file()),
                );
            };
            return Result[ResolvedModuleSpec].Error(
                ModuleError.UnknownModule(
                    head_name + "/" + tail_segments.join_to_string("/"),
                    target_package.self_name,
                    declared_module_keys(target_package.manifest),
                    specifier_span,
                ).render(module.entry_file()),
            );
        };

        let root_name = root_view_name(target_package, registry, owner);
        let spec = make_resolved_module_spec(key, config, root_name, target_package);

        for loaded in self.storage.module_stack then {
            if loaded == spec.full_name then {
                let mutable cycle = List[String].new();
                let mutable started = false;
                for step in self.storage.module_stack then {
                    if step == spec.full_name then {
                        started = true;
                    };
                    if started then {
                        cycle.push(step);
                    };
                };
                cycle.push(spec.full_name);
                return Result[ResolvedModuleSpec].Error(
                    ModuleError.CircularDependency(cycle).render(module.entry_file()),
                );
            };
        };

        if load then {
            let _ = self.resolve_module_spec(spec, unit) or return;
        };
        return Result[ResolvedModuleSpec].Ok(spec);
    };

    private record_module_using(
        self,
        specifier: String,
        specifier_span: SourceSpan,
        items: Option[List[UsingModuleItem]],
        import_all: Bool,
        module: ModuleInfo,
        unit: CompilationUnit,
        current_file: String,
        imported_this_file: Set[String],
    ): Result[Void] = {
        let is_merge = items is .None();
        let spec = self.resolve_module_import(
            specifier,
            specifier_span,
            module,
            unit,
            not is_merge,
        ) or return;
        if imported_this_file.contains(spec.full_name) then {
            return Result[Void].Error(
                ModuleError.DuplicateUsing(spec.full_name, specifier_span).render(
                    module.entry_file(),
                ),
            );
        };
        imported_this_file.insert(spec.full_name);

        // Import edges are scoped to the FILE the `using` is written in: a
        // `using` in one file of a module does not silently apply to its
        // siblings. That is what makes imports meaningful in a multi-file module.
        let import_source_file = Option[String].Some(current_file);
        let target_path = spec.path_segments;
        when items in {
            .None() then {
                // Bare form is a MERGE (§3.2): the target module joins this
                // one and its boundary is gone. It is the same operation the
                // `./` path form performs -- a specifier only says where the
                // target is, not what happens to it.
                return self.merge_module_into(spec, specifier, specifier_span, module, unit);
            },
            .Some(list) then {
                if import_all then {
                    // `{ ... }`, `{ a as b, ... }`, `{ !a, ... }` -- the whole
                    // surface with the listed renames applied and exclusions
                    // removed (§3.3). The filter rides on the batch edge and
                    // stops a renamed/excluded spelling from landing under its
                    // own name; a rename is ALSO a symbol edge so the new
                    // spelling resolves through the ordinary layer 2.
                    unit.add_import_edge(
                        module.path(),
                        target_path,
                        ImportKind.BatchImport(),
                        import_source_file,
                        specifier_span,
                        list,
                    );
                    for item in list then {
                        if item.alias is .Some(_) then {
                            unit.add_symbol_import_edge(
                                module.path(),
                                target_path,
                                item.alias or else item.name,
                                ImportKind.MemberImport(),
                                import_source_file,
                                Option[String].Some(item.name),
                                specifier_span,
                            );
                        };
                    };
                } else if list.is_empty() then {
                    // `{ }` -- a placeholder with no member surface (§3.3).
                    // It is a dependency edge and nothing more: no names, and
                    // (once §3.4 lands) no methods.
                    unit.add_import_edge(
                        module.path(),
                        target_path,
                        ImportKind.ModuleImport(),
                        import_source_file,
                        specifier_span,
                        List[UsingModuleItem].new(),
                    );
                } else {
                    for item in list then {
                        unit.add_symbol_import_edge(
                            module.path(),
                            target_path,
                            item.alias or else item.name,
                            ImportKind.MemberImport(),
                            import_source_file,
                            Option[String].Some(item.name),
                            specifier_span,
                        );
                    };
                };
            },
        };
        return Result[Void].Ok({});
    };

    /// Import from a local module named by its entry file (§3.1). A local path
    /// with braces needs no manifest entry: the entry file IS the module, and
    /// its identity is the entry's position inside its package (§5.3.1) -- the
    /// same rule a registered module gets, unregistered or not. The symbol
    /// prefix is the derived identity key `module_symbol_key`, which is why
    /// renaming a dependency key moves no ABI symbol.
    ///
    /// The target module is created on first reference if nothing claimed it.
    /// Once it exists it is a module like any other -- it can also be merged
    /// (bare form) or imported by name if a manifest entry names it.
    private record_local_module_using(
        self,
        specifier: String,
        specifier_span: SourceSpan,
        items: Option[List[UsingModuleItem]],
        import_all: Bool,
        module: ModuleInfo,
        unit: CompilationUnit,
        current_file: String,
        imported_this_file: Set[String],
    ): Result[Void] = {
        let current_dir = current_file.into_path().dir_name().to_string();
        let mutable target = current_dir.into_path();
        for segment in specifier.split("/") then {
            if segment == "." or segment.is_empty() then {
                continue;
            };
            if segment == ".." then {
                target = target.dir_name();
            } else {
                target = target.join(segment);
            };
        };
        let entry_abs = when absolute_path(target) in {
            .Ok(p) then p.to_string(),
            .Error(_) then target.to_string(),
        };
        if not path_exist(entry_abs.into_path()) then {
            return Result[Void].Error(
                ModuleError.FileNotFound(specifier, current_dir).render(
                    module.entry_file(),
                ),
            );
        };
        if imported_this_file.contains(entry_abs) then {
            return Result[Void].Error(
                ModuleError.DuplicateUsing(specifier, specifier_span).render(
                    module.entry_file(),
                ),
            );
        };
        imported_this_file.insert(entry_abs);

        // Identity = (package source, entry position) (§5.3.1). The path
        // segments keep the entry's position inside the package, so
        // `util/util.koral` and `helpers/util.koral` never share a unit slot,
        // a name key, or a symbol prefix again.
        // Load the target as its own module so its declarations exist under
        // `target_path` and the boundary stays (§3.1). `resolve_module_spec`
        // is idempotent on the unit key, so a second `using` of the same entry
        // reuses the module rather than loading it twice.
        let owner = self.storage.root_package or else {
            return Result[Void].Error(
                ModuleError.FileNotFound(specifier, current_dir).render(
                    module.entry_file(),
                ),
            );
        };
        let package_root = owner.manifest.package_root;
        let rel = entry_relative_path(entry_abs, package_root);
        let target_path = symbol_key_segments(rel);
        let spec = ResolvedModuleSpec(
            target_path.join_to_string("/"),
            target_path,
            module_symbol_key(package_source_tag(owner), entry_abs, package_root),
            rel,
            rel,
            entry_abs,
            List[String].new(),
            owner.identity,
            owner.kind,
            owner,
        );
        let _ = self.resolve_module_spec(spec, unit) or return;

        let mutable list = items or else List[UsingModuleItem].new();
        let import_source_file = Option[String].Some(current_file);
        if import_all then {
            unit.add_import_edge(
                module.path(),
                target_path,
                ImportKind.BatchImport(),
                import_source_file,
                specifier_span,
                list,
            );
            for item in list then {
                if item.alias is .Some(_) then {
                    unit.add_symbol_import_edge(
                        module.path(),
                        target_path,
                        item.alias or else item.name,
                        ImportKind.MemberImport(),
                        import_source_file,
                        Option[String].Some(item.name),
                        specifier_span,
                    );
                };
            };
        } else if list.is_empty() then {
            unit.add_import_edge(
                module.path(),
                target_path,
                ImportKind.ModuleImport(),
                import_source_file,
                specifier_span,
                List[UsingModuleItem].new(),
            );
        } else {
            for item in list then {
                unit.add_symbol_import_edge(
                    module.path(),
                    target_path,
                    item.alias or else item.name,
                    ImportKind.MemberImport(),
                    import_source_file,
                    Option[String].Some(item.name),
                    specifier_span,
                );
            };
        };
        return Result[Void].Ok({});
    };

    /// The `package_root` of the registered package whose source tree contains
    /// `file_path` -- longest match wins, since a path dependency may sit inside
    /// the root package's tree. `None` when no package claims the file.
    private package_root_containing(self, file_path: String): Option[String] = {
        let entry_path = (when absolute_path(file_path.into_path()) in {
            .Ok(p) then p,
            .Error(_) then file_path.into_path(),
        }).normalize();
        let mutable candidates = List[LoadedPackage].new();
        when self.storage.root_package in {
            .Some(pkg) then candidates.push(pkg),
            .None() then {},
        };
        when self.storage.registry in {
            .Some(reg) then {
                for pkg in reg.all then {
                    candidates.push(pkg);
                };
            },
            .None() then {},
        };
        let mutable best = Option[String].None();
        let mutable best_len: UInt = 0;
        let entry_str = entry_path.to_string();
        for pkg in candidates then {
            let root_str = pkg.manifest.package_root.into_path().normalize().to_string();
            // Segment boundary, not raw prefix: `root/src` must not claim
            // `root/src2/file.koral`.
            if entry_str == root_str or entry_str.starts_with(root_str + "/") then {
                let len = root_str.count();
                if len > best_len then {
                    best_len = len;
                    best = Option[String].Some(root_str);
                };
            };
        };
        return best;
    };

    /// Merge a whole module into the current one (§3.2). The bare form of
    /// `using "spec";` lands here for a registered module exactly as it does
    /// for a local entry file -- a specifier says where the target is, the
    /// braces say whether its boundary survives.
    ///
    /// The target's boundary is gone afterwards: its `internal` names are
    /// this module's `internal` names. It may therefore be merged into at
    /// most one module, and once merged it can no longer be imported (§7).
    private merge_module_into(
        self,
        spec: ResolvedModuleSpec,
        specifier: String,
        specifier_span: SourceSpan,
        module: ModuleInfo,
        unit: CompilationUnit,
    ): Result[Void] = {
        // Merge dissolves the target's boundary, so it stays inside one package
        // (§3.2): the target's `internal` names become this module's and
        // its declarations join this package's identity. Another package's
        // module can only be imported, never merged.
        if package_id_for_kind(spec.package_kind) != module.package_id() then {
            return Result[Void].Error(
                ModuleError.CrossPackageMerge(specifier, specifier_span).render(
                    module.entry_file(),
                ),
            );
        };
        let target = when absolute_path(spec.entry_file.into_path()) in {
            .Ok(p) then p.to_string(),
            .Error(_) then spec.entry_file,
        };
        if module.has_merged_submodule(target) then {
            return Result[Void].Error(
                ModuleError.DuplicateUsing(specifier, specifier_span).render(
                    module.entry_file(),
                ),
            );
        };
        module.add_merged_submodule(target);
        // `resolve_file` walks the target's own merge closure, so the whole
        // module -- entry plus everything it merges -- joins this one.
        let _ = self.resolve_file(target, module, unit) or return;
        return Result[Void].Ok({});
    };

    // Resolve file merge: using "file_name"
    // Resolves a normalized relative source path against the current file's directory and merges it.
    private resolve_file_merge(
        self,
        file_name: String,
        using_span: SourceSpan,
        module: ModuleInfo,
        unit: CompilationUnit,
        current_file: String,
    ): Result[Void] = {
        let current_dir = current_file.into_path().dir_name().to_string();
        if not file_name.ends_with(".koral") then {
            return Result[Void].Error(
                "File merge path must end in '.koral'; write '\(file_name).koral'",
            );
        };

        // Resolve `.` / `..` ourselves. `join` keeps them, so `./a.koral` and
        // `a.koral` would be two names for one file -- and then neither the
        // cycle check nor the duplicate check would see the other.
        let mutable target = current_dir.into_path();
        for segment in file_name.split("/") then {
            if segment == "." or segment.is_empty() then {
                continue;
            };
            if segment == ".." then {
                target = target.dir_name();
            } else {
                target = target.join(segment);
            };
        };
        let file_path = target.to_string();

        if not path_exist(file_path.into_path()) then {
            return Result[Void].Error(
                ModuleError.FileNotFound(file_name, current_dir).render(
                    module.entry_file(),
                ),
            );
        };

        // Merge claims ownership, so the target must live inside the current
        // package's source tree (§3.2) -- the same rule the bare form enforces
        // by package identity. With no package claiming the current file there
        // is no boundary to respect.
        when self.package_root_containing(current_file) in {
            .Some(my_root) then {
                let mutable same_package = false;
                when self.package_root_containing(file_path) in {
                    .Some(target_root) then {
                        if target_root == my_root then {
                            same_package = true;
                        };
                    },
                    .None() then {},
                };
                if not same_package then {
                    return Result[Void].Error(
                        ModuleError.CrossPackageMerge(file_name, using_span).render(
                            module.entry_file(),
                        ),
                    );
                };
            },
            .None() then {},
        };

        // A merge cycle means each file is waiting on the other's definitions
        // (§7.22). Check before the duplicate-merge case: in a ring the file is
        // still being assembled, which is the more specific story.
        for f in self.storage.resolving_files then {
            if f == file_path then {
                let mutable cycle = List[String].new();
                for step in self.storage.resolving_files then {
                    cycle.push(step);
                };
                cycle.push(file_path);
                return Result[Void].Error(
                    ModuleError.CircularDependency(cycle).render(module.entry_file()),
                );
            };
        };

        if module.has_merged_submodule(file_path) then {
            return Result[Void].Error(
                ModuleError.DuplicateUsing(file_name, using_span).render(
                    module.entry_file(),
                ),
            );
        };

        module.add_merged_submodule(file_path);
        return self.resolve_file(file_path, module, unit);
    };

    /// Load a bare file's contents into an already-created module. There is no
    /// package table behind a bare file, so a module import here has nothing it
    /// could name.
    public resolve_single_file(
        self,
        module: ModuleInfo,
        unit: CompilationUnit,
    ): Result[Void] = {
        return self.resolve_file(module.entry_file(), module, unit);
    };

    // Main entry: resolve a module from its entry file.
    public resolve_module_with_path(
        self,
        entry_file: String,
        root_module_path: Option[List[String]],
    ): Result[CompilationUnit] = {
        let abs_path = when absolute_path(entry_file.into_path()) in {
            .Ok(p) then p.to_string(),
            .Error(e) then {
                return Result[CompilationUnit].Error(
                    "Cannot resolve path: \(entry_file)",
                );
            },
        };

        module_debug("[module] resolve_module: \(abs_path)");

        let filename = abs_path.into_path().with_ext_name("").base_name();

        if validate_module_name(filename) is .Some(reason) then {
            return Result[CompilationUnit].Error(
                "Invalid entry file name '\(filename)': \(reason)",
            );
        };

        let mutable root_path = when root_module_path in {
            .Some(path) then path,
            .None() then {
                let mutable default_path = List[String].new();
                default_path.push(module_file_name_to_identifier(filename));
                default_path
            },
        };
        // A bare entry has no package behind it; its identity source is the
        // fixed `single:` tag and its position is the entry's own name (§5.3.1
        // degenerate case).
        let root = ModuleInfo.named(
            root_path,
            abs_path,
            false,
            join_path(root_path, "."),
            "",
            module_symbol_key(
                "single",
                abs_path,
                abs_path.into_path().dir_name().to_string(),
            ),
        );
        let unit = CompilationUnit.new(root);

        let _ = self.resolve_file(abs_path, root, unit) or return;
        module_debug(
            "[module] root-local nodes after resolve: \(root.global_nodes().count())",
        );

        return Result[CompilationUnit].Ok(unit);
    };

    public resolve_module(self, entry_file: String): Result[CompilationUnit] = {
        return self.resolve_module_with_path(entry_file, Option[List[String]].None());
    };

    /// Resolve a bare file plus the standard-library prelude.
    ///
    /// The prelude is NOT part of the `using` graph -- it is the base the graph
    /// sits on (§6.4's "主模块是基础层"). Everything else is whatever the file's
    /// own `using` statements reach.
    /// Resolve a bare file plus the standard-library prelude.
    ///
    /// The prelude is NOT part of the `using` graph -- it is the base the graph
    /// sits on (§6.4's "主模块是基础层"). Everything else is whatever the file's
    /// own `using` statements reach.
    public resolve_for_typecheck(
        self,
        entry_file: String,
        no_std: Bool,
    ): Result[ResolvedModuleGraph] = {
        let abs_path = when absolute_path(entry_file.into_path()) in {
            .Ok(p) then p.to_string(),
            .Error(_) then entry_file,
        };
        let filename = abs_path.into_path().with_ext_name("").base_name();
        let root_path = List[String].new();
        root_path.push(module_file_name_to_identifier(filename));
        let root = ModuleInfo.named(
            root_path,
            abs_path,
            false,
            filename,
            "root:user",
            module_symbol_key(
                "single",
                abs_path,
                abs_path.into_path().dir_name().to_string(),
            ),
        );

        // ONE unit: the prelude and the file's own `using` may name the same
        // module, and compiling it twice would define its symbols twice.
        let unit = CompilationUnit.empty();
        unit.add_module(root);

        if not no_std then {
            let std_path = find_std_manifest_path() or else {
                return Result[ResolvedModuleGraph].Error("standard library not found");
            };
            let registry = load_package_registry(
                std_path,
                Option[String].Some(std_path),
                Option[String].None(),
            ) or return;
            let std_package = registry.std_package or else {
                return Result[ResolvedModuleGraph].Error("standard library not found");
            };
            self.set_packages(registry, std_package);
            when prelude_module_spec(registry) in {
                .Some(spec) then {
                    let _ = self.resolve_module_spec(spec, unit) or return;
                },
                .None() then {},
            };
        };

        let _ = self.resolve_single_file(root, unit) or return;

        let all_pairs = unit.collect_all_nodes_with_path();

        let mutable loaded_nodes = List[LoadedNode].new();
        let mutable node_source_paths = List[String].new();
        for pair in all_pairs.iterator() then {
            loaded_nodes.push(pair.first);
            node_source_paths.push(pair.first.source_file);
        };

        return Result[ResolvedModuleGraph].Ok(
            ResolvedModuleGraph(
                root.path_string(),
                unit.import_graph(),
                loaded_nodes,
                all_pairs,
                node_source_paths,
                self.collect_unique_module_paths(all_pairs),
                self.collect_unique_sources(loaded_nodes),
                unit.module_symbol_keys(),
            ),
        );
    };

    /// Every module spec this resolver has loaded, in no particular order.
    public loaded_module_specs(self): List[ResolvedModuleSpec] = {
        let mutable specs = List[ResolvedModuleSpec].new();
        for kv in self.storage.module_index.iterator() then {
            specs.push(kv.second);
        };
        return specs;
    };

    private collect_unique_module_paths(
        self,
        loaded_nodes_with_path: List[Pair[LoadedNode, List[String]]],
    ): List[List[String]] = {
        let mutable seen = Set[String].new();
        let mutable module_paths = List[List[String]].new();
        for pair in loaded_nodes_with_path.iterator() then {
            let path = pair.second;
            let key = join_path(path, ".");
            if not seen.contains(key) then {
                seen.insert(key);
                module_paths.push(path);
            };
        };
        let _ = self;
        return module_paths;
    };

    private collect_unique_sources(self, loaded_nodes: List[LoadedNode]): List[String] = {
        let mutable seen = Set[String].new();
        let mutable source_files = List[String].new();
        for node in loaded_nodes.iterator() then {
            if not seen.contains(node.source_file) then {
                seen.insert(node.source_file);
                source_files.push(node.source_file);
            };
        };
        let _ = self;
        return source_files;
    };
};

// ── Helpers ───────────────────────────────────────────────────────────────────

/// `"std:std"` / `"root:<name>"` / `"dependency:<key>"` -- the tag later passes
/// key cross-package visibility on.
public let package_id_for_kind(kind: ResolvedPackageKind): String = when kind in {
    .Root() then "root:user",
    .Std() then "std:std",
    .Dependency(key) then "dependency:\(key)",
};

/// Whether `package_id` is std's. Decided by the identity
/// `package_id_for_kind` mints -- never by a module path or a user spelling,
/// either of which a package can choose freely.
public let is_std_package_id(package_id: String): Bool = {
    return package_id == package_id_for_kind(.Std());
};

/// Sorted, comma-joined -- or `<none>` when there is nothing to list. Order
/// must not depend on hash iteration, because the text is compared across
/// compilers.
private let join_sorted(values: List[String]): String = {
    if values.is_empty() then {
        return "<none>";
    };
    let mutable sorted = values;
    sorted.sort();
    return sorted.join_to_string(", ");
};

/// The keys a package's manifest declares, for "module not found" messages.
public let declared_module_keys(manifest: PackageManifest): List[String] = {
    let mutable keys = List[String].new();
    let mutable iter = manifest.modules.iterator();
    while iter.next() is .Some(entry) then {
        keys.push(entry.first);
    };
    keys.sort();
    return keys;
};

// Convert PascalCase module identifier to snake_case file name
// e.g. "Primitives" -> "primitives", "BufReader" -> "buf_reader", "Std" -> "std"
public let module_identifier_to_file_name(identifier: String): String = {
    if identifier.is_empty() then {
        return identifier;
    };
    let mutable result = StringBuilder.new();
    let runes = identifier.to_runes();
    let mutable first = true;
    for ch in runes then {
        if ch.is_ascii_uppercase() then {
            if not first then {
                result.push_byte('_');
            };
            result.push_rune(ch.to_ascii_lowercase());
        } else {
            result.push_rune(ch);
        };
        first = false;
    };
    return result.to_string();
};

// Render a module path as the `using` specifier a user would actually write.
// ["Std", "Time"] -> "std/time". Diagnostics must quote code, not internal names.
public let module_path_to_using_specifier(module_path: List[String]): String = {
    let mutable parts = List[String].new();
    for seg in module_path then {
        parts.push(module_identifier_to_file_name(seg));
    };
    return parts.join_to_string("/");
};

// Convert snake_case file name to PascalCase module identifier
// e.g. "primitives" -> "Primitives", "buf_reader" -> "BufReader"
public let module_file_name_to_identifier(filename: String): String = {
    let mutable result = StringBuilder.new();
    let mutable capitalize_next = true;
    let runes = filename.to_runes();
    for ch in runes then {
        if ch == '_' then {
            capitalize_next = true;
        } else if capitalize_next and ch.is_ascii_lowercase() then {
            result.push_rune(ch.to_ascii_uppercase());
            capitalize_next = false;
        } else {
            result.push_rune(ch);
            capitalize_next = false;
        };
    };
    return result.to_string();
};

private let module_debug(message: String): Void = {
    if env("KORAL_DEBUG_MODULE") is .Some(v) and (v == "1" or v == "true" or v == "TRUE") then {
        eprintln(message);
    };
};
