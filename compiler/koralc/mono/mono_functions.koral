// Generic function instantiation for the monomorphization phase.
// Implements instantiate_function, and stubs for instantiate_extension_method
// and instantiate_trait_placeholder_method (implemented in tasks 6.2 and 6.6).
//

// ── instantiate_function ──────────────────────────────────────────────────────

// Instantiate a generic function template with concrete type arguments.
//
// Steps:
//   a. If any type arg contains an unresolved GenericParameter, skip code generation
//      and return a partial InstantiatedFunction with empty mangled name
//   b. Generate the mangled name using make_layout_name
//   c. Check instantiated_functions cache
//   d. Check instantiating_functions for cycle detection
//   e. Add to instantiating_functions
//   f. Build type substitution map: template.type_parameters[i].name → args[i]
//   g. Resolve parameter types and return type using resolve_type_node
//   h. Build the concrete FunctionType
//   i. Create InstantiatedFunction and cache it BEFORE processing the body
//   j. Get the checked body: use template.checked_body if Some, otherwise look up from registry
//   k. If body exists, call substitute_types_in_expression to replace generic params
//   l. Create a FunctionDecl node and add to generated_nodes
//   m. Remove from instantiating_functions
//   n. Return the InstantiatedFunction
//
file_private let make_mono_function_body_placeholder_expr(t Type) TypedExpr = {
    return TypedExpr(TypedExprKind.IntegerLiteral("0"), t, unknown_span());
};

file_private let pass_kind_from_type_node(node TypeNode) FunctionParamPassKind = {
    return when node in {
        .Reference(_, is_mutable, span) then if is_mutable then FunctionParamPassKind.ByMutableReference(
        ) else FunctionParamPassKind.ByReference(),
        .BorrowedReference(_, is_mutable, span) then if is_mutable then FunctionParamPassKind.ByMutableReference(
        ) else FunctionParamPassKind.ByReference(),
        _ then FunctionParamPassKind.ByValue(),
    };
};

file_private let skip_instantiation_with_unsatisfied_constraints(
    mono Monomorphizer,
    template GenericFunctionTemplate,
    args List[Type],
) Bool = {
    let mutable i UInt = 0;
    while i < template.type_parameters.count() and i < args.count() then {
        let param = template.type_parameters[i];
        let mutable actual_type = resolve_parameterized_type(mono, (args[i]));
        for constraint in param.constraints then {
            // Shape bounds (`mutable` / `foreign`) do not suppress instantiation
            // here: sema already rejects a call that violates one, and skipping
            // the instantiation of a function the compiler itself still needs
            // leaves a hole in the emitted C.
            //
            // A trait bound carries the DECLARATION it requires, resolved when
            // the template was registered in the module that wrote it.
            when constraint in {
                .Trait(trait_def_id, _, _) then {
                    if not type_satisfies_trait_constraint(
                        mono,
                        actual_type,
                        trait_def_id,
                    ) then {
                        return true;
                    };
                },
                .Mutable() or .Foreign() then {},
            };
        };
        i += 1;
    };
    return false;
};

public let instantiate_function(
    mono Monomorphizer,
    template GenericFunctionTemplate,
    args List[Type],
) InstantiatedFunction = {
    // a. If any type arg contains an unresolved GenericParameter, skip code generation
    //    and return a partial InstantiatedFunction with empty mangled name.
    if args_have_generic_parameter(args) then {
        return InstantiatedFunction("", Type.Unknown());
    };

    // Defensive guard: if inferred type args do not fully match template arity,
    // skip instantiation and let callers fall back to existing symbol resolution.
    if args.count() != template.type_parameters.count() then {
        return InstantiatedFunction("", Type.Unknown());
    };

    // A generic declaration is a member only where its constraints hold.
    // Speculative instantiations routinely violate them (e.g. `Random.next[T
    // Randomizable]`, or `Iterator.sum` needing `T: Add[T] and Zero`); those must
    // not be emitted. Mirrors Swift's `enforceGenericConstraints`.
    if skip_instantiation_with_unsatisfied_constraints(mono, template, args) then {
        return InstantiatedFunction("", Type.Unknown());
    };

    // b. Generate the mangled name.
    let mangled_name = make_layout_name(mono, template.name, args, template.def_id);

    // c. Check instantiated_functions cache.
    when mono.storage.instantiated_functions.get(mangled_name) in {
        .Some(cached) then {
            return cached;
        },
        .None() then {},
    };

    // d. Check instantiating_functions for cycle detection.
    if mono.storage.instantiating_functions.contains(mangled_name) then {
        // Return a partial result to yield the cycle; the cache will be populated
        // once the outer instantiation completes.
        return InstantiatedFunction(mangled_name, Type.Unknown());
    };

    // e. Add to instantiating_functions.
    mono.storage.instantiating_functions.insert(mangled_name);

    // f. Build type substitution map: template.type_parameters[i].name → args[i].
    let mutable substitution = Dict[String, Type].new();
    let mutable param_idx = UInt(0);
    while param_idx < template.type_parameters.count() then {
        let param = template.type_parameters[param_idx];
        let arg = args[param_idx];
        substitution.insert(param.name, arg);
        param_idx += UInt(1);
    };

    // g. Resolve parameter types and return type using resolve_type_node.
    let mutable concrete_param_types = List[Type].new();
    let mutable concrete_params = List[TypedParam].new();

    // Use checked_parameters if available, otherwise resolve from template parameters.
    when template.checked_parameters in {
        .Some(checked_params_list) then {
            for sym in checked_params_list then {
                let mutable substituted_type = mono.substitute_type_impl(
                    sym.symbol_type,
                    substitution,
                );
                let mutable resolved_type = resolve_parameterized_type(
                    mono,
                    substituted_type,
                );
                concrete_params.push(
                    TypedParam(
                        mono.storage.context.symbol_name(sym),
                        sym.is_mutable(),
                        resolved_type,
                        false,
                    ),
                );
                concrete_param_types.push(resolved_type);
            };
        },
        .None() then {
            // Fall back to resolving from template parameters via TypeNode.
            let node_subst = template_substitution(
                template.type_parameters,
                substitution,
            );
            for p in template.parameters then {
                let mutable resolved_type = mono.resolve_type_node_impl(
                    p.param_type,
                    node_subst,
                );
                concrete_params.push(
                    TypedParam(p.name, p.is_mutable, resolved_type, p.named),
                );
                concrete_param_types.push(resolved_type);
            };
        },
    };

    // Resolve return type.
    let concrete_return_type = when template.checked_return_type in {
        .Some(checked_ret) then resolve_parameterized_type(
            mono,
            mono.substitute_type_impl(checked_ret, substitution),
        ),
        .None() then mono.resolve_type_node_impl(
            template.return_type,
            template_substitution(template.type_parameters, substitution),
        ),
    };

    // h. Build the concrete FunctionType, preserving declared pass kinds.
    let mutable function_param_entries = List[FunctionParamEntry].new();
    let mutable function_param_index = UInt(0);
    while function_param_index < concrete_params.count() then {
        let declared_param = template.parameters[function_param_index];
        function_param_entries.push(
            FunctionParamEntry(
                concrete_params[function_param_index].param_type,
                pass_kind_from_type_node(declared_param.param_type),
            ),
        );
        function_param_index += UInt(1);
    };
    let function_type = Type.FunctionType(function_param_entries, concrete_return_type);

    let template_module_path = mono.storage.context.get_module_path(template.def_id) or else List[String].new(
    );
    let template_source_file = mono.storage.context.get_source_file(template.def_id) or else "";
    let template_access = mono.storage.context.get_access(template.def_id) or else AccessModifier.Public(
    );
    let template_span = mono.storage.context.get_span(template.def_id) or else unknown_span(
    );

    // Allocate a new DefId for the concrete function with full metadata so
    // later phases can recover it from the emitted declaration structurally.
    let def_id = mono.storage.context.allocate_full(
        mangled_name,
        DefKind.Function(),
        template_module_path,
        template_source_file,
        template_access,
        template_span,
    );

    // Register the function signature in the DefIdMap.
    let mutable param_specs = List[FunctionParamSpec].new();
    for p in concrete_params then {
        param_specs.push(FunctionParamSpec(p.name, p.is_mutable, p.named, false));
    };
    mono.storage.context.set_symbol_info(
        def_id,
        SymbolInfo(function_type, SymbolKind.Function(), MethodKind.Normal(), false),
    );
    mono.storage.context.set_param_specs(def_id, param_specs);
    mono.storage.context.set_cname(def_id, mangled_name);

    // i. Create InstantiatedFunction and cache it BEFORE processing the body
    //    to support recursive functions.
    let result = InstantiatedFunction(mangled_name, function_type);
    mono.storage.instantiated_functions.insert(mangled_name, result);

    // Also register the symbol for this function.
    let func_symbol = Symbol(def_id, function_type, SymbolKind.Function());
    mono.storage.instantiated_function_symbols.insert(mangled_name, func_symbol);

    // Record the DefId remapping from the generic template's DefId to the concrete one.
    when mono.storage.remapped_function_def_ids.get(template.def_id.id) in {
        .Some(existing_list) then {
            let mutable updated = existing_list;
            updated.push(Pair(def_id, function_type));
            mono.storage.remapped_function_def_ids.insert(template.def_id.id, updated);
        },
        .None() then {
            let mutable new_list = List[Pair[DefId, Type]].new();
            new_list.push(Pair(def_id, function_type));
            mono.storage.remapped_function_def_ids.insert(template.def_id.id, new_list);
        },
    };

    // Register ConcreteCallableInfo with owner_type=None so the codegen
    // uses the mangled name directly (without current_function_type_prefix).
    mono.register_concrete_callable_if_absent(
        ConcreteCallableInfo(
            def_id,
            mangled_name,
            Option[Type].None(),
            Option[String].None(),
            Option[DefId].None(),
        ),
    );

    // j. Get the checked body: use template.checked_body if Some,
    //    otherwise look up from GenericTemplateRegistry.
    let body_opt = when template.checked_body in {
        .Some(body) then Option[TypedExpr].Some(body),
        .None() then {
            // Look up the latest version from the registry.
            when mono.storage.generic_templates.lookup_function_by_def_id(
                template.def_id,
            ) in {
                .Some(latest_template_ref) then {
                    when latest_template_ref.checked_body in {
                        .Some(latest_body) then Option[TypedExpr].Some(latest_body),
                        .None() then Option[TypedExpr].None(),
                    }
                },
                .None() then {
                    when mono.storage.generic_templates.lookup_function(template.name) in {
                        .Some(latest_template_ref) then {
                            when latest_template_ref.checked_body in {
                                .Some(latest_body) then Option[TypedExpr].Some(
                                    latest_body,
                                ),
                                .None() then Option[TypedExpr].None(),
                            }
                        },
                        .None() then Option[TypedExpr].None(),
                    }
                },
            }
        },
    };

    // k. If body exists, substitute generic params with concrete types.
    when body_opt in {
        .Some(body) then {
            let concrete_body = mono.substitute_types_in_expression_impl(
                body,
                substitution,
            );
            let resolved_concrete_body = resolve_types_in_expression(mono, concrete_body);
            let mutable context = mono.storage.context;
            context.set_concrete_function_body(def_id, resolved_concrete_body);
            mono.storage.resolved_function_body_ids.insert(def_id.id);

            // l. Create a FunctionDecl node and add to generated_nodes.
            let mutable fn_param_type_refs = List[Type].new();
            for cp in concrete_params then {
                fn_param_type_refs.push(cp.param_type);
            };
            let decl = TypedDecl.FunctionDecl(
                template_access,
                mangled_name,
                concrete_params,
                concrete_return_type,
                make_mono_function_body_placeholder_expr(concrete_return_type),
                template_span,
                Symbol(def_id, function_type, SymbolKind.Function()),
            );
            mono.storage.generated_nodes.push(decl);
        },
        .None() then {
            // No body available — this is an intrinsic or forward declaration.
            // Emit an IntrinsicFunctionDecl so the symbol is still visible.
            let decl = TypedDecl.IntrinsicFunctionDecl(
                template_access,
                mangled_name,
                concrete_params,
                concrete_return_type,
                template_span,
                Symbol(def_id, Type.Unknown(), SymbolKind.Function()),
            );
            mono.storage.generated_nodes.push(decl);
        },
    };

    // m. Remove from instantiating_functions.
    mono.storage.instantiating_functions.remove(mangled_name);

    // n. Return the InstantiatedFunction.
    return result;
};

// ── select_extension_template ─────────────────────────────────────────────────

// Select the best matching extension method template from a list of candidates.
//
// Filters by:
//   - method name must match
//   - method type mutable parameter count must match (if provided)
//   - extension type mutable parameter count must match (if provided)
//
// Among matching candidates, prefer one with a checked body source.
//
public let select_extension_template(
    extensions List[GenericExtensionMethodTemplate],
    name String,
    method_type_arg_count Option[UInt],
    extension_type_arg_count Option[UInt],
) Option[GenericExtensionMethodTemplate] = {
    let mutable first_match = Option[GenericExtensionMethodTemplate].None();
    for ext_ref in extensions then {
        if ext_ref.method.name != name then {
            continue;
        };
        when method_type_arg_count in {
            .Some(count) then {
                if ext_ref.method.type_params.count() != count then {
                    continue;
                };
            },
            .None() then {},
        };
        when extension_type_arg_count in {
            .Some(count) then {
                if ext_ref.type_params.count() != count then {
                    continue;
                };
            },
            .None() then {},
        };
        if ext_ref.checked_body is .Some(_) then {
            return Option[GenericExtensionMethodTemplate].Some(ext_ref);
        };
        when first_match in {
            .Some(_) then {},
            .None() then {
                first_match = Option[GenericExtensionMethodTemplate].Some(ext_ref);
            },
        };
    };
    return first_match;
};

file_private let select_conformance_extension_template(
    mono Monomorphizer,
    base_type Type,
    method_name String,
    method_type_arg_count Option[UInt],
) Option[GenericExtensionMethodTemplate] = {
    let mutable parameterized_base_type = resolve_parameterized_type(mono, base_type);
    let count_key = when method_type_arg_count in {
        .Some(count) then count.to_string(),
        .None() then "*",
    };
    let cache_key = "\(stable_type_key(parameterized_base_type))|\(method_name)|\(count_key)";
    if mono.storage.conformance_extension_template_missing.contains(cache_key) then {
        return Option[GenericExtensionMethodTemplate].None();
    };
    when mono.storage.conformance_extension_template_cache.get(cache_key) in {
        .Some(cached) then {
            return Option[GenericExtensionMethodTemplate].Some(cached);
        },
        .None() then {},
    };

    let mutable first_match = Option[GenericExtensionMethodTemplate].None();
    for ext_entry in mono.storage.generic_templates.extension_methods then {
        for ext_ref in ext_entry.second then {
            if ext_ref.method.name != method_name then {
                continue;
            };
            when method_type_arg_count in {
                .Some(count) then {
                    if ext_ref.method.type_params.count() != count then {
                        continue;
                    };
                },
                .None() then {},
            };
            let target_type = when ext_ref.conformance_target_type in {
                .Some(target) then target,
                .None() then {
                    continue;
                },
            };
            if not trait_conformance_target_matches(
                mono,
                target_type,
                parameterized_base_type,
            ) and not trait_conformance_target_matches_for_template_binding(
                mono,
                target_type,
                parameterized_base_type,
            ) then {
                continue;
            };
            if ext_ref.checked_body is .Some(_) then {
                mono.storage.conformance_extension_template_cache.insert(
                    cache_key,
                    ext_ref,
                );
                return Option[GenericExtensionMethodTemplate].Some(ext_ref);
            };
            when first_match in {
                .Some(_) then {},
                .None() then {
                    first_match = Option[GenericExtensionMethodTemplate].Some(ext_ref);
                },
            };
        };
    };
    when first_match in {
        .Some(template_ref) then {
            mono.storage.conformance_extension_template_cache.insert(
                cache_key,
                template_ref,
            );
        },
        .None() then {
            mono.storage.conformance_extension_template_missing.insert(cache_key);
        },
    };
    return first_match;
};

file_private let patched_extension_template_with_body(
    template GenericExtensionMethodTemplate,
    donor GenericExtensionMethodTemplate,
) GenericExtensionMethodTemplate = {
    return GenericExtensionMethodTemplate(
        template.type_params,
        donor.method,
        template.conformance_trait_name,
        template.conformance_trait_def_id,
        template.trait_method_def_id,
        template.conformance_target_type,
        template.conformance_trait_args,
        template.uses_trait_type_params,
        template.source_file,
        template.module_path,
        template.package_id,
        donor.checked_body,
        donor.checked_parameters,
        donor.checked_return_type,
        if donor.tool_type_params.is_empty() then template.tool_type_params
        else donor.tool_type_params,
    );
};

public let lookup_extension_template_checked_body(
    mono Monomorphizer,
    template GenericExtensionMethodTemplate,
) Option[TypedExpr] =
    template.checked_body;

file_private let concrete_extension_def_id_is_materialized(
    mono Monomorphizer,
    def_id DefId,
) Bool = {
    for node_ref in mono.storage.generated_nodes then {
        when node_ref in {
            .FunctionDecl(_, _, _, _, _, _, id) then {
                if id.def_id.id == def_id.id then {
                    return true;
                };
            },
            .IntrinsicFunctionDecl(_, _, _, _, _, id) then {
                if id.def_id.id == def_id.id then {
                    return true;
                };
            },
            .GivenDecl(_, members, _) then {
                for member_ref in members then {
                    if member_ref.def_id.id == def_id.id then {
                        return true;
                    };
                };
            },
            .GivenTraitDecl(_, _, _, members, _, _) then {
                for member_ref in members then {
                    if member_ref.def_id.id == def_id.id then {
                        return true;
                    };
                };
            },
            .IntrinsicGivenDecl(_, members, _) then {
                for member_ref in members then {
                    if member_ref.def_id.id == def_id.id then {
                        return true;
                    };
                };
            },
            _ then {},
        };
    };
    return false;
};

// Resolve a StructureType/EnumType def_id to a (template_name, type_args) pair.
// Tries in order: context.get_template_name + get_type_arguments, layout_to_template_info, context.lookup_type.
// Returns None if none of the sources produce a template name.
file_private let resolve_template_name_and_args(
    mono Monomorphizer,
    def_id DefId,
) Option[Pair[String, List[Type]]] = {
    when mono.storage.context.get_template_name(def_id) in {
        .Some(template_name) then {
            when mono.storage.context.get_type_arguments(def_id) in {
                .Some(type_args) then {
                    return Option[Pair[String, List[Type]]].Some(
                        Pair[String, List[Type]](template_name, type_args),
                    );
                },
                .None() then {},
            };
            let layout_name = mono.storage.context.get_name(def_id) or else "";
            when mono.storage.layout_to_template_info.get(layout_name) in {
                .Some(info) then {
                    let mutable args = List[Type].new();
                    for type_arg in info.args then {
                        args.push(type_arg);
                    };
                    return Option[Pair[String, List[Type]]].Some(
                        Pair[String, List[Type]](info.base_name, args),
                    );
                },
                .None() then {},
            };
            when mono.storage.context.lookup_type(def_id) in {
                .Some(mapped_type) then {
                    when mapped_type in {
                        .GenericStruct(tplDefId, args) then {
                            let mutable concrete_args = List[Type].new();
                            for a in args then {
                                concrete_args.push(a);
                            };
                            return Option[Pair[String, List[Type]]].Some(
                                Pair[String, List[Type]](
                                    def_id_spelling(tplDefId),
                                    concrete_args,
                                ),
                            );
                        },
                        .GenericEnum(tplDefId, args) then {
                            let mutable concrete_args = List[Type].new();
                            for a in args then {
                                concrete_args.push(a);
                            };
                            return Option[Pair[String, List[Type]]].Some(
                                Pair[String, List[Type]](
                                    def_id_spelling(tplDefId),
                                    concrete_args,
                                ),
                            );
                        },
                        _ then {},
                    };
                },
                .None() then {},
            };
            return Option[Pair[String, List[Type]]].Some(
                Pair[String, List[Type]](template_name, List[Type].new()),
            );
        },
        .None() then {
            let layout_name = mono.storage.context.get_name(def_id) or else "";
            when mono.storage.layout_to_template_info.get(layout_name) in {
                .Some(info) then {
                    let mutable args = List[Type].new();
                    for type_arg in info.args then {
                        args.push(type_arg);
                    };
                    return Option[Pair[String, List[Type]]].Some(
                        Pair[String, List[Type]](info.base_name, args),
                    );
                },
                .None() then {},
            };
            when mono.storage.context.lookup_type(def_id) in {
                .Some(mapped_type) then {
                    when mapped_type in {
                        .GenericStruct(tplDefId, args) then {
                            let mutable concrete_args = List[Type].new();
                            for a in args then {
                                concrete_args.push(a);
                            };
                            return Option[Pair[String, List[Type]]].Some(
                                Pair[String, List[Type]](
                                    def_id_spelling(tplDefId),
                                    concrete_args,
                                ),
                            );
                        },
                        .GenericEnum(tplDefId, args) then {
                            let mutable concrete_args = List[Type].new();
                            for a in args then {
                                concrete_args.push(a);
                            };
                            return Option[Pair[String, List[Type]]].Some(
                                Pair[String, List[Type]](
                                    def_id_spelling(tplDefId),
                                    concrete_args,
                                ),
                            );
                        },
                        _ then {},
                    };
                },
                .None() then {},
            };
            return Option[Pair[String, List[Type]]].None();
        },
    };
};

/// Whether two trait identities name the same DECLARATION.
///
/// This is the only shape the comparison may take. Accepting two spellings and
/// resolving each one here is what let two same-named traits from different
/// modules answer for each other: both spellings land on whichever declaration
/// last wrote the unqualified index, so the test came out true for any pair.
/// Callers hold the identity on the record they are filtering (`conformance_trait_def_id`,
/// `GivenTraitDecl.trait_def_id`, the bound's own `def_id`) and must pass that.
public let trait_identity_matches(left DefId, right DefId) Bool = {
    return left.is_valid() and right.is_valid() and left == right;
};

file_private let lookup_extension_methods_fuzzy(
    mono Monomorphizer,
    owner MethodOwner,
) Option[List[GenericExtensionMethodTemplate]] = {
    if mono.storage.fuzzy_extension_methods_missing.contains(owner) then {
        return Option[List[GenericExtensionMethodTemplate]].None();
    };
    when mono.storage.fuzzy_extension_methods_cache.get(owner) in {
        .Some(cached) then {
            return Option[List[GenericExtensionMethodTemplate]].Some(cached);
        },
        .None() then {},
    };

    when mono.storage.generic_templates.lookup_extension_methods(owner) in {
        .Some(exact) then {
            mono.storage.fuzzy_extension_methods_cache.insert(owner, exact);
            return Option[List[GenericExtensionMethodTemplate]].Some(exact);
        },
        .None() then {},
    };

    // Swift MonomorphizerFunctions.lookupTraitTargetExtensionMethod collects every
    // template that belongs to THIS trait. Membership is decided by the template's
    // declaration DefId; the previous version merged any bucket whose key merely
    // suffix-matched the requested name, which conflated unrelated traits that
    // happen to share a name.
    // Membership is decided by the trait's DECLARATION: this owner IS a trait
    // declaration, so ask for its own DefId rather than looking a spelling up.
    let want_trait_def_id = when owner in {
        .Decl(def_id) then if mono.storage.generic_templates.is_trait_def_id(def_id) then Option[DefId].Some(
            def_id,
        ) else Option[DefId].None(),
        .Builtin(_) then Option[DefId].None(),
    };
    let mutable merged = List[GenericExtensionMethodTemplate].new();
    for entry in mono.storage.generic_templates.extension_methods then {
        for template_ref in entry.second then {
            when template_ref.conformance_trait_def_id in {
                .Some(id) then {
                    let matches = when want_trait_def_id in {
                        .Some(want) then id == want,
                        .None() then false,
                    };
                    if matches then {
                        merged.push(template_ref);
                    };
                },
                .None() then {},
            };
        };
    };
    if merged.is_empty() then {
        mono.storage.fuzzy_extension_methods_missing.insert(owner);
        return Option[List[GenericExtensionMethodTemplate]].None();
    };
    mono.storage.fuzzy_extension_methods_cache.insert(owner, merged);
    return Option[List[GenericExtensionMethodTemplate]].Some(merged);
};

file_private let select_trait_tool_template_cached(
    mono Monomorphizer,
    trait_def_id DefId,
    method_name String,
    method_type_arg_count Option[UInt],
    trait_arg_count Option[UInt],
) Option[GenericExtensionMethodTemplate] = {
    let method_count_key = when method_type_arg_count in {
        .Some(count) then count.to_string(),
        .None() then "*",
    };
    let trait_count_key = when trait_arg_count in {
        .Some(count) then count.to_string(),
        .None() then "*",
    };
    // The owner IS the trait's declaration -- no spelling is consulted on the
    // way in. The cache key is that identity too, so two same-named traits from
    // different modules cannot share a slot.
    if not trait_def_id.is_valid() then {
        return Option[GenericExtensionMethodTemplate].None();
    };
    let trait_owner = MethodOwner.Decl(trait_def_id);
    let cache_key = "d\(trait_def_id.id)|\(method_name)|\(method_count_key)|\(trait_count_key)";

    if mono.storage.trait_tool_template_missing.contains(cache_key) then {
        return Option[GenericExtensionMethodTemplate].None();
    };
    when mono.storage.trait_tool_template_cache.get(cache_key) in {
        .Some(cached) then {
            return Option[GenericExtensionMethodTemplate].Some(cached);
        },
        .None() then {},
    };

    let selected = when lookup_extension_methods_fuzzy(mono, trait_owner) in {
        .Some(tool_templates) then select_extension_template(
            tool_templates,
            method_name,
            method_type_arg_count,
            trait_arg_count,
        ),
        .None() then Option[GenericExtensionMethodTemplate].None(),
    };

    when selected in {
        .Some(template_ref) then mono.storage.trait_tool_template_cache.insert(
            cache_key,
            template_ref,
        ),
        .None() then mono.storage.trait_tool_template_missing.insert(cache_key),
    };
    return selected;
};

file_private let lookup_given_trait_decls_fuzzy(
    mono Monomorphizer,
    trait_def_id DefId,
) Option[List[TypedDecl]] = {
    // Keyed on the DECLARATION, never on a spelling: two same-named traits
    // would otherwise share a cache slot and hand each other's `given`s out.
    let key = "d\(trait_def_id.id)";
    if mono.storage.fuzzy_given_trait_decls_missing.contains(key) then {
        return Option[List[TypedDecl]].None();
    };
    when mono.storage.fuzzy_given_trait_decls_cache.get(key) in {
        .Some(cached) then {
            return Option[List[TypedDecl]].Some(cached);
        },
        .None() then {},
    };

    let mutable matches = List[TypedDecl].new();
    for node_ref in mono.storage.source_given_decls then {
        when node_ref in {
            .GivenTraitDecl(_, _, _, _, _, given_trait_def_id) then {
                if trait_identity_matches(given_trait_def_id, trait_def_id) then {
                    matches.push(node_ref);
                };
            },
            _ then {},
        };
    };

    if matches.is_empty() then {
        mono.storage.fuzzy_given_trait_decls_missing.insert(key);
        return Option[List[TypedDecl]].None();
    };
    mono.storage.fuzzy_given_trait_decls_cache.insert(key, matches);
    return Option[List[TypedDecl]].Some(matches);
};

file_private let normalize_trait_conformance_actual_type_for_template_binding(
    mono Monomorphizer,
    actual Type,
) Type = {
    let normalized = normalize_trait_conformance_actual_type(mono, actual);
    let mutable out = normalized;
    when normalized in {
        .StructureType(def_id) then {
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then {
                    let mutable mapped_args = List[Type].new();
                    for arg in info.second then {
                        mapped_args.push(resolve_parameterized_type(mono, arg));
                    };
                    out = Type.GenericStruct(
                        mono.storage.context.get_template_def_id(def_id),
                        mapped_args,
                    );
                },
                .None() then {},
            };
        },
        .EnumType(def_id) then {
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then {
                    let mutable mapped_args = List[Type].new();
                    for arg in info.second then {
                        mapped_args.push(resolve_parameterized_type(mono, arg));
                    };
                    out = Type.GenericEnum(
                        mono.storage.context.get_template_def_id(def_id),
                        mapped_args,
                    );
                },
                .None() then {},
            };
        },
        _ then {},
    };
    return out;
};

/// The generic template's DECLARATION carried by a type -- identity, never a
/// spelling.
file_private let type_template_decl(mono Monomorphizer, t Type) DefId = {
    return when t in {
        .GenericStruct(d, _) then d,
        .GenericEnum(d, _) then d,
        .TraitObject(d, _) then d,
        .StructureType(def_id) then mono.storage.context.get_template_def_id(def_id),
        .EnumType(def_id) then mono.storage.context.get_template_def_id(def_id),
        _ then def_id_invalid(),
    };
};

file_private let trait_conformance_target_matches_for_template_binding(
    mono Monomorphizer,
    pattern Type,
    actual Type,
) Bool = {
    let normalized_pattern = normalize_trait_conformance_actual_type_for_template_binding(
        mono,
        pattern,
    );
    let normalized_actual = normalize_trait_conformance_actual_type_for_template_binding(
        mono,
        actual,
    );
    return when normalized_pattern in {
        .GenericStruct(_, pattern_args) then when normalized_actual in {
            // Identity: the template's DECLARATION, not its spelling.
            .GenericStruct(_, actual_args) then type_template_decl(
                mono,
                normalized_pattern,
            ) == type_template_decl(mono, normalized_actual) and pattern_args.count() == actual_args.count(
            ),
            .StructureType(_) then type_template_decl(mono, normalized_pattern) == type_template_decl(
                mono,
                normalized_actual,
            ) and pattern_args.count() == (mono.storage.context.get_type_arguments(
                mono.storage.context.get_template_def_id(def_id_invalid()),
            ) or else List[Type].new()).count(),
            _ then false,
        },
        .GenericEnum(_, pattern_args) then when normalized_actual in {
            .GenericEnum(_, actual_args) then type_template_decl(
                mono,
                normalized_pattern,
            ) == type_template_decl(mono, normalized_actual) and pattern_args.count() == actual_args.count(
            ),
            .EnumType(_) then type_template_decl(mono, normalized_pattern) == type_template_decl(
                mono,
                normalized_actual,
            ),
            _ then false,
        },
        _ then mono.storage.context.get_layout_key(pattern) == mono.storage.context.get_layout_key(
            normalized_actual,
        ),
    };
};

file_private let trait_conformance_target_shallow_matches(
    mono Monomorphizer,
    pattern Type,
    actual Type,
) Bool = {
    let normalized_pattern = normalize_trait_conformance_actual_type(mono, pattern);
    let normalized_actual = normalize_trait_conformance_actual_type(mono, actual);
    return when normalized_pattern in {
        .GenericStruct(_, pattern_args) then when normalized_actual in {
            // Identity: the template's DECLARATION, not its spelling.
            .GenericStruct(_, actual_args) then type_template_decl(
                mono,
                normalized_pattern,
            ) == type_template_decl(mono, normalized_actual) and pattern_args.count() == actual_args.count(
            ),
            .StructureType(_) then type_template_decl(mono, normalized_pattern) == type_template_decl(
                mono,
                normalized_actual,
            ),
            _ then false,
        },
        .GenericEnum(_, pattern_args) then when normalized_actual in {
            .GenericEnum(_, actual_args) then type_template_decl(
                mono,
                normalized_pattern,
            ) == type_template_decl(mono, normalized_actual) and pattern_args.count() == actual_args.count(
            ),
            .EnumType(_) then type_template_decl(mono, normalized_pattern) == type_template_decl(
                mono,
                normalized_actual,
            ),
            _ then false,
        },
        _ then trait_conformance_target_matches(mono, pattern, actual),
    };
};

file_private let collect_trait_conformance_bindings_for_template_binding(
    mono Monomorphizer,
    pattern Type,
    actual Type,
    bindings Dict[String, Type],
) Void = {
    let normalized_pattern = normalize_trait_conformance_actual_type_for_template_binding(
        mono,
        pattern,
    );
    let normalized_actual = normalize_trait_conformance_actual_type_for_template_binding(
        mono,
        actual,
    );
    when normalized_pattern in {
        .GenericParameter(name) then {
            if not bindings.contains_key(name) then {
                bindings.insert(name, normalized_actual);
            };
        },
        .ReferenceType(pattern_inner) then {
            when normalized_actual in {
                .ReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .BorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .MutableReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .BorrowedReferenceType(pattern_inner) then {
            when normalized_actual in {
                .ReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .BorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .MutableBorrowedReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .WeakReferenceType(pattern_inner) then {
            when normalized_actual in {
                .WeakReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableWeakReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .MutableWeakReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableWeakReferenceType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .PointerType(pattern_inner) then {
            when normalized_actual in {
                .PointerType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutablePointerType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .MutablePointerType(pattern_inner) then {
            when normalized_actual in {
                .MutablePointerType(actual_inner) then collect_trait_conformance_bindings_for_template_binding(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        // Identity: the template's DECLARATION, not its spelling.
        .GenericStruct(pattern_def_id, pattern_args) then {
            when normalized_actual in {
                .GenericStruct(actual_def_id, actual_args) then {
                    if pattern_def_id == actual_def_id and pattern_args.count() == actual_args.count(
                    ) then {
                        let mutable i UInt = 0;
                        while i < pattern_args.count() then {
                            collect_trait_conformance_bindings_for_template_binding(
                                mono,
                                (pattern_args[i]),
                                (actual_args[i]),
                                bindings,
                            );
                            i += 1;
                        };
                    };
                },
                _ then {},
            };
        },
        .GenericEnum(pattern_def_id, pattern_args) then {
            when normalized_actual in {
                .GenericEnum(actual_def_id, actual_args) then {
                    if pattern_def_id == actual_def_id and pattern_args.count() == actual_args.count(
                    ) then {
                        let mutable i UInt = 0;
                        while i < pattern_args.count() then {
                            collect_trait_conformance_bindings_for_template_binding(
                                mono,
                                (pattern_args[i]),
                                (actual_args[i]),
                                bindings,
                            );
                            i += 1;
                        };
                    };
                },
                _ then {},
            };
        },
        _ then {},
    };
};

file_private let infer_trait_extension_type_args_for_template_binding(
    mono Monomorphizer,
    conformance_target Type,
    parameterized_base_type Type,
    trait_def_id DefId,
) List[Type] = {
    let mutable out = List[Type].new();
    if not trait_conformance_target_matches_for_template_binding(
        mono,
        conformance_target,
        parameterized_base_type,
    ) then {
        return out;
    };

    let mutable bindings = Dict[String, Type].new();
    collect_trait_conformance_bindings_for_template_binding(
        mono,
        conformance_target,
        parameterized_base_type,
        bindings,
    );

    when mono.storage.generic_templates.lookup_trait_by_def_id(trait_def_id) in {
        .Some(info) then {
            for tp in info.type_params then {
                out.push(bindings.get(tp.name) or else Type.Unknown());
            };
        },
        .None() then {},
    };
    return out;
};

file_private let resolve_given_trait_args_for_template_binding(
    mono Monomorphizer,
    conformance_target Type,
    trait_args List[Type],
    parameterized_base_type Type,
) List[Type] = {
    let mutable out = List[Type].new();
    if not trait_conformance_target_matches_for_template_binding(
        mono,
        conformance_target,
        parameterized_base_type,
    ) then {
        return out;
    };

    let mutable bindings = Dict[String, Type].new();
    collect_trait_conformance_bindings_for_template_binding(
        mono,
        conformance_target,
        parameterized_base_type,
        bindings,
    );
    for trait_arg in trait_args then {
        out.push(
            resolve_parameterized_type(mono, substitute_type(mono, trait_arg, bindings)),
        );
    };
    return out;
};

file_private let resolve_template_conformance_trait_args_from_metadata(
    mono Monomorphizer,
    base_type Type,
    template GenericExtensionMethodTemplate,
) List[Type] = {
    let mutable out = List[Type].new();
    let mutable parameterized_base_type = resolve_parameterized_type(mono, base_type);
    let target_type = when template.conformance_target_type in {
        .Some(target) then target,
        .None() then {
            return out;
        },
    };
    if not trait_conformance_target_matches_for_template_binding(
        mono,
        target_type,
        parameterized_base_type,
    ) then {
        return out;
    };
    let mutable bindings = Dict[String, Type].new();
    collect_trait_conformance_bindings_for_template_binding(
        mono,
        target_type,
        parameterized_base_type,
        bindings,
    );
    for trait_arg in template.conformance_trait_args then {
        out.push(
            resolve_parameterized_type(mono, substitute_type(mono, trait_arg, bindings)),
        );
    };
    return out;
};

public let resolve_extension_template_conformance_trait_args(
    mono Monomorphizer,
    base_type Type,
    template GenericExtensionMethodTemplate,
) List[Type] = {
    let mutable out = List[Type].new();
    let from_metadata = resolve_template_conformance_trait_args_from_metadata(
        mono,
        base_type,
        template,
    );
    if not from_metadata.is_empty() then {
        return from_metadata;
    };
    let trait_name = when template.conformance_trait_name in {
        .Some(name) then name,
        .None() then {
            return out;
        },
    };
    let trait_def_id = when template.conformance_trait_def_id in {
        .Some(id) then id,
        .None() then {
            return out;
        },
    };
    let parameterized_base_type = resolve_parameterized_type(mono, base_type);
    when lookup_given_trait_decls_fuzzy(mono, trait_def_id) in {
        .Some(given_nodes) then {
            for node_ref in given_nodes then {
                when node_ref in {
                    .GivenTraitDecl(target_type, _, trait_args, _, _, _) then {
                        if not trait_conformance_target_matches_for_template_binding(
                            mono,
                            target_type,
                            parameterized_base_type,
                        ) then {
                            continue;
                        };
                        if not trait_args.is_empty() then {
                            let resolved = resolve_given_trait_args_for_template_binding(
                                mono,
                                target_type,
                                trait_args,
                                parameterized_base_type,
                            );
                            if not resolved.is_empty() then {
                                return resolved;
                            };
                        };
                        let inferred = infer_trait_extension_type_args_for_template_binding(
                            mono,
                            target_type,
                            parameterized_base_type,
                            trait_def_id,
                        );
                        if not inferred.is_empty() then {
                            return inferred;
                        };
                    },
                    _ then {},
                };
            };
        },
        .None() then {},
    };
    return out;
};

public let instantiate_conformance_trait_methods_for_type(
    mono Monomorphizer,
    base_type Type,
) Void = {
    let mutable parameterized_base_type = resolve_parameterized_type(mono, base_type);
    let current_generation_version = mono.storage.generated_nodes.count();
    when mono.storage.conformance_trait_methods_scan_version.get(
        parameterized_base_type,
    ) in {
        .Some(scanned_version) then {
            if scanned_version == current_generation_version then {
                return;
            };
        },
        .None() then {},
    };
    // Dedup on the trait DECLARATION's identity -- two same-named traits from
    // different modules are different traits and both need their vtables.
    let mutable instantiated_traits = Set[DefId].new();
    for node_ref in mono.storage.source_given_decls then {
        when node_ref in {
            .GivenTraitDecl(target_type, trait_name, trait_args, _, _, trait_def_id) then {
                if not trait_conformance_target_shallow_matches(
                    mono,
                    target_type,
                    parameterized_base_type,
                ) then {
                    continue;
                };
                if instantiated_traits.contains(trait_def_id) then {
                    continue;
                };
                let resolved_trait_args = if trait_args.is_empty() then infer_trait_extension_type_args(
                    mono,
                    target_type,
                    parameterized_base_type,
                    trait_def_id,
                )
                else resolve_given_trait_args(
                    mono,
                    target_type,
                    trait_args,
                    parameterized_base_type,
                );
                instantiate_trait_vtable_methods(
                    mono,
                    parameterized_base_type,
                    trait_name,
                    trait_def_id,
                    resolved_trait_args,
                );
                instantiated_traits.insert(trait_def_id);
            },
            _ then {},
        };
    };

    // Fallback: rely on extension-template conformance metadata when source
    // given declarations are not sufficient to recover a concrete conformance
    // match for this receiver shape.
    for ext_entry in mono.storage.generic_templates.extension_methods then {
        for template_ref in ext_entry.second then {
            let trait_name = when template_ref.conformance_trait_name in {
                .Some(name) then name,
                .None() then {
                    continue;
                },
            };
            let trait_def_id = when template_ref.conformance_trait_def_id in {
                .Some(id) then id,
                .None() then def_id_invalid(),
            };
            if instantiated_traits.contains(trait_def_id) then {
                continue;
            };
            let conformance_target = when template_ref.conformance_target_type in {
                .Some(target) then target,
                .None() then {
                    continue;
                },
            };
            if not trait_conformance_target_shallow_matches(
                mono,
                conformance_target,
                parameterized_base_type,
            ) then {
                continue;
            };
            let resolved_trait_args = resolve_extension_template_conformance_trait_args(
                mono,
                parameterized_base_type,
                template_ref,
            );
            instantiate_trait_vtable_methods(
                mono,
                parameterized_base_type,
                trait_name,
                trait_def_id,
                resolved_trait_args,
            );
            instantiated_traits.insert(trait_def_id);
        };
    };

    mono.storage.conformance_trait_methods_scan_version.insert(
        parameterized_base_type,
        current_generation_version,
    );
};

/// Instantiate the conformance method `method_name` for `base_type`, under the
/// trait DECLARATION `trait_def_id`. The `given`s that can provide the method
/// are selected by identity -- two same-named traits do not answer for each
/// other.
public let instantiate_conformance_trait_method_for_type(
    mono Monomorphizer,
    base_type Type,
    trait_def_id DefId,
    method_name String,
    method_type_args List[Type],
) Void = {
    let mutable parameterized_base_type = resolve_parameterized_type(mono, base_type);
    if has_generic_parameter(parameterized_base_type) or args_have_generic_parameter(
        method_type_args,
    ) then {
        return;
    };

    let method_type_arg_count = Option[UInt].Some(method_type_args.count());

    for node_ref in mono.storage.source_given_decls then {
        when node_ref in {
            .GivenTraitDecl(target_type, _, trait_args, members, _, given_trait_def_id) then {
                if not trait_identity_matches(given_trait_def_id, trait_def_id) then {
                    continue;
                };
                if not trait_conformance_target_shallow_matches(
                    mono,
                    target_type,
                    parameterized_base_type,
                ) then {
                    continue;
                };
                let mutable has_member = false;
                for member_ref in members then {
                    if member_ref.name == method_name then {
                        has_member = true;
                        break;
                    };
                };
                if not has_member then {
                    continue;
                };
                let effective_trait_args = if trait_args.is_empty() then infer_trait_extension_type_args(
                    mono,
                    target_type,
                    parameterized_base_type,
                    given_trait_def_id,
                )
                else resolve_given_trait_args(
                    mono,
                    target_type,
                    trait_args,
                    parameterized_base_type,
                );
                when select_trait_tool_template_cached(
                    mono,
                    given_trait_def_id,
                    method_name,
                    method_type_arg_count,
                    Option[UInt].Some(effective_trait_args.count()),
                ) in {
                    .Some(tool_template_ref) then {
                        let _ = mono.instantiate_extension_method_impl(
                            parameterized_base_type,
                            MethodOwner.Decl(given_trait_def_id),
                            tool_template_ref,
                            effective_trait_args,
                            method_type_args,
                        );
                        return;
                    },
                    .None() then {},
                };
            },
            _ then {},
        };
    };

    for ext_entry in mono.storage.generic_templates.extension_methods then {
        for template_ref in ext_entry.second then {
            let conformance_trait_def_id = when template_ref.conformance_trait_def_id in {
                .Some(id) then id,
                .None() then {
                    continue;
                },
            };
            if not trait_identity_matches(conformance_trait_def_id, trait_def_id) then {
                continue;
            };
            if template_ref.method.name != method_name then {
                continue;
            };
            let conformance_target = when template_ref.conformance_target_type in {
                .Some(target) then target,
                .None() then {
                    continue;
                },
            };
            if not trait_conformance_target_shallow_matches(
                mono,
                conformance_target,
                parameterized_base_type,
            ) then {
                continue;
            };
            let effective_trait_args = resolve_extension_template_conformance_trait_args(
                mono,
                parameterized_base_type,
                template_ref,
            );
            let _ = mono.instantiate_extension_method_impl(
                parameterized_base_type,
                ext_entry.first,
                template_ref,
                effective_trait_args,
                method_type_args,
            );
            return;
        };
    };
};

// ── instantiate_extension_method ─────────────────────────────────────────────

// Instantiate a generic extension method with concrete type arguments.
//
// Outer wrapper matching Swift's instantiateExtensionMethod:
//   1. Resolve base_type via resolve_parameterized_type
//   2. Derive structure_name from the resolved type
//   3. Handle Ref/MutRef/Ptr/etc effective_template_name + effective_type_args
//   4. Look up latest template if checked_body is nil
//   5. Delegate to instantiate_extension_method_from_entry
//
public let instantiate_extension_method(
    mono Monomorphizer,
    base_type Type,
    owner MethodOwner,
    template GenericExtensionMethodTemplate,
    type_args List[Type],
    method_type_args List[Type],
) Symbol = {
    // 1. Resolve the base type if it's a parameterized type.
    let mutable resolved_base_type = resolve_parameterized_type(mono, base_type);

    // Never materialize extension methods for unresolved placeholder/generic shapes.
    if has_generic_parameter(resolved_base_type) or is_placeholder_inferred_type(
        resolved_base_type,
    ) then {
        return Symbol(DefId(UInt(0)), Type.Unknown(), SymbolKind.Function());
    };
    if args_have_generic_parameter(type_args) or args_have_generic_parameter(
        method_type_args,
    ) then {
        return Symbol(DefId(UInt(0)), Type.Unknown(), SymbolKind.Function());
    };

    // 2. Derive structure_name from the resolved type, matching Swift's structureName.
    //    Must cover all type variants that can reach this point to avoid producing
    //    invalid C identifiers (e.g. "struct#546 ref mutable" from type_display_name).
    let structure_name = when resolved_base_type in {
        .StructureType(def_id) then {
            let name = mono.storage.context.get_name(def_id) or else "";
            mono.storage.context.get_template_name(def_id) or else name
        },
        // C mangling: the spelling is read from the DECLARATION. Names are
        // legitimate here (output), but they must still come from the identity.
        .GenericStruct(template_def_id, _) then def_id_spelling(template_def_id),
        .GenericEnum(template_def_id, _) then def_id_spelling(template_def_id),
        .EnumType(def_id) then {
            let name = mono.storage.context.get_name(def_id) or else "";
            mono.storage.context.get_template_name(def_id) or else name
        },
        .PointerType(_) then "Ptr",
        .MutablePointerType(_) then "MutPtr",
        .ReferenceType(_) then "Ref",
        .MutableReferenceType(_) then "MutRef",
        .BorrowedReferenceType(_) then "BorrowRef",
        .MutableBorrowedReferenceType(_) then "BorrowMutRef",
        .WeakReferenceType(_) then "WeakRef",
        .MutableWeakReferenceType(_) then "MutWeakRef",
        _ then mono.storage.context.type_display_name(resolved_base_type),
    };

    // 3. Resolve the owner identity actually being extended. A modifier base
    //    extends its own closed built-in owner rather than the one the caller
    //    named, and contributes its inner type as an extra type argument.
    //    This used to be a ladder assigning the strings "Ref"/"MutRef"/"Ptr"/...
    let mutable effective_owner = owner;
    let mutable effective_type_args = type_args;
    when base_type in {
        .ReferenceType(inner) then {
            effective_owner = MethodOwner.Builtin("Ref");
            if effective_type_args.is_empty() then {
                effective_type_args.push(inner);
            };
        },
        .MutableReferenceType(inner) then {
            effective_owner = MethodOwner.Builtin("MutRef");
            if effective_type_args.is_empty() then {
                effective_type_args.push(inner);
            };
        },
        .BorrowedReferenceType(inner) then {
            if effective_type_args.is_empty() then {
                effective_type_args.push(inner);
            };
        },
        .MutableBorrowedReferenceType(inner) then {
            if effective_type_args.is_empty() then {
                effective_type_args.push(inner);
            };
        },
        .PointerType(inner) then {
            effective_owner = MethodOwner.Builtin("Ptr");
            if effective_type_args.is_empty() then {
                effective_type_args.push(inner);
            };
        },
        .MutablePointerType(inner) then {
            effective_owner = MethodOwner.Builtin("MutPtr");
            if effective_type_args.is_empty() then {
                effective_type_args.push(inner);
            };
        },
        .WeakReferenceType(inner) then {
            effective_owner = MethodOwner.Builtin("WeakRef");
            if effective_type_args.is_empty() then {
                effective_type_args.push(inner);
            };
        },
        .MutableWeakReferenceType(inner) then {
            effective_owner = MethodOwner.Builtin("MutWeakRef");
            if effective_type_args.is_empty() then {
                effective_type_args.push(inner);
            };
        },
        _ then {},
    };

    let effective_base_type = normalize_borrowed_extension_base_type(
        resolved_base_type,
        effective_owner,
    );

    // 4. Resolve the latest template from the registry if checked_body is missing.
    //    InstantiationRequests may carry an earlier snapshot without a checked_body.
    let resolved_template = if template.checked_body is .Some(_) then template
    else {
        when mono.storage.generic_templates.lookup_extension_methods(owner) in {
            .Some(ext_list) then {
                when select_extension_template(
                    ext_list,
                    template.method.name,
                    Option[UInt].Some(template.method.type_params.count()),
                    Option[UInt].Some(template.type_params.count()),
                ) in {
                    .Some(latest) then latest,
                    .None() then template,
                }
            },
            .None() then template,
        }
    };

    // 5. Delegate to the inner implementation.
    return instantiate_extension_method_from_entry(
        mono,
        effective_base_type,
        structure_name,
        effective_owner,
        effective_type_args,
        method_type_args,
        resolved_template,
    );
};

// ── resolve_method_instance_by_identity ──────────────────────────────────────

// The unique owner of the template declaring `def_id`, or None when ambiguous.
// Pure identity: matched on the declaration's DefId, never its name.
file_private let exact_template_owner_for_method_def_id(
    mono Monomorphizer,
    def_id DefId,
) Option[MethodOwner] = {
    if not def_id.is_valid() then {
        return Option[MethodOwner].None();
    };
    let mutable owners = List[MethodOwner].new();
    let mutable seen = Set[MethodOwner].new();
    for entry in mono.storage.extension_methods.iterator() then {
        let key = entry.first;
        let method_entry = entry.second;
        if method_entry.symbol.def_id == def_id then {
            if not seen.contains(key.owner) then {
                seen.insert(key.owner);
                owners.push(key.owner);
            };
        };
    };
    for entry in mono.storage.generic_templates.extension_methods.iterator() then {
        let owner = entry.first;
        let templates = entry.second;
        for template in templates then {
            if template.method.def_id == def_id then {
                if not seen.contains(owner) then {
                    seen.insert(owner);
                    owners.push(owner);
                };
            };
        };
    };
    if owners.count() == UInt(1) then {
        return Option[MethodOwner].Some(owners[UInt(0)]);
    };
    return Option[MethodOwner].None();
};

// Generic parameter names in a type, in order of first appearance.
file_private let collect_generic_parameter_names_from_type(t Type) List[String] = {
    let mutable names = List[String].new();
    let mutable seen = Set[String].new();
    let mutable stack = List[Type].new();
    stack.push(t);
    let mutable index UInt = UInt(0);
    while index < stack.count() then {
        let current = stack[index];
        index += UInt(1);
        when current in {
            .GenericParameter(name) then {
                if not seen.contains(name) then {
                    seen.insert(name);
                    names.push(name);
                };
            },
            .ReferenceType(inner) then stack.push(inner),
            .MutableReferenceType(inner) then stack.push(inner),
            .BorrowedReferenceType(inner) then stack.push(inner),
            .MutableBorrowedReferenceType(inner) then stack.push(inner),
            .WeakReferenceType(inner) then stack.push(inner),
            .MutableWeakReferenceType(inner) then stack.push(inner),
            .PointerType(inner) then stack.push(inner),
            .MutablePointerType(inner) then stack.push(inner),
            .FunctionType(params, ret) then {
                for param in params then {
                    stack.push(param.param_type);
                };
                stack.push(ret);
            },
            .GenericStruct(_, args) then {
                for arg in args then {
                    stack.push(arg);
                };
            },
            .GenericEnum(_, args) then {
                for arg in args then {
                    stack.push(arg);
                };
            },
            _ then {},
        };
    };
    return names;
};

// Infer method-level type args by unifying the template's checked signature
// against the substituted method type (Swift's `inferMethodTypeArgsBySignature`).
file_private let infer_method_type_args_by_signature(
    mono Monomorphizer,
    template GenericExtensionMethodTemplate,
    substituted_type Type,
) List[Type] = {
    let mutable out = List[Type].new();
    if template.method.type_params.is_empty() then {
        return out;
    };
    let mutable resolved_substituted = resolve_parameterized_type(mono, substituted_type);
    let (checked_params_opt, checked_returns) = when template.checked_parameters is .Some(_) in {
        true then Pair(template.checked_parameters, template.checked_return_type),
        false then Pair(Option[List[Symbol]].None(), Option[Type].None()),
    };
    when checked_params_opt in {
        .Some(checked_params) then {
            when checked_returns in {
                .Some(checked_return) then {
                    when resolved_substituted in {
                        .FunctionType(expected_params, expected_returns) then {
                            let expected_types = param_entry_types(expected_params);
                            let mutable bindings = Dict[String, Type].new();
                            let mutable i UInt = UInt(1);
                            while i < checked_params.count() and i < expected_types.count() then {
                                let _ = unify_generic_type_pattern(
                                    mono,
                                    (checked_params[i]).symbol_type,
                                    expected_types[i],
                                    collect_generic_parameter_names_from_type(
                                        (checked_params[i]).symbol_type,
                                    ),
                                    bindings,
                                );
                                i += UInt(1);
                            };
                            let _ = unify_generic_type_pattern(
                                mono,
                                checked_return,
                                expected_returns,
                                collect_generic_parameter_names_from_type(
                                    checked_return,
                                ),
                                bindings,
                            );
                            for type_param in template.method.type_params then {
                                out.push(
                                    when bindings.get(type_param.name) in {
                                        .Some(bound) then bound,
                                        .None() then Type.GenericParameter(type_param.name),
                                    }
                                );
                            };
                        },
                        _ then {},
                    }
                },
                .None() then {},
            }
        },
        .None() then {},
    };
    return out;
};

// Infer the CONFORMANCE's type arguments by unifying the template's checked
// signature against the expected method type (Swift's
// `inferTraitExtensionTypeArgs`). Returns None when the shape does not fit.
public let infer_trait_extension_type_args_by_method_type(
    mono Monomorphizer,
    base_type Type,
    method_info GenericExtensionMethodTemplate,
    expected_method_type Type,
    method_type_args List[Type],
) Option[List[Type]] = {
    let (actual_params, actual_return) = when expected_method_type in {
        .FunctionType(params, ret) then Pair(params, ret),
        _ then {
            return Option[List[Type]].None();
        },
    };
    let mutable substitution = Dict[String, Type].new();
    substitution.insert("Self", resolve_parameterized_type(mono, base_type));
    let method_type_params = method_info.method.type_params;
    if not method_type_args.is_empty() then {
        if method_type_params.count() != method_type_args.count() then {
            return Option[List[Type]].None();
        };
        let mutable i UInt = UInt(0);
        while i < method_type_params.count() then {
            substitution.insert(
                (method_type_params[i]).name,
                method_type_args[i],
            );
            i += UInt(1);
        };
    };
    let (pattern_params, pattern_return) = when method_info.checked_parameters is .Some(_) in {
        true then {
            when method_info.checked_return_type in {
                .Some(checked_return) then {
                    let mutable params_out = List[Type].new();
                    let checked = when method_info.checked_parameters in {
                        .Some(checked_ref) then checked_ref,
                        .None() then List[Symbol].new(),
                    };
                    for param in checked then {
                        params_out.push(
                            substitute_type(mono, param.symbol_type, substitution),
                        );
                    };
                    Pair(
                        params_out,
                        substitute_type(mono, checked_return, substitution),
                    )
                },
                .None() then Pair(List[Type].new(), Type.Unknown()),
            }
        },
        false then Pair(List[Type].new(), Type.Unknown()),
    };
    if pattern_params.is_empty() then {
        return Option[List[Type]].None();
    };
    let actual_types = param_entry_types(actual_params);
    if pattern_params.count() != actual_types.count() then {
        return Option[List[Type]].None();
    };
    let mutable type_param_names = List[String].new();
    let mutable type_param_set = Set[String].new();
    for type_param in method_info.type_params then {
        type_param_names.push(type_param.name);
        type_param_set.insert(type_param.name);
    };
    if method_type_args.is_empty() then {
        for method_type_param in method_type_params then {
            if not type_param_set.contains(method_type_param.name) then {
                type_param_names.push(method_type_param.name);
                type_param_set.insert(method_type_param.name);
            };
        };
    };
    let mutable inferred = Dict[String, Type].new();
    let mutable i UInt = UInt(0);
    while i < pattern_params.count() then {
        if not unify_generic_type_pattern(
            mono,
            pattern_params[i],
            actual_types[i],
            type_param_names,
            inferred,
        ) then {
            return Option[List[Type]].None();
        };
        i += UInt(1);
    };
    if not unify_generic_type_pattern(
        mono,
        pattern_return,
        actual_return,
        type_param_names,
        inferred,
    ) then {
        return Option[List[Type]].None();
    };
    let mutable ordered = List[Type].new();
    for type_param in method_info.type_params then {
        when inferred.get(type_param.name) in {
            .Some(bound) then ordered.push(bound),
            .None() then {
                return Option[List[Type]].None();
            },
        };
    };
    return Option[List[Type]].Some(ordered);
};
//
// rustc's `Instance::resolve`. The definition-time DefId is authoritative:
// this never re-decides which method via name lookup. All monomorphization
// method-instance lookup funnels here.
//
// Lookup chain:
//   L0: already-instantiated → the DefId IS the emitted identity.
//   L1: direct hash lookup in `extension_method_def_ids_by_identity` by
//       `MethodInstanceKey` (DefId + GenericArgs). No type matching — the key
//       is exact identity. Dual-keyed under the trait method DefId.
//   L2: materialize the template's specialization, then retry L1.
//   L3: keepDefinitionTime (concrete given / built-in only).

// Receiver candidates for identity lookup: the receiver itself, and the pointee
// of a reference-like receiver (Swift's `identityReceiverLookupCandidates`).
public let identity_receiver_lookup_candidates(
    mono Monomorphizer,
    receiver_type Type,
) List[Type] = {
    let mutable candidates = List[Type].new();
    let mutable seen = Set[Type].new();
    let append = Type.Unknown();
    let _ = append;
    let resolved = resolve_parameterized_type(mono, receiver_type);
    if not seen.contains(resolved) then {
        seen.insert(resolved);
        candidates.push(resolved);
    };
    let inner = when resolved in {
        .ReferenceType(inner) then Option[Type].Some(inner),
        .MutableReferenceType(inner) then Option[Type].Some(inner),
        .BorrowedReferenceType(inner) then Option[Type].Some(inner),
        .MutableBorrowedReferenceType(inner) then Option[Type].Some(inner),
        .WeakReferenceType(inner) then Option[Type].Some(inner),
        .MutableWeakReferenceType(inner) then Option[Type].Some(inner),
        _ then Option[Type].None(),
    };
    when inner in {
        .Some(inner_ref) then {
            let resolved_inner = resolve_parameterized_type(mono, inner_ref);
            if not seen.contains(resolved_inner) then {
                seen.insert(resolved_inner);
                candidates.push(resolved_inner);
            };
        },
        .None() then {},
    };
    return candidates;
};

// Does the instantiated symbol's signature match the expected method type?
// Signature equality, not candidate scanning — the key already named the
// method; this only rejects a mismatched specialization.
file_private let symbol_matches_full_method_type(
    mono Monomorphizer,
    hit_def_id DefId,
    full_method_type Type,
) Bool = {
    return when mono.storage.context.get_symbol_type(hit_def_id) in {
        .Some(hit_type) then {
            let resolved_hit_type = resolve_parameterized_type(mono, hit_type);
            if mono.storage.context.get_layout_key(resolved_hit_type) == mono.storage.context.get_layout_key(
                full_method_type,
            ) then true
            else when resolved_hit_type in {
                .FunctionType(hit_params, hit_returns) then {
                    when full_method_type in {
                        .FunctionType(expected_params, expected_returns) then {
                            let hit_types = param_entry_types(hit_params);
                            let expected_types = param_entry_types(expected_params);
                            if hit_types.count() != expected_types.count() then false
                            else if mono.storage.context.get_layout_key(
                                resolve_parameterized_type(mono, hit_returns),
                            ) != mono.storage.context.get_layout_key(
                                resolve_parameterized_type(mono, expected_returns),
                            ) then false
                            else {
                                let mutable ok = true;
                                let mutable i UInt = UInt(0);
                                while i < hit_types.count() then {
                                    if mono.storage.context.get_layout_key(
                                        resolve_parameterized_type(mono, hit_types[i]),
                                    ) != mono.storage.context.get_layout_key(
                                        resolve_parameterized_type(mono, expected_types[i]),
                                    ) then {
                                        ok = false;
                                    };
                                    i += UInt(1);
                                };
                                ok
                            }
                        },
                        _ then false,
                    }
                },
                _ then false,
            }
        },
        .None() then true,
    };
};

file_private let symbol_matches_full_method_type_via_trait_receiver(
    mono Monomorphizer,
    hit_def_id DefId,
    full_method_type Type,
    trait_def_id DefId,
) Bool = {
    return when mono.storage.context.get_symbol_type(hit_def_id) in {
        .Some(hit_type) then when resolve_parameterized_type(mono, hit_type) in {
            .FunctionType(hit_params, hit_returns) then when full_method_type in {
                .FunctionType(expected_params, expected_returns) then {
                    let hit_types = param_entry_types(hit_params);
                    let expected_types = param_entry_types(expected_params);
                    if hit_types.count() != expected_types.count() or hit_types.is_empty() then {
                        return false;
                    };
                    if mono.storage.context.get_layout_key(
                        resolve_parameterized_type(mono, hit_returns),
                    ) != mono.storage.context.get_layout_key(
                        resolve_parameterized_type(mono, expected_returns),
                    ) then {
                        return false;
                    };
                    let hit_first = resolve_parameterized_type(mono, hit_types[UInt(0)]);
                    let first_is_trait_receiver = when hit_first in {
                        .TraitObject(hit_trait_def_id, _) then hit_trait_def_id == trait_def_id,
                        _ then false,
                    };
                    if not first_is_trait_receiver then {
                        return false;
                    };
                    let mutable i UInt = UInt(1);
                    while i < hit_types.count() then {
                        if mono.storage.context.get_layout_key(
                            resolve_parameterized_type(mono, hit_types[i]),
                        ) != mono.storage.context.get_layout_key(
                            resolve_parameterized_type(mono, expected_types[i]),
                        ) then {
                            return false;
                        };
                        i += UInt(1);
                    };
                    true
                },
                _ then false,
            },
            _ then false,
        },
        .None() then false,
    };
};

file_private let symbol_matches_expected_or_trait_receiver(
    mono Monomorphizer,
    hit_def_id DefId,
    full_method_type Type,
    trait_def_id_opt Option[DefId],
) Bool = {
    if symbol_matches_full_method_type(mono, hit_def_id, full_method_type) then {
        return true;
    };
    return when trait_def_id_opt in {
        .Some(trait_def_id) then symbol_matches_full_method_type_via_trait_receiver(
            mono,
            hit_def_id,
            full_method_type,
            trait_def_id,
        ),
        .None() then false,
    };
};

/// Finds (or materializes) the specialization of the SAME method the
/// definition-time symbol named. The definition-time DefId is authoritative.
/// Identity lookup that NEVER instantiates -- a pure read of the tables.
///
/// `resolve_method_instance_by_identity`'s L2 materializes a specialization,
/// which mutates the monomorphizer. That is right at a call site and wrong in
/// the middle of type resolution: `refresh_list_pattern_ops` runs while the
/// resolution worklist is still draining, and an instantiation there perturbs
/// state that later makes codegen emit a payloadless init for a tagged enum
/// (`Type`, `InterpolatedStringTokenPart`). This variant answers only from what
/// is already registered (L0/L1) and leaves the tables untouched.
///
/// Read-only is not a weaker identity check: the key is still owner + DefId +
/// type args. It only declines to CREATE anything.
public let lookup_method_instance_identity_readonly(
    mono Monomorphizer,
    definition_method Symbol,
    receiver_type Type,
    method_type_args List[Type],
) Option[Symbol] = {
    let def_id = definition_method.def_id;
    if not def_id.is_valid() then {
        return Option[Symbol].None();
    };
    // L0: the DefId is already the emitted identity.
    if mono.storage.instantiated_method_def_ids.contains(def_id.id) then {
        return Option[Symbol].Some(definition_method);
    };
    let identity_def_id = when mono.storage.receiver_method_dispatch.get(def_id) in {
        .Some(dispatch_info) then when dispatch_info.method_def_id.is_valid() in {
            true then dispatch_info.method_def_id,
            false then def_id,
        },
        .None() then def_id,
    };
    let mutable lookup_def_ids = List[DefId].new();
    lookup_def_ids.push(identity_def_id);
    if not (identity_def_id == def_id) then {
        lookup_def_ids.push(def_id);
    };
    // Dual-key: trait-method references carry the trait METHOD's DefId
    // (rustc's `trait_item_def_id`), not the impl's.
    when mono.storage.receiver_method_dispatch.get(def_id) in {
        .Some(dispatch_info) then when dispatch_info.trait_method_def_id in {
            .Some(trait_item_def_id) then {
                if not lookup_def_ids.contains(trait_item_def_id) then {
                    lookup_def_ids.push(trait_item_def_id);
                };
            },
            .None() then {},
        },
        .None() then {},
    };
    for lookup_def_id in lookup_def_ids then {
        let lookup_key = make_receiver_method_identity_key(
            mono,
            receiver_type,
            lookup_def_id,
            method_type_args,
        );
        when mono.storage.extension_method_def_ids_by_identity.get(lookup_key) in {
            .Some(hit) then {
                let hit_type = when mono.storage.context.get_function_type(hit) in {
                    .Some(function_type) then function_type,
                    .None() then definition_method.symbol_type,
                };
                return Option[Symbol].Some(
                    Symbol(hit, hit_type, SymbolKind.Function()),
                );
            },
            .None() then {},
        };
        // Swift `remappedFunctionDefIds[oldDefId]` -- the GivenDecl remapping
        // maps the declaration DefId to the per-conforming-type instance DefId.
        when mono.storage.remapped_function_def_ids.get(lookup_def_id.id) in {
            .Some(remapped_list) then {
                if not remapped_list.is_empty() then {
                    let hit = (remapped_list[UInt(0)]).first;
                    let hit_type = when mono.storage.context.get_function_type(hit) in {
                        .Some(function_type) then function_type,
                        .None() then definition_method.symbol_type,
                    };
                    return Option[Symbol].Some(
                        Symbol(hit, hit_type, SymbolKind.Function()),
                    );
                };
            },
            .None() then {},
        };
    };
    return Option[Symbol].None();
};


public let resolve_method_instance_by_identity(
    mono Monomorphizer,
    definition_method Symbol,
    substituted_method_type Type,
    substituted_method_type_args List[Type],
    receiver_type Type,
) MethodInstanceResolution = {
    let def_id = definition_method.def_id;
    let identity_def_id = when mono.storage.receiver_method_dispatch.get(def_id) in {
        .Some(dispatch_info) then when dispatch_info.method_def_id.is_valid() in {
            true then dispatch_info.method_def_id,
            false then def_id,
        },
        .None() then def_id,
    };
    let trait_def_id_opt = when mono.storage.receiver_method_dispatch.get(identity_def_id) in {
        .Some(dispatch_info) then dispatch_info.conformance_trait_def_id,
        .None() then when mono.storage.receiver_method_dispatch.get(def_id) in {
            .Some(dispatch_info) then dispatch_info.conformance_trait_def_id,
            .None() then Option[DefId].None(),
        },
    };

    // Substitute method-level type parameters into the method type so the
    // expected type is fully concrete.
    let mutable full_method_type = substituted_method_type;
    let owner = mono.storage.context.method_owner_of(receiver_type);
    let dispatch_owner = when mono.storage.receiver_method_dispatch.get(identity_def_id) in {
        .Some(dispatch_info) then when dispatch_info.owner in {
            .Some(owner_ref) then when owner_ref in {
                .ExtensionTemplate(owner_def_id) then Option[MethodOwner].Some(
                    MethodOwner.Decl(owner_def_id),
                ),
                .ConcreteType(_) then Option[MethodOwner].None(),
            },
            .None() then Option[MethodOwner].None(),
        },
        .None() then when mono.storage.receiver_method_dispatch.get(def_id) in {
            .Some(dispatch_info) then when dispatch_info.owner in {
                .Some(owner_ref) then when owner_ref in {
                    .ExtensionTemplate(owner_def_id) then Option[MethodOwner].Some(
                        MethodOwner.Decl(owner_def_id),
                    ),
                    .ConcreteType(_) then Option[MethodOwner].None(),
                },
                .None() then Option[MethodOwner].None(),
            },
            .None() then Option[MethodOwner].None(),
        },
    };
    let exact_owner = exact_template_owner_for_method_def_id(mono, identity_def_id);

    // Template lookup by DECLARATION identity — never by name. Tries the
    // owner, then the exact owner, then the dispatch owner, each first under
    // the identity DefId and then the raw DefId (they differ when a trait
    // method link is present).
    let mutable template = mono.storage.generic_templates.lookup_extension_method_by_def_id(
        owner,
        identity_def_id,
    );
    if template is .None() then {
        when exact_owner in {
            .Some(exact_owner_ref) then {
                template = mono.storage.generic_templates.lookup_extension_method_by_def_id(
                    exact_owner_ref,
                    identity_def_id,
                );
            },
            .None() then {},
        };
    };
    if template is .None() then {
        when dispatch_owner in {
            .Some(dispatch_owner_ref) then {
                template = mono.storage.generic_templates.lookup_extension_method_by_def_id(
                    dispatch_owner_ref,
                    identity_def_id,
                );
            },
            .None() then {},
        };
    };
    if template is .None() and identity_def_id == def_id then {
        template = mono.storage.generic_templates.lookup_extension_method_by_def_id(
            owner,
            def_id,
        );
        if template is .None() then {
            when exact_owner in {
                .Some(exact_owner_ref) then {
                    template = mono.storage.generic_templates.lookup_extension_method_by_def_id(
                        exact_owner_ref,
                        def_id,
                    );
                },
                .None() then {},
            };
            if template is .None() then {
                when dispatch_owner in {
                    .Some(dispatch_owner_ref) then {
                        template = mono.storage.generic_templates.lookup_extension_method_by_def_id(
                            dispatch_owner_ref,
                            def_id,
                        );
                    },
                    .None() then {},
                };
            };
        };
    };

    let template_ref = when template in {
        .Some(template_ref) then Option[GenericExtensionMethodTemplate].Some(template_ref),
        .None() then Option[GenericExtensionMethodTemplate].None(),
    };

    if not substituted_method_type_args.is_empty() and has_generic_parameter(
        substituted_method_type,
    ) then {
        let mutable m_subst = Dict[String, Type].new();
        when template_ref in {
            .Some(template_ref) then {
                if not template_ref.method.type_params.is_empty() then {
                    let mutable i UInt = UInt(0);
                    while i < template_ref.method.type_params.count() and i < substituted_method_type_args.count() then {
                        m_subst.insert(
                            (template_ref.method.type_params[i]).name,
                            substituted_method_type_args[i],
                        );
                        i += UInt(1);
                    };
                } else {
                    let param_names = collect_generic_parameter_names_from_type(
                        substituted_method_type,
                    );
                    let mutable i UInt = UInt(0);
                    while i < param_names.count() and i < substituted_method_type_args.count() then {
                        m_subst.insert(
                            param_names[i],
                            substituted_method_type_args[i],
                        );
                        i += UInt(1);
                    };
                };
            },
            .None() then {
                let param_names = collect_generic_parameter_names_from_type(
                    substituted_method_type,
                );
                let mutable i UInt = UInt(0);
                while i < param_names.count() and i < substituted_method_type_args.count() then {
                    m_subst.insert(
                        param_names[i],
                        substituted_method_type_args[i],
                    );
                    i += UInt(1);
                };
            },
        };
        if not m_subst.is_empty() then {
            full_method_type = substitute_type(mono, substituted_method_type, m_subst);
        };
    };

    // L0: already-instantiated — the DefId IS the emitted identity.
    if mono.storage.instantiated_method_def_ids.contains(def_id.id) then {
        return MethodInstanceResolution.Instantiated(
            Symbol(def_id, full_method_type, definition_method.kind),
        );
    };
    // L1: direct hash lookup by identity key (DefId + GenericArgs). Check both
    // the definition-time DefId and the trait method DefId (for methods that
    // implement a trait method via `trait_item_def_id`).
    let pair = mono.storage.context.method_owner_and_args(receiver_type);
    let owner_args = pair.second;
    let mutable lookup_def_ids = List[DefId].new();
    lookup_def_ids.push(identity_def_id);
    if not (identity_def_id == def_id) then {
        lookup_def_ids.push(def_id);
    };
    for lookup_def_id in lookup_def_ids then {
        let lookup_key = make_receiver_method_identity_key(
            mono,
            receiver_type,
            lookup_def_id,
            substituted_method_type_args,
        );
        when mono.storage.extension_method_def_ids_by_identity.get(lookup_key) in {
            .Some(hit) then {
                if symbol_matches_expected_or_trait_receiver(
                    mono,
                    hit,
                    full_method_type,
                    trait_def_id_opt,
                ) then {
                    return MethodInstanceResolution.Instantiated(
                        Symbol(hit, full_method_type, SymbolKind.Function()),
                    );
                };
            },
            .None() then {},
        };
        // Swift `remappedFunctionDefIds[oldDefId]` — the GivenDecl remapping
        // (register_given_decl_method_identities) maps the declaration DefId to
        // the per-conforming-type instance DefId.
        when mono.storage.remapped_function_def_ids.get(lookup_def_id.id) in {
            .Some(remapped_list) then {
                for remapped in remapped_list then {
                    if symbol_matches_expected_or_trait_receiver(
                        mono,
                        remapped.first,
                        full_method_type,
                        trait_def_id_opt,
                    ) then {
                        return MethodInstanceResolution.Instantiated(
                            Symbol(remapped.first, full_method_type, SymbolKind.Function()),
                        );
                    };
                };
            },
            .None() then {},
        };
        // Dual-key: also check under the trait method DefId.
        let trait_method_def_id = when mono.storage.receiver_method_dispatch.get(
            lookup_def_id,
        ) in {
            .Some(dispatch_info) then dispatch_info.trait_method_def_id,
            .None() then when mono.storage.receiver_method_dispatch.get(def_id) in {
                .Some(dispatch_info) then dispatch_info.trait_method_def_id,
                .None() then Option[DefId].None(),
            },
        };
        when trait_method_def_id in {
            .Some(trait_item_def_id) then {
                let trait_key = make_receiver_method_identity_key(
                    mono,
                    receiver_type,
                    trait_item_def_id,
                    substituted_method_type_args,
                );
                when mono.storage.extension_method_def_ids_by_identity.get(trait_key) in {
                    .Some(hit) then {
                        if symbol_matches_expected_or_trait_receiver(
                            mono,
                            hit,
                            full_method_type,
                            trait_def_id_opt,
                        ) then {
                            return MethodInstanceResolution.Instantiated(
                                Symbol(hit, full_method_type, SymbolKind.Function()),
                            );
                        };
                    },
                    .None() then {},
                };
            },
            .None() then {},
        };
    };

    // L2: materialize this declaration's specialization, then retry L1.
    when template_ref in {
        .Some(template_ref) then {
            let resolved_base = resolve_parameterized_type(mono, receiver_type);
            let receiver_owner_args = if not owner_args.is_empty() then owner_args
            else when resolved_base in {
                .GenericStruct(_, args) then args,
                .GenericEnum(_, args) then args,
                .StructureType(s_def_id) then mono.storage.context.get_type_arguments(
                    s_def_id,
                ) or else List[Type].new(),
                .EnumType(s_def_id) then mono.storage.context.get_type_arguments(
                    s_def_id,
                ) or else List[Type].new(),
                _ then List[Type].new(),
            };
            let m_args = if not substituted_method_type_args.is_empty() then substituted_method_type_args
            else if not template_ref.method.type_params.is_empty() then infer_method_type_args_by_signature(
                mono,
                template_ref,
                full_method_type,
            )
            else List[Type].new();
            let resolved_owner_args = if template_ref.type_params.count() == receiver_owner_args.count() then receiver_owner_args
            else when infer_trait_extension_type_args_by_method_type(
                mono,
                resolved_base,
                template_ref,
                full_method_type,
                m_args,
            ) in {
                .Some(inferred) then inferred,
                .None() then receiver_owner_args,
            };
            if m_args.count() == template_ref.method.type_params.count() and template_ref.type_params.count() == resolved_owner_args.count() then {
                let inst_sym = instantiate_extension_method(
                    mono,
                    resolved_base,
                    owner,
                    template_ref,
                    resolved_owner_args,
                    m_args,
                );
                if inst_sym.def_id.is_valid() then {
                    // Retry L1 after instantiation.
                    for lookup_def_id in lookup_def_ids then {
                        let retry_key = make_receiver_method_identity_key(
                            mono,
                            receiver_type,
                            lookup_def_id,
                            m_args,
                        );
                        when mono.storage.extension_method_def_ids_by_identity.get(
                            retry_key,
                        ) in {
                            .Some(hit) then {
                                if symbol_matches_expected_or_trait_receiver(
                                    mono,
                                    hit,
                                    full_method_type,
                                    trait_def_id_opt,
                                ) then {
                                    return MethodInstanceResolution.Instantiated(
                                        Symbol(
                                            hit,
                                            full_method_type,
                                            SymbolKind.Function(),
                                        ),
                                    );
                                };
                            },
                            .None() then {},
                        };
                    };
                    // The freshly instantiated symbol IS the answer.
                    if symbol_matches_expected_or_trait_receiver(
                        mono,
                        inst_sym.def_id,
                        full_method_type,
                        trait_def_id_opt,
                    ) then {
                        return MethodInstanceResolution.Instantiated(
                            Symbol(
                                inst_sym.def_id,
                                full_method_type,
                                SymbolKind.Function(),
                            ),
                        );
                    };
                };
            };
        },
        .None() then {
        },
    };

    // L3: keep the definition-time DefId ONLY if it's already an emitted
    // function (concrete given / built-in). Otherwise the C name would be the
    // template's name.
    if mono.storage.instantiated_method_def_ids.contains(def_id.id) then {
        return MethodInstanceResolution.Instantiated(
            Symbol(def_id, full_method_type, definition_method.kind),
        );
    };
    return MethodInstanceResolution.KeepDefinitionTime(full_method_type);
};

/// Tries each receiver candidate (the receiver and its pointee) and returns the
/// first instantiated result. Falls back to the first keepDefinitionTime.
public let resolve_method_instance_by_identity_for_receiver(
    mono Monomorphizer,
    definition_method Symbol,
    substituted_method_type Type,
    substituted_method_type_args List[Type],
    receiver_type Type,
) MethodInstanceResolution = {
    let mutable keep_definition_time = Option[Type].None();
    let candidates = identity_receiver_lookup_candidates(mono, receiver_type);
    for candidate in candidates then {
        if has_generic_parameter(candidate) then {
            continue;
        };
        let resolution = resolve_method_instance_by_identity(
            mono,
            definition_method,
            substituted_method_type,
            substituted_method_type_args,
            candidate,
        );
        when resolution in {
            .Instantiated(_) then {
                return resolution;
            },
            .KeepDefinitionTime(method_type) then {
                if keep_definition_time is .None() then {
                    keep_definition_time = Option[Type].Some(method_type);
                };
            },
        };
    };
    when keep_definition_time in {
        .Some(method_type) then MethodInstanceResolution.KeepDefinitionTime(
            method_type,
        ),
        .None() then MethodInstanceResolution.KeepDefinitionTime(
            substituted_method_type,
        ),
    }
};

/// Resolve a standalone method reference (`.variable` / `.call` callee) to its
/// concrete instance (Swift's `resolveStandaloneMethodFunctionReference`).
/// Receiver candidates come from the function type's first parameter, the
/// return type, and the template owner — never from a name lookup. Returns
/// None when no instance has been materialized; the caller then keeps the
/// definition-time symbol.
public let resolve_standalone_method_function_reference(
    mono Monomorphizer,
    definition_method Symbol,
    substituted_function_type Type,
    substituted_method_type_args List[Type],
) Option[Symbol] = {
    let resolved_function_type = resolve_parameterized_type(
        mono,
        substituted_function_type,
    );
    let (fn_params, fn_returns) = when resolved_function_type in {
        .FunctionType(params, ret) then Pair(params, ret),
        _ then {
            return Option[Symbol].None();
        },
    };
    let mutable receiver_candidates = List[Type].new();
    let mutable seen = Set[Type].new();
    let param_types = param_entry_types(fn_params);
    if not param_types.is_empty() then {
        for candidate in identity_receiver_lookup_candidates(mono, param_types[UInt(0)]) then {
            if not has_generic_parameter(candidate) and not seen.contains(candidate) then {
                seen.insert(candidate);
                receiver_candidates.push(candidate);
            };
        };
    };
    for candidate in identity_receiver_lookup_candidates(mono, fn_returns) then {
        if not has_generic_parameter(candidate) and not seen.contains(candidate) then {
            seen.insert(candidate);
            receiver_candidates.push(candidate);
        };
    };
    when resolve_parameterized_type(mono, fn_returns) in {
        .GenericStruct(_, args) then {
            for arg in args then {
                for candidate in identity_receiver_lookup_candidates(mono, arg) then {
                    if not has_generic_parameter(candidate) and not seen.contains(candidate) then {
                        seen.insert(candidate);
                        receiver_candidates.push(candidate);
                    };
                };
            };
        },
        .GenericEnum(_, args) then {
            for arg in args then {
                for candidate in identity_receiver_lookup_candidates(mono, arg) then {
                    if not has_generic_parameter(candidate) and not seen.contains(candidate) then {
                        seen.insert(candidate);
                        receiver_candidates.push(candidate);
                    };
                };
            };
        },
        .StructureType(s_def_id) then {
            when mono.storage.context.get_type_arguments(s_def_id) in {
                .Some(args) then {
                    for arg in args then {
                        for candidate in identity_receiver_lookup_candidates(mono, arg) then {
                            if not has_generic_parameter(candidate) and not seen.contains(candidate) then {
                                seen.insert(candidate);
                                receiver_candidates.push(candidate);
                            };
                        };
                    };
                },
                .None() then {},
            };
        },
        .EnumType(s_def_id) then {
            when mono.storage.context.get_type_arguments(s_def_id) in {
                .Some(args) then {
                    for arg in args then {
                        for candidate in identity_receiver_lookup_candidates(mono, arg) then {
                            if not has_generic_parameter(candidate) and not seen.contains(candidate) then {
                                seen.insert(candidate);
                                receiver_candidates.push(candidate);
                            };
                        };
                    };
                },
                .None() then {},
            };
        },
        _ then {},
    };
    // The definition's own owner: methods declared on a type whose instance is
    // only visible through the dispatch table still need a candidate.
    when mono.storage.receiver_method_dispatch.get(definition_method.def_id) in {
        .Some(dispatch_info) then {
            when dispatch_info.owner in {
                .Some(owner_ref) then {
                    when owner_ref in {
                        .ConcreteType(owner_type) then {
                            for candidate in identity_receiver_lookup_candidates(
                                mono,
                                owner_type,
                            ) then {
                                if not has_generic_parameter(candidate) and not seen.contains(candidate) then {
                                    seen.insert(candidate);
                                    receiver_candidates.push(candidate);
                                };
                            };
                        },
                        .ExtensionTemplate(_) then {},
                    }
                },
                .None() then {},
            }
        },
        .None() then {},
    };
    when exact_template_owner_for_method_def_id(mono, definition_method.def_id) in {
        .Some(owner) then {
            let owner_type = when owner in {
                .Decl(owner_def_id) then when mono.storage.context.lookup_type(
                    owner_def_id,
                ) in {
                    .Some(t) then t,
                    .None() then Type.Unknown(),
                },
                .Builtin(name) then builtin_type_for_owner_name(name),
            };
            if not (owner_type is .Unknown()) then {
                for candidate in identity_receiver_lookup_candidates(
                    mono,
                    owner_type,
                ) then {
                    if not has_generic_parameter(candidate) and not seen.contains(candidate) then {
                        seen.insert(candidate);
                        receiver_candidates.push(candidate);
                    };
                };
            };
        },
        .None() then {},
    };
    for receiver_type in receiver_candidates then {
        let resolution = resolve_method_instance_by_identity_for_receiver(
            mono,
            definition_method,
            resolved_function_type,
            substituted_method_type_args,
            receiver_type,
        );
        when resolution in {
            .Instantiated(symbol) then {
                return Option[Symbol].Some(
                    Symbol(
                        symbol.def_id,
                        resolve_parameterized_type(mono, symbol.symbol_type),
                        symbol.kind,
                    ),
                );
            },
            .KeepDefinitionTime(_) then {},
        };
    };
    return Option[Symbol].None();
};

// Built-in scalar/modifier type for an owner name in the closed `builtin`
// space. Only used to recover a candidate receiver type from an owner that
// has no declaration to carry one.
file_private let builtin_type_for_owner_name(name String) Type = {
    return when name in {
        "Int" then Type.IntType(),
        "Int8" then Type.Int8Type(),
        "Int16" then Type.Int16Type(),
        "Int32" then Type.Int32Type(),
        "Int64" then Type.Int64Type(),
        "UInt" then Type.UIntType(),
        "UInt8" then Type.UInt8Type(),
        "UInt16" then Type.UInt16Type(),
        "UInt32" then Type.UInt32Type(),
        "UInt64" then Type.UInt64Type(),
        "Float32" then Type.Float32Type(),
        "Float64" then Type.Float64Type(),
        "Bool" then Type.BoolType(),
        _ then Type.Unknown(),
    };
};

/// Resolve a trait-method placeholder to the concrete implementation by the
/// trait METHOD's DefId (Swift's `resolveTraitPlaceholderMethodByIdentity`).
/// Pure identity: no name lookup. Returns None when nothing has been
/// instantiated for this identity yet.
public let resolve_trait_placeholder_method_by_identity(
    mono Monomorphizer,
    trait_method_def_id DefId,
    expected_method_type Type,
    method_type_args List[Type],
    receiver_type Type,
) Option[Symbol] = {
    if not trait_method_def_id.is_valid() then {
        return Option[Symbol].None();
    };
    let definition_method = Symbol(
        trait_method_def_id,
        expected_method_type,
        SymbolKind.Function(),
    );
    let resolution = resolve_method_instance_by_identity_for_receiver(
        mono,
        definition_method,
        expected_method_type,
        method_type_args,
        receiver_type,
    );
    return when resolution in {
        .Instantiated(symbol) then Option[Symbol].Some(
            Symbol(
                symbol.def_id,
                resolve_parameterized_type(mono, symbol.symbol_type),
                symbol.kind,
            ),
        ),
        .KeepDefinitionTime(_) then Option[Symbol].None(),
    };
};

// ── instantiate_extension_method_from_entry ──────────────────────────────────

file_private let normalize_borrowed_extension_base_type(
    base_type Type,
    owner MethodOwner,
) Type = {
    let owner_kind = when owner in {
        .Builtin(kind) then kind,
        .Decl(_) then "",
    };
    return when owner_kind in {
        "Ref" then when base_type in {
            .BorrowedReferenceType(inner) then Type.ReferenceType(inner),
            .MutableBorrowedReferenceType(inner) then Type.ReferenceType(inner),
            _ then base_type,
        },
        "MutRef" then when base_type in {
            .MutableBorrowedReferenceType(inner) then Type.MutableReferenceType(inner),
            _ then base_type,
        },
        _ then base_type,
    };
};

// Inner implementation matching Swift's instantiateExtensionMethodFromEntry.
// Receives already-resolved base_type, structure_name, and resolved template.
//
// Steps:
//   a. Generate the symbol name using make_extension_method_layout_name
//   b. Check caches — if already registered, return existing symbol
//   c. Build type substitution map
//   d. Resolve parameter types and return type
//   e. Allocate a new DefId for the concrete method
//   f. Register in extension_method_def_ids_by_identity with dual keys
//   g. Register in extension_methods map for the type
//   h. Emit the declaration node (FunctionDecl or IntrinsicFunctionDecl)
//   i. Return the Symbol for the instantiated method
//
public let instantiate_extension_method_from_entry(
    mono Monomorphizer,
    base_type Type,
    structure_name String,
    effective_owner MethodOwner,
    type_args List[Type],
    method_type_args List[Type],
    template GenericExtensionMethodTemplate,
) Symbol = {
    // "Is the owner a trait?" is a question about the DECLARATION. It used to be
    // answered by looking a name up in the trait registry.
    let conformance_template = when mono.storage.generic_templates.is_trait_owner(
        effective_owner,
    ) in {
        true then select_conformance_extension_template(
            mono,
            base_type,
            template.method.name,
            Option[UInt].Some(template.method.type_params.count()),
        ),
        false then Option[GenericExtensionMethodTemplate].None(),
    };
    let resolved_template = when conformance_template in {
        .Some(conformance_ref) then patched_extension_template_with_body(
            template,
            conformance_ref,
        ),
        .None() where template.checked_body is .Some(_) then template,
        .None() then {
            // A trait-tool body is stored under the TRAIT's owner; an ordinary
            // extension body under the type's. Both are identities.
            let lookup_owner = when template.conformance_trait_def_id in {
                .Some(trait_def_id) then MethodOwner.Decl(trait_def_id),
                .None() then effective_owner,
            };
            when mono.storage.generic_templates.lookup_extension_methods(lookup_owner) in {
                .Some(tool_templates) then when select_extension_template(
                    tool_templates,
                    template.method.name,
                    Option[UInt].Some(template.method.type_params.count()),
                    Option[UInt].Some(template.type_params.count()),
                ) in {
                    .Some(tool_template_ref) then patched_extension_template_with_body(
                        template,
                        tool_template_ref,
                    ),
                    .None() then template,
                },
                .None() then template,
            }
        },
    };

    let owner_constraints_satisfied = extension_type_args_satisfy_constraints(
        mono,
        resolved_template,
        type_args,
    );
    if not owner_constraints_satisfied then {
        return Symbol(DefId(UInt(0)), Type.Unknown(), SymbolKind.Function());
    };

    // A trait-tool body carries its own generic parameters -- the ones it was
    // written against -- whose constraints must also hold. `type_params` above is
    // the CONFORMANCE's parameter list, so `extension_type_args_satisfy_constraints`
    // cannot see these: `join_to_string` needs `T ToString` and `into_set` needs
    // `T Hash`, and when the trait argument is `Pair[K, V]` that means `K` and `V`
    // must satisfy them too. `DictIterator[K Hash, V Any]` does not promise that,
    // so those tools must not be emitted for, say,
    // `DictIterator[String, ResolvedModuleSpec]`.
    // Tool parameter `i` binds to the conformance's trait argument `i` -- the same
    // binding Swift uses in `enforceGenericConstraints(typeParameters:args:)`.
    if not resolved_template.tool_type_params.is_empty() then {
        let tool_trait_args = resolve_extension_template_conformance_trait_args(
            mono,
            base_type,
            resolved_template,
        );
        if tool_trait_args.count() == resolved_template.tool_type_params.count() then {
            let mutable tool_idx UInt = 0;
            while tool_idx < resolved_template.tool_type_params.count() then {
                let tool_param = resolved_template.tool_type_params[tool_idx];
                let bound_type = resolve_parameterized_type(
                    mono,
                    (tool_trait_args[tool_idx]),
                );
                for constraint in tool_param.constraints then {
                    if not type_satisfies_bound_constraint(mono, bound_type, constraint) then {
                        return Symbol(
                            DefId(UInt(0)),
                            Type.Unknown(),
                            SymbolKind.Function(),
                        );
                    };
                };
                tool_idx += 1;
            };
        };
    };

    // Compute concrete_lookup_type_name matching Swift's logic:
    //   StructureType(defId) → context.getName(defId)
    //   EnumType(defId)      → context.getName(defId)
    //   default              → structure_name
    let concrete_lookup_type_name = when base_type in {
        .StructureType(did) then mono.storage.context.get_name(did) or else structure_name,
        .EnumType(did) then mono.storage.context.get_name(did) or else structure_name,
        .ReferenceType(_) then mono.storage.context.get_layout_key(
            resolve_parameterized_type(mono, base_type),
        ),
        .MutableReferenceType(_) then mono.storage.context.get_layout_key(
            resolve_parameterized_type(mono, base_type),
        ),
        .BorrowedReferenceType(_) then mono.storage.context.get_layout_key(
            resolve_parameterized_type(mono, base_type),
        ),
        .MutableBorrowedReferenceType(_) then mono.storage.context.get_layout_key(
            resolve_parameterized_type(mono, base_type),
        ),
        .WeakReferenceType(_) then mono.storage.context.get_layout_key(
            resolve_parameterized_type(mono, base_type),
        ),
        .MutableWeakReferenceType(_) then mono.storage.context.get_layout_key(
            resolve_parameterized_type(mono, base_type),
        ),
        .PointerType(_) then mono.storage.context.get_layout_key(
            resolve_parameterized_type(mono, base_type),
        ),
        .MutablePointerType(_) then mono.storage.context.get_layout_key(
            resolve_parameterized_type(mono, base_type),
        ),
        _ then structure_name,
    };
    let mangle_template_name = structure_name;
    // a. Generate the symbol name. The owner's DECLARATION joins it so two
    //    modules' same-named types get two C symbols (see the mangle helper).
    // The mangle owner is the RECEIVER TYPE's declaration, always -- never
    // `effective_owner`, which is the trait's declaration for a trait-tool method
    // and the type's for a plain extension. Using both produced two C names for
    // one method (`SetIterator_I_next_d33` vs `SetIterator_I_next_d74`), and the
    // call site and the definition disagreed about which was which.
    let mangle_owner_id = when mono.storage.context.method_owner_of(base_type) in {
        .Decl(d) then d,
        .Builtin(_) then def_id_invalid(),
    };
    // The INSTANCE's type arguments, never the extension template's. A trait
    // tool is declared against the TRAIT's parameters (`given[T Any] Iterator[T]`
    // has one), so `type_args` carries the trait arguments while the receiver
    // `MapIterator[T, U, R]` carries three. Mangling and keying on `type_args`
    // collapsed `MapIterator[Int, Int, ListIterator[Int]]` and
    // `MapIterator[Int, Int, FilterIterator[Int, ListIterator[Int]]]` into one C
    // symbol: the second `into_list` call type-checked fine and then passed its
    // receiver to the first one's definition.
    let mutable instance_type_args = List[Type].new();
    let resolved_base_for_args = resolve_parameterized_type(mono, base_type);
    when resolved_base_for_args in {
        .GenericStruct(_, args) then {
            for a in args then instance_type_args.push(a);
        },
        .GenericEnum(_, args) then {
            for a in args then instance_type_args.push(a);
        },
        .StructureType(did) then {
            when mono.storage.context.get_type_arguments(did) in {
                .Some(args) then {
                    for a in args then instance_type_args.push(a);
                },
                .None() then {},
            };
        },
        .EnumType(did) then {
            when mono.storage.context.get_type_arguments(did) in {
                .Some(args) then {
                    for a in args then instance_type_args.push(a);
                },
                .None() then {},
            };
        },
        _ then {},
    };
    if instance_type_args.is_empty() then {
        for a in type_args then instance_type_args.push(a);
    };
    let mangled_name = make_extension_method_layout_name(
        mono,
        mangle_template_name,
        mangle_owner_id,
        instance_type_args,
        resolved_template.method.name,
        method_type_args,
    );
    // Keyed by the INSTANTIATION: the owner plus the type arguments this method
    // was instantiated with. `List[String]` and `List[Rune]` are two entries.
    let lookup_key = MethodLookupKey(
        effective_owner,
        instance_type_args,
        resolved_template.method.name,
        method_type_args,
    );
    let cache_key = "ext:\(mangled_name)";
    when mono.storage.instantiated_function_symbols.get(cache_key) in {
        .Some(cached_symbol) then {
            let template_has_body = lookup_extension_template_checked_body(
                mono,
                resolved_template,
            ) is .Some(_);
            let cached_has_body = mono.storage.resolved_function_body_ids.contains(
                cached_symbol.def_id.id,
            ) or mono.storage.context.get_concrete_function_body(cached_symbol.def_id) is .Some(_);
            if not template_has_body or cached_has_body then {
                return cached_symbol;
            };
        },
        .None() then {},
    };

    // c. Build type substitution map.
    let mutable substitution = Dict[String, Type].new();

    // template.type_params[i].name → type_args[i]
    let tp_count = if resolved_template.type_params.count() < type_args.count() then resolved_template.type_params.count(
    ) else type_args.count();
    let mutable tp_idx = UInt(0);
    while tp_idx < tp_count then {
        let tp = resolved_template.type_params[tp_idx];
        substitution.insert(tp.name, type_args[tp_idx]);
        tp_idx += UInt(1);
    };

    // template.method.type_params[i].name → method_type_args[i]
    // The method's own type arguments may be absent (inference did not produce
    // any), so index against the shorter of the two — indexing
    // `method_type_args[mtp_idx]` unguarded panics on `Option.map` and friends.
    let mtp_count = if resolved_template.method.type_params.count() < method_type_args.count(
    ) then resolved_template.method.type_params.count() else method_type_args.count();
    let mutable mtp_idx = UInt(0);
    while mtp_idx < mtp_count then {
        let mtp = resolved_template.method.type_params[mtp_idx];
        substitution.insert(mtp.name, method_type_args[mtp_idx]);
        mtp_idx += UInt(1);
    };

    // Also substitute Self with the base type
    substitution.insert("Self", base_type);

    // Set current_self_type mutable so resolve_parameterized_type can resolve GenericParameter("Self")
    let saved_self_type = mono.storage.current_self_type;
    mono.storage.current_self_type = Option[Type].Some(base_type);

    when resolved_template.checked_parameters in {
        .Some(checked_params) then {
            let _ = checked_params;
        },
        .None() then {},
    };

    if type_args.count() != resolved_template.type_params.count() then {
        mono.storage.current_self_type = saved_self_type;
        return Symbol(DefId(UInt(0)), Type.Unknown(), SymbolKind.Function());
    };
    if method_type_args.count() != resolved_template.method.type_params.count() then {
        mono.storage.current_self_type = saved_self_type;
        return Symbol(DefId(UInt(0)), Type.Unknown(), SymbolKind.Function());
    };

    // d. Resolve parameter types and return type.
    let mutable concrete_params = List[TypedParam].new();
    let mutable concrete_param_types = List[Type].new();

    when resolved_template.checked_parameters in {
        .Some(checked_params_list) then {
            for sym in checked_params_list then {
                let mutable substituted_type = mono.substitute_type_impl(
                    sym.symbol_type,
                    substitution,
                );
                let mutable resolved_type = resolve_parameterized_type(
                    mono,
                    substituted_type,
                );
                concrete_params.push(
                    TypedParam(
                        mono.storage.context.symbol_name(sym),
                        sym.is_mutable(),
                        resolved_type,
                        false,
                    ),
                );
                concrete_param_types.push(resolved_type);
            };
        },
        .None() then {
            let node_subst = template_substitution(
                resolved_template.type_params,
                substitution,
            );
            for p in resolved_template.method.params then {
                let mutable resolved_type = resolve_parameterized_type(
                    mono,
                    mono.resolve_type_node_impl(p.param_type, node_subst),
                );
                concrete_params.push(
                    TypedParam(p.name, p.is_mutable, resolved_type, p.named),
                );
                concrete_param_types.push(resolved_type);
            };
        },
    };

    let concrete_return_type = when resolved_template.checked_return_type in {
        .Some(checked_return_type) then {
            let mutable substituted_return_type = mono.substitute_type_impl(
                checked_return_type,
                substitution,
            );
            resolve_parameterized_type(mono, substituted_return_type)
        },
        .None() then {
            let node_subst = template_substitution(
                resolved_template.type_params,
                substitution,
            );
            let mutable resolved_node_type = mono.resolve_type_node_impl(
                resolved_template.method.return_type,
                node_subst,
            );
            resolve_parameterized_type(mono, resolved_node_type)
        },
    };
    let mutable method_param_entries = List[FunctionParamEntry].new();
    let mutable method_param_index = UInt(0);

    while method_param_index < concrete_params.count() then {
        let declared_param = resolved_template.method.params[method_param_index];
        let param_type = concrete_params[method_param_index].param_type;
        method_param_entries.push(
            FunctionParamEntry(
                param_type,
                pass_kind_from_type_node(declared_param.param_type),
            ),
        );
        method_param_index += UInt(1);
    };
    let function_type = Type.FunctionType(method_param_entries, concrete_return_type);
    let method_span = resolved_template.method.span;

    // e. Allocate a new DefId for the concrete method with full metadata so
    // codegen can bind the emitted FunctionDecl back to this symbol.
    let def_id = mono.storage.context.allocate_full(
        mangled_name,
        DefKind.Function(),
        List[String].new(),
        "",
        resolved_template.method.access,
        method_span,
    );

    // Register the function signature.
    let mutable param_specs = List[FunctionParamSpec].new();
    for p in concrete_params then {
        param_specs.push(FunctionParamSpec(p.name, p.is_mutable, p.named, false));
    };
    mono.storage.context.set_symbol_info(
        def_id,
        SymbolInfo(function_type, SymbolKind.Function(), MethodKind.Normal(), false),
    );
    mono.storage.context.set_param_specs(def_id, param_specs);
    mono.storage.context.set_cname(def_id, mangled_name);

    // Build the result symbol.
    let result_symbol = Symbol(def_id, function_type, SymbolKind.Function());
    // Keep the semantic method name for receiver lookup. Concrete C naming
    // comes from the DefId/c_identifier path, while typed lookup keys carry
    // any method type arguments separately.
    let logical_name_with_args = resolved_template.method.name;
    // Only set owner_type mutable for actual instance methods (first param is self/source).
    // Standalone functions (no `self`/`source` first parameter) must not get
    // method-style C naming.
    let mutable has_receiver = false;
    if not resolved_template.method.params.is_empty() then {
        let first_name = resolved_template.method.params[UInt(0)].name;
        has_receiver = first_name == "self" or first_name == "source";
    };
    let effective_owner_type = if has_receiver then Option[Type].Some(base_type)
    else Option[Type].None();
    mono.register_concrete_callable_if_absent(
        ConcreteCallableInfo(
            def_id,
            logical_name_with_args,
            effective_owner_type,
            resolved_template.conformance_trait_name,
            resolved_template.conformance_trait_def_id,
        ),
    );
    // rustc's `trait_item_def_id`: the trait METHOD this instance implements,
    // so trait-method references can find it by the trait item's DefId rather
    // than by name. Resolved at registration and carried on the template --
    // mono reads it and never re-derives it from a method spelling.
    let trait_method_def_id = resolved_template.trait_method_def_id;
    when effective_owner_type in {
        .Some(owner_type) then {
            let resolved_trait_method_def_id = when trait_method_def_id in {
                .Some(_) then trait_method_def_id,
                // Swift TypeChecker.registerReceiverStyleMethod: with a
                // conformance trait but no separate trait-method lookup hit,
                // the impl method IS the trait method's identity.
                .None() then if resolved_template.conformance_trait_name is .Some(_) then Option[DefId].Some(
                    def_id,
                ) else Option[DefId].None(),
            };
            mono.set_receiver_method_dispatch_if_absent(
                def_id,
                ReceiverMethodDispatchInfo(
                    def_id,
                    resolved_template.method.name,
                    Option[ReceiverMethodOwner].Some(
                        ReceiverMethodOwner.ConcreteType(owner_type),
                    ),
                    resolved_template.conformance_trait_name,
                    resolved_template.conformance_trait_def_id,
                    resolved_trait_method_def_id,
                ),
            );
        },
        .None() then {},
    };

    // Where the method was REGISTERED from: its owner identity, plus the trait
    // it was declared in when there is one. Both are identities; the old version
    // pushed the mangle name, the lookup name and the trait's spelling.
    let mutable remap_source_keys = List[MethodOwner].new();
    remap_source_keys.push(effective_owner);
    when resolved_template.conformance_trait_def_id in {
        .Some(trait_def_id) then remap_source_keys.push(MethodOwner.Decl(trait_def_id)),
        .None() then {},
    };
    for source_key in remap_source_keys then {
        when mono.storage.method_table.lookup(source_key, resolved_template.method.name) in {
            .Some(original_symbol) then {
                when mono.storage.remapped_function_def_ids.get(
                    original_symbol.def_id.id,
                ) in {
                    .Some(existing_list) then {
                        let mutable updated = existing_list;
                        let mutable already_present = false;
                        for entry in updated then {
                            if entry.first.id == def_id.id then {
                                already_present = true;
                            };
                        };
                        if not already_present then {
                            updated.push(Pair(def_id, function_type));
                            mono.storage.remapped_function_def_ids.insert(
                                original_symbol.def_id.id,
                                updated,
                            );
                        };
                    },
                    .None() then {
                        let mutable new_list = List[Pair[DefId, Type]].new();
                        new_list.push(Pair(def_id, function_type));
                        mono.storage.remapped_function_def_ids.insert(
                            original_symbol.def_id.id,
                            new_list,
                        );
                    },
                };
            },
            .None() then {},
        };
    };

    // The emitted DefId IS the final identity (Swift
    // `instantiatedMethodDefIds.insert`): resolve_method_instance_by_identity's
    // L0 short-circuit.
    mono.storage.instantiated_method_def_ids.insert(def_id.id);
    let identity_lookup_key = make_extension_method_identity_key(
        mono,
        effective_owner,
        instance_type_args,
        resolved_template.method.def_id,
        method_type_args,
    );
    mono.storage.extension_method_def_ids_by_identity.insert(identity_lookup_key, def_id);
    // Dual-key: trait-method references carry the trait METHOD's DefId
    // (rustc's `trait_item_def_id`), not the impl's. Register the instance
    // under that identity too so identity lookup finds it either way.
    when trait_method_def_id in {
        .Some(trait_item_def_id) then {
            let trait_identity_key = make_extension_method_identity_key(
                mono,
                effective_owner,
                instance_type_args,
                trait_item_def_id,
                method_type_args,
            );
            mono.storage.extension_method_def_ids_by_identity.insert(
                trait_identity_key,
                def_id,
            );
        },
        .None() then {},
    };

    // g. Register in extension_methods map for the type.
    if method_type_args.is_empty() then {
        let method_entry = ConcreteMethodEntry(result_symbol, Option[String].None());
        // Per INSTANTIATION: `Set[Pair[Int,Int]]` and `Set[Pair[String,Int]]` are
        // two entries, not one bucket keyed by `Set`.
        mono.storage.extension_methods.insert(lookup_key, method_entry);
    };

    // Cache before body substitution so recursive/re-entrant extension
    // instantiations can reuse the symbol instead of re-entering the body path.
    mono.storage.instantiated_functions.insert(
        mangled_name,
        InstantiatedFunction(mangled_name, function_type),
    );
    mono.storage.instantiated_function_symbols.insert(cache_key, result_symbol);

    // Skip code generation if the instantiated function type still contains
    // generic parameters. Mirrors Swift `instantiateExtensionMethodFromEntry`'s
    // post-substitution guard: a template body whose type params did not fully
    // substitute must never be emitted, or MIR verification sees an unresolved
    // generic (e.g. `Pair[T,U].hash`) and fails. The symbol is still returned so
    // identity lookup can reference it.
    if has_generic_parameter(function_type) then {
        mono.storage.current_self_type = saved_self_type;
        return result_symbol;
    };

    // h. Emit the declaration node.
    when lookup_extension_template_checked_body(mono, resolved_template) in {
        .Some(body) then {
            if mono.storage.extension_body_resolution_depth > 0 then {
                let deferred_req = InstantiationRequest(
                    InstantiationKind.ExtensionMethod(
                        effective_owner,
                        base_type,
                        resolved_template,
                        type_args,
                        method_type_args,
                    ),
                    0,
                    "",
                );
                let deferred_key = deferred_req.deduplication_key();
                if not mono.storage.processed_request_keys.contains(deferred_key) and not mono.storage.pending_request_keys.contains(
                    deferred_key,
                ) then {
                    mono.storage.pending_request_keys.insert(deferred_key);
                    mono.storage.pending_requests.push(deferred_req);
                } else {
                };
                mono.storage.current_self_type = saved_self_type;
                return result_symbol;
            };
            // Substitute generic params with concrete types and emit a FunctionDecl.
            mono.storage.extension_body_resolution_depth += 1;
            let saved_self_type = mono.storage.current_self_type;
            mono.storage.current_self_type = Option[Type].Some(base_type);
            let concrete_body = mono.substitute_types_in_expression_impl(
                body,
                substitution,
            );
            let resolved_concrete_body = resolve_types_in_expression(mono, concrete_body);
            mono.storage.current_self_type = saved_self_type;
            let mutable context = mono.storage.context;
            context.set_concrete_function_body(def_id, resolved_concrete_body);
            mono.storage.resolved_function_body_ids.insert(def_id.id);
            let decl = TypedDecl.FunctionDecl(
                resolved_template.method.access,
                mangled_name,
                concrete_params,
                concrete_return_type,
                make_mono_function_body_placeholder_expr(concrete_return_type),
                method_span,
                Symbol(def_id, function_type, SymbolKind.Function()),
            );
            mono.storage.generated_nodes.push(decl);
            mono.storage.extension_body_resolution_depth -= 1;
        },
        .None() then {
            // Intrinsic extension method — emit an IntrinsicFunctionDecl.
            let decl = TypedDecl.IntrinsicFunctionDecl(
                resolved_template.method.access,
                mangled_name,
                concrete_params,
                concrete_return_type,
                method_span,
                Symbol(def_id, Type.Unknown(), SymbolKind.Function()),
            );
            mono.storage.generated_nodes.push(decl);
        },
    };

    // i. Return the Symbol for the instantiated method.
    mono.storage.current_self_type = saved_self_type;
    return result_symbol;
};

public let instantiate_extension_method_def_id(
    mono Monomorphizer,
    base_type Type,
    owner MethodOwner,
    template GenericExtensionMethodTemplate,
    type_args List[Type],
    method_type_args List[Type],
) DefId = {
    let sym = instantiate_extension_method(
        mono,
        base_type,
        owner,
        template,
        type_args,
        method_type_args,
    );
    return sym.def_id;
};

// ── instantiate_trait_placeholder_method ─────────────────────────────────────

file_private let normalize_trait_conformance_actual_type(
    mono Monomorphizer,
    actual Type,
) Type = {
    return when actual in {
        .StructureType(def_id) then {
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(pair) then {
                    let mutable args = List[Type].new();
                    for arg in pair.second then {
                        args.push(arg);
                    };
                    Type.GenericStruct(
                        mono.storage.context.get_template_def_id(def_id),
                        args,
                    )
                },
                .None() then {
                    when mono.storage.context.lookup_type(def_id) in {
                        .Some(mapped_type) then mapped_type,
                        .None() then actual,
                    }
                },
            }
        },
        .EnumType(def_id) then {
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(pair) then {
                    let mutable args = List[Type].new();
                    for arg in pair.second then {
                        args.push(arg);
                    };
                    Type.GenericEnum(
                        mono.storage.context.get_template_def_id(def_id),
                        args,
                    )
                },
                .None() then {
                    when mono.storage.context.lookup_type(def_id) in {
                        .Some(mapped_type) then mapped_type,
                        .None() then actual,
                    }
                },
            }
        },
        _ then actual,
    };
};

file_private let trait_conformance_target_matches(
    mono Monomorphizer,
    pattern Type,
    actual Type,
) Bool = {
    let normalized_pattern = normalize_trait_conformance_actual_type(mono, pattern);
    let normalized_actual = normalize_trait_conformance_actual_type(mono, actual);
    return when normalized_pattern in {
        // Identity: the template's DECLARATION, not its spelling.
        .GenericStruct(_, pattern_args) then when normalized_actual in {
            .GenericStruct(_, actual_args) then type_template_decl(
                mono,
                normalized_pattern,
            ) == type_template_decl(mono, normalized_actual) and pattern_args.count() == actual_args.count(
            ),
            _ then false,
        },
        .GenericEnum(_, pattern_args) then when normalized_actual in {
            .GenericEnum(_, actual_args) then type_template_decl(
                mono,
                normalized_pattern,
            ) == type_template_decl(mono, normalized_actual) and pattern_args.count() == actual_args.count(
            ),
            _ then false,
        },
        _ then mono.storage.context.get_layout_key(pattern) == mono.storage.context.get_layout_key(
            normalized_actual,
        ),
    };
};

file_private let collect_trait_conformance_bindings(
    mono Monomorphizer,
    pattern Type,
    actual Type,
    bindings Dict[String, Type],
) Void = {
    let normalized_pattern = normalize_trait_conformance_actual_type(mono, pattern);
    let normalized_actual = normalize_trait_conformance_actual_type(mono, actual);
    when normalized_pattern in {
        .GenericParameter(name) then {
            if not bindings.contains_key(name) then {
                bindings.insert(name, normalized_actual);
            };
        },
        .ReferenceType(pattern_inner) then {
            when normalized_actual in {
                .ReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .BorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .MutableReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .BorrowedReferenceType(pattern_inner) then {
            when normalized_actual in {
                .ReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .BorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .MutableBorrowedReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableBorrowedReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .WeakReferenceType(pattern_inner) then {
            when normalized_actual in {
                .WeakReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutableWeakReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .MutableWeakReferenceType(pattern_inner) then {
            when normalized_actual in {
                .MutableWeakReferenceType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .PointerType(pattern_inner) then {
            when normalized_actual in {
                .PointerType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                .MutablePointerType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        .MutablePointerType(pattern_inner) then {
            when normalized_actual in {
                .MutablePointerType(actual_inner) then collect_trait_conformance_bindings(
                    mono,
                    pattern_inner,
                    actual_inner,
                    bindings,
                ),
                _ then {},
            };
        },
        // Identity: the template's DECLARATION, not its spelling.
        .GenericStruct(pattern_def_id, pattern_args) then {
            when normalized_actual in {
                .GenericStruct(actual_def_id, actual_args) then {
                    if pattern_def_id == actual_def_id and pattern_args.count() == actual_args.count(
                    ) then {
                        let mutable i UInt = 0;
                        while i < pattern_args.count() then {
                            collect_trait_conformance_bindings(
                                mono,
                                (pattern_args[i]),
                                (actual_args[i]),
                                bindings,
                            );
                            i += 1;
                        };
                    };
                },
                _ then {},
            };
        },
        .GenericEnum(pattern_def_id, pattern_args) then {
            when normalized_actual in {
                .GenericEnum(actual_def_id, actual_args) then {
                    if pattern_def_id == actual_def_id and pattern_args.count() == actual_args.count(
                    ) then {
                        let mutable i UInt = 0;
                        while i < pattern_args.count() then {
                            collect_trait_conformance_bindings(
                                mono,
                                (pattern_args[i]),
                                (actual_args[i]),
                                bindings,
                            );
                            i += 1;
                        };
                    };
                },
                _ then {},
            };
        },
        _ then {},
    };
};

/// Whether `def_id` names std's `Pair`, or is a monomorphized instantiation of
/// it. Declaration identity only -- a user type also called `Pair` is a
/// different type and gets no tuple-destructuring behaviour.
public let is_std_pair_def_id(context CompilerContext, def_id DefId) Bool = {
    let want = context.std_type_def_id("Pair") or else {
        return false;
    };
    return def_id == want or context.get_template_def_id(def_id) == want;
};

/// Whether `def_id` is std's `Rune`. Declaration identity only -- the spelling
/// is read once, here, to find the std declaration; every later question
/// compares the identity. A user type also called `Rune` is a different type.
public let is_std_rune_def_id(context CompilerContext, def_id DefId) Bool = {
    let want = context.std_type_def_id("Rune") or else {
        return false;
    };
    return def_id == want or context.get_template_def_id(def_id) == want;
};

file_private let infer_trait_extension_type_args(
    mono Monomorphizer,
    conformance_target Type,
    parameterized_base_type Type,
    trait_def_id DefId,
) List[Type] = {
    let mutable out = List[Type].new();
    if not trait_conformance_target_matches(
        mono,
        conformance_target,
        parameterized_base_type,
    ) then {
        return out;
    };

    let mutable bindings = Dict[String, Type].new();
    collect_trait_conformance_bindings(
        mono,
        conformance_target,
        parameterized_base_type,
        bindings,
    );

    // The trait DECLARATION, not whichever same-named one last wrote the
    // unqualified index -- the parameter names being read here belong to the
    // trait the caller means.
    when mono.storage.generic_templates.lookup_trait_by_def_id(trait_def_id) in {
        .Some(info) then {
            for tp in info.type_params then {
                out.push(bindings.get(tp.name) or else Type.Unknown());
            };
        },
        .None() then {},
    };
    return out;
};

file_private let resolve_given_trait_args(
    mono Monomorphizer,
    conformance_target Type,
    trait_args List[Type],
    parameterized_base_type Type,
) List[Type] = {
    let mutable out = List[Type].new();
    if not trait_conformance_target_matches(
        mono,
        conformance_target,
        parameterized_base_type,
    ) then {
        return out;
    };

    let mutable bindings = Dict[String, Type].new();
    collect_trait_conformance_bindings(
        mono,
        conformance_target,
        parameterized_base_type,
        bindings,
    );
    for trait_arg in trait_args then {
        out.push(
            resolve_parameterized_type(mono, substitute_type(mono, trait_arg, bindings)),
        );
    };
    return out;
};

/// Recovers a trait's type arguments by walking the trait requirement's
/// signature and the concrete implementation's signature in parallel.
///
/// Wherever the requirement mentions one of the trait's type parameters, the
/// concrete type sitting at that position IS the corresponding argument. This
/// is the general rule: it needs no per-trait special case (there used to be a
/// hard-coded `Iterator`/`next`/`Option` path here), and it works for any trait
/// whose requirements mention its parameters.
///
/// Only names listed in `wanted` are recorded -- `Self` and the implementation's
/// own type parameters are left alone. First occurrence wins.
file_private let collect_trait_type_args_by_unification(
    mono Monomorphizer,
    wanted Set[String],
    requirement Type,
    concrete Type,
    solved Dict[String, Type],
) Void = {
    when requirement in {
        .GenericParameter(name) then {
            if wanted.contains(name) and not solved.contains_key(name) then {
                solved.insert(name, resolve_parameterized_type(mono, concrete));
            };
        },
        .GenericStruct(_, req_args) then {
            when concrete in {
                .GenericStruct(_, c_args) then collect_trait_type_args_in_list(
                    mono,
                    wanted,
                    req_args,
                    c_args,
                    solved,
                ),
                _ then {},
            };
        },
        .GenericEnum(_, req_args) then {
            when concrete in {
                .GenericEnum(_, c_args) then collect_trait_type_args_in_list(
                    mono,
                    wanted,
                    req_args,
                    c_args,
                    solved,
                ),
                _ then {},
            };
        },
        .TraitObject(_, req_args) then {
            when concrete in {
                .TraitObject(_, c_args) then collect_trait_type_args_in_list(
                    mono,
                    wanted,
                    req_args,
                    c_args,
                    solved,
                ),
                _ then {},
            };
        },
        .ReferenceType(req_inner) then {
            when concrete in {
                .ReferenceType(c_inner) then collect_trait_type_args_by_unification(
                    mono,
                    wanted,
                    req_inner,
                    c_inner,
                    solved,
                ),
                _ then {},
            };
        },
        .MutableReferenceType(req_inner) then {
            when concrete in {
                .MutableReferenceType(c_inner) then collect_trait_type_args_by_unification(
                    mono,
                    wanted,
                    req_inner,
                    c_inner,
                    solved,
                ),
                _ then {},
            };
        },
        .BorrowedReferenceType(req_inner) then {
            when concrete in {
                .BorrowedReferenceType(c_inner) then collect_trait_type_args_by_unification(
                    mono,
                    wanted,
                    req_inner,
                    c_inner,
                    solved,
                ),
                _ then {},
            };
        },
        .MutableBorrowedReferenceType(req_inner) then {
            when concrete in {
                .MutableBorrowedReferenceType(c_inner) then collect_trait_type_args_by_unification(
                    mono,
                    wanted,
                    req_inner,
                    c_inner,
                    solved,
                ),
                _ then {},
            };
        },
        .PointerType(req_inner) then {
            when concrete in {
                .PointerType(c_inner) then collect_trait_type_args_by_unification(
                    mono,
                    wanted,
                    req_inner,
                    c_inner,
                    solved,
                ),
                _ then {},
            };
        },
        .MutablePointerType(req_inner) then {
            when concrete in {
                .MutablePointerType(c_inner) then collect_trait_type_args_by_unification(
                    mono,
                    wanted,
                    req_inner,
                    c_inner,
                    solved,
                ),
                _ then {},
            };
        },
        .WeakReferenceType(req_inner) then {
            when concrete in {
                .WeakReferenceType(c_inner) then collect_trait_type_args_by_unification(
                    mono,
                    wanted,
                    req_inner,
                    c_inner,
                    solved,
                ),
                _ then {},
            };
        },
        .MutableWeakReferenceType(req_inner) then {
            when concrete in {
                .MutableWeakReferenceType(c_inner) then collect_trait_type_args_by_unification(
                    mono,
                    wanted,
                    req_inner,
                    c_inner,
                    solved,
                ),
                _ then {},
            };
        },
        _ then {},
    };
};

file_private let collect_trait_type_args_in_list(
    mono Monomorphizer,
    wanted Set[String],
    requirement List[Type],
    concrete List[Type],
    solved Dict[String, Type],
) Void = {
    if requirement.count() != concrete.count() then {
        return;
    };
    let mutable i UInt = 0;
    while i < requirement.count() then {
        collect_trait_type_args_by_unification(
            mono,
            wanted,
            requirement[i],
            concrete[i],
            solved,
        );
        i += 1;
    };
};

/// Recover a trait's type arguments for a conformance witnessed by `template`.
///
/// Two sources, in order:
///   1. The trait requirement's signature, unified against the concrete
///      implementation's signature (the general rule).
///   2. The extension method's own type parameters by name, which works when the
///      implementation happened to use the trait's parameter names.
file_private let infer_trait_args_from_extension_template_binding(
    mono Monomorphizer,
    template GenericExtensionMethodTemplate,
    concrete_extension_type_args List[Type],
    trait_def_id DefId,
) List[Type] = {
    let mutable out = List[Type].new();
    let mutable bindings = Dict[String, Type].new();
    let mutable i UInt = 0;
    while i < template.type_params.count() and i < concrete_extension_type_args.count() then {
        bindings.insert(
            template.type_params[i].name,
            resolve_parameterized_type(mono, (concrete_extension_type_args[i])),
        );
        i += 1;
    };

    // The trait DECLARATION: the members being unified against are the ones the
    // caller means, not whichever same-named trait last wrote the unqualified
    // index.
    when mono.storage.generic_templates.lookup_trait_by_def_id(trait_def_id) in {
        .Some(info) then {
            let mutable wanted = Set[String].new();
            for trait_tp in info.type_params then {
                wanted.insert(trait_tp.name);
            };

            let mutable solved = Dict[String, Type].new();
            // The method's own TypeNodes are resolved against the template's
            // parameters; `bindings` only supplies the ones the caller knows.
            let node_subst = template_substitution(template.type_params, bindings);
            for member in info.members then {
                if member.name != template.method.name then {
                    continue;
                };
                let concrete_return_type = when template.checked_return_type in {
                    .Some(checked_return_type) then resolve_parameterized_type(
                        mono,
                        substitute_type(mono, checked_return_type, node_subst),
                    ),
                    .None() then resolve_parameterized_type(
                        mono,
                        mono.resolve_type_node_impl(
                            template.method.return_type,
                            node_subst,
                        ),
                    ),
                };
                collect_trait_type_args_by_unification(
                    mono,
                    wanted,
                    member.return_type,
                    concrete_return_type,
                    solved,
                );
                let mutable p UInt = 0;
                while p < member.params.count() and p < template.method.params.count() then {
                    let concrete_param_type = resolve_parameterized_type(
                        mono,
                        mono.resolve_type_node_impl(
                            template.method.params[p].param_type,
                            node_subst,
                        ),
                    );
                    collect_trait_type_args_by_unification(
                        mono,
                        wanted,
                        member.params[p].param_type,
                        concrete_param_type,
                        solved,
                    );
                    p += 1;
                };
                break;
            };

            for trait_tp in info.type_params then {
                out.push(
                    solved.get(trait_tp.name) or else (bindings.get(trait_tp.name) or else Type.Unknown(
                    )),
                );
            };
        },
        .None() then {},
    };
    return out;
};

/// The built-in's name within the CLOSED primitive space, so extension methods
/// declared on `Int` / `Bool` / ... can be reached.
///
/// This is NOT name matching in the identity sense. Scalars and modifiers carry
/// no declaration -- there is no `DefId` to compare -- so their identity IS
/// their slot in a finite, closed set, exactly like rustc's
/// `rustc_middle::ty::fast_reject::SimplifyType` and the `incoherent_impls`
/// table it feeds. `MethodOwner.Builtin(name)` is the same idea; see the note on
/// that case. A user type cannot enter this set, so the name cannot collide.
file_private let primitive_extension_template_name(t Type) Option[String] = {
    return when t in {
        .IntType() then Option[String].Some("Int"),
        .Int8Type() then Option[String].Some("Int8"),
        .Int16Type() then Option[String].Some("Int16"),
        .Int32Type() then Option[String].Some("Int32"),
        .Int64Type() then Option[String].Some("Int64"),
        .UIntType() then Option[String].Some("UInt"),
        .UInt8Type() then Option[String].Some("UInt8"),
        .UInt16Type() then Option[String].Some("UInt16"),
        .UInt32Type() then Option[String].Some("UInt32"),
        .UInt64Type() then Option[String].Some("UInt64"),
        .Float32Type() then Option[String].Some("Float32"),
        .Float64Type() then Option[String].Some("Float64"),
        .BoolType() then Option[String].Some("Bool"),
        _ then Option[String].None(),
    };
};

/// Whether `actual_type` satisfies one bound. Dispatches on the bound's KIND,
/// never on its spelling: a trait bound asks the conformance registry for the
/// trait's DECLARATION, a shape bound (`mutable` / `foreign`) asks the type's
/// own declaration. Ignoring a shape bound here is what let `given[T foreign]`
/// methods vanish from the emitted C while the call still compiled.
file_private let type_satisfies_bound_constraint(
    mono Monomorphizer,
    actual_type Type,
    constraint Bound,
) Bool = {
    return when constraint in {
        // `def_id` was resolved when the enclosing template was registered, in
        // the module that wrote the bound. Looking the spelling up again here
        // would ask a table that is last-wins across modules which `Tag` was
        // meant, and two same-named traits would answer for each other.
        .Trait(def_id, _, _) then type_satisfies_trait_constraint(
            mono,
            actual_type,
            def_id,
        ),
        .Mutable() then type_satisfies_mutable_bound(mono, actual_type),
        .Foreign() then type_satisfies_foreign_bound(mono, actual_type),
    };
};

file_private let type_satisfies_mutable_bound(mono Monomorphizer, actual_type Type) Bool = {
    let t = resolve_parameterized_type(mono, actual_type);
    return when t in {
        .StructureType(def_id) then mono.storage.context.is_struct_mutable(def_id),
        .GenericStruct(template_def_id, _) then mono.storage.context.is_struct_mutable(
            template_def_id,
        ),
        _ then false,
    };
};

/// The same CLOSED set `satisfies_foreign_constraint` checks in sema: built-in
/// scalars (including std's `Rune`), raw pointers, and `foreign type` decls.
file_private let type_satisfies_foreign_bound(mono Monomorphizer, actual_type Type) Bool = {
    let t = resolve_parameterized_type(mono, actual_type);
    return when t in {
        .IntType() or .Int8Type() or .Int16Type() or .Int32Type() or .Int64Type() or .UIntType() or .UInt8Type() or .UInt16Type() or .UInt32Type() or .UInt64Type() or .Float32Type() or .Float64Type() or .BoolType() then true,
        .PointerType(_) or .MutablePointerType(_) then true,
        .StructureType(def_id) then {
            if mono.storage.context.is_foreign_struct(def_id) then {
                true
            } else {
                is_std_rune_def_id(mono.storage.context, def_id)
            }
        },
        _ then false,
    };
};

/// Whether `actual_type` has a conformance for the trait DECLARATION
/// `trait_def_id`. The match is on identity, so two same-named traits from
/// different modules cannot answer for each other.
file_private let type_satisfies_trait_constraint(
    mono Monomorphizer,
    actual_type Type,
    trait_def_id DefId,
) Bool = {

    let mutable parameterized_actual_type = resolve_parameterized_type(mono, actual_type);

    let primitive_name_opt = primitive_extension_template_name(
        parameterized_actual_type,
    );

    // Only the owner's TYPE ARGUMENTS matter here -- the owner itself is looked
    // up by identity below (`method_owner_of`). No spelling is carried.
    let actual_template_match = when parameterized_actual_type in {
        .GenericStruct(_, args) then Option[List[Type]].Some(args),
        .GenericEnum(_, args) then Option[List[Type]].Some(args),
        .ReferenceType(inner) then {
            let mutable args = List[Type].new();
            args.push(resolve_parameterized_type(mono, inner));
            Option[List[Type]].Some(args)
        },
        .MutableReferenceType(inner) then {
            let mutable args = List[Type].new();
            args.push(resolve_parameterized_type(mono, inner));
            Option[List[Type]].Some(args)
        },
        .BorrowedReferenceType(inner) then {
            let mutable args = List[Type].new();
            args.push(resolve_parameterized_type(mono, inner));
            Option[List[Type]].Some(args)
        },
        .MutableBorrowedReferenceType(inner) then {
            let mutable args = List[Type].new();
            args.push(resolve_parameterized_type(mono, inner));
            Option[List[Type]].Some(args)
        },
        .WeakReferenceType(inner) then {
            let mutable args = List[Type].new();
            args.push(resolve_parameterized_type(mono, inner));
            Option[List[Type]].Some(args)
        },
        .MutableWeakReferenceType(inner) then {
            let mutable args = List[Type].new();
            args.push(resolve_parameterized_type(mono, inner));
            Option[List[Type]].Some(args)
        },
        .PointerType(inner) then {
            let mutable args = List[Type].new();
            args.push(resolve_parameterized_type(mono, inner));
            Option[List[Type]].Some(args)
        },
        .MutablePointerType(inner) then {
            let mutable args = List[Type].new();
            args.push(resolve_parameterized_type(mono, inner));
            Option[List[Type]].Some(args)
        },
        .StructureType(def_id) then when resolve_template_name_and_args(mono, def_id) in {
            .Some(info) then {
                let mutable arg_refs = List[Type].new();
                for arg in info.second then {
                    arg_refs.push(resolve_parameterized_type(mono, arg));
                };
                Option[List[Type]].Some(arg_refs)
            },
            .None() then Option[List[Type]].None(),
        },
        .EnumType(def_id) then when resolve_template_name_and_args(mono, def_id) in {
            .Some(info) then {
                let mutable arg_refs = List[Type].new();
                for arg in info.second then {
                    arg_refs.push(resolve_parameterized_type(mono, arg));
                };
                Option[List[Type]].Some(arg_refs)
            },
            .None() then Option[List[Type]].None(),
        },
        _ then Option[List[Type]].None(),
    };

    when actual_template_match in {
        .Some(template_args) then {
            let matching_templates = mono.storage.generic_templates.lookup_extension_methods(
                mono.storage.context.method_owner_of(parameterized_actual_type),
            ) or else List[GenericExtensionMethodTemplate].new();
            let mutable saw_matching_template = false;
            for template_ref in matching_templates then {
                when template_ref.conformance_trait_def_id in {
                    .Some(conformance_trait_def_id) then {
                        if not trait_identity_matches(
                            conformance_trait_def_id,
                            trait_def_id,
                        ) then {
                            continue;
                        };
                    },
                    .None() then {
                        continue;
                    },
                };
                if template_ref.type_params.count() != template_args.count() then {
                    continue;
                };
                saw_matching_template = true;
                if extension_type_args_satisfy_constraints(
                    mono,
                    template_ref,
                    template_args,
                ) then {
                    return true;
                };
            };
            if saw_matching_template then {
                return false;
            };
        },
        .None() then {},
    };

    for node_ref in mono.storage.source_given_decls then {
        when node_ref in {
            .GivenTraitDecl(target_type, _, _, _, _, given_trait_def_id) then {
                if not trait_identity_matches(given_trait_def_id, trait_def_id) then {
                    continue;
                };
                if trait_conformance_target_matches(
                    mono,
                    target_type,
                    parameterized_actual_type,
                ) then {
                    return true;
                };
                when primitive_name_opt in {
                    .Some(primitive_name) then {
                        let primitive_def_id = mono.storage.generic_templates.lookup_struct_def_id(
                            primitive_name,
                        );
                        let mutable primitive_type = Type.GenericStruct(
                            primitive_def_id,
                            List[Type].new(),
                        );
                        if trait_conformance_target_matches(
                            mono,
                            target_type,
                            primitive_type,
                        ) then {
                            return true;
                        };
                    },
                    .None() then {},
                };
            },
            _ then {},
        };
    };

    return false;
};

public let extension_type_args_satisfy_constraints(
    mono Monomorphizer,
    template GenericExtensionMethodTemplate,
    type_args List[Type],
) Bool = {
    if template.type_params.count() != type_args.count() then {
        return false;
    };

    let mutable i UInt = 0;
    while i < template.type_params.count() then {
        let param = template.type_params[i];
        let mutable actual_type = resolve_parameterized_type(mono, (type_args[i]));
        for constraint in param.constraints then {
            if not type_satisfies_bound_constraint(mono, actual_type, constraint) then {
                return false;
            };
        };
        i += 1;
    };

    return true;
};

/// Instantiate every method a conformance needs on `concrete_type`.
///
/// A conformance `X: Child` IMPLIES `X: Parent` — sema already requires the
/// parent `given` to be declared explicitly — so the parent's methods are
/// instantiated here too. Without that the child's vtable still carries the
/// parent's requirement (the requirement list flattens parents in) with nothing
/// to bind it to: `resolve_method_def_id` walks to the parent and finds no
/// conformance for this concrete type, and codegen dies with
/// `Refusing to emit partial vtable ... missing methods: <inherited one>`.
///
/// `visited` breaks cycles in the parent graph and is shared across the whole
/// walk. It is deliberately NOT consulted by the reference-unwrap recursion at
/// the end of the body: `Box[Int]` and `Box[Int] ref` are different receivers
/// that each need their own instantiation even though they share a trait
/// identity.
public let instantiate_trait_vtable_methods(
    mono Monomorphizer,
    concrete_type Type,
    trait_name String,
    trait_def_id DefId,
    trait_type_args List[Type],
) Void = {
    let mutable visited = Set[UInt].new();
    instantiate_trait_vtable_methods_core(
        mono,
        concrete_type,
        trait_name,
        trait_def_id,
        trait_type_args,
        visited,
    );
};

file_private let instantiate_trait_vtable_methods_core(
    mono Monomorphizer,
    concrete_type Type,
    trait_name String,
    trait_def_id DefId,
    trait_type_args List[Type],
    visited Set[UInt],
) Void = {
    if has_generic_parameter(concrete_type) then {
        return;
    };
    if visited.contains(trait_def_id.id) then {
        return;
    };
    visited.insert(trait_def_id.id);

    let mutable parameterized_concrete_type = resolve_parameterized_type(
        mono,
        concrete_type,
    );
    let normalized_actual = normalize_trait_conformance_actual_type(
        mono,
        parameterized_concrete_type,
    );
    let mutable concrete_template_name = stable_type_key(parameterized_concrete_type);
    let mutable extension_type_args = List[Type].new();
    let mutable instantiated_any = false;

    when normalized_actual in {
        .GenericStruct(tplDefId, args) then {
            concrete_template_name = def_id_spelling(tplDefId);
            for arg in args then {
                extension_type_args.push(arg);
            };
        },
        .GenericEnum(tplDefId, args) then {
            concrete_template_name = def_id_spelling(tplDefId);
            for arg in args then {
                extension_type_args.push(arg);
            };
        },
        .ReferenceType(inner) then {
            concrete_template_name = "Ref";
            extension_type_args.push(inner);
        },
        .MutableReferenceType(inner) then {
            concrete_template_name = "MutRef";
            extension_type_args.push(inner);
        },
        .BorrowedReferenceType(inner) then {
            concrete_template_name = "Ref";
            extension_type_args.push(inner);
        },
        .MutableBorrowedReferenceType(inner) then {
            concrete_template_name = "MutRef";
            extension_type_args.push(inner);
        },
        .PointerType(inner) then {
            concrete_template_name = "Ptr";
            extension_type_args.push(inner);
        },
        .MutablePointerType(inner) then {
            concrete_template_name = "MutPtr";
            extension_type_args.push(inner);
        },
        .WeakReferenceType(inner) then {
            concrete_template_name = "WeakRef";
            extension_type_args.push(inner);
        },
        .MutableWeakReferenceType(inner) then {
            concrete_template_name = "MutWeakRef";
            extension_type_args.push(inner);
        },
        .StructureType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(layout_name) then {
                    when mono.storage.context.get_template_name(def_id) in {
                        .Some(template_name) then {
                            concrete_template_name = template_name;
                            when mono.storage.context.get_type_arguments(def_id) in {
                                .Some(actual_args) then {
                                    for arg in actual_args then {
                                        extension_type_args.push(arg);
                                    };
                                },
                                .None() then {
                                    when mono.storage.layout_to_template_info.get(
                                        layout_name,
                                    ) in {
                                        .Some(info) then {
                                            for arg in info.args then {
                                                extension_type_args.push(arg);
                                            };
                                        },
                                        .None() then {
                                            when mono.storage.context.lookup_type(
                                                def_id,
                                            ) in {
                                                .Some(mapped_type) then {
                                                    when mapped_type in {
                                                        .GenericStruct(_, mapped_args) then {
                                                            for arg in mapped_args then {
                                                                extension_type_args.push(
                                                                    arg,
                                                                );
                                                            };
                                                        },
                                                        .GenericEnum(_, mapped_args) then {
                                                            for arg in mapped_args then {
                                                                extension_type_args.push(
                                                                    arg,
                                                                );
                                                            };
                                                        },
                                                        _ then {},
                                                    };
                                                },
                                                .None() then {},
                                            };
                                        },
                                    };
                                },
                            };
                        },
                        .None() then {
                            when mono.storage.layout_to_template_info.get(layout_name) in {
                                .Some(info) then {
                                    concrete_template_name = info.base_name;
                                    for arg in info.args then {
                                        extension_type_args.push(arg);
                                    };
                                },
                                .None() then {
                                    concrete_template_name = layout_name;
                                },
                            };
                        },
                    };
                },
                .None() then {},
            };
        },
        .EnumType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(layout_name) then {
                    when mono.storage.context.get_template_name(def_id) in {
                        .Some(template_name) then {
                            concrete_template_name = template_name;
                            when mono.storage.context.get_type_arguments(def_id) in {
                                .Some(actual_args) then {
                                    for arg in actual_args then {
                                        extension_type_args.push(arg);
                                    };
                                },
                                .None() then {
                                    when mono.storage.layout_to_template_info.get(
                                        layout_name,
                                    ) in {
                                        .Some(info) then {
                                            for arg in info.args then {
                                                extension_type_args.push(arg);
                                            };
                                        },
                                        .None() then {
                                            when mono.storage.context.lookup_type(
                                                def_id,
                                            ) in {
                                                .Some(mapped_type) then {
                                                    when mapped_type in {
                                                        .GenericEnum(_, mapped_args) then {
                                                            for arg in mapped_args then {
                                                                extension_type_args.push(
                                                                    arg,
                                                                );
                                                            };
                                                        },
                                                        .GenericStruct(_, mapped_args) then {
                                                            for arg in mapped_args then {
                                                                extension_type_args.push(
                                                                    arg,
                                                                );
                                                            };
                                                        },
                                                        _ then {},
                                                    };
                                                },
                                                .None() then {},
                                            };
                                        },
                                    };
                                },
                            };
                        },
                        .None() then {
                            when mono.storage.layout_to_template_info.get(layout_name) in {
                                .Some(info) then {
                                    concrete_template_name = info.base_name;
                                    for arg in info.args then {
                                        extension_type_args.push(arg);
                                    };
                                },
                                .None() then {
                                    concrete_template_name = layout_name;
                                },
                            };
                        },
                    };
                },
                .None() then {},
            };
        },
        _ then {},
    };

    // One owner identity -- the type, and for an instance its template. The old
    // version kept both of the type's SPELLINGS (`concrete_template_name` and the
    // template's) in a candidate list, which is what let two same-named types
    // answer for each other.
    let mutable candidate_template_owners = List[MethodOwner].new();
    candidate_template_owners.push(
        mono.storage.context.method_owner_of(parameterized_concrete_type),
    );
    for candidate_owner in candidate_template_owners then {
        when mono.storage.generic_templates.lookup_extension_methods(candidate_owner) in {
            .Some(templates) then {
                for template_ref in templates then {
                    when template_ref.conformance_trait_def_id in {
                        .Some(conformance_trait_def_id) then {
                            if not trait_identity_matches(
                                conformance_trait_def_id,
                                trait_def_id,
                            ) then {
                                continue;
                            };
                        },
                        .None() then {
                            continue;
                        },
                    };
                    if template_ref.type_params.count() != extension_type_args.count() then {
                        continue;
                    };
                    if not extension_type_args_satisfy_constraints(
                        mono,
                        template_ref,
                        extension_type_args,
                    ) then {
                        continue;
                    };
                    if template_ref.method.type_params.count() != UInt(0) then {
                        continue;
                    };
                    let mutable effective_template_ref = template_ref;
                    let mutable should_instantiate = true;
                    if template_ref.checked_body is .None() then {
                        when lookup_extension_methods_fuzzy(
                            mono,
                            MethodOwner.Decl(
                                template_ref.conformance_trait_def_id or else def_id_invalid(
                                ),
                            ),
                        ) in {
                            .Some(tool_templates) then when select_extension_template(
                                tool_templates,
                                template_ref.method.name,
                                Option[UInt].Some(
                                    template_ref.method.type_params.count(),
                                ),
                                Option[UInt].Some(trait_type_args.count()),
                            ) in {
                                .Some(tool_template_ref) then {
                                    if extension_type_args_satisfy_constraints(
                                        mono,
                                        tool_template_ref,
                                        trait_type_args,
                                    ) then {
                                        effective_template_ref = patched_extension_template_with_body(
                                            template_ref,
                                            tool_template_ref,
                                        );
                                    } else {
                                        should_instantiate = false;
                                    };
                                },
                                .None() then {
                                    should_instantiate = false;
                                },
                            },
                            .None() then {
                                should_instantiate = false;
                            },
                        };
                    };
                    if not should_instantiate then {
                        continue;
                    };
                    let _ = mono.instantiate_extension_method_impl(
                        parameterized_concrete_type,
                        candidate_owner,
                        effective_template_ref,
                        extension_type_args,
                        List[Type].new(),
                    );
                    instantiated_any = true;
                };
            },
            .None() then {},
        };
    };

    if not instantiated_any then {
        when parameterized_concrete_type in {
            .ReferenceType(inner) then instantiate_trait_vtable_methods(
                mono,
                inner,
                trait_name,
                trait_def_id,
                trait_type_args,
            ),
            .MutableReferenceType(inner) then instantiate_trait_vtable_methods(
                mono,
                inner,
                trait_name,
                trait_def_id,
                trait_type_args,
            ),
            .BorrowedReferenceType(inner) then instantiate_trait_vtable_methods(
                mono,
                inner,
                trait_name,
                trait_def_id,
                trait_type_args,
            ),
            .MutableBorrowedReferenceType(inner) then instantiate_trait_vtable_methods(
                mono,
                inner,
                trait_name,
                trait_def_id,
                trait_type_args,
            ),
            .WeakReferenceType(inner) then instantiate_trait_vtable_methods(
                mono,
                inner,
                trait_name,
                trait_def_id,
                trait_type_args,
            ),
            .MutableWeakReferenceType(inner) then instantiate_trait_vtable_methods(
                mono,
                inner,
                trait_name,
                trait_def_id,
                trait_type_args,
            ),
            .PointerType(inner) then instantiate_trait_vtable_methods(
                mono,
                inner,
                trait_name,
                trait_def_id,
                trait_type_args,
            ),
            .MutablePointerType(inner) then instantiate_trait_vtable_methods(
                mono,
                inner,
                trait_name,
                trait_def_id,
                trait_type_args,
            ),
            _ then {},
        };
    };

    // The parent's conformance for the SAME concrete type. Its type arguments
    // come from the parent's own declaration, with this trait's type parameters
    // bound to what the conformance was asked for -- so `Child[T] Parent[T]`
    // instantiated for `Child[Int]` carries `[Int]`, not `[T]`.
    when mono.storage.generic_templates.lookup_trait_by_def_id(trait_def_id) in {
        .Some(trait_info) then {
            let mutable bindings = Dict[String, Type].new();
            bindings.insert("Self", concrete_type);
            let mutable param_index UInt = 0;
            while param_index < trait_info.type_params.count() and param_index < trait_type_args.count(
            ) then {
                bindings.insert(
                    trait_info.type_params[param_index].name,
                    trait_type_args[param_index],
                );
                param_index += 1;
            };
            for parent in trait_info.parent_traits then {
                if not parent.def_id.is_valid() then {
                    continue;
                };
                let mutable parent_args = List[Type].new();
                for arg_node in parent.type_arg_nodes then {
                    parent_args.push(resolve_type_node(mono, arg_node, bindings));
                };
                instantiate_trait_vtable_methods_core(
                    mono,
                    concrete_type,
                    parent.name,
                    parent.def_id,
                    parent_args,
                    visited,
                );
            };
        },
        .None() then {},
    };

    // The witness codegen and the MIR verifier ask for. Filed LAST, once this
    // trait's and every parent's methods have been instantiated, so the
    // implementation map can point at the INSTANCE's DefIds rather than the
    // declaration's templates.
    materialize_conformance_witness_for_instance(
        mono,
        concrete_type,
        trait_name,
        trait_def_id,
        trait_type_args,
    );
};

// Resolve a trait placeholder method call to a concrete implementation.
//
// Steps:
//   a. If base_type contains an unresolved GenericParameter, skip
//   b. Determine the template name and resolved base type:
//      - GenericStruct(template_name, args): resolve args via resolve_parameterized_type,
//        use template_name
//      - GenericEnum(template_name, args): same as GenericStruct
//      - StructureType(def_id): look up name from def_id_map, then check
//        layout_to_template_info for the base template name
//      - EnumType(def_id): same as StructureType
//      - Other types: skip (no extension methods possible)
//   c. Look up extension method templates from the registry using the template name
//   d. Find the matching template using select_extension_template
//   e. Call instantiate_extension_method with the resolved base_type, template_name,
//      template, type_args, and method_type_args
//
public let instantiate_trait_placeholder_method(
    mono Monomorphizer,
    base_type Type,
    method_name String,
    method_type_args List[Type],
) Void = {
    let placeholder_base_type = when base_type in {
        .ReferenceType(inner) then inner,
        .MutableReferenceType(inner) then inner,
        _ then base_type,
    };
    // a. If base_type contains an unresolved GenericParameter, skip.
    if has_generic_parameter(placeholder_base_type) or is_placeholder_inferred_type(
        placeholder_base_type,
    ) then {
        return;
    };
    if args_have_generic_parameter(method_type_args) then {
        return;
    };

    let trait_placeholder_key = InstantiationRequest(
        InstantiationKind.TraitMethod(
            placeholder_base_type,
            method_name,
            method_type_args,
        ),
        0,
        "",
    ).deduplication_key();
    if mono.storage.resolved_trait_placeholder_keys.contains(trait_placeholder_key) then {
        return;
    };
    if mono.storage.in_progress_trait_placeholder_keys.contains(trait_placeholder_key) then {
        return;
    };
    mono.storage.in_progress_trait_placeholder_keys.insert(trait_placeholder_key);

    // b. Determine the template name and resolved base type.
    //    We need both the template name (for registry lookup) and the resolved
    //    concrete base type mutable (for instantiate_extension_method).
    let mutable template_name_opt = Option[String].None();
    let mutable resolved_base_type = placeholder_base_type;
    let mutable type_args = List[Type].new();

    when placeholder_base_type in {
        // GenericStruct: instantiate the struct to get the concrete type, then use
        // the template name for extension method lookup.
        .GenericStruct(tplDefId, args) then {
            let mutable resolved_args = List[Type].new();
            for a in args then {
                resolved_args.push(resolve_parameterized_type(mono, a));
            };
            // Instantiate the struct to get the concrete StructureType.
            // Identity is the carried `tplDefId`; mirror the GenericEnum branch
            // below, which already resolves through the declaration.
            when mono.storage.generic_templates.struct_by_def_id(tplDefId) in {
                .Some(struct_template) then {
                    let resolved = mono.instantiate_struct_impl(
                        struct_template,
                        resolved_args,
                    );
                    resolved_base_type = resolved;
                },
                .None() then {},
            };
            template_name_opt = Option[String].Some(def_id_spelling(tplDefId));
            // The type_args for the extension method are the generic struct's args.
            for a in resolved_args then {
                type_args.push(a);
            };
        },
        // GenericEnum: same as GenericStruct.
        .GenericEnum(template_def_id, args) then {
            let mutable resolved_args = List[Type].new();
            for a in args then {
                resolved_args.push(resolve_parameterized_type(mono, a));
            };
            when mono.storage.generic_templates.enum_by_def_id(template_def_id) in {
                .Some(enum_template) then {
                    let resolved = mono.instantiate_enum_impl(
                        enum_template,
                        resolved_args,
                    );
                    resolved_base_type = resolved;
                },
                .None() then {},
            };
            // Display/mangling: the spelling comes from the declaration.
            template_name_opt = Option[String].Some(def_id_spelling(template_def_id));
            for a in resolved_args then {
                type_args.push(a);
            };
        },
        // StructureType: look up name from def_id_map, then check layout_to_template_info
        // for the base template name.
        .StructureType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(layout_name) then {
                    // Prefer DefId generic-instantiation metadata when available.
                    when mono.storage.context.get_template_name(def_id) in {
                        .Some(template_name) then {
                            //  already reads the declaration.
                            template_name_opt = Option[String].Some(template_name);
                            when mono.storage.context.get_type_arguments(def_id) in {
                                .Some(actual_args) then {
                                    for a in actual_args then {
                                        type_args.push(a);
                                    };
                                },
                                .None() then {
                                    when mono.storage.layout_to_template_info.get(
                                        layout_name,
                                    ) in {
                                        .Some(info) then {
                                            for a in info.args then {
                                                type_args.push(a);
                                            };
                                        },
                                        .None() then {},
                                    };
                                },
                            };
                        },
                        .None() then {
                            // Fall back to layout-derived template info.
                            when mono.storage.layout_to_template_info.get(layout_name) in {
                                .Some(info) then {
                                    template_name_opt = Option[String].Some(
                                        info.base_name,
                                    );
                                    for a in info.args then {
                                        type_args.push(a);
                                    };
                                },
                                .None() then {
                                    // Concrete (non-generic) struct: use the layout name directly.
                                    when mono.storage.context.lookup_type(def_id) in {
                                        .Some(mapped_type) then {
                                            when mapped_type in {
                                                .GenericStruct(template_def_id, mapped_args) then {
                                                    // Display/mangling: the spelling comes from the declaration.
                                                    template_name_opt = Option[String].Some(
                                                        def_id_spelling(template_def_id),
                                                    );
                                                    for a in mapped_args then {
                                                        type_args.push(a);
                                                    };
                                                },
                                                _ then {
                                                    template_name_opt = Option[String].Some(
                                                        layout_name,
                                                    );
                                                },
                                            };
                                        },
                                        .None() then {
                                            template_name_opt = Option[String].Some(
                                                layout_name,
                                            );
                                        },
                                    };
                                },
                            };
                        },
                    };
                },
                .None() then {},
            };
        },
        // EnumType: same as StructureType.
        .EnumType(def_id) then {
            when mono.storage.context.get_name(def_id) in {
                .Some(layout_name) then {
                    when mono.storage.context.get_template_name(def_id) in {
                        .Some(template_name) then {
                            template_name_opt = Option[String].Some(template_name);
                            when mono.storage.context.get_type_arguments(def_id) in {
                                .Some(actual_args) then {
                                    for a in actual_args then {
                                        type_args.push(a);
                                    };
                                },
                                .None() then {
                                    when mono.storage.layout_to_template_info.get(
                                        layout_name,
                                    ) in {
                                        .Some(info) then {
                                            for a in info.args then {
                                                type_args.push(a);
                                            };
                                        },
                                        .None() then {},
                                    };
                                },
                            };
                        },
                        .None() then {
                            when mono.storage.layout_to_template_info.get(layout_name) in {
                                .Some(info) then {
                                    template_name_opt = Option[String].Some(
                                        info.base_name,
                                    );
                                    for a in info.args then {
                                        type_args.push(a);
                                    };
                                },
                                .None() then {
                                    when mono.storage.context.lookup_type(def_id) in {
                                        .Some(mapped_type) then {
                                            when mapped_type in {
                                                .GenericEnum(template_def_id, mapped_args) then {
                                                    template_name_opt = Option[String].Some(
                                                        def_id_spelling(template_def_id),
                                                    );
                                                    for a in mapped_args then {
                                                        type_args.push(a);
                                                    };
                                                },
                                                _ then {
                                                    template_name_opt = Option[String].Some(
                                                        layout_name,
                                                    );
                                                },
                                            };
                                        },
                                        .None() then {
                                            template_name_opt = Option[String].Some(
                                                layout_name,
                                            );
                                        },
                                    };
                                },
                            };
                        },
                    };
                },
                .None() then {},
            };
        },
        .PointerType(inner) then {
            template_name_opt = Option[String].Some("Ptr");
            type_args.push(inner);
        },
        .MutablePointerType(inner) then {
            template_name_opt = Option[String].Some("MutPtr");
            type_args.push(inner);
        },
        .WeakReferenceType(inner) then {
            template_name_opt = Option[String].Some("WeakRef");
            type_args.push(inner);
        },
        .MutableWeakReferenceType(inner) then {
            template_name_opt = Option[String].Some("MutWeakRef");
            type_args.push(inner);
        },
        .IntType() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .Int8Type() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .Int16Type() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .Int32Type() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .Int64Type() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .UIntType() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .UInt8Type() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .UInt16Type() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .UInt32Type() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .UInt64Type() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .Float32Type() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .Float64Type() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        .BoolType() then {
            template_name_opt = primitive_extension_template_name(placeholder_base_type);
        },
        // All other types: no extension methods to look up.
        _ then {},
    };

    let method_type_arg_count = Option[UInt].Some(method_type_args.count());
    let concrete_template_name = when template_name_opt in {
        .Some(name) then name,
        .None() then stable_type_key(resolved_base_type),
    };
    let trait_entry_structure_name = when resolved_base_type in {
        .StructureType(def_id) then mono.storage.context.get_name(def_id) or else concrete_template_name,
        .EnumType(def_id) then mono.storage.context.get_name(def_id) or else concrete_template_name,
        _ then concrete_template_name,
    };
    let mutable parameterized_resolved_base_type = resolve_parameterized_type(
        mono,
        resolved_base_type,
    );
    let conformance_binding_type_args = if not type_args.is_empty() then {
        type_args
    } else when parameterized_resolved_base_type in {
        .GenericStruct(_, base_args) then {
            let mutable inferred_args = List[Type].new();
            for arg in base_args then {
                inferred_args.push(arg);
            };
            inferred_args
        },
        .GenericEnum(_, base_args) then {
            let mutable inferred_args = List[Type].new();
            for arg in base_args then {
                inferred_args.push(arg);
            };
            inferred_args
        },
        .StructureType(def_id) then {
            let mutable inferred_args = List[Type].new();
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then {
                    for arg in info.second then {
                        inferred_args.push(resolve_parameterized_type(mono, arg));
                    };
                },
                .None() then {},
            };
            inferred_args
        },
        .EnumType(def_id) then {
            let mutable inferred_args = List[Type].new();
            when resolve_template_name_and_args(mono, def_id) in {
                .Some(info) then {
                    for arg in info.second then {
                        inferred_args.push(resolve_parameterized_type(mono, arg));
                    };
                },
                .None() then {},
            };
            inferred_args
        },
        _ then List[Type].new(),
    };

    // c. Look up extension method templates from the registry using the template name.
    let template_name = when template_name_opt in {
        .Some(name) then name,
        .None() then {
            for node_ref in mono.storage.source_given_decls then {
                when node_ref in {
                    .GivenTraitDecl(target_type, _, trait_args, _, _, given_trait_def_id) then {
                        if not trait_conformance_target_matches(
                            mono,
                            target_type,
                            parameterized_resolved_base_type,
                        ) and not trait_conformance_target_matches_for_template_binding(
                            mono,
                            target_type,
                            parameterized_resolved_base_type,
                        ) then {
                            continue;
                        };
                        let inferred_trait_args = resolve_given_trait_args(
                            mono,
                            target_type,
                            trait_args,
                            parameterized_resolved_base_type,
                        );
                        when select_trait_tool_template_cached(
                            mono,
                            given_trait_def_id,
                            method_name,
                            method_type_arg_count,
                            Option[UInt].Some(inferred_trait_args.count()),
                        ) in {
                            .Some(tool_template_ref) then {
                                // Note: select_extension_template already prefers templates
                                // with checked_body. If no tool template has a body (trait
                                // declares only a signature), instantiation proceeds without
                                // a body — the conformance must provide one via GivenTraitDecl.
                                let _ = mono.instantiate_extension_method_impl(
                                    resolved_base_type,
                                    MethodOwner.Decl(given_trait_def_id),
                                    tool_template_ref,
                                    inferred_trait_args,
                                    method_type_args,
                                );
                                mono.storage.resolved_trait_placeholder_keys.insert(
                                    trait_placeholder_key,
                                );
                                mono.storage.in_progress_trait_placeholder_keys.remove(
                                    trait_placeholder_key,
                                );
                                return;
                            },
                            .None() then {},
                        };
                    },
                    _ then {},
                };
            };
            instantiate_conformance_trait_methods_for_type(mono, resolved_base_type);
            mono.storage.in_progress_trait_placeholder_keys.remove(
                trait_placeholder_key,
            );
            return;
        },
    };

    // Ensure trait-tool methods for already-known conformances are materialized
    // before receiver-method binding continues.
    instantiate_conformance_trait_methods_for_type(mono, resolved_base_type);

    let extension_type_arg_count = Option[UInt].None();
    let matched_template_opt = when mono.storage.generic_templates.lookup_extension_methods(
        mono.storage.context.method_owner_of(resolved_base_type),
    ) in {
        .Some(ext_templates) then select_extension_template(
            ext_templates,
            method_name,
            method_type_arg_count,
            extension_type_arg_count,
        ),
        .None() then select_conformance_extension_template(
            mono,
            resolved_base_type,
            method_name,
            method_type_arg_count,
        ),
    };
    let matched_template = when matched_template_opt in {
        .Some(t_ref) then t_ref,
        .None() then {
            when mono.storage.generic_templates.lookup_extension_methods(
                mono.storage.context.method_owner_of(resolved_base_type),
            ) in {
                .Some(ext_templates) then {
                    for ext_ref in ext_templates then {
                        when ext_ref.conformance_trait_def_id in {
                            .Some(conformance_trait_def_id) then {
                                let inferred_trait_args_from_conformance = resolve_extension_template_conformance_trait_args(
                                    mono,
                                    resolved_base_type,
                                    ext_ref,
                                );
                                let inferred_trait_args = if not inferred_trait_args_from_conformance.is_empty(
                                ) then {
                                    inferred_trait_args_from_conformance
                                } else {
                                    infer_trait_args_from_extension_template_binding(
                                        mono,
                                        ext_ref,
                                        conformance_binding_type_args,
                                        conformance_trait_def_id,
                                    )
                                };
                                when select_trait_tool_template_cached(
                                    mono,
                                    conformance_trait_def_id,
                                    method_name,
                                    method_type_arg_count,
                                    Option[UInt].Some(inferred_trait_args.count()),
                                ) in {
                                    .Some(tool_template_ref) then {
                                        let _ = mono.instantiate_extension_method_impl(
                                            resolved_base_type,
                                            mono.storage.context.method_owner_of(
                                                resolved_base_type,
                                            ),
                                            tool_template_ref,
                                            inferred_trait_args,
                                            method_type_args,
                                        );
                                        mono.storage.resolved_trait_placeholder_keys.insert(
                                            trait_placeholder_key,
                                        );
                                        mono.storage.in_progress_trait_placeholder_keys.remove(
                                            trait_placeholder_key,
                                        );
                                        return;
                                    },
                                    .None() then {},
                                };
                            },
                            .None() then {},
                        };
                    };
                },
                .None() then {},
            };
            for ext_entry in mono.storage.generic_templates.extension_methods then {
                for ext_ref in ext_entry.second then {
                    let conformance_trait_def_id = when ext_ref.conformance_trait_def_id in {
                        .Some(id) then id,
                        .None() then {
                            continue;
                        },
                    };
                    let target_type = when ext_ref.conformance_target_type in {
                        .Some(target) then target,
                        .None() then {
                            continue;
                        },
                    };
                    if not trait_conformance_target_matches(
                        mono,
                        target_type,
                        parameterized_resolved_base_type,
                    ) and not trait_conformance_target_matches_for_template_binding(
                        mono,
                        target_type,
                        parameterized_resolved_base_type,
                    ) then {
                        continue;
                    };
                    let resolved_from_conformance = resolve_extension_template_conformance_trait_args(
                        mono,
                        resolved_base_type,
                        ext_ref,
                    );
                    let inferred_from_binding = infer_trait_args_from_extension_template_binding(
                        mono,
                        ext_ref,
                        conformance_binding_type_args,
                        conformance_trait_def_id,
                    );
                    let effective_trait_args = if not resolved_from_conformance.is_empty(
                    ) then {
                        resolved_from_conformance
                    } else inferred_from_binding;
                    let trait_arg_count_filter = if effective_trait_args.is_empty() then Option[UInt].None(
                    ) else Option[UInt].Some(effective_trait_args.count());
                    when select_trait_tool_template_cached(
                        mono,
                        conformance_trait_def_id,
                        method_name,
                        method_type_arg_count,
                        trait_arg_count_filter,
                    ) in {
                        .Some(tool_template_ref) then {
                            let _ = mono.instantiate_extension_method_impl(
                                resolved_base_type,
                                mono.storage.context.method_owner_of(resolved_base_type),
                                tool_template_ref,
                                conformance_binding_type_args,
                                method_type_args,
                            );
                            mono.storage.resolved_trait_placeholder_keys.insert(
                                trait_placeholder_key,
                            );
                            mono.storage.in_progress_trait_placeholder_keys.remove(
                                trait_placeholder_key,
                            );
                            return;
                        },
                        .None() then {},
                    };
                };
            };
            for node_ref in mono.storage.source_given_decls then {
                when node_ref in {
                    .GivenTraitDecl(target_type, _, trait_args, _, _, given_trait_def_id) then {
                        if not trait_conformance_target_matches(
                            mono,
                            target_type,
                            parameterized_resolved_base_type,
                        ) and not trait_conformance_target_matches_for_template_binding(
                            mono,
                            target_type,
                            parameterized_resolved_base_type,
                        ) then {
                            continue;
                        };
                        let owner_template_for_trait_method = when mono.storage.generic_templates.lookup_extension_methods(
                            mono.storage.context.method_owner_of(
                                parameterized_resolved_base_type,
                            ),
                        ) in {
                            .Some(owner_templates) then {
                                let mutable found = Option[GenericExtensionMethodTemplate].None(
                                );
                                for owner_template in owner_templates then {
                                    if owner_template.method.name != method_name then {
                                        continue;
                                    };
                                    when owner_template.conformance_trait_def_id in {
                                        .Some(owner_trait_def_id) then {
                                            if trait_identity_matches(
                                                owner_trait_def_id,
                                                given_trait_def_id,
                                            ) then {
                                                found = Option[GenericExtensionMethodTemplate].Some(
                                                    owner_template,
                                                );
                                                break;
                                            };
                                        },
                                        .None() then {},
                                    };
                                };
                                found
                            },
                            .None() then Option[GenericExtensionMethodTemplate].None(),
                        };
                        let inferred_trait_args = infer_trait_extension_type_args(
                            mono,
                            target_type,
                            parameterized_resolved_base_type,
                            given_trait_def_id,
                        );
                        let resolved_trait_args = if trait_args.is_empty() then List[Type].new(
                        )
                        else resolve_given_trait_args(
                            mono,
                            target_type,
                            trait_args,
                            parameterized_resolved_base_type,
                        );
                        let resolved_from_conformance = when owner_template_for_trait_method in {
                            .Some(owner_template_ref) then resolve_extension_template_conformance_trait_args(
                                mono,
                                resolved_base_type,
                                owner_template_ref,
                            ),
                            .None() then List[Type].new(),
                        };
                        let inferred_from_binding = when owner_template_for_trait_method in {
                            .Some(owner_template_ref) then infer_trait_args_from_extension_template_binding(
                                mono,
                                owner_template_ref,
                                conformance_binding_type_args,
                                given_trait_def_id,
                            ),
                            .None() then List[Type].new(),
                        };
                        let effective_trait_args = if not resolved_trait_args.is_empty() then {
                            resolved_trait_args
                        } else if not resolved_from_conformance.is_empty() then {
                            resolved_from_conformance
                        } else if not inferred_from_binding.is_empty() then {
                            inferred_from_binding
                        } else inferred_trait_args;
                        when select_trait_tool_template_cached(
                            mono,
                            given_trait_def_id,
                            method_name,
                            method_type_arg_count,
                            Option[UInt].Some(effective_trait_args.count()),
                        ) in {
                            .Some(tool_template_ref) then {
                                let _ = mono.instantiate_extension_method_impl(
                                    resolved_base_type,
                                    mono.storage.context.method_owner_of(
                                        resolved_base_type,
                                    ),
                                    tool_template_ref,
                                    effective_trait_args,
                                    method_type_args,
                                );
                                mono.storage.resolved_trait_placeholder_keys.insert(
                                    trait_placeholder_key,
                                );
                                mono.storage.in_progress_trait_placeholder_keys.remove(
                                    trait_placeholder_key,
                                );
                                return;
                            },
                            .None() then {},
                        };
                    },
                    _ then {},
                };
            };
            instantiate_conformance_trait_methods_for_type(mono, resolved_base_type);
            mono.storage.in_progress_trait_placeholder_keys.remove(
                trait_placeholder_key,
            );
            return;
        },
    };

    let should_use_trait_fallback = when matched_template.conformance_trait_def_id in {
        .Some(_) then true,
        .None() then false,
    };
    if should_use_trait_fallback then {
        when matched_template.conformance_trait_def_id in {
            .Some(conformance_trait_def_id) then {
                let resolved_from_conformance = resolve_extension_template_conformance_trait_args(
                    mono,
                    resolved_base_type,
                    matched_template,
                );
                let inferred_from_binding = infer_trait_args_from_extension_template_binding(
                    mono,
                    matched_template,
                    conformance_binding_type_args,
                    conformance_trait_def_id,
                );
                let effective_trait_args = if not resolved_from_conformance.is_empty() then {
                    resolved_from_conformance
                } else if not inferred_from_binding.is_empty() then {
                    inferred_from_binding
                } else List[Type].new();
                when select_trait_tool_template_cached(
                    mono,
                    conformance_trait_def_id,
                    method_name,
                    method_type_arg_count,
                    Option[UInt].Some(effective_trait_args.count()),
                ) in {
                    .Some(tool_template_ref) then {
                        let patched_template = patched_extension_template_with_body(
                            matched_template,
                            tool_template_ref,
                        );
                        let _ = mono.instantiate_extension_method_impl(
                            resolved_base_type,
                            mono.storage.context.method_owner_of(resolved_base_type),
                            patched_template,
                            effective_trait_args,
                            method_type_args,
                        );
                        mono.storage.resolved_trait_placeholder_keys.insert(
                            trait_placeholder_key,
                        );
                        mono.storage.in_progress_trait_placeholder_keys.remove(
                            trait_placeholder_key,
                        );
                        return;
                    },
                    .None() then {},
                };
            },
            .None() then {},
        };
        for node_ref in mono.storage.source_given_decls then {
            when node_ref in {
                .GivenTraitDecl(target_type, _, trait_args, _, _, given_trait_def_id) then {
                    if not trait_conformance_target_matches(
                        mono,
                        target_type,
                        parameterized_resolved_base_type,
                    ) and not trait_conformance_target_matches_for_template_binding(
                        mono,
                        target_type,
                        parameterized_resolved_base_type,
                    ) then {
                        continue;
                    };
                    let inferred_trait_args = infer_trait_extension_type_args(
                        mono,
                        target_type,
                        parameterized_resolved_base_type,
                        given_trait_def_id,
                    );
                    let resolved_trait_args = if trait_args.is_empty() then List[Type].new(
                    )
                    else resolve_given_trait_args(
                        mono,
                        target_type,
                        trait_args,
                        parameterized_resolved_base_type,
                    );
                    let resolved_from_conformance = resolve_extension_template_conformance_trait_args(
                        mono,
                        resolved_base_type,
                        matched_template,
                    );
                    let inferred_from_binding = infer_trait_args_from_extension_template_binding(
                        mono,
                        matched_template,
                        conformance_binding_type_args,
                        given_trait_def_id,
                    );
                    let effective_trait_args = if not resolved_trait_args.is_empty() then {
                        resolved_trait_args
                    } else if not resolved_from_conformance.is_empty() then {
                        resolved_from_conformance
                    } else if not inferred_from_binding.is_empty() then {
                        inferred_from_binding
                    } else inferred_trait_args;
                    when select_trait_tool_template_cached(
                        mono,
                        given_trait_def_id,
                        method_name,
                        method_type_arg_count,
                        Option[UInt].Some(effective_trait_args.count()),
                    ) in {
                        .Some(tool_template_ref) then {
                            let patched_template = patched_extension_template_with_body(
                                matched_template,
                                tool_template_ref,
                            );
                            let _ = mono.instantiate_extension_method_impl(
                                resolved_base_type,
                                mono.storage.context.method_owner_of(base_type),
                                patched_template,
                                effective_trait_args,
                                method_type_args,
                            );
                            mono.storage.resolved_trait_placeholder_keys.insert(
                                trait_placeholder_key,
                            );
                            mono.storage.in_progress_trait_placeholder_keys.remove(
                                trait_placeholder_key,
                            );
                            return;
                        },
                        .None() then {},
                    };
                },
                _ then {},
            };
        };
    };

    // e. Call instantiate_extension_method with the resolved base_type, template_name,
    //    template, type_args, and method_type_args.
    mono.instantiate_extension_method_impl(
        resolved_base_type,
        mono.storage.context.method_owner_of(base_type),
        matched_template,
        type_args,
        method_type_args,
    );
    mono.storage.resolved_trait_placeholder_keys.insert(trait_placeholder_key);
    mono.storage.in_progress_trait_placeholder_keys.remove(trait_placeholder_key);
};
