// Parameterized type resolution for the monomorphization phase: wrapper
// chains, trait placeholders, def-id backed types, pattern type resolution,
// and the resolve_parameterized_type worklist.

let split_parameterized_type_wrappers(t: Type): ParameterizedTypeWrapperChain = {
    let mutable wrappers = List[ParameterizedTypeWrapperKind].new();
    let mutable current = t;
    while true then {
        when current in {
            .ReferenceType(inner) then {
                wrappers.push(ParameterizedTypeWrapperKind.Reference());
                current = inner;
            },
            .MutableReferenceType(inner) then {
                wrappers.push(ParameterizedTypeWrapperKind.MutableReference());
                current = inner;
            },
            .BorrowedReferenceType(inner) then {
                wrappers.push(ParameterizedTypeWrapperKind.BorrowedReference());
                current = inner;
            },
            .MutableBorrowedReferenceType(inner) then {
                wrappers.push(ParameterizedTypeWrapperKind.MutableBorrowedReference());
                current = inner;
            },
            .PointerType(inner) then {
                wrappers.push(ParameterizedTypeWrapperKind.Pointer());
                current = inner;
            },
            .MutablePointerType(inner) then {
                wrappers.push(ParameterizedTypeWrapperKind.MutablePointer());
                current = inner;
            },
            .WeakReferenceType(inner) then {
                wrappers.push(ParameterizedTypeWrapperKind.WeakReference());
                current = inner;
            },
            .MutableWeakReferenceType(inner) then {
                wrappers.push(ParameterizedTypeWrapperKind.MutableWeakReference());
                current = inner;
            },
            _ then {
                break;
            },
        };
    };
    return ParameterizedTypeWrapperChain(wrappers, current);
};

let apply_parameterized_type_wrapper(
    kind: ParameterizedTypeWrapperKind,
    inner: Type,
): Type = {
    return when kind in {
        .Reference() then Type.ReferenceType(inner),
        .MutableReference() then Type.MutableReferenceType(inner),
        .BorrowedReference() then Type.BorrowedReferenceType(inner),
        .MutableBorrowedReference() then Type.MutableBorrowedReferenceType(inner),
        .Pointer() then Type.PointerType(inner),
        .MutablePointer() then Type.MutablePointerType(inner),
        .WeakReference() then Type.WeakReferenceType(inner),
        .MutableWeakReference() then Type.MutableWeakReferenceType(inner),
    };
};

let rebuild_parameterized_type_wrappers(
    inner: Type,
    wrappers: List[ParameterizedTypeWrapperKind],
): Type = {
    let mutable rebuilt = inner;
    let mutable index = wrappers.count();
    while index > UInt(0) then {
        index = index - UInt(1);
        rebuilt = apply_parameterized_type_wrapper(wrappers[index], rebuilt);
    };
    return rebuilt;
};

let normalize_trait_placeholder_type(mono: Monomorphizer, t: Type): Type = {
    let chain = split_parameterized_type_wrappers(t);
    let normalized_inner = when chain.inner in {
        .GenericStruct(template_def_id, args) then {
            let mutable normalized_args = List[Type].new();
            for arg_ref in args then {
                normalized_args.push(normalize_trait_placeholder_type(mono, arg_ref));
            };
            let trait_name_opt = mono.storage.generic_templates.resolve_trait_name(
                def_id_spelling(template_def_id),
            );
            when trait_name_opt in {
                .Some(trait_name) then Type.TraitObject(
                    trait_def_id_from_registry(mono, trait_name),
                    normalized_args,
                ),
                .None() then Type.GenericStruct(template_def_id, normalized_args),
            }
        },
        .GenericEnum(template_def_id, args) then {
            let mutable normalized_args = List[Type].new();
            for arg_ref in args then {
                normalized_args.push(normalize_trait_placeholder_type(mono, arg_ref));
            };
            let trait_name_opt = mono.storage.generic_templates.resolve_trait_name(
                def_id_spelling(template_def_id),
            );
            when trait_name_opt in {
                .Some(trait_name) then Type.TraitObject(
                    trait_def_id_from_registry(mono, trait_name),
                    normalized_args,
                ),
                .None() then Type.GenericEnum(template_def_id, normalized_args),
            }
        },
        .FunctionType(fn_params, return_type) then {
            let param_types = param_entry_types(fn_params);
            let mutable normalized_params = List[Type].new();
            for param_type in param_types then {
                normalized_params.push(
                    normalize_trait_placeholder_type(mono, param_type),
                );
            };
            let normalized_return = normalize_trait_placeholder_type(mono, return_type);
            make_function_type(normalized_params, normalized_return)
        },
        .GenericParameter(name) then {
            // Resolve Self using current_self_type if available
            if name == "Self" then {
                when mono.storage.current_self_type in {
                    .Some(self_type) then {
                        return self_type;
                    },
                    .None() then {},
                };
            };
            return t;
        },
        _ then chain.inner,
    };
    return if chain.wrappers.is_empty() then normalized_inner
    else rebuild_parameterized_type_wrappers(normalized_inner, chain.wrappers);
};

let trait_object_type_from_registry(
    mono: Monomorphizer,
    trait_name: String,
): Type = {
    let mutable trait_type_args = List[Type].new();
    let mutable trait_def_id = def_id_invalid();
    when trait_info_from_registry(mono, trait_name) in {
        .Some(info) then {
            trait_def_id = info.def_id;
            for type_param in info.type_params then {
                trait_type_args.push(Type.GenericParameter(type_param.name));
            };
        },
        .None() then {},
    };
    return Type.TraitObject(trait_def_id, trait_type_args);
};

let resolve_def_id_backed_type(
    mono: Monomorphizer,
    def_id: DefId,
    fallback: Type,
    is_struct: Bool,
): Type = {
    // A nominal type keeps its DefId identity while its members are resolved.
    // Generic reconstruction is only valid for GenericStruct/GenericEnum nodes.
    if is_struct then {
        when mono.storage.context.get_struct_fields(def_id) in {
            .Some(fields) then {
                let mutable resolved_fields = List[StructField].with_capacity(
                    fields.count(),
                );
                let mutable changed = false;
                for field in fields then {
                    let resolved_field_type = resolve_parameterized_type_cached(
                        mono,
                        field.field_type,
                    );
                    if resolved_field_type != field.field_type then {
                        changed = true;
                    };
                    resolved_fields.push(
                        StructField(
                            field.name,
                            resolved_field_type,
                            field.is_mutable,
                            field.access,
                            field.named,
                            field.default_value,
                        ),
                    );
                };
                if changed then {
                    mono.storage.context.set_struct_fields(def_id, resolved_fields);
                };
            },
            .None() then {},
        };
    } else {
        when mono.storage.context.get_enum_cases(def_id) in {
            .Some(cases) then {
                let mutable resolved_cases = List[EnumCaseInfo].with_capacity(
                    cases.count(),
                );
                let mutable changed = false;
                for enum_case in cases then {
                    let mutable resolved_params = List[EnumCaseParam].with_capacity(
                        enum_case.params.count(),
                    );
                    for param in enum_case.params then {
                        let resolved_param_type = resolve_parameterized_type_cached(
                            mono,
                            param.param_type,
                        );
                        if resolved_param_type != param.param_type then {
                            changed = true;
                        };
                        resolved_params.push(
                            EnumCaseParam(
                                param.name,
                                resolved_param_type,
                                param.named,
                                param.default_value,
                            ),
                        );
                    };
                    resolved_cases.push(EnumCaseInfo(enum_case.name, resolved_params));
                };
                if changed then {
                    mono.storage.context.set_enum_cases(def_id, resolved_cases);
                };
            },
            .None() then {},
        };
    };
    return fallback;
};

let resolve_types_in_pattern(
    mono: Monomorphizer,
    pattern: TypedPattern,
): TypedPattern = {
    return when pattern in {
        .Wildcard() then TypedPattern.Wildcard(),
        .Variable(symbol) then TypedPattern.Variable(resolve_symbol_type(mono, symbol)),
        .BoolLiteral(value) then TypedPattern.BoolLiteral(value),
        .NullLiteral(result_type) then TypedPattern.NullLiteral(
            resolve_parameterized_type(mono, result_type),
        ),
        .IntegerLiteral(value) then TypedPattern.IntegerLiteral(value),
        .NegativeIntegerLiteral(value) then TypedPattern.NegativeIntegerLiteral(value),
        .FloatLiteral(value) then TypedPattern.FloatLiteral(value),
        .StringLiteral(value, equals_symbol) then TypedPattern.StringLiteral(
            value,
            equals_symbol,
        ),
        .RuneLiteral(value) then TypedPattern.RuneLiteral(value),
        .ComparisonPattern(op, value) then TypedPattern.ComparisonPattern(op, value),
        .EnumCase(case_name, tag_index, elements) then {
            let mutable new_elements = List[TypedPatternElement].new();
            for element in elements then {
                new_elements.push(
                    TypedPatternElement(
                        element.label,
                        resolve_types_in_pattern(mono, element.pattern),
                    ),
                );
            };
            TypedPattern.EnumCase(case_name, tag_index, new_elements)
        },
        .StructPattern(type_name, elements) then {
            let mutable new_elements = List[TypedPatternElement].new();
            for element in elements then {
                new_elements.push(
                    TypedPatternElement(
                        element.label,
                        resolve_types_in_pattern(mono, element.pattern),
                    ),
                );
            };
            TypedPattern.StructPattern(type_name, new_elements)
        },
        .TraitObjectType(target_type) then TypedPattern.TraitObjectType(
            resolve_parameterized_type(mono, target_type),
        ),
        .TraitObjectTypeBinding(symbol, target_type) then {
            let resolved_symbol = Symbol(
                symbol.def_id,
                resolve_parameterized_type(mono, symbol.symbol_type),
                symbol.kind,
            );
            TypedPattern.TraitObjectTypeBinding(
                resolved_symbol,
                resolve_parameterized_type(mono, target_type),
            )
        },
        .AndPattern(left, right) then {
            TypedPattern.AndPattern(
                resolve_types_in_pattern(mono, left),
                resolve_types_in_pattern(mono, right),
            )
        },
        .OrPattern(left, right) then {
            TypedPattern.OrPattern(
                resolve_types_in_pattern(mono, left),
                resolve_types_in_pattern(mono, right),
            )
        },
        .NotPattern(inner) then {
            TypedPattern.NotPattern(resolve_types_in_pattern(mono, inner))
        },
        .WeakBinding(symbol) then TypedPattern.WeakBinding(
            resolve_symbol_type(mono, symbol),
        ),
        .ListPattern(ops, elements) then {
            let mutable new_elements = List[TypedPattern].new();
            for element in elements then {
                new_elements.push(resolve_types_in_pattern(mono, element));
            };
            TypedPattern.ListPattern(
                refresh_list_pattern_ops(
                    mono,
                    ops,
                    resolve_parameterized_type(mono, ops.list_type),
                    resolve_parameterized_type(mono, ops.element_type),
                ),
                new_elements,
            )
        },
        .RestPattern() then pattern,
    };
};

/// Re-resolve a list pattern's std methods against its now-concrete list type.
///
/// A symbol kept from the generic template names a function monomorphization
/// never emits, so the call would not link. Once `List[T]` has a real `T`,
/// `count` and `__index_get` are instantiated for it exactly as an ordinary
/// `xs.count()` / `xs[i]` call instantiates them.
public let refresh_list_pattern_ops(
    mono: Monomorphizer,
    ops: ListPatternOps,
    list_type: Type,
    element_type: Type,
): ListPatternOps = {
    if has_generic_parameter(list_type) then {
        return ListPatternOps(list_type, element_type, ops.count_symbol, ops.index_symbol);
    };
    // `count` / `__index_get` are the compiler's own list-pattern ops, a closed
    // set the pattern lowering names directly; the warm-up below is a parse
    // boundary for them, not a general name lookup. It is what materializes the
    // specialization for the now-concrete list type, exactly as an ordinary
    // `xs.count()` / `xs[i]` call would.
    instantiate_trait_placeholder_method(mono, list_type, "count", List[Type].new());
    instantiate_trait_placeholder_method(mono, list_type, "__index_get", List[Type].new());
    // Read-only identity lookup: no instantiation, so the resolution worklist
    // this runs inside is left alone. Instantiating here perturbs state that
    // later makes codegen emit a payloadless init for a tagged enum
    // (`Type`, `InterpolatedStringTokenPart`). The lookup is still keyed by
    // owner + DefId -- it only declines to CREATE anything.
    let count_symbol = lookup_method_instance_identity_readonly(
        mono,
        ops.count_symbol,
        list_type,
        List[Type].new(),
    ) or else ops.count_symbol;
    let index_symbol = lookup_method_instance_identity_readonly(
        mono,
        ops.index_symbol,
        list_type,
        List[Type].new(),
    ) or else ops.index_symbol;
    return ListPatternOps(list_type, element_type, count_symbol, index_symbol);
};

// ── Iterative type resolution worklist helpers ────────────────────────────────

// Collect child types that must be resolved before the parent type.
// Used by the iterative worklist in resolve_parameterized_type to avoid
// deep call-stack recursion on nested generic types.
let collect_resolve_children(mono: Monomorphizer, t: Type): List[Type] = {
    let mutable children = List[Type].new();

    // Wrapper types: peel all wrappers and return the inner type.
    let chain = split_parameterized_type_wrappers(t);
    if not chain.wrappers.is_empty() then {
        children.push(chain.inner);
        return children;
    };

    when t in {
        .FunctionType(fn_params, return_type) then {
            let param_types = param_entry_types(fn_params);
            for pt in param_types then {
                children.push(pt);
            };
            children.push(return_type);
        },
        .GenericStruct(_, args) then {
            for arg in args then {
                children.push(arg);
            };
        },
        .GenericEnum(_, args) then {
            for arg in args then {
                children.push(arg);
            };
        },
        .StructureType(def_id) then {
            when mono.storage.context.get_type_arguments(def_id) in {
                .Some(type_args) then {
                    for arg in type_args then {
                        children.push(arg);
                    };
                },
                .None() then {
                    when mono.storage.context.lookup_type(def_id) in {
                        .Some(mapped) then {
                            children.push(mapped);
                        },
                        .None() then {},
                    };
                },
            };
            when mono.storage.context.get_struct_fields(def_id) in {
                .Some(fields) then {
                    for field in fields then {
                        children.push(field.field_type);
                    };
                },
                .None() then {},
            };
        },
        .EnumType(def_id) then {
            when mono.storage.context.get_type_arguments(def_id) in {
                .Some(type_args) then {
                    for arg in type_args then {
                        children.push(arg);
                    };
                },
                .None() then {
                    when mono.storage.context.lookup_type(def_id) in {
                        .Some(mapped) then {
                            children.push(mapped);
                        },
                        .None() then {},
                    };
                },
            };
            when mono.storage.context.get_enum_cases(def_id) in {
                .Some(cases) then {
                    for c in cases then {
                        for p in c.params then {
                            children.push(p.param_type);
                        };
                    };
                },
                .None() then {},
            };
        },
        .OpaqueType(def_id) then {
            when mono.storage.context.lookup_type(def_id) in {
                .Some(mapped) then {
                    children.push(mapped);
                },
                .None() then {},
            };
        },
        _ then {},
    };
    return children;
};

// Cache-first resolution helper: returns from cache if available, otherwise
// calls resolve_parameterized_type_single. This avoids re-entering the worklist
// wrapper in resolve_parameterized_type when children are already cached.
let resolve_parameterized_type_cached(mono: Monomorphizer, t: Type): Type = {
    when mono.storage.resolved_parameterized_types.get(t) in {
        .Some(cached) then {
            return cached;
        },
        .None() then {},
    };
    return resolve_parameterized_type_single(mono, t);
};

// resolve_parameterized_type_single: resolves a single type using the original logic.
// Called by the worklist pre-resolution pass. Children should already be in the cache.
let resolve_parameterized_type_single(mono: Monomorphizer, t: Type): Type = {
    let chain = split_parameterized_type_wrappers(t);
    if not chain.wrappers.is_empty() then {
        let resolved_inner = resolve_parameterized_type_cached(mono, chain.inner);
        let rebuilt = rebuild_parameterized_type_wrappers(resolved_inner, chain.wrappers);
        let result = if rebuilt == t then t else rebuilt;
        mono.storage.resolved_parameterized_types.insert(t, result);
        return result;
    };

    // Resolve GenericParameter("Self") using current_self_type if available
    if t is .GenericParameter(name) then {
        if name == "Self" then {
            when mono.storage.current_self_type in {
                .Some(self_type) then {
                    mono.storage.resolved_parameterized_types.insert(t, self_type);
                    return self_type;
                },
                .None() then {},
            };
        };
        mono.storage.resolved_parameterized_types.insert(t, t);
        return t;
    };
    when t in {
        .IntType() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .Int8Type() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .Int16Type() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .Int32Type() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .Int64Type() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .UIntType() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .UInt8Type() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .UInt16Type() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .UInt32Type() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .UInt64Type() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .Float32Type() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .Float64Type() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .BoolType() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .VoidType() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .NeverType() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .ModuleType(_) then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .TraitObject(...) then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .TypeVar(_) then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        .Unknown() then {
            mono.storage.resolved_parameterized_types.insert(t, t);
            return t;
        },
        _ then {},
    };

    when t in {
        .FunctionType(fn_params, return_type) then {
            let param_types = param_entry_types(fn_params);
            let mutable new_param_types = List[Type].with_capacity(param_types.count());
            let mutable changed = false;
            for pt in param_types then {
                let resolved = resolve_parameterized_type_cached(mono, pt);
                if resolved != pt then {
                    changed = true;
                };
                new_param_types.push(resolved);
            };
            let resolved_return = resolve_parameterized_type_cached(mono, return_type);
            if not changed and resolved_return == return_type then {
                mono.storage.resolved_parameterized_types.insert(t, t);
                return t;
            };
            let result = make_function_type(new_param_types, resolved_return);
            mono.storage.resolved_parameterized_types.insert(t, result);
            return result;
        },
        .OpaqueType(def_id) then {
            if mono.storage.context.lookup_type(def_id) is .None() then {
                mono.storage.resolved_parameterized_types.insert(t, t);
                return t;
            };
        },
        _ then {},
    };

    when mono.storage.resolved_parameterized_types.get(t) in {
        .Some(cached) then {
            return cached;
        },
        .None() then {},
    };
    when type_instantiation_cache_key(mono, t) in {
        .Some(cache_key) then {
            when mono.storage.instantiated_types.get(cache_key) in {
                .Some(cached) then {
                    mono.storage.resolved_parameterized_types.insert(t, cached);
                    return cached;
                },
                .None() then {},
            };
        },
        .None() then {},
    };
    if mono.storage.resolving_parameterized_type_keys.contains(t) then {
        return t;
    };
    mono.storage.resolving_parameterized_type_keys.insert(t);

    let resolved = when t in {
        .GenericStruct(template_def_id, args) then {
            when type_instantiation_cache_key(mono, t) in {
                .Some(cache_key) then when mono.storage.instantiated_types.get(
                    cache_key,
                ) in {
                    .Some(cached) then {
                        cached
                    },
                    .None() then {},
                },
                .None() then {},
            };
            let trait_name_opt = mono.storage.generic_templates.resolve_trait_name(
                def_id_spelling(template_def_id),
            );
            let mutable resolved_args = List[Type].new();
            for arg_ref in args then {
                let normalized_arg = normalize_trait_placeholder_type(mono, arg_ref);
                resolved_args.push(
                    resolve_parameterized_type_cached(mono, normalized_arg),
                );
            };
            when trait_name_opt in {
                .Some(trait_name) then Type.TraitObject(
                    trait_def_id_from_registry(mono, trait_name),
                    resolved_args,
                ),
                .None() then {
                    if args_have_generic_parameter(resolved_args) then Type.GenericStruct(
                        template_def_id,
                        resolved_args,
                    )
                    else when mono.storage.generic_templates.struct_by_def_id(
                        template_def_id,
                    ) in {
                        .Some(struct_template) then {
                            mono.instantiate_struct_impl(struct_template, resolved_args)
                        },
                        .None() then {
                            when mono.storage.generic_templates.concrete_struct_types.get(
                                def_id_spelling(template_def_id),
                            ) in {
                                .Some(concrete) then concrete,
                                .None() then Type.GenericStruct(
                                    template_def_id,
                                    resolved_args,
                                ),
                            }
                        },
                    }
                },
            }
        },
        .GenericEnum(template_def_id, args) then {
            when type_instantiation_cache_key(mono, t) in {
                .Some(cache_key) then when mono.storage.instantiated_types.get(
                    cache_key,
                ) in {
                    .Some(cached) then {
                        cached
                    },
                    .None() then {},
                },
                .None() then {},
            };
            let trait_name_opt = mono.storage.generic_templates.resolve_trait_name(
                def_id_spelling(template_def_id),
            );
            let mutable resolved_args = List[Type].new();
            for arg_ref in args then {
                let normalized_arg = normalize_trait_placeholder_type(mono, arg_ref);
                resolved_args.push(
                    resolve_parameterized_type_cached(mono, normalized_arg),
                );
            };
            when trait_name_opt in {
                .Some(trait_name) then Type.TraitObject(
                    trait_def_id_from_registry(mono, trait_name),
                    resolved_args,
                ),
                .None() then {
                    if args_have_generic_parameter(resolved_args) then Type.GenericEnum(
                        template_def_id,
                        resolved_args,
                    )
                    else when mono.storage.generic_templates.enum_by_def_id(
                        template_def_id,
                    ) in {
                        .Some(enum_template) then {
                            mono.instantiate_enum_impl(enum_template, resolved_args)
                        },
                        .None() then {
                            when mono.storage.generic_templates.concrete_enum_types.get(
                                def_id_spelling(template_def_id),
                            ) in {
                                .Some(concrete) then concrete,
                                .None() then Type.GenericEnum(
                                    template_def_id,
                                    resolved_args,
                                ),
                            }
                        },
                    }
                },
            }
        },
        .StructureType(def_id) then resolve_def_id_backed_type(mono, def_id, t, true),
        .EnumType(def_id) then resolve_def_id_backed_type(mono, def_id, t, false),
        .OpaqueType(def_id) then {
            when mono.storage.context.lookup_type(def_id) in {
                .Some(mapped) then {
                    let resolved_mapped = resolve_parameterized_type_cached(mono, mapped);
                    if mono.storage.context.get_layout_key(resolved_mapped) == mono.storage.context.get_layout_key(
                        t,
                    ) then t else resolved_mapped
                },
                .None() then t,
            }
        },
        _ then t,
    };

    mono.storage.resolving_parameterized_type_keys.remove(t);
    mono.storage.resolved_parameterized_types.insert(t, resolved);
    return resolved;
};

public let resolve_parameterized_type(mono: Monomorphizer, t: Type): Type = {
    // 快路径：命中缓存直接返回。缓存由 resolve_parameterized_type_single 全量填充
    // （连已具体的原语类型也缓存 t→t），而这个入口被逐节点调用，命中率很高。
    // 不短路的话，即使答案已在缓存里，每次调用也要分配 worklist 的 List + Dict，
    // 以及 collect_resolve_children 的一次 List。
    when mono.storage.resolved_parameterized_types.get(t) in {
        .Some(cached) then {
            return cached;
        },
        .None() then {},
    };
    // ── Iterative worklist pre-resolution ──────────────────────────────────
    // Pre-resolve all descendant types iteratively to avoid stack overflow.
    // This ensures that when the resolution logic below calls resolve_parameterized_type
    // for children, those children are already in the cache.
    {
        let mutable wl = List[Type].new();
        wl.push(t);
        let mutable wl_iters = UInt(100000); // safety guard: real types resolve well before this
        let mutable push_back_counts = Dict[Type, UInt].new();
        while not wl.is_empty() and wl_iters > UInt(0) then {
            wl_iters = wl_iters - UInt(1);
            let cur = wl.pop().unwrap();
            let ct = cur;
            let already = when mono.storage.resolved_parameterized_types.get(ct) in {
                .Some(_) then true,
                .None() then false,
            };
            if not already then {
                // Cycle detection: if this type has been pushed back too many times,
                // resolve it anyway to yield potential infinite loops.
                let pb_count = when push_back_counts.get(ct) in {
                    .Some(c) then c,
                    .None() then UInt(0),
                };
                // Force-resolve after 3 retries to yield potential infinite loops
                if pb_count > UInt(3) then {
                    resolve_parameterized_type_single(mono, ct);
                } else {
                    let kids = collect_resolve_children(mono, ct);
                    let mutable all_done = true;
                    for kid in kids then {
                        let kid_done = when mono.storage.resolved_parameterized_types.get(
                            kid,
                        ) in {
                            .Some(_) then true,
                            .None() then false,
                        };
                        if not kid_done then {
                            all_done = false;
                            wl.push(kid);
                        };
                    };
                    if all_done then {
                        resolve_parameterized_type_single(mono, ct);
                        // If the result is a new type, it may need resolution too.
                        let res = mono.storage.resolved_parameterized_types.get(ct);
                        if res is .Some(r) then {
                            if r != ct then {
                                let r_cached = when mono.storage.resolved_parameterized_types.get(
                                    r,
                                ) in {
                                    .Some(_) then true,
                                    .None() then false,
                                };
                                if not r_cached then {
                                    wl.push(r);
                                };
                            };
                        };
                    } else {
                        // Not all children resolved yet – push back with count.
                        push_back_counts.insert(ct, pb_count + UInt(1));
                        wl.push(cur);
                    };
                };
            };
        };
    };
    // After the worklist, all descendants should be cached.
    // The logic below will find them via cache lookups.
    // ── End worklist pre-resolution ────────────────────────────────────────

    // Iterative wrapper peeling: strip reference/pointer wrappers in a loop
    // instead of recursing, to avoid stack overflow on deep wrapper chains.
    let chain = split_parameterized_type_wrappers(t);
    if not chain.wrappers.is_empty() then {
        let resolved_inner = resolve_parameterized_type(mono, chain.inner);
        let rebuilt = rebuild_parameterized_type_wrappers(resolved_inner, chain.wrappers);
        return if rebuilt == t then t else rebuilt;
    };

    // Resolve GenericParameter("Self") using current_self_type if available
    if t is .GenericParameter(name) then {
        if name == "Self" then {
            when mono.storage.current_self_type in {
                .Some(self_type) then {
                    return self_type;
                },
                .None() then {},
            };
        };
        return t;
    };
    when t in {
        .IntType() then {
            return t;
        },
        .Int8Type() then {
            return t;
        },
        .Int16Type() then {
            return t;
        },
        .Int32Type() then {
            return t;
        },
        .Int64Type() then {
            return t;
        },
        .UIntType() then {
            return t;
        },
        .UInt8Type() then {
            return t;
        },
        .UInt16Type() then {
            return t;
        },
        .UInt32Type() then {
            return t;
        },
        .UInt64Type() then {
            return t;
        },
        .Float32Type() then {
            return t;
        },
        .Float64Type() then {
            return t;
        },
        .BoolType() then {
            return t;
        },
        .VoidType() then {
            return t;
        },
        .NeverType() then {
            return t;
        },
        .ModuleType(_) then {
            return t;
        },
        .TraitObject(...) then {
            return t;
        },
        .TypeVar(_) then {
            return t;
        },
        .Unknown() then {
            return t;
        },
        _ then {},
    };

    when t in {
        .FunctionType(fn_params, return_type) then {
            let param_types = param_entry_types(fn_params);
            let mutable new_param_types = List[Type].with_capacity(param_types.count());
            let mutable changed = false;
            for pt in param_types then {
                let resolved = resolve_parameterized_type(mono, pt);
                if resolved != pt then {
                    changed = true;
                };
                new_param_types.push(resolved);
            };
            let resolved_return = resolve_parameterized_type(mono, return_type);
            if not changed and resolved_return == return_type then {
                return t;
            };
            return make_function_type(new_param_types, resolved_return);
        },
        .OpaqueType(def_id) then {
            if mono.storage.context.lookup_type(def_id) is .None() then {
                return t;
            };
        },
        _ then {},
    };

    when mono.storage.resolved_parameterized_types.get(t) in {
        .Some(cached) then {
            return cached;
        },
        .None() then {},
    };
    when type_instantiation_cache_key(mono, t) in {
        .Some(cache_key) then {
            when mono.storage.instantiated_types.get(cache_key) in {
                .Some(cached) then {
                    mono.storage.resolved_parameterized_types.insert(t, cached);
                    return cached;
                },
                .None() then {},
            };
        },
        .None() then {},
    };
    if mono.storage.resolving_parameterized_type_keys.contains(t) then {
        return t;
    };
    mono.storage.resolving_parameterized_type_keys.insert(t);

    let resolved = when t in {
        // GenericStruct: look up struct template and instantiate.
        .GenericStruct(template_def_id, args) then {
            when type_instantiation_cache_key(mono, t) in {
                .Some(cache_key) then when mono.storage.instantiated_types.get(
                    cache_key,
                ) in {
                    .Some(cached) then {
                        cached
                    },
                    .None() then {},
                },
                .None() then {},
            };
            // Trait names can appear in GenericStruct form during sema output
            // (e.g. [T]Iterator). Treat them as trait objects in mono/type
            // resolution so codegen does not attempt to materialize fake
            // concrete layouts like Iterator_Int.
            let trait_name_opt = mono.storage.generic_templates.resolve_trait_name(
                def_id_spelling(template_def_id),
            );
            let mutable resolved_args = List[Type].new();
            for arg_ref in args then {
                let normalized_arg = normalize_trait_placeholder_type(mono, arg_ref);
                resolved_args.push(resolve_parameterized_type(mono, normalized_arg));
            };
            when trait_name_opt in {
                .Some(trait_name) then Type.TraitObject(
                    trait_def_id_from_registry(mono, trait_name),
                    resolved_args,
                ),
                .None() then {
                    if args_have_generic_parameter(resolved_args) then Type.GenericStruct(
                        template_def_id,
                        resolved_args,
                    )
                    else when mono.storage.generic_templates.struct_by_def_id(
                        template_def_id,
                    ) in {
                        .Some(struct_template) then {
                            mono.instantiate_struct_impl(struct_template, resolved_args)
                        },
                        .None() then {
                            // Check concrete struct types registry.
                            when mono.storage.generic_templates.concrete_struct_types.get(
                                def_id_spelling(template_def_id),
                            ) in {
                                .Some(concrete) then concrete,
                                .None() then Type.GenericStruct(
                                    template_def_id,
                                    resolved_args,
                                ),
                            }
                        },
                    }
                },
            }
        },
        // GenericEnum: look up enum template and instantiate.
        .GenericEnum(template_def_id, args) then {
            when type_instantiation_cache_key(mono, t) in {
                .Some(cache_key) then when mono.storage.instantiated_types.get(
                    cache_key,
                ) in {
                    .Some(cached) then {
                        cached
                    },
                    .None() then {},
                },
                .None() then {},
            };
            let trait_name_opt = mono.storage.generic_templates.resolve_trait_name(
                def_id_spelling(template_def_id),
            );
            let mutable resolved_args = List[Type].new();
            for arg_ref in args then {
                let normalized_arg = normalize_trait_placeholder_type(mono, arg_ref);
                resolved_args.push(resolve_parameterized_type(mono, normalized_arg));
            };
            when trait_name_opt in {
                .Some(trait_name) then Type.TraitObject(
                    trait_def_id_from_registry(mono, trait_name),
                    resolved_args,
                ),
                .None() then {
                    if args_have_generic_parameter(resolved_args) then Type.GenericEnum(
                        template_def_id,
                        resolved_args,
                    )
                    else when mono.storage.generic_templates.enum_by_def_id(
                        template_def_id,
                    ) in {
                        .Some(enum_template) then {
                            mono.instantiate_enum_impl(enum_template, resolved_args)
                        },
                        .None() then {
                            // Check concrete enum types registry.
                            when mono.storage.generic_templates.concrete_enum_types.get(
                                def_id_spelling(template_def_id),
                            ) in {
                                .Some(concrete) then concrete,
                                .None() then Type.GenericEnum(
                                    template_def_id,
                                    resolved_args,
                                ),
                            }
                        },
                    }
                },
            }
        },
        .StructureType(def_id) then resolve_def_id_backed_type(mono, def_id, t, true),
        .EnumType(def_id) then resolve_def_id_backed_type(mono, def_id, t, false),
        .OpaqueType(def_id) then {
            when mono.storage.context.lookup_type(def_id) in {
                .Some(mapped) then {
                    let resolved_mapped = resolve_parameterized_type(mono, mapped);
                    if mono.storage.context.get_layout_key(resolved_mapped) == mono.storage.context.get_layout_key(
                        t,
                    ) then t else resolved_mapped
                },
                .None() then t,
            }
        },
        // All other types: return unchanged.
        _ then t,
    };

    mono.storage.resolving_parameterized_type_keys.remove(t);
    mono.storage.resolved_parameterized_types.insert(t, resolved);
    return resolved;
};

