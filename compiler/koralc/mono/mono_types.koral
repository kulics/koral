// Layout Name generation for the monomorphization phase.
// Provides canonical string representations of types (layout keys) and
// helpers for building the unique C-level identifiers used by the Monomorphizer.
//

// ── layout key ────────────────────────────────────────────────────────────────

// There is ONE layout key, `CompilerContext.get_layout_key`. It names
// monomorphized C entities and is compared for type equality all over the
// Monomorphizer, so it must be injective on the type -- two types that get one
// key share one C symbol. Its rules live with it in
// `sema/compiler_context.koral`; this file used to carry a second
// implementation with its own spellings, and the two had drifted.
public let contextual_layout_key(mono: Monomorphizer, t: Type): String = {
    return mono.storage.context.get_layout_key(t);
};

private let instantiation_layout_key(mono: Monomorphizer, t: Type): String = {
    return mono.storage.context.get_layout_key(t);
};

private let concrete_layout_key(mono: Monomorphizer, def_id: DefId): Option[String] = {
    let name = mono.storage.context.get_name(def_id) or else {
        return Option[String].None();
    };
    let module_path = mono.storage.context.get_module_path(def_id) or else List[String].new(
    );
    let is_private = when mono.storage.context.get_access(def_id) in {
        .Some(access) then when access in {
            .Private() then true,
            _ then false,
        },
        .None() then false,
    };
    let source_file = mono.storage.context.get_source_file(def_id) or else "";

    let mutable parts = List[String].new();
    if not module_path.is_empty() then {
        let mutable path_str = StringBuilder.new();
        let mutable first = true;
        for seg in module_path then {
            if not first then {
                path_str.push_byte('_');
            };
            path_str.push_string(seg);
            first = false;
        };
        parts.push(path_str.to_string());
    };

    if is_private and not source_file.is_empty() then {
        let mutable hash: WrappingUInt32 = 0;
        for byte in source_file.bytes() then {
            hash = hash * 31 + WrappingUInt32(byte);
        };
        parts.push("f\(UInt(hash % 10000))");
    };

    parts.push(name);

    let mutable result = StringBuilder.new();
    let mutable first = true;
    for part in parts then {
        if not first then {
            result.push_byte('_');
        };
        result.push_string(part);
        first = false;
    };
    return Option[String].Some(result.to_string());
};

// ── make_layout_name ──────────────────────────────────────────────────────────

// Generate the layout name for a generic struct, enum, or function.
//
// Format: "<template_name>_<arg1_key>_<arg2_key>..."
//
// Examples:
//   make_layout_name("List", [Int], template_def_id)       → "List_Int_d<id>"
//   make_layout_name("Dict", [String, Int], template_def_id) → "Dict_String_Int_d<id>"
public let make_layout_name(
    mono: Monomorphizer,
    template_name: String,
    args: List[Type],
    template_def_id: DefId,
): String = {
    let mutable arg_keys = List[String].new();
    for a in args then {
        arg_keys.push(mono.storage.context.get_layout_key(a));
    };
    let mutable out = StringBuilder.new();
    out.push_string(template_name);
    out.push_string("_");
    out.push_string(arg_keys.join_to_string("_"));
    if template_def_id.is_valid() then {
        out.push_string("_d");
        out.push_string(template_def_id.id.to_string());
    };
    return out.to_string();
};

// Mirrors Swift's Monomorphizer.typeInstantiationCacheKey(for:).
// The cache identity is the template declaration DefId plus concrete type
// arguments; layout names remain output symbols and are not identity keys.
/// The instantiation cache key: the template's DECLARATION plus its type
/// arguments.
///
/// Keyed by `DefId`, never by the template's spelling -- deriving it from the
/// name gave every same-named template one key, so `mod_a`'s `Box[Int]` and
/// `mod_b`'s `Box[Int]` shared a cache slot and the second returned the first's
/// instantiation. rustc's `Instance` is `(DefId, GenericArgs)` for the same
/// reason.
public let type_instantiation_cache_key(
    mono: Monomorphizer,
    t: Type,
): Option[InstantiationKey] = {
    return when t in {
        .GenericStruct(template_def_id, args) then {
            if template_def_id.is_valid() then {
                Option[InstantiationKey].Some(
                    InstantiationKey.StructType(template_def_id, args),
                )
            } else {
                Option[InstantiationKey].None()
            }
        },
        .GenericEnum(template_def_id, args) then {
            if template_def_id.is_valid() then {
                Option[InstantiationKey].Some(
                    InstantiationKey.EnumType(template_def_id, args),
                )
            } else {
                Option[InstantiationKey].None()
            }
        },
        .StructureType(def_id) then {
            if not mono.storage.context.is_generic_instantiation(def_id) then {
                return Option[InstantiationKey].None();
            };
            when mono.storage.context.get_type_arguments(def_id) in {
                .Some(args) then Option[InstantiationKey].Some(
                    InstantiationKey.StructType(
                        mono.storage.context.get_template_def_id(def_id),
                        args,
                    ),
                ),
                .None() then Option[InstantiationKey].None(),
            }
        },
        .EnumType(def_id) then {
            if not mono.storage.context.is_generic_instantiation(def_id) then {
                return Option[InstantiationKey].None();
            };
            when mono.storage.context.get_template_name(def_id) in {
                .Some(_) then when mono.storage.context.get_type_arguments(def_id) in {
                    .Some(args) then {
                        Option[InstantiationKey].Some(
                            InstantiationKey.EnumType(
                                mono.storage.context.get_template_def_id(def_id),
                                args,
                            ),
                        )
                    },
                    .None() then Option[InstantiationKey].None(),
                },
                .None() then Option[InstantiationKey].None(),
            }
        },
        _ then Option[InstantiationKey].None(),
    };
};

// ── make_extension_method_layout_name ────────────────────────────────────────

// Generate the layout name for an extension method.
//
// Format (no method type args):
//   "<template_name>_<type_arg1_key>_..._<method_name>"
//
// Format (with method type args):
//   "<template_name>_<type_arg1_key>_..._<method_name>_<method_arg1_key>_..."
//
// Examples:
//   make_extension_method_layout_name("List",  [Int],         "push",  [])       → "List_Int_push"
//   make_extension_method_layout_name("Dict",   [String, Int], "get",   [])       → "Dict_String_Int_get"
//   make_extension_method_layout_name("List",  [Int],         "map",   [String]) → "List_Int_map_String"
//   make_extension_method_layout_name(..., "List", [Int], "push", [])        → "List_Int_push_d103"
//
// The owner's DECLARATION joins the name, exactly as a type's own C name does
// (`Box_I_d184`). Two modules may each declare `Box`, so `Box_I_stamp` alone
// names two different methods and one C definition answers for both.
public let make_extension_method_layout_name(
    mono: Monomorphizer,
    template_name: String,
    template_def_id: DefId,
    type_args: List[Type],
    method_name: String,
    method_type_args: List[Type],
): String = {
    let mutable out = StringBuilder.new();
    out.push_string(template_name);
    for a in type_args then {
        out.push_string("_");
        out.push_string(instantiation_layout_key(mono, a));
    };
    out.push_string("_");
    out.push_string(method_name);
    for a in method_type_args then {
        out.push_string("_");
        out.push_string(instantiation_layout_key(mono, a));
    };
    // The owner's DECLARATION joins the name, exactly as a type's own C name does
    // (`Box_I_d184`). Two modules may each declare `Box`, so `Box_I_stamp` alone
    // names two different methods and one C definition answers for both.
    if template_def_id.is_valid() then {
        out.push_string("_d\(template_def_id.id)");
    };
    return out.to_string();
};

/// Key of one instantiated extension method: WHICH type, WHICH method, which
/// method type arguments.
///
/// The owner is a declaration identity, so two types with the same spelling --
/// or the same C mangle name -- cannot share a slot. This used to build a
/// `String` out of a mangle name plus a layout key, which is why a `String` and
/// a `Rune` could answer for each other.
public let make_extension_method_key(
    mono: Monomorphizer,
    owner: MethodOwner,
    owner_args: List[Type],
    method_name: String,
    method_type_args: List[Type],
): MethodLookupKey = {
    let _ = mono;
    return MethodLookupKey(owner, owner_args, method_name, method_type_args);
};

/// Same key, built from a `CompilerContext` alone -- MIR and codegen do not
/// hold a `Monomorphizer`.
public let make_receiver_method_key_from_context(
    context: CompilerContext,
    receiver_type: Type,
    method_name: String,
): MethodLookupKey = {
    let pair = context.method_owner_and_args(receiver_type);
    return MethodLookupKey(pair.first, pair.second, method_name, List[Type].new());
};

/// Key of a method instantiated for a concrete receiver: the receiver's owner
/// identity AND its instantiation arguments, so `List[String].new` and
/// `List[Rune].new` are two entries. See `docs/design/generics-and-monomorphization.md`.
public let make_receiver_method_key(
    mono: Monomorphizer,
    receiver_type: Type,
    method_name: String,
    method_type_args: List[Type],
): MethodLookupKey = {
    let pair = mono.storage.context.method_owner_and_args(receiver_type);
    return MethodLookupKey(pair.first, pair.second, method_name, method_type_args);
};

/// DefId-keyed identity key for one instantiated extension method. This is the
/// migration target for instance lookup; the name-keyed helpers above remain
/// only for declaration-time/name bridge tables.
public let make_extension_method_identity_key(
    mono: Monomorphizer,
    owner: MethodOwner,
    owner_args: List[Type],
    method_def_id: DefId,
    method_type_args: List[Type],
): MethodInstanceKey = {
    let _ = mono;
    return MethodInstanceKey(owner, owner_args, method_def_id, method_type_args);
};

/// Same identity key, built from a `CompilerContext` alone.
public let make_receiver_method_identity_key_from_context(
    context: CompilerContext,
    receiver_type: Type,
    method_def_id: DefId,
): MethodInstanceKey = {
    let pair = context.method_owner_and_args(receiver_type);
    return MethodInstanceKey(pair.first, pair.second, method_def_id, List[Type].new());
};

/// Identity key of a method instantiated for a concrete receiver.
public let make_receiver_method_identity_key(
    mono: Monomorphizer,
    receiver_type: Type,
    method_def_id: DefId,
    method_type_args: List[Type],
): MethodInstanceKey = {
    let pair = mono.storage.context.method_owner_and_args(receiver_type);
    return MethodInstanceKey(pair.first, pair.second, method_def_id, method_type_args);
};

// ── has_generic_parameter ─────────────────────────────────────────────────────

// Returns true if the type contains any GenericParameter variant.
// Used to detect partially-resolved types that should skip code generation.
// Whether `t` is still uninstantiated -- not yet a type monomorphization can
// lay out. A type VARIABLE counts: it is an inference result nobody pinned
// down, and materializing a layout for one would name a symbol after a shape
// that does not exist. Callers ask this to decide "may I emit this yet?", not
// "does this mention a type parameter?".
public let has_generic_parameter(t: Type): Bool = {
    return when t in {
        .GenericParameter(_) then true,
        .TypeVar(_) then true,
        .ReferenceType(inner) then has_generic_parameter(inner),
        .MutableReferenceType(inner) then has_generic_parameter(inner),
        .BorrowedReferenceType(inner) then has_generic_parameter(inner),
        .MutableBorrowedReferenceType(inner) then has_generic_parameter(inner),
        .PointerType(inner) then has_generic_parameter(inner),
        .MutablePointerType(inner) then has_generic_parameter(inner),
        .WeakReferenceType(inner) then has_generic_parameter(inner),
        .MutableWeakReferenceType(inner) then has_generic_parameter(inner),
        .FunctionType(fn_params, return_type) then {
            let param_types = param_entry_types(fn_params);
            for pt in param_types then {
                if has_generic_parameter(pt) then {
                    return true;
                };
            };
            has_generic_parameter(return_type)
        },
        .GenericStruct(_, args) then {
            for a in args then {
                if has_generic_parameter(a) then {
                    return true;
                };
            };
            false
        },
        .GenericEnum(_, args) then {
            for a in args then {
                if has_generic_parameter(a) then {
                    return true;
                };
            };
            false
        },
        .TraitObject(_, args) then {
            for a in args then {
                if has_generic_parameter(a) then {
                    return true;
                };
            };
            false
        },
        _ then false,
    };
};

// Like `has_generic_parameter` but treats `Self` as already bound (to the
// target type at registration time), matching Swift's
// `extensionMethods[methodOwnerKey]` registration which files every concrete
// method including ones whose params mention `Self`.
public let has_generic_parameter_excluding_self(t: Type): Bool = {
    return when t in {
        .GenericParameter(name) then name != "Self",
        .TypeVar(_) then true,
        .ReferenceType(inner) then has_generic_parameter_excluding_self(inner),
        .MutableReferenceType(inner) then has_generic_parameter_excluding_self(inner),
        .BorrowedReferenceType(inner) then has_generic_parameter_excluding_self(inner),
        .MutableBorrowedReferenceType(inner) then has_generic_parameter_excluding_self(
            inner,
        ),
        .PointerType(inner) then has_generic_parameter_excluding_self(inner),
        .MutablePointerType(inner) then has_generic_parameter_excluding_self(inner),
        .WeakReferenceType(inner) then has_generic_parameter_excluding_self(inner),
        .MutableWeakReferenceType(inner) then has_generic_parameter_excluding_self(
            inner,
        ),
        .FunctionType(fn_params, return_type) then {
            for pt in param_entry_types(fn_params) then {
                if has_generic_parameter_excluding_self(pt) then {
                    return true;
                };
            };
            has_generic_parameter_excluding_self(return_type)
        },
        .GenericStruct(_, args) then {
            for a in args then {
                if has_generic_parameter_excluding_self(a) then {
                    return true;
                };
            };
            false
        },
        .GenericEnum(_, args) then {
            for a in args then {
                if has_generic_parameter_excluding_self(a) then {
                    return true;
                };
            };
            false
        },
        .TraitObject(_, args) then {
            for a in args then {
                if has_generic_parameter_excluding_self(a) then {
                    return true;
                };
            };
            false
        },
        _ then false,
    };
};

// ── args_have_generic_parameter ───────────────────────────────────────────────

// Returns true if any type in the args list is still unresolved enough that
// monomorphization should not materialize a concrete layout yet.
public let args_have_generic_parameter(args: List[Type]): Bool = {
    for a in args then {
        if has_generic_parameter(a) or is_placeholder_inferred_type(a) then {
            return true;
        };
    };
    return false;
};

// ── instantiate_struct ────────────────────────────────────────────────────────

// Instantiate a generic struct template with concrete type arguments.
//
// Steps:
//   a. If any type arg is a GenericParameter, return partial GenericStruct (skip codegen)
//   b. Generate layout name
//   c. Check instantiated_types cache
//   d. Build type substitution map
//   e. Resolve each field's TypeNode to a concrete Type
//   f. Create TypeStructDecl and add to generated_nodes
//   g. Cache in instantiated_types
//   h. If template has drop, enqueue ExtensionMethod instantiation request
//   i. Return StructureType(def_id)
//
public let instantiate_struct(
    mono: Monomorphizer,
    template: GenericStructTemplate,
    args: List[Type],
): Type = {
    if args.count() != template.type_parameters.count() then {
        mono.report_monomorphization_error(
            template.def_id,
            "Monomorphization error: struct type arg arity mismatch for \(template.name) - expected \(template.type_parameters.count()), got \(args.count())",
        );
        return Type.Unknown();
    };

    // a. If any type arg contains an unresolved GenericParameter, skip code generation
    //    and return a partial GenericStruct type.
    if args_have_generic_parameter(args) then {
        return Type.GenericStruct(template.def_id, args);
    };

    // b. Generate the layout name.
    let layout_name = make_layout_name(mono, template.name, args, template.def_id);

    // c. Check instantiated_types cache.
    let mutable type_arg_list = List[Type].new();
    for a in args then {
        type_arg_list.push(a);
    };
    let cache_key = InstantiationKey.StructType(template.def_id, type_arg_list);
    when mono.storage.instantiated_types.get(cache_key) in {
        .Some(cached) then {
            return cached;
        },
        .None() then {},
    };

    // Create a placeholder concrete type before resolving fields so recursive
    // references through ref/Option can reuse it instead of tripping cycle detection.
    let def_id = mono.storage.context.allocate(
        layout_name,
        DefKind.TypeDef(TypeDefKind.Structure()),
    );
    let mutable concrete_type = Type.StructureType(def_id);
    mono.storage.instantiated_types.insert(cache_key, concrete_type);

    // Propagate the template's nominal mutability to the concrete instantiation
    // so `type mutable RangeIterator[T]` correctly classifies RangeIterator_Int
    // as managed in the layout analysis. Without this, the instantiation is
    // treated as a plain value type and its iterator state is deep-copied on
    // every `next()` call, breaking for-loop termination.
    if mono.storage.context.is_struct_mutable(template.def_id) then {
        mono.storage.context.set_struct_mutable(def_id, true);
    };

    mono.storage.context.set_struct_info(
        def_id,
        StructTypeInfo(
            List[StructField].new(),
            true,
            Option[List[Type]].Some(type_arg_list),
            Option[String].Some(template.name),
            template.def_id,
        ),
    );

    // d. Build type substitution map: template.type_parameters[i].name → args[i].
    let mutable substitution = Dict[String, Type].new();
    let mutable param_idx = UInt(0);
    while param_idx < template.type_parameters.count() then {
        let param = template.type_parameters[param_idx];
        let arg = args[param_idx];
        substitution.insert(param.name, arg);
        param_idx += UInt(1);
    };

    // e. Resolve each field's TypeNode to a concrete Type.
    let mutable concrete_fields = List[TypedField].new();
    for field in template.fields then {
        let resolved_type = resolve_parameterized_type(
            mono,
            mono.resolve_type_node_impl(
                field.field_type,
                template_substitution(template.type_parameters, substitution),
            ),
        );

        concrete_fields.push(
            TypedField(
                field.access,
                field.name,
                field.is_mutable,
                resolved_type,
                field.named,
                field.default_value,
            ),
        );
    };

    // Register struct fields in the DefIdMap for later use.
    let mutable struct_fields = List[StructField].new();
    for cf in concrete_fields then {
        struct_fields.push(
            StructField(
                cf.name,
                cf.field_type,
                cf.is_mutable,
                cf.access,
                cf.named,
                Option[Expr].None(),
            ),
        );
    };
    // 使用 set_struct_info 记录完整的泛型实例化信息
    mono.storage.context.set_struct_info(
        def_id,
        StructTypeInfo(
            struct_fields,
            true,
            Option[List[Type]].Some(type_arg_list),
            Option[String].Some(template.name),
            template.def_id,
        ),
    );

    // i. Create TypeStructDecl and add to generated_nodes.
    let decl = TypedDecl.TypeStructDecl(
        AccessModifier.Public(),
        layout_name,
        concrete_fields,
        unknown_span(),
        Symbol(def_id, concrete_type, SymbolKind.TypeSymbol()),
    );
    mono.storage.generated_nodes.push(decl);

    // Record template info for error messages and final trait pass.
    mono.storage.layout_to_template_info.insert(
        layout_name,
        TemplateInfo(template.name, args),
    );

    // j. Cache in instantiated_types.
    mono.storage.instantiated_types.insert(cache_key, concrete_type);

    // h. Force instantiate drop if this type conforms to std Drop.
    //    All other extension methods are instantiated on-demand when called,
    //    via try_bind_generic_method_call during monomorphization.
    let template_owner = MethodOwner.Decl(template.def_id);
    when mono.storage.generic_templates.lookup_extension_methods(template_owner) in {
        .Some(ext_templates) then {
            for ext_template in ext_templates then {
                if ext_template.method.name == "drop" or mono.storage.context.is_std_drop_impl_def_id(
                    ext_template.conformance_trait_def_id,
                ) then {
                    let _ = mono.instantiate_extension_method_impl(
                        concrete_type,
                        template_owner,
                        ext_template,
                        args,
                        List[Type].new(),
                    );
                };
            };
        },
        .None() then {},
    };

    // m. Return the concrete StructureType.
    return concrete_type;
};

// ── instantiate_enum ─────────────────────────────────────────────────────────

// Instantiate a generic enum template with concrete type arguments.
//
// Steps:
//   a. If any type arg is a GenericParameter, return partial GenericEnum (skip codegen)
//   b. Generate layout name
//   c. Check instantiated_types cache
//   d. Build type substitution map
//   e. Resolve each case's param TypeNodes to concrete Types
//   f. Create TypeEnumDecl and add to generated_nodes
//   g. Cache in instantiated_types
//   h. If template has drop, enqueue ExtensionMethod instantiation request
//   i. Return EnumType(def_id)
//
public let instantiate_enum(
    mono: Monomorphizer,
    template: GenericEnumTemplate,
    args: List[Type],
): Type = {
    if args.count() != template.type_parameters.count() then {
        mono.report_monomorphization_error(
            template.def_id,
            "Monomorphization error: enum type arg arity mismatch for \(template.name) - expected \(template.type_parameters.count()), got \(args.count())",
        );
        return Type.Unknown();
    };

    // a. If any type arg contains an unresolved GenericParameter, skip code generation
    //    and return a partial GenericEnum type.
    if args_have_generic_parameter(args) then {
        return Type.GenericEnum(template.def_id, args);
    };

    // b. Generate the layout name.
    let layout_name = make_layout_name(mono, template.name, args, template.def_id);

    // c. Check instantiated_types cache.
    let mutable type_arg_list = List[Type].new();
    for a in args then {
        type_arg_list.push(a);
    };
    let cache_key = InstantiationKey.EnumType(template.def_id, type_arg_list);
    when mono.storage.instantiated_types.get(cache_key) in {
        .Some(cached) then {
            return cached;
        },
        .None() then {},
    };

    // Create a placeholder concrete type before resolving case parameters so
    // recursive references through ref can reuse it instead of tripping cycle detection.
    let def_id = mono.storage.context.allocate(
        layout_name,
        DefKind.TypeDef(TypeDefKind.Enum()),
    );
    let mutable concrete_type = Type.EnumType(def_id);
    mono.storage.instantiated_types.insert(cache_key, concrete_type);

    mono.storage.context.set_enum_info(
        def_id,
        EnumTypeInfo(
            List[EnumCaseInfo].new(),
            true,
            Option[List[Type]].Some(type_arg_list),
            Option[String].Some(template.name),
            template.def_id,
        ),
    );

    // d. Build type substitution map: template.type_parameters[i].name → args[i].
    let mutable substitution = Dict[String, Type].new();
    let mutable param_idx = UInt(0);
    while param_idx < template.type_parameters.count() then {
        let param = template.type_parameters[param_idx];
        let arg = args[param_idx];
        substitution.insert(param.name, arg);
        param_idx += UInt(1);
    };

    // e. Resolve each case's param TypeNodes to concrete Types.
    let mutable concrete_cases = List[TypedEnumCase].new();
    for case_ in template.cases then {
        let mutable concrete_fields = List[TypedEnumCaseField].new();
        for param in case_.params then {
            let resolved_type = resolve_parameterized_type(
                mono,
                mono.resolve_type_node_impl(
                    param.param_type,
                    template_substitution(template.type_parameters, substitution),
                ),
            );

            concrete_fields.push(
                TypedEnumCaseField(
                    param.name,
                    resolved_type,
                    param.named,
                    param.default_value,
                ),
            );
        };
        concrete_cases.push(TypedEnumCase(case_.name, concrete_fields));
    };

    // Register enum cases in the DefIdMap for later use.
    let mutable enum_case_infos = List[EnumCaseInfo].new();
    for cc in concrete_cases then {
        let mutable case_params = List[EnumCaseParam].new();
        for cf in cc.fields then {
            case_params.push(
                EnumCaseParam(cf.name, cf.field_type, cf.named, Option[Expr].None()),
            );
        };
        enum_case_infos.push(EnumCaseInfo(cc.name, case_params));
    };
    // 使用 set_enum_info 记录完整的泛型实例化信息
    mono.storage.context.set_enum_info(
        def_id,
        EnumTypeInfo(
            enum_case_infos,
            true,
            Option[List[Type]].Some(type_arg_list),
            Option[String].Some(template.name),
            template.def_id,
        ),
    );

    // i. Create TypeEnumDecl and add to generated_nodes.
    let decl = TypedDecl.TypeEnumDecl(
        AccessModifier.Public(),
        layout_name,
        concrete_cases,
        unknown_span(),
        Symbol(def_id, concrete_type, SymbolKind.TypeSymbol()),
    );
    mono.storage.generated_nodes.push(decl);

    // Record template info for error messages and final trait pass.
    mono.storage.layout_to_template_info.insert(
        layout_name,
        TemplateInfo(template.name, args),
    );

    // j. Cache in instantiated_types.
    mono.storage.instantiated_types.insert(cache_key, concrete_type);

    // h. Force instantiate drop if this enum type conforms to std Drop.
    //    All other extension methods are instantiated on-demand when called.
    let template_owner = MethodOwner.Decl(template.def_id);
    when mono.storage.generic_templates.lookup_extension_methods(template_owner) in {
        .Some(ext_templates) then {
            for ext_template in ext_templates then {
                if ext_template.method.name == "drop" or mono.storage.context.is_std_drop_impl_def_id(
                    ext_template.conformance_trait_def_id,
                ) then {
                    let _ = mono.instantiate_extension_method_impl(
                        concrete_type,
                        template_owner,
                        ext_template,
                        args,
                        List[Type].new(),
                    );
                };
            };
        },
        .None() then {},
    };

    // m. Return the concrete EnumType.
    return concrete_type;
};
