/// Whether this pattern matches every value of its type. A list matches
/// everything only as the bare rest marker `[...]`: a fixed slot -- even an
/// irrefutable one -- still constrains the length, so `[_, ...]` misses `[]`.
public let typed_pattern_is_irrefutable(pattern TypedPattern) Bool = {
    return when pattern in {
        .Wildcard() then true,
        .Variable(_) then true,
        .RestPattern() then true,
        .ListPattern(_, elements) then elements is [.RestPattern()],
        .StructPattern(_, elements) then {
            for element in elements then {
                if not typed_pattern_is_irrefutable(element.pattern) then {
                    return false;
                };
            };
            true
        },
        .AndPattern(left, right) then typed_pattern_is_irrefutable(left) and typed_pattern_is_irrefutable(
            right,
        ),
        .OrPattern(left, right) then typed_pattern_is_irrefutable(left) or typed_pattern_is_irrefutable(
            right,
        ),
        _ then false,
    };
};

/// Whether this pattern is the rest marker `...`.
public let typed_pattern_is_rest_slot(pattern TypedPattern) Bool = {
    return pattern is .RestPattern();
};

public let typed_pattern_binding_symbols(pattern TypedPattern) List[Symbol] = {
    let mutable symbols = List[Symbol].new();
    let mutable seen_def_ids = Set[UInt].new();
    typed_pattern_collect_binding_symbols(pattern, symbols, seen_def_ids);
    return symbols;
};

file_private let typed_pattern_collect_binding_symbols(
    pattern TypedPattern,
    symbols List[Symbol],
    seen_def_ids Set[UInt],
) Void = {
    when pattern in {
        .Variable(symbol) then {
            if not seen_def_ids.contains(symbol.def_id.id) then {
                seen_def_ids.insert(symbol.def_id.id);
                symbols.push(symbol);
            };
        },
        .TraitObjectTypeBinding(symbol, _) then {
            if not seen_def_ids.contains(symbol.def_id.id) then {
                seen_def_ids.insert(symbol.def_id.id);
                symbols.push(symbol);
            };
        },
        .WeakBinding(symbol) then {
            if not seen_def_ids.contains(symbol.def_id.id) then {
                seen_def_ids.insert(symbol.def_id.id);
                symbols.push(symbol);
            };
        },
        .EnumCase(_, _, elements) then {
            for element in elements then {
                typed_pattern_collect_binding_symbols(
                    element.pattern,
                    symbols,
                    seen_def_ids,
                );
            };
        },
        .StructPattern(_, elements) then {
            for element in elements then {
                typed_pattern_collect_binding_symbols(
                    element.pattern,
                    symbols,
                    seen_def_ids,
                );
            };
        },
        .ListPattern(_, elements) then {
            for element in elements then {
                typed_pattern_collect_binding_symbols(
                    element,
                    symbols,
                    seen_def_ids,
                );
            };
        },
        .AndPattern(left, right) then {
            typed_pattern_collect_binding_symbols(left, symbols, seen_def_ids);
            typed_pattern_collect_binding_symbols(right, symbols, seen_def_ids);
        },
        .OrPattern(left, right) then {
            typed_pattern_collect_binding_symbols(left, symbols, seen_def_ids);
            typed_pattern_collect_binding_symbols(right, symbols, seen_def_ids);
        },
        .NotPattern(inner) then typed_pattern_collect_binding_symbols(
            inner,
            symbols,
            seen_def_ids,
        ),
        .Wildcard() then {},
        .RestPattern() then {},
        .BoolLiteral(_) then {},
        .NullLiteral(_) then {},
        .IntegerLiteral(_) then {},
        .NegativeIntegerLiteral(_) then {},
        .FloatLiteral(_) then {},
        .StringLiteral(_, _) then {},
        .RuneLiteral(_) then {},
        .TraitObjectType(_) then {},
        .ComparisonPattern(_, _) then {},
    };
};

public let typed_pattern_introduces_binding(pattern TypedPattern) Bool = {
    return when pattern in {
        .Variable(_) then true,
        .TraitObjectTypeBinding(_, _) then true,
        .WeakBinding(_) then true,
        .EnumCase(_, _, elements) then {
            for element in elements then {
                if typed_pattern_introduces_binding(element.pattern) then {
                    return true;
                };
            };
            false
        },
        .StructPattern(_, elements) then {
            for element in elements then {
                if typed_pattern_introduces_binding(element.pattern) then {
                    return true;
                };
            };
            false
        },
        .ListPattern(_, elements) then {
            for element in elements then {
                if typed_pattern_introduces_binding(element) then {
                    return true;
                };
            };
            false
        },
        .AndPattern(left, right) then typed_pattern_introduces_binding(left) or typed_pattern_introduces_binding(
            right,
        ),
        .OrPattern(left, right) then typed_pattern_introduces_binding(left) or typed_pattern_introduces_binding(
            right,
        ),
        .NotPattern(inner) then typed_pattern_introduces_binding(inner),
        .Wildcard() then false,
        .RestPattern() then false,
        .BoolLiteral(_) then false,
        .NullLiteral(_) then false,
        .IntegerLiteral(_) then false,
        .NegativeIntegerLiteral(_) then false,
        .FloatLiteral(_) then false,
        .StringLiteral(_, _) then false,
        .RuneLiteral(_) then false,
        .TraitObjectType(_) then false,
        .ComparisonPattern(_, _) then false,
    };
};

public let typed_pattern_is_wildcard_only(pattern TypedPattern) Bool = {
    return when pattern in {
        .Wildcard() then true,
        .RestPattern() then true,
        .ListPattern(_, _) then typed_pattern_is_irrefutable(pattern),
        .EnumCase(_, _, elements) then {
            for element in elements then {
                if not typed_pattern_is_wildcard_only(element.pattern) then {
                    return false;
                };
            };
            true
        },
        .StructPattern(_, elements) then {
            for element in elements then {
                if not typed_pattern_is_wildcard_only(element.pattern) then {
                    return false;
                };
            };
            true
        },
        .Variable(_) then false,
        .TraitObjectType(_) then false,
        .TraitObjectTypeBinding(_, _) then false,
        .WeakBinding(_) then false,
        .BoolLiteral(_) then false,
        .NullLiteral(_) then false,
        .IntegerLiteral(_) then false,
        .NegativeIntegerLiteral(_) then false,
        .FloatLiteral(_) then false,
        .StringLiteral(_, _) then false,
        .RuneLiteral(_) then false,
        .ComparisonPattern(_, _) then false,
        .AndPattern(_, _) then false,
        .OrPattern(_, _) then false,
        .NotPattern(_) then false,
    };
};

public let typed_pattern_is_conditionless_payload(pattern TypedPattern) Bool = {
    return when pattern in {
        .Wildcard() then true,
        .Variable(_) then true,
        .RestPattern() then true,
        .ListPattern(_, _) then typed_pattern_is_irrefutable(pattern),
        .TraitObjectType(_) then false,
        .TraitObjectTypeBinding(_, _) then false,
        .StructPattern(_, elements) then {
            for element in elements then {
                if not typed_pattern_is_conditionless_payload(element.pattern) then {
                    return false;
                };
            };
            true
        },
        _ then false,
    };
};

/// Whether `pattern` contains an `or` that offers more than one reading.
///
/// `not` is not a choice point -- a negation has no bindings to disagree on --
/// so nothing under it counts.
public let typed_pattern_contains_or(pattern TypedPattern) Bool = {
    return when pattern in {
        .OrPattern(_, _) then true,
        .AndPattern(left, right) then typed_pattern_contains_or(left) or typed_pattern_contains_or(
            right,
        ),
        .EnumCase(_, _, elements) then {
            for element in elements then {
                if typed_pattern_contains_or(element.pattern) then {
                    return true;
                };
            };
            false
        },
        .StructPattern(_, elements) then {
            for element in elements then {
                if typed_pattern_contains_or(element.pattern) then {
                    return true;
                };
            };
            false
        },
        .ListPattern(_, elements) then {
            for element in elements then {
                if typed_pattern_contains_or(element) then {
                    return true;
                };
            };
            false
        },
        _ then false,
    };
};

/// The or-free readings of `pattern`, in backtracking order.
///
/// Every `or` is a choice point and one alternative fixes each choice to one
/// side. Nested choices multiply (cartesian product, the leftmost choice
/// varying slowest), so `Point(a or b, c or d)` reads as the sequence
/// `(a, c) (a, d) (b, c) (b, d)` -- an arm with a guard tries the leftmost
/// reading first and falls through to the next reading when the guard
/// refuses. A pattern with no `or` returns itself: the common case never
/// rebuilds.
public let typed_pattern_or_alternatives(pattern TypedPattern) List[TypedPattern] = {
    if not typed_pattern_contains_or(pattern) then {
        let mutable single = List[TypedPattern].new();
        single.push(pattern);
        return single;
    };
    let mutable out = List[TypedPattern].new();
    typed_pattern_collect_or_alternatives(pattern, out);
    return out;
};

file_private let typed_pattern_collect_or_alternatives(
    pattern TypedPattern,
    out List[TypedPattern],
) Void = {
    when pattern in {
        .OrPattern(left, right) then {
            typed_pattern_collect_or_alternatives(left, out);
            typed_pattern_collect_or_alternatives(right, out);
        },
        .AndPattern(left, right) then {
            for left_alt in typed_pattern_or_alternatives(left) then {
                for right_alt in typed_pattern_or_alternatives(right) then {
                    out.push(.AndPattern(left_alt, right_alt));
                };
            };
        },
        .EnumCase(case_name, tag_index, elements) then {
            for combo in typed_pattern_element_combinations(elements) then {
                out.push(.EnumCase(case_name, tag_index, combo));
            };
        },
        .StructPattern(type_name, elements) then {
            for combo in typed_pattern_element_combinations(elements) then {
                out.push(.StructPattern(type_name, combo));
            };
        },
        .ListPattern(ops, elements) then {
            for combo in typed_pattern_list_combinations(elements) then {
                out.push(.ListPattern(ops, combo));
            };
        },
        _ then {
            out.push(pattern);
        },
    };
};

/// Every reading of a labeled element list: the first element's choices vary
/// slowest, so alternatives come out in source order.
file_private let typed_pattern_element_combinations(
    elements List[TypedPatternElement],
) List[List[TypedPatternElement]] = {
    let mutable combos = List[List[TypedPatternElement]].new();
    combos.push(List[TypedPatternElement].new());
    for element in elements then {
        let alts = typed_pattern_or_alternatives(element.pattern);
        let mutable next = List[List[TypedPatternElement]].new();
        for combo in combos then {
            for alt in alts then {
                let mutable extended = combo.clone();
                extended.push(TypedPatternElement(element.label, alt));
                next.push(extended);
            };
        };
        combos = next;
    };
    return combos;
};

/// The same product for a list pattern's unlabeled slots.
file_private let typed_pattern_list_combinations(
    elements List[TypedPattern],
) List[List[TypedPattern]] = {
    let mutable combos = List[List[TypedPattern]].new();
    combos.push(List[TypedPattern].new());
    for element in elements then {
        let alts = typed_pattern_or_alternatives(element);
        let mutable next = List[List[TypedPattern]].new();
        for combo in combos then {
            for alt in alts then {
                let mutable extended = combo.clone();
                extended.push(alt);
                next.push(extended);
            };
        };
        combos = next;
    };
    return combos;
};

/// The patterns whose test reads the RAW subject: a `null` pattern compares
/// the pointer itself and a trait-object pattern matches the wrapper. The
/// type checker keeps the subject un-dereferenced for these
/// (`pattern_requires_raw_subject`) and derefs one level for every other
/// pattern, so MIR must see the same subject the pattern was checked against.
public let typed_pattern_requires_raw_subject(pattern TypedPattern) Bool = {
    return when pattern in {
        .NullLiteral(_) then true,
        .TraitObjectType(_) then true,
        .TraitObjectTypeBinding(_, _) then true,
        .EnumCase(_, _, elements) then {
            for element in elements then {
                if typed_pattern_requires_raw_subject(element.pattern) then {
                    return true;
                };
            };
            false
        },
        .StructPattern(_, elements) then {
            for element in elements then {
                if typed_pattern_requires_raw_subject(element.pattern) then {
                    return true;
                };
            };
            false
        },
        .ListPattern(_, elements) then {
            for element in elements then {
                if typed_pattern_requires_raw_subject(element) then {
                    return true;
                };
            };
            false
        },
        .AndPattern(left, right) then typed_pattern_requires_raw_subject(left) or typed_pattern_requires_raw_subject(
            right,
        ),
        .OrPattern(left, right) then typed_pattern_requires_raw_subject(left) or typed_pattern_requires_raw_subject(
            right,
        ),
        .NotPattern(inner) then typed_pattern_requires_raw_subject(inner),
        _ then false,
    };
};
