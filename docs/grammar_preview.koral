// ============================================================
// FFI（外部函数接口）
// ============================================================

// 需要链接的原生库放在 koral.json / std/koral.json 的 links 中，
// 不再使用 foreign using

foreign type FILE {}
foreign type Point(x Int, y Int)        // 带字段的外部类型

foreign let fopen(path *unsafe UInt8, mode *unsafe UInt8) *unsafe FILE
foreign let fclose(file *unsafe FILE) Int32


// ============================================================
// 字面量 (Literals)
// ============================================================

let literals() Void = {
    // 字符串
    let s String = "hello, world!"
    let escaped = "tab:\t newline:\n quote:\""
    let hex_byte = "\xAB"
    let unicode = "\u{1F600}"

    // 多行字符串（三引号，缩进以 closing """ 为基准自动剥离）
    let multi = """
        hello
        world
        """
    // multi == "hello\nworld"

    // 字符串插值
    let name = "Koral"
    let greeting = "Hello \(name), 1 + 1 = \(1 + 1)"

    // 多行字符串中的插值
    let doc = """
        Dear \(name),
        Welcome.
        """

    // Rune（字符）字面量
    let r Rune = 'a'
    let newline_rune = '\n'
    let unicode_rune = '\u{1F600}'

    // 整数
    let decimal Int = 123
    let binary  Int = 0b1010          // value: 10
    let octal   Int = 0o755           // value: 493
    let hex     Int = 0xFF            // value: 255
    let sep     Int = 1_000_000       // 下划线分隔符
    let hex_sep Int = 0xFF_FF         // value: 65535

    // 浮点数
    let f64 Float64 = 1.23
    let sci1 Float64 = 1e10
    let sci2 Float64 = 2.5e-3
    let sci3 Float64 = 1e+6

    // Duration 后缀字面量
    let d1 Duration = 10s
    let d2 Duration = 250ms
    let d5 Duration = 150us
    let d6 Duration = 42ns
    let d_neg Duration = -5s

    // Pair 字面量（等价于 Pair(a, b)）
    let p1 = (1, 2)
    let p2 = (true, "ok")
    let p3 = ((1, 2), 3)   // 嵌套 Pair

    // 布尔
    let t Bool = true
    let f Bool = false

    // 类型转换（cast）
    let i32 = 42(Int32)
    let f32 Float32 = 3.14(Float32)
}


// ============================================================
// 变量与常量 (Variables & Constants)
// ============================================================

let variables() Void = {
    // 不可变绑定（类型推断）
    let x = 42
    // 不可变绑定（显式类型）
    let y Int = 42
    // 可变绑定
    let mutable z Int = 0
    z = 10
    z += 1

    // Pair 解构绑定
    let (a, b) = (1, 2)                  // 类型推断
    let (c Int, d String) = (3, "hello")  // 显式类型标注
    let (mutable e, f) = (10, 20)             // 可变绑定
    let (_, g) = (1, 2)                   // 丢弃第一个元素

    // 丢弃返回值
    _ = some_fn()
}

// ============================================================
// 运算符 (Operators)
// ============================================================

let operators() Void = {
    // 逻辑运算符
    x and y
    x or y
    not x

    // 比较运算符
    x == y  // eq
    x <> y  // ne
    x > y   // gt
    x < y   // lt
    x >= y  // ge
    x <= y  // le
    1 < x < 3      // chained ascending comparison
    10 >= y > 0    // chained descending comparison
    // invalid: a < b > c
    // invalid: a < b == c

    // 算术运算符
    x + y   // add
    x - y   // sub
    x * y   // mul
    x / y   // div
    x % y   // mod
    -x      // unary minus

    // 位运算符
    x & y   // bitwise and
    x | y   // bitwise or
    x ^ y   // bitwise xor
    ~x      // bitwise not
    x << y  // left shift
    x >> y  // right shift

    // 复合赋值运算符
    x += y;  x -= y;  x *= y;  x /= y;  x %= y
    x &= y;  x |= y;  x ^= y;  x <<= y; x >>= y

    // 范围运算符
    let a = 1..5    // 1 <= x <= 5  (closed)
    let b = 1..<5   // 1 <= x < 5   (closed-open)
    let c = 1<..5   // 1 < x <= 5   (open-closed)
    let d = 1<..<5  // 1 < x < 5    (open)
    let e = 1..     // 1 <= x <= max (from)
    let f = 1<..    // 1 < x <= max  (from-open)
    let g = ..5     // min <= x <= 5 (to)
    let h = ..<5    // min <= x < 5  (to-open)
    let i = ..      // min <= x <= max (full)
}


// ============================================================
// 函数 (Functions)
// ============================================================

// 无参无返回值
let do_nothing() Void = {}

// 有参有返回值
let add(x Int, y Int) Int = x + y

// 显式返回类型
let mul(x Int, y Int) Int = x * y

// 可变参数
let inc(mutable x Int) Int = {
    x += 1
    return x
}

// 泛型函数（单约束）
let contains[T Eq](list List[T], item T) Bool = {}

// 泛型函数（多约束）
let max[T Eq and Ord](a T, b T) T =
    if a.compare(b) >= 0 then a else b

// 函数类型
let fn_types() Void = {
    let f Func(Int, Int) Int = (x Int, y Int) Int -> x + y
    let g Func(Int) Int      = (x) -> x * 2
    let h Func() Void          = () -> {}

    // 柯里化
    let add = (x Int) -> (y Int) -> x + y
    let v = add(1)(2)

    // 作为参数传递
    let apply = (f Func(Int) Int, x Int) Int -> f(x)
    apply((x) -> x + 1, 5)
    apply((x Int) Int -> x * 2, 5)

    // 链式调用（lambda 作为参数）
    some_list.filter((x) -> x % 2 == 0).map((x) -> x * x)
}

// ============================================================
// 构造器标签与默认填充 (Constructor Labels and Default Fill)
// ============================================================

// 结构体字段声明使用 `name Type`。
// 调用时仍然可以按字段名写标签。
type Button(width Int, height Int, label String)

let labeled_struct() Void = {
    let b = Button(width: 100, height: 50, label: "OK")
    println(b.label)
}

// 支持重排与 `...` 默认填充
let struct_default_fill() Void = {
    let b = Button(label: "OK", ...)
    println(b.width)
}

// Enum 变体同样支持标签构造
type DrawCmd {
    Line(start Point, end Point),
    Circle(center Point, radius Float64),
}

let labeled_enum() Void = {
    let cmd = DrawCmd.Circle(center: Point(0, 0), radius: 5.0)
    // 隐式成员表达式同样支持标签构造
    let cmd2 Option[DrawCmd] = .Some(.Line(Point(0, 0), end: Point(1, 1)))
}

// 模式匹配中的标签解构（按字段名匹配）
let labeled_pattern_matching() Void = {
    let cmd = DrawCmd.Circle(center: Point(0, 0), radius: 5.0)

    // when 表达式
    when cmd in {
        .Line(s, end: e) then println(s.x),
        .Circle(center: c, radius: r) then println(r),
    }

    // if is
    if cmd is .Circle(center: c, radius: _) then println(c.x)

    // 结构体解构
    let b = Button(width: 100, height: 50, label: "OK")
    if b is Button(width: w, height: _, label: l) then println(l)
}

// ============================================================
// yield value（仅用于 if / when 分支表达式的分支 body）
// ============================================================

let value = if ready() then {
    yield 42
} else {
    yield 0
}

// early yield value：在分支 body 内提前产出当前分支表达式的值
let classify(score Int) String =
    if score >= 90 then {
        if score == 100 then { yield "perfect" }
        yield "A"
    } else {
        yield "other"
    }

// 嵌套 when 表达式拥有自己的分支结果目标
let nested(flag Bool) Int =
    if flag then {
        yield when input() in {
            .Some(v) then { yield v },
            .None then { yield 0 },
        }
    } else {
        yield -1
    }


// ============================================================
// 控制流 (Control Flow)
// ============================================================

let control_flow() Void = {
    // if-then（单分支）
    if a < b then {
        {}
    }

    // if-then-else（双分支）
    let v = if true then 0 else 1
    if a then {
        {}
    } else if b then {
        {}
    } else {
        {}
    }

    // 条件逻辑组合（左到右短路；前面绑定可供后续 and 子句使用）
    if ready() and has_permission() and feature_enabled() then run() else deny()
    if input is .Some(x) and x > 0 and validate(x) then accept(x) else reject()

    // while-then（语句）
    while a < b then {
        {}
    }

    // while 条件逻辑组合
    while iter.next() is .Some(v) and v < 10 then println(v)

    // for-in-then（语句）
    for item in list then println(item)
    for i in 0..10 then println(i)
    for i in 0..10 then if i % 2 == 0 then println(i)

    // 解构迭代（需要 enumerate 返回的元素用 pattern 解构）
    for (first, second) in list.enumerate() then {
        println(first)
        println(second)
    }

    // return / break / continue
    let early Func(Int) Int = (x Int) Int ->
        if x > 0 then 1 else 2

    while i < 10 then {
        i += 1
        if i == 5 then { continue }
        if i == 8 then { break }
    }

    // defer（LIFO 顺序，作用域退出前执行）
    let with_defer Func() Void = () -> {
        defer println("C")  // 最后执行
        defer println("B")
        defer println("A")  // 最先执行
        println("working")
        // 输出: working -> A -> B -> C
    }
}


// ============================================================
// 模式匹配 (Pattern Matching)
// ============================================================

let pattern_matching() Void = {
    // when 表达式（穷举匹配）
    when x in {
        1       then "one",
        2       then "two",
        _       then "other",
    }

    // 所有模式类型
    when value in {
        1           then {},  // 整数字面量
        -5          then {},  // 负整数字面量
        'a'         then {},  // rune 字面量
        "abc"       then {},  // 字符串字面量
        true        then {},  // 布尔字面量
        (a, b)      then {},  // Pair 解构模式
        ((a, b), c) then {},  // 嵌套 Pair 解构模式
        _           then {},  // 通配符
        x           then {},  // 变量绑定
        mutable x   then {},  // 可变变量绑定
        Foo(x, y)   then {},  // 结构体解构
        .Some(x)    then {},  // enum case 解构
        > 5         then {},  // 比较模式（大于）
        < 10        then {},  // 比较模式（小于）
        >= 0        then {},  // 比较模式（大于等于）
        <= 100      then {},  // 比较模式（小于等于）
        > -5        then {},  // 比较模式（负数）
        1 or 2      then {},  // or 组合
        x and > 0   then {},  // and 组合（绑定 + 比较）
        not 0       then {},  // not 组合
    }

    // 数值范围匹配（and 组合比较模式）
    when num in {
        0 or 1 or 2 or 3 or 4 or 5 or 6 or 7 or 8 or 9 then
            println("single digit"),
        n and >= 10 and <= 99 then
            println("double digits"),
        n and >= 100 and <= 999 then
            println("triple digits"),
        _ then
            println("four or more digits"),
    }

    // if is（条件模式匹配）
    if op is .Some(v) then println(v)
    if a is 1 or a is 2 then {}
    if a is n and n < 2 then {}
    if a is not 2 then {}

    // while is（循环模式匹配）
    let iter = list.iterator()
    while iter.next() is .Some(v) then println(v)

    // Pair pattern（if / when）
    if (1, 2) is (a, b) then println(a + b)
    when ((1, 2), 3) in {
        ((x, y), z) then println(x + y + z),
    }

    // 链式条件匹配（前一段绑定供后一段使用）
    if foo() is A(x) and bar(x) is B(y) then {
        do_stuff_with(x, y)
    }
}

// ============================================================
// 结构体解构模式 (Struct Destructuring Pattern)
// ============================================================

type Point(x Int, y Int)
type Rect(origin Point, width Int, height Int)

let struct_destructuring() Void = {
    let r = Rect(Point(1, 2), 30, 40)

    // when 中解构
    when r in {
        Rect(Point(x, y), w, h) then println(x + y + w + h),
    }

    // if is 中解构
    if r is Rect(Point(x, y), _, _) then println(x + y)

    // 字段通配符
    when r in {
        Rect(_, w, h) then println(w * h),
    }

    // 字段字面量匹配
    when r in {
        Rect(Point(0, _), _, _) then println("origin at x=0"),
        Rect(Point(x, _), _, _) then println(x),
    }
}


// ============================================================
// 类型系统 (Type System)
// ============================================================

// 结构体（积类型）
type Button(width Int, height Int, label String)

// 带访问修饰符的字段
type Image(
    private width  Int,
    private height Int,
    public  source String,
)

// 可变字段
type Counter(mutable count Int)

// enum（和类型 / 枚举）
type TreeNode {
    Empty(),
    Node(value Int, left *TreeNode, right *TreeNode),
}

// 泛型 enum（ADT）
type Option[T Any] {
    Some(value T),
    None(),
}

// 类型别名
type Byte    = UInt8
type Meters  = Int
type Coord   = Point

// 泛型结构体
type Table[T Any](mutable data T)


// ============================================================
// 类型修饰符：* / *mutable / *unsafe / *unsafe mutable / ?* / ?*mutable
// ============================================================

let type_modifiers() Void = {
    // *：只读受管理引用
    // - 可通过普通 & 形成（左值或右值均可；右值会物化托管存储，产出 *T）
    // - 也可通过 box() 创建（返回 *mutable T，可隐式宽化为 *T）
    // - 成员访问自动解引用（对结构体/枚举类型）
    // - *expr 读取值，但不支持 *expr 赋值（* 是只读引用）
    let local Int = 7
    let borrowed *Int = &local    // let 绑定 → *T
    let temp_ref *Int = &42       // 右值也可形成托管 *T
    let a *Int = box(42)             // box() 返回 *mutable T，可隐式宽化为 *T
    println(*a)          // 显式解引用读取
    let point_ref *Point = box(Point(10, 20))
    println(point_ref.x)    // 对结构体做成员访问时自动解引用
    // *a = 99           // 错误：* 不支持解引用赋值

    // *mutable：可变受管理引用
    // - 可通过可变左值上的 &mutable 形成（产出 *mutable T）
    // - &mutable 仍然要求可写左值；不能直接对右值使用
    // - box() 返回 *mutable T
    // - 支持 *expr 读取和 *expr = value 赋值
    // - *mutable T 可隐式转换为 *T（丢弃写权限），反向不允许
    let mutable local2 Int = 7
    let mut_borrowed *mutable Int = &mutable local2  // let mutable 绑定 → *mutable T
    let owned *mutable Int = box(42)            // box() 返回 *mutable T
    println(*owned)      // *expr 读取
    *owned = 99          // *expr 赋值（*mutable 支持）

    // *unsafe：只读原始指针
    // - 通过 &unsafe 在可取地址存储上形成
    // - 支持 *expr 读取，但不支持 *expr 赋值
    // - 支持下标读取 p[i]，但不支持下标赋值
    // - 支持指针算术（+ / -）
    // - 支持直接字段访问 p.field，但不做隐式 pointee 方法查找
    let b *unsafe Int = &unsafe a
    let value = *b       // *expr 读取
    // *b = 99           // 错误：*unsafe 不支持 *expr 赋值
    let v0 = b[0]           // 下标读取（等价于 *(b + 0)）
    // b[1] = 200           // 错误：*unsafe 不支持下标赋值

    // *unsafe mutable：可变原始指针
    // - 可通过 &unsafe mutable 在可取地址存储上形成
    // - 支持 *expr 读取和 *expr = value 赋值
    // - 支持下标读取和下标赋值（指针偏移语义）
    // - 支持指针算术（+ / -）
    let mp *unsafe mutable Int = alloc_memory[Int](2)
    *mp = 99             // *expr 赋值
    mp[0] = 111             // 下标赋值（等价于 *(mp + 0) = 111）
    mp[1] = 222             // 下标赋值（等价于 *(mp + 1) = 222）

    // ?* / ?*mutable：弱引用（不增加引用计数）
    // ?*T 是只读弱引用，?*mutable T 是可变弱引用
    let c ?*Int = downgrade(a)                  // *T → ?*T
    let d ?*mutable Int = downgrade_mutable(owned)          // *mutable T → ?*mutable T

    // 类型注解中使用
    let f Func(*Int) Void = (x) -> println(*x)
}

// ============================================================
// 堆分配 (Heap Allocation)
// ============================================================

let heap_allocation() Void = {
    // box() 将值分配到堆上，返回 *mutable
    let r *mutable Int = box(42)
    let p *mutable Point = box(Point(10, 20))
    println(p.x)            // 成员访问自动解引用
    println(p.y)            // 另一侧字段同样可直接访问
    *r = 100             // *mutable 支持 *expr 赋值
}

// ============================================================
// ?* 弱引用
// ============================================================

let weakref_example() Void = {
    let strong *mutable Int = box(42)

    // 降级为可变弱引用（*mutable → ?*mutable）
    let weak ?*mutable Int = downgrade_mutable(strong)

    // 升级回可变强引用（?*mutable T → Option[*mutable T]）
    when upgrade_mutable(weak) in {
        .Some(r) then {
            println(*r)
            *r = 100       // *mutable 支持赋值
        },
        .None then println("expired"),
    }

    // 只读版本：*T → ?*T → Option[*T]
    let ro *Int = strong           // *mutable 隐式宽化为 *
    let ro_weak ?*Int = downgrade(ro)
    when upgrade(ro_weak) in {
        .Some(r) then println(*r),
        .None    then println("expired"),
    }
}

// ============================================================
// 指针操作 (Raw Pointer Operations)
// ============================================================

let pointer_ops() Void = {
    let p *unsafe mutable Int = alloc_memory[Int](2)  // 分配 2 个 Int 的内存，返回 *unsafe mutable

    init_memory(p, 100)           // 初始化（要求 *unsafe mutable）
    let value = *p             // 解引用读取

    let p2 = p + 1                // 指针偏移
    init_memory(p2, 200)

    *p = 999                   // 解引用赋值（*unsafe mutable 支持）

    // 下标访问（指针偏移 + 解引用）
    let v0 = p[0]                 // 等价于 *(p + 0)
    let v1 = p[1]                 // 等价于 *(p + 1)
    p[0] = 111                    // 下标赋值（*unsafe mutable 支持）
    p[1] = 222

    deinit_memory(p)              // 析构（要求 *unsafe mutable）
    deinit_memory(p2)
    dealloc_memory(p)             // 释放内存

    let np *unsafe Int = null_ptr()   // null 指针（返回 *unsafe T）
    println(p == null_ptr())
}


// ============================================================
// trait（特征 / 接口）
// ============================================================

// 基本 trait
trait Eq {
    equals(self, other Self) Bool
}

// trait 继承（单继承）
trait Ord Eq {
    compare(self, other Self) Int
}

// trait 继承（多继承，and 连接）
trait ToString {
    to_string(*self) String
}

trait PrettyPrint ToString and Eq {
    pretty(self) String
}

// 泛型 trait
trait Iterator[T Any] {
    next(*mutable self) Option[T]
}

// ============================================================
// given（实现 trait 或扩展方法）
// ============================================================

type Foo(value Int)

// 扩展方法（不实现 trait）
given Foo {
    double(self) Int = self.value * 2
}

// 实现 trait
given Foo as Eq {
    equals(self, other Foo) Bool = self.value == other.value
}

given Foo as Ord {
    compare(self, other Foo) Int = self.value - other.value
}

// 泛型 given
type Table[T Any](mutable data T)

given[T Any] Table[T] {
    set_data(*mutable self, d T) Void = {
        self.data = d
    }
}

// 泛型 given 实现 trait
given[T Eq] Table[T] as Eq {
    equals(self, other Table[T]) Bool = self.data.equals(other.data)
}

// ============================================================
// 操作符重载 (Operator Overloading)
// ============================================================

// Koral 通过 Trait 实现算术/比较类操作符重载。
// 常见映射：
// +  -> Add[R]
// -  -> Sub[R] / Neg
// *  -> Mul[R]
// /  -> Div[R]
// %  -> Rem[R]
// == / <> -> Eq
// < / > / <= / >= -> Ord
// 同方向链式顺序比较（如 a < b < c）只是上述比较操作的语法糖。
// 编译器会降成相邻两段比较，并保证单次求值与短路；它不会引入新的 Trait。
// [] / []= 是内建语义，仅支持 String / List / Deque / pointer
// 位运算与移位目前仍是内建操作，不通过公开 Trait 自定义。

type Vec2(x Int, y Int)

given Vec2 as Add[Vec2] {
    add(self, other Vec2) Vec2 = Vec2(self.x + other.x, self.y + other.y)
}

given Vec2 as Neg {
    neg(self) Vec2 = Vec2(-self.x, -self.y)
}

given Vec2 as Eq {
    equals(self, other Vec2) Bool = self.x == other.x and self.y == other.y
}

given Vec2 as Ord {
    compare(self, other Vec2) Int =
        if self.x <> other.x then self.x.compare(other.x) else self.y.compare(other.y)
}

let operator_overloading() Void = {
    let a = Vec2(1, 2)
    let b = Vec2(3, 4)

    let sum = a + b
    let flipped = -sum

    if a == b then println("same")
    if a < b then println("ordered")

    println(sum.x)
    println(flipped.y)
}

// 内建下标访问与下标赋值
let builtin_subscript() Void = {
    let mutable list = [10, 20, 30]
    println(list[0])
    list[1] = 99

    let text = "abc"
    let b UInt8 = text[1]
    println(b)

    let p *unsafe mutable Int = alloc_memory[Int](2)
    p[0] = list[0]
    p[1] = list[1]
    println(p[1])
    dealloc_memory(p)
}

// ============================================================
// trait object（特征对象，动态分发）
// ============================================================

trait Shape {
    area(*self) Float64
    reset(*mutable self) Void
}

type Circle(mutable radius Float64)
given Circle as Shape {
    area(*self) Float64 = 3.14159 * self.radius * self.radius
    reset(*mutable self) Void = {
        self.radius = 0.0
    }
}

let trait_object_example() Void = {
    // *TraitName / *mutable TraitName 类型 + box() = 动态分发
    let s *Shape = box(Circle(5.0))
    let ms *mutable Shape = box(Circle(6.0))
    println(s.area())
    ms.reset()
    println(ms.area())

    // 接受 trait * 参数的函数值
    let print_area Func(*Shape) Void = (shape *Shape) -> println(shape.area())
    print_area(s)
}


// ============================================================
// 泛型 (Generics)
// ============================================================

// 泛型函数（单约束）
let find[T Eq](list List[T], item T) Bool = {}

// 泛型函数（多约束）
let sort_and_dedup[T Eq and Ord](list List[T]) List[T] = {}

// 泛型类型实例化
let generics_usage() Void = {
    let t = Table[Int](42)      // 显式类型参数
    let t2 = Table(42)          // 推断类型参数

    add[Int](1, 2)              // 显式泛型函数调用
    add(1, 2)                   // 推断泛型函数调用
}

// ============================================================
// 泛型方法（方法级类型参数）
// ============================================================

type MyBox[T Any](value T)

given[T Any] MyBox[T] {
    // [U Any] 是方法自己的类型参数
    public transform[U Any](self, f Func(T) U) U = f(self.value)
}

let generic_method_call() Void = {
    let b = MyBox[Int](21)
    // 显式指定方法类型参数
    let result = b.transform[Int]((x) -> x * 2)
    println(result)
}

// ============================================================
// 限定方法调用（消歧义，指定 trait）
// ============================================================

trait Tag {
    value(self) Int
}

given Tag {
    // given 扩展方法（为所有实现了 Tag 的类型提供默认方法）
    plus_ten(self) Int = self.value() + 10
}

type Num(x Int)
given Num as Tag {
    value(self) Int = self.x
}

let qualified_call_example() Void = {
    let n = Num(7)
    // (obj as TraitName).method() — 实例限定调用
    println((n as Tag).plus_ten())
    // 对类型名同样可以使用限定调用形式
    println((Num as Tag).plus_ten(n))
}


// ============================================================
// or else / and then / or return（Option/Result 链式操作）
// ============================================================

let option_chaining() Void = {
    let opt = Option[Int].Some(42)
    let none = Option[Int].None()

    // or else：解包，None 时使用默认值
    let value  = opt  or else 0   // 42
    let value2 = none or else 0   // 0

    // or else + 提前返回（自定义错误处理）
    let default_option Func(Option[Int]) Int = (o Option[Int]) Int -> {
        let v = o or else { return -1 }
        return v * 2
    }

    // and then：值变换（Some 时执行，None 时透传）
    let doubled = opt and then it * 2              // Some(84)
    let chained = opt and then it + 1 and then it * 3  // Some(129)

    // and then + 自动 flatten（monadic bind）
    let safe_div Func(Int, Int) Option[Int] = (x Int, y Int) Option[Int] ->
        if y == 0 then .None() else .Some(x / y)
    let result = opt and then safe_div(it, 10)     // Option[Option[T]] -> Option[T]

    // Result 的 or else 错误传播
    let double_result Func(Result[Int]) Result[Int] = (res Result[Int]) Result[Int] -> {
        let value = res or else { return .Error(it) }
        return .Ok(value * 2)
    }
}

// ============================================================
// or return（错误传播语法糖）
// ============================================================

// or return 是 or else + 提前返回的简写形式：
//   对 Result：expr or return  等价于  expr or else { return .Error(it) }
//   对 Option：expr or return  等价于  expr or else { return .None() }
//
// 约束：
//   - Result 传播只能用在返回 Result 的函数中
//   - Option 传播只能用在返回 Option 的函数中

let read_config(path String) Result[Config] = {
    let text = read_text_file(path) or return         // Result 传播
    let parsed = parse_json(text) or return
    return .Ok(parsed)
}

let find_user(id Int) Option[User] = {
    let entry = lookup_table(id) or return            // Option 传播
    let user = entry.to_user() or return
    return .Some(user)
}

// or return + and then 组合
let doubled_value(res Result[Int]) Result[Int] = {
    let value = (res and then it * 2) or return          // 先 transform，再传播
    return .Ok(value + 1)
}

// 对比：or return vs or else
let format_file_with_or_return(path String) Result[Void] = {
    let source = read_text_file(path) or return
    let formatted = format_source(source) or return
    return write_text_file(path, formatted)
}

let format_file_with_or_else(path String) Result[Void] = {
    let source = read_text_file(path) or else { return Result[Void].Error(it) }
    let formatted = format_source(source) or else { return Result[Void].Error(it) }
    return write_text_file(path, formatted)
}

// or else 仍然用于需要自定义处理的场景
let with_custom_handling(path String) Result[String] = {
    let source = read_text_file(path) or else {
        eprintln("Warning: failed to read \(path)")
        return .Error(it)
    }
    return .Ok(source)
}

// ============================================================
// 访问修饰符 (Access Modifiers)
// ============================================================

// public：所有 package / module 可见
// protected public：同一 package 内可见
// protected：仅当前逻辑 module 内可见（顶层默认）
// private：仅当前文件可见

public  let public_fn()    Void = {}
protected public let package_fn() Void = {}
private let private_fn()   Void = {}
        let protected_fn() Void = {}  // 默认 protected

public type PublicType(
    public           x Int,   // 所有 package / module 可见
    protected public y Int,   // 同一 package 内各 module 可见
    protected        z Int,   // 仅当前 module 可见
    private          w Int,   // 仅当前文件可见
                     k Int,   // 字段默认 public
)

given PublicType {
    public           get_x(self) Int = self.x
    protected public package_helper(self) Int = self.y
    private          helper(self) Int = self.w
                     internal_op(self) Int = self.z
}


// ============================================================
// 集合字面量 (Collection Literals)
// ============================================================

let collections() Void = {
    // List（动态数组）
    let list List[Int] = [1, 2, 3, 4, 5]
    println(list[0])        // 下标访问

    // Dict（键值对）
    let dict Dict[String, Bool] = ["a": true, "b": false]
    println(dict)
}

// ============================================================
// 自定义析构 (drop)
// ============================================================

type Resource(id Int)

given Resource as Drop {
    drop(source *unsafe mutable Self) Void = {
        print("dropping resource ")
        println(source.id)
    }
}

let drop_example() Void = {
    let r = Resource(1)
    // r 在作用域结束时自动调用 drop
    // defer 在 drop 之前执行
    defer println("deferred cleanup")
}
