// ============================================================
// Koral Language Grammar Preview (illustrative, non-normative)
// Canonical grammar reference: docs/guide/grammar.bnf
//
// Sections follow the learning order used by docs/guide/document.md:
//   1. 语言基本元素 -> 2. 控制流 -> 3. 自定义类型
//   -> 4. 模式匹配 -> 5. 抽象设计 -> 6. 外部互操作
// ============================================================

// ============================================================
// 1. 语言基本元素 (Language Basics)
// ============================================================

// ------------------------------------------------------------
// 程序结构：模块导入 (Module Imports)
// ------------------------------------------------------------

// 文件合并：`./` 或 `../` 开头即文件，目标必须以 .koral 结尾（§3.1/§3.2）
using "./utils.koral";
using "./helpers.koral";
using "../shared/format.koral";

// 模块导入：specifier 是 `包名[/子路径]`；导入列表的形态（`...` 是基础集合并关闭列表）：
//   { } 空占位 / { a, b } 只带一部分 / { a as b } 逐项别名
//   { ... } 全部 / { a as b, ... } 全部加别名 / { !a, !b, ... } 全部减排除
//   （同一模块每文件只导入一次；下列各行并列展示形态写法）
using "std/io" { ... }; // 全部
using "std/io" { Reader }; // 只带一部分
using "std/io" { Reader as IoReader, Writer }; // 逐项别名
using "std/io" { }; // 空列表：占位（编辑期先占着）
using "std/os" { Config as OsConfig, ... }; // 全部加别名（重命名项写在 `...` 前）
using "std/os" { !Config, !Builder, ... }; // 全部减去排除项（排除项写在 `...` 前）
using "app/services" { run_server };

// ------------------------------------------------------------
// 构建条件声明 (Build-Conditional Declarations)
// ------------------------------------------------------------
// #if 按构建目标（os / arch）在编译期选择声明：条件是封闭语法——
// os("...") / arch("...") 用 and / or / not 与括号组合，不是表达式。
// 分支只装全局声明（可嵌套 #if / using），以 ; 结束；未选中的分支仍要
// 解析，但名字不解析、类型不检查。同名声明必须分置在 #if … else … 的
// 两侧（一侧一个），无条件声明不能与条件声明同名。

#if os("windows") then {
    let unsafe foreign "CreateFileA" create_file_a(path: *UInt8, access: UInt32): UInt32;
} else {
    let unsafe foreign "open" open_path(path: *UInt8, flags: Int32): Int32;
};

#if (os("linux") or os("macos")) and not arch("x86_64") then {
    let platform_line_end: String = "\n";
} else {
    let platform_line_end: String = "\r\n";
};

// 入口函数：无参数，返回 Int 或 Void
let main(): Int = {
    println("Hello, world!");
    return 0;
};

// ------------------------------------------------------------
// 字面量 (Literals)
// ------------------------------------------------------------

let literals(): Void = {
    // 字符串
    let s: String = "hello, world!";
    let escaped = "tab:\t newline:\n quote:\"";
    let hex_byte = "\xAB";
    let unicode = "\u{1F600}";

    // 多行字符串（三引号，缩进以 closing """ 为基准自动剥离）
    let multi = """
        hello
        world
        """;
    // multi == "hello\nworld"

    // 字符串插值
    let name = "Koral";
    let greeting = "Hello \(name), 1 + 1 = \(1 + 1)";

    // 多行字符串中的插值
    let doc = """
        Dear \(name),
        Welcome.
        """;

    // Rune（字符）字面量
    let r: Rune = 'a';
    let newline_rune = '\n';
    let unicode_rune = '\u{1F600}';

    // 整数
    let decimal: Int = 123;
    let binary: Int = 0b1010; // value: 10
    let octal: Int = 0o755; // value: 493
    let hex: Int = 0xFF; // value: 255
    let sep: Int = 1_000_000; // 下划线分隔符
    let hex_sep: Int = 0xFF_FF; // value: 65535

    // 浮点数
    let f64: Float64 = 1.23;
    let sci1: Float64 = 1e10;
    let sci2: Float64 = 2.5e-3;
    let sci3: Float64 = 1e+6;

    // Duration 后缀字面量（10s == Duration.new(seconds = 10, nanoseconds = 0)）
    let d1: Duration = 10s;
    let d2: Duration = 250ms;
    let d5: Duration = 150us;
    let d6: Duration = 42ns;
    let d_neg: Duration = -5s;

    // Pair 用构造器构造（没有 Pair 字面量）
    let p1 = Pair(1, 2);
    let p2 = Pair(true, "ok");
    let p3 = Pair(Pair(1, 2), 3); // 嵌套 Pair

    // 布尔
    let t: Bool = true;
    let f: Bool = false;

    // 类型转换（cast）
    let i32 = Int32(42);
    let f32: Float32 = Float32(3.14);
};

// ------------------------------------------------------------
// 集合字面量 (Collection Literals)
// ------------------------------------------------------------

let collections(): Void = {
    // List / Set / Dict 是 `type mutable` 共享对象，不使用写时复制
    let list: List[Int] = [1, 2, 3, 4, 5];
    let set: Set[String] = ["a", "b"];
    let dict: Dict[String, Bool] = ["a": true, "b": false];
    let empty: List[Int] = []; // 空字面量需要类型上下文
    println(list[0]);

    // 需要独立副本时显式 clone()
    let copy = list.clone();
};

// ------------------------------------------------------------
// 变量与绑定 (Variables & Bindings)
// ------------------------------------------------------------

let variables(): Void = {
    // 不可变绑定（类型推断）
    let x = 42;
    // 不可变绑定（显式类型）
    let y: Int = 42;
    // 可变绑定
    let mutable z: Int = 0;
    z = 10;
    z += 1;

    // Pair 解构绑定
    let (a, b) = Pair(1, 2); // 类型推断
    let (c: Int, d: String) = Pair(3, "hello"); // 显式类型标注
    let (mutable e, f) = Pair(10, 20); // 可变绑定
    let (_, g) = Pair(1, 2); // 丢弃第一个元素

    // 嵌套解构绑定
    let (h, (i, j)) = Pair(1, Pair(2, 3));

    // 丢弃返回值
    let _ = some_fn();
};

// ------------------------------------------------------------
// 运算符 (Operators)
// ------------------------------------------------------------

let operators(): Void = {
    // 逻辑运算符
    x and y;
    x or y;
    not x;

    // 比较运算符
    x == y; // eq
    x != y; // ne
    x > y; // gt
    x < y; // lt
    x >= y; // ge
    x <= y; // le
    1 < x < 3; // chained ascending comparison
    10 >= y > 0; // chained descending comparison
    // invalid: a < b > c
    // invalid: a < b == c

    // 算术运算符
    x + y; // add
    x - y; // sub
    x * y; // mul
    x / y; // div
    x % y; // mod
    -x; // unary minus

    // 位运算符
    x & y; // bitwise and
    x | y; // bitwise or
    x ^ y; // bitwise xor
    ~x; // bitwise not
    x << y; // left shift
    x >> y; // right shift

    // 复合赋值运算符
    x += y;
    x -= y;
    x *= y;
    x /= y;
    x %= y;
    x &= y;
    x |= y;
    x ^= y;
    x <<= y;
    x >>= y;

    // 范围运算符
    let a: Range[Int] = 1..5; // 1 <= x <= 5  (closed)
    let b: Range[Int] = 1..<5; // 1 <= x < 5   (closed-open)
    let c: Range[Int] = 1<..5; // 1 < x <= 5   (open-closed)
    let d: Range[Int] = 1<..<5; // 1 < x < 5    (open)
    let e: Range[Int] = 1...; // 1 <= x <= max (from)
    let f: Range[Int] = 1<...; // 1 < x <= max  (from-open)
    let g: Range[Int] = ...5; // min <= x <= 5 (to)
    let h: Range[Int] = ...<5; // min <= x < 5  (to-open)
    let i: Range[Int] = ...; // min <= x <= max (full)
};

// ------------------------------------------------------------
// 函数 (Functions)
// ------------------------------------------------------------

// 无参无返回值
let do_nothing(): Void = {};

// 有参有返回值
let add(x: Int, y: Int): Int = x + y;

// 显式返回类型
let mul(x: Int, y: Int): Int = x * y;

// 可变参数（`mutable` 只是让局部绑定可写，不属于签名）
let inc(mutable x: Int): Int = {
    x += 1;
    return x;
};

// 泛型函数（单约束）
let first_of[T: Any](list: List[T]): Option[T] = list.first();

// 泛型函数（多约束）
let max[T: Eq and Ord](a: T, b: T): T = if a.compare(b) >= 0 then a else b;

// 泛型函数（形状约束：mutable / foreign / sendable 是关键字，不是 trait，
// 编译器按类型自己的声明判定；可用 and 组合）
let bump[T: mutable](c: T): T = c;
let read_bytes[T: foreign](buf: List[T]): *T = buf.borrow_ptr();
let pass[T: sendable](x: T): T = x;
let pass_foreign[T: foreign and sendable](x: T): T = x;

// 函数类型
let fn_types(): Void = {
    let f: (Int, Int) -> Int = (x: Int, y: Int): Int => x + y;
    let g: (Int) -> Int = (x) => x * 2;
    let h: () -> Void = () => {};

    // 柯里化
    let add = (x: Int) => (y: Int) => x + y;
    let v = add(1)(2);

    // 作为参数传递
    let apply = (f: (Int) -> Int, x: Int): Int => f(x);
    apply((x) => x + 1, 5);
    apply((x: Int): Int => x * 2, 5);

    // 链式调用（lambda 作为参数）；惰性管线从 lazy() 进入
    some_list.lazy().filter((x) => x % 2 == 0).map((x) => x * x);
};

// 类型头表达式：括号里的类型头与裸名是同一目标
//（`(Point)(1, 2)` == `Point(1, 2)`；`(Point).origin()` == `Point.origin()`）
given Point {
    origin(): Point = Point(0, 0); // 省略 `self` 的方法即静态方法
};

let type_head_expr(): Void = {
    let p = (Point)(1, 2);
    let o = (Point).origin();
};

// ------------------------------------------------------------
// 闭包捕获 (Closure Capture)
// ------------------------------------------------------------

// 捕获只有拷贝语义：`let` 按拷贝、`type mutable` 按共享句柄。
// `let mutable` 不能被捕获——请用 Cell 携带共享可变状态。
let closures(): Void = {
    let base = 10;
    let add_base = (x) => base + x; // ok: 不可变绑定按拷贝捕获

    let xs = [1, 2];
    let pusher = () => {
        xs.push(3)
    }; // ok: `xs` 是共享句柄

    let counter = Cell(0); // ok: Cell 是 `type mutable` 的共享可变状态
    let bump = () => {
        counter.value = counter.value + 1;
        return counter.value;
    };
    // let mutable n = 0;
    // let bad = () => { n = n + 1; };    // 错误：不能捕获 let mutable
};

// ------------------------------------------------------------
// 命名字段与默认值 (Named Fields and Defaults)
// ------------------------------------------------------------

// 位置字段使用 `name: Type`，命名字段使用 `name: Type =`（带默认值写 `name: Type = 50`）。
// 声明形态唯一决定调用/匹配形态：命名字段必须带标签（`name = value`），位置字段绝不能带标签。
// 只有命名字段（带 `=`）可以声明默认值。
type Button(width: Int, height: Int = 50, label: String = "OK");

let labeled_struct(): Void = {
    let b = Button(100, height = 50, label = "OK");
    println(b.label);
};

let struct_named_defaults(): Void = {
    let b = Button(100, label = "Apply");
    println(b.height);
};

// Enum 变体同样支持标签构造：声明为命名就必须带标签
type DrawCmd {
    Line(start: Point =, end: Point =),
    Circle(center: Point =, radius: Float64 =),
};

let labeled_enum(): Void = {
    let cmd = DrawCmd.Circle(center = Point(0, 0), radius = 5.0);
    // 隐式成员表达式同样支持标签构造
    let cmd2: Option[DrawCmd] = .Some(.Line(start = Point(0, 0), end = Point(1, 1)));
    // DrawCmd.Circle(Point(0, 0), 5.0)  // 错误：'center' 必须带标签
};

// 模式匹配中的标签解构（与调用规则完全一致）
let labeled_pattern_matching(): Void = {
    let cmd = DrawCmd.Circle(center = Point(0, 0), radius = 5.0);

    // when 表达式
    when cmd in {
        .Line(start = s, end = e) then println(s.x),
        .Circle(center = c, radius = r) then println(r),
    };

    // if is
    if cmd is .Circle(center = c, radius = _) then println(c.x);

    // 结构体解构：width 是位置字段，height / label 是命名字段
    let b = Button(100, height = 50, label = "OK");
    if b is Button(w, height = _, label = l) then println(l);
};

// for 绑定是全模式（与 when 分支同一套），但必须不可失败：
// `_` / `x` / `mutable x` / 结构体 / 元组 / 嵌套解构都可以
let for_binding_shapes(): Void = {
    let pairs = [Pair(1, 2), Pair(3, 4)];
    for (left, right) in pairs then {
        println(left + right);
    };
    for p in pairs where p.first > 0 then {
        println(p.second);
    };
};

// ============================================================
// 2. 控制流 (Control Flow)
// ============================================================

let control_flow(): Void = {
    // if-then（单分支）
    if a < b then {
        {};
    };

    // if-then-else（双分支）
    let v = if true then 0 else 1;
    if a then {
        {};
    } else if b then {
        {};
    } else {
        {};
    };

    // 裸控制转移分支体：then/else 后直接写 return/break/continue
    // （单跳块 `{ … }` 的语法糖，类型 Never；不是表达式，别处不许写）
    if a then return else return;
    for x in list then return x;
    when v in {
        1 then continue,
        _ then break,
    };

    // 条件逻辑组合（左到右短路；前面绑定可供后续 and 子句使用）
    if ready() and has_permission() and feature_enabled() then run() else deny();
    if input is .Some(x) and x > 0 and validate(x) then accept(x) else reject();

    // while-then（表达式）
    while a < b then {
        {};
    };

    // while 条件逻辑组合
    while iter.next() is .Some(v) and v < 10 then println(v);

    // for-in-then（表达式）
    for item in list then println(item);
    for i in 0..10 then println(i);
    for i in 0..10 then if i % 2 == 0 then println(i);

    // 解构迭代（enumerate 返回的元素用 Pair 解构；for 绑定是全模式，但必须不可失败）
    for (first, second) in list.enumerate() then {
        println(first);
        println(second);
    };

    // return / break / continue
    let early: (Int) -> Int = (x: Int): Int => if x > 0 then 1 else 2;

    while i < 10 then {
        i += 1;
        if i == 5 then {
            continue;
        };
        if i == 8 then {
            break;
        };
    };

    // defer（LIFO 顺序，作用域退出前执行）
    let with_defer: () -> Void = () => {
        defer println("C"); // 最后执行
        defer println("B");
        defer println("A"); // 最先执行
        println("working");
        // 输出: working -> A -> B -> C
    };
};

// ------------------------------------------------------------
// block tail expression（块尾表达式）
// ------------------------------------------------------------

let value: Int = if ready() then {
    42
} else {
    0
};

let classify(score: Int): String = if score >= 90 then {
    if score == 100 then {
        "perfect"
    } else {
        "A"
    }
} else {
    "other"
};

let nested(flag: Bool): Int = if flag then {
    when input() in {
        .Some(v) then {
            v
        },
        .None() then {
            0
        },
    }
} else {
    -1
};

// ------------------------------------------------------------
// or else / and then / or return（Option/Result 链式操作）
// ------------------------------------------------------------

let option_chaining(): Void = {
    let opt = Option[Int].Some(42);
    let none = Option[Int].None();
    // 优先级：流程层内 `and then` > `or else` / `or return`；
    //         逻辑层内 `and` > `or`。
    // 两层不隐式混用，跨层必须加括号：`a and (b or else c)` 与
    // `(a and b) or else c` 都合法，`a and b or else c` 与
    // `opt and then as v in v == 1 and false` 都被拒绝。

    // or else：值合并；左侧为 None / Error 时使用默认值
    let value = opt or else 0; // 42
    let value2 = none or else 0; // 0

    // or else + 提前返回（自定义错误处理）
    let default_option: (Option[Int]) -> Int = (o: Option[Int]): Int => {
        let v = o or else {
            return -1;
        };
        return v * 2;
    };

    // and then：值变换（Some / Ok 时执行，None / Error 时透传）
    let doubled = opt and then as v in v * 2; // Some(84)
    let chained = opt and then as v in v + 1 and then as v in v * 3; // Some(129)

    // and then 接收者省略链：右侧是以 `.` 开头的后缀链，接收者是解包值
    //（`opt and then .to_string()` == `opt and then as v in v.to_string()`）
    let text = opt and then .to_string(); // Some("42")

    // 跨层的两种合法写法——括号就是分层
    let ready: Bool = true;
    let wrapped = opt and then as v in (v == 1 and false); // Option[Bool]：Some(false)
    let combined = ready and (opt and then as v in v > 0 or else false); // Bool：true

    // and then 折叠同族：变换体自身已是同一种 Option / Result 时，它的值就是结果；
    // 否则包一层
    let safe_div: (Int, Int) -> Option[Int] = (x: Int, y: Int): Option[Int] => if y == 0 then .None() else .Some(x / y);
    let result = opt and then as v in safe_div(v, 10); // Option[Int]：Some(4)

    // Result 同样支持 or else / and then；`as e in` 绑定 Error 值
    let double_result: (Result[Int]) -> Result[Int] = (res: Result[Int]): Result[Int] => {
        let value = res or else as e in {
            return .Error(e);
        };
        return .Ok(value * 2);
    };
};

// or return 是 or else + 提前返回的简写形式（脱糖时绑定用编译器内部名）：
//   对 Result：expr or return  等价于  expr or else as e in { return .Error(e); }
//   对 Option：expr or return  等价于  expr or else { return .None(); }
//
// 约束：
//   - Result 传播只能用在返回 Result 的函数中
//   - Option 传播只能用在返回 Option 的函数中

let read_config(path: String): Result[Config] = {
    let text = read_text_file(path) or return; // Result 传播
    let parsed = parse_json(text) or return;
    return .Ok(parsed);
};

let find_user(id: Int): Option[User] = {
    let entry = lookup_table(id) or return; // Option 传播
    let user = entry.to_user() or return;
    return .Some(user);
};

// or return + and then 组合
let doubled_value(res: Result[Int]): Result[Int] = {
    let value = (res and then as v in v * 2) or return; // 先 transform，再传播
    return .Ok(value + 1);
};

// 对比：or return vs or else
let format_file_with_or_return(path: String): Result[Void] = {
    let source = read_text_file(path) or return;
    let formatted = format_source(source) or return;
    return write_text_file(path, content = formatted);
};

let format_file_with_or_else(path: String): Result[Void] = {
    let source = read_text_file(path) or else as e in {
        return Result[Void].Error(e);
    };
    let formatted = format_source(source) or else as e in {
        return Result[Void].Error(e);
    };
    return write_text_file(path, content = formatted);
};

// or else 仍然用于需要自定义处理的场景
let with_custom_handling(path: String): Result[String] = {
    let source = read_text_file(path) or else as e in {
        eprintln("Warning: failed to read \(path)");
        return .Error(e);
    };
    return .Ok(source);
};

// ============================================================
// 3. 自定义类型 (Custom Types)
// ============================================================

// ------------------------------------------------------------
// type：浅层不可变的 nominal
// ------------------------------------------------------------
// 构造后字段不可修改，不能声明 `mutable` 字段。
// 没有 identity；布局由编译器决定；不承诺值语义（拷贝可以共享 backing）。

type Point(x: Int, y: Int);
type Empty();

// 带访问修饰符的字段
type Image(private width: Int, private height: Int, public source: String);

// enum（和类型 / 枚举）——同样浅层不可变，不能声明 `mutable`
type TreeNode {
    Empty(),
    Node(value: Int, left: TreeNode, right: TreeNode),
};

// 泛型 enum（ADT）
type Box3[T: Any] {
    Some(value: T),
    None(),
};

// 类型别名（不能声明 `mutable`；可以带泛型参数与约束）
type Byte = UInt8;
type Meters = Int;
type Coord = Point;
type OrdList[T: Ord] = List[T];

// ------------------------------------------------------------
// type mutable：共享可变对象
// ------------------------------------------------------------
// 有 identity：赋值与传参交出同一个对象的句柄。
// 只有显式 `mutable` 字段才能原地修改。

type mutable Counter(mutable count: Int, id: UInt);
type mutable Table[T: Any](mutable data: T);

// clone() 是 Clone trait 方法：List / Set / Dict / Deque 自带，
// 其他共享对象要给 Clone 实现后才能 clone()
given[T: Any] Table[T]: Clone {
    clone(self): Table[T] = Table[T](self.data);
};

let shared_objects(): Void = {
    let c = Counter(0, 1);
    c.count = 5; // ok：mutable 字段经共享句柄修改
    // c.id = 2;       // 错误：id 不是 mutable 字段

    let t = Table(42);
    let alias = t; // 共享同一对象
    t.data = 43;
    // alias.data == 43

    let copy = t.clone(); // 显式独立副本（clone() 是 Clone trait 方法，由 given 提供）
};

// ------------------------------------------------------------
// sendable：并发安全声明（类型修饰符槽：unsafe? sendable? mutable?）
// ------------------------------------------------------------
// 六种形态：type / type mutable（线程内）+ sendable 家族（可跨线程）：
//   type sendable                 冻结数据，浅层不可变，安全共享
//   type sendable mutable         共享修改，编译器内建对象锁
//   type unsafe sendable          开发者承诺可共享
//   type unsafe sendable mutable  开发者承诺，同步自理
// 安全形态校验每个字段（enum 校验每个 payload）；unsafe 必须伴随 sendable。
// enum 只取不可变形态（type sendable / type unsafe sendable），不带 mutable；
// type foreign / 类型别名 / type intrinsic 不能标记 sendable。

type sendable SharedPoint(x: Int, y: Int);
type sendable mutable SharedCounter(mutable hits: Int);
type unsafe sendable mutable Mutex(private handle: *UInt8);
type sendable SendShape {
    Circle(r: Float64),
    Rect(w: Float64, h: Float64),
};

// trait sendable：对象总是可跨线程；每个 given 实现必须自身 sendable
trait sendable Speak {
    speak(self): Int;
};

type sendable Robot(id: Int);

given Robot: Speak {
    speak(self): Int = self.id;
};

// sendable 函数类型：限定整个函数类型（可嵌套）；可转成普通函数类型，反向不行
let run_task(f: sendable () -> Void): Void = f();

let sendable_fn_types(): Void = {
    let worker: sendable (Int) -> Int = (x) => x * 2;
    let nested: sendable (Int) -> sendable (Int) -> Int = (x) => (y) => x + y;
    let takes: (sendable (Int) -> Int) -> Int = (f) => f(1); // 内层参数带限定
};

// ------------------------------------------------------------
// 泛型 (Generics)
// ------------------------------------------------------------

type MyBox[T: Any](value: T);

given[T: Any] MyBox[T] {
    // [U: Any] 是方法自己的类型参数
    public transform[U: Any](self, f: (T) -> U): U = f(self.value);
};

let generics_usage(): Void = {
    let t = MyBox[Int](42); // 显式类型参数
    let t2 = MyBox(42); // 推断类型参数

    // 显式指定方法类型参数
    let result = t.transform[Int]((x) => x * 2);

    first_of[Int]([1, 2]); // 显式泛型函数调用
    let ints: List[Int] = [1, 2];
    first_of(ints); // 推断泛型函数调用
};

// ------------------------------------------------------------
// 内存与资源 (Memory and Resources)
// ------------------------------------------------------------

// Drop：仅由编译器调用的析构入口，签名固定为 drop(self): Void。
// 只能由 `type mutable` 实现（值类型的清理是合成的字段释放，见文档）。
type mutable Resource(id: Int);

given Resource: Drop {
    drop(self): Void = {
        print("dropping resource ");
        println(self.id);
    };
};

let drop_example(): Void = {
    let r = Resource(1);
    // r 在作用域结束时自动调用 drop
    // defer 在 drop 之前执行
    defer println("deferred cleanup");
};

// 弱引用：?T（只对满足 `mutable` 约束的类型有效）
let weak_refs(): Void = {
    let node = Counter(0, 1);
    let weak = node as ?Counter; // ?Counter
    when ?weak in {
        .Some(c) then println(c.count),
        .None() then println("expired"),
    };
};

// ============================================================
// 4. 模式匹配 (Pattern Matching)
// ============================================================

let pattern_matching(): Void = {
    // when 表达式（穷举匹配）
    when x in {
        1 then "one",
        2 then "two",
        _ then "other",
    };

    // 分支守卫（pat where cond then body）：模式绑定在守卫里可见，
    // 守卫为假落到下一分支；带守卫的分支不贡献穷尽性覆盖。
    // `for` 的 `where` 在同一个槽位，为假则跳过该元素。
    when v in {
        .Some(n) where n > 0 then "positive",
        .Some(n) then "non-positive",
        .None() then "empty",
    };

    // 所有模式类型（主体是占位符，不绑定具体类型）
    when subject in {
        1 then {}, // 整数字面量
        -5 then {}, // 负整数字面量
        1.5 then {}, // 浮点字面量
        -2.25 then {}, // 负浮点字面量
        'a' then {}, // rune 字面量
        "abc" then {}, // 字符串字面量
        true then {}, // 布尔字面量
        (a, b) then {}, // Pair 解构模式
        ((a, b), c) then {}, // 嵌套 Pair 解构模式
        _ then {}, // 通配符
        x then {}, // 变量绑定
        mutable x then {}, // 可变变量绑定
        Foo(x, y) then {}, // 结构体解构
        Foo(...) then {}, // 结构体解构（剩余模式：整段省略，忽略每个字段）
        .Some(x) then {}, // enum case 解构
        .Some(...) then {}, // enum case 解构（剩余模式：整段省略）
        [] then {}, // 列表模式（空列表）
        [a, b] then {}, // 列表模式（长度恰好 2）
        [a, ...] then {}, // 列表模式（长度 >= 1）
        [a, ..., b] then {}, // 列表模式（首尾各一，中间忽略）
        [...] then {}, // 列表模式（任意长度，等价 _）
        > 5 then {}, // 比较模式（大于）
        < 10 then {}, // 比较模式（小于）
        >= 0 then {}, // 比较模式（大于等于）
        <= 100 then {}, // 比较模式（小于等于）
        > -5 then {}, // 比较模式（负数）
        > 1.5 then {}, // 比较模式（浮点界）
        >= 'a' then {}, // 比较模式（rune 界）
        1 or 2 then {}, // or 组合
        x and > 0 then {}, // and 组合（绑定 + 比较）
        not 0 then {}, // not 组合
    };

    // 列表模式与剩余模式
    // 无 `...` 时长度必须恰好相等；有 `...` 时已写的槽位数是长度下界。
    // `...` 只忽略槽位、不绑定，每层元素表至多一个。列表里它可以和已写的槽位
    // 并存；结构体 / 枚举变体里它必须是唯一槽位（整段省略）。
    let nums: List[Int] = [1, 2];
    when nums in {
        [] then println("empty"),
        [x] then println("one"),
        [head, ..., tail] then println("ends"),
    };

    // 数值范围匹配（and 组合比较模式）
    when num in {
        0 or 1 or 2 or 3 or 4 or 5 or 6 or 7 or 8 or 9 then println("single digit"),
        n and >= 10 and <= 99 then println("double digits"),
        n and >= 100 and <= 999 then println("triple digits"),
        _ then println("four or more digits"),
    };

    // if is（条件模式匹配）
    if op is .Some(v) then println(v);
    if a is n and n < 2 then {};
    if a is not 2 then {};

    // is 链（同一主体上的多个测试用 or is / and is 串成一个模式）
    if a is 1 or is 2 then {}; // or is：任一匹配即真
    if p is Point(_, _) and is not Point(0, 0) then {}; // and is not：收窄再排除

    // null 模式（字面量模式；字面量模式不单独穷尽，when 仍需兜底分支）
    let q: *Int = null;
    when q in {
        null then println("null"),
        _ then println("live"),
    };
    if q is not null then {};

    // trait object 的实现类型精确匹配（主体保持 trait object）
    let problem: Problem = PreviewIoError(7);
    if problem is PreviewIoError then println("io");
    if problem is io: PreviewIoError then println(io.render());

    // while is（循环模式匹配）
    let iter = list.iterator();
    while iter.next() is .Some(v) then println(v);

    // 元组解构模式（if / when）——按位置拆结构体
    if Pair(1, 2) is (a, b) then println(a + b);
    when Pair(Pair(1, 2), 3) in {
        ((x, y), z) then println(x + y + z),
    };

    // 链式条件匹配（前一段绑定供后一段使用）
    if foo() is A(x) and bar(x) is B(y) then {
        do_stuff_with(x, y);
    };
};

// 结构体解构模式 (Struct Destructuring Pattern)
type Rect(origin: Point, width: Int, height: Int);

let struct_destructuring(): Void = {
    let r = Rect(Point(1, 2), 30, 40);

    // when 中解构
    when r in {
        Rect(Point(x, y), w, h) then println(x + y + w + h),
    };

    // if is 中解构
    if r is Rect(Point(x, y), _, _) then println(x + y);

    // 字段通配符
    when r in {
        Rect(_, w, h) then println(w * h),
    };

    // 字段字面量匹配
    when r in {
        Rect(Point(0, _), _, _) then println("origin at x=0"),
        Rect(Point(x, _), _, _) then println(x),
    };
};

// ============================================================
// 5. 抽象设计 (Abstraction)
// ============================================================

// ------------------------------------------------------------
// trait（特征 / 接口）
// ------------------------------------------------------------

// 基本 trait（`self` 是唯一接收器形态）
trait Eq {
    equals(self, other: Self): Bool;
};

// trait 继承（单继承）
trait Ord: Eq {
    compare(self, other: Self): Int;
};

// trait 继承（多继承，and 连接）
trait ToString {
    to_string(self): String;
};

trait PrettyPrint: ToString and Eq {
    pretty(self): String;
};

// 泛型 trait
trait Cursor[T: Any] {
    next(self): Option[T];
};

// ------------------------------------------------------------
// given（实现 trait 或扩展方法）
// ------------------------------------------------------------

type Foo(value: Int);

// 扩展方法（不实现 trait）
given Foo {
    double(self): Int = self.value * 2;
};

// 实现 trait
given Foo: Eq {
    equals(self, other: Foo): Bool = self.value == other.value;
};

given Foo: Ord {
    compare(self, other: Foo): Int = self.value - other.value;
};

// 泛型 given
given[T: Any] Table[T] {
    set_data(self, d: T): Void = {
        self.data = d;
    };
};

// 泛型 given 实现 trait
given[T: Eq] Table[T]: Eq {
    equals(self, other: Table[T]): Bool = self.data.equals(other.data);
};

// ------------------------------------------------------------
// trait 工具方法（given Trait）
// ------------------------------------------------------------

// public trait：要求与实现的可见性随 trait 本体（省略修饰符即继承）
public trait Problem {
    render(self): String;
};

given Problem {
    describe(self): String = "problem: " + self.render();
};

type PreviewIoError(code: Int);
given PreviewIoError: Problem {
    public render(self): String = "io";
};

// ------------------------------------------------------------
// 完全限定调用（Rust 式 <Type as Trait>::method）
// ------------------------------------------------------------

trait Tag {
    value(self): Int;
};

given Tag {
    // given 扩展方法（为所有实现了 Tag 的类型提供默认方法）
    plus_ten(self): Int = self.value() + 10;
    kind(self): Int = 42;
};

type Num(x: Int);
given Num: Tag {
    value(self): Int = self.x;
};

let qualified_call_example(): Void = {
    let n = Num(7);
    // Type(TraitName).method(receiver, ...) — 完全限定调用（Rust 式）。
    // receiver 是第一个实参，因此实例方法与静态 trait 方法写法一致。
    println(Num(Tag).plus_ten(n));
    println(Num(Tag).kind(n));
    // expr(TraitName).method(...) — receiver 限定调用：receiver 是基础表达式，
    // 不再重复传入（仅实例方法）。
    println(n(Tag).plus_ten());
};

// ------------------------------------------------------------
// trait object（特征对象，动态分发）
// ------------------------------------------------------------
// 表层语法就是 trait 名本身；不需要 Object 标记 trait。

trait Shape {
    area(self): Float64;
    reset(self): Void;
};

type mutable Circle(mutable radius: Float64);
given Circle: Shape {
    area(self): Float64 = 3.14159 * self.radius * self.radius;
    reset(self): Void = {
        self.radius = 0.0;
    };
};

let trait_object_example(): Void = {
    // 赋值即形成 trait object，动态分发
    let s: Shape = Circle(5.0);
    println(s.area());
    s.reset();

    // 接受 trait object 参数的函数
    let print_area: (Shape) -> Void = (shape: Shape) => println(shape.area());
    print_area(s);

    // 实现类型精确匹配（主体保持 trait object）
    let problem: Problem = PreviewIoError(7);
    if problem is PreviewIoError then println("io exact");
    when problem in {
        io: PreviewIoError then println(io.render()),
        _ then println("other"),
    };
};

// ------------------------------------------------------------
// 操作符重载 (Operator Overloading)
// ------------------------------------------------------------
// 常见映射：
// +  -> Add[R]
// -  -> Sub[R] / Neg
// *  -> Mul[R]
// /  -> Div[R]
// %  -> Rem[R]
// == / != -> Eq
// < / > / <= / >= -> Ord
// 同方向链式顺序比较（如 a < b < c）只是上述比较操作的语法糖。
// 编译器会降成相邻两段比较，并保证单次求值与短路；它不会引入新的 Trait。
// [] / []= 是内建语义，仅支持 String / List / Deque / pointer
// 位运算与移位目前仍是内建操作，不通过公开 Trait 自定义。

type Vec2(x: Int, y: Int);

given Vec2: Add[Vec2] {
    add(self, other: Vec2): Vec2 = Vec2(self.x + other.x, self.y + other.y);
};

given Vec2: Neg {
    neg(self): Vec2 = Vec2(-self.x, -self.y);
};

given Vec2: Eq {
    equals(self, other: Vec2): Bool = self.x == other.x and self.y == other.y;
};

given Vec2: Ord {
    compare(self, other: Vec2): Int = if self.x != other.x then self.x.compare(other.x)
    else self.y.compare(other.y);
};

let operator_overloading(): Void = {
    let a = Vec2(1, 2);
    let b = Vec2(3, 4);

    let sum = a + b;
    let flipped = -sum;

    if a == b then println("same");
    if a < b then println("ordered");

    println(sum.x);
    println(flipped.y);
};

// 内建下标访问与下标赋值（List 是 `type mutable`，无需 `let mutable` 绑定）
// String / List / [N]T 的下标有边界检查，是安全操作；raw pointer 的下标是
// 未检查的 C 索引，读写都要 unsafe 块。
let builtin_subscript(): Void = {
    let list = [10, 20, 30];
    println(list[0]);
    list[1] = 99;

    let text = "abc";
    let b: UInt8 = text[1];
    println(b);

    // raw pointer 下标（未检查的 C 索引）
    let p: *mutable Int = unsafe { alloc_memory[Int](UInt(2)) };
    unsafe { p[0] = list[0]; p[1] = list[1]; };
    let v = unsafe { p[1] };
    println(v);
    unsafe { dealloc_memory(p) };
};

// ------------------------------------------------------------
// 访问修饰符 (Access Modifiers)
// ------------------------------------------------------------

// public：所有 package / module 可见
// protected：同一 package 内可见
// internal：仅当前逻辑 module 内可见（缺省值，不写）
// private：仅当前文件可见
// 习惯：缺省即 internal 不写；显式修饰符只标偏离——private 收窄、
// protected / public 放宽。

public let public_fn(): Void = {};
protected let package_fn(): Void = {};
private let file_fn(): Void = {};
let module_fn(): Void = {}; // 缺省 internal，不写

public type PublicType(
    public x: Int, // 所有 package / module 可见
    protected y: Int, // 同一 package 内各 module 可见
    private w: Int, // 仅当前文件可见
    k: Int, // 字段缺省 internal
);

given PublicType {
    public get_x(self): Int = self.x;
    protected package_helper(self): Int = self.y;
    private helper(self): Int = self.w;
    get_k(self): Int = self.k;
};

// ============================================================
// 6. 外部互操作 (External Interop)
// ============================================================

// ------------------------------------------------------------
// 指针类型 (Raw Pointer Types)
// ------------------------------------------------------------
// *T          只读 raw pointer：*expr 读取；不支持 *expr / p[i] 赋值
// *mutable T  可变 raw pointer：*expr 读写、p[i] 读写、指针算术
// *mutable T  可隐式转换为 *T，反向不允许
//
// 触碰内存的操作都要 unsafe { … } 块：*p 解引用（读写）、p[i] 未检查下标
// （读写）、p ± n 指针算术、字段投影 p.f、内存内建函数（alloc_memory 等）。
// 产生与携带指针是安全的：&x / &mutable m、null、p == null、as 重解释。

let pointer_ops(): Void = {
    let p: *mutable Int = unsafe { alloc_memory[Int](UInt(2)) }; // 分配 2 个 Int

    unsafe {
        init_memory(p, 100); // 初始化（要求 *mutable T）
        let value = *p; // 解引用读取

        let p2 = p + 1; // 指针偏移
        init_memory(p2, 200);

        *p = 999; // 解引用赋值（*mutable T 支持）

        // 下标访问（指针偏移 + 解引用）
        let v0 = p[0]; // 等价于 *(p + 0)
        let v1 = p[1]; // 等价于 *(p + 1)
        p[0] = 111; // 下标赋值（*mutable T 支持）
        p[1] = 222;

        deinit_memory(p); // 析构（要求 *mutable T）
        deinit_memory(p2);
        dealloc_memory(p); // 释放内存
    };

    // as 重解释转换（安全操作）：指针 <-> 整数地址、换指向类型、*mutable T -> *T
    let addr = p as UInt; // 指针读成整数地址
    let back = addr as *Int; // 整数地址读回指针

    let np: *Int = null; // null 指针字面量（加入 *T / *mutable T）
    println(np == null); // 指针比较是安全操作（p != null 同理）
};

// ------------------------------------------------------------
// 取址 (Address-Of)
// ------------------------------------------------------------
// & / &mutable 要求可取地址的存储；字面量和临时值会被拒绝。
// 产生指针是安全操作（危险在触碰内存的操作，见上）。

let address_of(): Void = {
    let local: Int = 7;
    let mutable m: Int = 8;

    let rp: *Int = &local; // 只读 raw pointer
    let mp: *mutable Int = &mutable m; // 可变 raw pointer

    // let bad = &42;   // 错误：raw 取址需要可取地址的存储
};

// ------------------------------------------------------------
// FFI（外部函数接口）
// ------------------------------------------------------------
// 需要链接的原生库放在 koral.json / std/koral.json 的 links 中

type foreign FILE {};
type foreign Timespec(tv_sec: Int64, tv_nsec: Int64); // 带字段的外部类型

// 外部函数：无函数体是引用（extern 链接），有函数体是 C ABI 导出。
// 签名带 raw pointer / C 函数指针的引用必须标记 `unsafe`（见 unsafe 声明）。
let unsafe foreign fopen(path: *UInt8, mode: *UInt8): *FILE;
let unsafe foreign fclose(file: *FILE): Int32;

// C 名字槽：`foreign` 后的字符串是该声明在 C 侧的名字（符号名 / 宏名）；
// 缺省时 C 名等于 Koral 名，Koral 名必须是合法 C 标识符
let unsafe foreign "strlen" c_strlen(p: *UInt8): UInt;

// 外部变量：`mutable` 选 extern 可变变量；带初值是 C 变量定义；
// 无 `mutable` 且带常量初值是 C 宏常量绑定（不产生链接符号）
let foreign mutable errno: Int32; // extern 可变变量
let unsafe foreign stdin: *UInt8; // 指针类型的 foreign 全局必须标记 unsafe
let foreign mutable counter: Int32 = 0; // C 变量定义（静态初始化）
let foreign "AF_INET6" af_inet6: Int32 = 10; // C 宏常量（带 C 名槽）

// ------------------------------------------------------------
// C 函数指针类型 (Foreign Function Types)
// ------------------------------------------------------------
// foreign (A) -> R 是裸 C 函数指针，不是 Koral 闭包：只有 let foreign 函数
// 与同型值能落入，null 可以加入（同 *T）；调用需要 unsafe 块。

let foreign abs(x: Int32): Int32;

let fn_pointer_types(): Void = {
    let f: foreign (Int32) -> Int32 = abs;
    let cb: foreign (Int32) -> Int32 = null;
};

// ------------------------------------------------------------
// 定长数组 [N]T (Fixed-Size Arrays)
// ------------------------------------------------------------
// C 布局定长数组：值语义（赋值 / 传参拷贝）。下标有边界检查，是安全操作
// （只有 *T 的下标才是未检查的 C 索引）。元素类型必须能跨 FFI 边界；
// [N]T 不能直接作 let foreign 的参数 / 返回类型（用 *T）。

let fixed_arrays(): Void = {
    let mutable a: [4]Int32 = [1, 2, 3, 4]; // 恰好 N 个元素
    let mutable z: [4]Int32 = []; // 全零缓冲
    a[2] = Int32(9); // 下标赋值（边界检查，安全）
    let p: *Int32 = &a[0]; // 元素地址（取址是安全操作）
};

// ------------------------------------------------------------
// unsafe 声明 (Unsafe Declarations)
// ------------------------------------------------------------
// 安全契约标记：调用（或访问）被标记的声明需要 unsafe 上下文。
// 标记位置：函数 / foreign / intrinsic 声明在 `let` 之后（foreign / intrinsic
// 之前）；方法与 trait 要求在可见性与名字之间。变量不能标记。
// trait 要求与实现必须携带同一标记；被标记函数的函数体不是隐式 unsafe
// 上下文——体内的不安全操作仍要写 unsafe { … }。

let unsafe first_byte(p: *UInt8): UInt8 = unsafe { *p };

type Buffer(data: *mutable UInt8);

given Buffer {
    unsafe slot_at(self, i: UInt): *mutable UInt8 = unsafe { self.data + Int(i) };
};

trait Blob {
    unsafe raw_bytes(self): *UInt8;
};

type BlobImpl(data: *UInt8);

given BlobImpl: Blob {
    unsafe raw_bytes(self): *UInt8 = self.data; // 与要求携带同一标记
};

// foreign 声明同理：签名带 raw pointer / C 函数指针的引用必须标记 unsafe
let unsafe foreign strlen(p: *UInt8): UInt;

// ------------------------------------------------------------
// 内建声明 (Intrinsic Declarations，保留给标准库)
// ------------------------------------------------------------
// intrinsic 声明编译器内建的类型与函数，只允许写在标准库源码里；普通包
// 会被拒绝（'intrinsic' declarations are only allowed in the standard library）。
// 标准库（std/primitives.koral）的写法：
//   public type intrinsic Int;
//   public let unsafe intrinsic alloc_memory[T: Any](capacity: UInt): *mutable T;
// 原始内存内建函数（alloc_memory / dealloc_memory / init_memory /
// deinit_memory / take_memory / copy_memory / move_memory / compare_memory）
// 都是 `let unsafe intrinsic`——调用它们需要 unsafe 上下文。
