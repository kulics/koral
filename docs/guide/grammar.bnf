// Koral Language Grammar (BNF)
// Updated to match current implementation (Lexer/Parser)

<program> ::= <using-decl>* <global-decl>*

// using 必须出现在其他全局声明之前

<using-decl> ::= "using" <string-literal> <import-list>? ";"

// 一种写法（§3）。specifier 是字符串，含义由它的形状决定（§3.1）：
//   "./..." 或 "../..." 开头 → 文件合并，目标必须以 .koral 结尾（§3.2）
//   其它                    → 模块导入，写法是 包名[/子路径]（§3.3）
//
// 文件合并：把目标文件的顶层定义并入当前模块。不是外部单元依赖、不是包导入、
// 不是子模块声明、不是别名机制；不允许与 <import-list> 连用（合并就是全部）。
//
// 模块导入：<import-list> 省略即「全部可见成员」；出现则不能为空（§7.4）。
// 同一模块在同一文件内只 using 一次（§7.10）。

<import-list> ::= "{" <import-item> ("," <import-item>)* ","? "}"

<import-item> ::= (<identifier> | <type-identifier>) <import-alias>?
<import-alias> ::= "as" (<identifier> | <type-identifier>)
// 别名必须与被引标识符的大小写类一致：`Reader as IoReader` 合法，
// `Reader as reader` 报 "alias must start with an uppercase letter because
// referenced identifier 'Reader' starts with uppercase"（反之亦然）。

// 说明：
// 1) using "std/io";                        导入 std/io 的全部可见成员
// 2) using "std/io" { Reader, Writer };     只带一部分
// 3) using "std/io" { Reader as IoReader }; 逐项别名（允许尾逗号）
// 4) using "./helpers.koral";               文件合并
// 5) 模块名不绑定为命名空间：导入 Reader 后写 Reader，不写 io.Reader
// 6) 包名是单段小写标识符（§2.1），子路径用 / 分隔，全程无 "."
//    manifest 里的 "." 只是记法（§5.2）——源码里主模块就写包名本身
// 7) 模块的包内名写在 koral.json 的 modules 里；源码一律写全名
// 8) `{ .. }` / `{ * }` 不再是写法：省略列表就是全部

// ============================================================================
// Global Declarations
// ============================================================================

<global-decl> ::= <access-modifier>* <let-decl>
               | <access-modifier>* <type-decl>
               | <access-modifier>* <trait-decl>
               | <given-decl>

<access-modifier> ::= "public"
                    | "file_private"
                    | "module_private"
                    | "package_private"
// 访问修饰符是唯一的**前缀**修饰符：它们说的是「谁看得见这个声明」。
// 其余限定词说的是「声明的是个什么东西」，一律紧跟关键字——也就是
// `type mutable` / `let mutable` 已经确立的那个位置。

<decl-qualifier> ::= "foreign" | "intrinsic"
// 声明的定义在哪里：在 C，或在编译器里。两者互斥，也不能重复。
// 它们排在 `mutable` 之前，因为 `mutable` 描述的是绑定：
// `let foreign mutable errno Int32;`。
// `foreign` / `intrinsic` 声明没有函数体；`given` 只接受 `intrinsic`。

// ============================================================================
// Let Declarations (Variables and Functions)
// ============================================================================

<let-decl> ::= "let" <identifier> <generic-params>? <function-signature> "=" <expression> ";"
             | "let" "mutable"? <identifier> <type-annotation>? "=" <expression> ";"
             | "let" "intrinsic" <identifier> <generic-params>? <function-signature> ";"        // body-less intrinsic function
             | "let" "foreign" <identifier> <positional-signature> ";"                          // body-less foreign function
             | "let" "foreign" "mutable"? <identifier> <type-annotation> ";"                    // body-less variable
// 说明：出现 mutable 时必须是变量声明（不可接函数参数列表）。
// 带 <decl-qualifier> 的形式没有函数体；不带的必须有。
// Global `let` bindings initialize in declaration order: a later binding may
// read an earlier one and see its final value (`let a = 1; let b = a + 1;`
// gives `b == 2`).
// intrinsic 函数支持泛型与命名参数（含默认值），只允许出现在标准库里；
// foreign 函数不支持泛型、不支持命名参数（parse 报 "Named parameters are
// not supported in foreign declarations"），也不支持函数体。
<positional-signature> ::= "(" <positional-param-list>? ")" <type-annotation>
<positional-param-list> ::= <positional-param> ("," <positional-param>)* ","?
<positional-param> ::= "mutable"? <identifier> <type-annotation>
// 说明：
// 1) foreign 变量声明必须有类型（支持 mutable）
// 2) foreign 函数不允许函数体，不支持泛型
// 3) foreign 函数不支持命名参数，所有参数必须是位置参数（无冒号）

<function-signature> ::= "(" <func-param-list>? ")" <type-annotation>
<func-param-list> ::= <func-param> ("," <func-param>)* ","?
<func-param> ::= "mutable"? <identifier> <type-annotation>                  // positional param
               | "mutable"? <identifier> ":" <type-annotation>               // named param
               | "mutable"? <identifier> ":" <type-annotation> "=" <default-value-literal>  // named param with default
// Positional params must come before named params. Enforced at function /
// method / foreign declarations, struct and enum payload field lists, and call
// arguments. `f(a: Int, b Int)` is rejected at the declaration.
// NOT yet enforced inside a pattern's argument list (`Point(y: 2, x)`) -- the
// subject is matched positionally there and no name is available to report.
// Named params must be called with labels: name: value.
// Only named params (with colon) can have default values.

<method-param-list> ::= <method-first-param> ("," <func-param>)* ","?
// After the first receiver param, remaining params follow the same positional/named rules as func-param.
<method-first-param> ::= "self"                                          // unified self receiver
                       | <func-param>
// Receiver rules:
// - self: unified self receiver (mutability follows the type declaration)
// - func-param: explicit typed parameter (not self)

<type-annotation> ::= <type>

// ============================================================================
// Type Declarations
// ============================================================================

<type-decl> ::= "type" "mutable"? <type-identifier> <generic-params>? <type-body> ";"
              | "type" "foreign" <type-identifier> <foreign-type-body> ";"
              | "type" "intrinsic" <type-identifier> ";"                // body-less (built into the compiler)
              | "type" <type-identifier> "=" <type> ";"                 // type alias
// 说明：`mutable` 仅对 struct 有效，枚举和别名不支持。
// `type foreign` 与 `type mutable` 互斥——外部类型的可变性不属于 Koral 自己的
// nominal 声明。
// 类型别名不支持泛型参数，但目标类型可以是泛型实例化类型（如 List[Int]）
// 类型别名在语义检查阶段被完全消除，后续阶段无需感知其存在
<type-body> ::= "(" <field-list>? ")"                 // struct
              | "{" <variant-list>? "}"                // enum (sum type)

<foreign-type-body> ::= "(" <field-list>? ")"    // FFI struct with fields
                      | "{" "}"                   // opaque type (empty enum, no variants)
// 说明：
// 1) `type foreign` 可以有字段（用于 FFI 结构体布局对齐），也可以用空大括号表示不透明类型
// 2) 空大括号 `{}` 表示没有变体的 enum，与普通 enum 语法一致

<field-list> ::= <field> ("," <field>)* ","?
<field> ::= <access-modifier>? "mutable"? <identifier> <type-annotation>                    // positional field
          | <access-modifier>? "mutable"? <identifier> ":" <type-annotation>                 // named field
          | <access-modifier>? "mutable"? <identifier> ":" <type-annotation> "=" <default-value-literal>  // named field with default

<variant-list> ::= <variant> ("," <variant>)* ","?
<variant> ::= <type-identifier> "(" <variant-field-list>? ")"       // 括号必写：声明位也写 `Red()`，与构造位 `.Red()`、模式位 `.Red()` 一致
<variant-field-list> ::= <variant-field> ("," <variant-field>)* ","?
<variant-field> ::= <identifier> <type-annotation>                    // positional
                  | <identifier> ":" <type-annotation>                 // named
                  | <identifier> ":" <type-annotation> "=" <default-value-literal>  // named with default

// ============================================================================
// Trait Declarations
// ============================================================================

<trait-decl> ::= "trait" <type-identifier> <generic-params>? <trait-parents>? "{" <trait-member>* "}" ";"
<trait-parents> ::= <type> ("and" <type>)*
<trait-member> ::= <access-modifier>? <identifier> <generic-params>? "(" <method-param-list>? ")" <type-annotation> ";"
// Trait method params follow the same positional/named rules as func-param.
// Named params in trait declarations must be matched by implementations.
// Default values declared in trait are the only source; implementations must not re-declare defaults.
// 说明：trait method 支持泛型参数，但不支持方法体。返回类型必须显式写出
// （与文档 "Named functions and methods must spell out the return type
// explicitly" 一致；bootstrap 会报 "Missing return type"）。

// ============================================================================
// Given Declarations (Type Implementations)
// ============================================================================

<given-decl> ::= "given" <decl-qualifier>? <generic-params>? <type> ("as" <type>)? "{" <given-member>* "}" ";"
// `given` 只接受 `intrinsic`（实现在编译器里）。`given intrinsic T { ... };`
// `given` 不接受访问修饰符（`public given ...` 是语法错误）。
<given-member> ::= <access-modifier>? <identifier> <generic-params>? "(" <method-param-list>? ")" <type-annotation> "=" <expression> ";"
                 | <access-modifier>? <identifier> <generic-params>? "(" <method-param-list>? ")" <type-annotation> ";"  // body-less, `given intrinsic` only
// Given implementations must match the trait's named/positional parameter classification.
// If the trait declares defaults, the given implementation must NOT redeclare them.
// If the trait declares no defaults, the given implementation cannot add them.
// 说明：
// 1) `given Type { members }` 为类型固有实现
// 2) `given Type as Trait { members }` 为 trait 实现
// 普通 `given` 方法必须带函数体和显式返回类型（少写返回类型会报
// "Missing return type"）；无函数体的形式只属于 `given intrinsic`。

// ============================================================================
// Generic Parameters
// ============================================================================

<generic-params> ::= "[" <generic-param-list> "]"
<generic-param-list> ::= <generic-param> ("," <generic-param>)* ","?
<generic-param> ::= <type-identifier> <trait-constraints>
<trait-constraints> ::= <trait-constraint> ("and" <trait-constraint>)*
<trait-constraint> ::= "mutable"
                     | "foreign"
                     | <type-identifier>
                     | <generic-type>
// 说明：当前 parser 约束里支持四类：
// 1) 类型种类约束关键字 `mutable`（不是 trait 名，是词法关键字）——
//    主体必须声明为 `type mutable`
// 2) 类型种类约束关键字 `foreign`（同样不是 trait 名）——主体的表示由
//    Koral 的布局自由之外决定，可以跨 FFI：内置标量、`*` 指针、
//    `type foreign` 声明，以及 std 的 `Rune`。这是**封闭集合**，由编译器判定，
//    用户声明不能认领（`type` 的布局由编译器选，不在其中）
// 3) 简单 trait 名（如 Eq）
// 4) 泛型 trait（如 Iterator[T]）
// 约束是必填的：`[T]` 报 `Type parameter 'T' requires a constraint`；
// 不加约束就写 `[T Any]`。`Any` 特殊——它**不是**一种约束，是「无约束」的写法。

// ============================================================================
// Types
// ============================================================================

<type> ::= <type-prefix>* <type-atom>

<type-atom> ::= <type-identifier>
              | <generic-type>
              | <function-type>
              | "Self"

<type-prefix> ::= "*" "mutable"?
               | "?"
// *T          — read-only pointer
// *mutable T  — mutable pointer
// ?T          — weak reference

<generic-type> ::= <type-identifier> "[" <type-list> "]"
<function-type> ::= "(" <function-type-param-list>? ")" "->" <type>
<function-type-param-list> ::= <type> ("," <type>)* ","?
// Function type: (T1, T2, TN) -> ReturnType
// The types inside parentheses are parameter types; `->` separates them from
// the return type. `->` is right-associative: `(A) -> (B) -> C` is
// `(A) -> ((B) -> C)`. A function type in a type list is self-delimiting;
// `(` in a TYPE opens a parameter list and nothing else (no grouping parens).
// Examples:
//   () -> Int           - no params, returns Int
//   (Int) -> Int        - one param, returns Int
//   (Int, Int) -> Int   - two params, returns Int
//   ((Int) -> Int) -> Int - takes a function, returns Int
// Module-prefixed type syntax is not part of the language. Import concrete
// type symbols with `using "module/path" { TypeName };`, then refer to `TypeName`
// directly.

<type-list> ::= <type> ("," <type>)* ","?

// ============================================================================
// Statements
// ============================================================================

<statement> ::= <let-statement>
              | <assignment-statement>
              | <return-statement>
              | <break-statement>
              | <continue-statement>
              | <defer-statement>
              | <expression-statement>
// Control flow (`if`, `when`, `while`, `for`) are expressions, not statements.
// They are parsed via <expression-statement> → <expression> → <prefix-expression>.
// Single-branch `if`/`when`/`while`/`for` semantically produce Void.

<let-statement> ::= "let" "mutable"? <identifier> <type-annotation>? "=" <expression> ";"
                | "let" <tuple-binding> "=" <expression> ";"

// A tuple binding destructures a STRUCT by position: `(a, b, c)` against a
// struct with exactly three fields, in declaration order. N >= 2 -- `(x)` is a
// parenthesized binding, not a tuple. A field may be discarded with `_`.
// Slots may nest: `let (a, (b, c)) = ...` destructures a field that is itself
// a struct, the same way a nested <tuple-pattern> does in `when`/`is`.
<tuple-binding> ::= "(" <binding-element> ("," <binding-element>)+ ")"
<binding-element> ::= "_"
                    | "mutable"? <identifier> <type-annotation>?
                    | <tuple-binding>

<assignment-statement> ::= <expression> <assign-op> <expression> ";"
<assign-op> ::= "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>="

<return-statement> ::= "return" <expression>? ";"
<break-statement> ::= "break" ";"
<continue-statement> ::= "continue" ";"

<defer-statement> ::= "defer" <expression> ";"
// Plain `break` exits the nearest enclosing `while`/`for` loop.

<expression-statement> ::= <expression> ";"

// ============================================================================
// Expressions
// ============================================================================

<expression> ::= <layer-operand> <layered-tail>?
// The operand is parsed first, and the operator that follows it picks the
// chain. With no operator the expression is just the operand -- one parse,
// never two. That is exactly the shape both parsers have.
//
// Everything under <layer-operand> -- comparison, range, `is`, `not` -- binds
// TIGHTER than the flow layer and the logical layer. In particular
// `a == b or else c` groups as `(a == b) or else c`, never `a == (b or else c)`.
//
// Flow operators and logical operators are TWO layers, and the layers do not
// mix implicitly: one tail is a flow tail or a logical tail, never both at the
// same level. Crossing from one layer to the other takes parentheses -- the
// way `??` refuses to sit beside `||` in the languages that have it.
//
//   `a and (b or else c)`              -- fine, and means that
//   `(a and b) or else c`              -- fine, and means something else
//   `a and b or else c`                -- refused: it means neither
//   `opt and then it == 1 and false`   -- refused
//
// The two layers are defined under "Binary Expressions" below.

// `if`, `while`, `for`, `when` are parsed as prefix expressions.
// See <prefix-expression> below. `while` / `for` evaluate to `Void` unless they terminate early with `Never` control flow.

// ============================================================================
// Control Flow Expressions (parsed as prefix expressions)
// ============================================================================

<if-expression> ::= "if" <expression> "then" <expression> ("else" <expression>)?
<while-expression> ::= "while" <expression> "then" <expression>
<for-expression> ::= "for" <match-pattern> "in" <expression> ("where" <expression>)? "then" <expression>
<when-expression> ::= "when" <expression> "in" "{" <match-arm-list> "}"
<match-arm-list> ::= <match-arm> ("," <match-arm>)* ","?
<match-arm> ::= <match-pattern> ("where" <expression>)? "then" <expression>
// 守卫（guard）：`pat where cond then body`。`when` 与 `for` 同一套：
// 都用 `in` 做间隔字，都用 `where` 做守卫，都收全模式。规则：
//   1. 守卫在 arm / 循环级，不进子模式：`a or b where c` 是 `(a or b) where c`，
//      要给分支各挂条件就写两个 arm。
//   2. 模式绑定在守卫里可见（`.Some(n) where n > 0`），守卫先于分支体求值。
//   3. 守卫必须是 Bool。
//   4. `when`：守卫为假则落到下一个 arm，绑定丢弃；**带守卫的分支不贡献
//      穷尽性覆盖**（保守规则）：`{ .Some(n) where n > 0 then a, .None() then b }`
//      仍判非穷尽。
//   5. `for`：守卫为假则跳过该元素，进入下一轮迭代（不结束循环）。位置在
//      iterable 之后、`then` 之前，与 `when` arm 里「模式之后、`then` 之前」
//      是同一个槽位。
//   6. `is` 表达式没有守卫（`x is pat` 是表达式，守卫要跟 `and`/`or`
//      拼优先级、绑定还要跨界）；要守卫就用 `when`。
//   7. 旧拼法 `if` 一律报错并指路（`Pattern guards use 'where', not 'if'`）；
//      `if` 本身仍是表达式/语句关键字。
// `for` 的绑定是全模式（与 `when` arm 同一套语法），但**必须不可失败**：
// 循环没法跳过模式拒绝的元素。`_` / `x` / `mutable x` / `Point(x, y)` /
// `(a, b)` 都不可反驳；`.Some(x)` / `42` / `?v` / `[a, b]` 会报
// `For binding cannot fail; use 'when' to match`。

// ============================================================================
// Flow layer / logical layer
// ============================================================================

// Precedence INSIDE a layer is unchanged: `and then` binds tighter than
// `or else` / `or return`, and `and` binds tighter than `or`. Both layers
// start from the same <layer-operand> -- which already includes comparison,
// so comparison binds tighter than both layers.
//
// After the operand the next operator picks the tail: `and then` / `or else` /
// `or return` continue a flow tail, `and` / `or` continue a logical tail. The
// two tails are disjoint because `then`, `else` and `return` are reserved
// words, never <layer-operand>s.

<layer-operand> ::= <not-expression>

<layered-tail> ::= <flow-tail>
                 | <logical-tail>

// Flow tail. `and then` binds tightest, then `or else` / `or return` chain
// left to right: `f() and then g(it) or else h()` is
// `(f() and then g(it)) or else h()`. `or return` is a postfix link (early
// return, no operand); `or else` takes one more <flow-operand>, which may
// itself be an `and then` chain: `x or else y and then z` is
// `x or else (y and then z)`.
<flow-tail> ::= <and-then-link>+ <flow-link>*
              | <flow-link>+
<and-then-link> ::= "and" "then" <layer-operand>
<flow-link> ::= "or" "else" <flow-operand>
              | "or" "return"
<flow-operand> ::= <layer-operand> <and-then-link>*
// "and then" is optional chaining / value transformation for Option/Result types
// "or else" is value coalescing for Option/Result types
// "or return" is early-return propagation for Option/Result types

// Logical tail. `and` binds tightest: `a or b and c` is `a or (b and c)`.
<logical-tail> ::= <and-link>+ <or-link>*
                 | <or-link>+
<and-link> ::= "and" <layer-operand>
<or-link> ::= "or" <logical-and-operand>
<logical-and-operand> ::= <layer-operand> <and-link>*

<not-expression> ::= "not" <is-expression> | <is-expression>

<is-expression> ::= <range-expression>
                  | <range-expression> <is-or-chain>
<is-or-chain>  ::= <is-and-chain> ("or" <is-and-chain>)*
<is-and-chain> ::= <is-slot> ("and" <is-slot>)*
<is-slot>      ::= "is" "not"? <primary-pattern>
// `is` 链：同一主体上的多个测试，用双词连接 `and is` / `or is` 串起来。
// 整条链是**一个模式**——`x is A or is B` 即 `x is (A or B)`——所以两侧的绑定
// 像 `when` 臂的 `or` 一样共享。`and is` 比 `or is` 紧，整条链仍坐在单独一个
// `is` 的位置上：比表达式 `and` / `or` 紧，所以
// `a is x or is y and b > 1` 是 `(a is x or is y) and (b > 1)`。
// 每个槽位是 `is` `not`? <primary-pattern>，组合子只出现在槽位**之间**。
// `and` 单独出现时是表达式算子；连接词只有在后面跟着 `is` 时才算连接词——
// 文法在这里已经约束了：`<is-and-chain>` 以 `is` 开头。

<bitwise-or-expression> ::= <bitwise-xor-expression> ("|" <bitwise-xor-expression>)*
<bitwise-xor-expression> ::= <bitwise-and-expression> ("^" <bitwise-and-expression>)*
<bitwise-and-expression> ::= <shift-expression> ("&" <shift-expression>)*

<range-expression> ::= <comparison-expression> <range-suffix>?
                     | <range-prefix>
                     | <range-prefix> <comparison-expression>

<range-suffix> ::= <closed-range-op> <comparison-expression>
                 | <open-postfix-range-op>

// 范围算符分两族，按界是否写出来分：
//   `..` 族（<closed-range-op>）-- 两端都在。连接符，严格二元，缺界即错。
//   `...` 族（<open-range-op>）-- 至少缺一端。`...` 站在缺掉的那个界的
//     位置上：`a...` / `a<...` 缺右界，`...b` / `...<b` 缺左界，`...` 两端
//     都缺（Range[T].Full()）。至多一端有界，`a...b` 是错的。
// `<` 永远夹在点与被排除的界之间，读作"点侧 < 界侧"：
//   `a<..b` 是 a 之后到 b，`a..<b` 是 a 到 b 之前，`a<...` 是 a 之后，
//   `...<b` 是 b 之前。`<...<` 不存在：无界可排。
// 词法最大吞并：`.` 处 `...<` > `...` > `..<` > `..` > `.`；
//               `<` 处 `<...` > `<..<` > `<..` < `<`。
//   所以 `....` = `...` + `.`，`<....` = `<...` + `.`，`a...b` 是 `a...`
//   后跟 `b`（错），`a<...b` 是 `a<...` 后跟 `b`（错）。
// `...` 的两个语境互不重叠：表达式位置是开区间，模式槽位是 rest 模式
// （见 <rest-pattern>），声明形参槽的变长参数仍预留给它。模式里没有 range
// 语法（range pattern 已废弃并报错），所以 `...` 在模式位置无歧义。
// **不做 spread**：变长槽类型化为 List[T] 后，调用端传列表就是摊开，运行时
// 无须再摊一次（Java/Swift 路线）；spread 只在"调用是无类型值序列"的语言里
// 是变长的另一半（JS/Python）。
<closed-range-op> ::= ".." | "..<" | "<.." | "<..<"
<open-range-op> ::= "..." | "...<" | "<..."
<open-postfix-range-op> ::= "..." | "<..."
<open-prefix-range-op> ::= "..." | "...<"
<range-prefix> ::= <open-prefix-range-op>

<comparison-expression> ::= <bitwise-or-expression> <comparison-tail>?

<comparison-tail> ::= <equality-op> <bitwise-or-expression>
                    | <ascending-chain-tail>
                    | <descending-chain-tail>

<equality-op> ::= "==" | "!="

// Ordering chains allow one or more links; a single `<` / `>` is the
// one-link case. Direction mixing (`a < b > c`) and equality chains
// (`a == b == c`) are refused at parse time.
<ascending-chain-tail> ::= <ascending-op> <bitwise-or-expression>
                           (<ascending-op> <bitwise-or-expression>)*

<descending-chain-tail> ::= <descending-op> <bitwise-or-expression>
                            (<descending-op> <bitwise-or-expression>)*

<ascending-op> ::= "<" | "<="
<descending-op> ::= ">" | ">="

<shift-expression> ::= <additive-expression> (<shift-op> <additive-expression>)*
<shift-op> ::= "<<" | ">>"

<additive-expression> ::= <multiplicative-expression> (<additive-op> <multiplicative-expression>)*
<additive-op> ::= "+" | "-"

<multiplicative-expression> ::= <prefix-expression> (<multiplicative-op> <prefix-expression>)*
<multiplicative-op> ::= "*" | "/" | "%"

// ============================================================================
// Prefix Expressions
// ============================================================================

<prefix-expression> ::= <if-expression>
                      | <while-expression>
                      | <for-expression>
                      | <when-expression>
                      | "-" <prefix-expression>
                      | "~" <prefix-expression>
                      | "?" <prefix-expression>
                      | "*" <prefix-expression>
                      | "&" "mutable"? <prefix-expression>
                      | <postfix-expression>
// Prefix operators:
// - ?expr upgrades a weak reference to Option[T]
// - *expr dereferences raw pointers
// - & expr / &mutable expr form raw pointers
// Mutability/addressability checks are semantic, not grammar-level.

// ============================================================================
// Postfix Expressions
// ============================================================================

<postfix-expression> ::= <primary-expression> <postfix-suffix>*
<postfix-suffix> ::= <call-suffix>
                   | <subscript-suffix>
                   | <member-suffix>
                   | <qualified-call-suffix>

// `(` 是两个后缀共用的起始记号，`[` 是两个共用的。文法里它们各写各的产生式，
// 但解析时是**形状归类 + 有界前看**，不是「试解析、失败就回退」：先用一次
// 有界扫描判断括号里的记号串是不是**类型形状**（只读 token 缓冲，不建树、
// 不发诊断），再按判断结果走对应产生式。与实现一一对应
// （koralc parser/core.koral:scan_type_shape_at / scan_paren_type_suffix_at，
//  parser/core_expressions.koral:parse_postfix_suffixes）。
//
//   **类型形状**（与 <type> 的文法逐条对齐）：
//     类型前缀：`?`、`*` [`mutable`]（可嵌套，如 `?* T`）
//     类型头  ：`Self`、首字母大写的标识符、`(` <type-list> `)` `->` <type>
//     类型头后可跟 `[` <type-list> `]`
//     裸 `*` **不算**类型起始：`f(*p)` 是解引用实参；只有 `*` 才是类型。
//
//   **`let` 声明的 `(`**（签名还是类型标注）：
//     括号内首 token 是类型头/类型前缀 -> 函数类型标注（变量绑定）
//        例：`let f (Int) -> Int = g`、`let h ((Int) -> Int) -> Int = g`
//     括号内首 token 是 `mutable`/小写标识符 -> 参数表（函数声明）
//        例：`let f(x Int) Int = ...`、`let inc(mutable x Int) Int = ...`
//     括号为空时看 `)` 之后：`->` 是函数类型 `() -> R`，其余是零参签名。
//     函数声明的结果类型**裸写**、不带 `->`（与 lambda 的结果类型一致）。
//
//   `(` 的归类：
//     括号内是**单个类型**且后面紧跟 `)`：
//        后面紧跟 `.method(` / `.method[` <type-list> `]` `(` ->
//           <qualified-call-suffix>（组合节点，见下）
//        否则 -> 错误：限定调用必须带方法调用；类型没有值，不能单独出现在括号里
//     其余：
//        base 是类型名 -> <type-application>（转型 / 构造）
//        其它 base     -> <call-suffix>
//   例：Num(Tag).m(n) 是限定调用；Int(x) 是把 x 转型到 Int；Point(1, 2) 是构造；
//       f(1, 2) 是调用；f(*p) 是调用（`*p` 是解引用）。
//
//   `[` 的归类：
//     括号内是 <type-list> -> 泛型实例化（由 <subscript-suffix> 承担，见下）
//     其余                 -> <subscript-suffix>
//   `[` 后若是空的 `[]`，或实参之间出现 `,`，都按错误报出，不猜测语义。
//
//   `.member[...]` 后的归类（`m[T](...)`）：
//     `[` <type-list> `]` `(` -> 泛型方法调用
//     `[` <type-list> `]`     -> 方法上的类型实参（方法不接受时报错）
//
//   **lambda 与括号表达式**共用 `(`，判据是 `=>`：
//     (params) [ReturnType] `=>` ... 是 lambda，其余是括号表达式。
//     params 是 `name [Type] (, name [Type])* ,?`；`name: Type` 是写错的
//     lambda 参数，仍按 lambda 解析并报
//     `Lambda parameters use 'name Type', not 'name: Type'`。
//     形状判类不建树，因此失败的分支不会吞掉真正该报的诊断。

<call-suffix> ::= "(" <argument-list>? ")"
<subscript-suffix> ::= "[" <expression> "]"
// Exactly ONE index. `[]` and `[a, b]` are errors, not empty or multi-index
// subscripts: there is no collection in the language that indexes by a tuple.
<member-suffix> ::= "." <identifier>

// 类型应用：`Type(expr)` 把 expr 转换到 Type，或 `Type(args)` 构造 Type 的值。
// 两者的区分是语义的（类型检查器按 Type 的种类决定），文法上同形：
//   基础类型（数值 / 指针）+ 单个位置实参 -> 显式转型（cast）
//   结构 / 枚举 + 实参列表                -> 构造（constructor）
// 带前缀的类型（* T、*mutable T、?T）在表达式开头直接写，
// 与类型标注同拼写：`* Int(p)`、`*mutable T(q)`、`?Int(r)`。
// `*` 只会是类型起始；裸 `*` 是解引用，不会歧义。
// NEVER `expr(Type)` -- 旧的后缀写法不再存在。`as` 仍然只有两个用途：
// import 别名（`using "..." { X as Y }`）和 `given Type as Trait`。
<type-application> ::= <type> "(" <argument-list> ")"

// 限定调用（组合节点）：消歧义，指定 trait。两套写法，都必须**带着方法调用**，
// 前部 `expr(Trait)` / `Type(Trait)` 不能单独存在：
//   1. Type(Trait).method(...)      -- 类型限定。实例方法的 receiver 作为第一个
//      实参传入，静态 trait 方法不传 receiver。方法级泛型参数仍写在方法名后。
//      例: Num(Tag).plus_ten(n)  /  Num(Tag).kind(n)  /  Box(Transform[Int]).apply[Out](b, f)
//   2. expr(Trait).method(...)      -- receiver 限定。receiver 就是左侧表达式，
//      方法实参里不再写 receiver。仅用于实例方法。
//      例: n(Tag).plus_ten()  /  n(Tag).kind()
// 语法上 `(` 的归类见上文：括号内是单个类型且后面紧跟 `.method(` 才是限定调用。
<qualified-call-suffix> ::= "(" <trait-ref> ")" "." <identifier> <qualified-method-tail>
<qualified-method-tail> ::= ("[" <type-list> "]")? "(" <argument-list>? ")"
<trait-ref>             ::= <type-identifier> ("[" <type-list> "]")?

<argument> ::= <identifier> ":" <expression>
             | <expression>
<argument-list> ::= <argument> ("," <argument>)* ","?
<expression-list> ::= <expression> ("," <expression>)* ","?
// Semantic rules for labeled arguments:
// - The declaration fixes the call shape: a named parameter (`name: Type`) MUST be
//   passed by label, a positional parameter (`name Type`) MUST NOT be. There is no
//   optional-label form. This applies uniformly to functions, methods and constructors,
//   and the same rule governs pattern destructuring.
// - Positional arguments must not appear after named arguments (call sites;
//   see the note on <func-param-list> for pattern argument lists).
// - Named arguments match by parameter/field name and may reorder named fields in constructors.
// - Default values are provided by named parameter / named field declarations, not by call-site fill syntax.

// ============================================================================
// Primary Expressions
// ============================================================================

<primary-expression> ::= <literal>
                       | <identifier>
                       | "self"
                       | "it"
                       | <type-application>
                       | <implicit-member-expression>
                       | <collection-literal>
                       | <block-expression>
                       | <lambda-expression>
                       | "(" <expression> ")"
// <type-application> 的类型可以带前缀，直接写在表达式开头：
//   * Int(p)  /  *mutable T(q)  /  ?Int(r)
// 裸 `*` 是解引用；`*` 开头只可能是类型应用。
// There is NO tuple/pair literal. A `Pair` is constructed with its own
// constructor (`Pair[Int, String](1, "a")`) like any other type.

// 语义规则：**类型不能单独作为表达式**。Type 本身没有可行的值，因此
// `let x = Point;`、`foo(Point)`、`Point;` 都是错误。类型名只允许出现在
// 这些位置：
//   Type(...)            -- 类型应用（转型 / 构造）
//   Type.method(...)     -- 静态方法调用
//   Type[T]              -- 泛型实例化（其后可继续 .method / (...)）
//   Type(Trait).method(...)  -- 类型限定调用
//   以及所有类型位置（标注、实参、泛型实参等）。

// Generic instantiation is handled by postfix composition:
//   TypeName[T]  → <identifier> <subscript-suffix>  (GenericInstantiation)
//   TypeName[T].method(args)  → <identifier> <subscript-suffix> <member-suffix> <call-suffix>  (StaticMethodCall)
//   TypeName.method(args)  → <identifier> <member-suffix> <call-suffix>  (StaticMethodCall)
//   make[T](1)  → <identifier> <subscript-suffix> <call-suffix>  (GenericInstantiation + Call)
//   TypeName[T](args)  → 类型应用（构造）；TypeName(expr) → 类型应用（转型 / 构造）

<collection-literal> ::= "[" "]"
                       | "[" <expression-list> ","? "]"
                       | "[" <map-entry-list> ","? "]"

<map-entry-list> ::= <map-entry> ("," <map-entry>)*
<map-entry> ::= <expression> ":" <expression>

<implicit-member-expression> ::= "." (<type-identifier> | <identifier>) "(" <argument-list>? ")"
// 隐式成员表达式：当期望类型已知时，可以省略类型名直接使用 .成员名
// 用于 enum case 构造和静态方法调用
// 即使是零字段 enum case，在表达式位置也必须写空括号，如 .None()
// 例如: .Some(42), .None(), .new(), .with_capacity(10)

<block-expression> ::= "{" <statement>* <tail-expression>? "}"
<tail-expression> ::= <expression>

<lambda-expression> ::= "(" <lambda-param-list>? ")" <type-annotation>? "=>" <expression>
<lambda-param-list> ::= <lambda-param> ("," <lambda-param>)* ","?
<lambda-param> ::= <identifier> <type-annotation>?
// Lambda expression examples (`=>` opens the body; `->` is the function-TYPE
// arrow and never introduces a lambda body):
//   () => 42                           - no params
//   (x) => x * 2                       - single param, type inferred
//   (x Int) => x * 2                   - single param with type
//   (x, y) => x + y                    - multiple params, types inferred
//   (x Int, y Int) Int => x + y        - full type annotations
//   (x) => { let y = x * 2; return y + 1 } - block body

// ============================================================================
// Patterns
// ============================================================================

<is-pattern> ::= <primary-pattern>
// `is` takes a single pattern; combinators live between the slots of an `is`
// chain (`or is` / `and is`), never inside a slot.
// (<primary-pattern> already covers <comparison-pattern>; it is not repeated
// here -- repeating it derived the same pattern two ways.)

<match-pattern> ::= <or-pattern>
// Used only by `when` arms. Logical pattern combinators remain supported here.

<or-pattern> ::= <and-pattern> ("or" <and-pattern>)*
<and-pattern> ::= <not-pattern> ("and" <not-pattern>)*
<not-pattern> ::= "not" <not-pattern>
               | <primary-pattern>

<primary-pattern> ::= "_"                                     // wildcard
                    | "-"? <integer-literal>                  // integer literal pattern (including negative)
                    | "-"? <float-literal>                    // float literal pattern (including negative)
                    | <bool-literal>                          // bool literal pattern
                    | <string-literal>                        // string literal pattern (plain literal only -- no interpolation)
                    | <rune-literal>                          // rune literal pattern
                    | <trait-object-type-binding-pattern>     // exact trait-object implementation type binding
                    | <trait-object-type-pattern>             // exact trait-object implementation type test
                    | "mutable"? <identifier>                     // variable binding
                    | <struct-pattern>                        // struct destructuring pattern
                    | <tuple-pattern>                         // positional destructuring pattern
                    | <list-pattern>                          // list destructuring pattern
                    | <comparison-pattern>                    // comparison pattern
                    | <enum-case-pattern>                    // enum case pattern

<trait-object-type-binding-pattern> ::= "mutable"? <identifier> <concrete-type-pattern>
// Binding exact trait-object implementation type pattern.
// Examples:
//   err IoError
//   mutable err IoError

<trait-object-type-pattern> ::= <concrete-type-pattern>
// Exact implementation-type pattern for trait objects only.
// Semantic rules:
// - The subject must be a trait object.
// - The target must be a concrete type, not a trait object.
// - Matching does not auto-deref to the value type.
// - The target cannot require stronger mutability than the subject.

<concrete-type-pattern> ::= <type-identifier>
                          | <type-identifier> "[" <type-list> "]"
// Generic concrete nominal type pattern, e.g. ParseError[Int].

<tuple-pattern> ::= "(" <tuple-slot> ("," <tuple-slot>)+ ")"
<tuple-slot> ::= <match-pattern>
// Positional destructuring against a STRUCT with exactly as many fields:
// `(a, b, c)` matches a three-field struct in declaration order. N >= 2 --
// `(` in pattern position opens a tuple and never groups a single pattern.
// This is how `Pair` is destructured too, since `Pair` is simply a
// two-field struct. No rest slot here: a whole-list elision is written
// `Point(...)`, and `( ... )` is the parenthesized-pattern error.

<struct-pattern> ::= <type-identifier> "(" <pattern-arg-list>? ")"
// Struct destructuring pattern: matches a struct value and destructures its fields by position.
// TypeName must refer to a struct type. The number of sub-patterns must match the number of fields.
// Sub-patterns can be any pattern (wildcard, variable binding, literal, nested struct, etc.)
// Examples:
//   Point(x, y)              - bind fields to x and y
//   Point(_, y)              - ignore first field, bind second
//   Point(0, y)              - match first field literally, bind second
//   Rect(Point(a, b), w, h)  - nested struct destructuring
//   Box(v)                   - works with generic structs (e.g., Box[Int])

<comparison-pattern> ::= <comparison-pattern-op> <comparison-pattern-value>
<comparison-pattern-op> ::= ">" | "<" | ">=" | "<="
<comparison-pattern-value> ::= "-"? <integer-literal>
                             | "-"? <float-literal>
                             | <rune-literal>
// 比较模式：> n、< n、>= n、<= n。值是字面量，且种类必须与主体的种类一致——
// 与常量模式同一条规则：能匹配什么，等于该字面量与该类型做 `==` 能否通过
// 类型检查。因此 `> 1` 不作用于浮点主体（写 `> 1.0`），`> 'a'` 不作用于整数
// 主体。具体对应：
//   整数主体   <- "-"? <integer-literal>
//   Rune 主体  <- <rune-literal>（脱糖为码点比较）
//   UInt8 主体 <- "-"? <integer-literal> 或 <rune-literal>（rune 限 ASCII）
//   Float 主体 <- "-"? <float-literal>
// 比较界允许落在主体的域外（UInt8 上的 `>= -1` 恒真），所以这里的负号不查
// 有无符号；等值模式的负数字面量仍然不能匹配无符号类型。
// 浮点字面量模式按 IEEE 等值匹配（与 `==` 一致）：NaN 不匹配任何常量模式，
// `0.0` 与 `-0.0` 互匹配；浮点常量与比较模式都不贡献穷尽性覆盖。

<enum-case-pattern> ::= "." <type-identifier> "(" <pattern-arg-list>? ")"
// 模式语法独立于构造语法；即使是零字段 enum case，模式位置也写空括号，如 .None()
<pattern-arg> ::= <identifier> ":" <match-pattern>    // named pattern argument
                | <rest-pattern>                      // rest slot -- must be the element list's only slot; ignores every field
                | <match-pattern>                      // positional pattern argument
<pattern-arg-list> ::= <pattern-arg> ("," <pattern-arg>)* ","?

<list-pattern> ::= "[" <list-slot>* "]"
<list-slot> ::= <rest-pattern>
              | <match-pattern>
// 列表解构模式，主体必须是 std 的 `List[T]`（按声明身份判定，不看拼写）。
// 每个非剩余槽位与 `T` 统一；绑定语义等同 `let name = subject[i]`。
// 长度规则：
//   无 `...`  -> 长度必须恰好等于槽位数
//   有 `...`  -> 已写的槽位数是长度下界，`...` 吞掉其余
// 例：
//   []              只匹配空列表
//   [a, b]          只匹配长度 2
//   [a, ...]        长度 >= 1，首元素绑到 a
//   [a, ..., b]     长度 >= 2，首尾各绑一个
//   [...]           任意列表（等价于 `_`）

<rest-pattern> ::= "..."
// 剩余模式。**只忽略，不绑定**——`...x` 是语法错误。语义是「忽略这些槽位」，
// 不是「把剩余槽位绑成一个列表」。出现在其它位置（整条 arm、`is` 主体、`not`
// 之下、单独的 `( ... )`）一律报错。
//
// 两套语义，按所在元素表分：
//   列表元素表        吞掉未写出的中间槽位，每层至多一个，可以和已写的槽位并存。
//   结构体 / 枚举变体 整段省略：必须是元素表的**唯一**槽位，忽略每个字段，
//                     命名字段与位置字段一视同仁。`Point(...)` 即
//                     `Point(_, _, _)`，`Button(...)` 在
//                     `type Button(w Int, h: Int)` 上同样合法。要忽略的是
//                     部分字段时逐个写 `_`，不与 `...` 并存。
// 元组模式不收剩余槽位（`( ... )` 是括号分组错误，混排报「must be the only slot」）。
//
// 穷举性：固定元数里 `...` 就是整段 `_`，不改变穷举性；列表里它让长度从
// 「恰好 k」变成「>= k」，只有当所有非剩余槽位都不可反驳时该长度才算被全覆盖。

// ============================================================================
// Literals
// ============================================================================

<literal> ::= <integer-literal>
            | <float-literal>
            | <duration-literal>
            | <string-literal>
            | <rune-literal>
            | <bool-literal>

<duration-literal> ::= <decimal-literal> <duration-suffix>
<duration-suffix> ::= "s" | "ms" | "us" | "ns"

<integer-literal> ::= <decimal-literal>
                  | <binary-literal>
                  | <octal-literal>
                  | <hex-literal>

// Digit separators: `_` may separate digits inside every digit run -- integer
// part, fractional part, exponent digits, any base (`1_000`, `1.0_0`,
// `1_0e1_0`, `0xFF_FF`). The productions below say it exactly: a separator
// sits between two digit groups, so it may NOT lead (including right after the
// `0b`/`0o`/`0x` prefix: `0x_1`), NOT trail (`1_`, `1.0_`, `1e1_`), NOT
// double (`1__0`), and NOT sit against `.` (`1_.0`). Each of those is a
// lexical error ("Invalid digit separator '_' in numeric literal"). A number
// never LEADS with `_` at all -- `_1` is an identifier -- and `1._x` is member
// access on `1`, not a float, because a fraction needs a digit right after `.`.
<decimal-literal> ::= [0-9]+ ("_" [0-9]+)*
<binary-literal> ::= "0b" [0-1]+ ("_" [0-1]+)*
<octal-literal> ::= "0o" [0-7]+ ("_" [0-7]+)*
<hex-literal> ::= "0x" [0-9a-fA-F]+ ("_" [0-9a-fA-F]+)*

<float-literal> ::= <decimal-digits> "." <decimal-digits>
                 | <decimal-digits> "e" ("+" | "-")? <decimal-digits>
                 | <decimal-digits> "." <decimal-digits> "e" ("+" | "-")? <decimal-digits>
// Only lowercase `e` opens an exponent, and only when a digit or [sign] digit
// follows it. `1exp` is therefore the integer `1` and the identifier `exp`
// (and `1e_1` is `1` and `e_1`), not a float. Base prefixes likewise accept
// only lowercase `0b` / `0o` / `0x`. `1.5.6` (two dots) is a lexical error.

<decimal-digits> ::= [0-9]+ ("_" [0-9]+)*

// One string literal with two layouts. Interpolation is optional -- a literal
// with no `\(` is an ordinary string, one with at least one is an interpolated
// string -- so there is no separate spelling and no ambiguity between two
// productions. Only `"` delimits a string; there is no raw-string form.
<string-literal> ::= '"' <single-line-string-part>* '"'
                   | '"""' "\n" <multiline-string-part>* <multiline-closing>

<single-line-string-part> ::= <escape-sequence>
                            | <interpolation>
                            | <single-line-string-char>
// Any Unicode scalar except `"`, `\` and newline.
<single-line-string-char> ::= ~["\\\n]

// Inside a multi-line string a newline is ordinary content, and so is every
// other scalar except `\`. The string ends at the first unescaped `"""`.
<multiline-string-part> ::= <escape-sequence>
                          | <interpolation>
                          | <multiline-string-char>
<multiline-string-char> ::= ~[\\]

<multiline-closing> ::= <indent-whitespace> '"""'
// The leading whitespace of the closing `"""` defines the indentation prefix
// that is stripped from every content line. Every non-empty content line must
// start with at least that prefix, otherwise the literal is rejected.
<indent-whitespace> ::= (" " | "\t")*

<interpolation> ::= "\(" <expression> ")"

// Exactly one Unicode scalar value -- `''` and `'ab'` are both errors. The
// literal's default type is `Rune`; in a context that expects `UInt8` the same
// spelling is inferred as a byte. One form, two types.
<rune-literal> ::= "'" <rune-char> "'"
// Any Unicode scalar except `'` and newline.
<rune-char> ::= <escape-sequence> | ~['\\\n]

<escape-sequence> ::= "\\" ("n" | "t" | "r" | "v" | "f" | "0" | "\\" | '"' | "'")
                    | "\\x" [0-9a-fA-F] [0-9a-fA-F]
                    | "\\u{" [0-9a-fA-F]+ "}"
// \xHH  — exactly 2 hex digits, produces a single byte (0x00–0xFF)
// \u{H…} — 1 to 6 hex digits, produces a Unicode scalar value (must be a valid Unicode scalar)
// \xHH  — exactly 2 hex digits, produces a single byte (0x00–0xFF)
// \u{H…} — 1 to 6 hex digits, produces a Unicode scalar value (must be a valid Unicode scalar)

<bool-literal> ::= "true" | "false"

// ============================================================================
// Default Value Literals (for named parameter defaults)
// ============================================================================

<default-value-literal> ::= "-"? <integer-literal>
                          | "-"? <float-literal>
                          | <bool-literal>
                          | <string-literal>
                          | <rune-literal>
                          | "[" "]"                    // empty collection (List, Set, or Dict, inferred from type)
                          | "..."                      // empty range (Range[T].Full)
// Default values are only allowed on named parameters (name: Type = value).
// Numbers may be negative (`= -1`, `= -2.5`); other defaults are positive
// literals only.
// The empty collection literal [] is resolved by type context:
//   List[T] -> List.new(), Set[T] -> Set.new(), Dict[K,V] -> Dict.new()
// The range literal ... resolves to Range[T].Full()

<identifier> ::= "_"* [a-z] [a-zA-Z0-9_]*
             | "_"+
// 说明：identifier 以小写 ASCII 字母开头，允许 _ 前缀；单独的下划线序列也合法（用于占位）。
// 保留字（见 Keywords 节）不是 identifier。

<type-identifier> ::= "_"* [A-Z] [a-zA-Z0-9_]*
// 说明：type-identifier 以大写 ASCII 字母开头，允许 _ 前缀

// ============================================================================
// Keywords
// ============================================================================

// Reserved keywords:
//   let, mutable, type, trait, given, intrinsic, foreign
//   using, self, Self, as
//   if, then, else, while, for, when, is, in, it, where
//   and, or, not
//   return, break, continue, defer
//   true, false
//   public, file_private, module_private, package_private

// ============================================================================
// Operators
// ============================================================================

// Arithmetic: + - * / %
// Comparison: == != > < >= <=
// Logical: and or not
// Bitwise: & | ^ ~ << >>
// Assignment: = += -= *= /= %= &= |= ^= <<= >>=
// Range: .. ..< <.. <..<          (closed -- both bounds written)
//        ... ...< <...            (open -- one bound elided, see <open-range-op>)
// Function type: ->   (between a type's parameter list and its return type)
// Lambda: =>          (before a lambda body)
// Early-return propagation: or return
// Value coalescing: or else
// Optional chaining: and then
// Other: . , ; : ( ) [ ] { }

// ============================================================================
// Evaluation Order (semantic, not grammar)
// ============================================================================

// Expressions evaluate STRICTLY LEFT-TO-RIGHT. Wherever operands are
// sequenced in the syntax, the source order is the evaluation order:
//
// 1. Call arguments, qualified-call receiver arguments, and constructor /
//    type-application arguments: `f(trace(1), trace(2))` runs `trace(1)`
//    before `trace(2)`.
// 2. Binary operands (`+`, `*`, `==`, `&`, `<<`, ...): the left operand is
//    fully evaluated before the right one.
// 3. `and` / `or`: the left operand is evaluated first; the right is skipped
//    when the left decides the result (short-circuit).
// 4. `and then` / `or else` / `or return`: the left operand is evaluated
//    first; the transform / default is skipped when the left decides the
//    result (short-circuit).
// 5. Collection and dict literals: elements in source order; for a dict entry
//    the key is evaluated before its value. `[trace(1): trace(2)]` runs 1
//    before 2.
// 6. Constructor fields (positional and named): in source order, not in
//    declaration order.
//
// There is no unspecified order anywhere: two operand expressions never
// interleave or reverse. Comparison chains (`a < b < c`) evaluate each
// operand at most once, left to right, short-circuiting after a failed link.

// ============================================================================
// Implicit Conversion Rules (semantic, not grammar)
// ============================================================================

// No implicit ref promotion for function/method arguments.
// No auto-deref for function/method arguments.
// Use explicit &, &mutable, and * at call sites.
// Method receiver is always `self` (unified receiver), no auto-ref or auto-deref.

// Closures are copy-only.
// `let` captures by copy, `type mutable` captures a shared handle,
// and `let mutable` bindings cannot be captured; use `Cell[T]` for shared mutable state.

// ============================================================================
// Comments
// ============================================================================

// Line comment: // text
// Block comment: /* text */

// ============================================================================
// Statement Termination
// ============================================================================

// Koral uses explicit semicolons for statement termination:
// - Every statement and declaration must end with a semicolon `;`
// - `}` is NOT a statement terminator; it is part of block/type/trait/given syntax
// - Newlines have no semantic significance
// - There is no automatic semicolon insertion (ASI)
// - Because newlines are insignificant, a single expression may span lines
//   freely. Nothing but `;` ends it.
// - `;` is the only statement terminator. Never place `;` in the middle of a
//   multi-line call chain: it ends the statement there. Write the chain as one
//   statement with a single trailing `;`.
// - `()` and `[]` are grouping structures only; they do not provide newline semantics
// - `if`, `when`, `for`, `while` used as statements must end with `;`
// - Top-level declarations (function, type, trait, given) must end with `;`
// - Block-bodied forms end with `}` which is part of the construct, not a statement terminator
