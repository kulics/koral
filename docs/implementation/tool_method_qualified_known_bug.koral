// EXPECT-ERROR: Panic: qualified to B
// 钉住已知缺陷（限定调用选错 trait 的深水区）：`Type(Trait).m(...)` 的
// 选择层已修，但 mono 共享模板的 checked 快照会被先到接收者固化——同名
// 工具的体/签名带错自型（`Box(B).describe` 仍返回 A 的值）。根因在
// MethodDeclaration 无声明级 body 回退 + 双键登记共享槽；深修后本用例
// 应翻成 tool_method_qualified_ok 里的正断言（== 2）。

trait A {
    get(self): Int;
};
trait B {
    fetch(self): Int;
};

given A {
    describe(self): Int = 1;
};
given B {
    describe(self): Int = 2;
};

type Box(x: Int);

given Box: A {
    get(self): Int = 0;
};
given Box: B {
    fetch(self): Int = 0;
};

let main(): Int = {
    let b = Box(1);
    assert(Box(B).describe(b) == 2, "qualified to B");
    return 0;
};
