let test_file_single(): TestResult = {
    let in_path = create_temp_text_file("tmp_grep_file_single.txt", "red\ngreen\nblue\n") or else {
        return fail("file_single setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep(["re", in_path], Option[String].None()) or else {
        return fail("file_single run failed");
    };
    return check(out, "red\ngreen\n", 0, "file_single");
};

let test_multi_file_prefix(): TestResult = {
    let a = create_temp_text_file("tmp_grep_multi_a.txt", "hit\n") or else {
        return fail("multi_file_prefix setup a failed");
    };
    defer cleanup_temp_file(a);
    let b = create_temp_text_file("tmp_grep_multi_b.txt", "hit\n") or else {
        return fail("multi_file_prefix setup b failed");
    };
    defer cleanup_temp_file(b);
    let out = run_grep(["hit", a, b], Option[String].None()) or else {
        return fail("multi_file_prefix run failed");
    };
    return check(out, a + ":hit\n" + b + ":hit\n", 0, "multi_file_prefix");
};

let test_bad_pattern(): TestResult = {
    let out = run_grep(["("], Option[String].None()) or else {
        return fail("bad_pattern run failed");
    };
    let r1 = assert_int(out.exit_code, 2, "bad_pattern exit");
    if r1 is .Fail(_) then {
        return r1;
    };
    return assert_true(out.stderr.contains("invalid pattern"), "bad_pattern stderr");
};

let test_missing_file(): TestResult = {
    let out = run_grep(["x", "tmp_grep_no_such_file.txt"], Option[String].None()) or else {
        return fail("missing_file run failed");
    };
    let r1 = assert_int(out.exit_code, 2, "missing_file exit");
    if r1 is .Fail(_) then {
        return r1;
    };
    return assert_true(
        out.stderr.contains("tmp_grep_no_such_file.txt"),
        "missing_file stderr",
    );
};

