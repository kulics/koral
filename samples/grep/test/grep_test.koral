let test_C_groups(): TestResult = {
    // Real line-number gap between the two matches (2 and 10) so the groups
    // are non-contiguous and GNU grep separates them with `--`.
    let in_path = create_temp_text_file(
        "tmp_grep_C.txt",
        "a\nhit\nb\nc\nd\ne\nf\ng\nh\nhit\ni\n",
    ) or else {
        return fail("C_groups setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep(["-C", "1", "hit"], Option[String].Some(in_path)) or else {
        return fail("C_groups run failed");
    };
    return check(out, "a\nhit\nb\n--\nh\nhit\ni\n", 0, "C_groups");
};

let test_m_flag(): TestResult = {
    let in_path = create_temp_text_file("tmp_grep_m.txt", "a\na\na\n") or else {
        return fail("m_flag setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep(["-m", "2", "a"], Option[String].Some(in_path)) or else {
        return fail("m_flag run failed");
    };
    return check(out, "a\na\n", 0, "m_flag");
};

let test_q_flag(): TestResult = {
    let in_path = create_temp_text_file("tmp_grep_q.txt", "a\n") or else {
        return fail("q_flag setup failed");
    };
    defer cleanup_temp_file(in_path);
    let hit = run_grep(["-q", "a"], Option[String].Some(in_path)) or else {
        return fail("q_flag hit run failed");
    };
    let r1 = check(hit, "", 0, "q_flag hit");
    if r1 is .Fail(_) then {
        return r1;
    };
    let miss = run_grep(["-q", "z"], Option[String].Some(in_path)) or else {
        return fail("q_flag miss run failed");
    };
    return check(miss, "", 1, "q_flag miss");
};

let test_r_flag(): TestResult = {
    let base = "tmp_grep_r_dir";
    create_dir_all(base.into_path().join("sub")) or else {
        return fail("r_flag setup dir failed");
    };
    defer {
        let _ = remove_dir_all(base.into_path());
    };
    let _ = write_text_file(base.into_path().join("a.txt"), content = "hit\n") or else {
        return fail("r_flag setup a failed");
    };
    let _ = write_text_file(base.into_path().join("sub/b.txt"), content = "x\nhit\n") or else {
        return fail("r_flag setup b failed");
    };
    let out = run_grep(["-r", "hit", base], Option[String].None()) or else {
        return fail("r_flag run failed");
    };
    if out.exit_code != 0 then {
        return fail("r_flag exit");
    };
    let norm = normalize_paths(out.stdout);
    let e1 = normalize_paths(base.into_path().join("a.txt").to_string());
    let e2 = normalize_paths(base.into_path().join("sub/b.txt").to_string());
    let r1 = assert_true(norm.contains(e1 + ":hit"), "r_flag entry a");
    if r1 is .Fail(_) then {
        return r1;
    };
    return assert_true(norm.contains(e2 + ":hit"), "r_flag entry b");
};

// ----------------------------------------------------------------------------
// Runner
// ----------------------------------------------------------------------------

let run_case(name: String, r: TestResult): TestCase = {
    print("- ");
    print(name);
    print(" ... ");
    when r in {
        .Pass() then println("ok"),
        .Fail(msg) then {
            println("FAIL");
            println(msg);
        },
    };
    return TestCase(name, r);
};

let main(): Void = {
    println("grep tests:");
    let mutable cases = List[TestCase].new();
    cases.push(run_case("stdin_match", test_stdin_match()));
    cases.push(run_case("stdin_anchor", test_stdin_anchor()));
    cases.push(run_case("stdin_ere", test_stdin_ere()));
    cases.push(run_case("stdin_no_match", test_stdin_no_match()));
    cases.push(run_case("stdin_no_trailing_newline", test_stdin_no_trailing_newline()));
    cases.push(run_case("file_single", test_file_single()));
    cases.push(run_case("multi_file_prefix", test_multi_file_prefix()));
    cases.push(run_case("bad_pattern", test_bad_pattern()));
    cases.push(run_case("missing_file", test_missing_file()));
    cases.push(run_case("n_flag", test_n_flag()));
    cases.push(run_case("i_flag", test_i_flag()));
    cases.push(run_case("v_flag", test_v_flag()));
    cases.push(run_case("c_flag", test_c_flag()));
    cases.push(run_case("c_no_match", test_c_no_match()));
    cases.push(run_case("c_multi", test_c_multi()));
    cases.push(run_case("l_flag", test_l_flag()));
    cases.push(run_case("L_flag", test_L_flag()));
    cases.push(run_case("h_flag", test_h_flag()));
    cases.push(run_case("e_multi", test_e_multi()));
    cases.push(run_case("f_flag", test_f_flag()));
    cases.push(run_case("cluster", test_cluster()));
    cases.push(run_case("no_pattern", test_no_pattern()));
    cases.push(run_case("x_flag", test_x_flag()));
    cases.push(run_case("w_flag", test_w_flag()));
    cases.push(run_case("o_flag", test_o_flag()));
    cases.push(run_case("A_flag", test_A_flag()));
    cases.push(run_case("B_flag", test_B_flag()));
    cases.push(run_case("C_groups", test_C_groups()));
    cases.push(run_case("m_flag", test_m_flag()));
    cases.push(run_case("q_flag", test_q_flag()));
    cases.push(run_case("r_flag", test_r_flag()));

    let mutable failed = 0;
    for c in cases then {
        if c.result is .Fail(_) then {
            failed += 1;
        };
    };
    println("");
    if failed == 0 then {
        println("all grep tests passed");
    } else {
        println("\(failed) grep tests failed");
        exit(1);
    };
};
