// grep_test.koral: single-entry test runner for grep (unit + golden tests).
// Run from the repository root:
//   koralc build samples/grep/src/grep.koral -o bin/samples
//   koralc run samples/grep/test/grep_test.koral
// Assumes the grep binary is built to bin/samples/grep(.exe).
// Golden reference: `grep -E` semantics (patterns are POSIX ERE), embedded as
// expected strings derived from `grep -E` output.

using "std" { ... };
using "std/io" { ... };
using "std/os" { ... };
using "std/proc" { ... };

type TestResult {
    Pass(),
    Fail(message: String),
};

type TestCase(name: String, result: TestResult);

type ProcessOutput(stdout: String, stderr: String, exit_code: Int);

let pass(): TestResult = TestResult.Pass();
let fail(msg: String): TestResult = TestResult.Fail(msg);

let create_temp_text_file(name: String, content: String): Result[String] = {
    let path = name.into_path();
    write_text_file(path, content = content) or return;
    return Result[String].Ok(name);
};

let cleanup_temp_file(path: String): Void = {
    let _ = remove_file(path.into_path());
};

/// Run grep with optional stdin fed from a text file (IoRedirect.File).
let run_grep(args: List[String], stdin_file: Option[String]): Result[ProcessOutput] = {
    let grep_bin = if env("OS") is .Some(os) and os.contains("Windows") then "bin/samples/grep.exe"
    else "bin/samples/grep";
    let mutable cmd = Command.new(grep_bin).args(args).set_stdin(IoRedirect.Null());
    when stdin_file in {
        .Some(path) then {
            let f = open_file(path.into_path(), OpenMode.Read()) or return;
            cmd = Command.new(grep_bin).args(args).set_stdin(IoRedirect.File(f));
        },
        .None() then {},
    };
    let out = cmd.run_output() or return;
    let exit_code = out.status.code() or else 0;
    return Result[ProcessOutput].Ok(ProcessOutput(out.stdout, out.stderr, exit_code));
};

let assert_eq(actual: String, expected: String, msg: String): TestResult = {
    if actual == expected then {
        return pass();
    };
    let mutable m = StringBuilder.new();
    m.push_string(msg);
    m.push_string(" | expected=");
    m.push_string(expected);
    m.push_string(" | actual=");
    m.push_string(actual);
    return fail(m.to_string());
};

let assert_int(actual: Int, expected: Int, msg: String): TestResult = {
    if actual == expected then {
        return pass();
    };
    return fail(
        msg + " | expected=" + expected.to_string() + " actual=" + actual.to_string(),
    );
};

let assert_true(ok: Bool, msg: String): TestResult = {
    return if ok then pass() else fail(msg);
};

let normalize_newlines(s: String): String = {
    return s.replace_all("\r\n", with = "\n");
};

let normalize_paths(s: String): String = {
    return normalize_newlines(s).replace_all("\\", with = "/");
};

/// Check stdout + exit code against one golden pair.
let check(
    out: ProcessOutput,
    expected_stdout: String,
    expected_exit: Int,
    msg: String,
): TestResult = {
    let r1 = assert_eq(normalize_newlines(out.stdout), expected_stdout, msg + " output");
    if r1 is .Fail(_) then {
        return r1;
    };
    return assert_int(out.exit_code, expected_exit, msg + " exit");
};

// ----------------------------------------------------------------------------
// Cases: matching and streams
// ----------------------------------------------------------------------------

let test_stdin_match(): TestResult = {
    let in_path = create_temp_text_file(
        "tmp_grep_in_match.txt",
        "apple\nbanana\ncherry\n",
    ) or else {
        return fail("stdin_match setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep(["an"], Option[String].Some(in_path)) or else {
        return fail("stdin_match run failed");
    };
    return check(out, "banana\n", 0, "stdin_match");
};

let test_stdin_anchor(): TestResult = {
    let in_path = create_temp_text_file("tmp_grep_in_anchor.txt", "apple\nbanana\n") or else {
        return fail("stdin_anchor setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep(["^b"], Option[String].Some(in_path)) or else {
        return fail("stdin_anchor run failed");
    };
    return check(out, "banana\n", 0, "stdin_anchor");
};

