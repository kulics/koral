// sha256sum.koral: SHA-256 checksum tool (FIPS 180-4).
//
// Build:  bin/compiler/koralc build samples/sha256sum/src/sha256sum.koral -o bin/sample-sha256sum
// Test:   bin/compiler/koralc run samples/sha256sum/test/sha256sum_test.koral -o .
//
// Golden reference: the FIPS 180-4 test vectors, asserted in test/sha256sum_test.koral.
//
// Scope note: file arguments only. Reading standard input needs stdin shaped as a
// `Reader`, and none exists — `scanln()` is the only stdin path and it is
// line-oriented text, which cannot carry binary files. Until that capability lands,
// refusing to hash stdin is correct; a text-only stand-in would silently give the
// wrong digest for every binary input.

using "std/os" { ... };
using "std/io" { ... };
using "std/hex" { ... };

// ============================================================================
// SHA-256 core (FIPS 180-4)
// ============================================================================
// Every 32-bit step wraps modulo 2^32, so all accumulation goes through
// `wrapping_add`. Plain `+` would panic on the first overflow.

/// The 64 round constants K[0..63].
///
/// Shared by every hasher: read-only after init, so one table serves them all.
/// `List` is `type mutable`, so nothing in the type system forbids a write --
/// the guard is `file_private` plus this file never touching it again.
file_private let round_constants List[UInt32] = [
    0x428a2f98,
    0x71374491,
    0xb5c0fbcf,
    0xe9b5dba5,
    0x3956c25b,
    0x59f111f1,
    0x923f82a4,
    0xab1c5ed5,
    0xd807aa98,
    0x12835b01,
    0x243185be,
    0x550c7dc3,
    0x72be5d74,
    0x80deb1fe,
    0x9bdc06a7,
    0xc19bf174,
    0xe49b69c1,
    0xefbe4786,
    0x0fc19dc6,
    0x240ca1cc,
    0x2de92c6f,
    0x4a7484aa,
    0x5cb0a9dc,
    0x76f988da,
    0x983e5152,
    0xa831c66d,
    0xb00327c8,
    0xbf597fc7,
    0xc6e00bf3,
    0xd5a79147,
    0x06ca6351,
    0x14292967,
    0x27b70a85,
    0x2e1b2138,
    0x4d2c6dfc,
    0x53380d13,
    0x650a7354,
    0x766a0abb,
    0x81c2c92e,
    0x92722c85,
    0xa2bfe8a1,
    0xa81a664b,
    0xc24b8b70,
    0xc76c51a3,
    0xd192e819,
    0xd6990624,
    0xf40e3585,
    0x106aa070,
    0x19a4c116,
    0x1e376c08,
    0x2748774c,
    0x34b0bcb5,
    0x391c0cb3,
    0x4ed8aa4a,
    0x5b9cca4f,
    0x682e6ff3,
    0x748f82ee,
    0x78a5636f,
    0x84c87814,
    0x8cc70208,
    0x90befffa,
    0xa4506ceb,
    0xbef9a3f7,
    0xc67178f2,
];

/// The eight initial hash values H[0..7].
///
/// A template, not a shared state: `compress_block` updates `state` in place,
/// so every hasher starts from its own copy (`initial_state.clone()`).
file_private let initial_state List[UInt32] = [
    0x6a09e667,
    0xbb67ae85,
    0x3c6ef372,
    0xa54ff53a,
    0x510e527f,
    0x9b05688c,
    0x1f83d9ab,
    0x5be0cd19,
];

/// The SHA-256 streaming hasher. Feed bytes with `update`, then ask for `digest`.
type mutable Sha256(
    mutable state List[UInt32],
    mutable pending List[UInt8],
    mutable total UInt64,
);

given Sha256 {

    public new() Sha256 = Sha256(initial_state.clone(), List[UInt8].new(), 0);

    /// Compress one 64-byte block starting at `offset` into `block`.
    ///
    /// `state` is the running H[0..7] and is updated in place.
    file_private compress_block(self, block List[UInt8], offset UInt) Void = {
        // W[0..15]: the block as 16 big-endian 32-bit words.
        let mutable w = List[UInt32].with_capacity(64);
        let mutable i UInt = 0;
        while i < 16 then {
            let b = offset + i * 4;
            let b0 = UInt32(block[b]) << 24;
            let b1 = UInt32(block[b + 1]) << 16;
            let b2 = UInt32(block[b + 2]) << 8;
            let b3 = UInt32(block[b + 3]);
            w.push(b0 | b1 | b2 | b3);
            i += 1;
        };

        // W[16..63]: the message schedule.
        while i < 64 then {
            let w15 = w[i - 15];
            let w2 = w[i - 2];
            let s0 = w15.rotate_right(7) ^ w15.rotate_right(18) ^ (w15 >> 3);
            let s1 = w2.rotate_right(17) ^ w2.rotate_right(19) ^ (w2 >> 10);
            w.push(w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1));
            i += 1;
        };

        let mutable a = self.state[0];
        let mutable b = self.state[1];
        let mutable c = self.state[2];
        let mutable d = self.state[3];
        let mutable e = self.state[4];
        let mutable f = self.state[5];
        let mutable g = self.state[6];
        let mutable h = self.state[7];

        i = 0;
        while i < 64 then {
            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            let ch = (e & f) ^ ((~e) & g);
            let temp1 = h.wrapping_add(s1).wrapping_add(ch).wrapping_add(round_constants[i]).wrapping_add(
                w[i],
            );
            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let temp2 = s0.wrapping_add(maj);

            h = g;
            g = f;
            f = e;
            e = d.wrapping_add(temp1);
            d = c;
            c = b;
            b = a;
            a = temp1.wrapping_add(temp2);

            i += 1;
        };

        self.state[0] = self.state[0].wrapping_add(a);
        self.state[1] = self.state[1].wrapping_add(b);
        self.state[2] = self.state[2].wrapping_add(c);
        self.state[3] = self.state[3].wrapping_add(d);
        self.state[4] = self.state[4].wrapping_add(e);
        self.state[5] = self.state[5].wrapping_add(f);
        self.state[6] = self.state[6].wrapping_add(g);
        self.state[7] = self.state[7].wrapping_add(h);
    };

    /// Absorb bytes. Any whole block is compressed immediately; the tail is
    /// held in `pending` until the next call or `digest`.
    public update(self, bytes List[UInt8], span: Range[UInt] = ...) Void = {
        let spec = bytes.slice_spec(span);
        let start = spec.start();
        let end = spec.end();
        let mutable i = start;
        while i < end then {
            self.pending.push(bytes[i]);
            self.total += 1;
            if self.pending.count() == 64 then {
                self.compress_block(self.pending, 0);
                self.pending.clear();
            };
            i += 1;
        };
    };

    /// Finish the digest: FIPS 180-4 padding, then the final block(s).
    /// Returns the 32-byte hash.
    public digest(self) List[UInt8] = {
        let bit_len = self.total * 8;

        // 0x80, then zeros until the length field fits in the last 8 bytes.
        let mutable pad = List[UInt8].new();
        pad.push(0x80);
        while (self.pending.count() + pad.count()) % 64 != 56 then {
            pad.push(0);
        };
        // Each byte is taken explicitly, high byte first. `wrapping_cast` is
        // the unchecked truncation -- a checked `UInt8(...)` would panic on any
        // shifted value still wider than a byte.
        pad.push((bit_len >> 56).wrapping_cast[UInt8]());
        pad.push((bit_len >> 48).wrapping_cast[UInt8]());
        pad.push((bit_len >> 40).wrapping_cast[UInt8]());
        pad.push((bit_len >> 32).wrapping_cast[UInt8]());
        pad.push((bit_len >> 24).wrapping_cast[UInt8]());
        pad.push((bit_len >> 16).wrapping_cast[UInt8]());
        pad.push((bit_len >> 8).wrapping_cast[UInt8]());
        pad.push(bit_len.wrapping_cast[UInt8]());

        self.update(pad);

        // The padding always lands on a block boundary, so nothing is pending.
        let mutable out = List[UInt8].with_capacity(32);
        let mutable i UInt = 0;
        while i < 8 then {
            let word = self.state[i];
            out.push((word >> 24).wrapping_cast[UInt8]());
            out.push((word >> 16).wrapping_cast[UInt8]());
            out.push((word >> 8).wrapping_cast[UInt8]());
            out.push(word.wrapping_cast[UInt8]());
            i += 1;
        };
        return out;
    };
};

// ============================================================================
// Hashing a file
// ============================================================================

/// Stream a file through SHA-256 one chunk at a time. The whole file is never
/// held in memory — that is the point of the streaming hasher.
file_private let hash_file(path String) Result[List[UInt8]] = {
    let file = open_file(path.into_path(), OpenMode.Read()) or else as e in {
        return Result[List[UInt8]].Error("cannot open `\(path)`: \(e.message())");
    };

    let hasher = Sha256.new();
    let buf = make_bytes(8192);

    while true then {
        let n = file.read(into: buf) or else as e in {
            return Result[List[UInt8]].Error("cannot read `\(path)`: \(e.message())");
        };
        if n == 0 then {
            break;
        };
        hasher.update(buf, span: 0..<(UInt(n)));
    };

    return Result[List[UInt8]].Ok(hasher.digest());
};

// ============================================================================
// Help and Version
// ============================================================================

file_private let show_help() Void = {
    let help = """
        Usage: sha256sum FILE...
        Print SHA-256 (FIPS 180-4) checksums of each FILE.

        Output format: <checksum>  <file>

        Options:
          -h, --help       show this help text
          -v, --version    show version information

        Standard input is not supported yet: reading it needs stdin shaped as a
        Reader, and the only stdin path today is line-oriented text.
        """;
    println(help);
};

file_private let show_version() Void = {
    println("koral-sha256sum 1.0.0");
};

// ============================================================================
// Entry
// ============================================================================

public let main() Int = {
    let argv = args();

    let mutable files = List[String].new();
    let mutable i UInt = 1;
    while i < argv.count() then {
        let arg = argv[i];
        when arg in {
            "-h" or "--help" then {
                show_help();
                return 0;
            },
            "-v" or "--version" then {
                show_version();
                return 0;
            },
            // `-` alone is the stdin sentinel; anything else dashed is an option.
            _ where arg.starts_with("-") and arg != "-" then {
                eprintln("sha256sum: unrecognized option `\(arg)`");
                eprintln("Try `sha256sum --help` for more information.");
                return 2;
            },
            _ then {
                files.push(arg);
            },
        };
        i += 1;
    };

    if files is [] then {
        eprintln("sha256sum: missing operand");
        eprintln("Standard input is not supported yet; name a FILE.");
        eprintln("Try `sha256sum --help` for more information.");
        return 2;
    };

    let mutable had_error = false;
    for file in files then {
        let digest = hash_file(file) or else as e in {
            eprintln("sha256sum: \(e.message())");
            had_error = true;
            continue;
        };

        // GNU coreutils prints two spaces between the digest and a text-mode
        // file name; the tests assert on that exact shape.
        let mutable line = StringBuilder.new();
        line.push_string(encode_hex(digest));
        line.push_string("  ");
        line.push_string(file);
        println(line.to_string());
    };

    return if had_error then 1 else 0;
};
