// grep_j_test.koral: single-entry test runner for grep-j (unit + golden tests).
// Run from the repository root:
//   koralc build samples/grep-j/src/grep_j.koral -o bin/samples
//   koralc run samples/grep-j/test/grep_j_test.koral
// Assumes the grep-j binary is built to bin/samples/grep_j(.exe).
// Golden reference: `grep -F` semantics (patterns are fixed strings), embedded
// as expected strings derived from `grep -F` output. The parallel cases pin
// the sample's invariant: `-j N` output is byte-identical to `-j 1`.

using "std" { ... };
using "std/io" { ... };
using "std/os" { ... };
using "std/proc" { ... };

type TestResult {
    Pass(),
    Fail(message: String),
};

type TestCase(name: String, result: TestResult);

type ProcessOutput(stdout: String, stderr: String, exit_code: Int);

let pass(): TestResult = TestResult.Pass();
let fail(msg: String): TestResult = TestResult.Fail(msg);

let create_temp_text_file(name: String, content: String): Result[String] = {
    let path = name.to_path();
    write_text_file(path, content = content) or return;
    return Result[String].Ok(name);
};

let cleanup_temp_file(path: String): Void = {
    let _ = remove_file(path.to_path());
};

/// Run grep-j with optional stdin fed from a text file (IoRedirect.File).
let run_grep_j(args: List[String], stdin_file: Option[String]): Result[ProcessOutput] = {
    let grep_bin = if env("OS") is .Some(os) and os.contains("Windows") then "bin/samples/grep_j.exe"
    else "bin/samples/grep_j";
    let mutable cmd = Command.new(grep_bin).args(args).set_stdin(IoRedirect.Null());
    when stdin_file in {
        .Some(path) then {
            let f = open_file(path.to_path(), OpenMode.Read()) or return;
            cmd = Command.new(grep_bin).args(args).set_stdin(IoRedirect.File(f));
        },
        .None() then {},
    };
    let out = cmd.run_output() or return;
    let exit_code = out.status.code() or else 0;
    return Result[ProcessOutput].Ok(ProcessOutput(out.stdout, out.stderr, exit_code));
};

let assert_eq(actual: String, expected: String, msg: String): TestResult = {
    if actual == expected then {
        return pass();
    };
    let mutable m = StringBuilder.new();
    m.push_string(msg);
    m.push_string(" | expected=");
    m.push_string(expected);
    m.push_string(" | actual=");
    m.push_string(actual);
    return fail(m.to_string());
};

let assert_int(actual: Int, expected: Int, msg: String): TestResult = {
    if actual == expected then {
        return pass();
    };
    return fail(
        msg + " | expected=" + expected.to_string() + " actual=" + actual.to_string(),
    );
};

let assert_true(ok: Bool, msg: String): TestResult = {
    return if ok then pass() else fail(msg);
};

let normalize_newlines(s: String): String = {
    return s.replace_all("\r\n", with = "\n");
};

let normalize_paths(s: String): String = {
    return normalize_newlines(s).replace_all("\\", with = "/");
};

/// Check stdout + exit code against one golden pair.
let check(
    out: ProcessOutput,
    expected_stdout: String,
    expected_exit: Int,
    msg: String,
): TestResult = {
    let r1 = assert_eq(normalize_newlines(out.stdout), expected_stdout, msg + " output");
    if r1 is .Fail(_) then {
        return r1;
    };
    return assert_int(out.exit_code, expected_exit, msg + " exit");
};

/// Build `head + tail` as one argv tail (no list-`+` in the language).
let join_args(head: List[String], tail: List[String]): List[String] = {
    let mutable out = List[String].new();
    for a in head then {
        out.push(a);
    };
    for a in tail then {
        out.push(a);
    };
    return out;
};

/// Check that a `-j N` run is byte-identical to the same run under `-j 1`.
let check_same_as_serial(
    args: List[String],
    stdin_file: Option[String],
    jobs: String,
    msg: String,
): TestResult = {
    let serial = run_grep_j(args, stdin_file) or else {
        return fail(msg + " serial run failed");
    };
    let mut_args = List[String].new();
    mut_args.push("-j");
    mut_args.push(jobs);
    for a in args then {
        mut_args.push(a);
    };
    let par = run_grep_j(mut_args, stdin_file) or else {
        return fail(msg + " parallel run failed");
    };
    let r1 = assert_eq(
        normalize_newlines(par.stdout),
        normalize_newlines(serial.stdout),
        msg + " stdout",
    );
    if r1 is .Fail(_) then {
        return r1;
    };
    let r2 = assert_eq(
        normalize_newlines(par.stderr),
        normalize_newlines(serial.stderr),
        msg + " stderr",
    );
    if r2 is .Fail(_) then {
        return r2;
    };
    return assert_int(par.exit_code, serial.exit_code, msg + " exit");
};

// ----------------------------------------------------------------------------
// Cases: fixed-string matching and streams
// ----------------------------------------------------------------------------

let test_stdin_match(): TestResult = {
    let in_path = create_temp_text_file(
        "tmp_grepj_in_match.txt",
        "apple\nbanana\ncherry\n",
    ) or else {
        return fail("stdin_match setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep_j(["an"], Option[String].Some(in_path)) or else {
        return fail("stdin_match run failed");
    };
    return check(out, "banana\n", 0, "stdin_match");
};

/// `-F` is literal: `a.c` must NOT read as an ERE.
let test_literal_metachars(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_literal.txt", "abc\naxc\n") or else {
        return fail("literal_metachars setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep_j(["a.c"], Option[String].Some(in_path)) or else {
        return fail("literal_metachars run failed");
    };
    return check(out, "", 1, "literal_metachars");
};

let test_literal_dot_hit(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_dot.txt", "a.c\naxc\n") or else {
        return fail("literal_dot_hit setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep_j(["a.c"], Option[String].Some(in_path)) or else {
        return fail("literal_dot_hit run failed");
    };
    return check(out, "a.c\n", 0, "literal_dot_hit");
};

let test_stdin_no_match(): TestResult = {
