    return check(tight_out, "", 1, "empty_pattern_word tight");
};

let test_empty_pattern_x(): TestResult = {
    let empty_line = create_temp_text_file("tmp_grepj_empty_x.txt", "\n") or else {
        return fail("empty_pattern_x empty setup failed");
    };
    defer cleanup_temp_file(empty_line);
    let hit = run_grep_j(["-x", ""], Option[String].Some(empty_line)) or else {
        return fail("empty_pattern_x hit run failed");
    };
    let r1 = check(hit, "\n", 0, "empty_pattern_x hit");
    if r1 is .Fail(_) then {
        return r1;
    };
    let nonempty = create_temp_text_file("tmp_grepj_empty_x2.txt", "ab\n") or else {
        return fail("empty_pattern_x nonempty setup failed");
    };
    defer cleanup_temp_file(nonempty);
    let miss = run_grep_j(["-x", ""], Option[String].Some(nonempty)) or else {
        return fail("empty_pattern_x miss run failed");
    };
    return check(miss, "", 1, "empty_pattern_x miss");
};

// ----------------------------------------------------------------------------
// Cases: context, -m, -q, -r
// ----------------------------------------------------------------------------

let test_A_flag(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_A.txt", "1\n2\n3\n4\n") or else {
        return fail("A_flag setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep_j(["-A", "1", "2"], Option[String].Some(in_path)) or else {
        return fail("A_flag run failed");
    };
    return check(out, "2\n3\n", 0, "A_flag");
};

let test_B_flag(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_B.txt", "1\n2\n3\n4\n") or else {
        return fail("B_flag setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep_j(["-B", "1", "3"], Option[String].Some(in_path)) or else {
        return fail("B_flag run failed");
    };
    return check(out, "2\n3\n", 0, "B_flag");
};

let test_C_groups(): TestResult = {
    // Real line-number gap between the two matches (2 and 10) so the groups
    // are non-contiguous and GNU grep separates them with `--`.
    let in_path = create_temp_text_file(
        "tmp_grepj_C.txt",
        "a\nhit\nb\nc\nd\ne\nf\ng\nh\nhit\ni\n",
    ) or else {
        return fail("C_groups setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep_j(["-C", "1", "hit"], Option[String].Some(in_path)) or else {
        return fail("C_groups run failed");
    };
    return check(out, "a\nhit\nb\n--\nh\nhit\ni\n", 0, "C_groups");
};

let test_m_flag(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_m.txt", "a\na\na\n") or else {
        return fail("m_flag setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep_j(["-m", "2", "a"], Option[String].Some(in_path)) or else {
        return fail("m_flag run failed");
    };
    return check(out, "a\na\n", 0, "m_flag");
};

let test_q_flag(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_q.txt", "a\n") or else {
        return fail("q_flag setup failed");
    };
    defer cleanup_temp_file(in_path);
    let hit = run_grep_j(["-q", "a"], Option[String].Some(in_path)) or else {
        return fail("q_flag hit run failed");
    };
    let r1 = check(hit, "", 0, "q_flag hit");
    if r1 is .Fail(_) then {
        return r1;
    };
    let miss = run_grep_j(["-q", "z"], Option[String].Some(in_path)) or else {
        return fail("q_flag miss run failed");
    };
    return check(miss, "", 1, "q_flag miss");
};

let test_r_flag(): TestResult = {
    let base = "tmp_grepj_r_dir";
    create_dir_all(base.to_path().join("sub")) or else {
        return fail("r_flag setup dir failed");
    };
    defer {
        let _ = remove_dir_all(base.to_path());
    };
    let _ = write_text_file(base.to_path().join("a.txt"), content = "hit\n") or else {
        return fail("r_flag setup a failed");
    };
    let _ = write_text_file(base.to_path().join("sub/b.txt"), content = "x\nhit\n") or else {
        return fail("r_flag setup b failed");
    };
    let out = run_grep_j(["-r", "hit", base], Option[String].None()) or else {
        return fail("r_flag run failed");
    };
    if out.exit_code != 0 then {
        return fail("r_flag exit");
    };
    let norm = normalize_paths(out.stdout);
    let e1 = normalize_paths(base.to_path().join("a.txt").to_string());
    let e2 = normalize_paths(base.to_path().join("sub/b.txt").to_string());
    let r1 = assert_true(norm.contains(e1 + ":hit"), "r_flag entry a");
    if r1 is .Fail(_) then {
        return r1;
    };
    return assert_true(norm.contains(e2 + ":hit"), "r_flag entry b");
};

// ----------------------------------------------------------------------------
// Cases: -j plumbing and the parallel-correctness invariant
// ----------------------------------------------------------------------------

let test_jobs_zero(): TestResult = {
    let out = run_grep_j(["-j", "0", "a"], Option[String].None()) or else {
        return fail("jobs_zero run failed");
    };
    let r1 = assert_int(out.exit_code, 2, "jobs_zero exit");
    if r1 is .Fail(_) then {
        return r1;
    };
    return assert_true(out.stderr.contains("invalid count"), "jobs_zero stderr");
};

let test_jobs_bad(): TestResult = {
    let out = run_grep_j(["-j", "xyz", "a"], Option[String].None()) or else {
        return fail("jobs_bad run failed");
    };
    let r1 = assert_int(out.exit_code, 2, "jobs_bad exit");
    if r1 is .Fail(_) then {
        return r1;
    };
    return assert_true(out.stderr.contains("invalid count"), "jobs_bad stderr");
};

let test_jobs_missing_arg(): TestResult = {
    let out = run_grep_j(["-j"], Option[String].None()) or else {
        return fail("jobs_missing_arg run failed");
    };
    let r1 = assert_int(out.exit_code, 2, "jobs_missing_arg exit");
    if r1 is .Fail(_) then {
        return r1;
    };
    return assert_true(
        out.stderr.contains("requires an argument"),
        "jobs_missing_arg stderr",
    );
};

let test_jobs_one_file(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_j1f.txt", "hit\nmiss\n") or else {
        return fail("jobs_one_file setup failed");
    };
    defer cleanup_temp_file(in_path);
    return check_same_as_serial(["hit", in_path], Option[String].None(), "8", "jobs_one_file");
};

let test_stdin_with_jobs(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_jstdin.txt", "apple\nbanana\n") or else {
        return fail("stdin_with_jobs setup failed");
    };
    defer cleanup_temp_file(in_path);
    return check_same_as_serial(["an"], Option[String].Some(in_path), "4", "stdin_with_jobs");
};

/// The core invariant across modes: `-j 4` is byte-identical to `-j 1`.
let test_parallel_modes_match_serial(): TestResult = {
    let mutable paths = List[String].new();
    for k in 0..<8 then {
        let name = "tmp_grepj_pm_\(k).txt";
        let content = if k % 2 == 0 then "hit\nmiss\nhit\n" else "miss\nmiss\n";
        let p = create_temp_text_file(name, content) or else {
            return fail("parallel_modes setup failed");
        };
        paths.push(p);
    };
    defer {
        for p in paths then {
            cleanup_temp_file(p);
        };
    };
    let r1 = check_same_as_serial(
        join_args(["hit"], paths),
        Option[String].None(),
        "4",
        "parallel_modes plain",
    );
    if r1 is .Fail(_) then {
        return r1;
    };
    let r2 = check_same_as_serial(
        join_args(["-c", "hit"], paths),
        Option[String].None(),
        "4",
        "parallel_modes count",
    );
    if r2 is .Fail(_) then {
        return r2;
    };
    let r3 = check_same_as_serial(
        join_args(["-l", "hit"], paths),
        Option[String].None(),
        "3",
        "parallel_modes list",
    );
    if r3 is .Fail(_) then {
        return r3;
    };
    let r4 = check_same_as_serial(
        join_args(["-n", "-v", "hit"], paths),
        Option[String].None(),
        "3",
        "parallel_modes invert",
    );
    if r4 is .Fail(_) then {
        return r4;
    };
    return check_same_as_serial(
        join_args(["-C", "1", "hit"], paths),
        Option[String].None(),
        "4",
        "parallel_modes context",
    );
};

/// Workers finish out of operand order on purpose: file 0 is huge while the
/// rest are tiny, so with 3 workers every later block arrives first and the
/// coordinator must hold them until index 0 lands.
let test_parallel_order_stress(): TestResult = {
    let big = "pad line\n".repeat(20000) + "hit at end\n";
    let p0 = create_temp_text_file("tmp_grepj_order_big.txt", big) or else {
        return fail("order_stress setup big failed");
    };
    let mutable created = List[String].new();
    created.push(p0);
    defer {
        for p in created then {
            cleanup_temp_file(p);
        };
    };
    let mutable args = List[String].new();
    args.push("hit");
    args.push(p0);
    for k in 1..<7 then {
        let name = "tmp_grepj_order_\(k).txt";
        let p = create_temp_text_file(name, "hit \(k)\n") or else {
            return fail("order_stress setup small failed");
        };
        created.push(p);
        args.push(p);
    };
    return check_same_as_serial(args, Option[String].None(), "3", "order_stress");
};

/// An unreadable file aborts the serial loop at its operand position; the
/// parallel path must reproduce that exactly: blocks before it, none after.
let test_parallel_missing_file(): TestResult = {
    let a = create_temp_text_file("tmp_grepj_pmf_a.txt", "hit\n") or else {
        return fail("parallel_missing_file setup a failed");
    };
    defer cleanup_temp_file(a);
    let c = create_temp_text_file("tmp_grepj_pmf_c.txt", "hit\n") or else {
        return fail("parallel_missing_file setup c failed");
    };
    defer cleanup_temp_file(c);
    let args = ["hit", a, "tmp_grepj_no_such_file.txt", c];
    let serial = run_grep_j(args, Option[String].None()) or else {
        return fail("parallel_missing_file serial run failed");
    };
    let r1 = check(serial, a + ":hit\n", 2, "parallel_missing_file serial");
    if r1 is .Fail(_) then {
        return r1;
    };
    let r2 = check_same_as_serial(args, Option[String].None(), "3", "parallel_missing_file");
    if r2 is .Fail(_) then {
        return r2;
    };
    let par = run_grep_j(["-j", "3", "hit", a, "tmp_grepj_no_such_file.txt", c], Option[String].None()) or else {
        return fail("parallel_missing_file parallel run failed");
    };
    return assert_true(
        par.stderr.contains("tmp_grepj_no_such_file.txt"),
        "parallel_missing_file stderr",
    );
};

// ----------------------------------------------------------------------------
// Runner
// ----------------------------------------------------------------------------

let run_case(name: String, r: TestResult): TestCase = {
    print("- ");
    print(name);
    print(" ... ");
    when r in {
        .Pass() then println("ok"),
        .Fail(msg) then {
            println("FAIL");
            println(msg);
        },
    };
    return TestCase(name, r);
};

let main(): Void = {
    println("grep-j tests:");
    let mutable cases = List[TestCase].new();
    cases.push(run_case("stdin_match", test_stdin_match()));
    cases.push(run_case("literal_metachars", test_literal_metachars()));
    cases.push(run_case("literal_dot_hit", test_literal_dot_hit()));
    cases.push(run_case("stdin_no_match", test_stdin_no_match()));
    cases.push(run_case("stdin_no_trailing_newline", test_stdin_no_trailing_newline()));
    cases.push(run_case("file_single", test_file_single()));
    cases.push(run_case("multi_file_prefix", test_multi_file_prefix()));
    cases.push(run_case("missing_file", test_missing_file()));
    cases.push(run_case("n_flag", test_n_flag()));
    cases.push(run_case("i_flag", test_i_flag()));
    cases.push(run_case("io_flag", test_io_flag()));
    cases.push(run_case("v_flag", test_v_flag()));
    cases.push(run_case("c_flag", test_c_flag()));
    cases.push(run_case("c_no_match", test_c_no_match()));
    cases.push(run_case("c_multi", test_c_multi()));
    cases.push(run_case("l_flag", test_l_flag()));
    cases.push(run_case("L_flag", test_L_flag()));
    cases.push(run_case("h_flag", test_h_flag()));
    cases.push(run_case("e_multi", test_e_multi()));
    cases.push(run_case("f_flag", test_f_flag()));
    cases.push(run_case("cluster", test_cluster()));
    cases.push(run_case("no_pattern", test_no_pattern()));
    cases.push(run_case("x_flag", test_x_flag()));
    cases.push(run_case("w_flag", test_w_flag()));
    cases.push(run_case("o_flag", test_o_flag()));
    cases.push(run_case("o_w_flag", test_o_w_flag()));
    cases.push(run_case("w_overlap", test_w_overlap()));
    cases.push(run_case("o_multi_pattern", test_o_multi_pattern()));
    cases.push(run_case("empty_pattern", test_empty_pattern()));
    cases.push(run_case("empty_pattern_word", test_empty_pattern_word()));
    cases.push(run_case("empty_pattern_x", test_empty_pattern_x()));
    cases.push(run_case("A_flag", test_A_flag()));
    cases.push(run_case("B_flag", test_B_flag()));
    cases.push(run_case("C_groups", test_C_groups()));
    cases.push(run_case("m_flag", test_m_flag()));
    cases.push(run_case("q_flag", test_q_flag()));
    cases.push(run_case("r_flag", test_r_flag()));
    cases.push(run_case("jobs_zero", test_jobs_zero()));
    cases.push(run_case("jobs_bad", test_jobs_bad()));
    cases.push(run_case("jobs_missing_arg", test_jobs_missing_arg()));
    cases.push(run_case("jobs_one_file", test_jobs_one_file()));
    cases.push(run_case("stdin_with_jobs", test_stdin_with_jobs()));
    cases.push(run_case("parallel_modes_match_serial", test_parallel_modes_match_serial()));
    cases.push(run_case("parallel_order_stress", test_parallel_order_stress()));
    cases.push(run_case("parallel_missing_file", test_parallel_missing_file()));

    let mutable failed = 0;
    for c in cases then {
        if c.result is .Fail(_) then {
            failed += 1;
        };
    };
    println("");
    if failed == 0 then {
        println("all grep-j tests passed");
    } else {
        println("\(failed) grep-j tests failed");
        exit(1);
    };
};
