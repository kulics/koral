// ----------------------------------------------------------------------------
// Cases: selection shapes (-x/-w/-o) and empty patterns
// ----------------------------------------------------------------------------

let test_x_flag(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_x.txt", "cat\ncatalog\n") or else {
        return fail("x_flag setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep_j(["-x", "cat"], Option[String].Some(in_path)) or else {
        return fail("x_flag run failed");
    };
    return check(out, "cat\n", 0, "x_flag");
};

let test_w_flag(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_w.txt", "cat\nconcatenate\n") or else {
        return fail("w_flag setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep_j(["-w", "cat"], Option[String].Some(in_path)) or else {
        return fail("w_flag run failed");
    };
    return check(out, "cat\n", 0, "w_flag");
};

/// GNU `-Fo` walks positions left to right and skips past each printed match:
/// `aa` in `aaa` prints once.
let test_o_flag(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_o.txt", "abcabc\naaa\n") or else {
        return fail("o_flag setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep_j(["-o", "bc"], Option[String].Some(in_path)) or else {
        return fail("o_flag run failed");
    };
    let r1 = check(out, "bc\nbc\n", 0, "o_flag bc");
    if r1 is .Fail(_) then {
        return r1;
    };
    let overlap = run_grep_j(["-o", "aa"], Option[String].Some(in_path)) or else {
        return fail("o_flag overlap run failed");
    };
    return check(overlap, "aa\n", 0, "o_flag overlap");
};

/// `-o` with `-w` prints only word-bounded occurrences.
let test_o_w_flag(): TestResult = {
    let a = create_temp_text_file("tmp_grepj_ow_a.txt", "cat cats\n") or else {
        return fail("o_w_flag setup a failed");
    };
    defer cleanup_temp_file(a);
    let b = create_temp_text_file("tmp_grepj_ow_b.txt", "cat cat\n") or else {
        return fail("o_w_flag setup b failed");
    };
    defer cleanup_temp_file(b);
    let out_a = run_grep_j(["-wo", "cat", a], Option[String].None()) or else {
        return fail("o_w_flag a run failed");
    };
    let r1 = check(out_a, "cat\n", 0, "o_w_flag a");
    if r1 is .Fail(_) then {
        return r1;
    };
    let out_b = run_grep_j(["-wo", "cat", b], Option[String].None()) or else {
        return fail("o_w_flag b run failed");
    };
    return check(out_b, "cat\ncat\n", 0, "o_w_flag b");
};

/// The scan rule's overlap corner: `a-a` is hidden at offset 0 of `a-a-a`
/// (followed by a word char) but the occurrence at offset 2 is word-bounded,
/// so `-w` selects and `-wo` prints one.
let test_w_overlap(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_wo.txt", "a-a-a\n") or else {
        return fail("w_overlap setup failed");
    };
    defer cleanup_temp_file(in_path);
    let sel = run_grep_j(["-w", "a-a"], Option[String].Some(in_path)) or else {
        return fail("w_overlap select run failed");
    };
    let r1 = check(sel, "a-a-a\n", 0, "w_overlap select");
    if r1 is .Fail(_) then {
        return r1;
    };
    let out = run_grep_j(["-wo", "a-a"], Option[String].Some(in_path)) or else {
        return fail("w_overlap out run failed");
    };
    return check(out, "a-a\n", 0, "w_overlap out");
};

/// Deliberate divergence (documented in grep_j.koral): `-o` prints each
/// pattern's matches in order without cross-pattern deduplication. GNU picks
/// the leftmost-longest across the pattern set and would print only `ab`.
let test_o_multi_pattern(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_om.txt", "abc\n") or else {
        return fail("o_multi_pattern setup failed");
    };
    defer cleanup_temp_file(in_path);
    let out = run_grep_j(["-o", "-e", "ab", "-e", "bc"], Option[String].Some(in_path)) or else {
        return fail("o_multi_pattern run failed");
    };
    return check(out, "ab\nbc\n", 0, "o_multi_pattern");
};

/// Empty pattern pins, all mirroring GNU `grep -F`: it selects every line
/// (exit 0), inverts to nothing, prints nothing under `-o`, and its zero-width
/// occurrences obey `-w`/`-x` like any other occurrence.
let test_empty_pattern(): TestResult = {
    let in_path = create_temp_text_file("tmp_grepj_empty.txt", "hi\n") or else {
        return fail("empty_pattern setup failed");
    };
    defer cleanup_temp_file(in_path);
    let sel = run_grep_j([""], Option[String].Some(in_path)) or else {
        return fail("empty_pattern select run failed");
    };
    let r1 = check(sel, "hi\n", 0, "empty_pattern select");
    if r1 is .Fail(_) then {
        return r1;
    };
    let inv = run_grep_j(["-v", ""], Option[String].Some(in_path)) or else {
        return fail("empty_pattern invert run failed");
    };
    let r2 = check(inv, "", 1, "empty_pattern invert");
    if r2 is .Fail(_) then {
        return r2;
    };
    let out = run_grep_j(["-o", ""], Option[String].Some(in_path)) or else {
        return fail("empty_pattern o run failed");
    };
    return check(out, "", 0, "empty_pattern o");
};

let test_empty_pattern_word(): TestResult = {
    let gap = create_temp_text_file("tmp_grepj_empty_w.txt", "a  b\n") or else {
        return fail("empty_pattern_word gap setup failed");
