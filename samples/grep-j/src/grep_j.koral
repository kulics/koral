// grep_j.koral: koral grep-j tool entry -- parallel fixed-string grep.
// Build example: koralc build samples/grep-j/src/grep_j.koral -o bin/samples
// Usage: grep [-nivclhqoxwrL] [-e PATTERN]... [-f FILE]...
//          [-A NUM] [-B NUM] [-C NUM] [-m NUM] [-j NUM] [PATTERN] [FILE...]
// Patterns are fixed strings (the `grep -F` dialect): every character matches
// itself, nothing is special. Reads standard input when no FILE is given
// (always serial). A missing trailing newline is preserved on output.
// `-j NUM` searches the FILE operands on NUM worker threads (default: the
// machine's available parallelism, at least 1); the output is byte-identical
// to `-j 1` because the coordinator replays per-file blocks in operand order
// no matter what order the workers finish in.
// Deliberate divergences from GNU grep: `-o` with `-v` is a usage error;
// `-o` prints each pattern's matches in order without cross-pattern
// deduplication (GNU picks the leftmost-longest match across the pattern
// set); `-m` prints the trailing context of the final match; `-i` folds
// ASCII letters only (no locale case folding); `-w` counts only ASCII word
// constituents (a multi-byte neighbor reads as non-word); `-j` is an
// extension.
// Exit codes: 0 = selected (found for -l/-L), 1 = not found, 2 = error.

using "std" { ... };
using "std/io" { ... };
using "std/os" { ... };
using "std/sync" { ... };
using "std/async" { ... };

// ============================================================================
// Configuration
// ============================================================================

type mutable Flags(
    mutable line_numbers: Bool,
    mutable ignore_case: Bool,
    mutable invert: Bool,
    mutable count_only: Bool,
    mutable files_with_matches: Bool,
    mutable files_without_matches: Bool,
    mutable no_filename: Bool,
    mutable only_matching: Bool,
    mutable quiet: Bool,
    mutable whole_line: Bool,
    mutable word_match: Bool,
    mutable recursive: Bool,
    mutable max_count: Int,
    mutable after_context: Int,
    mutable before_context: Int,
    mutable jobs: Int,
);

type mutable Config(
    mutable patterns: List[String],
    mutable pattern_files: List[String],
    mutable files: List[String],
    flags: Flags,
);

/// The immutable search shape every worker sees. Frozen so a worker closure's
/// captures are all `sendable`; parse-time state stays in `Flags`/`Config`.
type sendable RunFlags(
    line_numbers: Bool,
    ignore_case: Bool,
    invert: Bool,
    count_only: Bool,
    files_with_matches: Bool,
    files_without_matches: Bool,
    no_filename: Bool,
    only_matching: Bool,
    quiet: Bool,
    whole_line: Bool,
    word_match: Bool,
    max_count: Int,
    after_context: Int,
    before_context: Int,
);

/// One file's outcome: the output block it produced, whether it selected
/// anything, and the error message when the file could not be processed.
/// Exactly one outcome is sent per file, so the coordinator terminates by
/// counting outcomes -- no sentinel messages, no channel-close ordering.
type sendable FileOutcome(
    index: Int,
    block: String,
    matched: Bool,
    error: Option[String],
);

/// One buffered line for `-B` context output.
type LineEntry(no: Int, text: String);

let new_flags(): Flags = {
    let cores = available_parallelism();
    return Flags(
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        0,
        0,
        0,
        if cores < 1 then 1 else cores,
    );
};

let to_run_flags(flags: Flags): RunFlags =
    RunFlags(
        flags.line_numbers,
        flags.ignore_case,
        flags.invert,
        flags.count_only,
        flags.files_with_matches,
        flags.files_without_matches,
        flags.no_filename,
        flags.only_matching,
        flags.quiet,
        flags.whole_line,
        flags.word_match,
        flags.max_count,
        flags.after_context,
        flags.before_context,
    );

/// Parse a numeric option argument (digits only).
let digits: String = "0123456789";

let parse_count(arg: String): Option[Int] = {
    if arg.count() == 0 then {
        return Option[Int].None();
    };
    for i in 0..<arg.count() then {
        if not digits.contains(arg.substring(i..<(i + 1))) then {
            return Option[Int].None();
        };
    };
    return when Int.parse(arg) in {
        .Ok(n) then Option[Int].Some(n),
        .Error(_) then Option[Int].None(),
    };
};

/// Parse argv (index 0 is the program name). Flags may be clustered (`-in`)
/// and may appear anywhere; numeric flags take the rest of the cluster or the
/// next argument (`-C2`, `-C 2`, `-j4`, `-j 4`). `-e`/`-f` consume the next
/// argument and may repeat; `--` ends flag parsing. The first bare argument is
/// the pattern unless `-e`/`-f` already supplied one; the rest are files.
let parse_args(args: List[String]): Result[Config] = {
    let mutable config = Config(
        List[String].new(),
        List[String].new(),
        List[String].new(),
        new_flags(),
    );
    let mutable have_pattern_source = false;
    let mutable no_more_flags = false;
    let mutable i = 1;
    while i < args.count() then {
        let arg = args[i];
        i += 1;
        if no_more_flags or not arg.starts_with("-") or arg == "-" then {
            if not have_pattern_source and config.patterns.is_empty() and config.pattern_files.is_empty(
            ) then {
                config.patterns.push(arg);
                have_pattern_source = true;
            } else {
                config.files.push(arg);
            };
            continue;
        };
        if arg == "--" then {
            no_more_flags = true;
            continue;
        };
        let mutable j = 1;
        while j < arg.count() then {
            let ch = arg.substring(j..<(j + 1));
            j += 1;
            when ch in {
                "n" then {
                    config.flags.line_numbers = true;
                },
                "i" then {
                    config.flags.ignore_case = true;
                },
                "v" then {
                    config.flags.invert = true;
                },
                "c" then {
                    config.flags.count_only = true;
                },
                "l" then {
                    config.flags.files_with_matches = true;
                },
                "L" then {
                    config.flags.files_without_matches = true;
                },
                "h" then {
                    config.flags.no_filename = true;
                },
                "o" then {
                    config.flags.only_matching = true;
                },
                "q" then {
                    config.flags.quiet = true;
                },
                "x" then {
                    config.flags.whole_line = true;
                },
                "w" then {
                    config.flags.word_match = true;
                },
                "r" then {
                    config.flags.recursive = true;
                },
                "e" then {
                    if i >= args.count() then {
                        return Result[Config].Error(
                            "option requires an argument -- 'e'",
                        );
                    };
                    config.patterns.push(args[i]);
                    have_pattern_source = true;
                    i += 1;
                },
                "f" then {
                    if i >= args.count() then {
                        return Result[Config].Error(
                            "option requires an argument -- 'f'",
                        );
                    };
                    config.pattern_files.push(args[i]);
                    have_pattern_source = true;
                    i += 1;
                },
                "A" or "B" or "C" or "m" or "j" then {
                    // A number: the rest of the cluster, or the next argument.
                    // The arm blocks yield their TRAILING EXPRESSION (no `;`
                    // on it) -- a block's tail is its value.
                    let rest = arg.substring(j..<(arg.count()));
                    let text = when rest.count() > 0 in {
                        true then {
                            j = arg.count();
                            rest
                        },
                        false then {
                            if i >= args.count() then {
                                return Result[Config].Error(
                                    "option requires an argument -- '\(ch)'",
                                );
                            };
                            let value = args[i];
                            i += 1;
                            value
                        },
                    };
                    let n = parse_count(text) or else {
                        return Result[Config].Error(
                            "invalid count argument -- '\(text)'",
                        );
                    };
                    when ch in {
                        "A" then {
                            config.flags.after_context = n;
                        },
                        "B" then {
                            config.flags.before_context = n;
                        },
                        "C" then {
                            config.flags.after_context = n;
                            config.flags.before_context = n;
                        },
                        "j" then {
                            if n == 0 then {
                                return Result[Config].Error(
                                    "invalid count argument -- '\(text)'",
                                );
                            };
                            config.flags.jobs = n;
                        },
                        _ then {
                            config.flags.max_count = n;
                        },
                    };
                },
                _ then {
                    return Result[Config].Error("invalid option -- '\(ch)'");
                },
            };
        };
    };
    if config.flags.files_with_matches and config.flags.files_without_matches then {
        return Result[Config].Error("cannot combine -l and -L");
    };
    if config.flags.only_matching and config.flags.invert then {
        return Result[Config].Error("cannot combine -o and -v");
    };
    return Result[Config].Ok(config);
};

// ============================================================================
// Patterns and matching
// ============================================================================

/// Strip one trailing newline so anchors see the line content (grep semantics).
let line_subject(line: String): String = {
    if line.ends_with("\n") then {
        return line.substring(0..<(line.count() - 1));
    };
    return line;
};

/// ASCII word constituent (`-w`): letter, digit, or underscore. Multi-byte
/// neighbors read as non-word bytes -- the documented ASCII-only word set.
let is_word_byte(b: UInt8): Bool = {
    return b == '_' or (b >= '0' and b <= '9') or (b >= 'A' and b <= 'Z') or (b >= 'a' and b <= 'z');
};

/// GNU `-w`: the occurrence must touch a non-word constituent or the line
/// edge. Positions are byte offsets into `subject`; the neighbor check reads
/// raw bytes so a multi-byte neighbor cannot trip the substring rune check.
let word_bounded(subject: String, s: Int, e: Int): Bool = {
    if s > 0 and is_word_byte(subject.get(s - 1).unwrap()) then {
        return false;
    };
    if e < subject.count() and is_word_byte(subject.get(e).unwrap()) then {
        return false;
    };
    return true;
};

/// All occurrences of `pat` in `search` under GNU `grep -Fo`'s scan rule:
/// walk positions left to right; a position that matches advances past the
/// match end, any other position advances by one. That is why `-w` can still
/// see an occurrence hidden behind an unbounded overlap (`a-a` in `a-a-a`
/// matches at offset 2). The empty pattern matches at every position as a
/// zero-width occurrence (`find_from(start, "")` is `Some(start)`), so the
/// same walk yields the whole 0..=n set -- those count for selection but are
/// never printed by `-o`.
let scan_occurrences(search: String, pat: String, word_filter: Bool): List[Pair[Int, Int]] = {
    let mutable out = List[Pair[Int, Int]].new();
    let n = search.count();
    let mutable pos = 0;
    while pos <= n then {
        when search.find_from(pos, pat) in {
            .None() then {
                return out;
            },
            .Some(i) then {
                let e = i + pat.count();
                if not word_filter or word_bounded(search, i, e) then {
                    out.push(Pair[Int, Int](i, e));
                    pos = if e > i then e else i + 1;
                } else {
                    pos = i + 1;
                };
            },
        };
    };
    return out;
};

/// The occurrences one pattern claims on a line: whole-line equality for
/// `-x`, otherwise the scan under the `-w` filter.
let mode_occurrences(search: String, pat: String, flags: RunFlags): List[Pair[Int, Int]] = {
    if flags.whole_line then {
        let mutable out = List[Pair[Int, Int]].new();
        if search == pat then {
            out.push(Pair[Int, Int](0, search.count()));
        };
        return out;
    };
    return scan_occurrences(search, pat, flags.word_match);
};

/// A line is selected when any pattern claims an occurrence, XOR-ed with `-v`.
/// `search` is the (ASCII-folded when `-i`) match subject; patterns arrive
/// pre-folded from `collect_patterns`.
let line_selected(patterns: FrozenList[String], flags: RunFlags, search: String): Bool = {
    let mutable hit = false;
    let mutable i = 0;
    while i < patterns.count() and not hit then {
        let pat = patterns.get(i).unwrap();
        if not mode_occurrences(search, pat, flags).is_empty() then {
            hit = true;
        };
        i += 1;
    };
    return when flags.invert in {
        true then not hit,
        false then hit,
    };
};

/// Collect literal patterns from `-e`/bare patterns plus `-f` files (one per
/// line). Nothing is compiled -- patterns are fixed strings. `-i` folds each
/// pattern once here so per-line search only folds the subject.
let collect_patterns(config: Config): Result[FrozenList[String]] = {
    let mutable texts = List[String].new();
    for p in config.patterns then {
        texts.push(p);
    };
    for path in config.pattern_files then {
        let data = read_text_file(path.to_path()) or else as e in {
            return Result[FrozenList[String]].Error("\(path): \(e.message())");
        };
        let reader = BufReader[ByteBuffer].new(ByteBuffer.from_string(data));
        while true then {
            let opt = reader.read_line() or else as e in {
                return Result[FrozenList[String]].Error("\(path): \(e.message())");
            };
            let line = opt or else {
                break;
            };
            texts.push(line_subject(line));
        };
    };
    if config.flags.ignore_case then {
        let mutable folded = List[String].new();
        for t in texts then {
            folded.push(t.to_ascii_lowercase());
        };
        return Result[FrozenList[String]].Ok(folded.to_frozen_list());
    };
    return Result[FrozenList[String]].Ok(texts.to_frozen_list());
};

// ============================================================================
// Output prefixes
// ============================================================================

/// Match lines separate file/number with `:`, context lines with `-`.
let match_prefix(flags: RunFlags, show_name: Bool, name: String, no: Int): String = {
    let mutable p = "";
    if show_name then {
        p = name + ":";
    };
    if flags.line_numbers then {
        p = p + no.to_string() + ":";
    };
    return p;
};

let context_prefix(flags: RunFlags, show_name: Bool, name: String, no: Int): String = {
    let mutable p = "";
    if show_name then {
        p = name + "-";
    };
    if flags.line_numbers then {
        p = p + no.to_string() + "-";
    };
    return p;
};

// ============================================================================
// Per-stream driver
// ============================================================================

/// Run one input stream through the matcher, accumulating its output block
/// into `acc`. Ok(true) when any line was selected. `name` is the display name
/// for `-c`/`-l`/`-L` and filename prefixes; `show_name` gates the prefix in
/// line output. Mode precedence: `-q` > `-l`/`-L` > `-c` > normal.
/// The caller owns `acc`, so a mid-stream failure still hands back the block
/// produced before the failing read -- the serial loop and the parallel
/// coordinator both replay it before reporting the error.
let grep_stream[R: Reader](
    patterns: FrozenList[String],
    flags: RunFlags,
    src: R,
    name: String =,
    show_name: Bool =,
    acc: StringBuilder =,
): Result[Bool] = {
    let reader = BufReader[R].new(src);
    let use_context = flags.before_context > 0 or flags.after_context > 0;
    let mutable matched = false;
    let mutable selected_count = 0;
    let mutable line_no = 0;
    let mutable pending = List[LineEntry].new();
    let mutable trailing = 0;
    let mutable last_printed = 0;
    let mutable printed_any = false;

    while true then {
        let opt = reader.read_line() or return;
        let line = opt or else {
            break;
        };
        line_no += 1;
        let subject = line_subject(line);
        let search = if flags.ignore_case then subject.to_ascii_lowercase() else subject;
        let selected = line_selected(patterns, flags, search);

        if selected then {
            matched = true;
            selected_count += 1;

            if flags.quiet then {
                break;
            };

            if flags.files_with_matches or flags.files_without_matches or flags.count_only then {
                // summarized after the stream ends
            } else if flags.only_matching then {
                let mutable pi = 0;
                while pi < patterns.count() then {
                    let pat = patterns.get(pi).unwrap();
                    for occ in mode_occurrences(search, pat, flags) then {
                        // Print from the ORIGINAL subject: `-i` folding is
                        // search-only (ASCII folds are byte-length neutral).
                        if occ.second > occ.first then {
                            let prefix = match_prefix(flags, show_name, name, line_no);
                            acc.push_string(prefix);
                            acc.push_string(subject.substring(occ.first..<occ.second));
                            acc.push_string("\n");
                        };
                    };
                    pi += 1;
                };
            } else if use_context then {
                // Flush the before-window, then the match itself. A gap in
                // line numbers separates groups with `--` (GNU format).
                let start = if pending.count() > flags.before_context then pending.count(
                ) - flags.before_context else 0;
                for entry in pending.lazy().skip(start) then {
                    if printed_any and entry.no > last_printed + 1 then {
                        acc.push_string("--\n");
                    };
                    let p = context_prefix(flags, show_name, name, entry.no);
                    acc.push_string(p);
                    acc.push_string(entry.text);
                    printed_any = true;
                    last_printed = entry.no;
                };
                pending = List[LineEntry].new();
                if printed_any and line_no > last_printed + 1 then {
                    acc.push_string("--\n");
                };
                let p = match_prefix(flags, show_name, name, line_no);
                acc.push_string(p);
                acc.push_string(line);
                printed_any = true;
                last_printed = line_no;
                trailing = flags.after_context;
            } else {
                let p = match_prefix(flags, show_name, name, line_no);
                acc.push_string(p);
                acc.push_string(line);
            };
        } else if trailing > 0 then {
            // After-context of a recent match.
            trailing -= 1;
            if printed_any and line_no > last_printed + 1 then {
                acc.push_string("--\n");
            };
            let p = context_prefix(flags, show_name, name, line_no);
            acc.push_string(p);
            acc.push_string(line);
            printed_any = true;
            last_printed = line_no;
        } else if use_context and not flags.quiet and not flags.count_only and not flags.files_with_matches and not flags.files_without_matches then {
            pending.push(LineEntry(line_no, line));
        };

        if flags.max_count > 0 and selected_count >= flags.max_count and trailing == 0 then {
            break;
        };
    };

    if flags.files_with_matches then {
        if matched then {
            acc.push_string(name + "\n");
        };
        return Result[Bool].Ok(matched);
    };
    if flags.files_without_matches then {
        if not matched then {
            acc.push_string(name + "\n");
        };
        return Result[Bool].Ok(matched);
    };
    if flags.count_only then {
        let prefix = if show_name then name + ":" else "";
        acc.push_string(prefix + selected_count.to_string() + "\n");
        return Result[Bool].Ok(selected_count > 0);
    };
    return Result[Bool].Ok(matched);
};

// ============================================================================
// Operands
// ============================================================================

/// With `-r`, expand directory operands through `walk_dir` into file lists; a
/// recursive search with no operands starts at `.`.
let expand_operands(config: Config): Result[List[String]] = {
    if not config.flags.recursive then {
        return Result[List[String]].Ok(config.files);
    };
    let mutable operands = config.files;
    if operands.is_empty() then {
        operands = List[String].new();
        operands.push(".");
    };
    let mutable out = List[String].new();
    for path in operands then {
        let info = file_info(path.to_path()) or else as e in {
            return Result[List[String]].Error(e.message());
        };
        if info.is_dir() then {
            let entries = walk_dir(path.to_path()) or else as e in {
                return Result[List[String]].Error(e.message());
            };
            for entry in entries then {
                if entry.is_file() then {
                    out.push(entry.path().to_string());
                };
            };
        } else {
            out.push(path);
        };
    };
    return Result[List[String]].Ok(out);
};

// ============================================================================
// Parallel shell
// ============================================================================

/// `-L` flips what counts as a hit for the exit code.
let exit_relevant(flags: RunFlags, selected: Bool): Bool = {
    return when flags.files_without_matches in {
        true then not selected,
        false then selected,
    };
};

/// Search the FILE operands on `jobs` worker threads. Workers claim file
/// indices through an atomic counter and finish in whatever order the OS
/// schedules them; the coordinator replays each outcome block in operand
/// order, so stdout is byte-identical to the serial loop. Termination is by
/// counting: exactly one `FileOutcome` is sent per claimed index and every
/// index is claimed exactly once.
let run_parallel[W: Writer](
    patterns: FrozenList[String],
    flags: RunFlags,
    inputs: List[String],
    jobs: Int,
    show_name: Bool,
    out: W =,
): Int = {
    let total = inputs.count();
    let worker_count = if jobs < total then jobs else total;
    let files = inputs.to_frozen_list();
    let channels = make_channel[FileOutcome](total + total + worker_count);
    let sender = channels.first;
    let receiver = channels.second;
    let next_index = AtomicInt.new(0);
    let mutable threads = List[Thread].new();

    for _ in 0..<worker_count then {
        let shared_sender = sender;
        let shared_patterns = patterns;
        let shared_flags = flags;
        let shared_files = files;
        let shared_show_name = show_name;
        let shared_index = next_index;

        threads.push(
            run_task(
                () => {
                    while true then {
                        let idx = shared_index.fetch_add(1);
                        if idx < 0 or idx >= shared_files.count() then {
                            break;
                        };
                        let path = shared_files.get(idx).unwrap();
                        let acc = StringBuilder.new();
                        when open_file(path.to_path(), OpenMode.Read()) in {
                            .Ok(file) then {
                                when grep_stream(
                                    shared_patterns,
                                    shared_flags,
                                    file,
                                    name = path,
                                    show_name = shared_show_name,
                                    acc = acc,
                                ) in {
                                    .Ok(matched) then {
                                        let _ = shared_sender.send(
                                            FileOutcome(
                                                idx,
                                                acc.into_string(),
                                                matched,
                                                Option[String].None(),
                                            ),
                                        );
                                    },
                                    .Error(e) then {
                                        let _ = shared_sender.send(
                                            FileOutcome(
                                                idx,
                                                acc.into_string(),
                                                false,
                                                Option[String].Some(e.message()),
                                            ),
                                        );
                                    },
                                };
                            },
                            .Error(e) then {
                                let _ = shared_sender.send(
                                    FileOutcome(
                                        idx,
                                        "",
                                        false,
                                        Option[String].Some(e.message()),
                                    ),
                                );
                            },
                        };
                    };
                },
            ),
        );
    };

    let mutable pending = List[Option[FileOutcome]].new();
    for _ in 0..<total then {
        pending.push(Option[FileOutcome].None());
    };
    let mutable next = 0;
    let mutable received = 0;
    let mutable any_relevant = false;
    let mutable had_error = false;

    while received < total then {
        when receiver.recv() in {
            .Ok(outcome) then {
                received += 1;
                pending[outcome.index] = Option[FileOutcome].Some(outcome);
                // Replay in operand order; an outcome only becomes visible
                // once every earlier index has been emitted.
                while next < total and not had_error then {
                    let slot = pending[next];
                    if slot is .Some(ev) then {
                        if ev.block.count() > 0 then {
                            out.write_all(from = ev.block.as_slice()) or else as e in {
                                eprintln("grep: \(e.message())");
                                return 2;
                            };
                        };
                        when ev.error in {
                            .Some(message) then {
                                eprintln("grep: \(inputs[next]): \(message)");
                                had_error = true;
                            },
                            .None() then {
                                if exit_relevant(flags, ev.matched) then {
                                    any_relevant = true;
                                };
                            },
                        };
                        next += 1;
                    } else {
                        break;
                    };
                };
            },
            .Error(_) then {
                break;
            },
        };
    };

    for t in threads then {
        let _ = t.wait();
    };
    if had_error then {
        return 2;
    };
    return if any_relevant then 0 else 1;
};

// ============================================================================
// Entry
// ============================================================================

let usage(): Void = {
    eprintln(
        "usage: grep [-nivclhqoxwrL] [-e PATTERN]... [-f FILE]... [-A NUM] [-B NUM] [-C NUM] [-m NUM] [-j NUM] [PATTERN] [FILE...]",
    );
};

let main(): Int = {
    let argv = args();
    // Shape dispatch by list pattern: nothing beyond the program name is a
    // usage complaint.
    let parsed = when argv in {
        [] or [_] then Result[Config].Error("no pattern given"),
        [_, ...] then parse_args(argv),
    };
    let config = parsed or else as e in {
        eprintln("grep: \(e.message())");
        usage();
        return 2;
    };
    if config.patterns.is_empty() and config.pattern_files.is_empty() then {
        eprintln("grep: no pattern given");
        usage();
        return 2;
    };
    let patterns = collect_patterns(config) or else as e in {
        eprintln("grep: \(e.message())");
        return 2;
    };
    let inputs = expand_operands(config) or else as e in {
        eprintln("grep: \(e.message())");
        return 2;
    };
    let flags = to_run_flags(config.flags);

    let out = stdout();
    let mutable any_relevant = false;

    if inputs.count() == 0 then {
        // Standard input is one stream: always serial, never pooled.
        let acc = StringBuilder.new();
        let selected = grep_stream(
            patterns,
            flags,
            stdin(),
            name = "(standard input)",
            show_name = false,
            acc = acc,
        ) or else as e in {
            eprintln("grep: \(e.message())");
            return 2;
        };
        let block = acc.into_string();
        if block.count() > 0 then {
            out.write_all(from = block.as_slice()) or else as e in {
                eprintln("grep: \(e.message())");
                return 2;
            };
        };
        let relevant = exit_relevant(flags, selected);
        any_relevant = relevant;
    } else if config.flags.jobs <= 1 then {
        // Serial operand loop: identical bytes to run_parallel, no threads.
        let show_name = not flags.no_filename and (inputs.count() > 1 or config.flags.recursive);
        for path in inputs then {
            let file = open_file(path.to_path(), OpenMode.Read()) or else as e in {
                eprintln("grep: \(path): \(e.message())");
                return 2;
            };
            let acc = StringBuilder.new();
            let selected = grep_stream(
                patterns,
                flags,
                file,
                name = path,
                show_name = show_name,
                acc = acc,
            ) or else as e in {
                eprintln("grep: \(path): \(e.message())");
                return 2;
            };
            let block = acc.into_string();
            if block.count() > 0 then {
                out.write_all(from = block.as_slice()) or else as e in {
                    eprintln("grep: \(e.message())");
                    return 2;
                };
            };
            let relevant = exit_relevant(flags, selected);
            if relevant then {
                any_relevant = true;
            };
        };
    } else {
        let show_name = not flags.no_filename and (inputs.count() > 1 or config.flags.recursive);
        return run_parallel(patterns, flags, inputs, config.flags.jobs, show_name, out = out);
    };

    return if any_relevant then 0 else 1;
};
