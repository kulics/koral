// ============================================================================
// Standard Library API Doc Generator
// ============================================================================
// Walks the Koral sources of `std/` and writes one markdown page per module,
// listing its public API in declaration-only syntax, every entry carrying the
// `///` doc comment that documents it.
//
// Extraction goes through `koral_syntax`, the same tokenizer, parser and
// printer the formatter uses. An earlier version of this tool scanned raw lines
// and counted braces to guess where declarations began and ended; it could not
// tell a `//` inside a string from a comment, and its idea of a signature was
// whatever text happened to sit between two heuristics. Here a declaration is a
// CST node, and the text on the page is printed by the one printer that knows
// how Koral is spelled -- so a signature in these docs is the syntax the
// formatter would write for it.
//
// What reaches a page is decided here: a top-level declaration is shown when it
// is `public`; a `given` carries no access modifier, so it is shown when the
// thing it extends is `public` -- a type or a trait (the trait-tool block). A
// `given` for a module-internal type is implementation detail and its
// documentation would leak that type's name.
// An entry that reaches a page must carry a `///` doc comment; a page with an
// undocumented entry is an error, so "every API has its documentation" is a
// property of the output and not a promise to be kept by hand.
// ============================================================================

using "koral_syntax" { ... };

using "std/os" { ... };

// ============================================================================
// What gets collected
// ============================================================================

/// One rendered declaration with its documentation, already in its final
/// spelling. Multi-line by construction -- a type with a body, say -- so the
/// signature is kept as text rather than re-split into lines. `docs` are the
/// `///` lines of the comment run above the declaration, verbatim.
type Decl(docs: List[String], text: String);

type mutable ParsedApi(
    mutable free_functions: List[Decl],
    mutable traits: List[Decl],
    mutable types: List[Decl],
    mutable givens: List[Decl],
);

let empty_parsed_api(): ParsedApi =
    ParsedApi(List[Decl].new(), List[Decl].new(), List[Decl].new(), List[Decl].new());

let merge_parsed(target: ParsedApi, parsed: ParsedApi): Void = {
    for item in parsed.free_functions then {
        target.free_functions.push(item);
    };
    for item in parsed.traits then {
        target.traits.push(item);
    };
    for item in parsed.types then {
        target.types.push(item);
    };
    for item in parsed.givens then {
        target.givens.push(item);
    };
};

// ============================================================================
// Extraction: a walk over the CST
// ============================================================================

/// Everything a consumer of the file can see, in source order, each entry
/// carrying the `///` run that documents it. What reaches a page is decided in
/// `decl_is_shown`; what is shown of each declaration is decided by
/// `Printer.print_signature`. Anything shown without a doc comment is recorded
/// in `missing`.
let parse_public_api(
    file_path: Path,
    public_types: List[String],
    missing: List[String],
): ParsedApi = {
    let api = empty_parsed_api();

    let text = read_text_file(file_path) or else as e in {
        eprintln("Warning: failed to read \(file_path.to_string()): \(e.message())");
        return api;
    };

    let file = parse_source(text) or else as e in {
        eprintln("Warning: failed to parse \(file_path.to_string()): \(e.message())");
        return api;
    };

    collect_file_api(api, file, public_types, missing);
    return api;
};

/// The walk shared by page rendering and the self-test: every shown
/// declaration of `file`, with its docs, in source order.
let collect_file_api(
    api: ParsedApi,
    file: CstFile,
    public_types: List[String],
    missing: List[String],
): Void = {
    for pair in file.items.lazy().enumerate() then {
        when pair.second in {
            .Decl(d) or .DeclPreSemi(_, d) then {
                collect_decl(api, file.items, pair.first, d, public_types, missing);
            },
            _ then {},
        };
    };
};

let parse_source(text: String): Result[CstFile] = {
    let mutable tokenizer = Tokenizer.new(text);
    let tokens = tokenizer.tokenize() or return;
    let mutable parser = CstParser.new(tokens);
    return parser.parse();
};

/// Whether `d` reaches a module page. A top-level declaration must say
/// `public`. A `given` never can (grammar.bnf <given-decl>), so it is part of
/// the story only when the thing it extends is one a consumer can name -- a
/// `public` type (`given BufReader[R]`, `given Int: Add[Int]`) or trait (the
/// trait-tool block `given Ord { ... }`), or a language-level shape like
/// `*T` / `?T` that every consumer spells for themselves. A `given` for a
/// module-internal type is implementation detail, and printing it would leak
/// that type's name into the public docs.
let decl_is_shown(d: CstDecl, public_types: List[String]): Bool = when d in {
    .Given(_, _, _, _, target, _, _, _, _, _) then {
        when target_type_name(target) in {
            .Some(name) then public_types.contains(name),
            .None() then true,
        }
    },
    _ then Printer.is_public(Printer.decl_visibility(d)),
};

/// The nominal name at the head of a `given` target: `Box` for `Box[R]`, seen
/// through `mutable` / parenthesized wrappers. `None` when the target names
/// no nominal type -- a pointer (`*T`), a weak reference (`?T`), a function
/// type, `Self` -- where the shape itself is language-level and no module
/// declaration stands behind the name.
let target_type_name(t: CstType): Option[String] = when t in {
    .Named(name) then Option[String].Some(name.to_string()),
    .Generic(_, _, _, base) then .Some(base.to_string()),
    .Mutable(inner, _) or .Paren(_, inner, _) then target_type_name(inner),
    .Ptr(_, _) or .Weakref(_, _) or .SelfType(_) or .ConstraintKeyword(_) or .Function(_, _, _, _)
    or .ForeignFunction(_, _, _, _, _) then Option[String].None(),
};

/// Every `public` type and trait name declared in `file` -- the names a
/// `given` may extend and still be part of the story. A trait name matters
/// because a trait-tool block (`given Ord { ... }`) targets its trait.
let public_type_names(file: CstFile): List[String] = {
    let mutable names = List[String].new();
    for item in file.items then {
        when item in {
            .Decl(d) or .DeclPreSemi(_, d) then {
                when d in {
                    .Type(vis, _, _, _, _, name, _) or .Trait(vis, _, _, name, _, _, _, _) then {
                        if Printer.is_public(vis) then {
                            names.push(name.to_string());
                        };
                    },
                    _ then {},
                };
            },
            _ then {},
        };
    };
    return names;
};

/// Appends every `public` type name declared in the file. A read or parse
/// failure warns and contributes nothing -- the same policy as the page walk.
let collect_public_type_names_from_file(file_path: Path, into: List[String]): Void = {
    let text = read_text_file(file_path) or else as e in {
        eprintln("Warning: failed to read \(file_path.to_string()): \(e.message())");
        return;
    };
    let file = parse_source(text) or else as e in {
        eprintln("Warning: failed to parse \(file_path.to_string()): \(e.message())");
        return;
    };
    for name in public_type_names(file) then {
        into.push(name);
    };
};

/// Renders a declaration without its body and without the members a consumer
/// cannot reach, then terminates it. The `;` is added here rather than by the
/// printer because this is documentation: the page shows a signature, and a
/// signature ends in a semicolon.
let render_signature(d: CstDecl): String = {
    let mutable printer = Printer.new();
    printer.print_signature(d);
    printer.write_terminator();
    return printer.result();
};

/// The name a missing-doc report hangs `d` on: its own name, or the trait /
/// type a `given` is about.
let decl_report_name(d: CstDecl): String = when d in {
    .Func(_, _, _, _, _, _, name, _, _, _, _, _, _) or .ForeignDecl(_, _, _, _, _, _, name, _, _, _, _) then {
        when name in {
            .Some(t) then t.to_string(),
            .None() then "let",
        }
    },
    .Type(_, _, _, _, _, name, _) or .Trait(_, _, _, name, _, _, _, _) or .Var(_, _, _, name, _)
    or .TraitMethod(_, _, name, _, _, _, _) then name.to_string(),
    .Given(_, _, _, _, target, _, trait_type, _, _, _) then {
        when trait_type in {
            .Some(tt) then "given " + type_to_string(target) + ": " + type_to_string(tt),
            .None() then "given " + type_to_string(target),
        }
    },
    .Using(_) then "using",
};

/// The name a missing-doc report hangs `d`'s members on: the trait name, or
/// the type a `given` extends.
let member_owner_name(d: CstDecl): String = when d in {
    .Trait(_, _, _, name, _, _, _, _) then name.to_string(),
    .Given(_, _, _, _, target, _, _, _, _, _) then {
        when target_type_name(target) in {
            .Some(name) then name,
            .None() then type_to_string(target),
        }
    },
    _ then decl_report_name(d),
};

/// Records every shown member of a trait or `given` that carries no `///` doc
/// comment. `public_only` mirrors the rendering rule: a `given` shows only its
/// `public` members, a trait shows all of them.
let check_member_docs(
    missing: List[String],
    owner: String,
    members: List[CstItem],
    public_only: Bool,
): Void = {
    for pair in members.lazy().enumerate() then {
        when pair.second in {
            .Decl(d) or .DeclPreSemi(_, d) then {
                if public_only and not Printer.is_public(Printer.decl_visibility(d)) then {
                    continue;
                };
                if doc_comments_above(members, pair.first).is_empty() then {
                    missing.push(owner + "." + decl_report_name(d));
                };
            },
            _ then {},
        };
    };
};

let collect_decl(
    api: ParsedApi,
    items: List[CstItem],
    index: UInt,
    d: CstDecl,
    public_types: List[String],
    missing: List[String],
): Void = {
    if not decl_is_shown(d, public_types) then {
        return;
    };

    let docs = doc_comments_above(items, index);
    if docs.is_empty() then {
        missing.push(decl_report_name(d));
    };

    when d in {
        .Func(_, _, _, _, _, _, _, _, _, _, _, _, _) or .ForeignDecl(_, _, _, _, _, _, _, _, _, _, _)
        or .Var(_, _, _, _, _) then {
            api.free_functions.push(Decl(docs, render_signature(d)));
        },
        .Type(_, _, _, _, _, _, _) then {
            api.types.push(Decl(docs, render_signature(d)));
        },
        .Trait(_, _, _, _, _, _, members, _) then {
            check_member_docs(missing, member_owner_name(d), members, false);
            api.traits.push(Decl(docs, render_signature(d)));
        },
        .Given(_, _, _, _, _, _, _, _, members, _) then {
            check_member_docs(missing, member_owner_name(d), members, true);
            api.givens.push(Decl(docs, render_signature(d)));
        },
        _ then {},
    };
};

// ============================================================================
// Page assembly
// ============================================================================

let append_declarations(lines: List[String], declarations: List[Decl]): Void = {
    for idx in 0..<declarations.count() then {
        for doc in declarations[idx].docs then {
            lines.push(doc);
        };
        lines.push(declarations[idx].text);
        if idx + 1 < declarations.count() then {
            lines.push("");
        };
    };
};

/// The whole markdown page for one module, as text. Fails when the module
/// offers an API entry with no `///` doc comment: a page that documents every
/// API is the point of the tool, so an undocumented entry stops the build
/// instead of reaching the page.
let render_module_doc(
    module_key: String,
    source_files: List[String],
    public_types: List[String],
): Result[String] = {
    let module_name = module_key;
    let module_stem = last_segment(module_key);
    let mutable stem_first = List[String].new();
    let mutable rest = List[String].new();
    for source_str in source_files then {
        if file_stem(source_str.into_path()) == module_stem then {
            stem_first.push(source_str);
        } else {
            rest.push(source_str);
        };
    };
    stem_first.sort();
    rest.sort();

    let mutable ordered_sources = stem_first;
    ordered_sources.push_list(rest);

    let mutable missing = List[String].new();
    let mutable parsed_all = empty_parsed_api();
    for source_str in ordered_sources then {
        merge_parsed(
            parsed_all,
            parse_public_api(source_str.into_path(), public_types, missing),
        );
    };

    if not missing.is_empty() then {
        return Result[String].Error(
            "undocumented public API in module " + module_name + ": " + missing.join_to_string(", "),
        );
    };

    let mutable lines = List[String].new();
    // Machine-readable marker first: a rendered HTML comment, so it stays
    // invisible while telling a human editor that this page is not theirs.
    lines.push("<!-- GENERATED by toolchain/doc. Do not edit by hand.");
    lines.push("     Regenerate: bin/toolchain-doc-gen/koral_doc");
    lines.push("     Verify:     bin/toolchain-doc-gen/koral_doc --check -->");
    lines.push("");
    lines.push("# " + module_name + " API");
    lines.push("");
    lines.push("## Overview");
    lines.push(
        "This page lists the public API of module `" + module_name + "` (declaration-only syntax), organized by free functions, traits, types, and given implementations.",
    );
    lines.push("");
    lines.push("Import the module with `using \"" + module_name + "\" { ... };`.");
    lines.push("");

    lines.push("## Free Functions");
    if parsed_all.free_functions.count() > 0 then {
        lines.push("```koral");
        append_declarations(lines, parsed_all.free_functions);
        lines.push("```");
    } else {
        lines.push("(none)");
    };

    lines.push("");
    lines.push("## Traits");
    if parsed_all.traits.count() > 0 then {
        lines.push("```koral");
        append_declarations(lines, parsed_all.traits);
        lines.push("```");
    } else {
        lines.push("(none)");
    };

    lines.push("");
    lines.push("## Types");
    if parsed_all.types.count() > 0 then {
        lines.push("```koral");
        append_declarations(lines, parsed_all.types);
        lines.push("```");
    } else {
        lines.push("(none)");
    };

    lines.push("");
    lines.push("## Given Implementations");
    if parsed_all.givens.count() > 0 then {
        lines.push("```koral");
        append_declarations(lines, parsed_all.givens);
        lines.push("```");
    } else {
        lines.push("(none)");
    };

    lines.push("");

    return Result[String].Ok(lines.join_to_string("\n"));
};

// ============================================================================
// Self-test
// ============================================================================
// The extraction used to be checked against hand-written line lists. Now that a
// declaration is a CST node, the check is against the language: given source
// text, does the page show the right thing?

type mutable SelfTest(mutable failed: Bool);

given SelfTest {

    new(): SelfTest = SelfTest(false);

    contains(self, name: String, text: String, needle: String): Void = {
        if text.contains(needle) then {
            return;
        };
        self.failed = true;
        eprintln("SELF-TEST FAIL: \(name)");
        eprintln("  expected to contain: \(needle)");
        eprintln("  got:");
        eprintln(text);
    };

    not_contains(self, name: String, text: String, needle: String): Void = {
        if not text.contains(needle) then {
            return;
        };
        self.failed = true;
        eprintln("SELF-TEST FAIL: \(name)");
        eprintln("  expected NOT to contain: \(needle)");
        eprintln("  got:");
        eprintln(text);
    };
};

/// The rendered declarations of one self-contained source string: the same
/// selection and doc rules as a module page, in declaration order.
let render_all(source: String): Result[String] = {
    let file = parse_source(source) or return;
    let public_types = public_type_names(file);
    let mutable missing = List[String].new();
    let mutable api = empty_parsed_api();
    collect_file_api(api, file, public_types, missing);

    let mutable out = StringBuilder.new();
    for group in [api.free_functions, api.traits, api.types, api.givens] then {
        for decl in group then {
            for doc in decl.docs then {
                out.push_string(doc);
                out.push_string("\n");
            };
            out.push_string(decl.text);
            out.push_string("\n");
        };
    };
    return .Ok(out.to_string());
};

/// The missing-doc report of one self-contained source string -- what the
/// module-page gate would refuse to publish.
let undocumented_in(source: String): Result[List[String]] = {
    let file = parse_source(source) or return;
    let public_types = public_type_names(file);
    let mutable missing = List[String].new();
    let mutable api = empty_parsed_api();
    collect_file_api(api, file, public_types, missing);
    return .Ok(missing);
};

let run_self_test(): Void = {
    let mutable t = SelfTest.new();

    // Non-public fields stay off the page; the public ones do not. An
    // unmarked field is module-internal by default and stays off too.
    let mixed = render_all(
        "public type Mixed(public visible: String, internal hidden: Int, protected token: Int, private cache: Int, bare: Int);\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render mixed type: \(e.message())");
        exit(1);
    };
    t.contains("type keeps public fields", mixed, "visible");
    t.not_contains("type drops internal fields", mixed, "hidden");
    t.not_contains("type drops protected fields", mixed, "token");
    t.not_contains("type drops private fields", mixed, "cache");
    t.not_contains("type drops unmarked fields (default internal)", mixed, "bare");

    // A `given` shows only its public methods; a trait shows all of them,
    // because a trait's whole body is its interface.
    let given_text = render_all(
        "public type mutable Box[R: Any](value: R);\n" + "given[R: Any] Box[R] {\n" + "    public new(value: R): Box[R] = Box[R](value);\n" + "    private peek(self): R = self.value;\n" + "    get(self): R = self.value;\n" + "};\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render given: \(e.message())");
        exit(1);
    };
    t.contains("given shows public methods", given_text, "public new(value: R): Box[R]");
    t.not_contains("given drops private methods", given_text, "peek");
    t.not_contains("given drops unexported methods", given_text, "get(self): R");

    let trait_text = render_all(
        "public trait Greet {\n" + "    greet(self): String;\n" + "    help(self): String;\n" + "};\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render trait: \(e.message())");
        exit(1);
    };
    t.contains("trait keeps every member", trait_text, "greet(self): String");
    t.contains("trait keeps every member (2)", trait_text, "help(self): String");

    // Bodies are not part of a signature.
    let function_text = render_all(
        "public let add(a: Int, b: Int): Int = {\n" + "    return a + b;\n" + "};\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render function: \(e.message())");
        exit(1);
    };
    t.contains("function signature", function_text, "public let add(a: Int, b: Int): Int;");
    t.not_contains("function body is not shown", function_text, "return");

    // A declaration that is not `public` is not part of the public API. A
    // `given` has no access modifier, but it is shown only for a type a
    // consumer can name: `Secret` is module-internal here, so its `given`
    // stays off the page with it.
    let private_text = render_all(
        "let hidden(): Int = 1;\n" + "type Secret(value: Int);\n" + "trait Quiet { q(self): Int; };\n" + "given Secret {\n" + "    public reveal(self): Int = self.value;\n" + "};\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render private decls: \(e.message())");
        exit(1);
    };
    t.not_contains("non-public function is skipped", private_text, "hidden");
    t.not_contains("non-public type is skipped", private_text, "Secret");
    t.not_contains("non-public trait is skipped", private_text, "Quiet");
    t.not_contains("given of non-public type is skipped", private_text, "reveal");

    // A `given` for a public type is part of the story even though the block
    // itself carries no access modifier -- and so is a `given` for a built-in
    // type, whose `public type intrinsic` declaration names it.
    let given_public = render_all(
        "public type intrinsic Int;\n" + "public trait Zero {\n" + "    zero(): Self;\n" + "};\n" + "given Int: Zero {\n" + "    public zero(): Int = 0;\n" + "};\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render public-type given: \(e.message())");
        exit(1);
    };
    t.contains("given of public type is shown", given_public, "given Int: Zero");
    t.contains("given of built-in type is shown", given_public, "public zero(): Int");

    // A trait-tool block -- `given Trait { ... }` -- targets its trait, which
    // is just as nameable, so it is shown with its public methods.
    let tool_text = render_all(
        "public trait Ord {\n" + "    compare(self, other: Self): Int;\n" + "};\n" + "given Ord {\n" + "    public clamp(self, min: Self =, max: Self =): Self;\n" + "};\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render trait-tool block: \(e.message())");
        exit(1);
    };
    t.contains("trait-tool block is shown", tool_text, "given Ord");
    t.contains("trait-tool methods are shown", tool_text, "clamp");

    // A `given` on a language-level shape (`*T`) names no module type: every
    // consumer spells the target for themselves, so it is always part of the
    // story.
    let ptr_text = render_all(
        "given[T: Any] *T: Eq {\n" + "    public equals(self, other: *T): Bool = true;\n" + "};\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render pointer given: \(e.message())");
        exit(1);
    };
    t.contains("pointer given is shown", ptr_text, "given[T: Any] *T: Eq");

    // Doc comments ride above the entry they document -- the declaration
    // itself and the members a trait or `given` shows. An ordinary `//` note
    // is not documentation and stays off the page.
    let doc_text = render_all(
        "/// Adds two numbers.\n" + "public let add(a: Int, b: Int): Int = a + b;\n" + "\n" + "// just a note\n" + "/// A stack.\n" + "public type Stack;\n" + "\n" + "/// Reader surface.\n" + "public trait Reader {\n" + "    /// Reads one byte.\n" + "    read(self): Option[UInt8];\n" + "};\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render doc comments: \(e.message())");
        exit(1);
    };
    t.contains("doc comment renders above a function", doc_text, "/// Adds two numbers.");
    t.contains("doc comment renders above a type", doc_text, "/// A stack.");
    t.contains("doc comment renders above a trait", doc_text, "/// Reader surface.");
    t.contains("doc comment renders above a member", doc_text, "/// Reads one byte.");
    t.not_contains("ordinary comment is not documentation", doc_text, "just a note");

    // Every entry a page shows must carry its documentation; the gate names
    // what is missing so it can be fixed in the source.
    let undocumented = undocumented_in(
        "/// Documented.\n" + "public let documented(): Int = 1;\n" + "public let bare(): Int = 2;\n" + "public trait T {\n" + "    /// Documented.\n" + "    a(self): Int;\n" + "    b(self): Int;\n" + "};\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not report missing docs: \(e.message())");
        exit(1);
    };
    let report = undocumented.join_to_string(", ");
    t.contains("undocumented function is reported", report, "bare");
    t.contains("undocumented member is reported", report, "T.b");
    t.not_contains("documented function is not reported", report, "documented");
    t.not_contains("documented member is not reported", report, "T.a");

    let documented_only = undocumented_in(
        "/// Documented.\n" + "public let documented(): Int = 1;\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not report missing docs: \(e.message())");
        exit(1);
    };
    if not documented_only.is_empty() then {
        t.failed = true;
        eprintln("SELF-TEST FAIL: fully documented source reports nothing");
        eprintln("  got: \(documented_only.join_to_string(", "))");
    };

    // Comments and multiline strings live inside tokens; a line scanner
    // mis-reads them, the parser does not.
    let comment_text = render_all(
        "public type Span(\n" + "    // how far it reaches\n" + "    public length: UInt,\n" + ");\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render commented type: \(e.message())");
        exit(1);
    };
    t.contains("commented field list keeps its fields", comment_text, "length: UInt");

    // Weak references (`?T`) and default values (`name: T = literal`) are part
    // of a signature's meaning. Both have been dropped here before.
    let weak_text = render_all(
        "public let intrinsic downgrade[T: mutable](val: T): ?T;\n" + "public let intrinsic upgrade[T: mutable](val: ?T): Option[T];\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render weak refs: \(e.message())");
        exit(1);
    };
    t.contains("weak return type", weak_text, "downgrade[T: mutable](val: T): ?T;");
    t.contains("weak parameter type", weak_text, "upgrade[T: mutable](val: ?T): Option[T];");

    let default_text = render_all(
        "public trait Reader {\n" + "    read(self, into: List[UInt8] =, span: Range[UInt] = ...): Result[UInt];\n" + "};\n" + "public type Span(public length: UInt = 0, public label: String = \"x\");\n",
    ) or else as e in {
        eprintln("SELF-TEST FAIL: could not render defaults: \(e.message())");
        exit(1);
    };
    t.contains("range default keeps its elision", default_text, "span: Range[UInt] = ...");
    t.contains("integer default", default_text, "length: UInt = 0");
    t.contains("string default", default_text, "label: String = \"x\"");

    // A module is named the way `using` names it: `std/io`, never `Std.Io`.
    if module_key_for_source(
        "std/io/io.koral".into_path(),
        "std".into_path(),
    ) != "std/io" then {
        t.failed = true;
        eprintln("SELF-TEST FAIL: nested module key");
        eprintln("  expected: std/io");
    };
    if module_key_for_source(
        "std/std.koral".into_path(),
        "std".into_path(),
    ) != "std" then {
        t.failed = true;
        eprintln("SELF-TEST FAIL: root module key");
        eprintln("  expected: std");
    };

    if t.failed then {
        eprintln("SELF-TEST FAILED");
        exit(1);
    };
    println("self-test passed");
};

// ============================================================================
// Module naming
// ============================================================================

/// `std/io/io.koral` -> `std/io`, `std/std.koral` -> `std`. The key is the
/// directory path under the library root: the module's real name, the same
/// string a `using` specifier writes. A file name is not part of it, since a
/// module may span several files.
let module_key_for_source(source: Path, std_root: Path): String = {
    let root_name = std_root.base_name();
    let rel = source.to_string().trim_prefix(std_root.to_string()).trim_prefix("/");

    let mutable parts = List[String].new();
    for part in rel.split("/") then {
        parts.push(part);
    };
    if parts.count() > 0 then {
        parts.pop();
    };
    if parts.is_empty() then {
        return root_name;
    };
    return root_name + "/" + parts.join_to_string("/");
};

let file_stem(path: Path): String = {
    let base = path.base_name();
    let ext = path.ext_name();
    if ext.is_empty() or base.count() <= ext.count() then {
        return base;
    };
    return base.substring(0..<(base.count() - ext.count()));
};

let last_segment(key: String): String = when key.find_last("/") in {
    .Some(idx) then key.substring((idx + 1)...),
    .None() then key,
};

// ============================================================================
// Filesystem
// ============================================================================

let clear_generated_docs_recursive(path: Path): Void = {
    let mutable entries = read_dir(path) or else {
        return;
    };

    while entries.next() is .Some(entry) then {
        let full_path = entry.path();
        if entry.is_dir() then {
            clear_generated_docs_recursive(full_path);
            let _ = remove_dir(full_path);
        } else {
            if entry.name().ends_with(".md") then {
                let _ = remove_file(full_path);
            };
        };
    };
};

let clear_generated_docs(docs_root: Path): Void = {
    if not path_exist(docs_root) then {
        let _ = create_dir_all(docs_root);
        return;
    };
    clear_generated_docs_recursive(docs_root);
};

let collect_koral_sources(root: Path): Result[List[String]] = {
    let mutable out = List[String].new();
    let mutable walker = walk_dir(root) or return;

    while walker.next() is .Some(entry) then {
        if entry.is_file() and entry.name().ends_with(".koral") then {
            out.push(entry.path().to_string());
        };
    };

    return Result[List[String]].Ok(out);
};

let find_repo_root(): Result[Path] = {
    let mutable cursor = current_dir() or return;

    for _ in 0..<12 then {
        let marker = cursor.join("std/std.koral");
        if path_exist(marker) then {
            return Result[Path].Ok(cursor);
        };

        let parent = cursor.dir_name();
        if parent.to_string() == cursor.to_string() then {
            break;
        };
        cursor = parent;
    };

    return Result[Path].Error(
        "Cannot locate repo root (missing std/std.koral). Please run under the repository or set working directory accordingly.",
    );
};

// ============================================================================
// Entry point
// ============================================================================

let main(): Void = {
    let args = args();
    let mutable check_only = false;
    for i in 1..<args.count() then {
        if args[i] == "--self-test" then {
            run_self_test();
            return;
        };
        if args[i] == "--check" then {
            check_only = true;
        };
    };

    let repo_root = find_repo_root() or else as e in {
        eprintln("Error: \(e.message())");
        exit(1);
    };

    let std_root = repo_root.join("std");
    // Output root is a generator-exclusive leaf: `clear_generated_docs` deletes
    // every `.md` under it before writing, so nothing hand-written may live here.
    // `docs/api/README.md` deliberately sits one level above it.
    let docs_root = repo_root.join("docs").join("api").join("std");

    let mutable source_files = collect_koral_sources(std_root) or else as e in {
        eprintln("Error collecting std sources: \(e.message())");
        exit(1);
    };

    source_files.sort();

    // One name table for all of `std/`: a `given` is public story only when the
    // type it extends is `public`, wherever that type is declared.
    let mutable public_types = List[String].new();
    for source_str in source_files then {
        collect_public_type_names_from_file(source_str.into_path(), public_types);
    };

    let grouped = source_files.group_by(
        (source_str) => module_key_for_source(source_str.into_path(), std_root),
    );

    let mutable module_keys = List[String].new();
    for entry in grouped then {
        module_keys.push(entry.first);
    };
    module_keys.sort();

    // `--check` proves the pages on disk are what the tool would write, without
    // touching them. Generated docs are checked in; a change to `std/` that is
    // not followed by a regeneration is a stale page, and this is what says so.
    let mutable stale: UInt = 0;

    // Every page is rendered before any page is written or checked: a module
    // with undocumented API stops the whole run -- every gap is reported, not
    // just the first -- and a half-written docs tree is worse than none.
    let mutable pending_paths = List[Path].new();
    let mutable pending_pages = List[String].new();
    let mutable failures = List[String].new();

    for module_key in module_keys then {
        let files = grouped.get(module_key).unwrap();
        let output = docs_root.join(
            last_segment(module_key).to_ascii_lowercase() + ".md",
        );
        let page = render_module_doc(module_key, files, public_types) or else as e in {
            failures.push(e.message());
            continue;
        };
        pending_paths.push(output);
        pending_pages.push(page);
    };

    if not failures.is_empty() then {
        for message in failures then {
            eprintln(message);
        };
        eprintln(
            "\(failures.count()) module page(s) cannot be published until their undocumented API is described",
        );
        exit(1);
    };

    if not check_only then {
        clear_generated_docs(docs_root);
    };

    for idx in 0..<pending_paths.count() then {
        let output = pending_paths[idx];
        let page = pending_pages[idx];
        if check_only then {
            let existing = read_text_file(output) or else as e in {
                stale += 1;
                eprintln("STALE: \(output.to_string()) -- \(e.message())");
                continue;
            };
            if existing != page then {
                stale += 1;
                eprintln(
                    "STALE: \(output.to_string()) does not match what the generator would write",
                );
            };
        } else {
            let _ = write_text_file(output, content = page) or else as e in {
                eprintln("Error writing \(output.to_string()): \(e.message())");
                exit(1);
            };
        };
    };

    if check_only then {
        if stale > 0 then {
            eprintln(
                "\(stale) generated page(s) are out of date; run the generator to refresh them",
            );
            exit(1);
        };
        println("generated docs are up to date (\(module_keys.count()) modules)");
        return;
    };

    println("Generated \(module_keys.count()) module docs in \(docs_root.to_string())");
};
