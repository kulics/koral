// ============================================================================
// Standard Library API Doc Generator
// ============================================================================
// Walks the Koral sources of `std/` and writes one markdown page per module,
// listing its public API in declaration-only syntax.
//
// Extraction goes through `koral_syntax`, the same tokenizer, parser and
// printer the formatter uses. An earlier version of this tool scanned raw lines
// and counted braces to guess where declarations began and ended; it could not
// tell a `//` inside a string from a comment, and its idea of a signature was
// whatever text happened to sit between two heuristics. Here a declaration is a
// CST node, and the text on the page is printed by the one printer that knows
// how Koral is spelled -- so a signature in these docs is the syntax the
// formatter would write for it.
// ============================================================================

using "koral_syntax";

using "std/os";

// ============================================================================
// What gets collected
// ============================================================================

/// One rendered declaration, already in its final spelling. Multi-line by
/// construction -- a type with a body, say -- so it is kept as text rather than
/// re-split into lines.
type Decl(text String);

type mutable ParsedApi(
    mutable free_functions List[Decl],
    mutable traits List[Decl],
    mutable types List[Decl],
    mutable givens List[Decl],
);

let empty_parsed_api() ParsedApi =
    ParsedApi(List[Decl].new(), List[Decl].new(), List[Decl].new(), List[Decl].new());

let merge_parsed(target ParsedApi, parsed ParsedApi) Void = {
    for item in parsed.free_functions then {
        target.free_functions.push(item);
    };
    for item in parsed.traits then {
        target.traits.push(item);
    };
    for item in parsed.types then {
        target.types.push(item);
    };
    for item in parsed.givens then {
        target.givens.push(item);
    };
};

// ============================================================================
// Extraction: a walk over the CST
// ============================================================================

/// Everything a consumer of the file can see, in source order. The filtering
/// rule lives in `Printer.print_signature` -- one place decides what "the public
/// API" of a declaration is, and this tool only sorts the results into pages.
let parse_public_api(file_path Path) ParsedApi = {
    let api = empty_parsed_api();

    let text = read_text_file(file_path) or else {
        eprintln("Warning: failed to read \(file_path.to_string()): \(it.message())");
        return api;
    };

    let file = parse_source(text) or else {
        eprintln("Warning: failed to parse \(file_path.to_string()): \(it.message())");
        return api;
    };

    for item in file.items then {
        when item in {
            .Decl(d) then {
                collect_decl(api, d);
            },
            _ then {},
        };
    };

    return api;
};

let parse_source(text String) Result[CstFile] = {
    let mutable tokenizer = Tokenizer.new(text);
    let tokens = tokenizer.tokenize() or return;
    let mutable parser = CstParser.new(tokens);
    return parser.parse();
};

/// Renders a declaration without its body and without the members a consumer
/// cannot reach, then terminates it. The `;` is added here rather than by the
/// printer because this is documentation: the page shows a signature, and a
/// signature ends in a semicolon.
let render_signature(d CstDecl) Decl = {
    let mutable printer = Printer.new();
    printer.print_signature(d);
    printer.write_terminator();
    return Decl(printer.result());
};

let collect_decl(api ParsedApi, d CstDecl) Void = {
    if not Printer.is_public(Printer.decl_visibility(d)) then {
        // A `given` block carries no access modifier and is always part of the
        // story -- it is where a type meets its traits.
        when d in {
            .Given(_, _, _, _, _, _, _, _, _, _) then {
                api.givens.push(render_signature(d));
            },
            _ then {},
        };
        return;
    };

    when d in {
        .Func(_, _, _, _, _, _, _, _, _, _, _, _) then {
            api.free_functions.push(render_signature(d));
        },
        .ForeignDecl(_, _, _, _, _, _, _, _, _, _) then {
            api.free_functions.push(render_signature(d));
        },
        .Var(_, _, _, _, _) then {
            api.free_functions.push(render_signature(d));
        },
        .Type(_, _, _, _, _, _, _) then {
            api.types.push(render_signature(d));
        },
        .Trait(_, _, _, _, _, _, _, _) then {
            api.traits.push(render_signature(d));
        },
        .Given(_, _, _, _, _, _, _, _, _, _) then {
            api.givens.push(render_signature(d));
        },
        _ then {},
    };
};

// ============================================================================
// Page assembly
// ============================================================================

let append_declarations(lines List[String], declarations List[Decl]) Void = {
    for idx in 0..<declarations.count() then {
        lines.push(declarations[idx].text);
        if idx + 1 < declarations.count() then {
            lines.push("");
        };
    };
};

/// The whole markdown page for one module, as text.
let render_module_doc(module_key String, source_files List[String]) Result[String] = {
    let module_name = module_name_from_key(module_key);
    let module_stem = last_segment(module_key);
    let mutable stem_first = List[String].new();
    let mutable rest = List[String].new();
    for source_str in source_files then {
        if to_pascal_case(file_stem(source_str.into_path())) == module_stem then {
            stem_first.push(source_str);
        } else {
            rest.push(source_str);
        };
    };
    stem_first.sort();
    rest.sort();

    let mutable ordered_sources = stem_first;
    ordered_sources.push_list(rest);

    let mutable parsed_all = empty_parsed_api();
    for source_str in ordered_sources then {
        merge_parsed(parsed_all, parse_public_api(source_str.into_path()));
    };

    let mutable lines = List[String].new();
    // Machine-readable marker first: a rendered HTML comment, so it stays
    // invisible while telling a human editor that this page is not theirs.
    lines.push("<!-- GENERATED by toolchain/doc. Do not edit by hand.");
    lines.push("     Regenerate: bin/toolchain-doc-gen/koral_doc");
    lines.push("     Verify:     bin/toolchain-doc-gen/koral_doc --check -->");
    lines.push("");
    lines.push("# " + module_name + " API");
    lines.push("");
    lines.push("## Overview");
    lines.push(
        "This page lists the public API of module `" + module_name + "` (declaration-only syntax), organized by free functions, traits, types, and given implementations.",
    );
    lines.push("");

    lines.push("## Free Functions");
    if parsed_all.free_functions.count() > 0 then {
        lines.push("```koral");
        append_declarations(lines, parsed_all.free_functions);
        lines.push("```");
    } else {
        lines.push("(none)");
    };

    lines.push("");
    lines.push("## Traits");
    if parsed_all.traits.count() > 0 then {
        lines.push("```koral");
        append_declarations(lines, parsed_all.traits);
        lines.push("```");
    } else {
        lines.push("(none)");
    };

    lines.push("");
    lines.push("## Types");
    if parsed_all.types.count() > 0 then {
        lines.push("```koral");
        append_declarations(lines, parsed_all.types);
        lines.push("```");
    } else {
        lines.push("(none)");
    };

    lines.push("");
    lines.push("## Given Implementations");
    if parsed_all.givens.count() > 0 then {
        lines.push("```koral");
        append_declarations(lines, parsed_all.givens);
        lines.push("```");
    } else {
        lines.push("(none)");
    };

    lines.push("");

    return Result[String].Ok(lines.join_to_string("\n"));
};

// ============================================================================
// Self-test
// ============================================================================
// The extraction used to be checked against hand-written line lists. Now that a
// declaration is a CST node, the check is against the language: given source
// text, does the page show the right thing?

type mutable SelfTest(mutable failed Bool);

given SelfTest {

    new() SelfTest = SelfTest(false);

    contains(self, name String, text String, needle String) Void = {
        if text.contains(needle) then {
            return;
        };
        self.failed = true;
        eprintln("SELF-TEST FAIL: \(name)");
        eprintln("  expected to contain: \(needle)");
        eprintln("  got:");
        eprintln(text);
    };

    not_contains(self, name String, text String, needle String) Void = {
        if not text.contains(needle) then {
            return;
        };
        self.failed = true;
        eprintln("SELF-TEST FAIL: \(name)");
        eprintln("  expected NOT to contain: \(needle)");
        eprintln("  got:");
        eprintln(text);
    };
};

let render_all(source String) Result[String] = {
    let file = parse_source(source) or return;
    let mutable out = StringBuilder.new();
    for item in file.items then {
        when item in {
            .Decl(d) then {
                if not Printer.is_public(Printer.decl_visibility(d)) then {
                    when d in {
                        .Given(_, _, _, _, _, _, _, _, _, _) then {},
                        _ then {
                            continue;
                        },
                    };
                };
                let rendered = render_signature(d);
                out.push_string(rendered.text);
                out.push_string("\n");
            },
            _ then {},
        };
    };
    return .Ok(out.to_string());
};

let run_self_test() Void = {
    let mutable t = SelfTest.new();

    // Non-public fields stay off the page; the public ones do not.
    let mixed = render_all(
        "public type Mixed(public_name String, module_private hidden Int, package_private token Int, file_private cache Int);\n",
    ) or else {
        eprintln("SELF-TEST FAIL: could not render mixed type: \(it.message())");
        exit(1);
    };
    t.contains("type keeps public fields", mixed, "public_name");
    t.not_contains("type drops module_private fields", mixed, "hidden");
    t.not_contains("type drops package_private fields", mixed, "token");
    t.not_contains("type drops file_private fields", mixed, "cache");

    // A `given` shows only its public methods; a trait shows all of them,
    // because a trait's whole body is its interface.
    let given_text = render_all(
        "type mutable Box[R Any](value R);\n" + "given[R Any] Box[R] {\n" + "    public new(value R) Box[R] = Box[R](value);\n" + "    file_private peek(self) R = self.value;\n" + "    get(self) R = self.value;\n" + "};\n",
    ) or else {
        eprintln("SELF-TEST FAIL: could not render given: \(it.message())");
        exit(1);
    };
    t.contains("given shows public methods", given_text, "public new(value R) Box[R]");
    t.not_contains("given drops file_private methods", given_text, "peek");
    t.not_contains("given drops unexported methods", given_text, "get(self)");

    let trait_text = render_all(
        "public trait Greet {\n" + "    greet(self) String;\n" + "    help(self) String;\n" + "};\n",
    ) or else {
        eprintln("SELF-TEST FAIL: could not render trait: \(it.message())");
        exit(1);
    };
    t.contains("trait keeps every member", trait_text, "greet(self) String");
    t.contains("trait keeps every member (2)", trait_text, "help(self) String");

    // Bodies are not part of a signature.
    let function_text = render_all(
        "public let add(a Int, b Int) Int = {\n" + "    return a + b;\n" + "};\n",
    ) or else {
        eprintln("SELF-TEST FAIL: could not render function: \(it.message())");
        exit(1);
    };
    t.contains("function signature", function_text, "public let add(a Int, b Int) Int;");
    t.not_contains("function body is not shown", function_text, "return");

    // A declaration that is not `public` is not part of the public API -- and
    // `given` is the exception, since it carries no access modifier at all.
    let private_text = render_all(
        "let hidden() Int = 1;\n" + "type Secret(value Int);\n" + "trait Quiet { q(self) Int; };\n",
    ) or else {
        eprintln("SELF-TEST FAIL: could not render private decls: \(it.message())");
        exit(1);
    };
    t.not_contains("non-public function is skipped", private_text, "hidden");
    t.not_contains("non-public type is skipped", private_text, "Secret");
    t.not_contains("non-public trait is skipped", private_text, "Quiet");

    // Comments and multiline strings live inside tokens; a line scanner
    // mis-reads them, the parser does not.
    let comment_text = render_all(
        "public type Span(\n" + "    // how far it reaches\n" + "    length UInt,\n" + ");\n",
    ) or else {
        eprintln("SELF-TEST FAIL: could not render commented type: \(it.message())");
        exit(1);
    };
    t.contains("commented field list keeps its fields", comment_text, "length UInt");

    // Weak references (`?T`) and default values (`name: T = literal`) are part
    // of a signature's meaning. Both have been dropped here before.
    let weak_text = render_all(
        "public intrinsic let downgrade[T mutable](val T) ?T;\n" + "public intrinsic let upgrade[T mutable](val ?T) Option[T];\n",
    ) or else {
        eprintln("SELF-TEST FAIL: could not render weak refs: \(it.message())");
        exit(1);
    };
    t.contains("weak return type", weak_text, "downgrade[T mutable](val T) ?T;");
    t.contains("weak parameter type", weak_text, "upgrade[T mutable](val ?T) Option[T];");

    let default_text = render_all(
        "public trait Reader {\n" + "    read(self, into: List[UInt8], span: Range[UInt] = ..) Result[UInt];\n" + "};\n" + "public type Span(length: UInt = 0, label: String = \"x\");\n",
    ) or else {
        eprintln("SELF-TEST FAIL: could not render defaults: \(it.message())");
        exit(1);
    };
    t.contains("range default keeps its elision", default_text, "span: Range[UInt] = ..");
    t.contains("integer default", default_text, "length: UInt = 0");
    t.contains("string default", default_text, "label: String = \"x\"");

    if t.failed then {
        eprintln("SELF-TEST FAILED");
        exit(1);
    };
    println("self-test passed");
};

// ============================================================================
// Module naming
// ============================================================================

/// `io` -> `Io`, `json_value` -> `JsonValue`. File and module names are ASCII
/// identifiers, so the uppercase is a byte shift and nothing more.
let to_pascal_case(s String) String = {
    let mutable out = StringBuilder.new();
    let mutable upper_next = true;
    for i in 0..<s.count() then {
        let ch = s[i];
        if ch == '_' then {
            upper_next = true;
            continue;
        };
        if upper_next and ch >= 'a' and ch <= 'z' then {
            out.push_byte(ch - 'a' + 'A');
        } else {
            out.push_byte(ch);
        };
        upper_next = false;
    };
    return out.to_string();
};

/// `std/io/io.koral` -> `Std.Io`, `std/std.koral` -> `Std`. The key is the
/// directory path under the library root; a file name is not part of it, since
/// a module may span several files.
let module_key_for_source(source Path, std_root Path) String = {
    let root_name = to_pascal_case(std_root.base_name());
    let rel = source.to_string().trim_prefix(std_root.to_string()).trim_prefix("/");

    let mutable parts = List[String].new();
    for part in rel.split("/") then {
        parts.push(part);
    };
    if parts.count() > 0 then {
        parts.pop();
    };
    if parts.is_empty() then {
        return root_name;
    };

    let mutable names = List[String].new();
    for part in parts then {
        names.push(to_pascal_case(part));
    };
    return root_name + "." + names.join_to_string(".");
};

let module_name_from_key(key String) String = key;

let file_stem(path Path) String = {
    let base = path.base_name();
    let ext = path.ext_name();
    if ext.is_empty() or base.count() <= ext.count() then {
        return base;
    };
    return base.substring(0..<(base.count() - ext.count()));
};

let last_segment(key String) String = when key.find_last(".") in {
    .Some(idx) then key.substring((idx + 1)..),
    .None() then key,
};

// ============================================================================
// Filesystem
// ============================================================================

let clear_generated_docs_recursive(path Path) Void = {
    let mutable entries = read_dir(path) or else {
        return;
    };

    while entries.next() is .Some(entry) then {
        let full_path = entry.path();
        if entry.is_dir() then {
            clear_generated_docs_recursive(full_path);
            let _ = remove_dir(full_path);
        } else {
            if entry.name().ends_with(".md") then {
                let _ = remove_file(full_path);
            };
        };
    };
};

let clear_generated_docs(docs_root Path) Void = {
    if not path_exist(docs_root) then {
        let _ = create_dir_all(docs_root);
        return;
    };
    clear_generated_docs_recursive(docs_root);
};

let collect_koral_sources(root Path) Result[List[String]] = {
    let mutable out = List[String].new();
    let mutable walker = walk_dir(root) or return;

    while walker.next() is .Some(entry) then {
        if entry.is_file() and entry.name().ends_with(".koral") then {
            out.push(entry.path().to_string());
        };
    };

    return Result[List[String]].Ok(out);
};

let find_repo_root() Result[Path] = {
    let mutable cursor = current_dir() or return;

    let mutable steps UInt = 0;
    while steps < 12 then {
        let marker = cursor.join("std/std.koral");
        if path_exist(marker) then {
            return Result[Path].Ok(cursor);
        };

        let parent = cursor.dir_name();
        if parent.to_string() == cursor.to_string() then {
            break;
        };
        cursor = parent;
        steps += 1;
    };

    return Result[Path].Error(
        "Cannot locate repo root (missing std/std.koral). Please run under the repository or set working directory accordingly.",
    );
};

// ============================================================================
// Entry point
// ============================================================================

let main() Void = {
    let args = args();
    let mutable check_only = false;
    for i in 1..<args.count() then {
        if args[i] == "--self-test" then {
            run_self_test();
            return;
        };
        if args[i] == "--check" then {
            check_only = true;
        };
    };

    let repo_root = find_repo_root() or else {
        eprintln("Error: \(it.message())");
        exit(1);
    };

    let std_root = repo_root.join("std");
    // Output root is a generator-exclusive leaf: `clear_generated_docs` deletes
    // every `.md` under it before writing, so nothing hand-written may live here.
    // `docs/api/README.md` deliberately sits one level above it.
    let docs_root = repo_root.join("docs").join("api").join("std");

    let mutable source_files = collect_koral_sources(std_root) or else {
        eprintln("Error collecting std sources: \(it.message())");
        exit(1);
    };

    source_files.sort();

    let grouped = source_files.group_by(
        (source_str) -> module_key_for_source(source_str.into_path(), std_root),
    );

    let mutable module_keys = List[String].new();
    let mutable grouped_entries = grouped.iterator();
    while grouped_entries.next() is .Some(entry) then {
        module_keys.push(entry.first);
    };
    module_keys.sort();

    // `--check` proves the pages on disk are what the tool would write, without
    // touching them. Generated docs are checked in; a change to `std/` that is
    // not followed by a regeneration is a stale page, and this is what says so.
    let mutable stale UInt = 0;

    if not check_only then {
        clear_generated_docs(docs_root);
    };

    for module_key in module_keys then {
        let files = grouped.get(module_key).unwrap();
        let page = render_module_doc(module_key, files) or else {
            eprintln("Error rendering doc for \(module_key): \(it.message())");
            exit(1);
        };

        let output = docs_root.join(
            last_segment(module_key).to_ascii_lowercase() + ".md",
        );
        if check_only then {
            let existing = read_text_file(output) or else {
                stale += 1;
                eprintln("STALE: \(output.to_string()) -- \(it.message())");
                continue;
            };
            if existing <> page then {
                stale += 1;
                eprintln(
                    "STALE: \(output.to_string()) does not match what the generator would write",
                );
            };
        } else {
            let _ = write_text_file(output, content: page) or else {
                eprintln("Error writing \(output.to_string()): \(it.message())");
                exit(1);
            };
        };
    };

    if check_only then {
        if stale > 0 then {
            eprintln(
                "\(stale) generated page(s) are out of date; run the generator to refresh them",
            );
            exit(1);
        };
        println("generated docs are up to date (\(module_keys.count()) modules)");
        return;
    };

    println("Generated \(module_keys.count()) module docs in \(docs_root.to_string())");
};
