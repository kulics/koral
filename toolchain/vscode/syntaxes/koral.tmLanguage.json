{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Koral",
  "scopeName": "source.koral",
  "foldingStartMarker": "^\\s*(?:/\\*|//\\s*#?region\\b|(?:let|type|given|using|if|when|while|for)\\b.*\\{\\s*$|\\{\\s*$)",
  "foldingStopMarker": "^\\s*(?:\\*/|//\\s*#?endregion\\b|\\})\\s*$",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#implicit-member"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.koral",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.koral"
            }
          },
          "end": "$\\n?"
        },
        {
          "name": "comment.block.koral",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.koral"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.koral"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.koral",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.koral",
              "match": "\\\\(?:[ntrfv0\\\\\"']|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
            },
            {
              "name": "meta.interpolation.koral",
              "begin": "\\\\\\(",
              "end": "\\)",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.koral",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.koral",
              "match": "\\\\(?:[ntrfv0\\\\\"']|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
            },
            {
              "name": "meta.interpolation.koral",
              "begin": "\\\\\\(",
              "end": "\\)",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.koral",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.koral",
              "match": "\\\\(?:[ntrfv0\\\\\"']|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.koral",
          "match": "\\b\\d[\\d_]*(?:ms|us|ns|s)\\b"
        },
        {
          "name": "constant.numeric.float.koral",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+\\-]?\\d[\\d_]*)\\b"
        },
        {
          "name": "constant.numeric.float.koral",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.binary.koral",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.koral",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.hex.koral",
          "match": "\\b0x[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.integer.koral",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.koral",
          "match": "\\b(?:if|then|else|when|while|for|break|continue|return|yield|defer|is|in)\\b"
        },
        {
          "name": "keyword.operator.word.koral",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "keyword.declaration.koral",
          "match": "\\b(?:let|type|trait|given|using|as)\\b"
        },
        {
          "name": "storage.modifier.koral",
          "match": "\\b(?:mutable|public|file_private|module_private|package_private|foreign|intrinsic|unsafe)\\b"
        },
        {
          "name": "variable.language.koral",
          "match": "\\b(?:self|it|Self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "meta.type.function.koral",
          "begin": "\\bFunc\\s*\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.type.parameters.begin.koral"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.type.parameters.end.koral"
            }
          },
          "patterns": [
            {
              "include": "#types"
            }
          ]
        },
        {
          "name": "support.type.builtin.koral",
          "match": "\\b(?:Int|UInt|Int8|UInt8|Int16|UInt16|Int32|UInt32|Int64|UInt64|Float32|Float64|Bool|String|Void|Rune|Option|Result|List|Dict|Set|Func)\\b"
        },
        {
          "name": "entity.name.type.koral",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.koral",
          "match": "\\b(let)\\s+(\\[[^\\]]*\\])?\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.koral"
            },
            "2": {
              "name": "meta.generic-params.koral"
            },
            "3": {
              "name": "entity.name.function.koral"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.koral",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.koral",
          "match": "<\\.\\.<|<\\.\\.|\\.\\.<|\\.\\.(?![.<])"
        },
        {
          "name": "keyword.operator.arrow.koral",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.koral",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|(?<![=<>!])=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.koral",
          "match": "==|<>|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.bitwise.koral",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.arithmetic.koral",
          "match": "[+\\-*/%]"
        },
        {
          "name": "punctuation.separator.koral",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.koral",
          "match": "(?<=[A-Za-z0-9_\\]\\)])\\."
        },
        {
          "name": "keyword.operator.unsafe-deref.koral",
          "match": "\\bunsafe\\s*\\*"
        }
      ]
    }
  }
}
