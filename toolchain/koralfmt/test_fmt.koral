// ============================================================================
// Koral Formatter - Test Suite
// ============================================================================

using "koral_syntax" { ... };

using "std/os" { ... };

type mutable TestRunner(mutable pass_count UInt, mutable fail_count UInt);

given TestRunner {

    new() TestRunner = TestRunner(0, 0);

    test(self, name String, input String, expected String) Void = {
        when format_source(input) in {
            .Ok(result) then {
                if result == expected then {
                    self.pass_count += 1;
                } else {
                    self.fail_count += 1;
                    println("FAIL: " + name);
                    println("  expected:");
                    println(expected);
                    println("  got:");
                    println(result);
                };
            },
            .Error(e) then {
                self.fail_count += 1;
                println("ERROR: " + name + " - " + e.message());
            },
        };
    };

    test_error_contains(self, name String, input String, expected_substring String) Void = {
        when format_source(input) in {
            .Ok(result) then {
                self.fail_count += 1;
                println("FAIL: " + name);
                println("  expected error containing:");
                println(expected_substring);
                println("  got formatted output:");
                println(result);
            },
            .Error(e) then {
                let message = e.message();
                if message.contains(expected_substring) then {
                    self.pass_count += 1;
                } else {
                    self.fail_count += 1;
                    println("FAIL: " + name);
                    println("  expected error containing:");
                    println(expected_substring);
                    println("  got error:");
                    println(message);
                };
            },
        };
    };

    /// Formats through `format_source_checked`, so the run also asserts the
    /// formatting contract (nothing but `;` and `,` moved) and idempotence.
    /// Anything the raw printer would print by corrupting the source fails here.
    test_checked(self, name String, input String, expected String) Void = {
        when format_source_checked(input) in {
            .Ok(result) then {
                if result == expected then {
                    self.pass_count += 1;
                } else {
                    self.fail_count += 1;
                    println("FAIL: " + name);
                    println("  expected:");
                    println(expected);
                    println("  got:");
                    println(result);
                };
            },
            .Error(e) then {
                self.fail_count += 1;
                println("ERROR: " + name + " - " + e.message());
            },
        };
    };

    summary(self) Void = {
        let total = self.pass_count + self.fail_count;
        println(self.pass_count.to_string() + "/" + total.to_string() + " tests passed");
        if self.fail_count > 0 then {
            exit(1);
        };
    };
};

let main() Void = {
    let mutable t = TestRunner.new();

    // === Basic let bindings ===
    t.test("simple let spacing", "let x=1+2;\n", "let x = 1 + 2;\n");
    t.test("let with type", "let x Int=42;\n", "let x Int = 42;\n");
    t.test("let mutable", "let mutable x=0;\n", "let mutable x = 0;\n");
    t.test("public let", "public let x Int=42;\n", "public let x Int = 42;\n");

    // === Function declarations ===
    t.test(
        "func decl",
        "let add(a Int,b Int) Int=a+b;\n",
        "let add(a Int, b Int) Int = a + b;\n",
    );
    t.test(
        "func with block",
        "let f() Void={\nlet x=1;\nlet y=2;\n};\n",
        "let f() Void = {\n    let x = 1;\n    let y = 2;\n};\n",
    );
    t.test(
        "return stmt",
        "let f() Int={\nreturn 42;\n};\n",
        "let f() Int = {\n    return 42;\n};\n",
    );
    t.test("block tail expr", "let f() Int={\n42\n};\n", "let f() Int = {\n    42\n};\n");
    t.test(
        "defer stmt",
        "let f() Void={\ndefer close();\n};\n",
        "let f() Void = {\n    defer close();\n};\n",
    );
    t.test(
        "block tail expr with stmt",
        "let f() Int={\nfoo();\n42\n};\n",
        "let f() Int = {\n    foo();\n    42\n};\n",
    );
    t.test(
        "defer stmt with semi",
        "let f() Void={\ndefer close();\n};\n",
        "let f() Void = {\n    defer close();\n};\n",
    );
    t.test(
        "block expression stmt only",
        "let f() Void={\nfoo();\nbar();\n};\n",
        "let f() Void = {\n    foo();\n    bar();\n};\n",
    );

    // === Using declarations ===
    // The OPERATION follows from the braces (module-design §3): bare is a
    // merge, braces are an import. The specifier only says where the target
    // is -- `./` or `../` is a local module's entry file, anything else is a
    // registered module's `package[/subpath]`. Forms are a payload: every
    // shape below must survive a round trip unchanged.
    t.test("using", "using \"foo\";\n", "using \"foo\";\n");
    t.test(
        "module using",
        "using \"std/io\"{Reader as IoReader,Writer};\n",
        "using \"std/io\" { Reader as IoReader, Writer };\n",
    );
    t.test("module using all public", "using \"std/io\";\n", "using \"std/io\";\n");
    t.test("file merge", "using \"./helpers.koral\";\n", "using \"./helpers.koral\";\n");
    t.test(
        "file merge parent",
        "using \"../shared/util.koral\";\n",
        "using \"../shared/util.koral\";\n",
    );
    t.test(
        "import inert placeholder",
        "using \"std/os\" { };\n",
        "using \"std/os\" { };\n",
    );
    t.test(
        "import all",
        "using \"std/os\"{...};\n",
        "using \"std/os\" { ... };\n",
    );
    t.test(
        "import all with rename",
        "using \"std/os\" { Config as OsConfig, ... };\n",
        "using \"std/os\" { Config as OsConfig, ... };\n",
    );
    t.test(
        "import all with exclusions",
        "using \"std/os\"{!Config,!Builder,...};\n",
        "using \"std/os\" { !Config, !Builder, ... };\n",
    );
    t.test(
        "local path import",
        "using \"./util.koral\" { util_pub };\n",
        "using \"./util.koral\" { util_pub };\n",
    );

    // === Type declarations ===
    // `type` / `type mutable` are the two nominal forms the language has
    // (grammar.bnf <type-decl>). `mutable` used to be a parse error here.
    // Raw pointers are `*`*T` / `*mutable T` (grammar.bnf
    // <type-prefix>). The managed `*`*T` / `*! T` spellings are gone.
    t.test(
        "raw pointer types",
        "let f(p *mutable Int, q *Int) Void={};\n",
        "let f(p *mutable Int, q *Int) Void = {};\n",
    );
    t.test(
        "type mutable",
        "type mutable Counter(mutable count Int);\n",
        "type mutable Counter(mutable count Int);\n",
    );
    t.test(
        "generic type mutable",
        "type mutable Box[R Mark](value R);\n",
        "type mutable Box[R Mark](value R);\n",
    );
    // `mutable` in a generic PARAMETER constraint is a type-kind constraint
    // keyword, not a type -- `[T mutable]`.
    t.test(
        "mutable constraint",
        "let f[T mutable](v T) Int=0;\n",
        "let f[T mutable](v T) Int = 0;\n",
    );
    t.test(
        "mutable and trait constraint",
        "let f[T mutable and Eq](v T) Int=0;\n",
        "let f[T mutable and Eq](v T) Int = 0;\n",
    );
    // Named params are <func-param> form 2, and trait members follow the same
    // rules -- so `name: Type` belongs there too.
    t.test("named param", "let f(a: Int) Int=a;\n", "let f(a: Int) Int = a;\n");
    // Defaults are a LITERAL, never an expression (grammar.bnf <field>).
    t.test("named field with default", "type P(x: Int=3);\n", "type P(x: Int = 3);\n");
    t.test(
        "named param with default",
        "let f(a: Int=3,b: Int=4) Int=a;\n",
        "let f(a: Int = 3, b: Int = 4) Int = a;\n",
    );
    t.test(
        "enum field with default",
        "type E { C(a: Int=2) };\n",
        "type E {\n    C(a: Int = 2),\n};\n",
    );
    // `-3` is a valid literal default (numeric defaults accept a leading '-').
    // An identifier after '-' is not.
    t.test_error_contains(
        "default must be a literal",
        "type P(x: Int=-a)\n",
        "literal default value",
    );
    t.test(
        "trait named param",
        "trait T {\nm(self, a: Int) Int;\n};\n",
        "trait T {\n    m(self, a: Int) Int;\n};\n",
    );

    t.test(
        "public type tuple",
        "public type Point(x Int,y Int);\n",
        "public type Point(x Int, y Int);\n",
    );

    // === Trait and Given ===
    t.test(
        "trait decl",
        "trait Printable {\nto_string(self) String;\n};\n",
        "trait Printable {\n    to_string(self) String;\n};\n",
    );
    t.test(
        "trait mutable receiver",
        "trait Counter {\nbump(self) Int;\n};\n",
        "trait Counter {\n    bump(self) Int;\n};\n",
    );
    t.test(
        "given block",
        "given Point {\npublic new(x Int,y Int) Point=Point(x,y);\n};\n",
        "given Point {\n    public new(x Int, y Int) Point = Point(x, y);\n};\n",
    );
    t.test(
        "given trait impl",
        "given Point as Eq {\npublic equals(self,other Point) Bool=self.x==other.x;\n};\n",
        "given Point as Eq {\n    public equals(self, other Point) Bool = self.x == other.x;\n};\n",
    );

    // === When/in expressions ===
    t.test(
        "when/in block",
        "when x in {\n1 then true,\n_ then false,\n};\n",
        "when x in {\n    1 then true,\n    _ then false,\n};\n",
    );
    // Arm guards (`pat where cond then body`) sit between the pattern and
    // `then`; the guard is arm-level and the pattern's bindings are visible in
    // it. `if` is the retired spelling and is named when it shows up here.
    t.test_checked(
        "when arm guard",
        "when x in {\n    .Some(n) where n > 0 then 1,\n    .Some(n) then 2,\n    .None() then 3,\n};\n",
        "when x in {\n    .Some(n) where n > 0 then 1,\n    .Some(n) then 2,\n    .None() then 3,\n};\n",
    );
    t.test_checked(
        "when arm guard block body",
        "when x in {\n    .Some(n) where n>0 then { n },\n    _ then 0,\n};\n",
        "when x in {\n    .Some(n) where n > 0 then {\n        n\n    },\n    _ then 0,\n};\n",
    );
    t.test_checked(
        "when arm guard with or pattern",
        "when x in {\n    1 or 2 where ok then 1,\n    _ then 0,\n};\n",
        "when x in {\n    1 or 2 where ok then 1,\n    _ then 0,\n};\n",
    );
    t.test_error_contains(
        "when arm guard needs a condition",
        "when x in {\n    1 where then 2,\n};\n",
        "expected",
    );
    t.test_error_contains(
        "when arm guard retired 'if' spelling",
        "when x in {\n    1 if true then 2,\n};\n",
        "Pattern guards use 'where', not 'if'",
    );

    // Float and rune pattern literals: the bound is a literal in the pattern
    // grammar (grammar.bnf <primary-pattern>, <comparison-pattern>) and round
    // trips as written. A sign hugs its number; a comparison operator gets a
    // space before the bound.
    t.test_checked(
        "float literal pattern",
        "when x in {\n    1.5 then 1,\n    -2.25 then 2,\n    _ then 0,\n};\n",
        "when x in {\n    1.5 then 1,\n    -2.25 then 2,\n    _ then 0,\n};\n",
    );
    t.test_checked(
        "negative float pattern hugs its sign",
        "when x in {\n    - 1.5 then 1,\n    _ then 0,\n};\n",
        "when x in {\n    -1.5 then 1,\n    _ then 0,\n};\n",
    );
    t.test_checked(
        "float comparison pattern",
        "when x in {\n    >1.5 then 1,\n    <= -2.0 then 2,\n    _ then 0,\n};\n",
        "when x in {\n    > 1.5 then 1,\n    <= -2.0 then 2,\n    _ then 0,\n};\n",
    );
    t.test_checked(
        "rune comparison pattern",
        "when c in {\n    >='a' and <= 'z' then 1,\n    _ then 0,\n};\n",
        "when c in {\n    >= 'a' and <= 'z' then 1,\n    _ then 0,\n};\n",
    );
    t.test_error_contains(
        "comparison pattern bound must be a literal",
        "when x in {\n    > true then 1,\n};\n",
        "expected pattern value",
    );

    // === Operators ===
    t.test("unary minus", "let x=-1;\n", "let x = -1;\n");
    t.test("range op", "let r=0..<10;\n", "let r = 0..<10;\n");
    t.test(
        "compound assign",
        "let f() Void={\nx+=1;\n};\n",
        "let f() Void = {\n    x += 1;\n};\n",
    );

    // === Strings ===
    t.test(
        "string interp",
        "let s=\"hello \\(name)\";\n",
        "let s = \"hello \\(name)\";\n",
    );

    // === Comments ===
    t.test("line comment", "// hello world\n", "// hello world\n");
    t.test(
        "trailing comment in block",
        "let f() Void={\nfoo(); // trailing\nbar();\n};\n",
        "let f() Void = {\n    foo(); // trailing\n    bar();\n};\n",
    );
    t.test("crlf normalization", "let x=1;\r\nlet y=2;\r\n", "let x = 1;\nlet y = 2;\n");

    // === Method calls ===
    t.test("method call", "let r=a.add(b);\n", "let r = a.add(b);\n");

    // === Casts and type applications ===
    // Casts spell the target type FIRST: `Type(expr)` (`Int(x)`, `Int64(42)`).
    // A prefixed target type keeps its prefix: `*Int(p)`, `?T(q)`. The
    // old postfix spelling `expr(Type)` is gone.
    t.test(
        "cast target type leads",
        "let main() Void={\nlet y=Int64(42);\nlet z=Int(y);\n};\n",
        "let main() Void = {\n    let y = Int64(42);\n    let z = Int(y);\n};\n",
    );
    t.test(
        "raw pointer cast",
        "let main() Void={\nlet p=*Int(q);\n};\n",
        "let main() Void = {\n    let p = *Int(q);\n};\n",
    );
    t.test(
        "mutable raw pointer cast",
        "let main() Void={\nlet p=*mutable Int(q);\n};\n",
        "let main() Void = {\n    let p = *mutable Int(q);\n};\n",
    );
    t.test(
        "weak reference construction",
        "let main() Void={\nlet w=?T(x);\n};\n",
        "let main() Void = {\n    let w = ?T(x);\n};\n",
    );
    t.test(
        "generic cast target",
        "let main() Void={\nlet v=Option[Int](x);\n};\n",
        "let main() Void = {\n    let v = Option[Int](x);\n};\n",
    );
    // A single operand is the cast spelling; a structural `Type(args)`
    // construction keeps its argument list either way.
    t.test(
        "constructor call keeps its arguments",
        "let main() Void={\nlet p=Pair(1,2);\nlet q=Point(x);\n};\n",
        "let main() Void = {\n    let p = Pair(1, 2);\n    let q = Point(x);\n};\n",
    );
    // Bare `*` still dereferences -- only `*` starts a type.
    t.test(
        "deref of a star argument is not a cast",
        "let main() Void={\nlet v=f(*p);\n};\n",
        "let main() Void = {\n    let v = f(*p);\n};\n",
    );

    // === Mutable and destructuring ===
    // A pair is built with its constructor; `(a, b, c)` destructures a struct
    // by position at any field count.
    t.test(
        "tuple destructuring",
        "let main() Void={\nlet (a,b)=Pair(1,2);\n};\n",
        "let main() Void = {\n    let (a, b) = Pair(1, 2);\n};\n",
    );
    t.test(
        "tuple destructuring three slots",
        "let main() Void={\nlet (a,_,c)=Point3(1,2,3);\n};\n",
        "let main() Void = {\n    let (a, _, c) = Point3(1, 2, 3);\n};\n",
    );
    // There is no pair literal. A `Pair` is built with its own constructor.
    t.test_error_contains(
        "pair literal rejected",
        "let main() Void={\nlet p=(1,2);\n};\n",
        "pair literal",
    );
    // A list kept on one line has no trailing comma; one the formatter exploded
    // across lines always does. The author's comma is not preserved -- it is a
    // separator, and the line shape is what decides it.
    t.test(
        "collection literals drop inline trailing comma",
        "let main() Void={\nlet xs=[1,2,];\nlet d=[\"a\":1,];\n};\n",
        "let main() Void = {\n    let xs = [1, 2];\n    let d = [\"a\": 1];\n};\n",
    );
    t.test(
        "collection literals",
        "let main() Void={\nlet xs=[1,2];\n};\n",
        "let main() Void = {\n    let xs = [1, 2];\n};\n",
    );
    t.test(
        "qualified trait call",
        "let main() Void={\nlet r=Num(Tag).plus_ten(n,);\n};\n",
        "let main() Void = {\n    let r = Num(Tag).plus_ten(n);\n};\n",
    );
    // The prefix `base(Trait)` is never standalone: the written form is always
    // the composite `base(Trait).method(...)`, for a type name or any receiver.
    t.test(
        "receiver-qualified trait call",
        "let main() Void={\nlet r=value(Tag).plus_ten(1);\n};\n",
        "let main() Void = {\n    let r = value(Tag).plus_ten(1);\n};\n",
    );
    t.test(
        "qualified generic method call",
        "let main() Void={\nlet r=Num(Tag).plus_ten[Int](n);\n};\n",
        "let main() Void = {\n    let r = Num(Tag).plus_ten[Int](n);\n};\n",
    );
    t.test_error_contains(
        "old postfix cast rejected",
        "let main() Void={\nlet y=x(Int);\n};\n",
        "A qualified call must include its method call",
    );
    t.test_error_contains(
        "bare qualified trait prefix rejected",
        "let main() Void={\nlet r=Num(Tag);\n};\n",
        "A qualified call must include its method call",
    );
    t.test_error_contains(
        "qualified trait without method call rejected",
        "let main() Void={\nlet r=Num(Tag).plus_ten;\n};\n",
        "A qualified call must include its method call",
    );
    // Exploded argument lists end in a comma so the next edit is one line.
    t.test(
        "exploded call args keep a trailing comma",
        "let main() Void={\nreturn f(a_very_long_argument_one,a_very_long_argument_two,a_very_long_argument_three,a_very_long_argument_four);\n};\n",
        "let main() Void = {\n    return f(\n        a_very_long_argument_one,\n        a_very_long_argument_two,\n        a_very_long_argument_three,\n        a_very_long_argument_four,\n    );\n};\n",
    );
    t.test(
        "named params in declaration",
        "let connect(host String,port: Int) Void={};\n",
        "let connect(host String, port: Int) Void = {};\n",
    );
    t.test(
        "package private access token",
        "package_private let value Int=1;\n",
        "package_private let value Int = 1;\n",
    );
    t.test_error_contains(
        "given not trait rejected",
        "given Kind not Deref;\n",
        "expected '{', got 'not'",
    );
    t.test(
        "trait parent list",
        "trait FloatMath Numeric and Div[Self] and Neg {\n};\n",
        "trait FloatMath Numeric and Div[Self] and Neg {};\n",
    );

    // === Multiple declarations ===
    t.test("multi decl", "let x=1;\nlet y=2;\n", "let x = 1;\nlet y = 2;\n");

    // === Idempotency ===
    t.test("idempotent simple", "let x = 1 + 2;\n", "let x = 1 + 2;\n");
    t.test(
        "idempotent trait",
        "trait Foo {\n    bar(self) Int;\n};\n",
        "trait Foo {\n    bar(self) Int;\n};\n",
    );

    // === Rejected stale syntax ===
    t.test_error_contains(
        "foreign using removed",
        "foreign using \"math\"\n",
        "Unexpected token: foreign",
    );
    t.test_error_contains(
        "using alias removed",
        "using \"foo\" as Bar\n",
        "takes no alias",
    );
    t.test_error_contains(
        "using all public must stand alone",
        "using \"std/io\" { .., Reader }\n",
        "'..' is not an import item",
    );
    t.test_error_contains(
        "using after declaration",
        "let x=1;\nusing \"foo\";\n",
        "using declarations must appear before other top-level declarations",
    );
    t.test(
        "full range argument",
        "type Button(label Range[Int]);\nlet make() Button=Button(...);\n",
        "type Button(label Range[Int]);\nlet make() Button = Button(...);\n",
    );
    // A trailing comment on a `using` sits after the declaration's own `;`.
    // The printer used to append a second `;` at the end of the line, where the
    // line comment swallowed it -- the contract saw a comment token grow a `;`.
    t.test_checked(
        "using with trailing comment",
        "using \"std/io\"; // 全部\n\nlet main() Int = {\n    return 0;\n};\n",
        "using \"std/io\"; // 全部\n\nlet main() Int = {\n    return 0;\n};\n",
    );
    t.test_checked(
        "using with comment before terminator",
        "using \"std/io\" /* c */;\n\nlet main() Int = {\n    return 0;\n};\n",
        "using \"std/io\" /* c */;\n\nlet main() Int = {\n    return 0;\n};\n",
    );
    // `name: Type` is a NAMED field -- a different declaration, not an
    // alternate spelling (grammar.bnf <field>: "named field"). It used to be
    // rejected here, which denied documented syntax.
    t.test(
        "named constructor field",
        "type Point(x: Int, y: Int);\n",
        "type Point(x: Int, y: Int);\n",
    );
    // Enum payload fields follow the same <variant-field> rule -- named fields
    // and defaults both belong there.
    t.test(
        "named enum payload field",
        "type E { C(a: Int) };\n",
        "type E {\n    C(a: Int),\n};\n",
    );
    // <variant-list> is `("," <variant>)* ","?`, so the LAST variant may stand
    // without a comma. Requiring one silently reformatted user code.
    t.test(
        "variant without trailing comma",
        "type E { A(), B() };\n",
        "type E {\n    A(),\n    B(),\n};\n",
    );
    t.test(
        "single variant without comma",
        "type E { A() };\n",
        "type E {\n    A(),\n};\n",
    );
    // A comment inside a payload documents the field under it. Dropping it is
    // a formatter deleting user prose -- `typed_ast.koral` keeps one there.
    t.test(
        "comment in enum payload",
        "type E {\n    Given(\n        span Span,\n        // the declaration identity\n        id DefId,\n    ),\n};\n",
        "type E {\n    Given(\n        span Span,\n        // the declaration identity\n        id DefId,\n    ),\n};\n",
    );
    t.test(
        "positional constructor field",
        "type Point(x Int,y Int);\n",
        "type Point(x Int, y Int);\n",
    );
    t.test_error_contains("missing then rejected", "let main() Void = if 1 1;\n", "then");
    // Range spellings (grammar.bnf <range-op> / <open-range-op>): the `..`
    // family is closed (both bounds written), the `...` family elides one.
    // Maximal munch: `...<` > `...` > `..<` > `..` at a dot, `<...` > `<..<`
    // > `<..` at a `<`. `....` is `...` + `.` and `<....` is `<...` + `.`.
    t.test(
        "range operators round-trip",
        "let a=1..5; let b=1..<5; let c=1<..5; let d=1<..<5; let e=1...; let f=1<...; let g=...5; let h=...<5; let i=...;\n",
        "let a = 1..5;\nlet b = 1..<5;\nlet c = 1<..5;\nlet d = 1<..<5;\nlet e = 1...;\nlet f = 1<...;\nlet g = ...5;\nlet h = ...<5;\nlet i = ...;\n",
    );
    t.test_error_contains(
        "two bounds on a '...' range rejected",
        "let x=1...5;\n",
        "a '...' range takes at most one bound",
    );
    t.test_error_contains(
        "'...<5' as a value rejected",
        "let x=1...<5;\n",
        "'...<' opens a range with no left bound",
    );
    t.test_error_contains(
        "'<...5' as a value rejected",
        "let x=<...5;\n",
        "'<...' follows a range bound",
    );
    t.test_error_contains(
        "old open range `1..` rejected",
        "let x=1..;\n",
        "open ranges are spelled with '...': write 'a...' or 'a<...'",
    );
    t.test_error_contains(
        "old open range `1<..` rejected",
        "let x=1<..;\n",
        "open ranges are spelled with '...': write 'a...' or 'a<...'",
    );
    t.test_error_contains(
        "old open range `..<5` rejected",
        "let x=..<5;\n",
        "open ranges are spelled with '...': write '...b', '...<b', or '...'",
    );
    t.test_error_contains(
        "old full range `..` rejected",
        "let x=..;\n",
        "open ranges are spelled with '...': write '...b', '...<b', or '...'",
    );
    t.test_error_contains(
        "old range default `= ..` rejected",
        "type Span(range: Range[Int] = ..);\n",
        "open ranges are spelled with '...'",
    );
    // ── number literals (grammar.bnf <float-literal> / <duration-literal>) ──
    // The text is kept verbatim. It used to be re-lexed into `2.5e` `-` `3`
    // and printed as `2.5e - 3`, which koralc refuses to parse at all.
    t.test_checked(
        "signed-exponent floats keep their spelling",
        "let a=2.5e-3; let b=1e+6; let c=1e10; let d=1.0_0;\n",
        "let a = 2.5e-3;\nlet b = 1e+6;\nlet c = 1e10;\nlet d = 1.0_0;\n",
    );
    t.test_checked(
        "duration suffixes",
        "let a=10s; let b=250ms; let c=150us; let d=42ns;\n",
        "let a = 10s;\nlet b = 250ms;\nlet c = 150us;\nlet d = 42ns;\n",
    );
    t.test_error_contains(
        "duration suffix `h` rejected",
        "let a = 1h;\n",
        "expected ';' after declaration",
    );
    t.test_error_contains(
        "duration suffix `min` rejected",
        "let a = 1min;\n",
        "expected ';' after declaration",
    );
    t.test_error_contains(
        "uppercase `E` is not an exponent",
        "let a = 1E-3;\n",
        "expected ';' after declaration",
    );
    t.test_error_contains(
        "`e` without exponent digits is an identifier",
        "let a = 1e;\n",
        "expected ';' after declaration",
    );
    // ── comments before terminators ─────────────────────────────────────
    // A comment may sit between a statement and its `;`, between a list item
    // and its separator, and after a block's tail expression. koralc treats
    // comments as trivia and accepts all of these; the formatter must too,
    // and must keep every comment where the author put it.
    t.test_checked(
        "comment before a declaration terminator",
        "let x = 1 /* c */;\n",
        "let x = 1 /* c */;\n",
    );
    t.test_checked(
        "line comment before a declaration terminator",
        "let x = 1 // c\n;\n",
        "let x = 1 // c\n;\n",
    );
    t.test_checked(
        "comment before a statement terminator",
        "let main() Void = {\n    f() /* c */;\n};\n",
        "let main() Void = {\n    f() /* c */;\n};\n",
    );
    t.test_checked(
        "comment before a bare return terminator",
        "let main() Void = {\n    return /* c */;\n};\n",
        "let main() Void = {\n    return /* c */;\n};\n",
    );
    t.test_checked(
        "comment after a block tail expression",
        "let f() Int = {\n    v /* c */\n};\n",
        "let f() Int = {\n    v /* c */\n};\n",
    );
    t.test_checked(
        "comment before a list separator",
        "let f(a Int /* c */, b Int) Int = 0;\n",
        "let f(a Int /* c */, b Int) Int = 0;\n",
    );
    t.test_checked(
        "comment before a closing delimiter",
        "let main() Void = {\n    f(a /* c */);\n};\n",
        "let main() Void = {\n    f(a /* c */);\n};\n",
    );
    t.test_checked(
        "comment before an enum variant separator",
        "type T {\n    A() /* c */,\n    B(),\n};\n",
        "type T {\n    A(), /* c */\n    B(),\n};\n",
    );

    // ── function types and lambdas ──────────────────────────────────────
    // A function TYPE is `(T1, T2) -> R`; a lambda body opens with `=>`.
    // The two arrows never trade places.
    t.test_checked(
        "function type annotation",
        "let f(Int) -> Int = g;\n",
        "let f (Int) -> Int = g;\n",
    );
    t.test_checked(
        "nested function type",
        "let f ((Int) -> Int) -> Int = g;\n",
        "let f ((Int) -> Int) -> Int = g;\n",
    );
    t.test_checked(
        "zero-parameter function type vs zero-parameter declaration",
        "let t () -> Void = r;\n\nlet f() Int = {\n    return 0;\n};\n",
        "let t () -> Void = r;\n\nlet f() Int = {\n    return 0;\n};\n",
    );
    t.test_checked(
        "function-typed parameter and return",
        "let compose(f (Int) -> Int) (Int) -> Int = f;\n",
        "let compose(f (Int) -> Int) (Int) -> Int = f;\n",
    );
    t.test_checked(
        "lambda with return type",
        "let f = (x Int) Int => x + 1;\n",
        "let f = (x Int) Int => x + 1;\n",
    );
    t.test_checked(
        "lambda with inferred params",
        "let f = (x, y) => x + y;\n",
        "let f = (x, y) => x + y;\n",
    );
    t.test_checked(
        "lambda taking a function",
        "let a = (f (Int) -> Int, x Int) Int => f(x);\n",
        "let a = (f (Int) -> Int, x Int) Int => f(x);\n",
    );
    t.test_checked(
        "lambda returning a function type",
        "let r = (x) (Int) -> Int => x;\n",
        "let r = (x) (Int) -> Int => x;\n",
    );
    t.test_checked(
        "function type in generic argument",
        "let ms List[(Int) -> Int] = [];\n",
        "let ms List[(Int) -> Int] = [];\n",
    );
    // ── parse parity with the compiler ──────────────────────────────────
    // The formatter's parser must accept exactly what `koralc` accepts. Each
    // case below was verified to be rejected by the compiler; the message text
    // is the compiler's own where it has one. If one of these goes green
    // again, koral-syntax has drifted behind the compiler.
    t.test_error_contains(
        "legacy `Func(T) R` type rejected",
        "let f Func(Int) Int = g;\n",
        "expected ';' after declaration",
    );
    t.test_error_contains(
        "legacy `->` lambda rejected",
        "let main() Void = {\n    let f = (x) -> x;\n};\n",
        "expected ';' after let declaration",
    );
    t.test_error_contains(
        "digit separator may not double",
        "let a = 1__0;\n",
        "Invalid digit separator '_' in numeric literal",
    );
    t.test_error_contains(
        "digit separator may not trail",
        "let a = 1_;\n",
        "Invalid digit separator '_' in numeric literal",
    );
    t.test_error_contains(
        "digit separator may not lead after a base prefix",
        "let a = 0x_1;\n",
        "Invalid digit separator '_' in numeric literal",
    );
    t.test_error_contains(
        "digit separator may not touch a dot",
        "let a = 1_.0;\n",
        "Invalid digit separator '_' in numeric literal",
    );
    t.test_error_contains(
        "leading zeros rejected",
        "let a = 007;\n",
        "Leading zeros are not allowed in integer literals",
    );
    t.test_error_contains(
        "base literal may not carry a fraction",
        "let a = 0b101.1;\n",
        "0b literals do not support floating point",
    );
    t.test_error_contains(
        "off-base digit rejected",
        "let a = 0b2;\n",
        "Invalid digit '2' in 0b literal",
    );
    t.test_error_contains(
        "base literal needs a digit",
        "let a = 0b;\n",
        "0b literal must have at least one digit",
    );
    t.test_error_contains(
        "consecutive dots rejected",
        "let a = 1.5.6;\n",
        "consecutive dots are not allowed",
    );
    t.test(
        "raw pointer type `*T`",
        "type T(a Int);\nlet f(x *T) Int = 0;\n",
        "type T(a Int);\nlet f(x *T) Int = 0;\n",
    );
    t.test(
        "raw pointer type `*mutable T`",
        "type T(a Int);\nlet f(x *mutable T) Int = 0;\n",
        "type T(a Int);\nlet f(x *mutable T) Int = 0;\n",
    );
    t.test_error_contains(
        "legacy `?*T` rejected",
        "type T(a Int);\nlet f(x ?*T) Int = 0;\n",
        "Weak reference syntax is '?T', not legacy '?*T'",
    );
    t.test_error_contains(
        "`?mutable T` rejected",
        "type mutable T(a Int);\nlet f(x ?mutable T) Int = 0;\n",
        "expected type name",
    );
    t.test_error_contains(
        "`*self` receiver rejected",
        "type T(a Int);\ngiven T {\n    f(*self) Int = 0;\n};\n",
        "use 'self' only",
    );
    t.test_error_contains(
        "`*self mutable` receiver rejected",
        "type mutable T(a Int);\ngiven T {\n    f(*self mutable) Int = 0;\n};\n",
        "use 'self' only",
    );
    t.test_error_contains(
        "positional param default rejected",
        "let f(x Int = 5) Int = 0;\n",
        "Default values are only allowed for named parameters",
    );
    t.test_error_contains(
        "positional field default rejected",
        "type T(x Int = 5);\n",
        "Default values are only allowed for named parameters",
    );
    t.test_error_contains(
        "positional variant-field default rejected",
        "type E {\n    R(x Int = 5),\n};\n",
        "Default values are only allowed for named parameters",
    );
    // The only written form of a qualified call is `Type(Trait).method(...)`
    // (grammar.bnf <qualified-path-suffix>). The `(expr as Trait)` spelling was
    // never documented and the compiler never supported it.
    t.test_error_contains(
        "`expr as Trait` rejected",
        "let main() Void={\nlet r=(x as Tag).plus_ten(1);\n};\n",
        "expected ')', got 'as'",
    );
    t.test_error_contains(
        "mutable type alias rejected",
        "type mutable U = Int;\n",
        "Type alias cannot be marked mutable",
    );
    t.test_error_contains(
        "mutable enum rejected",
        "type mutable E {\n    A,\n    B,\n};\n",
        "Enum type cannot be marked mutable",
    );
    t.test_error_contains(
        "import alias case-class mismatch rejected",
        "using \"std/io\" { Reader as reader };\n",
        "alias must start with an uppercase letter",
    );
    // Flow operators (`and then`, `or else`, `or return`) and logical operators
    // (`and`, `or`) are two layers and do not mix without parentheses
    // (guide/grammar.bnf <expression>). Each message is the compiler's own.
    t.test_error_contains(
        "logical `and` after flow rejected",
        "let main() Int = {\n    let o = Option[Int].Some(1);\n    let v = o and then as v in v == 1 and false;\n    let _ = v;\n    return 0;\n};\n",
        "'and' cannot be mixed with the flow operators",
    );
    t.test_error_contains(
        "logical `or` after flow rejected",
        "let main() Int = {\n    let o = Option[Int].Some(1);\n    let v = o and then as v in v == 1 or false;\n    let _ = v;\n    return 0;\n};\n",
        "'or' cannot be mixed with the flow operators",
    );
    t.test_error_contains(
        "flow `and then` after logical rejected",
        "let main() Int = {\n    let v = true or false and then as v in v == 1;\n    let _ = v;\n    return 0;\n};\n",
        "'and then' cannot be mixed with logical",
    );
    t.test_error_contains(
        "flow `or else` after logical rejected",
        "let main() Int = {\n    let v = true and false or else false;\n    let _ = v;\n    return 0;\n};\n",
        "'or else' cannot be mixed with logical",
    );
    t.test_error_contains(
        "flow `or return` after logical rejected",
        "let main() Int = {\n    let v = true and false or return;\n    let _ = v;\n    return 0;\n};\n",
        "'or return' cannot be mixed with logical",
    );
    // `;` is required by the compiler and must not be supplied here. Grammar
    // has no ASI: a missing `;` is an error, and filling one in would rewrite
    // source the compiler refuses. Each shape below is rejected by `koralc`
    // with `expected: ';'`, so it must be rejected here too.
    t.test_error_contains(
        "top-level declaration without `;` rejected",
        "let f() Int = 1\n",
        "expected ';' after declaration",
    );
    t.test_error_contains(
        "using without `;` rejected",
        "using \"./helper.koral\"\n",
        "expected ';' after declaration",
    );
    t.test_error_contains(
        "top-level type without `;` rejected",
        "type T(a Int)\n",
        "expected ';' after declaration",
    );
    t.test_error_contains(
        "member method without `;` rejected",
        "type T(a Int);\ngiven T {\n    go(self) Int = 1\n};\n",
        "expected ';' after declaration",
    );
    t.test_error_contains(
        "block binding without `;` rejected",
        "let f() Int = {\n    let x = 1\n    x\n};\n",
        "expected ';' after let declaration",
    );
    t.test_error_contains(
        "bare expression that is not the tail rejected",
        "let f() Int = {\n    1\n    2\n};\n",
        "expected ';' after expression statement",
    );
    // Forms the compiler DOES accept -- these must keep formatting.
    t.test(
        "named variant-field default accepted",
        "type E {\n    R(x: Int = 5),\n};\n",
        "type E {\n    R(x: Int = 5),\n};\n",
    );
    // A variant declaration always writes its parens (`Red()`), so that the
    // declaration, the expression (`.Red()`) and the pattern (`.Red()`) all
    // spell the case the same way.
    t.test_error_contains(
        "variant without parens rejected",
        "type E { A, B };\n",
        "expected '(', got ','",
    );
    t.test(
        "zero-field variant keeps its parens",
        "type E { A(), B() };\n",
        "type E {\n    A(),\n    B(),\n};\n",
    );
    t.test(
        "leading underscore in type name accepted",
        "type _Foo(a Int);\n",
        "type _Foo(a Int);\n",
    );
    // Parentheses are the only way to cross the flow / logical boundary, so
    // they are load-bearing: dropping one would turn accepted source into the
    // rejected mix. Assert the parentheses survive a rewrite.
    t.test_checked(
        "parenthesised flow inside logical keeps its parens",
        "let main() Int = {\n    let r = true and (Option[Int].Some(1) and then as v in v > 0 or else false);\n    let _ = r;\n    return 0;\n};\n",
        "let main() Int = {\n    let r = true and (Option[Int].Some(1) and then as v in v > 0 or else false);\n    let _ = r;\n    return 0;\n};\n",
    );
    t.test_checked(
        "parenthesised logical inside flow keeps its parens",
        "let main() Int = {\n    let v = Option[Int].Some(1) and then as v in (v == 1 and false);\n    let _ = v;\n    return 0;\n};\n",
        "let main() Int = {\n    let v = Option[Int].Some(1) and then as v in (v == 1 and false);\n    let _ = v;\n    return 0;\n};\n",
    );
    // Chains inside one layer are still accepted, and still flatten onto one
    // line when they fit.
    t.test_checked(
        "flow chain inside its own layer accepted",
        "let main() Int = {\n    let v = Option[Int].Some(1) and then as v in v * 2 or else 0;\n    let _ = v;\n    return 0;\n};\n",
        "let main() Int = {\n    let v = Option[Int].Some(1) and then as v in v * 2 or else 0;\n    let _ = v;\n    return 0;\n};\n",
    );
    // The chain and binder forms are load-bearing: the leading dot marks the
    // chain (an implicit member would mean something else) and `as v in` is the
    // name the body uses. Dropping either would change what the source means.
    t.test_checked(
        "and then chain keeps its leading dot",
        "let main() Int = {\n    let v = Option[Int].Some(1) and then .to_string();\n    let _ = v;\n    return 0;\n};\n",
        "let main() Int = {\n    let v = Option[Int].Some(1) and then .to_string();\n    let _ = v;\n    return 0;\n};\n",
    );
    t.test_checked(
        "and then binder keeps its name",
        "let main() Int = {\n    let v = Option[Int].Some(1) and then as x in x * 2;\n    let _ = v;\n    return 0;\n};\n",
        "let main() Int = {\n    let v = Option[Int].Some(1) and then as x in x * 2;\n    let _ = v;\n    return 0;\n};\n",
    );
    t.test_checked(
        "or else binder keeps its name",
        "let main() Int = {\n    let r = Result[String].Error(\"boom\");\n    let v = r or else as e in e.message();\n    let _ = v;\n    return 0;\n};\n",
        "let main() Int = {\n    let r = Result[String].Error(\"boom\");\n    let v = r or else as e in e.message();\n    let _ = v;\n    return 0;\n};\n",
    );
    t.test_checked(
        "chain and binder compose with or else",
        "let main() Int = {\n    let v = Option[Int].Some(1) and then .to_string() or else \"none\";\n    let w = Option[Int].Some(1) and then as x in x * 2 or else 0;\n    let _ = v;\n    let _ = w;\n    return 0;\n};\n",
        "let main() Int = {\n    let v = Option[Int].Some(1) and then .to_string() or else \"none\";\n    let w = Option[Int].Some(1) and then as x in x * 2 or else 0;\n    let _ = v;\n    let _ = w;\n    return 0;\n};\n",
    );
    // `or else as e in` on Option is a SEMANTIC refusal (None has no payload),
    // not a parse error: the shape is well-formed and the formatter must keep
    // it intact rather than reject or rewrite it. The compiler's own complaint
    // is covered by `tests/compiler-cases/flow_bind_or_else_option_error.koral`.
    t.test_checked(
        "or else binder is well-formed syntax even where sema refuses it",
        "let main() Int = {\n    let o = Option[Int].Some(1);\n    let v = o or else as e in 0;\n    let _ = v;\n    return 0;\n};\n",
        "let main() Int = {\n    let o = Option[Int].Some(1);\n    let v = o or else as e in 0;\n    let _ = v;\n    return 0;\n};\n",
    );
    t.test_checked(
        "logical chain inside its own layer accepted",
        "let main() Int = {\n    let v = true or false and true;\n    let _ = v;\n    return 0;\n};\n",
        "let main() Int = {\n    let v = true or false and true;\n    let _ = v;\n    return 0;\n};\n",
    );
    // Newlines carry no meaning: only `;` ends a statement (grammar.bnf
    // "Statement Termination"). An expression may therefore span lines after
    // ANY token -- not just after a hand-picked set of leading words, which is
    // what a join-token whitelist used to enforce. These assert the whitelist
    // is gone: an operator-led continuation must parse, and a newline must not
    // split a call from its arguments.
    t.test_checked(
        "operator-led continuation accepted",
        "public let f(x UInt32) UInt32 = {\n    let word = x << 24\n        | x << 16\n        | x << 8\n        | x;\n    return word;\n};\n",
        "public let f(x UInt32) UInt32 = {\n    let word = x << 24 | x << 16 | x << 8 | x;\n    return word;\n};\n",
    );
    t.test_checked(
        "newline does not split a call from its arguments",
        "let main() Int = {\n    let v = f\n        (1);\n    return v;\n};\n",
        "let main() Int = {\n    let v = f(1);\n    return v;\n};\n",
    );
    t.test_checked(
        "newline does not split a chain from its receiver",
        "let main() Int = {\n    let n = \"abc\"\n        .count();\n    return n;\n};\n",
        "let main() Int = {\n    let n = \"abc\".count();\n    return n;\n};\n",
    );
    // `it` is an ordinary identifier: it names nothing implicitly and is free
    // for a declaration like any other name.
    t.test_checked(
        "`it` as declaration name accepted",
        "let main() Int = {\n    let it Int = 0;\n    return it;\n};\n",
        "let main() Int = {\n    let it Int = 0;\n    return it;\n};\n",
    );
    t.test(
        "`or else as e in` binder round-trips",
        "let g(r Result[Int]) Int = {\n    let x = r or else as e in {\n        let _ = e;\n        return 0;\n    };\n    return x;\n};\n",
        "let g(r Result[Int]) Int = {\n    let x = r or else as e in {\n        let _ = e;\n        return 0;\n    };\n    return x;\n};\n",
    );
    // `while` and `for` always produce `Void`, so a `Void` binding IS their
    // value position and the language accepts it (document.md: "while and for
    // always produce Void"). These used to assert that the form is rejected --
    // a rule the language does not have -- which is why they could sit red
    // forever without anyone noticing: the harness did not compile at all.
    t.test(
        "while in Void binding",
        "let x Void = while true then {};\n",
        "let x Void = while true then {};\n",
    );
    t.test(
        "for in Void binding",
        "let x Void = for item in [1,2] then println(item);\n",
        "let x Void = for item in [1, 2] then println(item);\n",
    );

    // ====================================================================
    // Language surface the formatter used to get wrong. Each of these was a
    // real gap: a form the compiler accepts that this tool either rejected or
    // rewrote into something else. Keep them -- the corpus gate only sees
    // whatever happens to be written down today.
    // ====================================================================

    // `foreign` / `intrinsic` qualify the declaration keyword -- `let foreign`,
    // `type foreign` -- the slot `let mutable` established. Access modifiers
    // stay in the prefix slot. The old prefix order is a parse error now.
    t.test(
        "qualifier after let keyword",
        "let foreign foo Int;\n",
        "let foreign foo Int;\n",
    );
    t.test(
        "access modifier before qualifier",
        "public let foreign foo Int;\n",
        "public let foreign foo Int;\n",
    );
    t.test(
        "intrinsic qualifier on type",
        "public type intrinsic Foo;\n",
        "public type intrinsic Foo;\n",
    );
    t.test_error_contains(
        "prefix qualifier before access rejected",
        "foreign public let foo Int;\n",
        "Unexpected token: foreign",
    );
    t.test_error_contains(
        "prefix qualifier after access rejected",
        "public foreign let foo Int;\n",
        "Unexpected token: foreign",
    );

    // `mutable` on a trait method parameter (grammar.bnf <func-param>). It was
    // accepted for free functions and rejected inside a trait body.
    t.test(
        "mutable param in trait method",
        "trait T {\ninc(self, mutable value Int) Int;\n};\n",
        "trait T {\n    inc(self, mutable value Int) Int;\n};\n",
    );
    t.test(
        "mutable param in given method",
        "type A();\ntrait T {\ninc(self, mutable value Int) Int;\n};\ngiven A as T {\ninc(self, mutable value Int) Int = value;\n};\n",
        "type A();\ntrait T {\n    inc(self, mutable value Int) Int;\n};\ngiven A as T {\n    inc(self, mutable value Int) Int = value;\n};\n",
    );

    // Default values are literals, and the literal set includes `...` (the
    // empty range) and rune literals (grammar.bnf <default-value-literal>).
    t.test(
        "empty range default",
        "type Span(range: Range[Int] = ...);\n",
        "type Span(range: Range[Int] = ...);\n",
    );
    t.test("rune default", "type C(c: Rune = 'x');\n", "type C(c: Rune = 'x');\n");

    // Tuple destructuring: `for (a, b, c) in`, and `(a, b, c)` as a pattern
    // under `when` / `is`. All of these were "expected ')', got ','".
    t.test(
        "for tuple binding",
        "let main() Void = {\nfor (left, right) in pairs then {\nprintln(left);\n};\n};\n",
        "let main() Void = {\n    for (left, right) in pairs then {\n        println(left);\n    };\n};\n",
    );
    t.test(
        "for tuple binding three slots",
        "let main() Void = {\nfor (x, _, z) in points then {\nprintln(x);\n};\n};\n",
        "let main() Void = {\n    for (x, _, z) in points then {\n        println(x);\n    };\n};\n",
    );
    t.test(
        "tuple pattern in when",
        "let main() Void = {\nlet s = when p in {\n(a, b) then a + b,\n};\n};\n",
        "let main() Void = {\n    let s = when p in {\n        (a, b) then a + b,\n    };\n};\n",
    );
    t.test(
        "tuple pattern in is",
        "let main() Void = {\nif p is (a, b) then {\nprintln(a);\n};\n};\n",
        "let main() Void = {\n    if p is (a, b) then {\n        println(a);\n    };\n};\n",
    );

    // `name Type` binds the matched trait-object implementation; `mutable name
    // Type` binds it mutably (grammar.bnf <trait-object-type-binding-pattern>).
    t.test(
        "trait object type binding pattern",
        "let f(t T) Int = when t in {\nio ProbeError then 1,\n_ then 0,\n};\n",
        "let f(t T) Int = when t in {\n    io ProbeError then 1,\n    _ then 0,\n};\n",
    );
    t.test(
        "mutable trait object type binding pattern",
        "let f(t T) Int = when t in {\nmutable io ProbeError then 1,\n_ then 0,\n};\n",
        "let f(t T) Int = when t in {\n    mutable io ProbeError then 1,\n    _ then 0,\n};\n",
    );

    // Weak-reference upgrade: `?expr` upgrades a weak reference to `Option[T]`.
    t.test(
        "weak upgrade expression",
        "let main() Void = {\nlet v = ?w;\n};\n",
        "let main() Void = {\n    let v = ?w;\n};\n",
    );
    t.test(
        "weak upgrade in when",
        "let f(w ?Port) Int = when ?w in {\n.Some(p) then p,\n.None() then 0,\n};\n",
        "let f(w ?Port) Int = when ?w in {\n    .Some(p) then p,\n    .None() then 0,\n};\n",
    );

    // An import list may span lines; the line breaks are kept, because `using`
    // is carried through as a token list rather than re-laid out.
    t.test(
        "multiline import list",
        "using \"a/b\" { x as y, z as w,\n    q, };\n",
        "using \"a/b\" { x as y, z as w,\n    q, };\n",
    );

    // A comment written on its own line documents what follows. Glueing it to
    // the previous line turns it into a trailing comment on the wrong item --
    // the prose survives, the meaning does not.
    t.test(
        "own-line comment stays on its own line",
        "type S(\n    a Int,\n    // documents b\n    b UInt,\n);\n",
        "type S(\n    a Int,\n    // documents b\n    b UInt,\n);\n",
    );
    // Comment text is byte-for-byte the author's, trailing spaces included. The
    // test runner reads `// EXPECT: ` markers -- trimming one rewrites an
    // expectation.
    t.test(
        "comment trailing space preserved",
        "let x Int = 1; // note:  \n",
        "let x Int = 1; // note:  \n",
    );

    // Multiline strings carry their own column layout; the closing `"""` sets
    // the indentation that gets stripped at compile time, so re-indenting the
    // interior would change the value.
    t.test(
        "multiline string interior untouched",
        "let main() Void = {\nlet s = \"\"\"\n        hello\n        world\n        \"\"\";\n};\n",
        "let main() Void = {\n    let s = \"\"\"\n        hello\n        world\n        \"\"\";\n};\n",
    );

    // A function declaration without a body needs `foreign` or `intrinsic`.
    // Parsing it as a variable would drop the parameter list on the floor.
    t.test_error_contains(
        "body-less function without modifier rejected",
        "let bad(x Int) Int;\n",
        "foreign",
    );

    // The contract, through the checked entry point: every one of these must
    // come back byte-identical to its expectation AND survive a second pass.
    t.test_checked(
        "checked: qualifier after keyword",
        "public let foreign mutable foo Int32;\n",
        "public let foreign mutable foo Int32;\n",
    );
    t.test_checked(
        "checked: tuple pattern",
        "let s = when p in {\n(a, b) then a + b,\n};\n",
        "let s = when p in {\n    (a, b) then a + b,\n};\n",
    );
    t.test_checked(
        "checked: comment with trailing space",
        "let x Int = 1; // note:  \n",
        "let x Int = 1; // note:  \n",
    );
    t.test_checked(
        "checked: multiline string",
        "let s = \"\"\"\n  a\n  b\n  \"\"\";\n",
        "let s = \"\"\"\n  a\n  b\n  \"\"\";\n",
    );

    // === for bindings (a full match pattern; the formatter records what was
    // written, whether it can fail is the compiler's call) ===
    t.test(
        "for plain binding",
        "let main() Void={\nfor x in xs then f(x);\n};\n",
        "let main() Void = {\n    for x in xs then f(x);\n};\n",
    );
    t.test(
        "for mutable binding",
        "let main() Void={\nfor mutable x in xs then x+=1;\n};\n",
        "let main() Void = {\n    for mutable x in xs then x += 1;\n};\n",
    );
    t.test(
        "for tuple binding",
        "let main() Void={\nfor (a,b) in pairs then f(a,b);\n};\n",
        "let main() Void = {\n    for (a, b) in pairs then f(a, b);\n};\n",
    );
    t.test(
        "for tuple binding with discard",
        "let main() Void={\nfor (a,_,c) in xs then f(a,c);\n};\n",
        "let main() Void = {\n    for (a, _, c) in xs then f(a, c);\n};\n",
    );
    t.test(
        "for struct pattern",
        "let main() Void={\nfor Point(a,b) in xs then f(a,b);\n};\n",
        "let main() Void = {\n    for Point(a, b) in xs then f(a, b);\n};\n",
    );
    t.test(
        "for guard",
        "let main() Void={\nfor x in xs where x>0 then f(x);\n};\n",
        "let main() Void = {\n    for x in xs where x > 0 then f(x);\n};\n",
    );
    t.test_error_contains(
        "for guard retired 'if' spelling",
        "let main() Void={\nfor x in xs if x>0 then f(x);\n};\n",
        "Pattern guards use 'where', not 'if'",
    );
    t.test_error_contains(
        "for parenthesized slot rejected",
        "let main() Void={\nfor (x) in xs then f(x);\n};\n",
        "A parenthesized pattern groups nothing; `(` starts a tuple pattern with at least two slots. Under 'is', combine tests with 'or is' / 'and is'",
    );

    // === Nested tuple bindings ===
    // A slot may itself be a tuple binding: `let (a, (b, c)) = ...` and
    // `for (a, (b, c)) in ...` -- the same nesting a <tuple-pattern> allows
    // in `when`/`is`.
    t.test(
        "nested let tuple binding",
        "let main() Void={\nlet (a,(b,c))=Outer(1,Inner(2,3));\n};\n",
        "let main() Void = {\n    let (a, (b, c)) = Outer(1, Inner(2, 3));\n};\n",
    );
    t.test(
        "nested for tuple binding",
        "let main() Void={\nfor (a,(b,c)) in xs then f(a,b,c);\n};\n",
        "let main() Void = {\n    for (a, (b, c)) in xs then f(a, b, c);\n};\n",
    );
    t.test(
        "nested let tuple binding with mutable and type",
        "let main() Void={\nlet (mutable a,(b Int,_))=Outer(1,Inner(2,3));\n};\n",
        "let main() Void = {\n    let (mutable a, (b Int, _)) = Outer(1, Inner(2, 3));\n};\n",
    );
    t.test(
        "deeply nested tuple binding",
        "let main() Void={\nlet ((a,b),(c,(d,e)))=make();\n};\n",
        "let main() Void = {\n    let ((a, b), (c, (d, e))) = make();\n};\n",
    );

    // === `Self` is a type, not an expression ===
    // The compilers' primary-expression parser has no case for `Self`, so
    // `Self(1)` and `Self` are refused here too. `Self` stays legal in type
    // position (`* Self(p)`, `let x Self`, ...).
    t.test_error_contains(
        "Self as expression rejected",
        "let main() Void={\nlet p=Self(1,2);\n};\n",
        "'Self' is a type and cannot be used as an expression",
    );
    t.test_error_contains(
        "bare Self as expression rejected",
        "let main() Void={\nlet p=Self;\n};\n",
        "'Self' is a type and cannot be used as an expression",
    );
    t.test(
        "Self as type annotation allowed",
        "let main() Void={\nlet x Self=y;\n};\n",
        "let main() Void = {\n    let x Self = y;\n};\n",
    );

    t.summary();

    // The inline assertions above cover the language surface. This covers the
    // codebase: every `.koral` file under the real source trees has to format
    // without error, without losing a token, and to a fixed point. Test cases
    // under `tests/` are deliberately excluded -- a large share of them are
    // written to be rejected.
    run_corpus_gate(t);
};

// ============================================================================
// Corpus gate
// ============================================================================

/// The directories that hold real Koral source: the code people edit and ship.
let corpus_roots() List[String] = ["std", "compiler", "toolchain", "samples"];

let run_corpus_gate(t TestRunner) Void = {
    let repo_root = find_repo_root() or else as e in {
        eprintln("CORPUS GATE: \(e.message())");
        exit(1);
    };

    let mutable checked UInt = 0;
    let mutable failed UInt = 0;

    for relative in corpus_roots() then {
        let root = repo_root.join(relative);
        if not path_exist(root) then {
            continue;
        };

        let mutable walker = walk_dir(root) or else as e in {
            eprintln("CORPUS GATE: cannot walk \(root.to_string()): \(e.message())");
            exit(1);
        };

        while walker.next() is .Some(entry) then {
            let name = entry.name();
            if name == ".build" or name == "node_modules" then {
                continue;
            };
            if not entry.is_file() or not name.ends_with(".koral") then {
                continue;
            };

            let path = entry.path();
            // Fixtures under a `test/cases` directory are inputs, not source --
            // some of them exist precisely to be rejected.
            if path.to_string().contains("/test/cases/") then {
                continue;
            };

            checked += 1;
            let source = read_text_file(path) or else as e in {
                failed += 1;
                eprintln(
                    "CORPUS GATE FAIL: cannot read \(path.to_string()): \(e.message())",
                );
                continue;
            };

            when format_source_checked(source) in {
                .Ok(_) then {},
                .Error(e) then {
                    failed += 1;
                    eprintln("CORPUS GATE FAIL: \(path.to_string())");
                    eprintln("  \(e.message())");
                },
            };
        };
    };

    println("corpus gate: \(checked) files checked, \(failed) failed");
    if failed > 0 then {
        exit(1);
    };
};

let find_repo_root() Result[Path] = {
    let mutable cursor = current_dir() or return;

    let mutable steps UInt = 0;
    while steps < 12 then {
        if path_exist(cursor.join("std").join("std.koral")) then {
            return Result[Path].Ok(cursor);
        };
        let parent = cursor.dir_name();
        if parent.to_string() == cursor.to_string() then {
            break;
        };
        cursor = parent;
        steps += 1;
    };

    return Result[Path].Error("cannot locate repo root (missing std/std.koral)");
};
