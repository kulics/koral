// ============================================================================
// Koral Formatter - Test Suite
// ============================================================================

using "tokenizer"
using "parser"
using "printer"

type TestRunner(mutable pass_count UInt, mutable fail_count UInt)

given TestRunner {

    new() TestRunner = TestRunner(0, 0)

    test(*mutable self, name String, input String, expected String) Void = {
        when format_source(input) in {
            .Ok(result) then {
                if result == expected then {
                    self.pass_count += 1
                } else {
                    self.fail_count += 1
                    println("FAIL: " + name)
                    println("  expected:")
                    println(expected)
                    println("  got:")
                    println(result)
                }
            },
            .Error(e) then {
                self.fail_count += 1
                println("ERROR: " + name + " - " + e.message())
            },
        }
    }

    summary(self) Void = {
        let total = self.pass_count + self.fail_count
        println(self.pass_count.to_string() + "/" + total.to_string() + " tests passed")
        if self.fail_count > 0 then { exit(1) }
    }
}

let main() Void = {
    let mutable t = TestRunner.new()

    // === Basic let bindings ===
    t.test("simple let spacing", "let x=1+2\n", "let x = 1 + 2\n")
    t.test("let with type", "let x Int=42\n", "let x Int = 42\n")
    t.test("let mutable", "let mutable x=0\n", "let mutable x = 0\n")
    t.test("public let", "public let x Int=42\n", "public let x Int = 42\n")

    // === Function declarations ===
    t.test("func decl", "let add(a Int,b Int) Int=a+b\n", "let add(a Int, b Int) Int = a + b\n")
    t.test("func with block", "let f() Void={\nlet x=1\nlet y=2\n}\n",
        "let f() Void = {\n    let x = 1\n    let y = 2\n}\n")
    t.test("return stmt", "let f() Int={\nreturn 42\n}\n", "let f() Int = {\n    return 42\n}\n")
    t.test("break value stmt", "let f() Int={\nbreak 42\n}\n", "let f() Int = {\n    break 42\n}\n")
    t.test("defer stmt", "let f() Void={\ndefer close()\n}\n", "let f() Void = {\n    defer close()\n}\n")
    t.test("break value stmt with semi", "let f() Int={\nbreak 42;\n}\n", "let f() Int = {\n    break 42\n}\n")
    t.test("defer stmt with semi", "let f() Void={\ndefer close();\n}\n", "let f() Void = {\n    defer close()\n}\n")
    t.test("block expression stmt only", "let f() Void={\nfoo()\nbar()\n}\n",
        "let f() Void = {\n    foo()\n    bar()\n}\n")

    // === Using declarations ===
    t.test("using", "using \"foo\"\n", "using \"foo\"\n")
    t.test("foreign using", "foreign using \"math\"\n", "foreign using \"math\"\n")

    // === Type declarations ===
    t.test("public type tuple", "public type Point(x Int,y Int)\n", "public type Point(x Int, y Int)\n")

    // === Trait and Given ===
    t.test("trait decl", "trait Printable {\nto_string(*self) String\n}\n",
        "trait Printable {\n    to_string(*self) String\n}\n")
    t.test("trait mutable receiver", "trait Counter {\nbump(*mutable self) Int\n}\n",
        "trait Counter {\n    bump(*mutable self) Int\n}\n")
    t.test("given block", "given Point {\npublic new(x Int,y Int) Point=Point(x,y)\n}\n",
        "given Point {\n    public new(x Int, y Int) Point = Point(x, y)\n}\n")
    t.test("given trait impl", "given Point as Eq {\npublic equals(self,other Point) Bool=self.x==other.x\n}\n",
        "given Point as Eq {\n    public equals(self, other Point) Bool = self.x == other.x\n}\n")

    // === When/in expressions ===
    t.test("when/in block", "when x in {\n1 then true,\n_ then false,\n}\n",
        "when x in {\n    1 then true,\n    _ then false,\n}\n")

    // === Operators ===
    t.test("unary minus", "let x=-1\n", "let x = -1\n")
    t.test("range op", "let r=0..<10\n", "let r = 0..<10\n")
    t.test("compound assign", "let f() Void={\nx+=1\n}\n",
        "let f() Void = {\n    x += 1\n}\n")

    // === Strings ===
    t.test("string interp", "let s=\"hello \\(name)\"\n", "let s = \"hello \\(name)\"\n")

    // === Comments ===
    t.test("line comment", "// hello world\n", "// hello world\n")
    t.test("trailing comment in block", "let f() Void={\nfoo() // trailing\nbar()\n}\n",
        "let f() Void = {\n    foo() // trailing\n    bar()\n}\n")
    t.test("crlf normalization", "let x=1\r\nlet y=2\r\n", "let x = 1\nlet y = 2\n")

    // === Method calls ===
    t.test("method call", "let r=a.add(b)\n", "let r = a.add(b)\n")

    // === Modern reference syntax ===
    t.test("managed ref type and address-of", "let main() Void={\nlet mutable x=1\nlet r *mutable Int=&mutable x\nlet y=*r\n}\n",
        "let main() Void = {\n    let mutable x = 1\n    let r *mutable Int = &mutable x\n    let y = *r\n}\n")
    t.test("raw pointer type and address-of", "let main() Void={\nlet mutable x=1\nlet p *! mutable Int=&! mutable x\n}\n",
        "let main() Void = {\n    let mutable x = 1\n    let p *! mutable Int = &! mutable x\n}\n")
    t.test("pair destructuring", "let main() Void={\nlet (a,b)=(1,2)\n}\n",
        "let main() Void = {\n    let (a, b) = (1, 2)\n}\n")
    t.test("collection literals", "let main() Void={\nlet xs=[1,2,]\nlet d=[\"a\":1,]\n}\n",
        "let main() Void = {\n    let xs = [1, 2, ]\n    let d = [\"a\": 1, ]\n}\n")
    t.test("qualified trait call", "let main() Void={\nlet r=x.(Tag)plus_ten(1,)\n}\n",
        "let main() Void = {\n    let r = x.(Tag)plus_ten(1, )\n}\n")
    t.test("given not trait", "given Kind not Deref\n",
        "given Kind not Deref\n")
    t.test("trait parent list", "trait FloatMath Numeric and Div[Self] and Neg {\n}\n",
        "trait FloatMath Numeric and Div[Self] and Neg {}\n")

    // === Multiple declarations ===
    t.test("multi decl", "let x=1\nlet y=2\n", "let x = 1\nlet y = 2\n")

    // === Idempotency ===
    t.test("idempotent simple", "let x = 1 + 2\n", "let x = 1 + 2\n")
    t.test("idempotent trait", "trait Foo {\n    bar(self) Int\n}\n",
        "trait Foo {\n    bar(self) Int\n}\n")

    t.summary()
}
