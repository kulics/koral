// Foreign declaration forms: the C-name slot, body-bearing exports, macro
// constants and exported globals (cffi-design.md §B/§C).

let foreign sin(x: Float64): Float64;
let foreign "abs" int(x: Int32): Int32;
let foreign "toupper" mutable upper_state: Int32;
let foreign "AF_INET6" af_inet6: Int32 = 10;
let foreign mutable counter: Int32 = 0;
let foreign "koral_flag" mutable flag: Int32 = 1;

let foreign add_one(x: Int32): Int32 = {
    return x + Int32(1);
};

let foreign apply_twice(f: foreign (Int32) -> Int32, x: Int32): Int32 = {
    return f(f(x));
};

let main(): Int = {
    let f: foreign (Int32) -> Int32 = add_one;
    return f(Int32(1)).to_int();
};
