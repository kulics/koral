// ============================================================================
// Koral Formatter - CLI Entry Point
// ============================================================================
// Usage: koral-fmt [--check] <file1.koral> [file2.koral ...]
// ============================================================================

using "koral_syntax";

using "std/os";

// ============================================================================
// CLI Entry Point
// ============================================================================

let main() Void = {
    let arguments = args();

    if arguments.count() <= 1 then {
        print_usage();
        exit(1);
    };

    let mutable check_mode = false;
    let mutable files = List[String].new();
    for i in 1..<arguments.count() then {
        let arg = arguments[i];
        if arg == "--check" then {
            check_mode = true;
        } else if arg == "--help" or arg == "-h" then {
            print_usage();
            exit(0);
        } else {
            files.push(arg);
        };
    };

    if files.is_empty() then {
        eprintln("Error: no input files specified");
        print_usage();
        exit(1);
    };

    let mutable had_error = false;

    for path in files then {
        if check_mode then {
            when check_file(path) in {
                .Ok(is_formatted) then {
                    if not is_formatted then {
                        eprintln("\(path): not formatted");
                        had_error = true;
                    };
                },
                .Error(e) then {
                    eprintln("Error: \(path): \(e.message())");
                    had_error = true;
                },
            };
        } else {
            when format_file(path) in {
                .Ok(_) then {},
                .Error(e) then {
                    eprintln("Error: \(path): \(e.message())");
                    had_error = true;
                },
            };
        };
    };

    if had_error then {
        exit(1);
    };
};

// ============================================================================
// File Operations
// ============================================================================

let format_file(path String) Result[Void] = {
    let file_path = path.into_path();
    let source = read_text_file(file_path) or return;
    let formatted = formatted_file_content(source) or return;

    if formatted == source then {
        return .Ok({});
    };
    return write_text_file(file_path, content: formatted);
};

let check_file(path String) Result[Bool] = {
    let source = read_text_file(path.into_path()) or return;
    let formatted = formatted_file_content(source) or return;
    return .Ok(formatted == source);
};

/// The whole file as the formatter would write it. Line endings are layout:
/// `\r\n` and bare `\r` are folded to `\n` first, so everything downstream --
/// including the contract check -- sees one spelling of "end of line". A
/// byte-order mark is handled by `format_source_checked` itself.
let formatted_file_content(source String) Result[String] =
    format_source_checked(normalize_newlines(source));

/// Line endings are layout. `\r\n` and bare `\r` are folded to `\n` first so
/// that everything downstream -- including the contract check -- sees one
/// spelling of "end of line".
let normalize_newlines(source String) String = {
    if not source.contains("\r") then {
        return source;
    };

    let runes = source.to_runes();
    let mutable out = StringBuilder.new();
    let mutable i UInt = 0;

    while i < runes.count() then {
        let r = runes[i];
        if r == '\r' then {
            out.push_byte('\n');
            if i + 1 < runes.count() and runes[i + 1] == '\n' then {
                i += 2;
            } else {
                i += 1;
            };
            continue;
        };

        out.push_string(r.to_string());
        i += 1;
    };

    return out.to_string();
};

// ============================================================================
// Usage
// ============================================================================

let print_usage() Void =
    eprintln(
        """
        Usage: koral-fmt [--check] <file1.koral> [file2.koral ...]

        Options:
          --check    Check if files are formatted (exit 1 if not)
          --help     Show this help message
        """,
    );
