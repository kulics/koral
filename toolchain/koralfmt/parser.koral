// ============================================================================
// Koral Formatter - Fully Structured CST Parser
// ============================================================================
// CST preserves all tokens (keywords, delimiters) for exact reproduction,
// but parses full structure like an AST so the printer needs zero spacing inference.
// ============================================================================

// ============================================================================
// CST Type Nodes
// ============================================================================

public type CstType {
    Named(name Token),
    SelfType(kw Token),
    Mut(inner * CstType, kw Token),
    Generic(lbracket Token, args List[CstTypeArg], rbracket Token, base Token),
    Ref(inner * CstType, kw Token),
    Ptr(inner * CstType, kw Token),
    Weakref(inner * CstType, kw Token),
}

// A type argument with optional trailing comma
public type CstTypeArg(inner * CstType, comma Option[Token])

// ============================================================================
// CST Expression Nodes
// ============================================================================

public type CstExpr {
    // Literals
    IntLit(token Token),
    FloatLit(token Token),
    StrLit(token Token),
    InterpStr(token Token),
    BoolLit(token Token),
    Ident(token Token),
    SelfExpr(token Token),
    UnderscoreExpr(token Token),
    Commented(comments List[Token], inner * CstExpr),

    // Operators
    BinaryOp(left * CstExpr, op Token, right * CstExpr),
    UnaryMinus(op Token, operand * CstExpr),
    Deref(op Token, operand * CstExpr),
    AddressOf(op Token, raw_kw Option[Token], mut_kw Option[Token], operand * CstExpr),
    NotExpr(op Token, operand * CstExpr),
    IsExpr(subject * CstExpr, is_kw Token, not_kw Option[Token], pattern * CstPattern),
    BitwiseNot(op Token, operand * CstExpr),
    PrefixKw(kw Token, operand * CstExpr),
    TypeCast(lparen Token, cast_type * CstType, rparen Token, operand * CstExpr),
    Paren(lparen Token, inner * CstExpr, rparen Token),
    PairExpr(lparen Token, first * CstExpr, comma Token, second * CstExpr, rparen Token),

    // Access and calls
    FieldAccess(base * CstExpr, dot Token, field Token),
    QualifiedCall(base * CstExpr, dot Token, trait_lparen Token, trait_name Token, trait_rparen Token,
                  method_name Token, lparen Token, args List[CstCallArg], rparen Token),
    Call(callee * CstExpr, lparen Token, args List[CstCallArg], rparen Token),
    SubscriptExpr(base * CstExpr, lbracket Token, args List[CstCallArg], rbracket Token),
    GenericInst(base * CstExpr, lbracket Token, type_args List[CstTypeArg], rbracket Token),
    ImplicitMember(dot Token, name Token, lparen Option[Token], args List[CstCallArg], rparen Option[Token]),

    // Control flow
    Block(lbrace Token, items List[*CstItem], rbrace Token),
    If(kw Token, cond * CstExpr, then_kw Token, then_body * CstExpr,
       else_kw Option[Token], else_body Option[* CstExpr]),
    IfPattern(kw Token, subject * CstExpr, is_kw Token, pattern * CstPattern,
              then_kw Token, then_body * CstExpr,
              else_kw Option[Token], else_body Option[* CstExpr]),
    While(kw Token, cond * CstExpr, then_kw Token, body * CstExpr),
    WhilePattern(kw Token, subject * CstExpr, is_kw Token, pattern * CstPattern,
                 then_kw Token, body * CstExpr),
    For(kw Token, binding * CstPattern, eq Token, iterable * CstExpr,
        then_kw Token, body * CstExpr),
    When(kw Token, subject * CstExpr, is_kw Token,
         lbrace Token, arms List[* CstWhenArm], rbrace Token),

    // Chaining
    AndThen(left * CstExpr, and_kw Token, then_kw Token, right * CstExpr),
    OrElse(left * CstExpr, or_kw Token, else_kw Token, right * CstExpr),
    OrReturn(left * CstExpr, or_kw Token, return_kw Token),

    // Range
    RangeExpr(left Option[* CstExpr], op Token, right Option[* CstExpr]),

    // Collection literals
    EmptyLiteral(lbracket Token, rbracket Token),
    CollectionLiteral(lbracket Token, elements List[CstCollectionElement], rbracket Token),
    DictLiteral(lbracket Token, entries List[CstDictEntry], rbracket Token),

    // Lambda
    Lambda(lparen Token, params List[CstLambdaParam], rparen Token,
           ret_type Option[* CstType], arrow Token, body * CstExpr),

    // Enum variant declaration in type enum body
    EnumVariant(name Token, lparen Option[Token], fields List[CstEnumField], rparen Option[Token]),
}

// Call argument with optional trailing comma
public type CstCallArg(label Option[Token], colon Option[Token], value * CstExpr, comma Option[Token])

public type CstCollectionElement(value * CstExpr, comma Option[Token])

public type CstDictEntry(key * CstExpr, colon Token, value * CstExpr, comma Option[Token])

// Lambda parameter
public type CstLambdaParam(name Token, param_type Option[* CstType], comma Option[Token])

// Enum variant field: Name(Type) as `fieldName FieldType` or `fieldName: FieldType`
public type CstEnumField(name Token, colon Option[Token], field_type * CstType, comma Option[Token])

// ============================================================================
// CST Pattern Nodes
// ============================================================================

public type CstPattern {
    Wildcard(token Token),
    Variable(name Token),
    MutVariable(mut_kw Token, name Token),
    PatIntLit(token Token),
    NegIntLit(minus Token, token Token),
    PatStrLit(token Token),
    PatBoolLit(token Token),
    EnumCase(dot Token, name Token, lparen Option[Token], args List[CstPatternArg], rparen Option[Token]),
    StructPattern(name Token, lparen Token, args List[CstPatternArg], rparen Token),
    Comparison(op Token, value Token),
    AndPattern(left * CstPattern, and_kw Token, right * CstPattern),
    OrPattern(left * CstPattern, or_kw Token, right * CstPattern),
    NotPattern(not_kw Token, inner * CstPattern),
    ParenPattern(lparen Token, inner * CstPattern, rparen Token),
}

public type CstPatternArg(label Option[Token], colon Option[Token], pattern * CstPattern, comma Option[Token])

// ============================================================================
// CST When Arm
// ============================================================================

public type CstWhenArm(
    leading_comments List[Token],
    pattern * CstPattern,
    then_kw Token,
    body * CstExpr,
    comma Option[Token],
    trailing_comments List[Token],
)

// ============================================================================
// CST Parameter and Generic Parameter
// ============================================================================

public type CstParam {
    SelfParam(kw Token, mut_kw Option[Token], ref_kw Option[Token], comma Option[Token]),
    NamedParam(name Token, mut_kw Option[Token], colon Option[Token], param_type * CstType, comma Option[Token]),
}

public type CstGenericParam(
    name Token,
    constraints List[* CstType],
    comma Option[Token],
)

public type CstGenericParams(
    lbracket Token,
    params List[CstGenericParam],
    rbracket Token,
)

// ============================================================================
// CST Statements
// ============================================================================

public type CstStmt {
    VarDecl(let_kw Token, mut_kw Option[Token], name Token,
            var_type Option[* CstType], eq Token, value * CstExpr),
    PairVarDecl(let_kw Token, lparen Token, first CstPairBinding, comma Token, second CstPairBinding,
                rparen Token, eq Token, value * CstExpr),
    Assignment(target * CstExpr, op Token, value * CstExpr),
    ExprStmt(expr * CstExpr, semi Option[Token]),
    Defer(kw Token, value * CstExpr),
    Return(kw Token, value Option[* CstExpr]),
    Break(kw Token, value Option[* CstExpr]),
    Continue(kw Token),
}

public type CstPairBinding(mut_kw Option[Token], name Token, binding_type Option[* CstType], is_discard Bool)

// ============================================================================
// CST Type Body (for type declarations)
// ============================================================================

public type CstTypeBody {
    Struct(lparen Token, items List[*CstStructBodyItem], rparen Token),
    Enum(lbrace Token, cases List[*CstItem], rbrace Token),
    Alias(eq Token, target * CstType),
    Empty(),
}

public type CstStructBodyItem {
    Field(field CstStructField),
    Comment(token Token),
    TrailingComment(token Token),
    BlankLine(),
}

public type CstStructField(
    mut_kw Option[Token],
    access Option[Token],
    name Token,
    colon Option[Token],
    field_type * CstType,
    comma Option[Token],
)

// ============================================================================
// CST Declarations
// ============================================================================

public type CstDecl {
    Using(tokens List[Token]),
    ForeignUsing(foreign_kw Token, tokens List[Token]),
    Func(
        vis Option[Token],
        modifiers List[Token],
        let_kw Option[Token],
        mut_kw Option[Token],
        generic_params Option[* CstGenericParams],
        name Option[Token],
        lparen Option[Token],
        params List[CstParam],
        rparen Option[Token],
        return_type Option[* CstType],
        eq Token,
        body * CstExpr
    ),
    ForeignDecl(
        vis Option[Token],
        modifiers List[Token],
        let_kw Option[Token],
        mut_kw Option[Token],
        generic_params Option[* CstGenericParams],
        name Option[Token],
        lparen Option[Token],
        params List[CstParam],
        rparen Option[Token],
        return_type Option[* CstType]
    ),
    Type(
        vis Option[Token],
        modifiers List[Token],
        kw Token,
        generic_params Option[* CstGenericParams],
        name Token,
        body * CstTypeBody
    ),
    Trait(
        vis Option[Token],
        kw Token,
        generic_params Option[* CstGenericParams],
        name Token,
        super_traits List[* CstType],
        lbrace Token,
        members List[*CstItem],
        rbrace Token
    ),
    Given(
        vis Option[Token],
        modifiers List[Token],
        kw Token,
        generic_params Option[* CstGenericParams],
        target * CstType,
        as_kw Option[Token],
        trait_type Option[* CstType],
        lbrace Token,
        members List[*CstItem],
        rbrace Token
    ),
    GivenNot(
        vis Option[Token],
        modifiers List[Token],
        kw Token,
        generic_params Option[* CstGenericParams],
        target * CstType,
        not_kw Token,
        trait_name Token
    ),
    Var(
        vis Option[Token],
        let_kw Token,
        mut_kw Option[Token],
        name Token,
        var_type Option[* CstType]
    ),
    TraitMethod(
        vis Option[Token],
        generic_params Option[* CstGenericParams],
        name Token,
        lparen Token,
        params List[CstTraitMethodParam],
        rparen Token,
        return_type Option[* CstType]
    ),
}

// Trait method parameter
public type CstTraitMethodParam {
    // self / *self / *self mut
    SelfParam(kw Token, mut_kw Option[Token], ref_kw Option[Token], comma Option[Token]),
    // name Type
    NamedParam(name Token, colon Option[Token], param_type * CstType, comma Option[Token]),
}

// ============================================================================
// CST Item and File
// ============================================================================

public type CstItem {
    Decl(decl * CstDecl),
    Stmt(stmt * CstStmt),
    Comment(token Token),
    TrailingComment(token Token),
    BlankLine(),
}

public type CstFile(items List[*CstItem])


// ============================================================================
// CstParser
// ============================================================================

public type CstParser(
    tokens List[Token],
    mut pos UInt,
    mut line_join_grouping UInt,
)

given CstParser {

    public new(tokens List[Token]) CstParser = CstParser(tokens, 0, 0)

    // ========================================================================
    // Token helpers
    // ========================================================================

    private peek(*self) Token = {
        let mut i = self.pos
        while i < self.tokens.count() then {
            when self.tokens[i] in {
                .Newline() then { i += 1; continue },
                _ then { return self.tokens[i] },
            }
        }
        return Token.EOF()
    }

    private peek_raw(*self) Token = {
        if self.pos >= self.tokens.count() then { return .EOF() }
        return self.tokens[self.pos]
    }

    private advance(*mut self) Token = {
        if self.pos >= self.tokens.count() then { return .EOF() }
        let tok = self.tokens[self.pos]
        self.pos += 1
        return tok
    }

    private skip_newlines(*mut self) Void = {
        while self.pos < self.tokens.count() then {
            when self.tokens[self.pos] in {
                .Newline() then { self.pos += 1 },
                _ then { return },
            }
        }
    }

    private expected_error(*self, expected String) String = {
        let got = self.peek()
        return "Parse error: expected \(expected), got '\(got.to_string())' at token #\(self.pos.to_string())"
    }

    private is_eof(*self) Bool = self.peek() is .EOF()

    private check(*self, expected Token) Bool =
        Token.tag(self.peek()) == Token.tag(expected)

    private expect(*mut self, expected Token, expected_name String) Result[Token] = {
        if self.check(expected) then { return .Ok(self.eat()) }
        return .Error(box(self.expected_error(expected_name)))
    }

    private expect_ident(*mut self, what String) Result[Token] = 
        when self.peek() in {
            .Ident(_) then .Ok(self.eat()),
            _ then .Error(box(self.expected_error(what))),
        }

    private is_type_start(*self, t Token) Bool = when t in {
        .Star() or .KwPtr() or .KwWeakref() or .KwSelfType() then true,
        .Ident(name) then {
            let runes = name.to_runes()
            if runes.count() == 0 then { return false }
            let first = runes[0].to_uint32()
            break first >= 65 and first <= 90
        },
        _ then false,
    }

    private eat(*mut self) Token = {
        self.skip_newlines()
        return self.advance()
    }

    private eat_comma(*mut self) Option[Token] = {
        if self.check(Token.Comma()) then { return .Some(self.eat()) }
        return .None()
    }

    private count_newlines(*self) UInt = {
        let mut count UInt = 0
        let mut i = self.pos
        while i < self.tokens.count() then {
            when self.tokens[i] in {
                .Newline() then { count += 1; i += 1 },
                _ then { return count },
            }
        }
        return count
    }

    private peek_at_skip_nl(*self, offset UInt) Token = {
        let mut count UInt = 0
        let mut i = self.pos
        while i < self.tokens.count() then {
            when self.tokens[i] in {
                .Newline() then { i += 1; continue },
                _ then {
                    if count == offset then { return self.tokens[i] }
                    count += 1
                    i += 1
                },
            }
        }
        return Token.EOF()
    }

    private is_access_mod(*self) Bool =
        self.peek() is .KwPublic() or self.peek() is .KwPrivate() or self.peek() is .KwProtected()

    private access_modifier_token_count(*self) UInt = {
        if self.peek() is .KwProtected() and self.peek_at_skip_nl(1) is .KwPublic() then {
            return 2
        }
        if self.is_access_mod() then { return 1 }
        return 0
    }

    private eat_vis(*mut self) Option[Token] = {
        if self.check(.KwProtected()) and self.peek_at_skip_nl(1) is .KwPublic() then {
            self.eat()
            self.eat()
            return .Some(.KwProtectedPublic())
        }
        if self.is_access_mod() then { return .Some(self.eat()) }
        return .None()
    }

    private eat_modifiers(*mut self) List[Token] = {
        let mut mods = List[Token].new()
        while true then {
            when self.peek() in {
                .KwForeign() or .KwIntrinsic() then { mods.push(self.eat()) },
                _ then { return mods },
            }
        }
        return mods
    }

    private is_code_item(item CstItem) Bool = when item in {
        .Decl(_) or .Stmt(_) then true,
        _ then false,
    }

    private last_item_is_code(*self, items List[*CstItem]) Bool = {
        if items.count() == 0 then { return false }
        let prev = *items[items.count() - 1]
        return CstParser.is_code_item(prev)
    }

    // Check if we crossed a newline boundary (for statement termination)
    private at_newline_boundary(*self) Bool = {
        if self.pos == 0 then { return false }
        // Check if there's a newline between current pos-1 and the next non-newline
        let mut i = self.pos
        if i > 0 then {
            i -= 1
            while i > 0 then {
                when self.tokens[i] in {
                    .Newline() then { return true },
                    _ then { return false },
                }
            }
        }
        return false
    }

    // Check if there's a newline before the current peek position
    private newline_before_current(*self) Bool = {
        if self.line_join_grouping > 0 then { return false }
        return self.count_newlines() > 0
    }

    private enter_line_join_grouping(*mut self) Void = {
        self.line_join_grouping += 1
    }

    private leave_line_join_grouping(*mut self) Void = {
        if self.line_join_grouping > 0 then {
            self.line_join_grouping -= 1
        }
    }

    // ========================================================================
    // Type parsing
    // ========================================================================

    public parse_type(*mut self) Result[CstType] = {
        return self.parse_type_node()
    }

    private parse_type_node(*mut self) Result[CstType] = {
        if self.check(.KwPtr()) then {
            let kw = self.eat()
            let mut mut_kw = Option[Token].None()
            if self.check(.KwMut()) then {
                mut_kw = .Some(self.eat())
            }
            let inner = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            if mut_kw is .Some(mk) then {
                return .Ok(.Mut(box(CstType.Ptr(box(inner), kw)), mk))
            }
            return .Ok(.Ptr(box(inner), kw))
        }
        if self.check(.Star()) then {
            let kw = self.eat()
            if self.check(.KwRaw()) then {
                let ignored_raw_kw = self.eat()
                let mut mut_kw = Option[Token].None()
                if self.check(.KwMut()) then {
                    mut_kw = .Some(self.eat())
                }
                let inner = when self.parse_type_node() in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                let ptr_kw = Token.KwPtr()
                let _ = ignored_raw_kw
                if mut_kw is .Some(mk) then {
                    return .Ok(.Mut(box(CstType.Ptr(box(inner), ptr_kw)), mk))
                }
                return .Ok(.Ptr(box(inner), ptr_kw))
            }
            let mut mut_kw = Option[Token].None()
            if self.check(.KwMut()) then {
                mut_kw = .Some(self.eat())
            }
            let inner = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            if mut_kw is .Some(mk) then {
                return .Ok(.Mut(box(CstType.Ref(box(inner), kw)), mk))
            }
            return .Ok(.Ref(box(inner), kw))
        }
        if self.check(.KwWeakref()) then {
            let kw = self.eat()
            let mut mut_kw = Option[Token].None()
            if self.check(.KwMut()) then {
                mut_kw = .Some(self.eat())
            }
            let inner = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            if mut_kw is .Some(mk) then {
                return .Ok(.Mut(box(CstType.Weakref(box(inner), kw)), mk))
            }
            return .Ok(.Weakref(box(inner), kw))
        }

        // Self type
        if self.check(.KwSelfType()) then {
            let kw = self.eat()
            return .Ok(CstType.SelfType(kw))
        }

        // Simple named type
        let name = when self.expect_ident("type name") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        when name in {
            .Ident(n) then {
                let runes = n.to_runes()
                if runes.count() == 0 then {
                    return .Error(box("Parse error: empty type name"))
                } else {
                    let first = runes[0].to_uint32()
                    if first < 65 or first > 90 then {
                        return .Error(box("Parse error: type name must start with uppercase, got '\(n)'"))
                    }
                }
            },
            _ then {},
        }
        let mut t = CstType.Named(name)
        while self.check(.LBracket()) then {
            let lb = self.eat()
            let mut args = List[CstTypeArg].new()
            while not self.check(.RBracket()) and not self.is_eof() then {
                let inner = when self.parse_type_node() in {
                    .Ok(parsed_type) then parsed_type,
                    .Error(e) then { return .Error(e) },
                }
                let comma = self.eat_comma()
                args.push(CstTypeArg(box(inner), comma))
            }
            let rb = when self.expect(.RBracket(), "']'") in {
                .Ok(tok) then tok,
                .Error(e) then { return .Error(e) },
            }
            when t in {
                .Named(base) then { t = .Generic(lb, args, rb, base) },
                _ then { return .Error(box("Parse error: generic arguments require a named base type")) },
            }
        }
        return .Ok(t)
    }

    private parse_type_suffix(*mut self, base CstType) CstType = {
        return base
    }

    // ========================================================================
    // Generic parameters: [T Any, U Eq]
    // ========================================================================

    private parse_generic_params(*mut self) Result[Option[* CstGenericParams]] = {
        if not self.check(.LBracket()) then {
            return .Ok(.None())
        }
        let lb = when self.expect(.LBracket(), "'['") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let mut params = List[CstGenericParam].new()
        while not self.check(.RBracket()) and not self.is_eof() then {
            let name = when self.expect_ident("generic parameter name") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            let mut constraints = List[* CstType].new()
            // Collect constraint types until comma or ]
            while not self.check(.Comma()) and not self.check(.RBracket()) and not self.is_eof() then {
                if self.check(.KwAnd()) then {
                    self.eat()
                    continue
                }
                let ct = when self.parse_type_node() in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                constraints.push(box(ct))
            }
            let comma = self.eat_comma()
            params.push(CstGenericParam(name, constraints, comma))
        }
        let rb = when self.expect(.RBracket(), "']'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        return .Ok(.Some(box(CstGenericParams(lb, params, rb))))
    }

    // ========================================================================
    // Parameters: (name Type, name2 Type2)
    // ========================================================================

    private parse_params(*mut self) Result[List[CstParam]] = {
        let mut params = List[CstParam].new()
        let mut first UInt = 1
        while not self.check(.RParen()) and not self.is_eof() then {
            // Method-first-param support: self / *self / *self mut
            if first == 1 and self.check(.Star()) then {
                let ref_kw = self.eat()
                let mut mut_kw = Option[Token].None()
                if self.check(.KwMut()) then {
                    mut_kw = .Some(self.eat())
                }
                let kw = when self.expect(.KwSelf(), "'self'") in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                let comma = self.eat_comma()
                params.push(.SelfParam(kw, mut_kw, .Some(ref_kw), comma))
                first = 0
                continue
            }
            if first == 1 and self.check(.KwSelf()) then {
                let kw = self.eat()
                let comma = self.eat_comma()
                params.push(.SelfParam(kw, .None(), .None(), comma))
                first = 0
                continue
            }

            let mut param_mut = Option[Token].None()
            if self.check(.KwMut()) then {
                param_mut = .Some(self.eat())
            }

            let name = when self.expect_ident("parameter name") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }

            let mut colon = Option[Token].None()
            if self.check(.Colon()) then {
                colon = .Some(self.eat())
            }

            // Parameters must have explicit type annotation.
            if not self.is_type_start(self.peek()) then {
                return .Error(box("Parse error: expected parameter type after '\(name.to_string())'"))
            }
            let pt = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            let comma = self.eat_comma()
            params.push(.NamedParam(name, param_mut, colon, box(pt), comma))
            first = 0
        }
        return .Ok(params)
    }

    // ========================================================================
    // Expression parsing — recursive descent with precedence
    // ========================================================================
    // Precedence (low to high):
    //   or return
    //   or else
    //   or
    //   and then
    //   and
    //   not
    //   is / is not
    //   | (bitwise or)
    //   ^ (bitwise xor)
    //   & (bitwise and)
    //   range (.., ..<, etc.)
    //   == <> > < >= <=
    //   << >>
    //   + -
    //   * / %
    //   prefix (-, ~, deptr, cast)
    //   postfix (., call, subscript)
    //   primary
    // ========================================================================

    public parse_expr(*mut self) Result[CstExpr] = {
        return self.parse_expr_node()
    }

    private parse_expr_node(*mut self) Result[CstExpr] = {
        return self.parse_or_return()
    }

    private parse_or_return(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_or_else() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while self.check(.KwOr()) then {
            let next = self.peek_at_skip_nl(1)
            when next in {
                .KwReturn() then {
                    let or_kw = self.eat()
                    let ret_kw = self.eat()
                    left = .OrReturn(box(left), or_kw, ret_kw)
                },
                _ then { break },
            }
        }
        return .Ok(left)
    }

    private parse_or_else(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_or() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while self.check(.KwOr()) then {
            let next = self.peek_at_skip_nl(1)
            when next in {
                .KwElse() then {
                    let or_kw = self.eat()
                    let else_kw = self.eat()
                    let right = when self.parse_or() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    left = .OrElse(box(left), or_kw, else_kw, box(right))
                },
                _ then { break },
            }
        }
        return .Ok(left)
    }

    private parse_or(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_and_then() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while self.check(.KwOr()) then {
            let next = self.peek_at_skip_nl(1)
            if next is .KwElse() then { break }
            if next is .KwReturn() then { break }
            let op = self.eat()
            let right = when self.parse_and_then() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            left = .BinaryOp(box(left), op, box(right))
        }
        return .Ok(left)
    }

    private parse_and_then(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_and() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while self.check(.KwAnd()) then {
            let next = self.peek_at_skip_nl(1)
            when next in {
                .KwThen() then {
                    let and_kw = self.eat()
                    let then_kw = self.eat()
                    let right = when self.parse_and() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    left = .AndThen(box(left), and_kw, then_kw, box(right))
                },
                _ then { break },
            }
        }
        return .Ok(left)
    }

    private parse_and(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_not() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while self.check(.KwAnd()) then {
            let next = self.peek_at_skip_nl(1)
            if next is .KwThen() then { break }
            let op = self.eat()
            let right = when self.parse_not() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            left = .BinaryOp(box(left), op, box(right))
        }
        return .Ok(left)
    }

    private parse_single_pattern(*mut self) Result[CstPattern] = {
        return self.parse_primary_pattern()
    }

    private parse_is(*mut self) Result[CstExpr] = {
        let left = when self.parse_bitwise_or() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }

        if self.newline_before_current() then {
            return .Ok(left)
        }
        if not self.check(.KwIs()) then {
            return .Ok(left)
        }

        let is_kw = self.eat()
        let mut not_kw = Option[Token].None()
        if self.check(.KwNot()) then {
            not_kw = .Some(self.eat())
        }
        let pattern = when self.parse_single_pattern() in {
            .Ok(p) then p,
            .Error(e) then { return .Error(e) },
        }
        return .Ok(.IsExpr(box(left), is_kw, not_kw, box(pattern)))
    }

    private parse_not(*mut self) Result[CstExpr] = {
        if self.check(.KwNot()) then {
            let op = self.eat()
            let operand = when self.parse_is() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.NotExpr(op, box(operand)))
        }
        return self.parse_is()
    }

    private parse_bitwise_or(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_bitwise_xor() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while self.check(.Pipe()) then {
            if self.newline_before_current() then { break }
            let op = self.eat()
            let right = when self.parse_bitwise_xor() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            left = .BinaryOp(box(left), op, box(right))
        }
        return .Ok(left)
    }

    private parse_bitwise_xor(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_bitwise_and() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while self.check(.Caret()) then {
            if self.newline_before_current() then { break }
            let op = self.eat()
            let right = when self.parse_bitwise_and() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            left = .BinaryOp(box(left), op, box(right))
        }
        return .Ok(left)
    }

    private parse_bitwise_and(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_range() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while self.check(.Amp()) then {
            if self.newline_before_current() then { break }
            let op = self.eat()
            let right = when self.parse_range() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            left = .BinaryOp(box(left), op, box(right))
        }
        return .Ok(left)
    }

    private parse_range(*mut self) Result[CstExpr] = {
        // Prefix range: ..b, ..<b, ..., ...<b, ....
        when self.peek() in {
            .Range() then {
                let op = self.eat()
                if self.can_start_range_bound() then {
                    let right = when self.parse_comparison() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    return .Ok(.RangeExpr(.None(), op, .Some(box(right))))
                }
                return .Ok(.RangeExpr(.None(), op, .None()))
            },
            .RangeLt() then {
                let op = self.eat()
                let right = when self.parse_comparison() in {
                    .Ok(e) then e,
                    .Error(e) then { return .Error(e) },
                }
                return .Ok(.RangeExpr(.None(), op, .Some(box(right))))
            },
            .FullRange() then {
                let op = self.eat()
                return .Ok(.RangeExpr(.None(), op, .None()))
            },
            .Unbounded() then {
                let op = self.eat()
                if self.can_start_range_bound() then {
                    let right = when self.parse_comparison() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    return .Ok(.RangeExpr(.None(), op, .Some(box(right))))
                }
                return .Ok(.RangeExpr(.None(), op, .None()))
            },
            .UnboundedLt() then {
                let op = self.eat()
                let right = when self.parse_comparison() in {
                    .Ok(e) then e,
                    .Error(e) then { return .Error(e) },
                }
                return .Ok(.RangeExpr(.None(), op, .Some(box(right))))
            },
            _ then {},
        }

        let left = when self.parse_comparison() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }

        when self.peek() in {
            .Range() then {
                let op = self.eat()
                if self.can_start_range_bound() then {
                    let right = when self.parse_comparison() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    return .Ok(.RangeExpr(.Some(box(left)), op, .Some(box(right))))
                }
                return .Ok(.RangeExpr(.Some(box(left)), op, .None()))
            },
            .RangeLt() or .LtRangeLt() then {
                let op = self.eat()
                let right = when self.parse_comparison() in {
                    .Ok(e) then e,
                    .Error(e) then { return .Error(e) },
                }
                return .Ok(.RangeExpr(.Some(box(left)), op, .Some(box(right))))
            },
            .LtRange() then {
                let op = self.eat()
                if self.can_start_range_bound() then {
                    let right = when self.parse_comparison() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    return .Ok(.RangeExpr(.Some(box(left)), op, .Some(box(right))))
                }
                return .Ok(.RangeExpr(.Some(box(left)), op, .None()))
            },
            .Unbounded() or .LtUnbounded() then {
                let op = self.eat()
                return .Ok(.RangeExpr(.Some(box(left)), op, .None()))
            },
            _ then { return .Ok(left) },
        }
    }

    private can_start_range_bound(*self) Bool = when self.peek() in {
        .KwIf() or .KwWhile() or .KwWhen() or .KwFor() then true,
        .Minus() or .Tilde() or .Amp() or .Star() then true,
        .Ident(_) or .KwSelf() or .KwSelfType() or .IntLit(_) or .FloatLit(_) or .StrLit(_) or .InterpStr(_) or .BoolTrue() or .BoolFalse() then true,
        .LBrace() or .LParen() or .LBracket() or .Dot() then true,
        _ then false,
    }

    private parse_comparison(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_shift() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while true then {
            when self.peek() in {
                .EqEq() or .NotEq() or .Gt() or .Lt() or .GtEq() or .LtEq() then {
                    if self.newline_before_current() then { break }
                    let op = self.eat()
                    let right = when self.parse_shift() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    left = .BinaryOp(box(left), op, box(right))
                },
                _ then { break },
            }
        }
        return .Ok(left)
    }

    private parse_shift(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_additive() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while true then {
            when self.peek() in {
                .LShift() or .RShift() then {
                    if self.newline_before_current() then { break }
                    let op = self.eat()
                    let right = when self.parse_additive() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    left = .BinaryOp(box(left), op, box(right))
                },
                _ then { break },
            }
        }
        return .Ok(left)
    }

    private parse_additive(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_multiplicative() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while true then {
            when self.peek() in {
                .Plus() then {
                    if self.newline_before_current() then { break }
                    let op = self.eat()
                    let right = when self.parse_multiplicative() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    left = .BinaryOp(box(left), op, box(right))
                },
                .Minus() then {
                    if self.newline_before_current() then { break }
                    let op = self.eat()
                    let right = when self.parse_multiplicative() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    left = .BinaryOp(box(left), op, box(right))
                },
                _ then { break },
            }
        }
        return .Ok(left)
    }

    private parse_multiplicative(*mut self) Result[CstExpr] = {
        let mut left = when self.parse_prefix() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while true then {
            when self.peek() in {
                .Star() or .Slash() or .Percent() then {
                    if self.newline_before_current() then { break }
                    let op = self.eat()
                    let right = when self.parse_prefix() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    left = .BinaryOp(box(left), op, box(right))
                },
                _ then { break },
            }
        }
        return .Ok(left)
    }

    // ========================================================================
    // Prefix expressions
    // ========================================================================

    private parse_prefix(*mut self) Result[CstExpr] = {
        let mut leading_comments = List[Token].new()
        while self.peek() is .LineComment(_) or self.peek() is .BlockComment(_) or self.peek() is .Semi() then {
            if self.peek() is .Semi() then {
                let ignored_semi = self.eat()
            } else {
                leading_comments.push(self.eat())
            }
        }

        if leading_comments.count() > 0 then {
            let inner = when self.parse_prefix() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.Commented(leading_comments, box(inner)))
        }

        // Unary minus
        if self.check(.Minus()) then {
            let op = self.eat()
            // Check for negative literal
            when self.peek() in {
                .IntLit(_) then {
                    let lit = self.eat()
                    return .Ok(.UnaryMinus(op, box(CstExpr.IntLit(lit))))
                },
                .FloatLit(_) then {
                    let lit = self.eat()
                    return .Ok(.UnaryMinus(op, box(CstExpr.FloatLit(lit))))
                },
                _ then {
                    let operand = when self.parse_prefix() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    return .Ok(.UnaryMinus(op, box(operand)))
                },
            }
        }

        // Bitwise not
        if self.check(.Tilde()) then {
            let op = self.eat()
            let operand = when self.parse_prefix() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.BitwiseNot(op, box(operand)))
        }

        // Dereference
        if self.check(.Star()) then {
            let op = self.eat()
            let operand = when self.parse_prefix() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.Deref(op, box(operand)))
        }

        // Address-of: &, &mut, &raw, &raw mut
        if self.check(.Amp()) then {
            let op = self.eat()
            let mut raw_kw = Option[Token].None()
            let mut mut_kw = Option[Token].None()
            if self.check(.KwRaw()) then {
                raw_kw = .Some(self.eat())
                if self.check(.KwMut()) then {
                    mut_kw = .Some(self.eat())
                }
            } else if self.check(.KwMut()) then {
                mut_kw = .Some(self.eat())
            }
            let operand = when self.parse_prefix() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.AddressOf(op, raw_kw, mut_kw, box(operand)))
        }

        return self.parse_postfix()
    }

    // ========================================================================
    // Postfix expressions
    // ========================================================================

    private parse_postfix(*mut self) Result[CstExpr] = {
        let mut expr = when self.parse_primary() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        while true then {
            // Stop at newline for non-continuation tokens
            if self.newline_before_current() then {
                if self.peek() is not .Dot() then { break }
            }

            // Field access: expr.field
            if self.check(.Dot()) then {
                let dot = self.eat()

                if self.check(.LParen()) then {
                    let trait_lp = self.eat()
                    let trait_name = when self.expect_ident("trait name") in {
                        .Ok(t) then t,
                        .Error(e) then { return .Error(e) },
                    }
                    let trait_rp = when self.expect(.RParen(), "')'") in {
                        .Ok(t) then t,
                        .Error(e) then { return .Error(e) },
                    }
                    let method_name = when self.expect_ident("method name") in {
                        .Ok(t) then t,
                        .Error(e) then { return .Error(e) },
                    }
                    let lp = when self.expect(.LParen(), "'('") in {
                        .Ok(t) then t,
                        .Error(e) then { return .Error(e) },
                    }
                    let args = when self.parse_call_args() in {
                        .Ok(a) then a,
                        .Error(e) then { return .Error(e) },
                    }
                    let rp = when self.expect(.RParen(), "')'") in {
                        .Ok(t) then t,
                        .Error(e) then { return .Error(e) },
                    }
                    expr = .QualifiedCall(box(expr), dot, trait_lp, trait_name, trait_rp, method_name, lp, args, rp)
                    continue
                }

                let field = when self.expect_ident("field name") in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                // Check for method call: expr.field(args)
                if (not self.newline_before_current()) and self.check(.LParen()) then {
                    let field_expr = CstExpr.FieldAccess(box(expr), dot, field)
                    let lp = self.eat()
                    let args = when self.parse_call_args() in {
                        .Ok(a) then a,
                        .Error(e) then { return .Error(e) },
                    }
                    let rp = when self.expect(.RParen(), "')'") in {
                        .Ok(t) then t,
                        .Error(e) then { return .Error(e) },
                    }
                    expr = .Call(box(field_expr), lp, args, rp)
                    continue
                }
                expr = .FieldAccess(box(expr), dot, field)
                continue
            }

            // Postfix cast: expr(Type)
            if self.check(.LParen()) then {
                let saved = self.pos
                let lp = self.eat()
                if self.is_type_start(self.peek()) then {
                    let cast_type = when self.parse_type_node() in {
                        .Ok(t) then t,
                        .Error(_) then {
                            self.pos = saved
                            let lp2 = self.eat()
                            let args2 = when self.parse_call_args() in {
                                .Ok(a) then a,
                                .Error(e) then { return .Error(e) },
                            }
                            let rp2 = when self.expect(.RParen(), "')'") in {
                                .Ok(t) then t,
                                .Error(e) then { return .Error(e) },
                            }
                            expr = .Call(box(expr), lp2, args2, rp2)
                            continue
                        },
                    }
                    if self.check(.RParen()) then {
                        let rp = self.eat()
                        expr = .TypeCast(lp, box(cast_type), rp, box(expr))
                        continue
                    }
                }
                self.pos = saved
                let call_lp = self.eat()
                let args = when self.parse_call_args() in {
                    .Ok(a) then a,
                    .Error(e) then { return .Error(e) },
                }
                let rp = when self.expect(.RParen(), "')'") in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                expr = .Call(box(expr), call_lp, args, rp)
                continue
            }

            // Generic instantiation suffix: expr[T]
            if self.check(.LBracket()) then {
                if self.is_type_start(self.peek_at_skip_nl(1)) then {
                    let lb = self.eat()
                    let mut type_args = List[CstTypeArg].new()
                    while not self.check(.RBracket()) and not self.is_eof() then {
                        let t = when self.parse_type_node() in {
                            .Ok(parsed_type) then parsed_type,
                            .Error(e) then { return .Error(e) },
                        }
                        let comma = self.eat_comma()
                        type_args.push(CstTypeArg(box(t), comma))
                    }
                    let rb = when self.expect(.RBracket(), "']'") in {
                        .Ok(t) then t,
                        .Error(e) then { return .Error(e) },
                    }
                    expr = .GenericInst(box(expr), lb, type_args, rb)
                    continue
                }

                // Subscript: expr[args]
                let lb = self.eat()
                let mut args = List[CstCallArg].new()
                while not self.check(.RBracket()) and not self.is_eof() then {
                    let value = when self.parse_expr_node() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    let comma = self.eat_comma()
                    args.push(CstCallArg(.None(), .None(), box(value), comma))
                }
                let rb = when self.expect(.RBracket(), "']'") in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                expr = .SubscriptExpr(box(expr), lb, args, rb)
                continue
            }

            break
        }
        return .Ok(expr)
    }

    private parse_call_args(*mut self) Result[List[CstCallArg]] = {
        let mut args = List[CstCallArg].new()
        self.enter_line_join_grouping()
        while not self.check(.RParen()) and not self.is_eof() then {
            if self.check(.Semi()) then {
                self.eat()
                continue
            }
            let mut leading_comments = List[Token].new()
            while self.peek() is .LineComment(_) or self.peek() is .BlockComment(_) then {
                leading_comments.push(self.eat())
            }
            let before = self.pos
            let mut label = Option[Token].None()
            let mut colon = Option[Token].None()
            if self.peek() is .Ident(_) and self.peek_at_skip_nl(1) is .Colon() then {
                label = .Some(self.eat())
                colon = .Some(self.eat())
            }
            let mut value = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            if leading_comments.count() > 0 then {
                value = .Commented(leading_comments, box(value))
            }
            let comma = self.eat_comma()
            args.push(CstCallArg(label, colon, box(value), comma))
            if self.pos == before then {
                self.leave_line_join_grouping()
                return .Error(box("Parse error: parser made no progress in argument list"))
            }
        }
        self.leave_line_join_grouping()
        return .Ok(args)
    }

    // ========================================================================
    // Primary expressions
    // ========================================================================

    private parse_primary(*mut self) Result[CstExpr] = {
        when self.peek() in {
            .KwIf() then { return self.parse_if_expr() },
            .KwWhile() then { return self.parse_while_expr() },
            .KwFor() then { return self.parse_for_expr() },
            .KwWhen() then { return self.parse_when_expr() },
            _ then {},
        }

        when self.peek() in {
            .IntLit(_) then { return .Ok(.IntLit(self.eat())) },
            .FloatLit(_) then { return .Ok(.FloatLit(self.eat())) },
            .StrLit(_) then { return .Ok(.StrLit(self.eat())) },
            .InterpStr(_) then { return .Ok(.InterpStr(self.eat())) },
            .BoolTrue() or .BoolFalse() then { return .Ok(.BoolLit(self.eat())) },
            .KwSelf() then { return .Ok(.SelfExpr(self.eat())) },
            .Underscore() then { return .Ok(.UnderscoreExpr(self.eat())) },
            _ then {},
        }

        // Identifier
        if self.peek() is .Ident(_) then { return .Ok(.Ident(self.eat())) }

        // Block: { ... }
        if self.check(.LBrace()) then {
            return self.parse_block_expr()
        }

        // Parenthesized expression or lambda
        if self.check(.LParen()) then {
            return self.parse_paren_or_lambda()
        }

        // Collection literals: [] / [a, b] / [key: value]
        if self.check(.LBracket()) then {
            return self.parse_collection_literal()
        }

        // Implicit member: .Name or .Name(args)
        if self.check(.Dot()) then {
            let dot = self.eat()
            let name = when self.expect_ident("member name") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            if self.check(.LParen()) then {
                let lp = self.eat()
                let args = when self.parse_call_args() in {
                    .Ok(a) then a,
                    .Error(e) then { return .Error(e) },
                }
                let rp = when self.expect(.RParen(), "')'") in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                return .Ok(.ImplicitMember(dot, name, .Some(lp), args, .Some(rp)))
            }
            return .Ok(.ImplicitMember(dot, name, .None(), List[CstCallArg].new(), .None()))
        }

        // Self type used as expression
        if self.check(.KwSelfType()) then {
            return .Ok(.Ident(self.eat()))
        }

        // Invalid primary token
        let got = self.peek()
        when got in {
            .RParen() or .RBracket() or .RBrace() or .Comma() or .Semi() then {
                return .Error(box("Parse error: expected primary expression, got '\(got.to_string())' at token #\(self.pos.to_string())"))
            },
            _ then {},
        }
        if not self.is_eof() then {
            let bad = self.eat()
            return .Ok(.Ident(bad))
        }
        return .Error(box("Parse error: expected primary expression, got '\(got.to_string())' at token #\(self.pos.to_string())"))
    }

    private parse_collection_literal(*mut self) Result[CstExpr] = {
        let lb = when self.expect(.LBracket(), "'['") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        self.enter_line_join_grouping()

        if self.check(.RBracket()) then {
            let rb = when self.expect(.RBracket(), "']'") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            self.leave_line_join_grouping()
            return .Ok(.EmptyLiteral(lb, rb))
        }

        let first = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }

        if self.check(.Colon()) then {
            let mut entries = List[CstDictEntry].new()
            let first_colon = self.eat()
            let first_value = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            let first_comma = self.eat_comma()
            entries.push(CstDictEntry(box(first), first_colon, box(first_value), first_comma))

            while not self.check(.RBracket()) and not self.is_eof() then {
                let key = when self.parse_expr_node() in {
                    .Ok(e) then e,
                    .Error(e) then { return .Error(e) },
                }
                let colon = when self.expect(.Colon(), "':'") in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                let value = when self.parse_expr_node() in {
                    .Ok(e) then e,
                    .Error(e) then { return .Error(e) },
                }
                let comma = self.eat_comma()
                entries.push(CstDictEntry(box(key), colon, box(value), comma))
            }

            let rb = when self.expect(.RBracket(), "']'") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            self.leave_line_join_grouping()
            return .Ok(.DictLiteral(lb, entries, rb))
        }

        let mut elements = List[CstCollectionElement].new()
        let first_comma = self.eat_comma()
        elements.push(CstCollectionElement(box(first), first_comma))
        while not self.check(.RBracket()) and not self.is_eof() then {
            let element = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            let comma = self.eat_comma()
            elements.push(CstCollectionElement(box(element), comma))
        }

        let rb = when self.expect(.RBracket(), "']'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        self.leave_line_join_grouping()
        return .Ok(.CollectionLiteral(lb, elements, rb))
    }

    // ========================================================================
    // Block expression: { statements }
    // Note: block body is statement-only (no trailing final-expression slot).
    // ========================================================================

    private parse_block_expr(*mut self) Result[CstExpr] = {
        let lb = when self.expect(.LBrace(), "'{'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let mut items = List[*CstItem].new()
        while not self.check(.RBrace()) and not self.is_eof() then {
            let nl_count = self.count_newlines()
            if nl_count >= 2 then {
                self.skip_newlines()
                items.push(box(CstItem.BlankLine()))
                continue
            }
            self.skip_newlines()
            if self.check(.RBrace()) or self.is_eof() then { break }
            if self.peek() is .LineComment(_) or self.peek() is .BlockComment(_) then {
                let c = self.eat()
                let prev_is_code = self.last_item_is_code(items)
                if nl_count == 0 and prev_is_code then {
                    items.push(box(CstItem.TrailingComment(c)))
                } else {
                    items.push(box(CstItem.Comment(c)))
                }
                continue
            }
            when self.parse_block_item() in {
                .Ok(item) then { items.push(box(item)) },
                .Error(e) then { return .Error(e) },
            }
        }
        let rb = when self.expect(.RBrace(), "'}'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        return .Ok(.Block(lb, items, rb))
    }

    private parse_block_item(*mut self) Result[CstItem] = {
        // Variable declaration: let [mut] name [Type] = expr
        if self.peek() is .KwLet() then {
            when self.parse_var_decl_stmt() in {
                .Ok(s) then { return .Ok(.Stmt(box(s))) },
                .Error(e) then { return .Error(e) },
            }
        }
        // Statement
        return when self.parse_stmt() in {
            .Ok(s) then .Ok(.Stmt(box(s))),
            .Error(e) then .Error(e),
        }
    }

    // ========================================================================
    // Parenthesized expression or lambda
    // ========================================================================

    private parse_paren_or_lambda(*mut self) Result[CstExpr] = {
        // Try lambda: (params) [RetType] -> body
        let saved = self.pos
        let lambda_result = self.try_parse_lambda()
        when lambda_result in {
            .Some(e) then { return .Ok(e) },
            .None() then { self.pos = saved },
        }
        // Parenthesized expression
        let lp = when self.expect(.LParen(), "'('") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        if self.check(.RParen()) then {
            when self.expect(.RParen(), "')'") in {
                .Ok(_) then {},
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.Ident(.Ident("()")))
        }
        self.enter_line_join_grouping()
        let inner = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                self.leave_line_join_grouping()
                return .Error(e)
            },
        }
        if self.check(.Comma()) then {
            let comma = self.eat()
            let second = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then {
                    self.leave_line_join_grouping()
                    return .Error(e)
                },
            }
            let rp = when self.expect(.RParen(), "')'") in {
                .Ok(t) then t,
                .Error(e) then {
                    self.leave_line_join_grouping()
                    return .Error(e)
                },
            }
            self.leave_line_join_grouping()
            return .Ok(.PairExpr(lp, box(inner), comma, box(second), rp))
        }
        let rp = when self.expect(.RParen(), "')'") in {
            .Ok(t) then t,
            .Error(e) then {
                self.leave_line_join_grouping()
                return .Error(e)
            },
        }
        self.leave_line_join_grouping()

        // Keep one paren layer for readability, but collapse duplicate nesting:
        // ((x)) -> (x)
        when inner in {
            .Paren(_, nested, _) then { return .Ok(.Paren(lp, nested, rp)) },
            _ then { return .Ok(.Paren(lp, box(inner), rp)) },
        }
    }

    private try_parse_lambda(*mut self) Option[CstExpr] = {
        let lp = when self.expect(.LParen(), "'('") in {
            .Ok(t) then t,
            .Error(_) then { return .None() },
        }
        let mut params = List[CstLambdaParam].new()
        while not self.check(.RParen()) and not self.is_eof() then {
            if self.peek() is not .Ident(_) then { return .None() }
            let name = self.eat()
            // Optional type annotation
            let mut pt = Option[* CstType].None()
            if self.peek() is .Ident(_) or self.peek() is .LBracket() or self.peek() is .KwSelfType() then {
                // Check if this looks like a type (uppercase start or [)
                let is_type = self.is_type_start(self.peek())
                if is_type then {
                    let t = when self.parse_type_node() in {
                        .Ok(parsed_type) then parsed_type,
                        .Error(_) then { return .None() },
                    }
                    pt = .Some(box(t))
                }
            }
            let comma = self.eat_comma()
            params.push(CstLambdaParam(name, pt, comma))
        }
        if not self.check(.RParen()) then { return .None() }
        let rp = when self.expect(.RParen(), "')'") in {
            .Ok(t) then t,
            .Error(_) then { return .None() },
        }

        // Optional return type
        let mut ret = Option[* CstType].None()
        if self.peek() is .Ident(_) or self.peek() is .LBracket() or self.peek() is .KwSelfType() then {
            let is_type = self.is_type_start(self.peek())
            if is_type then {
                let t = when self.parse_type_node() in {
                    .Ok(parsed_type) then parsed_type,
                    .Error(_) then { return .None() },
                }
                ret = .Some(box(t))
            }
        }

        if not self.check(.Arrow()) then { return .None() }
        let arrow = self.eat()
        let body = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(_) then { return .None() },
        }
        return .Some(.Lambda(lp, params, rp, ret, arrow, box(body)))
    }

    // ========================================================================
    // Control flow expressions
    // ========================================================================

    private parse_if_expr(*mut self) Result[CstExpr] = {
        let kw = when self.expect(.KwIf(), "'if'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let cond = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }

        let then_kw = when self.expect(.KwThen(), "'then'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let then_body = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        if self.check(.KwElse()) then {
            let else_kw = self.eat()
            let else_body = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.If(kw, box(cond), then_kw, box(then_body),
                .Some(else_kw), .Some(box(else_body))))
        }
        return .Ok(.If(kw, box(cond), then_kw, box(then_body), .None(), .None()))
    }

    private parse_while_expr(*mut self) Result[CstExpr] = {
        let kw = when self.expect(.KwWhile(), "'while'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let cond = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }

        let then_kw = when self.expect(.KwThen(), "'then'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let body = if self.check(.LBrace()) then {
            break when self.parse_block_expr() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
        } else {
            break when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
        }
        return .Ok(.While(kw, box(cond), then_kw, box(body)))
    }

    private parse_for_expr(*mut self) Result[CstExpr] = {
        let kw = when self.expect(.KwFor(), "'for'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let binding = when self.parse_pattern_node() in {
            .Ok(p) then p,
            .Error(e) then { return .Error(e) },
        }
        let in_kw = when self.expect(.KwIn(), "'in'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let iterable = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        let then_kw = when self.expect(.KwThen(), "'then'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let body = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        return .Ok(.For(kw, box(binding), in_kw, box(iterable), then_kw, box(body)))
    }

    private parse_when_expr(*mut self) Result[CstExpr] = {
        let kw = when self.expect(.KwWhen(), "'when'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let subject = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        let in_kw = when self.expect(.KwIn(), "'in'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }

        let lb = when self.expect(.LBrace(), "'{'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let mut arms = List[* CstWhenArm].new()
        while not self.check(.RBrace()) and not self.is_eof() then {
            self.skip_newlines()
            if self.check(.RBrace()) or self.is_eof() then { break }
            let mut leading_comments = List[Token].new()
            while self.peek() is .LineComment(_) or self.peek() is .BlockComment(_) then {
                leading_comments.push(self.eat())
                self.skip_newlines()
                if self.check(.RBrace()) or self.is_eof() then { break }
            }
            if self.check(.RBrace()) or self.is_eof() then { break }
            when self.parse_when_arm() in {
                .Ok(arm) then { arms.push(box(CstWhenArm(leading_comments, arm.pattern, arm.then_kw, arm.body, arm.comma, arm.trailing_comments))) },
                .Error(e) then { return .Error(e) },
            }
        }
        let rb = when self.expect(.RBrace(), "'}'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        return .Ok(.When(kw, box(subject), in_kw, lb, arms, rb))
    }

    private parse_when_arm(*mut self) Result[CstWhenArm] = {
        let pattern = when self.parse_pattern_node() in {
            .Ok(p) then p,
            .Error(e) then { return .Error(e) },
        }
        let then_kw = when self.expect(.KwThen(), "'then'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let body = if self.check(.LBrace()) then {
            break when self.parse_block_expr() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
        } else {
            break when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
        }
        let comma = self.eat_comma()
        let mut trailing_comments = List[Token].new()
        while self.peek_raw() is .LineComment(_) or self.peek_raw() is .BlockComment(_) then {
            trailing_comments.push(self.advance())
        }
        // Skip semicolons too
        if self.peek() is .Semi() then { self.eat() }
        return .Ok(CstWhenArm(List[Token].new(), box(pattern), then_kw, box(body), comma, trailing_comments))
    }

    private expect_pattern_value(*mut self, what String) Result[Token] = {
        return when self.peek() in {
            .IntLit(_) or .FloatLit(_) or .StrLit(_) or .BoolTrue() or .BoolFalse() or .Ident(_) then .Ok(self.eat()),
            _ then .Error(box(self.expected_error(what))),
        }
    }

    // ========================================================================
    // Pattern parsing
    // ========================================================================

    public parse_pattern(*mut self) Result[CstPattern] = {
        return self.parse_pattern_node()
    }

    private parse_pattern_node(*mut self) Result[CstPattern] = {
        return self.parse_or_pattern()
    }

    private parse_or_pattern(*mut self) Result[CstPattern] = {
        let mut left = when self.parse_and_pattern() in {
            .Ok(p) then p,
            .Error(e) then { return .Error(e) },
        }
        while self.check(.KwOr()) then {
            let next = self.peek_at_skip_nl(1)
            if next is .KwElse() then { break }
            let op = self.eat()
            let right = when self.parse_and_pattern() in {
                .Ok(p) then p,
                .Error(e) then { return .Error(e) },
            }
            left = .OrPattern(box(left), op, box(right))
        }
        return .Ok(left)
    }

    private parse_and_pattern(*mut self) Result[CstPattern] = {
        let mut left = when self.parse_not_pattern() in {
            .Ok(p) then p,
            .Error(e) then { return .Error(e) },
        }
        while self.check(.KwAnd()) then {
            let next = self.peek_at_skip_nl(1)
            if next is .KwThen() then { break }
            let op = self.eat()
            let right = when self.parse_not_pattern() in {
                .Ok(p) then p,
                .Error(e) then { return .Error(e) },
            }
            left = .AndPattern(box(left), op, box(right))
        }
        return .Ok(left)
    }

    private parse_not_pattern(*mut self) Result[CstPattern] = {
        if self.check(.KwNot()) then {
            let op = self.eat()
            let inner = when self.parse_not_pattern() in {
                .Ok(p) then p,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.NotPattern(op, box(inner)))
        }
        return self.parse_primary_pattern()
    }

    private parse_primary_pattern(*mut self) Result[CstPattern] = {
        // Comparison patterns: > n, < n, >= n, <= n
        when self.peek() in {
            .Gt() or .Lt() or .GtEq() or .LtEq() then {
                let op = self.eat()
                // Handle negative: > -5
                if self.check(.Minus()) then {
                    let minus = self.eat()
                    let value = when self.expect_pattern_value("pattern value") in {
                        .Ok(v) then v,
                        .Error(e) then { return .Error(e) },
                    }
                    return .Ok(.Comparison(op, value))
                }
                let value = when self.expect_pattern_value("pattern value") in {
                    .Ok(v) then v,
                    .Error(e) then { return .Error(e) },
                }
                return .Ok(.Comparison(op, value))
            },
            _ then {},
        }

        // Negative integer: -5
        if self.check(.Minus()) then {
            let minus = self.eat()
            let value = when self.expect_pattern_value("integer literal") in {
                .Ok(v) then v,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.NegIntLit(minus, value))
        }

        // Integer literal
        when self.peek() in {
            .IntLit(_) then { return .Ok(.PatIntLit(self.eat())) },
            .FloatLit(_) then { return .Ok(.PatIntLit(self.eat())) },
            .StrLit(_) then { return .Ok(.PatStrLit(self.eat())) },
            .BoolTrue() or .BoolFalse() then { return .Ok(.PatBoolLit(self.eat())) },
            _ then {},
        }

        // Wildcard
        if self.peek() is .Underscore() then { return .Ok(.Wildcard(self.eat())) }

        // Mutable variable: mut name
        if self.check(.KwMut()) then {
            let mut_kw = self.eat()
            let name = when self.expect_ident("pattern variable name") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.MutVariable(mut_kw, name))
        }

        // Enum case: .Name or .Name(args)
        if self.check(.Dot()) then {
            let dot = self.eat()
            let name = when self.expect_ident("enum case name") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            if self.check(.LParen()) then {
                let lp = self.eat()
                let mut args = List[CstPatternArg].new()
                while not self.check(.RParen()) and not self.is_eof() then {
                    let mut label = Option[Token].None()
                    let mut colon = Option[Token].None()
                    if self.peek() is .Ident(_) and self.peek_at_skip_nl(1) is .Colon() then {
                        label = .Some(self.eat())
                        colon = .Some(self.eat())
                    }
                    let p = when self.parse_pattern_node() in {
                        .Ok(parsed_pattern) then parsed_pattern,
                        .Error(e) then { return .Error(e) },
                    }
                    let comma = self.eat_comma()
                    args.push(CstPatternArg(label, colon, box(p), comma))
                }
                let rp = when self.expect(.RParen(), "')'") in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                return .Ok(.EnumCase(dot, name, .Some(lp), args, .Some(rp)))
            }
            return .Ok(.EnumCase(dot, name, .None(), List[CstPatternArg].new(), .None()))
        }

        // Parenthesized pattern
        if self.check(.LParen()) then {
            let lp = self.eat()
            let inner = when self.parse_pattern_node() in {
                .Ok(parsed_pattern) then parsed_pattern,
                .Error(e) then { return .Error(e) },
            }
            let rp = when self.expect(.RParen(), "')'") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.ParenPattern(lp, box(inner), rp))
        }

        // Variable or struct pattern: name or Name(args)
        if self.peek() is .Ident(_) then {
            let name = when self.expect_ident("pattern name") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            if self.check(.LParen()) then {
                let lp = self.eat()
                let mut args = List[CstPatternArg].new()
                while not self.check(.RParen()) and not self.is_eof() then {
                    let mut label = Option[Token].None()
                    let mut colon = Option[Token].None()
                    if self.peek() is .Ident(_) and self.peek_at_skip_nl(1) is .Colon() then {
                        label = .Some(self.eat())
                        colon = .Some(self.eat())
                    }
                    let p = when self.parse_pattern_node() in {
                        .Ok(parsed_pattern) then parsed_pattern,
                        .Error(e) then { return .Error(e) },
                    }
                    let comma = self.eat_comma()
                    args.push(CstPatternArg(label, colon, box(p), comma))
                }
                let rp = when self.expect(.RParen(), "')'") in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                return .Ok(.StructPattern(name, lp, args, rp))
            }
            return .Ok(.Variable(name))
        }

        // Fallback
        return .Error(box(self.expected_error("pattern")))
    }

    // ========================================================================
    // Statement parsing
    // ========================================================================

    private parse_stmt(*mut self) Result[CstStmt] = {
        when self.peek() in {
            .KwDefer() then {
                let kw = self.eat()
                let value = when self.parse_expr_node() in {
                    .Ok(e) then e,
                    .Error(e) then { return .Error(e) },
                }
                if self.peek() is .Semi() then { self.eat() }
                return .Ok(.Defer(kw, box(value)))
            },
            .KwReturn() then {
                let kw = self.eat()
                // Check if there's a value on the same line
                if self.peek_raw() is .Newline() or self.peek_raw() is .EOF() then {
                    return .Ok(.Return(kw, .None()))
                }
                if self.check(.RBrace()) then {
                    return .Ok(.Return(kw, .None()))
                }
                if self.check(.Semi()) then {
                    self.eat()
                    return .Ok(.Return(kw, .None()))
                }
                let value = when self.parse_expr_node() in {
                    .Ok(e) then e,
                    .Error(e) then { return .Error(e) },
                }
                // Eat optional semicolon
                if self.peek() is .Semi() then { self.eat() }
                return .Ok(.Return(kw, .Some(box(value))))
            },
            .KwBreak() then {
                let kw = self.eat()
                if self.peek_raw() is .Newline() or self.peek_raw() is .EOF() then {
                    return .Ok(.Break(kw, .None()))
                }
                if self.check(.RBrace()) then {
                    return .Ok(.Break(kw, .None()))
                }
                if self.peek() is .Semi() then { self.eat() }
                else {
                    let value = when self.parse_expr_node() in {
                        .Ok(e) then e,
                        .Error(e) then { return .Error(e) },
                    }
                    if self.peek() is .Semi() then { self.eat() }
                    return .Ok(.Break(kw, .Some(box(value))))
                }
                return .Ok(.Break(kw, .None()))
            },
            .KwContinue() then {
                let kw = self.eat()
                if self.peek() is .Semi() then { self.eat() }
                return .Ok(.Continue(kw))
            },
            _ then {},
        }

        // Expression statement — may be followed by assignment operator
        let expr = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        when self.peek() in {
            .Eq() or .PlusEq() or .MinusEq() or .StarEq() or .SlashEq() or .PercentEq()
            or .AmpEq() or .PipeEq() or .CaretEq() or .LShiftEq() or .RShiftEq() then {
                let op = self.eat()
                let value = when self.parse_expr_node() in {
                    .Ok(e) then e,
                    .Error(e) then { return .Error(e) },
                }
                if self.peek() is .Semi() then { self.eat() }
                return .Ok(.Assignment(box(expr), op, box(value)))
            },
            _ then {},
        }
        // Eat optional semicolon
        let mut semi = Option[Token].None()
        if self.peek() is .Semi() then { semi = .Some(self.eat()) }
        return .Ok(.ExprStmt(box(expr), semi))
    }

    private parse_var_decl_stmt(*mut self) Result[CstStmt] = {
        let let_kw = when self.expect(.KwLet(), "'let'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }

        if self.check(.LParen()) then {
            let lp = self.eat()
            let first = when self.parse_pair_binding() in {
                .Ok(binding) then binding,
                .Error(e) then { return .Error(e) },
            }
            let comma = when self.expect(.Comma(), "','") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            let second = when self.parse_pair_binding() in {
                .Ok(binding) then binding,
                .Error(e) then { return .Error(e) },
            }
            let rp = when self.expect(.RParen(), "')'") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            let eq = when self.expect(.Eq(), "'='") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            let value = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            if self.peek() is .Semi() then { self.eat() }
            return .Ok(.PairVarDecl(let_kw, lp, first, comma, second, rp, eq, box(value)))
        }

        let mut mut_kw = Option[Token].None()
        if self.check(.KwMut()) then {
            mut_kw = .Some(self.eat())
        }
        let name = when self.expect_ident("variable name") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }

        // Optional type annotation
        let mut var_type = Option[* CstType].None()
        if self.is_type_start(self.peek()) then {
            let t = when self.parse_type_node() in {
                .Ok(parsed_type) then parsed_type,
                .Error(e) then { return .Error(e) },
            }
            var_type = .Some(box(t))
        }

        let eq = when self.expect(.Eq(), "'='") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let value = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then { return .Error(e) },
        }
        // Eat optional semicolon
        if self.peek() is .Semi() then { self.eat() }
        return .Ok(.VarDecl(let_kw, mut_kw, name, var_type, eq, box(value)))
    }

    private parse_pair_binding(*mut self) Result[CstPairBinding] = {
        let mut mut_kw = Option[Token].None()
        if self.check(.KwMut()) then {
            mut_kw = .Some(self.eat())
        }

        if self.check(.Underscore()) then {
            let name = self.eat()
            return .Ok(CstPairBinding(mut_kw, name, .None(), true))
        }

        let name = when self.expect_ident("variable name") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }

        let mut binding_type = Option[* CstType].None()
        if not self.check(.Comma()) and not self.check(.RParen()) then {
            let t = when self.parse_type_node() in {
                .Ok(parsed_type) then parsed_type,
                .Error(e) then { return .Error(e) },
            }
            binding_type = .Some(box(t))
        }

        return .Ok(CstPairBinding(mut_kw, name, binding_type, false))
    }

    // ========================================================================
    // Declaration parsing
    // ========================================================================

    // Main entry point
    public parse(*mut self) Result[CstFile] = {
        let mut items = List[*CstItem].new()
        while not self.is_eof() then {
            let nl_count = self.count_newlines()
            if nl_count >= 2 then {
                self.skip_newlines()
                items.push(box(CstItem.BlankLine()))
                continue
            }
            self.skip_newlines()
            if self.is_eof() then { break }
            if self.check(.Semi()) then {
                self.eat()
                continue
            }
            if self.peek() is .LineComment(_) or self.peek() is .BlockComment(_) then {
                let c = self.eat()
                let prev_is_code = self.last_item_is_code(items)
                if nl_count == 0 and prev_is_code then {
                    items.push(box(CstItem.TrailingComment(c)))
                } else {
                    items.push(box(CstItem.Comment(c)))
                }
                continue
            }
            let before = self.pos
            when self.parse_top_item() in {
                .Ok(item) then { items.push(box(item)) },
                .Error(e) then { return .Error(e) },
            }
            if self.pos == before then {
                return .Error(box("Parse error: parser made no progress"))
            }
        }
        return .Ok(CstFile(items))
    }

    private parse_top_item(*mut self) Result[CstItem] = {
        // Using declaration
        if self.check(.KwUsing()) then {
            when self.parse_using_decl() in {
                .Ok(d) then { return .Ok(.Decl(box(d))) },
                .Error(e) then { return .Error(e) },
            }
        }
        // Foreign using
        if self.check(.KwForeign()) then {
            let next = self.peek_at_skip_nl(1)
            when next in {
                .KwUsing() then {
                    when self.parse_foreign_using_decl() in {
                        .Ok(d) then { return .Ok(.Decl(box(d))) },
                        .Error(e) then { return .Error(e) },
                    }
                },
                _ then {},
            }
        }

        // Determine declaration kind by peeking past access modifiers and modifiers
        let mut offset UInt = self.access_modifier_token_count()
        let after_access = self.peek_at_skip_nl(offset)
        if after_access is .KwForeign() or after_access is .KwIntrinsic() then { offset += 1 }
        let decl_kw = self.peek_at_skip_nl(offset)
        when decl_kw in {
            .KwLet() then {
                when self.parse_let_decl() in {
                    .Ok(d) then { return .Ok(.Decl(box(d))) },
                    .Error(e) then { return .Error(e) },
                }
            },
            .KwType() then {
                when self.parse_type_decl() in {
                    .Ok(d) then { return .Ok(.Decl(box(d))) },
                    .Error(e) then { return .Error(e) },
                }
            },
            .KwTrait() then {
                when self.parse_trait_decl() in {
                    .Ok(d) then { return .Ok(.Decl(box(d))) },
                    .Error(e) then { return .Error(e) },
                }
            },
            .KwGiven() then {
                when self.parse_given_decl() in {
                    .Ok(d) then { return .Ok(.Decl(box(d))) },
                    .Error(e) then { return .Error(e) },
                }
            },
            _ then {},
        }
        // Statement
        return when self.parse_stmt() in {
            .Ok(s) then .Ok(.Stmt(box(s))),
            .Error(e) then .Error(e),
        }
    }

    // ========================================================================
    // Using declarations
    // ========================================================================

    private parse_using_decl(*mut self) Result[CstDecl] = {
        let mut tokens = List[Token].new()
        while not self.is_eof() then {
            when self.peek_raw() in {
                .Newline() or .EOF() then { break },
                _ then { tokens.push(self.advance()) },
            }
        }
        return .Ok(.Using(tokens))
    }

    private parse_foreign_using_decl(*mut self) Result[CstDecl] = {
        let foreign_kw = when self.expect(.KwForeign(), "'foreign'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let mut tokens = List[Token].new()
        while not self.is_eof() then {
            when self.peek_raw() in {
                .Newline() or .EOF() then { break },
                _ then { tokens.push(self.advance()) },
            }
        }
        return .Ok(.ForeignUsing(foreign_kw, tokens))
    }

    // ========================================================================
    // Let declaration (function or variable)
    // ========================================================================

    private parse_let_decl(*mut self) Result[CstDecl] = {
        let vis = self.eat_vis()
        let mods = self.eat_modifiers()
        let let_kw = when self.expect(.KwLet(), "'let'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let mut mut_kw = Option[Token].None()
        if self.check(.KwMut()) then {
            mut_kw = .Some(self.eat())
        }
        return self.finish_func_or_var(vis, mods, .Some(let_kw), mut_kw, false)
    }

    private finish_func_or_var(*mut self,
        vis Option[Token], mods List[Token],
        let_kw Option[Token], mut_kw Option[Token],
        in_member_context Bool
    ) Result[CstDecl] = {
        let name = when self.expect_ident("declaration name") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let gp = when self.parse_generic_params() in {
            .Ok(g) then g,
            .Error(e) then { return .Error(e) },
        }

        // Parameters
        let mut lp = Option[Token].None()
        let mut params = List[CstParam].new()
        let mut rp = Option[Token].None()
        if self.check(.LParen()) then {
            lp = .Some(self.eat())
            params = when self.parse_params() in {
                .Ok(ps) then ps,
                .Error(e) then { return .Error(e) },
            }
            rp = .Some(when self.expect(.RParen(), "')'") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            })
        }

        // Return type
        let mut ret = Option[* CstType].None()
        if self.is_type_start(self.peek()) then {
            if not self.check(.Eq()) then {
                let t = when self.parse_type_node() in {
                    .Ok(parsed_type) then parsed_type,
                    .Error(e) then { return .Error(e) },
                }
                ret = .Some(box(t))
            }
        }

        // = body → function
        if self.check(.Eq()) then {
            let eq = self.eat()
            let body = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.Func(vis, mods, let_kw, mut_kw, gp, .Some(name),
                lp, params, rp, ret, eq, box(body)))
        }

        // No = → foreign declaration or variable
        if mods.count() > 0 then {
            return .Ok(.ForeignDecl(vis, mods, let_kw, mut_kw, gp, .Some(name),
                lp, params, rp, ret))
        }

        // In trait/given member context, signature-style declarations without
        // body are method signatures, not variable declarations.
        if in_member_context then {
            if lp is .Some(_) then {
                return .Ok(.ForeignDecl(vis, mods, let_kw, mut_kw, gp, .Some(name),
                    lp, params, rp, ret))
            }
            return .Error(box(self.expected_error("member signature")))
        }

        // Variable declaration (top-level)
        let lk = when let_kw in {
            .Some(k) then k,
            .None() then .KwLet(),
        }
        return .Ok(.Var(vis, lk, mut_kw, name, ret))
    }

    // ========================================================================
    // Type declaration
    // ========================================================================

    private parse_type_decl(*mut self) Result[CstDecl] = {
        let vis = self.eat_vis()
        let mods = self.eat_modifiers()
        let kw = when self.expect(.KwType(), "'type'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let name = when self.expect_ident("type name") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let gp = when self.parse_generic_params() in {
            .Ok(g) then g,
            .Error(e) then { return .Error(e) },
        }

        // Struct body: (fields)
        if self.check(.LParen()) then {
            let lp = self.eat()
            let mut items = List[*CstStructBodyItem].new()
            while not self.check(.RParen()) and not self.is_eof() then {
                let nl_count = self.count_newlines()
                if nl_count >= 2 then {
                    self.skip_newlines()
                    items.push(box(CstStructBodyItem.BlankLine()))
                    continue
                }
                self.skip_newlines()
                if self.check(.RParen()) or self.is_eof() then { break }
                if self.peek() is .LineComment(_) or self.peek() is .BlockComment(_) then {
                    let c = self.eat()
                    let prev_is_field =
                        if items.count() > 0 then {
                            break when *items[items.count() - 1] in { .Field(_) then true, _ then false }
                        } else false
                    if nl_count == 0 and prev_is_field then {
                        items.push(box(CstStructBodyItem.TrailingComment(c)))
                    } else {
                        items.push(box(CstStructBodyItem.Comment(c)))
                    }
                    continue
                }
                let mut field_mut = Option[Token].None()
                let field_access = self.eat_vis()
                if self.check(.KwMut()) then {
                    field_mut = .Some(self.eat())
                }
                let field_name = when self.expect_ident("field name") in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                let mut colon = Option[Token].None()
                if self.check(.Colon()) then {
                    colon = .Some(self.eat())
                }
                let field_type = when self.parse_type_node() in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                let comma = self.eat_comma()
                items.push(box(CstStructBodyItem.Field(CstStructField(field_mut, field_access, field_name, colon, box(field_type), comma))))
            }
            let rp = when self.expect(.RParen(), "')'") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.Type(vis, mods, kw, gp, name,
                box(CstTypeBody.Struct(lp, items, rp))))
        }

        // Enum body: { .Variant1, .Variant2(T) }
        if self.check(.LBrace()) then {
            let lb = self.eat()
            let mut cases = List[*CstItem].new()
            while not self.check(.RBrace()) and not self.is_eof() then {
                let nl_count = self.count_newlines()
                if nl_count >= 2 then {
                    self.skip_newlines()
                    cases.push(box(CstItem.BlankLine()))
                    continue
                }
                self.skip_newlines()
                if self.check(.RBrace()) or self.is_eof() then { break }
                if self.peek() is .LineComment(_) or self.peek() is .BlockComment(_) then {
                    let c = self.eat()
                    let prev_is_code = self.last_item_is_code(cases)
                    if nl_count == 0 and prev_is_code then {
                        cases.push(box(CstItem.TrailingComment(c)))
                    } else {
                        cases.push(box(CstItem.Comment(c)))
                    }
                    continue
                }
                let expr = when self.parse_enum_variant_expr() in {
                    .Ok(e) then e,
                    .Error(e) then { return .Error(e) },
                }
                when self.expect(.Comma(), "','") in {
                    .Ok(_) then {},
                    .Error(e) then { return .Error(e) },
                }
                let s = CstStmt.ExprStmt(box(expr), .None())
                cases.push(box(CstItem.Stmt(box(s))))
            }
            let rb = when self.expect(.RBrace(), "'}'") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.Type(vis, mods, kw, gp, name,
                box(CstTypeBody.Enum(lb, cases, rb))))
        }

        // Alias: = OtherType
        if self.check(.Eq()) then {
            let eq = when self.expect(.Eq(), "'='") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            let target = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.Type(vis, mods, kw, gp, name,
                box(CstTypeBody.Alias(eq, box(target)))))
        }

        // Empty (foreign type)
        return .Ok(.Type(vis, mods, kw, gp, name, box(CstTypeBody.Empty())))
    }

    private parse_enum_variant_expr(*mut self) Result[CstExpr] = {
        let name = when self.expect_ident("enum variant name") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }

        let mut lp = Option[Token].None()
        let mut fields = List[CstEnumField].new()
        let mut rp = Option[Token].None()

        if self.check(.LParen()) then {
            lp = .Some(self.eat())
            while not self.check(.RParen()) and not self.is_eof() then {
                let field_name = when self.expect_ident("enum field name") in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                let mut colon = Option[Token].None()
                if self.check(.Colon()) then {
                    colon = .Some(self.eat())
                }
                let field_type = when self.parse_type_node() in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                let comma = self.eat_comma()
                fields.push(CstEnumField(field_name, colon, box(field_type), comma))
            }
            rp = .Some(when self.expect(.RParen(), "')'") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            })
        }

        return .Ok(.EnumVariant(name, lp, fields, rp))
    }

    // ========================================================================
    // Trait declaration
    // ========================================================================

    private parse_trait_decl(*mut self) Result[CstDecl] = {
        let vis = self.eat_vis()
        let kw = when self.expect(.KwTrait(), "'trait'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let name = when self.expect_ident("trait name") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let gp = when self.parse_generic_params() in {
            .Ok(g) then g,
            .Error(e) then { return .Error(e) },
        }

        // Super traits (before {)
        let mut supers = List[* CstType].new()
        if not self.check(.LBrace()) and not self.is_eof() and self.peek_raw() is not .Newline() and self.peek_raw() is not .EOF() then {
            let first = when self.parse_type_node() in {
                .Ok(parsed_type) then parsed_type,
                .Error(e) then { return .Error(e) },
            }
            supers.push(box(first))
            while self.check(.KwAnd()) then {
                self.eat()
                let next = when self.parse_type_node() in {
                    .Ok(parsed_type) then parsed_type,
                    .Error(e) then { return .Error(e) },
                }
                supers.push(box(next))
            }
        }

        let lb = when self.expect(.LBrace(), "'{'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let members = when self.parse_trait_members() in {
            .Ok(ms) then ms,
            .Error(e) then { return .Error(e) },
        }
        let rb = when self.expect(.RBrace(), "'}'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        return .Ok(.Trait(vis, kw, gp, name, supers, lb, members, rb))
    }

    // ========================================================================
    // Trait members
    // ========================================================================

    private parse_trait_members(*mut self) Result[List[*CstItem]] = {
        let mut members = List[*CstItem].new()
        while not self.check(.RBrace()) and not self.is_eof() then {
            let nl_count = self.count_newlines()
            if nl_count >= 2 then {
                self.skip_newlines()
                members.push(box(CstItem.BlankLine()))
                continue
            }
            self.skip_newlines()
            if self.check(.RBrace()) or self.is_eof() then { break }
            if self.check(.Semi()) then {
                self.eat()
                continue
            }
            if self.peek() is .LineComment(_) or self.peek() is .BlockComment(_) then {
                let c = self.eat()
                let prev_is_code = self.last_item_is_code(members)
                if nl_count == 0 and prev_is_code then {
                    members.push(box(CstItem.TrailingComment(c)))
                } else {
                    members.push(box(CstItem.Comment(c)))
                }
                continue
            }
            when self.parse_trait_method_sig() in {
                .Ok(d) then { members.push(box(CstItem.Decl(box(d)))) },
                .Error(e) then { return .Error(e) },
            }
        }
        return .Ok(members)
    }

    private parse_trait_method_sig(*mut self) Result[CstDecl] = {
        let vis = self.eat_vis()
        let name = when self.expect_ident("method name") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let gp = when self.parse_generic_params() in {
            .Ok(g) then g,
            .Error(e) then { return .Error(e) },
        }
        let lp = when self.expect(.LParen(), "'('") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let mut params = List[CstTraitMethodParam].new()
        let mut first UInt = 1
        while not self.check(.RParen()) and not self.is_eof() then {
            // self / *self / *self mut
            if first == 1 and self.check(.Star()) then {
                let ref_kw = self.eat()
                let mut mut_kw = Option[Token].None()
                if self.check(.KwMut()) then {
                    mut_kw = .Some(self.eat())
                }
                let kw = when self.expect(.KwSelf(), "'self'") in {
                    .Ok(t) then t,
                    .Error(e) then { return .Error(e) },
                }
                let comma = self.eat_comma()
                params.push(.SelfParam(kw, mut_kw, .Some(ref_kw), comma))
                first = 0
                continue
            }
            if self.peek() is .KwSelf() then {
                let kw = self.eat()
                let comma = self.eat_comma()
                params.push(.SelfParam(kw, .None(), .None(), comma))
                first = 0
                continue
            }
            // name Type
            let pname = when self.expect_ident("parameter name") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            let mut colon = Option[Token].None()
            if self.check(.Colon()) then {
                colon = .Some(self.eat())
            }
            let pt = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            let comma = self.eat_comma()
            params.push(.NamedParam(pname, colon, box(pt), comma))
            first = 0
        }
        let rp = when self.expect(.RParen(), "')'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        // Return type (optional)
        let mut ret = Option[* CstType].None()
        if not self.check(.RBrace()) and not self.is_eof() then {
            if self.peek_raw() is not .Newline() then {
                let t = when self.parse_type_node() in {
                    .Ok(parsed_type) then parsed_type,
                    .Error(e) then { return .Error(e) },
                }
                ret = .Some(box(t))
            }
        }
        return .Ok(.TraitMethod(vis, gp, name, lp, params, rp, ret))
    }

    // ========================================================================
    // Given declaration
    // ========================================================================

    private parse_given_decl(*mut self) Result[CstDecl] = {
        let vis = self.eat_vis()
        let mods = self.eat_modifiers()
        let kw = when self.expect(.KwGiven(), "'given'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let gp = when self.parse_generic_params() in {
            .Ok(g) then g,
            .Error(e) then { return .Error(e) },
        }

        // Target type (may be complex like [T, R]EnumerateStream)
        let target = when self.parse_type_node() in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }

        let mut as_kw = Option[Token].None()
        let mut trait_type = Option[* CstType].None()
        if self.check(.KwNot()) then {
            let not_kw = self.eat()
            let trait_name = when self.expect_ident("trait name") in {
                .Ok(t) then t,
                .Error(e) then { return .Error(e) },
            }
            return .Ok(.GivenNot(vis, mods, kw, gp, box(target), not_kw, trait_name))
        }
        if self.check(.KwAs()) then {
            as_kw = when self.expect(.KwAs(), "'as'") in {
                .Ok(t) then .Some(t),
                .Error(e) then { return .Error(e) },
            }
            trait_type = when self.parse_type_node() in {
                .Ok(t) then .Some(box(t)),
                .Error(e) then { return .Error(e) },
            }
        }

        let lb = when self.expect(.LBrace(), "'{'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        let members = when self.parse_member_items() in {
            .Ok(ms) then ms,
            .Error(e) then { return .Error(e) },
        }
        let rb = when self.expect(.RBrace(), "'}'") in {
            .Ok(t) then t,
            .Error(e) then { return .Error(e) },
        }
        return .Ok(.Given(vis, mods, kw, gp, box(target), as_kw, trait_type, lb, members, rb))
    }

    // ========================================================================
    // Member items (shared by trait/given)
    // ========================================================================

    private parse_member_items(*mut self) Result[List[*CstItem]] = {
        let mut members = List[*CstItem].new()
        while not self.check(.RBrace()) and not self.is_eof() then {
            let nl_count = self.count_newlines()
            if nl_count >= 2 then {
                self.skip_newlines()
                members.push(box(CstItem.BlankLine()))
                continue
            }
            self.skip_newlines()
            if self.check(.RBrace()) or self.is_eof() then { break }
            if self.check(.Semi()) then {
                self.eat()
                continue
            }
            if self.peek() is .LineComment(_) or self.peek() is .BlockComment(_) then {
                let c = self.eat()
                let prev_is_code = self.last_item_is_code(members)
                if nl_count == 0 and prev_is_code then {
                    members.push(box(CstItem.TrailingComment(c)))
                } else {
                    members.push(box(CstItem.Comment(c)))
                }
                continue
            }
            // Determine if this is a let-decl or a method without let
            let mut offset UInt = self.access_modifier_token_count()
            let after_access = self.peek_at_skip_nl(offset)
            if after_access is .KwForeign() or after_access is .KwIntrinsic() then { offset += 1 }
            let kw = self.peek_at_skip_nl(offset)
            when kw in {
                .KwLet() then {
                    when self.parse_let_decl() in {
                        .Ok(d) then { members.push(box(CstItem.Decl(box(d)))) },
                        .Error(e) then { return .Error(e) },
                    }
                },
                _ then {
                    // Method without let keyword
                    when self.parse_member_no_let() in {
                        .Ok(d) then { members.push(box(CstItem.Decl(box(d)))) },
                        .Error(e) then { return .Error(e) },
                    }
                },
            }
        }
        return .Ok(members)
    }

    private parse_member_no_let(*mut self) Result[CstDecl] = {
        let vis = self.eat_vis()
        let mods = self.eat_modifiers()
        // Generic params and name are handled by finish_func_or_var
        return self.finish_func_or_var(vis, mods, .None(), .None(), true)
    }
}
