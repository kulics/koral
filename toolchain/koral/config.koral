// ============================================================================
// Koral Build System - Project Configuration
// ============================================================================

using "./utils.koral";
using "std/json";
using "std/os";

/// A module as the manifest declares it. `key` is the package-internal name --
/// `"."` for the main module, otherwise the subpath. A consumer spells the FULL
/// name, `package[/subpath]`; the manifest only describes the inside (§5.2).
public type ModuleConfig(
    entry String,
    links List[String],
);

/// Four fields (§5.1): `package`, `version`, `modules`, `dependencies`.
/// No `name` (same thing as `package`), no top-level `entry` (the default build
/// target IS the main module), no `requires` (the module graph comes from
/// `using`, §5.4), no `module_aliases` (renaming is the dependency key, §5.3).
public type ProjectConfig(
    package String,
    version String,
    modules Dict[String, ModuleConfig],
    dependencies Dict[String, DepConfig],
);

/// `source` is the fetch location and the package's identity (§5.3). The key
/// under which it sits in `dependencies` is the name the SOURCE writes for it,
/// which is why renaming a dependency is just changing that key.
public type DepConfig(
    key String,
    source String,
    version String,
);

file_private let is_valid_module_segment(segment String) Bool = {
    if segment.count() == 0 then {
        return false;
    };

    let first = segment.get(0) or else { return false;};
    if first < 'a' or first > 'z' then {
        return false;
    };

    for i in 1..<segment.count() then {
        let ch = segment[i];
        let is_lower = ch >= 'a' and ch <= 'z';
        let is_digit = ch >= '0' and ch <= '9';
        let is_underscore = ch == '_';
        if not is_lower and not is_digit and not is_underscore then {
            return false;
        };
    };

    return true;
};

/// A manifest module key is `"."` or a `/`-separated subpath of identifier
/// segments (§5.2). It never carries the package name -- that would be
/// describing the package from the outside, which is the consumer's job.
file_private let is_valid_module_key(key String) Bool = {
    if key == "." then {
        return true;
    };
    if key.count() == 0 or key.contains(".") then {
        return false;
    };
    for segment in key.split("/") then {
        if not is_valid_module_segment(segment) then {
            return false;
        };
    };
    return true;
};

/// A package name is a single identifier segment (§2.1) -- no `/`, no `.`.
file_private let is_valid_package_name(name String) Bool =
    name.count() > 0 and is_valid_module_segment(name);

/// A module full name as source writes it: `package[/subpath]`.
file_private let is_valid_module_full_name(name String) Bool = {
    if name.count() == 0 then {
        return false;
    };
    let parts = name.split("/");
    let mutable head = "";
    let mutable seen = false;
    for segment in parts then {
        if not seen then {
            head = segment;
            seen = true;
        } else if not is_valid_module_segment(segment) then {
            return false;
        };
    };
    return seen and is_valid_package_name(head);
};

file_private let json_string_array(values List[String]) JsonValue = {
    let mutable arr = List[JsonValue].new();
    for value in values then {
        arr.push(JsonValue.String(value));
    };
    return JsonValue.Array(arr);
};

file_private let load_string_array_field(
    value JsonValue,
    field_name String,
    context String,
) Result[List[String]] = {
    let arr = value.as_array() or else {
        return .Error("error: '\(field_name)' in \(context) must be an array");
    };

    let mutable out = List[String].new();
    for i in 0..<arr.count() then {
        let item = arr[i].as_string() or else {
            return .Error("error: '\(field_name)[\(i)]' in \(context) must be a string");
        };
        out.push(item);
    };
    return .Ok(out);
};

file_private let load_string_dict_field(
    value JsonValue,
    field_name String,
    context String,
) Result[Dict[String, String]] = {
    let obj = value.as_object() or else {
        return .Error("error: '\(field_name)' in \(context) must be an object");
    };

    let mutable out = Dict[String, String].new();
    let mutable iter = obj.iterator();
    while iter.next() is .Some(entry) then {
        let str_value = entry.second.as_string() or else {
            return .Error("error: '\(field_name).\(entry.first)' in \(context) must be a string");
        };
        out.insert(entry.first, str_value);
    };
    return .Ok(out);
};

file_private let load_optional_string_array_field(
    json JsonValue,
    field_name String,
    context String,
) Result[List[String]] = when json.get_field(field_name) in {
    .Some(value_ref) then load_string_array_field(value_ref, field_name, context),
    .None() then .Ok(List[String].new()),
};

file_private let load_optional_string_dict_field(
    json JsonValue,
    field_name String,
    context String,
) Result[Dict[String, String]] = when json.get_field(field_name) in {
    .Some(value_ref) then load_string_dict_field(value_ref, field_name, context),
    .None() then .Ok(Dict[String, String].new()),
};

/// The default build target is the main module -- the one declared under the
/// `modules` key `"."` (§5.1). Its full name is the package name. A package
/// with no main module has no default; the caller has to say which module.
public let default_target_module(config ProjectConfig) Result[String] = {
    if config.modules.contains_key(".") then {
        return .Ok(config.package);
    };
    return .Error("error: package has no main module ('modules' key \".\"); pass --module <package/subpath>");
};

/// The `modules` key a full name (`package[/subpath]`) refers to.
public let module_key_for_full_name(config ProjectConfig, full_name String) Result[String] = {
    let mutable head = full_name;
    let mutable subpath = "";
    if full_name.contains("/") then {
        let mutable idx UInt = 0;
        while idx < full_name.count() then {
            if full_name[idx] == '/' then {
                head = full_name.substring(.Until(idx));
                subpath = full_name.substring(.From(idx + 1));
                break;
            };
            idx += 1;
        };
    };

    if head <> config.package then {
        return .Error("error: module '\(full_name)' is not in package '\(config.package)'");
    };

    let key = if subpath.is_empty() then "." else subpath;
    if config.modules.contains_key(key) then {
        return .Ok(key);
    };
    return .Error("error: module '\(full_name)' not found in koral.json");
};

public let target_module_for_build(config ProjectConfig, flags Dict[String, String]) Result[String] = {
    let module_name = flags.get("--module") or else {
        return default_target_module(config);
    };

    let _ = module_key_for_full_name(config, module_name) or return;
    return .Ok(module_name);
};

/// Artifact names come from the full name, which separates subpaths with `/`.
public let artifact_stem(module_name String) String =
    module_name.replace_all("/", with: "__").replace_all("::", with: "__");

file_private let reject_obsolete_field(json JsonValue, field String, hint String) Result[Void] = {
    if json.get_field(field) is .Some(_) then {
        return .Error("error: koral.json field '\(field)' is no longer supported -- \(hint)");
    };
    return .Ok({});
};

public let load_config(project_dir String) Result[ProjectConfig] = {
    let config_path = project_dir + "/koral.json";

    if not path_exist(config_path.into_path()) then {
        return .Error("error: koral.json not found in current directory");
    };

    let text = read_text_file(config_path.into_path()) or return;
    let json = JsonValue.parse(text) or return;
    if json.as_object() is .None() then {
        return .Error("error: koral.json must be a JSON object");
    };

    reject_obsolete_field(json, "name", "renamed to 'package'") or return;
    reject_obsolete_field(json, "entry", "the default build target is the main module (modules key \".\")") or return;
    reject_obsolete_field(json, "requires", "the module graph comes from 'using'") or return;
    reject_obsolete_field(json, "module_aliases", "renaming a dependency is its 'dependencies' key") or return;
    reject_obsolete_field(json, "links", "links belong on the module that needs them") or return;

    let package_ref = json.get_field("package") or else {
        return .Error("error: missing required field 'package' in koral.json");
    };
    let package = package_ref.as_string() or else {
        return .Error("error: 'package' must be a string in koral.json");
    };
    if not is_valid_package_name(package) then {
        return .Error("error: invalid package name '\(package)'. Must be a single lowercase identifier");
    };
    if package == "std" then {
        return .Error("error: package name 'std' is reserved");
    };

    let version_ref = json.get_field("version") or else {
        return .Error("error: missing required field 'version' in koral.json");
    };
    let version = version_ref.as_string() or else {
        return .Error("error: 'version' must be a string in koral.json");
    };

    let modules_ref = json.get_field("modules") or else {
        return .Error("error: missing required field 'modules' in koral.json");
    };
    let modules_obj = modules_ref.as_object() or else {
        return .Error("error: 'modules' must be an object in koral.json");
    };

    let mutable modules = Dict[String, ModuleConfig].new();
    let mutable module_iter = modules_obj.iterator();
    while module_iter.next() is .Some(module_entry) then {
        let module_name = module_entry.first;
        if not is_valid_module_key(module_name) then {
            return .Error("error: invalid module key '\(module_name)'; use '.' or lower_snake segments joined by '/'");
        };

        if module_entry.second.as_object() is .None() then {
            return .Error("error: module '\(module_name)' must be an object");
        };
        let module_json = module_entry.second;
        reject_obsolete_field(module_json, "requires", "the module graph comes from 'using'") or return;

        let entry_ref = module_json.get_field("entry") or else {
            return .Error("error: module '\(module_name)' is missing required field 'entry'");
        };
        let module_entry_path = entry_ref.as_string() or else {
            return .Error("error: module '\(module_name)' field 'entry' must be a string");
        };
        if not module_entry_path.ends_with(".koral") then {
            return .Error("error: module '\(module_name)' entry must end with .koral");
        };

        let links = load_optional_string_array_field(module_json, "links", "module '\(module_name)'") or return;
        modules.insert(module_name, ModuleConfig(module_entry_path, links));
    };

    if modules.is_empty() then {
        return .Error("error: a package declares at least one module");
    };

    let mutable dependencies = Dict[String, DepConfig].new();
    if json.get_field("dependencies") is .Some(deps_ref) then {
        let deps_obj = deps_ref.as_object() or else {
            return .Error("error: 'dependencies' must be an object in koral.json");
        };
        let mutable iter = deps_obj.iterator();
        while iter.next() is .Some(dep_entry) then {
            let dep_key = dep_entry.first;
            let dep_json = dep_entry.second;

            if not is_valid_package_name(dep_key) then {
                return .Error("error: invalid dependency key '\(dep_key)'; it is the name the source writes, a single lowercase identifier");
            };
            if dep_key == package then {
                return .Error("error: dependency key '\(dep_key)' collides with this package's own name");
            };
            if dep_key == "std" then {
                return .Error("error: dependency key 'std' is reserved");
            };

            reject_obsolete_field(dep_json, "name", "the key is the name the source writes") or return;
            reject_obsolete_field(dep_json, "git", "the fetch location is 'source'") or return;
            reject_obsolete_field(dep_json, "module_aliases", "renaming a dependency is its key") or return;

            let source_ref = dep_json.get_field("source") or else {
                return .Error("error: dependency '\(dep_key)' missing 'source' field");
            };
            let source = source_ref.as_string() or else {
                return .Error("error: dependency '\(dep_key)' 'source' must be a string");
            };

            let dep_version_ref = dep_json.get_field("version") or else {
                return .Error("error: dependency '\(dep_key)' missing 'version' field");
            };
            let dep_version = dep_version_ref.as_string() or else {
                return .Error("error: dependency '\(dep_key)' 'version' must be a string");
            };

            dependencies.insert(dep_key, DepConfig(dep_key, source, dep_version));
        };
    };

    return .Ok(ProjectConfig(package, version, modules, dependencies));
};

public let save_config(project_dir String, config ProjectConfig) Result[Void] = {
    let mutable obj = Dict[String, JsonValue].new();
    obj.insert("package", JsonValue.String(config.package));
    obj.insert("version", JsonValue.String(config.version));

    if not config.dependencies.is_empty() then {
        let mutable deps_obj = Dict[String, JsonValue].new();
        let mutable dep_iter = config.dependencies.iterator();
        while dep_iter.next() is .Some(dep_entry) then {
            let dep = dep_entry.second;
            let mutable dep_json = Dict[String, JsonValue].new();
            dep_json.insert("source", JsonValue.String(dep.source));
            dep_json.insert("version", JsonValue.String(dep.version));
            deps_obj.insert(dep_entry.first, JsonValue.Object(dep_json));
        };
        obj.insert("dependencies", JsonValue.Object(deps_obj));
    };

    let mutable modules_obj = Dict[String, JsonValue].new();
    let mutable module_iter = config.modules.iterator();
    while module_iter.next() is .Some(module_entry) then {
        let module = module_entry.second;
        let mutable module_json = Dict[String, JsonValue].new();
        module_json.insert("entry", JsonValue.String(module.entry));
        module_json.insert("links", json_string_array(module.links));
        modules_obj.insert(module_entry.first, JsonValue.Object(module_json));
    };
    obj.insert("modules", JsonValue.Object(modules_obj));

    let json = JsonValue.Object(obj);
    let text = json.to_string_pretty() + "\n";
    let config_path = project_dir + "/koral.json";
    write_text_file(config_path.into_path(), content: text) or return;
    return .Ok({});
};
