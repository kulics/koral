// ============================================================================
// Koral Build System - Project Lint Test Suite
// ============================================================================
//
// The lint's job is one sentence: a `.koral` file the package did not mean to
// leave out must not sit there unnoticed (§7). These cases pin the three
// decisions that sentence rests on -- what "claimed" means, that a forgotten
// DIRECTORY is caught and not just a stray file, and that `exclude` is the
// escape hatch for fixtures rather than a silent narrowing of the scan.
// ============================================================================

using "koral/lint" { find_orphan_sources, lint_orphans, render_layout_problem };
using "std/os" { ... };

type mutable TestRunner(mutable pass_count UInt, mutable fail_count UInt);

given TestRunner {
    new() TestRunner = TestRunner(0, 0);

    check(self, name String, got List[String], expected List[String]) Void = {
        let got_text = got.join_to_string(", ");
        let expected_text = expected.join_to_string(", ");
        if got_text == expected_text then {
            self.pass_count += 1;
        } else {
            self.fail_count += 1;
            println("FAIL: " + name);
            println("  expected: [" + expected_text + "]");
            println("  got:      [" + got_text + "]");
        };
    };

    check_clean(self, name String, root String, entries List[String], exclude List[String]) Void = {
        when find_orphan_sources(root, entries, exclude) in {
            .Ok(orphans) then {
                self.check(name, orphans, List[String].new());
            },
            .Error(e) then {
                self.fail_count += 1;
                println("FAIL: " + name + " - " + e.message());
            },
        };
    };

    check_orphans(
        self,
        name String,
        root String,
        entries List[String],
        exclude List[String],
        expected List[String],
    ) Void = {
        when find_orphan_sources(root, entries, exclude) in {
            .Ok(orphans) then {
                self.check(name, orphans, expected);
            },
            .Error(e) then {
                self.fail_count += 1;
                println("FAIL: " + name + " - " + e.message());
            },
        };
    };
};

/// A scratch package: a directory of files written exactly as given.
let make_case(root String, files List[Pair[String, String]]) Void = {
    // Setup, not the subject under test: a failure here is a broken harness,
    // so it stops the run rather than becoming a false verdict. The first run
    // has nothing to remove.
    if path_exist(root) then {
        remove_dir_all(root) or else as e in {
            println("setup failed: " + e.message());
            exit(1);
        };
    };
    create_dir_all(root) or else as e in {
        println("setup failed: " + e.message());
        exit(1);
    };
    for entry in files then {
        let path = root.into_path().join(entry.first).to_string();
        create_dir_all(path.into_path().dir_name()) or else as e in {
            println("setup failed: " + e.message());
            exit(1);
        };
        write_text_file(path, content: entry.second) or else as e in {
            println("setup failed: " + e.message());
            exit(1);
        };
    };
};

let main() Void = {
    let runner = TestRunner.new();
    let scratch = temp_dir().join("koral_project_lint_test").to_string();

    // 1. Nothing loose: an entry and the helper it merges.
    make_case(
        scratch,
        [
            Pair("main.koral", "using \"./helper.koral\";\npublic let main() Int = 0;\n"),
            Pair("helper.koral", "public let helper() Int = 1;\n"),
        ],
    );
    runner.check_clean("merge claims the helper", scratch, ["main.koral"], List[String].new());

    // 2. A file dropped beside the module's other files.
    make_case(
        scratch,
        [
            Pair("main.koral", "public let main() Int = 0;\n"),
            Pair("stray.koral", "public let stray() Int = 1;\n"),
        ],
    );
    runner.check_orphans(
        "stray file beside the module is reported",
        scratch,
        ["main.koral"],
        List[String].new(),
        ["stray.koral"],
    );

    // 3. A whole directory nobody mentions. This is the case the old
    //    "sits beside a claimed file" narrowing could not see, and it is the
    //    common one: a new module whose `using` was never written.
    make_case(
        scratch,
        [
            Pair("main.koral", "public let main() Int = 0;\n"),
            Pair("helpers/util.koral", "public let util() Int = 1;\n"),
            Pair("helpers/more.koral", "public let more() Int = 2;\n"),
        ],
    );
    runner.check_orphans(
        "forgotten directory is reported",
        scratch,
        ["main.koral"],
        List[String].new(),
        ["helpers/more.koral", "helpers/util.koral"],
    );

    // 4. `exclude` is the fixture escape hatch -- and it is EXPLICIT, so a
    //    directory of formatter inputs is not the same shape as a forgotten
    //    module.
    make_case(
        scratch,
        [
            Pair("main.koral", "public let main() Int = 0;\n"),
            Pair("test/cases/a.koral", "public let a() Int = 1;\n"),
        ],
    );
    runner.check_clean(
        "exclude covers the fixture directory",
        scratch,
        ["main.koral"],
        ["test/cases"],
    );
    runner.check_orphans(
        "without exclude the fixture directory is reported",
        scratch,
        ["main.koral"],
        List[String].new(),
        ["test/cases/a.koral"],
    );

    // 5. A local IMPORT also claims its target: `using "./util.koral" { a };`
    //    makes `util.koral` a module of its own (§3.1).
    make_case(
        scratch,
        [
            Pair("main.koral", "using \"./util.koral\" { util };\npublic let main() Int = util();\n"),
            Pair("util.koral", "public let util() Int = 1;\n"),
        ],
    );
    runner.check_clean("local import claims the target", scratch, ["main.koral"], List[String].new());

    // 6. Claims are transitive through a merge chain.
    make_case(
        scratch,
        [
            Pair("main.koral", "using \"./a.koral\";\npublic let main() Int = 0;\n"),
            Pair("a.koral", "using \"./b.koral\";\npublic let a() Int = 1;\n"),
            Pair("b.koral", "public let b() Int = 2;\n"),
        ],
    );
    runner.check_clean("merge closure is transitive", scratch, ["main.koral"], List[String].new());

    // 7. A declared entry is a module even when nothing reaches it this build.
    make_case(
        scratch,
        [
            Pair("main.koral", "public let main() Int = 0;\n"),
            Pair("other.koral", "public let other() Int = 1;\n"),
        ],
    );
    runner.check_clean(
        "a declared entry is never an orphan",
        scratch,
        ["main.koral", "other.koral"],
        List[String].new(),
    );

    // 8. The verdict a human reads, not just the paths.
    make_case(
        scratch,
        [
            Pair("main.koral", "public let main() Int = 0;\n"),
            Pair("stray.koral", "public let stray() Int = 1;\n"),
        ],
    );
    when lint_orphans(scratch, ["main.koral"], List[String].new()) in {
        .Some(problem) then {
            let rendered = render_layout_problem(problem);
            if rendered.contains("belong to no module") and rendered.contains("stray.koral") then {
                runner.pass_count += 1;
            } else {
                runner.fail_count += 1;
                println("FAIL: the rendered verdict names the problem");
                println("  got: " + rendered);
            };
        },
        .None() then {
            runner.fail_count += 1;
            println("FAIL: the rendered verdict names the problem - no problem reported");
        },
    };

    if path_exist(scratch) then {
        remove_dir_all(scratch) or else as e in {
            println("cleanup failed: " + e.message());
            exit(1);
        };
    };

    let total = runner.pass_count + runner.fail_count;
    println("\(runner.pass_count)/\(total) tests passed");
    if runner.fail_count > 0 then {
        exit(1);
    };
};
