// ============================================================================
// Koral Build System - CLI Entry Point
// ============================================================================
// Usage: koral <command> [args...] [flags...]
// ============================================================================

using "./config.koral";
using "./cmd_init.koral";
using "./cmd_build.koral";
using "./cmd_check.koral";
using "./cmd_run.koral";
using "./cmd_get.koral";
using "./cmd_format.koral";
using "./cmd_clean.koral";
using "./commands.koral";

using "std/os";
using "std/json";

public let main() Int = {
    let argv = args();

    if argv.count() < 2 then {
        print_help();
        return 0;
    };

    let cli_args = parse_cli_args(argv) or else {
        error_msg(it.message());
        return 1;
    };

    return dispatch(cli_args);
};
