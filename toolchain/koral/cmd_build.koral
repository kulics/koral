// ============================================================================
// Koral Build System - build Command
// ============================================================================

using "std/os" { ... };
using "std/proc" { ... };

/// Find koralc executable by searching PATH and KORAL_HOME
///
/// The primary implementation wins: `compiler/` is what you develop, so `koral
/// build` reaches for `bin/compiler/koralc` before anything else. The frozen
/// Swift compiler under `compiler-reference/` is the seed and the oracle, and is
/// the last resort -- you only fall back to it when no self-hosted `koralc`
/// exists yet (a fresh clone, before the first `bin/compiler/koralc` build).
///
/// `find_executable` searches these dirs before PATH, so this order IS the
/// effective priority.
public let find_koralc(): Option[String] = {
    let mutable preferred_dirs = List[String].new();
    if env("KORAL_HOME") is .Some(home) then {
        let h = home.into_path();
        preferred_dirs.push(h.join("bin/compiler").to_string());
        preferred_dirs.push(h.join("bin/compiler-clone").to_string());
        preferred_dirs.push(h.join("bin/compiler-new").to_string());
        preferred_dirs.push(h.join("bin").to_string());
        preferred_dirs.push(home);
        preferred_dirs.push(
            h.join("compiler-reference/.build/x86_64-unknown-windows-msvc/release").to_string(
            ),
        );
        preferred_dirs.push(h.join("compiler-reference/.build/release").to_string());
        preferred_dirs.push(
            h.join("compiler-reference/.build/x86_64-unknown-windows-msvc/debug").to_string(
            ),
        );
        preferred_dirs.push(h.join("compiler-reference/.build/debug").to_string());
    };
    return find_executable("koralc", preferred_dirs);
};

/// The compiler flags a build mode maps to. Mirrors koralc's own mapping so
/// `koral build --release` and `koralc build --release` agree.
public let build_mode_args(flags: Dict[String, String]): List[String] = {
    if flags.get("--release") is .Some(_) then {
        return ["--release"];
    };
    if flags.get("--debug") is .Some(_) then {
        return ["--debug"];
    };
    return List[String].new();
};

/// Build the project
/// koral build [--release]
public let cmd_build(args: List[String], flags: Dict[String, String]): Int = {
    let config = load_config(".") or else as e in {
        error_msg(e.message());
        return 1;
    };
    let target_module = target_module_for_build(config, flags) or else as e in {
        error_msg(e.message());
        return 1;
    };

    // Project layout first: a `.koral` file no module claims is compiled
    // nowhere and checked by nothing, and this is the only place that can see
    // it (§7). `koral lint` runs the same check on its own.
    if fail_on_layout_problem(".", config) then {
        return 1;
    };

    let koralc = find_koralc() or else {
        error_msg("koralc not found. Ensure koralc is in your PATH or set KORAL_HOME");
        return 1;
    };

    let stem = artifact_stem(target_module);
    status_msg("Compiling", "\(config.package) v\(config.version) [\(target_module)]");

    create_dir_all(".build".into_path()) or else as e in {
        error_msg("failed to create .build directory: \(e.message())");
        return 1;
    };

    let mutable cmd = Command.new(koralc);
    cmd.arg("build");
    cmd.arg("--package-config");
    cmd.arg("koral.json");
    cmd.arg("--target-module");
    cmd.arg(target_module);
    cmd.arg("--requires-root");
    cmd.arg(".requires");
    // Forward the build mode so `koral build --release` is not a no-op. The
    // compiler selects the clang level from these; without them it uses -O1.
    for mode_flag in build_mode_args(flags) then {
        cmd.arg(mode_flag);
    };
    cmd.args(compiler_std_args());
    cmd.arg("-o");
    cmd.arg(".build/");
    cmd.set_stdout(IoRedirect.Inherit());
    cmd.set_stderr(IoRedirect.Inherit());
    let status = cmd.run() or else as e in {
        error_msg("failed to run koralc: \(e.message())");
        return 1;
    };

    if not status.is_success() then {
        return status.code() or else 1;
    };

    let exe_ext = executable_suffix();
    status_msg("Finished", ".build/\(stem)\(exe_ext)");
    return 0;
};
