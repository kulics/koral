// ============================================================================
// Koral Build System - format Command
// ============================================================================

using "std/os" { ... };
using "std/proc" { ... };

/// Find koralfmt executable by searching PATH and KORAL_HOME
let find_koralfmt() Option[String] = {
    let mutable preferred_dirs = List[String].new();
    if env("KORAL_HOME") is .Some(home) then {
        let h = home.into_path();
        preferred_dirs.push(h.join("bin/toolchain-koralfmt").to_string());
        preferred_dirs.push(h.join("bin/koralfmt").to_string());
        preferred_dirs.push(h.join("bin").to_string());
        preferred_dirs.push(home);
    };
    return find_executable("koralfmt", preferred_dirs);
};

/// Collect all .koral files in the project directory
let collect_koral_files(dir String) List[String] = {
    let mutable files = List[String].new();
    let mutable walker = walk_dir(dir.into_path()) or else {
        return files;
    };

    while walker.next() is .Some(entry) then {
        let name = entry.name();
        if name == ".build" or name == ".requires" or name == ".git" then {
            continue;
        };
        if entry.file_type().is_file() and name.ends_with(".koral") then {
            files.push(entry.path().to_string());
        };
    };
    return files;
};

/// Format source files
/// koral format [files...]
public let cmd_format(args List[String], flags Dict[String, String]) Int = {
    let koralfmt = find_koralfmt() or else {
        error_msg(
            "koralfmt not found. Ensure koralfmt is in your PATH or set KORAL_HOME",
        );
        return 1;
    };

    let files = if args.count() > 0 then {
        args
    } else {
        collect_koral_files(".")
    };

    if files.count() == 0 then {
        info_msg("Format", "no .koral files found");
        return 0;
    };

    let mutable had_error = false;
    let mutable formatted UInt = 0;

    for file in files then {
        let mutable cmd = Command.new(koralfmt);
        cmd.arg(file);
        cmd.set_stdout(IoRedirect.Inherit());
        cmd.set_stderr(IoRedirect.Inherit());
        let status = cmd.run() or else as e in {
            eprintln("error: failed to run koralfmt on \(file): \(e.message())");
            had_error = true;
            continue;
        };
        if status.is_success() then {
            formatted += 1;
        } else {
            had_error = true;
        };
    };

    status_msg("Formatted", "\(formatted) file(s)");
    return if had_error then 1 else 0;
};
