// ============================================================================
// Koral Build System - check Command
// ============================================================================

using std::os { .. };
using std::proc { .. };

/// Type-check the project without generating an executable
/// koral check
public let cmd_check(args List[String], flags Dict[String, String]) Int = {
    let config = load_config(".") or else {
        error_msg(it.message());
        return 1;
    };
    let target_module = target_module_for_build(config, flags) or else {
        error_msg(it.message());
        return 1;
    };

    let koralc = find_koralc() or else {
        error_msg("koralc not found. Ensure koralc is in your PATH or set KORAL_HOME");
        return 1;
    };

    status_msg("Checking", "\(config.name) v\(config.version) [\(target_module)]");

    let mutable cmd = Command.new(koralc);
    cmd.arg("check");
    cmd.arg("--package-config");
    cmd.arg("koral.json");
    cmd.arg("--target-module");
    cmd.arg(target_module);
    cmd.arg("--requires-root");
    cmd.arg(".requires");
    cmd.args(compiler_std_args());
    cmd.set_stdout(IoRedirect.Inherit());
    cmd.set_stderr(IoRedirect.Inherit());
    let status = cmd.run() or else {
        error_msg("failed to run koralc: \(it.message())");
        return 1;
    };

    if not status.is_success() then {
        return status.code() or else 1;
    };

    status_msg("Finished", "no errors found");
    return 0;
};
