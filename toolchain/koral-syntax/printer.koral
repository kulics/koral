// ============================================================================
// Koral Syntax - Structural CST Printer
// ============================================================================
// Every spacing decision is determined by the CST node structure.
// No token-level spacing inference needed.
//
// This is the one place that knows how Koral is spelled. `print_file` lays out
// a whole file (the formatter's job); `print_signature` renders a declaration
// without its body (the API doc generator's job). Both come from the same node
// types, so a signature in generated docs is the same syntax the formatter
// would write.
// ============================================================================

public type mutable Printer(
    mutable output StringBuilder,
    // The line being built. Trailing whitespace is trimmed when it is flushed,
    // but only as far back as `strip_limit` -- whitespace that is part of a
    // token (a comment's trailing spaces, say) is author content and stays.
    mutable line StringBuilder,
    mutable strip_limit UInt,
    // Set after a separating comma. The space that follows is written when the
    // next thing lands, and is skipped when that thing is a closer -- so a
    // trailing comma hugs its closer (`f(a, b,)`) rather than leaving `, )`.
    mutable pending_space Bool,
    // Columns the enclosing statement will still use after this expression --
    // the `;` a declaration or statement adds, for instance. Width checks have
    // to reserve them or a line that "fits" ends up one column over.
    mutable reserve UInt,
    // Measuring mode: nothing is allowed to break, so what comes out is the
    // exact single-line width of the subtree. `flat_length` renders through a
    // printer in this mode instead of guessing at a length.
    mutable force_flat Bool,
    // Extra indent levels for the next line-start write. A `using` import list
    // is carried as a token list, so its continuation lines hang one level in
    // under the `using`.
    mutable hang UInt,
    mutable indent UInt,
    mutable at_line_start Bool,
);

given Printer {

    public new() Printer =
        Printer(StringBuilder.new(), StringBuilder.new(), 0, false, 0, false, 0, 0, true);

    /// Everything printed so far, including the line still being built.
    public result(self) String = {
        self.flush_line();
        return self.output.to_string();
    };

    /// Ends a declaration-only rendering: a signature is a statement, and a
    /// statement ends in `;`.
    public write_terminator(self) Void = {
        self.write(";");
    };

    // ========================================================================
    // Low-level output
    // ========================================================================

    file_private write_indent(self) Void = {
        for _ in 0..<self.indent then {
            self.line.push_string("    ");
        };
    };

    /// Whitespace between the last token and the end of the line is layout, so
    /// it goes. Everything from `strip_limit` back is token content and stays.
    file_private flush_line(self) Void = {
        let runes = self.line.to_string().to_runes();
        let mutable end UInt = runes.count();
        while end > self.strip_limit then {
            let ch = runes[end - 1].to_uint32();
            if ch == 32 or ch == 9 then {
                end -= 1;
            } else {
                break;
            };
        };
        let mutable j UInt = 0;
        while j < end then {
            self.output.push_string(runes[j].to_string());
            j += 1;
        };
        self.line = StringBuilder.new();
        self.strip_limit = 0;
    };

    file_private write_newline(self) Void = {
        self.pending_space = false;
        self.flush_line();
        self.output.push_byte('\n');
        self.at_line_start = true;
    };

    file_private write_space(self) Void = {
        self.pending_space = false;
        self.line.push_byte(' ');
    };

    /// `)` `]` `}` -- what a separating space must not be written before.
    file_private is_closer(s String) Bool = s == ")" or s == "]" or s == "}";

    /// `)` and `]` close comma-separated lists, where the trailing comma is a
    /// punctuation choice the line shape makes. `}` is deliberately excluded: it
    /// closes blocks and bodies too, and after one a comma can be a required
    /// separator -- `when x in { 1 then { a(); }, _ then 0, }` loses the arm
    /// boundary if that comma goes.
    file_private is_list_closer(s String) Bool = s == ")" or s == "]";

    file_private write_separator(self, comma Token) Void = {
        self.write_token(comma);
        self.pending_space = true;
    };

    /// A list kept on one line carries no trailing comma -- `[1, 2]`, not
    /// `[1, 2,]`. A list the formatter exploded always does, so its last line
    /// ends in a comma and the closer sits on the next line: the two shapes are
    /// told apart by whether the comma and the closer share a line.
    file_private drop_trailing_comma(self) Void = {
        let runes = self.line.to_string().to_runes();
        let mutable end UInt = runes.count();
        if end == 0 then {
            return;
        };
        if runes[end - 1].to_uint32() <> 44 then {
            return;
        };
        end -= 1;
        let mutable out = StringBuilder.new();
        let mutable j UInt = 0;
        while j < end then {
            out.push_string(runes[j].to_string());
            j += 1;
        };
        self.line = out;
        if self.strip_limit > self.line.count() then {
            self.strip_limit = self.line.count();
        };
    };

    file_private write(self, s String) Void = {
        if self.pending_space then {
            self.pending_space = false;
            if not Printer.is_closer(s) then {
                self.line.push_byte(' ');
            };
        };
        if Printer.is_list_closer(s) then {
            self.drop_trailing_comma();
        };
        if self.at_line_start then {
            self.write_indent();
            if self.hang > 0 then {
                for _ in 0..<self.hang then {
                    self.line.push_string("    ");
                };
                self.hang = 0;
            };
            self.at_line_start = false;
        };
        self.line.push_string(s);
        self.strip_limit = self.line.count();
    };

    /// A token is written as one unit of content. Block comments and multiline
    /// strings span lines, and their interior is author text: it is written
    /// exactly as it came, so its own column layout is never touched. Only the
    /// first line picks up the surrounding indent.
    file_private write_token(self, t Token) Void = {
        let text = t.to_string();
        if not text.contains("\n") then {
            self.write(text);
            return;
        };
        if self.at_line_start then {
            self.write_indent();
            self.at_line_start = false;
        };
        let runes = text.to_runes();
        let mutable i UInt = 0;
        while i < runes.count() then {
            let r = runes[i];
            if r.to_uint32() == 10 then {
                self.strip_limit = self.line.count();
                self.flush_line();
                self.output.push_byte('\n');
                self.at_line_start = false;
            } else {
                self.line.push_string(r.to_string());
            };
            i += 1;
        };
        self.strip_limit = self.line.count();
    };

    // ========================================================================
    // Type printing
    // ========================================================================

    file_private print_type(self, t CstType) Void = when t in {
        .Named(name) then self.write_token(name),
        .SelfType(kw) then self.write_token(kw),
        .ConstraintKeyword(kw) then self.write_token(kw),
        .Mutable(inner, kw) then {
            when inner in {
                .Ptr(ptr_inner, ptr_kw) then {
                    self.write_token(ptr_kw);
                    self.write_space();
                    self.write_token(kw);
                    self.write_space();
                    self.print_type(ptr_inner);
                },
                .Weakref(weak_inner, weak_kw) then {
                    self.write_token(weak_kw);
                    self.write_space();
                    self.write_token(kw);
                    self.write_space();
                    self.print_type(weak_inner);
                },
                _ then {
                    self.write_token(kw);
                    self.write_space();
                    self.print_type(inner);
                },
            };
        },
        .Generic(lb, args, rb, base) then {
            self.write_token(base);
            self.write_token(lb);
            for i in 0..<args.count() then {
                let arg = args[i];
                self.print_type(arg.inner);
                if arg.comma is .Some(c) then {
                    self.write_separator(c);
                };
            };
            self.write_token(rb);
        },
        .Function(func_kw, lp, args, rp, return_type) then {
            self.write_token(func_kw);
            self.write_token(lp);
            for i in 0..<args.count() then {
                let arg = args[i];
                self.print_type(arg.inner);
                if arg.comma is .Some(c) then {
                    self.write_separator(c);
                };
            };
            self.write_token(rp);
            self.write_space();
            self.print_type(return_type);
        },
        .Ptr(inner, kw) then {
            self.write_token(kw);
            self.write_space();
            self.print_type(inner);
        },
        .Weakref(inner, kw) then {
            self.write_token(kw);
            self.print_type(inner);
        },
    };

    // ========================================================================
    // Generic params printing: [T Any, U Eq]
    // ========================================================================

    file_private print_generic_params(self, gp CstGenericParams) Void = {
        self.write_token(gp.lbracket);
        for i in 0..<gp.params.count() then {
            let p = gp.params[i];
            self.write_token(p.name);
            for j in 0..<p.constraints.count() then {
                self.write_space();
                if j > 0 then {
                    self.write("and");
                    self.write_space();
                };
                self.print_type(p.constraints[j]);
            };
            if p.comma is .Some(c) then {
                self.write_separator(c);
            };
        };
        self.write_token(gp.rbracket);
    };

    // ========================================================================
    // Pattern printing
    // ========================================================================

    file_private print_pattern(self, p CstPattern) Void = when p in {
        .Wildcard(t) then self.write_token(t),
        .Variable(name) then self.write_token(name),
        .MutVariable(mut_kw, name) then {
            self.write_token(mut_kw);
            self.write_space();
            self.write_token(name);
        },
        .PatIntLit(t) then self.write_token(t),
        .NegIntLit(minus, t) then {
            self.write_token(minus);
            self.write_token(t);
        },
        .PatStrLit(t) then self.write_token(t),
        .PatBoolLit(t) then self.write_token(t),
        .EnumCase(dot, name, lp, args, rp) then {
            self.write_token(dot);
            self.write_token(name);
            if lp is .Some(l) then {
                self.write_token(l);
                for i in 0..<args.count() then {
                    let a = args[i];
                    if a.label is .Some(label) then {
                        self.write_token(label);
                        if a.colon is .Some(c) then {
                            self.write_token(c);
                            self.write_space();
                        };
                    };
                    self.print_pattern(a.pattern);
                    if a.comma is .Some(c) then {
                        self.write_separator(c);
                    };
                };
                if rp is .Some(r) then {
                    self.write_token(r);
                };
            };
        },
        .StructPattern(name, lp, args, rp) then {
            self.write_token(name);
            self.write_token(lp);
            for i in 0..<args.count() then {
                let a = args[i];
                if a.label is .Some(label) then {
                    self.write_token(label);
                    if a.colon is .Some(c) then {
                        self.write_token(c);
                        self.write_space();
                    };
                };
                self.print_pattern(a.pattern);
                if a.comma is .Some(c) then {
                    self.write_separator(c);
                };
            };
            self.write_token(rp);
        },
        .Comparison(op, minus, value) then {
            self.write_token(op);
            self.write_space();
            if minus is .Some(m) then {
                self.write_token(m);
            };
            self.write_token(value);
        },
        .AndPattern(left, and_kw, right) then {
            self.print_pattern(left);
            self.write_space();
            self.write_token(and_kw);
            self.write_space();
            self.print_pattern(right);
        },
        .OrPattern(left, or_kw, right) then {
            self.print_pattern(left);
            self.write_space();
            self.write_token(or_kw);
            self.write_space();
            self.print_pattern(right);
        },
        .NotPattern(not_kw, inner) then {
            self.write_token(not_kw);
            self.write_space();
            self.print_pattern(inner);
        },
        .ParenPattern(lp, inner, rp) then {
            self.write_token(lp);
            self.print_pattern(inner);
            self.write_token(rp);
        },
        .PairPattern(lp, left, comma, right, rp) then {
            self.write_token(lp);
            self.print_pattern(left);
            self.write_token(comma);
            self.write_space();
            self.print_pattern(right);
            self.write_token(rp);
        },
        .TypeBinding(mut_kw, name, bound_type) then {
            if mut_kw is .Some(mk) then {
                self.write_token(mk);
                self.write_space();
            };
            self.write_token(name);
            self.write_space();
            self.print_type(bound_type);
        },
    };

    // ========================================================================
    // Expression printing
    // ========================================================================

    public print_expr(self, e CstExpr) Void = when e in {
        .IntLit(t) then self.write_token(t),
        .FloatLit(t) then self.write_token(t),
        .StrLit(t) then self.write_token(t),
        .InterpStr(t) then self.write_token(t),
        .BoolLit(t) then self.write_token(t),
        .Ident(t) then self.write_token(t),
        .SelfExpr(t) then self.write_token(t),
        .UnderscoreExpr(t) then self.write_token(t),
        .Commented(comments, inner) then {
            for comment in comments then {
                self.write_token(comment);
                self.write_newline();
            };
            self.print_expr(inner);
        },
        .BinaryOp(left, op, right) then {
            self.print_expr(left);
            self.write_space();
            self.write_token(op);
            self.write_space();
            self.print_expr(right);
        },
        .UnaryMinus(op, operand) then {
            self.write_token(op);
            self.print_expr(operand);
        },
        .Deref(op, operand) then {
            self.write_token(op);
            self.print_expr(operand);
        },
        .AddressOf(op, raw_kw, mut_kw, operand) then {
            if raw_kw is .Some(rk) then {
                self.write_token(op);
                self.write_token(rk);
                if mut_kw is .Some(mk) then {
                    self.write_space();
                    self.write_token(mk);
                };
                self.write_space();
                self.print_expr(operand);
                return;
            };
            self.write_token(op);
            if mut_kw is .Some(mk) then {
                self.write_token(mk);
                self.write_space();
            };
            self.print_expr(operand);
        },
        .NotExpr(op, operand) then {
            self.write_token(op);
            self.write_space();
            self.print_expr(operand);
        },
        .IsExpr(subject, is_kw, not_kw, pattern) then {
            self.print_expr(subject);
            self.write_space();
            self.write_token(is_kw);
            if not_kw is .Some(nk) then {
                self.write_space();
                self.write_token(nk);
            };
            self.write_space();
            self.print_pattern(pattern);
        },
        .BitwiseNot(op, operand) then {
            self.write_token(op);
            self.print_expr(operand);
        },
        .PrefixKw(kw, operand) then {
            self.write_token(kw);
            self.write_space();
            self.print_expr(operand);
        },
        .TypeCast(lp, cast_type, rp, operand) then {
            self.print_expr(operand);
            self.write_token(lp);
            self.print_type(cast_type);
            self.write_token(rp);
        },
        .Paren(lp, inner, rp) then {
            let mutable core_ref = inner;
            while core_ref is .Paren(_, nested, _) then {
                core_ref = nested;
            };
            self.write_token(lp);
            self.print_expr(core_ref);
            self.write_token(rp);
        },
        .PairExpr(lp, first, comma, second, rp) then {
            self.write_token(lp);
            self.print_expr(first);
            self.write_token(comma);
            self.write_space();
            self.print_expr(second);
            self.write_token(rp);
        },
        .TraitQualification(lp, base, as_kw, trait_type, rp) then {
            self.write_token(lp);
            self.print_expr(base);
            self.write_space();
            self.write_token(as_kw);
            self.write_space();
            self.print_type(trait_type);
            self.write_token(rp);
        },
        .FieldAccess(base, dot, field) then {
            self.print_expr(base);
            self.write_token(dot);
            self.write_token(field);
        },
        .QualifiedCall(base, dot, trait_lp, trait_name, trait_rp, method_name, lp, args, rp) then {
            self.print_expr(base);
            self.write_token(dot);
            self.write_token(trait_lp);
            self.write_token(trait_name);
            self.write_token(trait_rp);
            self.write_token(method_name);
            self.write_token(lp);
            self.print_call_args(args, true);
            self.write_token(rp);
        },
        .Call(callee, lp, args, rp) then {
            self.print_expr(callee);
            self.write_token(lp);
            self.print_call_args(args, true);
            self.write_token(rp);
        },
        .SubscriptExpr(base, lb, args, rb) then {
            self.print_expr(base);
            self.write_token(lb);
            self.print_call_args(args, false);
            self.write_token(rb);
        },
        .GenericInst(base, lb, type_args, rb) then {
            self.print_expr(base);
            self.write_token(lb);
            for i in 0..<type_args.count() then {
                let a = type_args[i];
                self.print_type(a.inner);
                if a.comma is .Some(c) then {
                    self.write_separator(c);
                };
            };
            self.write_token(rb);
        },
        .ImplicitMember(dot, name, lp, args, rp) then {
            self.write_token(dot);
            self.write_token(name);
            if lp is .Some(l) then {
                self.write_token(l);
                self.print_call_args(args, true);
                if rp is .Some(r) then {
                    self.write_token(r);
                };
            };
        },
        .Block(lb, items, tail_expr, rb) then self.print_block(lb, items, tail_expr, rb),
        .If(kw, cond, then_kw, then_body, else_kw, else_body) then self.print_if(
            kw,
            cond,
            then_kw,
            then_body,
            else_kw,
            else_body,
        ),
        .IfPattern(kw, subject, is_kw, pattern, then_kw, then_body, else_kw, else_body) then {
            self.write_token(kw);
            self.write_space();
            self.print_expr(subject);
            self.write_space();
            self.write_token(is_kw);
            self.write_space();
            self.print_pattern(pattern);
            self.write_space();
            self.write_token(then_kw);
            self.write_space();
            self.print_expr(then_body);
            if else_kw is .Some(ek) then {
                self.write_space();
                self.write_token(ek);
                if else_body is .Some(eb) then {
                    self.write_space();
                    self.print_expr(eb);
                };
            };
        },
        .While(kw, cond, then_kw, body) then {
            self.write_token(kw);
            self.write_space();
            self.print_expr(cond);
            self.write_space();
            self.write_token(then_kw);
            self.write_space();
            self.print_expr(body);
        },
        .WhilePattern(kw, subject, is_kw, pattern, then_kw, body) then {
            self.write_token(kw);
            self.write_space();
            self.print_expr(subject);
            self.write_space();
            self.write_token(is_kw);
            self.write_space();
            self.print_pattern(pattern);
            self.write_space();
            self.write_token(then_kw);
            self.write_space();
            self.print_expr(body);
        },
        .For(kw, binding, eq, iterable, then_kw, body) then {
            self.write_token(kw);
            self.write_space();
            self.print_pattern(binding);
            self.write_space();
            self.write_token(eq);
            self.write_space();
            self.print_expr(iterable);
            self.write_space();
            self.write_token(then_kw);
            self.write_space();
            self.print_expr(body);
        },
        .When(kw, subject, is_kw, lb, arms, rb) then self.print_when(
            kw,
            subject,
            is_kw,
            lb,
            arms,
            rb,
        ),
        .AndThen(left, and_kw, then_kw, right) then {
            self.print_expr(left);
            self.write_space();
            self.write_token(and_kw);
            self.write_space();
            self.write_token(then_kw);
            self.write_space();
            self.print_expr(right);
        },
        .OrElse(left, or_kw, else_kw, right) then {
            self.print_expr(left);
            self.write_space();
            self.write_token(or_kw);
            self.write_space();
            self.write_token(else_kw);
            self.write_space();
            self.print_expr(right);
        },
        .OrReturn(left, or_kw, return_kw) then {
            self.print_expr(left);
            self.write_space();
            self.write_token(or_kw);
            self.write_space();
            self.write_token(return_kw);
        },
        .RangeExpr(left, op, right) then {
            if left is .Some(l) then {
                self.print_expr(l);
            };
            self.write_token(op);
            if right is .Some(r) then {
                self.print_expr(r);
            };
        },
        .EmptyLiteral(lb, rb) then {
            self.write_token(lb);
            self.write_token(rb);
        },
        .CollectionLiteral(lb, elements, rb) then {
            self.write_token(lb);
            for i in 0..<elements.count() then {
                let element = elements[i];
                self.print_expr(element.value);
                if element.comma is .Some(c) then {
                    self.write_separator(c);
                };
            };
            self.write_token(rb);
        },
        .DictLiteral(lb, entries, rb) then {
            self.write_token(lb);
            for i in 0..<entries.count() then {
                let entry = entries[i];
                self.print_expr(entry.key);
                self.write_token(entry.colon);
                self.write_space();
                self.print_expr(entry.value);
                if entry.comma is .Some(c) then {
                    self.write_separator(c);
                };
            };
            self.write_token(rb);
        },
        .Lambda(lp, params, rp, ret, arrow, body) then {
            self.write_token(lp);
            for i in 0..<params.count() then {
                let p = params[i];
                self.write_token(p.name);
                if p.param_type is .Some(pt) then {
                    self.write_space();
                    self.print_type(pt);
                };
                if p.comma is .Some(c) then {
                    self.write_separator(c);
                };
            };
            self.write_token(rp);
            if ret is .Some(rt) then {
                self.write_space();
                self.print_type(rt);
            };
            self.write_space();
            self.write_token(arrow);
            self.write_space();
            self.print_expr(body);
        },
        .EnumVariant(name, lp, fields, rp) then {
            self.write_token(name);
            if lp is .Some(l) then {
                // A comment needs its own line, so a payload that carries one
                // has to be laid out multi-line. Collapsing it would leave the
                // comment spliced into the middle of an inline argument list.
                let wrap = self.enum_variant_needs_multiline(fields);
                self.write_token(l);
                if wrap then {
                    self.write_newline();
                    self.indent += 1;
                };
                for i in 0..<fields.count() then {
                    let f = fields[i];
                    for c in f.comments then {
                        if not self.at_line_start then {
                            self.write_newline();
                        };
                        self.write_token(c);
                        self.write_newline();
                    };
                    if wrap and not self.at_line_start then {
                        self.write_newline();
                    };
                    self.write_token(f.name);
                    if f.colon is .Some(c) then {
                        self.write_token(c);
                        self.write_space();
                    } else {
                        self.write_space();
                    };
                    self.print_type(f.field_type);
                    self.print_default_value(f.default_value);
                    if wrap then {
                        self.write(",");
                    } else if f.comma is .Some(c) then {
                        self.write_token(c);
                        self.write_space();
                    };
                };
                if wrap then {
                    self.indent -= 1;
                    self.write_newline();
                };
                if rp is .Some(r) then {
                    self.write_token(r);
                };
            };
        },
    };

    file_private enum_variant_needs_multiline(self, fields List[CstEnumField]) Bool = {
        for f in fields then {
            if not f.comments.is_empty() then {
                return true;
            };
        };
        return false;
    };

    file_private print_call_args(
        self,
        args List[CstCallArg],
        allow_trailing_comma Bool,
    ) Void = {
        if self.call_args_need_multiline(args) then {
            self.write_newline();
            self.indent += 1;
            for arg in args then {
                self.print_call_arg_multiline(arg, allow_trailing_comma);
                if not self.at_line_start then {
                    self.write_newline();
                };
            };
            self.indent -= 1;
            return;
        };
        for arg in args then {
            self.print_call_arg_inline(arg);
        };
    };

    /// One argument per line, each line ending in a comma -- including the last,
    /// so adding an argument is a one-line diff.
    file_private print_call_arg_multiline(
        self,
        arg CstCallArg,
        allow_trailing_comma Bool,
    ) Void = when arg in {
        .Value(label, colon, value, comma) then {
            if label is .Some(arg_label) then {
                self.write_token(arg_label);
                if colon is .Some(c) then {
                    self.write_token(c);
                    self.write_space();
                };
            };
            self.print_expr(value);
            if comma is .Some(c) then {
                self.write_token(c);
            } else if allow_trailing_comma then {
                self.write(",");
            };
        },
        .DefaultFill(leading_comments, ellipsis, comma) then {
            for comment in leading_comments then {
                self.write_token(comment);
                self.write_newline();
            };
            self.write_token(ellipsis);
            if comma is .Some(c) then {
                self.write_token(c);
            } else if allow_trailing_comma then {
                self.write(",");
            };
        },
    };

    file_private print_call_arg_inline(self, arg CstCallArg) Void = when arg in {
        .Value(label, colon, value, comma) then {
            if label is .Some(arg_label) then {
                self.write_token(arg_label);
                if colon is .Some(c) then {
                    self.write_token(c);
                    self.write_space();
                };
            };
            self.print_expr(value);
            if comma is .Some(c) then {
                self.write_separator(c);
            };
        },
        .DefaultFill(_, ellipsis, comma) then {
            self.write_token(ellipsis);
            if comma is .Some(c) then {
                self.write_separator(c);
            };
        },
    };

    /// Arguments go on one line when they fit, and one per line when they do
    /// not. A comment inside the argument list always forces the second shape --
    /// there is no room for it on a single line.
    file_private call_args_need_multiline(self, args List[CstCallArg]) Bool = {
        for arg in args then {
            when arg in {
                .Value(_, _, value, _) then when value in {
                    .Commented(_, _) then {
                        return true;
                    },
                    _ then {},
                },
                .DefaultFill(leading_comments, _, _) then {
                    if leading_comments.count() > 0 then {
                        return true;
                    };
                },
            };
        };

        if self.force_flat then {
            return false;
        };

        let mutable total UInt = 1;
        for arg in args then {
            total += self.estimate_call_arg_length(arg) + 1;
        };
        return not self.line_fits(total);
    };

    /// The exact width `e` takes when nothing is allowed to break. Rendered
    /// rather than estimated: a guess that runs a couple of columns short is
    /// enough to make one pass break a call and the next pass not, and the
    /// formatter stops being idempotent.
    file_private flat_length(self, e CstExpr) UInt = {
        let mutable measure = Printer.new();
        measure.force_flat = true;
        measure.print_expr(e);
        return measure.line.count() + measure.output.count();
    };

    /// Whether the rest of the current line can take `width` more columns.
    /// `line` already holds the indent, so its length is the column.
    file_private line_fits(self, width UInt) Bool =
        self.line.count() + width + self.reserve <= Printer.line_width();

    file_private line_width() UInt = 90;

    // ========================================================================
    // Block printing: { items }
    // ========================================================================

    file_private print_block(
        self,
        lb Token,
        items List[CstItem],
        tail_expr Option[CstExpr],
        rb Token,
    ) Void = {
        self.write_token(lb);
        if items.count() == 0 and tail_expr is .None() then {
            self.write_token(rb);
            return;
        };
        self.print_block_items_multiline(items, tail_expr, rb);
    };

    file_private print_block_multiline(
        self,
        lb Token,
        items List[CstItem],
        tail_expr Option[CstExpr],
        rb Token,
    ) Void = {
        self.write_token(lb);
        if items.count() == 0 and tail_expr is .None() then {
            self.write_token(rb);
            return;
        };
        self.print_block_items_multiline(items, tail_expr, rb);
    };

    file_private print_block_items_multiline(
        self,
        items List[CstItem],
        tail_expr Option[CstExpr],
        rb Token,
    ) Void = {
        self.write_newline();
        self.indent += 1;
        let mutable i UInt = 0;
        while i < items.count() then {
            if items[i] is .BlankLine() then {
                self.write_newline();
                i += 1;
                continue;
            };
            self.print_item(items[i]);
            if not self.next_is_trailing_comment(items, i) then {
                if not self.at_line_start then {
                    self.write_newline();
                };
            };
            i += 1;
        };
        if tail_expr is .Some(expr) then {
            self.print_expr(expr);
            if not self.at_line_start then {
                self.write_newline();
            };
        };
        self.indent -= 1;
        self.write_token(rb);
    };

    // ========================================================================
    // If expression printing
    // ========================================================================

    file_private print_if(
        self,
        kw Token,
        cond CstExpr,
        then_kw Token,
        then_body CstExpr,
        else_kw Option[Token],
        else_body Option[CstExpr],
    ) Void = {
        self.write_token(kw);
        self.write_space();
        self.print_expr(cond);
        self.write_space();
        self.write_token(then_kw);

        let then_is_block = when then_body in {
            .Block(_, _, _, _) then true,
            _ then false,
        };

        if then_is_block then {
            self.write_space();
            self.print_expr(then_body);
            if else_kw is .Some(ek) then {
                self.write_space();
                self.write_token(ek);
                if else_body is .Some(eb) then {
                    self.write_space();
                    self.print_expr(eb);
                };
            };
        } else {
            // Non-block then body: prefer inline for short forms
            self.write_space();
            self.print_expr(then_body);
            if else_kw is .Some(ek) then {
                if else_body is .Some(eb) then {
                    let else_is_block_like = when eb in {
                        .Block(_, _, _, _) or .When(_, _, _, _, _, _) then true,
                        _ then false,
                    };
                    let eb_expr = eb;
                    if else_is_block_like then {
                        self.write_newline();
                        self.write_token(ek);
                        self.write_space();
                        self.print_expr(eb_expr);
                    } else {
                        // Does ` else <branch>` still fit where we are? Measured
                        // from the column the `if` has already reached, and by
                        // rendering the branch flat rather than guessing at it.
                        let else_width = ek.to_string().count() + 2 + self.flat_length(
                            eb_expr,
                        );
                        if self.line_fits(else_width) then {
                            self.write_space();
                            self.write_token(ek);
                            self.write_space();
                            self.print_expr(eb_expr);
                        } else {
                            self.write_newline();
                            self.write_token(ek);
                            self.write_space();
                            self.print_expr(eb_expr);
                        };
                    };
                } else {
                    self.write_newline();
                    self.write_token(ek);
                };
            };
        };
    };

    // ========================================================================
    // When expression printing
    // ========================================================================

    file_private print_when(
        self,
        kw Token,
        subject CstExpr,
        is_kw Token,
        lb Token,
        arms List[CstWhenArm],
        rb Token,
    ) Void = {
        self.write_token(kw);
        self.write_space();
        self.print_expr(subject);
        self.write_space();
        self.write_token(is_kw);
        self.write_space();
        self.write_token(lb);
        if arms.count() == 0 then {
            self.write_token(rb);
            return;
        };
        self.write_newline();
        self.indent += 1;
        for i in 0..<arms.count() then {
            let arm = arms[i];
            for comment in arm.leading_comments then {
                self.write_token(comment);
                self.write_newline();
            };
            self.print_pattern(arm.pattern);
            self.write_space();
            self.write_token(arm.then_kw);
            self.write_space();
            self.print_expr(arm.body);
            self.write(",");
            for j in 0..<arm.trailing_comments.count() then {
                let comment = arm.trailing_comments[j];
                if j == 0 then {
                    self.write_space();
                };
                self.write_token(comment);
                if j + 1 < arm.trailing_comments.count() then {
                    self.write_newline();
                };
            };
            self.write_newline();
        };
        self.indent -= 1;
        self.write_token(rb);
    };

    // ========================================================================
    // Statement printing
    // ========================================================================

    file_private print_stmt(self, s CstStmt) Void = when s in {
        .VarDecl(let_kw, mut_kw, name, var_type, eq, value) then {
            self.write_token(let_kw);
            self.write_space();
            if mut_kw is .Some(mk) then {
                self.write_token(mk);
                self.write_space();
            };
            self.write_token(name);
            if var_type is .Some(vt) then {
                self.write_space();
                self.print_type(vt);
            };
            self.write_space();
            self.write_token(eq);
            self.write_space();
            self.print_expr(value);
        },
        .PairVarDecl(let_kw, lp, first, comma, second, rp, eq, value) then {
            self.write_token(let_kw);
            self.write_space();
            self.write_token(lp);
            self.print_pair_binding(first);
            self.write_token(comma);
            self.write_space();
            self.print_pair_binding(second);
            self.write_token(rp);
            self.write_space();
            self.write_token(eq);
            self.write_space();
            self.print_expr(value);
        },
        .Assignment(target, op, value) then {
            self.print_expr(target);
            self.write_space();
            self.write_token(op);
            self.write_space();
            self.print_expr(value);
        },
        .ExprStmt(expr, _) then {
            self.print_expr(expr);
        },
        .Defer(kw, value) then {
            self.write_token(kw);
            self.write_space();
            self.print_expr(value);
        },
        .Return(kw, value) then {
            self.write_token(kw);
            if value is .Some(v) then {
                self.write_space();
                self.print_expr(v);
            };
        },
        .Break(kw) then {
            self.write_token(kw);
        },
        .Continue(kw) then self.write_token(kw),
    };

    file_private print_pair_binding(self, binding CstPairBinding) Void = {
        if binding.mut_kw is .Some(mk) then {
            self.write_token(mk);
            self.write_space();
        };
        self.write_token(binding.name);
        if binding.binding_type is .Some(bt) then {
            self.write_space();
            self.print_type(bt);
        };
    };

    // ========================================================================
    // Item printing
    // ========================================================================

    public print_item(self, item CstItem) Void = when item in {
        .Decl(d) then {
            // The `;` is written here, after the declaration -- reserve the
            // column for it so width checks see the whole statement. It is set,
            // not accumulated: a nested statement's terminator replaces the
            // enclosing one, whose own `;` lands after a closing brace and
            // cannot be riding on an inner line.
            let saved_reserve = self.reserve;
            self.reserve = 1;
            self.print_decl(d);
            self.reserve = saved_reserve;
            self.write(";");
        },
        .Stmt(s) then {
            let saved_reserve = self.reserve;
            self.reserve = 1;
            self.print_stmt(s);
            self.reserve = saved_reserve;
            self.write(";");
        },
        .Comment(t) then self.write_token(t),
        .TrailingComment(t) then {
            if not self.at_line_start then {
                self.write_space();
            };
            self.write_token(t);
        },
        .BlankLine() then {},
    };

    // ========================================================================
    // Declaration printing
    // ========================================================================

    file_private print_decl(self, d CstDecl) Void = when d in {
        .Using(tokens) then {
            self.print_token_sequence_stripped(tokens);
        },
        .ForeignUsing(foreign_kw, tokens) then {
            self.write_token(foreign_kw);
            if tokens.count() > 0 then {
                self.write_space();
                self.print_token_sequence_stripped(tokens);
            };
        },
        .Func(vis, mods, let_kw, mut_kw, gp, name, lp, params, rp, ret, eq, body) then self.print_func_decl(
            vis,
            mods,
            let_kw,
            mut_kw,
            gp,
            name,
            lp,
            params,
            rp,
            ret,
            eq,
            body,
        ),
        .ForeignDecl(vis, mods, let_kw, mut_kw, gp, name, lp, params, rp, ret) then self.print_foreign_decl(
            vis,
            mods,
            let_kw,
            mut_kw,
            gp,
            name,
            lp,
            params,
            rp,
            ret,
        ),
        .Type(vis, mods, kw, mut_kw, gp, name, body) then self.print_type_decl(
            vis,
            mods,
            kw,
            mut_kw,
            gp,
            name,
            body,
        ),
        .Trait(vis, kw, gp, name, supers, lb, members, rb) then self.print_trait_decl(
            vis,
            kw,
            gp,
            name,
            supers,
            lb,
            members,
            rb,
        ),
        .Given(vis, mods, kw, gp, target, as_kw, trait_type, lb, members, rb) then self.print_given_decl(
            vis,
            mods,
            kw,
            gp,
            target,
            as_kw,
            trait_type,
            lb,
            members,
            rb,
        ),
        .GivenNot(vis, mods, kw, gp, target, not_kw, trait_name) then {
            if vis is .Some(v) then {
                self.write_token(v);
                self.write_space();
            };
            for mod in mods then {
                self.write_token(mod);
                self.write_space();
            };
            self.write_token(kw);
            if gp is .Some(g) then {
                self.print_generic_params(g);
            };
            self.write_space();
            self.print_type(target);
            self.write_space();
            self.write_token(not_kw);
            self.write_space();
            self.write_token(trait_name);
        },
        .Var(vis, let_kw, mut_kw, name, var_type) then {
            if vis is .Some(v) then {
                self.write_token(v);
                self.write_space();
            };
            self.write_token(let_kw);
            self.write_space();
            if mut_kw is .Some(mk) then {
                self.write_token(mk);
                self.write_space();
            };
            self.write_token(name);
            if var_type is .Some(vt) then {
                self.write_space();
                self.print_type(vt);
            };
        },
        .TraitMethod(vis, gp, name, lp, params, rp, ret) then {
            if vis is .Some(v) then {
                self.write_token(v);
                self.write_space();
            };
            self.write_token(name);
            if gp is .Some(g) then {
                self.print_generic_params(g);
            };
            self.write_token(lp);
            for param in params then {
                when param in {
                    .SelfParam(kw, mut_kw, comma) then {
                        self.print_self_param(kw, mut_kw, comma);
                    },
                    .NamedParam(pname, mut_kw, colon, pt, default_value, comma) then {
                        if mut_kw is .Some(mk) then {
                            self.write_token(mk);
                            self.write_space();
                        };
                        self.write_token(pname);
                        if colon is .Some(c) then {
                            self.write_token(c);
                            self.write_space();
                        } else {
                            self.write_space();
                        };
                        self.print_type(pt);
                        self.print_default_value(default_value);
                        if comma is .Some(c) then {
                            self.write_token(c);
                            self.write_space();
                        };
                    },
                };
            };
            self.write_token(rp);
            if ret is .Some(rt) then {
                self.write_space();
                self.print_type(rt);
            };
        },
    };

    // `using` declarations are kept as a flat token list rather than a parsed
    // shape, so this is the one place that still decides spacing from token
    // text. Newlines inside the list are real line breaks and are preserved --
    // an import list written across lines stays across lines.

    file_private print_token_sequence(self, tokens List[Token]) Void = {
        for i in 0..<tokens.count() then {
            self.print_sequence_token(tokens, i);
        };
    };

    file_private print_token_sequence_stripped(self, tokens List[Token]) Void = {
        let mutable count = tokens.count();
        while count > 0 and tokens[count - 1] is .Semi() then {
            count -= 1;
        };
        for i in 0..<count then {
            self.print_sequence_token(tokens, i);
        };
    };

    file_private print_sequence_token(self, tokens List[Token], i UInt) Void = {
        let cur = tokens[i];
        if cur is .Newline() then {
            self.write_newline();
            return;
        };
        if i > 0 and tokens[i - 1] is .Newline() then {
            self.hang = 1;
        } else if i > 0 then {
            if self.should_space_between_tokens(tokens[i - 1], cur) then {
                self.write_space();
            };
        };
        self.write_token(cur);
    };

    file_private should_space_between_tokens(self, prev Token, cur Token) Bool = {
        when prev in {
            .Colon() or .Dot() then {
                return false;
            },
            .LBrace() then {
                return true;
            },
            _ then {},
        };
        when cur in {
            .Colon() or .Dot() or .Comma() or .Semi() or .RParen() or .RBracket() then {
                return false;
            },
            .LBrace() then {
                return true;
            },
            _ then {},
        };
        return true;
    };

    // ========================================================================
    // Func declaration
    // ========================================================================

    file_private print_func_decl(
        self,
        vis Option[Token],
        mods List[Token],
        let_kw Option[Token],
        mut_kw Option[Token],
        gp Option[CstGenericParams],
        name Option[Token],
        lp Option[Token],
        params List[CstParam],
        rp Option[Token],
        ret Option[CstType],
        eq Token,
        body CstExpr,
    ) Void = {
        let wrap_params = if lp is .Some(_) then {
            if self.count_params(params) > 0 then {
                let head_len = self.estimate_head_length(
                    vis,
                    mods,
                    let_kw,
                    mut_kw,
                    gp,
                    name,
                    lp,
                    params,
                    rp,
                    ret,
                );
                (self.indent * 4) + head_len > 90
            } else false
        } else false;

        if vis is .Some(v) then {
            self.write_token(v);
            self.write_space();
        };
        for mod in mods then {
            self.write_token(mod);
            self.write_space();
        };
        if let_kw is .Some(k) then {
            self.write_token(k);
            self.write_space();
        };
        if mut_kw is .Some(k) then {
            self.write_token(k);
            self.write_space();
        };
        if name is .Some(n) then {
            self.write_token(n);
        };
        if gp is .Some(g) then {
            self.print_generic_params(g);
        };
        if lp is .Some(l) then {
            self.write_token(l);
            if wrap_params then {
                self.print_params_multiline(params);
            } else {
                self.print_params(params);
            };
            if rp is .Some(r) then {
                self.write_token(r);
            };
        };
        if ret is .Some(rt) then {
            self.write_space();
            self.print_type(rt);
        };
        self.write_space();
        self.write_token(eq);

        // Block/when/if body: same line
        when body in {
            .Block(lb, items, tail_expr, rb) then {
                self.write_space();
                self.print_block_multiline(lb, items, tail_expr, rb);
                return;
            },
            .When(_, _, _, _, _, _) or .If(_, _, _, _, _, _) then {
                self.write_space();
                self.print_expr(body);
                return;
            },
            _ then {},
        };

        // Simple body: check line length for wrapping
        let head_len = self.estimate_head_length(
            vis,
            mods,
            let_kw,
            mut_kw,
            gp,
            name,
            lp,
            params,
            rp,
            ret,
        );
        let body_len = self.estimate_expr_length(body);
        let total = (self.indent * 4) + head_len + 3 + body_len; // " = " + body

        if total > 90 then {
            self.write_newline();
            self.indent += 1;
            self.print_expr(body);
            self.indent -= 1;
        } else {
            self.write_space();
            self.print_expr(body);
        };
    };

    // ========================================================================
    // Foreign declaration (no body)
    // ========================================================================

    file_private print_foreign_decl(
        self,
        vis Option[Token],
        mods List[Token],
        let_kw Option[Token],
        mut_kw Option[Token],
        gp Option[CstGenericParams],
        name Option[Token],
        lp Option[Token],
        params List[CstParam],
        rp Option[Token],
        ret Option[CstType],
    ) Void = {
        let wrap_params = if lp is .Some(_) then {
            if self.count_params(params) > 0 then {
                let head_len = self.estimate_head_length(
                    vis,
                    mods,
                    let_kw,
                    mut_kw,
                    gp,
                    name,
                    lp,
                    params,
                    rp,
                    ret,
                );
                (self.indent * 4) + head_len > 90
            } else false
        } else false;

        if vis is .Some(v) then {
            self.write_token(v);
            self.write_space();
        };
        for mod in mods then {
            self.write_token(mod);
            self.write_space();
        };
        if let_kw is .Some(k) then {
            self.write_token(k);
            self.write_space();
        };
        if mut_kw is .Some(k) then {
            self.write_token(k);
            self.write_space();
        };
        if name is .Some(n) then {
            self.write_token(n);
        };
        if gp is .Some(g) then {
            self.print_generic_params(g);
        };
        if lp is .Some(l) then {
            self.write_token(l);
            if wrap_params then {
                self.print_params_multiline(params);
            } else {
                self.print_params(params);
            };
            if rp is .Some(r) then {
                self.write_token(r);
            };
        };
        if ret is .Some(rt) then {
            self.write_space();
            self.print_type(rt);
        };
    };

    // ========================================================================
    // Params printing
    // ========================================================================

    file_private print_params(self, params List[CstParam]) Void = {
        for param in params then {
            self.print_param(param);
        };
    };

    file_private print_params_multiline(self, params List[CstParam]) Void = {
        self.write_newline();
        self.indent += 1;
        for param in params then {
            self.print_param_multiline(param);
            if not self.at_line_start then {
                self.write_newline();
            };
        };
        self.indent -= 1;
    };

    file_private print_param_multiline(self, param CstParam) Void = {
        when param in {
            .SelfParam(kw, mut_kw, _) then {
                self.print_self_param(kw, mut_kw, .None());
                self.write(",");
            },
            .NamedParam(name, mut_kw, colon, param_type, default_value, _) then {
                if mut_kw is .Some(mk) then {
                    self.write_token(mk);
                    self.write_space();
                };
                self.write_token(name);
                if colon is .Some(c) then {
                    self.write_token(c);
                    self.write_space();
                } else {
                    self.write_space();
                };
                self.print_type(param_type);
                self.print_default_value(default_value);
                self.write(",");
            },
        };
    };

    // `self` is the only receiver form; there is no `*self` spelling left to
    // print (grammar.bnf <method-first-param>).
    file_private print_self_param(
        self,
        kw Token,
        mut_kw Option[Token],
        comma Option[Token],
    ) Void = {
        self.write_token(kw);
        if mut_kw is .Some(mk) then {
            self.write_space();
            self.write_token(mk);
        };
        if comma is .Some(c) then {
            self.write_separator(c);
        };
    };

    /// Measured exactly, by rendering the value flat, and without the separator
    /// comma. The comma is what the line-shape decision itself chooses -- a list
    /// kept on one line has none, one exploded across lines has one per line --
    /// so counting it here would let the decision depend on its own output and
    /// the formatter would stop settling.
    file_private estimate_call_arg_length(self, arg CstCallArg) UInt = when arg in {
        .Value(label, colon, value, _) then {
            let mutable len = self.flat_length(value);
            if label is .Some(arg_label) then {
                len += arg_label.to_string().count();
                if colon is .Some(c) then {
                    len += c.to_string().count() + 1;
                };
            };
            len
        },
        .DefaultFill(_, ellipsis, _) then ellipsis.to_string().count(),
    };

    file_private print_param(self, param CstParam) Void = {
        when param in {
            .SelfParam(kw, mut_kw, comma) then {
                self.print_self_param(kw, mut_kw, comma);
            },
            .NamedParam(name, mut_kw, colon, param_type, default_value, comma) then {
                if mut_kw is .Some(mk) then {
                    self.write_token(mk);
                    self.write_space();
                };
                self.write_token(name);
                if colon is .Some(c) then {
                    self.write_token(c);
                    self.write_space();
                } else {
                    self.write_space();
                };
                self.print_type(param_type);
                self.print_default_value(default_value);
                if comma is .Some(c) then {
                    self.write_separator(c);
                };
            },
        };
    };

    // ========================================================================
    // Type declaration
    // ========================================================================

    file_private print_type_decl(
        self,
        vis Option[Token],
        mods List[Token],
        kw Token,
        mut_kw Option[Token],
        gp Option[CstGenericParams],
        name Token,
        body CstTypeBody,
    ) Void = {
        if vis is .Some(v) then {
            self.write_token(v);
            self.write_space();
        };
        for mod in mods then {
            self.write_token(mod);
            self.write_space();
        };
        self.write_token(kw);
        self.write_space();
        if mut_kw is .Some(m) then {
            self.write_token(m);
            self.write_space();
        };
        self.write_token(name);
        if gp is .Some(g) then {
            self.print_generic_params(g);
        };
        when body in {
            .Struct(lp, items, rp) then {
                let field_count = self.count_struct_fields(items);
                let wrap_fields = if not self.struct_items_are_simple(items) then true
                else {
                    if field_count > 0 then {
                        let decl_len = self.estimate_struct_decl_length(
                            vis,
                            mods,
                            kw,
                            mut_kw,
                            gp,
                            name,
                            items,
                        );
                        (self.indent * 4) + decl_len > 90
                    } else false
                };

                self.write_token(lp);
                if wrap_fields then {
                    self.print_struct_body_multiline(items, rp);
                } else {
                    for item in items then {
                        when item in {
                            .Field(field) then self.print_struct_field(field),
                            _ then {},
                        };
                    };
                    self.write_token(rp);
                };
            },
            .Enum(lb, cases, rb) then {
                self.write_space();
                self.print_enum_body(lb, cases, rb);
            },
            .Alias(eq, target) then {
                self.write_space();
                self.write_token(eq);
                self.write_space();
                self.print_type(target);
            },
            .Empty() then {},
        };
    };

    file_private estimate_default_length(self, d Option[CstDefault]) UInt = {
        return when d in {
            .Some(default) then {
                let mutable len UInt = 2;
                for t in default.value_tokens then {
                    len += t.to_string().count();
                };
                len
            },
            .None() then 0(UInt),
        };
    };

    file_private print_default_value(self, d Option[CstDefault]) Void = {
        when d in {
            .Some(default) then {
                self.write_space();
                self.write_token(default.eq);
                self.write_space();
                for t in default.value_tokens then {
                    self.write_token(t);
                };
            },
            .None() then {},
        };
    };

    file_private print_struct_field(self, f CstStructField) Void = {
        if f.access is .Some(a) then {
            self.write_token(a);
            self.write_space();
        };
        if f.mut_kw is .Some(mk) then {
            self.write_token(mk);
            self.write_space();
        };
        self.write_token(f.name);
        if f.colon is .Some(c) then {
            self.write_token(c);
            self.write_space();
        } else {
            self.write_space();
        };
        self.print_type(f.field_type);
        self.print_default_value(f.default_value);
        if f.comma is .Some(c) then {
            self.write_separator(c);
        };
    };

    file_private print_struct_field_multiline(self, f CstStructField) Void = {
        if f.access is .Some(a) then {
            self.write_token(a);
            self.write_space();
        };
        if f.mut_kw is .Some(mk) then {
            self.write_token(mk);
            self.write_space();
        };
        self.write_token(f.name);
        if f.colon is .Some(c) then {
            self.write_token(c);
            self.write_space();
        } else {
            self.write_space();
        };
        self.print_type(f.field_type);
        self.print_default_value(f.default_value);
        self.write(",");
    };

    file_private print_struct_body_multiline(
        self,
        items List[CstStructBodyItem],
        rp Token,
    ) Void = {
        self.write_newline();
        self.indent += 1;
        let mutable i UInt = 0;
        while i < items.count() then {
            when items[i] in {
                .BlankLine() then {
                    self.write_newline();
                },
                .Comment(t) then {
                    self.write_token(t);
                    if not self.at_line_start then {
                        self.write_newline();
                    };
                },
                .TrailingComment(t) then {
                    if not self.at_line_start then {
                        self.write_space();
                    };
                    self.write_token(t);
                    if not self.at_line_start then {
                        self.write_newline();
                    };
                },
                .Field(field) then {
                    self.print_struct_field_multiline(field);
                    if i + 1 < items.count() then {
                        when items[i + 1] in {
                            // Only a TrailingComment belongs on this line -- the
                            // source had it after the code on the same line. A
                            // Comment was written on its own line and documents
                            // whatever follows, so gluing it here would silently
                            // re-aim it at the previous field.
                            .TrailingComment(t) then {
                                self.write_space();
                                self.write_token(t);
                                i += 1;
                            },
                            _ then {},
                        };
                    };
                    if not self.at_line_start then {
                        self.write_newline();
                    };
                },
            };
            i += 1;
        };
        self.indent -= 1;
        self.write_token(rp);
    };

    file_private print_enum_body(self, lb Token, cases List[CstItem], rb Token) Void = {
        self.write_token(lb);
        if cases.count() == 0 then {
            self.write_token(rb);
            return;
        };
        self.write_newline();
        self.indent += 1;
        let mutable i UInt = 0;
        while i < cases.count() then {
            when cases[i] in {
                .BlankLine() then {
                    self.write_newline();
                },
                .Comment(t) then {
                    self.write_token(t);
                    if not self.at_line_start then {
                        self.write_newline();
                    };
                },
                .TrailingComment(t) then {
                    if not self.at_line_start then {
                        self.write_space();
                    };
                    self.write_token(t);
                    if not self.at_line_start then {
                        self.write_newline();
                    };
                },
                .Stmt(s) then {
                    when s in {
                        .ExprStmt(expr, _) then {
                            self.print_expr(expr);
                            self.write(",");
                        },
                        _ then {
                            self.print_stmt(s);
                            self.write(",");
                        },
                    };
                    if i + 1 < cases.count() then {
                        when cases[i + 1] in {
                            .TrailingComment(t) then {
                                self.write_space();
                                self.write_token(t);
                                i += 1;
                            },
                            _ then {},
                        };
                    };
                    if not self.at_line_start then {
                        self.write_newline();
                    };
                },
                .Decl(d) then {
                    self.print_decl(d);
                    self.write(",");
                    if i + 1 < cases.count() then {
                        when cases[i + 1] in {
                            .TrailingComment(t) then {
                                self.write_space();
                                self.write_token(t);
                                i += 1;
                            },
                            _ then {},
                        };
                    };
                    if not self.at_line_start then {
                        self.write_newline();
                    };
                },
            };
            i += 1;
        };
        self.indent -= 1;
        self.write_token(rb);
    };

    // ========================================================================
    // Trait declaration
    // ========================================================================

    file_private print_trait_decl(
        self,
        vis Option[Token],
        kw Token,
        gp Option[CstGenericParams],
        name Token,
        supers List[CstType],
        lb Token,
        members List[CstItem],
        rb Token,
    ) Void = {
        if vis is .Some(v) then {
            self.write_token(v);
            self.write_space();
        };
        self.write_token(kw);
        self.write_space();
        self.write_token(name);
        if gp is .Some(g) then {
            self.print_generic_params(g);
        };
        for i in 0..<supers.count() then {
            self.write_space();
            if i > 0 then {
                self.write("and");
                self.write_space();
            };
            self.print_type(supers[i]);
        };
        self.write_space();
        self.print_member_block(lb, members, rb);
    };

    // ========================================================================
    // Given declaration
    // ========================================================================

    file_private print_given_decl(
        self,
        vis Option[Token],
        mods List[Token],
        kw Token,
        gp Option[CstGenericParams],
        target CstType,
        as_kw Option[Token],
        trait_type Option[CstType],
        lb Token,
        members List[CstItem],
        rb Token,
    ) Void = {
        if vis is .Some(v) then {
            self.write_token(v);
            self.write_space();
        };
        for mod in mods then {
            self.write_token(mod);
            self.write_space();
        };
        self.write_token(kw);
        if gp is .Some(g) then {
            self.print_generic_params(g);
            self.write_space();
        } else {
            self.write_space();
        };
        self.print_type(target);
        if as_kw is .Some(akw) then {
            self.write_space();
            self.write_token(akw);
            if trait_type is .Some(tt) then {
                self.write_space();
                self.print_type(tt);
            };
        };
        self.write_space();
        self.print_member_block(lb, members, rb);
    };

    // ========================================================================
    // Member block (shared by trait/given)
    // ========================================================================

    file_private print_member_block(self, lb Token, members List[CstItem], rb Token) Void = {
        self.write_token(lb);
        if members.count() == 0 then {
            self.write_token(rb);
            return;
        };
        self.write_newline();
        self.indent += 1;
        let mutable i UInt = 0;
        while i < members.count() then {
            if members[i] is .BlankLine() then {
                self.write_newline();
                i += 1;
                continue;
            };
            self.print_item(members[i]);
            if not self.next_is_trailing_comment(members, i) then {
                if not self.at_line_start then {
                    self.write_newline();
                };
            };
            i += 1;
        };
        self.indent -= 1;
        self.write_token(rb);
    };

    // ========================================================================
    // File printing (top-level)
    // ========================================================================

    /// Blank lines are the author's and go back as written: one `BlankLine`
    /// item prints one blank line, and none are invented or dropped. Older
    /// rules here both inserted a blank before a comment and deleted the one
    /// after it, which contradicted the trailing-comment rule below -- a
    //  comment that belonged on a code line could end up on its own line, and
    /// the next pass would then separate it with a blank.
    public print_file(self, items List[CstItem]) Void = {
        let mutable i UInt = 0;
        while i < items.count() then {
            if items[i] is .BlankLine() then {
                self.write_newline();
                i += 1;
                continue;
            };
            self.print_item(items[i]);
            if not self.next_is_trailing_comment(items, i) then {
                if not self.at_line_start then {
                    self.write_newline();
                };
            };
            i += 1;
        };
    };

    // ========================================================================
    // Item classification helpers
    // ========================================================================

    file_private next_is_trailing_comment(self, items List[CstItem], index UInt) Bool = {
        if index + 1 >= items.count() then {
            return false;
        };
        return items[index + 1] is .TrailingComment(_);
    };

    // ========================================================================
    // Length estimation (for line wrapping)
    // ========================================================================

    file_private estimate_expr_length(self, e CstExpr) UInt = when e in {
        .IntLit(tok) then tok.to_string().count(),
        .FloatLit(tok) then tok.to_string().count(),
        .StrLit(tok) then tok.to_string().count(),
        .InterpStr(tok) then tok.to_string().count(),
        .BoolLit(tok) then tok.to_string().count(),
        .Ident(tok) then tok.to_string().count(),
        .SelfExpr(tok) then tok.to_string().count(),
        .UnderscoreExpr(tok) then tok.to_string().count(),
        .Commented(comments, inner) then {
            let mutable sum = self.estimate_expr_length(inner);
            for comment in comments then {
                sum += comment.to_string().count() + 1;
            };
            sum
        },
        .BinaryOp(left, op, right) then self.estimate_expr_length(left) + 1 + op.to_string(
        ).count() + 1 + self.estimate_expr_length(right),
        .UnaryMinus(_, operand) then 1 + self.estimate_expr_length(operand),
        .Deref(_, operand) then 1 + self.estimate_expr_length(operand),
        .AddressOf(_, raw_kw, mut_kw, operand) then {
            let mutable prefix UInt = 1;
            if raw_kw is .Some(rk) then {
                prefix += rk.to_string().count();
                if mut_kw is .Some(mk) then {
                    prefix += 1 + mk.to_string().count();
                };
                prefix + 1 + self.estimate_expr_length(operand)
            } else {
                if mut_kw is .Some(mk) then {
                    prefix += mk.to_string().count() + 1;
                };
                prefix + self.estimate_expr_length(operand)
            }
        },
        .NotExpr(_, operand) then 4 + self.estimate_expr_length(operand),
        .EmptyLiteral(_, _) then 2,
        .CollectionLiteral(_, elements, _) then {
            let mutable len UInt = 2;
            for i in 0..<elements.count() then {
                if i > 0 then {
                    len += 1;
                };
                len += self.estimate_expr_length(elements[i].value);
                if elements[i].comma is .Some(_) then {
                    len += 1;
                };
            };
            len
        },
        .DictLiteral(_, entries, _) then {
            let mutable len UInt = 2;
            for i in 0..<entries.count() then {
                if i > 0 then {
                    len += 1;
                };
                len += self.estimate_expr_length(entries[i].key) + 2 + self.estimate_expr_length(
                    entries[i].value,
                );
                if entries[i].comma is .Some(_) then {
                    len += 1;
                };
            };
            len
        },
        .PairExpr(_, first, _, second, _) then 4 + self.estimate_expr_length(first) + self.estimate_expr_length(
            second,
        ),
        .Paren(_, inner, _) then 2 + self.estimate_expr_length(inner),
        .TraitQualification(_, base, _, trait_type, _) then 4 + self.estimate_expr_length(
            base,
        ) + self.estimate_type_length(trait_type),
        .Block(_, _, _, _) then 10,
        .FieldAccess(base, _, field) then self.estimate_expr_length(base) + 1 + field.to_string(
        ).count(),
        .QualifiedCall(base, _, _, trait_name, _, method_name, _, args, _) then {
            let mutable len = self.estimate_expr_length(base) + 4 + trait_name.to_string(
            ).count() + method_name.to_string().count() + 2;
            for i in 0..<args.count() then {
                if i > 0 then {
                    len += 2;
                };
                len += self.estimate_call_arg_length(args[i]);
            };
            len
        },
        .Call(callee, _, args, _) then {
            let mutable len = self.estimate_expr_length(callee) + 2;
            for i in 0..<args.count() then {
                if i > 0 then {
                    len += 2;
                };
                len += self.estimate_call_arg_length(args[i]);
            };
            len
        },
        .GenericInst(base, _, type_args, _) then {
            let mutable len = self.estimate_expr_length(base) + 2;
            for i in 0..<type_args.count() then {
                if i > 0 then {
                    len += 2;
                };
                len += self.estimate_type_length(type_args[i].inner);
            };
            len
        },
        .EnumVariant(name, lp, fields, _) then {
            let mutable len = name.to_string().count();
            if lp is .Some(_) then {
                len += 2;
                for i in 0..<fields.count() then {
                    if i > 0 then {
                        len += 2;
                    };
                    for c in fields[i].comments then {
                        len += c.to_string().count() + 1;
                    };
                    len += fields[i].name.to_string().count() + 1 + self.estimate_type_length(
                        fields[i].field_type,
                    ) + self.estimate_default_length(fields[i].default_value);
                };
            };
            len
        },
        _ then 10,
    };

    file_private estimate_type_length(self, t CstType) UInt = when t in {
        .Named(name) then name.to_string().count(),
        .ConstraintKeyword(kw) then kw.to_string().count(),
        .SelfType(_) then 4,
        .Mutable(inner, _) then when inner in {
            .Ptr(ptr_inner, _) then self.estimate_type_length(ptr_inner) + 15,
            .Weakref(weak_inner, _) then self.estimate_type_length(weak_inner) + 6,
            _ then self.estimate_type_length(inner) + 4,
        },
        .Generic(_, args, _, base) then {
            let mutable len = base.to_string().count() + 2;
            for i in 0..<args.count() then {
                if i > 0 then {
                    len += 2;
                };
                len += self.estimate_type_length(args[i].inner);
            };
            len
        },
        .Function(func_kw, _, args, _, return_type) then {
            let mutable len = func_kw.to_string().count() + 3;
            for i in 0..<args.count() then {
                if i > 0 then {
                    len += 2;
                };
                len += self.estimate_type_length(args[i].inner);
            };
            len += self.estimate_type_length(return_type);
            len
        },
        .Ptr(inner, _) then self.estimate_type_length(inner) + 7,
        .Weakref(inner, _) then self.estimate_type_length(inner) + 2,
    };

    file_private estimate_head_length(
        self,
        vis Option[Token],
        mods List[Token],
        let_kw Option[Token],
        mut_kw Option[Token],
        gp Option[CstGenericParams],
        name Option[Token],
        lp Option[Token],
        params List[CstParam],
        rp Option[Token],
        ret Option[CstType],
    ) UInt = {
        let mutable len UInt = 0;
        if vis is .Some(v) then {
            len += v.to_string().count() + 1;
        };
        for mod in mods then {
            len += mod.to_string().count() + 1;
        };
        if let_kw is .Some(k) then {
            len += k.to_string().count() + 1;
        };
        if mut_kw is .Some(k) then {
            len += k.to_string().count() + 1;
        };
        if gp is .Some(g) then {
            let gv = g;
            len += 2; // [ ]
            for gi in 0..<gv.params.count() then {
                let p = gv.params[gi];
                len += p.name.to_string().count();
                for ci in 0..<p.constraints.count() then {
                    if ci > 0 then {
                        len += 5;
                    }; // " and "
                    len += 1 + self.estimate_type_length(p.constraints[ci]);
                };
                if p.comma is .Some(_) then {
                    len += 2;
                };
            };
        };
        if name is .Some(n) then {
            len += n.to_string().count();
        };
        if lp is .Some(_) then {
            len += 2; // ( )
            for param in params then {
                when param in {
                    .SelfParam(_, mut_kw, comma) then {
                        len += 4;
                        if mut_kw is .Some(_) then {
                            len += 4;
                        };
                        if comma is .Some(_) then {
                            len += 2;
                        };
                    },
                    .NamedParam(name, mut_kw, colon, param_type, default_value, comma) then {
                        if mut_kw is .Some(_) then {
                            len += 4;
                        };
                        len += name.to_string().count() + 1 + self.estimate_type_length(
                            param_type,
                        ) + self.estimate_default_length(default_value);
                        if colon is .Some(_) then {
                            len += 1;
                        };
                        if comma is .Some(_) then {
                            len += 2;
                        };
                    },
                };
            };
        };
        if ret is .Some(rt) then {
            len += 1 + self.estimate_type_length(rt);
        };
        return len;
    };

    file_private estimate_struct_decl_length(
        self,
        vis Option[Token],
        mods List[Token],
        kw Token,
        mut_kw Option[Token],
        gp Option[CstGenericParams],
        name Token,
        items List[CstStructBodyItem],
    ) UInt = {
        let mutable len UInt = 0;
        if vis is .Some(v) then {
            len += v.to_string().count() + 1;
        };
        for mod in mods then {
            len += mod.to_string().count() + 1;
        };
        len += kw.to_string().count() + 1;
        if mut_kw is .Some(m) then {
            len += m.to_string().count() + 1;
        };
        if gp is .Some(g) then {
            let gv = g;
            len += 2;
            for gi in 0..<gv.params.count() then {
                let p = gv.params[gi];
                len += p.name.to_string().count();
                for ci in 0..<p.constraints.count() then {
                    if ci > 0 then {
                        len += 5;
                    }; // " and "
                    len += 1 + self.estimate_type_length(p.constraints[ci]);
                };
                if p.comma is .Some(_) then {
                    len += 2;
                };
            };
        };
        len += name.to_string().count();
        len += 2;
        for item in items then {
            when item in {
                .Field(f) then {
                    if f.access is .Some(a) then {
                        len += a.to_string().count() + 1;
                    };
                    if f.mut_kw is .Some(mk) then {
                        len += mk.to_string().count() + 1;
                    };
                    len += f.name.to_string().count() + 1 + self.estimate_type_length(
                        f.field_type,
                    ) + self.estimate_default_length(f.default_value);
                    if f.colon is .Some(_) then {
                        len += 1;
                    };
                    if f.comma is .Some(_) then {
                        len += 2;
                    };
                },
                _ then {},
            };
        };
        return len;
    };

    file_private count_params(self, params List[CstParam]) UInt = {
        let mutable count UInt = 0;
        for _ in params then {
            count += 1;
        };
        return count;
    };

    file_private count_struct_fields(self, items List[CstStructBodyItem]) UInt = {
        let mutable count UInt = 0;
        for item in items then {
            when item in {
                .Field(_) then {
                    count += 1;
                },
                _ then {},
            };
        };
        return count;
    };

    file_private struct_items_are_simple(self, items List[CstStructBodyItem]) Bool = {
        for item in items then {
            when item in {
                .Field(_) then {},
                _ then {
                    return false;
                },
            };
        };
        return true;
    };

    // ========================================================================
    // Finalize output
    // ========================================================================

    // ========================================================================
    // Declaration-only view
    // ========================================================================

    /// Renders a declaration the way generated API docs show it: the shape of
    /// the thing, bodies left out, only what a consumer of the module can see.
    ///
    ///   * a top-level declaration is shown only if it is `public`
    ///   * a `given` block is always shown (it carries no access modifier), with
    ///     its `public` members -- the rest belong to the implementor
    ///   * a trait shows every member: a trait's whole body is its interface
    ///   * a struct type shows fields that are not explicitly non-public, and an
    ///     enum type shows all of its cases
    ///
    /// Spelled by this same printer, so a signature in generated docs is the
    /// syntax the formatter would write for it.
    public print_signature(self, d CstDecl) Void = when d in {
        .Func(vis, mods, let_kw, mut_kw, gp, name, lp, params, rp, ret, _, _) then {
            if not Printer.is_public(vis) then {};
            self.print_decl_head(vis, mods, let_kw, mut_kw, gp, name, lp, params, rp, ret);
        },
        .ForeignDecl(vis, mods, let_kw, mut_kw, gp, name, lp, params, rp, ret) then {
            self.print_decl_head(vis, mods, let_kw, mut_kw, gp, name, lp, params, rp, ret);
        },
        .Var(vis, let_kw, mut_kw, name, var_type) then {
            if vis is .Some(v) then {
                self.write_token(v);
                self.write_space();
            };
            self.write_token(let_kw);
            self.write_space();
            if mut_kw is .Some(mk) then {
                self.write_token(mk);
                self.write_space();
            };
            self.write_token(name);
            if var_type is .Some(vt) then {
                self.write_space();
                self.print_type(vt);
            };
        },
        .Type(vis, mods, kw, mut_kw, gp, name, body) then {
            if vis is .Some(v) then {
                self.write_token(v);
                self.write_space();
            };
            for mod in mods then {
                self.write_token(mod);
                self.write_space();
            };
            self.write_token(kw);
            self.write_space();
            if mut_kw is .Some(m) then {
                self.write_token(m);
                self.write_space();
            };
            self.write_token(name);
            if gp is .Some(g) then {
                self.print_generic_params(g);
            };
            self.print_type_body_signature(body);
        },
        .Trait(vis, kw, gp, name, supers, lb, members, rb) then {
            if vis is .Some(v) then {
                self.write_token(v);
                self.write_space();
            };
            self.write_token(kw);
            self.write_space();
            self.write_token(name);
            if gp is .Some(g) then {
                self.print_generic_params(g);
            };
            for i in 0..<supers.count() then {
                self.write_space();
                if i > 0 then {
                    self.write("and");
                    self.write_space();
                };
                self.print_type(supers[i]);
            };
            self.write_space();
            self.print_member_signatures(lb, members, rb, false);
        },
        .Given(vis, mods, kw, gp, target, as_kw, trait_type, lb, members, rb) then {
            if vis is .Some(v) then {
                self.write_token(v);
                self.write_space();
            };
            for mod in mods then {
                self.write_token(mod);
                self.write_space();
            };
            self.write_token(kw);
            if gp is .Some(g) then {
                self.print_generic_params(g);
            };
            self.write_space();
            self.print_type(target);
            if as_kw is .Some(akw) then {
                self.write_space();
                self.write_token(akw);
                if trait_type is .Some(tt) then {
                    self.write_space();
                    self.print_type(tt);
                };
            };
            self.write_space();
            self.print_member_signatures(lb, members, rb, true);
        },
        .GivenNot(vis, mods, kw, gp, target, not_kw, trait_name) then {
            if vis is .Some(v) then {
                self.write_token(v);
                self.write_space();
            };
            for mod in mods then {
                self.write_token(mod);
                self.write_space();
            };
            self.write_token(kw);
            if gp is .Some(g) then {
                self.print_generic_params(g);
            };
            self.write_space();
            self.print_type(target);
            self.write_space();
            self.write_token(not_kw);
            self.write_space();
            self.write_token(trait_name);
        },
        .TraitMethod(vis, gp, name, lp, params, rp, ret) then {
            if vis is .Some(v) then {
                self.write_token(v);
                self.write_space();
            };
            self.write_token(name);
            if gp is .Some(g) then {
                self.print_generic_params(g);
            };
            self.write_token(lp);
            for i in 0..<params.count() then {
                if i > 0 then {
                    self.write(",");
                    self.write_space();
                };
                when params[i] in {
                    .SelfParam(kw, mut_kw, _) then {
                        self.print_self_param(kw, mut_kw, .None());
                    },
                    .NamedParam(pname, mut_kw, colon, pt, default_value, _) then {
                        if mut_kw is .Some(mk) then {
                            self.write_token(mk);
                            self.write_space();
                        };
                        self.write_token(pname);
                        if colon is .Some(c) then {
                            self.write_token(c);
                            self.write_space();
                        } else {
                            self.write_space();
                        };
                        self.print_type(pt);
                        self.print_default_value(default_value);
                    },
                };
            };
            self.write_token(rp);
            if ret is .Some(rt) then {
                self.write_space();
                self.print_type(rt);
            };
        },
        .Using(_) or .ForeignUsing(_, _) then {},
    };

    /// Everything before the `=` of a function declaration.
    file_private print_decl_head(
        self,
        vis Option[Token],
        mods List[Token],
        let_kw Option[Token],
        mut_kw Option[Token],
        gp Option[CstGenericParams],
        name Option[Token],
        lp Option[Token],
        params List[CstParam],
        rp Option[Token],
        ret Option[CstType],
    ) Void = {
        if vis is .Some(v) then {
            self.write_token(v);
            self.write_space();
        };
        for mod in mods then {
            self.write_token(mod);
            self.write_space();
        };
        if let_kw is .Some(k) then {
            self.write_token(k);
            self.write_space();
        };
        if mut_kw is .Some(k) then {
            self.write_token(k);
            self.write_space();
        };
        if name is .Some(n) then {
            self.write_token(n);
        };
        if gp is .Some(g) then {
            self.print_generic_params(g);
        };
        if lp is .Some(l) then {
            self.write_token(l);
            self.print_params(params);
            if rp is .Some(r) then {
                self.write_token(r);
            };
        };
        if ret is .Some(rt) then {
            self.write_space();
            self.print_type(rt);
        };
    };

    /// A struct whose fields are all non-public has nothing to show -- `type
    /// mutable BufReader[R Reader]`, not `... ()`.
    file_private print_type_body_signature(self, body CstTypeBody) Void = when body in {
        .Struct(lp, items, rp) then {
            let mutable visible UInt = 0;
            for item in items then {
                when item in {
                    .Field(field) then {
                        if Printer.field_is_visible(field) then {
                            visible += 1;
                        };
                    },
                    _ then {},
                };
            };
            if visible == 0 then {
                return;
            };

            self.write_token(lp);
            for item in items then {
                when item in {
                    // Each field carries its own separator, exactly as written:
                    // a signature is a rendering of the declaration, not a
                    // re-typesetting of it.
                    .Field(field) then {
                        if Printer.field_is_visible(field) then {
                            self.print_struct_field(field);
                        };
                    },
                    _ then {},
                };
            };
            self.write_token(rp);
        },
        .Enum(lb, cases, rb) then {
            self.write_space();
            self.print_enum_body(lb, cases, rb);
        },
        .Alias(eq, target) then {
            self.write_space();
            self.write_token(eq);
            self.write_space();
            self.print_type(target);
        },
        .Empty() then {},
    };

    /// Members of a trait or `given`, as signatures on their own lines.
    /// `public_only` is the `given` rule: a method a consumer cannot call is not
    /// part of the API surface, however interesting it is to the implementor.
    file_private print_member_signatures(
        self,
        lb Token,
        members List[CstItem],
        rb Token,
        public_only Bool,
    ) Void = {
        self.write_token(lb);
        let mutable shown UInt = 0;
        for item in members then {
            when item in {
                .Decl(d) then {
                    if public_only and not Printer.is_public(Printer.decl_visibility(d)) then {
                        continue;
                    };
                    shown += 1;
                },
                _ then {},
            };
        };
        if shown == 0 then {
            self.write_token(rb);
            return;
        };
        self.write_newline();
        self.indent += 1;
        for item in members then {
            when item in {
                .Decl(d) then {
                    if public_only and not Printer.is_public(Printer.decl_visibility(d)) then {
                        continue;
                    };
                    self.print_signature(d);
                    self.write(";");
                    self.write_newline();
                },
                _ then {},
            };
        };
        self.indent -= 1;
        self.write_token(rb);
    };

    public is_public(v Option[Token]) Bool = when v in {
        .Some(tok) then tok is .KwPublic(),
        .None() then false,
    };

    /// A struct field is part of the API unless it says otherwise.
    file_private field_is_visible(f CstStructField) Bool = when f.access in {
        .Some(tok) then tok is .KwPublic(),
        .None() then true,
    };

    /// The access modifier on a declaration, wherever it sits in the modifier
    /// list -- `foreign public let` and `public foreign let` are both legal.
    public decl_visibility(d CstDecl) Option[Token] = {
        let (vis, mods) = when d in {
            .Func(v, ms, _, _, _, _, _, _, _, _, _, _) then Pair(v, ms),
            .ForeignDecl(v, ms, _, _, _, _, _, _, _, _) then Pair(v, ms),
            .Type(v, ms, _, _, _, _, _) then Pair(v, ms),
            .Given(v, ms, _, _, _, _, _, _, _, _) then Pair(v, ms),
            .GivenNot(v, ms, _, _, _, _, _) then Pair(v, ms),
            .Var(v, _, _, _, _) then Pair(v, List[Token].new()),
            .Trait(v, _, _, _, _, _, _, _) then Pair(v, List[Token].new()),
            .TraitMethod(v, _, _, _, _, _, _) then Pair(v, List[Token].new()),
            .Using(_) or .ForeignUsing(_, _) then Pair(
                Option[Token].None(),
                List[Token].new(),
            ),
        };
        if vis is .Some(t) then {
            return .Some(t);
        };
        for m in mods then {
            when m in {
                .KwPublic() or .KwPrivate() or .KwProtected() or .KwProtectedPublic() then {
                    return .Some(m);
                },
                _ then {},
            };
        };
        return .None();
    };

    /// Flush the last line, then collapse runs of blank lines to at most one
    /// blank line and make sure the file ends with a newline. Trailing
    /// whitespace was already handled per line when each line was flushed.
    public finalize(self) Void = {
        self.flush_line();
        let runes = self.output.to_string().to_runes();
        let mutable result = StringBuilder.new();
        let mutable consecutive_newlines UInt = 0;

        let mutable i UInt = 0;
        while i < runes.count() then {
            let r = runes[i];
            if r.to_uint32() == 10 then {
                consecutive_newlines += 1;
                if consecutive_newlines <= 2 then {
                    result.push_byte('\n');
                };
            } else {
                consecutive_newlines = 0;
                result.push_string(r.to_string());
            };
            i += 1;
        };

        // Ensure trailing newline
        let result_runes = result.to_string().to_runes();
        if result_runes.count() > 0 then {
            if result_runes[result_runes.count() - 1].to_uint32() <> 10 then {
                result.push_byte('\n');
            };
        };
        self.output = result;
    };
};

// ============================================================================
// Top-level format_source function
// ============================================================================

file_private let validate_optional_expr_usage(
    expr Option[CstExpr],
    statement_context Bool,
) Result[Void] = when expr in {
    .Some(inner) then validate_expr_usage(inner, statement_context),
    .None() then .Ok({}),
};

file_private let validate_call_args(args List[CstCallArg]) Result[Void] = {
    for arg in args then {
        when arg in {
            .Value(_, _, value, _) then {
                validate_expr_usage(value, false) or return;
            },
            .DefaultFill(_, _, _) then {},
        };
    };
    return .Ok({});
};

file_private let validate_item_list(items List[CstItem]) Result[Void] = {
    for item in items then {
        when validate_item(item) in {
            .Ok(_) then {},
            .Error(e) then {
                return .Error(e);
            },
        };
    };
    return .Ok({});
};

file_private let validate_type_body(body CstTypeBody) Result[Void] = when body in {
    .Enum(_, cases, _) then validate_item_list(cases),
    _ then .Ok({}),
};

file_private let validate_decl(decl CstDecl) Result[Void] = when decl in {
    .Func(_, _, _, _, _, _, _, _, _, _, _, body) then validate_expr_usage(body, false),
    .Type(_, _, _, _, _, _, body) then validate_type_body(body),
    .Trait(_, _, _, _, _, _, members, _) then validate_item_list(members),
    .Given(_, _, _, _, _, _, _, _, members, _) then validate_item_list(members),
    .Using(_) or .ForeignUsing(_, _) or .ForeignDecl(_, _, _, _, _, _, _, _, _, _) or .GivenNot(_, _, _, _, _, _, _) or .Var(_, _, _, _, _) or .TraitMethod(_, _, _, _, _, _, _) then .Ok(
        {},
    ),
};

file_private let validate_stmt(stmt CstStmt) Result[Void] = when stmt in {
    .VarDecl(_, _, _, _, _, value) then validate_expr_usage(value, false),
    .PairVarDecl(_, _, _, _, _, _, _, value) then validate_expr_usage(value, false),
    .Assignment(target, _, value) then {
        validate_expr_usage(target, false) or return;
        return validate_expr_usage(value, false);
    },
    .ExprStmt(expr, _) then validate_expr_usage(expr, true),
    .Defer(_, value) then validate_expr_usage(value, true),
    .Return(_, value) then validate_optional_expr_usage(value, false),
    .Break(_) then .Ok({}),
    .Continue(_) then .Ok({}),
};

file_private let validate_item(item CstItem) Result[Void] = when item in {
    .Decl(decl) then validate_decl(decl),
    .Stmt(stmt) then validate_stmt(stmt),
    .Comment(_) or .TrailingComment(_) or .BlankLine() then .Ok({}),
};

file_private let validate_expr_usage(expr CstExpr, statement_context Bool) Result[Void] = when expr in {
    .IntLit(_) or .FloatLit(_) or .StrLit(_) or .InterpStr(_) or .BoolLit(_) or .Ident(_) or .SelfExpr(_) or .UnderscoreExpr(_) or .EnumVariant(_, _, _, _) then .Ok(
        {},
    ),
    .Commented(_, inner) then validate_expr_usage(inner, statement_context),
    .BinaryOp(left, _, right) then {
        validate_expr_usage(left, false) or return;
        return validate_expr_usage(right, false);
    },
    .UnaryMinus(_, operand) or .Deref(_, operand) or .NotExpr(_, operand) or .BitwiseNot(_, operand) or .PrefixKw(_, operand) then validate_expr_usage(
        operand,
        false,
    ),
    .AddressOf(_, _, _, operand) then validate_expr_usage(operand, false),
    .IsExpr(subject, _, _, _) then validate_expr_usage(subject, false),
    .TypeCast(_, _, _, operand) then validate_expr_usage(operand, false),
    .Paren(_, inner, _) then validate_expr_usage(inner, false),
    .PairExpr(_, first, _, second, _) then {
        validate_expr_usage(first, false) or return;
        return validate_expr_usage(second, false);
    },
    .TraitQualification(_, base, _, _, _) then validate_expr_usage(base, false),
    .FieldAccess(base, _, _) then validate_expr_usage(base, false),
    .QualifiedCall(base, _, _, _, _, _, _, args, _) then {
        validate_expr_usage(base, false) or return;
        return validate_call_args(args);
    },
    .Call(callee, _, args, _) then {
        validate_expr_usage(callee, false) or return;
        return validate_call_args(args);
    },
    .SubscriptExpr(base, _, args, _) then {
        validate_expr_usage(base, false) or return;
        return validate_call_args(args);
    },
    .GenericInst(base, _, _, _) then validate_expr_usage(base, false),
    .ImplicitMember(_, _, _, args, _) then validate_call_args(args),
    .Block(_, items, tail_expr, _) then {
        validate_item_list(items) or return;
        return validate_optional_expr_usage(tail_expr, false);
    },
    .If(_, cond, _, then_body, _, else_body) then {
        validate_expr_usage(cond, false) or return;
        validate_expr_usage(then_body, statement_context) or return;
        return validate_optional_expr_usage(else_body, statement_context);
    },
    .IfPattern(_, subject, _, _, _, then_body, _, else_body) then {
        validate_expr_usage(subject, false) or return;
        validate_expr_usage(then_body, statement_context) or return;
        return validate_optional_expr_usage(else_body, statement_context);
    },
    .While(_, cond, _, body) then {
        validate_expr_usage(cond, false) or return;
        return validate_expr_usage(body, true);
    },
    .WhilePattern(_, subject, _, _, _, body) then {
        validate_expr_usage(subject, false) or return;
        return validate_expr_usage(body, true);
    },
    .For(_, _, _, iterable, _, body) then {
        validate_expr_usage(iterable, false) or return;
        return validate_expr_usage(body, true);
    },
    .When(_, subject, _, _, arms, _) then {
        validate_expr_usage(subject, false) or return;
        for arm in arms then {
            validate_expr_usage(arm.body, statement_context) or return;
        };
        return .Ok({});
    },
    .AndThen(left, _, _, right) or .OrElse(left, _, _, right) then {
        validate_expr_usage(left, false) or return;
        return validate_expr_usage(right, false);
    },
    .OrReturn(left, _, _) then validate_expr_usage(left, false),
    .RangeExpr(left, _, right) then {
        validate_optional_expr_usage(left, false) or return;
        return validate_optional_expr_usage(right, false);
    },
    .EmptyLiteral(_, _) then .Ok({}),
    .CollectionLiteral(_, elements, _) then {
        for element in elements then {
            validate_expr_usage(element.value, false) or return;
        };
        return .Ok({});
    },
    .DictLiteral(_, entries, _) then {
        for entry in entries then {
            validate_expr_usage(entry.key, false) or return;
            validate_expr_usage(entry.value, false) or return;
        };
        return .Ok({});
    },
    .Lambda(_, _, _, _, _, body) then validate_expr_usage(body, false),
};

public let format_source(source String) Result[String] = {
    let mutable tokenizer = Tokenizer.new(source);
    let tokens = tokenizer.tokenize() or return;
    let mutable parser = CstParser.new(tokens);
    let file = parser.parse() or return;
    validate_item_list(file.items) or return;
    let mutable printer = Printer.new();
    printer.print_file(file.items);
    printer.finalize();
    let result = printer.result();
    return Result[String].Ok(result);
};
