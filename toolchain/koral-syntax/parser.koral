// ============================================================================
// Koral Syntax - CST Parser
// ============================================================================
// Builds the CST in cst.koral from a token stream. Structure is parsed fully
// (the printer needs zero spacing inference); comments are kept as items so
// nothing written in a file is dropped by a round trip.
// ============================================================================

// ============================================================================
// CstParser
// ============================================================================

public type mutable CstParser(tokens List[Token], mutable pos UInt);

given CstParser {

    public new(tokens List[Token]) CstParser = CstParser(tokens, 0);

    // ========================================================================
    // Token helpers
    // ========================================================================

    file_private peek(self) Token = {
        let mutable i = self.pos;
        while i < self.tokens.count() then {
            when self.tokens[i] in {
                .Newline() then {
                    i += 1;
                    continue;
                },
                _ then {
                    return self.tokens[i];
                },
            };
        };
        return Token.EOF();
    };

    file_private peek_raw(self) Token = {
        if self.pos >= self.tokens.count() then {
            return .EOF();
        };
        return self.tokens[self.pos];
    };

    file_private advance(self) Token = {
        if self.pos >= self.tokens.count() then {
            return .EOF();
        };
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    };

    file_private skip_newlines(self) Void = {
        while self.pos < self.tokens.count() then {
            when self.tokens[self.pos] in {
                .Newline() then {
                    self.pos += 1;
                },
                _ then {
                    return;
                },
            };
        };
    };

    file_private expected_error(self, expected String) String = {
        let got = self.peek();
        return "Parse error: expected \(expected), got '\(got.to_string())' at token #\(self.pos.to_string())";
    };

    file_private is_eof(self) Bool = self.peek() is .EOF();

    file_private check(self, expected Token) Bool =
        Token.tag(self.peek()) == Token.tag(expected);

    file_private expect(self, expected Token, expected_name String) Result[Token] = {
        if self.check(expected) then {
            return .Ok(self.eat());
        };
        return .Error(self.expected_error(expected_name));
    };

    file_private expect_ident(self, what String) Result[Token] = when self.peek() in {
        .Ident(_) then .Ok(self.eat()),
        _ then .Error(self.expected_error(what)),
    };

    // ── 有界前看：形状归类 ─────────────────────────────────────────────────
    //
    // 与编译器同一套规则：歧义由「形状」决定，不由「试解析、失败再回退」决定。
    // 形状扫描只读 token 缓冲、不建树、不改 `self.pos`，回答一个有界问题：
    // 从某个下标起的 token 串是不是一个类型的形状，到哪里结束。

    /// Whether `i` is in range and the token there can begin a type.
    /// Mirrors `is_type_start`, except that bare `*` is excluded: `f(*p)`
    /// dereferences, it does not cast. Only `*` is a type.
    /// The index of the first token at or after `i` that is not a newline.
    /// The parser's `peek()` skips newlines; the scanner must too, or a
    /// multi-line call argument makes it see `Newline` where the parser sees `(`.
    file_private sig_index_at(self, i UInt) UInt = {
        let mutable j = i;
        while j < self.tokens.count() and self.tokens[j] is .Newline() then {
            j += 1;
        };
        return j;
    };

    /// Whether `i` (after skipping newlines) is in range and the token there
    /// can begin a type. Mirrors `is_type_start`, except that `*` only starts
    /// a type when followed by a type head: `f(*p)` dereferences, it does not
    /// cast.
    file_private token_starts_type_at(self, raw_i UInt) Bool = {
        let i = self.sig_index_at(raw_i);
        if i >= self.tokens.count() then {
            return false;
        };
        return when self.tokens[i] in {
            .KwWeakref() or .KwSelfType() then true,
            .Star() then {
                let n = self.sig_index_at(i + 1);
                n < self.tokens.count() and self.token_is_type_head(self.tokens[n])
            },
            .Ident(name) then self.is_type_start(.Ident(name)),
            _ then false,
        };
    };

    /// Whether a token can start a type head (after `*`).
    /// Type heads are `mutable`, `Self`, and uppercase identifiers.
    file_private token_is_type_head(self, token Token) Bool = {
        return when token in {
            .KwMut() or .KwSelfType() then true,
            .Ident(name) then self.is_type_start(.Ident(name)),
            _ then false,
        };
    };

    /// The index just past one type starting at `start_index`, or `None`.
    file_private scan_type_shape_at(self, raw_start UInt) Option[UInt] = {
        let mutable i = self.sig_index_at(raw_start);
        let mutable more_prefixes = true;
        while more_prefixes then {
            i = self.sig_index_at(i);
            if i >= self.tokens.count() then {
                return Option[UInt].None();
            };
            if self.tokens[i] is .KwWeakref() then {
                i += 1;
            } else if self.tokens[i] is .Star() then {
                let n = self.sig_index_at(i + 1);
                // After `*` a type head OR a parenthesized type may follow:
                // `*Int`, `*mutable Int`, `*(Int)`. A bare `*` before a
                // lowercase pointee (`**p`) is a deref chain, not a type.
                if n >= self.tokens.count() then {
                    more_prefixes = false;
                } else if self.token_is_type_head(self.tokens[n])
                    or self.tokens[n] is .LParen() then {
                    i = n;
                    if i < self.tokens.count() and self.tokens[i] is .KwMut() then {
                        i += 1;
                    };
                } else {
                    more_prefixes = false;
                };
            } else {
                more_prefixes = false;
            };
        };
        i = self.sig_index_at(i);
        if i >= self.tokens.count() then {
            return Option[UInt].None();
        };
        if self.tokens[i] is .KwSelfType() then {
            return Option[UInt].Some(i + 1);
        };
        if self.tokens[i] is .LParen() then {
            // Two shapes open with `(`: the function type
            // `( <type-list> ) "->" <type>`, and the grouping `( <type> )`
            // that holds exactly one type. A type LIST without the `->` is
            // not a type.
            let after_params = self.scan_type_list_at(i) or else {
                return Option[UInt].None();
            };
            let arrow_index = self.sig_index_at(after_params);
            if arrow_index < self.tokens.count() and self.tokens[arrow_index] is .Arrow() then {
                return self.scan_type_shape_at(arrow_index + 1);
            };
            return self.scan_single_type_group_at(i);
        };
        if self.tokens[i] is .Ident(name) then {
            let after_name = self.sig_index_at(i + 1);
            if not self.is_type_start(.Ident(name)) then {
                return Option[UInt].None();
            };
            if after_name < self.tokens.count() and self.tokens[after_name] is .LBracket() then {
                return self.scan_type_list_at(after_name);
            };
            return Option[UInt].Some(after_name);
        };
        return Option[UInt].None();
    };

    /// The index just past a `[` `<type-list>` `]` (or `(` `<type-list>` `)`)
    /// run starting at `start_index`, or `None`.
    file_private scan_type_list_at(self, raw_start UInt) Option[UInt] = {
        let start_index = self.sig_index_at(raw_start);
        if start_index >= self.tokens.count() then {
            return Option[UInt].None();
        };
        let is_bracket_list = self.tokens[start_index] is .LBracket();
        let is_paren_list = self.tokens[start_index] is .LParen();
        if not is_bracket_list and not is_paren_list then {
            return Option[UInt].None();
        };
        let mutable i = start_index + 1;
        let mutable done = false;
        let mutable result = Option[UInt].None();
        while not done then {
            i = self.sig_index_at(i);
            if i >= self.tokens.count() then {
                done = true;
                result = Option[UInt].None();
                continue;
            };
            let token_is_close = if is_bracket_list then self.tokens[i] is .RBracket()
            else self.tokens[i] is .RParen();
            if token_is_close then {
                done = true;
                result = Option[UInt].Some(i + 1);
                continue;
            };
            if self.tokens[i] is .Comma() then {
                i += 1;
                continue;
            };
            let next = self.scan_type_shape_at(i) or else {
                done = true;
                result = Option[UInt].None();
                continue;
            };
            i = next;
        };
        return result;
    };

    /// The index just past a `( <type> )` grouping starting at `start_index`,
    /// or `None`. The contents must be EXACTLY one type that ends at the
    /// closing `)`: an empty `()` is not a type, a trailing comma disqualifies
    /// (`(T,)`), and a type LIST is only a type with the `->` that turns it
    /// into a function type.
    file_private scan_single_type_group_at(self, raw_start UInt) Option[UInt] = {
        let start_index = self.sig_index_at(raw_start);
        if start_index >= self.tokens.count() or self.tokens[start_index] is not .LParen() then {
            return Option[UInt].None();
        };
        let after_open = self.sig_index_at(start_index + 1);
        if after_open >= self.tokens.count() or self.tokens[after_open] is .RParen() then {
            return Option[UInt].None();
        };
        let after_type = self.scan_type_shape_at(after_open) or else {
            return Option[UInt].None();
        };
        let rp_index = self.sig_index_at(after_type);
        if rp_index >= self.tokens.count() or self.tokens[rp_index] is not .RParen() then {
            return Option[UInt].None();
        };
        return Option[UInt].Some(rp_index + 1);
    };

    /// Whether `expr` is written as a TYPE NAME: a bare upper-first identifier
    /// or a generic instantiation of one. That is what lets `Type(expr)` be a
    /// cast rather than an ordinary call.
    file_private expr_is_type_name(self, expr CstExpr) Bool = {
        return when expr in {
            .Ident(tok) then when tok in {
                .Ident(name) then self.is_type_start(.Ident(name)),
                _ then false,
            },
            .GenericInst(base, _, _, _) then self.expr_is_type_name(base),
            _ then false,
        };
    };

    /// The target type of a `Type(expr)` cast, read off the callee when that
    /// callee is written as a type name. `Int(x)` gives `Int`, `Box[T](x)` gives
    /// `Box[T]`. `None` when the expression is not a type name.
    file_private expr_as_cast_type(self, expr CstExpr) Option[CstType] = {
        when expr in {
            .Ident(tok) then {
                when tok in {
                    .Ident(_) then {
                        if self.is_type_start(tok) then {
                            return .Some(CstType.Named(tok));
                        };
                    },
                    _ then {},
                };
            },
            .GenericInst(base, lb, args, rb) then {
                when self.expr_as_cast_type(base) in {
                    .Some(base_type) then {
                        when base_type in {
                            .Named(name_tok) then {
                                return .Some(CstType.Generic(lb, args, rb, name_tok));
                            },
                            _ then {},
                        };
                    },
                    .None() then {},
                };
            },
            _ then {},
        };
        return .None();
    };

    /// Whether `(params) [Type] =>` starts at `start_index`.
    ///
    /// SHAPE, not a trial parse: the tell is a `=>` after the parameter list's
    /// `)`, or after an optional return type written there. Reads the buffer
    /// only. This replaces a trial that parsed the whole lambda (body included)
    /// speculatively and rolled back on any failure.
    file_private shape_is_lambda_at(self, raw_start UInt) Bool = {
        let start_index = self.sig_index_at(raw_start);
        if start_index >= self.tokens.count() then {
            return false;
        };
        if self.tokens[start_index] is not .LParen() then {
            return false;
        };
        let mutable i = self.sig_index_at(start_index + 1);
        if i < self.tokens.count() and self.tokens[i] is .RParen() then {
            return self.lambda_return_clause_follows_at(i + 1);
        };
        // Non-empty parameters: `name [Type] (, name [Type])* ,?`
        while true then {
            i = self.sig_index_at(i);
            if i >= self.tokens.count() then {
                return false;
            };
            if self.tokens[i] is not .Ident(_) then {
                return false;
            };
            i = self.sig_index_at(i + 1);
            if i >= self.tokens.count() then {
                return false;
            };
            // A parameter is `name [Type]`. `name: Type` is a MISTAKEN lambda
            // parameter, and still a lambda: the real parse reports
            // `Lambda parameters use 'name Type', not 'name: Type'`.
            if self.tokens[i] is .Colon() then {
                i = self.sig_index_at(i + 1);
                let after_type = self.scan_type_shape_at(i) or else {
                    return false;
                };
                i = after_type;
            } else if self.tokens[i] is not .Comma() and is not .RParen() then {
                let after_type = self.scan_type_shape_at(i) or else {
                    return false;
                };
                i = after_type;
            };
            i = self.sig_index_at(i);
            if i >= self.tokens.count() then {
                return false;
            };
            if self.tokens[i] is .Comma() then {
                i += 1;
            } else {
                break;
            };
        };
        i = self.sig_index_at(i);
        if i >= self.tokens.count() then {
            return false;
        };
        if self.tokens[i] is not .RParen() then {
            return false;
        };
        return self.lambda_return_clause_follows_at(i + 1);
    };

    /// After a lambda's parameter list: `=>`, or `<type> =>`.
    file_private lambda_return_clause_follows_at(self, raw_start UInt) Bool = {
        let start_index = self.sig_index_at(raw_start);
        if start_index >= self.tokens.count() then {
            return false;
        };
        if self.tokens[start_index] is .FatArrow() then {
            return true;
        };
        let after_type = self.scan_type_shape_at(start_index) or else {
            return false;
        };
        let arrow_index = self.sig_index_at(after_type);
        return arrow_index < self.tokens.count() and self.tokens[arrow_index] is .FatArrow();
    };

    /// The index just past a `( <type> )` suffix starting at `start_index`, or
    /// `None`. This is the SHAPE of the qualification prefix `base(Trait)` of a
    /// composite qualified call -- the prefix is only legal as part of
    /// `base(Trait).method(...)`.
    file_private scan_paren_type_suffix_at(self, raw_start UInt) Option[UInt] = {
        let start_index = self.sig_index_at(raw_start);
        if start_index >= self.tokens.count() then {
            return Option[UInt].None();
        };
        if self.tokens[start_index] is not .LParen() then {
            return Option[UInt].None();
        };
        let after_type = self.scan_type_shape_at(start_index + 1) or else {
            return Option[UInt].None();
        };
        let rp_index = self.sig_index_at(after_type);
        if rp_index >= self.tokens.count() then {
            return Option[UInt].None();
        };
        if self.tokens[rp_index] is not .RParen() then {
            return Option[UInt].None();
        };
        return Option[UInt].Some(rp_index + 1);
    };

    file_private is_type_start(self, t Token) Bool = when t in {
        .Star() or .KwPtr() or .KwWeakref() or .KwSelfType() then true,
        // A function type opens with its parameter list: `(T1, T2) -> R`.
        .LParen() then true,
        .Ident(name) then {
            // `<type-identifier> ::= "_"* [A-Z] ...` (grammar.bnf): leading
            // underscores are allowed, the first letter is not.
            let runes = name.to_runes();
            let mutable idx UInt = 0;
            while idx < runes.count() and runes[idx].to_uint32() == 95 then {
                idx += 1;
            };
            if idx >= runes.count() then {
                return false;
            };
            let first = runes[idx].to_uint32();
            first >= 65 and first <= 90
        },
        _ then false,
    };

    /// Whether the `(` at `raw_start` closes and the next token is `->` -- the
    /// tell of a function type's parameter list `(T1, T2) -> R`. Reads the
    /// buffer with a depth walk; nothing is parsed. The `->` is what separates
    /// a function type from the parenthesized shapes a signature or a value
    /// can write.
    file_private paren_closes_before_arrow_at(self, raw_start UInt) Bool = {
        let start = self.sig_index_at(raw_start);
        if start >= self.tokens.count() or self.tokens[start] is not .LParen() then {
            return false;
        };
        let mutable depth UInt = 0;
        let mutable i = start;
        while i < self.tokens.count() then {
            when self.tokens[i] in {
                .LParen() then {
                    depth += 1;
                },
                .RParen() then {
                    depth -= 1;
                    if depth == 0 then {
                        let after = self.sig_index_at(i + 1);
                        return after < self.tokens.count() and self.tokens[after] is .Arrow();
                    };
                },
                _ then {},
            };
            i += 1;
        };
        return false;
    };

    /// Whether the `(` at `raw_start` opens a TYPE -- the annotation of a
    /// binding (`let f (Int) -> Int = g`, `let p (*Int) = q`) -- rather than a
    /// declaration's parameter list. Two tells, either one is enough:
    /// `)` followed by `->` (a function type), or non-empty contents that scan
    /// as a type list ending exactly at `)` (a grouping `(T)`, or a multi-type
    /// list the type parser will then reject). A signature's parameters start
    /// with `name Type` / `mutable`, never with a bare type head.
    file_private paren_opens_type_at(self, raw_start UInt) Bool = {
        if self.paren_closes_before_arrow_at(raw_start) then {
            return true;
        };
        let start = self.sig_index_at(raw_start);
        if start >= self.tokens.count() or self.tokens[start] is not .LParen() then {
            return false;
        };
        let after_open = self.sig_index_at(start + 1);
        if after_open >= self.tokens.count() or self.tokens[after_open] is .RParen() then {
            // `()` is an empty parameter list, not a type.
            return false;
        };
        return self.scan_type_list_at(start) is .Some(_);
    };

    /// Whether `name` is a value name: lowercase-first after underscores, or
    /// underscore-only. Mirrors the compilers' `is_valid_value_name`.
    file_private is_value_name(self, name String) Bool = {
        let runes = name.to_runes();
        if runes.count() == 0 then {
            return false;
        };
        let mutable idx UInt = 0;
        while idx < runes.count() and runes[idx].to_uint32() == 95 then {
            idx += 1;
        };
        if idx >= runes.count() then {
            return true;
        };
        let first = runes[idx].to_uint32();
        first >= 97 and first <= 122
    };

    file_private eat(self) Token = {
        self.skip_newlines();
        return self.advance();
    };

    /// Every declaration ends with `;` -- top-level or member, whatever it
    /// declares (`grammar.bnf` "Top-level declarations ... must end with `;`").
    /// Never supply one: a formatter that fills in a missing `;` rewrites source
    /// into a shape the compiler will then refuse.
    file_private eat_decl_semi(self) Result[Token] = {
        if self.peek() is not .Semi() then {
            return .Error("Parse error: expected ';' after declaration");
        };
        return .Ok(self.eat());
    };

    /// Close a parsed declaration: collect the comments that trail it before
    /// its terminating `;` -- `let x = 1 /* c */;` -- consume the `;`, then
    /// wrap it. A line comment before the `;` pushes the `;` to its own line.
    file_private finish_decl_item(self, d CstDecl) Result[CstItem] = {
        let mutable comments = List[Token].new();
        while self.peek() is .LineComment(_) or is .BlockComment(_) then {
            comments.push(self.eat());
        };
        when self.eat_decl_semi() in {
            .Ok(_) then {},
            .Error(e) then {
                return .Error(e);
            },
        };
        if comments.count() > 0 then {
            return .Ok(.DeclPreSemi(comments, d));
        };
        return .Ok(.Decl(d));
    };

    /// A list item's separator slot: the comment tokens that trail the item
    /// before its comma -- `a /* c */, b` -- and the comma itself when the
    /// source wrote one. Comments before a closing delimiter arrive here with
    /// no comma and still travel with the item they trail: `f(a /* c */)`.
    /// A formatter may not drop them.
    file_private eat_comma(self) Option[CstComma] = {
        let mutable comments = List[Token].new();
        while self.peek() is .LineComment(_) or is .BlockComment(_) then {
            comments.push(self.eat());
        };
        if self.check(Token.Comma()) then {
            return .Some(CstComma(comments, .Some(self.eat())));
        };
        if comments.count() > 0 then {
            return .Some(CstComma(comments, .None()));
        };
        return .None();
    };

    /// Whether a separator slot actually carries a comma (a slot of comments
    /// alone is the last item's trail before a closing delimiter).
    file_private sep_has_comma(self, sep Option[CstComma]) Bool = {
        return when sep in {
            .Some(s) then s.token is .Some(_),
            .None() then false,
        };
    };

    file_private count_newlines(self) UInt = {
        let mutable count UInt = 0;
        let mutable i = self.pos;
        while i < self.tokens.count() then {
            when self.tokens[i] in {
                .Newline() then {
                    count += 1;
                    i += 1;
                },
                _ then {
                    return count;
                },
            };
        };
        return count;
    };

    file_private peek_at_skip_nl(self, offset UInt) Token = {
        let mutable count UInt = 0;
        let mutable i = self.pos;
        while i < self.tokens.count() then {
            when self.tokens[i] in {
                .Newline() then {
                    i += 1;
                    continue;
                },
                _ then {
                    if count == offset then {
                        return self.tokens[i];
                    };
                    count += 1;
                    i += 1;
                },
            };
        };
        return Token.EOF();
    };

    file_private is_access_mod(self) Bool =
        self.peek() is .KwPublic() or is .KwPrivate() or is .KwProtected() or is .KwProtectedPublic();

    /// Eats one access modifier. Each of the four is a single token, so there is
    /// nothing to merge here -- an older spelling treated `module_private public`
    /// as one modifier and would have rewritten it to `package_private`, silently
    /// turning a rejected program into an accepted one with different visibility.
    file_private eat_vis(self) Option[Token] = {
        if self.is_access_mod() then {
            return .Some(self.eat());
        };
        return .None();
    };

    /// The `foreign` / `intrinsic` qualifiers written immediately after a
    /// declaration's keyword -- `let foreign`, `type foreign`, `given intrinsic`.
    /// They qualify the thing being declared, so they sit in the slot right
    /// after the keyword, the slot `type mutable` and `let mutable` established.
    /// Access modifiers stay in the prefix slot.
    ///
    /// Printing `vis`, then the keyword, then `mods` must reproduce the source
    /// order exactly; nothing is reordered or dropped on the way through the
    /// CST.
    file_private eat_kind_modifiers(self) List[Token] = {
        let mutable mods = List[Token].new();
        while true then {
            if self.check(.KwForeign()) or self.check(.KwIntrinsic()) then {
                mods.push(self.eat());
            } else {
                return mods;
            };
        };
        return mods;
    };

    /// How many leading tokens are access modifiers, before the declaration
    /// keyword. `foreign` / `intrinsic` are not prefix modifiers -- they sit
    /// after the keyword and are read by `eat_kind_modifiers` there.
    file_private modifier_token_count(self) UInt = {
        let mutable offset UInt = 0;
        while true then {
            when self.peek_at_skip_nl(offset) in {
                .KwPublic() or .KwPrivate() or .KwProtected() or .KwProtectedPublic() then {
                    offset += 1;
                },
                _ then {
                    return offset;
                },
            };
        };
        return offset;
    };

    file_private is_code_item(item CstItem) Bool = when item in {
        .Decl(_) or .Stmt(_) or .DeclPreSemi(_, _) or .StmtPreSemi(_, _) then true,
        _ then false,
    };

    file_private last_item_is_code(self, items List[CstItem]) Bool = {
        if items.count() == 0 then {
            return false;
        };
        let prev = items[items.count() - 1];
        return CstParser.is_code_item(prev);
    };

    file_private item_is_using_decl(item CstItem) Bool = when item in {
        .Decl(decl) or .DeclPreSemi(_, decl) then when decl in {
            .Using(_) then true,
            _ then false,
        },
        _ then false,
    };

    file_private item_is_non_using_top_level_code(item CstItem) Bool = when item in {
        .Decl(decl) or .DeclPreSemi(_, decl) then when decl in {
            .Using(_) then false,
            _ then true,
        },
        .Stmt(_) or .StmtPreSemi(_, _) then true,
        _ then false,
    };

    // Newlines carry no meaning for parsing: `peek`/`eat` skip them, and nothing
    // consults them to decide where an expression or statement ends. `;` is the
    // only statement terminator. `count_newlines` below is for layout only.

    // ========================================================================
    // Type parsing
    // ========================================================================

    public parse_type(self) Result[CstType] = {
        return self.parse_type_node();
    };

    /// The parameter list, the closing `)`, and the return type of a function
    /// type whose `(` is already consumed. `arrow_required` is true for the
    /// `(T1, T2) -> R` spelling and false for the legacy `Func(T1, T2) R`
    /// spelling, which carries no arrow at all.
    file_private parse_function_type_tail(
        self,
        lp Token,
        arrow_required Bool,
    ) Result[CstType] = {
        let mutable args = List[CstTypeArg].new();
        while not self.check(.RParen()) and not self.is_eof() then {
            let inner = when self.parse_type_node() in {
                .Ok(parsed_type) then parsed_type,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let comma = self.eat_comma();
            args.push(CstTypeArg(inner, comma));
        };
        let rp = when self.expect(.RParen(), "')'") in {
            .Ok(tok) then tok,
            .Error(e) then {
                return .Error(e);
            },
        };
        if self.check(.Arrow()) then {
            self.eat();
        } else {
            if arrow_required then {
                return .Error("Parse error: expected '->' in function type");
            };
        };
        if not self.is_type_start(self.peek()) then {
            return .Error(
                "Parse error: function type must include a return type, e.g. (Int, String) -> Bool",
            );
        };
        let return_type = when self.parse_type_node() in {
            .Ok(parsed_type) then parsed_type,
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(.Function(lp, args, rp, return_type));
    };

    file_private parse_type_node(self) Result[CstType] = {
        if self.check(.Star()) then {
            let kw = self.eat();
            let mutable mut_kw = Option[Token].None();
            if self.check(.KwMut()) then {
                mut_kw = .Some(self.eat());
            };
            let inner = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let ptr_kw = Token.KwPtr();
            let _ = kw;
            if mut_kw is .Some(mk) then {
                return .Ok(.Mutable(CstType.Ptr(inner, ptr_kw), mk));
            };
            return .Ok(.Ptr(inner, ptr_kw));
        };
        if self.check(.KwWeakref()) then {
            let kw = self.eat();
            // The legacy `?*T` weak spelling is rejected at the type, where the
            // compiler rejects it -- not at the lexer, which would also kill
            // `?*p` in expression position (an upgrade chain).
            if self.check(.Star()) then {
                return .Error(
                    "Parse error: Weak reference syntax is '?T', not legacy '?*T'",
                );
            };
            // `?` takes a type and nothing else: `?mutable T` is not a spelling
            // (weak capability is a `mutable` type-parameter constraint plus
            // `?T`, not a mutable weak reference). `mutable` fails as a type.
            let inner = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.Weakref(inner, kw));
        };

        // Two shapes open with `(`. A function type is `(T1, T2) -> R` -- its
        // parameter list is a TYPE list and the `->` is mandatory. Otherwise
        // the parens are GROUPING and hold exactly one type: `(*Int)`. A type
        // list without `->`, and an empty `()`, are rejected with the grouping
        // message (byte-identical with the compilers).
        if self.check(.LParen()) then {
            if self.paren_closes_before_arrow_at(self.pos) then {
                let lp = self.eat();
                return self.parse_function_type_tail(lp, true);
            };
            let lp = self.eat();
            if self.check(.RParen()) or self.check(.Comma()) then {
                return .Error(
                    "Parse error: A parenthesized type holds exactly one type: write '(T)', or a function type '(A, B) -> R'",
                );
            };
            let inner = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            if self.check(.Comma()) then {
                return .Error(
                    "Parse error: A parenthesized type holds exactly one type: write '(T)', or a function type '(A, B) -> R'",
                );
            };
            let rp = when self.expect(.RParen(), "')'") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            // Keep one paren layer for readability, but collapse duplicate
            // nesting: ((T)) -> (T) -- the same policy as expression `Paren`.
            when inner in {
                .Paren(_, nested, _) then {
                    return .Ok(.Paren(lp, nested, rp));
                },
                _ then {
                    return .Ok(.Paren(lp, inner, rp));
                },
            };
        };

        // Self type
        if self.check(.KwSelfType()) then {
            let kw = self.eat();
            return .Ok(CstType.SelfType(kw));
        };

        // Simple named type
        let name = when self.expect_ident("type name") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        when name in {
            .Ident(n) then {
                let runes = n.to_runes();
                if runes.count() == 0 then {
                    return .Error("Parse error: empty type name");
                } else {
                    // `<type-identifier> ::= "_"* [A-Z] ...` (grammar.bnf):
                    // leading underscores are allowed, the first letter is not.
                    let mutable idx UInt = 0;
                    while idx < runes.count() and runes[idx].to_uint32() == 95 then {
                        idx += 1;
                    };
                    if idx >= runes.count() then {
                        return .Error(
                            "Parse error: type name must start with uppercase, got '\(n)'",
                        );
                    };
                    let first = runes[idx].to_uint32();
                    if first < 65 or first > 90 then {
                        return .Error(
                            "Parse error: type name must start with uppercase, got '\(n)'",
                        );
                    };
                };

            },
            _ then {},
        };
        let mutable t = CstType.Named(name);
        while self.check(.LBracket()) then {
            let lb = self.eat();
            let mutable args = List[CstTypeArg].new();
            while not self.check(.RBracket()) and not self.is_eof() then {
                let inner = when self.parse_type_node() in {
                    .Ok(parsed_type) then parsed_type,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let comma = self.eat_comma();
                args.push(CstTypeArg(inner, comma));
            };
            let rb = when self.expect(.RBracket(), "']'") in {
                .Ok(tok) then tok,
                .Error(e) then {
                    return .Error(e);
                },
            };
            when t in {
                .Named(base) then {
                    t = .Generic(lb, args, rb, base);
                },
                _ then {
                    return .Error(
                        "Parse error: generic arguments require a named base type",
                    );
                },
            };
        };
        return .Ok(t);
    };

    file_private parse_type_suffix(self, base CstType) CstType = {
        return base;
    };

    // ========================================================================
    // Generic parameters: [T Any, U Eq]
    // ========================================================================

    /// `<default-value-literal>`: number, bool, string, rune, `[]`, a bare
    /// range, or `null`. A leading `-` is accepted for numeric literals
    /// (`x: Int = -1`). Never an expression -- `1 + 2` is not a default.
    ///
    /// Rune literals scan as `IntLit` tokens carrying their quoted spelling
    /// (see `scan_char_literal`), so the literal case already covers them.
    file_private parse_default_value(self) Result[Option[CstDefault]] = {
        if not self.check(.Eq()) then {
            return .Ok(.None());
        };
        let eq = self.eat();
        let mutable value_tokens = List[Token].new();
        if self.check(.LBracket()) then {
            value_tokens.push(self.eat());
            if self.check(.RBracket()) then {
                value_tokens.push(self.eat());
            } else {
                return .Error(
                    "Parse error: default value must be an empty collection '[]'",
                );
            };
        } else if self.check(.Minus()) then {
            value_tokens.push(self.eat());
            when self.peek() in {
                .IntLit(_) or .FloatLit(_) then {
                    value_tokens.push(self.eat());
                },
                _ then {
                    return .Error(
                        "Parse error: expected a literal default value (number, bool, string, rune, [], range, or null)",
                    );
                },
            };
        } else {
            if self.peek() is .Range() then {
                return .Error(
                    "Parse error: open ranges are spelled with '...': write '...b', '...<b', or '...'",
                );
            };
            when self.peek() in {
                .IntLit(_) or .FloatLit(_) or .StrLit(_) or .BoolTrue() or .BoolFalse()
                    or .NullLit() or .Ellipsis() then {
                    value_tokens.push(self.eat());
                },
                _ then {
                    return .Error(
                        "Parse error: expected a literal default value (number, bool, string, rune, [], range, or null)",
                    );
                },
            };
        };
        return .Ok(.Some(CstDefault(eq, value_tokens)));
    };

    file_private parse_generic_params(self) Result[Option[CstGenericParams]] = {
        if not self.check(.LBracket()) then {
            return .Ok(.None());
        };
        let lb = when self.expect(.LBracket(), "'['") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let mutable params = List[CstGenericParam].new();
        while not self.check(.RBracket()) and not self.is_eof() then {
            let name = when self.expect_ident("generic parameter name") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let mutable constraints = List[CstType].new();
            // Collect constraints until comma or ]. `mutable` is a type-kind
            // constraint keyword in this position, not a type.
            while not self.check(.Comma()) and not self.check(.RBracket()) and not self.is_eof(
            ) then {
                if self.check(.KwAnd()) then {
                    self.eat();
                    continue;
                };
                if self.check(.KwMut()) then {
                    constraints.push(CstType.ConstraintKeyword(self.eat()));
                    continue;
                };
                if self.check(.KwForeign()) then {
                    constraints.push(CstType.ConstraintKeyword(self.eat()));
                    continue;
                };
                let ct = when self.parse_type_node() in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                constraints.push(ct);
            };
            let comma = self.eat_comma();
            params.push(CstGenericParam(name, constraints, comma));
        };
        let rb = when self.expect(.RBracket(), "']'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(.Some(CstGenericParams(lb, params, rb)));
    };

    // ========================================================================
    // Parameters: (name Type, name2 Type2)
    // ========================================================================

    file_private parse_params(self) Result[List[CstParam]] = {
        let mutable params = List[CstParam].new();
        let mutable first UInt = 1;
        // Positional params must come before named params (grammar.bnf
        // <func-param-list>): a declaration fixes one call shape, so the two
        // kinds may not be interleaved.
        let mutable seen_named = false;
        while not self.check(.RParen()) and not self.is_eof() then {
            // `self` is the only receiver form. `*self` / `*self mutable` are
            // gone with managed refs -- the receiver's mutability follows the
            // type declaration. Matches the compiler's rejection.
            if first == 1 and self.check(.Star()) then {
                return .Error(
                    "Parse error: Invalid receiver parameter syntax: use 'self' only",
                );
            };
            if first == 1 and self.check(.KwSelf()) then {
                let kw = self.eat();
                let comma = self.eat_comma();
                params.push(.SelfParam(kw, .None(), comma));
                first = 0;
                continue;
            };

            let mutable param_mut = Option[Token].None();
            if self.check(.KwMut()) then {
                param_mut = .Some(self.eat());
            };

            let name = when self.expect_ident("parameter name") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };

            let mutable colon = Option[Token].None();
            if self.check(.Colon()) then {
                colon = .Some(self.eat());
                seen_named = true;
            } else if seen_named then {
                return .Error(
                    "Parse error: Positional parameter '\(name.to_string())' cannot appear after named parameters",
                );
            };

            // Parameters must have explicit type annotation.
            if not self.is_type_start(self.peek()) then {
                return .Error(
                    "Parse error: expected parameter type after '\(name.to_string())'",
                );
            };
            let pt = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            // Only named parameters (with a colon) may carry a default.
            if colon is .None() and self.check(.Eq()) then {
                return .Error(
                    "Parse error: Default values are only allowed for named parameters (use 'name: Type = value' syntax)",
                );
            };
            let default_value = when self.parse_default_value() in {
                .Ok(d) then d,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let comma = self.eat_comma();
            params.push(.NamedParam(name, param_mut, colon, pt, default_value, comma));
            first = 0;
        };
        return .Ok(params);
    };

    // ========================================================================
    // Expression parsing — recursive descent with precedence
    // ========================================================================
    // Precedence (low to high):
    //   or
    //   and
    //   or else / or return
    //   and then
    //   not
    //   is / is not
    //   range (.., ..<, <.., <..<)
    //   == != < > <= >=
    //   | (bitwise or)
    //   ^ (bitwise xor)
    //   & (bitwise and)
    //   << >>
    //   + -
    //   * / %
    //   prefix (-, ~, *, &)
    //   postfix (., call, subscript, cast)
    //   primary
    // ========================================================================

    public parse_expr(self) Result[CstExpr] = {
        return self.parse_expr_node();
    };

    // ── flow layer / logical layer ──────────────────────────────────────────
    //
    // `and then` / `or else` / `or return` are ONE layer -- value flow -- and
    // `and` / `or` are another -- boolean logic. Precedence inside a layer is
    // unchanged: `and then` binds tighter than `or else` / `or return`, and
    // `and` binds tighter than `or`. The layers do not mix implicitly.
    // Crossing from one to the other takes parentheses, the way `??` refuses
    // to sit beside `||` in the languages that have it:
    //
    //   `a and (b or else c)`                   -- fine, and means that
    //   `(a and b) or else c`                   -- fine, and means something else
    //   `a and b or else c`                     -- refused: it means neither
    //   `opt and then as v in v == 1 and false` -- refused
    //
    // So the operand is parsed first, and the operator that follows it decides
    // which chain continues. Both chains stop at the other layer's operators
    // and refuse them there instead of guessing a grouping. The rule is the
    // same one the compilers enforce, so a file the formatter accepts is a
    // file the compilers accept.

    file_private parse_expr_node(self) Result[CstExpr] = {
        let operand = self.parse_not() or return;
        return self.parse_layered_tail(operand);
    };

    /// Continue `operand` in whichever layer its next operator belongs to.
    file_private parse_layered_tail(self, operand CstExpr) Result[CstExpr] = {
        if self.starts_flow_chain() then {
            let flowed = self.parse_flow_tail(operand) or return;
            return self.reject_logical_at_flow_layer(flowed);
        };
        if self.starts_logical_chain() then {
            let logical = self.parse_logical_tail(operand) or return;
            return self.reject_flow_at_logical_layer(logical);
        };
        return .Ok(operand);
    };

    /// Whether the operator at the cursor is a flow operator.
    file_private starts_flow_chain(self) Bool = {
        return when self.peek() in {
            .KwAnd() then self.peek_at_skip_nl(1) is .KwThen(),
            .KwOr() then self.peek_at_skip_nl(1) is .KwElse() or is .KwReturn(),
            _ then false,
        };
    };

    /// Whether the operator at the cursor is a logical operator.
    file_private starts_logical_chain(self) Bool = {
        return when self.peek() in {
            .KwAnd() then self.peek_at_skip_nl(1) is not .KwThen(),
            .KwOr() then self.peek_at_skip_nl(1) is not .KwElse() and is not .KwReturn(),
            _ then false,
        };
    };

    // The right operand of one `and then` link. Three shapes:
    //   `.f(x).g`      -- receiver-elided member chain on the unwrapped value
    //   `as v in body` -- explicit binder, body is a layer operand
    //   anything else  -- a plain layer operand (legacy; goes away with `it`)
    //
    // A leading dot here is the chain, never an implicit member.
    file_private parse_and_then_operand(self) Result[CstExpr] = {
        if self.check(.Dot()) then {
            // The leading `.` is consumed by the dot suffix, which the postfix
            // loop runs on the elided receiver.
            let base = CstExpr.FlowReceiver();
            let chain = self.parse_postfix_suffixes(base) or return;
            return .Ok(.FlowChain(chain));
        };
        if self.check(.KwAs()) then {
            return self.parse_flow_bind();
        };
        // No plain-expression form: the unwrapped value has no implicit name.
        return .Error(
            "Parse error: 'and then' takes a '.member()' chain or an 'as name in body' binder -- there is no implicit name",
        );
    };

    // The right operand of `or else`. `as e in body` names the error payload
    // (Result only -- `None` has no payload); anything else is the fallback
    // value itself, where a leading dot stays an implicit member.
    file_private parse_or_else_operand(self) Result[CstExpr] = {
        if self.check(.KwAs()) then {
            return self.parse_flow_bind();
        };
        return self.parse_not();
    };

    // `as name in body`. The body stops at a layer operand, so an `or else`
    // written after it belongs to the enclosing flow chain and the binder's
    // scope stays tight.
    file_private parse_flow_bind(self) Result[CstExpr] = {
        let as_kw = self.eat();
        let name = when self.expect_ident("flow binding name") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        if not self.check(.KwIn()) then {
            return .Error(self.expected_error("'in' after flow binding name"));
        };
        let in_kw = self.eat();
        let body = self.parse_not() or return;
        return .Ok(.FlowBind(as_kw, name, in_kw, body));
    };

    // `and then` binds tightest of the flow operators.
    file_private parse_and_then_chain(self, operand CstExpr) Result[CstExpr] = {
        let mutable left = operand;
        while self.check(.KwAnd()) and self.peek_at_skip_nl(1) is .KwThen() then {
            let and_kw = self.eat();
            let then_kw = self.eat();
            let right = self.parse_and_then_operand() or return;
            left = .AndThen(left, and_kw, then_kw, right);
        };
        return .Ok(left);
    };

    // `or else` / `or return` sit between `and then` and the end of the layer:
    // `f() and then as v in g(v) or else h()` groups as `(f() and then as v in g(v)) or else h()`.
    file_private parse_flow_tail(self, operand CstExpr) Result[CstExpr] = {
        let mutable left = self.parse_and_then_chain(operand) or return;
        while self.check(.KwOr()) then {
            let next = self.peek_at_skip_nl(1);
            when next in {
                .KwElse() then {
                    let or_kw = self.eat();
                    let else_kw = self.eat();
                    let rhs_operand = self.parse_or_else_operand() or return;
                    let right = self.parse_and_then_chain(rhs_operand) or return;
                    left = .OrElse(left, or_kw, else_kw, right);
                },
                .KwReturn() then {
                    let or_kw = self.eat();
                    let ret_kw = self.eat();
                    left = .OrReturn(left, or_kw, ret_kw);
                },
                _ then {
                    break;
                },
            };
        };
        return .Ok(left);
    };

    file_private parse_logical_and_chain(self, operand CstExpr) Result[CstExpr] = {
        let mutable left = operand;
        while self.check(.KwAnd()) and self.peek_at_skip_nl(1) is not .KwThen() then {
            let op = self.eat();
            let right = self.parse_not() or return;
            left = .BinaryOp(left, op, right);
        };
        return .Ok(left);
    };

    file_private parse_logical_tail(self, operand CstExpr) Result[CstExpr] = {
        let mutable left = self.parse_logical_and_chain(operand) or return;
        while self.check(.KwOr()) and self.peek_at_skip_nl(1) is not .KwElse() and is not .KwReturn() then {
            let op = self.eat();
            let rhs_operand = self.parse_not() or return;
            let right = self.parse_logical_and_chain(rhs_operand) or return;
            left = .BinaryOp(left, op, right);
        };
        return .Ok(left);
    };

    /// A logical operator arriving after a flow chain.
    file_private reject_logical_at_flow_layer(self, expr CstExpr) Result[CstExpr] = {
        if self.peek() is .KwAnd() and self.peek_at_skip_nl(1) is not .KwThen() then {
            return .Error(
                "Parse error: 'and' cannot be mixed with the flow operators 'and then' / 'or else' / 'or return' without parentheses",
            );
        };
        if self.peek() is .KwOr() and self.peek_at_skip_nl(1) is not .KwElse() and is not .KwReturn() then {
            return .Error(
                "Parse error: 'or' cannot be mixed with the flow operators 'and then' / 'or else' / 'or return' without parentheses",
            );
        };
        return .Ok(expr);
    };

    /// A flow operator arriving after a logical chain.
    file_private reject_flow_at_logical_layer(self, expr CstExpr) Result[CstExpr] = {
        if self.peek() is .KwAnd() and self.peek_at_skip_nl(1) is .KwThen() then {
            return .Error(
                "Parse error: 'and then' cannot be mixed with logical 'and' / 'or' without parentheses",
            );
        };
        if self.peek() is .KwOr() and self.peek_at_skip_nl(1) is .KwElse() then {
            return .Error(
                "Parse error: 'or else' cannot be mixed with logical 'and' / 'or' without parentheses",
            );
        };
        if self.peek() is .KwOr() and self.peek_at_skip_nl(1) is .KwReturn() then {
            return .Error(
                "Parse error: 'or return' cannot be mixed with logical 'and' / 'or' without parentheses",
            );
        };
        return .Ok(expr);
    };

    file_private parse_single_pattern(self) Result[CstPattern] = {
        return self.parse_primary_pattern();
    };

    file_private parse_is(self) Result[CstExpr] = {
        let left = when self.parse_range() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };

        if not self.check(.KwIs()) then {
            return .Ok(left);
        };

        let is_kw = self.eat();
        let mutable not_kw = Option[Token].None();
        if self.check(.KwNot()) then {
            not_kw = .Some(self.eat());
        };
        let first = when self.parse_single_pattern() in {
            .Ok(p) then p,
            .Error(e) then {
                return .Error(e);
            },
        };
        // `or is` / `and is` continue the same pattern; `or` / `and` alone is
        // the expression operator and ends the chain. The connector is only
        // one when it is followed by `is`.
        let mutable links = List[CstIsLink].new();
        while (self.check(.KwOr()) or self.check(.KwAnd()))
            and self.peek_at_skip_nl(1) is .KwIs()
        then {
            let connector = self.eat();
            let link_is = self.eat();
            let mutable link_not = Option[Token].None();
            if self.check(.KwNot()) then {
                link_not = .Some(self.eat());
            };
            let link_pattern = when self.parse_single_pattern() in {
                .Ok(p) then p,
                .Error(e) then {
                    return .Error(e);
                },
            };
            links.push(CstIsLink(connector, link_is, link_not, link_pattern));
        };
        let pattern = if links.is_empty() then first else CstPattern.IsChain(first, links);
        return .Ok(.IsExpr(left, is_kw, not_kw, pattern));
    };

    file_private parse_not(self) Result[CstExpr] = {
        if self.check(.KwNot()) then {
            let op = self.eat();
            let operand = when self.parse_is() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.NotExpr(op, operand));
        };
        return self.parse_is();
    };

    file_private parse_bitwise_or(self) Result[CstExpr] = {
        let mutable left = when self.parse_bitwise_xor() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        while self.check(.Pipe()) then {
            let op = self.eat();
            let right = when self.parse_bitwise_xor() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            left = .BinaryOp(left, op, right);
        };
        return .Ok(left);
    };

    file_private parse_bitwise_xor(self) Result[CstExpr] = {
        let mutable left = when self.parse_bitwise_and() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        while self.check(.Caret()) then {
            let op = self.eat();
            let right = when self.parse_bitwise_and() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            left = .BinaryOp(left, op, right);
        };
        return .Ok(left);
    };

    file_private parse_bitwise_and(self) Result[CstExpr] = {
        let mutable left = when self.parse_shift() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        while self.check(.Amp()) then {
            let op = self.eat();
            let right = when self.parse_shift() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            left = .BinaryOp(left, op, right);
        };
        return .Ok(left);
    };

    file_private parse_range(self) Result[CstExpr] = {
        // Prefix ranges: `...b`, `...<b`, `...`. `<...` is postfix-only: its
        // `<` hugs the left bound. The `..` family is always closed (both
        // bounds written); a missing bound is spelled with `...`.
        when self.peek() in {
            .Ellipsis() then {
                let op = self.eat();
                if self.can_start_range_bound() then {
                    let right = when self.parse_comparison() in {
                        .Ok(e) then e,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    return .Ok(.RangeExpr(.None(), op, .Some(right)));
                };
                return .Ok(.RangeExpr(.None(), op, .None()));
            },
            .EllipsisLt() then {
                let op = self.eat();
                let right = when self.parse_comparison() in {
                    .Ok(e) then e,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                return .Ok(.RangeExpr(.None(), op, .Some(right)));
            },
            .Range() or .RangeLt() then {
                return .Error(
                    "Parse error: open ranges are spelled with '...': write '...b', '...<b', or '...'",
                );
            },
            .LtEllipsis() then {
                return .Error(
                    "Parse error: '<...' follows a range bound; write 'a<...'",
                );
            },
            _ then {},
        };

        let left = when self.parse_comparison() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };

        when self.peek() in {
            .Range() then {
                let op = self.eat();
                if self.can_start_range_bound() then {
                    let right = when self.parse_comparison() in {
                        .Ok(e) then e,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    return .Ok(.RangeExpr(.Some(left), op, .Some(right)));
                };
                return .Error(
                    "Parse error: open ranges are spelled with '...': write 'a...' or 'a<...'",
                );
            },
            .RangeLt() or .LtRangeLt() then {
                let op = self.eat();
                let right = when self.parse_comparison() in {
                    .Ok(e) then e,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                return .Ok(.RangeExpr(.Some(left), op, .Some(right)));
            },
            .LtRange() then {
                let op = self.eat();
                if self.can_start_range_bound() then {
                    let right = when self.parse_comparison() in {
                        .Ok(e) then e,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    return .Ok(.RangeExpr(.Some(left), op, .Some(right)));
                };
                return .Error(
                    "Parse error: open ranges are spelled with '...': write 'a...' or 'a<...'",
                );
            },
            .Ellipsis() or .LtEllipsis() then {
                let op = self.eat();
                if self.can_start_range_bound() then {
                    return .Error(
                        "Parse error: a '...' range takes at most one bound; write 'a..b' for a closed range",
                    );
                };
                return .Ok(.RangeExpr(.Some(left), op, .None()));
            },
            .EllipsisLt() then {
                return .Error(
                    "Parse error: '...<' opens a range with no left bound; write '...<b'",
                );
            },
            _ then {
                return .Ok(left);
            },
        };
    };

    file_private can_start_range_bound(self) Bool = when self.peek() in {
        .KwIf() or .KwWhile() or .KwWhen() or .KwFor() then true,
        .Minus() or .Tilde() or .Amp() or .Star() then true,
        .Ident(_) or .KwSelf() or .KwSelfType() or .IntLit(_) or .FloatLit(_) or .StrLit(_) or .InterpStr(_) or .BoolTrue() or .BoolFalse() or .NullLit() then true,
        .LBrace() or .LParen() or .LBracket() or .Dot() then true,
        _ then false,
    };

    file_private parse_comparison(self) Result[CstExpr] = {
        let mutable left = when self.parse_bitwise_or() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        while true then {
            when self.peek() in {
                .EqEq() or .NotEq() or .Gt() or .Lt() or .GtEq() or .LtEq() then {
                    let op = self.eat();
                    let right = when self.parse_bitwise_or() in {
                        .Ok(e) then e,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    left = .BinaryOp(left, op, right);
                },
                _ then {
                    break;
                },
            };
        };
        return .Ok(left);
    };

    file_private parse_shift(self) Result[CstExpr] = {
        let mutable left = when self.parse_additive() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        while true then {
            when self.peek() in {
                .LShift() or .RShift() then {
                    let op = self.eat();
                    let right = when self.parse_additive() in {
                        .Ok(e) then e,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    left = .BinaryOp(left, op, right);
                },
                _ then {
                    break;
                },
            };
        };
        return .Ok(left);
    };

    file_private parse_additive(self) Result[CstExpr] = {
        let mutable left = when self.parse_multiplicative() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        while true then {
            when self.peek() in {
                .Plus() then {
                    let op = self.eat();
                    let right = when self.parse_multiplicative() in {
                        .Ok(e) then e,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    left = .BinaryOp(left, op, right);
                },
                .Minus() then {
                    let op = self.eat();
                    let right = when self.parse_multiplicative() in {
                        .Ok(e) then e,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    left = .BinaryOp(left, op, right);
                },
                _ then {
                    break;
                },
            };
        };
        return .Ok(left);
    };

    file_private parse_multiplicative(self) Result[CstExpr] = {
        let mutable left = when self.parse_cast() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        while true then {
            when self.peek() in {
                .Star() or .Slash() or .Percent() then {
                    let op = self.eat();
                    let right = when self.parse_cast() in {
                        .Ok(e) then e,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    left = .BinaryOp(left, op, right);
                },
                _ then {
                    break;
                },
            };
        };
        return .Ok(left);
    };

    // ========================================================================
    // Cast expressions
    // ========================================================================

    /// `expr as Type` -- pointer reinterpretation and weak construction,
    /// left-associative and sitting between the multiplicative level and the
    /// prefix level (Rust's `as` position):
    ///
    ///   `&x as *T`       == `(&x) as *T`
    ///   `*p as *Int`     == `(*p) as *Int`
    ///   `p * q as *T`    == `p * (q as *T)`
    ///   `p as *Int == q` == `(p as *Int) == q`
    ///
    /// `as` takes a full `<type>`: `*T`, `*mutable T`, `?T`, `Trait[Int]`,
    /// an alias. The cast result takes no postfix suffixes -- a method call on
    /// one takes parentheses, `(self as *T).equals(...)`, and `x as *T.m()`
    /// leaves `.m()` a stray token.
    file_private parse_cast(self) Result[CstExpr] = {
        let mutable left = when self.parse_prefix() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        while self.check(.KwAs()) then {
            let as_kw = self.eat();
            let cast_type = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            left = .AsCast(left, as_kw, cast_type);
        };
        return .Ok(left);
    };

    // ========================================================================
    // Prefix expressions
    // ========================================================================

    file_private parse_prefix(self) Result[CstExpr] = {
        let mutable leading_comments = List[Token].new();
        while self.peek() is .LineComment(_) or is .BlockComment(_) or is .Semi() then {
            if self.peek() is .Semi() then {
                let ignored_semi = self.eat();
            } else {
                leading_comments.push(self.eat());
            };
        };

        if leading_comments.count() > 0 then {
            let inner = when self.parse_prefix() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.Commented(leading_comments, inner));
        };

        // Unary minus
        if self.check(.Minus()) then {
            let op = self.eat();
            // Check for negative literal
            when self.peek() in {
                .IntLit(_) then {
                    let lit = self.eat();
                    return .Ok(.UnaryMinus(op, CstExpr.IntLit(lit)));
                },
                .FloatLit(_) then {
                    let lit = self.eat();
                    return .Ok(.UnaryMinus(op, CstExpr.FloatLit(lit)));
                },
                _ then {
                    let operand = when self.parse_prefix() in {
                        .Ok(e) then e,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    return .Ok(.UnaryMinus(op, operand));
                },
            };
        };

        // Bitwise not
        if self.check(.Tilde()) then {
            let op = self.eat();
            let operand = when self.parse_prefix() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.BitwiseNot(op, operand));
        };

        // A leading `*` is ALWAYS the dereference operator -- it never opens a
        // cast shape. `*Int(q)` parses as `*(Int(q))`, an operator chain over
        // the call; bare `*Int` is a deref chain over a type-as-value (the
        // compilers reject that one at sema). Pointer casts are written
        // `expr as *T`.
        if self.check(.Star()) then {
            let op = self.eat();
            let operand = when self.parse_prefix() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.Deref(op, operand));
        };

        // A leading `?` is ALWAYS the weak-upgrade operator (`?expr` upgrades
        // a weak reference to `Option[T]`). `?T(x)` parses as `?(T(x))`; bare
        // `?T` is an upgrade chain over a type-as-value. Weak construction is
        // written `expr as ?T`.
        if self.check(.KwWeakref()) then {
            let op = self.eat();
            let operand = when self.parse_prefix() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.Upgrade(op, operand));
        };

        // Address-of: &expr, &mutable expr
        if self.check(.Amp()) then {
            let op = self.eat();
            let mutable mut_kw = Option[Token].None();
            if self.check(.KwMut()) then {
                mut_kw = .Some(self.eat());
            };
            let operand = when self.parse_prefix() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.AddressOf(op, mut_kw, operand));
        };

        return self.parse_postfix();
    };

    // ========================================================================
    // Postfix expressions
    // ========================================================================

    /// The composite `base(Trait).method(...)` /
    /// `base(Trait).method[TypeArgs](...)` qualified call. The `(Trait)` SHAPE
    /// has already been decided by `scan_paren_type_suffix_at`; this consumes
    /// the qualification AND the method call, so the prefix never exists on its
    /// own. `base` is a type name for the type-qualified form
    /// `Type(Trait).method`, and any other expression for the receiver-qualified
    /// form `expr(Trait).method`. The result is the full
    /// `Call(FieldAccess(QualifiedTrait(...), method), args)`.
    file_private parse_qualified_call_suffix(self, base CstExpr) Result[CstExpr] = {
        let lp = self.eat();
        let trait_type = self.parse_type_node() or return;
        let rp = when self.expect(.RParen(), "')'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        if not self.check(.Dot()) then {
            return .Error(
                "Parse error: A qualified call must include its method call: write 'base(Trait).method(...)'. Casts are written 'Type(expr)' or 'expr as Type', not 'expr(Type)'",
            );
        };
        let dot = self.eat();
        let method = when self.expect_ident("qualified method name") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let mutable field = CstExpr.FieldAccess(
            .QualifiedTrait(lp, trait_type, rp, base),
            dot,
            method,
        );
        // Generic method call: `base(Trait).method[TypeArgs](...)`.
        if self.check(.LBracket()) and self.scan_type_list_at(self.pos) is .Some(_) then {
            let lb = self.eat();
            let mutable type_args = List[CstTypeArg].new();
            while not self.check(.RBracket()) and not self.is_eof() then {
                let t = when self.parse_type_node() in {
                    .Ok(parsed_type) then parsed_type,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let comma = self.eat_comma();
                type_args.push(CstTypeArg(t, comma));
            };
            let rb = when self.expect(.RBracket(), "']'") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            field = .GenericInst(field, lb, type_args, rb);
        };
        if not self.check(.LParen()) then {
            return .Error(
                "Parse error: A qualified call must include its method call: write 'base(Trait).method(...)'. Casts are written 'Type(expr)' or 'expr as Type', not 'expr(Type)'",
            );
        };
        let call_lp = self.eat();
        let args = when self.parse_call_args() in {
            .Ok(a) then a,
            .Error(e) then {
                return .Error(e);
            },
        };
        let call_rp = when self.expect(.RParen(), "')'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(.Call(field, call_lp, args, call_rp));
    };

    file_private parse_postfix(self) Result[CstExpr] = {
        let expr = when self.parse_primary() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        return self.parse_postfix_suffixes(expr);
    };

    /// Postfix suffixes (calls, subscripts, member access, qualified calls)
    /// applied to an already-parsed expression.
    file_private parse_postfix_suffixes(self, start CstExpr) Result[CstExpr] = {
        let mutable expr = start;
        while true then {
            // Field access: expr.field
            if self.check(.Dot()) then {
                let dot = self.eat();

                let field = when self.expect_ident("field name") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                // Check for method call: expr.field(args)
                if self.check(.LParen()) then {
                    let field_expr = CstExpr.FieldAccess(expr, dot, field);
                    let lp = self.eat();
                    let args = when self.parse_call_args() in {
                        .Ok(a) then a,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    let rp = when self.expect(.RParen(), "')'") in {
                        .Ok(t) then t,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    expr = .Call(field_expr, lp, args, rp);
                    continue;
                };
                expr = .FieldAccess(expr, dot, field);
                continue;
            };

            // One bounded shape scan decides what `(` opens.
            //
            // `( <type> )` is the qualification prefix of a composite qualified
            // call `base(Trait).method(...)` -- the method call is parsed here
            // too, so the prefix never stands alone. Anything else is a call,
            // which includes the type application `Type(expr)` / `Type(args)`:
            // a TYPE NAME callee with a single positional operand is the cast
            // spelling `Type(expr)`, and every other argument shape is a
            // construction or ordinary call. Nothing is parsed speculatively
            // and rolled back.
            if self.check(.LParen()) then {
                if self.scan_paren_type_suffix_at(self.pos) is .Some(_) then {
                    expr = self.parse_qualified_call_suffix(expr) or return;
                    continue;
                };
                let call_lp = self.eat();
                let args = when self.parse_call_args() in {
                    .Ok(a) then a,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let rp = when self.expect(.RParen(), "')'") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                // `Type(expr)` -- one positional operand -- is the cast
                // spelling. `Type(a, b)`, `Type(x: 1)`, `Type()` are
                // constructions and keep the call shape.
                if self.expr_is_type_name(expr) and args.count() == 1 then {
                    let mutable is_cast = false;
                    let mutable operand = expr;
                    // `CstCallArg` has one case, so the destructure covers
                    // every argument -- there is no fallback arm to write.
                    when args[0] in {
                        .Value(label, colon, value, _) then {
                            if label is .None() and colon is .None() then {
                                is_cast = true;
                                operand = value;
                            };
                        },
                    };
                    if is_cast and self.expr_as_cast_type(expr) is .Some(cast_type) then {
                        expr = .TypeCast(call_lp, cast_type, rp, operand);
                        continue;
                    };
                };
                expr = .Call(expr, call_lp, args, rp);
                continue;
            };

            // Generic instantiation suffix: expr[T]
            if self.check(.LBracket()) then {
                // `[` `<type-list>` `]` is a generic application; anything else
                // is a subscript. One bounded scan of the bracketed run decides
                // -- so `s[UInt(0)]` is a subscript whose index is a cast, not
                // a generic application with a stray `(`.
                if self.scan_type_list_at(self.pos) is .Some(_) then {
                    // `.member[T]` alone is not a generic instantiation: the
                    // compilers require the call parens that follow the type
                    // arguments (`'(' after generic method name`).
                    when expr in {
                        .FieldAccess(_, _, _) then {
                            when self.scan_type_list_at(self.pos) in {
                                .Some(next_idx) then {
                                    let after = self.sig_index_at(next_idx);
                                    if after >= self.tokens.count() or self.tokens[
                                        after
                                    ] is not .LParen() then {
                                        return .Error(
                                            "Parse error: Unexpected token: [, expected: '(' after generic method name",
                                        );
                                    };
                                },
                                .None() then {},
                            };
                        },
                        _ then {},
                    };
                    let lb = self.eat();
                    let mutable type_args = List[CstTypeArg].new();
                    while not self.check(.RBracket()) and not self.is_eof() then {
                        let t = when self.parse_type_node() in {
                            .Ok(parsed_type) then parsed_type,
                            .Error(e) then {
                                return .Error(e);
                            },
                        };
                        let comma = self.eat_comma();
                        type_args.push(CstTypeArg(t, comma));
                    };
                    let rb = when self.expect(.RBracket(), "']'") in {
                        .Ok(t) then t,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    expr = .GenericInst(expr, lb, type_args, rb);
                    continue;
                };

                // Subscript: expr[index]. A subscript takes exactly one index
                // and no trailing comma -- `x[i,]` is a syntax error the
                // compiler rejects with "Subscript expression supports exactly
                // one index". Parsing it leniently here would let a rewrite emit
                // it and never notice.
                let lb = self.eat();
                let mutable args = List[CstCallArg].new();
                while not self.check(.RBracket()) and not self.is_eof() then {
                    let value = when self.parse_expr_node() in {
                        .Ok(e) then e,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    let comma = self.eat_comma();
                    args.push(.Value(.None(), .None(), value, comma));
                };
                let rb = when self.expect(.RBracket(), "']'") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                if args.count() > 1 then {
                    return .Error(
                        "Parse error: Subscript expression supports exactly one index",
                    );
                };
                if args.count() == 1 then {
                    // One case again: the destructure is total.
                    when args[0] in {
                        .Value(_, _, _, comma) then {
                            if comma is .Some(_) then {
                                return .Error(
                                    "Parse error: Subscript expression supports exactly one index",
                                );
                            };
                        },
                    };
                };
                expr = .SubscriptExpr(expr, lb, args, rb);
                continue;
            };

            break;
        };
        return .Ok(expr);
    };

    file_private parse_call_args(self) Result[List[CstCallArg]] = {
        let mutable args = List[CstCallArg].new();
        // Positional arguments must not appear after named arguments
        // (grammar.bnf <argument-list>).
        let mutable seen_named = false;
        while not self.check(.RParen()) and not self.is_eof() then {
            if self.check(.Semi()) then {
                self.eat();
                continue;
            };
            let mutable leading_comments = List[Token].new();
            while self.peek() is .LineComment(_) or is .BlockComment(_) then {
                leading_comments.push(self.eat());
            };
            let before = self.pos;
            let mutable label = Option[Token].None();
            let mutable colon = Option[Token].None();
            if self.peek() is .Ident(_) and self.peek_at_skip_nl(1) is .Colon() then {
                label = .Some(self.eat());
                colon = .Some(self.eat());
                seen_named = true;
            } else if seen_named then {
                return .Error(
                    "Parse error: Positional arguments are not allowed after named arguments",
                );
            };
            let mutable value = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            if leading_comments.count() > 0 then {
                value = .Commented(leading_comments, value);
            };
            let comma = self.eat_comma();
            args.push(.Value(label, colon, value, comma));
            if self.pos == before then {
                return .Error("Parse error: parser made no progress in argument list");
            };
        };
        return .Ok(args);
    };

    // ========================================================================
    // Primary expressions
    // ========================================================================

    file_private parse_primary(self) Result[CstExpr] = {
        when self.peek() in {
            .KwIf() then {
                return self.parse_if_expr();
            },
            .KwWhile() then {
                return self.parse_while_expr();
            },
            .KwFor() then {
                return self.parse_for_expr();
            },
            .KwWhen() then {
                return self.parse_when_expr();
            },
            _ then {},
        };

        when self.peek() in {
            .IntLit(_) then {
                return .Ok(.IntLit(self.eat()));
            },
            .FloatLit(_) then {
                return .Ok(.FloatLit(self.eat()));
            },
            .StrLit(_) then {
                return .Ok(.StrLit(self.eat()));
            },
            .InterpStr(_) then {
                return .Ok(.InterpStr(self.eat()));
            },
            .BoolTrue() or .BoolFalse() then {
                return .Ok(.BoolLit(self.eat()));
            },
            .NullLit() then {
                return .Ok(.NullLit(self.eat()));
            },
            .KwSelf() then {
                return .Ok(.SelfExpr(self.eat()));
            },
            .Underscore() then {
                return .Ok(.UnderscoreExpr(self.eat()));
            },
            _ then {},
        };

        // Identifier
        if self.peek() is .Ident(_) then {
            return .Ok(.Ident(self.eat()));
        };

        // Block: { ... }
        if self.check(.LBrace()) then {
            return self.parse_block_expr();
        };

        // Parenthesized expression or lambda
        if self.check(.LParen()) then {
            return self.parse_paren_or_lambda();
        };

        // Collection literals: [] / [a, b] / [key: value]
        if self.check(.LBracket()) then {
            return self.parse_collection_literal();
        };

        // Implicit member: .Name or .Name(args)
        if self.check(.Dot()) then {
            let dot = self.eat();
            let name = when self.expect_ident("member name") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            if self.check(.LParen()) then {
                let lp = self.eat();
                let args = when self.parse_call_args() in {
                    .Ok(a) then a,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let rp = when self.expect(.RParen(), "')'") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                return .Ok(.ImplicitMember(dot, name, .Some(lp), args, .Some(rp)));
            };
            return .Ok(
                .ImplicitMember(dot, name, .None(), List[CstCallArg].new(), .None()),
            );
        };

        // `Self` is a TYPE, not an expression. The compilers' primary
        // expression parser has no case for it -- `Self(1)`, `Self`, and
        // `f(Self)` are all refused there -- so this refuses it too. `Self`
        // stays legal in type position (`* Self(p)`, `let x Self`, ...).
        if self.check(.KwSelfType()) then {
            return .Error(
                "Parse error: 'Self' is a type and cannot be used as an expression",
            );
        };

        // Invalid primary token
        let got = self.peek();
        when got in {
            .RParen() or .RBracket() or .RBrace() or .Comma() or .Semi() then {
                return .Error(
                    "Parse error: expected primary expression, got '\(got.to_string())' at token #\(self.pos.to_string())",
                );
            },
            _ then {},
        };
        return .Error(
            "Parse error: expected primary expression, got '\(got.to_string())' at token #\(self.pos.to_string())",
        );
    };

    file_private parse_collection_literal(self) Result[CstExpr] = {
        let lb = when self.expect(.LBracket(), "'['") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };

        if self.check(.RBracket()) then {
            let rb = when self.expect(.RBracket(), "']'") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.EmptyLiteral(lb, rb));
        };

        let first = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };

        if self.check(.Colon()) then {
            let mutable entries = List[CstDictEntry].new();
            let first_colon = self.eat();
            let first_value = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let first_comma = self.eat_comma();
            entries.push(CstDictEntry(first, first_colon, first_value, first_comma));

            while not self.check(.RBracket()) and not self.is_eof() then {
                let key = when self.parse_expr_node() in {
                    .Ok(e) then e,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let colon = when self.expect(.Colon(), "':'") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let value = when self.parse_expr_node() in {
                    .Ok(e) then e,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let comma = self.eat_comma();
                entries.push(CstDictEntry(key, colon, value, comma));
            };

            let rb = when self.expect(.RBracket(), "']'") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.DictLiteral(lb, entries, rb));
        };

        let mutable elements = List[CstCollectionElement].new();
        let first_comma = self.eat_comma();
        elements.push(CstCollectionElement(first, first_comma));
        while not self.check(.RBracket()) and not self.is_eof() then {
            let element = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let comma = self.eat_comma();
            elements.push(CstCollectionElement(element, comma));
        };

        let rb = when self.expect(.RBracket(), "']'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(.CollectionLiteral(lb, elements, rb));
    };

    // ========================================================================
    // Block expression: { statements [tail-expression] }
    // ========================================================================

    file_private parse_block_expr(self) Result[CstExpr] = {
        let lb = when self.expect(.LBrace(), "'{'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let mutable items = List[CstItem].new();
        let mutable tail_expr = Option[CstExpr].None();
        let mutable tail_comments = List[Token].new();
        while not self.check(.RBrace()) and not self.is_eof() then {
            let nl_count = self.count_newlines();
            if nl_count >= 2 then {
                self.skip_newlines();
                items.push(CstItem.BlankLine());
                continue;
            };
            self.skip_newlines();
            if self.check(.RBrace()) or self.is_eof() then {
                break;
            };
            if self.peek() is .LineComment(_) or is .BlockComment(_) then {
                let c = self.eat();
                let prev_is_code = self.last_item_is_code(items);
                if nl_count == 0 and prev_is_code then {
                    items.push(CstItem.TrailingComment(c));
                } else {
                    items.push(CstItem.Comment(c));
                };
                continue;
            };
            when self.parse_block_item() in {
                .Ok(item) then {
                    // Comments may trail the expression before the block's
                    // `}` -- `v // note` as the tail -- and ride the item.
                    let mutable pre_semi = List[Token].new();
                    let mutable stmt = Option[CstStmt].None();
                    when item in {
                        .Stmt(s) then {
                            stmt = .Some(s);
                        },
                        .StmtPreSemi(comments, s) then {
                            pre_semi = comments;
                            stmt = .Some(s);
                        },
                        _ then {},
                    };
                    when stmt in {
                        .Some(s) then {
                            when s in {
                                .ExprStmt(expr, semi) then {
                                    // A bare expression is the block's tail
                                    // expression and must be last. Anything
                                    // after it needs a `;` on the earlier one;
                                    // the compiler reports `expected: '}'` here.
                                    // Never supply that `;` -- it would turn a
                                    // tail expression into a statement.
                                    if semi is .None() then {
                                        if self.check(.RBrace()) then {
                                            tail_expr = .Some(expr);
                                            tail_comments = pre_semi;
                                        } else {
                                            return .Error(
                                                "Parse error: expected ';' after expression statement",
                                            );
                                        };
                                    } else {
                                        items.push(item);
                                    };
                                },
                                _ then {
                                    items.push(item);
                                },
                            };
                        },
                        .None() then {
                            items.push(item);
                        },
                    };
                },
                .Error(e) then {
                    return .Error(e);
                },
            };
            if tail_expr is .Some(_) then {
                break;
            };
        };
        let rb = when self.expect(.RBrace(), "'}'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(.Block(lb, items, tail_expr, tail_comments, rb));
    };

    file_private parse_block_item(self) Result[CstItem] = {
        // Variable declaration: let [mutable] name [Type] = expr
        if self.peek() is .KwLet() then {
            return self.parse_var_decl_stmt();
        };
        // Statement
        return self.parse_stmt();
    };

    // ========================================================================
    // Parenthesized expression or lambda
    // ========================================================================

    /// A type read as a VALUE -- the inner of a parenthesized type head `(T)`.
    /// Named types and the `*` / `?` prefixes map onto the ordinary expression
    /// nodes: bare `*Int` is already a deref chain over the type-as-value, and
    /// `(*Foo).f()` just groups the same chain. A function type has no
    /// expression spelling at all, so it travels as one opaque token whose
    /// text is the type itself -- the round trip is the contract, and the
    /// compilers reject these at sema anyway.
    file_private type_as_expr(self, t CstType) CstExpr = when t in {
        .Named(name) then .Ident(name),
        .SelfType(kw) then .SelfExpr(kw),
        .Generic(lb, args, rb, base) then .GenericInst(.Ident(base), lb, args, rb),
        .Ptr(inner, kw) then .Deref(kw, self.type_as_expr(inner)),
        .Weakref(inner, kw) then .Upgrade(kw, self.type_as_expr(inner)),
        .Mutable(inner, kw) then when inner in {
            // `*mutable T` prints star-mut-space-name; mirror that shape.
            .Ptr(ptr_inner, ptr_kw) then .Deref(
                ptr_kw,
                .PrefixKw(kw, self.type_as_expr(ptr_inner)),
            ),
            _ then .PrefixKw(kw, self.type_as_expr(inner)),
        },
        .Paren(lp, inner, rp) then .Paren(lp, self.type_as_expr(inner), rp),
        .ConstraintKeyword(kw) then .Ident(kw),
        .Function(_, _, _, _) then .Ident(Token.Ident(type_to_string(t))),
    };

    file_private parse_paren_or_lambda(self) Result[CstExpr] = {
        // `(` opens a lambda, a parenthesized TYPE head, or a parenthesized
        // expression. The shape classifier decides BEFORE anything is built --
        // a lambda is `(params) [Type] => ...`, so the `=>` is the tell; a type
        // head is `( <one type> )` -- and then the chosen alternative is
        // parsed for real. No trial to roll back.
        if self.shape_is_lambda_at(self.pos) then {
            let lambda_expr = self.parse_lambda_node() or return;
            return .Ok(lambda_expr);
        };
        // Type head: `(T)` is a type-as-value primary that takes postfix
        // suffixes like any other -- `(Point)(1, 2)` a cast, `(Point).origin()`
        // a call, bare `(T)` a primary the compilers reject at sema. The
        // contents must be exactly one type that ends at the `)`; a trailing
        // comma disqualifies and falls through to the pair-literal error.
        if self.scan_single_type_group_at(self.pos) is .Some(_) then {
            let lp = when self.expect(.LParen(), "'('") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let inner_type = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let rp = when self.expect(.RParen(), "')'") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let inner = self.type_as_expr(inner_type);
            // Keep one paren layer for readability, but collapse duplicate
            // nesting: ((T)) -> (T)
            when inner in {
                .Paren(_, nested, _) then {
                    return .Ok(.Paren(lp, nested, rp));
                },
                _ then {
                    return .Ok(.Paren(lp, inner, rp));
                },
            };
        };
        // Parenthesized expression
        let lp = when self.expect(.LParen(), "'('") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        if self.check(.RParen()) then {
            when self.expect(.RParen(), "')'") in {
                .Ok(_) then {},
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.Ident(.Ident("()")));
        };
        let inner = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        if self.check(.Comma()) then {
            // There is no tuple/pair literal. A `Pair` is built with its own
            // constructor, like any other type.
            return .Error(
                "Parse error: A pair literal is not an expression: construct a Pair with 'Pair(first, second)'",
            );
        };
        let rp = when self.expect(.RParen(), "')'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };

        // Keep one paren layer for readability, but collapse duplicate nesting:
        // ((x)) -> (x)
        when inner in {
            .Paren(_, nested, _) then {
                return .Ok(.Paren(lp, nested, rp));
            },
            _ then {
                return .Ok(.Paren(lp, inner, rp));
            },
        };
    };

    /// Parses a lambda whose SHAPE `shape_is_lambda_at` has already confirmed.
    /// Errors are real errors -- there is no alternative to fall back to.
    file_private parse_lambda_node(self) Result[CstExpr] = {
        let lp = when self.expect(.LParen(), "'('") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let mutable params = List[CstLambdaParam].new();
        while not self.check(.RParen()) and not self.is_eof() then {
            let name = when self.expect_ident("lambda parameter") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let mutable pt = Option[CstType].None();
            if not self.check(.Comma()) and not self.check(.RParen()) then {
                let t = when self.parse_type_node() in {
                    .Ok(parsed_type) then parsed_type,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                pt = .Some(t);
            };
            let comma = self.eat_comma();
            params.push(CstLambdaParam(name, pt, comma));
        };
        let rp = when self.expect(.RParen(), "')'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };

        // Optional return type
        let mutable ret = Option[CstType].None();
        if not self.check(.FatArrow()) then {
            let t = when self.parse_type_node() in {
                .Ok(parsed_type) then parsed_type,
                .Error(e) then {
                    return .Error(e);
                },
            };
            ret = .Some(t);
        };

        // `=>` introduces the body.
        if not self.check(.FatArrow()) then {
            return .Error("Parse error: expected '=>' in lambda expression");
        };
        let arrow = self.eat();
        let body = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(.Lambda(lp, params, rp, ret, arrow, body));
    };

    // ========================================================================
    // Control flow expressions
    // ========================================================================

    file_private parse_if_expr(self) Result[CstExpr] = {
        let kw = when self.expect(.KwIf(), "'if'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let cond = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };

        let then_kw = when self.expect(.KwThen(), "'then'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let then_body = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        if self.check(.KwElse()) then {
            let else_kw = self.eat();
            let else_body = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(
                .If(kw, cond, then_kw, then_body, .Some(else_kw), .Some(else_body)),
            );
        };
        return .Ok(.If(kw, cond, then_kw, then_body, .None(), .None()));
    };

    file_private parse_while_expr(self) Result[CstExpr] = {
        let kw = when self.expect(.KwWhile(), "'while'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let cond = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };

        let then_kw = when self.expect(.KwThen(), "'then'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let body = if self.check(.LBrace()) then {
            when self.parse_block_expr() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            }
        } else {
            when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            }
        };
        return .Ok(.While(kw, cond, then_kw, body));
    };

    /// `for <match-pattern> "in" <expression> ("where" <expression>)? "then" <body>`
    ///
    /// The binding is a full match pattern -- the same one a `when` arm takes.
    /// The CST records what was written; whether the pattern can fail is the
    /// compiler's call, not this parser's.
    file_private parse_for_expr(self) Result[CstExpr] = {
        let kw = when self.expect(.KwFor(), "'for'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let binding = when self.parse_pattern_node() in {
            .Ok(p) then p,
            .Error(e) then {
                return .Error(e);
            },
        };
        let in_kw = when self.expect(.KwIn(), "'in'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let iterable = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        // Optional guard: `for p in xs where cond then body`. It sits after the
        // iterable, right before `then`, the same slot a `when` arm guard takes
        // before its `then`.
        let mutable where_kw = Option[Token].None();
        let mutable guard = Option[CstExpr].None();
        if self.check(.KwWhere()) then {
            where_kw = .Some(self.eat());
            let guard_expr = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            guard = .Some(guard_expr);
        } else if self.check(.KwIf()) then {
            // The retired guard spelling, and the one a reader coming from
            // `when` arms reaches for first. Falling through would report
            // "expected 'then'", which is true but never names the mistake.
            return .Error("Pattern guards use 'where', not 'if'");
        };
        let then_kw = when self.expect(.KwThen(), "'then'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let body = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(.For(kw, binding, in_kw, iterable, where_kw, guard, then_kw, body));
    };

    file_private parse_when_expr(self) Result[CstExpr] = {
        let kw = when self.expect(.KwWhen(), "'when'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let subject = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        let in_kw = when self.expect(.KwIn(), "'in'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };

        let lb = when self.expect(.LBrace(), "'{'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let mutable arms = List[CstWhenArm].new();
        while not self.check(.RBrace()) and not self.is_eof() then {
            self.skip_newlines();
            if self.check(.RBrace()) or self.is_eof() then {
                break;
            };
            let mutable leading_comments = List[Token].new();
            while self.peek() is .LineComment(_) or is .BlockComment(_) then {
                leading_comments.push(self.eat());
                self.skip_newlines();
                if self.check(.RBrace()) or self.is_eof() then {
                    break;
                };
            };
            if self.check(.RBrace()) or self.is_eof() then {
                break;
            };
            when self.parse_when_arm() in {
                .Ok(arm) then {
                    arms.push(
                        CstWhenArm(
                            leading_comments,
                            arm.pattern,
                            arm.guard_kw,
                            arm.guard,
                            arm.then_kw,
                            arm.body,
                            arm.comma,
                            arm.trailing_comments,
                        ),
                    );
                },
                .Error(e) then {
                    return .Error(e);
                },
            };
        };
        let rb = when self.expect(.RBrace(), "'}'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(.When(kw, subject, in_kw, lb, arms, rb));
    };

    file_private parse_when_arm(self) Result[CstWhenArm] = {
        let pattern = when self.parse_pattern_node() in {
            .Ok(p) then p,
            .Error(e) then {
                return .Error(e);
            },
        };
        // Optional arm guard: `pat where cond then body`. The condition parses
        // like an `if` condition and stops before `then`.
        let mutable guard_kw = Option[Token].None();
        let mutable guard = Option[CstExpr].None();
        if self.check(.KwWhere()) then {
            guard_kw = .Some(self.eat());
            let guard_expr = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            guard = .Some(guard_expr);
        } else if self.check(.KwIf()) then {
            // The retired guard spelling. Falling through would report
            // "expected 'then'", which is true but never names the mistake.
            return .Error("Pattern guards use 'where', not 'if'");
        };
        let then_kw = when self.expect(.KwThen(), "'then'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let body = if self.check(.LBrace()) then {
            when self.parse_block_expr() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            }
        } else {
            when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            }
        };
        let comma = self.eat_comma();
        let mutable trailing_comments = List[Token].new();
        while self.peek_raw() is .LineComment(_) or is .BlockComment(_) then {
            trailing_comments.push(self.advance());
        };
        // Skip semicolons too
        if self.peek() is .Semi() then {
            self.eat();
        };
        return .Ok(
            CstWhenArm(
                List[Token].new(),
                pattern,
                guard_kw,
                guard,
                then_kw,
                body,
                comma,
                trailing_comments,
            ),
        );
    };

    /// A pattern bound: an integer, float, or rune literal. Rune literals scan
    /// as `IntLit` tokens carrying their quoted spelling, so the integer case
    /// already covers them.
    file_private expect_pattern_value(self, what String) Result[Token] = {
        return when self.peek() in {
            .IntLit(_) then .Ok(self.eat()),
            .FloatLit(_) then .Ok(self.eat()),
            _ then .Error(self.expected_error(what)),
        };
    };

    // ========================================================================
    // Pattern parsing
    // ========================================================================

    public parse_pattern(self) Result[CstPattern] = {
        return self.parse_pattern_node();
    };

    file_private parse_pattern_node(self) Result[CstPattern] = {
        return self.parse_or_pattern();
    };

    file_private parse_or_pattern(self) Result[CstPattern] = {
        let mutable left = when self.parse_and_pattern() in {
            .Ok(p) then p,
            .Error(e) then {
                return .Error(e);
            },
        };
        while self.check(.KwOr()) then {
            let next = self.peek_at_skip_nl(1);
            if next is .KwElse() then {
                break;
            };
            let op = self.eat();
            let right = when self.parse_and_pattern() in {
                .Ok(p) then p,
                .Error(e) then {
                    return .Error(e);
                },
            };
            left = .OrPattern(left, op, right);
        };
        return .Ok(left);
    };

    file_private parse_and_pattern(self) Result[CstPattern] = {
        let mutable left = when self.parse_not_pattern() in {
            .Ok(p) then p,
            .Error(e) then {
                return .Error(e);
            },
        };
        while self.check(.KwAnd()) then {
            let next = self.peek_at_skip_nl(1);
            if next is .KwThen() then {
                break;
            };
            let op = self.eat();
            let right = when self.parse_not_pattern() in {
                .Ok(p) then p,
                .Error(e) then {
                    return .Error(e);
                },
            };
            left = .AndPattern(left, op, right);
        };
        return .Ok(left);
    };

    file_private parse_not_pattern(self) Result[CstPattern] = {
        if self.check(.KwNot()) then {
            let op = self.eat();
            let inner = when self.parse_not_pattern() in {
                .Ok(p) then p,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.NotPattern(op, inner));
        };
        return self.parse_primary_pattern();
    };

    file_private parse_primary_pattern(self) Result[CstPattern] = {
        // Comparison patterns: > n, < n, >= n, <= n (n optionally negative)
        when self.peek() in {
            .Gt() or .Lt() or .GtEq() or .LtEq() then {
                let op = self.eat();
                let mutable minus = Option[Token].None();
                if self.check(.Minus()) then {
                    minus = .Some(self.eat());
                };
                let value = when self.expect_pattern_value("pattern value") in {
                    .Ok(v) then v,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                return .Ok(.Comparison(op, minus, value));
            },
            _ then {},
        };

        // Negative numeric literal: -5, -1.5
        if self.check(.Minus()) then {
            let minus = self.eat();
            let value = when self.expect_pattern_value("integer or float literal") in {
                .Ok(v) then v,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return when value in {
                .FloatLit(_) then .Ok(.NegFloatLit(minus, value)),
                _ then .Ok(.NegIntLit(minus, value)),
            };
        };

        // Integer / float literal
        when self.peek() in {
            .IntLit(_) then {
                return .Ok(.PatIntLit(self.eat()));
            },
            .FloatLit(_) then {
                return .Ok(.PatFloatLit(self.eat()));
            },
            .StrLit(_) then {
                return .Ok(.PatStrLit(self.eat()));
            },
            .BoolTrue() or .BoolFalse() then {
                return .Ok(.PatBoolLit(self.eat()));
            },
            .NullLit() then {
                return .Ok(.PatNullLit(self.eat()));
            },
            _ then {},
        };

        // Wildcard
        if self.peek() is .Underscore() then {
            return .Ok(.Wildcard(self.eat()));
        };

        // `mutable name` -- mutable variable binding
        // `mutable name Type` -- mutable trait-object implementation binding
        if self.check(.KwMut()) then {
            let mut_kw = self.eat();
            let name = when self.expect_ident("pattern variable name") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            if self.is_type_start(self.peek()) then {
                let bound = when self.parse_type_node() in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                return .Ok(.TypeBinding(.Some(mut_kw), name, bound));
            };
            return .Ok(.MutVariable(mut_kw, name));
        };

        // Weak-reference unpacking: `?name` / `?TypeName(name)`.
        // Lowercase after `?` is a bare binding; a type name is a typed binding
        // whose target type is checked.
        if self.check(.KwWeakref()) then {
            let question = self.eat();
            let name = when self.expect_ident("weak binding name") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            if self.is_type_start(name) then {
                // `?TypeName(name)` -- typed binding with a target type check.
                let lp = when self.expect(.LParen(), "'('") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let bind = when self.expect_ident("weak binding name") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let rp = when self.expect(.RParen(), "')'") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                return .Ok(
                    .WeakBinding(
                        question,
                        bind,
                        .Some(lp),
                        .Some(CstType.Named(name)),
                        .Some(rp),
                    ),
                );
            };
            // `?name` -- bare binding.
            return .Ok(.WeakBinding(question, name, .None(), .None(), .None()));
        };

        // Enum case: .Name or .Name(args)
        if self.check(.Dot()) then {
            let dot = self.eat();
            let name = when self.expect_ident("enum case name") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            if self.check(.LParen()) then {
                let lp = self.eat();
                let mutable args = List[CstPatternArg].new();
                while not self.check(.RParen()) and not self.is_eof() then {
                    let mutable label = Option[Token].None();
                    let mutable colon = Option[Token].None();
                    if self.peek() is .Ident(_) and self.peek_at_skip_nl(1) is .Colon() then {
                        label = .Some(self.eat());
                        colon = .Some(self.eat());
                    };
                    let p = when self.parse_pattern_node() in {
                        .Ok(parsed_pattern) then parsed_pattern,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    let comma = self.eat_comma();
                    args.push(CstPatternArg(label, colon, p, comma));
                };
                let rp = when self.expect(.RParen(), "')'") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                return .Ok(.EnumCase(dot, name, .Some(lp), args, .Some(rp)));
            };
            return .Ok(
                .EnumCase(dot, name, .None(), List[CstPatternArg].new(), .None()),
            );
        };

        // `...` -- rest slot. In the compiler this is only legal as a slot of an
        // element list; the CST records what was written, so it is a pattern
        // node here and the round trip keeps the token.
        if self.check(.Ellipsis()) then {
            return .Ok(.Rest(self.eat()));
        };

        // `[ p, q ]` -- list pattern: destructuring of a `List[T]` by length
        if self.check(.LBracket()) then {
            let lb = self.eat();
            let mutable items = List[CstListPatternItem].new();
            let mutable more = true;
            while more then {
                if self.check(.RBracket()) or self.is_eof() then {
                    more = false;
                } else {
                    let p = when self.parse_pattern_node() in {
                        .Ok(parsed_pattern) then parsed_pattern,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    let sep = self.eat_comma();
                    items.push(CstListPatternItem(p, sep));
                    if not self.sep_has_comma(sep) then {
                        more = false;
                    };
                };
            };
            let rb = when self.expect(.RBracket(), "']'") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(.ListPattern(lb, items, rb));
        };

        // `( a, b, c )` -- tuple pattern: positional destructuring of a struct,
        // also the `for (a, b, c) in ...` binding form. A single pattern under
        // `(` groups nothing and is rejected below.
        if self.check(.LParen()) then {
            let lp = self.eat();
            let first = when self.parse_pattern_node() in {
                .Ok(parsed_pattern) then parsed_pattern,
                .Error(e) then {
                    return .Error(e);
                },
            };
            if self.check(.Comma()) then {
                let mutable items = List[CstTuplePatternItem].new();
                let mutable current = first;
                let mutable more = true;
                while more then {
                    let sep = self.eat_comma();
                    items.push(CstTuplePatternItem(current, sep));
                    if not self.sep_has_comma(sep) then {
                        more = false;
                    } else {
                        let next = when self.parse_pattern_node() in {
                            .Ok(parsed_pattern) then parsed_pattern,
                            .Error(e) then {
                                return .Error(e);
                            },
                        };
                        current = next;
                    };
                };
                let rp = when self.expect(.RParen(), "')'") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                return .Ok(.TuplePattern(lp, items, rp));
            };
            // `(` in pattern position opens a tuple, which needs at least two
            // slots. A single parenthesized pattern groups nothing to group:
            // a `when` arm is already a full pattern, and under `is` the
            // combinators are the connectors `or is` / `and is`, which live
            // outside the slot. Same wording as the compilers.
            return .Error(
                "A parenthesized pattern groups nothing; `(` starts a tuple pattern with at least two slots. Under 'is', combine tests with 'or is' / 'and is'",
            );
        };

        // Variable or struct pattern: name or Name(args)
        if self.peek() is .Ident(_) then {
            let name = when self.expect_ident("pattern name") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            if self.check(.LParen()) then {
                let lp = self.eat();
                let mutable args = List[CstPatternArg].new();
                while not self.check(.RParen()) and not self.is_eof() then {
                    let mutable label = Option[Token].None();
                    let mutable colon = Option[Token].None();
                    if self.peek() is .Ident(_) and self.peek_at_skip_nl(1) is .Colon() then {
                        label = .Some(self.eat());
                        colon = .Some(self.eat());
                    };
                    let p = when self.parse_pattern_node() in {
                        .Ok(parsed_pattern) then parsed_pattern,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    let comma = self.eat_comma();
                    args.push(CstPatternArg(label, colon, p, comma));
                };
                let rp = when self.expect(.RParen(), "')'") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                return .Ok(.StructPattern(name, lp, args, rp));
            };
            // `name Type` -- trait-object implementation binding
            if self.is_type_start(self.peek()) then {
                let bound = when self.parse_type_node() in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                return .Ok(.TypeBinding(.None(), name, bound));
            };
            return .Ok(.Variable(name));
        };

        // Fallback
        return .Error(self.expected_error("pattern"));
    };

    // ========================================================================
    // Statement parsing
    // ========================================================================

    /// The comments between a statement and its `;`, and the `;` when the
    /// source wrote one.
    file_private eat_stmt_terminator(self) CstComma = {
        let mutable comments = List[Token].new();
        while self.peek() is .LineComment(_) or is .BlockComment(_) then {
            comments.push(self.eat());
        };
        if self.check(.Semi()) then {
            return CstComma(comments, .Some(self.eat()));
        };
        return CstComma(comments, .None());
    };

    /// A statement item, carrying the comments that trail it before its `;`.
    file_private stmt_item(self, terminator CstComma, s CstStmt) CstItem = {
        if terminator.comments.count() > 0 then {
            return CstItem.StmtPreSemi(terminator.comments, s);
        };
        return CstItem.Stmt(s);
    };

    /// The next token that is not a comment. Newlines are layout and comments
    /// stay in place -- this only answers what FOLLOWS them, so a bare
    /// `return /* c */;` can be told from `return /* c */ 0;`.
    file_private peek_past_comments(self) Token = {
        let mutable i = self.pos;
        while i < self.tokens.count() then {
            when self.tokens[i] in {
                .Newline() or .LineComment(_) or .BlockComment(_) then {
                    i += 1;
                },
                _ then {
                    return self.tokens[i];
                },
            };
        };
        return Token.EOF();
    };

    file_private parse_stmt(self) Result[CstItem] = {
        when self.peek() in {
            .KwDefer() then {
                let kw = self.eat();
                let value = when self.parse_expr_node() in {
                    .Ok(e) then e,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let term = self.eat_stmt_terminator();
                return .Ok(self.stmt_item(term, .Defer(kw, value)));
            },
            .KwReturn() then {
                let kw = self.eat();
                // A bare `return` is decided before any value: `return /* c */;`
                // has none. Comments here trail the statement; comments before
                // a VALUE lead it and the value parse collects them.
                let next = self.peek_past_comments();
                if next is .Semi() or is .RBrace() then {
                    let term = self.eat_stmt_terminator();
                    return .Ok(self.stmt_item(term, .Return(kw, .None())));
                };
                let value = when self.parse_expr_node() in {
                    .Ok(e) then e,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let term = self.eat_stmt_terminator();
                if term.token is .None() then {
                    return .Error("Parse error: expected ';' after return");
                };
                return .Ok(self.stmt_item(term, .Return(kw, .Some(value))));
            },
            .KwBreak() then {
                let kw = self.eat();
                let term = self.eat_stmt_terminator();
                if term.token is .None() then {
                    return .Error("Parse error: expected ';' after break");
                };
                return .Ok(self.stmt_item(term, .Break(kw)));
            },
            .KwContinue() then {
                let kw = self.eat();
                let term = self.eat_stmt_terminator();
                if term.token is .None() then {
                    return .Error("Parse error: expected ';' after continue");
                };
                return .Ok(self.stmt_item(term, .Continue(kw)));
            },
            _ then {},
        };

        // Expression statement — may be followed by assignment operator
        let expr = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        when self.peek() in {
            .Eq() or .PlusEq() or .MinusEq() or .StarEq() or .SlashEq() or .PercentEq() or .AmpEq() or .PipeEq() or .CaretEq() or .LShiftEq() or .RShiftEq() then {
                let op = self.eat();
                let value = when self.parse_expr_node() in {
                    .Ok(e) then e,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let term = self.eat_stmt_terminator();
                if term.token is .None() then {
                    return .Error("Parse error: expected ';' after assignment");
                };
                return .Ok(self.stmt_item(term, .Assignment(expr, op, value)));
            },
            _ then {},
        };
        let term = self.eat_stmt_terminator();
        let semi = term.token;
        return .Ok(self.stmt_item(term, .ExprStmt(expr, semi)));
    };

    file_private parse_var_decl_stmt(self) Result[CstItem] = {
        let let_kw = when self.expect(.KwLet(), "'let'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };

        if self.check(.LParen()) then {
            let lp = self.eat();
            let first = when self.parse_pair_binding() in {
                .Ok(binding) then binding,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let mutable items = List[CstTupleBindingItem].new();
            let mutable current = first;
            // At least two slots: `let (x) = ...` is not a tuple binding.
            if self.peek_past_comments() is not .Comma() then {
                return .Error("Parse error: expected ',' in tuple let statement");
            };
            let mutable more = true;
            while more then {
                let sep = self.eat_comma();
                items.push(CstTupleBindingItem(current, sep));
                if not self.sep_has_comma(sep) then {
                    more = false;
                } else {
                    let next = when self.parse_pair_binding() in {
                        .Ok(binding) then binding,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    current = next;
                };
            };
            let rp = when self.expect(.RParen(), "')'") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let eq = when self.expect(.Eq(), "'='") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let value = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let term = self.eat_stmt_terminator();
            if term.token is .None() then {
                return .Error("Parse error: expected ';' after let declaration");
            };
            return .Ok(self.stmt_item(term, .TupleVarDecl(let_kw, lp, items, rp, eq, value)));
        };

        let mutable mut_kw = Option[Token].None();
        if self.check(.KwMut()) then {
            mut_kw = .Some(self.eat());
        };
        let name = when self.expect_ident("variable name") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };

        // Optional type annotation
        let mutable var_type = Option[CstType].None();
        if self.is_type_start(self.peek()) then {
            let t = when self.parse_type_node() in {
                .Ok(parsed_type) then parsed_type,
                .Error(e) then {
                    return .Error(e);
                },
            };
            var_type = .Some(t);
        };

        let eq = when self.expect(.Eq(), "'='") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let value = when self.parse_expr_node() in {
            .Ok(e) then e,
            .Error(e) then {
                return .Error(e);
            },
        };
        let term = self.eat_stmt_terminator();
        if term.token is .None() then {
            return .Error("Parse error: expected ';' after let declaration");
        };
        return .Ok(self.stmt_item(term, .VarDecl(let_kw, mut_kw, name, var_type, eq, value)));
    };

    file_private parse_pair_binding(self) Result[CstPairBinding] = {
        // Nested tuple binding: `(a, (b, c))`. A nested slot is a full
        // `<tuple-binding>`, so nesting is allowed wherever a binding element
        // is -- `let (a, (b, c)) = ...` and `for (a, (b, c)) in ...` alike.
        if self.check(.LParen()) and self.peek_at_skip_nl(1) is not .RParen() then {
            return self.parse_nested_tuple_binding();
        };

        let mutable mut_kw = Option[Token].None();
        if self.check(.KwMut()) then {
            mut_kw = .Some(self.eat());
        };

        if self.check(.Underscore()) then {
            let name = self.eat();
            return .Ok(.Leaf(mut_kw, name, .None(), true));
        };

        let name = when self.expect_ident("variable name") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };

        // `_` is spelled as an identifier by the tokenizer; it is still the
        // discard slot. The compilers recognise the name the same way.
        let name_is_discard = when name in {
            .Ident(n) then n == "_",
            _ then false,
        };

        // A binding name is a VALUE name: lowercase-first (after underscores),
        // or underscore-only. `for Point(a, b)` is a struct pattern, which
        // this parser does not accept -- the compilers refuse the uppercase
        // name with "must start with a lowercase letter".
        when name in {
            .Ident(n) then {
                if not name_is_discard and not self.is_value_name(n) then {
                    return .Error(
                        "Parse error: Variable name '\(n)' must start with a lowercase letter",
                    );
                };
            },
            _ then {},
        };

        let mutable binding_type = Option[CstType].None();
        if not self.check(.Comma()) and not self.check(.RParen()) and not self.check(
            .KwIn(),
        ) then {
            let t = when self.parse_type_node() in {
                .Ok(parsed_type) then parsed_type,
                .Error(e) then {
                    return .Error(e);
                },
            };
            binding_type = .Some(t);
        };

        return .Ok(.Leaf(mut_kw, name, binding_type, name_is_discard));
    };

    /// `( a, b, ... )` as a binding element: at least two slots, each a
    /// binding element (so the slots nest). Mirrors the compilers'
    /// `parse_pair_binding_element`, which refuses a parenthesized run of
    /// fewer than two slots.
    file_private parse_nested_tuple_binding(self) Result[CstPairBinding] = {
        let lp = self.eat();
        let first = when self.parse_pair_binding() in {
            .Ok(binding) then binding,
            .Error(e) then {
                return .Error(e);
            },
        };
        if self.peek_past_comments() is not .Comma() then {
            return .Error(
                "Parse error: expected ',' in tuple binding: a parenthesized binding needs at least two slots",
            );
        };
        let mutable items = List[CstTupleBindingItem].new();
        let mutable current = first;
        let mutable more = true;
        while more then {
            let sep = self.eat_comma();
            items.push(CstTupleBindingItem(current, sep));
            if not self.sep_has_comma(sep) then {
                more = false;
            } else {
                let next = when self.parse_pair_binding() in {
                    .Ok(binding) then binding,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                current = next;
            };
        };
        let rp = when self.expect(.RParen(), "')'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(.Nested(lp, items, rp));
    };

    // ========================================================================
    // Declaration parsing
    // ========================================================================

    // Main entry point
    public parse(self) Result[CstFile] = {
        let mutable items = List[CstItem].new();
        let mutable seen_non_using = false;
        while not self.is_eof() then {
            let nl_count = self.count_newlines();
            if nl_count >= 2 then {
                self.skip_newlines();
                items.push(CstItem.BlankLine());
                continue;
            };
            self.skip_newlines();
            if self.is_eof() then {
                break;
            };
            if self.check(.Semi()) then {
                self.eat();
                continue;
            };
            if self.peek() is .LineComment(_) or is .BlockComment(_) then {
                let c = self.eat();
                let prev_is_code = self.last_item_is_code(items);
                if nl_count == 0 and prev_is_code then {
                    items.push(CstItem.TrailingComment(c));
                } else {
                    items.push(CstItem.Comment(c));
                };
                continue;
            };
            let before = self.pos;
            let item = when self.parse_top_item() in {
                .Ok(parsed_item) then parsed_item,
                .Error(e) then {
                    return .Error(e);
                },
            };
            if CstParser.item_is_using_decl(item) then {
                if seen_non_using then {
                    return .Error(
                        "Parse error: using declarations must appear before other top-level declarations",
                    );
                };
            } else if CstParser.item_is_non_using_top_level_code(item) then {
                seen_non_using = true;
            };
            items.push(item);
            if self.pos == before then {
                return .Error("Parse error: parser made no progress");
            };
        };
        return .Ok(CstFile(items));
    };

    file_private parse_top_item(self) Result[CstItem] = {
        // Using declaration. Its `;` is collected inside the declaration's own
        // token list, and the compiler does not require one at all -- so it
        // does not go through `finish_decl_item`. Matching the compiler here
        // means accepting `using "./x.koral"` without `;`, even though
        // grammar.bnf writes the `;` as mandatory.
        if self.check(.KwUsing()) then {
            when self.parse_using_decl() in {
                .Ok(d) then {
                    return .Ok(.Decl(d));
                },
                .Error(e) then {
                    return .Error(e);
                },
            };
        };

        // Determine declaration kind by peeking past every leading access
        // modifier.
        let offset UInt = self.modifier_token_count();
        let decl_kw = self.peek_at_skip_nl(offset);
        // `foreign` / `intrinsic` qualify the declaration keyword (`let foreign`),
        // not the prefix; a leading one is the old spelling. Name the token the
        // way the compiler's declaration dispatch does.
        when decl_kw in {
            .KwForeign() then {
                return .Error("Parse error: Unexpected token: foreign");
            },
            .KwIntrinsic() then {
                return .Error("Parse error: Unexpected token: intrinsic");
            },
            _ then {},
        };
        when decl_kw in {
            .KwLet() then {
                when self.parse_let_decl() in {
                    .Ok(d) then {
                        return self.finish_decl_item(d);
                    },
                    .Error(e) then {
                        return .Error(e);
                    },
                };
            },
            .KwType() then {
                when self.parse_type_decl() in {
                    .Ok(d) then {
                        return self.finish_decl_item(d);
                    },
                    .Error(e) then {
                        return .Error(e);
                    },
                };
            },
            .KwTrait() then {
                when self.parse_trait_decl() in {
                    .Ok(d) then {
                        return self.finish_decl_item(d);
                    },
                    .Error(e) then {
                        return .Error(e);
                    },
                };
            },
            .KwGiven() then {
                when self.parse_given_decl() in {
                    .Ok(d) then {
                        return self.finish_decl_item(d);
                    },
                    .Error(e) then {
                        return .Error(e);
                    },
                };
            },
            _ then {},
        };
        // Statement
        return self.parse_stmt();
    };

    // ========================================================================
    // Using declarations
    // ========================================================================

    /// After the specifier (and optional import list) nothing may appear but
    /// layout, comments, and the one `;` that ends the declaration. The `;` is
    /// collected into `tokens` rather than consumed by the caller, so it is
    /// required here instead of by `finish_decl_item`.
    file_private validate_using_trailing_tokens(
        self,
        tokens List[Token],
        start UInt,
        message String,
    ) Result[Void] = {
        let mutable seen_semi = false;
        let mutable i = start;
        while i < tokens.count() then {
            when tokens[i] in {
                .Newline() or .LineComment(_) or .BlockComment(_) then {
                    i += 1;
                },
                .Semi() then {
                    if seen_semi then {
                        return .Error(message);
                    };
                    seen_semi = true;
                    i += 1;
                },
                _ then {
                    return .Error(message);
                },
            };
        };
        if not seen_semi then {
            return .Error("Parse error: expected ';' after declaration");
        };
        return .Ok({});
    };

    /// The contents of a `StrLit` token, quotes stripped.
    file_private using_specifier_text(self, token Token) String = {
        let raw = when token in {
            .StrLit(t) then t,
            _ then "",
        };
        if raw.count() < UInt(2) then {
            return "";
        };
        return raw.substring(UInt(1)..<(raw.count() - UInt(1)));
    };

    /// module-design §3.1: a specifier beginning `./` or `../` merges a file,
    /// anything else imports `package[/subpath]`. The formatter checks SHAPE
    /// only -- whether the package exists is the compiler's business.
    file_private is_file_merge_specifier(self, spec String) Bool = {
        return spec.starts_with("./") or spec.starts_with("../") or spec.starts_with(
            ".\\",
        ) or spec.starts_with("..\\");
    };

    /// `<import-list>` -- the filter on an import (§3.3). Six forms:
    ///
    ///     { }                  nothing at all (a placeholder while editing)
    ///     { a, b }             exactly these
    ///     { a as b }           exactly these, one renamed
    ///     { ... }              every visible member
    ///     { a as b, ... }      every member, `a` spelled `b`
    ///     { !a, !b, ... }      every member but `a` and `b`
    ///
    /// `...` is the base set and closes the list. Items alongside it are
    /// renames (positive) or exclusions (`!`), never both; a positive item
    /// without `as` next to `...` is redundant and rejected. The list may span
    /// lines, so newlines are skipped as whitespace here.
    file_private validate_import_list_tokens(
        self,
        tokens List[Token],
        start UInt,
    ) Result[Void] = {
        let mutable i = start;
        if i >= tokens.count() or tokens[i] is not .LBrace() then {
            return .Error(
                "Parse error: expected an import list like '{ Reader, Writer }'",
            );
        };
        i += 1;
        let mutable import_all = false;
        let mutable saw_exclude = false;
        let mutable saw_positive = false;
        while true then {
            i = CstParser.skip_newline_tokens(tokens, i);
            if i >= tokens.count() then {
                return .Error("Parse error: expected '}' in import list");
            };
            if tokens[i] is .RBrace() then {
                return self.finish_import_list_tokens(
                    tokens,
                    i + 1,
                    import_all,
                    saw_exclude,
                    saw_positive,
                );
            };
            if tokens[i] is .Ellipsis() then {
                // `...` is the base set and closes the list (§3.3).
                i = CstParser.skip_newline_tokens(tokens, i + 1);
                if i < tokens.count() and tokens[i] is .Comma() then {
                    i = CstParser.skip_newline_tokens(tokens, i + 1);
                };
                if i >= tokens.count() or tokens[i] is not .RBrace() then {
                    return .Error(
                        "Parse error: '...' closes the import list; put renames or exclusions before it, or write '{ ... }'",
                    );
                };
                return self.finish_import_list_tokens(
                    tokens,
                    i + 1,
                    true,
                    saw_exclude,
                    saw_positive,
                );
            };
            if tokens[i] is .Range() then {
                return .Error(
                    "Parse error: '..' is not an import item; write '...' to import every visible member",
                );
            };
            let mutable excluded = false;
            if tokens[i] is .Bang() then {
                excluded = true;
                saw_exclude = true;
                i = CstParser.skip_newline_tokens(tokens, i + 1);
            } else {
                saw_positive = true;
            };
            if i >= tokens.count() or tokens[i] is not .Ident(_) then {
                return .Error(
                    "Parse error: expected an import item or '}' in import list",
                );
            };
            let item_name = when tokens[i] in {
                .Ident(n) then n,
                _ then "",
            };
            i += 1;

            i = CstParser.skip_newline_tokens(tokens, i);
            if i < tokens.count() and tokens[i] is .KwAs() then {
                if excluded then {
                    return .Error(
                        "Parse error: '!\(item_name)' is an exclusion and cannot be renamed; drop the '!' or drop the 'as'",
                    );
                };
                i = CstParser.skip_newline_tokens(tokens, i + 1);
                if i >= tokens.count() or tokens[i] is not .Ident(_) then {
                    return .Error("Parse error: expected an alias name after 'as'");
                };
                let alias_name = when tokens[i] in {
                    .Ident(n) then n,
                    _ then "",
                };
                // The alias must keep the referenced name's case class.
                // Matches the compiler's rejection exactly.
                let item_runes = item_name.to_runes();
                let alias_runes = alias_name.to_runes();
                if item_runes.count() > 0 and alias_runes.count() > 0 then {
                    // Mirrors the compiler's `is_upper_first`: leading
                    // underscores are skipped, the first letter decides.
                    let mutable ii UInt = 0;
                    while ii < item_runes.count() and item_runes[ii].to_uint32() == 95 then {
                        ii += 1;
                    };
                    let mutable ai UInt = 0;
                    while ai < alias_runes.count() and alias_runes[ai].to_uint32() == 95 then {
                        ai += 1;
                    };
                    let item_upper = ii < item_runes.count() and item_runes[ii].to_uint32(
                    ) >= 65 and item_runes[ii].to_uint32() <= 90;
                    let alias_upper = ai < alias_runes.count() and alias_runes[ai].to_uint32(
                    ) >= 65 and alias_runes[ai].to_uint32() <= 90;
                    if item_upper != alias_upper then {
                        if item_upper then {
                            return .Error(
                                "Parse error: Using alias '\(alias_name)' is invalid: alias must start with an uppercase letter because referenced identifier '\(item_name)' starts with uppercase",
                            );
                        };
                        return .Error(
                            "Parse error: Using alias '\(alias_name)' is invalid: alias must start with a lowercase letter because referenced identifier '\(item_name)' starts with lowercase",
                        );
                    };
                };
                i += 1;
            };

            i = CstParser.skip_newline_tokens(tokens, i);
            if i >= tokens.count() then {
                return .Error("Parse error: expected ',' or '}' in import list");
            };
            if tokens[i] is .Comma() then {
                i += 1;
                continue;
            };
            if tokens[i] is .RBrace() then {
                return self.finish_import_list_tokens(
                    tokens,
                    i + 1,
                    import_all,
                    saw_exclude,
                    saw_positive,
                );
            };
            return .Error("Parse error: expected ',' or '}' in import list");
        };

        return .Ok({});
    };

    /// Validate one import list's shape once its items and base set are known
    /// (§3.3). Shared by both exits of the token loop so the two paths cannot
    /// drift apart.
    file_private finish_import_list_tokens(
        self,
        tokens List[Token],
        next UInt,
        import_all Bool,
        saw_exclude Bool,
        saw_positive Bool,
    ) Result[Void] = {
        if saw_exclude and saw_positive then {
            return .Error(
                "Parse error: an import list is either all-positive or all-exclusions; '{ !a, ... }' and '{ a as b, ... }' do not mix",
            );
        };
        if saw_exclude and not import_all then {
            return .Error(
                "Parse error: '!' excludes from the whole module surface and needs '...'; write '{ !name, ... }'",
            );
        };
        return self.validate_using_trailing_tokens(
            tokens,
            next,
            "Parse error: unexpected tokens after using declaration",
        );
    };

    file_private skip_newline_tokens(tokens List[Token], start UInt) UInt = {
        let mutable i = start;
        while i < tokens.count() and tokens[i] is .Newline() then {
            i += 1;
        };
        return i;
    };

    file_private validate_using_decl_tokens(self, tokens List[Token]) Result[Void] = {
        if tokens.count() == 0 or tokens[0] is not .KwUsing() then {
            return .Error("Parse error: expected 'using' declaration");
        };
        if tokens.count() < 2 or tokens[1] is not .StrLit(_) then {
            return .Error(
                "Parse error: expected a string literal after 'using', like 'using \"std/io\";' or 'using \"./file.koral\";'",
            );
        };

        let spec = self.using_specifier_text(tokens[1]);
        if tokens.count() > 2 and tokens[2] is .KwAs() then {
            // Renaming a module is changing its key in `dependencies`, not an
            // alias on the `using` (module-design §5.3). File merges never had
            // aliases either -- merging is whole-file.
            return .Error(
                "Parse error: 'using' takes no alias; rename a dependency by changing its key, or name members in an import list with 'as'",
            );
        };
        if self.is_file_merge_specifier(spec) and not spec.ends_with(".koral") then {
            return .Error("Parse error: file merge path must end in '.koral'");
        };
        // A local path may be merged (bare) or imported (braces) -- the
        // braces decide only whether the target's boundary survives (§3).
        // The spec's shape says where the target is (§3.1), never what
        // happens to it.
        if tokens.count() > 2 and tokens[2] is .LBrace() then {
            return self.validate_import_list_tokens(tokens, 2);
        };
        return self.validate_using_trailing_tokens(
            tokens,
            2,
            "Parse error: unexpected tokens after using declaration",
        );
    };

    /// Collects the whole `using` declaration as a flat token list. An import
    /// list may span lines (`{ a,\n b }`), so collection only stops at a newline
    /// that is outside the braces. Interior newlines stay in the list -- the
    /// sequence is printed back with the same line breaks it came with.
    file_private parse_using_decl(self) Result[CstDecl] = {
        let tokens = self.collect_using_tokens();
        when self.validate_using_decl_tokens(tokens) in {
            .Ok(_) then {},
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(.Using(tokens));
    };

    file_private collect_using_tokens(self) List[Token] = {
        let mutable tokens = List[Token].new();
        let mutable depth UInt = 0;
        while not self.is_eof() then {
            when self.peek_raw() in {
                .Newline() then {
                    if depth == 0 then {
                        return tokens;
                    };
                    tokens.push(self.advance());
                },
                .LBrace() then {
                    depth += 1;
                    tokens.push(self.advance());
                },
                .RBrace() then {
                    if depth > 0 then {
                        depth -= 1;
                    };
                    tokens.push(self.advance());
                },
                .EOF() then {
                    return tokens;
                },
                _ then {
                    tokens.push(self.advance());
                },
            };
        };
        return tokens;
    };

    // ========================================================================
    // Let declaration (function or variable)
    // ========================================================================

    file_private parse_let_decl(self) Result[CstDecl] = {
        let vis = self.eat_vis();
        let let_kw = when self.expect(.KwLet(), "'let'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        // `foreign` / `intrinsic` sit immediately after `let`, before `mutable`:
        // `let foreign mutable errno Int32;`.
        let mods = self.eat_kind_modifiers();
        let mutable mut_kw = Option[Token].None();
        if self.check(.KwMut()) then {
            mut_kw = .Some(self.eat());
        };
        return self.finish_func_or_var(vis, mods, .Some(let_kw), mut_kw, false);
    };

    file_private finish_func_or_var(
        self,
        vis Option[Token],
        mods List[Token],
        let_kw Option[Token],
        mut_kw Option[Token],
        in_member_context Bool,
    ) Result[CstDecl] = {
        let name = when self.expect_ident("declaration name") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let gp = when self.parse_generic_params() in {
            .Ok(g) then g,
            .Error(e) then {
                return .Error(e);
            },
        };

        // Parameters -- unless the `(` opens a function TYPE's parameter list
        // (`let f (Int) -> Int = value`), which is an annotation, not a
        // signature. The contents decide: a type-head starts a type list, and
        // `mutable` / a lowercase name starts parameters.
        let mutable lp = Option[Token].None();
        let mutable params = List[CstParam].new();
        let mutable rp = Option[Token].None();
        if self.check(.LParen()) and not self.paren_opens_type_at(self.pos) then {
            lp = .Some(self.eat());
            params = when self.parse_params() in {
                .Ok(ps) then ps,
                .Error(e) then {
                    return .Error(e);
                },
            };
            rp = .Some(
                when self.expect(.RParen(), "')'") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                },
            );
        };

        // Return type
        let mutable ret = Option[CstType].None();
        if self.is_type_start(self.peek()) then {
            if not self.check(.Eq()) then {
                let t = when self.parse_type_node() in {
                    .Ok(parsed_type) then parsed_type,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                ret = .Some(t);
            };
        };

        // = body → function
        if self.check(.Eq()) then {
            let eq = self.eat();
            let body = when self.parse_expr_node() in {
                .Ok(e) then e,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(
                .Func(vis, mods, let_kw, mut_kw, gp, .Some(name), lp, params, rp, ret, eq, body),
            );
        };

        // No `=` means no body. That is legal for a `foreign` or `intrinsic`
        // declaration and for a trait/given method signature -- and nowhere
        // else. `let f(x Int) Int;` is a syntax error, and parsing it as a
        // variable would drop the parameter list on the floor.
        if mods.count() > 0 then {
            return .Ok(
                .ForeignDecl(vis, mods, let_kw, mut_kw, gp, .Some(name), lp, params, rp, ret),
            );
        };

        if in_member_context then {
            if lp is .Some(_) then {
                return .Ok(
                    .ForeignDecl(vis, mods, let_kw, mut_kw, gp, .Some(name), lp, params, rp, ret),
                );
            };
            return .Error(self.expected_error("member signature"));
        };

        if lp is .Some(_) then {
            return .Error(
                "Parse error: a function declaration without a body needs 'foreign' or 'intrinsic'",
            );
        };

        // Variable declaration (top-level)
        let lk = when let_kw in {
            .Some(k) then k,
            .None() then .KwLet(),
        };
        return .Ok(.Var(vis, lk, mut_kw, name, ret));
    };

    // ========================================================================
    // Type declaration
    // ========================================================================

    file_private parse_type_decl(self) Result[CstDecl] = {
        let vis = self.eat_vis();
        let kw = when self.expect(.KwType(), "'type'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        // `foreign` / `intrinsic` sit immediately after `type`: `type foreign`.
        let mods = self.eat_kind_modifiers();
        // `type` `mutable`? — the two nominal forms the language has
        // (grammar.bnf `<type-decl>`). `mutable` applies to structs only.
        let mutable mut_kw = Option[Token].None();
        if self.check(.KwMut()) then {
            mut_kw = .Some(self.eat());
        };
        let name = when self.expect_ident("type name") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let gp = when self.parse_generic_params() in {
            .Ok(g) then g,
            .Error(e) then {
                return .Error(e);
            },
        };

        // Struct body: (fields)
        if self.check(.LParen()) then {
            let lp = self.eat();
            let mutable items = List[CstStructBodyItem].new();
            // Positional fields must come before named fields (grammar.bnf
            // <field-list>), same rule as <func-param-list>.
            let mutable seen_named_field = false;
            while not self.check(.RParen()) and not self.is_eof() then {
                let nl_count = self.count_newlines();
                if nl_count >= 2 then {
                    self.skip_newlines();
                    items.push(CstStructBodyItem.BlankLine());
                    continue;
                };
                self.skip_newlines();
                if self.check(.RParen()) or self.is_eof() then {
                    break;
                };
                if self.peek() is .LineComment(_) or is .BlockComment(_) then {
                    let c = self.eat();
                    let prev_is_field = if items.count() > 0 then {
                        when items[items.count() - 1] in {
                            .Field(_) then true,
                            _ then false,
                        }
                    } else false;
                    if nl_count == 0 and prev_is_field then {
                        items.push(CstStructBodyItem.TrailingComment(c));
                    } else {
                        items.push(CstStructBodyItem.Comment(c));
                    };
                    continue;
                };
                let mutable field_mut = Option[Token].None();
                let field_access = self.eat_vis();
                if self.check(.KwMut()) then {
                    field_mut = .Some(self.eat());
                };
                let field_name = when self.expect_ident("field name") in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                // `name Type` (positional) and `name: Type` (named) are both
                // <field> spellings (grammar.bnf). The colon slot is what the
                // printer reads to keep the distinction.
                let mutable field_colon = Option[Token].None();
                if self.check(.Colon()) then {
                    field_colon = .Some(self.eat());
                    seen_named_field = true;
                } else if seen_named_field then {
                    return .Error(
                        "Parse error: Positional field '\(field_name.to_string())' cannot appear after named fields",
                    );
                };
                let field_type = when self.parse_type_node() in {
                    .Ok(t) then t,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                // Only named fields (with a colon) may carry a default.
                if field_colon is .None() and self.check(.Eq()) then {
                    return .Error(
                        "Parse error: Default values are only allowed for named parameters (use 'name: Type = value' syntax)",
                    );
                };
                let default_value = when self.parse_default_value() in {
                    .Ok(d) then d,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                let comma = self.eat_comma();
                items.push(
                    CstStructBodyItem.Field(
                        CstStructField(
                            field_mut,
                            field_access,
                            field_name,
                            field_colon,
                            field_type,
                            default_value,
                            comma,
                        ),
                    ),
                );
            };
            let rp = when self.expect(.RParen(), "')'") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(
                .Type(vis, mods, kw, mut_kw, gp, name, CstTypeBody.Struct(lp, items, rp)),
            );
        };

        // Enum body: { .Variant1, .Variant2(T) }
        if self.check(.LBrace()) then {
            if mut_kw is .Some(_) then {
                return .Error("Parse error: Enum type cannot be marked mutable");
            };
            let lb = self.eat();
            let mutable cases = List[CstItem].new();
            while not self.check(.RBrace()) and not self.is_eof() then {
                let nl_count = self.count_newlines();
                if nl_count >= 2 then {
                    self.skip_newlines();
                    cases.push(CstItem.BlankLine());
                    continue;
                };
                self.skip_newlines();
                if self.check(.RBrace()) or self.is_eof() then {
                    break;
                };
                if self.peek() is .LineComment(_) or is .BlockComment(_) then {
                    let c = self.eat();
                    let prev_is_code = self.last_item_is_code(cases);
                    if nl_count == 0 and prev_is_code then {
                        cases.push(CstItem.TrailingComment(c));
                    } else {
                        cases.push(CstItem.Comment(c));
                    };
                    continue;
                };
                let expr = when self.parse_enum_variant_expr() in {
                    .Ok(e) then e,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                // <variant-list> is `("," <variant>)* ","?` (grammar.bnf), so a
                // comma is required BETWEEN variants and optional after the last.
                // Comments that trail a variant before its comma ride as items
                // after it; the case list prints them once the comma is out.
                let sep = self.eat_comma();
                let s = CstStmt.ExprStmt(expr, .None());
                cases.push(CstItem.Stmt(s));
                when sep in {
                    .Some(slot) then {
                        for c in slot.comments then {
                            cases.push(CstItem.TrailingComment(c));
                        };
                    },
                    .None() then {},
                };
            };
            let rb = when self.expect(.RBrace(), "'}'") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(
                .Type(vis, mods, kw, mut_kw, gp, name, CstTypeBody.Enum(lb, cases, rb)),
            );
        };

        // Alias: = OtherType
        if self.check(.Eq()) then {
            if mut_kw is .Some(_) then {
                return .Error("Parse error: Type alias cannot be marked mutable");
            };
            let eq = when self.expect(.Eq(), "'='") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let target = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            return .Ok(
                .Type(vis, mods, kw, mut_kw, gp, name, CstTypeBody.Alias(eq, target)),
            );
        };

        // Empty (foreign type)
        return .Ok(.Type(vis, mods, kw, mut_kw, gp, name, CstTypeBody.Empty()));
    };

    file_private parse_enum_variant_expr(self) Result[CstExpr] = {
        let name = when self.expect_ident("enum variant name") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };

        let mutable fields = List[CstEnumField].new();
        // Positional payload fields must come before named ones -- see
        // parse_params.
        let mutable seen_named_field = false;

        // A variant declaration always writes its parens -- `Red()`, never bare
        // `Red` -- so the declaration matches the expression (`.Red()`) and
        // pattern (`.Red()`) spellings.
        let lp = when self.expect(.LParen(), "'('") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        while not self.check(.RParen()) and not self.is_eof() then {
            // A comment between payload fields is documentation on the
            // field that follows it, not a field name. Keep it.
            let mutable comments = List[Token].new();
            while self.peek() is .LineComment(_) or is .BlockComment(_) then {
                comments.push(self.eat());
            };
            let field_name = when self.expect_ident("enum field name") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            // `name Type` (positional) and `name: Type` (named) are both
            // <variant-field> spellings (grammar.bnf).
            let mutable field_colon = Option[Token].None();
            if self.check(.Colon()) then {
                field_colon = .Some(self.eat());
                seen_named_field = true;
            } else if seen_named_field then {
                return .Error(
                    "Parse error: Positional field '\(field_name.to_string())' cannot appear after named fields",
                );
            };
            let field_type = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            // Only named fields (with a colon) may carry a default.
            if field_colon is .None() and self.check(.Eq()) then {
                return .Error(
                    "Parse error: Default values are only allowed for named parameters (use 'name: Type = value' syntax)",
                );
            };
            let default_value = when self.parse_default_value() in {
                .Ok(d) then d,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let comma = self.eat_comma();
            fields.push(
                CstEnumField(
                    comments,
                    field_name,
                    field_colon,
                    field_type,
                    default_value,
                    comma,
                ),
            );
        };
        let rp = when self.expect(.RParen(), "')'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };

        return .Ok(.EnumVariant(name, lp, fields, rp));
    };

    // ========================================================================
    // Trait declaration
    // ========================================================================

    file_private parse_trait_decl(self) Result[CstDecl] = {
        let vis = self.eat_vis();
        let kw = when self.expect(.KwTrait(), "'trait'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let name = when self.expect_ident("trait name") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let gp = when self.parse_generic_params() in {
            .Ok(g) then g,
            .Error(e) then {
                return .Error(e);
            },
        };

        // Super traits (before {)
        let mutable supers = List[CstType].new();
        if not self.check(.LBrace()) and not self.is_eof() and self.peek_raw() is not .Newline() and self.peek_raw(
        ) is not .EOF() then {
            let first = when self.parse_type_node() in {
                .Ok(parsed_type) then parsed_type,
                .Error(e) then {
                    return .Error(e);
                },
            };
            supers.push(first);
            while self.check(.KwAnd()) then {
                self.eat();
                let next = when self.parse_type_node() in {
                    .Ok(parsed_type) then parsed_type,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                supers.push(next);
            };
        };

        let lb = when self.expect(.LBrace(), "'{'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let members = when self.parse_trait_members() in {
            .Ok(ms) then ms,
            .Error(e) then {
                return .Error(e);
            },
        };
        let rb = when self.expect(.RBrace(), "'}'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(.Trait(vis, kw, gp, name, supers, lb, members, rb));
    };

    // ========================================================================
    // Trait members
    // ========================================================================

    file_private parse_trait_members(self) Result[List[CstItem]] = {
        let mutable members = List[CstItem].new();
        while not self.check(.RBrace()) and not self.is_eof() then {
            let nl_count = self.count_newlines();
            if nl_count >= 2 then {
                self.skip_newlines();
                members.push(CstItem.BlankLine());
                continue;
            };
            self.skip_newlines();
            if self.check(.RBrace()) or self.is_eof() then {
                break;
            };
            if self.check(.Semi()) then {
                self.eat();
                continue;
            };
            if self.peek() is .LineComment(_) or is .BlockComment(_) then {
                let c = self.eat();
                let prev_is_code = self.last_item_is_code(members);
                if nl_count == 0 and prev_is_code then {
                    members.push(CstItem.TrailingComment(c));
                } else {
                    members.push(CstItem.Comment(c));
                };
                continue;
            };
            when self.parse_trait_method_sig() in {
                .Ok(d) then {
                    when self.eat_decl_semi() in {
                        .Ok(_) then {},
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    members.push(CstItem.Decl(d));
                },
                .Error(e) then {
                    return .Error(e);
                },
            };
        };
        return .Ok(members);
    };

    file_private parse_trait_method_sig(self) Result[CstDecl] = {
        let vis = self.eat_vis();
        let name = when self.expect_ident("method name") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let gp = when self.parse_generic_params() in {
            .Ok(g) then g,
            .Error(e) then {
                return .Error(e);
            },
        };
        let lp = when self.expect(.LParen(), "'('") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let mutable params = List[CstTraitMethodParam].new();
        let mutable first UInt = 1;
        // Positional params must come before named params -- see parse_params.
        let mutable seen_named = false;
        while not self.check(.RParen()) and not self.is_eof() then {
            // `self` is the only receiver form -- see the note in parse_params.
            if first == 1 and self.check(.Star()) then {
                return .Error(
                    "Parse error: Invalid receiver parameter syntax: use 'self' only",
                );
            };
            if self.peek() is .KwSelf() then {
                let kw = self.eat();
                let comma = self.eat_comma();
                params.push(.SelfParam(kw, .None(), comma));
                first = 0;
                continue;
            };
            // [mutable] name Type          -- positional
            // [mutable] name: Type         -- named (called with a label)
            // Trait members follow func-param (grammar.bnf <method-param-list>),
            // so both forms and the optional `mutable` apply here too.
            let mutable param_mut = Option[Token].None();
            if self.check(.KwMut()) then {
                param_mut = .Some(self.eat());
            };
            let pname = when self.expect_ident("parameter name") in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let mutable colon = Option[Token].None();
            if self.check(.Colon()) then {
                colon = .Some(self.eat());
                seen_named = true;
            } else if seen_named then {
                return .Error(
                    "Parse error: Positional parameter '\(pname.to_string())' cannot appear after named parameters",
                );
            };
            let pt = when self.parse_type_node() in {
                .Ok(t) then t,
                .Error(e) then {
                    return .Error(e);
                },
            };
            // Only named parameters (with a colon) may carry a default.
            if colon is .None() and self.check(.Eq()) then {
                return .Error(
                    "Parse error: Default values are only allowed for named parameters (use 'name: Type = value' syntax)",
                );
            };
            let default_value = when self.parse_default_value() in {
                .Ok(d) then d,
                .Error(e) then {
                    return .Error(e);
                },
            };
            let comma = self.eat_comma();
            params.push(.NamedParam(pname, param_mut, colon, pt, default_value, comma));
            first = 0;
        };
        let rp = when self.expect(.RParen(), "')'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        // Return type (optional)
        let mutable ret = Option[CstType].None();
        if not self.check(.RBrace()) and not self.is_eof() then {
            if self.peek_raw() is not .Newline() then {
                let t = when self.parse_type_node() in {
                    .Ok(parsed_type) then parsed_type,
                    .Error(e) then {
                        return .Error(e);
                    },
                };
                ret = .Some(t);
            };
        };
        return .Ok(.TraitMethod(vis, gp, name, lp, params, rp, ret));
    };

    // ========================================================================
    // Given declaration
    // ========================================================================

    file_private parse_given_decl(self) Result[CstDecl] = {
        let vis = self.eat_vis();
        let kw = when self.expect(.KwGiven(), "'given'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        // `intrinsic` sits immediately after `given`: `given intrinsic Int`.
        let mods = self.eat_kind_modifiers();
        let gp = when self.parse_generic_params() in {
            .Ok(g) then g,
            .Error(e) then {
                return .Error(e);
            },
        };

        // Target type (may be complex like [T, R]EnumerateStream)
        let target = when self.parse_type_node() in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };

        let mutable as_kw = Option[Token].None();
        let mutable trait_type = Option[CstType].None();
        if self.check(.KwAs()) then {
            as_kw = when self.expect(.KwAs(), "'as'") in {
                .Ok(t) then .Some(t),
                .Error(e) then {
                    return .Error(e);
                },
            };
            trait_type = when self.parse_type_node() in {
                .Ok(t) then .Some(t),
                .Error(e) then {
                    return .Error(e);
                },
            };
        };

        let lb = when self.expect(.LBrace(), "'{'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        let members = when self.parse_member_items() in {
            .Ok(ms) then ms,
            .Error(e) then {
                return .Error(e);
            },
        };
        let rb = when self.expect(.RBrace(), "'}'") in {
            .Ok(t) then t,
            .Error(e) then {
                return .Error(e);
            },
        };
        return .Ok(
            .Given(vis, mods, kw, gp, target, as_kw, trait_type, lb, members, rb),
        );
    };

    // ========================================================================
    // Member items (shared by trait/given)
    // ========================================================================

    file_private parse_member_items(self) Result[List[CstItem]] = {
        let mutable members = List[CstItem].new();
        while not self.check(.RBrace()) and not self.is_eof() then {
            let nl_count = self.count_newlines();
            if nl_count >= 2 then {
                self.skip_newlines();
                members.push(CstItem.BlankLine());
                continue;
            };
            self.skip_newlines();
            if self.check(.RBrace()) or self.is_eof() then {
                break;
            };
            if self.check(.Semi()) then {
                self.eat();
                continue;
            };
            if self.peek() is .LineComment(_) or is .BlockComment(_) then {
                let c = self.eat();
                let prev_is_code = self.last_item_is_code(members);
                if nl_count == 0 and prev_is_code then {
                    members.push(CstItem.TrailingComment(c));
                } else {
                    members.push(CstItem.Comment(c));
                };
                continue;
            };
            // Determine if this is a let-decl or a method without let, peeking
            // past every leading modifier regardless of the order it was written in.
            let offset UInt = self.modifier_token_count();
            let kw = self.peek_at_skip_nl(offset);
            when kw in {
                .KwLet() then {
                    when self.parse_let_decl() in {
                        .Ok(d) then {
                            when self.eat_decl_semi() in {
                                .Ok(_) then {},
                                .Error(e) then {
                                    return .Error(e);
                                },
                            };
                            members.push(CstItem.Decl(d));
                        },
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                },
                _ then {
                    // Method without let keyword
                    when self.parse_member_no_let() in {
                        .Ok(d) then {
                            when self.eat_decl_semi() in {
                                .Ok(_) then {},
                                .Error(e) then {
                                    return .Error(e);
                                },
                            };
                            members.push(CstItem.Decl(d));
                        },
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                },
            };
        };
        return .Ok(members);
    };

    file_private parse_member_no_let(self) Result[CstDecl] = {
        let vis = self.eat_vis();
        // Generic params and name are handled by finish_func_or_var. Members
        // carry no `foreign` / `intrinsic` qualifiers.
        return self.finish_func_or_var(vis, List[Token].new(), .None(), .None(), true);
    };
};
