// ============================================================================
// Koral Syntax - Tokenizer
// ============================================================================

// ============================================================================
// Token Type Definition
// ============================================================================

public type Token {
    // Keywords
    KwLet(),
    KwMut(),
    KwIf(),
    KwThen(),
    KwElse(),
    KwWhile(),
    KwFor(),
    KwUnsafe(),
    KwWhen(),
    KwIn(),
    KwIs(),
    KwAnd(),
    KwOr(),
    KwNot(),
    KwType(),
    KwTrait(),
    KwGiven(),
    KwAs(),
    KwUsing(),
    KwForeign(),
    KwIntrinsic(),
    KwSelf(),
    KwSelfType(),
    KwReturn(),
    KwBreak(),
    KwContinue(),
    KwDefer(),
    KwIt(),
    KwPtr(),
    Bang(),
    KwWeakref(),
    KwPublic(),
    KwPrivate(),
    KwProtected(),
    KwProtectedPublic(),

    // Literals
    BoolTrue(),
    BoolFalse(),
    IntLit(text String),
    FloatLit(text String),
    StrLit(text String),
    InterpStr(text String),

    // Identifier
    Ident(name String),

    // Arithmetic operators
    Plus(),
    Minus(),
    Star(),
    Slash(),
    Percent(),

    // Comparison operators
    EqEq(),
    NotEq(),
    Gt(),
    Lt(),
    GtEq(),
    LtEq(),

    // Assignment
    Eq(),

    // Compound assignment operators
    PlusEq(),
    MinusEq(),
    StarEq(),
    SlashEq(),
    PercentEq(),
    AmpEq(),
    PipeEq(),
    CaretEq(),
    LShiftEq(),
    RShiftEq(),

    // Bitwise operators
    Amp(),
    Pipe(),
    Caret(),
    Tilde(),
    LShift(),
    RShift(),

    // Arrow
    Arrow(),

    // Range operators
    Range(),
    RangeLt(),
    LtRange(),
    LtRangeLt(),
    // `...` exists only to reject it where an old default-fill spelling used
    // to live; it is never a range operator (grammar.bnf <range-op>).
    Ellipsis(),

    // Delimiters
    LParen(),
    RParen(),
    LBrace(),
    RBrace(),
    LBracket(),
    RBracket(),

    // Punctuation
    Semi(),
    Comma(),
    Colon(),
    Dot(),

    // Comments
    LineComment(text String),
    BlockComment(text String),

    // Whitespace
    Newline(),

    // Special
    Underscore(),
    EOF(),
};

// ============================================================================
// Token Methods
// ============================================================================

given Token {

    public to_string(self) String = when self in {
        .KwLet() then "let",
        .KwMut() then "mutable",
        .KwIf() then "if",
        .KwUnsafe() then "unsafe",
        .KwThen() then "then",
        .KwElse() then "else",
        .KwWhile() then "while",
        .KwFor() then "for",
        .KwWhen() then "when",
        .KwIn() then "in",
        .KwIs() then "is",
        .KwAnd() then "and",
        .KwOr() then "or",
        .KwNot() then "not",
        .KwType() then "type",
        .KwTrait() then "trait",
        .KwGiven() then "given",
        .KwAs() then "as",
        .KwUsing() then "using",
        .KwForeign() then "foreign",
        .KwIntrinsic() then "intrinsic",
        .KwSelf() then "self",
        .KwSelfType() then "Self",
        .KwReturn() then "return",
        .KwBreak() then "break",
        .KwContinue() then "continue",
        .KwDefer() then "defer",
        .KwIt() then "it",
        .KwPtr() then "*",
        .Bang() then "!",
        .KwWeakref() then "?",
        .KwPublic() then "public",
        .KwPrivate() then "file_private",
        .KwProtected() then "module_private",
        .KwProtectedPublic() then "package_private",
        .BoolTrue() then "true",
        .BoolFalse() then "false",
        .IntLit(t) then t,
        .FloatLit(t) then t,
        .StrLit(t) then t,
        .InterpStr(t) then t,
        .Ident(n) then n,
        .Plus() then "+",
        .Minus() then "-",
        .Star() then "*",
        .Slash() then "/",
        .Percent() then "%",
        .EqEq() then "==",
        .NotEq() then "<>",
        .Gt() then ">",
        .Lt() then "<",
        .GtEq() then ">=",
        .LtEq() then "<=",
        .Eq() then "=",
        .PlusEq() then "+=",
        .MinusEq() then "-=",
        .StarEq() then "*=",
        .SlashEq() then "/=",
        .PercentEq() then "%=",
        .AmpEq() then "&=",
        .PipeEq() then "|=",
        .CaretEq() then "^=",
        .LShiftEq() then "<<=",
        .RShiftEq() then ">>=",
        .Amp() then "&",
        .Pipe() then "|",
        .Caret() then "^",
        .Tilde() then "~",
        .LShift() then "<<",
        .RShift() then ">>",
        .Arrow() then "->",
        .Range() then "..",
        .RangeLt() then "..<",
        .LtRange() then "<..",
        .LtRangeLt() then "<..<",
        .Ellipsis() then "...",
        .LParen() then "(",
        .RParen() then ")",
        .LBrace() then "{",
        .RBrace() then "}",
        .LBracket() then "[",
        .RBracket() then "]",
        .Semi() then ";",
        .Comma() then ",",
        .Colon() then ":",
        .Dot() then ".",
        .LineComment(t) then t,
        .BlockComment(t) then t,
        .Newline() then "\n",
        .Underscore() then "_",
        .EOF() then "",
    };

    public is_keyword(self) Bool = when self in {
        .KwLet() or .KwMut() or .KwIf() or .KwThen() or .KwElse() or .KwWhile() or .KwFor() or .KwUnsafe() or .KwWhen() or .KwIn() or .KwIs() or .KwAnd() or .KwOr() or .KwNot() or .KwType() or .KwTrait() or .KwGiven() or .KwAs() or .KwUsing() or .KwForeign() or .KwIntrinsic() or .KwSelf() or .KwSelfType() or .KwReturn() or .KwBreak() or .KwContinue() or .KwDefer() or .KwIt() or .KwPtr() or .Bang() or .KwWeakref() or .KwPublic() or .KwPrivate() or .KwProtected() or .KwProtectedPublic() then true,
        _ then false,
    };

    public is_binary_op(self) Bool = when self in {
        .Plus() or .Minus() or .Star() or .Slash() or .Percent() or .EqEq() or .NotEq() or .Gt() or .Lt() or .GtEq() or .LtEq() or .Eq() or .PlusEq() or .MinusEq() or .StarEq() or .SlashEq() or .PercentEq() or .AmpEq() or .PipeEq() or .CaretEq() or .LShiftEq() or .RShiftEq() or .Amp() or .Pipe() or .Caret() or .LShift() or .RShift() or .KwAnd() or .KwOr() then true,
        _ then false,
    };

    public is_range_op(self) Bool = when self in {
        .Range() or .RangeLt() or .LtRange() or .LtRangeLt() then true,
        _ then false,
    };

    public is_prefix_op(self) Bool = when self in {
        .KwNot() or .Tilde() then true,
        _ then false,
    };

    public is_open_delim(self) Bool = when self in {
        .LParen() or .LBrace() or .LBracket() then true,
        _ then false,
    };

    public is_close_delim(self) Bool = when self in {
        .RParen() or .RBrace() or .RBracket() then true,
        _ then false,
    };

    public tag(t Token) Int = when t in {
        .KwLet() then 1,
        .KwMut() then 2,
        .KwIf() then 3,
        .KwThen() then 4,
        .KwElse() then 5,
        .KwWhile() then 6,
        .KwFor() then 7,
        .KwWhen() then 8,
        .KwIn() then 9,
        .KwIs() then 10,
        .KwAnd() then 11,
        .KwOr() then 12,
        .KwNot() then 13,
        .KwType() then 14,
        .KwTrait() then 15,
        .KwGiven() then 16,
        .KwAs() then 17,
        .KwUsing() then 18,
        .KwForeign() then 19,
        .KwIntrinsic() then 20,
        .KwSelf() then 21,
        .KwSelfType() then 22,
        .KwReturn() then 23,
        .KwBreak() then 24,
        .KwContinue() then 25,
        .KwDefer() then 94,
        .KwIt() then 94,
        .KwUnsafe() then 102,
        .KwPtr() then 96,
        .Bang() then 97,
        .KwWeakref() then 100,
        .KwPublic() then 30,
        .KwPrivate() then 31,
        .KwProtected() then 32,
        .KwProtectedPublic() then 101,
        .BoolTrue() then 34,
        .BoolFalse() then 35,
        .IntLit(_) then 36,
        .FloatLit(_) then 37,
        .StrLit(_) then 38,
        .InterpStr(_) then 39,
        .Ident(_) then 40,
        .Plus() then 41,
        .Minus() then 42,
        .Star() then 43,
        .Slash() then 44,
        .Percent() then 45,
        .EqEq() then 46,
        .NotEq() then 47,
        .Gt() then 48,
        .Lt() then 49,
        .GtEq() then 50,
        .LtEq() then 51,
        .Eq() then 52,
        .PlusEq() then 53,
        .MinusEq() then 54,
        .StarEq() then 55,
        .SlashEq() then 56,
        .PercentEq() then 57,
        .AmpEq() then 58,
        .PipeEq() then 59,
        .CaretEq() then 60,
        .LShiftEq() then 61,
        .RShiftEq() then 62,
        .Amp() then 63,
        .Pipe() then 64,
        .Caret() then 65,
        .Tilde() then 66,
        .LShift() then 67,
        .RShift() then 68,
        .Arrow() then 69,
        .Range() then 70,
        .RangeLt() then 71,
        .LtRange() then 72,
        .LtRangeLt() then 73,
        .Ellipsis() then 74,
        .LParen() then 78,
        .RParen() then 79,
        .LBrace() then 80,
        .RBrace() then 81,
        .LBracket() then 82,
        .RBracket() then 83,
        .Semi() then 84,
        .Comma() then 85,
        .Colon() then 86,
        .Dot() then 87,
        .LineComment(_) then 88,
        .BlockComment(_) then 89,
        .Newline() then 90,
        .Underscore() then 91,
        .EOF() then 92,
    };
};

// ============================================================================
// Tokenizer
// ============================================================================

public type mutable Tokenizer(runes List[Rune], mutable pos UInt);

given Tokenizer {

    public new(source String) Tokenizer = Tokenizer(source.to_runes(), 0);

    // Peek at current rune without consuming
    file_private peek(self) Option[Rune] = if self.pos >= self.runes.count() then .None()
    else .Some(self.runes[self.pos]);

    // Peek at rune at offset from current position
    file_private peek_at(self, offset UInt) Option[Rune] = {
        let idx = self.pos + offset;
        return if idx >= self.runes.count() then .None() else .Some(self.runes[idx]);
    };

    // Advance and return current rune
    file_private advance(self) Rune = {
        let r = self.runes[self.pos];
        self.pos += 1;
        return r;
    };

    // Check if at end
    file_private is_eof(self) Bool = self.pos >= self.runes.count();

    // Check if rune equals a specific character
    file_private rune_eq(r Rune, ch Rune) Bool = r == ch;

    // ========================================================================
    // Main tokenize entry point
    // ========================================================================

    public tokenize(self) Result[List[Token]] = {
        let mutable tokens = List[Token].new();

        while not self.is_eof() then {
            let r = self.runes[self.pos];
            let cp = r.to_uint32();

            // Skip carriage return (Windows line endings)
            if Tokenizer.rune_eq(r, '\r') then {
                self.pos += 1;
                continue;
            };

            // Emit newline tokens, skip other whitespace
            if Tokenizer.rune_eq(r, '\n') then {
                self.pos += 1;
                tokens.push(Token.Newline());
                continue;
            };
            if r.is_ascii_whitespace() then {
                self.pos += 1;
                continue;
            };

            // Line comment: //
            if Tokenizer.rune_eq(r, '/') then {
                if self.peek_at(1) is .Some(r2) then {
                    if Tokenizer.rune_eq(r2, '/') then {
                        tokens.push(self.scan_line_comment());
                        continue;
                    };
                    if Tokenizer.rune_eq(r2, '*') then {
                        let comment_tok = self.scan_block_comment() or return;
                        tokens.push(comment_tok);
                        continue;
                    };
                };
            };

            // String literal
            if Tokenizer.rune_eq(r, '"') then {
                let tok = self.scan_string() or return;
                tokens.push(tok);
                continue;
            };

            // Number literal
            if r.is_ascii_digit() then {
                let num_tok = self.scan_number() or return;
                tokens.push(num_tok);
                continue;
            };

            // Weak reference prefix: `?T`. A bare `?` used to fall through to
            // the unknown-character case and be thrown away, which turned
            // `?T` into `T` -- a type change no later check could see, since
            // the character was gone before anything looked at it. The legacy
            // `?*` spelling is rejected the way the compiler rejects it.
            if Tokenizer.rune_eq(r, '?') then {
                if self.peek_at(1) is .Some(n) and Tokenizer.rune_eq(n, '*') then {
                    return .Error("Weak reference syntax is '?T', not legacy '?*T'");
                };
                self.pos += 1;
                let weakref_kw = Token.KwWeakref();
                tokens.push(weakref_kw);
                continue;
            };

            // Identifier or keyword
            if r.is_identifier_start() then {
                tokens.push(self.scan_identifier());
                continue;
            };

            // Operators and punctuation
            if self.scan_operator() is .Some(tok) then {
                tokens.push(tok);
                continue;
            };

            // Unknown character - skip
            self.pos += 1;
        };

        tokens.push(.EOF());
        return .Ok(tokens);
    };

    // ========================================================================
    // Line comment: // ...
    // ========================================================================

    file_private scan_line_comment(self) Token = {
        let mutable text = StringBuilder.new();
        // Consume // and rest of line, but don't consume the newline
        while not self.is_eof() then {
            let r = self.runes[self.pos];
            if Tokenizer.rune_eq(r, '\n') or Tokenizer.rune_eq(r, '\r') then {
                break;
            };
            text.push_string(r.to_string());
            self.pos += 1;
        };
        return Token.LineComment(text.to_string());
    };

    // ========================================================================
    // Block comment: /* ... */
    // ========================================================================

    // Comments do not nest -- the first `*/` ends the comment, and one that
    // never closes is an error, exactly as koralc lexes it.
    file_private scan_block_comment(self) Result[Token] = {
        let mutable text = StringBuilder.new();
        text.push_string("/*");
        self.pos += 2;
        while not self.is_eof() then {
            let r = self.runes[self.pos];
            if Tokenizer.rune_eq(r, '*') and self.peek_at(1) is .Some(r2) and Tokenizer.rune_eq(r2, '/') then {
                text.push_string(r.to_string());
                text.push_string(r2.to_string());
                self.pos += 2;
                return .Ok(.BlockComment(text.to_string()));
            };
            text.push_string(r.to_string());
            self.pos += 1;
        };
        return .Error("Unterminated block comment");
    };

    // ========================================================================
    // String literal: "..." or "\(...)" interpolation
    // ========================================================================

    file_private scan_string(self) Result[Token] = {
        if self.peek_at(1) is .Some(q1) and Tokenizer.rune_eq(q1, '"') then {
            if self.peek_at(2) is .Some(q2) and Tokenizer.rune_eq(q2, '"') then {
                return self.scan_multiline_string();
            };
        };

        let mutable text = StringBuilder.new();
        text.push_byte('"');
        self.pos += 1; // skip opening "
        let mutable is_interp = false;

        while not self.is_eof() then {
            let r = self.runes[self.pos];

            // End of string
            if Tokenizer.rune_eq(r, '"') then {
                text.push_byte('"');
                self.pos += 1;
                if is_interp then {
                    return .Ok(.InterpStr(text.to_string()));
                };
                return .Ok(.StrLit(text.to_string()));
            };

            // Escape sequence
            if Tokenizer.rune_eq(r, '\\') then {
                text.push_string(r.to_string());
                self.pos += 1;
                if not self.is_eof() then {
                    let next = self.runes[self.pos];
                    // Interpolation: \(...)
                    if Tokenizer.rune_eq(next, '(') then {
                        is_interp = true;
                        text.push_string(next.to_string());
                        self.pos += 1;
                        // Consume until matching )
                        let mutable depth UInt = 1;
                        while not self.is_eof() and depth > 0 then {
                            let ir = self.runes[self.pos];
                            if Tokenizer.rune_eq(ir, '(') then {
                                depth += 1;
                            };
                            if Tokenizer.rune_eq(ir, ')') then {
                                depth -= 1;
                            };
                            text.push_string(ir.to_string());
                            self.pos += 1;
                        };
                    } else {
                        text.push_string(next.to_string());
                        self.pos += 1;
                    };
                };
                continue;
            };

            // Newline inside string - error
            if Tokenizer.rune_eq(r, '\n') then {
                return .Error("unterminated string literal");
            };

            text.push_string(r.to_string());
            self.pos += 1;
        };

        return Result[Token].Error("unterminated string literal");
    };

    file_private scan_multiline_string(self) Result[Token] = {
        let mutable text = StringBuilder.new();
        text.push_string("\"\"\"");
        self.pos += 3;
        let mutable is_interp = false;

        while not self.is_eof() then {
            if self.peek() is .Some(r0) and Tokenizer.rune_eq(r0, '"') then {
                if self.peek_at(1) is .Some(r1) and Tokenizer.rune_eq(r1, '"') then {
                    if self.peek_at(2) is .Some(r2) and Tokenizer.rune_eq(r2, '"') then {
                        text.push_string("\"\"\"");
                        self.pos += 3;
                        if is_interp then {
                            return .Ok(.InterpStr(text.to_string()));
                        };
                        return .Ok(.StrLit(text.to_string()));
                    };
                };
            };

            let r = self.runes[self.pos];
            if Tokenizer.rune_eq(r, '\\') then {
                text.push_string(r.to_string());
                self.pos += 1;
                if not self.is_eof() then {
                    let next = self.runes[self.pos];
                    if Tokenizer.rune_eq(next, '(') then {
                        is_interp = true;
                        text.push_string(next.to_string());
                        self.pos += 1;
                        let mutable depth UInt = 1;
                        while not self.is_eof() and depth > 0 then {
                            let ir = self.runes[self.pos];
                            if Tokenizer.rune_eq(ir, '(') then {
                                depth += 1;
                            };
                            if Tokenizer.rune_eq(ir, ')') then {
                                depth -= 1;
                            };
                            text.push_string(ir.to_string());
                            self.pos += 1;
                        };
                    } else {
                        text.push_string(next.to_string());
                        self.pos += 1;
                    };
                };
                continue;
            };

            text.push_string(r.to_string());
            self.pos += 1;
        };

        return .Error("unterminated string literal");
    };

    // ========================================================================
    // Number literal
    // ========================================================================

    // Number literal. The source spelling is kept verbatim in the token text
    // (a formatter may not rewrite literals), but the shape is validated the
    // way koralc lexes it:
    //   - `0b` / `0o` / `0x` (lowercase) open a base literal carrying only
    //     that base's digits, and no fraction.
    //   - `_` sits between two digits of the same run; it may not lead, trail,
    //     double, or touch `.`.
    //   - A decimal literal may not carry leading zeros (write `0o7`).
    //   - Only lowercase `e` opens an exponent, and only before a digit or
    //     [sign] digit (`1exp` is `1` then `exp`).
    //   - Duration suffixes are `s` / `ms` / `us` / `ns`, integers only.
    file_private scan_number(self) Result[Token] = {
        if Tokenizer.rune_eq(self.runes[self.pos], '0') and self.peek_at(1) is .Some(p) then {
            if Tokenizer.rune_eq(p, 'b') then {
                return self.scan_base_number("0b", "01");
            };
            if Tokenizer.rune_eq(p, 'o') then {
                return self.scan_base_number("0o", "01234567");
            };
            if Tokenizer.rune_eq(p, 'x') then {
                return self.scan_base_number("0x", "0123456789abcdefABCDEF");
            };
        };
        return self.scan_decimal_number();
    };

    // `0b12` blames the stray digit, `0x1.a` is a fraction attempt, and a
    // prefix with no digits at all is an error -- `0body` is `0b` + `ody`.
    file_private scan_base_number(self, prefix String, valid String) Result[Token] = {
        let mutable text = StringBuilder.new();
        text.push_string(prefix);
        self.pos += 2;
        let mutable digit_count UInt = 0;
        let mutable last_was_digit Bool = false;
        while not self.is_eof() then {
            let r = self.runes[self.pos];
            if valid.contains(r.to_string()) then {
                text.push_string(r.to_string());
                self.pos += 1;
                digit_count += 1;
                last_was_digit = true;
            } else if Tokenizer.rune_eq(r, '_') then {
                if last_was_digit and self.peek_at(1) is .Some(n) and valid.contains(n.to_string()) then {
                    text.push_string(r.to_string());
                    text.push_string(n.to_string());
                    self.pos += 2;
                    digit_count += 1;
                    last_was_digit = true;
                } else {
                    return .Error("Invalid digit separator '_' in numeric literal");
                };
            } else if r.is_ascii_digit() then {
                return .Error("Invalid digit '" + r.to_string() + "' in " + prefix + " literal");
            } else if Tokenizer.rune_eq(r, '.') then {
                if self.peek_at(1) is .Some(n) then {
                    if n.is_ascii_digit() or valid.contains(n.to_string()) then {
                        return .Error(prefix + " literals do not support floating point");
                    };
                };
                break;
            } else {
                break;
            };
        };
        if digit_count == 0 then {
            return .Error(prefix + " literal must have at least one digit");
        };
        return .Ok(.IntLit(text.to_string()));
    };

    file_private scan_decimal_number(self) Result[Token] = {
        let mutable text = StringBuilder.new();
        let mutable is_float = false;
        let mutable last_was_digit Bool = false;
        let mutable int_digits UInt = 0;
        let mutable leading_zero Bool = false;
        let mutable in_integer Bool = true;

        while not self.is_eof() then {
            let r = self.runes[self.pos];
            if r.is_ascii_digit() then {
                if in_integer then {
                    if int_digits == 0 and Tokenizer.rune_eq(r, '0') then {
                        leading_zero = true;
                    };
                    int_digits += 1;
                };
                text.push_string(r.to_string());
                self.pos += 1;
                last_was_digit = true;
            } else if Tokenizer.rune_eq(r, '_') then {
                if last_was_digit and self.peek_at(1) is .Some(n) and n.is_ascii_digit() then {
                    text.push_string(r.to_string());
                    text.push_string(n.to_string());
                    self.pos += 2;
                    if in_integer then {
                        int_digits += 1;
                    };
                    last_was_digit = true;
                } else {
                    return .Error("Invalid digit separator '_' in numeric literal");
                };
            } else if Tokenizer.rune_eq(r, '.') then {
                // `..` / `..<` are range operators, and a `.` that is not
                // followed by a digit is member access -- neither one is a
                // decimal point.
                if self.peek_at(1) is .Some(n) then {
                    if Tokenizer.rune_eq(n, '.') or Tokenizer.rune_eq(n, '<') then {
                        break;
                    };
                    if not n.is_ascii_digit() then {
                        break;
                    };
                } else {
                    break;
                };
                if is_float then {
                    return .Error("consecutive dots are not allowed");
                };
                is_float = true;
                in_integer = false;
                text.push_string(r.to_string());
                self.pos += 1;
                last_was_digit = false;
            } else if Tokenizer.rune_eq(r, 'e') then {
                // `e` opens an exponent only before a digit or [sign] digit.
                let mutable starts_exponent Bool = false;
                if self.peek_at(1) is .Some(n) then {
                    if n.is_ascii_digit() then {
                        starts_exponent = true;
                    } else if Tokenizer.rune_eq(n, '+') or Tokenizer.rune_eq(n, '-') then {
                        if self.peek_at(2) is .Some(n2) and n2.is_ascii_digit() then {
                            starts_exponent = true;
                        };
                    };
                };
                if not starts_exponent then {
                    break;
                };
                is_float = true;
                in_integer = false;
                text.push_string(r.to_string());
                self.pos += 1;
                if self.peek() is .Some(s) then {
                    if Tokenizer.rune_eq(s, '+') or Tokenizer.rune_eq(s, '-') then {
                        text.push_string(s.to_string());
                        self.pos += 1;
                    };
                };
                last_was_digit = false;
                while not self.is_eof() then {
                    let er = self.runes[self.pos];
                    if er.is_ascii_digit() then {
                        text.push_string(er.to_string());
                        self.pos += 1;
                        last_was_digit = true;
                    } else if Tokenizer.rune_eq(er, '_') then {
                        if last_was_digit and self.peek_at(1) is .Some(n) and n.is_ascii_digit() then {
                            text.push_string(er.to_string());
                            text.push_string(n.to_string());
                            self.pos += 2;
                            last_was_digit = true;
                        } else {
                            return .Error("Invalid digit separator '_' in numeric literal");
                        };
                    } else {
                        break;
                    };
                };
            } else {
                break;
            };
        };

        if int_digits > 1 and leading_zero then {
            return .Error("Leading zeros are not allowed in integer literals");
        };

        if not is_float and self.scan_duration_suffix(text) then {
            return .Ok(.IntLit(text.to_string()));
        };
        if is_float then {
            return .Ok(.FloatLit(text.to_string()));
        };
        return .Ok(.IntLit(text.to_string()));
    };

    // `s` / `ms` / `us` / `ns`, and only when no identifier character
    // follows: `10s2` is `10` then `s2`, not a duration. The suffix is
    // appended to `text` only on a match, so a failure leaves `self.pos` (and
    // the literal text) untouched.
    file_private scan_duration_suffix(self, text StringBuilder) Bool = {
        let start = self.pos;
        let mutable letters = StringBuilder.new();
        while not self.is_eof() and self.runes[self.pos].is_ascii_alphabetic() then {
            letters.push_string(self.runes[self.pos].to_string());
            self.pos += 1;
        };
        let word = letters.to_string();
        let mutable matched = word == "s" or word == "ms" or word == "us" or word == "ns";
        if matched and not self.is_eof() then {
            if self.runes[self.pos].is_identifier_continue() then {
                matched = false;
            };
        };
        if matched then {
            text.push_string(word);
            return true;
        };
        self.pos = start;
        return false;
    };

    // ========================================================================
    // Identifier or keyword
    // ========================================================================

    file_private scan_identifier(self) Token = {
        let mutable text = StringBuilder.new();
        while not self.is_eof() then {
            let r = self.runes[self.pos];
            if r.is_identifier_continue() then {
                text.push_string(r.to_string());
                self.pos += 1;
            } else {
                break;
            };
        };

        // Match keywords using when expression
        return when text.to_string() in {
            "let" then .KwLet(),
            "mutable" then .KwMut(),
            "if" then .KwIf(),
            "then" then .KwThen(),
            "else" then .KwElse(),
            "while" then .KwWhile(),
            "for" then .KwFor(),
            "when" then .KwWhen(),
            "in" then .KwIn(),
            "is" then .KwIs(),
            "and" then .KwAnd(),
            "or" then .KwOr(),
            "not" then .KwNot(),
            "type" then .KwType(),
            "trait" then .KwTrait(),
            "given" then .KwGiven(),
            "as" then .KwAs(),
            "using" then .KwUsing(),
            "foreign" then .KwForeign(),
            "intrinsic" then .KwIntrinsic(),
            "self" then .KwSelf(),
            "Self" then .KwSelfType(),
            "return" then .KwReturn(),
            "break" then .KwBreak(),
            "continue" then .KwContinue(),
            "defer" then .KwDefer(),
            "it" then .KwIt(),
            "unsafe" then .KwUnsafe(),
            "public" then .KwPublic(),
            "file_private" then .KwPrivate(),
            "module_private" then .KwProtected(),
            "package_private" then .KwProtectedPublic(),
            "true" then .BoolTrue(),
            "false" then .BoolFalse(),
            _ then .Ident(text.to_string()),
        };
    };

    // ========================================================================
    // Operators and punctuation
    // ========================================================================

    file_private scan_operator(self) Option[Token] = {
        let r = self.runes[self.pos];
        let cp = r.to_uint32();

        // Single-char tokens
        // '(' ')' '{' '}' '[' ']' ';' ',' ':' '~'
        if cp == 40 then {
            self.pos += 1;
            return .Some(.LParen());
        };
        if cp == 41 then {
            self.pos += 1;
            return .Some(.RParen());
        };
        if cp == 123 then {
            self.pos += 1;
            return .Some(.LBrace());
        };
        if cp == 125 then {
            self.pos += 1;
            return .Some(.RBrace());
        };
        if cp == 91 then {
            self.pos += 1;
            return .Some(.LBracket());
        };
        if cp == 93 then {
            self.pos += 1;
            return .Some(.RBracket());
        };
        if cp == 59 then {
            self.pos += 1;
            return .Some(.Semi());
        };
        if cp == 44 then {
            self.pos += 1;
            return .Some(.Comma());
        };
        if cp == 58 then {
            self.pos += 1;
            return .Some(.Colon());
        };
        if cp == 126 then {
            self.pos += 1;
            return .Some(.Tilde());
        };
        if cp == 33 then {
            self.pos += 1;
            return .Some(.Bang());
        };

        // + +=
        if cp == 43 then {
            self.pos += 1;
            if self.peek() is .Some(n) then {
                if Tokenizer.rune_eq(n, '=') then {
                    self.pos += 1;
                    return .Some(.PlusEq());
                };
            };
            return .Some(.Plus());
        };

        // - -= ->
        if cp == 45 then {
            self.pos += 1;
            if self.peek() is .Some(n) then {
                if Tokenizer.rune_eq(n, '=') then {
                    self.pos += 1;
                    return .Some(.MinusEq());
                };
                if Tokenizer.rune_eq(n, '>') then {
                    self.pos += 1;
                    return .Some(.Arrow());
                };
            };
            return .Some(.Minus());
        };

        // * *=
        if cp == 42 then {
            if self.peek_at(1) is .Some(n) then {
                if Tokenizer.rune_eq(n, '=') then {
                    self.pos += 2;
                    return .Some(.StarEq());
                };
            };
            self.pos += 1;
            return .Some(.Star());
        };

        // / /= (// and /* handled earlier)
        if cp == 47 then {
            self.pos += 1;
            if self.peek() is .Some(n) then {
                if Tokenizer.rune_eq(n, '=') then {
                    self.pos += 1;
                    return .Some(.SlashEq());
                };
            };
            return .Some(.Slash());
        };

        // % %=
        if cp == 37 then {
            self.pos += 1;
            if self.peek() is .Some(n) then {
                if Tokenizer.rune_eq(n, '=') then {
                    self.pos += 1;
                    return .Some(.PercentEq());
                };
            };
            return .Some(.Percent());
        };

        // = ==
        if cp == 61 then {
            self.pos += 1;
            if self.peek() is .Some(n) then {
                if Tokenizer.rune_eq(n, '=') then {
                    self.pos += 1;
                    return .Some(.EqEq());
                };
            };
            return .Some(.Eq());
        };

        // < <= << <<= <> <.. <..<
        if cp == 60 then {
            self.pos += 1;
            if self.peek() is .Some(n) then {
                if Tokenizer.rune_eq(n, '=') then {
                    self.pos += 1;
                    return .Some(.LtEq());
                };
                if Tokenizer.rune_eq(n, '>') then {
                    self.pos += 1;
                    return .Some(.NotEq());
                };
                if Tokenizer.rune_eq(n, '<') then {
                    self.pos += 1;
                    if self.peek() is .Some(n2) then {
                        if Tokenizer.rune_eq(n2, '=') then {
                            self.pos += 1;
                            return .Some(.LShiftEq());
                        };
                    };
                    return .Some(.LShift());
                };
                if Tokenizer.rune_eq(n, '.') then {
                    self.pos += 1;
                    if self.peek() is .Some(n2) then {
                        if Tokenizer.rune_eq(n2, '.') then {
                            self.pos += 1;
                            if self.peek() is .Some(n3) then {
                                if Tokenizer.rune_eq(n3, '<') then {
                                    self.pos += 1;
                                    return .Some(.LtRangeLt());
                                };
                            };
                            return .Some(.LtRange());
                        };
                    };
                    // Just `<.` - put back and return Lt
                    self.pos -= 1;
                };
            };
            return .Some(.Lt());
        };

        // > >= >> >>=
        if cp == 62 then {
            self.pos += 1;
            if self.peek() is .Some(n) then {
                if Tokenizer.rune_eq(n, '=') then {
                    self.pos += 1;
                    return .Some(.GtEq());
                };
                if Tokenizer.rune_eq(n, '>') then {
                    self.pos += 1;
                    if self.peek() is .Some(n2) then {
                        if Tokenizer.rune_eq(n2, '=') then {
                            self.pos += 1;
                            return .Some(.RShiftEq());
                        };
                    };
                    return .Some(.RShift());
                };
            };
            return .Some(.Gt());
        };

        // . .. ..< ...
        // `...` is not a range operator: it exists only to reject the old
        // default-fill spelling. `....` is `...` followed by `.`, and `...<`
        // is `...` followed by `<` -- exactly the split koralc makes.
        if cp == 46 then {
            self.pos += 1;
            if self.peek() is .Some(n) then {
                if Tokenizer.rune_eq(n, '.') then {
                    self.pos += 1;
                    if self.peek() is .Some(n2) then {
                        if Tokenizer.rune_eq(n2, '<') then {
                            self.pos += 1;
                            return .Some(.RangeLt());
                        };
                        if Tokenizer.rune_eq(n2, '.') then {
                            self.pos += 1;
                            return .Some(.Ellipsis());
                        };
                    };
                    return .Some(.Range());
                };
            };
            return .Some(.Dot());
        };

        // & &=
        if cp == 38 then {
            self.pos += 1;
            if self.peek() is .Some(n) then {
                if Tokenizer.rune_eq(n, '=') then {
                    self.pos += 1;
                    return .Some(.AmpEq());
                };
            };
            return .Some(.Amp());
        };

        // | |=
        if cp == 124 then {
            self.pos += 1;
            if self.peek() is .Some(n) then {
                if Tokenizer.rune_eq(n, '=') then {
                    self.pos += 1;
                    return .Some(.PipeEq());
                };
            };
            return .Some(.Pipe());
        };

        // ^ ^=
        if cp == 94 then {
            self.pos += 1;
            if self.peek() is .Some(n) then {
                if Tokenizer.rune_eq(n, '=') then {
                    self.pos += 1;
                    return .Some(.CaretEq());
                };
            };
            return .Some(.Caret());
        };

        // _ (underscore as standalone token - only if not part of identifier)
        if cp == 95 then {
            // Check if next char continues an identifier
            if self.peek_at(1) is .Some(next) then {
                if next.is_identifier_continue() then {
                    // This is actually an identifier starting with _
                    return .Some(self.scan_identifier());
                };
            };
            self.pos += 1;
            return .Some(.Underscore());
        };

        // Character literal (single-quoted)
        if cp == 39 then {
            return .Some(self.scan_char_literal());
        };

        return Option[Token].None();
    };

    // ========================================================================
    // Character literal: '...'
    // ========================================================================

    file_private scan_char_literal(self) Token = {
        let mutable text = StringBuilder.new();
        text.push_byte('\'');
        self.pos += 1; // skip opening '

        while not self.is_eof() then {
            let r = self.runes[self.pos];
            if Tokenizer.rune_eq(r, '\'') then {
                text.push_byte('\'');
                self.pos += 1;
                return .IntLit(text.to_string());
            };
            if Tokenizer.rune_eq(r, '\\') then {
                text.push_string(r.to_string());
                self.pos += 1;
                if not self.is_eof() then {
                    text.push_string(self.runes[self.pos].to_string());
                    self.pos += 1;
                };
                continue;
            };
            text.push_string(r.to_string());
            self.pos += 1;
        };
        return Token.IntLit(text.to_string());
    };
};
