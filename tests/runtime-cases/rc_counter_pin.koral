// RC traffic measurement (concurrency-design.md P6). The EXACT numbers are a
// koralc-only pin -- the ARC optimizations (borrowed params, last-use moves,
// alias pair elimination) are implementation-side and the frozen seed is the
// semantic referee, deliberately carrying none -- so scripts/verify.sh greps
// the expected counts out of a bootstrap-built run (the "rc counter pins"
// stage). This file therefore lives in tests/runtime-cases (like
// weak_init_probe.koral) and is NOT a suite case: the shared suite and the
// differential oracle require identical output under both compilers, and the
// numbers are exactly what differs.
//
// Alias windows take a borrowed PARAMETER as the source: alias sources are
// non-owning by construction (their +1 is owned outside the function and
// outlives any binding window).

let foreign __koral_rc_stats_enable(): Void;
let foreign __koral_rc_stats_retains(): UInt64;
let foreign __koral_rc_stats_releases(): UInt64;
let unsafe foreign __koral_atomic_fetch_add_iptr(p: *Int, delta: Int): Int;

type mutable Box(mutable n: Int);

// Mirrors std/sync/atomic.koral's AtomicInt shape: the receiver's field
// address feeds a `__koral_atomic_*` builtin as a direct argument and never
// escapes -- rule 5a of codegen_borrowed_self lets fetch_add borrow.
type unsafe sendable mutable Counter(private mutable value: Int);

given Counter {
    fetch_add(self, delta: Int): Int =
        unsafe { __koral_atomic_fetch_add_iptr(&self.value, delta) };

    load(self): Int = self.value;
};

let read(b: Box): Int = b.n;

let alias_window(b: Box): String = {
    let r0 = __koral_rc_stats_retains();
    let alias = b;
    let _ = read(alias);
    let _ = read(b);
    let r1 = __koral_rc_stats_retains();
    return "w1_alias_retains=\(r1 - r0)";
};

let probe_move(): Void = {
    let a = Box(10);
    let x = a;
    let _ = read(x);
};

let probe_alias(b: Box): Void = {
    let alias = b;
    let _ = read(alias);
    let _ = read(b);
};

// into_frozen_list must be a storage hand-off, not a copy: three heap strings in,
// zero retains across the transfer (a copying freeze would retain each).
let freeze_window(): String = {
    let mutable xs = List[String].new();
    xs.push("a" + "1");
    xs.push("b" + "2");
    xs.push("c" + "3");
    let r0 = __koral_rc_stats_retains();
    let frozen = xs.into_frozen_list();
    let r1 = __koral_rc_stats_retains();
    let _ = frozen.count();
    return "w7_into_frozen_retains=\(r1 - r0)";
};

// init_memory 的实参是消费性使用（契约即「接管 value 的所有权」）。源局部的
// 末次使用就是该实参时，直接移动（清 init flag、store 走 move）——push 形参、
// push_list 中转量走的就是这条；源局部后处仍存活时，实参照旧复制（store
// retain），后续读的 P5/别名对消照常开火。消费只发生在移动指定点这一个位置
// （Copy 标签值的消费必须在 consume_last_use_source 就地记账），不存在双认领。
// 2026-11-14：走查不再对 init_memory 的 Copy 读整局部禁移后，本窗口的
// `let y = x` 绑定可消一对 retain/release，计数 2→1（ASan 全净、时序钉全绿）。
let init_memory_window(): String = {
    let slot = unsafe { alloc_memory[Box](UInt(1)) };
    let x = Box(4);
    let r0 = __koral_rc_stats_retains();
    unsafe { init_memory(slot, x) };
    let y = x;
    let r1 = __koral_rc_stats_retains();
    let _ = read(y);
    unsafe { deinit_memory(slot) };
    return "w8_init_memory_retains=\(r1 - r0)";
};

// 比较位借用化（2026-11-14）：`eq` 的实参槽进借用不动点后，循环里的活值
// 比较不再每轮付 copy+drop——直接派发与单态化泛型派发都按 +0 传参。窗口内
// retain/release 都必须是 0（旧账：每轮一对）。实参在窗口后仍使用，排除
// 末次使用移动的干扰。
let compare_eq[T: Eq](a: T, b: T): Bool = a == b;

let compare_window(): String = {
    let x = "hello" + " world";
    let y = "hello" + " world";
    let r0 = __koral_rc_stats_retains();
    let d0 = __koral_rc_stats_releases();
    let mutable i = 0;
    let mutable c = 0;
    while i < 4 then {
        if x == y then {
            c += 1;
        };
        if compare_eq(x, y) then {
            c += 1;
        };
        i += 1;
    };
    let r1 = __koral_rc_stats_retains();
    let d1 = __koral_rc_stats_releases();
    let _ = x.count();
    let _ = y.count();
    let _ = c;
    return "w9_compare_retains=\(r1 - r0) w9_compare_releases=\(d1 - d0)";
};

// vtable 按槽释放网（2026-11-14）：ownership-first 的实参转移（调用点
// retain 副本）由 wrapper 代放（借用体不放）。窗口的净流量必须是 0：转移
// 而没人放 → 泄漏（净 +1）；放两次 → 净 -1。
trait Ask {
    ask(self, other: String): Bool;
};

type Asker(name: String);
given Asker: Ask {
    ask(self, other: String): Bool = self.name == other;
};

let vtable_window(a: Ask, other: String): String = {
    let r0 = __koral_rc_stats_retains();
    let d0 = __koral_rc_stats_releases();
    let r = a.ask(other);
    let r1 = __koral_rc_stats_retains();
    let d1 = __koral_rc_stats_releases();
    let _ = other.count();
    return "w10_vtable_net=\((r1 - r0) - (d1 - d0)) \(r.to_string())";
};

// 下标投影借用位（issue 8 余部 · 2026-11-14）：`xs[0] == y` 的接收者读是
// 下标槽装载，旧账每比较付一对 retain/release（提前物化副本）。槽装载消去
// （compute_slot_load_elisions 四闸）后整对归零：纯被调 + 借用槽 + 单使用
// 点 + 无副作用间隔。实参在窗口后仍使用，排除末次使用移动的干扰。
let subscript_window(): String = {
    let mutable xs = List[String].new();
    xs.push("hello" + " world");
    let y = "hello" + " world";
    let r0 = __koral_rc_stats_retains();
    let d0 = __koral_rc_stats_releases();
    let mutable i = 0;
    let mutable c = 0;
    while i < 4 then {
        if xs[0] == y then {
            c += 1;
        };
        i += 1;
    };
    let r1 = __koral_rc_stats_retains();
    let d1 = __koral_rc_stats_releases();
    let _ = y.count();
    let _ = xs.count();
    let _ = c;
    return "w11_subscript_retains=\(r1 - r0) w11_subscript_releases=\(d1 - d0)";
};

// 原子内建实参取址位（rule 5a · 2026-11-16）：`fetch_add` 的 `&self.value`
// 只作 `__koral_atomic_*` 直接实参、不外逃。旧规（rule 5 无条件）把方法打成
// owned 约定，每次调用付一对 retain/release，8 线程下 refcount 税把
// fetch_add 压到对象锁的 2 倍慢；carve-out 后接收者走 +0 借用，窗口内
// RC 流量归零。实参在窗口后仍使用，排除末次使用移动的干扰。
let atomic_window(): String = {
    let counter = Counter(0);
    let r0 = __koral_rc_stats_retains();
    let d0 = __koral_rc_stats_releases();
    let mutable i = 0;
    while i < 4 then {
        let _ = counter.fetch_add(1);
        i += 1;
    };
    let r1 = __koral_rc_stats_retains();
    let d1 = __koral_rc_stats_releases();
    let _ = counter.load();
    return "w12_atomic_retains=\(r1 - r0) w12_atomic_releases=\(d1 - d0)";
};

let main(): Void = {
    __koral_rc_stats_enable();

    let b1 = Box(1);
    println(alias_window(b1));

    let c1 = Box(2);
    let r2 = __koral_rc_stats_retains();
    let c2 = c1;
    let c3 = c2;
    let _ = read(c3);
    let r3 = __koral_rc_stats_retains();
    println("w2_move_chain_retains=\(r3 - r2)");

    let d1 = Box(3);
    let r4 = __koral_rc_stats_retains();
    let d2 = d1;
    let _ = read(d2);
    let d3 = d1;
    let _ = read(d3);
    let r5 = __koral_rc_stats_retains();
    println("w3_multiread_retains=\(r5 - r4)");

    let d0 = __koral_rc_stats_releases();
    probe_move();
    let d1b = __koral_rc_stats_releases();
    println("w5_probe_move_releases=\(d1b - d0)");

    let bx = Box(11);
    let d2b = __koral_rc_stats_releases();
    probe_alias(bx);
    let d3b = __koral_rc_stats_releases();
    println("w6_probe_alias_releases=\(d3b - d2b)");

    println(freeze_window());

    println(init_memory_window());

    println(compare_window());

    println(subscript_window());

    println(atomic_window());

    let asker = Asker("rex" + "-dog");
    let ao: Ask = asker;
    println(vtable_window(ao, "!" + "?"));
};
