// EXPECT: ok
// The managed-object allocation contract. A fresh [Control | payload] block
// starts with strong = 1 and weak = 1 -- the implicit weak that "the payload
// is alive" holds (std/koral_runtime.h). The runtime stress stage in
// scripts/verify.sh greps the emitted C of this file: `weak_count = 1` must
// appear and `weak_count = 0` must not. Nothing else can police this value:
// the differential is blind to it (both compilers emit it) and the C protocol
// test hand-writes its own init.

type mutable Cell(value: Int);

let main(): Void = {
    let c = Cell(7);
    let w = c as ?Cell;
    if ?w is .Some(v) then {
        if v.value == 7 then {
            println("ok");
        } else {
            assert(false, "cell payload");
        };
    } else {
        assert(false, "upgrade must succeed while the strong handle is alive");
    };
};
