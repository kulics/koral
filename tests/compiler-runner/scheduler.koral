using std { .. }
using std::async { .. }
using std::os { .. }
using std::rand { .. }
using std::sync { .. }
using std::time { .. }

private type CaseWorkerEvent {
    Started(info CaseInfo),
    Finished(result CaseResult),
    WorkerExited(),
}

private let effective_parallel_jobs(config RunnerConfig, total UInt) UInt = {
    if total == 0 then {
        return 0(UInt)
    }
    let mutable worker_count = min(config.jobs, total)
    let bootstrap_parallel_cap UInt = 6(UInt)
    if config.compiler_kind == "bootstrap" and worker_count > bootstrap_parallel_cap then {
        worker_count = bootstrap_parallel_cap
    }
    return worker_count
}

private let finalize_summary(total UInt, passed UInt, failed UInt, timed_out UInt, memory_exceeded UInt, infra_failed UInt, start MonoTime) RunSummary = {
    let duration_ms = start.elapsed().as_milliseconds()
    let exit_code = if failed == 0 then 0 else 1
    return RunSummary(total, passed, failed, timed_out, memory_exceeded, infra_failed, duration_ms, exit_code)
}

private let run_cases_serial(config RunnerConfig, cases List[CaseInfo]) RunSummary = {
    let start = MonoTime.now()
    let total = cases.count()
    let stop_requested = AtomicInt.new(0)
    let mutable executed UInt = 0
    let mutable passed UInt = 0
    let mutable failed UInt = 0
    let mutable timed_out UInt = 0
    let mutable memory_exceeded UInt = 0
    let mutable infra_failed UInt = 0

    for i in 0..<total then {
        print_case_started(config, i + 1, total, cases[i])
        let result = run_single_case(config, cases[i], stop_requested)
        executed += 1
        print_case_result(config, i + 1, total, result)
        if result.passed then {
            passed += 1
        } else {
            failed += 1
            if result.failure_type == "timeout" then {
                timed_out += 1
            }
            if result.failure_type == "memory_exceeded" then {
                memory_exceeded += 1
                stop_requested.store(1)
                if executed < total then {
                    report_error_line(
                        config,
                        "Aborting remaining " + (total - executed).to_string()
                            + " case(s) after memory limit exceeded by " + result.case_info.relative_path
                    )
                }
                break
            }
            if result.failure_type == "infrastructure_error" then {
                infra_failed += 1
            }
        }
    }

    return finalize_summary(executed, passed, failed, timed_out, memory_exceeded, infra_failed, start)
}

private let run_case_and_emit_events(
    config RunnerConfig,
    info CaseInfo,
    stop_requested AtomicInt,
    sender SendChannel[CaseWorkerEvent],
) Void = {
    if stop_requested.load() <> 0 then {
        return
    }
    let _ = sender.send(.Started(info))
    let result = run_single_case(config, info, stop_requested)
    let _ = sender.send(.Finished(result))
}

private let run_case_with_group_lock(
    config RunnerConfig,
    info CaseInfo,
    sync_lock Mutex,
    net_lock Mutex,
    env_lock Mutex,
    stop_requested AtomicInt,
    sender SendChannel[CaseWorkerEvent],
) Void = {
    if stop_requested.load() <> 0 then {
        return
    }
    when info.group_key in {
        "sync" then {
            sync_lock.lock()
            if stop_requested.load() == 0 then {
                run_case_and_emit_events(config, info, stop_requested, sender)
            }
            sync_lock.unlock()
        },
        "net" then {
            net_lock.lock()
            if stop_requested.load() == 0 then {
                run_case_and_emit_events(config, info, stop_requested, sender)
            }
            net_lock.unlock()
        },
        "env" then {
            env_lock.lock()
            if stop_requested.load() == 0 then {
                run_case_and_emit_events(config, info, stop_requested, sender)
            }
            env_lock.unlock()
        },
        _ then run_case_and_emit_events(config, info, stop_requested, sender),
    }
}

private let run_cases_parallel(config RunnerConfig, cases List[CaseInfo]) RunSummary = {
    let start = MonoTime.now()
    let total = cases.count()
    if total == 0 then {
        return finalize_summary(0, 0, 0, 0, 0, 0, start)
    }

    let worker_count = effective_parallel_jobs(config, total)
    let mutable shuffled_cases = cases
    let random = default_random()
    random.shuffle(&mutable shuffled_cases)

    let next_index = AtomicInt.new(0)
    let stop_requested = AtomicInt.new(0)
    let channels = make_channel[CaseWorkerEvent](total + total + worker_count)
    let sender = channels.first
    let receiver = channels.second
    let sync_lock = Mutex.new()
    let net_lock = Mutex.new()
    let env_lock = Mutex.new()
    let mutable started UInt = 0
    let mutable received UInt = 0
    let mutable workers_exited UInt = 0
    let mutable passed UInt = 0
    let mutable failed UInt = 0
    let mutable timed_out UInt = 0
    let mutable memory_exceeded UInt = 0
    let mutable infra_failed UInt = 0

    for _ in 0..<worker_count then {
        let shared_sender = sender
        let shared_cases = shuffled_cases
        let shared_config = config
        let shared_index = next_index
        let shared_stop_requested = stop_requested
        let shared_sync_lock = sync_lock
        let shared_net_lock = net_lock
        let shared_env_lock = env_lock

        let _ = run_task(() -> {
            while true then {
                if shared_stop_requested.load() <> 0 then {
                    break
                }

                let idx = shared_index.fetch_add(1)
                if idx < 0 or idx(UInt) >= shared_cases.count() then {
                    break
                }

                if shared_stop_requested.load() <> 0 then {
                    break
                }

                let case_info = shared_cases[idx(UInt)]
                run_case_with_group_lock(
                    shared_config,
                    case_info,
                    shared_sync_lock,
                    shared_net_lock,
                    shared_env_lock,
                    shared_stop_requested,
                    shared_sender,
                )
            }

            let _ = shared_sender.send(.WorkerExited())
        })
    }

    while workers_exited < worker_count then {
        when receiver.recv() in {
            .Ok(event) then {
                when event in {
                    .Started(info) then {
                        started += 1
                        print_case_started(config, started, total, info)
                    },
                    .Finished(result) then {
                        print_case_result(config, received + 1, total, result)
                        if result.passed then {
                            passed += 1
                        } else {
                            failed += 1
                            if result.failure_type == "timeout" then {
                                timed_out += 1
                            }
                            if result.failure_type == "memory_exceeded" then {
                                memory_exceeded += 1
                                if stop_requested.load() == 0 then {
                                    stop_requested.store(1)
                                    let remaining = if total > started then total - started else 0(UInt)
                                    report_error_line(
                                        config,
                                        "Aborting remaining " + remaining.to_string()
                                            + " queued case(s) after memory limit exceeded by " + result.case_info.relative_path
                                    )
                                }
                            }
                            if result.failure_type == "infrastructure_error" then {
                                infra_failed += 1
                            }
                        }
                        received += 1
                    },
                    .WorkerExited() then {
                        workers_exited += 1
                    },
                }
            },
            .Error(_) then {
                break
            },
        }
    }

    return finalize_summary(received, passed, failed, timed_out, memory_exceeded, infra_failed, start)
}

public let run_cases(config RunnerConfig, cases List[CaseInfo]) RunSummary = {
    if cases.is_empty() then {
        report_error_line(config, "No test cases matched current filter")
        return RunSummary(0, 0, 1, 0, 0, 0, 0, 1)
    }

    let effective_jobs = effective_parallel_jobs(config, cases.count())
    if config.compiler_kind == "bootstrap" and effective_jobs < config.jobs then {
        report_line(
            config,
            "Bootstrap parallelism capped to " + effective_jobs.to_string()
                + " worker(s) for stability (requested " + config.jobs.to_string() + ")"
        )
    }

    report_line(config, "Running " + cases.count().to_string() + " case(s) with jobs=" + effective_jobs.to_string())

    let summary = if effective_jobs <= 1 then
        run_cases_serial(config, cases)
    else
        run_cases_parallel(config, cases)

    print_summary(config, summary)
    return summary
}
