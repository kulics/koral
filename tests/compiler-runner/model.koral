using "std/os";

public type RunnerConfig(
    run_root Path,
    cases_root Path,
    output_root Path,
    report_file Path,
    filter Option[String],
    jobs UInt,
    timeout_secs Int,
    memory_limit_mb UInt,
    compiler_kind String,
    compiler_bin Path,
    bootstrap_koralc Path,
    swift_koralc Path,
    compare_diagnostics Bool,
    verbose Bool,
);

public type CaseInfo(
    name String,
    relative_path String,
    absolute_path Path,
    group_key String,
);

given CaseInfo as Eq {

    public equals(self, other CaseInfo) Bool = self.relative_path == other.relative_path;
};

given CaseInfo as Ord {

    public compare(self, other CaseInfo) Int = self.relative_path.compare(other.relative_path);
};

// 有序期望：在输出中按顺序出现（子序列匹配）。
// 无序期望：连续的若干条构成一组，组内相对次序自由，但必须落在同一时序窗口内
// （上一条有序期望之后、下一条有序期望之前）。用来断言「这些都发生了」而不钉次序。
public type ExpectationItem {
    Ordered(want String),
    Unordered(want String),
};

public type ExpectationSet(
    expect_output List[String],
    expect_exact_output List[String],
    expect_error List[String],
    expected_exit Option[Int],
    expect_items List[ExpectationItem],
);

public type CaseResult(
    case_info CaseInfo,
    passed Bool,
    status String,
    failure_type String,
    failure_message String,
    exit_code Int,
    duration_ms Int64,
);

given CaseResult as Eq {

    public equals(self, other CaseResult) Bool = self.case_info == other.case_info;
};

given CaseResult as Ord {

    public compare(self, other CaseResult) Int = self.case_info.compare(other.case_info);
};

public type RunSummary(
    total UInt,
    passed UInt,
    failed UInt,
    timed_out UInt,
    memory_exceeded UInt,
    infra_failed UInt,
    duration_ms Int64,
    exit_code Int,
);

/// One compiler's raw behaviour for one case: what it said, and what the
/// program did.
///
/// This is deliberately NOT the pass/fail verdict. A verdict is relative to the
/// hand-written `// EXPECT` comments; two compilers can both satisfy a substring
/// assertion and still disagree about everything else the program printed. The
/// differential oracle compares observations against EACH OTHER, which needs the
/// raw text that the verdict path throws away.
public type CaseObservation {
    /// The harness broke -- this case says nothing about either compiler.
    Infra(message String),
    /// This side did not finish inside the harness limits (timeout, memory
    /// ceiling). Compared for agreement only: a case that fails to finish under
    /// one compiler and not the other is divergence whichever limit fired, and
    /// comparing the two reasons would be noise.
    DidNotFinish(reason String),
    Observed(
        label String,
        /// Whether the compiler accepted the program and produced a binary.
        accepted Bool,
        /// Normalized stdout+stderr of the compile step.
        compile_output String,
        /// `Some` only when there was a binary and it was executed.
        run Option[ProgramRun],
    ),
};

/// What a compiled program did when it actually ran.
public type ProgramRun(
    exit_code Int,
    /// Normalized stdout+stderr.
    stdout String,
);
