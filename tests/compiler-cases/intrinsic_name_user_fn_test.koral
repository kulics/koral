// EXPECT: user spawn 7

// A user function that happens to carry a hidden intrinsic's NAME is the
// user's own: the raw-name dispatch must not hijack it. For non-std code the
// hidden intrinsic names are not dispatched at all, so ordinary resolution
// finds this declaration.

using "std" { ... };

let spawn_thread(x: Int): Int = {
    return x + 1;
};

let main(): Void = {
    println("user spawn \(spawn_thread(6))");
};
