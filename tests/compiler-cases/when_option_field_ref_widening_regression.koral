// EXPECT: ok

type Big(value Int)
given Big not Deref

type Expr(kind * Big)

let select(flag Bool, expr Expr, fallback * Big) * Big = when if flag then Option[Expr].Some(expr) else Option[Expr].None() in {
    .Some(lowered_expr) then lowered_expr.kind,
    .None() then fallback,
}

let main() Void = {
    let big1 *mutable Big = box(Big(7))
    let big2 *mutable Big = box(Big(9))
    let expr = Expr(big1)
    let selected_true * Big = select(true, expr, big2)
    let selected_false * Big = select(false, expr, big2)
    assert(selected_true.value == 7, "some branch should return field *")
    assert(selected_false.value == 9, "none branch should return fallback")
    println("ok")
}
