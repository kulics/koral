// EXPECT-ERROR: Type mismatch: expected ?*mutable CounterOps, got ?*CounterOps

trait CounterOps {
    peek(*self) Int
}

type Counter(value Int)

given Counter as CounterOps {

    public peek(*self) Int = self.value
}

let main() Int = {
    let strong *mutable CounterOps = box(Counter(3))
    let readonly * CounterOps = strong
    let weak ?* CounterOps = downgrade(readonly)
    let _ ?*mutable CounterOps = weak
    return 0
}
