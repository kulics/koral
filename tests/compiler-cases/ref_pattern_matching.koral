// Test pattern matching on T * types without explicit deref.
// when, if-is, and while-is should all auto-deref the subject when it is a *.
// EXPECT: test_when_ref: PASS
// EXPECT: test_if_is_ref: PASS
// EXPECT: test_while_is_ref: PASS
// EXPECT: test_if_is_ref_none: PASS
// EXPECT: test_when_ref_struct: PASS
// EXPECT: All * pattern matching tests passed!

type Opt {
    None(),
    Some(value Int),
}

type Box(x Int, y Int)

// Helper: returns an Opt * (via a struct that holds one)
type OptHolder(mutable value Opt)

given OptHolder {

    get_ref(*self) * Opt = &self.value
}

// Test 1: when on Opt * — should auto-deref and match inner type
let test_when_ref() Int = {
    let mutable holder = OptHolder(Opt.Some(42))
    let r * Opt = &holder.value
    return when r in {
        .Some(v) then v,
        .None then 0,
    }
}

// Test 2: if-is on Opt * — should auto-deref and match inner type
let test_if_is_ref() Int = {
    let mutable holder = OptHolder(Opt.Some(99))
    let r * Opt = &holder.value
    return if r is .Some(v) then v else 0
}

// Test 3: while-is on Opt * — iterator returns Opt * each iteration
type RefIterator(mutable current Int, max Int)

given RefIterator {

    // Returns a fresh Opt by value each call; caller takes *
    next_val(*mutable self) Opt = {
        return if self.current < self.max then {
            let v = self.current
            self.current = self.current + 1
            break Opt.Some(v)
        } else {
            break Opt.None()
        }
    }
}

let test_while_is_ref() Int = {
    let mutable iter = RefIterator(0, 4)
    let mutable sum = 0
    // next_val returns Opt by value; take * to it and match
    let mutable cur = iter.next_val()
    let mutable cur_ref * Opt = &cur
    while cur_ref is .Some(v) then {
        sum = sum + v
        cur = iter.next_val()
        cur_ref = &cur
    }
    return sum  // 0 + 1 + 2 + 3 = 6
}

// Test 4: if-is on Opt * — None branch
let test_if_is_ref_none() Int = {
    let mutable holder = OptHolder(Opt.None())
    let r * Opt = &holder.value
    return if r is .Some(v) then v else 77
}

// Test 5: when on Box * — struct pattern on *
let test_when_ref_struct() Int = {
    let mutable b = Box(10, 20)
    let r * Box = &b
    return when r in {
        Box(x, y) then x + y,
    }
}

let main() Int = {
    if test_when_ref() == 42 then {
        println("test_when_ref: PASS")
    } else {
        println("test_when_ref: FAIL")
        return 1
    }

    if test_if_is_ref() == 99 then {
        println("test_if_is_ref: PASS")
    } else {
        println("test_if_is_ref: FAIL")
        return 1
    }

    if test_while_is_ref() == 6 then {
        println("test_while_is_ref: PASS")
    } else {
        println("test_while_is_ref: FAIL")
        return 1
    }

    if test_if_is_ref_none() == 77 then {
        println("test_if_is_ref_none: PASS")
    } else {
        println("test_if_is_ref_none: FAIL")
        return 1
    }

    if test_when_ref_struct() == 30 then {
        println("test_when_ref_struct: PASS")
    } else {
        println("test_when_ref_struct: FAIL")
        return 1
    }

    println("All * pattern matching tests passed!")
    return 0
}
