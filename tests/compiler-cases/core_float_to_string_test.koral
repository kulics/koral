// EXPECT: f64_round_ok
// EXPECT: f64_neg_ok
// EXPECT: f64_zero_ok
// EXPECT: f64_neg_zero_ok
// EXPECT: f64_big_ok
// EXPECT: f64_max_ok
// EXPECT: f64_int_valued_ok
// EXPECT: f64_nan_ok
// EXPECT: f64_inf_ok
// EXPECT: f64_neg_inf_ok
// EXPECT: f32_round_ok
// EXPECT: f32_max_ok
// EXPECT: f32_nan_ok
// EXPECT: f32_inf_ok
// EXPECT: f64_roundtrip_ok
// EXPECT: f32_roundtrip_ok

// Float32/Float64 to_string: the SHORTEST decimal that parses back to the same
// value -- round-trip is the contract, not a fixed digit count
// (docs/guide/document.md §Conversions, 2026-11-12): 2.3 prints "2.3", 1e20
// prints "1e+20", 0.0 prints "0", and integral values need no trailing
// decimals. Same rendering as JSON numbers. NaN/Inf keep their spelled forms.
//
// Negative control: the old fixed six-decimal rendering ("2.300000") fails
// the equality checks below AND the round-trip checks (parse("2.300000") is
// fine, but parse of the 17-digit-truncated max_value is not the same bits).

using "std/text" { ... };

let main(): Int = {
    let f1 = 2.3.to_string();
    if f1 == "2.3" then println("f64_round_ok") else println("FAIL f64_round: " + f1);

    let f2 = (0.0 - 2.3).to_string();
    if f2 == "-2.3" then println("f64_neg_ok") else println("FAIL f64_neg: " + f2);

    let f3 = 0.0.to_string();
    if f3 == "0" then println("f64_zero_ok") else println("FAIL f64_zero: " + f3);

    let f4 = Float64.from_bits(UInt64(1) << 63).to_string();
    if f4 == "-0" then println("f64_neg_zero_ok") else println("FAIL f64_neg_zero: " + f4);

    let f5 = 1e20.to_string();
    if f5 == "1e+20" then println("f64_big_ok") else println("FAIL f64_big: " + f5);

    let f6 = Float64.max_value().to_string();
    if f6 == "1.7976931348623157e+308" then println("f64_max_ok")
    else println("FAIL f64_max: " + f6);

    let f7 = 12.0.to_string();
    if f7 == "12" then println("f64_int_valued_ok") else println("FAIL f64_int_valued: " + f7);

    let nan_v = Float64.nan();
    if nan_v.to_string() == "NaN" then println("f64_nan_ok") else println("FAIL f64_nan");

    let inf_v = Float64.inf();
    if inf_v.to_string() == "Inf" then println("f64_inf_ok") else println("FAIL f64_inf");

    let neg_inf = 0.0 - Float64.inf();
    if neg_inf.to_string() == "-Inf" then println("f64_neg_inf_ok") else println("FAIL f64_neg_inf");

    let g1 = Float32(2.3).to_string();
    if g1 == "2.3" then println("f32_round_ok") else println("FAIL f32_round: " + g1);

    let g2 = Float32.max_value().to_string();
    if g2 == "3.4028235e+38" then println("f32_max_ok") else println("FAIL f32_max: " + g2);

    if Float32.nan().to_string() == "NaN" then println("f32_nan_ok") else println("FAIL f32_nan");

    if Float32.inf().to_string() == "Inf" then println("f32_inf_ok") else println("FAIL f32_inf");

    // Round-trip: every finite sample parses back to the same bits.
    let f64_samples = List[Float64].new();
    f64_samples.push(0.1);
    f64_samples.push(1.0 / 3.0);
    f64_samples.push(2.3);
    f64_samples.push(0.0);
    f64_samples.push(1e-300);
    f64_samples.push(1e300);
    f64_samples.push(123456789.123456);
    f64_samples.push(Float64.max_value());
    f64_samples.push(0.0 - Float64.max_value());
    f64_samples.push(3.141592653589793);
    let mutable f64_ok = true;
    for v in f64_samples then {
        let text = v.to_string();
        let back = Float64.parse(text) or else panic("parse failed: " + text);
        if back.to_bits() != v.to_bits() then {
            f64_ok = false;
            println("FAIL f64_roundtrip: " + text);
        };
    };
    if f64_ok then println("f64_roundtrip_ok");

    let f32_samples = List[Float32].new();
    f32_samples.push(Float32(0.1));
    f32_samples.push(Float32(1.0) / Float32(3.0));
    f32_samples.push(Float32(2.3));
    f32_samples.push(Float32(0.0));
    f32_samples.push(Float32(1e-30));
    f32_samples.push(Float32.max_value());
    f32_samples.push(Float32(0.0) - Float32.max_value());
    let mutable f32_ok = true;
    for v in f32_samples then {
        let text = v.to_string();
        let back = Float32.parse(text) or else panic("parse failed: " + text);
        if back.to_bits() != v.to_bits() then {
            f32_ok = false;
            println("FAIL f32_roundtrip: " + text);
        };
    };
    if f32_ok then println("f32_roundtrip_ok");

    return 0;
};
