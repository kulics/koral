// EXPECT: f64_round_ok
// EXPECT: f64_neg_ok
// EXPECT: f64_zero_ok
// EXPECT: f64_neg_zero_ok
// EXPECT: f64_big_ok
// EXPECT: f64_max_ok
// EXPECT: f64_nan_ok
// EXPECT: f64_inf_ok
// EXPECT: f64_neg_inf_ok
// EXPECT: f32_round_ok
// EXPECT: f32_max_ok
// EXPECT: f32_nan_ok
// EXPECT: f32_inf_ok

// Float32/Float64 to_string: decimal with six fractional digits, correctly
// rounded (2.3 prints "2.300000", not truncated "2.299999"), with no Int
// conversion (Float64.max_value() used to abort), plus the NaN/Inf specials.

let main(): Int = {
    let f1 = 2.3.to_string();
    if f1 == "2.300000" then println("f64_round_ok") else println("FAIL f64_round: " + f1);

    let f2 = (0.0 - 2.3).to_string();
    if f2 == "-2.300000" then println("f64_neg_ok") else println("FAIL f64_neg: " + f2);

    let f3 = 0.0.to_string();
    if f3 == "0.000000" then println("f64_zero_ok") else println("FAIL f64_zero: " + f3);

    let f4 = Float64.from_bits(UInt64(1) << 63).to_string();
    if f4 == "-0.000000" then println("f64_neg_zero_ok") else println("FAIL f64_neg_zero: " + f4);

    let f5 = 1e20.to_string();
    if f5 == "100000000000000000000.000000" then println("f64_big_ok")
    else println("FAIL f64_big: " + f5);

    // |f| >= 2^63 used to abort on Int conversion.
    let f6 = Float64.max_value().to_string();
    if f6.starts_with("17976931348623157") and f6.ends_with(".000000") and f6.count() == 316 then println(
        "f64_max_ok",
    ) else println("FAIL f64_max: " + f6);

    let f7 = Float64.nan().to_string();
    if f7 == "NaN" then println("f64_nan_ok") else println("FAIL f64_nan: " + f7);

    let f8 = Float64.inf().to_string();
    if f8 == "Inf" then println("f64_inf_ok") else println("FAIL f64_inf: " + f8);

    let f9 = (0.0 - Float64.inf()).to_string();
    if f9 == "-Inf" then println("f64_neg_inf_ok") else println("FAIL f64_neg_inf: " + f9);

    let g1 = Float32(2.3).to_string();
    if g1 == "2.300000" then println("f32_round_ok") else println("FAIL f32_round: " + g1);

    let g2 = Float32.max_value().to_string();
    if g2 == "340282346638528859811704183484516925440.000000" then println("f32_max_ok")
    else println("FAIL f32_max: " + g2);

    let g3 = Float32.nan().to_string();
    if g3 == "NaN" then println("f32_nan_ok") else println("FAIL f32_nan: " + g3);

    let g4 = Float32.inf().to_string();
    if g4 == "Inf" then println("f32_inf_ok") else println("FAIL f32_inf: " + g4);

    return 0;
};
