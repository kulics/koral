// EXPECT: hello8080

type Client(value Int);

given Client {
    public connect(host String, port: Int = 80) String = {
        let mutable s = host;
        s.push_string(port.to_string());
        return s;
    };
};

let main() Int = {
    println(Client.connect("hello", port: 8080));
    return 0;
};
