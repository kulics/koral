// Test that calling a mutating method through a readonly reference is rejected.
// EXPECT-ERROR: Cannot call mutating method through read-only reference

type Counter(mutable value Int);

given Counter {
    increment(*mutable self) Void = {
        self.value = self.value + 1;
    };
    get_value(*self) Int = {
        return self.value;
    };
};

let main() Int = {
    let c = Counter(0);
    let ref_c = &c;
    // This should fail - calling mutating method through readonly ref
    ref_c.increment();
    return 0;
};