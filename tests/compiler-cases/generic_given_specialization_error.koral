// EXPECT-ERROR: Invalid operation generic given specialization not supported
// Design guard: a generic given may not specialize the type it extends.
//
// `given [T Any] Box[Int]` writes a concrete argument where `T` was declared,
// so the given is not actually generic in `T`. The only accepted form is the
// identity one -- every argument is the corresponding type parameter's name:
//
//     given [T Any] Box[T] { ... }
//
// Both compilers enforce this; before, only Swift did.

type Box[T Any](public v T);

given[E Any] Box[Int] {
    public take(self) Int = self.v;
};

let main() Int = {
    return 0;
};
