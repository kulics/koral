// Test: Struct patterns can establish exhaustiveness when all fields use wildcards.
// Issue #24 - struct bodies cannot establish exhaustiveness (FIXED)
// EXPECT: PASS

type Point(x Int, y Int);

let classify(p Point) Int = {
    return when p in {
        .Point(0, 0) then 0,
        .Point(_, _) then 1,
    };
};

let main() Int = {
    let r1 = classify(Point(0, 0));
    let r2 = classify(Point(1, 2));
    if r1 == 0 and r2 == 1 then {
        println("PASS");
        return 0;
    };
    println("FAIL");
    return 1;
};

