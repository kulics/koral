// EXPECT-ERROR: Cannot take the address of a field of a 'sendable mutable' object

// Implicit-borrow ban (concurrency-design.md §对象锁语义·裁定二, 隐式形态):
// the owner of the field is reached implicitly — through a pointer variable
// that the address-of dereferences without being spelled as a deref. The
// result is still a field address of a locked object, exactly the escape
// hatch `&c.hits` opens, and is banned the same way. (Reference-shaped
// parameter types are not spellable in Koral, so the plain `foo(c.hits)`
// borrow form cannot be written at all; every borrow-forming adaptation
// chokepoint is hooked for it regardless.)

type sendable mutable Outer(mutable hits: Int);

let main(): Void = {
    let o = Outer(0);
    let p: *Outer = &o;
    let q = &p.hits;
    let _ = q;
};
