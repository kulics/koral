// EXPECT-ERROR: A pair literal is not an expression: construct a Pair with 'Pair(first, second)'
// Once `ident :` matches, the argument IS labeled -- `ident : ...` can never be
// a positional argument (there is no `:` operator in expressions). Swift used
// to restore and re-parse positionally on a labeled-parse failure, which said
// "unexpected `:`" after re-parsing `a` instead of the real complaint.

type Box(v Int);

let main() Int = {
    let b = Box(v: (1, 2));
    return 0;
};
