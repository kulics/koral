// EXPECT: ba7816bf
// EXPECT: 00ff
// EXPECT: ff
// EXPECT: 68656c6c6f
// EXPECT: hex roundtrip ok
// std.hex round trip: encode is lowercase, decode accepts either case.

using "std/hex";

let main() Int = {
    // The FIPS 180-4 "abc" digest prefix -- a known byte sequence, not this
    // implementation's own output.
    println(encode_hex([186, 120, 22, 191]));

    // Uppercase input decodes; encoding it back is lowercase.
    let upper = decode_hex("00FF") or else {
        eprintln("decode failed: \(it.message())");
        return 1;
    };
    println(encode_hex(upper));

    // A single byte round-trips.
    let one = decode_hex("Ff") or else {
        eprintln("decode failed: \(it.message())");
        return 1;
    };
    println(encode_hex(one));

    // Text bytes round-trip.
    let text = decode_hex("68656c6c6f") or else {
        eprintln("decode failed: \(it.message())");
        return 1;
    };
    println(encode_hex(text));

    // Empty input round-trips to empty output. `[]` infers `List[UInt8]` from
    // the parameter.
    if encode_hex([]) <> "" then {
        eprintln("empty encode is not empty");
        return 1;
    };
    let empty = decode_hex("") or else {
        eprintln("empty decode failed: \(it.message())");
        return 1;
    };
    if empty.count() <> 0 then {
        eprintln("empty decode is not empty");
        return 1;
    };

    println("hex roundtrip ok");
    return 0;
};
