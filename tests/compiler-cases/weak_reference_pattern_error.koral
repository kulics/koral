// EXPECT-ERROR: Cannot match a pattern against a weak reference: upgrade it first
// A weak reference is a HANDLE, not a value: before unwrapping with `is ?v` it
// has no fields, no cases and no payload to destructure. Binding the handle
// whole is fine; testing its shape is not.

type mutable Box(mutable value Int);

let main() Int = {
    let b = Box(42);
    let weak ?Box = ?Box(b);
    let v = when weak in {
        Box(x) then x,
        _ then 0,
    };
    return v;
};
