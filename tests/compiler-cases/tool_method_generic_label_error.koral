// A named parameter must be passed by label even when the call goes through
// a trait-bounded generic receiver and a tool (extension) method.
// EXPECT-ERROR: Named parameter 'name' must be passed by label

using "std" { ... };

trait Greeter {
    base(self): String;
};

given Greeter {
    greet(self, name: String =, times: Int = 1): String = self.base();
};

type G();

given G: Greeter {
    base(self): String = "hi";
};

let call[T: Greeter](t: T): String = {
    return t.greet("koral");
};

let main(): Int = {
    let _ = call(G());
    return 0;
};
