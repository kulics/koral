// EXPECT-ERROR: Cannot capture mutable variable 'xs'; hold the state in a Cell and capture the cell instead

// Reading a `let mutable` collection through a subscript inside a lambda is a
// capture of the binding: the subscript is lowered to a method call on the
// binding, and a snapshot would hide later updates.

let main() Int = {
    let mutable xs = [1, 2, 3];
    let f = () => xs[0];
    return 0;
};
