// EXPECT: 3
// Generic code bounds the capability instead of naming a type: `BitAnd` and
// `BitNot` in the signature let any conforming type through, user types and
// the primitive families alike.

type Mask(bits: UInt8);

given Mask: BitAnd[Mask] {
    public bit_and(self, other: Mask): Mask = Mask(self.bits & other.bits);
};

given Mask: BitNot {
    public bit_not(self): Mask = Mask(~self.bits);
};

given Mask {
    public to_string(self): String = self.bits.to_string();
};

let band[T: BitAnd[T] and BitNot](a: T, b: T): T = ~a & b;

let main(): Int = {
    println(band(Mask(0), Mask(3)).to_string());
    return 0;
};
