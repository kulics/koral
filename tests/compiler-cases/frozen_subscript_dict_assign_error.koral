// EXPECT-ERROR: Cannot assign to immutable subscript of type 'FrozenDict[String, Int]'
// A frozen dict subscript is read-only too (one error site; the list shape is
// pinned in frozen_subscript_assign_error).

using "std" { ... };

let main(): Void = {
    let map_source = Dict[String, Int].new();
    map_source.insert("a", 1);
    let frozen = map_source.to_frozen_dict();
    frozen["a"] = 2;
};
