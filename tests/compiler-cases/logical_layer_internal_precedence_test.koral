// EXPECT: or over and: 1
// Precedence INSIDE the logical layer is unchanged: `and` binds tighter than
// `or`, so
//   a or b and c
// is
//   a or (b and c)
// With a=true, b=false, c=false that is `true or false`, not
// `(true or false) and false`.

let main() Int = {
    let a Bool = true;
    let b Bool = false;
    let c Bool = false;
    let v = a or b and c;
    println("or over and: " + (if v then 1 else 0).to_string());
    return 0;
};
