// EXPECT: reads ok
// EXPECT: done

// Concurrent readers over one shared dict (concurrency-design.md §std落点):
// reads hold the container's lock SHARED, so four readers run together. The
// shared-read path is also where every value copy of the inner `Dict` is
// touched from several threads at once -- managed boxes keep atomic refcounts
// for exactly this (a non-atomic one races here into use-after-free).

using "std/async" { ... };
using "std/sync" { ... };

let main(): Void = {
    let d = ConcurrentDict[Int, Int].new();
    let mutable i = 0;
    while i < 100 then {
        d.insert(i, i + 1);
        i = i + 1;
    };
    let handles = List[Thread].new();
    let mutable t = 0;
    while t < 4 then {
        let h = run_task(() => {
            let mutable k = 0;
            while k < 50000 then {
                let idx = k % 100;
                let v = d.get(idx) or else panic("missing entry");
                assert(v == idx + 1, "value must survive parallel reads");
                k = k + 1;
            };
        });
        handles.push(h);
        t = t + 1;
    };
    let mutable j = 0;
    while j < handles.count() then {
        (handles.get(j) or else panic("handle")).wait().unwrap();
        j = j + 1;
    };
    println("reads ok");
    println("done");
};
