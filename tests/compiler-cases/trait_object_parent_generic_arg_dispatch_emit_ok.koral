trait Parent[T Any] {
    values(*self) List[T];
};

trait Child[T Any] Parent[T] {};

type Holder(value Int);

given Holder as Parent[Int] {

    values(*self) List[Int] = [self.value, self.value + 1];
};

given Holder as Child[Int] {};

let erase(x * Holder) * Child[Int] = x;

let main() Int = {
    let strong *mutable Holder = box(Holder(9));
    let readonly * Holder = strong;
    let child = erase(readonly);
    let values = child.values();
    return values[0];
};