// EXPECT-ERROR: Construction is written 'Type(args)', not 'expr as Type'
// A trait target joins the nominal rule: `expr as Trait` is not a cast
// spelling. The upcast is the call form `Trait(expr)`.

trait Drawable {
    draw(self) String;
};

type Circle(r Int);

given Circle as Drawable {
    draw(self) String = "circle(\(self.r))";
};

let main() Int = {
    let c = Circle(3);
    let d = c as Drawable;
    return 0;
};
