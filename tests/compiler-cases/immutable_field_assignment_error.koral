// EXPECT-ERROR: Cannot assign to immutable field 'a' of type 'Val'
// EXPECT-ERROR: v.a = 2;
// The second pin is the diagnostic's source snippet. A field is named as a
// FIELD, not as an immutable variable: `v.a = 2` blames the field `a` of the
// type `Val` -- the field is the thing that refuses, and the variable `v` is
// not what the assignment is refusing. (Plain variables keep
// `Cannot assign to immutable variable: x`.)

type Val(a: Int);

let main(): Void = {
    let mutable v = Val(1);
    v.a = 2;
    println(v.a.to_string());
};
