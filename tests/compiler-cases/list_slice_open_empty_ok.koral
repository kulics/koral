// EXPECT: list_open_slice_empty_ok
// EXPECT: list_open_slice_siblings_empty_ok
// EXPECT: list_push_list_open_empty_ok
// EXPECT: list_insert_list_at_open_empty_ok

// `a<..<a` names no elements: it is a legal EMPTY bounded range, just like
// `a..<a`, `a<..a`, and `a<..<a+1`. slice_spec must return the empty spec
// instead of panicking "invalid range" (the old guard was `s >= e`).

let main(): Void = {
    let mutable l = List[Int].new();
    for i in 0..<5 then {
        l.push(i);
    };

    // The once-broken case: 1<..<1 must slice to the empty list.
    let empty = l.sublist(1<..<1);
    assert(empty.count() == 0, "sublist(1<..<1) is empty");
    assert(l.count() == 5, "sublist leaves source untouched");
    println("list_open_slice_empty_ok");

    // Sibling empty ranges keep behaving as empty specs.
    assert(l.sublist(2..<2).count() == 0, "2..<2 empty");
    assert(l.sublist(2<..2).count() == 0, "2<..2 empty");
    assert(l.sublist(2<..<3).count() == 0, "2<..<3 empty");
    assert(l.sublist(1<..<2).count() == 0, "1<..<2 empty");
    assert(l.sublist(0<..<0).count() == 0, "0<..<0 empty");
    assert(l.sublist(5<..<5).count() == 0, "5<..<5 empty at end");
    let mutable e = List[Int].new();
    assert(e.sublist(0<..<0).count() == 0, "0<..<0 empty on empty list");
    println("list_open_slice_siblings_empty_ok");

    // push_list with an empty Open span appends nothing.
    let mutable dst = List[Int].new();
    dst.push(7);
    dst.push_list(l, span = 1<..<1);
    assert(dst.count() == 1, "push_list(1<..<1) appends nothing");
    assert(dst[0] == 7, "push_list keeps existing elements");
    println("list_push_list_open_empty_ok");

    // insert_list_at with an empty Open span inserts nothing.
    let mutable mid = List[Int].new();
    mid.push(1);
    mid.push(3);
    mid.insert_list_at(1, l, span = 2<..<2);
    assert(mid.count() == 2, "insert_list_at(2<..<2) inserts nothing");
    assert(mid[0] == 1 and mid[1] == 3, "insert_list_at keeps order");
    println("list_insert_list_at_open_empty_ok");

    // A non-empty Open span still slices normally.
    let slice = l.sublist(1<..<4);
    assert(slice.count() == 2, "1<..<4 has two elements");
    assert(slice[0] == 2 and slice[1] == 3, "1<..<4 picks 2, 3");
};
