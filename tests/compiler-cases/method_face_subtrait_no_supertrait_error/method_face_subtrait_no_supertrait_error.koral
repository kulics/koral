// EXPECT-ERROR: Trait 'Root' provides it but is not in scope
// Importing a SUBTRAIT does not bring the supertrait's methods on a CONCRETE
// receiver (§3.4). Rust is the same: `use a::Sub;` leaves `x.b()` an error --
// only a generic BOUND opens the supertrait (see
// method_face_bound_brings_methods_test).

using "std" { ... };
using "./lib.koral" { X, Leaf };

public let main() Int = {
    let x = X.new();
    println(x.l().to_string());
    println(x.r().to_string());
    return 0;
};
