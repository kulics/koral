// EXPECT-ERROR: Duplicate definition: twice
// Two `given` blocks naming the SAME instantiation collide on a method name
// exactly like two blocks on the same plain type.

type Box[T: Any](value: T);

given Box[Int] {
    public twice(self): Int = 1;
};

given Box[Int] {
    public twice(self): Int = 2;
};

let main(): Int = {
    return 0;
};
