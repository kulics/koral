// EXPECT-ERROR: Pattern guards use 'where', not 'if'
// Design guard: the guard keyword is `where`. `if` is still an ordinary
// expression and statement keyword, so the old spelling would otherwise fall
// through to "Expected 'then' in when arm" -- true, but never names the
// mistake, so the parser says which keyword belongs here.

using "std" { ... };

type Color {
    Red(),
    Green(),
};

let main() Int = {
    let c = Color.Red();
    let s = when c in {
        .Red() if true then 1,
        _ then 0,
    };
    println(s);
    return 0;
};
