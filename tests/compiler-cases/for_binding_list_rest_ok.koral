// EXPECT: for_list_rest_ok
// Design guard: the bare rest slot `[...]` is total on a list -- it matches
// every length. Pin it so the coverage judgement keeps answering the same as
// the syntactic shortcut for this shape.

using "std" { ... };

let main() Int = {
    let xs = List[List[Int]].new();
    let mutable a = List[Int].new();
    a.push(1);
    let mutable b = List[Int].new();
    xs.push(a);
    xs.push(b);
    let mutable count = 0;
    for [...] in xs then {
        count += 1;
    };
    if count == 2 then {
        println("for_list_rest_ok");
    };
    return 0;
};
