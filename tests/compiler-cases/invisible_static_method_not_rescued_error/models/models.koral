public trait Make {
    make(): Self;
};

public type Counter(public n: Int);

given Counter {
    public new(n: Int): Self = Counter(n);
    // An INHERENT static `make`, unmarked so it defaults to `internal`. It
    // owns the type's `make` slot, so `Counter.make()` resolves HERE.
    make(): Self = Counter(1);
};

// A conformance `make` on the same name (public requirement). It is what the
// old visibility-rescue fallback reached for when the inherent one was denied.
given Counter: Make {
    make(): Self = Counter(2);
};
