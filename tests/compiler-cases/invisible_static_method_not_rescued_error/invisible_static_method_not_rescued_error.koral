// EXPECT-ERROR: Cannot access internal method 'make'
// The inherent `make` is `internal`, so it is not callable across modules. A
// conformance method of the same name exists, but reaching it must NOT pull the
// invisible method back in: once a method is judged inaccessible it is reported
// as such, never rescued by a conformance lookup. Both compilers reject with the
// same text.

using "invisible_static_method_not_rescued_error/models" { Counter, Make };

public let main() Int = {
    let c = Counter.make();
    return c.n;
};
