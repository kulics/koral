// EXPECT: PASS
// A float converts to an integer by truncating toward zero first; the family
// range policy then applies to the truncated value.

let main(): Int = {
    if not (Int(3.9) == 3) then {
        eprintln("FAIL: Int(3.9) != 3");
        return 1;
    };
    if not (Int(-3.9) == -3) then {
        eprintln("FAIL: Int(-3.9) != -3");
        return 1;
    };
    if not (Int(300.7) == 300) then {
        eprintln("FAIL: Int(300.7) != 300");
        return 1;
    };

    println("PASS");
    return 0;
};
