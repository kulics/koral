// EXPECT: join_ok
// 字面 join 与两向对账的正例：int 字面量进整数宽度、rune 字面量进
// UInt8、反向 join 让后到的窄类型胜出（`[1, x]` → List[UInt8]），
// 泛型参数位的 echo guard 不受影响（`first_of([1, 2])` 绑 T = Int）。

let first_of[T: Any](xs: List[T]): T = xs[0];

let main(): Int = {
    let v = first_of([1, 2]);
    assert(v == 1, "generic call binds T = Int");

    let x: UInt8 = 7;
    let a = [1, x];
    assert(a.count() == 2, "reverse join list");
    assert(a[1] == 7, "narrow element survives");

    let b: List[UInt8] = ['a', 'b'];
    assert(b[0] == 'a', "rune literal joins UInt8");

    let c: List[Float64] = [1.0, 2.5];
    assert(c[1] == 2.5, "float literal joins float");

    let d: Dict[String, Int] = ["a": 1, "b": 2];
    assert(d.count() == 2, "dict literal with target");

    let e = ["x": 1, "y": 2];
    assert(e.count() == 2, "dict literal inference");

    let s: Set[Int] = [1, 2];
    assert(s.count() == 2, "set literal with target");

    let f: FrozenList[Int] = [1, 2, 3];
    assert(f.count() == 3, "frozen list literal");

    let g: [3]Int32 = [1, 2, 3];
    assert(g[2] == 3, "fixed array literal");

    println("join_ok");
    return 0;
};
