// EXPECT-ERROR: Member 'parse' not found in type 'Int'
// A missing static is the seed's throw point: the `or return` beneath it is
// never reached, so this is ONE line -- the missing member -- and not the
// downstream `'or return' ... got '?'` cascade. The file deliberately omits
// `using "std/text"`, which is what makes `Int.parse` missing.

let parse_port(s: String): Result[Int] = {
    let n = Int.parse(s) or return;
    return Result[Int].Ok(n);
};
