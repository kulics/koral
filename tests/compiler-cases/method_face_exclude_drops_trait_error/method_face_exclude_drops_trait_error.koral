// EXPECT-ERROR: Trait 'Speak' provides it but is not in scope
// `{ !Speak, ... }` takes the module whole minus `Speak`, so the trait is out
// of scope and its methods are not callable (§3.3/§3.4).

using "std" { ... };
using "./lib.koral" { Robot };
using "./traits.koral" { !Speak, ... };

public let main() Int = {
    let r = Robot.new("r2");
    println(r.say());
    return 0;
};
