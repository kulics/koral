// std.text: float specials accept [+-] and any case (Python float() rules).
// EXPECT: plus_inf_ok
// EXPECT: plus_nan_ok
// EXPECT: plain_nan_ok
// EXPECT: lower_inf_ok
// EXPECT: mixed_infinity_ok
// EXPECT: neg_infinity_ok
// EXPECT: neg_nan_sign_ok

using "std/text" { ... };

let main(): Int = {
    when Float64.parse("+inf") in {
        .Ok(f) then if f.is_inf() and not f.is_sign_negative() then println(
            "plus_inf_ok",
        )
        else println("FAIL plus_inf"),
        .Error(e) then println("FAIL plus_inf: " + e.message()),
    };

    when Float64.parse("+NaN") in {
        .Ok(f) then if f.is_nan() then println("plus_nan_ok")
        else println("FAIL plus_nan"),
        .Error(e) then println("FAIL plus_nan: " + e.message()),
    };

    // Existing spellings keep working
    when Float64.parse("nan") in {
        .Ok(f) then if f.is_nan() then println("plain_nan_ok")
        else println("FAIL plain_nan"),
        .Error(e) then println("FAIL plain_nan: " + e.message()),
    };

    when Float64.parse("inf") in {
        .Ok(f) then if f.is_inf() then println("lower_inf_ok")
        else println("FAIL lower_inf"),
        .Error(e) then println("FAIL lower_inf: " + e.message()),
    };

    when Float64.parse("iNfInItY") in {
        .Ok(f) then if f.is_inf() and not f.is_sign_negative() then println(
            "mixed_infinity_ok",
        )
        else println("FAIL mixed_infinity"),
        .Error(e) then println("FAIL mixed_infinity: " + e.message()),
    };

    when Float64.parse("-Infinity") in {
        .Ok(f) then if f.is_inf() and f.is_sign_negative() then println(
            "neg_infinity_ok",
        )
        else println("FAIL neg_infinity"),
        .Error(e) then println("FAIL neg_infinity: " + e.message()),
    };

    // Python float("-nan") keeps the sign bit
    when Float64.parse("-nan") in {
        .Ok(f) then if f.is_nan() and f.is_sign_negative() then println(
            "neg_nan_sign_ok",
        )
        else println("FAIL neg_nan_sign"),
        .Error(e) then println("FAIL neg_nan_sign: " + e.message()),
    };

    return 0;
};
