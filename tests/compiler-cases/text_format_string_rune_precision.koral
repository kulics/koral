// std.text: String.format precision counts runes and cuts on rune boundaries.
// EXPECT: one_rune_ok
// EXPECT: two_runes_ok
// EXPECT: over_precision_ok
// EXPECT: zero_precision_ok
// EXPECT: ascii_precision_ok

using "std/text" { ... };

let main(): Int = {
    // "你好" is two runes (six bytes); .1 must keep the first rune whole
    if "你好".format(".1").equals("你") then println("one_rune_ok")
    else println("FAIL one_rune: [" + "你好".format(".1") + "]");

    if "你好".format(".2").equals("你好") then println("two_runes_ok")
    else println("FAIL two_runes: [" + "你好".format(".2") + "]");

    // Precision beyond the rune count keeps the whole string
    if "你好".format(".3").equals("你好") then println("over_precision_ok")
    else println("FAIL over_precision: [" + "你好".format(".3") + "]");

    if "你好".format(".0").equals("") then println("zero_precision_ok")
    else println("FAIL zero_precision: [" + "你好".format(".0") + "]");

    // ASCII behaves as before
    if "abcdef".format(".3").equals("abc") then println("ascii_precision_ok")
    else println("FAIL ascii_precision: [" + "abcdef".format(".3") + "]");

    return 0;
};
