// Test or return diagnostics inside defer expression
// EXPECT-ERROR: control flow statement 'return' is not allowed in defer expression

let invalid_defer() Result[Int] = {
    defer {
        let value = Result[Int].Error(box("boom")) or return
        println(value.to_string())
    }
    return Result[Int].Ok(0)
}

let main() Int = {
    let _ = invalid_defer()
    return 0
}