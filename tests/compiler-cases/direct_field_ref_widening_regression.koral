// EXPECT: ok

type Kind {
    A(),
    B(),
}

given Kind not Deref

type Expr(kind * Kind)

let read(expr Expr) * Kind = expr.kind

let classify(kind * Kind) Int = when kind in {
    .A() then 1,
    .B() then 2,
}

let main() Void = {
    let kind_a *mutable Kind = box(Kind.A())
    let expr = Expr(kind_a)
    assert(classify(read(expr)) == 1, "field * should remain readonly")
    println("ok")
}
