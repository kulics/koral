// EXPECT-ERROR: Cannot implement requirement 'value' with a 'public' method: the requirement's access level is 'internal'.
// The reverse mismatch: the trait is internal (no modifier), so its
// requirement's level is `internal`, and a `public` implementation is a WIDER
// level. Equal or omitted -- never a written deviation in either direction.

trait Tag {
    value(self): Int;
};

type Box(v: Int);

given Box: Tag {
    public value(self): Int = self.v;
};

let main(): Int = {
    return 0;
};
