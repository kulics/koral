// A public trait carrying a STATIC requirement (no `self`): `make` is a
// constructor-like associated function, not a receiver method.

public trait Make {
    make(): Self;
};

public type Counter(public n: Int);

given Counter {
    public new(n: Int): Self = Counter(n);
};

// The implementation writes no access modifier, yet `make` is callable from
// other modules: a requirement's visibility follows the trait's, not the
// impl's spelling.

given Counter: Make {
    make(): Self = Counter(7);
};
