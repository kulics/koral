// EXPECT-ERROR: Only a 'type mutable' can implement Drop
//
// An enum has no `type mutable` form (`type_mutable_enum_error`), so an enum
// can never implement Drop: cleanup lives only on the ARC layer, and an
// enum's cleanup is its synthesized field release. A resource enum wraps an
// inner `type mutable` box and the destructor runs there, at RC-0.

using "std" { ... };

type Pinned {
    Empty(),
    Node(value: Int),
};

given Pinned: Drop {

    drop(self): Void = {
        println("drop");
    };
};

let main(): Void = {
    let value = Pinned.Empty();
};
