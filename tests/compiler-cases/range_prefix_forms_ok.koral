// EXPECT: PASS

// Ranges still parse in every position that expects a range value: open
// (`...b`, `...<b`, `...`) as a binding initializer, and closed (`a..b`,
// `a..<b`, `a<..b`, `a<..<b`) written without gaps around the operator.

let main(): Int = {
    let prefix_to = ...5;
    let prefix_to_open = ...<5;
    let full: Range[Int] = ...;
    let closed = 1..5;
    let closed_open = 1..<5;
    let open_closed = 1<..5;
    let open = 1<..<5;
    if not prefix_to.contains(0) then {
        eprintln("FAIL: prefix_to should contain 0");
        return 1;
    };
    if not prefix_to.contains(5) then {
        eprintln("FAIL: prefix_to should contain 5");
        return 1;
    };
    if prefix_to_open.contains(5) then {
        eprintln("FAIL: prefix_to_open should not contain 5");
        return 1;
    };
    if not full.contains(100) then {
        eprintln("FAIL: full should contain 100");
        return 1;
    };
    if closed.contains(0) or not closed.contains(3) then {
        eprintln("FAIL: closed range bounds");
        return 1;
    };
    if closed_open.contains(5) or not closed_open.contains(4) then {
        eprintln("FAIL: closed_open range bounds");
        return 1;
    };
    if open_closed.contains(1) or not open_closed.contains(5) then {
        eprintln("FAIL: open_closed range bounds");
        return 1;
    };
    if open.contains(1) or open.contains(5) or not open.contains(3) then {
        eprintln("FAIL: open range bounds");
        return 1;
    };
    println("PASS");
    return 0;
};
