// EXPECT-ERROR: 'sendable' qualifier applies only to function types; declare the trait 'sendable' instead
// A trait-object shape under the `sendable` qualifier is refused with the
// pointer to `trait sendable`: the qualifier is gone from the trait-object
// surface (concurrency-design.md §派生规则 5、6).

trait Speak {
    speak(self): Int;
};

let f(x: sendable Speak): Void = {};

let main(): Int = {
    return 0;
};
