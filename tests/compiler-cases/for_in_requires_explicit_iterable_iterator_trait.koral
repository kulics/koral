// EXPECT-ERROR: does not explicitly implement trait [Int]Iterator

type MyIter()
type MyRange()

given MyIter {

    next(*self) Option[Int] = Option.None()
}

given MyRange {

    iterator(*self) MyIter = MyIter()
}

let main() Int = {
    let r = MyRange()
    for n in r then {
        let _ = n
    }
    return 0
}
