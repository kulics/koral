// EXPECT-ERROR: Cannot call unsafe function 'new' outside an 'unsafe' block: the declaration is marked 'unsafe'.
// The constructor form of a static/associated method carries its `unsafe`
// marker like any other callee (unsafe-design.md §B1). `Box.new()` outside an
// `unsafe` block must be refused exactly as `Box.make()` is.

type Box(v: Int);

given Box {
    unsafe new(v: Int): Box = Box(v);
};

let main(): Int = {
    let b = Box.new(3);
    let _ = b;
    return 0;
};
