// EXPECT: range full arg ok

// `...` as an argument is the full range (Range[T].Full()), the same value
// `= ...` gives a parameter with no argument. The old default-fill spelling
// `f(...)` is gone; `...` here is an ordinary range literal.

type Span(range: Range[Int] =);

let take_named(span: Range[Int] =): Bool = span.contains(0);

let take_pos(r: Range[Int]): Bool = r.contains(0);

let main(): Int = {
    let s = Span(range = ...);
    if not take_pos(...) then {
        eprintln("FAIL: positional full range");
        return 1;
    };
    if not take_named(span = ...) then {
        eprintln("FAIL: named full range");
        return 1;
    };
    if not s.range.contains(0) then {
        eprintln("FAIL: constructor full range");
        return 1;
    };
    println("range full arg ok");
    return 0;
};
