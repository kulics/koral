// EXPECT: circle(3)
// EXPECT: circle(3)
// EXPECT: 21
// `c as Drawable` is the explicit upcast to a trait object -- the same value
// the implicit coercion on assignment produces, spelled where an expression
// is needed.

trait Drawable {
    draw(self) String;
};

type Circle(r Int);

given Circle as Drawable {
    draw(self) String = "circle(\(self.r))";
};

trait Transform[T Any] {
    apply(self, v T) T;
};

given Circle as Transform[Int] {
    apply(self, v Int) Int = v * self.r;
};

let main() Int = {
    let c = Circle(3);

    // explicit upcast to a trait object
    let d = c as Drawable;
    println(d.draw());

    // in expression position
    println((c as Drawable).draw());

    // generic trait target
    let t = c as Transform[Int];
    println(t.apply(7).to_string());
    return 0;
};
