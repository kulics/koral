// EXPECT: circle(3)
// EXPECT: circle(3)
// EXPECT: 21
// `Drawable(c)` is the explicit upcast to a trait object -- the same value
// the implicit coercion on assignment produces, spelled where an expression
// is needed. The call form takes exactly one positional argument, and its
// target is the trait name with its type arguments, if any.

trait Drawable {
    draw(self): String;
};

type Circle(r: Int);

given Circle: Drawable {
    draw(self): String = "circle(\(self.r))";
};

trait Transform[T: Any] {
    apply(self, v: T): T;
};

given Circle: Transform[Int] {
    apply(self, v: Int): Int = v * self.r;
};

let main(): Int = {
    let c = Circle(3);

    // explicit upcast to a trait object
    let d = Drawable(c);
    println(d.draw());

    // in expression position
    println(Drawable(c).draw());

    // generic trait target
    let t = Transform[Int](c);
    println(t.apply(7).to_string());
    return 0;
};
