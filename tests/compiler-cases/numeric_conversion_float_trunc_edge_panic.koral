// EXPECT-ERROR: Panic: numeric conversion overflow at
// Truncate-then-check: -1.0 truncates to -1, which is outside UInt8's range,
// so the conversion panics. (Its neighbour -0.5 truncates to 0 and converts --
// see numeric_conversion_float_trunc_bounds_test.)

let main(): Void = {
    let x: UInt8 = UInt8(-1.0);
    println(x);
};
