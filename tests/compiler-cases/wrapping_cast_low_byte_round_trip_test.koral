// EXPECT: PASS
// The low-byte idiom: serialize a wide integer one byte at a time and read the
// bytes back. Under the checked `Type(x)` rule every byte take above 255 would
// panic; `wrapping_cast` is the unchecked truncation, so the round trip holds
// for any bit pattern.

let main() Int = {
    let value UInt32 = 305419896;

    // Serialize big-endian: high byte first.
    let mutable bytes = List[UInt8].new();
    bytes.push((value >> 24).wrapping_cast[UInt8]());
    bytes.push((value >> 16).wrapping_cast[UInt8]());
    bytes.push((value >> 8).wrapping_cast[UInt8]());
    bytes.push(value.wrapping_cast[UInt8]());

    if bytes.count() != 4 then {
        eprintln("FAIL: expected 4 bytes, got \(bytes.count())");
        return 1;
    };
    if bytes[0] != 18 or bytes[1] != 52 or bytes[2] != 86 or bytes[3] != 120 then {
        eprintln("FAIL: big-endian bytes, got \(bytes[0]) \(bytes[1]) \(bytes[2]) \(bytes[3])");
        return 1;
    };

    // Read them back: widen and re-assemble.
    let back = (UInt32(bytes[0]) << 24) | (UInt32(bytes[1]) << 16) | (UInt32(bytes[2]) << 8) | UInt32(bytes[3]);
    if back != value then {
        eprintln("FAIL: round trip, got \(back)");
        return 1;
    };

    // A negative Int8's low byte round trips through UInt8 and back.
    let neg Int8 = -57;
    let raw UInt8 = neg.wrapping_cast[UInt8]();
    let restored Int8 = raw.wrapping_cast[Int8]();
    if raw != 199 then {
        eprintln("FAIL: Int8 -57 low byte, got \(raw)");
        return 1;
    };
    if restored != -57 then {
        eprintln("FAIL: UInt8 199 -> Int8, got \(restored)");
        return 1;
    };

    println("PASS");
    return 0;
};
