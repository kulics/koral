// EXPECT-ERROR: Rest pattern cannot bind a name
// Design guard: `...` ignores the slots it swallows. There is no name for them
// to bind to, so `...x` is refused rather than silently meaning `_` or a
// slice -- a binding would promise a value the pattern never produced.
using "std" { ... };

let main(): Int = {
    let xs: List[Int] = [1];
    let s = when xs in {
        [...x] then 1,
        _ then 2,
    };
    println(s);
    return 0;
};
