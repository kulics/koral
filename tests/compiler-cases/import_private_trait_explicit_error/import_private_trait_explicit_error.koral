// EXPECT-ERROR: Undefined trait: PrivTrait
//
// An explicit list is not a hole in the access rule (§3.3). The batch path
// (`using "m" { ... };`) already refuses to bring a `module_private` trait in,
// and its use is "Undefined trait" -- naming the trait in an explicit list must
// be refused exactly the same way. A name that cannot be imported is not in
// the file's scope to begin with, so the reader is told the trait is undefined,
// not that it is inaccessible.
using "std" { ... };
using "import_private_trait_explicit_error/mod_a" { PrivTrait };

let f[T PrivTrait](x T) T = x;

let main() Int = {
    return 0;
};
