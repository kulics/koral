// The bit toolbox lives on `BinaryInteger` (fixed-width binary word) and is
// shared by the families. Bit operations are total functions on the bit
// pattern, so a Wrapping value produces exactly the same result as its
// same-width plain twin -- and generic code over `BinaryInteger` runs on
// either family.
// EXPECT: bit_count_ok
// EXPECT: bit_rotate_ok
// EXPECT: bit_reverse_swap_ok
// EXPECT: bit_generic_ok

using "std/math" { ... };

let ones[T BinaryInteger](x T) UInt = x.count_ones();
let rot[T BinaryInteger](x T, n UInt) T = x.rotate_left(n);
let rev[T BinaryInteger](x T) T = x.reverse_bits();

let main() Int = {
    if WrappingUInt32(0x00f0f0f0).count_ones() == UInt32(0x00f0f0f0).count_ones()
        and WrappingInt8(-1).count_ones() == Int8(-1).count_ones()
        and WrappingUInt(255).count_zeros() == UInt(255).count_zeros()
        and WrappingInt8(1).leading_zeros() == Int8(1).leading_zeros()
        and WrappingInt8(1).trailing_zeros() == Int8(1).trailing_zeros()
        and WrappingInt8(-1).leading_ones() == Int8(-1).leading_ones()
        and WrappingInt8(-1).trailing_ones() == Int8(-1).trailing_ones() then {
        println("bit_count_ok");
    };

    // Self-returning methods: retag the result to the plain family (same
    // width, lossless) and compare with the plain twin's answer.
    if UInt32(WrappingUInt32(0x00f0f0f0).rotate_left(8)) == UInt32(0x00f0f0f0).rotate_left(8)
        and UInt32(WrappingUInt32(0x00f0f0f0).rotate_right(8)) == UInt32(0x00f0f0f0).rotate_right(8)
        and Int8(WrappingInt8(1).rotate_left(3)) == Int8(1).rotate_left(3) then {
        println("bit_rotate_ok");
    };

    if UInt32(WrappingUInt32(0x00f0f0f0).reverse_bits()) == UInt32(0x00f0f0f0).reverse_bits()
        and Int(WrappingInt(1).reverse_bits()) == Int(1).reverse_bits()
        and UInt(WrappingUInt(255).swap_bytes()) == UInt(255).swap_bytes()
        and Int8(WrappingInt8(1).swap_bytes()) == Int8(1).swap_bytes() then {
        println("bit_reverse_swap_ok");
    };

    if ones(WrappingUInt32(0x00f0f0f0)) == ones(UInt32(0x00f0f0f0))
        and Int8(rot(WrappingInt8(1), 3)) == Int8(1).rotate_left(3)
        and Int(rev(WrappingInt(1))) == Int(1).reverse_bits() then {
        println("bit_generic_ok");
    };

    return 0;
};
