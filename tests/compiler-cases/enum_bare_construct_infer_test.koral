// EXPECT: bare_infer_ok 1 42
// A bare generic-case construction pins its type arguments from the call's
// own arguments -- the same rule implicit struct construction follows -- so
// `Res.Ok(1)` is `Res[Int]` and the expected type may read its payload.

type Res[T: Any] {
    Ok(value: T),
    Error(message: String),
};

let main(): Void = {
    let d = Res.Ok(1);
    let e: Res[Int] = d;
    let v = when e in {
        .Ok(p) then p,
        .Error(m) then 0,
    };
    let w: Res[Int] = Res.Ok(42);
    let x = when w in {
        .Ok(p) then p,
        .Error(m) then 0,
    };
    println("bare_infer_ok \(v) \(x)");
};
