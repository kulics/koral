// EXPECT: named: 5
// EXPECT: pair: 9
// An explicitly-typed generic call takes named arguments exactly like a bare
// call: the parameter labels travel with the function's signature, not with
// the spelling of the callee.

let f[T: Any](p: T =): T = p;

let g[T: Any](p: T =, q: T =): T = q;

let main(): Int = {
    let x = f[Int](p = 5);
    println("named: \(x)");
    let y = g[Int](p = 7, q = 9);
    println("pair: \(y)");
    return 0;
};
