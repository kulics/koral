// EXPECT-ERROR: cannot call method 'sum' on pointer type '*unsafe Point'; pointers support direct field access only

type Point(x Int, y Int)

given Point {
    public sum(self) Int = self.x + self.y
}

let main() Int = {
    let p = Point(1, 2)
    let rp *unsafe Point = &unsafe p
    return rp.sum()
}