// EXPECT-ERROR: cannot call method 'sum' on raw pointer type '*raw Point'; raw pointers support direct field access only

type Point(x Int, y Int)

given Point {
    public sum(self) Int = self.x + self.y
}

let main() Int = {
    let p = Point(1, 2)
    let rp *raw Point = &raw p
    return rp.sum()
}