// EXPECT: 999
// EXPECT: member_call_prefers_method_ok
// A call resolves a method of that name before a field of the same name
// (Rust/Kotlin rule); the bare member read stays field-first.

type Point(fd: Int);

given Point {
    fd(self): Int = {
        return 999;
    };
};

let main(): Void = {
    let p = Point(1);
    println(p.fd());
    assert(p.fd == 1, "bare member read is the field");
    println("member_call_prefers_method_ok");
};
