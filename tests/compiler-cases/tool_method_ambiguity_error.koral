// EXPECT-ERROR: Ambiguous method 'describe' for type 'Box' via trait extensions
// 同名工具方法来自多个 trait 时，未限定调用报歧义——guide「Override and
// Conflict Rules」：Koral 不隐式选择，须用完全限定调用消歧（见
// tool_method_qualified_ok）。

trait A {
    get(self): Int;
};
trait B {
    fetch(self): Int;
};

given A {
    describe(self): Int = 1;
};
given B {
    describe(self): Int = 2;
};

type Box(x: Int);

given Box: A {
    get(self): Int = 0;
};
given Box: B {
    fetch(self): Int = 0;
};

let main(): Int = {
    let b = Box(1);
    let v = b.describe();
    return v;
};
