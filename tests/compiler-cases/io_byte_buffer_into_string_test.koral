// EXPECT: into_string_ok
// `try_into_string` hands the accumulated bytes to a `String` and empties the
// buffer; `try_to_string` snapshots. 编码问题走 `Result.Error` 不 panic。The
// buffer's storage is a plain `alloc_memory` block (not a single-block
// `Bytes`), so this is a one-copy handover rather than StringBuilder's
// adoption; capacity stays, like `clear`.

using "std/io" { ... };

let main(): Void = {
    let mutable b = ByteBuffer.from_string("hello world");
    let s = b.try_into_string().unwrap();
    assert(s == "hello world", "from_string roundtrip");
    assert(b.try_into_string().unwrap() == "", "drained");

    // The buffer stays usable after the handover.
    let _ = b.write_all(from = "again".as_slice());
    assert(b.try_into_string().unwrap() == "again", "reuse after handover");

    // The whole buffer is handed over regardless of the cursor.
    let mutable c = ByteBuffer.from_string("abcd");
    let mutable sink = List[UInt8].new();
    sink.push(0);
    sink.push(0);
    let c2 = c;
    let n = sink.borrow_slice((sl) => c2.read(into = sl[0..<2])) or else 0;
    assert(n == 2, "read two");
    assert(c.try_into_string().unwrap() == "abcd", "whole buffer handover");
    assert(c.try_into_string().unwrap() == "", "drained after cursor use");

    // Snapshot extractions (`to_*`) leave the buffer untouched.
    let mutable t = ByteBuffer.from_string("snap");
    assert(t.try_to_string().unwrap() == "snap", "try_to_string snapshot");
    let snap_bytes = t.to_bytes();
    assert(snap_bytes.count() == 4, "to_bytes snapshot count");
    assert(snap_bytes[0] == 's' and snap_bytes[3] == 'p', "to_bytes snapshot content");
    assert(t.try_into_string().unwrap() == "snap", "buffer untouched by snapshots");

    // `into_bytes` hands the whole content over and drains the buffer.
    let mutable d = ByteBuffer.from_string("abcd");
    let got = d.into_bytes();
    assert(got.count() == 4, "into_bytes count");
    assert(got[0] == 'a' and got[3] == 'd', "into_bytes content");
    assert(d.into_bytes().count() == 0, "into_bytes drained");
    assert(d.try_into_string().unwrap() == "", "drained after into_bytes");

    // `to_bytes` ignores the cursor, unlike the Reader `read_all`.
    let mutable e = ByteBuffer.from_string("wxyz");
    let e2 = e;
    let n2 = sink.borrow_slice((sl) => e2.read(into = sl[0..<2])) or else 0;
    assert(n2 == 2, "read two again");
    let full = e.to_bytes();
    assert(full.count() == 4, "to_bytes whole content");
    assert(full[2] == 'y', "to_bytes beyond cursor");

    // 编码错误走 Error 不 panic；失败的交接不动缓冲。
    let mut_bytes = List[UInt8].new();
    mut_bytes.push(255);
    mut_bytes.push(254);
    let mutable bad = ByteBuffer.from_bytes(mut_bytes);
    assert(bad.try_to_string().is_error(), "invalid utf8 -> error");
    assert(bad.to_bytes().count() == 2, "snapshot failed: buffer untouched");
    assert(bad.try_into_string().is_error(), "handover failed -> error");
    assert(bad.to_bytes().count() == 2, "failed handover drains nothing");

    println("into_string_ok");
};
