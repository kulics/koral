// EXPECT-ERROR: Rune literal must be a single ASCII character when used as UInt8
// A rune literal beside a `UInt8` is a byte comparison (`b >= 'a'`), and a
// non-ASCII rune says so at the literal -- the same complaint the binding
// form makes, in both compilers.

let main(): Int = {
    let b: UInt8 = 65;
    let x = b == '中';
    if x then {
        println("y");
    };
    return 0;
};
