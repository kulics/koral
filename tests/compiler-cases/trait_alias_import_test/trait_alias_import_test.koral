using "trait_alias_import_test/alpha" { Tag as TagA, a_box, read };

// EXPECT: 7
// A trait imported under an ALIAS is a trait: `TagA` must resolve, objectify,
// and convert exactly as `Tag` does in the declaring module. The alias exists
// only in THIS module's name space, so any step that re-resolves the trait's
// own spelling (`Tag`) in the declaring module -- object-safety checking,
// conformance checking, the conversion node's identity -- breaks the alias
// while the unrenamed import keeps working.

let main(): Int = {
    let t: TagA = a_box();
    println(read(t).to_string());
    return 0;
};
