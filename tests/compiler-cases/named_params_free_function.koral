// EXPECT: 30
// EXPECT: 30

// Free function calls must plan named arguments through the unified
// call-argument planner: labels are matched and arguments reordered.

let scale(value: Int, factor: Int) Int = value * factor;

let main() Int = {
    // declaration order
    println(scale(value: 10, factor: 3).to_string());
    // named args out of declaration order must reorder correctly
    println(scale(factor: 3, value: 10).to_string());
    return 0;
};
