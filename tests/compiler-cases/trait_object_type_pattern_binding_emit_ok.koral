trait Problem {
    render(*self) Int;
};

type ProbeIoError(value Int);
type ProbeNetError(value Int);

given ProbeIoError as Problem {

    render(*self) Int = self.value;
};

given ProbeNetError as Problem {

    render(*self) Int = self.value + 100;
};

given ProbeIoError {

    payload(*self) Int = self.value;
};

let describe(err * Problem) Int = when err in {
    io *ProbeIoError then io.payload(),
    _ then err.render(),
};

let main() Int = {
    let err * Problem = box(ProbeIoError(7));
    if err is *ProbeIoError then {
        if err is io *ProbeIoError then {
            return io.payload() + describe(err);
        };
    };
    return 0;
};