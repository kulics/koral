private let x: Int = 10;

protected let shared: Int = 7;

public let foo(): Void = {
    println(x);
};

internal type Point(public x: Int, private y: Int);

given Point {

    public get_y(self): Int = {
        return self.y;
    };
};

public let main(): Void = {
    foo();
    println(shared);
};
// EXPECT: 10
// EXPECT: 7
