// EXPECT: for_or_pattern_exhaustive_ok
// Design guard: an `or` whose alternatives together cover every case is
// total. `.A(x) or .B(x)` is irrefutable on a two-case enum -- neither side
// alone is, so the syntactic shortcut refuses it and only the coverage
// judgement accepts it.

using "std";

type E {
    A(x Int),
    B(x Int),
};

let main() Int = {
    let xs = List[E].new();
    xs.push(E.A(1));
    xs.push(E.B(2));
    xs.push(E.B(3));
    let mutable sum = 0;
    for .A(x) or .B(x) in xs then {
        sum += x;
    };
    if sum == 6 then {
        println("for_or_pattern_exhaustive_ok");
    };
    return 0;
};
