// EXPECT: ?*mut upgrade: 7
// EXPECT: ?*mut released
// EXPECT: trait ?*mut upgrade

trait Bump {
    bump(*mut self) Int
}

type Counter(mut value Int)

given Counter as Bump {

    public bump(*mut self) Int = {
        self.value += 1
        return self.value
    }
}

let main() Int = {
    let weak = make_weak_counter()

    when upgrade_mut(weak) in {
        .Some(_) then println("?*mut leaked"),
        .None then println("?*mut released"),
    }

    let strong_trait *mut Counter = box(Counter(0))
    let obj *mut Bump = strong_trait
    let traitWeak ?*mut Bump = downgrade_mut(obj)

    when upgrade_mut(traitWeak) in {
        .Some(_) then println("trait ?*mut upgrade"),
        .None then println("trait ?*mut failed"),
    }

    return 0
}

let make_weak_counter() ?*mut Counter = {
    let strong *mut Counter = box(Counter(6))
    let upgraded = upgrade_mut(downgrade_mut(strong)).unwrap()
    print("?*mut upgrade: ")
    println(upgraded.bump())
    return downgrade_mut(strong)
}
