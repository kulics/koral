// EXPECT: ?*mutable upgrade: 7
// EXPECT: ?*mutable released
// EXPECT: trait ?*mutable upgrade

trait Bump {
    bump(*mutable self) Int
}

type Counter(mutable value Int)

given Counter as Bump {

    public bump(*mutable self) Int = {
        self.value += 1
        return self.value
    }
}

let main() Int = {
    let weak = make_weak_counter()

    when upgrade_mut(weak) in {
        .Some(_) then println("?*mutable leaked"),
        .None then println("?*mutable released"),
    }

    let strong_trait *mutable Counter = box(Counter(0))
    let obj *mutable Bump = strong_trait
    let traitWeak ?*mutable Bump = downgrade_mut(obj)

    when upgrade_mut(traitWeak) in {
        .Some(_) then println("trait ?*mutable upgrade"),
        .None then println("trait ?*mutable failed"),
    }

    return 0
}

let make_weak_counter() ?*mutable Counter = {
    let strong *mutable Counter = box(Counter(6))
    let upgraded = upgrade_mut(downgrade_mut(strong)).unwrap()
    print("?*mutable upgrade: ")
    println(upgraded.bump())
    return downgrade_mut(strong)
}
