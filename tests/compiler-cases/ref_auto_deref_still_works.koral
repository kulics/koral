// EXPECT: 2

// Tests that auto-deref for method calls on *T still works alongside blanket given
// under the current U2 surface.

type Counter(mutable value Int)

given Counter {

    public increment(*mutable self) Void = {
        self.value = self.value + 1
    }
    public get(self) Int = self.value
}

let main() Void = {
    let mutable c = Counter(0)
    let r = &mutable c
    r.increment()
    r.increment()
    println(r.get())
}
