// EXPECT: true-return: 11
// EXPECT: false-return: 22

let choose_getter(flag Bool) Func[Int] = {
    let mut left = 11
    let mut right = 22
    let chosen ref Int = if flag then left.ref else right.ref
    return () -> chosen.val
}

let main() Int = {
    let true_getter = choose_getter(true)
    let false_getter = choose_getter(false)
    println("true-return: " + true_getter().to_string())
    println("false-return: " + false_getter().to_string())
    return 0
}