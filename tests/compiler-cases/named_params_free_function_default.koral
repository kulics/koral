// EXPECT: 10
// EXPECT: 50

// Free function named parameters support declared default values.

let scale(value Int, factor: Int = 5) Int = value * factor;

let main() Int = {
    // default fill
    println(scale(2).to_string());
    // explicit override
    println(scale(2, factor: 25).to_string());
    return 0;
};
