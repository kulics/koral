// EXPECT-ERROR: not object-safe

trait ManagedOnly {
    touch(self ref Self) Void
}

type Counter(mut value Int)

given Counter as ManagedOnly {
    public touch(self ref Self) Void = {}
}

let main() Int = {
    let counter ref mut Counter = box(Counter(1))
    let obj ref ManagedOnly = counter
    let _ = obj
    return 0
}