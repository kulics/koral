using "trait_plain_import_bound_wrong_trait_error/alpha" { Tag, a_box };
using "trait_plain_import_bound_wrong_trait_error/beta" { b_box };

// EXPECT-ERROR: Type BBox does not explicitly implement trait Tag (checking constraint T: Tag)
// `Tag` here is the one this file imported from alpha. `BBox` satisfies beta's
// `Tag`, which is a different trait, so this call must be refused. Resolving
// the bound through the unqualified index -- last-wins across modules -- would
// land on whichever `Tag` registered last and accept it.

let read[T: Tag](x: T): Int = x.value();

let main(): Int = {
    println(read(b_box()).to_string());
    return 0;
};
