// The visibility rule limits what may be BOUND, not what may be ignored: `_`
// does not read the field, so an unreadable field is fine as long as nobody
// takes its value.
// EXPECT: discard_ok
// EXPECT: named_discard_ok

using "std";
using "./types.koral";

type Local(name Int, secret: Int);

public let main() Int = {
    let p = SecretPoint.new(10, 20);
    let (a, _) = p;
    assert(a == 10, "keep the readable field");
    println("discard_ok");

    let l = Local(1, secret: 2);
    let v = when l in {
        Local(n, secret: _) then n,
    };
    assert(v == 1, "named field ignored by wildcard");
    println("named_discard_ok");

    return 0;
};
