// EXPECT: global capture first: 11
// EXPECT: global capture second: 16

private let mutable counter = 10;

let make_bump() () -> Int = {
    return () => {
        counter = counter + 1;
        return counter;
    };
};

let main() Int = {
    let bump = make_bump();
    println("global capture first: " + bump().to_string());

    counter = 15;
    println("global capture second: " + bump().to_string());
    return 0;
};
