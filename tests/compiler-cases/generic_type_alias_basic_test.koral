// Generic type aliases expand transparently: the alias name behaves exactly
// like its target spelling, including construction and nested instantiation.
// EXPECT: alias_new:
// EXPECT: 7
// EXPECT: alias_annotation:
// EXPECT: 3
// EXPECT: alias_chain:
// EXPECT: 11
// EXPECT: alias_opaque:
// EXPECT: 42
// EXPECT: alias_nested:
// EXPECT: 5

type Box2[T: Any] = List[T];
type Box4[T: Any] = Box2[T];
type Id[T: Any] = T;
type Pairs[T: Any] = List[List[T]];

let sum_box(b: Box2[Int]): Int = {
    let mutable total = 0;
    for i in 0..<b.count() then {
        total = total + b[i];
    };
    return total;
};

let main(): Int = {
    let mutable x = Box2[Int].new();
    x.push(3);
    x.push(4);
    println("alias_new:");
    println(sum_box(x));

    let y: Box2[Int] = x;
    println("alias_annotation:");
    println(y[0]);

    let mutable z = Box4[Int].new();
    z.push(11);
    println("alias_chain:");
    println(z[0]);

    let n: Id[Int] = 42;
    println("alias_opaque:");
    println(n);

    let mutable p = Pairs[Int].new();
    let mutable inner = List[Int].new();
    inner.push(5);
    p.push(inner);
    println("alias_nested:");
    println(p[0][0]);

    return 0;
};
