// EXPECT-ERROR: Undefined variable: stdout_write_lock

// Cross-PACKAGE access to a `protected` global: `stdout_write_lock` belongs
// to the std package (any module inside it) and must read as undeclared in
// user code. Invisible is undeclared (§3.3).

let main(): Void = {
    let w = stdout_write_lock;
    let _ = w;
};
