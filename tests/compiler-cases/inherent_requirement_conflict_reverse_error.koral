// EXPECT-ERROR: Duplicate definition: describe
// The same collision as inherent_requirement_conflict_error with the two
// blocks swapped: the error is a property of the name on the type, so the
// declaration order must not turn it into silent priority resolution.

trait Tag {
    describe(self): String;
};

type Num(x: Int);

given Num {
    describe(self): String = "inherent";
};

given Num: Tag {
    describe(self): String = "tag";
};

let main(): Int = {
    return 0;
};
