// EXPECT-ERROR: Member 'Bar' not found in type 'Box2[Int, String]'
// EXPECT-ERROR: Member 'bogus' not found in type 'Box2[Int, String]'
// A missing member names the receiver AS THE CALL WROTE IT -- type arguments
// and all -- in both spellings. The case-shaped one is a Member on a struct
// base (structs have no cases); the lowercase one is a static miss.

type Box2[A: Any, B: Any](first: A, second: B);

let a(): Void = {
    let x = Box2[Int, String].Bar(1);
};
let b(): Void = {
    let x = Box2[Int, String].bogus(1);
};
