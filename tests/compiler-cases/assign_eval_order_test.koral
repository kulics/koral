// EXPECT: index
// EXPECT: rhs
// EXPECT: 7
// EXPECT: base
// EXPECT: rhs2
// EXPECT: eval_order_ok

// Assignments evaluate left to right -- the left path and its subscripts
// first, then the right-hand side, then the write -- the same order for every
// type (concurrency-design.md §赋值求值顺序). The printed order is the
// evaluation order.

type mutable Box(mutable v: Int);

let base(): Box = {
    println("base");
    return Box(0);
};

let index(): Int = {
    println("index");
    return 0;
};

let rhs(): Int = {
    println("rhs");
    return 7;
};

let rhs2(): Int = {
    println("rhs2");
    return 11;
};

let main(): Void = {
    let xs = List[Int].new();
    xs.push(0);
    xs[index()] = rhs();
    println(xs[0]);
    base().v = rhs2();
    println("eval_order_ok");
};
