// EXPECT: 0
// Bare generic-method calls infer their type arguments from the arguments'
// conformances: `zip`'s `S2 = List[Rune]` fixes `U` and `R2` through List's
// `Iterable[T, ListIterator[T]]` conformance -- the chain resolves because
// the inference iterates (`Iterable` yields `R`, then `R`'s own `Iterator`
// bound yields `U`). The RESULT arguments must be collected in the method's
// DECLARATION order too: discovery order reads `zip[U, R2, S2]`'s `S2` first
// (the `other:` parameter) and slots every argument one place over.

let main(): Void = {
    let a: List[Rune] = "ab".to_runes();
    let b: List[Rune] = "cd".to_runes();
    when a.lazy().zip(b).position((p) => p.first != p.second) in {
        .Some(i) then println(i.to_string()),
        .None() then println("same"),
    };
};
