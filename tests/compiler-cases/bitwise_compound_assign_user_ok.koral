// EXPECT: 2
// EXPECT: 14
// A user type implementing the bitwise traits works under `&=` and `|=`, not
// just the binary operators -- the same shape compound_assign_user_add_ok
// pins for `+=`.

type Mask(bits: UInt8);

given Mask: BitAnd[Mask] {
    public bit_and(self, other: Mask): Mask = Mask(self.bits & other.bits);
};

given Mask: BitOr[Mask] {
    public bit_or(self, other: Mask): Mask = Mask(self.bits | other.bits);
};

given Mask {
    public to_string(self): String = self.bits.to_string();
};

let main(): Int = {
    let mutable m = Mask(3);
    m &= Mask(2);
    println(m.to_string());

    let mutable n = Mask(8);
    n |= Mask(6);
    println(n.to_string());
    return 0;
};
