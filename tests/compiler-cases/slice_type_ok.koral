// EXPECT: PASS
// Slice window spellings (slice-design): `[]T` / `[]mutable T` resolve to std's
// Slice/MutSlice templates, `[]mutable T` narrows implicitly to `[]T`, and the
// subscript forms type-check. The bodies below are never called with real
// windows -- construction APIs (as_slice/with_slice/into_slice) arrive with the
// owner migration -- but they run the full type check, which is the pin.

let take_readonly(s: []Int): Int = {
    if s.count() > 0 then {
        let head: Int = s[0];
        let window: []Int = s[0..<1];
        return head + window.count();
    };
    return 0;
};

let take_mutable(s: []mutable Int): Int = {
    // `[]mutable Int` narrows to `[]Int` (the one-way capability coercion).
    let total = take_readonly(s);
    if s.count() > 0 then {
        s[0] = total;
    };
    return total;
};

let main(): Int = {
    println("PASS");
    return 0;
};
