// EXPECT: PASS
// A weak field may name the type being declared. `Node` is `type mutable` by
// its own declaration, and a field's `?Node` is resolved before `Node` is
// complete -- mutability has to be known from the declaration, not from the
// finished definition. The self-reference is legal because the field is weak,
// so it contributes no size cycle.

type mutable Node(next ?Node);

public let main() Int = {
    let kids List[?Node] = [];
    if kids.count() != 0 then {
        eprintln("FAIL: expected an empty weak list");
        return 1;
    };
    println("PASS");
    return 0;
};
