// EXPECT-ERROR: 'Widget' is defined in module 'resolve_bare_index_diagnostic_test/mod_a'. Import it explicitly with using "resolve_bare_index_diagnostic_test/mod_a" { Widget };
//
// Design guard: the diagnostic lookup ("Import it explicitly" -- it reads the
// unqualified name index to name the declaring module) and a local/empty-path
// definition of the same spelling must coexist without clobbering each other.
//
// The lazy `using ... { };` loads mod_a and binds NOTHING, so `Widget` is
// declared somewhere but imported nowhere: the use below must be refused with
// the "Import it explicitly" diagnostic naming mod_a. `f` binds a generic
// parameter NAMED `Widget` -- a local/empty-path definition sharing the
// spelling with mod_a's name-index entry -- and must still type-check on its
// own (the binder wins inside the signature).
using "std" { ... };
using "resolve_bare_index_diagnostic_test/mod_a" { };

let f[Widget Any](w Widget) Widget = {
    return w;
};

let g(x Widget) Int = 1;

let main() Int = {
    return 0;
};
