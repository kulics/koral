// EXPECT: a=3
// EXPECT: c=7
// EXPECT: e=hello
// Forward references from a global initializer are legal, annotated or not:
// the referenced global initializes on first access, whenever it is declared.
using "std" { ... };

let a: Int = b;
let b: Int = 3;
let c = d;
let d = 7;
let e = f;
let f = "hello";

let main(): Void = {
    println("a=\(a)");
    println("c=\(c)");
    println("e=\(e)");
};
