// EXPECT: 9007199254740993
// EXPECT: 18446744073709551615
// EXPECT: -9007199254740993
// EXPECT: 42
// EXPECT: 1.5
// EXPECT: json bigint tests passed
// Integer tokens parse exactly: a Float64 rounds everything past 2^53, and
// JSON integers carry IDs that must survive a round trip. Past `UInt` (and
// at the single value -2^63) the token falls back to `Float64`.

using "std/json" { ... };

let main(): Int = {
    let cases: List[String] = [
        "9007199254740993",
        "18446744073709551615",
        "-9007199254740993",
        "42",
        "1.5",
    ];
    for text in cases then {
        when JsonValue.parse(text) in {
            .Ok(v) then println(v.to_string()),
            .Error(e) then println("FAIL parse \(text): \(e.message())"),
        };
    };
    println("json bigint tests passed");
    return 0;
};
