// EXPECT-ERROR: Conflicting conformance: 'given Point T' already declared
// Locality passes -- trait and type are both local -- so the duplicate
// conformance is reported. The pin intentionally omits the trailing line
// number.

trait T {
    poke(self) Int;
};

type Point(x Int);

given Point as T {
    poke(self) Int = self.x;
};

given Point as T {
    poke(self) Int = self.x;
};

let main() Int = 0;
