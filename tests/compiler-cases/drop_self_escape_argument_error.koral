// EXPECT-ERROR: 'self' cannot escape a drop body

// `drop(self)` runs while the object is being destroyed. Passing `self` on --
// as an argument here -- would let a dying object outlive its own destructor.

type File(fd Int);

let stash(f File) Void = {};

given File as Drop {
    drop(self) Void = {
        stash(self);
    };
};

let main() Int = {
    return 0;
};
