// EXPECT: 3
// EXPECT: 8
// EXPECT: 2
// EXPECT: newline semicolon continuation ok

let main() Int = {
    // Dot-chaining continuation: next line starts with '.'
    let n = "abc"
        .count()
    println(n)

    // Keyword join continuation: `and then` / `or else` stay attached across newlines.
    let chained = Option[Int].Some(4)
        and then it * 2
        or else 0
    println(chained)

    // `then` / `else` remain valid line-leading join points.
    let branch = if false
        then 1
        else 2
    println(branch)

    println("newline semicolon continuation ok")
    return 0
}
