// Tests that T * does NOT satisfy Eq when T does not implement Eq
// Feature: type-modifier-trait-conformance
// EXPECT-ERROR: does not satisfy trait

type NoEq(x Int)

let are_equal[T Eq](a T, b T) Bool = a == b

let main() Void = {
    let mut a = NoEq(1)
    let mut b = NoEq(1)
    let ra = &a
    let rb = &b
    println(are_equal(ra, rb))
}
