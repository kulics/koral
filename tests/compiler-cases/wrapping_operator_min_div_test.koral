// EXPECT: PASS
// Wrapping governs overflow only. `MIN / -1` is the one quotient that
// mathematically overflows, and on the Wrapping family it wraps to `MIN`
// (`MIN % -1` to `0`) instead of the C undefined result -- on every signed
// width that has a MIN.

let main(): Int = {
    let min_i = WrappingInt(Int.min_value());
    if not ((min_i / -1) == min_i) then {
        eprintln("FAIL: WrappingInt MIN / -1 != MIN");
        return 1;
    };
    if not ((min_i % -1) == 0) then {
        eprintln("FAIL: WrappingInt MIN % -1 != 0");
        return 1;
    };

    let min8 = WrappingInt8(Int8.min_value());
    if not ((min8 / -1) == min8) then {
        eprintln("FAIL: WrappingInt8 MIN / -1 != MIN");
        return 1;
    };
    if not ((min8 % -1) == 0) then {
        eprintln("FAIL: WrappingInt8 MIN % -1 != 0");
        return 1;
    };

    let min16 = WrappingInt16(Int16.min_value());
    if not ((min16 / -1) == min16) then {
        eprintln("FAIL: WrappingInt16 MIN / -1 != MIN");
        return 1;
    };
    if not ((min16 % -1) == 0) then {
        eprintln("FAIL: WrappingInt16 MIN % -1 != 0");
        return 1;
    };

    let min32 = WrappingInt32(Int32.min_value());
    if not ((min32 / -1) == min32) then {
        eprintln("FAIL: WrappingInt32 MIN / -1 != MIN");
        return 1;
    };
    if not ((min32 % -1) == 0) then {
        eprintln("FAIL: WrappingInt32 MIN % -1 != 0");
        return 1;
    };

    let min64 = WrappingInt64(Int64.min_value());
    if not ((min64 / -1) == min64) then {
        eprintln("FAIL: WrappingInt64 MIN / -1 != MIN");
        return 1;
    };
    if not ((min64 % -1) == 0) then {
        eprintln("FAIL: WrappingInt64 MIN % -1 != 0");
        return 1;
    };

    println("PASS");
    return 0;
};
