// Regression test: assigning a global function to a Func-typed variable
// must produce a valid closure, not crash the backend.

let add(x Int, y Int) Int = x + y

let main() Int = {
    let f Func(Int, Int) Int = add
    let result = f(10, 20)
    println(result)
    if result <> 30 then {
        eprintln("FAIL: expected 30, got \(result)")
        return 1
    }
    println("PASS")
    return 0
}
// EXPECT: 30
// EXPECT: PASS