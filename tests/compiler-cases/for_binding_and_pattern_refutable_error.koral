// EXPECT-ERROR: For binding cannot fail; use 'when' to match
// Design guard: `and` covers the INTERSECTION of its sides. `.A(x) and y`
// only matches the A case, so on a two-case enum it is refutable -- the
// coverage judgement must not read the `and` as the union of both sides.

using "std";

type E {
    A(x Int),
    B(x Int),
};

let main() Int = {
    let xs = List[E].new();
    xs.push(E.A(1));
    for .A(x) and y in xs then {
        println(x);
    };
    return 0;
};
