// EXPECT: 3
// EXPECT: b
// The one-conformance-per-(self type, trait) rule is per TYPE: different self
// types may apply the same trait to different type arguments.

type A(x: Int);
type B(y: Int);

given A: Add[Int] {
    add(self, other: Int): A = A(self.x + other);
};

given B: Add[String] {
    add(self, other: String): B = B(self.y);
};

let main(): Int = {
    let a = A(1) + 2;
    println(a.x);
    let b = B(9) + "x";
    println("b");
    return 0;
};
