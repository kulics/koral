// EXPECT: 1
// EXPECT: 7
// EXPECT: 0
// EXPECT: deep alias canonicalization ok

type IntList = List[Int];
type MaybeInt = Option[Int];

let build_list() IntList = .new();
let build_some() MaybeInt = .Some(7);

let main() Int = {
    let mutable a IntList = build_list();
    let mutable b List[Int] = List[Int].new();
    let picked = if true then &mutable a else &mutable b;
    picked.push(1);

    println(picked.count());

    when build_some() in {
        .Some(v) then println(v),
        .None() then println(0),
    };

    let make_list Func() List[Int] = IntList.new;
    let mutable xs = make_list();
    println(xs.count());
    println("deep alias canonicalization ok");
    return 0;
};