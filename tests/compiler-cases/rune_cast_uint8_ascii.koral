// EXPECT: 97
// EXPECT: rune cast tests passed
// `UInt8('a')` is the one rune-to-integer inference the language has: a
// single ASCII character in an explicit `UInt8` context becomes its byte.

let main(): Int = {
    let b = UInt8('a');
    println(b);
    println("rune cast tests passed");
    return 0;
};
