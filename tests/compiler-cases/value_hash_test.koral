// EXPECT: hash_ok
// Rune/Duration/网络地址/时间类型补 Hash：等值必等哈希，可当 Dict/Set 键。

using "std/net" { Ipv4Addr, IpAddr, SocketAddr };
using "std/time" { ClockTime, Date, TimeZone };

let main(): Int = {
    // Rune
    assert('中'.hash() == '中'.hash(), "rune hash stable");
    let rd = Dict[Rune, Int].new();
    rd.insert('中', 1);
    assert(rd.get('中') == Option[Int].Some(1), "rune key");

    // Duration
    let d1 = Duration.new(seconds = 3, nanoseconds = 5).unwrap();
    let d2 = Duration.new(seconds = 3, nanoseconds = 5).unwrap();
    assert(d1.hash() == d2.hash(), "duration hash stable");
    let dd = Dict[Duration, Int].new();
    dd.insert(d1, 7);
    assert(dd.get(d2) == Option[Int].Some(7), "duration key");

    // 网络地址
    let ip = Ipv4Addr.new(127, 0, 0, 1);
    let ip2 = Ipv4Addr.new(127, 0, 0, 1);
    assert(ip.hash() == ip2.hash(), "ipv4 hash stable");
    let sa = SocketAddr.new(IpAddr.V4(ip), 8080);
    let sa2 = SocketAddr.new(IpAddr.V4(ip2), 8080);
    assert(sa.hash() == sa2.hash(), "socket addr hash stable");
    let sd = Dict[SocketAddr, Int].new();
    sd.insert(sa, 8);
    assert(sd.get(sa2) == Option[Int].Some(8), "socket addr key");

    // 时间类型
    let ct = ClockTime.new(hour = 1, minute = 2, second = 3).unwrap();
    let ct2 = ClockTime.new(hour = 1, minute = 2, second = 3).unwrap();
    assert(ct.hash() == ct2.hash(), "clock time hash stable");
    let dt = Date.new(year = 2026, month = 11, day = 25).unwrap();
    let dt2 = Date.new(year = 2026, month = 11, day = 25).unwrap();
    assert(dt.hash() == dt2.hash(), "date hash stable");
    let tz = TimeZone.utc();
    assert(tz.hash() == TimeZone.utc().hash(), "timezone hash stable");

    let td = Dict[Date, Int].new();
    td.insert(dt, 9);
    assert(td.get(dt2) == Option[Int].Some(9), "date key");

    println("hash_ok");
    return 0;
};
