// With place semantics the element slot is addressable: `&xs[0]` borrows the
// slot itself (like `&xs.f`), not the address of a temporary copy.
// EXPECT: borrowed:
// EXPECT: 41
// EXPECT: written:
// EXPECT: 7

using "std" { ... };

let main(): Void = {
    let mutable xs = List[Int].new();
    xs.push(41);
    let r = &xs[0];
    println("borrowed:");
    println(*r);
    let rp = &mutable xs[0];
    *rp = 7;
    println("written:");
    println(xs[0]);
};
