// Test trait object ?* support (downgrade and upgrade)
// EXPECT: hello
// EXPECT: upgrade succeeded

trait Greet {
    greet(*self) String
}

type Greeter(name String)

given Greeter as Greet {

    public greet(*self) String = self.name
}

let main() Int = {
    let g1 = box(Greeter("hello"))
    let g * Greet = g1
    println(g.greet())

    // Downgrade to ?*
    let w ?* Greet = downgrade(g)

    // Upgrade back to strong *
    let upgraded = upgrade(w)
    when upgraded in {
        .Some(s) then println("upgrade succeeded"),
        .None then println("upgrade failed"),
    }

    return 0
}
