// EXPECT-ERROR: Type mismatch: expected MySrc, got Other
// 泛型方法类型形参的冲突绑定钉（tool_block_self_generic_arg_infer_ok 的
// 反面）：两个实参把同一个 R 绑到不同类型必须报错——推断不是"任选一个"。

trait Src {
    generate(self): UInt64;
};

trait Draw3 {
    draw3[R: Src](self, a: R, b: R): Int;
};

type Token();

given Token: Draw3 {
    draw3[R: Src](self, a: R, b: R): Int = {
        let _ = self;
        let _ = a;
        let _ = b;
        return 0;
    };
};

type MySrc();

given MySrc: Src {
    generate(self): UInt64 = 7;
};

type Other();

given Other: Src {
    generate(self): UInt64 = 1;
};

let main(): Void = {
    let t = Token();
    let n = t.draw3(MySrc(), Other());
    let _ = n;
};
