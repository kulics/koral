// EXPECT: guard bindings ok

// Destructured field bindings are visible inside the guard.

type Duo(left Int, right Int);

let pick(p Duo) Int = when p in {
    Duo(l, r) where l > r then l,
    Duo(l, r) then r,
};

let main() Int = {
    if pick(Duo(7, 2)) != 7 then {
        eprintln("FAIL: guard should see l and r");
        return 1;
    };
    if pick(Duo(2, 7)) != 7 then {
        eprintln("FAIL: guard false should fall through");
        return 1;
    };
    println("guard bindings ok");
    return 0;
};
