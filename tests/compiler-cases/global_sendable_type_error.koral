// EXPECT-ERROR: Global variable 'g' must have a sendable type
// A module-level binding must have a sendable type: `List` is thread-confined
// mutable working state, so a `List` global is refused (a global of `String`
// or of a `Frozen*` snapshot passes -- concurrency-design.md §跨界检查 (c)).

let g: List[Int] = [1, 2, 3];

let main(): Void = {
    let _ = g.count();
};
