// EXPECT: default_null: 0
// EXPECT: explicit_live: 1
// EXPECT: field_default: 0
// EXPECT: field_live: 1

// Pointer-typed defaults spell the empty pointer `null` -- both a named
// parameter default and a named field default.

let f(p: *Int = null): Int = if p is null then 0 else 1;

type Node(p: *Int = null);

let main(): Int = {
    // Parameter default fills with null.
    println("default_null: \(f())");

    let q = alloc_memory[Int](1);
    init_memory(q, 5);
    println("explicit_live: \(f(p = q))");

    // Field default fills with null.
    let n1 = Node();
    let field_default = if n1.p is null then 0 else 1;
    println("field_default: \(field_default)");

    let n2 = Node(p = q);
    let field_live = if n2.p is null then 0 else 1;
    println("field_live: \(field_live)");

    dealloc_memory(q);
    return 0;
};
