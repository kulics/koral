// EXPECT: foreign function pointer ok
// `foreign (T) -> R` is a bare C function pointer: `let foreign` functions and
// same-typed values inhabit it, `null` joins like `*T`, calls go straight to
// C. A lambda is NOT one of them.

let foreign abs(x: Int32): Int32;

let main(): Int = {
    let f: foreign (Int32) -> Int32 = abs;
    let g = abs;
    let mutable cb: foreign (Int32) -> Int32 = null;
    if cb == null then {
        println("null joins the pointer family");
    };
    if cb != null then {
        println("unreachable");
    };
    assert(f(Int32(-3)) == Int32(3), "call through the typed pointer");
    assert(g(Int32(-7)) == Int32(7), "call through the inferred pointer");
    cb = f;
    assert(cb(Int32(-9)) == Int32(9), "call through a rebound pointer");
    println("foreign function pointer ok");
    return 0;
};
