// EXPECT-ERROR: Panic: env_all: environment entry is not valid UTF-8
// 文本严格族钉：env_all 遇非 UTF-8 条目直接 panic（`std::env::vars` 同款：
// 名单叫 all 就要给全，不静默丢条目）；保真走 env_all_raw。

using "std/os" { ... };

let unsafe foreign __koral_setenv(name: *UInt8, value: *UInt8): Int32;

let main(): Void = unsafe {
    let name_cs = CString.from_string("KORAL_RAW_PANIC").unwrap();
    let val_ptr = alloc_memory[UInt8](2);
    init_memory(val_ptr, UInt8(255));
    init_memory(val_ptr + 1, UInt8(0));
    let rc = __koral_setenv(name_cs.borrow_ptr(), val_ptr as *UInt8);
    assert(rc == 0, "raw setenv");
    let _ = env_all();
};
