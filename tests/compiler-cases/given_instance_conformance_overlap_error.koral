// EXPECT-ERROR: Duplicate definition: doubled
// The no-overlap rule covers requirement witnesses too: a generic conformance's
// method already serves every instantiation, so an instantiation-target `given`
// may not redeclare the name -- inherent or witness, it is the same duplicate.

type Box[T: Any](value: T);

public trait Doubler {
    doubled(self): Int;
};

given[T: Any] Box[T]: Doubler {
    public doubled(self): Int = self.value * 2;
};

given Box[Int] {
    public doubled(self): Int = 3;
};

let main(): Int = {
    return 0;
};
