using "trait_same_name_cross_module_same_type_test/alpha" { make as make_alpha };
using "trait_same_name_cross_module_same_type_test/beta" { make as make_beta };

// EXPECT: 7
// EXPECT: 40
// Both the TRAIT and the concrete TYPE are spelled the same in two modules:
// `alpha.Tag` / `alpha.Box` and `beta.Tag` / `beta.Box`. A vtable is identified
// by (concrete type, trait DECLARATION, trait arguments) -- never by spelling --
// so these are four distinct identities and the two trait objects must each
// call their own `value`. A spelling-based key collapses them: the dedup table
// keeps one request, the inventory reports a false "duplicate vtable key", and
// the C symbol `__koral_vtable_Tag_for_Box` is emitted twice.

let main() Int = {
    println(make_alpha().value().to_string());
    println(make_beta().value().to_string());
    return 0;
};
