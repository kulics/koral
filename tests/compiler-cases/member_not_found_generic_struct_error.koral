// Same hole on a monomorphized generic instance: the receiver is a
// `StructureType` for a template, so the lookup goes through the same
// branch and must report the same way.
//
// Both compilers report this now. Swift used to fall through to
// `.invalidOperation(op: "member access", type1: ..., type2: "")` for every
// receiver that was not a non-generic struct, rendering
// `Invalid operation member access between types Box[Int] and ` -- the
// message stops mid-clause because `type2` is spelled empty. It was aligned
// to the well-formed `.undefinedMember` text (the one it already used for
// non-generic structs) rather than the other way round.

// EXPECT-ERROR: Member 'nope' not found in type 'Box[Int]'

type Box[T Any](v T);

let main() Void = {
    let b = Box[Int](1);
    let v = b.nope;
    println(v.to_string());
};
