using "./traits.koral" { Show };

public type Point(x: Int, y: Int);

given Point {
    public new(x: Int, y: Int): Point = Point(x, y);
};

// A conformance member implements the trait's requirement, and a requirement
// has no access slot of its own: its level IS the trait's. Writing `private`
// here would be a narrower level than the requirement's `public`, and the
// declaration is refused -- nothing may be registered that direct calls
// reject but trait-object dispatch reaches.

given Point: Show {
    private show(self): String = "(" + self.x.to_string() + ", " + self.y.to_string() + ")";
};
