// EXPECT-ERROR: Panic: List modified during iteration or borrow: push
// 修改锁（slice-design §修改锁）：`borrow_slice` 闭包全程持锁，任何经 list 的
// 修改入口立刻 panic（预防式，锚点=肇事修改调用点）。
let main(): Void = {
    let xs = List[UInt8].new();
    xs.push(1);
    xs.borrow_slice((s) => {
        let _ = s.count();
        xs.push(2);
    });
};
