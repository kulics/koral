// EXPECT: PASS

type Point(mutable x Int, mutable y Int)

let main() Int = {
    let mutable p = Point(1, 2)

    let rp unsafe * mutable Point = unsafe & mutable p
    // Two-level pointer wrapper: unsafe * (unsafe * mutable Point)
    let pp = unsafe & rp
    let inner = unsafe *pp

    if inner.x <> 1 then {
        eprintln("FAIL: expected x=1, got \(inner.x)")
        return 1
    }

    inner.y = 9
    if p.y <> 9 then {
        eprintln("FAIL: expected y=9, got \(p.y)")
        return 1
    }

    println("PASS")
    return 0
}
