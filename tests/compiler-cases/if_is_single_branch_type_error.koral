// Test that single-branch if...is expressions still require a Void/Never then-branch.
// EXPECT-ERROR: Single-branch 'if' must have Void or Never type in then branch

type MyOption {
    Some(value Int),
    None(),
};

let main() Int = {
    let opt = MyOption.Some(10);
    let value = if opt is .Some(v) then { v };
    let _ = value;
    return 0;
};
