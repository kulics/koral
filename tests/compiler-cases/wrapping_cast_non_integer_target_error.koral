// EXPECT-ERROR: Type 'String' does not support cast: only numeric and pointer types can be cast
// `wrapping_cast` is an integer bit-move: the target type argument is the
// conversion TARGET, and only integers have a two's-complement representation
// to move. A non-integer target is the same mistake `String(x)` makes, and
// gets the same complaint.

let main() Int = {
    let n Int = -5;
    let _ = n.wrapping_cast[String]();
    return 0;
};
