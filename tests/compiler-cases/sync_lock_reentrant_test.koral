// EXPECT: w=5
// EXPECT: h=10

// Reentrancy smoke (concurrency-design.md §对象锁语义 2): a method on a locked
// type assigns two fields from computed RHS expressions touching `self`. The
// statement critical section re-enters the same object's lock for the inner
// field reads — the lock is reentrant, so single-threaded execution must not
// self-deadlock.

type sendable mutable Rect(mutable w: Int, mutable h: Int);

given Rect {
    grow(self): Void = {
        self.w = self.w + self.h;
        self.h = self.w * 2;
    };
};

let main(): Void = {
    let r = Rect(2, 3);
    r.grow();
    println("w=\(r.w)");
    println("h=\(r.h)");
};
