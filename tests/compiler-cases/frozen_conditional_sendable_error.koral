// EXPECT-ERROR: sendable closure cannot capture non-sendable value 'nested'
// The conditional rule gates the frozen family too: `FrozenList[List[Int]]`
// cannot cross threads because its element type is not sendable
// (concurrency-design.md §派生规则 3).

using "std/async" { ... };

let main(): Void = {
    let nested = List[List[Int]].new().to_frozen_list();
    let t = run_task(() => {
        let _ = nested.count();
    });
    let _ = t.wait();
};
