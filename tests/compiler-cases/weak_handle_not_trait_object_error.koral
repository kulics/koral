// EXPECT-ERROR: Type '?Person' does not satisfy trait 'Greeter'. No blanket given exists for 'weakref' and 'Greeter'
// Design guard: a weak handle is a HANDLE, not its referent -- opaque until
// upgraded, with no conformance of its own. `?Person` must not become
// `Greeter` on the strength of `given Person as Greeter`; the referent `(?w)`
// yields can.
using "std" { ... };

trait Greeter {
    greet(self) String;
};

type mutable Person(mutable name String);

given Person as Greeter {
    greet(self) String = self.name;
};

let main() Int = {
    let p = Person("ada");
    let w ?Person = ?Person(p);
    let g Greeter = w;
    println(g.greet());
    return 0;
};
