// EXPECT: float32 literal ok

// A Float32 literal must compare at `float` width. Emitting it as an
// unsuffixed C double promotes the subject and compares `(double)1.1f`
// against `1.1`, which is false.

let main(): Int = {
    let y: Float32 = 1.1;
    if y != 1.1 then {
        eprintln("FAIL: Float32 literal must match its own value");
        return 1;
    };
    if 1.1 != y then {
        eprintln("FAIL: Float32 literal compare must be symmetric");
        return 1;
    };
    let x: Float64 = 1.5;
    if x != 1.5 then {
        eprintln("FAIL: Float64 literal must still match");
        return 1;
    };
    println("float32 literal ok");
    return 0;
};
