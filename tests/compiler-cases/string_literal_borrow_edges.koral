// EXPECT: empty_literal_len_ok
// EXPECT: empty_literal_alias_immutable_ok
// EXPECT: empty_literal_builder_ok
// EXPECT: many_pattern_literals_ok

let test_empty_literal_capacity_and_shared_alias() Void = {
    let empty = "";
    assert(empty.count() == 0, "empty literal count");
    println("empty_literal_len_ok");

    let copy = empty;
    assert(empty == "", "empty literal is immutable");
    assert(copy == "", "copied empty literal keeps value");
    println("empty_literal_alias_immutable_ok");

    let mutable sb = StringBuilder.new();
    sb.push_string(empty);
    sb.push_byte('?');
    let built = sb.to_string();
    assert(empty == "", "builder append does not mutate alias source");
    assert(built == "?", "builder constructs appended string");
    println("empty_literal_builder_ok");
};

let test_many_pattern_literals() Void = {
    let key = "k9";
    let value = when key in {
        "k0" then 0,
        "k1" then 1,
        "k2" then 2,
        "k3" then 3,
        "k4" then 4,
        "k5" then 5,
        "k6" then 6,
        "k7" then 7,
        "k8" then 8,
        "k9" then 9,
        _ then 100,
    };
    assert(value == 9, "many string literal branches should match correctly");
    println("many_pattern_literals_ok");
};

let main() Void = {
    test_empty_literal_capacity_and_shared_alias();
    test_many_pattern_literals();
};
