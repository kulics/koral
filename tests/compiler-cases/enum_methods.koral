// EXPECT: Status.describe called
// EXPECT: --- Scope 1 ---
// EXPECT: --- Scope 1 End ---
// EXPECT: Box.is_empty called
// EXPECT: --- Scope 2 ---
// EXPECT: --- Scope 2 End ---
//
// Enum methods on a value enum. User `drop` bodies are restricted to
// `type mutable` (a value's cleanup is its synthesized field release), so
// this type carries no Drop -- the destructor-observability semantics live
// with the `type mutable` struct tests (drop_observability_test and kin).

type Status {
    Active(),
    Inactive(value: Int),
};

given Status {

    describe(self): Int = {
        println("Status.describe called");
        return 0;
    };
};

type Box[T: Any] {
    Full(value: T),
    Empty(),
};

given[T: Any] Box[T] {
    is_empty(self): Bool = {
        println("Box.is_empty called");
        return true;
    };
};

let main(): Int = {
    let s = Status.Active();
    s.describe();

    println("--- Scope 1 ---");
    {
        // A value enum has no destructor to run here.
        let s2 = Status.Inactive(10);
        let _ = s2;
    };
    println("--- Scope 1 End ---");

    let b = Box[Int].Full(42);
    b.is_empty();

    println("--- Scope 2 ---");
    {
        let b2 = Box[Int].Empty();
        let _ = b2;
    };
    println("--- Scope 2 End ---");
    return 0;
};
