// EXPECT-ERROR: Panic: Fixed array index out of bounds: length 3
// A numeric subscript on a fixed array is bounds-checked: the index is
// evaluated once, the walk happens only for an index `< N`, and an
// out-of-range one panics instead of reading neighbouring memory. Raw
// pointer subscripts (`*T`) stay unchecked on purpose -- they are the unsafe
// escape hatch.

let main(): Int = {
    let a: [3]Int = [10, 20, 30];
    let i = 5;
    println(a[i]);
    return 0;
};
