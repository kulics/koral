// EXPECT-ERROR: Type mismatch: expected ref mut T, got T

trait ManagedBump {
    bump_and_keep(self ref mut Self) ref mut Self
}

type Counter(mut value Int)

given Counter as ManagedBump {
    public bump_and_keep(self ref mut Self) ref mut Self = self
}

let bad_generic[T ManagedBump](value T) ref mut T = value.bump_and_keep()

let main() Int = {
    let _ = bad_generic(Counter(0))
    return 0
}