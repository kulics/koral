// EXPECT: PASS
// The trait face (Eq Ord Hash Clone Default ToString) on all ten Wrapping
// types behaves like the plain counterpart of the same width: a value sorts
// and hashes like its plain twin after a same-width retype.

let main(): Int = {
    // --- WrappingInt ---
    let a: WrappingInt = WrappingInt(-5);
    let plain_a: Int = Int(a);
    if not a.equals(WrappingInt(-5)) then {
        eprintln("FAIL: WrappingInt.equals");
        return 1;
    };
    if a.compare(WrappingInt(3)) != plain_a.compare(3) then {
        eprintln("FAIL: WrappingInt.compare");
        return 1;
    };
    if a.hash() != plain_a.hash() then {
        eprintln(
            "FAIL: WrappingInt(-5) hash \(a.hash()) != Int(-5) hash \(plain_a.hash())",
        );
        return 1;
    };
    if not (WrappingInt.default() == 0) then {
        eprintln("FAIL: WrappingInt.default");
        return 1;
    };
    if not (a.clone().equals(a)) then {
        eprintln("FAIL: WrappingInt.clone");
        return 1;
    };
    if a.to_string() != "-5" then {
        eprintln("FAIL: WrappingInt(-5) prints \(a.to_string())");
        return 1;
    };

    // --- WrappingInt8 ---
    let b: WrappingInt8 = WrappingInt8(-5);
    if not b.equals(WrappingInt8(-5)) then {
        eprintln("FAIL: WrappingInt8.equals");
        return 1;
    };
    if b.compare(WrappingInt8(3)) != -1 then {
        eprintln("FAIL: WrappingInt8.compare");
        return 1;
    };
    if b.hash() != Int8(-5).hash() then {
        eprintln("FAIL: WrappingInt8(-5) hash disagrees with Int8(-5)");
        return 1;
    };
    if not (WrappingInt8.default() == 0) then {
        eprintln("FAIL: WrappingInt8.default");
        return 1;
    };
    if not (b.clone().equals(b)) then {
        eprintln("FAIL: WrappingInt8.clone");
        return 1;
    };
    if b.to_string() != "-5" then {
        eprintln("FAIL: WrappingInt8(-5) prints \(b.to_string())");
        return 1;
    };

    // --- WrappingInt16 ---
    let c: WrappingInt16 = WrappingInt16(-5);
    if not c.equals(WrappingInt16(-5)) then {
        eprintln("FAIL: WrappingInt16.equals");
        return 1;
    };
    if c.compare(WrappingInt16(3)) != -1 then {
        eprintln("FAIL: WrappingInt16.compare");
        return 1;
    };
    if c.hash() != Int16(-5).hash() then {
        eprintln("FAIL: WrappingInt16(-5) hash disagrees with Int16(-5)");
        return 1;
    };
    if not (WrappingInt16.default() == 0) then {
        eprintln("FAIL: WrappingInt16.default");
        return 1;
    };
    if not (c.clone().equals(c)) then {
        eprintln("FAIL: WrappingInt16.clone");
        return 1;
    };
    if c.to_string() != "-5" then {
        eprintln("FAIL: WrappingInt16(-5) prints \(c.to_string())");
        return 1;
    };

    // --- WrappingInt32 ---
    let d: WrappingInt32 = WrappingInt32(-5);
    if not d.equals(WrappingInt32(-5)) then {
        eprintln("FAIL: WrappingInt32.equals");
        return 1;
    };
    if d.compare(WrappingInt32(3)) != -1 then {
        eprintln("FAIL: WrappingInt32.compare");
        return 1;
    };
    if d.hash() != Int32(-5).hash() then {
        eprintln("FAIL: WrappingInt32(-5) hash disagrees with Int32(-5)");
        return 1;
    };
    if not (WrappingInt32.default() == 0) then {
        eprintln("FAIL: WrappingInt32.default");
        return 1;
    };
    if not (d.clone().equals(d)) then {
        eprintln("FAIL: WrappingInt32.clone");
        return 1;
    };
    if d.to_string() != "-5" then {
        eprintln("FAIL: WrappingInt32(-5) prints \(d.to_string())");
        return 1;
    };

    // --- WrappingInt64 ---
    let e: WrappingInt64 = WrappingInt64(-5);
    if not e.equals(WrappingInt64(-5)) then {
        eprintln("FAIL: WrappingInt64.equals");
        return 1;
    };
    if e.compare(WrappingInt64(3)) != -1 then {
        eprintln("FAIL: WrappingInt64.compare");
        return 1;
    };
    if e.hash() != Int64(-5).hash() then {
        eprintln("FAIL: WrappingInt64(-5) hash disagrees with Int64(-5)");
        return 1;
    };
    if not (WrappingInt64.default() == 0) then {
        eprintln("FAIL: WrappingInt64.default");
        return 1;
    };
    if not (e.clone().equals(e)) then {
        eprintln("FAIL: WrappingInt64.clone");
        return 1;
    };
    if e.to_string() != "-5" then {
        eprintln("FAIL: WrappingInt64(-5) prints \(e.to_string())");
        return 1;
    };

    // --- WrappingUInt ---
    let f: WrappingUInt = WrappingUInt(5);
    if not f.equals(WrappingUInt(5)) then {
        eprintln("FAIL: WrappingUInt.equals");
        return 1;
    };
    if f.compare(WrappingUInt(3)) != UInt(5).compare(3) then {
        eprintln("FAIL: WrappingUInt.compare");
        return 1;
    };
    if f.hash() != UInt(5).hash() then {
        eprintln("FAIL: WrappingUInt(5) hash disagrees with UInt(5)");
        return 1;
    };
    if not (WrappingUInt.default() == 0) then {
        eprintln("FAIL: WrappingUInt.default");
        return 1;
    };
    if not (f.clone().equals(f)) then {
        eprintln("FAIL: WrappingUInt.clone");
        return 1;
    };
    if f.to_string() != "5" then {
        eprintln("FAIL: WrappingUInt(5) prints \(f.to_string())");
        return 1;
    };

    // --- WrappingUInt8 ---
    let g: WrappingUInt8 = WrappingUInt8(255);
    if not g.equals(WrappingUInt8(255)) then {
        eprintln("FAIL: WrappingUInt8.equals");
        return 1;
    };
    if g.compare(WrappingUInt8(3)) != 1 then {
        eprintln("FAIL: WrappingUInt8.compare");
        return 1;
    };
    if g.hash() != UInt8(255).hash() then {
        eprintln("FAIL: WrappingUInt8(255) hash disagrees with UInt8(255)");
        return 1;
    };
    if not (WrappingUInt8.default() == 0) then {
        eprintln("FAIL: WrappingUInt8.default");
        return 1;
    };
    if not (g.clone().equals(g)) then {
        eprintln("FAIL: WrappingUInt8.clone");
        return 1;
    };
    if g.to_string() != "255" then {
        eprintln("FAIL: WrappingUInt8(255) prints \(g.to_string())");
        return 1;
    };

    // --- WrappingUInt16 ---
    let h: WrappingUInt16 = WrappingUInt16(65535);
    if not h.equals(WrappingUInt16(65535)) then {
        eprintln("FAIL: WrappingUInt16.equals");
        return 1;
    };
    if h.compare(WrappingUInt16(3)) != 1 then {
        eprintln("FAIL: WrappingUInt16.compare");
        return 1;
    };
    if h.hash() != UInt16(65535).hash() then {
        eprintln("FAIL: WrappingUInt16(65535) hash disagrees with UInt16(65535)");
        return 1;
    };
    if not (WrappingUInt16.default() == 0) then {
        eprintln("FAIL: WrappingUInt16.default");
        return 1;
    };
    if not (h.clone().equals(h)) then {
        eprintln("FAIL: WrappingUInt16.clone");
        return 1;
    };
    if h.to_string() != "65535" then {
        eprintln("FAIL: WrappingUInt16(65535) prints \(h.to_string())");
        return 1;
    };

    // --- WrappingUInt32 ---
    let i: WrappingUInt32 = WrappingUInt32(4294967295);
    if not i.equals(WrappingUInt32(4294967295)) then {
        eprintln("FAIL: WrappingUInt32.equals");
        return 1;
    };
    if i.compare(WrappingUInt32(3)) != 1 then {
        eprintln("FAIL: WrappingUInt32.compare");
        return 1;
    };
    if i.hash() != UInt32(4294967295).hash() then {
        eprintln(
            "FAIL: WrappingUInt32(4294967295) hash disagrees with UInt32(4294967295)",
        );
        return 1;
    };
    if not (WrappingUInt32.default() == 0) then {
        eprintln("FAIL: WrappingUInt32.default");
        return 1;
    };
    if not (i.clone().equals(i)) then {
        eprintln("FAIL: WrappingUInt32.clone");
        return 1;
    };
    if i.to_string() != "4294967295" then {
        eprintln("FAIL: WrappingUInt32(4294967295) prints \(i.to_string())");
        return 1;
    };

    // --- WrappingUInt64 ---
    let j: WrappingUInt64 = WrappingUInt64(18446744073709551615);
    if not j.equals(WrappingUInt64(18446744073709551615)) then {
        eprintln("FAIL: WrappingUInt64.equals");
        return 1;
    };
    if j.compare(WrappingUInt64(3)) != 1 then {
        eprintln("FAIL: WrappingUInt64.compare");
        return 1;
    };
    if j.hash() != UInt64(18446744073709551615).hash() then {
        eprintln(
            "FAIL: WrappingUInt64(18446744073709551615) hash disagrees with UInt64",
        );
        return 1;
    };
    if not (WrappingUInt64.default() == 0) then {
        eprintln("FAIL: WrappingUInt64.default");
        return 1;
    };
    if not (j.clone().equals(j)) then {
        eprintln("FAIL: WrappingUInt64.clone");
        return 1;
    };
    if j.to_string() != "18446744073709551615" then {
        eprintln("FAIL: WrappingUInt64 prints \(j.to_string())");
        return 1;
    };

    println("PASS");
    return 0;
};
