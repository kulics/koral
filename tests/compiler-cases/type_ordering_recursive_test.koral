// Regression test for nominal declaration ordering with recursive enums + containers.
// Exercises the same dependency shapes that previously produced incomplete-type
// errors in bootstrap-generated C: enum -> Dict[String, List[Enum]] cycles,
// struct -> enum by value, and container element types stored as pointers.

type JsonValue {
    Null(),
    Bool(value Bool),
    String(value String),
    Array(elements List[JsonValue]),
    Object(entries Dict[String, JsonValue]),
};

type TokenKind {
    Ident(name String),
    Number(value String),
    Nested(parts List[TokenPart]),
};

type Token(kind TokenKind, line UInt);

type TokenPart {
    Text(value String),
    ExprTokens(tokens List[Token]),
};

type mutable Builder(mutable cache Dict[String, List[JsonValue]]);

let main() Int = {
    let v = JsonValue.Object(Dict[String, JsonValue].new());
    let arr = JsonValue.Array(List[JsonValue].new());
    let t = Token(TokenKind.Nested(List[TokenPart].new()), 1);
    let b = Builder(Dict[String, List[JsonValue]].new());
    b.cache.insert("k", List[JsonValue].new());
    println("ok");
    return 0;
};
