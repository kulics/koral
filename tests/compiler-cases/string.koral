// EXPECT: String tests passed

let test_literal_basics() Void = {
    let s = "hi";
    let h UInt8 = 104;
    let i UInt8 = 105;
    assert(s.count() == 2, "literal count");
    assert(not s.is_empty(), "literal not empty");
    assert(s[0] == h, "literal byte h");
    assert(s[1] == i, "literal byte i");
    // Test safe get method
    when s.get(0) in {
        .Some(b) then assert(b == h, "get byte h"),
        .None() then panic("get should return Some"),
    };
    when s.get(100) in {
        .Some(_) then panic("get out of bounds should return None"),
        .None() then {},
    };
};

let test_push() Void = {
    let mutable s = StringBuilder.new();
    s.push_string("a");
    let b UInt8 = 98;// 'b'
    s.push_byte(b);
    assert(s.to_string() == "ab", "push byte");
};

let test_push_string() Void = {
    let mutable s = StringBuilder.new();
    s.push_string("ab");
    let t = "XYZ";
    let z UInt8 = 90;// 'Z'
    s.push_string(t);
    assert(s.to_string().count() == 5, "push string count");
    assert(s.to_string()[4] == z, "push string byte");
};

let test_push_string_self_alias() Void = {
    let mutable s = StringBuilder.new();
    s.push_string("ab");
    let snapshot = s.to_string();
    s.push_string(snapshot);
    assert(s.to_string() == "abab", "push_string self alias");
};

let test_push_substring_self_alias() Void = {
    let mutable s = StringBuilder.new();
    s.push_string("abcd");
    let snapshot = s.to_string();
    s.push_substring(snapshot, 1..<3);
    assert(s.to_string() == "abcdbc", "push_substring self alias");
};

let test_push_int_string() Void = {
    let mutable s = StringBuilder.new();
    s.push_string("value: ");
    s.push_string(42.to_string());
    assert(s.to_string() == "value: 42", "push int via to_string");
};

let test_push_uint_string() Void = {
    let mutable s = StringBuilder.new();
    s.push_string("count: ");
    s.push_string((100(UInt)).to_string());
    assert(s.to_string() == "count: 100", "push uint via to_string");
};

let test_push_bool_string() Void = {
    let mutable s = StringBuilder.new();
    s.push_string("flag: ");
    s.push_string(true.to_string());
    assert(s.to_string() == "flag: true", "push bool true via to_string");

    let mutable s2 = StringBuilder.new();
    s2.push_string("flag: ");
    s2.push_string(false.to_string());
    assert(s2.to_string() == "flag: false", "push bool false via to_string");
};

let test_copy_on_write() Void = {
    // String is value type: let b = a creates independent copy
    let a = "hi";
    let b = a;
    let h UInt8 = 104;// 'h'

    // Mutate via StringBuilder (String itself is immutable)
    let mutable sb = StringBuilder.new();
    sb.push_string(a);
    let bang UInt8 = 33;// '!'
    sb.push_byte(bang);
    let a_mutated = sb.to_string();

    assert(a_mutated.count() == 3, "a mutated count");
    assert(a_mutated[2] == bang, "a mutated byte");

    // Original copy remains unchanged (value semantics)
    assert(b.count() == 2, "b preserved count");
    assert(b[0] == h, "b preserved byte");
};

let test_add_operator() Void = {
    let a = "hello";
    let b = " world";
    let c = a + b;
    assert(c == "hello world", "string + string");

    let left = "" + a;
    assert(left == a, "empty + a");

    let right = a + "";
    assert(right == a, "a + empty");
};

let main() Void = {
    test_literal_basics();
    test_push();
    test_push_string();
    test_push_string_self_alias();
    test_push_substring_self_alias();
    test_push_int_string();
    test_push_uint_string();
    test_push_bool_string();
    test_copy_on_write();
    test_add_operator();
    println("String tests passed");
};
