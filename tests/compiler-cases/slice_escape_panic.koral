// EXPECT-ERROR: Panic: borrow_slice: slice escaped its borrow
// 逃逸检查（slice-design §借出）：闭包结束时块 RC 必须回到入口值（窗口建立前
// 读的那份，作用域词法闭合）。真逃逸 = 存进闭包**外**的持有者（闭包局部的
// 持有者闭包结束即散，不算逃逸——曾因 RC 账目错被误钉）。
let main(): Void = {
    let xs = List[UInt8].new();
    xs.push(1);
    let holder = List[[]mutable UInt8].new();
    xs.borrow_slice((s) => {
        holder.push(s);
    });
};
