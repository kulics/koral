// EXPECT-ERROR: Type mismatch: expected B, got A
// `?T(x)` wraps an `x` that is already a `T`. Mutability alone would let two
// unrelated mutable types trade places.

type mutable A(n Int);
type mutable B(s String);

public let main() Int = {
    let a = A(1);
    let w = ?B(a);
    return 0;
};
