// EXPECT-ERROR: Cannot take the address of a field of a 'sendable mutable' object

// Taking the address of a field of a safe `sendable mutable` object would
// bypass the object-lock promise (concurrency-design.md §对象锁语义·裁定二):
// the pointer could be used for unsynchronized reads and writes.

type sendable mutable Counter(mutable hits: Int);

let main(): Void = {
    let c = Counter(0);
    let p = &c.hits;
    let _ = p;
};
