// EXPECT: 50
// EXPECT: 10

type Rect(width Int, height Int)

type Cmd {
    Draw(x Int, y Int),
    Clear(),
}

let main() Int = {
    let r = Rect(height: 10, width: 5)
    if r is Rect(height: h, width: w) then println(w * h)

    let cmd = Cmd.Draw(y: 20, x: 10)
    when cmd in {
        .Draw(y: _, x: x) then println(x),
        .Clear() then println(0),
    }
    return 0
}
