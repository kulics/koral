// EXPECT: 42
// Explicit method type arguments bind in DECLARATION order. The binder used
// to pair them against the DISCOVERY order -- walking the signature finds the
// `other: S` parameter before the arrow's `U` -- and shifted every argument
// one slot: `U` received `S`'s argument, `U: Shown` was checked against `S`'s
// argument, and the return type was instantiated with a neighbor's. The
// declaration order is `U, S`; the discovery order is `S, U`.

trait Shown {
    shown(self): String;
};

type Num(value: Int);

given Num: Shown {
    shown(self): String = self.value.to_string();
};

type Box[T: Any](value: T);

given[T: Any] Box[T] {
    render[U: Shown, S: Any](self, other: S, make: (S) -> U): String = make(other).shown();
};

let main(): Void = {
    let b = Box(7);
    println(b.render[Num, Int](42, (n) => Num(n)));
};
