// Comparison binds tighter than `or return` too: `a == b or return` groups as
// `(a == b) or return`, so `or return` receives the `Bool` from `==` and is
// rejected, instead of `a == (b or return)`.
// EXPECT-ERROR: 'or return' can only be used with Option or Result types, got 'Bool'

let f(a Option[Int], b Option[Int]) Option[Int] = {
    let r = a == b or return;
    return Option[Int].Some(0);
};

let main() Int = {
    let x = f(Option[Int].Some(1), Option[Int].Some(2));
    return 0;
};
