// EXPECT: given_instance_method_generic_ok
// EXPECT: given_instance_method_generic_explicit_ok

// A method-generic method of an instantiation-target `given` (a method
// carrying its own type parameters) is instantiated per call and scoped to
// exactly its instantiation.

type Box[T: Any](value: T);

given Box[Int] {
    public pick[U: Any](self, a: U, b: U): U = a;
};

let main(): Void = {
    assert(Box[Int](1).pick(3, 4) == 3, "inferred method type args");
    println("given_instance_method_generic_ok");
    assert(Box[Int](1).pick[String]("a", "b") == "a", "explicit method type args");
    println("given_instance_method_generic_explicit_ok");
};
