// EXPECT-ERROR: List pattern requires a List subject, got 'String'
// Design guard: a list pattern destructures `List[T]` by length. Which std
// type that is comes from the declaration, never from the spelling, and no
// other type has a length/slot shape to match against.
using "std" { ... };

let main(): Int = {
    let s = when "hi" in {
        [a] then 1,
        _ then 2,
    };
    println(s);
    return 0;
};
