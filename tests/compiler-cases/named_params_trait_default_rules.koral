// EXPECT-ERROR: implementation must not also declare a default value

trait Formatter {
    format(self, prefix: String = ">", suffix: String) String;
};

type Line(text String);

given Line as Formatter {
    // ERROR: trait method has default for 'prefix', implementation cannot also have default
    format(self, prefix: String = ">>", suffix: String) String = prefix + self.text + suffix;
};

let main() Int = {
    let line = Line("hello");
    println(line.format(prefix: "[", suffix: "]"));
    return 0;
};
