// EXPECT: 11

trait CounterOps {
    peek(*self) Int
}

type Counter(value Int)

given Counter as CounterOps {

    public peek(*self) Int = self.value
}

let erase[T CounterOps](x * T) * CounterOps = x

let main() Int = {
    let strong *mut Counter = box(Counter(11))
    let readonly * Counter = strong
    let erased = erase(readonly)
    println(erased.peek().to_string())
    return 0
}