// A store through an element slot must compute the slot AFTER the value is
// evaluated: a value that grows the container can move its buffer, and a
// store through an earlier-taken slot pointer would corrupt the heap.
// EXPECT: field_store:
// EXPECT: 7
// EXPECT: element_store:
// EXPECT: 9

type mutable Rec(mutable v: Int);

let grow_rec(xs: List[Rec]): Int = {
    for i in 0..<100 then {
        xs.push(Rec(0));
    };
    return 7;
};

let grow_int(xs: List[Int]): Int = {
    for i in 0..<100 then {
        xs.push(0);
    };
    return 9;
};

let main(): Int = {
    let mutable recs = List[Rec].new();
    recs.push(Rec(1));
    recs[0].v = grow_rec(recs);
    println("field_store:");
    println(recs[0].v);

    let mutable xs = List[Int].new();
    xs.push(1);
    xs[0] = grow_int(xs);
    println("element_store:");
    println(xs[0]);
    return 0;
};
