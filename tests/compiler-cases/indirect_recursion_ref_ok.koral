// Test case for legal indirect recursion through *
// This should compile successfully because * breaks the cycle
// EXPECT: OK

// Two types that reference each other through *
// This is legal because * is a fixed-size pointer
type Person(
    name String,
    friend * Person  // * breaks the cycle
)

type TreeNode(
    value Int,
    left Option[* TreeNode],
    right Option[* TreeNode]
)

// Mutual recursion through * is also OK
type Parent(
    name String,
    child * Child
)

type Child(
    name String,
    parent * Parent
)

let main() Int = {
    println("OK")
    return 0
}
