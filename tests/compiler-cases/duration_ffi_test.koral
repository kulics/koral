// EXPECT: duration ffi ok

foreign type Timespec(tv_sec Int64, tv_nsec Int64)

let test_ffi_struct() Bool = {
    let ts = Timespec(1(Int64), 500_000_000(Int64))
    assert(ts.tv_sec == 1(Int64), "tv_sec mismatch")
    assert(ts.tv_nsec == 500_000_000(Int64), "tv_nsec mismatch")

    let p = &raw ts
    assert(p.tv_sec == 1(Int64), "ptr tv_sec mismatch")

    return true
}

let main() Int = {
    assert(test_ffi_struct(), "test_ffi_struct failed")
    println("duration ffi ok")
    return 0
}
