// EXPECT: duration ffi ok

type foreign Timespec(tv_sec Int64, tv_nsec Int64);

let test_ffi_struct() Bool = {
    let ts = Timespec(Int64(1), Int64(500_000_000));
    assert(ts.tv_sec == Int64(1), "tv_sec mismatch");
    assert(ts.tv_nsec == Int64(500_000_000), "tv_nsec mismatch");

    let p = & ts;
    assert(p.tv_sec == Int64(1), "ptr tv_sec mismatch");

    return true;
};

let main() Int = {
    assert(test_ffi_struct(), "test_ffi_struct failed");
    println("duration ffi ok");
    return 0;
};
