// EXPECT: guard not pattern ok

// A `not` pattern binds nothing; the guard runs with no bindings in scope.

let main(): Int = {
    let x = 4;
    let s = when x in {
        not 5 where x > 3 then "big",
        not 5 then "small",
        5 then "five",
        _ then "other",
    };
    if s != "big" then {
        eprintln("FAIL: not-pattern guard");
        return 1;
    };
    let y = 5;
    let t = when y in {
        not 5 where false then "unreachable",
        5 then "five",
        _ then "other",
    };
    if t != "five" then {
        eprintln("FAIL: not-pattern guard fallthrough");
        return 1;
    };
    println("guard not pattern ok");
    return 0;
};
