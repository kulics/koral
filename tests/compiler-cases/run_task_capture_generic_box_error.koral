// EXPECT-ERROR: sendable closure cannot capture non-sendable value 'boxed'
// The conditional rule is anti-smuggling everywhere: a capture of `Box[T]`
// with `T: Any` is not known sendable either (the argument condition is not
// proved), so run_task refuses it too (concurrency-design.md §跨界检查 (a)).

using "std/async" { ... };

type sendable Box[T: Any](value: T);

let work[T: Any](boxed: Box[T]): Void = {
    let t = run_task(() => {
        let _ = boxed;
    });
    let _ = t.wait();
};

let main(): Void = {
    work(Box[Int](1));
};
