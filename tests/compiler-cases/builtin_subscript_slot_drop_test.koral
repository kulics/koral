// Element slots follow the same retain/release rules as field access:
// storing releases the old element, reading retains the new one.
// EXPECT: churn:
// EXPECT: 100
// EXPECT: retained:
// EXPECT: head

type mutable Rec(mutable v: Int);

let main(): Int = {
    let mutable xs = List[String].new();
    xs.push("a");
    xs.push("b");
    xs[0] = xs[1];
    xs[0] = "head";
    println("churn:");
    let mutable recs = List[Rec].new();
    recs.push(Rec(1));
    recs.push(Rec(2));
    recs[0] = recs[1];
    recs[1].v = 100;
    println(recs[0].v);
    println("retained:");
    println(xs[0]);
    return 0;
};
