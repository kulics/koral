// EXPECT: fmt_huge_ok
// EXPECT: fmt_tiny_ok
// EXPECT: fmt_epsilon_ok
// EXPECT: fmt_shortest_ok
// EXPECT: fmt_int_ok
// EXPECT: fmt_power_of_ten_ok
// EXPECT: fmt_hundred_ok
// EXPECT: fmt_zero_ok
// EXPECT: fmt_negative_ok
// EXPECT: fmt_negative_zero_ok
// EXPECT: fmt_nan_ok
// EXPECT: fmt_inf_ok
// EXPECT: fmt_min_denormal_ok
// EXPECT: rt_ok

// Shortest-round-trip JSON number formatting: no Int conversion (so |v| >= 2^63
// prints), full precision (1e-20 and 1 ULP values round-trip), and non-finite
// values render as "null".

using "std/json" { ... };

let roundtrip_ok(text: String): Bool = {
    let first = JsonValue.parse(text);
    let mutable ok = false;
    when first in {
        .Error(_) then {},
        .Ok(v) then {
            let printed = v.to_string();
            when JsonValue.parse(printed) in {
                .Error(_) then {},
                .Ok(v2) then {
                    ok = v2 == v;
                },
            };
        },
    };
    return ok;
};

let main(): Int = {
    // Magnitudes above 2^63 used to abort on Int conversion.
    let huge = JsonValue.Number(1e30).to_string();
    if huge == "1e+30" then println("fmt_huge_ok") else println("FAIL fmt_huge: " + huge);

    // 15-digit truncation used to print "0.0".
    let tiny = JsonValue.Number(1e-20).to_string();
    if tiny == "1e-20" then println("fmt_tiny_ok") else println("FAIL fmt_tiny: " + tiny);

    let eps = JsonValue.Number(1.0000000000000002).to_string();
    if eps == "1.0000000000000002" then println("fmt_epsilon_ok")
    else println("FAIL fmt_epsilon: " + eps);

    let shortest = JsonValue.Number(0.1).to_string();
    if shortest == "0.1" then println("fmt_shortest_ok")
    else println("FAIL fmt_shortest: " + shortest);

    // Integer-valued doubles print without a decimal point.
    let int_v = JsonValue.Number(42.0).to_string();
    if int_v == "42" then println("fmt_int_ok") else println("FAIL fmt_int: " + int_v);

    let p10 = JsonValue.Number(10.0).to_string();
    if p10 == "10" then println("fmt_power_of_ten_ok") else println("FAIL fmt_power_of_ten: " + p10);

    let hundred = JsonValue.Number(100.0).to_string();
    if hundred == "100" then println("fmt_hundred_ok") else println("FAIL fmt_hundred: " + hundred);

    let zero = JsonValue.Number(0.0).to_string();
    if zero == "0" then println("fmt_zero_ok") else println("FAIL fmt_zero: " + zero);

    let neg = JsonValue.Number(0.0 - 5.0).to_string();
    if neg == "-5" then println("fmt_negative_ok") else println("FAIL fmt_negative: " + neg);

    // Negative zero keeps its sign so it round-trips bit-for-bit.
    let neg_zero = JsonValue.Number(Float64.from_bits(UInt64(1) << 63)).to_string();
    if neg_zero == "-0" then println("fmt_negative_zero_ok")
    else println("FAIL fmt_negative_zero: " + neg_zero);

    let nan_v = JsonValue.Number(Float64.nan()).to_string();
    if nan_v == "null" then println("fmt_nan_ok") else println("FAIL fmt_nan: " + nan_v);

    let inf_v = JsonValue.Number(Float64.inf()).to_string();
    if inf_v == "null" then println("fmt_inf_ok") else println("FAIL fmt_inf: " + inf_v);

    let denorm = JsonValue.Number(Float64.min_denormal()).to_string();
    if denorm == "5e-324" then println("fmt_min_denormal_ok")
    else println("FAIL fmt_min_denormal: " + denorm);

    // Every printed form re-parses to the identical double.
    let values = [
        "0.3", "1.0000000000000002", "1e+30", "1e-20", "2.2250738585072014e-308",
        "123456789", "-2.5", "0.1", "1e+100", "5e-324", "1.7976931348623157e+308",
    ];
    let mutable all_ok = true;
    for text in values then {
        if not roundtrip_ok(text) then {
            println("FAIL roundtrip: " + text);
            all_ok = false;
        };
    };
    if all_ok then println("rt_ok");

    return 0;
};
