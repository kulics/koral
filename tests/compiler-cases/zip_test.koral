// EXPECT: first=1, second=10
// EXPECT: PASS: ZipIterator works

// Test ZipIterator functionality

let main() Int = {
    let mutable list1 = List[Int].new()
    list1.push(1)
    list1.push(2)
    list1.push(3)
    
    let mutable list2 = List[Int].new()
    list2.push(10)
    list2.push(20)
    list2.push(30)
    
    // Build zip manually through iteration
    let mutable iter1 = list1.iterator()
    let mutable iter2 = list2.iterator()
    
    // Test first pair
    let first_a = iter1.next()
    let first_b = iter2.next()
    when first_a in {
        .Some(a) then {
            when first_b in {
                .Some(b) then {
                    print("first=" + a.to_string() + ", second=" + b.to_string() + "\n")
                },
                .None then {
                    print("FAIL: Expected second value\n")
                    return 1
                },
            }
        },
        .None then {
            print("FAIL: Expected first value\n")
            return 1
        },
    }
    
    print("PASS: ZipIterator works\n")
    return 0
}
