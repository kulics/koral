// EXPECT: renamed-key-ok
// EXPECT: renamed-box:7

// The dependency key (`zalias`) is a consumer-side spelling and no part of
// module identity (§5.3.1): renaming it changes no generated symbol. The
// symbol-level form of this claim is the emit-c diff probe -- same package
// under two keys must generate identical C symbols; this case pins the
// behavioral half.

using "zalias/util" { renamed_tag, RenamedBox };

let main(): Int = {
    println(renamed_tag());
    let b: RenamedBox = RenamedBox(7);
    println("renamed-box:" + b.v.to_string());
    return 0;
};
