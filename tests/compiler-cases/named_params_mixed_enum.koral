// EXPECT: hello
// EXPECT: 100

type Msg {
    Text(content: String),
    Resize(width: Int = 800, height: Int = 600),
};

let main() Int = {
    let m1 = Msg.Text(content: "hello");
    if m1 is .Text(content: c) then println(c);
    let m2 = Msg.Resize(width: 100);
    if m2 is .Resize(width: w, height: h) then println(w);
    return 0;
};
