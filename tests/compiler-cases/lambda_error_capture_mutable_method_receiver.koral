// EXPECT-ERROR: Cannot capture mutable variable 's'; hold the state in a Cell and capture the cell instead

// Using a `let mutable` as a method receiver inside a lambda is a capture of
// that binding, not a snapshot of its current value: the closure would hold
// storage it does not own.

let main() Int = {
    let mutable s = "hi";
    let f = () -> s.to_string();
    return 0;
};
