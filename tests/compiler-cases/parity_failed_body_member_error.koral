// EXPECT-ERROR: Undefined variable: bogus
// A method body that fails to check says so once: the body's own error is the
// whole story at the call sites. The method's signature is what call sites
// resolve against, and the failing body does not take it away.

type Point(x: Int);

given Point {
    use(self): Int = {
        return bogus;
    };
};

let caller(p: Point): Int = {
    return p.use();
};

let main(): Int = {
    return caller(Point(1));
};
