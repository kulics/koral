// EXPECT: rotate_zero_ok
// EXPECT: rotate_full_width_ok
// EXPECT: rotate_bits_ok
// A rotation by n modulo the bit width is total: n % width == 0 is the
// identity, never an over-wide shift panic (the old complementary
// `width - shift` reached `width` exactly there).

using "std/math" { ... };

let main(): Int = {
    if Int8(5).rotate_left(0) == Int8(5) and Int8(5).rotate_right(0) == Int8(
        5,
    ) and UInt32(7).rotate_left(0) == UInt32(7) and Int(7).rotate_right(0) == Int(
        7,
    ) then {
        println("rotate_zero_ok");
    };
    if Int8(5).rotate_left(8) == Int8(5) and Int8(5).rotate_right(8) == Int8(
        5,
    ) and Int8(5).rotate_left(16) == Int8(5) and UInt32(1).rotate_left(
        32,
    ) == UInt32(1) and Int(7).rotate_left(64) == Int(7) and Int(7).rotate_right(
        64,
    ) == Int(7) and WrappingInt8(5).rotate_left(8) == WrappingInt8(
        5,
    ) and WrappingUInt64(3).rotate_right(64) == WrappingUInt64(3) then {
        println("rotate_full_width_ok");
    };
    if Int8(1).rotate_left(4) == Int8(16) and Int8(1).rotate_right(1) == Int8(
        -128,
    ) and Int8(-128).rotate_left(1) == Int8(1) and WrappingInt8(1).rotate_left(
        4,
    ) == WrappingInt8(16) then {
        println("rotate_bits_ok");
    };
    return 0;
};
