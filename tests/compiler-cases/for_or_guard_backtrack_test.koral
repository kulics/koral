// EXPECT: for_or_guard_backtrack_ok
// Design guard: a `for` pattern with `or` offers several readings, and the
// where-guard is re-evaluated on each reading's own bindings -- a refused
// guard falls through to the next reading and only then skips the element.
// The unguarded loop keeps first-reading-wins: `.B(x, _) or .B(_, x)` on
// `B(1, 3)` binds x=1. That pin also catches the subject-cache leak where
// the re-test of the left reading compared the WRAPPER's enum tag and filled
// the bindings from the right reading instead.

using "std" { ... };

type Box {
    B(x Int, y Int),
};

type Nest {
    N(b Box, other Int),
};

let main() Int = {
    let mutable bs = List[Box].new();
    bs.push(Box.B(1, 3));

    let mutable backtrack = -99;
    for .B(x, _) or .B(_, x) in bs where x > 2 then {
        backtrack = x;
    };
    if backtrack != 3 then {
        eprintln("FAIL: for guard must re-run per reading");
        return 1;
    };

    let mutable first = -99;
    for .B(x, _) or .B(_, x) in bs where x > 0 then {
        first = x;
    };
    if first != 1 then {
        eprintln("FAIL: first reading wins when its guard accepts");
        return 1;
    };

    let mutable plain = -99;
    for .B(x, _) or .B(_, x) in bs then {
        plain = x;
    };
    if plain != 1 then {
        eprintln("FAIL: unguarded or binds the first matching reading");
        return 1;
    };

    let mutable ns = List[Nest].new();
    ns.push(Nest.N(Box.B(1, 3), 9));
    let mutable nested = -99;
    for .N(.B(x, _) or .B(_, x), _) in ns where x > 2 then {
        nested = x;
    };
    if nested != 3 then {
        eprintln("FAIL: nested or readings backtrack too");
        return 1;
    };

    let mutable skipped = 0;
    for .B(x, _) or .B(_, x) in bs where x > 100 then {
        skipped += 1;
    };
    if skipped != 0 then {
        eprintln("FAIL: refused guard on every reading skips the element");
        return 1;
    };

    println("for_or_guard_backtrack_ok");
    return 0;
};
