// EXPECT-ERROR: Duplicate definition: generic_kind
// A generic `given` serves every instantiation of its type, so a same-named
// method in an instantiation-target `given` is a second definition on that
// instantiation -- a duplicate, never a specialization that shadows the
// generic one.

type Crate[T: Any](value: T);

given[T: Any] Crate[T] {
    public generic_kind(self): String = "generic";
};

given Crate[Int] {
    public generic_kind(self): String = "int-specialized";
};

let main(): Int = {
    return 0;
};
