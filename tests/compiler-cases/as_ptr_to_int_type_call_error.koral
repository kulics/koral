// EXPECT-ERROR: Pointer and integer casts are written 'expr as Type', not 'Type(expr)'
// A pointer-to-integer cast is `p as UInt`, not the numeric-conversion
// spelling `UInt(p)`.

let main() Int = {
    let p = alloc_memory[Int](1);
    init_memory(p, 42);
    let u = UInt(p);
    dealloc_memory(p);
    return 0;
};
