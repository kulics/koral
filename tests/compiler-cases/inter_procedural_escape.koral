// Inter-procedural escape analysis integration test
//
// Tests that &local_var is correctly heap-allocated when passed to
// functions that store the value via init_memory or .val assignment
// (e.g. List.push, Set.insert), preventing dangling pointers.
//
// EXPECT: Test 1 direct: Leaf 10
// EXPECT: Test 2 method: Leaf 42
// EXPECT: Test 3 multi push: 3
// EXPECT: Test 3 values: 10 20 30
// EXPECT: Test 4 no escape: 99
// EXPECT: Test 5 nested: Leaf 77
// EXPECT: Test 6 set with list: ok
// EXPECT: Test 7 deref assign: 55

public type Node {
    Leaf(value Int),
    Branch(children List[* Node]),
}

public type Builder(mutable dummy Int)

given Builder {

    public new() Builder = Builder(0)

    public make_leaf(*self, v Int) Node = Node.Leaf(v)

    // Core test: build() creates a local variable, pushes * into List,
    // returns the List inside a enum. Without inter-procedural escape
    // analysis, `child` would be stack-allocated and become a dangling pointer.
    public build(*self) Node = {
        let mutable kids = List[* Node].new()
        let mutable child = self.make_leaf(42)
        kids.push(&child)
        return Node.Branch(kids)
    }

    // Multiple refs pushed into a list
    public build_multi(*self) List[* Node] = {
        let mutable kids = List[* Node].new()
        let mutable c1 = self.make_leaf(10)
        let mutable c2 = self.make_leaf(20)
        let mutable c3 = self.make_leaf(30)
        kids.push(&c1)
        kids.push(&c2)
        kids.push(&c3)
        return kids
    }

    // Nested: build calls another method that also pushes refs
    public build_nested(*self) Node = {
        let mutable kids = List[* Node].new()
        let mutable inner = self.make_leaf(77)
        kids.push(&inner)
        return Node.Branch(kids)
    }
}


// Helper: a function that takes a * but does NOT store it anywhere.
// The * should remain stack-allocated (no escape).
let read_ref(n * Node) Int = {
    return when *n in {
        .Leaf(v) then v,
        .Branch(_) then 0 - 1,
    }
}

// Helper: wraps a value in a Box via deref assignment
public type IntBox(mutable value Int)

let box_value(v Int) IntBox = {
    let mutable b = IntBox(0)
    b.value = v
    return b
}

let print_node(label String, node Node) Void = {
    when node in {
        .Branch(ch) then {
            let n = *ch[0]
            when n in {
                .Leaf(v) then println(label + "Leaf " + v.to_string()),
                _ then println(label + "FAIL"),
            }
        },
        _ then println(label + "not Branch"),
    }
}

public let main() Void = {
    // Test 1: Direct construction (baseline, no method call)
    let mutable kids1 = List[* Node].new()
    let mutable c1 = Node.Leaf(10)
    kids1.push(&c1)
    let tree1 = Node.Branch(kids1)
    print_node("Test 1 direct: ", tree1)

    // Test 2: Via method — the core dangling pointer fix
    let mutable b = Builder.new()
    let tree2 = b.build()
    print_node("Test 2 method: ", tree2)

    // Test 3: Multiple refs pushed into a list via method
    let kids3 = b.build_multi()
    println("Test 3 multi push: " + kids3.count().to_string())
    let n0 = *kids3[0]
    let n1 = *kids3[1]
    let n2 = *kids3[2]
    let mutable vals = String.new()
    when n0 in { .Leaf(v) then { vals.push_string(v.to_string()); }, _ then {}, }
    vals.push_string(" ")
    when n1 in { .Leaf(v) then { vals.push_string(v.to_string()); }, _ then {}, }
    vals.push_string(" ")
    when n2 in { .Leaf(v) then { vals.push_string(v.to_string()); }, _ then {}, }
    println("Test 3 values: " + vals)

    // Test 4: Non-escaping * — should still use stack allocation
    let mutable leaf4 = Node.Leaf(99)
    let result4 = read_ref(&leaf4)
    println("Test 4 no escape: " + result4.to_string())

    // Test 5: Nested method call with *
    let tree5 = b.build_nested()
    print_node("Test 5 nested: ", tree5)

    // Test 6: Set operations with List (exercises Set + List together)
    let mutable s = Set[Int].new()
    s.insert(1)
    s.insert(2)
    s.insert(3)
    let mutable items = List[Int].new()
    for v in s.iterator() then {
        items.push(v)
    }
    let len6 = items.count()
    println("Test 6 set with list: " + (if len6 > 1 then "ok" else "fail"))

    // Test 7: deref assignment escape (value written to pointer target)
    let b7 = box_value(55)
    println("Test 7 deref assign: " + b7.value.to_string())
}
