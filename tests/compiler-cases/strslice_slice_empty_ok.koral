// EXPECT: strslice_empty_ok
// EXPECT: strslice_empty_siblings_ok

// The String mirror of the empty-span rule: every range that normalizes to
// `[lo, lo)` slices to "" (`a..<a`, `a<..a`, `a<..<a+1`, `a..a-1`).
// (`a<..<a` crosses instead and panics; see
// panic_resolve_span_open_cross_error.)

let main(): Void = {
    let text = "abcde";

    assert(text.substring(2..<2).count() == 0, "2..<2 empty");
    assert(text.substring(2<..2).count() == 0, "2<..2 empty");
    assert(text.substring(2<..<3).count() == 0, "2<..<3 empty");
    assert(text.substring(1<..<2).count() == 0, "1<..<2 empty");
    assert(text.substring(3..2).count() == 0, "3..2 empty");
    assert(text.count() == 5, "substring leaves source untouched");
    println("strslice_empty_ok");

    // A non-empty span still slices normally.
    let slice = text.substring(1<..<4);
    assert(slice == "cd", "1<..<4 picks cd");
    println("strslice_empty_siblings_ok");
};
