// EXPECT: member return alias: 9
// EXPECT: member return alias ok

public type Holder(mutable value Int);

let identity_ref(r * Int) * Int = {
    return r;
};

let main() Int = {
    let mutable holder = Holder(7);
    let alias = identity_ref(&holder.value);
    holder.value = 9;
    println("member return alias: " + (*alias).to_string());
    assert(*alias == 9, "member-path return-only ref should alias original field");
    println("member return alias ok");
    return 0;
};