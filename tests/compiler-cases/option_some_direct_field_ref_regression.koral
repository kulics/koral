// EXPECT: ok

type Kind {
    A(),
    B(),
}

given Kind not Deref

type Expr(kind * Kind)

let wrap(expr Expr) Option[* Kind] = Option[* Kind].Some(expr.kind)

let classify(kind * Kind) Int = when kind in {
    .A() then 1,
    .B() then 2,
}

let main() Void = {
    let kind_a *mutable Kind = box(Kind.A())
    let expr = Expr(kind_a)
    assert(classify(wrap(expr).unwrap()) == 1, "constructor arg should widen field *")
    println("ok")
}
