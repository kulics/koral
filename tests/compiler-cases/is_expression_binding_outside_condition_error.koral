// EXPECT-ERROR: Variable bindings in 'is' expression are only allowed in if/while conditions and where guards

type MyOption {
    None(),
    Some(value: Int),
};

let main(): Int = {
    let opt = MyOption.Some(1);
    let matched = opt is .Some(value);
    if matched then {
        println("unexpected");
    };
    return 0;
};
