// EXPECT: concat leaves inputs alone
// EXPECT: concat of self works
// EXPECT: concat keeps elements

// `List.concat` returns a fresh list. The old `List as Add` short-circuited on an
// empty operand and handed the other operand straight back, so `[] + b` returned
// `b` itself and a later `push` on the result mutated `b`.

let main(): Int = {
    let a: List[Int] = [];
    let b: List[Int] = [7];
    let c = a.concat(b);
    c.push(8);
    if b.count() == 1 and c.count() == 2 then {
        println("concat leaves inputs alone");
    };

    let d: List[Int] = [1, 2];
    let e = d.concat(d);
    if e.count() == 4 and d.count() == 2 then {
        println("concat of self works");
    };

    let f: List[Int] = [1, 2];
    let g: List[Int] = [3];
    let h = f.concat(g);
    if h.count() == 3 and h.get(0).unwrap() == 1 and h.get(2).unwrap() == 3 then {
        println("concat keeps elements");
    };
    return 0;
};
