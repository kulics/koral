// EXPECT: PASS
// Test: return value escape analysis handles aggregates containing references

type RefHolder(data * Int)

let return_ref_in_struct() RefHolder = {
    let mutable x Int = 77
    return RefHolder(&x)  // x escapes through returned struct
}

let return_ref_through_call() RefHolder = {
    return return_ref_in_struct()  // ref escapes through function call
}

let test_return_aggregate_escape() Void = {
    let holder = return_ref_in_struct()
    assert(*holder.data == 77, "return aggregate escape")
}

let test_transitive_return_escape() Void = {
    let holder = return_ref_through_call()
    assert(*holder.data == 77, "transitive return escape")
}

let main() Void = {
    test_return_aggregate_escape()
    test_transitive_return_escape()
    println("PASS")
}
