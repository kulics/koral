// A bare collection literal in a generic ARGUMENT position infers its
// element type from the elements and keeps the parameter's family, so the
// call binds T from the literal (`count_of([1, 2])` -> T = Int). The family
// parameter's echo (`List[T]` carried as the argument type) used to bind T
// to itself -- main reported "expected inferred type for T, got unknown" and
// the seed leaked "Undefined type: T" from the literal's container lowering.
// Nested literals bind T to a collection type the same way.
// EXPECT: 2

let count_of[T: Any](xs: List[T]): Int = xs.count();

let main(): Int = {
    let n = count_of([1, 2]);
    let nested = count_of([[1], [2]]);
    println(n.to_string());
    println(nested.to_string());
    return 0;
};
