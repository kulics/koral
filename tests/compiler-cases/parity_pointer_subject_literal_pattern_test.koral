// EXPECT: p_null_raw: false
// EXPECT: n_null_raw: true
// EXPECT: q_not_null_raw: true
// EXPECT: checked: ok
// `p is 5` on a `*Int` matches the POINTEE: the pattern subject auto-derefs
// one indirection, consistent with struct patterns looking through pointers.
// The literal match is pinned in a generic body both compilers check and
// neither lowers (the seed's MIR cannot yet emit a pointer-subject literal
// test at runtime). A `null` pattern is the one exception -- it tests the
// POINTER itself and keeps the raw subject -- and runs for real: a live
// pointer is not null and the null literal is.

let lit_through_pointer[T Any](p *Int, mp *mutable Int) Bool = {
    return p is 5 and mp is 5 and not (p is 6);
};

let main() Int = {
    let x = 5;
    let p = &x;
    let mutable y = 5;
    let mp = &mutable y;
    let p_null_raw = p is null;
    println("p_null_raw: \(p_null_raw)");
    let n *Int = null;
    let n_null_raw = n is null;
    println("n_null_raw: \(n_null_raw)");
    let q = alloc_memory[Int](1);
    init_memory(q, 7);
    let q_not_null_raw = q is not null;
    println("q_not_null_raw: \(q_not_null_raw)");
    println("checked: ok");
    dealloc_memory(q);
    return 0;
};
