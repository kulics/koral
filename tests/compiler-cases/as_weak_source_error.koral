// EXPECT-ERROR: Invalid operation cast between types ?Box and *Box
// Casting FROM a weak handle is refused: `?Box` is a handle, not the referent,
// so it has no pointer reading to reinterpret.

type mutable Box(mutable value: Int);

let main(): Int = {
    let b = Box(42);
    let w = b as ?Box;
    let p = w as *Box;
    return 0;
};
