using "std";

// Same name as mod_a's `Plain`, different shape: `right` instead of `left`.
public type Plain(public right Int, public extra Int);

// Same name as mod_a's `Box`, one field more.
public type Box[T Any](public value T, public extra T);

public trait Shape {
    name(self) String;
};

public type Square(side Int);

given Square as Shape {
    name(self) String = "b-square";
};

// See mod_a: the SAME method names on the SAME-named types. If the method table
// keys by name, one of these is reported as "Duplicate definition: tag" and the
// other wins for both modules.
given Plain {
    tag(self) String = "b-plain";
};

given[T Any] Box[T] {
    stamp(self) T = self.extra;
};



public let plain_tag(p Plain) String = p.tag();
public let box_stamp(v Int) Int = Box(v, v * 2).stamp();
public let make_plain() Plain = Plain(2, 20);
// `extra` is derived, so a value read from the wrong module's layout is
// visible as a wrong number rather than a lucky match.
public let make_box(v Int) Box[Int] = Box(v, v * 2);
public let shape() Shape = Square(1);
public let shape_name(s Shape) String = s.name();
