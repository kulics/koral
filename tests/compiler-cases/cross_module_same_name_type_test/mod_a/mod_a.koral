using "std";

// A non-generic type deliberately named the same as mod_b's. Its fields are
// DELIBERATELY DISJOINT from mod_b's, so a collapsed name table cannot survive
// by accident: `left` only exists here, `right` only over there.
public type Plain(public left Int);

// A generic type with the same name as mod_b's, and again a different shape:
// one field here, two there.
public type Box[T Any](public value T);

// A trait deliberately named the same as mod_b's.
public trait Shape {
    name(self) String;
};

public type Circle(radius Int);

given Circle as Shape {
    name(self) String = "a-circle";
};

// Extension methods on same-named types. Both modules declare `tag` on their
// its own `Plain`. These are distinct methods on distinct types:
// `mod_a.Plain.tag` must never answer for `mod_b.Plain`.
given Plain {
    tag(self) String = "a-plain";
};

given[T Any] Box[T] {
    stamp(self) T = self.value;
};



public let plain_tag(p Plain) String = p.tag();
public let box_stamp(v Int) Int = Box(v).stamp();
public let make_plain() Plain = Plain(1);
public let make_box(v Int) Box[Int] = Box(v);
public let shape() Shape = Circle(1);
public let shape_name(s Shape) String = s.name();
