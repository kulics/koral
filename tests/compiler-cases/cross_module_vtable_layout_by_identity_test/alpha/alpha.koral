// A trait named `Tag` whose vtable layout is [value] -- `value` sits at slot 0.
public trait Tag {
    value(self): Int;
};

public type ABox(v: Int);

given ABox: Tag {
    value(self): Int = self.v;
};

public let a_box(): ABox = ABox(7);

public let read(r: Tag): Int = {
    return r.value();
};
