using "cross_module_vtable_layout_by_identity_test/alpha" { Tag, a_box, read };

// EXPECT: 7
// A trait OBJECT's vtable slot is decided by the trait DECLARATION's layout,
// never by a name's last-wins entry. Here alpha's `Tag` lays `value` out at
// slot 0 while beta's same-named `Tag` (never imported by this module) puts a
// parent's `b` first and `value` at slot 1. Reading the slot through the bare
// name index called slot 1 of alpha's vtable -- out of bounds or another
// method's entry.

let main(): Int = {
    let t: Tag = a_box();
    println(read(t).to_string());
    return 0;
};
