// EXPECT-ERROR: '?' expects a weak reference (?T), got Box
// The old type-constructor spelling for weak construction is no longer
// special syntax: `?Box(b)` now reads as the operator chain `?(Box(b))`, so
// the weak-upgrade operator is applied to a plain Box value.

type mutable Box(mutable value Int);

let main() Int = {
    let b = 42;
    let w = ?Box(b);
    return 0;
};
