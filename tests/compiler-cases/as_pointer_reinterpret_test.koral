// EXPECT: 42
// EXPECT: 42
// EXPECT: true
// EXPECT: true
// `as` reinterpret views: a `*mutable T` reads as a `*T`, a pointer may be
// re-read through a different pointee in one step, and the view selects the
// method face of the pointer type (`*T` vs `*mutable T` givens). The givens
// here are std's own `Eq` on pointers -- a test module may not add givens on
// pointer types (they belong to std).

let main() Int = {
    let p = alloc_memory[Int](1);
    init_memory(p, 42);

    // *mutable Int -> *Int: the shared view of the same cell
    let shared = p as *Int;
    println(*shared);

    // pointer -> pointer through a different pointee: one reinterpretation
    let as_uint = p as *UInt;
    println(*as_uint);

    // the *T method face through the cast
    println((p as *Int) == (p as *Int));

    // the *mutable T face re-views to *T inside std's Eq
    println(p == p);

    dealloc_memory(p);
    return 0;
};
