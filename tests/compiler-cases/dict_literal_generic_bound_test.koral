// EXPECT: dict_literal_bound_ok
// 泛型函数的字典字面量实参：K 的 Hash 约束由调用点的推断实参满足（String
// 实现 Hash），不能拿未代换的裸 K 报「K 没有实现 Hash」——那是误报。

using "std" { ... };

let f[K: Hash, V: Any](d: Dict[K, V]): Int = {
    return d.count();
};

let main(): Int = {
    let n = f(["a": 1]);
    assert(n == 1, "dict literal into generic param");
    let m = f([1: "x", 2: "y"]);
    assert(m == 2, "int keys");
    println("dict_literal_bound_ok");
    return 0;
};
