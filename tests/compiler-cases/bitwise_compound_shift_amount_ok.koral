// EXPECT: mask=4
// EXPECT: compound_shift_ok

// `op=` is the binary operator's two-step desugaring
// (concurrency-design.md §赋值求值顺序), so a shift by a plain count rides the
// operator's own operand types: `m <<= 2` is `m = m << 2` through
// `ShiftLeft[Int]`. The old same-type guard refused this form and sent users
// to the binary spelling; the two-step form inherits `<<`'s rules instead.

type Mask(bits: UInt8);

given Mask: ShiftLeft[Int] {
    public shift_left(self, other: Int): Mask = Mask(self.bits << UInt8(other));
};

let main(): Int = {
    let mutable m = Mask(1);
    m <<= 2;
    println("mask=\(m.bits)");
    println("compound_shift_ok");
    return 0;
};
