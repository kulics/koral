// EXPECT: inherent
// EXPECT: tool:5
// EXPECT: 99
// EXPECT: 7
// EXPECT: tool:5
// EXPECT: 5
//
// A qualified call names the TRAIT it means: `Type(Trait).method(receiver, ...)`
// and `receiver(Trait).method(...)` dispatch to the qualified trait's method,
// even when the type has an inherent method of the same name. The inherent
// method keeps the UNQUALIFIED call -- qualification is how the writer picks
// the other one.

trait Tag {
    value(self): Int;
};

given Tag {
    describe(self): String = "tool:" + self.value().to_string();
    kind(self): Int = 7;
};

type Num(x: Int);

given Num: Tag {
    value(self): Int = self.x;
};

given Num {
    describe(self): String = "inherent";
    kind(self): Int = 99;
};

let main(): Int = {
    let n = Num(5);

    // Unqualified: the inherent method owns the name.
    println(n.describe());

    // Type-qualified: the trait's tool method, not the inherent one.
    println(Num(Tag).describe(n));

    // Same split for a name whose trait side is a plain tool method.
    println(n.kind());
    println(Num(Tag).kind(n));

    // Receiver-qualified spelling, same dispatch.
    println(n(Tag).describe());

    // The requirement witness chosen by qualification.
    println(Num(Tag).value(n).to_string());
    return 0;
};
