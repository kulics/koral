// Tests that T * does NOT satisfy ToString when T does not implement ToString.
// Feature: type-modifier-trait-conformance
// EXPECT-ERROR: does not satisfy trait

type NoToString(x Int)

let render[T ToString](x T) String = x.to_string()

let main() Void = {
    let mutable value = NoToString(1)
    let r = &value
    println(render(r))
}