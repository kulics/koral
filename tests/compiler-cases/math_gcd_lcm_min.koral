// EXPECT: gcd_min_ok
// EXPECT: wrap_gcd_min_ok
// EXPECT: ilog_min_ok
// EXPECT: lcm_ok
// Magnitudes are taken in the unsigned twin, so the type minimum is an
// ordinary argument: no negation panic, and the Wrapping Euclid can no longer
// hand back a truncated (negative) remainder chain.

using "std/math" { ... };

let main(): Int = {
    if Int8.gcd(-128, 12) == Int8(4) and Int8.gcd(-128, -12) == Int8(
        4,
    ) and Int8.gcd(12, -128) == Int8(4) and gcd(Int8(-128), Int8(12)) == Int8(
        4,
    ) and Int16.gcd(-32768, 12) == Int16(4) and Int.gcd(Int.min_value(), 12) == Int(
        4,
    ) then {
        println("gcd_min_ok");
    };
    if WrappingInt8.gcd(-128, 6) == WrappingInt8(2) and WrappingInt8.gcd(
        -12,
        8,
    ) == WrappingInt8(4) and gcd(WrappingInt(-12), WrappingInt(8)) == WrappingInt(
        4,
    ) then {
        println("wrap_gcd_min_ok");
    };
    if Int8.ilog2(-128) == 7 and ilog2(Int8(-128)) == 7 and Int8.ilog10(
        -100,
    ) == 2 and Int.ilog2(Int.min_value()) == 63 and WrappingInt8.ilog2(
        -128,
    ) == 7 and ilog10(Int(-1000)) == 3 then {
        println("ilog_min_ok");
    };
    if Int8.lcm(-4, 6) == Int8(12) and lcm(Int8(-12), Int8(8)) == Int8(
        24,
    ) and WrappingInt8.lcm(-4, 6) == WrappingInt8(12) and Int8.lcm(0, -128) == Int8(
        0,
    ) then {
        println("lcm_ok");
    };
    return 0;
};
