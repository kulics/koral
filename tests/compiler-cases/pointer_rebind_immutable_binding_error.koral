// EXPECT-ERROR: Cannot assign to immutable variable: p
// Whole-variable assignment is about the BINDING: a `*mutable T` type does
// not let an immutable binding be rebound.

let main(): Int = {
    let mutable a = 1;
    let mutable b = 2;
    let p: *mutable Int = &mutable a;
    let q: *mutable Int = &mutable b;
    p = q;
    return 0;
};
