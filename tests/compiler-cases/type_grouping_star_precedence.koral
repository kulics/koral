// EXPECT: 7
// `*(Int) -> Int` reads as a pointer to a function type: `->` after the `)`
// makes `(Int) -> Int` a function type, and the `*` prefix applies to that
// whole type -- `*((Int) -> Int)`.

let main(): Int = {
    let f: ((Int) -> Int) = (x: Int) => x;
    let p: *(Int) -> Int = &f;
    println((*p)(7));
    return 0;
};
