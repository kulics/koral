// EXPECT: 5
// A generic bound puts its trait's methods in scope for the parameter it
// constrains, and that includes the bound trait's SUPERTRAITS (§3.4). Rust:
// `fn go<T: Sub>(t: T) { t.b() + t.s() }` needs no `use` of either trait.
//
// `Root` is deliberately NOT named in this file -- only `Leaf` is, and only in
// the bound. `x.r()` is reachable solely through `Leaf: Root`.

using "std" { ... };
using "./traits.koral" { Leaf };
using "./lib.koral" { X };

public let go[T: Leaf](x: T): Int = x.r() + x.l();

public let main(): Int = {
    println(go(X.new()).to_string());
    return 0;
};
