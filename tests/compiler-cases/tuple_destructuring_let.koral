// Test `let (a, b, ...) = expr;` -- positional destructuring of a struct.
// EXPECT: basic: 1 2
// EXPECT: typed: 3 hello
// EXPECT: discard_first: 20
// EXPECT: discard_second: 10
// EXPECT: mutable: 99 200
// EXPECT: nested: 5 6
// EXPECT: from_function: 42 ok
// EXPECT: generic_pair: 7 true
// EXPECT: mixed: 50 world
// EXPECT: three_fields: 1 2 3
// EXPECT: for_three_fields: 4 5 6

using "std";

type Point3(x Int, y Int, z Int);

let make_pair() Pair[Int, String] = Pair(42, "ok");

let main() Int = {
    // Two slots against a two-field struct.
    let (a, b) = Pair(1, 2);
    println("basic: \(a) \(b)");

    // With type annotations
    let (c Int, d String) = Pair(3, "hello");
    println("typed: \(c) \(d)");

    // Discard first element
    let (_, e) = Pair(10, 20);
    println("discard_first: \(e)");

    // Discard second element
    let (f, _) = Pair(10, 20);
    println("discard_second: \(f)");

    // Mutable bindings
    let (mutable g, mutable h) = Pair(1, 2);
    g = 99;
    h = 200;
    println("mutable: \(g) \(h)");

    // From a variable holding a struct
    let p = Pair(5, 6);
    let (i, j) = p;
    println("nested: \(i) \(j)");

    // From a function returning a Pair
    let (k, l) = make_pair();
    println("from_function: \(k) \(l)");

    // Generic pair
    let gp = Pair[Int, Bool](7, true);
    let (m, n) = gp;
    println("generic_pair: \(m) \(n)");

    // Mixed: mutable with type, discard
    let (mutable o Int, q String) = Pair(50, "world");
    println("mixed: \(o) \(q)");

    // Any field count, not just two.
    let (r, s, t) = Point3(1, 2, 3);
    println("three_fields: \(r) \(s) \(t)");

    // The same destructuring as a for binding.
    let points = List[Point3].new();
    points.push(Point3(4, 5, 6));
    for (u, v, w) in points then {
        println("for_three_fields: \(u) \(v) \(w)");
    };

    return 0;
};
