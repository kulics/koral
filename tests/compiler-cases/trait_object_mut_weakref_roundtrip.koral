// EXPECT: 5
// EXPECT: 6

trait CounterOps {
    peek(*self) Int
    bump(*mut self) Int
}

type Counter(mut value Int)

given Counter as CounterOps {

    public peek(*self) Int = self.value

    public bump(*mut self) Int = {
        self.value += 1
        return self.value
    }
}

let main() Int = {
    let strong *mut CounterOps = box(Counter(5))
    let weak ?*mut CounterOps = downgrade_mut(strong)

    when upgrade_mut(weak) in {
        .Some(counter) then {
            println(counter.peek().to_string())
            println(counter.bump().to_string())
        },
        .None then println("upgrade failed"),
    }

    return 0
}