// std.text: '_' digit separators must sit after a digit or the radix prefix
// and before a digit.
// EXPECT: under_ok
// EXPECT: under_multi_ok
// EXPECT: prefix_hex_ok
// EXPECT: prefix_hex_neg_ok
// EXPECT: prefix_bin_ok
// EXPECT: prefix_oct_ok
// EXPECT: under_trailing_err
// EXPECT: under_double_err
// EXPECT: under_leading_err
// EXPECT: prefix_trailing_err
// EXPECT: prefix_double_err
// EXPECT: uint_under_trailing_err
// EXPECT: uint_under_double_err
// EXPECT: uint_under_ok

using "std/text" { ... };

let main(): Int = {
    // Valid separators
    when Int.parse("1_000") in {
        .Ok(n) then if n == 1000 then println("under_ok")
        else println("FAIL under"),
        .Error(e) then println("FAIL under: " + e.message()),
    };

    when Int.parse("1_2_3") in {
        .Ok(n) then if n == 123 then println("under_multi_ok")
        else println("FAIL under_multi"),
        .Error(e) then println("FAIL under_multi: " + e.message()),
    };

    // A separator directly after the radix prefix is valid (Python/Rust)
    when Int.parse_radix("0x_1F", 16) in {
        .Ok(n) then if n == 31 then println("prefix_hex_ok")
        else println("FAIL prefix_hex"),
        .Error(e) then println("FAIL prefix_hex: " + e.message()),
    };

    when Int.parse_radix("-0x_1F", 16) in {
        .Ok(n) then if n == (0 - 31) then println("prefix_hex_neg_ok")
        else println("FAIL prefix_hex_neg"),
        .Error(e) then println("FAIL prefix_hex_neg: " + e.message()),
    };

    when Int.parse_radix("0b_101", 2) in {
        .Ok(n) then if n == 5 then println("prefix_bin_ok")
        else println("FAIL prefix_bin"),
        .Error(e) then println("FAIL prefix_bin: " + e.message()),
    };

    when UInt.parse_radix("0o_77", 8) in {
        .Ok(n) then if n == 63 then println("prefix_oct_ok")
        else println("FAIL prefix_oct"),
        .Error(e) then println("FAIL prefix_oct: " + e.message()),
    };

    // Trailing separator
    when Int.parse("1_") in {
        .Ok(n) then println("FAIL under_trailing"),
        .Error(e) then println("under_trailing_err"),
    };

    // Doubled separator
    when Int.parse("1__2") in {
        .Ok(n) then println("FAIL under_double"),
        .Error(e) then println("under_double_err"),
    };

    // Leading separator
    when Int.parse("_1") in {
        .Ok(n) then println("FAIL under_leading"),
        .Error(e) then println("under_leading_err"),
    };

    // After the prefix the separator still needs a following digit
    when Int.parse_radix("0x_", 16) in {
        .Ok(n) then println("FAIL prefix_trailing"),
        .Error(e) then println("prefix_trailing_err"),
    };

    when Int.parse_radix("0x__1", 16) in {
        .Ok(n) then println("FAIL prefix_double"),
        .Error(e) then println("prefix_double_err"),
    };

    // Same rules on the unsigned side
    when UInt.parse("1_") in {
        .Ok(n) then println("FAIL uint_under_trailing"),
        .Error(e) then println("uint_under_trailing_err"),
    };

    when UInt.parse("1__2") in {
        .Ok(n) then println("FAIL uint_under_double"),
        .Error(e) then println("uint_under_double_err"),
    };

    when UInt.parse("1_0") in {
        .Ok(n) then if n == 10 then println("uint_under_ok")
        else println("FAIL uint_under"),
        .Error(e) then println("FAIL uint_under: " + e.message()),
    };

    return 0;
};
