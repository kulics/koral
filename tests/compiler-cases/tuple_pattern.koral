// Test tuple patterns -- positional destructuring in `when` / `is`, at any
// field count.
// EXPECT: pair_pattern_when_ok
// EXPECT: pair_pattern_if_ok
// EXPECT: pair_pattern_wildcard_ok
// EXPECT: nested_pattern_ok
// EXPECT: three_field_pattern_ok

using "std";

type Point3(x Int, y Int, z Int);

let main() Int = {
    let p = Pair(1, 2);

    // Tuple pattern in when.
    let sum = when p in {
        (a, b) then a + b,
    };
    assert(sum == 3, "when tuple pattern");
    println("pair_pattern_when_ok");

    // Tuple pattern in if-is.
    let value = if p is (a, b) then a * 10 + b else 0;
    assert(value == 12, "if tuple pattern");
    println("pair_pattern_if_ok");

    // Tuple pattern with wildcard.
    let right = when Pair(9, 42) in {
        (_, x) then x,
    };
    assert(right == 42, "tuple wildcard");
    println("pair_pattern_wildcard_ok");

    // Nested tuple pattern.
    let nested = Pair(Pair(3, 4), 5);
    let nested_sum = when nested in {
        ((x, y), z) then x + y + z,
    };
    assert(nested_sum == 12, "nested tuple pattern");
    println("nested_pattern_ok");

    // Three slots against a three-field struct.
    let t = when Point3(1, 2, 3) in {
        (a, b, c) then a * 100 + b * 10 + c,
    };
    assert(t == 123, "three-field tuple pattern");
    println("three_field_pattern_ok");

    return 0;
};
