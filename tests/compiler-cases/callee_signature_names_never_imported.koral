// EXPECT: dropped value stays quiet
// EXPECT: callee signature names are not ours to import

// `make_channel` returns `Pair[SendChannel[T], RecvChannel[T]]`. Calling it must
// not demand that the caller import `SendChannel` and `RecvChannel` -- those
// names are spelled in the callee's signature, not by whoever called it. The
// companion case is `generic_template_requires_import_error_test`, where the
// caller DOES write the name and is told to import it.

using "std/sync" { make_channel };

public let main(): Int = {
    let _ = make_channel[Int](4);
    println("dropped value stays quiet");

    let ch = make_channel[Int](2);
    let _ = ch;
    println("callee signature names are not ours to import");
    return 0;
};
