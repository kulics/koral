// EXPECT: guard statement ok

// Guards work on `when` statements as well as `when` expressions.

let main() Int = {
    let mutable total = 0;
    let x = 3;
    when x in {
        n if n > 2 then {
            total = 10;
        },
        n if n > 0 then {
            total = 5;
        },
        _ then {
            total = 1;
        },
    };
    if total != 10 then {
        eprintln("FAIL: statement guard should take the first arm");
        return 1;
    };
    println("guard statement ok");
    return 0;
};
