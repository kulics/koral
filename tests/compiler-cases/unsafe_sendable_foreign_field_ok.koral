// EXPECT: 7
// The trusted interior: `type unsafe sendable` may hold foreign composites and
// foreign function types -- the developer vouches for the cross-thread story.
// This is the only sendable-family home for `type foreign` values
// (concurrency-design.md §派生规则 9).

using "std/async" { ... };

type foreign Inner(v: Int32);

type unsafe sendable Holder(inner: Inner, cb: foreign (Int32) -> Int32);

let work(h: Holder): Void = {
    let t = run_task(() => {
        if h.inner.v == Int32(7) then {
            println("7");
        };
    });
    let _ = t.wait();
};

let main(): Void = {
    work(Holder(Inner(Int32(7)), null));
};
