// EXPECT: 18446744073709551615
// EXPECT: 511
// EXPECT: 31
// EXPECT: 1000
// EXPECT: 10.500000
// EXPECT: literal_prefixed_u64_ok
// Prefixed literals normalize to their decimal value on both lexers (any
// spelling with the same value is the same literal), digit separators are
// dropped, and a UInt64-max value is a legal `UInt` literal.

using "std/io" { ... };

let main(): Void = {
    let hex: UInt = 0xFFFFFFFFFFFFFFFF;
    println(hex);
    let oct = 0o777;
    println(oct);
    let bin = 0b11111;
    println(bin);
    let sep = 1_000;
    println(sep);
    let f = 1_0.5;
    println(f);
    println("literal_prefixed_u64_ok");
};
