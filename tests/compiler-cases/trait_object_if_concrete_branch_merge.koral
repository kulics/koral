// EXPECT: 10

trait CounterOps {
    peek(self) Int;
};

type mutable Counter(mutable value Int);

given Counter as CounterOps {

    public peek(self) Int = self.value;
};

let choose(flag Bool, strong Counter, obj CounterOps) CounterOps =
    if flag then strong else obj;

let main() Int = {
    let strong Counter = Counter(10);
    let obj CounterOps = strong;
    let chosen = choose(true, strong, obj);
    println(chosen.peek().to_string());
    return 0;
};