// EXPECT: 10

trait CounterOps {
    peek(*self) Int
}

type Counter(mutable value Int)

given Counter as CounterOps {

    public peek(*self) Int = self.value
}

let choose(flag Bool, strong *mutable Counter, obj * CounterOps) * CounterOps =
    if flag then strong else obj

let main() Int = {
    let strong *mutable Counter = box(Counter(10))
    let obj * CounterOps = strong
    let chosen = choose(true, strong, obj)
    println(chosen.peek().to_string())
    return 0
}