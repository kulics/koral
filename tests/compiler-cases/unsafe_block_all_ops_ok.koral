// EXPECT: 7
// EXPECT: 3
// EXPECT: 11
// EXPECT: done
// One unsafe region per safety rationale: deref, unchecked subscript, member
// projection and pointer arithmetic all run inside `unsafe { … }`, and the
// values they produce flow freely afterwards (R4 -- danger lives in the
// operations, not the values).

type Proj(a: Int, b: Int);

let unsafe deref(p: *Int): Int = unsafe { *p };

let main(): Int = {
    let x = 7;
    let p: *Int = &x;
    let d = unsafe { deref(p) };
    println(d.to_string());
    let arr: [3]Int = [1, 2, 3];
    let q: *Int = &arr[0];
    let last = unsafe { q[2] };
    println(last.to_string());
    let pair = Proj(10, 20);
    let pp: *Proj = &pair;
    let first = unsafe { pp.a };
    println((first + 1).to_string());
    let r = unsafe { p + 5 };
    let _ = r;
    println("done");
    return 0;
};
