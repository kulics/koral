// EXPECT: 9

trait CounterOps {
    peek(*self) Int
}

type Counter(value Int)

given Counter as CounterOps {

    public peek(*self) Int = self.value
}

let main() Int = {
    let strong *mut Counter = box(Counter(9))
    let readonly * Counter = strong
    let obj * CounterOps = readonly
    println(obj.peek().to_string())
    return 0
}