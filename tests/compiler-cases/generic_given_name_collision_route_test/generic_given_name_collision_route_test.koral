// EXPECT: 7
// A generic `given` whose target TYPE shares its name with a trait elsewhere in
// the compilation (alpha's `Collide`, never imported here) is a TYPE-entity
// given: `Self` is the struct and `self.x` reads its field. Routing the target
// through the bare name index -- last-wins across modules -- made the compiler
// see a TRAIT target and check the body against a generic `Self` instead,
// rejecting a valid body.

type Collide[T: Any](x: T);

given[T: Any] Collide[T] {
    public get(self): T = self.x;
};

let main(): Int = {
    println(Collide[Int](7).get().to_string());
    return 0;
};
