// EXPECT: nested interpolation ok

let choose(value String, fallback String) String = {
    return if value.is_empty() then fallback else value;
};

let main() Int = {
    let value = "ok";
    let rendered = "\(choose(value, ".")) interpolation";
    if rendered <> "ok interpolation" then {
        return 1;
    };
    println("nested interpolation ok");
    return 0;
};
