// EXPECT-ERROR: Only one rest pattern is allowed per element list
// Design guard: `...` swallows everything not written at that point. A second
// one in the same list has nothing left to say, so the split would be
// ambiguous -- `[a, ..., b, ...]` does not say where the middle goes.
using "std" { ... };

let main() Int = {
    let xs List[Int] = [1];
    let s = when xs in {
        [a, ..., b, ...] then 1,
        _ then 2,
    };
    println(s);
    return 0;
};
