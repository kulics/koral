// EXPECT-ERROR: Or pattern branches must bind the same variables
// Design guard: `x is A or is B` is `x is (A or B)` -- one pattern -- so it
// inherits the `or` rule that both sides bind the same names. The body cannot
// know which side matched, so a name one side does not provide is not
// available afterwards. Here `{a, b}` against `{c, d}`.
using "std";

type Point(x Int, y Int);

let main() Int = {
    let p = Point(1, 2);
    if p is Point(a, b) or is Point(c, d) then {
        println(a);
    };
    return 0;
};
