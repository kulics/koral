// Global bindings of user-defined types carry their annotations; the
// constructors and enum cases initialize them in declaration order.

type sendable Point(x: Int, y: Int);
type sendable Color {
    Red(),
    Green(),
    Blue(),
};
type sendable Wrapper(value: Int);

private let origin: Point = Point(0, 0);
private let red: Color = Color.Red();
private let wrapped: Wrapper = Wrapper(42);
private let mutable cursor: Point = Point(10, 20);

public let main(): Void = {
    println(origin.x);
    println(origin.y);
    println(wrapped.value);
    println(cursor.x);
    cursor = Point(30, 40);
    println(cursor.x);
    println(cursor.y);
};
// EXPECT: 0
// EXPECT: 0
// EXPECT: 42
// EXPECT: 10
// EXPECT: 30
// EXPECT: 40
