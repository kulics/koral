// EXPECT-ERROR: Expression statement has no effect
// EXPECT-ERROR: Single-branch 'if' must have Void or Never type in then branch, got 'Int'
// A bare then-branch of a single-branch `if` is a statement body in the
// reference compiler: the branch is effect-checked like any expression
// statement, and the single-branch type rule reports on top of that. (The
// block form -- `if x then { 42 }` -- gets only the type line.)

let main(): Int = {
    let y = if true then 1;
    return 0;
};
