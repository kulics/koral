// EXPECT-ERROR: Type mismatch: expected Box, got Int
// `Type.method(args)` puts the receiver in the first explicit argument, so the
// first argument is checked against the receiver's own type: `Box.get(3)` asks
// `3` to be a `Box`, and that is a type error.

type Box(v Int);
given Box { get(self) Int = self.v; };

let main() Int = {
    let x Int = Box.get(3);
    println("x=\(x)");
    return 0;
};
