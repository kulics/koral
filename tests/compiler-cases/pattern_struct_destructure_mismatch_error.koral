// EXPECT-ERROR: Type mismatch: expected Rect, got Point
// The dot-form on a struct subject is a destructure claim: the name says the
// subject IS that type, and a claim on the wrong subject is refused with the
// claim's own words, at the pattern.

type Point(x: Int, y: Int);
type Rect(w: Int, h: Int);

let f(p: Point): Int = when p in {
    .Rect(a, b) then a,
    .Point(x, y) then x,
};
