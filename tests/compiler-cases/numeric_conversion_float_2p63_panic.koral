// EXPECT-ERROR: Panic: numeric conversion overflow at
// 2^63 must panic for Int. `(double)INT64_MAX` rounds UP to exactly 2^63, so
// a `<= (double)MAX` guard would wave this value through into an undefined
// cast; the emitted bound is the half-open `v < 2^63` instead.

let main(): Void = {
    let x = Int(9223372036854775808.0);
    println(x);
};
