// EXPECT-ERROR: Type Foo does not explicitly implement trait Eq (operator 'equals')
// EXPECT-ERROR: Member 'equals' not found in type 'Foo'
// The seed records the missing conformance and KEEPS GOING: the method lookup
// that follows is what decides whether the call can be built, and a receiver
// with no `equals` to call adds its own `Member ... not found` line on the
// same span.

type Foo(x Int);

let main() Int = {
    let a = Foo(1);
    let b = Foo(2);
    let _ = a == b;
    return 0;
};
