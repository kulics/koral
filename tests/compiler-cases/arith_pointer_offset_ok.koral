// EXPECT: 10
// EXPECT: 20
// EXPECT: 10
// Legal pointer arithmetic is exactly the pair `p + offset` / `p - offset`.

let main(): Int = {
    let p = alloc_memory[Int](2);
    init_memory(p, 10);
    init_memory(p + 1, 20);
    println(*p);
    println(*(p + 1));
    let q = p + 1;
    println(*(q - 1));
    dealloc_memory(p);
    return 0;
};
