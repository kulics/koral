// EXPECT: PASS

// Global `let` bindings initialize in declaration order, so a later binding
// can read an earlier one and see its final value.

let a = 1;
let b = a + 1;
let c = a + b;

private let mutable running = c;

let main(): Int = {
    if a != 1 then {
        eprintln("FAIL: a == \(a), want 1");
        return 1;
    };
    if b != 2 then {
        eprintln("FAIL: b == \(b), want 2");
        return 1;
    };
    if c != 3 then {
        eprintln("FAIL: c == \(c), want 3");
        return 1;
    };
    if running != 3 then {
        eprintln("FAIL: running == \(running), want 3");
        return 1;
    };
    running = running + 1;
    if running != 4 then {
        eprintln("FAIL: running == \(running), want 4");
        return 1;
    };
    println("PASS");
    return 0;
};
