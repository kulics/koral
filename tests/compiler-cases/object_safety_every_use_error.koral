// EXPECT-ERROR: is not object-safe
// EXPECT-ERROR: is not object-safe
// EXPECT-ERROR: Undefined variable: not_a_binding
// Design guard: "this trait cannot be a trait object" is a fact about each
// place one is written. There are two of them below, and the reader has to
// look at both -- fixing one leaves the other. Saying it once hides a real
// use; saying it and then stopping hides the rest of the file.
//
// The last expectation is the one that catches the abort: an implementation
// that reports the first object-safety complaint and then walks away never
// reaches the undefined name at the bottom.

trait NotSafe {
    make(self) Self;
};

type Impl(v Int);

given Impl as NotSafe {
    make(self) Self = self;
};

let main() Int = {
    let i = Impl(1);
    let first NotSafe = i;
    let second NotSafe = i;
    let broken = not_a_binding;
    return 0;
};
