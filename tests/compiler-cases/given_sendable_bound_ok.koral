// EXPECT: 1
// EXPECT: 2
// The strict spelling of a generic impl of a `trait sendable`: the `sendable`
// bound proves every admitted instantiation at the declaration, so the
// always-sendable trait object is sound by construction -- both the direct
// box and the generic relay (`P: Ping` forwards sendability) run clean
// (concurrency-design.md §trait sendability).

trait sendable Ping {
    ping(self): Int;
};

type sendable Box[T: Any](value: T);

given[T: sendable] Box[T]: Ping {
    ping(self): Int = 1;
};

let relay[P: Ping](p: P): Int = {
    let obj: Ping = p;
    return obj.ping() + 1;
};

let main(): Void = {
    let boxed = Box[Int](1);
    let obj: Ping = boxed;
    println(obj.ping());
    println(relay(boxed));
};
