// EXPECT-ERROR: Import of 'Default' from 'collide_prelude_error/mod_a' collides with a name already in scope; rename it with 'as'
//
// §3.3 collision matrix, cell 3: the prelude is a real import -- one the
// language writes for you -- so it OWNS its names exactly like a written
// `using` does. Taking `Default` for a different declaration loses the reader
// a name they never wrote, and is refused the same way. Single error: nothing
// else is ambiguous.
using "std" { ... };
using "collide_prelude_error/mod_a" { Default };

let main(): Int = {
    return 0;
};
