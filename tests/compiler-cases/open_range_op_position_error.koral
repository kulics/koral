// EXPECT-ERROR: '...<' opens a range with no left bound; write '...<b'

// `...<` starts a range (its right bound is exclusive); it never follows a
// left bound. The right-open form with a left bound is `1..<5`, and the
// left-open form is `1<...`.

let main() Int = {
    let x = 1...<5;
    if x.contains(0) then {
        return 1;
    };
    return 0;
};
