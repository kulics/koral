// EXPECT-ERROR: Unexpected token
// Design guard: `*` is not part of a pattern. A type test is spelled `T` /
// `name T` (`guide/grammar.bnf` <concrete-type-pattern>); the `*T` marker of
// the managed-reference era is gone from the grammar and must not parse.

type Box(v Int);

let main() Int = {
    let b = Box(1);
    let hit = b is *Box;
    let _ = hit;
    return 0;
};
