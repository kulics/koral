// EXPECT: overlap_rule_ok
// 重叠规则只管 (基础类型, trait) 对：同一基础类型对**不同** trait 仍可
// 各给各的，不同基础类型对同一 trait 也互不相干。

type Box[T: Any](v: T);
type Bag[T: Any](v: T);

trait Name {
    name(self): Int;
};
trait Age {
    age(self): Int;
};

given Box[Int]: Name {
    name(self): Int = 1;
};
given Box[String]: Age {
    age(self): Int = 2;
};
given Bag[Int]: Name {
    name(self): Int = 3;
};

let main(): Int = {
    let n = Box[Int](10);
    let a = Box[String]("x");
    let b = Bag[Int](30);
    assert(n.name() == 1, "box name");
    assert(a.age() == 2, "box age");
    assert(b.name() == 3, "bag name");
    println("overlap_rule_ok");
    return 0;
};
