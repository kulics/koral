// EXPECT: mutable forward ok

// A parameter declared `T mutable` does forward into another `T mutable`
// requirement -- the bound is carried, not re-checked against a concrete type.

type mutable Counter(mutable value Int, id UInt);

let needs_mutable[T mutable](x T) Int = {
    return 1;
};

let forward[T mutable](x T) Int = {
    return needs_mutable(x);
};

let main() Int = {
    println("mutable forward ok");
    return forward(Counter(0, 1)) - 1;
};
