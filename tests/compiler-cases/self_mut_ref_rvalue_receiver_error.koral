// EXPECT-ERROR: Cannot call '*mutable self' method 'increment' on an rvalue; store the value in a 'let mutable' variable first

type Counter(mutable value Int)

given Counter {

    increment(*mutable self) Void = {
        self.value = self.value + 1
    }
}

let main() Int = {
    Counter(1).increment()
    return 0
}