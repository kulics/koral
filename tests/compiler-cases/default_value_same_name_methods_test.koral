// EXPECT: 10
// EXPECT: hi

// Two same-name methods on different types can have different parameter
// defaults without overwriting each other.

type A(x Int);
type B(x String);

given A {
    public get(self, prefix: Int = 1) Int = self.x * prefix;
};

given B {
    public get(self, prefix: Int = 2) String = self.x;
};

let main() Int = {
    let a = A(10);
    let b = B("hi");
    println(a.get().to_string());
    println(b.get());
    return 0;
};
