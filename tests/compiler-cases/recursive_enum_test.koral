// Test case for recursive enum with generic type
// EXPECT: Test passed!

public type Expr {
    Number(value Int),
    BinaryOp(left * Expr, right * Expr),
    FunctionCall(name String, args List[* Expr]),
}

public let parse() Result[* Expr] = {
    let expr = box(Expr.Number(42))
    return Result[* Expr].Ok(expr)
}

public let main() Void = {
    when parse() in {
        .Ok(expr) then println("Test passed!"),
        .Error(msg) then println(msg.message()),
    }
}
