// EXPECT: PASS

let main() Int = {
    let strong *Int = box(42)
    let weak ?*Int = downgrade(strong)
    when upgrade(weak) in {
        .Some(value) then {
            if *value <> 42 then {
                eprintln("FAIL: expected 42, got \(*value)")
                return 1
            }
        },
        .None then {
            eprintln("FAIL: upgrade returned None")
            return 1
        },
    }
    println("PASS")
    return 0
}