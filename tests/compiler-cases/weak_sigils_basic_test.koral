// EXPECT: PASS
type mutable Box(mutable value Int);

let main() Int = {
    let b = Box(42);
    let weak ?Box = b as ?Box;
    let r = when ?weak in {
        .Some(v) then v.value,
        .None() then -1,
    };
    if r != 42 then {
        eprintln("FAIL: expected 42, got \(r)");
        return 1;
    };
    println("PASS");
    return 0;
};
