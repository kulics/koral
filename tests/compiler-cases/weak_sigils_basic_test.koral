// EXPECT: PASS
type mutable Box(mutable value Int);

let main() Int = {
    let b = Box(42);
    let weak ?Box = downgrade(b);
    when upgrade(weak) in {
        .Some(r) then {
            if r.value <> 42 then {
                eprintln("FAIL: expected 42, got \(r.value)");
                return 1;
            };
        },
        .None() then {
            eprintln("FAIL: upgrade returned None");
            return 1;
        },
    };
    println("PASS");
    return 0;
};