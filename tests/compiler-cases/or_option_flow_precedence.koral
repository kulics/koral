// EXPECT: or_else_over_or: 1
// EXPECT: or_return_over_or: 7

let choose_with_or_else(left Bool, right Option[Int]) Int = {
    let ok = left or right and then it == 1 or else false;
    return if ok then 1 else 0;
};

let choose_with_or_return(left Bool, right Option[Int]) Option[Int] = {
    let ok = left or right and then it == 1 or return;
    return if ok then .Some(7) else .Some(0);
};

let main() Int = {
    println("or_else_over_or: " + choose_with_or_else(false, Option[Int].Some(1)).to_string());
    when choose_with_or_return(false, Option[Int].Some(1)) in {
        .Some(v) then println("or_return_over_or: " + v.to_string()),
        .None() then println("or_return_over_or: none"),
    };
    return 0;
};