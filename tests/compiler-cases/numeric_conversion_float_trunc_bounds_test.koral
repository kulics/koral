// EXPECT: PASS
// A float converts to an integer by truncating toward zero FIRST, then the
// integer value is range-checked (numeric-families design §浮点: 先向零截断
// 得整数值，再按目标家族执行范围策略). The fractional edge values below are
// in range AFTER truncation and must convert, not panic.

let main(): Int = {
    let a: Int8 = Int8(-128.5);
    if a != -128 then {
        eprintln("FAIL: Int8(-128.5), got \(a)");
        return 1;
    };

    let b: Int8 = Int8(127.9);
    if b != 127 then {
        eprintln("FAIL: Int8(127.9), got \(b)");
        return 1;
    };

    let c: UInt8 = UInt8(-0.5);
    if c != 0 then {
        eprintln("FAIL: UInt8(-0.5), got \(c)");
        return 1;
    };

    let d: UInt8 = UInt8(255.9);
    if d != 255 then {
        eprintln("FAIL: UInt8(255.9), got \(d)");
        return 1;
    };

    let e: Int16 = Int16(-32768.5);
    if e != -32768 then {
        eprintln("FAIL: Int16(-32768.5), got \(e)");
        return 1;
    };

    let f = Int(-0.9);
    if f != 0 then {
        eprintln("FAIL: Int(-0.9), got \(f)");
        return 1;
    };

    println("PASS");
    return 0;
};
