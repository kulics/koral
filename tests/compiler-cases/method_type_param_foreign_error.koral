// EXPECT-ERROR: Type 'Vec' does not satisfy the 'foreign' constraint (checking constraint T: foreign). Only built-in scalars, raw pointers and 'foreign type' declarations cross the FFI boundary.

// The `foreign` shape bound is enforced on method type parameters too: a
// Koral `type` is not foreign, so `get[T foreign]` must reject it.

type Vec(x Int, y Int);
type Holder(data Int);

given Holder {
    public get[T foreign](self, x T) Int = {
        return 1;
    };
};

let main() Int = {
    let v = Vec(1, 2);
    let e = Holder(1).get(v);
    return 0;
};
