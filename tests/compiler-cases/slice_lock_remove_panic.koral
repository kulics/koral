// EXPECT-ERROR: Panic: List modified during iteration or borrow: remove_at
// 修改锁（slice-design §修改锁）：借出闭包全程持锁，`remove_at` 入口查锁命中
// panic（锚点=肇事修改调用点）。
let main(): Void = {
    let xs = List[UInt8].new();
    xs.push(1);
    xs.push(2);
    xs.borrow_slice((s) => {
        let _ = s.count();
        xs.remove_at(0);
    });
};
