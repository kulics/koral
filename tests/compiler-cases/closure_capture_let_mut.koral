// EXPECT-ERROR: Cannot capture mutable variable 'counter'

// Closure capture is copy-only: a `let mutable` local cannot be captured,
// because the closure would not own the storage. Use a `Cell` instead.

let main() Int = {
    let mutable counter = 0;
    let increment = () -> {
        counter = counter + 1;
    };
    increment();
    return 0;
};
