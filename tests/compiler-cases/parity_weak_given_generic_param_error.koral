// EXPECT-ERROR: '?T' requires a 'type mutable' referent, but 'T' is not declared as 'type mutable'
// A weak given self -- `given[T Any] ?T as LocalTrait` -- must satisfy the same
// referent gate every other `?T` spelling passes: the referent has to be
// 'type mutable', and the generic parameter's own bound is what says so. `T Any`
// does not, so the given is rejected with the referent objection alone.

trait LocalTrait {
    peek(self): Int;
};

given[T: Any] ?T: LocalTrait {
    peek(self): Int = 1;
};

let main(): Int = {
    return 0;
};
