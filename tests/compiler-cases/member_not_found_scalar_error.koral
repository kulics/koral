// Scalar receivers take the same branch and get the same diagnostic.
//
// Swift used to report a malformed `Invalid operation member access between
// types Int and ` here (see member_not_found_generic_struct_error for why
// the sentence ends mid-clause); it now reports the same member-not-found
// text as for a struct.

// EXPECT-ERROR: Member 'nope' not found in type 'Int'

let main() Void = {
    let n = 5;
    n.nope();
    println("unreachable");
};
