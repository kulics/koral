// EXPECT: 6
// EXPECT: 12

// Design guard: a user-declared type named `T` must not hijack the type
// parameter `T` inside std's `[T ...]` templates.
//
// A type parameter is a lexical binder: inside `fn for_each(self, fn Func(T)
// Void)` the `T` names the parameter being declared, never a module-level type
// of the same spelling. Template TypeNodes have to be resolved with the
// template's own parameter set in scope, otherwise an unbound bare name falls
// through to a global and the two types print identically (`expected T, got T`).

type T(v Int);

let main() Int = {
    let xs List[Int] = [1, 2, 3];
    let mutable total = 0;
    for x in xs then {
        total = total + x;
    };
    println(total.to_string());

    let doubled = xs.iterator().map((x) -> x * 2).into_list();
    let sum = doubled.iterator().fold(0, (acc, x) -> acc + x);
    println(sum.to_string());
    return 0;
};
