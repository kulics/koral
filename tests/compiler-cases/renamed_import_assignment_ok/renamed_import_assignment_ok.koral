// EXPECT: 5
// A renamed import binding keeps the declaration's mutability. `counter as ctr`
// makes `ctr` a write path to the same `let mutable` global the declaration
// owns. The write path used to re-resolve mutability through the name index
// only, find nothing (an alias lives in the import graph), and refuse the
// assignment as immutable while the read ran fine.

using "renamed_import_assignment_ok/mod" { counter as ctr };

let main(): Void = {
    ctr = 5;
    println(ctr.to_string());
};
