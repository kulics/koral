// EXPECT-ERROR: Type mismatch: expected ref mut

type Box[T Any](mut value T, mut touches Int)

given[T Any] Box[T] {
    public bump_and_keep(self ref mut Self) ref mut Self = {
        self.touches = self.touches + 1
        return self
    }
}

let main() Int = {
    let mut box = Box[Int](0, 0)
    let _ = box.bump_and_keep()
    return 0
}