// EXPECT: result_ops_ok
// Result 核心组：map_error（包装上下文）、ok()/error() 转 Option、
// unwrap_or_else（按错误算缺省）。and then / or else 是语言算子，不重复。

let main(): Int = {
    let ok = Result[Int].Ok(7);
    let bad = Result[Int].Error("boom");

    // map_error：Ok 原样，Error 被映射。
    let wrapped = bad.map_error((e: Error) => Error(WrappedError.new("ctx", e)));
    assert(wrapped.is_error(), "map_error keeps error");
    assert(wrapped.unwrap_error().message() == "ctx", "map_error wraps");
    assert(ok.map_error((e: Error) => e).unwrap() == 7, "map_error keeps ok");

    // ok() / error() 转 Option。
    assert(ok.ok() == Option[Int].Some(7), "ok to option");
    assert(ok.error().is_none(), "ok has no error");
    assert(bad.ok().is_none(), "error has no ok");
    assert(bad.error().is_some(), "error to option");

    // unwrap_or_else：按错误算缺省。
    assert(ok.unwrap_or_else((e: Error) => 0 - 1) == 7, "unwrap_or_else ok");
    assert(bad.unwrap_or_else((e: Error) => e.message().count()) == 4, "unwrap_or_else error");

    println("result_ops_ok");
    return 0;
};
