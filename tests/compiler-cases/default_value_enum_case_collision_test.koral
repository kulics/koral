// EXPECT: 1
// EXPECT: 2

// Two enums whose cases share a name AND a payload name keep their own
// declared defaults: each construction fills from its own case's field.

type Alpha {
    Wrap(value: Int = 1),
};

type Beta {
    Wrap(value: Int = 2),
};

let main() Int = {
    let a = Alpha.Wrap();
    when a in {
        .Wrap(value: v) then println(v),
    };
    let b = Beta.Wrap();
    when b in {
        .Wrap(value: v) then println(v),
    };
    return 0;
};
