// EXPECT-ERROR: Panic: integer overflow in multiplication
// 2^8 = 256 does not fit Int8, so the checked multiply panics: the guard from
// math_pow_guard only removes the *unused* square, never a needed one.

using "std/math" { ... };

let main(): Int = {
    let _ = Int8(2).pow(8);
    return 0;
};
