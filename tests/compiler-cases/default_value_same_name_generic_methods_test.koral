// EXPECT: box=1 bag=2

// Two generic types whose methods share a name AND a parameter name keep
// their own declared defaults: the default lives on the parameter's own
// declaration, so a call through one instantiation cannot pick up the
// other declaration's value.

type Box[T Any](v T);
type Bag[T Any](v T);

given[T Any] Box[T] {
    get(self, a: Int = 1) Int = a;
};

given[T Any] Bag[T] {
    get(self, a: Int = 2) Int = a;
};

let main() Int = {
    let b = Box[Int](0);
    let g = Bag[String]("");
    println("box=\(b.get()) bag=\(g.get())");
    return 0;
};
