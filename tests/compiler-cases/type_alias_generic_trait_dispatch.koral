// EXPECT: alias generic trait dispatch ok

type IntList = List[Int];

let same_lists(a IntList, b List[Int]) Bool = a == b;
let render_list(a IntList) String = a.to_string();
let hash_list(a IntList) UInt = a.hash();

let main() Int = {
    let mutable a IntList = IntList.new();
    let mutable b = List[Int].new();
    a.push(1);
    b.push(1);

    assert(same_lists(a, b), "alias generic Eq dispatch should match direct generic receiver");
    assert(render_list(a) == "[1]", "alias generic ToString dispatch should match direct generic receiver");
    assert(hash_list(a) == b.hash(), "alias generic Hash dispatch should match direct generic receiver");

    println("alias generic trait dispatch ok");
    return 0;
};