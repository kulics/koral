// EXPECT-ERROR: Undefined variable: spawn_thread

// The raw thread-spawn primitive is `protected`: visible inside the std
// package (Thread/Task/run_task build on it) but not to user code. Invisible
// is undeclared (§3.3) -- the call resolves exactly as if no such symbol
// existed. User-facing thread creation goes through `Thread`, `Task`, or
// `run_task`.

let main(): Void = {
    spawn_thread();
};
