// EXPECT: builder_run_output_ok
// EXPECT: builder_env_ok
// EXPECT: builder_cwd_ok
// EXPECT: builder_run_ok

using "std/os" { ... };
using "std/proc" { ... };

let main(): Void = {
    // ========================================================================
    // Command.new + arg + run_output
    // ========================================================================
    let result = Command.new("echo").arg("builder_test").run_output();
    when result in {
        .Ok(output) then {
            assert(output.is_success(), "builder run_output success");
            assert(output.stdout.contains("builder_test"), "builder run_output stdout");
        },
        .Error(e) then {
            println("builder_run_output_FAIL: \(e.message())");
            panic("builder run_output spawn failed");
        },
    };
    println("builder_run_output_ok");

    // ========================================================================
    // Command with environment variable
    // ========================================================================
    // Use "sh -c 'echo $VAR'" to check env var
    let env_result = Command.new("sh").arg("-c").arg("echo $KORAL_TEST_VAR").set_env(
        "KORAL_TEST_VAR",
        "hello_env",
    ).run_output();
    when env_result in {
        .Ok(output) then {
            assert(output.is_success(), "builder env success");
            assert(output.stdout.contains("hello_env"), "builder env stdout");
        },
        .Error(e) then {
            println("builder_env_FAIL: \(e.message())");
            panic("builder env spawn failed");
        },
    };
    println("builder_env_ok");

    // ========================================================================
    // Command with working directory
    // ========================================================================
    // The directory is one this process creates, not a POSIX constant: `/tmp`
    // is not a Windows path, and the marker in the name survives both the
    // native and the msys spelling of the path.
    let cwd_dir = create_temp_dir("".into_path(), prefix = "cmd_cwd_marker_").unwrap();
    let cwd_result = Command.new("pwd").set_current_dir(cwd_dir).run_output();
    when cwd_result in {
        .Ok(output) then {
            assert(output.is_success(), "builder cwd success");
            assert(output.stdout.contains("cmd_cwd_marker"), "builder cwd stdout");
        },
        .Error(e) then {
            println("builder_cwd_FAIL: \(e.message())");
            panic("builder cwd spawn failed");
        },
    };
    println("builder_cwd_ok");

    // ========================================================================
    // Command.run — returns only ExitStatus
    // ========================================================================
    let run_result = Command.new("echo").arg("run_only").run();
    when run_result in {
        .Ok(status) then {
            assert(status.is_success(), "builder run success");
        },
        .Error(e) then {
            println("builder_run_FAIL: \(e.message())");
            panic("builder run spawn failed");
        },
    };
    println("builder_run_ok");
};
