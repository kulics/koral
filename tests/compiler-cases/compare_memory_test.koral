// compare_memory: bulk unsigned-byte comparison, the read-side counterpart
// of copy_memory / move_memory. The count is in elements; the order is
// unsigned byte order.
// EXPECT: eq 0
// EXPECT: lt -1
// EXPECT: gt 1
// EXPECT: unsigned 1
// EXPECT: elems -1
// EXPECT: compare_memory tests passed

let sign(x: Int): Int = if x < 0 then 0 - 1
else if x > 0 then 1
else 0;

let main(): Int = {
    let a: List[UInt8] = [1, 2, 3];
    let b: List[UInt8] = [1, 2, 3];
    let c: List[UInt8] = [1, 2, 4];
    println("eq \(sign(compare_memory(a.borrow_ptr(), b.borrow_ptr(), UInt(3))))");
    println("lt \(sign(compare_memory(a.borrow_ptr(), c.borrow_ptr(), UInt(3))))");
    println("gt \(sign(compare_memory(c.borrow_ptr(), a.borrow_ptr(), UInt(3))))");

    // Unsigned byte order: 255 sorts ABOVE 1.
    let hi: List[UInt8] = [255];
    let lo: List[UInt8] = [1];
    println("unsigned \(sign(compare_memory(hi.borrow_ptr(), lo.borrow_ptr(), UInt(1))))");

    // Element-count semantics: two Int64 elements compare 16 bytes.
    let x: List[Int64] = [Int64(1), Int64(2)];
    let y: List[Int64] = [Int64(1), Int64(3)];
    println("elems \(sign(compare_memory(x.borrow_ptr(), y.borrow_ptr(), UInt(2))))");

    println("compare_memory tests passed");
    return 0;
};
