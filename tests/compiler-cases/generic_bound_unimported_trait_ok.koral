// EXPECT: ok
// The flip side of the old `generic_bound_unimported_trait_error`: a bound's
// identity travels on the DECLARATION resolved where the generic was written,
// and a use site checks satisfaction against that identity in the conformance
// registry. `Set` comes in below and `Int` conforms to `Hash`, but the trait
// itself is never imported here -- and never needs to be: the caller names no
// trait, so demanding its spelling would reject a program for a name it does
// not use.

using "std" { Set, Int };

public let main(): Int = {
    let s = Set[Int].new();
    let _ = s;
    println("ok");
    return 0;
};
