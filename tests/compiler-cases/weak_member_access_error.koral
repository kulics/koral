// EXPECT-ERROR: Member 'value' not found in type '?Box'
// A weak reference is a HANDLE: opaque until `upgrade`d, with no fields of the
// referent. Binding the handle whole is fine; reaching through it is not.

type mutable Box(mutable value Int);

let main() Int = {
    let b = Box(42);
    let w = downgrade(b);
    println("\(w.value)");
    return 0;
};
