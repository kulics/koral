// EXPECT: and_then above or_else: 10
// EXPECT: mixed right grouping: 99

let print_option(label String, opt Option[Int]) Void = {
    print(label)
    when opt in {
        .Some(v) then println(v.to_string()),
        .None then println("None"),
    }
}

let main() Int = {
    // Confirm documented precedence:
    // `and then` binds tighter than `or else`.
    let opt_none = Option[Int].None()
    let r1 = opt_none and then it * 2 or else 10
    print("and_then above or_else: ")
    println(r1)

    // Right grouping when mixing `and then` with `or else`.
    let opt_some = Option[Int].Some(33)
    let r2 = opt_some and then it * 3 or else 0
    print("mixed right grouping: ")
    println(r2)

    return 0
}
