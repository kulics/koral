// The rest slot in a list pattern turns the exact length into a lower bound.
// `...` swallows zero or more elements, so `[a, ...]` is "at least one" and
// `[...]` is "any length".
// EXPECT: list_rest_prefix_ok
// EXPECT: list_rest_suffix_ok
// EXPECT: list_rest_middle_ok
// EXPECT: list_rest_bare_ok

using "std" { ... };

let main() Int = {
    let xs List[Int] = [7, 8, 9, 10];

    // Prefix: at least one element, the first one bound.
    let head = when xs in {
        [] then 0,
        [a, ...] then a,
    };
    if head == 7 then {
        println("list_rest_prefix_ok");
    };

    // Suffix: at least one element, the last one bound.
    let tail = when xs in {
        [] then 0,
        [..., z] then z,
    };
    if tail == 10 then {
        println("list_rest_suffix_ok");
    };

    // Middle: at least two elements, first and last bound.
    let ends = when xs in {
        [a, ..., z] then a + z,
        _ then 0,
    };
    if ends == 17 then {
        println("list_rest_middle_ok");
    };

    // The bare rest marker matches every list -- it is the catchall shape.
    let any_len = when xs in {
        [...] then "any",
    };
    if any_len == "any" then {
        println("list_rest_bare_ok");
    };

    return 0;
};
