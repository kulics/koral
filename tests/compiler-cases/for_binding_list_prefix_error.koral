// EXPECT-ERROR: For binding cannot fail; use 'when' to match
// Design guard: `[x, ...]` misses the empty list, so a loop binding cannot
// use it -- the element might be `[]` and the loop has no way to skip it.

using "std" { ... };

let main() Int = {
    let xs = List[List[Int]].new();
    for [x, ...] in xs then {
        println(x);
    };
    return 0;
};
