// Built-in subscript is member-access (place) semantics: the element slot is
// read and written in place, with no element copy in and out.
// EXPECT: list_rw:
// EXPECT: 15
// EXPECT: nested_field:
// EXPECT: 77
// EXPECT: nested_subscript:
// EXPECT: 42
// EXPECT: deque_rw:
// EXPECT: 5
// EXPECT: dict_rw:
// EXPECT: 10
// EXPECT: borrow_read:
// EXPECT: 2
// EXPECT: mutable_borrow:
// EXPECT: 8

type mutable Rec(mutable v: Int);

let main(): Int = {
    let mutable xs = List[Int].new();
    xs.push(1);
    xs.push(2);
    xs[0] = 10;
    xs[0] += 5;
    println("list_rw:");
    println(xs[0]);

    let mutable recs = List[Rec].new();
    recs.push(Rec(1));
    recs[0].v = 77;
    println("nested_field:");
    println(recs[0].v);

    let mutable grid = List[List[Int]].new();
    let mutable row = List[Int].new();
    row.push(0);
    grid.push(row);
    grid[0][0] = 42;
    println("nested_subscript:");
    println(grid[0][0]);

    let mutable dq = Deque[Int].new();
    dq.push_back(1);
    dq[0] += 4;
    println("deque_rw:");
    println(dq[0]);

    let mutable d = Dict[String, Int].new();
    d.insert("a", 1);
    d["a"] = 9;
    d["a"] += 1;
    println("dict_rw:");
    println(d["a"]);

    let r = &xs[1];
    println("borrow_read:");
    println(*r);

    let rp = &mutable xs[1];
    *rp = 8;
    println("mutable_borrow:");
    println(xs[1]);
    return 0;
};
