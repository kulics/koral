// EXPECT: 7
// EXPECT: 7
// A parenthesized type head in expression position names the same target as
// the bare name: `(Point).origin()` is exactly `Point.origin()`.

type Point(x: Int, y: Int);

given Point {
    public origin(): Point = {
        return Point(7, 0);
    };
};

let main(): Int = {
    let a = (Point).origin();
    let b = Point.origin();
    println(a.x);
    println(b.x);
    return 0;
};
