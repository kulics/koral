// Test: global variable type inference
// Variables without explicit type annotations should infer from initializer

file_private let answer = 42
file_private let greeting = "hello"
file_private let flag = true
file_private let mutable counter = 0

file_private let compute() Int = {
    return answer + counter
}

public let main() Void = {
    println(greeting)
    println(answer)
    println(flag)
    counter = 10
    println(compute())
}
// EXPECT: hello
// EXPECT: 42
// EXPECT: true
// EXPECT: 52
