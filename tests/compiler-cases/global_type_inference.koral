// Test: global variable type inference
// Variables without explicit type annotations should infer from initializer

private let answer = 42
private let greeting = "hello"
private let flag = true
private let mutable counter = 0

private let compute() Int = {
    return answer + counter
}

public let main() Void = {
    println(greeting)
    println(answer)
    println(flag)
    counter = 10
    println(compute())
}
// EXPECT: hello
// EXPECT: 42
// EXPECT: true
// EXPECT: 52
