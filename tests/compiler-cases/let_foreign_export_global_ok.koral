// EXPECT: export global ok
// `let foreign mutable` + a value is a C variable DEFINITION with a static
// initializer (cffi-design.md §B): C reads and writes the very storage.

let foreign mutable counter: Int32 = 0;
let foreign "koral_flag" mutable flag: Int32 = 1;

let main(): Int = {
    assert(counter == Int32(0), "static initializer");
    counter = Int32(7);
    assert(counter == Int32(7), "C storage mutates in place");
    assert(flag == Int32(1), "aliased exported global");
    flag = Int32(2);
    assert(flag == Int32(2), "aliased storage mutates too");
    println("export global ok");
    return 0;
};
