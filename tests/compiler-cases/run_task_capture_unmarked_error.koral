// EXPECT-ERROR: sendable closure cannot capture non-sendable value 'state'
// The spawn boundary refuses a closure that captures unmarked state: run_task
// takes `sendable () -> Void`, and a sendable closure only takes sendable
// captures (concurrency-design.md §跨界检查 (a)).

using "std/async" { ... };

type mutable Unmarked(mutable n: Int);

let main(): Void = {
    let state = Unmarked(1);
    let t = run_task(() => {
        state.n = state.n + 1;
    });
    let _ = t.wait();
};
