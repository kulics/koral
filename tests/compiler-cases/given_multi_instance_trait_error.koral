// EXPECT-ERROR: Conflicting conformance: 'given Foo Bar' already declared
// The one-conformance-per-(self type, trait) rule is the trait rule, not an
// operator special case: `given Foo: Bar[Int]` and `given Foo: Bar[String]`
// are two instances of one trait on one type and conflict.

trait Bar[R: Any] {
    bar(self, other: R): Int;
};

type Foo(n: Int);

given Foo: Bar[Int] {
    bar(self, other: Int): Int = self.n + other;
};

given Foo: Bar[String] {
    bar(self, other: String): Int = self.n;
};

let main(): Int = {
    return 0;
};
