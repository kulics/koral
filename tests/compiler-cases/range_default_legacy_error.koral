// EXPECT-ERROR: open ranges are spelled with '...': write '...b', '...<b', or '...'

// A full-range default is `= ...`, like every other elided bound.

type Span(range: Range[Int] = ..);

let main() Int = {
    let s = Span();
    if s.range.contains(0) then {
        return 1;
    };
    return 0;
};
