// EXPECT-ERROR: Panic: JSON error: maximum nesting depth exceeded

// The pretty printer carries the same depth guard as the compact one: past the
// cap it reports the error instead of rendering a truncated document.

using "std/json" { ... };

let build_deep(n: Int): JsonValue = {
    let mutable v = JsonValue.Null();
    for _ in 0..<n then {
        let inner: List[JsonValue] = [v];
        v = JsonValue.Array(inner.to_frozen_list());
    };
    return v;
};

let main(): Void = {
    println(build_deep(3000).to_string_pretty());
};
