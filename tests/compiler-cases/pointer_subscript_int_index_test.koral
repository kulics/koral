// EXPECT: PASS
// A raw-pointer walk takes an `Int` index -- the same rule the collection
// subscript helpers enforce. Negative indices are raw C pointer arithmetic.

let main(): Int = {
    let p = alloc_memory[Int](1);
    init_memory(p, 5);
    let i = 0;
    if p[i] != 5 then {
        eprintln("FAIL: p[0], got \(p[i])");
        return 1;
    };
    println("PASS");
    deinit_memory(p);
    dealloc_memory(p);
    return 0;
};
