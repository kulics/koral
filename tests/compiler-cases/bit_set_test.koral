// EXPECT: basics true false 3 false
// EXPECT: removal true
// EXPECT: iteration 2 5 9
// EXPECT: algebra union 5 inter 2 diff 1 sym 3
// EXPECT: complement 97
// EXPECT: bounds false true
// EXPECT: done

// BitSet (concurrency-design.md §std落点, std/container/bit_set.koral): a
// fixed-universe bit-packed integer set. Reads outside the universe answer
// false; writes outside it are bounds errors; complement flips inside the
// universe only.

using "std/container" { ... };

let main(): Void = {
    let mutable b = BitSet.new(UInt(100));
    b.insert(UInt(2));
    b.insert(UInt(5));
    b.insert(UInt(5));
    b.insert(UInt(9));
    println("basics \(b.contains(UInt(5))) \(b.contains(UInt(6))) \(b.count()) \(b.is_empty())");

    println("removal \(b.try_remove(UInt(9)))");

    b.insert(UInt(9));
    let mutable acc = "";
    for v in b then {
        acc = acc + " \(v)";
    };
    println("iteration\(acc)");

    let a = BitSet.new(UInt(100));
    a.insert(UInt(2));
    a.insert(UInt(5));
    a.insert(UInt(7));
    a.insert(UInt(11));
    let union = b.union(a);
    let inter = b.intersection(a);
    let diff = b.difference(a);
    let sym = b.symmetric_difference(a);
    println("algebra union \(union.count()) inter \(inter.count()) diff \(diff.count()) sym \(sym.count())");

    let comp = b.complement();
    println("complement \(comp.count())");

    // Bounds discipline: reads answer false, contains never panics.
    println("bounds \(b.contains(UInt(500))) \(b.try_insert(UInt(3)))");
    println("done");
};
