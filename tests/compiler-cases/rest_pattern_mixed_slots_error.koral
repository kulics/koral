// EXPECT-ERROR: Rest pattern must be the only slot in a struct, enum or tuple pattern; use '_' for the other fields
// Design guard: the fixed-arity rest slot is whole-list elision, not arity
// sugar. Slots around it -- `Point(x, ..., y)` -- are how the old front/back
// fill was written, and that is gone: the fields to ignore are written `_`.
using "std" { ... };

type Point(x Int, y Int, z Int);

let main() Int = {
    let p = Point(1, 2, 3);
    let s = when p in {
        Point(x, ..., y) then x + y,
    };
    println(s);
    return 0;
};
