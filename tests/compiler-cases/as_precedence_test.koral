// EXPECT: 5
// EXPECT: 5
// EXPECT: true
// EXPECT: 42
// EXPECT: true
// `as` binds looser than the prefix operators and tighter than `*` / `/` and
// the binary and comparison operators: `&x as *Int` is `(&x) as *Int`,
// `*p as *Int` is `(*p) as *Int`, and `p as UInt == u` is `(p as UInt) == u`.
// Chaining is left-associative, and a cast result takes parens before a
// method call.

let main() Int = {
    let x = 5;
    let p = &x;

    // &x as *Int groups as (&x) as *Int: the address of x
    let q *Int = &x as *Int;
    println(*q);

    // *p as *Int groups as (*p) as *Int: the value 5 re-read as an address
    let five *Int = *p as *Int;
    println(five as UInt);

    // p as UInt == u groups as (p as UInt) == u
    let u UInt = p as UInt;
    println(p as UInt == u);

    // left-associative chain: pointer -> integer -> pointer
    let cell = alloc_memory[Int](1);
    init_memory(cell, 42);
    println(*(cell as UInt as *mutable UInt));

    // (cast) takes parens before a method call
    println((p as *Int).equals(q));
    dealloc_memory(cell);
    return 0;
};
