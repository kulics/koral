// EXPECT: type mutable field chain ok
// Object semantics: a `type mutable` object's `mutable` fields are writable
// through any path that reaches the object -- including a non-mutable field
// of a plain `type` wrapper, and generic instantiations alike.

type mutable Tm(mutable v: Int32);
type mutable Box[T: Any](mutable v: T);
type Outer(inner: Tm, g: Box[Int32]);

let main(): Int = {
    let o = Outer(Tm(Int32(0)), Box[Int32](Int32(0)));
    o.inner.v = Int32(1);
    assert(o.inner.v == Int32(1), "write lands on the shared object");
    o.g.v = Int32(2);
    assert(o.g.v == Int32(2), "generic instantiation shares the template's identity");
    println("type mutable field chain ok");
    return 0;
};
