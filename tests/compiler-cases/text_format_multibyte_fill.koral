// std.text: the fill character is a rune, so multi-byte fills work.
// EXPECT: fill_string_right_ok
// EXPECT: fill_number_right_ok
// EXPECT: fill_center_ok
// EXPECT: ascii_fill_ok

using "std/text" { ... };

let main(): Int = {
    // "·" (U+00B7) is two UTF-8 bytes and must not be split
    if "ab".format("·>5").equals("···ab") then println("fill_string_right_ok")
    else println("FAIL fill_string_right: [" + "ab".format("·>5") + "]");

    if 42.format("·>5").equals("···42") then println("fill_number_right_ok")
    else println("FAIL fill_number_right: [" + 42.format("·>5") + "]");

    if "ab".format("·^6").equals("··ab··") then println("fill_center_ok")
    else println("FAIL fill_center: [" + "ab".format("·^6") + "]");

    // Single-byte fills are unchanged
    if "ab".format("*>5").equals("***ab") then println("ascii_fill_ok")
    else println("FAIL ascii_fill: [" + "ab".format("*>5") + "]");

    return 0;
};
