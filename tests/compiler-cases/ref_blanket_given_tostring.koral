// Tests that T * satisfies ToString when T implements ToString (blanket given)
// Feature: type-modifier-trait-conformance

type Wrapper(value Int)

given Wrapper as ToString {

    public to_string(*self) String = "Wrapper(" + self.value.to_string() + ")"
}

let print_it[T ToString](x T) Void = println(x.to_string())

let main() Void = {
    let mutable w = Wrapper(42)
    let r = &w
    print_it(r)
}
// EXPECT: Wrapper(42)
