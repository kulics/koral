// EXPECT: hello
// EXPECT: 900
// EXPECT: 500

type Window(title String, width: Int = 800, height: Int = 600);

let main() Int = {
    let w1 = Window("hello");
    println(w1.title);
    let w2 = Window("hello", width: 900);
    println(w2.width);
    let w3 = Window("hello", width: 900, height: 500);
    println(w3.height);
    return 0;
};
