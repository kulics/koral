// EXPECT-ERROR: 'or' cannot be mixed with the flow operators 'and then' / 'or else' / 'or return' without parentheses
// Same rule in the same direction: a logical operator may not follow a flow
// chain without parentheses.

let main(): Int = {
    let opt = Option[Int].Some(1);
    let value = opt and then as v in v == 1 or false;
    let _ = value;
    return 0;
};
