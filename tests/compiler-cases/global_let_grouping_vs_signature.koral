// EXPECT: 1
// EXPECT: 2
// EXPECT: 1
// Global `let` disambiguates a grouped type annotation from a function
// signature: `let p (Int) = 1;` binds a global of type Int (the paren is
// grouping), `let f (x Int) Int = x;` is a one-parameter signature, and
// `let g () Int = 1;` is a zero-parameter signature.

let p: (Int) = 1;

let f(x: Int): Int = x;

let g(): Int = 1;

let main(): Int = {
    println(p);
    println(f(2));
    println(g());
    return 0;
};
