// EXPECT: PASS

type Counter(mut value Int)

given Counter {
    public inc(*mut self) Void = {
        self.value += 1
    }

    public get(*self) Int = self.value
}

let main() Int = {
    let mut c = Counter(1)
    c.inc()
    let value = c.get()
    if value <> 2 then {
        eprintln("FAIL: expected 2, got \(value)")
        return 1
    }
    println("PASS")
    return 0
}