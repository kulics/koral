// EXPECT: PASS

type Counter(mutable value Int)

given Counter {
    public inc(*mutable self) Void = {
        self.value += 1
    }

    public get(*self) Int = self.value
}

let main() Int = {
    let mutable c = Counter(1)
    c.inc()
    let value = c.get()
    if value <> 2 then {
        eprintln("FAIL: expected 2, got \(value)")
        return 1
    }
    println("PASS")
    return 0
}