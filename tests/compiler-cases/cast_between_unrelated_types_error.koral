// EXPECT-ERROR: Invalid operation cast between types Foo and Int
// Cast is a reinterpretation between fixed representations. A nominal Koral
// `type` has no fixed representation -- its layout is the compiler's -- so
// `Int(foo)` is not a cast, it is a mistake.

type Foo(a: Int);

public let main(): Int = {
    let x = Foo(1);
    let _ = Int(x);
    return 0;
};
