// types.koral - Defines structs with private/module_file_private fields

public type SecretPoint(
    public x Int,
    file_private y Int
)

given SecretPoint {

    public new(x Int, y Int) SecretPoint = SecretPoint(x, y)
    public get_y(self) Int = self.y
}

public type ProtectedData(
    public name Int,
    module_private value Int
)

given ProtectedData {

    public get_value(self) Int = self.value
}
