// EXPECT-ERROR: Type mismatch: expected Int, got String
// `or else`'s default stands in for the Option/Result payload, so it has to
// have the payload's type: `x or else "string"` against `Option[Int]` makes
// the two lowered `when` arms disagree.

let main() Int = {
    let x Option[Int] = Option[Int].Some(1);
    let v Int = x or else "string";
    return 0;
};
