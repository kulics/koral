// EXPECT: foreign method ok

// The mirror of method_type_param_foreign_error: a built-in scalar is in the
// `foreign` set, so `get[T foreign]` accepts it.

type Holder(data Int);

given Holder {
    public get[T foreign](self, x T) Int = {
        return 1;
    };
};

let main() Int = {
    let e = Holder(1).get(3);
    println("foreign method ok");
    return e - 1;
};
