// EXPECT-ERROR: open ranges are spelled with '...': write 'a...' or 'a<...'

// `1..` no longer spells a right-open range: the `..` family is closed only.
// The elided bound is written `...` (grammar.bnf <open-range-op>).

let main(): Int = {
    let x = 1..;
    if x.contains(0) then {
        return 1;
    };
    return 0;
};
