// EXPECT-ERROR: does not satisfy the 'foreign' constraint

// The `foreign` shape bound has the same rule as `mutable`: a generic
// parameter satisfies it only if declared `T foreign`.

let needs_foreign[T foreign](x T) Int = {
    return 1;
};

let forward[T Any](x T) Int = {
    return needs_foreign(x);
};

let main() Int = {
    return forward(1);
};
