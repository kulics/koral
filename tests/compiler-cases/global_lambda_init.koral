// Test: global variable initialization with lambda and function types

file_private let double Func(Int) Int = (x) -> x * 2
file_private let add Func(Int, Int) Int = (x, y) -> x + y
file_private let mutable transform Func(Int) Int = (x) -> x + 1

public let main() Void = {
    println(double(21))
    println(add(10, 20))
    println(transform(99))
    transform = (x) -> x * 10
    println(transform(5))
}
// EXPECT: 42
// EXPECT: 30
// EXPECT: 100
// EXPECT: 50
