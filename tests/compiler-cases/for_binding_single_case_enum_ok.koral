// EXPECT: for_single_case_enum_ok
// Design guard: a `for` binding must cover every element value. `Only(v)` is
// total on a one-case enum -- the exhaustiveness checker knows that even
// though the syntactic irrefutability shortcut calls every enum pattern
// refutable.

using "std" { ... };

type Box1 {
    Only(v: Int),
};

let main(): Int = {
    let xs = List[Box1].new();
    xs.push(Box1.Only(1));
    xs.push(Box1.Only(2));
    let mutable sum = 0;
    for .Only(v) in xs then {
        sum += v;
    };
    if sum == 3 then {
        println("for_single_case_enum_ok");
    };
    return 0;
};
