// EXPECT-ERROR: Unreachable pattern

trait Problem {
    render(*self) Int
}

type ProbeIoError(value Int)

given ProbeIoError as Problem {

    render(*self) Int = self.value
}

let main() Int = {
    let err *Problem = box(ProbeIoError(7))
    let _ = when err in {
        first *ProbeIoError then first.render(),
        second *ProbeIoError then second.render(),
        _ then 0,
    }
    return 0
}