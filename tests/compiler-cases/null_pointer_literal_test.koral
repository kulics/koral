// EXPECT: p_is_null: true
// EXPECT: m_is_null: true
// EXPECT: p_eq_null: true
// EXPECT: q_ne_null: true
// EXPECT: p_null_pattern: true
// EXPECT: q_live_pattern: true
// EXPECT: when_null: 0
// EXPECT: when_live: 1

// `null` is the null-pointer literal: it joins an expected `*T` / `*mutable T`,
// compares against pointers with `==` / `!=`, and matches as a literal pattern
// (`is null`, `is not null`, or a `when` arm). Literal patterns are not
// exhaustive alone, so the `when` keeps a catch-all `_` arm.

let classify(p: *Int): Int = when p in {
    null then 0,
    _ then 1,
};

let main(): Int = {
    // Assignment: null joins both pointer flavors.
    let p: *Int = null;
    let m: *mutable Int = null;
    println("p_is_null: \(p == null)");
    println("m_is_null: \(m == null)");

    // == / != against a live pointer.
    let q = alloc_memory[Int](1);
    init_memory(q, 7);
    println("p_eq_null: \(p == null)");
    println("q_ne_null: \(q != null)");

    // is / is not literal patterns.
    let p_null_pattern = p is null;
    println("p_null_pattern: \(p_null_pattern)");
    let q_live_pattern = q is not null;
    println("q_live_pattern: \(q_live_pattern)");

    // when with a null literal arm.
    println("when_null: \(classify(p))");
    println("when_live: \(classify(q))");

    dealloc_memory(q);
    return 0;
};
