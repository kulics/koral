// EXPECT-UNORDERED: Drop Box 0
// EXPECT-UNORDERED: Drop Box 1
// EXPECT: overwrite drop regression passed
// EXPECT-UNORDERED: Drop Box 2
// EXPECT-UNORDERED: Drop Box 3

type Box(id Int);

given Box as Drop {

    drop(self) Void = {
        print("Drop Box ");
        println(self.id);
    };
};

let main() Int = {
    let mutable value = Box(0);
    value = Box(1);
    value = Box(2);
    println("overwrite drop regression passed");
    value = Box(3);
    return 0;
};

