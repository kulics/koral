// EXPECT-ERROR: Type ?List[Int] is not iterable: missing iterator() method and does not implement Iterator
// Iterating needs the iterable's `next`/`iterator`, and a weak handle has
// neither until it is upgraded. Peeling `?T` here used to type the element as
// `Int` and lower to a payload access through a `__koral_WeakRef`.

using "std" { ... };

let main() Int = {
    let xs = List[Int].new();
    xs.push(1);
    let w = ?List[Int](xs);
    for x in w then {
        println("\(x)");
    };
    return 0;
};
