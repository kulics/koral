// EXPECT: before: false
// EXPECT: after replace: false
// EXPECT: after deinit: true

let get_shared(v * Int) * Int = v

let main() Int = {
    let mutable x = 1
    let shared * Int = &x

    let p = alloc_memory[* Int](1)
    init_memory(p, shared)

    print("before: ")
    println(is_unique_mutable(unsafe & shared))

    *p = get_shared(shared)

    print("after replace: ")
    println(is_unique_mutable(unsafe & shared))

    deinit_memory(p)
    print("after deinit: ")
    println(is_unique_mutable(unsafe & shared))

    dealloc_memory(p)
    return 0
}
