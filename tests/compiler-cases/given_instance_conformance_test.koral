// EXPECT: given_instance_conformance_direct_ok
// EXPECT: given_instance_conformance_generic_ok

// A conformance `given` on a concrete instantiation registers the conformance
// for that instantiation alone: the method is callable directly and through a
// generic bound, exactly like `given Int: Step`.

type Box[T: Any](value: T);

public trait Doubler {
    doubled(self): Int;
};

given Box[Int]: Doubler {
    public doubled(self): Int = self.value * 2;
};

let use_it[T: Doubler](x: T): Int = x.doubled();

let main(): Void = {
    assert(Box[Int](21).doubled() == 42, "direct call");
    println("given_instance_conformance_direct_ok");
    assert(use_it(Box[Int](21)) == 42, "generic bound");
    println("given_instance_conformance_generic_ok");
};
