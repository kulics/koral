// EXPECT: chain: [1][2][3]
// EXPECT: chain_short: [20][19]
// EXPECT: named_args: [8][7]
// EXPECT: ctor_fields: [10][9]
// EXPECT: named_and_value: [12][11]
// EXPECT: done

// Evaluation order is WRITTEN order wherever operands are sequenced
// (docs/guide/document.md §Evaluation Order, grammar.bnf "Evaluation Order"):
// the three shapes below used to evaluate in a different order in BOTH
// compilers -- comparison chains ran the second operand before the first
// (`[2][1][3]`), and labelled call arguments / labelled constructor fields
// were reordered into PARAMETER / FIELD declaration order before evaluation
// (`[7][8]`, `[9][10]`). Source order is evaluation order: an argument
// expression written first runs first, no matter which parameter it lands in.
//
// Negative control: reverting any of the three lowerings reorders the traces
// above (the outputs become [2][1][3], [7][8], [9][10]) and the case goes red.

let trace(x: Int): Int = {
    print("[" + x.to_string() + "]");
    return x;
};

type Point(x: Int =, y: Int =);

let pair(a: Int =, b: Int =): Int = a * 100 + b;

let main(): Void = {
    print("chain: ");
    let c1 = trace(1) < trace(2) < trace(3);
    assert(c1, "1 < 2 < 3");
    println("");

    print("chain_short: ");
    let c2 = trace(20) < trace(19) < trace(0);
    assert(not c2, "short-circuit after the failed link");
    println("");

    print("named_args: ");
    let r = pair(b = trace(8), a = trace(7));
    assert(r == 708, "args land in parameter order");
    println("");

    print("ctor_fields: ");
    let p = Point(y = trace(10), x = trace(9));
    assert(p.x == 9 and p.y == 10, "fields land in declaration order");
    println("");

    print("named_and_value: ");
    let r2 = pair(b = trace(12), a = trace(11));
    assert(r2 == 1112, "written order with a repeated shape");
    println("");
    println("done");
};
