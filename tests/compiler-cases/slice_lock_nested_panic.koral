// EXPECT-ERROR: Panic: List modified during iteration or borrow: push
// 嵌套=深度计数：借出里调带锁方法（map）合法，解一层后**外层锁仍在**——
// 此时 push 入口立刻 panic。
let main(): Void = {
    let xs = List[UInt8].new();
    xs.push(1);
    xs.push(2);
    xs.borrow_slice((s) => {
        let mapped = xs.map((e) => e + 1);
        let _ = mapped.count();
        xs.push(9);
        let _ = s.count();
    });
};
