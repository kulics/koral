// EXPECT-ERROR: Duplicate pattern: '16' already matched earlier
// Two spellings of one value are one pattern: `0x10` and `16` and `0o20`
// all name the same literal, and the second arm is a duplicate.

let f(x: Int): Int = when x in {
    0x10 then 1,
    16 then 2,
    _ then 3,
};

let main(): Int = {
    return f(16);
};
