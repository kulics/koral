// EXPECT: bitwise_before_comparison: ok
// EXPECT: bitwise_or_before_comparison: ok

let main() Int = {
    let flags = 6; // 110
    let mask = 2;  // 010

    if flags & mask == 2 then {
        println("bitwise_before_comparison: ok");
    } else {
        println("bitwise_before_comparison: fail");
    };

    if 1 | 2 == 3 then {
        println("bitwise_or_before_comparison: ok");
    } else {
        println("bitwise_or_before_comparison: fail");
    };

    return 0;
};