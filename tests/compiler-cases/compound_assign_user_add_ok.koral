// EXPECT: 11,22
// EXPECT: 2,4

// A user type implementing `Add` must also work under `+=`, not just `+`. This
// is the harder form of the compound-assignment dispatch check: the trait is
// user-defined and the receiver is a nominal `type`.

type Vec(x: Int, y: Int);

given Vec: Add[Vec] {
    public add(self, other: Vec): Vec = Vec(self.x + other.x, self.y + other.y);
};

given Vec {
    public to_string(self): String = self.x.to_string() + "," + self.y.to_string();
};

let main(): Int = {
    let mutable v = Vec(1, 2);
    v += Vec(10, 20);
    println(v.to_string());

    let mutable w = Vec(1, 2);
    w += w;
    println(w.to_string());
    return 0;
};
