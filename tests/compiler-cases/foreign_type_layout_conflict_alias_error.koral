// EXPECT-ERROR: foreign types 'A' and 'B' both define the C type 'timespec'; a C type gets one definition
// Different Koral names, one written C name: same layout-claim conflict. The
// second declaration is prefixed so the diagnostic's anchor pins the span
// rule -- a declaration's span starts at its keyword, not at `public`.

type foreign "timespec" A(a: Int32);
public type foreign "timespec" B(b: Int32);

let main(): Int = {
    return 0;
};
