// EXPECT: groups=2
// EXPECT: group1=2
// EXPECT: group2=3

// `List.group_by` builds `Dict[K, List[T]]`. `Dict.get` hands back the shared
// handle, so pushing into the retrieved bucket mutates the stored one in place --
// which is what we want. What was wrong was then re-inserting that same handle,
// dropping and re-storing the value it already was.

let main(): Int = {
    let g: List[Int] = [1, 1, 2, 2, 2];
    let grouped = g.group_by((x) => x);
    println("groups=" + grouped.count().to_string());
    println("group1=" + grouped.get(1).unwrap().count().to_string());
    println("group2=" + grouped.get(2).unwrap().count().to_string());
    return 0;
};
