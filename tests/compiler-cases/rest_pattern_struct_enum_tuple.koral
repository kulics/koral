// The rest slot in a struct or enum-case pattern is whole-list elision and
// nothing else: it must be the element list's ONLY slot, and it ignores every
// field -- named or not. A list pattern still takes a rest slot of its own,
// and a list pattern may sit inside a slot of an outer pattern.
// EXPECT: rest_struct_ok
// EXPECT: rest_enum_ok
// EXPECT: rest_struct_nested_ok

using "std" { ... };

type Point(x Int, y Int, z Int);
type Shape {
    Circle(r Int),
    Rect(w Int, h Int, tag Int),
};
type Pair2(first List[Int], second Int);

let main() Int = {
    let p = Point(1, 2, 3);

    // `Point(...)` is `Point(_, _, _)`: match the constructor, ignore the fields.
    let ends = when p in {
        Point(...) then 4,
    };
    if ends == 4 then {
        println("rest_struct_ok");
    };

    let s = Shape.Rect(4, 5, 6);
    let width = when s in {
        .Circle(...) then 0,
        .Rect(...) then 4,
    };
    if width == 4 then {
        println("rest_enum_ok");
    };

    // The outer elision does not reach into a slot: the inner list pattern
    // brings its own rest, and the second field is written out. The inner list
    // is refutable, so the struct still needs a catchall.
    let q = Pair2([9, 8], 1);
    let nested = when q in {
        Pair2([a, ...], _) then a,
        _ then 0,
    };
    if nested == 9 then {
        println("rest_struct_nested_ok");
    };

    return 0;
};
