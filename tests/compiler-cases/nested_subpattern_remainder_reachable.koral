// EXPECT: nested-subpattern: PASS

type Color {
    Red(),
    Green(),
    Blue(),
}

type MaybeColor {
    None(),
    Some(value Color),
}

let main() Int = {
    let value = MaybeColor.Some(Color.Green())
    let result = when value in {
        .Some(.Red) then 1,
        .Some(_) then 2,
        .None then 0,
    }
    if result == 2 then {
        println("nested-subpattern: PASS")
        return 0
    }
    return 1
}