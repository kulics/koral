// EXPECT: PASS
// `wrapping_cast` is an unchecked integer conversion with C/Rust-`as`
// semantics: take the two's-complement representation and truncate or
// sign/zero-extend it to the target width. It never panics -- the opt-out
// from the checked `Type(x)` rule for bit moves.

let main() Int = {
    let big Int = 300;
    let low = big.wrapping_cast[UInt8]();
    if low != 44 then {
        eprintln("FAIL: Int 300 -> UInt8, got \(low)");
        return 1;
    };

    let n Int = -5;
    let as_uint = n.wrapping_cast[UInt]();
    let expected UInt = 18446744073709551611;
    if as_uint != expected then {
        eprintln("FAIL: Int -5 -> UInt, got \(as_uint)");
        return 1;
    };

    // Sign-extends, then reinterprets: width-changing but unchecked. -1 as
    // Int8 sign-extends to all-ones, which reads as UInt max. (The same
    // table row with -5 gives 18446744073709551611 -- -5 as UInt.)
    let b Int8 = -1;
    let b_uint = b.wrapping_cast[UInt]();
    let expected_ones UInt = 18446744073709551615;
    if b_uint != expected_ones then {
        eprintln("FAIL: Int8 -1 -> UInt, got \(b_uint)");
        return 1;
    };
    let b5 Int8 = -5;
    let b5_uint = b5.wrapping_cast[UInt]();
    if b5_uint != expected then {
        eprintln("FAIL: Int8 -5 -> UInt, got \(b5_uint)");
        return 1;
    };

    let b_byte = b.wrapping_cast[UInt8]();
    if b_byte != 255 then {
        eprintln("FAIL: Int8 -1 -> UInt8, got \(b_byte)");
        return 1;
    };

    let w UInt32 = 305419896;
    let w_low = w.wrapping_cast[UInt8]();
    if w_low != 120 then {
        eprintln("FAIL: UInt32 0x12345678 -> UInt8, got \(w_low)");
        return 1;
    };

    let u UInt8 = 200;
    let u_signed = u.wrapping_cast[Int8]();
    if u_signed != -56 then {
        eprintln("FAIL: UInt8 200 -> Int8, got \(u_signed)");
        return 1;
    };

    let s Int8 = -100;
    let s_wide = s.wrapping_cast[Int]();
    if s_wide != -100 then {
        eprintln("FAIL: Int8 -100 -> Int, got \(s_wide)");
        return 1;
    };

    println("PASS");
    return 0;
};
