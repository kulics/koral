// EXPECT: rune compare ok

// Comparison patterns order runes by code point. A UInt8 subject takes a
// single ASCII rune as its bound.

let main() Int = {
    let c = 'q';
    let n = when c in {
        >= 'a' and <= 'z' then 1,
        >= 'A' and <= 'Z' then 2,
        _ then 0,
    };
    if n != 1 then {
        eprintln("FAIL: 'q' should land in a-z");
        return 1;
    };
    let u = '!';
    let m = when u in {
        >= 'a' and <= 'z' then 1,
        < '0' then 2,
        _ then 0,
    };
    if m != 2 then {
        eprintln("FAIL: '!' is before '0'");
        return 1;
    };
    let b UInt8 = 'B';
    let k = when b in {
        >= 'A' and <= 'Z' then 3,
        _ then 0,
    };
    if k != 3 then {
        eprintln("FAIL: UInt8 'B' should land in A-Z");
        return 1;
    };
    println("rune compare ok");
    return 0;
};
