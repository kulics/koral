// EXPECT-ERROR: A cast takes exactly one positional argument: write 'Type(expr)'
// A trait-object upcast is a cast form: exactly one positional argument --
// the value being upcast. `Drawable(c, c)` is not a cast.

trait Drawable {
    draw(self) String;
};

type Circle(r Int);

given Circle as Drawable {
    draw(self) String = "circle(\(self.r))";
};

let main() Int = {
    let c = Circle(3);
    let d = Drawable(c, c);
    return 0;
};
