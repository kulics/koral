// EXPECT: PASS
// `find` is a total Option accessor: a negative start is out of domain
// and yields `None` (as does a past-the-end start).

let main(): Int = {
    let s = "hello";
    if s.find("l", from = -1) is .Some(_) then {
        eprintln("FAIL: find(-1) should be None");
        return 1;
    };
    if s.find("l", from = 9) is .Some(_) then {
        eprintln("FAIL: find(9) should be None");
        return 1;
    };
    if s.find("l", from = 0) is .None() then {
        eprintln("FAIL: find(0) should find");
        return 1;
    };
    println("PASS");
    return 0;
};
