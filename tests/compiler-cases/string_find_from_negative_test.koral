// EXPECT: PASS
// `find_from` is a total Option accessor: a negative start is out of domain
// and yields `None` (as does a past-the-end start).

let main(): Int = {
    let s = "hello";
    if s.find_from(-1, "l") is .Some(_) then {
        eprintln("FAIL: find_from(-1) should be None");
        return 1;
    };
    if s.find_from(9, "l") is .Some(_) then {
        eprintln("FAIL: find_from(9) should be None");
        return 1;
    };
    if s.find_from(0, "l") is .None() then {
        eprintln("FAIL: find_from(0) should find");
        return 1;
    };
    println("PASS");
    return 0;
};
