// EXPECT-EXACT: drop
// EXPECT-EXACT: done

// A `type` that implements `Drop` makes sharing OBSERVABLE: the destructor runs
// once per object, so how many handles exist is visible. That puts it in the
// same class as `type mutable` on this axis -- the compiler may not optimize
// the sharing away. Three names for one value must still produce exactly one
// drop. This is the exception to "sharing is unobservable for `type`".
//
// EXPECT-EXACT pins the whole output, so an extra `drop` line would fail.

type Tracked(id Int);

given Tracked as Drop {
    drop(self) Void = {
        println("drop");
    };
};

let count_drops() Void = {
    let a = Tracked(1);
    let b = a;
    let c = b;
};

let main() Int = {
    count_drops();
    println("done");
    return 0;
};
