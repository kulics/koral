// EXPECT: true-branch: 11
// EXPECT: false-branch: 12
// EXPECT: conditional managed ref return ok

let choose_ref(flag Bool) *mutable Int = {
    let mutable a = 1
    let mutable b = 2
    let chosen *mutable Int = if flag then &mutable a else &mutable b
    *chosen = *chosen + 10
    return chosen
}

let main() Int = {
    let left = choose_ref(true)
    let right = choose_ref(false)

    println("true-branch: " + (*left).to_string())
    println("false-branch: " + (*right).to_string())

    assert(*left == 11, "true branch managed ref return")
    assert(*right == 12, "false branch managed ref return")
    println("conditional managed ref return ok")
    return 0
}
