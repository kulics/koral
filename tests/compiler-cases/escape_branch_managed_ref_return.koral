// EXPECT: true-branch: 11
// EXPECT: false-branch: 12
// EXPECT: conditional managed ref return ok

let choose_ref(flag Bool) ref mut Int = {
    let mut a = 1
    let mut b = 2
    let chosen ref mut Int = if flag then a.ref else b.ref
    chosen.val = chosen.val + 10
    return chosen
}

let main() Int = {
    let left = choose_ref(true)
    let right = choose_ref(false)

    println("true-branch: " + left.val.to_string())
    println("false-branch: " + right.val.to_string())

    assert(left.val == 11, "true branch managed ref return")
    assert(right.val == 12, "false branch managed ref return")
    println("conditional managed ref return ok")
    return 0
}