// EXPECT-ERROR: Type mismatch

// Same-named traits from different modules produce distinct trait objects:
// mod_a's Shape must not satisfy mod_b's Shape.

using std { .. };
using cross_module_trait_object_error::mod_a { shape as shape_a };
using cross_module_trait_object_error::mod_b { shape_name as shape_name_b };

let main() Int = {
    println(shape_name_b(shape_a()));
    return 0;
};
