// Test: global variable with custom type initialization and type inference

type Point(x Int, y Int)
type Color { Red(), Green(), Blue() }
type Wrapper(value Int)

file_private let origin = Point(0, 0)
file_private let red = Color.Red()
file_private let wrapped = Wrapper(42)
file_private let mutable cursor = Point(10, 20)

public let main() Void = {
    println(origin.x)
    println(origin.y)
    println(wrapped.value)
    println(cursor.x)
    cursor = Point(30, 40)
    println(cursor.x)
    println(cursor.y)
}
// EXPECT: 0
// EXPECT: 0
// EXPECT: 42
// EXPECT: 10
// EXPECT: 30
// EXPECT: 40
