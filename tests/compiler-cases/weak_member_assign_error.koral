// EXPECT-ERROR: Member 'value' not found in type '?Box'
// A write goes through the same rule, and reports the same thing a read does.
// It used to say `Invalid operation member access on non-struct between types
// ?Box and ` -- a sentence ending mid-clause, blaming a mutability rule for a
// member that does not exist.

type mutable Box(mutable value Int);

let main() Int = {
    let b = Box(42);
    let w = ?Box(b);
    w.value = 3;
    return 0;
};
