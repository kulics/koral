// EXPECT: PASS
// Float to Wrapping: truncate toward zero, then take the target width's low
// bits. The domain rule (NaN / +-inf panic) is separate and never fires here.

let main(): Int = {
    let x: Float64 = 300.7;
    let a: UInt8 = UInt8(WrappingUInt8(x));
    if a != 44 then {
        eprintln("FAIL: WrappingUInt8(300.7), got \(a)");
        return 1;
    };

    // Truncation is toward zero before the width cut.
    let y: Float64 = 3.9;
    let b: WrappingInt = WrappingInt(y);
    if Int(b) != 3 then {
        eprintln("FAIL: WrappingInt(3.9), got \(Int(b))");
        return 1;
    };
    let z: Float64 = -3.9;
    let c: WrappingInt = WrappingInt(z);
    if Int(c) != -3 then {
        eprintln("FAIL: WrappingInt(-3.9), got \(Int(c))");
        return 1;
    };

    println("PASS");
    return 0;
};
