// EXPECT-ERROR: does not explicitly implement trait Doubler
// The conformance of `given Box[Int]: Doubler` does not extend to `Box[Float64]`.

type Box[T: Any](value: T);

public trait Doubler {
    doubled(self): Int;
};

given Box[Int]: Doubler {
    public doubled(self): Int = self.value * 2;
};

let use_it[T: Doubler](x: T): Int = x.doubled();

let main(): Int = {
    return use_it(Box[Float64](1.5));
};
