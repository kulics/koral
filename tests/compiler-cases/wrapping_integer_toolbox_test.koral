// The mathematical toolbox (`pow` `gcd` `lcm` `ilog2` `ilog10`) is shared by
// the families: the same `given` body text runs on the Wrapping types, and
// `+ - * / %` make it wrap or panic as the family says. Where no overflow
// occurs the values match the plain twin exactly.
// EXPECT: wrap_pow_ok
// EXPECT: wrap_gcd_lcm_ok
// EXPECT: wrap_ilog_ok
// EXPECT: wrap_pow_overflow_ok
// EXPECT: wrap_generic_integer_ok

using "std/math" { ... };

let keep[T: Integer](x: T): T = x;

let main(): Int = {
    if WrappingInt(2).pow(10) == WrappingInt(1024) and WrappingInt8(3).pow(3) == WrappingInt8(
        27,
    ) and WrappingUInt(2).pow(10) == WrappingUInt(1024) and WrappingInt16(5).pow(2) == WrappingInt16(
        25,
    ) then {
        println("wrap_pow_ok");
    };

    if gcd(WrappingInt(12), WrappingInt(8)) == WrappingInt(4) and gcd(
        WrappingInt(-12),
        WrappingInt(8),
    ) == WrappingInt(4) and lcm(WrappingInt(4), WrappingInt(6)) == WrappingInt(12) and lcm(
        WrappingInt(-4),
        WrappingInt(6),
    ) == WrappingInt(12) and gcd(WrappingUInt8(12), WrappingUInt8(8)) == WrappingUInt8(
        4,
    ) then {
        println("wrap_gcd_lcm_ok");
    };

    if ilog2(WrappingInt(8)) == 3 and ilog2(WrappingInt(1)) == 0 and ilog10(
        WrappingInt(1000),
    ) == 3 and ilog10(WrappingInt(999)) == 2 and ilog2(WrappingUInt64(8)) == 3 then {
        println("wrap_ilog_ok");
    };

    // pow overflows to the wrapped answer, not a panic: 2^64 wraps to 0.
    if WrappingInt(2).pow(64) == WrappingInt(0) and WrappingInt8(2).pow(7) == WrappingInt8(
        -128,
    ) then {
        println("wrap_pow_overflow_ok");
    };

    // Generic code over `Integer` runs across the families.
    if keep(WrappingInt8(7)) == WrappingInt8(7) and keep(7) == 7 and gcd(
        keep(WrappingInt(12)),
        keep(WrappingInt(8)),
    ) == WrappingInt(4) then {
        println("wrap_generic_integer_ok");
    };

    return 0;
};
