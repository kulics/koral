using trait_same_name_cross_module_trait_object_test::alpha { run_alpha };
using trait_same_name_cross_module_trait_object_test::beta { run_beta };

// EXPECT: 7
// EXPECT: 40
// Two modules each declare a trait named `Tag` with a `value(self) Int` method,
// and each is used as a trait OBJECT in the same program. The two traits are
// different declarations and must get different vtables: `alpha`'s returns the
// field as-is, `beta`'s doubles it. If trait identity were decided by spelling
// the two vtables would collapse and one of the two answers would be wrong.
//
// Identity is the declaration's `DefId`, carried from sema through the typed
// AST and MIR; the name is display only.

let main() Int = {
    println(run_alpha().to_string());
    println(run_beta().to_string());
    return 0;
};
