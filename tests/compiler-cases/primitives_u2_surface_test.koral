// EXPECT: PASS

type mutable Counter(mutable count: Int);

let make_weak(): ?Counter = {
    let c = Counter(99);
    return c as ?Counter;
};

let main(): Int = {
    // Test weak construction + upgrade roundtrip
    let c = Counter(42);
    let weak: ?Counter = c as ?Counter;

    // Upgrade should succeed while object is alive
    let r = when ?weak in {
        .Some(v) then v.count,
        .None() then -1,
    };
    if r != 42 then {
        eprintln("FAIL: expected 42, got \(r)");
        return 1;
    };

    // Test that weak reference survives across scope via function
    let weak2: ?Counter = make_weak();
    // May or may not succeed depending on ARC timing — just verify no crash
    let _ = when ?weak2 in {
        .Some(v) then v.count,
        .None() then 0,
    };

    println("PASS");
    return 0;
};
