// EXPECT: PASS

let main() Int = {
    let strong *mutable Int = box(42)
    let shared *Int = strong
    let weak ?*Int = downgrade(shared)

    let raw_ptr *unsafe *Int = &unsafe shared
    let rc = ref_count[Int](raw_ptr)
    if rc < 1 then {
        eprintln("FAIL: expected ref_count >= 1, got \(rc)")
        return 1
    }

    if not is_unique_mutable[Int](raw_ptr) then {
        // shared aliases the same object, but the underlying control is still valid
    }

    when upgrade(weak) in {
        .Some(value) then {
            if *value <> 42 then {
                eprintln("FAIL: expected 42, got \(*value)")
                return 1
            }
        },
        .None then {
            eprintln("FAIL: upgrade returned None")
            return 1
        },
    }

    println("PASS")
    return 0
}