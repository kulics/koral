// EXPECT: (1, 2)
// A public trait's requirements are public: `show` is implemented in one
// module and called from another -- requirement visibility follows the
// trait's level across module boundaries.

using "./traits.koral" { Show };
using "./lib.koral" { Point };

public let main(): Int = {
    let p = Point.new(1, 2);
    println(p.show());
    return 0;
};
