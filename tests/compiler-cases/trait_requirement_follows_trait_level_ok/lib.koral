using "./traits.koral" { Show };

public type Point(x Int, y Int);

given Point {
    public new(x Int, y Int) Point = Point(x, y);
};

// The implementation writes no access modifier, yet `show` is callable from
// other modules: a requirement's visibility follows the trait's, not the
// impl's spelling.

given Point as Show {
    show(self) String = "(" + self.x.to_string() + ", " + self.y.to_string() + ")";
};
