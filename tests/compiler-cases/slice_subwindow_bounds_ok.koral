// EXPECT: PASS
// 窗界（slice-design §切片）：派生窗 `s[a..<b]` O(1) 折叠到根块，自身 len 是
// 唯一界限——派生窗界限正确、零长派生窗照折叠持根块（count 0 可读）。
let main(): Int = {
    let xs = List[UInt8].new();
    xs.push(1);
    xs.push(2);
    xs.push(3);
    let s = xs.into_slice();

    let w = s[1..<3];
    assert(w.count() == 2, "subwindow len");
    assert(w[0] == 2 and w[1] == 3, "subwindow contents");

    // 继续切片：界限逐层继承。
    let w2 = w[0..<1];
    assert(w2.count() == 1 and w2[0] == 2, "derived window bounds");
    let w3 = w[1..<2];
    assert(w3.count() == 1 and w3[0] == 3, "derived window bounds 2");

    // 零长派生窗：折叠持根块、可读为 empty。
    let zero = s[2..<2];
    assert(zero.count() == 0 and zero.is_empty(), "zero-len derived window");
    let zero2 = w[2..<2];
    assert(zero2.count() == 0, "zero-len derived from subwindow");

    // 只读窗同形（收窄）。
    let r: []UInt8 = s;
    let rw = r[0..<2];
    assert(rw.count() == 2 and rw[1] == 2, "readonly subwindow");

    println("PASS");
    return 0;
};
