// EXPECT: option_ord_hash_ok
// Option 补 Ord（None 排在每个 Some 前，Some 按载荷比）与 Hash（判别位
// 与载荷混合）；等值必等哈希，可当 Dict 键。

let main(): Int = {
    let n = Option[Int].None();
    let a = Option[Int].Some(1);
    let b = Option[Int].Some(2);
    assert(n < a, "None sorts first");
    assert(a < b, "Some compares payloads");
    assert(n.compare(Option[Int].None()) == 0, "None equals None");
    assert(a.compare(b) < 0, "compare sign");
    assert(a.hash() == Option[Int].Some(1).hash(), "equal values hash equal");

    let d = Dict[Option[Int], String].new();
    d.insert(Option[Int].None(), "none");
    d.insert(Option[Int].Some(1), "one");
    assert(d.count() == 2, "option keys");
    assert(d.get(Option[Int].Some(1)) == Option[String].Some("one"), "option key lookup");
    assert(d.get(Option[Int].None()) == Option[String].Some("none"), "none key lookup");

    println("option_ord_hash_ok");
    return 0;
};
