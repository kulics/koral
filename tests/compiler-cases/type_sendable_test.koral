// Declarations across the sendable modifier family parse and behave like
// ordinary nominal types (concurrency-design.md §声明形态).
// EXPECT: Point(3, 4)
// EXPECT: Counter(hits=1)
// EXPECT: Spin(n=2)
// EXPECT: Circle(r=1.5
// EXPECT: Wk(true)

type sendable Point(x: Int, y: Int);

type sendable mutable Counter(mutable hits: Int);

type unsafe sendable mutable Spin(mutable n: Int);

type sendable Shape {
    Circle(r: Float64),
    Rect(w: Float64, h: Float64),
};

type unsafe sendable Wk(ok: Bool);

type foreign sendable FX(a: Int32);

type sendable Box[T: Any](value: T);

let main(): Void = {
    let p = Point(3, 4);
    println("Point(\(p.x), \(p.y))");

    let c = Counter(0);
    c.hits = c.hits + 1;
    println("Counter(hits=\(c.hits))");

    let s = Spin(1);
    s.n = s.n + 1;
    println("Spin(n=\(s.n))");

    let shape = Shape.Circle(1.5);
    when shape in {
        .Circle(r) then println("Circle(r=\(r))"),
        .Rect(w, h) then println("Rect(\(w)x\(h))"),
    };

    println("Wk(\(Wk(true).ok))");
};
