// EXPECT-ERROR: Panic: ByteBuffer.into_string: invalid UTF-8
// checked 交接校验 UTF-8，非法字节 panic（String 恒合法 UTF-8）。

using "std/io" { ByteBuffer, Writer };

let main(): Void = {
    let raw: List[UInt8] = [97, 255, 98];
    let mutable b = ByteBuffer.new();
    let bb = b;
    let _ = raw.borrow_slice((sl) => bb.write_all(from = sl));
    let _ = b.into_string();
};
