// EXPECT-ERROR: Unknown named argument 'wrong' for 'add'

// Labels on instance method calls must be validated, not silently dropped.

type Calc(base Int);

given Calc {
    public add(self, value Int, multiplier: Int) Int = (self.base + value) * multiplier;
};

let main() Int = {
    let c = Calc(10);
    return c.add(5, wrong: 1);
};
