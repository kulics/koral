// EXPECT-ERROR: Field 'x' is positional and cannot be matched by label
// The declaration decides the call shape in BOTH directions: a field declared
// positional (`x Int`) must not be matched by label, just as a field declared
// named (`y: Int`) must be.

type Point(x Int, y Int);

let main() Int = {
    let p = Point(1, 2);
    let v = when p in {
        Point(x: a, y: b) then a + b,
    };
    return v;
};
