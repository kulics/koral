// EXPECT: clone_ok
// clone = 解钉（Go strings.Clone 同策略）：内容相等、块独立。窗口的
// borrow_ptr 与源块可观察地不同（off > 0 的窗口），clone 的块与两者都不同。

let main(): Int = {
    let base = "hello-world-window";
    let win = base.substring(3..<8);         // "lo-wo"，off > 0
    assert(win.borrow_ptr() != base.borrow_ptr(), "window points into block");

    let d = win.clone();
    assert(d == win, "clone content equal");
    assert(d.borrow_ptr() != win.borrow_ptr(), "clone detaches from window");
    assert(d.borrow_ptr() != base.borrow_ptr(), "clone detaches from source block");

    // 整串 clone 也解钉。
    let b2 = base.clone();
    assert(b2 == base, "whole-string clone equal");
    assert(b2.borrow_ptr() != base.borrow_ptr(), "whole-string clone detaches");

    // clone 的内容独立：逐字节一致。
    assert(d.count() == win.count() and d[2] == win[2] and d[4] == win[4], "clone bytes equal");

    println("clone_ok");
    return 0;
};
