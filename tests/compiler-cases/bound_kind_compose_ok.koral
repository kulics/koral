// `sendable` joins the kind-bound slot and composes with the other shape
// bounds (`T: mutable and sendable`, `T: foreign and sendable`) as well as
// with trait bounds (concurrency-design.md §派生规则).
// EXPECT: counter 1
// EXPECT: number 3

type sendable mutable Counter(mutable hits: Int);

let bump[T: mutable and sendable](c: T): T = c;

let pass[T: foreign and sendable](x: T): T = x;

let main(): Void = {
    let c = Counter(1);
    let c2 = bump(c);
    println("counter \(c2.hits)");
    println("number \(pass(3))");
};
