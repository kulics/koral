// EXPECT: PASS
// A same-width signed <-> unsigned conversion reinterprets the bit pattern and
// never panics. Nothing is lost -- only the signedness of the reading -- so
// there is no range to violate. Signed bit operations in `std` are built on
// exactly this move.

let main(): Int = {
    let expected: UInt = 18446744073709551611;

    let n: Int = -5;
    let u: UInt = UInt(n);
    let back: Int = Int(u);

    let b: Int8 = -1;
    let ub: UInt8 = UInt8(b);

    if u != expected then {
        eprintln("FAIL: Int -> UInt reinterpretation, got \(u)");
        return 1;
    };
    if back != -5 then {
        eprintln("FAIL: UInt -> Int round trip, got \(back)");
        return 1;
    };
    if ub != 255 then {
        eprintln("FAIL: Int8 -> UInt8 reinterpretation, got \(ub)");
        return 1;
    };
    println("PASS");
    return 0;
};
