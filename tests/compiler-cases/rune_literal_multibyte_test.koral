// EXPECT: PASS: multibyte rune literals ok
// One Unicode code point is one rune however many UTF-8 bytes it takes. A
// multi-byte character is a perfectly good single-code-point literal.

let main() Int = {
    let r Rune = 'é';
    let s Rune = '😀';
    assert(r.to_uint32() == UInt32(233), "é is U+00E9");
    assert(s.to_uint32() == UInt32(128512), "😀 is U+1F600");
    println("PASS: multibyte rune literals ok");
    return 0;
};
