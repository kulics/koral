// EXPECT: a run: 111
// EXPECT: b run: 222
// EXPECT: a helper: 111
// EXPECT: b helper: 222
//
// Design guard: a VALUE spelling resolves through this file's IMPORTS, not
// through a cross-module name slot that is last-wins across modules.
//
// `a/util` and `b/util` both export `helper`. The bare import names a/util's;
// b/util's arrives under the alias `helper_b`. The second module's
// registration must not swallow the first one's binding: bare `helper()`
// names the import this file wrote, and each module's internal `run()`
// calls its own `helper`.
//
// The TYPE analogue is pinned by `bare_import_same_name_type`; this is the
// value half of the same rule, which used to resolve bare `helper` to
// whichever module registered the spelling last and then complain
// "'helper' is defined in module 'import_same_name_value_bare_test/b/util'".

using "import_same_name_value_bare_test/a/util" { run as run_a, helper };
using "import_same_name_value_bare_test/b/util" { run as run_b, helper as helper_b };

let main(): Int = {
    print("a run: ");
    println(run_a());
    print("b run: ");
    println(run_b());
    print("a helper: ");
    println(helper());
    print("b helper: ");
    println(helper_b());
    return 0;
};
