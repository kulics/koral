using "trait_same_name_bound_same_type_test/alpha" { Tag as AlphaTag, box as alpha_box };
using "trait_same_name_bound_same_type_test/beta" { Tag as BetaTag, box as beta_box };

// EXPECT: 7
// EXPECT: 40
// EXPECT: 47
// Two modules each declare a trait named `Tag`, and both are used as GENERIC
// BOUNDS on type parameters in the same file. A bound carries the trait's
// DECLARATION identity; a placeholder built from its SPELLING looks up
// whichever `Tag` is registered first and dispatches the wrong `value`.
//
// This is the generic-bound half of `trait_same_name_cross_module_same_type_test`
// (trait objects). Both instantiations use a type spelled `Box`, so the
// concrete type cannot disambiguate either.

let read_a[T: AlphaTag](x: T): Int = x.value();
let read_b[T: BetaTag](x: T): Int = x.value();

let main(): Int = {
    println(read_a(alpha_box()).to_string());
    println(read_b(beta_box()).to_string());
    println((read_a(alpha_box()) + read_b(beta_box())).to_string());
    return 0;
};
