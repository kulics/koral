// std.text: Int.format must survive Int.min_value() (magnitude via UInt).
// EXPECT: min_dec_ok
// EXPECT: min_hex_ok
// EXPECT: min_roundtrip_ok
// EXPECT: neg_small_ok
// EXPECT: max_dec_ok

using "std/text" { ... };

let main(): Int = {
    let min = Int.min_value();

    if min.format("d").equals("-9223372036854775808") then println("min_dec_ok")
    else println("FAIL min_dec: [" + min.format("d") + "]");

    if min.format("x").equals("-8000000000000000") then println("min_hex_ok")
    else println("FAIL min_hex: [" + min.format("x") + "]");

    // Round-trips through the fixed parser
    when Int.parse(min.format("d")) in {
        .Ok(n) then if n == min then println("min_roundtrip_ok")
        else println("FAIL min_roundtrip"),
        .Error(e) then println("FAIL min_roundtrip: " + e.message()),
    };

    // Ordinary negatives are unaffected
    if (0 - 42).format("d").equals("-42") then println("neg_small_ok")
    else println("FAIL neg_small: [" + (0 - 42).format("d") + "]");

    if Int.max_value().format("d").equals("9223372036854775807") then println(
        "max_dec_ok",
    )
    else println("FAIL max_dec: [" + Int.max_value().format("d") + "]");

    return 0;
};
