// EXPECT-ERROR: Type mismatch: expected Int, got String
// A name shared by two `or` branches has to mean the same type in both, or one
// of the two branches would be writing the wrong thing into the binding.

type E {
    A(a Int),
    B(a String),
};

let f(e E) Int = when e in {
    .A(a) or .B(a) then 1,
};

let main() Int = {
    return f(E.A(1));
};
