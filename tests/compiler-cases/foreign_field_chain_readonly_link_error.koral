// EXPECT-ERROR: Cannot assign to immutable variable: v
// A read-only handle segment resets write permission for the rest of the
// chain, even under a `let mutable` root.

type foreign Inner(v: Int32);
type foreign Outer(p: *Inner);

let main(): Int = {
    let i = Inner(Int32(0));
    let mutable o = Outer(&i);
    o.p.v = Int32(1);
    return 0;
};
