// EXPECT-ERROR: does not satisfy the 'sendable' constraint (checking constraint U: sendable)
// Forwarding rule (concurrency-design.md §派生规则): a bare generic parameter
// gets no free pass -- `T: Any` cannot satisfy an inner `U: sendable`
// requirement, exactly as `T: Any` cannot satisfy `g[T mutable]`. The
// parameter must itself declare `T sendable`.

let inner[U: sendable](u: U): U = u;

let outer[T: Any](t: T): T = inner(t);

let main(): Void = {};
