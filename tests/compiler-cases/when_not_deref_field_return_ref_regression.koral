// EXPECT: ok

type Kind {
    A(),
    B(),
}

given Kind not Deref

type Expr(kind * Kind)

let clone_kind(expr * Expr) * Kind = when expr.kind in {
    .A() then box(Kind.A()),
    .B() then box(Kind.B()),
}

let classify(kind * Kind) Int = when kind in {
    .A() then 1,
    .B() then 2,
}

let main() Void = {
    let kind_a *mutable Kind = box(Kind.A())
    let kind_b *mutable Kind = box(Kind.B())
    let expr_a = Expr(kind_a)
    let expr_b = Expr(kind_b)
    assert(classify(clone_kind(&expr_a)) == 1, "A branch should clone to *")
    assert(classify(clone_kind(&expr_b)) == 2, "B branch should clone to *")
    println("ok")
}
