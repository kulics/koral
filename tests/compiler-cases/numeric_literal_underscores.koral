// Valid digit-separator forms: '_' may separate digits inside every digit run
// (integer part, fractional part, exponent digits) of any base. It may not
// lead, not trail, not double, and not sit against '.'.
// EXPECT: true
// EXPECT: true
// EXPECT: true
// EXPECT: true
// EXPECT: true
// EXPECT: true
// EXPECT: true
// EXPECT: true
// EXPECT: true
// EXPECT: true

let main() Int = {
    println((1_000_000 == 1000000).to_string());
    println((1_0_0 == 100).to_string());

    let a = 1.0_0_1;
    println((a == 1.001).to_string());

    let b = 1_0.0_0_1;
    println((b == 10.001).to_string());

    let c = 1_0e3;
    println((c == 10000.0).to_string());

    println((0b1010_0101 == 165).to_string());
    println((0xFF_FF == 65535).to_string());
    println((0o7_5_5 == 493).to_string());

    let d = 1_000e2;
    println((d == 100000.0).to_string());

    // Separators keep digits on both sides before a duration unit too.
    let f = 1_0s;
    println((f == 10s).to_string());

    return 0;
};
