// EXPECT: PASS

type Point(mut x Int, mut y Int)

let main() Int = {
    let mut p = Point(1, 2)
    let rp *! Point = &! p
    if rp.x <> 1 then {
        eprintln("FAIL: expected x=1, got \(rp.x)")
        return 1
    }
    let mp *! mut Point = &! mut p
    mp.x = 7
    if p.x <> 7 then {
        eprintln("FAIL: expected mutated x=7, got \(p.x)")
        return 1
    }
    println("PASS")
    return 0
}