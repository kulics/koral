// EXPECT: PASS

type Point(mutable x Int, mutable y Int)

let main() Int = {
    let mutable p = Point(1, 2)
    let rp unsafe * Point = unsafe & p
    if (unsafe *rp).x <> 1 then {
        eprintln("FAIL: expected x=1, got \(rp.x)")
        return 1
    }
    let mp unsafe * mutable Point = unsafe & mutable p
    (unsafe *mp).x = 7
    if p.x <> 7 then {
        eprintln("FAIL: expected mutated x=7, got \(p.x)")
        return 1
    }
    println("PASS")
    return 0
}