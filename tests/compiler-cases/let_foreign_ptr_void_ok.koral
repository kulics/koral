// EXPECT: ok
// `*Void` / `*mutable Void` are C's `void*`: the pointee is not a Koral value,
// so the pointer stays legal at the boundary. Foreign struct pointers too.

type foreign Box(x: Int32);

let foreign takes_void(p: *Void): *Void;
let foreign takes_mut_void(p: *mutable Void): Int32;
let foreign takes_box(b: *Box): Int32;

let main(): Void = {
    println("ok");
};
