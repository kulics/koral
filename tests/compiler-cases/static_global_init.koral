// EXPECT: 42 true hi 43
// EXPECT: static global init tests passed
// Constant-literal globals are initialized from process start: the C
// storage carries the value (no runtime initializer runs), and only the
// computed global goes through the lazy state machine.

let lit: Int = 42;
let flag: Bool = true;
let name: String = "hi";
let computed: Int = lit + 1;

let main(): Int = {
    println("\(lit) \(flag) \(name) \(computed)");
    println("static global init tests passed");
    return 0;
};
