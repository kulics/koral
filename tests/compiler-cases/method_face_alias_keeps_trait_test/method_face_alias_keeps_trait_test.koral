// EXPECT: beep r2
// `{ T as A }` leaves `T` unwritable but the TRAIT is still in scope, so its
// methods stay callable under their own names (§3.4). Rust agrees:
// `use std::io::Read as R;` still permits `f.read()`.

using "std" { ... };
using "./lib.koral" { Robot };
using "./traits.koral" { Speak as Sp };

public let main(): Int = {
    let r = Robot.new("r2");
    println(r.say());
    return 0;
};
