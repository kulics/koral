// EXPECT: pair_pos:
// EXPECT: 7
// EXPECT: pair_neg:
// EXPECT: 8
// EXPECT: mixed_then:
// EXPECT: 12
// EXPECT: mixed_else:
// EXPECT: 99
// EXPECT: value_pos:
// EXPECT: 15
// EXPECT: bare_return:
// EXPECT: done
// EXPECT: when_a:
// EXPECT: 31
// EXPECT: when_b:
// EXPECT: 32
// EXPECT: when_c:
// EXPECT: 33
// EXPECT: loops:
// EXPECT: 23
// EXPECT: for_skip:
// EXPECT: 12
// EXPECT: when_loop:
// EXPECT: 3
// EXPECT: search:
// EXPECT: 3
// EXPECT: first_of:
// EXPECT: 11
// A bare control transfer is legal in every `then` / `else` body slot: `if`
// branches, `when` arms, `while` / `for` bodies. It desugars to the
// single-jump block a reader would otherwise have to write, so it types
// `Never` and unifies with value branches exactly like `{ return v; }` does.

let pair(x: Int): Int = {
    if x > 0 then return 7 else return 8;
};

let mixed(x: Int): Int = {
    if x > 0 then return 12 else 99
};

let valuePosition(x: Int): Int = {
    let y = if x > 0 then return 0 else 15;
    return y;
};

let bareReturn(x: Int): Void = {
    if x > 0 then return;
    println("done");
};

let whenJumps(x: Int): Int = {
    when x in {
        1 then return 31,
        2 then 32,
        _ then return 33,
    }
};

let loopSum(): Int = {
    let mutable i = 0;
    let mutable sum = 0;
    while i < 10 then {
        i = i + 1;
        if i == 5 then continue else if i == 8 then break;
        sum = sum + i;
    };
    return sum;
};

let forSkip(): Int = {
    let mutable sum = 0;
    for x in [1, 2, 3, 4, 5] then {
        if x == 3 then continue;
        sum = sum + x;
    };
    return sum;
};

let whenLoop(): Int = {
    let mutable i = 0;
    let mutable hits = 0;
    while i < 5 then {
        i = i + 1;
        when i in {
            3 then continue,
            5 then break,
            _ then { hits = hits + 1; },
        };
    };
    return hits;
};

let search(limit: Int): Int = {
    let mutable i = 0;
    while i < limit then {
        if i == 3 then return i;
        i = i + 1;
    };
    return 0 - 1;
};

let firstOf(xs: List[Int]): Int = {
    for x in xs then return x;
    return 0 - 1;
};

let main(): Int = {
    println("pair_pos:");
    println(pair(1));
    println("pair_neg:");
    println(pair(0 - 1));
    println("mixed_then:");
    println(mixed(1));
    println("mixed_else:");
    println(mixed(0 - 1));
    println("value_pos:");
    println(valuePosition(0 - 1));
    println("bare_return:");
    bareReturn(0 - 1);
    println("when_a:");
    println(whenJumps(1));
    println("when_b:");
    println(whenJumps(2));
    println("when_c:");
    println(whenJumps(9));
    println("loops:");
    println(loopSum());
    println("for_skip:");
    println(forSkip());
    println("when_loop:");
    println(whenLoop());
    println("search:");
    println(search(10));
    println("first_of:");
    println(firstOf([11, 22]));
    return 0;
};
