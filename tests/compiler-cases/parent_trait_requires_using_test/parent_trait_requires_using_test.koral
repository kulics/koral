// A parent trait is a name like any other, and names cross a module boundary
// only through `using`. ChildOrd's parent is declared right here in the root
// module, but child/child.koral does not import it, so the child module cannot
// extend it. The fix is `using "../parent_trait_requires_using_test.koral" {
// ParentOrd };` in child/child.koral.
// EXPECT-ERROR: Undefined trait: ParentOrd

using "./child/child.koral" { ChildOrd };

public trait ParentOrd {
    compare(self, other: Self): Int;
};

let main(): Int = 0;
