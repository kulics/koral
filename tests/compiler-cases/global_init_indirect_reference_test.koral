// EXPECT: computed=14
// EXPECT: written=42
// Indirect references: an initializer that calls a function which writes one
// global and reads another forces both on the spot -- the accessor guarantee
// holds through call indirection too.
using "std" { ... };

let computed: Int = compute();
let mutable written: Int = 0;
let base: Int = 7;

let compute(): Int = {
    written = 42;
    return base * 2;
};

let main(): Void = {
    println("computed=\(computed)");
    println("written=\(written)");
};
