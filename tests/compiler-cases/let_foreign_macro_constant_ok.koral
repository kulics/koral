// EXPECT: macro constant ok
// `let foreign` + a value + no `mutable` is a C macro constant binding
// (cffi-design.md §B): no storage, no C entity -- the C name is a
// correspondence label only. The emitted C variable must keep its mangled
// name, not the label. A label still spells a legal C identifier: it names
// the corresponding C macro, and no C macro is named for a keyword.

let foreign "KORAL_STATIC_VAL" static_val: Int32 = 5;
let foreign "KORAL_DEFAULT_VAL" default_val: Int32 = -7;

let main(): Int = {
    assert(static_val == Int32(5), "macro constant value");
    assert(default_val == Int32(-7), "negative literal initializer");
    println("macro constant ok");
    return 0;
};
