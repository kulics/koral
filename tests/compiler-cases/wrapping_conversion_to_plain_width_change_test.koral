// EXPECT: PASS
// Wrapping -> Regular with a width change is the CHECKED half of the matrix:
// widening sign/zero-extends like any other widening retype of the bits, and
// narrowing checks against the regular target's range (the panic side is
// wrapping_conversion_to_plain_narrow_panic).

let main(): Int = {
    // Widening a signed Wrapping source sign-extends and fits.
    let w8: WrappingInt8 = -1;
    let wide: Int = Int(w8);
    if not (wide == -1) then {
        eprintln("FAIL: Int(WrappingInt8(-1)) != -1");
        return 1;
    };

    // Widening an unsigned Wrapping source zero-extends and fits.
    let u8: WrappingUInt8 = 255;
    let zext: UInt16 = UInt16(u8);
    if not (zext == 255) then {
        eprintln("FAIL: UInt16(WrappingUInt8(255)) != 255");
        return 1;
    };

    // A narrowing whose value fits the regular target succeeds.
    let w: WrappingInt = WrappingInt(200);
    let a: UInt8 = UInt8(w);
    if not (a == 200) then {
        eprintln("FAIL: UInt8(WrappingInt(200)) != 200");
        return 1;
    };

    println("PASS");
    return 0;
};
