// EXPECT: 42
// EXPECT: hello

// Test that a `*mut self` receiver can call methods declared with `*self`.
// This is the method-dispatch variant of *mut → * widening.

type Counter(mut value Int)

given Counter {

    // Method taking *self (read-only)
    read(*self) Int = self.value

    // Method taking *mut self (mutable)
    increment(*mut self) Void = {
        self.value = self.value + 1
    }

    // *mut method that calls a * method on self
    read_via_mut(*mut self) Int = self.read()
}

type Printer(mut buffer * String)

given Printer {

    // * method
    get_buffer(*self) String = self.buffer.to_string()

    // *mut method that calls * method on self
    print_buffer(*mut self) Void = {
        println(self.get_buffer())
    }
}

let main() Void = {
    let mut c = Counter(41)
    c.increment()
    // Call * method on *mut receiver directly
    println(c.read().to_string())

    let p *mut Printer = box(Printer(box("hello")))
    // *mut method internally calls * method
    p.print_buffer()
}
