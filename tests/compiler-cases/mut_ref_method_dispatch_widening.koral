// EXPECT: 42
// EXPECT: hello

// Test that a `*mutable self` receiver can call methods declared with `*self`.
// This is the method-dispatch variant of *mutable → * widening.

type Counter(mutable value Int)

given Counter {

    // Method taking *self (read-only)
    read(*self) Int = self.value

    // Method taking *mutable self (mutable)
    increment(*mutable self) Void = {
        self.value = self.value + 1
    }

    // *mutable method that calls a * method on self
    read_via_mut(*mutable self) Int = self.read()
}

type Printer(mutable buffer * String)

given Printer {

    // * method
    get_buffer(*self) String = self.buffer.to_string()

    // *mutable method that calls * method on self
    print_buffer(*mutable self) Void = {
        println(self.get_buffer())
    }
}

let main() Void = {
    let mutable c = Counter(41)
    c.increment()
    // Call * method on *mutable receiver directly
    println(c.read().to_string())

    let p *mutable Printer = box(Printer(box("hello")))
    // *mutable method internally calls * method
    p.print_buffer()
}
