// EXPECT: tag:5
// EXPECT: witness:7
// In a generic body a method call matches BY THE CONSTRAINT: `t.describe()`
// under `[T: Tag]` finds `Tag`'s tool method, and under `[T: Speak]` dispatches
// to the requirement's witness -- the body is checked once, against the bound,
// and instantiation must not re-answer the call from the receiver's own method
// table.

trait Tag {
    value(self): Int;
};

given Tag {
    describe(self): String = "tag:" + self.value().to_string();
};

trait Speak {
    describe(self): String;
};

type Num(x: Int);

given Num: Tag {
    value(self): Int = self.x;
};

type Word(v: Int);

given Word: Speak {
    describe(self): String = "witness:" + self.v.to_string();
};

let show_tool[T: Tag](t: T): String = {
    return t.describe();
};

let show_req[T: Speak](t: T): String = {
    return t.describe();
};

let main(): Int = {
    println(show_tool(Num(5)));
    println(show_req(Word(7)));
    return 0;
};
