// EXPECT: resolve_span_closed_open_ok
// EXPECT: resolve_span_from_ok
// EXPECT: resolve_span_empty_ok
// EXPECT: resolve_span_full_ok
// EXPECT: resolve_span_sublist_ok
// EXPECT: resolve_span_substring_ok

// `Range[Int].resolve_span(count)` resolves an interval over a container of
// `count` elements into `(start, length)` by Rust's slice-index rule: first
// normalize to the half-open `[lo, hi)` the interval names, then require
// `lo <= hi <= count`. A crossing interval panics (see
// panic_resolve_span_open_cross_error); `a..a-1` normalizes to the empty
// `[a, a)`.

let main(): Void = {
    let closed_open = (1..<3).resolve_span(4);
    assert(closed_open.first == 1, "closed_open start");
    assert(closed_open.first + closed_open.second == 3, "closed_open end");
    assert(closed_open.second == 2, "closed_open len");
    println("resolve_span_closed_open_ok");

    let from = (2...).resolve_span(4);
    assert(from.first == 2, "from start");
    assert(from.first + from.second == 4, "from end");
    assert(from.second == 2, "from len");
    println("resolve_span_from_ok");

    // Empty intervals: an interval that normalizes to `[lo, lo)` names no
    // elements wherever it sits. `a..a-1` is this case -- its inclusive end
    // lands one before its start -- while `a<..<a` crosses and panics.
    let back = (3..2).resolve_span(4);
    assert(back.first == 3 and back.second == 0, "3..2 empty at 3");
    assert((2..1).resolve_span(4).second == 0, "2..1 empty");
    assert((2..<2).resolve_span(4).second == 0, "2..<2 empty");
    assert((2<..2).resolve_span(4).second == 0, "2<..2 empty");
    assert((2<..<3).resolve_span(4).second == 0, "2<..<3 empty");
    assert((2<..<4).resolve_span(4).second == 1, "2<..<4 one element");
    assert((3..2).resolve_span(3).second == 0, "3..2 empty at end");
    println("resolve_span_empty_ok");

    let whole: Range[Int] = ...;
    let full = whole.resolve_span(4);
    assert(full.first == 0 and full.second == 4, "full");
    let until = (2..<4).resolve_span(4);
    assert(until.first == 2 and until.second == 2, "until");
    println("resolve_span_full_ok");

    let mutable values = List[Int].new();
    for i in 0..<5 then {
        values.push(i * 10);
    };
    let sub = values.sublist(1..<3);
    assert(sub.count() == 2, "sublist count");
    let mutable rebuilt = List[Int].new();
    rebuilt.push_list(values, span = 1..<3);
    assert(rebuilt.count() == 2, "push_list count");
    println("resolve_span_sublist_ok");

    let text = "hello";
    let cut = text.substring(1..<4);
    assert(cut == "ell", "substring 1..<4");
    let whole_text: Range[Int] = ...;
    assert(text.substring(whole_text) == "hello", "substring full");
    println("resolve_span_substring_ok");
};
