// EXPECT: PASS
// Wrapping types fully participate in integer literal joining: a literal
// takes the other side's integer type in both operand positions.

let main() Int = {
    let n WrappingInt = WrappingInt(0);
    let m WrappingInt = 123;
    let also_wrapping WrappingInt = 123;

    if not (n == 0) then {
        eprintln("FAIL: WrappingInt == literal joined to WrappingInt");
        return 1;
    };
    if not (0 == n) then {
        eprintln("FAIL: literal == WrappingInt joined to WrappingInt");
        return 1;
    };
    if not (m == 123) then {
        eprintln("FAIL: WrappingInt == 123, got \(Int(m))");
        return 1;
    };
    if m != also_wrapping then {
        eprintln("FAIL: let-joined literal disagrees");
        return 1;
    };

    let b WrappingUInt8 = WrappingUInt8(255);
    if not (b == 255) then {
        eprintln("FAIL: WrappingUInt8 == 255");
        return 1;
    };

    println("PASS");
    return 0;
};
