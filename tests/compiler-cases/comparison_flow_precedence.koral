// Comparison binds tighter than the flow layer (`and then` / `or else` /
// `or return`), the way Swift's comparison binds tighter than its flow
// operators: `a == b or else c` groups as `(a == b) or else c`, not
// `a == (b or else c)`. The parenthesized right-grouping type-checks here
// (Option coalesced to Int, then compared); the actual left-grouping makes
// `or else` receive the `Bool` from `==`, which is the error both compilers
// must report.
// EXPECT-ERROR: 'or else' can only be used with Option or Result types, got 'Bool'

let main() Int = {
    let a = Option[Int].Some(1);
    let b = Option[Int].Some(2);
    let r = a == b or else 0;
    return 0;
};
