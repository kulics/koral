// EXPECT: PASS
// A collection subscript takes an `Int` index -- counts and positions are
// signed -- so `l[i]` with `i: Int` (including a bare literal, which infers
// `Int` in subscript position) is exactly the right type.

let main(): Int = {
    let l: List[Int] = [1, 2, 3];
    let i = 0;
    if l[i] != 1 then {
        eprintln("FAIL: l[0], got \(l[i])");
        return 1;
    };
    println("PASS");
    return 0;
};
