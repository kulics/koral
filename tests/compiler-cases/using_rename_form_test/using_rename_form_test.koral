// EXPECT: 5
// `{ a as b, ... }` is the whole surface with `a` re-spelled as `b` (§3.3).
// The original spelling does not land; the rest is unfiltered.

using "std/text" { Regex as TextRegex, ... };

public let main() Int = {
    let renamed Option[TextRegex] = Option[TextRegex].None();
    let rest Option[Match] = Option[Match].None();
    let _ = renamed;
    let _ = rest;
    println("5");
    return 0;
};
