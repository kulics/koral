// EXPECT-ERROR: Maximum instantiation depth exceeded
// 泛型多态递归（f 的递归调用把自己实例化在 Wrap[T] 上）生成无穷实例化链：
// f[Int]、f[Wrap[Int]]、f[Wrap[Wrap[Int]]]、…… 编译器必须在**单态化统一
// 上限**（实参泛型嵌套深度）处干净报错，而不是追到天荒地老。两个编译器
// 同一阈值、同一文案。

type Wrap[T: Any](v: T);

let f[T: Any](x: T): Int = {
    return f[Wrap[T]](Wrap[T](x));
};

let main(): Int = {
    return f(1);
};
