// EXPECT: PASS
// The conversion matrix: the TARGET type decides the policy. A Wrapping
// target truncates to the target width's low bits and never panics; a same-
// width pair is a lossless retype. These are the worked equivalences of the
// width-changing truncate rule.

let main() Int = {
    let b Int8 = -1;
    let sign_extended UInt = UInt(WrappingUInt(b));
    let expected_ones UInt = 18446744073709551615;
    if sign_extended != expected_ones then {
        eprintln("FAIL: Int8 -1 -> WrappingUInt, got \(sign_extended)");
        return 1;
    };

    let low8 UInt8 = UInt8(WrappingUInt8(b));
    if low8 != 255 then {
        eprintln("FAIL: Int8 -1 -> WrappingUInt8, got \(low8)");
        return 1;
    };

    let big Int = 300;
    let truncated UInt8 = UInt8(WrappingUInt8(big));
    if truncated != 44 then {
        eprintln("FAIL: Int 300 -> WrappingUInt8, got \(truncated)");
        return 1;
    };

    let w UInt32 = 305419896;
    let w_low UInt8 = UInt8(WrappingUInt8(w));
    if w_low != 120 then {
        eprintln("FAIL: UInt32 0x12345678 -> WrappingUInt8, got \(w_low)");
        return 1;
    };

    let u UInt8 = 200;
    let signed Int8 = Int8(WrappingInt8(u));
    if signed != -56 then {
        eprintln("FAIL: UInt8 200 -> WrappingInt8, got \(signed)");
        return 1;
    };

    // Same width is a lossless retype in both directions: Wrapping -> plain
    // gives the value back.
    let n Int = -5;
    let wv WrappingInt = WrappingInt(n);
    let back Int = Int(wv);
    if back != -5 then {
        eprintln("FAIL: Int -> WrappingInt -> Int round trip, got \(back)");
        return 1;
    };

    println("PASS");
    return 0;
};
