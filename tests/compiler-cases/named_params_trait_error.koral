// EXPECT-ERROR: Named labels are only allowed on struct and enum constructors; use positional arguments

type Counter(value Int)

given Counter {

    public shift(self, amount Int, limit Int) Int = amount + limit + self.value
}

let main() Int = {
    let c = Counter(1)
    let _ = c.shift(amount: 2, limit: 3)
    return 0
}