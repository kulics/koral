// EXPECT-ERROR: requires named parameter

trait Printable {
    print(self, prefix: String, suffix: String) String;
};

type Item(name String);

given Item as Printable {
    // ERROR: trait has named param 'prefix', but implementation uses positional
    print(self, prefix String, suffix String) String = prefix + self.name + suffix;
};

let main() Int = {
    let item = Item("test");
    println(item.print(prefix: "[", suffix: "]"));
    return 0;
};
