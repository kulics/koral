// EXPECT-EXACT: method-first method: 30
// EXPECT-EXACT: method-first free: 10
// EXPECT-EXACT: free-first method: 200
// EXPECT-EXACT: free-first free: -10

// A `given` method and a free function of the same name are two different
// things: the method is identified by its owner, the function by (module, name).
// Neither may take the other's body, and declaring them in either order must
// behave the same.
//
// `classify` is declared method-first, `score` free-first. EXPECT-EXACT pins the
// whole output: a collision reads the wrong function body and the numbers change
// silently, with no diagnostic.

type Left(x Int);
type Right(y Int);

given Left {
    classify(self, r Right) Int = {
        return self.x + r.y;
    };
};

let classify(l Left, r Right) Int = {
    return r.y - l.x;
};

let score(l Left, r Right) Int = {
    return l.x - r.y;
};

given Right {
    score(self, l Left) Int = {
        return self.y * l.x;
    };
};

let main() Int = {
    let l = Left(10);
    let r = Right(20);
    println("method-first method: \(l.classify(r))");
    println("method-first free: \(classify(l, r))");
    println("free-first method: \(r.score(l))");
    println("free-first free: \(score(l, r))");
    return 0;
};
