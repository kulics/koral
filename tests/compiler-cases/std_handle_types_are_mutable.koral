// EXPECT: shared lock handle
// EXPECT: shared channel handle
// EXPECT: shared random stream

// OS and sync handles are `type mutable`: assignment hands out the same object,
// so two bindings observe each other's state changes. They were declared `type`
// after the mutability migration, which claimed the sharing was unobservable.

using "std/sync" { Mutex, make_channel, SendChannel, RecvChannel };
using "std/rand" { Random, DefaultRandomSource, RandomSource };

let main() Int = {
    let m = Mutex.new();
    let alias = m;
    m.lock();
    if not alias.try_lock() then {
        println("shared lock handle");
    };
    m.unlock();

    let ch = make_channel[Int](4);
    let sender SendChannel[Int] = ch.first;
    let receiver RecvChannel[Int] = ch.second;
    sender.send(1) or else {
        return 1;
    };
    sender.send(2) or else {
        return 1;
    };
    if receiver.recv() is .Ok(1) then {
        if receiver.recv() is .Ok(2) then {
            println("shared channel handle");
        };
    };

    let r = Random[DefaultRandomSource].new(DefaultRandomSource.new());
    let r_alias = r;
    let first_draw = r.next_int(0..<1000);
    let second_draw = r_alias.next_int(0..<1000);
    if first_draw <> second_draw then {
        println("shared random stream");
    };
    return 0;
};
