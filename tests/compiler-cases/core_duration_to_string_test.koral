// EXPECT: dur_minute_ok
// EXPECT: dur_hour_ok
// EXPECT: dur_hour_min_ok
// EXPECT: dur_min_sec_ok
// EXPECT: dur_sec_only_ok
// EXPECT: dur_zero_ok
// EXPECT: dur_subsec_ok
// EXPECT: dur_frac_ok
// EXPECT: dur_frac_hm_ok
// EXPECT: dur_negative_ok

// Duration to_string: a zero seconds component is omitted once hours or
// minutes have been emitted ("1m", not "1m0s"; "1h", not "1h0s"; "1h1m").

let main(): Int = {
    let d1 = 60s.to_string();
    if d1 == "1m" then println("dur_minute_ok") else println("FAIL dur_minute: " + d1);

    let d2 = 3600s.to_string();
    if d2 == "1h" then println("dur_hour_ok") else println("FAIL dur_hour: " + d2);

    let d3 = 3660s.to_string();
    if d3 == "1h1m" then println("dur_hour_min_ok") else println("FAIL dur_hour_min: " + d3);

    let d4 = 90s.to_string();
    if d4 == "1m30s" then println("dur_min_sec_ok") else println("FAIL dur_min_sec: " + d4);

    let d5 = 45s.to_string();
    if d5 == "45s" then println("dur_sec_only_ok") else println("FAIL dur_sec_only: " + d5);

    let d6 = 0s.to_string();
    if d6 == "0s" then println("dur_zero_ok") else println("FAIL dur_zero: " + d6);

    let d7 = 500_000_000ns.to_string();
    if d7 == "500ms" then println("dur_subsec_ok") else println("FAIL dur_subsec: " + d7);

    let d8 = 1_500_000_000ns.to_string();
    if d8 == "1.5s" then println("dur_frac_ok") else println("FAIL dur_frac: " + d8);

    // The fractional second path keeps its leading "0" after h/m.
    let d9 = (3600s + 500_000_000ns).to_string();
    if d9 == "1h0.5s" then println("dur_frac_hm_ok") else println("FAIL dur_frac_hm: " + d9);

    let d10 = (0s - 60s).to_string();
    if d10 == "-1m" then println("dur_negative_ok") else println("FAIL dur_negative: " + d10);

    return 0;
};
