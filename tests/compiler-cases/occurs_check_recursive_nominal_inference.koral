// Regression: generic inference on recursive nominal values must not recurse
// forever inside occurs-check.
// EXPECT: 7
// EXPECT: 9
// EXIT: 0

type Node(
    value Int,
    next Option[* Node]
);

type IntList {
    Cons(head Int, tail * IntList),
    Nil(),
};

let identity[T Any](value T) T = value;

let head_or_zero(list IntList) Int = {
    return when list in {
        .Cons(head, _) then head,
        .Nil() then 0,
    };
};

let main() Int = {
    let node = identity(Node(7, Option[* Node].None()));
    println(node.value);

    let list = identity(IntList.Cons(9, box(IntList.Nil())));
    println(head_or_zero(list));

    return 0;
};
