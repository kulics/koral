// EXPECT: foreign borrow ok

// `borrow_ptr` / `borrow_mut_ptr` stay available for element types whose
// representation is fixed outside Koral's layout freedom -- the FFI-compatible
// case. `foreign` is a CLOSED set the compiler decides: built-in scalars,
// raw pointers, `foreign type` declarations and std's `Rune`. No user
// declaration can claim it.

let main() Int = {
    let bytes = List[UInt8].new();
    bytes.push(65);
    bytes.push(66);
    let ptr = bytes.borrow_ptr();
    if ptr == null_ptr[UInt8]() then {
        eprintln("FAIL: null borrow_ptr");
        return 1;
    };
    let _ = bytes.borrow_mut_ptr();

    let runes = List[Rune].new();
    runes.push('A');
    let _ = runes.borrow_ptr();

    println("foreign borrow ok");
    return 0;
};
