// EXPECT-ERROR: Panic: numeric conversion overflow
// +infinity has no truncatable integer value: the domain step panics before
// any range policy applies, on the plain family just as on the Wrapping one
// (wrapping_float_inf_domain_panic).

let main(): Void = {
    let x: Float64 = 1.0 / 0.0;
    let y: Int = Int(x);
    println(y);
};
