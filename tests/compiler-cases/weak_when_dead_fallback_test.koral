// EXPECT: PASS
// `?v` in `when` is refutable: the dead case must be caught by the `_` arm.
// Also verifies `is not ?v` reports the dead case.

type mutable Box(mutable value Int);

let make_dead() ?Box = {
    let tmp = Box(99);
    return ?Box(tmp);
};

let main() Int = {
    let w = make_dead();

    // when + ?v falls through to `_` when the object is dead
    let r = when w in {
        ?v then v.value,
        _ then -1,
    };
    if r <> -1 then {
        eprintln("FAIL: dead when ?v expected -1, got \(r)");
        return 1;
    };

    // is not ?v reports dead
    if w is not ?v then {
        // expected
    } else {
        eprintln("FAIL: dead handle reported alive");
        return 2;
    };

    // if-expression fallback on dead handle
    let value = if w is ?v then v.value else 0;
    if value <> 0 then {
        eprintln("FAIL: dead if ?v expected 0, got \(value)");
        return 3;
    };

    println("PASS");
    return 0;
};
