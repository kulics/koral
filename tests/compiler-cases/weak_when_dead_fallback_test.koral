// EXPECT: PASS
// `?w` upgrades a weak reference to `Option[T]`. A dead handle upgrades to
// `.None()` and falls through to the None arm.

type mutable Box(mutable value Int);

let make_dead() ?Box = {
    let tmp = Box(99);
    return ?Box(tmp);
};

let main() Int = {
    let w = make_dead();

    // when on a dead handle falls to .None()
    let r = when ?w in {
        .Some(v) then v.value,
        .None() then -1,
    };
    if r != -1 then {
        eprintln("FAIL: dead when ?w expected -1, got \(r)");
        return 1;
    };

    // if-expression fallback on dead handle
    let value = when ?w in {
        .Some(v) then v.value,
        .None() then 0,
    };
    if value != 0 then {
        eprintln("FAIL: dead when ?w expected 0, got \(value)");
        return 3;
    };

    println("PASS");
    return 0;
};
