// EXPECT: PASS

let id[T Any](x T) T = x

let read_ref(x *Int) Int = *x

let bump_ref(x *mutable Int) Void = {
    *x += 1
}

let main() Int = {
    let mutable value = 41

    // Through generic Any context, '&value' must still be accepted as *Int.
    let got = read_ref(id(&value))
    if got <> 41 then {
        eprintln("FAIL: expected read value 41, got \(got)")
        return 1
    }

    // Through generic Any context, '&mutable value' must still be accepted as *mutable Int.
    bump_ref(id(&mutable value))
    if value <> 42 then {
        eprintln("FAIL: expected bumped value 42, got \(value)")
        return 1
    }

    println("PASS")
    return 0
}
