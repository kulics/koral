// EXPECT: stem-a
// EXPECT: stem-b
// EXPECT: box-a:1
// EXPECT: box-b:2

// Two local modules with the same entry stem in different directories are
// two modules (§5.3.1). Before module identity was (source, entry position)
// they collapsed into one `Util` slot and the second `using` re-imported the
// first module's names.

using "./util/util.koral" { shared_tag as tag_a, LocalBox as BoxA };
using "./helpers/util.koral" { shared_tag as tag_b, LocalBox as BoxB };

let main(): Int = {
    println(tag_a());
    println(tag_b());
    let a: BoxA = BoxA(1);
    let b: BoxB = BoxB(2);
    println("box-a:" + a.v.to_string());
    println("box-b:" + b.v.to_string());
    return 0;
};
