// EXPECT: -1
// EXPECT: 0
// EXPECT: Full

// A negative number, an empty collection and `...` round-trip through the
// declaration's stored default expression.

type Counter(total: Int);

given Counter {
    offset(self, by: Int = -1): Int = self.total + by;
    empty(self, xs: List[Int] = []): UInt = xs.count();
    span(self, r: Range[Int] = ...): String = when r in {
        .Full() then "Full",
        _ then "Other",
    };
};

let main(): Int = {
    let c = Counter(0);
    println(c.offset());
    println(c.empty().to_string());
    println(c.span());
    return 0;
};
