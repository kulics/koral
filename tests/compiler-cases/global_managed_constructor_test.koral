// EXPECT: 0
// EXPECT: 7
// A managed generic constructor inside a global initializer: `new` must reach
// C as its instantiated entry point, not as a bare template call (the
// registered koralc global-initializer emission bug).
using "std" { ... };
using "std/sync" { ... };

let xs = List[Lazy[Int]].new();
let ys = List[List[Int]].new();

let main(): Void = {
    println(xs.count().to_string());
    let inner = List[Int].new();
    inner.push(7);
    ys.push(inner);
    println(ys.get(0).unwrap().get(0).unwrap().to_string());
};
