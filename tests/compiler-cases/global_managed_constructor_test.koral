// EXPECT: 0
// EXPECT: 7
// A managed generic constructor inside a global initializer: `new` must reach
// C as its instantiated entry point, not as a bare template call (the
// registered koralc global-initializer emission bug).
using "std" { ... };
using "std/sync" { ... };

/// Escape-hatch holder: a global's type must be sendable, while these
/// growable lists are thread-confined working state (the constructors still
/// run in the global initializer, which is what this regression pins).
type unsafe sendable mutable ManagedGlobals(
    mutable xs: List[Lazy[Int]],
    mutable ys: List[List[Int]],
);

let globals = ManagedGlobals(List[Lazy[Int]].new(), List[List[Int]].new());

let main(): Void = {
    println(globals.xs.count().to_string());
    let inner = List[Int].new();
    inner.push(7);
    globals.ys.push(inner);
    println(globals.ys.get(0).unwrap().get(0).unwrap().to_string());
};
