// EXPECT-ERROR: Panic: numeric conversion overflow
// Wrapping -> Regular with a width change is checked like any regular target:
// the Wrapping source's own arithmetic wraps, but a narrowing to a regular
// target that cannot hold the value panics rather than truncating.

let main(): Void = {
    let w: WrappingInt = WrappingInt(300);
    let a: UInt8 = UInt8(w);
    println(a);
};
