// EXPECT-ERROR: Match on type 'Int8' requires a wildcard or variable binding pattern
// Hex pattern literals contribute coverage by their VALUE: `< 0x0A` covers
// below 10 and `>= 0x0B` covers 11 up, so 10 is a gap and the match is not
// exhaustive. (A digit-skipping parse once read both as 0 and called this
// exhaustive.)

let f(x: Int8): Int = when x in {
    < 0x0A then 0,
    >= 0x0B then 1,
};

let main(): Int = {
    return f(Int8(5));
};
