// EXPECT: beep r2
// Naming the TRAIT opens its methods on every implementing type (§3.4).
// This is Rust's rule: "items from traits can only be used if the trait is in
// scope" -- and naming the trait is what puts it there.

using "std" { ... };
using "./lib.koral" { Robot };
using "./traits.koral" { Speak };

public let main() Int = {
    let r = Robot.new("r2");
    println(r.say());
    return 0;
};
