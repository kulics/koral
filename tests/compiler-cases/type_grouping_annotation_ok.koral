// EXPECT: 7
// EXPECT: 7
// EXPECT: 7
// Parentheses in a TYPE group exactly one type: `(*Int)` is `*Int` and
// `((Int) -> Int)` is `(Int) -> Int`. A prefix written outside the parens
// applies to the whole group: `*(Int)` groups `Int` first, then points at it.

let main(): Int = {
    let x = 7;
    let p: (*Int) = &x;
    println(*p);

    let f: ((Int) -> Int) = (v: Int) => v;
    println(f(7));

    let y = 7;
    let q: *(Int) = &y;
    println(*q);
    return 0;
};
