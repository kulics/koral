// EXPECT-ERROR: Expected identifier for pair let binding
// A `for` binding is a binding, not a match pattern. `?v`, `.Case(x)`,
// `Name(a, b)` and the rest of the pattern grammar belong to `is`/`when`.

type mutable Box(value Int);

let main() Int = {
    let b = Box(1);
    let w = ?Box(b);
    for ?v in [w] then {
        let z = 1;
    };
    return 0;
};
