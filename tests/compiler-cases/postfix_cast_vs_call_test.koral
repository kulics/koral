// EXPECT: 7
// `(` opens a postfix cast when the run inside is exactly a type and the base
// is not a type name, and an ordinary call otherwise. Decided by one bounded
// shape scan: `f(*p)` dereferences an argument (bare `*` is not a type start),
// while `Int(n)` is a cast.

let helper(x Int) Int = x;

let main() Int = {
    let n = 7;
    let m = Int(n);
    println(helper(m).to_string());
    return 0;
};
