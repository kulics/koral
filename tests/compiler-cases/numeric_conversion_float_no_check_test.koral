// EXPECT: ok
// EXPECT: PASS
// Integer -> float and float -> float are never checked: precision may be
// lost (|n| > 2^53) and a float narrowing may overflow to +-inf, but neither
// is an error.

let main(): Int = {
    let u: UInt = 18446744073709551615;
    let f1: Float64 = Float64(u);
    let f2: Float32 = Float32(u);
    let f3: Float32 = Float32(f1);
    let _ = f2;
    let _ = f3;
    println("ok");
    println("PASS");
    return 0;
};
