// EXPECT-ERROR: Type parameter 'T' requires a constraint
// A type parameter must carry at least one constraint. `[T]` is not a way to
// write "no constraints" -- the vacuous constraint is spelled `Any`:
//
//     let f[T Any](x T) Int = { ... }     // ok
//     let f[T](x T) Int = { ... }         // error
//
// Both compilers used to fail this with different words -- Swift fell through
// to the constraint parser and reported `Expected type identifier, got: ]`,
// while bootstrap reported the actual problem but appended a redundant
// ` at 1:11` that the diagnostic already carried. Both now say exactly this.

type Box[T Any](v T);

let f[T](x T) Int = {
    return 0;
};

let main() Int = {
    return 0;
};
