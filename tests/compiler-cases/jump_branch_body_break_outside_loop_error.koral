// EXPECT-ERROR: Invalid operation break outside of while
// A bare `break` branch body reports exactly what the block form reports:
// the sugar is a parse-time rewrite to a single-jump block, so the loop
// check sees the same shape either way.
let main(): Int = {
    let x = 1;
    when x in {
        1 then break,
        _ then {},
    };
    return 0;
};
