// EXPECT: start
// EXPECT: ref_ref_box_ok
// EXPECT: end
// EXPECT: Drop Tracker

type Tracker(id Int)

given Tracker as Drop {

    drop(source *raw mut Self) Void = {
        println("Drop Tracker")
    }
}

let main() Int = {
    println("start")

    let mut t = Tracker(9)
    let r * Tracker = &t
    let rr * * Tracker = box(r)

    if (*rr).id == 9 then {
        println("ref_ref_box_ok")
    } else {}

    println("end")
    return 0
}
