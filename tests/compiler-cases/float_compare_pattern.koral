// EXPECT: float compare ok

// Comparison patterns order floats against a float literal.

let main() Int = {
    let x = 1.5;
    let n = when x in {
        >= 1.5 then 1,
        _ then 2,
    };
    if n <> 1 then {
        eprintln("FAIL: 1.5 >= 1.5");
        return 1;
    };
    let m = when x in {
        < 1.5 then 1,
        <= -2.0 then 2,
        _ then 3,
    };
    if m <> 3 then {
        eprintln("FAIL: catch-all should take 1.5");
        return 1;
    };
    let t = when x in {
        > -1.5 then 1,
        _ then 0,
    };
    if t <> 1 then {
        eprintln("FAIL: 1.5 > -1.5");
        return 1;
    };
    println("float compare ok");
    return 0;
};
