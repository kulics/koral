// Test that 'type mutable' nested fields are always writable through non-mutable parent fields.
// With Java/Kotlin-like semantics, mutability is a property of the object, not the binding.
// A non-mutable field of a 'type mutable' type still allows writing to its mutable fields.
// EXPECT: 2

type mutable Inner(mutable x Int);
type Wrap(inner Inner);

let main() Int = {
    let mutable w = Wrap(Inner(1));
    w.inner.x = 2;
    println(w.inner.x.to_string());
    return 0;
};