// EXPECT: drop field access ok

// `self` as the base of a field read or write is a receiver use, not an escape.
// A field write needs the field to be `mutable`, so the type is `type mutable`.

type mutable File(mutable fd Int);

given File as Drop {
    drop(self) Void = {
        let n = self.fd;
        self.fd = n;
    };
};

let main() Int = {
    let f = File(7);
    println("drop field access ok");
    return 0;
};
