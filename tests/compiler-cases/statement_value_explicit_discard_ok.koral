// EXPECT: ok
// EXPECT: panic-done
//
// The explicit forms of dropping a statement value: bind it to `let _ = ...`.
// `Void` calls and diverging (`Never`) calls need no ceremony -- there is no
// value to drop.

let might_fail(n: Int): Result[Int] = {
    if n > 0 then {
        return .Ok(n);
    };
    return .Error("bad");
};

let void_call(): Void = {
    print("");
};

let main(): Int = {
    let _ = might_fail(1);
    void_call();
    if false then {
        panic("never taken");
    };
    println("ok");
    let _ = {
        println("panic-done");
        might_fail(2)
    };
    return 0;
};
