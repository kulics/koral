// EXPECT: and then over or else: 20
// Precedence INSIDE the flow layer is unchanged: `and then` binds tighter than
// `or else` / `or return`, so
//   opt and then as v in v * 10 or else 0
// is
//   (opt and then as v in v * 10) or else 0
// The transform runs first -- Some(20) -- and `or else 0` keeps it.

let main() Int = {
    let opt = Option[Int].Some(2);
    let v = opt and then as v in v * 10 or else 0;
    println("and then over or else: " + v.to_string());
    return 0;
};
