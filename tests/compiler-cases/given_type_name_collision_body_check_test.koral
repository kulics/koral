// EXPECT-ERROR: Type mismatch
// A `given` whose target TYPE shares its name with a trait elsewhere in the
// compilation (std/io's `Writer`) must still be checked as a TYPE-entity given.
// The bare name index is last-wins across modules and cannot answer "which
// `Writer`?": routing the declaration through it skipped body checking
// entirely -- a body of the wrong return type compiled clean.
type Writer(w: Int);

given Writer {
    public get(self): Int = "not an int";
};

let main(): Int = {
    println(Writer(7).get().to_string());
    return 0;
};
