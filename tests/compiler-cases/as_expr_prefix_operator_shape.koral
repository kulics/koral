// EXPECT-ERROR: '?' expects a weak reference (?T), got Int
// Expression-leading `?` is the weak-upgrade operator over the whole postfix
// chain: `?Foo.bar()` is `?(Foo.bar())`, so the operand is the Int result of
// the static call -- not a `(?Foo).bar()` shape.

type Foo();

given Foo {
    public bar(): Int = {
        return 7;
    };
};

let main(): Int = {
    let w = ?Foo.bar();
    return 0;
};
