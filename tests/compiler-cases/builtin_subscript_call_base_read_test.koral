// EXPECT: call_temp_read_ok
// A subscript read on an rvalue base (`make()[0]`, `"xyz".to_runes()[1]`)
// addresses the element through `__index_slot`, and the slot points INTO the
// base temporary. The base is bound in a let-block and the load runs in the
// block tail -- before the block's scope-exit drops the base. Deferred past
// the drops the read returns zeroed storage instead of the element.

let make(): List[Int] = {
    let mutable l = List[Int].new();
    l.push(7);
    l.push(8);
    return l;
};

let main(): Void = {
    let a = make()[0];
    let b = make()[1];
    let s = "xyz".to_runes()[1];
    let mutable l2 = make();
    if a == 7 and b == 8 and l2[0] == 7 and s == 'y' then {
        println("call_temp_read_ok");
    } else {
        println("FAIL call_temp_read: " + a.to_string() + " " + b.to_string());
    };
};
