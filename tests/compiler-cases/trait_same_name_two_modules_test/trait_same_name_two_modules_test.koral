// EXPECT: 7
// EXPECT: b7
// EXPECT: 7
// EXPECT: b7
// One type implementing TWO same-named traits from two modules. The traits are
// spelled `Tag` in alpha and beta alike; each conformance must land in its own
// (type, trait DECLARATION) slot, and the two trait objects must dispatch
// independently -- a name-keyed conformance or vtable slot collapses them and
// the second `given` either conflicts at declaration or overwrites the first.

using "trait_same_name_two_modules_test/alpha" { Tag as TagA };
using "trait_same_name_two_modules_test/beta" { Tag as TagB };

type Box(v: Int);

given Box: TagA {
    id(self): Int = self.v;
};

given Box: TagB {
    code(self): String = "b" + self.v.to_string();
};

let main(): Int = {
    let b = Box(7);
    // Direct calls along each conformance.
    println(b.id().to_string());
    println(b.code());
    // Trait-object dispatch through each trait, independently.
    let a: TagA = b;
    let c: TagB = b;
    println(a.id().to_string());
    println(c.code());
    return 0;
};
