// EXPECT-ERROR: Enum case 'Bogus' not found in type 'Shape'
// A dot-form pattern name is a struct destructure or a case of the subject;
// anything else names nothing and the seed throws at the `when`, before the
// arm's body and before the coverage check. One line per `when`, first miss
// wins (the `.Nope` behind `.Bogus` is never reached).

type Shape {
    Circle(r: Float64),
    Rectangle(w: Float64, h: Float64),
};

let f(s: Shape): Float64 = when s in {
    .Bogus(r) then r,
    .Nope(x) then x,
    .Circle(c) then c,
    .Rectangle(w, h) then w * h,
};
