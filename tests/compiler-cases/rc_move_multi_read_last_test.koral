// EXPECT: value=hello!
// EXPECT: value=xyxy
// EXPECT: merged=hello
// EXPECT: done

// Multi-read last-use move (concurrency-design.md P5): a local read several
// times still moves at its FINAL value read -- earlier reads copy, the last
// one forwards the +1. A use inside a branch does not disqualify the merge
// point: the merge use is the last one and moves.

let bang(s: String): String = s + "!";

let observe(s: String): Bool = s.count() == 5;

let main(): Void = {
    let a = "hello";
    let b = bang(a);
    let ok = observe(a);
    assert(ok, "observe");
    println("value=\(b)");

    let x = "xy";
    let y = x;
    let z = x;
    println("value=\(y)\(z)");

    let m = "hello";
    let mutable r = false;
    if true then {
        r = observe(m);
    } else {
        r = false;
    };
    assert(r, "branch");
    println("merged=\(m)");
    println("done");
};
