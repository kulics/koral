// EXPECT-EXACT: 9

trait ManagedKeep {
    keep(self ref Self) ref Self
}

type Counter(mut value Int)

given Counter as ManagedKeep {
    public keep(self ref Self) ref Self = self
}

let keep_generic[T ManagedKeep](value ref T) ref T = value.keep()

let main() Int = {
    let strong ref mut Counter = box(Counter(9))
    let alias ref Counter = keep_generic(strong)
    println(alias.val.value.to_string())
    return 0
}