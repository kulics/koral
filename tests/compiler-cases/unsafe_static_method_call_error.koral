// EXPECT-ERROR: Cannot call unsafe function 'make' outside an 'unsafe' block: the declaration is marked 'unsafe'.
// A static/associated method carries its `unsafe` marker like any other callee
// (unsafe-design.md §B1): the call gate keys on the declaration's marker, not
// on the call shape. Calling `Box.make()` outside an `unsafe` block is refused
// exactly as the instance form `b.peek()` is.

type Box(v: Int);

given Box {
    unsafe make(): Box = Box(1);
};

let main(): Int = {
    let b = Box.make();
    let _ = b;
    return 0;
};
