// EXPECT-ERROR: Unknown named argument 'wrong' for 'combine'

// Labels on generic method calls must be validated, not silently dropped.

type Box[T Any](value T);

given[T Any] Box[T] {
    public combine(self, other: T, tag: Int) Int = tag;
};

let main() Int = {
    let b = Box(1);
    return b.combine(other: 2, wrong: 3);
};
