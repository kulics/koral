// EXPECT: PASS
// The Wrapping family masks the shift amount modulo the width -- a wrapped
// answer exists, so it wraps instead of panicking. `WrappingInt8(1) << 9`
// masks 9 to 1 and yields 2. The plain family keeps the checked panic
// (checked_shift_invalid); bits shifted out of the width are discarded the
// same way in both.

let main(): Int = {
    // 9 & 7 == 1: the amount wraps into the width.
    let one8: WrappingInt8 = 1;
    if not ((one8 << 9) == 2) then {
        eprintln("FAIL: WrappingInt8(1) << 9 != 2");
        return 1;
    };

    // Right shift masks the same way, arithmetic fill on the signed width.
    let neg8: WrappingInt8 = -8;
    if not ((neg8 >> 9) == -4) then {
        eprintln("FAIL: WrappingInt8(-8) >> 9 != -4");
        return 1;
    };

    // A second width: 20 & 15 == 4 on WrappingUInt16.
    let one16: WrappingUInt16 = 1;
    if not ((one16 << 20) == 16) then {
        eprintln("FAIL: WrappingUInt16(1) << 20 != 16");
        return 1;
    };

    // Unsigned right shift fills with zeros after masking.
    let top8: WrappingUInt8 = 192;
    if not ((top8 >> 9) == 96) then {
        eprintln("FAIL: WrappingUInt8(192) >> 9 != 96");
        return 1;
    };

    // Compound assignment masks on the same surface.
    let mutable acc: WrappingUInt8 = 1;
    acc <<= 9;
    if not (acc == 2) then {
        eprintln("FAIL: WrappingUInt8(1) <<= 9 != 2");
        return 1;
    };

    println("PASS");
    return 0;
};
