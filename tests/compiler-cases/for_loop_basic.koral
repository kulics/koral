// Test for loop basic functionality with List, Dict, and Set

// EXPECT: List iteration:
// EXPECT: 10
// EXPECT: 20
// EXPECT: 30
// EXPECT: List sum: 60
// EXPECT: Dict iteration:
// EXPECT: a -> 1
// EXPECT: b -> 2
// EXPECT: Set iteration:
// EXPECT: 100
// EXPECT: 200
// EXPECT: 300
// EXPECT: Set sum: 600
// EXPECT: All basic for loop tests passed

let main(): Void = {
    // Test 1: List iteration
    println("List iteration:");
    let mutable list = List[Int].new();
    list.push(10);
    list.push(20);
    list.push(30);

    let mutable sum = 0;
    for x in list then {
        println(x);
        sum = sum + x;
    };
    print("List sum: ");
    println(sum);
    assert(sum == 60, "list sum");

    // Test 2: Dict iteration (the walk visits every entry; the order is
    // unspecified -- it follows the per-process hash seed -- so the lines
    // are collected and printed sorted)
    println("Dict iteration:");
    let mutable map = Dict[String, Int].new();
    map.insert("a", 1);
    map.insert("b", 2);

    let mutable mapSum = 0;
    let mutable mapLines = List[String].new();
    for entry in map then {
        mapLines.push("\(entry.first) -> \(entry.second)");
        mapSum = mapSum + entry.second;
    };
    mapLines.sort();
    for line in mapLines then {
        println(line);
    };
    assert(mapSum == 3, "map sum");

    // Test 3: Set iteration (order unspecified; printed sorted)
    println("Set iteration:");
    let mutable set = Set[Int].new();
    set.insert(100);
    set.insert(200);
    set.insert(300);

    let mutable setSum = 0;
    let mutable values = List[Int].new();
    for v in set then {
        values.push(v);
        setSum = setSum + v;
    };
    values.sort();
    for v in values then {
        println(v);
    };
    print("Set sum: ");
    println(setSum);
    assert(setSum == 600, "set sum");

    println("All basic for loop tests passed");
};
