// EXPECT: 42
// EXPECT: 1
// `b as ?Box` wraps a managed object in a weak handle (a handle wrap, not a
// bit reinterpretation). `?w` upgrades the handle to `Option[Box]` --
// `.Some(v)` while the object is alive, `.None()` once it is dead -- and `is`
// tests that upgrade while binding the live referent.

type mutable Box(mutable value Int);

let main() Int = {
    let b = Box(42);
    let w = b as ?Box;

    // ?w upgrade to Option
    let r = when ?w in {
        .Some(v) then v.value,
        .None() then -1,
    };
    println(r);

    // is on the upgraded handle
    if ?w is .Some(v) then {
        println(1);
    } else {
        println(0);
    };
    return 0;
};
