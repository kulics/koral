// EXPECT: (1, 2)
// The flip side of the explicit-private pin: a `private` requirement impl
// still SERVES the trait. Dispatch goes through the requirement (public with
// the trait), never through the impl's own access.
using "./traits.koral" { Show };
using "./lib.koral" { Point };

let render(s: Show): String = s.show();

public let main(): Int = {
    let p = Point.new(1, 2);
    println(render(p));
    return 0;
};
