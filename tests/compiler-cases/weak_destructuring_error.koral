// EXPECT-ERROR: Cannot match a pattern against a weak reference: upgrade it first
// Positional destructuring tests the subject's SHAPE, and a weak handle has
// none until it is upgraded. Binding the handle whole is fine.

type mutable Box(mutable value Int);
type mutable Pair2(mutable first ?Box, mutable second Int);

let main() Int = {
    let b = Box(42);
    let w = b as ?Box;
    let p = Pair2(w, 7);
    let wp = p as ?Pair2;
    let (x, y) = wp;
    let _ = x;
    let _ = y;
    return 0;
};
