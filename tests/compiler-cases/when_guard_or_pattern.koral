// EXPECT: guard or pattern ok

// A guard on an or-pattern arm sees the names both sides bind.

let label(x Int) String = when x in {
    1 or 2 if x == 1 then "one",
    1 or 2 then "two-ish",
    _ then "other",
};

let main() Int = {
    if label(1) <> "one" then {
        eprintln("FAIL: guarded or arm first match");
        return 1;
    };
    if label(2) <> "two-ish" then {
        eprintln("FAIL: or arm after guard fell through");
        return 1;
    };
    if label(9) <> "other" then {
        eprintln("FAIL: wildcard");
        return 1;
    };
    println("guard or pattern ok");
    return 0;
};
