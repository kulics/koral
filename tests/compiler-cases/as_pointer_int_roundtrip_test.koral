// EXPECT: 42
// EXPECT: true
// `as` reinterprets a pointer as an integer address and an address back as a
// pointer: `p as UInt` / `u as *Int`. The roundtrip is bit-preserving -- the
// recovered pointer still addresses the original cell.

let main() Int = {
    let p = alloc_memory[Int](1);
    init_memory(p, 42);

    // pointer -> integer address
    let u UInt = p as UInt;

    // integer address -> pointer
    let p2 *Int = u as *Int;
    println(*p2);

    // the roundtrip address is the original address
    println((p2 as UInt) == u);

    dealloc_memory(p2);
    return 0;
};
