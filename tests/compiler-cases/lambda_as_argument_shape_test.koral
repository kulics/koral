// EXPECT: 2
// EXPECT: 4
// EXPECT: 6
// A lambda argument is decided by SHAPE -- `(params) [Type] -> ...`, with the
// `->` as the tell -- not by parsing the whole lambda speculatively and rolling
// back if it fails. This form (single untyped parameter, trailing comma, on its
// own line) is the one a trial parse used to mis-read as a parenthesized
// expression followed by a stray `->`.

using "std";

let main() Int = {
    let xs = List[Int].new();
    xs.push(1);
    xs.push(2);
    xs.push(3);
    let doubled = xs.map(
        (n) -> n * 2,
    );
    for v in doubled then {
        println(v.to_string());
    };
    return 0;
};
