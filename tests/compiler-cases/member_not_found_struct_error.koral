// A member that is neither a field nor a method must be a diagnostic.
// It used to type-check as `Unknown` and lower to a C struct-field access
// followed by a closure call, so a typo surfaced as a pile of clang errors.

// EXPECT-ERROR: Member 'nope' not found in type 'Foo'

type Foo(x Int);

let main() Void = {
    let f = Foo(1);
    let v = f.nope;
    println(v.to_string());
};
