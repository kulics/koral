// EXPECT: count=400000

// Cross-thread counter through AtomicCell.update_and_get: 8 threads each perform
// 50000 combining increments. Every update is one linearizable step, so the
// final count is exactly 400000 -- this is the atomic read-modify-write that
// plain `+=` and `x.f = x.f + 1` do NOT give (they are two non-atomic steps
// and lose updates).

using "std/async" { ... };
using "std/sync" { ... };

let main(): Void = {
    let cell = AtomicCell[Int].new(0);
    let mutable threads = List[Thread].new();
    let mutable i = 0;
    while i < 8 then {
        let shared = cell;
        threads.push(
            run_task(
                () => {
                    let mutable j = 0;
                    while j < 50000 then {
                        shared.update_and_get((v: Int): Int => v + 1);
                        j = j + 1;
                    };
                },
            ),
        );
        i = i + 1;
    };
    for t in threads then {
        let _ = t.wait();
    };
    println("count=\(cell.get())");
};
