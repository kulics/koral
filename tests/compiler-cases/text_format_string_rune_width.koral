// std.text: String.format width counts runes and pads to the rune count.
// EXPECT: cjk_width_ok
// EXPECT: ascii_width_ok
// EXPECT: cjk_fill_right_ok
// EXPECT: cjk_truncate_width_ok
// EXPECT: empty_width_ok

using "std/text" { ... };

let main(): Int = {
    // "你好" is two runes; width 5 pads three spaces
    if "你好".format("5").equals("你好   ") then println("cjk_width_ok")
    else println("FAIL cjk_width: [" + "你好".format("5") + "]");

    // ASCII is unchanged
    if "ab".format("5").equals("ab   ") then println("ascii_width_ok")
    else println("FAIL ascii_width: [" + "ab".format("5") + "]");

    // Rune width with a multi-byte fill
    if "你好".format("·>5").equals("···你好") then println("cjk_fill_right_ok")
    else println("FAIL cjk_fill_right: [" + "你好".format("·>5") + "]");

    // Truncate to two runes, then pad to width 3
    if "你好世界".format("3.2").equals("你好 ") then println("cjk_truncate_width_ok")
    else println("FAIL cjk_truncate_width: [" + "你好世界".format("3.2") + "]");

    if "".format("3").equals("   ") then println("empty_width_ok")
    else println("FAIL empty_width: [" + "".format("3") + "]");

    return 0;
};
