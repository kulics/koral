// EXPECT: 110
// EXPECT: 100
// EXPECT: 200
// EXPECT: 100
// EXPECT: 1
// EXPECT: 11

type Point(mutable x Int, y Int)

let main() Int = {
    let mutable a = 100
    a += 10
    println(a)// 110
    
    a -= 10
    println(a)// 100
    
    a *= 2
    println(a)// 200
    
    a /= 2
    println(a)// 100
    
    a %= 3
    println(a)// 1
    
    let mutable p = Point(10, 20)
    p.x += 1
    println(p.x)// 11
    
    return 0
}
