// A call that textually PRECEDES the `given` implementing the method must
// see the same accessibility as one that follows it: member visibility
// metadata is registered in the signature pass, before any body is checked.
// The seed is order-robust; this pins main's pre-stamp (given-after-use used
// to report "Cannot access internal method 'render'", given-before-use was
// clean).
// EXPECT: boom

trait Problem {
    render(self): String;
};

type PreviewIoError(msg: String);

let main(): Int = {
    let e: Problem = PreviewIoError("boom");
    if e is io: PreviewIoError then println(io.render());
    return 0;
};

given PreviewIoError: Problem {
    render(self): String = self.msg;
};
