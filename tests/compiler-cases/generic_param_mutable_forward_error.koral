// EXPECT-ERROR: does not satisfy the 'mutable' constraint

// A generic parameter gets no free pass on a shape bound: `T` satisfies
// `T mutable` only if its own declaration says so. Otherwise `f[T Any]` could
// satisfy a `g[T mutable]` requirement by forwarding its own unconstrained `T`.

type mutable Counter(mutable value Int, id UInt);

let needs_mutable[T mutable](x T) Int = {
    return 1;
};

let forward[T Any](x T) Int = {
    return needs_mutable(x);
};

let main() Int = {
    return forward(Counter(0, 1));
};
