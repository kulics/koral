// EXPECT: struct ok
// EXPECT: opaque ok
// EXPECT: foreign type cname tests passed
// The C-name slot on `type foreign`: the declaration's name in the C world --
// the struct tag for the struct form, the C type's own spelling for the
// opaque form. The Koral name keeps serving Koral code; each side calls its
// own name.

type foreign "timespec" KoralTimespec(tv_sec: Int64, tv_nsec: Int64);
type foreign "FILE" CFile {};
type foreign PlainHandle {};

let main(): Void = {
    let mutable t = KoralTimespec(Int64(1), Int64(2));
    t.tv_sec = Int64(3);
    if t.tv_sec == Int64(3) and t.tv_nsec == Int64(2) then {
        println("struct ok");
    } else {
        println("FAIL struct");
    };

    let f: *CFile = null;
    let h: *PlainHandle = null;
    if f == null and h == null then {
        println("opaque ok");
    } else {
        println("FAIL opaque");
    };
    println("foreign type cname tests passed");
};
