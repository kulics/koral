// EXPECT-ERROR: Variable bindings in 'is' expression are only allowed in if/while conditions

trait Problem {
    render(*self) Int
}

type ProbeIoError(value Int)

given ProbeIoError as Problem {

    render(*self) Int = self.value
}

let main() Int = {
    let err *Problem = box(ProbeIoError(7))
    let _ = err is io *ProbeIoError
    return 0
}