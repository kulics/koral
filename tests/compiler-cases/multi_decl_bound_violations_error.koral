// Three independent bound violations in three declarations are three
// diagnostics, not one: each declaration is its own unit of recovery, and
// the reader has to see every broken one -- fixing the first must not hide
// the rest. Both compilers report the same three, in declaration order.
// EXPECT-ERROR: multi_decl_bound_violations_error.koral:15:15: error: Type Int does not explicitly implement trait Blah (checking constraint T: Blah)
// EXPECT-ERROR: multi_decl_bound_violations_error.koral:17:15: error: Type Int does not explicitly implement trait Blah (checking constraint T: Blah)
// EXPECT-ERROR: multi_decl_bound_violations_error.koral:19:15: error: Type Int does not explicitly implement trait Blah (checking constraint T: Blah)

using "std/math" { ... };

trait Blah { };

let want[T Blah](x T) Int = 1;

let f() Int = want(3);

let g() Int = want(4);

let h() Int = want(5);

let main() Int = 0;
