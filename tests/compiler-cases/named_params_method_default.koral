// EXPECT: 15
// EXPECT: 30

// Instance methods support declared default values on named parameters.

type Calc(base Int);

given Calc {
    public add(self, value Int, multiplier: Int = 1) Int = (self.base + value) * multiplier;
};

let main() Int = {
    let c = Calc(10);
    // default fill
    println(c.add(5).to_string());
    // explicit override
    println(c.add(5, multiplier: 2).to_string());
    return 0;
};
