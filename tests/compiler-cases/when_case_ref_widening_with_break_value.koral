// EXPECT: ok

type Cell(value Int)

let read(cell * Cell) Int = cell.value

let main() Void = {
    let m *mutable Cell = box(Cell(2))
    let fallback * Cell = m
    let selected = when true in {
        true then {
            break box(Cell(1))
        },
        false then fallback,
    }

    assert(read(selected) == 1, "selected value")
    println("ok")
}
