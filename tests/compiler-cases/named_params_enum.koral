// EXPECT: 35
// EXPECT: 11

type Shape {
    Circle(radius Int),
    Rect(width Int, height Int),
}

let main() Int = {
    let a = Shape.Rect(height: 7, width: 5)
    when a in {
        .Rect(height: h, width: w) then println(w * h),
        .Circle(radius: r) then println(r),
    }

    let b = Shape.Circle(radius: 11)
    if b is .Circle(radius: r) then {
        println(r)
    }
    return 0
}
