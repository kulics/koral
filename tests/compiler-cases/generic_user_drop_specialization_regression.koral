// EXPECT: start
// EXPECT: Holder dropped
// EXPECT: Holder dropped
// EXPECT: end

type Holder[T: Any](raw_val: *mutable T);

given[T: Any] Holder[T]: Drop {
    drop(self): Void = {
        println("Holder dropped");
    };
};

let main(): Int = {
    println("start");
    {
        let a = Holder[Int](null);
        let b = Holder[UInt8](null);
    };
    println("end");
    return 0;
};
