// EXPECT-ERROR: Panic: numeric conversion overflow at
// Narrow widths follow the same rule: Int8 -1 does not become UInt8 255 by
// bit reinterpretation -- it is a value conversion and -1 is out of range.

let main(): Void = {
    let b: Int8 = -1;
    let ub: UInt8 = UInt8(b);
    println(ub);
};
