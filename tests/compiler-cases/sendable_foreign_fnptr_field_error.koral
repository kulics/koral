// EXPECT-ERROR: sendable type 'Cb' cannot have non-sendable field 'cb'
// Foreign function types are raw C pointers (never sendable), so they follow
// foreign composites out of safe `sendable` interiors
// (sendable_foreign_field_error; concurrency-design.md §派生规则 8-9).

type sendable Cb(cb: foreign (Int32) -> Int32);
