type Box[T Any](mutable value T)

given[T Any] Box[T] {
    get_val(*self) T = self.value
    
    set_val(*mutable self, v T) Void = {
        self.value = v
    }
}

let main() Void = {
    let mutable b = Box[Int](10)
    println(b.get_val())
    b.set_val(20)
    println(b.get_val())
}
// EXPECT: 10
// EXPECT: 20
