// EXPECT-ERROR: it is the entry of registered module
//
// §3.1 module-design.md ("路径指向已登记入口时报错并给名字", 2026-11-12 落地):
// the path form of a merge must not swallow a REGISTERED module's entry file --
// that is spelled by name (`using "pkg/child";`). The check fires at resolve
// time regardless of which module resolves first; an unregistered helper file
// still merges by path (using_relative_merge_path_test).
using "./child/child.koral";

let main(): Void = {
    println("should not get here");
};
