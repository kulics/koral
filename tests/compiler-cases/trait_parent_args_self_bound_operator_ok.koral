// EXPECT: 7

trait MyNumeric Add[Self] {}

type Num(value Int)

given Num as Add[Num] {

    add(self, other Num) Self = Num(self.value + other.value)
}

given Num as MyNumeric {}

let sum_pair[T MyNumeric](a T, b T) T = a + b

let main() Int = {
    let result = sum_pair(Num(3), Num(4))
    println(result.value)
    return 0
}