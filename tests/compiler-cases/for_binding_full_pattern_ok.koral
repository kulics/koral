// A `for` binding takes the full match grammar -- the same pattern a `when`
// arm takes -- as long as the result is irrefutable. Struct, tuple, nested and
// wildcard bindings all qualify; a refutable one is a compile error.
// EXPECT: for_struct_ok
// EXPECT: for_tuple_ok
// EXPECT: for_nested_ok
// EXPECT: for_wildcard_ok
// EXPECT: for_mutable_ok

using "std";

type Point(x Int, y Int, z Int);
type Outer(a Int, b Inner);
type Inner(c Int, d Int);

let main() Int = {
    let pts = List[Point].new();
    pts.push(Point(1, 2, 3));
    pts.push(Point(4, 5, 6));

    let mutable sum = 0;
    for Point(x, y, z) in pts then {
        sum += x + y + z;
    };
    if sum == 21 then {
        println("for_struct_ok");
    };

    let mutable tsum = 0;
    for (a, b, c) in pts then {
        tsum += a + c;
    };
    if tsum == 14 then {
        println("for_tuple_ok");
    };

    let os = List[Outer].new();
    os.push(Outer(1, Inner(2, 3)));
    let mutable nsum = 0;
    for Outer(a, (c, d)) in os then {
        nsum += a + c + d;
    };
    if nsum == 6 then {
        println("for_nested_ok");
    };

    let mutable count = 0;
    for _ in pts then {
        count += 1;
    };
    if count == 2 then {
        println("for_wildcard_ok");
    };

    let mutable total = 0;
    for mutable n in pts then {
        n = Point(0, 0, 1);
        total += n.z;
    };
    if total == 2 then {
        println("for_mutable_ok");
    };

    return 0;
};
