// EXPECT-ERROR: Undefined variable: it (there is no implicit flow binding; name the payload with 'as name in ...')
//
// `it` is an ordinary identifier now, so a leftover one is simply undefined.
// The diagnostic points at the form that does name the payload.

let main(): Int = {
    let o: Option[String] = Option[String].Some("x");
    let v = o or else {
        eprintln(it);
        "y"
    };
    let _ = v;
    return 0;
};
