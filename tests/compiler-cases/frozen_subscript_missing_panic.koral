// EXPECT-ERROR: Panic: Dict key not found
// Missing-key frozen subscript panics exactly like the mutable `Dict` one.

using "std" { ... };

let main(): Int = {
    let map_source = Dict[String, Int].new();
    map_source.insert("a", 1);
    let frozen = map_source.to_frozen_dict();
    let x = frozen["missing"];
    return x;
};
