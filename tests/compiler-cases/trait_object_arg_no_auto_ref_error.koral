// EXPECT-ERROR: Type mismatch: expected *Int, got Int

trait TmpReader {
    read(*self, x * Int) Int
}

type TmpBoxed(value Int)

given TmpBoxed as TmpReader {

    public read(*self, x * Int) Int = x
}

let main() Int = {
    let b = box(TmpBoxed(0))
    let r * TmpReader = b
    let x = 42
    let _ = r.read(x)
    return 0
}