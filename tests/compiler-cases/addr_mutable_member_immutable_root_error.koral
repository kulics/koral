// EXPECT-ERROR: Cannot take '&mutable' from immutable binding 'v'
// The field is a mutable slot, but the value it lives in is an immutable
// binding -- the mutation matrix decides, not the field.

type foreign Box(v: Int32);

let main(): Int = {
    let b = Box(Int32(0));
    let p: *mutable Int32 = &mutable b.v;
    let _ = p;
    return 0;
};
