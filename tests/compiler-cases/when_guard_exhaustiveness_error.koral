// EXPECT-ERROR: Non-exhaustive match on type 'Color': missing cases .Red

// A guarded arm covers nothing: `.Red if ...` does not count toward
// exhaustiveness, so `.Red` is still missing.

type Color {
    Red(),
    Green(),
    Blue(),
};

let main(): Int = {
    let c = Color.Red();
    let n = when c in {
        .Red() where true then 1,
        .Green() then 2,
        .Blue() then 3,
    };
    return n;
};
