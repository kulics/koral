// EXPECT: given_instance_basic_ok
// EXPECT: given_instance_disjoint_ok
// EXPECT: given_instance_shadow_ok

// A `given` whose target is a concrete instantiation of a generic type
// (`given Box[Int] { ... }`) declares methods for exactly that instantiation --
// rustc's `impl` on a concrete instantiation, not on every instantiation.
// Disjoint instantiations may declare the same method name, and an instance
// method shadows a same-named generic-given method for its instantiation alone.

type Box[T: Any](value: T);

given Box[Int] {
    public doubled(self): Int = self.value * 2;
};

type Crate[T: Any](value: T);

given Crate[Int] {
    public kind(self): String = "int";
};

given Crate[String] {
    public kind(self): String = "string";
};

given[T: Any] Crate[T] {
    public generic_kind(self): String = "generic";
};

given Crate[Int] {
    public generic_kind(self): String = "int-specialized";
};

let main(): Void = {
    assert(Box[Int](21).doubled() == 42, "instance method");
    println("given_instance_basic_ok");

    assert(Crate[Int](1).kind() == "int", "disjoint instance int");
    assert(Crate[String]("s").kind() == "string", "disjoint instance string");
    println("given_instance_disjoint_ok");

    assert(Crate[Int](1).generic_kind() == "int-specialized", "instance shadows generic");
    assert(Crate[String]("s").generic_kind() == "generic", "generic serves other instances");
    println("given_instance_shadow_ok");
};
