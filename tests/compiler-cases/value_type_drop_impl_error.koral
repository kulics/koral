// EXPECT-ERROR: Only a 'type mutable' can implement Drop
//
// Drop's cleanup lives only on the ARC layer: a `type` (value nominal)
// promises no identity -- same-field values are interchangeable -- and a user
// `drop` body would leak construction identity through the destructor count.
// Its cleanup is the synthesized field release. Declare the type
// `type mutable` to give it a destructor that runs once at RC-0.

type Tracker(value: Int);

given Tracker: Drop {

    drop(self): Void = {
        println("drop");
    };
};

let main(): Void = {
    let t = Tracker(1);
};
