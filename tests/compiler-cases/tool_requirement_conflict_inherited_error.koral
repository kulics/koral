// EXPECT-ERROR: conflicts with requirement
// A trait TOOL named like a requirement of the trait -- own OR inherited -- is
// a definition conflict, not a priority contest: the two would answer one name
// in one vtable face. `Child` inherits `p` from `Parent`, so `given Child { p }`
// is exactly the conflict `given Child { ... }` with an own `p` would be --
// the requirement walk must include parents.

trait Parent {
    p(self): Int;
};

trait Child: Parent {};

given Child {
    p(self): Int = 1;
};

let main(): Int = {
    return 0;
};
