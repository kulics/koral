// A construction blames its CALL for an argument literal's range violation:
// the seed fits construction arguments after they are checked and names the
// construct it is inside, while `let x UInt8 = 300` and `f(300)` still blame
// the literal. Struct, generic-struct and enum-case constructions all point
// at the call, in declaration order.
// EXPECT-ERROR: lower_constructor_range_check_call_span_error.koral:19:13: error: Integer literal 300 is out of range for UInt8
// EXPECT-ERROR: lower_constructor_range_check_call_span_error.koral:24:13: error: Integer literal 70000 is out of range for UInt16
// EXPECT-ERROR: lower_constructor_range_check_call_span_error.koral:29:13: error: Integer literal 500 is out of range for UInt8

type Point(x: UInt8, y: Int);

type Box[T: Any](v: UInt16);

type E {
    Case(v: UInt8),
};

let f1(): Int = {
    let p = Point(300, 0);
    return 0;
};

let f2(): Int = {
    let b = Box[Int](70000);
    return 0;
};

let f3(): Int = {
    let e = E.Case(500);
    return 0;
};
