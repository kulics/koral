// EXPECT-ERROR: lower_static_owner_type_args_error.koral:16:14: error: Type mismatch: expected 1 type arguments, got 0
// EXPECT-ERROR: lower_static_owner_type_args_error.koral:21:13: error: Type mismatch: expected 2 type arguments, got 0
// A static call spelled without type arguments pins its owner's type
// parameters from the call's OWN arguments -- an expected type never names
// them. `List.new()` alone and `L.new(5)` (whose argument pins only one of
// two owner parameters) are both "expected N type arguments, got 0" at the
// call, in declaration order.

type L[A: Any, B: Any](a: A);

given[A: Any, B: Any] L[A, B] {
    new(x: A): Self = L[A, B](x);
};

let f1(): Int = {
    let xs = List.new();
    return 0;
};

let f2(): Int = {
    let l = L.new(5);
    return 0;
};
