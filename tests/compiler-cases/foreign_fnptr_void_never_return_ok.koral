// EXPECT: ok
// `Void` / `Never` are legal in RETURN position: a C function pointer to a
// void-returning or noreturn function.

let main(): Int = {
    let v: foreign (Int32) -> Void = null;
    let n: foreign () -> Never = null;
    if v == null then {
        if n == null then {
            println("ok");
        };
    };
    return 0;
};
