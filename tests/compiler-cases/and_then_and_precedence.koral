// EXPECT-ERROR: Type mismatch

let main() Int = {
    let opt = Option[Int].Some(1);
    // With the new precedence this parses as:
    //   (opt and then (it == 1)) and false
    // which is invalid because `and` expects Bool on both sides.
    // Under the old precedence it would parse as:
    //   opt and then ((it == 1) and false)
    // which would be well-typed.
    let value = opt and then it == 1 and false;
    let _ = value;
    return 0;
};