// EXPECT-ERROR: Duplicate definition: pick
// The reverse spelling of given_instance_method_generic_overlap_error: the
// instance member is the method-generic one. Its name is still scoped to the
// instantiation and still may not collide with a generic given's.

type Box[T: Any](value: T);

given Box[Int] {
    public pick[U: Any](self, a: U, b: U): U = a;
};

given[T: Any] Box[T] {
    public pick(self): Int = 1;
};

let main(): Int = {
    return 0;
};
