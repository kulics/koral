// EXPECT: export definition ok
// Body presence turns a `let foreign` into a C ABI export (cffi-design.md §B):
// callable from Koral like any function, and its name inhabits
// `foreign (A) -> R` -- the bare C function pointer -- for callbacks.

let foreign add_one(x: Int32): Int32 = {
    return x + Int32(1);
};

let foreign apply_twice(f: foreign (Int32) -> Int32, x: Int32): Int32 = {
    return f(f(x));
};

let main(): Int = {
    assert(add_one(Int32(1)) == Int32(2), "direct call into the export");
    let f: foreign (Int32) -> Int32 = add_one;
    assert(f(Int32(41)) == Int32(42), "the export inhabits a C function pointer");
    assert(apply_twice(add_one, Int32(0)) == Int32(2), "passed to C as a callback");
    println("export definition ok");
    return 0;
};
