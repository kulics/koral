// EXPECT: 8

trait CounterOps {
    peek(*self) Int
}

type Counter(mut value Int)

given Counter as CounterOps {

    public peek(*self) Int = self.value
}

let expose_readonly(counter *mut CounterOps) * CounterOps = counter

let main() Int = {
    let strong *mut Counter = box(Counter(8))
    let readonly = expose_readonly(strong)
    println(readonly.peek().to_string())
    return 0
}