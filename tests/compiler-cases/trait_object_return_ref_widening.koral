// EXPECT: 8

trait CounterOps {
    peek(self) Int;
};

type mutable Counter(mutable value Int);

given Counter as CounterOps {

    public peek(self) Int = self.value;
};

let expose_readonly(counter CounterOps) CounterOps = counter;

let main() Int = {
    let strong Counter = Counter(8);
    let readonly = expose_readonly(strong);
    println(readonly.peek().to_string());
    return 0;
};