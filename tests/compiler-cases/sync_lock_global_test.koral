// EXPECT: lock_global_ok

// Module-level `let mutable` globals follow the field protocol
// (concurrency-design.md §对象锁语义的全局量落点): reads and writes wrap in
// the variable's own sync (atomic for scalar slots), the RHS runs outside it,
// and `g = g + 1` is therefore TWO accesses -- concurrent increments lose
// updates by design. This pins race-free, bounded hammering; the exact-count
// story lives in sync_atomic_cell_update_counter_test.

using "std/async" { ... };

let mutable g: Int = 0;

let main(): Void = {
    let mutable threads = List[Thread].new();
    let mutable i = 0;
    while i < 8 then {
        threads.push(
            run_task(
                () => {
                    let mutable j = 0;
                    while j < 50000 then {
                        g = g + 1;
                        j = j + 1;
                    };
                },
            ),
        );
        i = i + 1;
    };
    for t in threads then {
        let _ = t.wait();
    };
    assert(g >= 1, "global made progress");
    assert(g <= 400000, "no value past the naive sum");
    println("lock_global_ok");
};
