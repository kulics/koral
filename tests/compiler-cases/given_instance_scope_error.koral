// EXPECT-ERROR: Member 'doubled' not found
// A method declared for one instantiation is invisible on every other
// instantiation of the same generic type.

type Box[T: Any](value: T);

given Box[Int] {
    public doubled(self): Int = self.value * 2;
};

let main(): Int = {
    let f = Box[Float64](1.5);
    return f.doubled();
};
