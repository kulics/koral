// EXPECT: 1 1 2 3 2 3
// EXPECT: empty insert is a no-op

// `List.insert_list_at` must survive `other` being `self`. The shift below the
// insertion point used to overwrite the elements the copy loop was still
// reading, because after the `type mutable` migration a parameter is a shared
// handle, not an independent copy.

let main(): Int = {
    let mutable l: List[Int] = [1, 2, 3];
    l.insert_list_at(1, l);
    let mutable s = "";
    let mutable i: UInt = 0;
    while i < l.count() then {
        s += l.get(i).unwrap().to_string() + " ";
        i += 1;
    };
    println(s.trim_ascii_end());

    let mutable e: List[Int] = [1, 2];
    e.insert_list_at(0, e, span = 0..<0);
    if e.count() == 2 then {
        println("empty insert is a no-op");
    };
    return 0;
};
