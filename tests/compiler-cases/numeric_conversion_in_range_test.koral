// EXPECT: PASS
// A conversion whose value fits the target succeeds. Widening, in-range
// narrowing and cross-signedness conversions all go through the same checked
// path, so the check must not reject a value the target can hold.

let main(): Int = {
    // widening signed
    let small: Int8 = -100;
    let wide: Int = Int(small);

    // widening unsigned
    let ubyte: UInt8 = 200;
    let uwide: UInt = UInt(ubyte);

    // in-range narrowing
    let mid: Int = 200;
    let narrowed: UInt8 = UInt8(mid);

    // cross-signedness, both values in range
    let pos: Int8 = 100;
    let to_unsigned: UInt8 = UInt8(pos);
    let back: Int8 = Int8(to_unsigned);

    // signed -> unsigned, non-negative
    let n: Int = 5;
    let u: UInt = UInt(n);

    // unsigned -> signed, in range
    let un: UInt = 7;
    let sn: Int = Int(un);

    // float -> int truncates toward zero and is checked the same way
    let f: Float64 = -3.9;
    let t: Int = Int(f);

    if wide != -100 then {
        eprintln("FAIL: widening signed, got \(wide)");
        return 1;
    };
    if uwide != 200 then {
        eprintln("FAIL: widening unsigned, got \(uwide)");
        return 1;
    };
    if narrowed != 200 then {
        eprintln("FAIL: in-range narrowing, got \(narrowed)");
        return 1;
    };
    if to_unsigned != 100 then {
        eprintln("FAIL: cross to unsigned, got \(to_unsigned)");
        return 1;
    };
    if back != 100 then {
        eprintln("FAIL: cross back to signed, got \(back)");
        return 1;
    };
    if u != 5 then {
        eprintln("FAIL: signed to unsigned, got \(u)");
        return 1;
    };
    if sn != 7 then {
        eprintln("FAIL: unsigned to signed, got \(sn)");
        return 1;
    };
    if t != -3 then {
        eprintln("FAIL: float truncation, got \(t)");
        return 1;
    };
    println("PASS");
    return 0;
};
