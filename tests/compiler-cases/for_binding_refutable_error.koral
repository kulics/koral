// EXPECT-ERROR: For binding cannot fail; use 'when' to match
// Design guard: a `for` binding is a full match pattern now, but a loop cannot
// skip an element the pattern refuses, so the pattern must be irrefutable.
// `.Some(v)` can fail; `_`, `x`, `Point(x, y)` and `(a, b)` cannot.

using "std" { ... };

let main() Int = {
    let opts = List[Option[Int]].new();
    opts.push(Option[Int].Some(1));
    for .Some(v) in opts then {
        println(v);
    };
    return 0;
};
