// EXPECT-ERROR: Cannot take '&mut' of immutable value: c. Only 'let mut' lvalues (and lvalues reached through * or *! links) can use '&mut'.

type Counter(mut value Int)

given Counter {

    increment(*mut self) Void = {
        self.value = self.value + 1
    }
}

let main() Int = {
    let c = Counter(1)
    c.increment()
    return 0
}
