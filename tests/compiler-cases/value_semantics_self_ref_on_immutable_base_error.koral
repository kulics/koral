// EXPECT-ERROR: Cannot take '&mutable' of immutable value: c. Only 'let mutable' lvalues (and lvalues reached through * or unsafe * links) can use '&mutable'.

type Counter(mutable value Int)

given Counter {

    increment(*mutable self) Void = {
        self.value = self.value + 1
    }
}

let main() Int = {
    let c = Counter(1)
    c.increment()
    return 0
}
