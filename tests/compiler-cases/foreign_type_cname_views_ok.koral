// EXPECT: views ok
// The reference slot may repeat: an opaque `type foreign` claims no layout,
// so several declarations of one C name are just several views of one C
// type (the `let foreign` "same external symbol bound twice" rule). A struct
// and an opaque sharing a C name are one definition plus views -- legal too.

type foreign "Mix" MixStruct(a: Int32);
type foreign "Mix" MixOpaque {};
type foreign "FILE" FileA {};
type foreign "FILE" FileB {};

let main(): Void = {
    let s = MixStruct(Int32(1));
    if s.a == Int32(1) then {
        println("views ok");
    } else {
        println("FAIL views");
    };
};
