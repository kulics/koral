// EXPECT-ERROR: not object-safe

trait ManagedMutOnly {
    touch(self ref mut Self) Void
}

type Counter(mut value Int)

given Counter as ManagedMutOnly {
    public touch(self ref mut Self) Void = {
        self.value += 1
    }
}

let main() Int = {
    let counter ref mut Counter = box(Counter(1))
    let obj ref mut ManagedMutOnly = counter
    let _ = obj
    return 0
}