// Windows runner note: keep this as a build-only regression case.
// EXPECT: 5
// EXPECT: 5
// EXIT: 0

trait CounterOps {
    peek(*self) Int
    bump(*mutable self) Int
}

type Counter(mutable value Int)

given Counter as CounterOps {

    public peek(*self) Int = self.value

    public bump(*mutable self) Int = {
        self.value += 1
        return self.peek()
    }
}

let main() Int = {
    let strong *mutable Counter = box(Counter(4))
    let obj *mutable CounterOps = strong
    println(obj.bump().to_string())
    println(obj.peek().to_string())
    return 0
}
