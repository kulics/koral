// Test explicit dereference on trait object compile error
// EXPECT-ERROR: Cannot use * on a trait object *: concrete type is unknown at compile time

trait Greet {
    greet(*self) String
}

type Greeter(name String)

given Greeter as Greet {

    public greet(*self) String = "hello"
}

let main() Int = {
    let g1 = box(Greeter("test"))
    let g * Greet = g1
    let v = *g
    return 0
}
