// EXPECT-ERROR: Type NotRandom does not explicitly implement trait RandomSource

// Instantiating a generic TYPE checks its declared bounds, the same as a
// generic method call already did. koralc used to check only the method path,
// so a bad `Random[NotRandom]` compiled while `pick(NotOrd(), NotOrd())` did
// not.

using "std/rand" { Random, RandomSource };

type NotRandom();

public let main(): Int = {
    let r = Random[NotRandom].new(NotRandom());
    let _ = r;
    return 0;
};
