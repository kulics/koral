// EXPECT-ERROR: Type NotHashable does not explicitly implement trait Hash

// Instantiating a generic TYPE checks its declared bounds, the same as a
// generic method call already did. koralc used to check only the method path,
// so a bad `Set[NotHashable]` compiled while `pick(NotOrd(), NotOrd())` did
// not.

using "std" { Set };

type NotHashable();

public let main(): Int = {
    let s = Set[NotHashable].new();
    let _ = s;
    return 0;
};
