// EXPECT: 1
// EXPECT: 2

// Regression: an escaping closure carrying mutable state must own that state.
// With copy-only capture the state lives in a `Cell`, so the returned closure
// cannot dangle on the caller's stack frame.

let make_counter() Func() Int = {
    let counter = Cell(0);
    return () -> {
        counter.value = counter.value + 1;
        return counter.value;
    };
};

let main() Int = {
    let counter = make_counter();
    println(counter().to_string());
    println(counter().to_string());
    return 0;
};
