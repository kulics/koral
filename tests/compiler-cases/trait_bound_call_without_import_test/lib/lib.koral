// The library declares the trait, a generic function bounded by it, and the
// type that conforms. A caller that imports only `render` and `Point` must
// still be able to call `render(point)`: the bound's identity travels on the
// DECLARATION resolved here, not on a spelling re-resolved at the call site.

public trait Show {
    show(self): String;
};

public type Point(x: Int, y: Int);

given Point {
    public new(x: Int, y: Int): Point = Point(x, y);
};

given Point: Show {
    show(self): String = "(" + self.x.to_string() + ", " + self.y.to_string() + ")";
};

public let render[T: Show](x: T): String = x.show();
