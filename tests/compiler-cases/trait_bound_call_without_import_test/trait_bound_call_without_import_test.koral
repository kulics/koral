// EXPECT: (1, 2)
// The caller imports `render` and `Point` -- NOT the trait `Show`. Calling
// `render(value)` checks `Point: Show` against the conformance registry by the
// bound's declaration identity; re-resolving the spelling `Show` in this
// module would report `Undefined trait: Show` for a name it never needed.

using "trait_bound_call_without_import_test/lib" { render, Point };

public let main(): Int = {
    let p = Point.new(1, 2);
    println(render(p));
    return 0;
};
