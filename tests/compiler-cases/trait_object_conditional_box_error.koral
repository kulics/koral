// EXPECT-ERROR: Cannot form 'sendable' trait object from non-sendable type 'Box[Unmarked]'
// A generic impl of a `trait sendable` is conditional (all args sendable):
// `Box[Unmarked]` is not sendable, so it cannot box into the always-sendable
// object even though the template itself is declared sendable. The box-time
// check is what enforces the conditional case (concurrency-design.md
// §派生规则 3、6).

trait sendable Ping {
    ping(self): Int;
};

type sendable Box[T: Any](value: T);
type Unmarked(n: Int);

given[T: Any] Box[T]: Ping {
    ping(self): Int = 1;
};

let main(): Void = {
    let boxed = Box[Unmarked](Unmarked(1));
    let obj: Ping = boxed;
    let _ = obj.ping();
};
