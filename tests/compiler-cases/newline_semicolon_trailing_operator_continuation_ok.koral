// EXPECT: 3
// EXPECT: 4
// EXPECT: 3
// EXPECT: true
// EXPECT: 0123
// EXPECT: trailing operator continuation ok
let main() Int = {
    let sum = 1 + 2
    println(sum)

    let shifted = 1 << 1 + 1
    println(shifted)

    let mixed = 9 / 3
    println(mixed)

    let same = 1 + 2 == 3
    println(same)

    for i in 0..3 then {
        print(i.to_string())
    }
    println("")

    println("trailing operator continuation ok")
    return 0
}
