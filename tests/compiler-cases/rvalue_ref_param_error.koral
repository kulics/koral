// EXPECT-ERROR: Type mismatch: expected *String, got String

// This test verifies that passing an rvalue to a function expecting T *
// still produces an error (temporary materialization only applies to method receivers)

let takes_string_ref(s * String) UInt = s.count()

let main() Void = {
    // This should fail: "hello" is rvalue, function expects String *
    let len = takes_string_ref("hello")
    println(len)
}
