// Tests that a concrete managed-reference given declaration is rejected
// Feature: type-modifier-trait-conformance
// EXPECT-ERROR: Concrete type modifier given declarations are not allowed. Use generic form instead, e.g., 'given [T SomeTrait] *T as SomeTrait { ... }'

type Foo(x Int)

given Foo as Eq {

    public equals(self, other Foo) Bool = self.x == other.x
}

given *Foo as Eq {

    public equals(self, other * Foo) Bool = *self.equals(*other)
}

let main() Void = {
    println("should not compile")
}
