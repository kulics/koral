// The `(expr as Trait)` spelling is not part of the language. A qualified call
// is written `Type(Trait).method(...)` (grammar.bnf <qualified-path-suffix>);
// the `as` form was never documented and must not parse.
// EXPECT-ERROR: Unexpected token: as, expected: ')'

type Num(x Int);

let main() Int = {
    let n = Num(7);
    let r = (n as Num).to_string();
    return 0;
};
