// EXPECT: 7
// `alpha`'s `Shared` is module_private, so the import brings in nothing under
// that spelling. A name that never entered this file's scope cannot collide
// with the local `Shared` -- reporting it would blame the reader for a rule
// they cannot act on (§3.3).
using "using_private_name_not_in_scope_test/alpha";

type Shared(y Int);

let main() Int = {
    println(Shared(7).y.to_string());
    return 0;
};
