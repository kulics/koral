// EXPECT-ERROR: Undefined variable: child_internal
//
// §3.3 access levels through the IMPORT layer: an explicit `using` cannot
// conjure a name the target module hides from this one. `child_internal` is
// `internal` to the child module; the imported spelling resolves as if
// undeclared, exactly like the bare one.
using "std" { ... };
using "access_level_cross_module_import_error/child" { child_internal };

public let main(): Int = {
    return child_internal();
};
