// EXPECT-ERROR: sendable closure cannot capture non-sendable value 'v'
// A `sendable () -> Void` parameter refuses a closure that captures a
// non-sendable value (concurrency-design.md §派生规则 5).

type mutable Local(mutable n: Int);

let run(f: sendable () -> Void): Void = f();

let main(): Void = {
    let v = Local(1);
    run(() => println("captured \(v.n)"));
};
