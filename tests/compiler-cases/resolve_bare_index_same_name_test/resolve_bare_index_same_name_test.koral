// EXPECT: 1
// EXPECT: 2
// EXPECT: 3
//
// Design guard: the unqualified name index (written so "Import it explicitly"
// can name a module, last-wins) lives in its OWN key space and must not clobber
// a local/empty-path definition of the same name, nor be clobbered by one.
//
// mod_a registers `Box` and `Widget` in the name index beside their
// module-qualified keys. `echo` below binds a generic parameter NAMED `Box` --
// a local/empty-path binder -- and it must shadow the imported template inside
// the signature (so `echo(1)` is `Int -> Int`), while `Box(2)` at the call site
// still means mod_a's generic struct and `Widget(3)` still means mod_a's
// struct. Everything else in lookup must be unchanged.
using "std" { ... };
using "resolve_bare_index_same_name_test/mod_a" { Box, Widget };

let echo[Box Any](b Box) Box = {
    return b;
};

let main() Int = {
    println(echo(1).to_string());

    let boxed = Box(2);
    println(boxed.value.to_string());

    let w = Widget(3);
    println(w.value.to_string());
    return 0;
};
