using "std" { ... };

// Both declarations land in the unqualified NAME INDEX under their bare
// spelling (kept only so "Import it explicitly" can name a module), beside
// their module-qualified keys. The name index lives in its own key space, so
// it cannot clobber a same-named local/empty-path definition -- see the main
// file.
public type Box[T Any](public value T);

public type Widget(value Int);
