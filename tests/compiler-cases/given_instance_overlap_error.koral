// EXPECT-ERROR: Conflicting conformance
// 同一基础类型对同一 trait 只能有一个 given：实例化给定也不能拆着写——
// `given Box[Int]: Name` 与 `given Box[String]: Name` 重叠（查找对两者
// 都会回答），与两个 `given Point: T` 同罪。

type Box[T: Any](v: T);

trait Name {
    name(self): Int;
};

given Box[Int]: Name {
    name(self): Int = 1;
};

given Box[String]: Name {
    name(self): Int = 2;
};

let main(): Int = {
    return 0;
};
