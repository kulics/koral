// The initializer must not call get() on the same Lazy: the guard mutex is
// non-recursive, so the re-entrant call would deadlock holding it. The mistake
// panics with a diagnostic instead of hanging.
// EXPECT-ERROR: Panic: Lazy.get: the initializer called get() on the same Lazy

using "std/sync" { ... };

let main(): Void = {
    let cell = List[Lazy[Int]].new();
    let lazy_val = Lazy[Int].new(() => cell[0].get());
    cell.push(lazy_val);
    println(lazy_val.get());
};
