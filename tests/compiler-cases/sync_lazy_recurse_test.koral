// The initializer must not call get() on the same Lazy: it runs outside every
// lock, so the re-entrant call finds the value still uninitialized and has
// nothing to return. The mistake panics with a diagnostic instead of hanging.
// EXPECT-ERROR: Panic: Lazy.get: the initializer called get() on the same Lazy

using "std/sync" { ... };

/// Escape-hatch holder: the initializer slot is `sendable () -> T` (it may run
/// on any thread at first `get`), which refuses unmarked captures, while the
/// cell itself is thread-confined working state.
type unsafe sendable mutable LazyCell(items: List[Lazy[Int]]);

let main(): Void = {
    let cell = List[Lazy[Int]].new();
    let holder = LazyCell(cell);
    let lazy_val = Lazy[Int].new(() => holder.items[0].get());
    cell.push(lazy_val);
    println(lazy_val.get());
};
