// EXPECT: ok

type Big(value Int)
given Big not Deref

type Wrapped(mut kind * Big)

let pick(flag Bool, wrapped *mut Wrapped, fallback * Big) * Big = when flag in {
    true then wrapped.kind,
    false then fallback,
}

let main() Void = {
    let big1 *mut Big = box(Big(7))
    let big2 *mut Big = box(Big(9))
    let wrapped *mut Wrapped = box(Wrapped(big1))
    let picked_true * Big = pick(true, wrapped, big2)
    let picked_false * Big = pick(false, wrapped, big2)
    assert(picked_true.value == 7, "true branch should read wrapped kind")
    assert(picked_false.value == 9, "false branch should use fallback")
    println("ok")
}
