// The alias's declared bounds are checked at instantiation, the same way a
// generic struct's are.
// EXPECT-ERROR: Type NoHash does not explicitly implement trait Hash (checking constraint K: Hash)

type NoHash(x: Int);
type Dict2[K: Hash] = Dict[K, Int];

let main(): Int = {
    let d = Dict2[NoHash].new();
    return 0;
};
