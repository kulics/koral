// EXPECT: escape ok
// The C-name slot is the escape hatch for a Koral name that is not (or should
// not be) a C identifier: the Koral name keeps value naming, the C name is
// the symbol's spelling in the C world, and each side calls its own.

let foreign "c_koral_abs" café(x: Int32): Int32 = {
    if x < Int32(0) then {
        return Int32(0) - x;
    };
    return x;
};

type foreign "FILE" Café {};

let main(): Void = {
    let v = café(Int32(-5));
    if v == Int32(5) then {
        println("escape ok");
    } else {
        println("FAIL escape: " + v.to_string());
    };
};
