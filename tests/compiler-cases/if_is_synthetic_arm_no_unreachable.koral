// EXPECT: if_is_synthetic_arm_ok
// Design guard: `if x is pat` desugars to a `when` whose invented else-arm
// exists only to make the match exhaustive. That arm is not a pattern anyone
// wrote, so no unreachable or duplicate complaint may name it -- `if x is _`
// is not "duplicate pattern", and `if e is .A() or is .B()` on a two-case
// enum is not "unreachable" just because the invented `_` follows a total
// pattern. The seed checks none of this (if-is never becomes a `when` there),
// so koralc's synthetic-arm marking is what keeps the two quiet together.

type E {
    A(),
    B(),
};

let main(): Int = {
    let e = E.A();
    if e is _ then {
        println("wildcard ok");
    };
    if e is .A() or is .B() then {
        println("total chain ok");
    };
    println("if_is_synthetic_arm_ok");
    return 0;
};
