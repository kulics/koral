// EXPECT: 7
//
// §3.3 collision matrix, rule 3 (the "do not report" cell): the SAME
// declaration arriving via two paths is NOT a collision -- identity is the
// declaration, not the spelling. `Eq` here comes from the prelude AND from the
// written `using "std" { Eq };`; both name one declaration, so the spelling
// keeps its one owner and the program compiles.
using "std" { Eq };

let f[T Eq](x T) T = x;

let main() Int = {
    println(f(7).to_string());
    return 0;
};
