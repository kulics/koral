// EXPECT-ERROR: Type mismatch: expected Box, got List[Int]
// Family rule for collection literals (std-api design ruling): at a target
// outside the List/Set/Dict families the literal DEFAULTS -- a sequence
// literal reads as `List` -- and the ordinary type check reports the mismatch
// afterwards. This used to be rejected at the literal itself with "Collection
// literals only support built-in ..."; the default is what lets literals flow
// into Iterable-constrained slots (see collection_literal_default_test).

type Box(v: Int);

let main(): Int = {
    let value: Box = [1, 2, 3];
    let _ = value;
    0;
};
