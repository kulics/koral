// EXPECT: PASS
// `get` is a total accessor: any out-of-domain index -- negative or past the
// end -- is `None`, never a panic.

let main(): Int = {
    let l: List[Int] = [1, 2, 3];
    if l.get(-1) is .Some(_) then {
        eprintln("FAIL: get(-1) should be None");
        return 1;
    };
    if l.get(3) is .Some(_) then {
        eprintln("FAIL: get(3) should be None");
        return 1;
    };
    if l.get(0) is .None() then {
        eprintln("FAIL: get(0) should be Some");
        return 1;
    };
    println("PASS");
    return 0;
};
