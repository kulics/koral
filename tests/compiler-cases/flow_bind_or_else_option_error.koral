// EXPECT-ERROR: Option's 'None' has no payload to bind; use 'or else' without 'as ... in'
//
// `or else as e in` names the Error payload, and only a Result has one.
// `None` has no payload, so the binder form is refused on Option.

let main(): Int = {
    let o: Option[Int] = Option[Int].Some(1);
    let a = o or else as e in 0;
    return 0;
};
