// EXPECT: result_eq_ok
// Result 补 Eq：Ok 按载荷比，Ok 与 Error 恒不等；错误侧是 Error trait
// object（没有可比性来源），按 message() 文本相等判定。

let main(): Int = {
    let a = Result[Int].Ok(1);
    let b = Result[Int].Ok(1);
    let c = Result[Int].Ok(2);
    assert(a == b, "ok equals ok");
    assert(not (a == c), "ok values differ");
    assert(not (a != b), "not-equal agrees");

    let e1 = Result[Int].Error("boom");
    let e2 = Result[Int].Error("boom");
    let e3 = Result[Int].Error("other");
    assert(e1 == e2, "errors equal by message");
    assert(not (e1 == e3), "errors differ by message");
    assert(not (a == e1), "ok never equals error");
    assert(not (e1 == a), "error never equals ok");

    println("result_eq_ok");
    return 0;
};
