// EXPECT-ERROR: Ambiguous method 'value' for type 'T' via trait extensions
// Pin the generic-bound half of same-name method resolution (2026-11-13
// batch): two bounds on one parameter each declare `value`, and neither is
// THE method -- identity is the method's DefId, so two distinct declarations
// behind one name report the same ambiguity the type-side reports at
// registration. First-match-wins used to pick silently by bound order.
trait Alpha {
    value(self): Int;
};

trait Beta {
    value(self): Int;
};

let read[T: Alpha and Beta](x: T): Int = x.value();

let main(): Int = {
    return 0;
};
