// Test: global variable initialization with collection and dict literals.
// A global's type must be sendable, and the mutable containers are
// thread-confined working state, so the globals hold immutable `Frozen*`
// snapshots built from the literals (concurrency-design.md §跨界检查 (c)).

private let numbers: FrozenList[Int] = [1, 2, 3, 4, 5].to_frozen_list();
private let names: FrozenList[String] = ["alice", "bob", "charlie"].to_frozen_list();
private let mutable scores: FrozenList[Int] = [100, 200, 300].to_frozen_list();

private let config: FrozenDict[String, String] = ["host": "localhost", "port": "8080"].to_frozen_dict();
private let mutable settings: FrozenDict[String, String] = ["debug": "true"].to_frozen_dict();

public let main(): Void = {
    println(numbers.get(0).unwrap());
    println(numbers.get(4).unwrap());
    println(names.get(1).unwrap());
    println(scores.get(2).unwrap());
    scores = [400, 500].to_frozen_list();
    println(scores.get(0).unwrap());
    let host = config.get("host").unwrap();
    let port = config.get("port").unwrap();
    let debug = settings.get("debug").unwrap();
    println(host);
    println(port);
    println(debug);
};
// EXPECT: 1
// EXPECT: 5
// EXPECT: bob
// EXPECT: 300
// EXPECT: 400
// EXPECT: localhost
// EXPECT: 8080
// EXPECT: true
