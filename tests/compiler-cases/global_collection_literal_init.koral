// Test: global variable initialization with collection and dict literals

file_private let numbers = [1, 2, 3, 4, 5];
file_private let names = ["alice", "bob", "charlie"];
file_private let mutable scores = [100, 200, 300];

file_private let config = ["host": "localhost", "port": "8080"];
file_private let mutable settings = ["debug": "true"];

public let main() Void = {
    println(numbers[0]);
    println(numbers[4]);
    println(names[1]);
    println(scores[2]);
    scores = [400, 500];
    println(scores[0]);
    println(config["host"]);
    println(config["port"]);
    println(settings["debug"]);
};
// EXPECT: 1
// EXPECT: 5
// EXPECT: bob
// EXPECT: 300
// EXPECT: 400
// EXPECT: localhost
// EXPECT: 8080
// EXPECT: true
