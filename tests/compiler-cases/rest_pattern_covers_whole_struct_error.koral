// EXPECT-ERROR: Unreachable pattern 'Point(a, b, c)': already covered by 'Point(_, _, _)' at position 1
// Design guard: a rest slot in a fixed-arity pattern is whole-list elision, so
// `Point(...)` on a three-field struct is `Point(_, _, _)` -- an irrefutable
// pattern. Anything after it can never match, and the checker says so.
using "std" { ... };

type Point(x: Int, y: Int, z: Int);

let main(): Int = {
    let p = Point(1, 2, 3);
    let s = when p in {
        Point(...) then 1,
        (a, b, c) then 0,
    };
    println(s);
    return 0;
};
