// EXPECT-ERROR: Unreachable pattern 'Point(a, b, c)': already covered by 'Point(a, _, c)' at position 1
// Design guard: a rest slot is arity sugar for wildcards, so `(a, ..., c)` on a
// three-field struct is `Point(a, _, c)` -- an irrefutable pattern. Anything
// after it can never match, and the checker says so.
using "std";

type Point(x Int, y Int, z Int);

let main() Int = {
    let p = Point(1, 2, 3);
    let s = when p in {
        (a, ..., c) then a + c,
        (a, b, c) then 0,
    };
    println(s);
    return 0;
};
