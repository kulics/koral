// EXPECT-ERROR: Non-exhaustive match on type 'MaybeColor': missing cases .Some(.Blue)

type Color {
    Red(),
    Green(),
    Blue(),
};

type MaybeColor {
    None(),
    Some(value Color),
};

let main() Int = {
    let value = MaybeColor.Some(Color.Red());
    let _ = when value in {
        .Some(.Red()) then 1,
        .Some(.Green()) then 2,
        .None() then 0,
    };
    return 0;
};
