// EXPECT: true-store: 31
// EXPECT: false-store: 41

// Escaping closures carry mutable state through a `Cell`, so the stored
// callback keeps its own state alive after the building frame returns.

let build_callbacks(flag Bool) List[Func() Int] = {
    let callbacks = List[Func() Int].new();

    if flag then {
        let chosen = Cell(30);
        let callback Func() Int = () -> {
            chosen.value = chosen.value + 1;
            return chosen.value;
        };
        callbacks.push(callback);
    } else {
        let chosen = Cell(40);
        let callback Func() Int = () -> {
            chosen.value = chosen.value + 1;
            return chosen.value;
        };
        callbacks.push(callback);
    };

    return callbacks;
};

let main() Int = {
    let true_callbacks = build_callbacks(true);
    let true_callback = true_callbacks[0];
    println("true-store: " + true_callback().to_string());

    let false_callbacks = build_callbacks(false);
    let false_callback = false_callbacks[0];
    println("false-store: " + false_callback().to_string());
    return 0;
};
