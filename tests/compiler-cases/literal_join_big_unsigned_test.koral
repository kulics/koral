// EXPECT: PASS
// An integer literal joins the other operand's integer width in every
// operand position -- comparison, arithmetic and bitwise, either side -- and
// is range-checked against the width it joins, not against its Int default.
// A value that fits the joined width but not Int must compile and run; this
// is the core benefit of builtin widths over a generic wrapper.

let main() Int = {
    let x UInt = 18446744073709551614;

    // Comparison, literal on either side.
    if not (x == 18446744073709551614) then {
        eprintln("FAIL: x == literal");
        return 1;
    };
    if not (18446744073709551614 == x) then {
        eprintln("FAIL: literal == x");
        return 1;
    };

    // Comparison chains join the same way.
    if not (18446744073709551613 < x < 18446744073709551615) then {
        eprintln("FAIL: literal < x < literal");
        return 1;
    };

    // Arithmetic operands, literal on either side. Plain arithmetic is
    // checked at runtime, so only non-overflowing combinations run here.
    if (x - 18446744073709551613) != 1 then {
        eprintln("FAIL: x - literal");
        return 1;
    };
    if (18446744073709551615 - x) != 1 then {
        eprintln("FAIL: literal - x");
        return 1;
    };

    // Bitwise operands, literal on either side.
    if (x & 18446744073709551615) != x then {
        eprintln("FAIL: x & literal");
        return 1;
    };
    if (18446744073709551615 & x) != x then {
        eprintln("FAIL: literal & x");
        return 1;
    };

    // The Wrapping family joins the same way in both positions.
    let w WrappingUInt = 18446744073709551615;
    if not (w == 18446744073709551615) then {
        eprintln("FAIL: WrappingUInt == literal");
        return 1;
    };
    if not (18446744073709551615 == w) then {
        eprintln("FAIL: literal == WrappingUInt");
        return 1;
    };
    if not ((w + 18446744073709551615) == WrappingUInt(18446744073709551614)) then {
        eprintln("FAIL: WrappingUInt + literal");
        return 1;
    };
    if not ((18446744073709551615 + w) == WrappingUInt(18446744073709551614)) then {
        eprintln("FAIL: literal + WrappingUInt");
        return 1;
    };
    if not ((w & 18446744073709551614) == WrappingUInt(18446744073709551614)) then {
        eprintln("FAIL: WrappingUInt & literal");
        return 1;
    };
    if not ((18446744073709551614 & w) == WrappingUInt(18446744073709551614)) then {
        eprintln("FAIL: literal & WrappingUInt");
        return 1;
    };

    println("PASS");
    return 0;
};
