// EXPECT: 42
// The shapes a cast makes sense for: numeric to numeric with `Type(expr)`, and
// pointers to and from `Int` / `UInt` with `expr as Type`.

public let main(): Int = {
    let i = 42;
    let f = Float64(i);
    let b = UInt8(i);
    let j = Int(f);
    let mut = 7;
    let p = &mut;
    let addr = p as UInt;
    println(j.to_string());
    return 0;
};
