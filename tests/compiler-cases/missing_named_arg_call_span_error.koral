// A missing-argument complaint on an empty call anchors at the callee name --
// identical span on both compilers. Regression pin: koralc used to anchor at
// the enclosing statement while Swift anchored at the callee.
// EXPECT-ERROR: Missing named argument 'a' for 'f'

using "std" { ... };

let f(a: Int =, b: Int =): Int = a + b;

let main(): Int = {
    return f();
};
