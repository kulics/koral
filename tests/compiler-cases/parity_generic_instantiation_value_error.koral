// EXPECT-ERROR: Type 'List[Foo]' cannot be used as an expression: types have no value
// A generic instantiation standing alone is a type used as a value: types
// have no value -- the same objection the bare spelling gets -- and the
// message names the RESOLVED type.

type Foo(x Int);

let main() Int = {
    let x = List[Foo];
    return 0;
};
