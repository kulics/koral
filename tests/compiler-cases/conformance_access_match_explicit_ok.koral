// EXPECT: 7
// EXPECT: 7
// An explicit modifier that EQUALS the requirement's level is fine: `Tag` is
// public, so `value` may be written `public`. Both call paths then agree --
// the direct call and the trait-object dispatch judge the same level.

public trait Tag {
    value(self): Int;
};

type Box(v: Int);

given Box: Tag {
    public value(self): Int = self.v;
};

let main(): Int = {
    let b = Box(7);
    println(b.value().to_string());
    let t: Tag = b;
    println(t.value().to_string());
    return 0;
};
