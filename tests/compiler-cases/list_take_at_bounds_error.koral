// EXPECT-ERROR: List take_at index out of bounds

// take_at's bounds panic must name take_at (it used to say "List remove_at
// index out of bounds", naming the wrong API).

let main(): Int = {
    let mutable l = List[Int].new();
    l.push(1);
    l.push(2);
    let v = l.take_at(5);
    return v;
};
