// EXPECT-ERROR: Pointer and weak casts are written 'expr as Type', not 'Type(expr)'
// A parenthesized type head keeps the cast rule of its target: `(?Box)(b)`
// is the old spelling of `b as ?Box`.

type mutable Box(mutable value: Int);

let main(): Int = {
    let b = Box(42);
    let w = (?Box)(b);
    return 0;
};
