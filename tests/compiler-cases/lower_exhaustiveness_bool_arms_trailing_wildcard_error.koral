// EXPECT-ERROR: lower_exhaustiveness_bool_arms_trailing_wildcard_error.koral:13:29: error: Unreachable pattern '_': already covered by previous patterns
// Four two-bool arms cover every value of the one-case enum, so the trailing
// `_` is the ONLY unreachable arm. The field-wise box subtraction loses the
// correlation between the two bool fields -- eating `(true, true)` field-wise
// eats `(true, *)` and `(*, true)` -- so it must not empty the case early and
// blame the fourth arm (`.Both(false, false)`) instead. Only a precise
// subtraction may stand as "already covered".

type Flags {
    Both(a Bool, b Bool),
};

let classify(f Flags) Int = when f in {
    .Both(true, true) then 1,
    .Both(true, false) then 2,
    .Both(false, true) then 3,
    .Both(false, false) then 4,
    _ then 0,
};

let main() Int = {
    println(classify(Flags.Both(true, true)));
    return 0;
};
