// EXPECT: -9223372036854775808
// 9223372036854775807
// -1
// 0
// 18446744073709551615
// `Int.min_value()` has no positive counterpart in `Int`; taking the magnitude
// through `Int` overflows exactly there. It goes through `UInt` instead.

public let main() Int = {
    println(Int.min_value().to_string());
    println(Int.max_value().to_string());
    println((0 - 1).to_string());
    println(0.to_string());
    println(UInt.max_value().to_string());
    return 0;
};
