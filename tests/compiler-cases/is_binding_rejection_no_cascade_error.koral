// EXPECT-ERROR: Variable bindings in 'is' expression are not allowed in 'or' branches
// Design guard: a rejected binding must leave the names DEFINED. The program
// is refused with the one message above and nothing else -- the body below
// reads `value` and `value2`, which never bind at runtime, and those uses
// must not pile `Undefined variable` (and whatever an unknown value then
// fails to do) on top of the real diagnostic. The seed stops at the first
// complaint; koralc keeps checking, so the streams only agree because the
// rejection neutralises its own cascade.

type MyOption {
    None(),
    Some(value: Int),
};

let f(o: MyOption, other: MyOption): Int = {
    if o is .Some(value) or other is .Some(value2) then {
        let mutable sum = 0;
        sum += value;
        sum += value2;
        return sum;
    };
    return 0;
};

let main(): Int = {
    return f(MyOption.Some(1), MyOption.None());
};
