// EXPECT-ERROR: Not pattern cannot contain variable bindings
// A `not` pattern matches by the absence of a shape, so there is nothing to bind.

type E {
    A(a Int),
    B(b Int),
};

let f(e E) Int = when e in {
    not .A(v) then 1,
    _ then 0,
};

let main() Int = {
    return f(E.A(1));
};
