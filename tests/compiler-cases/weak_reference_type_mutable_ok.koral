// EXPECT: PASS
// A ?T whose referent is 'type mutable' is fine.
type mutable Box(mutable value Int);
let f(x ?Box) Int = {
    return if x is ?r then r.value else 0;
};
let main() Int = {
    let b = Box(42);
    let w = ?Box(b);
    if f(w) <> 42 then {
        eprintln("FAIL: expected 42");
        return 1;
    };
    println("PASS");
    return 0;
};
