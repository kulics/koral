// EXPECT: PASS
type mutable Box(mutable value Int);

let consume(x ?Box) Int = {
    return when ?x in {
        .Some(v) then v.value,
        .None() then 0,
    };
};

let main() Int = {
    let b = Box(42);
    let w = ?Box(b);
    if consume(w) != 42 then {
        eprintln("FAIL: expected 42");
        return 1;
    };
    println("PASS");
    return 0;
};
