// EXPECT: readonly: 0
// EXPECT: generic: 1
// EXPECT: mutable: 1
// EXPECT: boxed: 1

type Counter(mutable value Int)

trait ManagedBump {
    bump_and_keep(*mutable self) *mutable Self
}

given Counter {
    public read(*self) Int = self.value

    public increment(*mutable self) Void = {
        self.value += 1
    }
}

given Counter as ManagedBump {
    public bump_and_keep(*mutable self) *mutable Self = {
        self.value += 1
        return self
    }
}

let keep_generic[T ManagedBump](value *mutable T) *mutable T = value.bump_and_keep()

let main() Int = {
    let mutable a = Counter(0)
    println("readonly: \(a.read().to_string())")

    let mutable b = Counter(0)
    let alias = keep_generic(&mutable b)
    println("generic: \(alias.value.to_string())")

    let mutable c = Counter(0)
    c.increment()
    println("mutable: \(c.value.to_string())")

    let mutable box = Counter(0)
    let kept = (&mutable box).bump_and_keep()
    println("boxed: \(kept.value.to_string())")

    return 0
}
