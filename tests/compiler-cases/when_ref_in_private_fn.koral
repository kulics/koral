// EXPECT: readonly: 0
// EXPECT: generic: 1
// EXPECT: mutable: 1
// EXPECT: boxed: 1

type Counter(mut value Int)

trait ManagedBump {
    bump_and_keep(*mut self) *mut Self
}

given Counter {
    public read(*self) Int = self.value

    public increment(*mut self) Void = {
        self.value += 1
    }
}

given Counter as ManagedBump {
    public bump_and_keep(*mut self) *mut Self = {
        self.value += 1
        return self
    }
}

let keep_generic[T ManagedBump](value *mut T) *mut T = value.bump_and_keep()

let main() Int = {
    let mut a = Counter(0)
    println("readonly: \(a.read().to_string())")

    let mut b = Counter(0)
    let alias = keep_generic(&mut b)
    println("generic: \(alias.value.to_string())")

    let mut c = Counter(0)
    c.increment()
    println("mutable: \(c.value.to_string())")

    let mut box = Counter(0)
    let kept = (&mut box).bump_and_keep()
    println("boxed: \(kept.value.to_string())")

    return 0
}
