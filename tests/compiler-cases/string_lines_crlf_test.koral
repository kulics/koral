// EXPECT: lines_crlf_ok
// `lines()` 的行尾是 `\n` 或 `\r\n`：剥掉一个行尾 `\r`，其它位置的 `\r`
// 是内容——与 `scanln` 同一条规则。

let collect(text: String): List[String] = {
    let out = List[String].new();
    for line in text.lines() then {
        out.push(line);
    };
    return out;
};

let main(): Int = {
    let a = collect("a\r\nb\r\n");
    assert(a.count() == 2, "crlf two lines");
    assert(a[0] == "a" and a[1] == "b", "crlf content clean");

    let b = collect("a\nb");
    assert(b.count() == 2 and b[1] == "b", "lf unchanged");

    let c = collect("a\rb\r\n");
    assert(c.count() == 1 and c[0] == "a\rb", "interior cr is content");

    let d = collect("a\r\r\n");
    assert(d.count() == 1 and d[0] == "a\r", "only one trailing cr dropped");

    let e = collect("\r\n");
    assert(e.count() == 1 and e[0] == "", "crlf empty line");

    let f = collect("a\r");
    assert(f.count() == 1 and f[0] == "a", "bare trailing cr dropped");

    let g = collect("a\n\nb\n");
    assert(g.count() == 3 and g[1] == "" and g[2] == "b", "interior empty line");

    println("lines_crlf_ok");
    return 0;
};
