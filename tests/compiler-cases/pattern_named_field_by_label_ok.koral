// Destructuring follows the call rules, and this is what a legal match looks
// like: positional fields by position, named fields by label, either order
// among the named ones.
// EXPECT: by_label_ok
// EXPECT: reordered_ok
// EXPECT: mixed_ok
// EXPECT: tuple_positional_ok

using "std";

type Button(width Int, height: Int, label: String);

type Point(x Int, y Int);

let main() Int = {
    let b = Button(100, height: 20, label: "go");

    // Every field by its declared shape.
    let area = when b in {
        Button(w, height: h, label: l) then {
            assert(l == "go", "label");
            w * h
        },
    };
    assert(area == 2000, "by label");
    println("by_label_ok");

    // Named fields may be reordered.
    let l2 = when b in {
        Button(w, label: l, height: h) then l,
    };
    assert(l2 == "go", "reordered");
    println("reordered_ok");

    // Positional first, then named -- the call shape.
    let w2 = when b in {
        Button(w, height: h, label: l) then w,
    };
    assert(w2 == 100, "mixed");
    println("mixed_ok");

    // A struct with no named fields is destructured positionally.
    let p = Point(1, 2);
    let sum = when p in {
        (a, b) then a + b,
    };
    assert(sum == 3, "positional");
    println("tuple_positional_ok");

    return 0;
};
