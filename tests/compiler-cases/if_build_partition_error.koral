// EXPECT-ERROR: duplicate declaration 'twice'
// The partition rule (cffi-design.md §D): same-name declarations must sit on
// opposite branches of the SAME `#if … else …`. These two both live in
// then-branches of different constructs — they can coexist, so it is a
// duplicate declaration. Pure syntax: the error fires on every host.

#if os("windows") then {
    let twice(): Int = 1;
} else {
    let other_one(): Int = 1;
};

#if os("macos") then {
    let twice(): Int = 2;
} else {
    let other_two(): Int = 2;
};
