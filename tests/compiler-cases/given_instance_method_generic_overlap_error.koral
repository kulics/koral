// EXPECT-ERROR: Duplicate definition: pick
// Method-generic or not, an instance given's member name may not collide with
// a generic given's on the same type: the shape of the method never changes
// which instantiation it is defined for.

type Box[T: Any](value: T);

given[T: Any] Box[T] {
    public pick[U: Any](self, a: U, b: U): U = a;
};

given Box[Int] {
    public pick(self): Int = 1;
};

let main(): Int = {
    return 0;
};
