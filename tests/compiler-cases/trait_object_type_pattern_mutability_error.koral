// EXPECT-ERROR: requires a mutable trait object subject

trait Problem {
    render(*self) Int
}

type ProbeIoError(value Int)

given ProbeIoError as Problem {

    render(*self) Int = self.value
}

let main() Int = {
    let err * Problem = box(ProbeIoError(7))
    if err is io *mutable ProbeIoError then {
        return io.render()
    }
    return 0
}