// Trait object type pattern with bare type does not require mutable subject
// EXPECT: render_ok

trait Problem {
    render(self) Int;
};

type ProbeIoError(value Int);

given ProbeIoError as Problem {
    render(self) Int = self.value;
};

let main() Int = {
    let err Problem = ProbeIoError(7);
    if err is io ProbeIoError then {
        let _ = io.render();
        println("render_ok");
    };
    return 0;
};
