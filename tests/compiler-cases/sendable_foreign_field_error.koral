// EXPECT-ERROR: sendable type 'Holder' cannot have non-sendable field 'inner'
// Safe `sendable` verifies its fields, and a foreign composite is never
// sendable -- a sendable type's interior cannot hold one. The sanctioned home
// is `type unsafe sendable` (unsafe_sendable_foreign_field_ok;
// concurrency-design.md §派生规则 9).

type foreign Inner(v: Int32);

type sendable Holder(inner: Inner);
