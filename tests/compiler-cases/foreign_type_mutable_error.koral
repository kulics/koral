// EXPECT-ERROR: Foreign type cannot be marked mutable

// `type foreign` and `type mutable` are mutually exclusive: mutability is a
// property of Koral's own nominal declarations, and an external type's layout
// is C's, not ours.

type foreign mutable KoralTimespec(tv_sec Int64, tv_nsec Int64);

let main() Int = {
    return 0;
};
