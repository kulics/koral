// EXPECT-ERROR: Integer literal 300 is out of range for UInt8
// A literal is checked at compile time by WIDTH, not by family: a constant
// that does not fit is the author's mistake, so `WrappingUInt8(300)` gets
// the exact `UInt8(300)` complaint rather than 44.

let main(): Int = {
    let a: UInt8 = UInt8(WrappingUInt8(300));
    return 0;
};
