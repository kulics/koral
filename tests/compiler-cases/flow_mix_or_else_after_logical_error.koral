// EXPECT-ERROR: 'or else' cannot be mixed with logical 'and' / 'or' without parentheses
// The flow layer and the logical layer do not mix implicitly. `ready and
// (flag_opt or else false)` and `(ready and flag) or else false` are both
// accepted and mean different things; this means neither.

let main(): Int = {
    let ready: Bool = true;
    let flag_opt = Option[Bool].Some(true);
    let ok = ready and flag_opt or else false;
    let _ = ok;
    return 0;
};
