// EXPECT: PASS
// The other half of the rule: binding a weak handle WHOLE is fine, and the
// binding keeps the `?T`. A `let` may be annotated `?T`, passed to a parameter
// of type `?T`, and upgraded with `?expr`.

type mutable Box(mutable value Int);

let consume(x ?Box) Int = {
    return when ?x in {
        .Some(v) then v.value,
        .None() then 0,
    };
};

let main() Int = {
    let b = Box(42);
    let w = ?Box(b);
    let w2 ?Box = w;
    if consume(w2) != 42 then {
        eprintln("FAIL: expected 42");
        return 1;
    };
    println("PASS");
    return 0;
};
