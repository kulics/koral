// EXPECT: 2 3 3
// EXPECT: 9
// Nested slots may carry `mutable` and a type annotation, like any other
// binding element.

type Inner(b: Int, c: Int);
type Outer(a: Int, rest: Inner);

let main(): Int = {
    let (mutable x, (mutable y, z: Int)) = Outer(1, Inner(2, 3));
    x += 1;
    y += 1;
    println("\(x) \(y) \(z)");

    for (n, (mutable m, _)) in [Outer(4, Inner(5, 6))] then {
        m += n;
        println("\(m)");
    };
    return 0;
};
