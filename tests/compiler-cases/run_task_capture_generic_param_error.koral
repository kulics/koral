// EXPECT-ERROR: sendable closure cannot capture non-sendable value 'x'
// A bare generic parameter is not sendable at a boundary: `f[T: Any]` cannot
// launder `T` into run_task's `sendable () -> Void` capture. Only a
// `sendable`-bounded parameter passes (run_task_capture_generic_sendable_ok;
// concurrency-design.md §跨界检查 (a)).

using "std/async" { ... };

let work[T: Any](x: T): Void = {
    let t = run_task(() => {
        let _ = x;
    });
    let _ = t.wait();
};

let main(): Void = {
    work(1);
};
