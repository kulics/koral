// EXPECT-ERROR: Type mismatch: expected UInt, got Int
// A raw-pointer walk takes an exact `UInt` index -- the same rule the
// collection subscript helpers enforce.

let main(): Int = {
    let p = alloc_memory[Int](1);
    init_memory(p, 5);
    let i = 0;
    println(p[i]);
    deinit_memory(p);
    dealloc_memory(p);
    return 0;
};
