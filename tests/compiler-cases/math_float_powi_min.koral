// EXPECT: powi_min_ok
// EXPECT: powi_basic_ok
// The exponent magnitude is routed through `UInt`, so `Int.min_value()` no
// longer overflows on negation; the huge power underflows/overflows to the
// IEEE result 0.0 (or 1.0 for base 1.0).

using "std/math" { ... };

let main(): Int = {
    let f2: Float64 = 2.0;
    let one: Float64 = 1.0;
    if f2.powi(Int.min_value()) == 0.0 and one.powi(Int.min_value()) == 1.0 and (-2.0).powi(
        Int.min_value(),
    ) == 0.0 then {
        println("powi_min_ok");
    };
    if f2.powi(10) == 1024.0 and f2.powi(0) == 1.0 and f2.powi(-1) == 0.5 then {
        println("powi_basic_ok");
    };
    return 0;
};
