// EXPECT: 0
// EXPECT: 0
// EXPECT: true
// EXPECT: true

// `null` through `as`: `null as UInt` is the zero address, and `null as *Int` /
// `null as *mutable T` round-trip through pointer bindings.

let mut_null[T: Any](): *mutable T = null as *mutable T;

let main(): Int = {
    // null as UInt is address 0.
    let u: UInt = null as UInt;
    println(u);

    // null as *Int round-trips through a *Int binding and back to an address.
    let p: *Int = null as *Int;
    let back: UInt = p as UInt;
    println(back);

    // null as *mutable T round-trips through a *mutable T binding.
    let m: *mutable UInt8 = mut_null[UInt8]();
    let m2: *mutable UInt8 = m;
    println(m2 == null);

    println(p == null);
    return 0;
};
