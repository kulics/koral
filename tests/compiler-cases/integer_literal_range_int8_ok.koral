// EXPECT: PASS
// In-range integer literals for the narrow types: the boundaries themselves
// must be accepted.
let main() Int = {
    let a = Int8(-128);
    let b = Int8(127);
    let c = UInt(0);
    let d = Int8(0);
    if a <> Int8(-128) then {
        eprintln("FAIL: a");
        return 1;
    };
    if b <> Int8(127) then {
        eprintln("FAIL: b");
        return 1;
    };
    println("PASS");
    return 0;
};
