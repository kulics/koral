// EXPECT: 0
// EXPECT: 0
// EXPECT: true

// `null` joins a `*mutable T` expected type whose pointee is a type parameter
// -- the empty-collection constructor shape (`List.new`-style).

type Buffer[T: Any](raw: *mutable T, len: UInt, cap: UInt);

given[T: Any] Buffer[T] {

    new(): Self = {
        return Buffer[T](null, 0, 0);
    };
};

let main(): Int = {
    let b = Buffer[Int].new();
    println(b.len);
    println(b.cap);
    println(b.raw == null);
    return 0;
};
