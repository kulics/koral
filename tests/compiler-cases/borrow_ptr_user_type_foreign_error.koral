// EXPECT-ERROR: does not satisfy the 'foreign' constraint

// `foreign` is decided by the compiler and is NOT claimable by a user
// declaration. A Koral `type` has a layout the compiler chooses, so a raw
// pointer to one carries no meaning across the FFI boundary. (The old `Pod`
// marker let a user write `given Raw as Pod {}` and opt straight in.)

type Raw(impl: Int);

let main() Int = {
    let raws = List[Raw].new();
    raws.push(Raw(impl: 1));
    let _ = raws.borrow_ptr();
    return 0;
};
