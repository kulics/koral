// Test that comparison patterns can establish exhaustiveness
// when they fully cover the integer range (> 0 and <= 0).
// This should now pass without error (issue #9 fixed).
// EXPECT: PASS

let classify(x Int) Int = {
    return when x in {
        > 0 then 1,
        <= 0 then 0,
    };
};

let main() Int = {
    let r1 = classify(5);
    let r2 = classify(-3);
    let r3 = classify(0);
    if r1 == 1 and r2 == 0 and r3 == 0 then {
        println("PASS");
        return 0;
    };
    println("FAIL");
    return 1;
};

