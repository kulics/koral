// EXPECT-ERROR: Type mismatch: expected Mask, got Int

// Compound assignment feeds the operator a value that already has the
// target's type -- the rule `d *= 2` on `Duration` follows too. A shift by a
// plain count takes the binary form: `m = m << 2`.

type Mask(bits: UInt8);

given Mask: ShiftLeft[Int] {
    public shift_left(self, other: Int): Mask = Mask(self.bits << UInt8(other));
};

let main(): Int = {
    let mutable m = Mask(1);
    m <<= 2;
    return 0;
};
