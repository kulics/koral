// EXPECT-ERROR: Cannot capture mutable variable 'n'; hold the state in a Cell and capture the cell instead

// Interpolating a `let mutable` inside a lambda is a capture of the binding:
// the interpolation lowers to `to_string` on the binding, and a snapshot would
// hide later updates.

let main(): Int = {
    let mutable n = 1;
    let f = () => "\(n)";
    return 0;
};
