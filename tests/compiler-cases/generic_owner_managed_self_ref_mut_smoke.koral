// EXPECT-EXACT: 3

type Box[T Any](mut value T, mut touches Int)

given[T Any] Box[T] {
    public bump_and_keep(self ref mut Self) ref mut Self = {
        self.touches = self.touches + 1
        return self
    }
}

let main() Int = {
    let strong ref mut Box[Int] = box(Box[Int](1, 1))
    let alias ref mut Box[Int] = strong.bump_and_keep()
    alias.touches = alias.touches + 1
    println(strong.touches.to_string())
    return 0
}