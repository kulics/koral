// EXPECT-ERROR: Duplicate definition: Thing
//
// §同名顶层定义的冲突规则 (name-resolution.md, 2026-11-12): a `private` and a
// module-level definition of the same name in one module conflict no matter
// which side is collected first -- a private symbol may not shadow its
// module-level peer. This case collects the entry file's `internal Thing`
// before the helper's `private Thing`; the sibling case reverses the files.
// Both must report the same duplicate-definition error.
using "./helper.koral";

type Thing(n: Int);

let main(): Void = {
    let t = Thing(1);
    let _ = t;
};
