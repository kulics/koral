// EXPECT: PASS
// Bitwise operations on the Wrapping family: `& | ^` and `~`, with integer
// literals joining the other operand's type.

let main() Int = {
    let x WrappingUInt8 = 202; // 0b11001010
    let y WrappingUInt8 = 172; // 0b10101100
    if not ((x & y) == 136) then { // 0b10001000
        eprintln("FAIL: WrappingUInt8 and");
        return 1;
    };
    if not ((x | y) == 238) then { // 0b11101110
        eprintln("FAIL: WrappingUInt8 or");
        return 1;
    };
    if not ((x ^ y) == 102) then { // 0b01100110
        eprintln("FAIL: WrappingUInt8 xor");
        return 1;
    };
    if not ((~x) == 53) then { // 0b00110101
        eprintln("FAIL: WrappingUInt8 not");
        return 1;
    };

    // Literal operand joins to the Wrapping width.
    if not ((x & 1) == 0) then {
        eprintln("FAIL: WrappingUInt8 and literal");
        return 1;
    };

    // Signed widths work the same way.
    let s WrappingInt8 = -1; // all bits set
    if not ((s & 127) == 127) then {
        eprintln("FAIL: WrappingInt8(-1) and 127 != 127");
        return 1;
    };

    // Compound bitwise assignment keeps the same surface.
    let mutable m WrappingUInt8 = 202;
    m &= 240;
    if not (m == 192) then {
        eprintln("FAIL: WrappingUInt8(202) and= 240 != 192");
        return 1;
    };

    println("PASS");
    return 0;
};
