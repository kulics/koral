// EXPECT-ERROR: Enum case 'Bogus' not found in type 'Shape'
// The `is` desugar blames the whole `if`, like the seed's ambient span:
// `if s is .Bogus(r) then ...` reports at the `if`, not at the subject.

type Shape {
    Circle(r: Float64),
    Rectangle(w: Float64, h: Float64),
};

let g(s: Shape): Bool = if s is .Bogus(r) then true else false;
