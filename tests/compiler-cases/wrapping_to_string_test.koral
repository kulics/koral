// EXPECT: a=18446744073709551615
// EXPECT: n=-5
// EXPECT: u=18446744073709551611
// EXPECT: big=18446744073709551615
// EXPECT: PASS
// Wrapping values print what the plain counterpart of the same width would
// print AFTER a lossless same-width retype. A negative WrappingInt prints
// signed; the same bits read through WrappingUInt print as a large unsigned.

let main() Int = {
    let b Int8 = -1;
    println("a=\(WrappingUInt(b))");

    let n WrappingInt = WrappingInt(-5);
    println("n=\(n)");

    let u WrappingUInt = WrappingUInt(WrappingInt(-5));
    println("u=\(u)");

    let big WrappingUInt64 = WrappingUInt64(18446744073709551615);
    println("big=\(big)");

    if n.to_string() != Int(-5).to_string() then {
        eprintln("FAIL: WrappingInt(-5) prints \(n), plain prints \(Int(-5))");
        return 1;
    };

    println("PASS");
    return 0;
};
