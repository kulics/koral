// Regression: outer lambda capture analysis must respect nested lambda shadowing.
// EXPECT: 42
// EXIT: 0

type Box(value Int);

given Box {
    shadow_ok(*self) Int = {
        let borrowed = self;
        let outer Func() Int = () -> {
            let inner Func(Int) Int = (borrowed Int) -> borrowed + 1;
            return inner(41);
        };
        return outer();
    };
};

let main() Int = {
    let box = Box(0);
    println(box.shadow_ok());
    return 0;
};