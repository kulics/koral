// EXPECT-ERROR: Non-exhaustive match on type 'List[Int]': missing cases [_, ...]
// Design guard: a list pattern only covers a length completely when every slot
// is irrefutable. `[1, ...]` may match nothing (a list whose head is not 1),
// so it does not close the "length >= 1" case and the match still needs a
// catchall.
using "std" { ... };

let main() Int = {
    let xs List[Int] = [1];
    let s = when xs in {
        [] then 0,
        [1, ...] then 1,
    };
    println(s);
    return 0;
};
