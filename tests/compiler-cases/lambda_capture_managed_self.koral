// EXPECT: 2
// A method's `self` is capturable even when the receiver type is
// `type mutable`: the binding cannot be reassigned, and the capture is a
// handle copy (a retain), so the closure shares the object the method body
// already mutates. The mutable-capture ban is for `let mutable` locals,
// where a copy would silently snapshot storage the closure does not own
// (see lambda_error_capture_mutable_method_receiver).

type mutable Box(value: Int);

given Box {
    total(self, xs: List[Int]): Int =
        xs.lazy().filter((x) => x > self.value).to_list().count();
};

let main(): Void = {
    println(Box(3).total([1, 4, 5]).to_string());
};
