// EXPECT-ERROR: Panic: JSON error: maximum nesting depth exceeded

// Printing a tree past the depth cap is a formatting error, not a truncated
// document: `to_string` reports it the same way the parser does instead of
// silently emitting `null` for the over-deep subtree.

using "std/json" { ... };

let build_deep(n: UInt): JsonValue = {
    let mutable v = JsonValue.Null();
    for _ in 0..<n then {
        let inner: List[JsonValue] = [v];
        v = JsonValue.Array(inner.to_frozen_list());
    };
    return v;
};

let main(): Void = {
    println(build_deep(3000).to_string());
};
