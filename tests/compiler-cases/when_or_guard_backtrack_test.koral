// EXPECT: when_or_guard_backtrack_ok
// Design guard: an arm pattern with `or` offers several READINGS, and the
// where-guard is re-evaluated on each reading's own bindings -- not once on
// the first matching reading. `.A(x, _) or .A(_, x)` on `A(1, 3)` binds x=1
// then x=3: with `where x > 2` the left reading is refused and the right one
// runs; with `where x > 0` the left reading is accepted and the right one is
// never tried. A refused guard falls through to the next reading of the SAME
// arm, so the wildcard arm stays unreachable for those values.

type E {
    A(x Int, y Int),
    B(x Int, y Int),
};

let pick(e E) Int = when e in {
    .A(x, _) or .A(_, x) where x > 2 then x,
    _ then 0 - 1,
};

let pick_left(e E) Int = when e in {
    .A(x, _) or .A(_, x) where x > 0 then x,
    _ then 0 - 1,
};

let pick_three(e E) Int = when e in {
    .A(x, _) or .A(_, x) or .B(x, _) where x > 2 then x,
    _ then 0 - 1,
};

let pick_nested(xs List[List[Int]]) Int = when xs in {
    [[x, ...] or [_, x]] where x > 2 then x,
    _ then 0 - 1,
};

type MyOpt {
    None(),
    Some(value Int),
};

let wrap(v Int) MyOpt = MyOpt.Some(v);

// A guard that itself binds through `is` re-runs per reading too, and its
// bindings must land in the SAME slots on every reading -- the body sees
// whichever reading's guard accepted, not the last one compiled.
let pick_with_is(e E) Int = when e in {
    .A(x, _) or .A(_, x) where wrap(x) is .Some(w) and w > 0 then w,
    _ then 0 - 1,
};

let main() Int = {
    if pick(E.A(1, 3)) != 3 then {
        eprintln("FAIL: guard must re-run per reading");
        return 1;
    };
    if pick_left(E.A(1, 3)) != 1 then {
        eprintln("FAIL: first reading wins when its guard accepts");
        return 1;
    };
    if pick_three(E.A(1, 3)) != 3 then {
        eprintln("FAIL: backtracking across three readings");
        return 1;
    };
    if pick_three(E.B(7, 0)) != 7 then {
        eprintln("FAIL: later reading when earlier ones fail to match");
        return 1;
    };
    if pick_with_is(E.A(1, 3)) != 1 then {
        eprintln("FAIL: guard is-bindings track the reading that accepted");
        return 1;
    };
    let mutable inner = List[Int].new();
    inner.push(1);
    inner.push(3);
    let mutable outer = List[List[Int]].new();
    outer.push(inner);
    if pick_nested(outer) != 3 then {
        eprintln("FAIL: nested or readings backtrack too");
        return 1;
    };
    println("when_or_guard_backtrack_ok");
    return 0;
};
