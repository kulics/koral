// EXPECT: float nan and signed zero ok

// Patterns match under IEEE equality: NaN matches no literal (only a guard
// such as `v != v` catches it), and 0.0 matches -0.0.

let main() Int = {
    let nan = Float64.nan();
    let n = when nan in {
        1.5 then 1,
        v if v != v then 2,
        _ then 0,
    };
    if n != 2 then {
        eprintln("FAIL: NaN must fall to the guard");
        return 1;
    };
    let z = -0.0;
    let m = when z in {
        0.0 then 1,
        _ then 0,
    };
    if m != 1 then {
        eprintln("FAIL: -0.0 must match the pattern 0.0");
        return 1;
    };
    println("float nan and signed zero ok");
    return 0;
};
