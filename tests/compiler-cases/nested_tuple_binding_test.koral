// EXPECT: 1 2 3
// EXPECT: 4 5 6
// EXPECT: 7 8 9
// EXPECT: 11 12 10
// EXPECT: 20 21 22
// Nested tuple destructuring in `let` and `for`: a slot may itself be a
// tuple binding, the same way a nested <tuple-pattern> works in `when`/`is`.
// `let (a, (b, c))` binds a, then destructures the second field as (b, c).

type Inner(b: Int, c: Int);
type Outer(a: Int, rest: Inner);
type Pair2(left: Inner, right: Int);

let main(): Int = {
    let (a, (b, c)) = Outer(1, Inner(2, 3));
    println("\(a) \(b) \(c)");

    for (x, (y, z)) in [Outer(4, Inner(5, 6)), Outer(7, Inner(8, 9))] then {
        println("\(x) \(y) \(z)");
    };

    // Nesting at the front slot: `((p, q), r)`.
    let ((p, q), r) = Pair2(Inner(11, 12), 10);
    println("\(p) \(q) \(r)");

    // Deep nesting and a leaf beside a nested slot.
    let (m, (n, o)) = Outer(20, Inner(21, 22));
    println("\(m) \(n) \(o)");

    return 0;
};
