// EXPECT-ERROR: 'self' cannot escape a drop body: it may only be the receiver of a field access or a method call

// `&self.v` hands out a raw pointer into the dying object that outlives the
// destructor, so any `self` under an address-of (or a `*T` / `*mutable T`
// forming operator) is an escape -- even though `self.v` on its own is the
// legal receiver shape.

type mutable Res(mutable v: Int);

given Res: Drop {
    drop(self): Void = {
        let p: *Int = &self.v;
        let _ = p;
    };
};

let main(): Void = {
    {
        let r = Res(5);
        println("alive");
    };
    println("done");
};
