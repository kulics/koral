// Test: global variables with mixed explicit/inferred types

type sendable Config(name: String, value: Int);

private let version: Int = 1;
private let label: String = "production";
private let verbose: Bool = true;
private let mutable retries: Int = 3;

private let items: FrozenList[Int] = [10, 20, 30].to_frozen_list();
private let mapping: FrozenDict[String, String] = ["key": "value"].to_frozen_dict();

private let transform: sendable (Int) -> Int = (x) => x * 2;
private let mutable fallback: sendable (Int) -> Int = (x) => x;

private let cfg: Config = Config("main", 42);

public let main(): Void = {
    println(version);
    println(label);
    println(verbose);
    println(retries);
    println(items.get(1).unwrap());
    let mapped = mapping.get("key").unwrap();
    println(mapped);
    println(transform(5));
    println(cfg.name);
    println(cfg.value);
    retries = 5;
    fallback = (x) => x + 100;
    println(retries);
    println(fallback(1));
};
// EXPECT: 1
// EXPECT: production
// EXPECT: true
// EXPECT: 3
// EXPECT: 20
// EXPECT: value
// EXPECT: 10
// EXPECT: main
// EXPECT: 42
// EXPECT: 5
// EXPECT: 101
