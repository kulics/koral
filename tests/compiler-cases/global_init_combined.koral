// Test: global variables with mixed explicit/inferred types

type Config(name String, value Int)

file_private let version = 1
file_private let label = "production"
file_private let verbose = true
file_private let mutable retries = 3

file_private let items = [10, 20, 30]
file_private let mapping = ["key": "value"]

file_private let transform Func(Int) Int = (x) -> x * 2
file_private let mutable fallback Func(Int) Int = (x) -> x

file_private let cfg = Config("main", 42)

public let main() Void = {
    println(version)
    println(label)
    println(verbose)
    println(retries)
    println(items[1])
    println(mapping["key"])
    println(transform(5))
    println(cfg.name)
    println(cfg.value)
    retries = 5
    fallback = (x) -> x + 100
    println(retries)
    println(fallback(1))
}
// EXPECT: 1
// EXPECT: production
// EXPECT: true
// EXPECT: 3
// EXPECT: 20
// EXPECT: value
// EXPECT: 10
// EXPECT: main
// EXPECT: 42
// EXPECT: 5
// EXPECT: 101
