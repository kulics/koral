// Test: global variables with mixed explicit/inferred types

type Config(name String, value Int)

private let version = 1
private let label = "production"
private let verbose = true
private let mutable retries = 3

private let items = [10, 20, 30]
private let mapping = ["key": "value"]

private let transform Func(Int) Int = (x) -> x * 2
private let mutable fallback Func(Int) Int = (x) -> x

private let cfg = Config("main", 42)

public let main() Void = {
    println(version)
    println(label)
    println(verbose)
    println(retries)
    println(items[1])
    println(mapping["key"])
    println(transform(5))
    println(cfg.name)
    println(cfg.value)
    retries = 5
    fallback = (x) -> x + 100
    println(retries)
    println(fallback(1))
}
// EXPECT: 1
// EXPECT: production
// EXPECT: true
// EXPECT: 3
// EXPECT: 20
// EXPECT: value
// EXPECT: 10
// EXPECT: main
// EXPECT: 42
// EXPECT: 5
// EXPECT: 101
