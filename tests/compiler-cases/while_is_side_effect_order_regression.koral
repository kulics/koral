// EXPECT: while-order: PASS

type MaybeInt {
    Some(value Int),
    None(),
};

type mutable Tracker(mutable log StringBuilder);

given Tracker {

    left_false(self) Bool = {
        self.log.push_string("L");
        return false;
    };

    next(self) MaybeInt = {
        self.log.push_string("N");
        return MaybeInt.Some(1);
    };
};

let main() Int = {
    let mutable tracker = Tracker(StringBuilder.new());
    while tracker.left_false() and tracker.next() is .Some(value) then {
        println(value.to_string());
    };
    if tracker.log.to_string() == "L" then {
        println("while-order: PASS");
        return 0;
    };
    println("while-order: FAIL " + tracker.log.to_string());
    return 1;
};