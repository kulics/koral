// EXPECT: while-order: PASS

type MaybeInt {
    Some(value Int),
    None(),
}

type Tracker(mutable log String)

given Tracker {

    left_false(*mutable self) Bool = {
        self.log.push_string("L")
        return false
    }

    next(*mutable self) MaybeInt = {
        self.log.push_string("N")
        return MaybeInt.Some(1)
    }
}

let main() Int = {
    let mutable tracker = Tracker("")
    while tracker.left_false() and tracker.next() is .Some(value) then {
        println(value.to_string())
    }
    if tracker.log == "L" then {
        println("while-order: PASS")
        return 0
    }
    println("while-order: FAIL " + tracker.log)
    return 1
}