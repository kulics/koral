// EXPECT: 3
// EXPECT: 6
// EXPECT: newline grouped expression ok

let main() Int = {
    let sum = (
        1
        + 2
    )
    println(sum)

    let values = [
        1
        + 2,
        3,
    ]
    println(values[0] + values[1])

    println("newline grouped expression ok")
    return 0
}