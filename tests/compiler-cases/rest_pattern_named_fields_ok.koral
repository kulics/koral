// `...` means "ignore every field", named or not, so a type with named fields
// takes it exactly like a positional one. Whole-list elision matches none of
// the fields by name, which is why the declaration's labelling rules have
// nothing to say about it.
// EXPECT: named_fields_elided_ok

using "std" { ... };

type Button(width: Int, height: Int =, label: String =);

let main(): Int = {
    let b = Button(1, height = 2, label = "x");
    let s = when b in {
        Button(...) then 7,
    };
    if s == 7 then {
        println("named_fields_elided_ok");
    };
    return 0;
};
