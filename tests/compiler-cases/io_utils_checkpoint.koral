// EXPECT: utils checkpoint passed
using std::io { .. }

let main() Void = {
    // Verify ByteBuffer.from_string creates correct buffer
    let buf = ByteBuffer.from_string("hello")
    // Verify from_string round-trips via from_bytes
    let buf2 = ByteBuffer.from_bytes("world".to_bytes())
    
    // Verify seek works
    let sr = buf.seek(SeekOrigin.Start(0))
    when sr in {
        .Ok(pos) then assert(pos == 0, "seek to start"),
        .Error(_) then assert(false, "seek should succeed"),
    }

    // Verify flush is a no-op
    let fr = buf.flush()
    when fr in {
        .Ok(_) then {},
        .Error(_) then assert(false, "flush should succeed"),
    }

    print("utils checkpoint passed")
}
