// EXPECT: PASS
// Test: lambda captures must not hold dangling raw pointers to stack

let test_lambda_capture_ref() Void = {
    let mutable x Int = 42
    let r * Int = &x  // r references x on stack
    let f Func() Int = () -> *r  // lambda captures r - x must be heap-promoted
    let result = f()
    assert(result == 42, "lambda capture ref")
}

let test_lambda_capture_field_ref() Void = {
    let mutable x Int = 100
    let r * Int = &x
    // Lambda captures r through a projection
    let get_val Func() Int = () -> *r
    let v = get_val()
    assert(v == 100, "lambda capture field ref")
}

let main() Void = {
    test_lambda_capture_ref()
    test_lambda_capture_field_ref()
    println("PASS")
}
