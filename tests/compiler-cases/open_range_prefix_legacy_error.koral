// EXPECT-ERROR: open ranges are spelled with '...': write '...b', '...<b', or '...'

// `..5` / `..<5` / `..` no longer open a range: the elided left bound is
// written `...` (grammar.bnf <open-range-op>).

let main(): Int = {
    let x = ..5;
    if x.contains(0) then {
        return 1;
    };
    return 0;
};
