// EXPECT: ok

type Big(value Int)
given Big not Deref

type Wrapped(mutable kind * Big)

let select(flag Bool, wrapped *mutable Wrapped, fallback * Big) Option[* Big] = {
    let subject = if flag then Option[*mutable Wrapped].Some(wrapped) else Option[*mutable Wrapped].None()
    return Option[* Big].Some(when subject in {
        .Some(value) then value.kind,
        .None() then fallback,
    })
}

let main() Void = {
    let big1 *mutable Big = box(Big(7))
    let big2 *mutable Big = box(Big(9))
    let wrapped *mutable Wrapped = box(Wrapped(big1))
    let selected_true = select(true, wrapped, big2)
    let selected_false = select(false, wrapped, big2)
    assert(selected_true.unwrap().value == 7, "true branch should widen *mutable to *")
    assert(selected_false.unwrap().value == 9, "false branch should use fallback")
    println("ok")
}
