// EXPECT: ok

type Big(value Int)
given Big not Deref

type Holder(mutable value * Big)

let read_value(holder *mutable Holder) * Big = holder.value

let main() Void = {
    let big *mutable Big = box(Big(7))
    let holder *mutable Holder = box(Holder(big))
    let value * Big = read_value(holder)
    assert(value.value == 7, "mutable field * should widen to readonly *")
    println("ok")
}
