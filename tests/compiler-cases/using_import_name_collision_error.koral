// EXPECT-ERROR: collides with a name already in scope; an import-all cannot be renamed
// EXPECT-ERROR: collides with a name already in scope; rename it with 'as'
// A name a `using` brings in cannot silently lose to a different declaration
// already under that spelling (§3.3). The local one winning quietly is how an
// imported symbol becomes unreachable through its own name with nothing said.
//
// The fix differs by import kind: an explicit item can be renamed with `as`;
// an import-all has no item to rename, so the reader switches to a list.
using "std" { Duration };
using "std/json";

type Duration(x Int);
type JsonValue(v Int);

let main() Int = 0;
