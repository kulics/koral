// std.text: the 0 flag follows Python: '=' only when no align is written.
// EXPECT: zero_default_ok
// EXPECT: zero_explicit_right_ok
// EXPECT: zero_explicit_left_ok
// EXPECT: zero_explicit_fill_ok
// EXPECT: zero_explicit_center_ok

using "std/text" { ... };

let main(): Int = {
    // No align: fill '0' with '=' alignment (sign then zeros)
    if (0 - 42).format("08").equals("-0000042") then println("zero_default_ok")
    else println("FAIL zero_default: [" + (0 - 42).format("08") + "]");

    // Explicit '>' with 0: zeros keep that align
    if (0 - 42).format(">08").equals("00000-42") then println("zero_explicit_right_ok")
    else println("FAIL zero_explicit_right: [" + (0 - 42).format(">08") + "]");

    if 42.format("<08").equals("42000000") then println("zero_explicit_left_ok")
    else println("FAIL zero_explicit_left: [" + 42.format("<08") + "]");

    // An explicit fill means the 0 flag is ignored (Python)
    if 42.format("*<08").equals("42******") then println("zero_explicit_fill_ok")
    else println("FAIL zero_explicit_fill: [" + 42.format("*<08") + "]");

    if 42.format("^08").equals("00042000") then println("zero_explicit_center_ok")
    else println("FAIL zero_explicit_center: [" + 42.format("^08") + "]");

    return 0;
};
