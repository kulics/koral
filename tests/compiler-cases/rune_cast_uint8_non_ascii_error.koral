// EXPECT-ERROR: Rune literal must be a single ASCII character when used as UInt8
// `UInt8('中')` is a `UInt8` context, and a byte holds no other code point:
// the cast complains at the literal the way `let b: UInt8 = '中'` does.

let main(): Int = {
    let b = UInt8('中');
    println(b);
    return 0;
};
