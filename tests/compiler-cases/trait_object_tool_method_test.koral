// EXPECT: tool:3
// EXPECT: 20
// A trait OBJECT can call the trait's TOOL methods. `given Tag { ... }` entity
// methods are part of the trait's interface: callable on a concrete conforming
// type and on an erased `Tag` reference alike. The tool body runs against the
// receiver's conformance (`self.value()` goes to the witness).

trait Tag {
    value(self): Int;
};

given Tag {
    describe(self): String = "tool:" + self.value().to_string();
    plus(self, add: Int): Int = self.value() + add;
};

type Num(x: Int);

given Num: Tag {
    value(self): Int = self.x;
};

let main(): Int = {
    let obj: Tag = Num(3);
    println(obj.describe());
    println(obj.plus(17).to_string());
    return 0;
};
