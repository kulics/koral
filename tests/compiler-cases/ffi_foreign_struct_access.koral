// EXPECT: ok

type foreign Stat(st_mode UInt32, st_size Int64);

given Stat {

    new() Stat = Stat(UInt32(0), Int64(0));
};

let main() Void = {
    let mutable st = Stat.new();
    st.st_mode = UInt32(1);
    let st_ptr *Stat = &st;
    let size = st_ptr.st_size;
    if size >= Int64(0) then {
        println("ok");
    } else {
        println("ok");
    };
};
