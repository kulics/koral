// EXPECT: 5
// A body-less `let foreign` without the `unsafe` marker is the binding
// author's safe assertion (unsafe-design.md §E): scalar signature, no
// preconditions, callable from safe code with no `unsafe` block.

let foreign abs(x: Int32): Int32;

let main(): Int = {
    let v = abs(-5);
    println(Int(v).to_string());
    return 0;
};
