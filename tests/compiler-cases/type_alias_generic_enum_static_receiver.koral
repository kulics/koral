// EXPECT: 7
// EXPECT: alias generic enum static receiver ok

type MaybeInt = Option[Int];

let main() Int = {
    let direct MaybeInt = MaybeInt.Some(7);

    when direct in {
        .Some(v) then println(v),
        .None() then println(0),
    };

    println("alias generic enum static receiver ok");
    return 0;
};