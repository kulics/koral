// EXPECT-ERROR: Panic: List modified during iteration or borrow: __index_slot
// 修改锁：借出中经 list 的下标写 `xs[0] = v` 同样入口查锁（窗写 `s[i] = v`
// 不查锁——那是借出的授权通道）。
let main(): Void = {
    let xs = List[UInt8].new();
    xs.push(1);
    xs.push(2);
    xs.borrow_slice((s) => {
        let _ = s.count();
        xs[0] = 9;
    });
};
