// EXPECT: strslice_open_empty_ok
// EXPECT: strslice_open_siblings_empty_ok

// The String mirror of the empty-Open-slice rule: `a<..<a` names no bytes,
// so substring must return "" instead of panicking "invalid range".

let main(): Void = {
    let text = "abcde";

    // The once-broken case: 1<..<1 must slice to the empty string.
    let empty = text.substring(1<..<1);
    assert(empty.count() == 0, "substring(1<..<1) is empty");
    assert(text.count() == 5, "substring leaves source untouched");
    println("strslice_open_empty_ok");

    // Sibling empty ranges keep behaving as empty slices.
    assert(text.substring(2..<2).count() == 0, "2..<2 empty");
    assert(text.substring(2<..2).count() == 0, "2<..2 empty");
    assert(text.substring(2<..<3).count() == 0, "2<..<3 empty");
    assert(text.substring(1<..<2).count() == 0, "1<..<2 empty");
    assert(text.substring(5<..<5).count() == 0, "5<..<5 empty at end");

    // A non-empty Open span still slices normally.
    let slice = text.substring(1<..<4);
    assert(slice == "cd", "1<..<4 picks cd");
    println("strslice_open_siblings_empty_ok");
};
