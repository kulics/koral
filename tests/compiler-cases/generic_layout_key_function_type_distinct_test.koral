// EXPECT-EXACT: 6
// EXPECT-EXACT: 1
// EXPECT-EXACT: 6
// EXPECT-EXACT: 6
// Design guard: a layout key names a monomorphized C entity, so two types that
// get one key share one C symbol. `(Int) -> Int` and `(Bool) -> Int` used to
// both spell `Fn`, so `Holder[(Int) -> Int]` and `Holder[(Bool) -> Int]` were
// one struct and one `get` -- the emitted C even labelled the single definition
// with only one of the two instantiations. A key now carries the function
// signature and the parameter count (`Fn_<n>_<params>_<ret>`, which a bare
// `Fn_<params>_<ret>` join is not -- `() -> R_I` and `(R) -> I` would both
// spell `Fn_R_I`).
//
// What the suite can see is the ODR invariant: two instances parameterized by
// different function types must both survive as separate instances and both
// answer correctly when used side by side. The C symbol itself is not compared
// (the two compilers number DefIds differently), so this pins the consequence
// rather than the spelling.

type Holder[T: Any](value: T);

given[T: Any] Holder[T] {
    get(self): T = self.value;
    kind(self): Int = 1;
};

let double(x: Int): Int = x * 2;
let negate(x: Bool): Int = if x then 1 else 0;

let main(): Int = {
    let a = Holder[(Int) -> Int](double);
    let b = Holder[(Bool) -> Int](negate);
    println(a.get()(3).to_string());
    println(b.get()(true).to_string());
    let c = Holder[() -> Int](() => 6);
    let d = Holder[(Int) -> Int](double);
    println(c.get()().to_string());
    println(d.get()(3).to_string());
    return 0;
};
