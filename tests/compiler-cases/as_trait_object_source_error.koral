// EXPECT-ERROR: Cannot cast a trait object to another trait object
// Casting FROM a trait object is refused: a trait object carries one
// conformance, and re-erasing it under another trait is not a cast. The
// upcast call form takes a concrete value, not an already-erased one.

trait A {
    a(self) Int;
};

trait B {
    b(self) Int;
};

type Impl();

given Impl as A {
    a(self) Int = 1;
};

given Impl as B {
    b(self) Int = 2;
};

let main() Int = {
    let x = Impl();
    let obj A = x;
    let y = B(obj);
    return 0;
};
