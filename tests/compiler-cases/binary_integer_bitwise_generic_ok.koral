// EXPECT: 240
// `BinaryInteger` refines the bitwise operator traits, so one bound carries
// `& | ^ ~ << >>` -- and the Wrapping family satisfies it with its own masking
// shift semantics underneath.

using "std/math" { ... };

let mask[T: BinaryInteger](a: T, b: T): T = a & b;

let main(): Int = {
    println(mask(WrappingUInt8(255), WrappingUInt8(240)).to_string());
    return 0;
};
