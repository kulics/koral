// EXPECT: flow wrapping a parenthesised logical: 0
// EXPECT: logical wrapping a parenthesised flow: 1
// Parentheses are the only way to cross the flow / logical boundary, and they
// are enough: each form below is accepted and means exactly what the
// parentheses say.

let main() Int = {
    let ready Bool = true;
    let opt = Option[Int].Some(1);

    // A flow expression whose transform is a parenthesised logical
    // expression: `Some(1 == 1 and false)` is `Some(false)`.
    let transformed = opt and then (it == 1 and false);

    // A logical expression whose right operand is a parenthesised flow
    // expression: `true and (Some(1) ... or else false)` is `true`.
    let combined = ready and (opt and then it > 0 or else false);

    println(
        "flow wrapping a parenthesised logical: " + (if (transformed or else true) then 1
        else 0).to_string(),
    );
    println(
        "logical wrapping a parenthesised flow: " + (if combined then 1 else 0).to_string(
        ),
    );
    return 0;
};
