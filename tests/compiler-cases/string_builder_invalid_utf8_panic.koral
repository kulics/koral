// EXPECT-ERROR: Panic: StringBuilder.to_string: invalid UTF-8
// checked 快照校验 UTF-8：push_* 写入面已挡住非法字节（见
// string_builder_push_byte_utf8_panic），经 unsafe 免检构造混进非法字节后
// to_string 仍然收口，不再静默产出非法 String。

let main(): Void = {
    let mutable sb = StringBuilder.new();
    let raw: List[UInt8] = [97, 255];
    sb.push_string(unsafe { String.from_bytes_unchecked(raw) });
    let _ = sb.to_string();
};
