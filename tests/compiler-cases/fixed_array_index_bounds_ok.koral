// EXPECT: 20
// EXPECT: 30
// EXPECT: 12
// EXPECT: 62
// The bounds check does not disturb in-bounds access: reads, writes and
// compound writes through a numeric index all work, including the last
// element (`N - 1`).

let main(): Int = {
    let mutable a: [3]Int = [10, 20, 30];
    println(a[1]);

    a[2] = 30;
    println(a[2]);

    let i: Int = 0;
    a[i] += 2;
    println(a[i]);

    let mutable sum = 0;
    for k in 0..<3 then {
        sum += a[k];
    };
    println(sum);
    return 0;
};
