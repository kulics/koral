using "trait_plain_import_bound_identity_test/alpha" { Tag, a_box };
using "trait_plain_import_bound_identity_test/beta" { b_box };

// EXPECT: 7
// A plain `using` binds the imported trait under THIS module's name. Two
// modules each declare a trait called `Tag`; the bound `T Tag` written here
// must mean the one this file imported, not whichever `Tag` happens to sit in
// the global spelling table. The conformance the call needs is alpha's.

let read[T Tag](x T) Int = x.value();

let main() Int = {
    println(read(a_box()).to_string());
    return 0;
};
