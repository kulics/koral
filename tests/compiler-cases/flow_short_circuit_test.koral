// EXPECT-EXACT: default on None
// EXPECT-EXACT: done
// Flow operators short-circuit: the transform of `and then` runs only on
// `Some` / `Ok`, and the default of `or else` runs only on `None` / `Error`.
// The exact-match expectations are the guard: if either unused side ran, it
// would print and the line count would not match.

let log_bool(s String) Bool = {
    println(s);
    return true;
};

let log_int(s String) Int = {
    println(s);
    return 0;
};

let main() Int = {
    let none = Option[Int].None();

    // transform body must NOT run when the operand is None
    let a = none and then log_bool("transform ran");

    // default must NOT run when the operand is Some
    let some = Option[Int].Some(1);
    let b = some or else log_int("default ran");

    // default DOES run when the operand is None
    let c = none or else log_int_with_note();

    let _ = a;
    let _ = b;
    let _ = c;
    println("done");
    return 0;
};

let log_int_with_note() Int = {
    println("default on None");
    return 7;
};
