// EXPECT: float pattern ok

// A float literal pattern matches by IEEE equality at the subject's width.

let main() Int = {
    let x = 1.5;
    let n = when x in {
        1.5 then 1,
        -2.25 then 2,
        _ then 0,
    };
    if n != 1 then {
        eprintln("FAIL: 1.5 should match 1.5");
        return 1;
    };
    let neg = -2.25;
    let m = when neg in {
        1.5 then 1,
        -2.25 then 2,
        _ then 0,
    };
    if m != 2 then {
        eprintln("FAIL: -2.25 should match -2.25");
        return 1;
    };
    let e = 2.5e-3;
    let k = when e in {
        2.5e-3 then 3,
        _ then 0,
    };
    if k != 3 then {
        eprintln("FAIL: 2.5e-3 should match 2.5e-3");
        return 1;
    };
    println("float pattern ok");
    return 0;
};
