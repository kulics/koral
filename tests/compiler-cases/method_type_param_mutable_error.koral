// EXPECT-ERROR: Type 'Vec' does not satisfy the 'mutable' constraint (checking constraint T: mutable). Only types declared with 'type mutable' can be used as weak references.

// A method's own type parameters are enforced at the call site exactly like a
// free function's: `get[T mutable]` rejects an argument whose type is not
// declared `type mutable`, with the same diagnostic a free function produces.

type Vec(x Int, y Int);
type Holder(data Int);

given Holder {
    public get[T mutable](self, x T) Int = {
        return 1;
    };
};

let main() Int = {
    let v = Vec(1, 2);
    let e = Holder(1).get(v);
    return 0;
};
