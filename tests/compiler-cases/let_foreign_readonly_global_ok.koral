// EXPECT: foreign readonly ok
// `let foreign` without `mutable` on a runtime-owned C variable: read-only on
// the Koral side, bare `extern` in C. Koral mutability must not leak into the
// C linkage signature -- the runtime draws this seed lazily and may write it
// after program start, so an `extern const` emission would clash with the
// runtime's definition and refuse to compile.

let foreign "__koral_hash_seed_value" seed_value: UInt;

let main(): Int = {
    // The seed may still be undrawn (zero) here; the point is the link+read.
    let drawn = seed_value;
    if drawn != UInt(0) then {
        println("foreign readonly ok (seed drawn)");
    } else {
        println("foreign readonly ok");
    };
    return 0;
};
