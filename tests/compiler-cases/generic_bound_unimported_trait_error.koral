// EXPECT-ERROR: Undefined trait: RandomSource

// A bound is a name like any other. `Random` comes in below, but the trait its
// parameter is bounded by does not -- and a bound this module cannot see is
// `Undefined trait`, not a silent pass.

using "std/rand" { Random, DefaultRandomSource };

public let main(): Int = {
    let r = Random[DefaultRandomSource].new(DefaultRandomSource.new());
    let _ = r;
    return 0;
};
