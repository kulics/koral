// EXPECT-ERROR: Type mismatch: expected Int, got Bool
// An enum case constructor checks its arguments like a struct constructor
// does. `E.A` declares `x Int`, so passing a `Bool` is a type error.

type E {
    A(x: Int),
    B(y: Bool),
};

let main(): Int = {
    let wrong = E.A(true);
    let _ = wrong;
    return 0;
};
