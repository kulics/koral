// EXPECT: json_error_ok
// JsonError 的载荷字段统一命名 `detail`（与 IoError.Other(detail) 同名）。

using "std/json" { JsonError };

let main(): Int = {
    let e = JsonError("bad token", 7);
    assert(e.detail == "bad token", "detail field");
    assert(e.position == 7, "position field");
    assert(e.message().contains("7"), "message includes position");
    assert(e.message().contains("bad token"), "message includes detail");
    assert(e.to_string() == e.message(), "to_string matches message");

    println("json_error_ok");
    return 0;
};
