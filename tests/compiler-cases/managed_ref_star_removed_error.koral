// EXPECT-ERROR: managed refs are removed; raw pointers must be '*unsafe T'
// Design guard: `*T` is gone as a type spelling. Managed references were
// removed from the language model; the only pointer syntax left is the raw
// `*unsafe T` / `*unsafe mutable T`. A parser that still accepts `*T` is
// implementing a language the rest of the toolchain does not have.

type Box[T Any](value T);

let main() Int = {
    let b = Box[Int](1);
    let r *Box[Int] = b;
    return 0;
};
