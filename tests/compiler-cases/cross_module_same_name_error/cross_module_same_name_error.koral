// EXPECT-ERROR: Type mismatch

// Same-named generic types from different modules are NOT interchangeable:
// mod_a's Box[Int] must not satisfy mod_b's Box[Int].

using std { .. };
using cross_module_same_name_error::mod_a { make as make_a };
using cross_module_same_name_error::mod_b { tag as tag_b };

let main() Int = {
    println(tag_b(make_a(1)));
    return 0;
};
