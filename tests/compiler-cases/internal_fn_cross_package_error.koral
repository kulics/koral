// EXPECT-ERROR: Undefined variable: hash_seed

// Cross-PACKAGE access to a module-internal symbol: `hash_seed` is `internal`
// to std's root module (the default access), invisible to user code even
// though std's root is otherwise nameable without imports. Invisible is
// undeclared (§3.3) -- no leak through the bare-name index.

let main(): Int = {
    let x = hash_seed();
    let _ = x;
    return 0;
};
