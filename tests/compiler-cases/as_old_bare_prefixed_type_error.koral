// EXPECT-ERROR: Type 'Int' cannot be used as an expression: types have no value
// A bare prefixed type is no longer special syntax: `*Int` reads as the
// dereference operator applied to the type name `Int`, and a type has no
// value to dereference.

let main() Int = {
    let x = 7;
    let p = *Int;
    return 0;
};
