using std { .. };

// Same name as mod_a's Box, different shape and behaviour.
public type Box[T Any](public value T, public extra Int);

public trait Shape {
    name(self) String;
};

public type Square(side Int);

given Square as Shape {
    name(self) String = "b-square";
};

public let make(v Int) Box[Int] = Box(v, 0);
public let tag(b Box[Int]) String = "b";
public let shape() Shape = Square(1);
public let shape_name(s Shape) String = s.name();
