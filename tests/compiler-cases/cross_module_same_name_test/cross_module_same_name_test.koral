// EXPECT: a
// EXPECT: b
// EXPECT: a-circle
// EXPECT: b-square

// Import aliases bind each module's own declaration: same-named generics,
// traits and functions stay distinct and dispatch to the right module.

using std { .. };
using cross_module_same_name_test::mod_a {
    make as make_a, tag as tag_a, shape as shape_a, shape_name as shape_name_a,
};
using cross_module_same_name_test::mod_b {
    make as make_b, tag as tag_b, shape as shape_b, shape_name as shape_name_b,
};

let main() Int = {
    println(tag_a(make_a(1)));
    println(tag_b(make_b(2)));
    println(shape_name_a(shape_a()));
    println(shape_name_b(shape_b()));
    return 0;
};
