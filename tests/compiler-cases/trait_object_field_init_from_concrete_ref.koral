// EXPECT: 12

trait CounterOps {
    peek(*self) Int
}

type Counter(value Int)

given Counter as CounterOps {

    public peek(*self) Int = self.value
}

type Holder(item * CounterOps)

let main() Int = {
    let strong *mutable Counter = box(Counter(12))
    let readonly * Counter = strong
    let holder = Holder(readonly)
    println(holder.item.peek().to_string())
    return 0
}