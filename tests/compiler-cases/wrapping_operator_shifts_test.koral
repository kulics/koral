// EXPECT: PASS
// Wrapping shifts match the plain counterpart's semantics: arithmetic right
// shift on the signed widths, logical on the unsigned. Bits shifted out of
// the width are discarded.

let main() Int = {
    // Signed right shift fills with the sign bit.
    let neg8 WrappingInt8 = -8;
    if not ((neg8 >> 1) == -4) then {
        eprintln("FAIL: WrappingInt8(-8) >> 1 != -4");
        return 1;
    };

    // Unsigned right shift fills with zeros.
    let u8 WrappingUInt8 = 248;
    if not ((u8 >> 1) == 124) then {
        eprintln("FAIL: WrappingUInt8(248) >> 1 != 124");
        return 1;
    };

    // Left shift.
    let one WrappingUInt8 = 1;
    if not ((one << 3) == 8) then {
        eprintln("FAIL: WrappingUInt8(1) << 3 != 8");
        return 1;
    };

    // Bits shifted out of the width are discarded.
    let top WrappingUInt8 = 192;
    if not ((top << 1) == 128) then {
        eprintln("FAIL: WrappingUInt8(192) << 1 != 128");
        return 1;
    };

    // The 64-bit width behaves the same.
    let big WrappingUInt64 = 1;
    if not ((big << 62) == WrappingUInt64(4611686018427387904)) then {
        eprintln("FAIL: WrappingUInt64(1) << 62 != 2^62");
        return 1;
    };

    println("PASS");
    return 0;
};
