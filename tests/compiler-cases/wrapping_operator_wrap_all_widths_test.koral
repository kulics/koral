// EXPECT: PASS
// Wrapping arithmetic wraps modulo 2^N at EVERY width, not just the ones the
// surface tests happen to sample: each type's MAX + 1 lands on its MIN.

let main(): Int = {
    let max8: WrappingUInt8 = 255;
    if not ((max8 + 1) == 0) then {
        eprintln("FAIL: WrappingUInt8 MAX + 1 != 0");
        return 1;
    };
    let max16: WrappingUInt16 = 65535;
    if not ((max16 + 1) == 0) then {
        eprintln("FAIL: WrappingUInt16 MAX + 1 != 0");
        return 1;
    };
    let max32: WrappingUInt32 = 4294967295;
    if not ((max32 + 1) == 0) then {
        eprintln("FAIL: WrappingUInt32 MAX + 1 != 0");
        return 1;
    };
    let max64: WrappingUInt64 = 18446744073709551615;
    if not ((max64 + 1) == 0) then {
        eprintln("FAIL: WrappingUInt64 MAX + 1 != 0");
        return 1;
    };
    let maxu: WrappingUInt = 18446744073709551615;
    if not ((maxu + 1) == 0) then {
        eprintln("FAIL: WrappingUInt MAX + 1 != 0");
        return 1;
    };

    let maxi8: WrappingInt8 = 127;
    if not ((maxi8 + 1) == -128) then {
        eprintln("FAIL: WrappingInt8 MAX + 1 != MIN");
        return 1;
    };
    let maxi16: WrappingInt16 = 32767;
    if not ((maxi16 + 1) == -32768) then {
        eprintln("FAIL: WrappingInt16 MAX + 1 != MIN");
        return 1;
    };
    let maxi32: WrappingInt32 = 2147483647;
    if not ((maxi32 + 1) == -2147483648) then {
        eprintln("FAIL: WrappingInt32 MAX + 1 != MIN");
        return 1;
    };
    let maxi64: WrappingInt64 = 9223372036854775807;
    if not ((maxi64 + 1) == WrappingInt64(Int64.min_value())) then {
        eprintln("FAIL: WrappingInt64 MAX + 1 != MIN");
        return 1;
    };
    let maxi: WrappingInt = 9223372036854775807;
    if not ((maxi + 1) == WrappingInt(Int.min_value())) then {
        eprintln("FAIL: WrappingInt MAX + 1 != MIN");
        return 1;
    };

    println("PASS");
    return 0;
};
