// EXPECT: PASS
// The Wrapping family's arithmetic surface wraps modulo 2^N with no panic:
// `+ - * / %` and unary `-`. Integer literals join the other operand's type in
// both positions, and compound assignment uses the same surface.

let main() Int = {
    // WrappingUInt8(255) + 1 wraps to 0.
    let a WrappingUInt8 = 255;
    if not ((a + 1) == 0) then {
        eprintln("FAIL: WrappingUInt8(255) + 1 != 0");
        return 1;
    };
    if not ((1 + a) == 0) then {
        eprintln("FAIL: 1 + WrappingUInt8(255) != 0");
        return 1;
    };

    // WrappingInt.MIN - 1 wraps to MAX.
    let min_i = WrappingInt(Int.min_value());
    let max_i = WrappingInt(Int.max_value());
    if not ((min_i - 1) == max_i) then {
        eprintln("FAIL: WrappingInt.MIN - 1 != WrappingInt.MAX");
        return 1;
    };

    // WrappingUInt(0) - 1 wraps to the width's max.
    let zero_u WrappingUInt = 0;
    if not ((zero_u - 1) == WrappingUInt(UInt.max_value())) then {
        eprintln("FAIL: WrappingUInt(0) - 1 != WrappingUInt.MAX");
        return 1;
    };

    // Multiplication wraps: 127 * 2 == -2 on the 8-bit signed width.
    let big8 WrappingInt8 = 127;
    if not ((big8 * 2) == -2) then {
        eprintln("FAIL: WrappingInt8(127) * 2 != -2");
        return 1;
    };

    // Unary minus wraps: -MIN == MIN.
    if not ((-min_i) == min_i) then {
        eprintln("FAIL: -WrappingInt.MIN != WrappingInt.MIN");
        return 1;
    };

    // Division and remainder of ordinary values match plain arithmetic.
    let seven WrappingInt8 = 7;
    if not ((seven / 2) == 3) then {
        eprintln("FAIL: WrappingInt8(7) / 2 != 3");
        return 1;
    };
    if not ((seven % 2) == 1) then {
        eprintln("FAIL: WrappingInt8(7) % 2 != 1");
        return 1;
    };

    // Compound assignment wraps the same way.
    let mutable acc WrappingUInt8 = 255;
    acc += 1;
    if not (acc == 0) then {
        eprintln("FAIL: WrappingUInt8(255) += 1 != 0");
        return 1;
    };
    acc = 3;
    acc *= 9;
    if not (acc == 27) then {
        eprintln("FAIL: WrappingUInt8(3) *= 9 != 27");
        return 1;
    };
    acc <<= 2;
    if not (acc == 108) then {
        eprintln("FAIL: WrappingUInt8(27) <<= 2 != 108");
        return 1;
    };

    println("PASS");
    return 0;
};
