// EXPECT: borrow unique: false
// EXPECT: boxed unique: true
// EXPECT: shared unique: false

let main() Int = {
    let mutable local = 1
    let borrow * Int = &local
    print("borrow unique: ")
    println(is_unique_mutable(unsafe & borrow))

    let strong *mutable Int = box(2)
    print("boxed unique: ")
    println(is_unique_mutable(unsafe & strong))

    let alias * Int = strong
    print("shared unique: ")
    println(is_unique_mutable(unsafe & strong))

    return 0
}
