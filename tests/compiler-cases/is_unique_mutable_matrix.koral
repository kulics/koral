// EXPECT: borrow unique: false
// EXPECT: boxed unique: true
// EXPECT: shared unique: false

let main() Int = {
    let mut local = 1
    let borrow * Int = &local
    print("borrow unique: ")
    println(is_unique_mutable(&! borrow))

    let strong *mut Int = box(2)
    print("boxed unique: ")
    println(is_unique_mutable(&! strong))

    let alias * Int = strong
    print("shared unique: ")
    println(is_unique_mutable(&! strong))

    return 0
}
