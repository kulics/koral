// EXPECT-ERROR: Panic: borrow_slice: slice escaped its borrow
// 逃逸检查（slice-design §借出）：派生子窗 `s[a..<b]` 折叠持根块——存出去
// 同样被抓（打在块上，拷贝/派生/存容器/闭包捕获都 retain 块）。
let main(): Void = {
    let xs = List[UInt8].new();
    xs.push(1);
    xs.push(2);
    let holder = List[[]mutable UInt8].new();
    xs.borrow_slice((s) => {
        holder.push(s[0..<1]);
    });
};
