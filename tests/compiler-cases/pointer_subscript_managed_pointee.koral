// EXPECT: hello
// EXPECT: hello
// EXPECT: pointer subscript managed pointee tests passed
// A raw pointer subscript works for managed pointees too: `e[0]` on
// `*mutable String` reads the handle in the slot like any place read --
// the pointee being a std collection's type must not reroute the
// subscript into the collection helper path.

let main(): Int = {
    let e = alloc_memory[String](1);
    init_memory(e, "hello");
    println(e[0]);
    println(e[0]);
    deinit_memory(e);
    dealloc_memory(e);
    println("pointer subscript managed pointee tests passed");
    return 0;
};
