// EXPECT: receiver field: start-updated

public type Holder(mutable text String)

given Holder {
    public new(text String) Holder = Holder(text)

    public preserve(*mutable self) Void = {
        let saved = self.text
        self.text = "temporary"
        self.text = saved
    }

    public append_suffix(*mutable self, suffix String) Void = {
        self.text = self.text + suffix
    }
}

let main() Void = {
    let mutable holder = Holder.new("start")
    holder.preserve()
    holder.append_suffix("-updated")
    println("receiver field: " + holder.text)
}