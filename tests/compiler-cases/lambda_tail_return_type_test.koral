// EXPECT: 42
// EXPECT: 43

// A lambda with no return-type annotation infers its return type from the
// body block's tail expression, not Void.

let main() Int = {
    let f = () -> { 42 };
    let g = () -> { return 43; };
    let x Int = f();
    let y Int = g();
    println(x.to_string());
    println(y.to_string());
    return 0;
};
