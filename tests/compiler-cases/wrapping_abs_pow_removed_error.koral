// The `wrapping_*` method family is gone. The method name must not carry the
// overflow policy -- the receiver's type family does. `wrapping_abs` and
// `wrapping_pow` were the last two spellings of a policy in a name; the
// family model (`WrappingInt.MIN.abs()` wraps, `Int.MIN.abs()` panics)
// replaces both.
// EXPECT-ERROR: Member 'wrapping_abs' not found in type 'Int8'
// EXPECT-ERROR: Member 'wrapping_pow' not found in type 'Int'

using "std/math" { ... };

let main(): Int = {
    let a = Int8.min_value().wrapping_abs();
    let b = 2.wrapping_pow(64);
    println(a.to_string());
    println(b.to_string());
    return 0;
};
