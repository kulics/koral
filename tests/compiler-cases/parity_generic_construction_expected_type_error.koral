// EXPECT-ERROR: Type mismatch: expected G[Int8], got G[Int]
// An implicit generic construction infers its type arguments from the
// arguments alone; the expected type never names them. `G(5)` really is
// `G[Int]` delivered against `G[Int8]`, and the mismatch is the point.

type G[T: Any](x: T);

let main(): Int = {
    let g: G[Int8] = G(5);
    return 0;
};
