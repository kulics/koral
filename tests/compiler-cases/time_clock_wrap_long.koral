// EXPECT: wrap_ok
// add/sub reduce the duration modulo one day before scaling to nanoseconds,
// so a long-but-legal Duration wraps to the same clock time as its day
// remainder instead of overflowing the Int64 nanosecond scale.

using "std/time" { ... };

let main(): Int = {
    let t = ClockTime.new(hour = 23, minute = 0, second = 0).unwrap();
    let big = Duration.new(seconds = Int64.max_value(), nanoseconds = 0).unwrap();
    let daypart = Duration.new(
        seconds = Int64.max_value() % Int64(86_400),
        nanoseconds = 0,
    ).unwrap();
    assert((t + big).equals(t + daypart), "add long == day remainder");
    assert((t - big).equals(t - daypart), "sub long == day remainder");
    let t2 = t + 7200s;
    assert(t2.hour() == 1 and t2.minute() == 0, "23:00 + 2h = 01:00");
    let t3 = ClockTime.new(hour = 0, minute = 30, second = 0).unwrap() - 3600s;
    assert(t3.hour() == 23 and t3.minute() == 30, "00:30 - 1h = 23:30");
    println("wrap_ok");

    return 0;
};
