// EXPECT-ERROR: Panic: numeric conversion overflow at
// A same-width signed -> unsigned conversion is checked, not reinterpreted:
// -5 does not fit UInt and panics instead of silently becoming 2^64-5. The
// wrapped answer belongs to the Wrapping family (`UInt(WrappingUInt(n))`).

let main(): Void = {
    let n = -5;
    let u: UInt = UInt(n);
    println(u);
};
