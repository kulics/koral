// EXPECT-ERROR: Type 'T' does not satisfy the 'mutable' constraint (checking constraint T: mutable). Only types declared with 'type mutable' can be used as weak references.

// A generic parameter gets no free pass on a method's shape bound either: a
// bare `T` forwarded into `get[T mutable]` is rejected unless the forwarding
// parameter is itself declared `T mutable`. Same rule as the free-function
// case in generic_param_mutable_forward_error.

type mutable Counter(mutable value Int, id UInt);
type Holder(data Int);

given Holder {
    public get[T mutable](self, x T) Int = {
        return 1;
    };
};

let forward[T Any](x T) Int = {
    return Holder(1).get(x);
};

let main() Int = {
    return forward(Counter(0, 1));
};
