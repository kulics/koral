// EXPECT-ERROR: Type mismatch: expected *mut CounterOps, got *Counter

trait CounterOps {
    bump(*mut self) Int
}

type Counter(mut value Int)

given Counter as CounterOps {

    public bump(*mut self) Int = {
        self.value += 1
        return self.value
    }
}

let main() Int = {
    let strong *mut Counter = box(Counter(1))
    let readonly * Counter = strong
    let _ *mut CounterOps = readonly
    return 0
}