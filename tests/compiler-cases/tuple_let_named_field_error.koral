// EXPECT-ERROR: Named pattern field 'y' must be matched by label
// `let (a, b) = x` destructures positionally too, so the same rule applies: a
// field declared named cannot be bound without a label.

type Point2(x Int, y: Int);

let main() Int = {
    let p = Point2(1, y: 2);
    let (a, b) = p;
    return a + b;
};
