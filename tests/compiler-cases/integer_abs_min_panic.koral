// `abs` follows the receiver's family for overflow: on a regular type there
// is no wrapping answer to `MIN.abs()`, so it panics. The panic comes from
// the negation's own overflow check -- the method name carries no policy.
// EXPECT-ERROR: Panic: integer overflow in subtraction

using "std/math" { ... };

let main(): Int = {
    println(Int.min_value().abs().to_string());
    return 0;
};
