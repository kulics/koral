// EXPECT: [-]
// EXPECT: [x-]

// Trait method named parameters support declared default values.
// Defaults live on the trait declaration only.

trait Drawable {
    draw(self, color: String, border: String = "-") String;
};

type Circle(radius Int);

given Circle as Drawable {
    draw(self, color: String, border: String) String = "[" + color + border + "]";
};

let main() Int = {
    let c = Circle(10);
    // default fill through the trait method
    println(c.draw(color: ""));
    // explicit override
    println(c.draw(color: "x", border: "-"));
    return 0;
};
