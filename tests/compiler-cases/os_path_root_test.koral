// EXPECT: path_root_match_ok
// EXPECT: path_relative_rules_ok
// EXPECT: path_normalize_drive_ok

// Component matching must keep the absolute/relative distinction (the root is
// part of the component list), relative_to must refuse mixed abs/rel and
// differing roots, and normalize must only treat "X:/" letter forms as roots.
using "std/os" { ... };

let main(): Void = {
    // ========================================================================
    // starts_with / ends_with are root-aware.
    // ========================================================================
    assert(not "a".to_path().starts_with("/".to_path()), "rel starts_with root");
    assert(not "/a/b".to_path().starts_with("a/b".to_path()), "abs starts_with rel");
    assert(not "a/b".to_path().starts_with("/a/b".to_path()), "rel starts_with abs");
    assert("/a/b".to_path().starts_with("/a".to_path()), "abs starts_with abs");
    assert("/a/b".to_path().ends_with("b".to_path()), "ends_with tail component");
    assert(not "a/b".to_path().ends_with("/a/b".to_path()), "rel ends_with abs");
    assert("/".to_path().starts_with("/".to_path()), "root starts_with root");
    println("path_root_match_ok");

    // ========================================================================
    // relative_to: error exactly when one side is absolute or roots differ.
    // ========================================================================
    assert("/a/b".to_path().relative_to("a/b".to_path()).is_error(), "abs over rel");
    assert("a/b".to_path().relative_to("/a/b".to_path()).is_error(), "rel over abs");
    assert("C:/a".to_path().relative_to("D:/a".to_path()).is_error(), "drive mismatch");
    assert("/a/b".to_path().relative_to("/a".to_path()).unwrap().to_string() == "b", "abs same root");
    assert("a/b".to_path().relative_to("a".to_path()).unwrap().to_string() == "b", "rel same root");
    println("path_relative_rules_ok");

    // ========================================================================
    // normalize: only the letter + ':' + '/' form is a drive root.
    // ========================================================================
    assert("a:b/../x".to_path().normalize().to_string() == "x", "non-drive colon pair");
    assert("1:b/../x".to_path().normalize().to_string() == "x", "digit drive rejected");
    assert("C:/a/../x".to_path().normalize().to_string() == "C:/x", "drive root kept");
    assert("/a/b/../c".to_path().normalize().to_string() == "/a/c", "posix normalize");
    println("path_normalize_drive_ok");
};
