// EXPECT: 0
// EXPECT: 255
// EXPECT: 12
// A user type carrying `BitAnd` / `BitOr` / `BitXor` / `BitNot` gets `& | ^ ~`
// the way `Add` gives `+`. The bodies delegate to the built-in operators on
// `UInt8`, so the fast path keeps the checked semantics underneath.

type Mask(bits: UInt8);

given Mask: BitAnd[Mask] {
    public bit_and(self, other: Mask): Mask = Mask(self.bits & other.bits);
};

given Mask: BitOr[Mask] {
    public bit_or(self, other: Mask): Mask = Mask(self.bits | other.bits);
};

given Mask: BitXor[Mask] {
    public bit_xor(self, other: Mask): Mask = Mask(self.bits ^ other.bits);
};

given Mask: BitNot {
    public bit_not(self): Mask = Mask(~self.bits);
};

given Mask {
    public to_string(self): String = self.bits.to_string();
};

let main(): Int = {
    println((Mask(240) & Mask(15)).to_string());
    println((~Mask(0)).to_string());
    println((Mask(8) | Mask(4)).to_string());
    return 0;
};
