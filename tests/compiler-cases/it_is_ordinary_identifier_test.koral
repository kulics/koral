// EXPECT: let it: 5
// EXPECT: for it: 12
// EXPECT: field it: 9
// EXPECT: shadow: 3
//
// `it` is an ordinary identifier. It is not a keyword and nothing binds it
// implicitly: `and then` / `or else` name their payload with `as name in`.

type Box(it Int);

let main() Int = {
    let it = 5;
    print("let it: ");
    println(it);

    let mutable total = 0;
    for it in [1, 2, 3, 6] then {
        total += it;
    };
    print("for it: ");
    println(total);

    let b = Box(9);
    print("field it: ");
    println(b.it);

    // A nested scope may bind `it` again; it shadows the outer one there.
    let shadow = {
        let it = 3;
        it
    };
    print("shadow: ");
    println(shadow);

    return 0;
};
