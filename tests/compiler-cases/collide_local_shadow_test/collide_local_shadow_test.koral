// EXPECT: 5
//
// §3.3 collision matrix, the other "do not report" cell: a function-local
// `let` SHADOWING an imported name is legal -- the import is file-scope and
// the local binding is the inner one. No collision is reported and the local
// value is what the spelling means inside the function.
using "std" { ... };
using "collide_local_shadow_test/mod_a" { make };

let main() Int = {
    let make = 5;
    println(make.to_string());
    return 0;
};
