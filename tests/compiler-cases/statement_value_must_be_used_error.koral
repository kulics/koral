// EXPECT-ERROR: must be used or explicitly discarded
// An expression statement may drop its value silently only when it has none.
// `might_fail(1)` returns a `Result`, and a silently dropped `Result` is a
// lost error: the writer must use the value or discard it on purpose.

let might_fail(n: Int): Result[Int] = {
    if n > 0 then {
        return .Ok(n);
    };
    return .Error("bad");
};

let main(): Int = {
    might_fail(1);
    return 0;
};
