// The bounds panic carries the failing values (2026-11-12 message batch), and
// the message-building runs from a cold helper outside the accessor (2026-11-13
// batch): hot accessors like __index_slot must stay free of the interpolation
// machinery. This pins the message text, values included.
// EXPECT-ERROR: Panic: List index out of bounds: index 5, length 1

let main(): Int = {
    let mutable xs = List[Int].new();
    xs.push(1);
    let x = xs[5];
    return x;
};
