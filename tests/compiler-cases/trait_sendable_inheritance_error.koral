// EXPECT-ERROR: Trait 'Child' extends sendable trait 'Base' and must be declared sendable
// Trait inheritance rule (concurrency-design.md): a child of a
// `trait sendable` declaration must declare `sendable` as well, or the
// always-sendable object family would grow a non-sendable branch. Explicit,
// no inference.

trait sendable Base {
    base(self): Int;
};

trait Child: Base {
    child(self): Int;
};

let main(): Void = {};
