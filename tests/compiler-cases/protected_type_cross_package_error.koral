// EXPECT-ERROR: Undefined type: StdioWriteLock

// The type-namespace spelling of the same wall: `StdioWriteLock` is a
// `protected` type of the std package and must read as undeclared in user
// code, exactly like the value namespace. (An uncalled top-level signature is
// never checked, so the use lives in a checked body.)

using "std" { ... };

let main(): Void = {
    let xs = List[StdioWriteLock].new();
    let _ = xs;
};
