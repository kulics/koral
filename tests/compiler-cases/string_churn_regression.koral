// EXPECT: String churn regression passed

let build_fragment(seed Int) String = {
    let raw_str = "  alpha-beta-gamma-delta-epsilon-zeta  ";
    let trimmed = raw_str.trim_ascii();
    let replaced = trimmed.replace_all("-", with: "_");
    let prefix = replaced.substring(..<5);
    let suffix = replaced.substring(6..);
    let mutable out = StringBuilder.new();
    out.push_string(prefix);
    out.push_byte(':');
    out.push_string(seed.to_string());
    out.push_byte(':');
    out.push_string(suffix);
    return out.to_string();
};

let churn_round(seed Int, steps Int) String = {
    let mutable acc = StringBuilder.new();
    let mutable i = 0;
    while i < steps then {
        let fragment = build_fragment(seed + i);
        acc.push_string(fragment);
        if acc.count() > 512(UInt) then {
            let trimmed = acc.to_string().substring(64..);
            acc = StringBuilder.new();
            acc.push_string(trimmed);
        };
        i += 1;
    };

    let acc_str = acc.to_string();
    return if acc_str.count() > 96(UInt) then {
        acc_str.substring(..<96)
    } else {
        acc_str
    };
};

let main() Int = {
    let mutable carry = "";
    let mutable round = 0;

    while round < 12 then {
        let payload = churn_round(round * 100, 200);
        let mutable tagged = StringBuilder.new();
        tagged.push_string("xy".repeat(4(UInt)));
        tagged.push_byte(':');
        tagged.push_string(payload);
        let tagged_str = tagged.to_string();
        carry = if tagged_str.count() > 48(UInt) then tagged_str.substring(..<48) else tagged_str;
        round += 1;
    };

    assert(carry.contains("alpha"), "carry should preserve payload content");
    assert(carry.starts_with("xyxyxyxy:"), "carry should preserve repeated prefix");
    assert(carry.find(":").is_some(), "carry should contain separator");
    println("String churn regression passed");
    return 0;
};