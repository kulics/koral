// EXPECT: drop
// EXPECT: drop
// EXPECT: drop
// EXPECT: drops=3
//
// A field-less enum case is a stateless value, and codegen may represent every
// construction of one as a shared static immortal box -- EXCEPT when the enum
// type has a user Drop implementation, where each value owes exactly one
// destructor run. This pins the gate: three values (two of the empty case) go
// out of scope here, and the destructor must run three times.

using "std" { ... };

let mutable drop_count = 0;

type Pinned {
    Empty(),
    Node(value: Int),
};

given Pinned: Drop {

    drop(self): Void = {
        println("drop");
        drop_count = drop_count + 1;
    };
};

let main(): Void = {
    {
        let mutable value = Pinned.Empty();
        value = Pinned.Node(1);
        value = Pinned.Empty();
    };
    println("drops=\(drop_count.to_string())");
};
