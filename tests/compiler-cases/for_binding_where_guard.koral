// `for` takes a `where` guard after the iterable, just before `then` -- the
// same slot a `when` arm guard takes before its `then`. A false guard skips the
// element and moves on to the next iteration; it does not end the loop. The
// pattern's bindings are visible in the guard, and `break` / `continue` in the
// body still bind to the loop.
// EXPECT: for_where_filters
// EXPECT: for_where_binding_visible
// EXPECT: for_where_continue
// EXPECT: for_where_break

using "std" { ... };

type Point(x Int, y Int, z Int);

let main() Int = {
    let pts = List[Point].new();
    pts.push(Point(1, 2, 3));
    pts.push(Point(10, 20, 30));
    pts.push(Point(100, 200, 300));

    let mutable sum = 0;
    for p in pts where p.x < 50 then {
        sum += p.x;
    };
    if sum == 11 then {
        println("for_where_filters");
    };

    let mutable ysum = 0;
    for Point(x, y, z) in pts where y > 1 then {
        ysum += y;
    };
    if ysum == 222 then {
        println("for_where_binding_visible");
    };

    let mutable picked = 0;
    for i in 0..<6 where i % 2 == 0 then {
        if i == 2 then {
            continue;
        };
        picked += 1;
    };
    if picked == 2 then {
        println("for_where_continue");
    };

    let mutable seen = 0;
    for i in 0..<10 where i > 100 then {
        seen += 1;
    };
    for i in 0..<10 then {
        seen += 1;
        if seen == 3 then {
            break;
        };
    };
    if seen == 3 then {
        println("for_where_break");
    };

    return 0;
};
