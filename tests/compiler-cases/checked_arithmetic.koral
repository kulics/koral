// Test normal (non-overflowing) checked arithmetic operations
// EXPECT: add_int:
// EXPECT: 300
// EXPECT: sub_int:
// EXPECT: 50
// EXPECT: mul_int:
// EXPECT: 200
// EXPECT: div_int:
// EXPECT: 50
// EXPECT: mod_int:
// EXPECT: 1
// EXPECT: add_i8:
// EXPECT: true
// EXPECT: sub_u8:
// EXPECT: true
// EXPECT: mul_i16:
// EXPECT: true
// EXPECT: div_u32:
// EXPECT: true
// EXPECT: neg_int:
// EXPECT: -42
// EXPECT: wrap_add:
// EXPECT: true
// EXPECT: wrap_sub:
// EXPECT: true
// EXPECT: wrap_mul:
// EXPECT: true
// EXPECT: wrap_div:
// EXPECT: true
// EXPECT: wrap_rem:
// EXPECT: true
// EXPECT: wrap_neg:
// EXPECT: true
// EXPECT: wrap_shl:
// EXPECT: true
// EXPECT: wrap_shr:
// EXPECT: true

let main() Int = {
    // Basic Int arithmetic
    println("add_int:");
    println(100 + 200);
    println("sub_int:");
    println(100 - 50);
    println("mul_int:");
    println(10 * 20);
    println("div_int:");
    println(100 / 2);
    println("mod_int:");
    println(10 % 3);

    // Different integer types
    let a8 Int8 = 5;
    let b8 Int8 = 7;
    println("add_i8:");
    println(a8 + b8 == 12);

    let ua8 UInt8 = 200;
    let ub8 UInt8 = 10;
    println("sub_u8:");
    println(ua8 - ub8 == 190);

    let a16 Int16 = 30;
    let b16 Int16 = 20;
    println("mul_i16:");
    println(a16 * b16 == 600);

    let ua32 UInt32 = 100;
    let ub32 UInt32 = 20;
    println("div_u32:");
    println(ua32 / ub32 == 5);

    // Unary negation (non-overflowing)
    let x = 42;
    println("neg_int:");
    println(-x);

    // Wrapping operators (overflow cases that should NOT panic)
    let max8 WrappingInt8 = 127;
    let one8 WrappingInt8 = 1;
    println("wrap_add:");
    println((max8 + one8) == -128);

    let min8 WrappingInt8 = -128;
    println("wrap_sub:");
    println((min8 - one8) == 127);

    let big8 WrappingInt8 = 127;
    let two8 WrappingInt8 = 2;
    println("wrap_mul:");
    println((big8 * two8) == -2);

    // wrap_div: INT8_MIN / -1 would overflow, wrapping gives INT8_MIN
    let neg1_8 WrappingInt8 = -1;
    println("wrap_div:");
    println((min8 / neg1_8) == -128);

    // wrap_rem: INT8_MIN % -1 would overflow, wrapping gives 0
    println("wrap_rem:");
    println((min8 % neg1_8) == 0);

    // wrap_neg: -INT8_MIN would overflow, wrapping gives INT8_MIN
    println("wrap_neg:");
    println((-min8) == -128);

    // wrap_shl / wrap_shr: in-range shifts behave like the plain family
    let val8 WrappingInt8 = 1;
    println("wrap_shl:");
    println((val8 << 1) == 2);

    let val8b WrappingInt8 = 64;
    println("wrap_shr:");
    println((val8b >> 1) == 32);

    return 0;
};
