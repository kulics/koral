// EXPECT: 1
// EXPECT: 2
// Locality rule 2 for conformance: `given[T Any] *T as LocalTrait` and
// `given[T Any] *mutable T as LocalTrait` are legal in the test module because
// the trait is declared here -- the self type's module OR the trait's module
// may be current. The mutable form re-views `self` as `*T` to read through it.

trait LocalTrait {
    peek(self): Int;
};

given[T: Any] *T: LocalTrait {
    peek(self): Int = 1;
};

given[T: Any] *mutable T: LocalTrait {
    peek(self): Int = {
        let _: *T = self as *T;
        return 2;
    };
};

let main(): Int = {
    let x = 42;
    let p = &x;
    println(p.peek());
    let mutable y = 7;
    let mp = &mutable y;
    println(mp.peek());
    return 0;
};
