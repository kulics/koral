// EXPECT-ERROR: 'and' cannot be mixed with the flow operators 'and then' / 'or else' / 'or return' without parentheses
// The flow layer and the logical layer do not mix implicitly. This would read
// as `(opt and then as v in v == 1) and false`, and is refused rather than
// grouped -- parenthesize one side to say which grouping is meant.

let main(): Int = {
    let opt = Option[Int].Some(1);
    let value = opt and then as v in v == 1 and false;
    let _ = value;
    return 0;
};
