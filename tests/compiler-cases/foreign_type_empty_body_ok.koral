// EXPECT: empty struct ok
// A zero-field foreign struct (`type foreign X();`) is a struct, not an
// opaque: it constructs, copies and drops like any foreign value, and both
// compilers emit its C shape the same way (the struct form only).

type foreign ZedQ();

let main(): Void = {
    let a = ZedQ();
    let mutable b = a;
    b = ZedQ();
    println("empty struct ok");
};
