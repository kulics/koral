// EXPECT: w=2 math=3 n=2 nm=3
// `BinaryInteger` is a refinement of `Integer`: a fixed-width binary integer IS
// a mathematical integer, so one generic bound covers both toolboxes. Haskell
// keeps `Bits`/`FiniteBits` apart from `Integral` only because its `Bits` also
// covers the unbounded `Integer`; ours is fixed-width by definition.

using "std/math" { ... };

// Binary toolbox: reachable because T: BinaryInteger.
let bits[T: BinaryInteger](x: T): UInt = x.count_ones();

// Mathematical toolbox: reachable through the SAME bound -- BinaryInteger: Integer.
let math[T: BinaryInteger](x: T): UInt = T.ilog2(T.gcd(x, x));

public let main(): Int = {
    let w = WrappingInt(12);
    let n: Int = 12;
    println("w=\(bits(w)) math=\(math(w)) n=\(bits(n)) nm=\(math(n))");
    return 0;
};
