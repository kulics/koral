// EXPECT-ERROR: Missing type: global variable declarations must explicitly declare a type
// The unannotated cycle is gone before it can form: without a type annotation
// the declaration itself is rejected (annotated cycles are a different story --
// they are legal declarations caught by the initializer-order machinery at run
// time, see global_let_cycle_panic_test).
using "std" { ... };

let a = b;
let b = a;

let main(): Void = {
    println("should_not_print");
};
