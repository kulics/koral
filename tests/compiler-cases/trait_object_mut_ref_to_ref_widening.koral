// EXPECT: 4
// EXPECT: 4

trait CounterOps {
    peek(*self) Int
    bump(*mutable self) Int
}

type Counter(mutable value Int)

given Counter as CounterOps {

    public peek(*self) Int = self.value

    public bump(*mutable self) Int = {
        self.value += 1
        return self.value
    }
}

let read_counter(counter * CounterOps) Int = counter.peek()

let main() Int = {
    let strong *mutable Counter = box(Counter(4))
    let counter *mutable CounterOps = strong
    let readonly * CounterOps = counter

    println(read_counter(counter).to_string())
    println(readonly.peek().to_string())
    return 0
}