// EXPECT: 4
// EXPECT: 4

trait CounterOps {
    peek(*self) Int
    bump(*mut self) Int
}

type Counter(mut value Int)

given Counter as CounterOps {

    public peek(*self) Int = self.value

    public bump(*mut self) Int = {
        self.value += 1
        return self.value
    }
}

let read_counter(counter * CounterOps) Int = counter.peek()

let main() Int = {
    let strong *mut Counter = box(Counter(4))
    let counter *mut CounterOps = strong
    let readonly * CounterOps = counter

    println(read_counter(counter).to_string())
    println(readonly.peek().to_string())
    return 0
}