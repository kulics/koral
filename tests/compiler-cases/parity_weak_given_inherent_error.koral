// EXPECT-ERROR: '?T' requires a 'type mutable' referent, but 'T' is not declared as 'type mutable'
// The inherent shape hits the same gate as the conformance form: a weak given
// self `given[T Any] ?T { ... }` over a parameter that is not 'type mutable' is
// the referent objection, before any other rule weighs in.

given[T: Any] ?T {
    peek(self): Int = 1;
};

let main(): Int = {
    return 0;
};
