// EXPECT: 42
// EXPECT: hello
// EXPECT: true
// EXPECT: false
// EXPECT: A
// EXPECT: 3.140000
// EXPECT: 0
// EXPECT: 0

type Config(
    count: Int = 42,
    name: String = "hello",
    enabled: Bool = true,
    disabled: Bool = false,
    ch: Rune = 'A',
    ratio: Float64 = 3.14,
    items: List[Int] = [],
    flags: Dict[String, Int] = [],
);

let main() Int = {
    let c = Config();
    println(c.count);
    println(c.name);
    println(c.enabled);
    println(c.disabled);
    println(c.ch);
    println(c.ratio);
    println(c.items.count());
    println(c.flags.count());
    return 0;
};
