// EXPECT: decode_hex: odd-length input
// EXPECT: decode_hex: invalid hex digit at offset 0
// EXPECT: decode_hex: invalid hex digit at offset 2
// EXPECT: hex errors ok
// std.hex decode failures name the problem and where it is.

using "std/hex";

let show(label String, s String) Void = {
    when decode_hex(s) in {
        .Ok(_) then {
            println("\(label): unexpectedly decoded");
        },
        .Error(e) then {
            println(e.message());
        },
    };
};

let main() Int = {
    show("odd", "abc");
    show("bad-first", "zz");
    show("bad-second", "00g0");
    println("hex errors ok");
    return 0;
};
