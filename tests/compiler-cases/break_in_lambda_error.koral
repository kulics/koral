// EXPECT-ERROR: Invalid operation break outside of while
// A lambda is a function boundary: the loop outside it is not visible to `break`.
// (Both compilers used to let this through, and Swift silently emitted a no-op.)
let call(f Func() Void) Void = f();

let main() Int = {
    for i in 0..3 then {
        call(() -> { break; });
    };
    return 0;
};
