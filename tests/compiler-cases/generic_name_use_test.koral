// EXPECT: generic_names_ok
// 正例：表达式位的构造调用可以用裸名（`Box(1)`），带实参的类型注解、
// 跨声明前引（签名先于模板声明）都成立。

let f(b: Box[Int]): Int = b.v;

type Box[T: Any](v: T);

type Duo(l: Int, r: Int);

let make(): Box[Int] = Box(1);

let main(): Int = {
    let x = Box(1);
    assert(f(x) == 1, "bare constructor name");
    let y: Box[Int] = x;
    assert(f(y) == 1, "annotated applied name");
    let z = make();
    assert(f(z) == 1, "forward-declared generic in signature");
    let d: Duo = Duo(1, 2);
    assert(d.l == 1, "non-generic name");
    println("generic_names_ok");
    return 0;
};
