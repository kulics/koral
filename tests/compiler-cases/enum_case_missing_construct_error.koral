// EXPECT-ERROR: Enum case 'Bogus' not found in type 'Shape'
// EXPECT-ERROR: Enum case 'Bogus' not found in type 'Res'
// EXPECT-ERROR: Enum case 'Bogus' not found in type 'Res[Int]'
// A construction naming no case is one complaint naming the case, in every
// spelling: non-generic, bare generic template, and explicit type arguments.
// The `Type '...' cannot be used as an expression` pair that used to trail
// the bare forms is a cascade of the same single mistake. One mistake per
// declaration, as always: a throw point ends its declaration.

type Shape {
    Circle(r: Float64),
    Rectangle(w: Float64, h: Float64),
};
type Res[T: Any] {
    Ok(value: T),
    Error(message: String),
};

let a(): Void = {
    let x = Shape.Bogus(1.0);
};
let b(): Void = {
    let x = Res.Bogus(1);
};
let c(): Void = {
    let x = Res[Int].Bogus(1);
};
