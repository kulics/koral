// EXPECT: PASS
// Design guard: a trait-object exact-type pattern binding must return the
// CONCRETE value of the matched type, not the erased handle.
//
// A managed nominal is stored in the trait object's payload as its C value --
// the thin handle -- so the payload address is NOT the handle. Aliasing the two
// reads the handle's own bytes as if they were the object's fields: the binding
// then sees a pointer instead of the field. Both binding spellings are pinned
// here, on a managed type and on a value type, through the `when` form.

trait Shape {
    area(self) Int;
};

type mutable Box(w Int, h Int);
type Plain(w Int, h Int);

given Box as Shape {
    area(self) Int = self.w * self.h;
};

given Box {
    width(self) Int = self.w;
};

given Plain as Shape {
    area(self) Int = self.w * self.h;
};

given Plain {
    width(self) Int = self.w;
};

let describe(s Shape) Int = when s in {
    b Box then b.width() * 100 + b.area(),
    p Plain then p.width() * 100 + p.area(),
    _ then 0,
};

let check(label String, got Int, want Int) Bool = {
    if got != want then {
        eprintln("FAIL: \(label): got \(got) want \(want)");
        return false;
    };
    return true;
};

let main() Int = {
    let mutable passed Bool = true;

    // Managed type through `when` exact-type binding.
    let s1 Shape = Box(3, 4);
    passed = check("when-managed", describe(s1), 312) and passed;

    // Value type through `when` exact-type binding.
    let s2 Shape = Plain(5, 6);
    passed = check("when-value", describe(s2), 530) and passed;

    // `is` form on managed type.
    let s3 Shape = Box(7, 8);
    if s3 is b Box then {
        passed = check("is-managed", b.width() * 100 + b.area(), 756) and passed;
    } else {
        eprintln("FAIL: is-managed: pattern did not match");
        passed = false;
    };

    // `is` form on value type.
    let s4 Shape = Plain(2, 9);
    if s4 is p Plain then {
        passed = check("is-value", p.width() * 100 + p.area(), 218) and passed;
    } else {
        eprintln("FAIL: is-value: pattern did not match");
        passed = false;
    };

    if passed then {
        println("PASS");
        return 0;
    };
    return 1;
};
