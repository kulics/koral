// EXPECT-ERROR: Invalid operation plus between types T and T

trait MyBadNumeric Add[Int] {};

type Num(value Int);

given Num as Add[Int] {

    add(self, other Int) Self = Num(self.value + other);
};

given Num as MyBadNumeric {};

let bad_sum[T MyBadNumeric](a T, b T) T = a + b;

let main() Int = 0;