// `or else` binds tighter than logical `and`.
// EXPECT: and over or_else: 1

let main() Int = {
    let ready Bool = true;
    let flag_opt = Option[Bool].Some(true);
    // This parses as
    //   ready and (flag_opt or else false)
    // Under the previous precedence it would have parsed as
    //   (ready and flag_opt) or else false
    // which is ill-typed: `and` needs Bool on both sides.
    let ok = ready and flag_opt or else false;
    println("and over or_else: " + (if ok then 1 else 0).to_string());
    return 0;
};
