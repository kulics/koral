// EXPECT-ERROR: Member 'get' not found in type '?Box'
// Same rule for methods: a `?T` has no members of the referent.

type mutable Box(mutable value Int);

given Box {
    public get(self) Int = self.value;
};

let main() Int = {
    let b = Box(42);
    let w = ?Box(b);
    println("\(w.get())");
    return 0;
};
