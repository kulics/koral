// EXPECT-ERROR: Variable bindings in 'is' expression are not allowed in 'or' branches
// Design guard: a `where` guard follows the if/while rule exactly: `is`
// bindings live on the and-spine only. Under expression `or` the two branches
// cannot agree on which names exist, so the same rejection fires here too.

type MyOption {
    None(),
    Some(value: Int),
};

let pick(o: MyOption, other: MyOption): Int = when o in {
    .Some(v) where o is .Some(w) or other is .Some(x) then v,
    _ then 0,
};

let main(): Int = {
    return pick(MyOption.Some(1), MyOption.None());
};
