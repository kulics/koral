// EXPECT: comparison_chain_basic_ok

let mutable middle_calls = 0
let mutable last_calls = 0

let mark_middle(value Int) Int = {
    middle_calls = middle_calls + 1
    return value
}

let mark_last(value Int) Int = {
    last_calls = last_calls + 1
    return value
}

let main() Void = {
    assert(1 < 2 < 3, "ascending strict chain")
    assert(1 < 2 <= 2, "ascending mixed chain")
    assert(9 >= 9 > 3, "descending mixed chain")

    assert(0 < mark_middle(1) < 2, "middle operand evaluated once")
    assert(middle_calls == 1, "middle operand called once")

    let pass = 10 < mark_middle(1) < mark_last(20)
    assert(not pass, "first comparison should fail")
    assert(middle_calls == 2, "middle operand called once per chain")
    assert(last_calls == 0, "last operand short-circuited")

    println("comparison_chain_basic_ok")
}