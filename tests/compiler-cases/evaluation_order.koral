// Evaluation order is strictly left-to-right everywhere operands are sequenced:
// call arguments, binary operands, collection/dict literal elements (entries in
// source order, key before value), and constructor fields. `and` / `or` /
// `and then` / `or else` evaluate their left operand first and short-circuit
// without touching the right when the left decides the result.
// EXPECT: binop: [1][2]
// EXPECT: args: [3][4][5]
// EXPECT: list: [6][7][8]
// EXPECT: dict: [9][10][11][12]
// EXPECT: ctor: [13][14]
// EXPECT: mul_chain: [24][25][26]
// EXPECT: cmp: [27][28]
// EXPECT: recv: [29][30]
// EXPECT: and_sc: [31]
// EXPECT: or_sc: [33]
// EXPECT: and_then_sc: [35]
// EXPECT: and_then_run: [36][37]
// EXPECT: or_else_sc: [38]
// EXPECT: or_else_run: [40][99]

let trace(x Int) Int = {
    print("[" + x.to_string() + "]");
    return x;
};

let traceb(x Bool, tag Int) Bool = {
    print("[" + tag.to_string() + "]");
    return x;
};

let trace_opt(x Int) Option[Int] = {
    print("[" + x.to_string() + "]");
    return Option[Int].Some(x);
};

let trace_none(tag Int) Option[Int] = {
    print("[" + tag.to_string() + "]");
    return Option[Int].None();
};

let sum3(a Int, b Int, c Int) Int = a + b + c;

type Point(x Int, y Int);

let main() Int = {
    print("binop: ");
    let a = trace(1) + trace(2);
    println("");

    print("args: ");
    let b = sum3(trace(3), trace(4), trace(5));
    println("");

    print("list: ");
    let l = [trace(6), trace(7), trace(8)];
    println("");

    print("dict: ");
    let d = [trace(9): trace(10), trace(11): trace(12)];
    println("");

    print("ctor: ");
    let p = Point(trace(13), trace(14));
    println("");

    print("mul_chain: ");
    let m = trace(24) * trace(25) + trace(26);
    println("");

    print("cmp: ");
    let c = trace(27) < trace(28);
    println("");

    print("recv: ");
    let s = trace(29).to_string() + trace(30).to_string();
    println("");

    print("and_sc: ");
    let s1 = traceb(false, 31) and traceb(true, 32);
    println("");

    print("or_sc: ");
    let s2 = traceb(true, 33) or traceb(false, 34);
    println("");

    print("and_then_sc: ");
    let s3 = trace_none(35) and then as v in trace(99);
    println("");

    print("and_then_run: ");
    let s4 = trace_opt(36) and then as v in trace(37);
    println("");

    print("or_else_sc: ");
    let s5 = trace_opt(38) or else trace(99);
    println("");

    print("or_else_run: ");
    let s6 = trace_none(40) or else trace(99);
    println("");

    return 0;
};
