// EXPECT: 0
// `{ }` is the inert placeholder (§3.3): a dependency edge and nothing more.
// It binds no name and brings no method surface -- it exists so a `using` line
// can stay put while code is being edited.

using "std/os" { };

public let main() Int = {
    if is_inert_placeholder() then {
        println("0");
    };
    return 0;
};

module_private let is_inert_placeholder() Bool = {
    // Nothing from `std/os` is nameable here. `Path` is a type the module
    // exports; naming it would prove the import leaked.
    return true;
};
