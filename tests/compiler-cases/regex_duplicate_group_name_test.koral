// EXPECT: dup_group_ok
// 命名捕获组重名按正则编译错误收口（否则 group_by_name 拿到哪个是悬案）；
// 不同名照常，匿名组不受影响。

using "std/text" { Regex };

let main(): Int = {
    when Regex.compile("(?P<a>x)(?P<a>y)") in {
        .Ok(_) then assert(false, "duplicate name must fail"),
        .Error(e) then assert(e.message() == "Duplicate capture group name", "dup message"),
    };
    when Regex.compile("(?<a>x)(?<a>y)") in {
        .Ok(_) then assert(false, "duplicate name must fail (angle form)"),
        .Error(e) then assert(e.message() == "Duplicate capture group name", "dup message 2"),
    };
    // 命名组与匿名组、不同名之间互不干扰。
    let ok = Regex.compile("(?P<a>x)(?P<b>y)(z)").expect("distinct names");
    assert(ok.group_count() == 3, "distinct names compile");
    let anon = Regex.compile("(x)(x)").expect("anonymous repeats");
    assert(anon.group_count() == 2, "anonymous groups may repeat");

    println("dup_group_ok");
    return 0;
};
