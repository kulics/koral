// EXPECT-ERROR: Unreachable pattern '_': already covered by previous patterns
// Design guard: a defensive `_` after patterns that already cover every value
// is dead code, and saying so is an error on BOTH compilers -- the fallback
// cannot rescue anything the earlier arms did not already match. This pins
// the single-case enum shape specifically: `.Only(v)` claims the whole space,
// so the `_` below matches nothing.

type Box1 {
    Only(v: Int),
};

let f(e: Box1): Int = when e in {
    .Only(v) then v,
    _ then 0,
};

let main(): Int = {
    return f(Box1.Only(1));
};
