// EXPECT-ERROR: Type mismatch: expected Int, got *mutable Int

trait TmpReader {
    read(*self, x Int) Int;
};

type TmpBoxed();

given TmpBoxed as TmpReader {

    public read(*self, x Int) Int = x;
};

let main() Int = {
    let b = box(TmpBoxed());
    let r * TmpReader = b;
    let x = box(42);
    let _ = r.read(x);
    return 0;
};