// EXPECT: (1, 2)
// EXPECT: (3, 4)
// The trait is imported under an ALIAS (`Show as Display`) and never spelled
// `Show` in this module. Both uses must work: calling the library's `render`
// directly, and forwarding through this module's own bounded `wrap`, whose
// bound names the alias. Satisfaction is decided by the bound's DECLARATION
// identity on both sides, so neither use needs the original spelling.

using "trait_bound_call_without_import_alias_test/lib" { render, Point, Show as Display };

let wrap[T: Display](x: T): String = render(x);

public let main(): Int = {
    println(render(Point.new(1, 2)));
    println(wrap(Point.new(3, 4)));
    return 0;
};
