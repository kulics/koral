// The same library shape as trait_bound_call_without_import_test: the trait
// `Show` is declared here and only its conformance and the bounded generic
// function leave this module.

public trait Show {
    show(self): String;
};

public type Point(x: Int, y: Int);

given Point {
    public new(x: Int, y: Int): Point = Point(x, y);
};

given Point: Show {
    show(self): String = "(" + self.x.to_string() + ", " + self.y.to_string() + ")";
};

public let render[T: Show](x: T): String = x.show();
