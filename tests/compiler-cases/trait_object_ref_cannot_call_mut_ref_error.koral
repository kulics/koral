// EXPECT-ERROR: expected *mut CounterOps, got *CounterOps

trait CounterOps {
    bump(*mut self) Int
}

type Counter(mut value Int)

given Counter as CounterOps {

    public bump(*mut self) Int = {
        self.value += 1
        return self.value
    }
}

let main() Int = {
    let strong *mut Counter = box(Counter(1))
    let obj * CounterOps = strong
    let _ = obj.bump()
    return 0
}
