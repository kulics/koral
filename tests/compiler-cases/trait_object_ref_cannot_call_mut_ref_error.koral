// EXPECT-ERROR: expected *mutable CounterOps, got *CounterOps

trait CounterOps {
    bump(*mutable self) Int
}

type Counter(mutable value Int)

given Counter as CounterOps {

    public bump(*mutable self) Int = {
        self.value += 1
        return self.value
    }
}

let main() Int = {
    let strong *mutable Counter = box(Counter(1))
    let obj * CounterOps = strong
    let _ = obj.bump()
    return 0
}
