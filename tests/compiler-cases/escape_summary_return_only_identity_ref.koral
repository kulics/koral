// EXPECT: identity7
// EXPECT: stored7
// EXPECT: return-vs-store ok

public type IntBox(value * Int)

let identity_ref(r * Int) * Int = {
    return r
}

let store_ref(r * Int) IntBox = {
    return IntBox(r)
}

public let main() Void = {
    let mutable a = 7
    let r = identity_ref(&a)
    println("identity" + (*r).to_string())

    let mutable b = 7
    let box = store_ref(&b)
    println("stored" + (*box.value).to_string())

    assert(*r == 7, "return-only identity preserves value")
    assert(*box.value == 7, "stored ref preserves value")
    println("return-vs-store ok")
}

