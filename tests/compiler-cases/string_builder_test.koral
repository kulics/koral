// EXPECT: string_builder_ok

let main() Void = {
    let mutable b = StringBuilder.with_capacity(16);
    assert(b.is_empty(), "new builder empty");

    b.push_string("hel");
    b.push_byte('l');
    b.push_byte('o');
    assert(b.count() == 5, "builder count");

    let s1 = b.to_string();
    assert(s1 == "hello", "first snapshot");

    b.push_byte(' ');
    b.push_rune(Rune.from_uint32_unchecked(87(UInt32)));
    b.push_string("orld");
    let s2 = b.to_string();
    assert(s2 == "hello World", "second snapshot");

    // Snapshot must not be affected by future builder mutations.
    b.push_byte('!');
    assert(s1 == "hello", "snapshot stays stable");
    assert(b.to_string() == "hello World!", "latest snapshot");

    b.clear();
    assert(b.is_empty(), "clear resets builder");
    assert(b.to_string() == "", "empty after clear");

    println("string_builder_ok");
};
