// EXPECT: PASS
// `Type.method(args)` puts the receiver in the first explicit argument:
// `Int.wrapping_cast[UInt8](n)` is `n.wrapping_cast[UInt8]()`. The static
// spelling must produce the same unchecked cast and the same value -- the
// low-byte take and the whole behavior table are spelled both ways.

let main() Int = {
    let n Int = 300;
    let v UInt8 = Int.wrapping_cast[UInt8](n);
    if v != 44 then {
        eprintln("FAIL: Int 300 -> UInt8 via static spelling, got \(v)");
        return 1;
    };

    // The inferred form binds T from the expected type, like the instance form.
    let s UInt8 = Int.wrapping_cast(n);
    if s != 44 then {
        eprintln("FAIL: Int 300 -> UInt8 via inferred static spelling, got \(s)");
        return 1;
    };

    // Low-byte take on a UInt32: big-endian byte order, both bytes.
    let w UInt32 = 305419896;
    let low UInt8 = UInt32.wrapping_cast[UInt8](w);
    let high UInt8 = UInt32.wrapping_cast[UInt8](w >> 24);
    if low != 120 then {
        eprintln("FAIL: UInt32 0x12345678 -> UInt8 via static spelling, got \(low)");
        return 1;
    };
    if high != 18 then {
        eprintln("FAIL: UInt32 0x12345678 >> 24 -> UInt8 via static spelling, got \(high)");
        return 1;
    };

    // The instance form agrees value for value.
    let n2 Int = 300;
    if n2.wrapping_cast[UInt8]() != v then {
        eprintln("FAIL: static and instance spellings disagree");
        return 1;
    };

    println("PASS");
    return 0;
};
