// EXPECT: empty_pattern_ok
// 空字符串字面量是合法的 when 模式（与种子一致）：精确匹配空串，其余走默认。

let main(): Int = {
    let s = "";
    let n = when s in {
        "" then 0,
        "x" then 1,
        _ then 2,
    };
    assert(n == 0, "empty literal matches empty");
    let m = when "x" in {
        "" then 0,
        _ then 1,
    };
    assert(m == 1, "empty literal rejects others");

    println("empty_pattern_ok");
    return 0;
};
