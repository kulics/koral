// EXPECT: 7

trait CounterOps {
    peek(self) Int;
};

type Counter(value Int);

given Counter as CounterOps {

    public peek(self) Int = self.value;
};

let choose(flag Bool, left CounterOps, right CounterOps) CounterOps =
    if flag then left else right;

let main() Int = {
    let strong Counter = Counter(7);
    let left CounterOps = strong;
    let right CounterOps = left;
    let chosen = choose(true, left, right);
    println(chosen.peek().to_string());
    return 0;
};