// EXPECT-ERROR: Named pattern field 'y' must be matched by label
// A positional destructuring only reaches a field declared POSITIONAL. A named
// field has to be matched by label -- destructuring follows the call rules.

type Point2(x Int, y: Int);

let main() Int = {
    let p = Point2(1, y: 2);
    let v = when p in {
        (a, b) then a + b,
    };
    return v;
};
