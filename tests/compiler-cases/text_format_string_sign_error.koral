// std.text: an explicitly written sign is invalid for strings and must panic.
// EXPECT-ERROR: sign not allowed for string format

using "std/text" { ... };

let main(): Int = {
    // '-' is the default sign value, so only explicit-sign tracking catches it
    let s = "a".format("-5");
    println("FAIL sign: [" + s + "]");
    return 0;
};
