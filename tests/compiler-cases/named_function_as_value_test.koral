// EXPECT: fnvalue ok
// A named top-level function used as a value must be boxed into a closure.

let double(x: Int): Int = x * 2;

let apply(f: (Int) -> Int, v: Int): Int = f(v);

let main(): Int = {
    let r = apply(double, 21);
    if r == 42 then {
        println("fnvalue ok");
    };
    return 0;
};
