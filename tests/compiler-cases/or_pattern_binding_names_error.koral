// EXPECT-ERROR: Or pattern branches must bind the same variables. Left binds: {a}, Right binds: {b}
// An `or` matches one branch or the other, so both must offer the same names --
// otherwise the body would read a name only one branch ever bound.

type E {
    A(a Int),
    B(b Int),
};

let f(e E) Int = when e in {
    .A(a) or .B(b) then 1,
};

let main() Int = {
    return f(E.A(1));
};
