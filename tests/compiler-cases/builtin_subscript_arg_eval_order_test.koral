// EXPECT: arg_order_ok
// A subscript read that feeds a call argument must load at its own evaluation
// position: a later argument can grow the container and move the buffer the
// element slot points into, and a deferred load would then read through the
// stale slot pointer. Both argument orders pin -- the read-before-grow and
// the grow-before-read.

let grow(l: List[Int]): Int = {
    let mutable i = 0;
    while i < 200 then {
        l.push(0);
        i += 1;
    };
    return 0;
};

let sum2(a: Int, b: Int): Int = {
    return a + b;
};

let main(): Void = {
    let mutable l = List[Int].new();
    l.push(42);
    let r = sum2(l[0], grow(l));
    let mutable d = List[Int].new();
    d.push(7);
    let r2 = sum2(grow(d), d[0]);
    if r == 42 and r2 == 7 then {
        println("arg_order_ok");
    } else {
        println("FAIL arg_order: " + r.to_string() + " " + r2.to_string());
    };
};
