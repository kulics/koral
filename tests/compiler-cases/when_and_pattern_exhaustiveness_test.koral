// EXPECT: and_pattern_exhaustiveness_ok
// Design guard: `and` covers the intersection of its sides, so `.A(x) and y`
// claims only the A case. Reading it as the union would exhaust the enum too
// early and flag the `.B(x)` arm unreachable -- a false "Unreachable pattern"
// this pins out of existence.

type E {
    A(x Int),
    B(x Int),
};

let classify(e E) Int = when e in {
    .A(x) and y then x + 1,
    .B(x) then x + 100,
};

let main() Int = {
    if classify(E.A(1)) != 2 then {
        eprintln("FAIL: A arm");
        return 1;
    };
    if classify(E.B(1)) != 101 then {
        eprintln("FAIL: B arm");
        return 1;
    };
    println("and_pattern_exhaustiveness_ok");
    return 0;
};
