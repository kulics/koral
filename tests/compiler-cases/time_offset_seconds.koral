// EXPECT: name_ok
// EXPECT: format_ok
// EXPECT: roundtrip_ok
// A fixed offset with a seconds component renders ":SS" after the minutes
// (in `name` and in the ISO suffix) so the text cannot silently drop seconds
// and shift the instant.

using "std/time" { ... };

let main(): Int = {
    let tz = TimeZone.from_offset(3661s).unwrap();
    assert(tz.name() == "+01:01:01", "name +1h1m1s");
    let tzn = TimeZone.from_offset(-3661s).unwrap();
    assert(tzn.name() == "-01:01:01", "name -1h1m1s");
    let tzm = TimeZone.from_offset(3600s).unwrap();
    assert(tzm.name() == "+01:00", "whole minute unchanged");
    println("name_ok");

    let dt = DateTime.epoch().in_timezone(tz);
    assert(dt.to_string() == "1970-01-01T01:01:01+01:01:01", "format");
    println("format_ok");

    let rt = DateTime.parse(dt.to_string()).unwrap();
    assert(rt.to_unix_seconds() == dt.to_unix_seconds(), "roundtrip instant");
    assert(rt.to_string() == dt.to_string(), "roundtrip text");
    println("roundtrip_ok");

    return 0;
};
