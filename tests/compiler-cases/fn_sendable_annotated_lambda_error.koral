// EXPECT-ERROR: sendable closure cannot capture non-sendable value 'v'
// The expected type at the annotation drives the capture check: a lambda that
// captures a non-sendable value cannot be typed `sendable () -> Void`
// (concurrency-design.md §派生规则 5).

type mutable Local(mutable n: Int);

let main(): Void = {
    let v = Local(1);
    let f: sendable () -> Void = () => println("captured \(v.n)");
    f();
};
