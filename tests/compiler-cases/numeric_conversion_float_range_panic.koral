// EXPECT-ERROR: Panic: numeric conversion overflow
// The float-to-integer two-step, range half: 1e20 truncates to an integer the
// plain family cannot hold, so the conversion panics. Only the domain half
// (NaN / +-inf) differs in wording of what fails; both panic.

let main() Void = {
    let x Float64 = 1e20;
    let y Int = Int(x);
    println(y);
};
