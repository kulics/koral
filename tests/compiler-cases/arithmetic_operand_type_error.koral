// EXPECT-ERROR: Invalid operation plus between types Int and Float64
// A literal joins the other side's WIDTH, but only within its own kind. There
// is no int<->float promotion: `1 + 1.5` would otherwise resolve by whichever
// side the literal happened to sit on.

public let main() Int = {
    let c = 1 + 1.5;
    return 0;
};
