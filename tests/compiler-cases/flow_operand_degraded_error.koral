// EXPECT-ERROR: Undefined variable: undefined_thing
// EXPECT-ERROR: 'or return' can only be used with Option or Result types, got '?'
// A DEGRADED operand is not an aborted one: an undefined name keeps
// checking, so the flow complaint beside it is the seed's own second line.
// The miss shape in static_method_missing_using_error is the one that stops
// at a single line.

let f(): Option[Int] = {
    let x = undefined_thing or return;
    return Option[Int].Some(x);
};
