// EXPECT: public intrinsic ok

// The other side of the visibility gate: public intrinsics are user API.
// `alloc_memory`/`init_memory`/`dealloc_memory` dispatch for every package.

using "std" { ... };

let main(): Void = {
    let p = alloc_memory[Int](2);
    init_memory(p, 10);
    init_memory(p + 1, 20);
    dealloc_memory(p);
    println("public intrinsic ok");
};
