// Test file_private symbol file isolation
// EXPECT: All file_private isolation tests passed!
// Two files in the same module can have same-named file_private symbols
// They should NOT conflict in generated C code

using "file_a"
using "file_b"

public let main() Void = {
    // Test file_private variables from different files
    let a_val = get_private_var_a()
    let b_val = get_private_var_b()
    
    assert(a_val == 111, "file_a file_private var should be 111")
    assert(b_val == 222, "file_b file_private var should be 222")
    
    // Test file_private functions from different files
    let a_func = call_private_func_a()
    let b_func = call_private_func_b()
    
    assert(a_func == 1000, "file_a file_private func should return 1000")
    assert(b_func == 2000, "file_b file_private func should return 2000")
    
    // Test file_private types from different files (via public wrappers)
    let a_type = create_private_type_a()
    let b_type = create_private_type_b()
    
    assert(a_type.value == 10, "file_a file_private type value should be 10")
    assert(b_type.value == 10, "file_b file_private type value should be 10")
    
    print("All file_private isolation tests passed!")
}
