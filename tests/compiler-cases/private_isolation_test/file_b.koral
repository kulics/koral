// file_b.koral - Second file with file_private symbols
// These file_private symbols have SAME NAMES as file_a's but should be isolated

// Private variable - same name as in file_a
file_private let secret_value Int = 222

// Private function - same name as in file_a
file_private let compute_secret() Int = 2000

// Private type - same name as in file_a
file_private type SecretData(value Int)

// Public wrapper type to expose file_private type's value
public type WrapperB(value Int)

// Public accessors to test the file_private symbols
public let get_private_var_b() Int = secret_value

public let call_private_func_b() Int = compute_secret()

public let create_private_type_b() WrapperB = {
    let secret = SecretData(10)
    return WrapperB(secret.value)
}
