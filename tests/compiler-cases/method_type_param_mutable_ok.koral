// EXPECT: mutable method ok

// The mirror of method_type_param_mutable_error: a `type mutable` argument
// satisfies the method's `T mutable` bound and the call is accepted.

type mutable Counter(mutable value Int, id UInt);
type Holder(data Int);

given Holder {
    public get[T mutable](self, x T) Int = {
        return 1;
    };
};

let main() Int = {
    let e = Holder(1).get(Counter(0, 1));
    println("mutable method ok");
    return e - 1;
};
