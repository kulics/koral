// EXPECT: captured value: 42
// EXPECT: lambda capture escape ok

let make_getter(v Int) Func[Int] = {
    return () -> v
}

let make_pair_getter(a Int, b Int) Func[List[Int]] = {
    return () -> [a, b]
}

public let main() Void = {
    let getter = make_getter(42)
    println("captured value: " + getter().to_string())

    let pair_getter = make_pair_getter(10, 20)
    let pair = pair_getter()
    assert(pair.count() == 2, "pair count")
    assert(pair[0] == 10, "pair first")
    assert(pair[1] == 20, "pair second")

    println("lambda capture escape ok")
}

