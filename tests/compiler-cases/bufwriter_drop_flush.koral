// EXPECT: hello
// EXPECT: bufwriter drop flush tests passed
// A dropped BufWriter flushes: the buffered bytes land in the inner writer
// without an explicit flush -- nothing is silently discarded.

using "std/io" { ... };

type mutable TestWriter(mutable data: StringBuilder);

given TestWriter: Writer {
    public write(self, from: List[UInt8] =, span: Range[UInt] =): Result[UInt] = {
        let mutable n = UInt(0);
        for i in span then {
            self.data.push_byte(from[i]);
            n += 1;
        };
        return Result[UInt].Ok(n);
    };

    public flush(self): Result[Void] = Result[Void].Ok({});
};

let write_without_flush(w: TestWriter): Void = {
    let mutable bw = BufWriter[TestWriter].new(w);
    let bytes = "hello".to_bytes();
    let _ = bw.write(from = bytes, span = 0..<bytes.count());
};

let main(): Int = {
    let w = TestWriter(StringBuilder.new());
    write_without_flush(w);
    println(w.data.to_string());
    println("bufwriter drop flush tests passed");
    return 0;
};
