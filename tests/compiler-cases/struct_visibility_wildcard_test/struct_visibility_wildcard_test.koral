// Test that wildcard on file_private fields is allowed in destructuring
// Using _ for file_private field should work fine
// EXPECT: x_value: 10
// EXPECT: Wildcard on file_private field works!

using "types"

public let main() Int = {
    let p = SecretPoint.new(10, 20)
    // This should succeed: using wildcard for file_private field 'y'
    if p is SecretPoint(x, _) then {
        print("x_value: ")
        println(x)
    }
    println("Wildcard on file_private field works!")
    return 0
}
