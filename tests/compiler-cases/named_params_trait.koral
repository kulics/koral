// EXPECT: red3
// EXPECT: hello0

trait Drawable {
    draw(self, color: String, thickness: Int) String;
};

type Circle(radius Int);

given Circle as Drawable {
    draw(self, color: String, thickness: Int) String = {
        let mutable s = color;
        s.push_string(thickness.to_string());
        return s;
    };
};

let main() Int = {
    let c = Circle(10);
    println(c.draw(color: "red", thickness: 3));
    println(c.draw(color: "hello", thickness: 0));
    return 0;
};
