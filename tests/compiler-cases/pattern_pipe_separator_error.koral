// EXPECT-ERROR: Pattern separator '|' is not supported; use 'or'
// Design guard: `|` is not part of the pattern grammar. A `when` arm spells
// an alternative `or`, and an `is` chain spells it `or is`.

let main() Int = {
    let x = 1;
    let r = when x in {
        0 | 1 then x,
        _ then 0,
    };
    println(r);
    return 0;
};
