// EXPECT-ERROR: Panic: List modified during iteration or borrow: into_slice
// 修改锁：锁着期间 `into_slice` 也是一次修改，入口即 panic。
let main(): Void = {
    let xs = List[UInt8].new();
    xs.push(1);
    xs.borrow_slice((s) => {
        let _ = s.count();
        let other = xs.into_slice();
        let _ = other.count();
    });
};
