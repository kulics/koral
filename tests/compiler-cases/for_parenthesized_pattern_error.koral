// EXPECT-ERROR: A parenthesized pattern groups nothing; `(` starts a tuple pattern with at least two slots. Under 'is', combine tests with 'or is' / 'and is'
// Design guard: a `for` binding is a full match pattern, so `(` opens a tuple
// there too. A single parenthesized pattern groups nothing to group -- the
// same rejection `is (pat)` gets, and koral-syntax refuses it in lockstep.
using "std";

let main() Int = {
    let mutable xs = List[Int].new();
    xs.push(1);
    for (x) in xs then {
        println(x);
    };
    return 0;
};
