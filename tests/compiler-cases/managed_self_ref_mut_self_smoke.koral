// EXPECT: 3

type Counter(mut value Int)

given Counter {
    public bump_and_keep(self ref mut Self) ref mut Self = {
        self.value += 1
        return self
    }
}

let main() Int = {
    let counter ref mut Counter = box(Counter(1))
    let alias ref mut Counter = counter.bump_and_keep()
    alias.value += 1
    println(counter.value.to_string())
    return 0
}