// EXPECT-ERROR: Cannot declare 'given String' in module
// EXPECT-ERROR: Member 'm' not found in type 'String'
// A given that fails its locality rule has no methods: the seed throws from
// the signature pass BEFORE registering anything, so the call site of its
// member says `Member 'm' not found` on top of the locality complaint.

given String {
    m(self): Int = 1;
};

let main(): Int = {
    let s = "hi";
    return s.m();
};
