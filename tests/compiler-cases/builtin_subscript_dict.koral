// EXPECT: builtin subscript dict ok

using std { .. };

type mutable Point(mutable x Int, mutable y Int);

let main() Void = {
    // === Subscript write: update only (insert via insert()) ===
    let mutable d = Dict[Int, Int].new();
    d.insert(1, 10);
    d.insert(2, 20);
    d.insert(3, 30);
    assert(d.count() == 3, "insert count");

    d[2] = 99;
    assert(d.count() == 3, "subscript update count unchanged");
    assert(d.get(2).unwrap() == 99, "subscript update d[2]");

    // === Subscript read ===
    let v1 = d[1];
    assert(v1 == 10, "subscript read d[1]");
    let v2 = d[2];
    assert(v2 == 99, "subscript read d[2]");

    // === String keys ===
    let mutable sd = Dict[String, Int].new();
    sd.insert("hello", 42);
    sd.insert("world", 100);
    assert(sd["hello"] == 42, "string key read hello");
    assert(sd["world"] == 100, "string key read world");
    sd["hello"] = 999;
    assert(sd["hello"] == 999, "string key update hello");

    // === shared aliases: updates are visible through both names ===
    let mutable original = Dict[Int, String].new();
    original.insert(1, "a");
    original.insert(2, "b");

    let mutable copy = original;
    copy.insert(3, "c");
    copy[1] = "A";

    assert(original.count() == 3, "original count reflects shared insert");
    assert(original.get(1).unwrap() == "A", "original[1] reflects shared update");
    assert(original.contains_key(3), "original contains_key 3 after shared insert");
    assert(copy.count() == 3, "copy count after write");
    assert(copy.get(1).unwrap() == "A", "copy[1] modified");
    assert(copy.contains_key(3), "copy contains_key 3");

    // === Compound assignment ===
    let mutable ca = Dict[Int, Int].new();
    ca.insert(1, 10);
    ca[1] += 5;
    assert(ca[1] == 15, "compound add assignment");
    ca[1] -= 3;
    assert(ca[1] == 12, "compound sub assignment");
    ca[1] *= 2;
    assert(ca[1] == 24, "compound mul assignment");

    // === Deep update: mutable-type field via subscript ===
    let mutable points = Dict[Int, Point].new();
    points.insert(1, Point(10, 20));
    points[1].y = 77;
    assert(points[1].x == 10, "deep update keeps x");
    assert(points[1].y == 77, "deep update stores new y");

    // === Subscript method call on mutable-type dict element ===
    let mutable dl = Dict[String, List[Int]].new();
    dl.insert("x", List[Int].new());
    dl["x"].push(42);
    dl["x"].push(99);
    assert(dl["x"].count() == 2, "dict subscript push count");
    assert(dl["x"][0] == 42, "dict subscript push value 0");
    assert(dl["x"][1] == 99, "dict subscript push value 1");

    // === Subscript method call on mutable-type list element ===
    let mutable xs = List[List[Int]].new();
    xs.push(List[Int].new());
    xs[0].push(7);
    xs[0].push(8);
    assert(xs[0].count() == 2, "list subscript push count");
    assert(xs[0][0] == 7, "list subscript push value 0");
    assert(xs[0][1] == 8, "list subscript push value 1");

    println("builtin subscript dict ok");
};
