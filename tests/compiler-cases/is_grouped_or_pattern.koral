// EXPECT: grouped_or_pattern: PASS
// Several `is` tests on one subject join with the connector `or is`; the chain
// is one pattern, so the two sides share bindings the way a `when` arm's `or`
// does. (`is` used to take `(0 or 1)` -- parentheses no longer group a single
// pattern; `(` opens a tuple.)

let main() Int = {
    let x = 1;
    if x is 0 or is 1 then {
        println("grouped_or_pattern: PASS");
        return 0;
    };
    println("grouped_or_pattern: FAIL");
    return 1;
};
