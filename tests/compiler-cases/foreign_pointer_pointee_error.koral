// EXPECT-ERROR: does not satisfy the 'foreign' constraint
// `foreign` is a closed set about representation. A raw pointer is only as
// FFI-shaped as what it POINTS AT: `*String` carries a managed pointee across
// the boundary just as much as `String` does.

let main() Int = {
    let ps = List[*String].new();
    let _ = ps.borrow_ptr();
    return 0;
};
