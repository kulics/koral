// EXPECT-ERROR: Type 'T' does not satisfy the 'foreign' constraint (checking constraint T: foreign). Only built-in scalars, raw pointers and 'foreign type' declarations cross the FFI boundary.

// Same rule as `foreign` on a free function: a bare `T` forwarded into a
// method's `T foreign` is rejected unless declared `T foreign` itself.

type Holder(data Int);

given Holder {
    public get[T foreign](self, x T) Int = {
        return 1;
    };
};

let forward[T Any](x T) Int = {
    return Holder(1).get(x);
};

let main() Int = {
    return forward(1);
};
