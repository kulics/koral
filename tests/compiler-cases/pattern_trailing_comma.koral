// A pattern argument list accepts a trailing comma -- `<pattern-arg-list>`'s
// final `","?` (grammar.bnf). Pinned after the CFFI land: koralc's parser
// rejected the form the formatter emits while the reference accepted it.
// EXPECT: true
// EXPECT: pattern trailing comma tests passed

type E {
    A(),
    B(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Int, j: Int, k: Int, l: Int),
    C(),
};

let f(x: E): Bool = when x in {
    .A() or .B(
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
    ) then true,
    _ then false,
};

let main(): Int = {
    println("\(f(E.A()))");
    println("pattern trailing comma tests passed");
    return 0;
};
