// EXPECT: counter after 3 calls: 3
// EXPECT: shared cell value: 7

// Closures capture by copy only. Shared mutable state goes through a `Cell`
// (a `type mutable` object): the closure captures the cell handle and all
// holders observe the same storage.

type mutable Shared(mutable value Int);

let main() Int = {
    // Counter through a cell: mutation is visible to every holder.
    let counter = Cell(0);
    let increment = () -> {
        counter.value = counter.value + 1;
        return counter.value;
    };
    increment();
    increment();
    increment();
    println("counter after 3 calls: " + counter.value.to_string());

    // A `type mutable` object works the same way as a cell.
    let shared = Shared(5);
    let bump = () -> {
        shared.value = shared.value + 2;
    };
    bump();
    println("shared cell value: " + shared.value.to_string());
    return 0;
};
