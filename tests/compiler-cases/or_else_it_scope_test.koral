// EXPECT: or_else it is unwrapped: 42
// EXPECT: or_else it on None: 7
// EXPECT: and_then it chain: 8
// EXPECT: and_then then or_else: 4
// EXPECT: nested it shadow: 42
//
// `or else` opens an `it` scope bound to the left operand's unwrapped value
// (for Option) or error value (for Result), and `and then` opens an `it` scope
// bound to the previous unwrapped result. An outer `it` must not leak into
// either operand -- each construct shadows it with its own binding.

let main() Int = {
    // `it` in the or-else fallback has the unwrapped Int type of the left
    // operand. `x` is Some(42) so the fallback is not evaluated and the result
    // is the unwrapped value itself.
    let x Option[Int] = Option[Int].Some(42);
    let v = x or else it + 1;
    print("or_else it is unwrapped: ");
    println(v);

    // On None the fallback runs. `it` is in scope (shadows any outer binding).
    let y Option[Int] = Option[Int].None();
    let w = y or else 7;
    print("or_else it on None: ");
    println(w);

    // `and then` chains bind `it` to the previous unwrapped result.
    // Some(3) -> Some(4) -> Some(8)
    let a = Option[Int].Some(3) and then it + 1 and then it * 2;
    when a in {
        .Some(n) then {
            print("and_then it chain: ");
            println(n);
        },
        .None() then {
            print("and_then it chain: ");
            println(0);
        },
    };

    // Mixed: unwrapped by `and then`, then `or else` over the result.
    // Some(2) -> Some(4) -> or else -> 4
    let b = Option[Int].Some(2) and then it * 2 or else 5;
    print("and_then then or_else: ");
    println(b);

    // Shadowing: the outer `and then` binds `it` as String; the inner `or else`
    // on Option[Int] must shadow it with Int so `it + 1` type-checks as Int+Int.
    let outer Option[String] = Option[String].Some("hello");
    let inner Option[Int] = Option[Int].Some(42);
    let c = outer and then (inner or else it + 1);
    when c in {
        .Some(n) then {
            print("nested it shadow: ");
            println(n);
        },
        .None() then {
            print("nested it shadow: ");
            println(0);
        },
    };

    return 0;
};
