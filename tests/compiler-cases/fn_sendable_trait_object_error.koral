// EXPECT-ERROR: Type 'Human' must be sendable to implement sendable trait 'Speak'
// Every implementor of a `trait sendable` declaration must itself be sendable
// (safe or unsafe form both count), so the trait's objects stay
// always-sendable. The refusal fires at the `given`, not at the box
// (concurrency-design.md §派生规则 6).

trait sendable Speak {
    speak(self): Int;
};

type Human(name: String);

given Human: Speak {
    speak(self): Int = 1;
};

let main(): Void = {};
