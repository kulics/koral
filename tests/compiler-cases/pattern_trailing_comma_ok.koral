// EXPECT: enum:
// EXPECT: 3
// EXPECT: struct:
// EXPECT: 3
// EXPECT: tuple:
// EXPECT: 3
// EXPECT: list:
// EXPECT: 3
// Trailing commas are allowed in every pattern element list -- enum-case
// args, struct destructuring, tuple destructuring, list destructuring -- the
// same rule a call argument list follows.

type Shape {
    Circle(r: Int),
    Rect(w: Int, h: Int),
};

type Point(x: Int, y: Int);

let enumTotal(s: Shape): Int = {
    return when s in {
        .Circle(r,) then r,
        .Rect(w, h,) then w + h,
    };
};

let structTotal(p: Point): Int = {
    return when p in {
        Point(a, b,) then a + b,
    };
};

let tupleTotal(p: Point): Int = {
    return when p in {
        (a, b,) then a + b,
    };
};

let listTotal(xs: List[Int]): Int = {
    return when xs in {
        [a, b,] then a + b,
        _ then 0,
    };
};

let main(): Int = {
    println("enum:");
    println(enumTotal(.Circle(3)));
    println("struct:");
    println(structTotal(Point(1, 2)));
    println("tuple:");
    println(tupleTotal(Point(1, 2)));
    println("list:");
    println(listTotal([1, 2]));
    return 0;
};
