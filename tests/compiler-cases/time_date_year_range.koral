// EXPECT: year_range_ok
// EXPECT: year_format_ok
// Date.new range-checks the year to 0000-9999, the range the "YYYY-MM-DD"
// text format can represent; outside it to_string used to render garbage
// ("000-1-01-01") and parse could not read it back.

using "std/time" { ... };

let main(): Int = {
    assert(Date.new(year = -1, month = 1, day = 1).is_error(), "year -1");
    assert(Date.new(year = 10000, month = 1, day = 1).is_error(), "year 10000");
    assert(Date.new(year = 0, month = 1, day = 1).is_error() == false, "year 0");
    assert(Date.new(year = 9999, month = 12, day = 31).is_error() == false, "year 9999");
    println("year_range_ok");

    assert(
        Date.new(year = 0, month = 1, day = 1).unwrap().to_string() == "0000-01-01",
        "year 0 render",
    );
    assert(
        Date.new(year = 9999, month = 12, day = 31).unwrap().to_string() == "9999-12-31",
        "year 9999 render",
    );
    assert(Date.parse("0000-01-01").is_error() == false, "year 0 parse");
    println("year_format_ok");

    return 0;
};
