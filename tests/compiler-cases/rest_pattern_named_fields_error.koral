// EXPECT-ERROR: Rest pattern cannot be used with named fields in 'Button'; match named fields by label
// Design guard: `...` names no field, so it cannot stand in for one that has
// to be matched by label. A named field already says which slot it wants, and
// the rest marker has nothing to say about it.
using "std";

type Button(width Int, height: Int, label: String);

let main() Int = {
    let b = Button(1, height: 2, label: "x");
    let s = when b in {
        Button(w, ...) then w,
        Button(w, height: _, label: _) then 0,
    };
    println(s);
    return 0;
};
