// EXPECT-ERROR: Panic: Fixed array index out of bounds: length 3
// A signed fixed-array index is checked at BOTH ends: `a[i]` with a
// negative `i` panics like an oversized one instead of reading before
// the array's storage.

let main(): Int = {
    let a: [3]Int = [10, 20, 30];
    let i: Int = 0 - 1;
    println(a[i]);
    return 0;
};
