// EXPECT-ERROR: Rest pattern must be inside a list, enum, struct, or tuple pattern
// Design guard: a rest slot swallows the unwritten remainder of an ELEMENT
// LIST. At the top of an arm there is no such list, so `...` says nothing.
using "std" { ... };

let main(): Int = {
    let xs: List[Int] = [1];
    let s = when xs in {
        ... then 1,
        _ then 2,
    };
    println(s);
    return 0;
};
