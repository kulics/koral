// EXPECT-ERROR: expected ':' after generic parameter name 'T'
// The bare form `given[T] Box[T]: Ping` is not a way to skip bounds: every
// generic parameter must spell its constraint, at minimum `T: Any`
// (type_parameter_requires_constraint_error.koral pins the colon-with-nothing
// sibling). The blessed spelling of this impl is `given[T: Any] Box[T]: Ping`
// -- the conditional sendable case is enforced at the box site, not by
// demanding a `T: sendable` bound here (concurrency-design.md §可组合种类约束).

trait sendable Ping {
    ping(self): Int;
};

type sendable Box[T: Any](value: T);

given[T] Box[T]: Ping {
    ping(self): Int = 1;
};

let main(): Void = {
    let _ = Box[Int](1);
};
