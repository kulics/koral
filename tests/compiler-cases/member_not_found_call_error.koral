// Same as member_not_found_struct_error, but reached through a call, which
// lowers to a closure call and used to produce `void _t68;` style clang errors.

// EXPECT-ERROR: Member 'nope' not found in type 'Foo'

type Foo(x Int);

let main() Void = {
    let f = Foo(1);
    f.nope();
    println("unreachable");
};
