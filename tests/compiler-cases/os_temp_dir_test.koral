// EXPECT: temp_dir_ok

// temp_dir() must return a real directory: "/tmp"-style on POSIX and the
// Windows temp location on Windows, even in a stripped environment where
// TMPDIR/TEMP/TMP are all unset.
using "std/os" { ... };

let main(): Void = {
    let td = temp_dir();
    assert(not td.is_empty(), "temp_dir not empty");
    assert(file_info(td).unwrap().is_dir(), "temp_dir is a directory");
    if is_windows_host() then {
        assert(not td.to_string().starts_with("/"), "windows temp is not /tmp");
    };
    println("temp_dir_ok");
};
