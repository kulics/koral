// EXPECT: cname alias ok
// A declared C name rides the mangling slot (cffi-design.md §C): the Koral
// spelling stays a lowercase value name, the string is what C links against.
// A Koral name that would collide with a C keyword is unspellable without it.

let foreign "abs" int(x: Int32): Int32;
let foreign "toupper" my_upper(c: Int32): Int32;

let main(): Int = {
    assert(int(Int32(-2)) == Int32(2), "call through a keyword-colliding Koral name");
    assert(my_upper(Int32(97)) == Int32(65), "call through the aliased name");
    let f: foreign (Int32) -> Int32 = my_upper;
    assert(f(Int32(98)) == Int32(66), "the aliased function still inhabits a C pointer");
    println("cname alias ok");
    return 0;
};
