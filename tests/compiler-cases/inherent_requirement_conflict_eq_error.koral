// EXPECT-ERROR: Duplicate definition: equals
// A lang-item requirement is not exempt from the collision rule: an inherent
// `equals` shares its name with `Eq`'s requirement on the same type, so the
// definition is rejected -- `a.equals(b)` and `a == b` must not silently
// resolve to two different methods. (This case pinned the old coexistence.)

type Coord(x: Int, y: Int);

given Coord {
    equals(self, other: Coord): Bool = self.x == other.x and self.y == other.y;
};

given Coord: Eq {
    equals(self, other: Coord): Bool = self.x == other.x and self.y == other.y;
};

let main(): Int = {
    let a = Coord(1, 2);
    let b = Coord(1, 2);
    println(a.equals(b).to_string());
    return 0;
};
