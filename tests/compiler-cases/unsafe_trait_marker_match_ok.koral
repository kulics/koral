// EXPECT: 9
// Requirement and implementation carry the SAME marker (R3), and calling the
// requirement through a trait object needs an unsafe context (B1).

trait Poke {
    unsafe peek(self): Int;
};

type Box(v: Int);

given Box: Poke {
    public unsafe peek(self): Int = self.v;
};

let main(): Int = {
    let b = Box(9);
    let p: Poke = b;
    let v = unsafe { p.peek() };
    println(v.to_string());
    return 0;
};
