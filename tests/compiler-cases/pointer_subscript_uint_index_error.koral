// EXPECT-ERROR: Type mismatch: expected Int, got UInt
// The reverse mismatch of `pointer_subscript_int_index_test`: a `UInt` index
// is refused by the pointer subscript's exact `Int` ABI.

let main(): Int = {
    let p = alloc_memory[Int](1);
    init_memory(p, 5);
    let u: UInt = 0;
    println(p[u]);
    deinit_memory(p);
    dealloc_memory(p);
    return 0;
};
