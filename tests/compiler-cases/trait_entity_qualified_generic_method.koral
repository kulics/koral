// EXPECT: 15
// EXPECT: 7
// EXPECT: v5

// Fully qualified calls use one written form, `Type(Trait).method(...)`:
// the receiver of an instance method is the first call argument, and method
// type arguments stay after the method name.

trait Tag {
    value(self) Int;
};

given Tag {
    scaled[Factor Any](self, factor: Int) Int = self.value() * factor;
    kind(self) Int = 7;
    describe(self, prefix: String) String = prefix + self.value().to_string();
};

type Num(x Int);

given Num as Tag {
    value(self) Int = self.x;
};

let main() Int = {
    let n = Num(5);
    // Instance method with method-level type arguments: receiver first.
    println(Num(Tag).scaled[Int](n, factor: 3).to_string());
    // Trait tool method with a receiver parameter, same written form.
    println(Num(Tag).kind(n).to_string());
    // Named parameters work the same as any other call.
    println(Num(Tag).describe(n, prefix: "v"));
    return 0;
};
