// EXPECT: owned * return ok
// EXPECT: owned trait * return ok

trait OwnedRefReturnReader {
    read(*self) Int
}

type OwnedRefReturnBox(value Int)

given OwnedRefReturnBox as OwnedRefReturnReader {

    public read(*self) Int = self.value
}

let make_box() * OwnedRefReturnBox = {
    let value = OwnedRefReturnBox(7)
    return &value
}

let identity_box_ref(box * OwnedRefReturnBox) * OwnedRefReturnBox = box

let identity_reader_ref(reader * OwnedRefReturnReader) * OwnedRefReturnReader = reader

let main() Int = {
    let strong = identity_box_ref(make_box())
    assert(strong.value == 7, "owned * return should preserve heap object")
    println("owned * return ok")

    let reader * OwnedRefReturnReader = strong
    let alias = identity_reader_ref(reader)
    assert(alias.read() == 7, "owned trait * return should preserve heap object")
    println("owned trait * return ok")
    return 0
}
