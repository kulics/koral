// EXPECT-ERROR: Duplicate definition: describe
// An inherent method may not share a name with a trait REQUIREMENT its type
// implements. The collision is a definition-level error -- not a call-site
// choice between candidates -- and it fires in every declaration order.

trait Tag {
    describe(self): String;
};

type Num(x: Int);

given Num: Tag {
    describe(self): String = "tag";
};

given Num {
    describe(self): String = "inherent";
};

let main(): Int = {
    return 0;
};
