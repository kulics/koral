// EXPECT-ERROR: Integer literal 99999999999999999999 is out of range for Int
// An un-annotated integer literal is defaulted to Int and range-checked against
// that default. Left unchecked it reaches the C compiler as "integer literal is
// too large to be represented in any integer type" -- a diagnostic with no
// source location, reported long after the offending line.

let main() Void = {
    let x = 99999999999999999999;
    println(x);
};
