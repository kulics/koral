// A list pattern slot may itself be a full pattern -- a literal, an enum case,
// another list. The slot is its own subject: an inner pattern must be checked
// against the ELEMENT, never against the list.
// EXPECT: list_nested_enum_ok
// EXPECT: list_nested_literal_ok
// EXPECT: list_nested_list_ok

using "std" { ... };

type Part {
    Lit(text: String),
    Interp(),
};

let main(): Int = {
    let parts: List[Part] = [Part.Lit("hi")];

    // The slot binds inside the enum payload.
    let s = when parts in {
        [.Lit(text)] then text,
        _ then "interp",
    };
    if s == "hi" then {
        println("list_nested_enum_ok");
    };

    // The slot may be a literal pattern too.
    let nums: List[Int] = [7, 8];
    let n = when nums in {
        [7, ...] then "seven",
        _ then "other",
    };
    if n == "seven" then {
        println("list_nested_literal_ok");
    };

    // A list inside a list.
    let nested: List[List[Int]] = [[1, 2]];
    let m = when nested in {
        [[a, b]] then a + b,
        _ then 0,
    };
    if m == 3 then {
        println("list_nested_list_ok");
    };

    return 0;
};
