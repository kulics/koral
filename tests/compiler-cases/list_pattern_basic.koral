// List patterns -- destructuring a `List[T]` by length. Without a rest slot
// the length must match exactly, and each slot binds one element.
// EXPECT: list_basic_exact_ok
// EXPECT: list_basic_empty_ok
// EXPECT: list_basic_bindings_ok
// EXPECT: list_basic_is_ok

using "std";

let main() Int = {
    let xs List[Int] = [1, 2, 3];

    // Exact length: `[a, b, c]` matches only a three-element list.
    let shape = when xs in {
        [] then "empty",
        [a] then "one",
        [a, b] then "two",
        [a, b, c] then "three",
        _ then "more",
    };
    if shape == "three" then {
        println("list_basic_exact_ok");
    };

    // The empty pattern matches exactly one length.
    let empty_shape = when xs in {
        [] then "empty",
        _ then "nonempty",
    };
    if empty_shape == "nonempty" then {
        println("list_basic_empty_ok");
    };

    // Slots bind elements of the list's element type.
    let bound = when xs in {
        [a, b, c] then a + b + c,
        _ then 0,
    };
    if bound == 6 then {
        println("list_basic_bindings_ok");
    };

    // The same patterns work under `is`.
    if xs is [a, b, c] then {
        println("list_basic_is_ok");
    };

    return 0;
};
