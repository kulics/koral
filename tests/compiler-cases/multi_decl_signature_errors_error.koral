// Three independent signature errors in three declarations are three
// diagnostics: a rejected parameter type is recorded for its own
// declaration and the next declaration is still checked. Both compilers
// report the same three, in declaration order.
// EXPECT-ERROR: multi_decl_signature_errors_error.koral:9:10: error: Undefined type: NoSuchTypeOne
// EXPECT-ERROR: multi_decl_signature_errors_error.koral:11:10: error: Undefined type: NoSuchTypeTwo
// EXPECT-ERROR: multi_decl_signature_errors_error.koral:13:10: error: Undefined type: NoSuchTypeThree

let f(x: NoSuchTypeOne): Int = 1;

let g(x: NoSuchTypeTwo): Int = 1;

let h(x: NoSuchTypeThree): Int = 1;

let main(): Int = 0;
