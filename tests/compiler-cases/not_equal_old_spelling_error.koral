// EXPECT-ERROR: '<>' is not supported; use '!='
// Design guard: `<>` is retired; not-equal is spelled `!=`. The lexer rejects
// the old spelling as a unit -- letting it munch as `<` then `>` would report
// "expected expression, got '>'", which is true but never names the mistake,
// so the message has to name the replacement here.

let main() Int = {
    let a = 1;
    let b = 2;
    if a <> b then {
        println("no");
    };
    return 0;
};
