// Test: Method calls on * types should auto-dereference
// EXPECT: 3
// EXPECT: 42

public type Counter(value Int)

given Counter {

    public count(self) Int = self.value
}

// Function that takes a * parameter and calls method on it
let get_count(c * Counter) Int = c.count()

// Function that takes a List * and uses subscript
let get_first(list * List[Int]) Int = list[0]

public let main() Void = {
    let mutable counter = Counter(3)
    println(get_count(&counter).to_string())
    
    let mutable nums = List[Int].new()
    nums.push(42)
    nums.push(10)
    nums.push(20)
    println(get_first(&nums).to_string())
}
