// EXPECT: nested: 2
// EXPECT: nested_other: 0
// EXPECT: generic: 3
// A nested generic-enum payload's pattern leaves are checked against the
// INSTANCE's field types -- `Wrap(v T)` in `G2[Bool]` is `Wrap(v Bool)` --
// so `.Wrap(true)` / `.Wrap(false)` really do close the `Wrap` case and
// `.Empty()` closes the payload. Every arm is reachable: the trailing `_`
// still covers `P`'s other case (and `P[G2[Bool]]`'s `.Outer` is closed by
// the three payload arms, leaving the catchall reachable through `Other`).

type G2[T: Any] {
    Wrap(v: T),
    Empty(),
};

type P {
    Outer(inner: G2[Bool]),
    Other(),
};

type Q[T: Any] {
    Outer(inner: T),
    Other(),
};

let classify_nested(p: P): Int = when p in {
    .Outer(.Wrap(true)) then 1,
    .Outer(.Wrap(false)) then 2,
    .Outer(.Empty()) then 3,
    _ then 0,
};

let classify_generic(q: Q[G2[Bool]]): Int = when q in {
    .Outer(.Wrap(true)) then 1,
    .Outer(.Wrap(false)) then 2,
    .Outer(.Empty()) then 3,
    _ then 0,
};

let main(): Int = {
    println("nested: \(classify_nested(P.Outer(G2[Bool].Wrap(false))))");
    println("nested_other: \(classify_nested(P.Other()))");
    println("generic: \(classify_generic(Q[G2[Bool]].Outer(G2[Bool].Empty())))");
    return 0;
};
