// EXPECT: ascii_preds_ok
// UInt8 / Rune 补 is_ascii_control / is_ascii_graphic / is_ascii_punctuation
// （Rust u8/char 同族）与 Rune.from_uint8 转换（全值域无检查）。

let main(): Int = {
    // UInt8
    assert(UInt8(7).is_ascii_control(), "bell is control");
    assert(UInt8(127).is_ascii_control(), "del is control");
    assert(not UInt8(32).is_ascii_control(), "space is not control");
    assert(UInt8(33).is_ascii_graphic(), "bang is graphic");
    assert(not UInt8(32).is_ascii_graphic(), "space is not graphic");
    assert(UInt8(33).is_ascii_punctuation(), "bang is punctuation");
    assert(not UInt8(65).is_ascii_punctuation(), "letter is not punctuation");
    assert(not UInt8(48).is_ascii_punctuation(), "digit is not punctuation");

    // Rune 同族对称
    let bang = Rune.from_uint8(UInt8(33));
    assert(bang.is_ascii_graphic() and bang.is_ascii_punctuation(), "rune predicates");
    assert(Rune.from_uint8(200).to_uint32() == 200, "from_uint8 widens");
    let bell = Rune.from_uint8(7);
    assert(bell.is_ascii_control(), "rune control");

    println("ascii_preds_ok");
    return 0;
};
