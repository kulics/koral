// EXPECT-ERROR: Undefined variable: b
// A global `let` initializer runs in declaration order. Reading one that has
// not been checked yet is a forward reference -- and a cycle is made of those
// -- so it would load the zero the runtime has not written over yet.

let a Int = b;
let b Int = a;

public let main() Int = {
    println(a.to_string());
    return 0;
};
