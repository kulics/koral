// Test that when two traits define the same method name and a type
// implements both, the call should be rejected as ambiguous.
// EXPECT-ERROR: Ambiguous method 'greet' for type 'Person' via trait extensions

trait Greet {
    greet(*self) String;
};

trait Farewell {
    greet(*self) String;
};

type Person(name String);

given Person as Greet {
    greet(*self) String = {
        return "Hello, " + self.name;
    };
};

given Person as Farewell {
    greet(*self) String = {
        return "Goodbye, " + self.name;
    };
};

let main() Int = {
    let p = Person("World");
    // This should be ambiguous - which greet() is called?
    let result = p.greet();
    println(result);
    return 0;
};