// Tests that T * * satisfies ToString when T implements ToString.
// This exercises recursive blanket given lookup for *-like receivers.
// EXPECT: Wrapper(42)

type Wrapper(value Int)

given Wrapper as ToString {

    public to_string(*self) String = "Wrapper(" + self.value.to_string() + ")"
}

let print_it[T ToString](x T) Void = println(x.to_string())

let main() Void = {
    let mutable w = Wrapper(42)
    let inner = &w
    let mutable outer_base = inner
    let outer = &outer_base
    print_it(outer)
}
