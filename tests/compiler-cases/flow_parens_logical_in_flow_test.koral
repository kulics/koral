// EXPECT-ERROR: 'or else' can only be used with Option or Result types
// Parentheses cross the boundary in this direction too. The parser accepts
// `(ready and flag) or else default` -- the complaint that follows is the type
// error a flow operator always reports when its left side is not an
// Option / Result, not a parse error about mixing.

let main() Int = {
    let ready Bool = true;
    let flag Bool = true;
    let ok = (ready and flag) or else false;
    let _ = ok;
    return 0;
};
