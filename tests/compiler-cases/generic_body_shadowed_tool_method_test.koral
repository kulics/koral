// EXPECT: tool:5
// EXPECT: inherent
// EXPECT: tool:5
// A generic body matches trait methods BY THE CONSTRAINT, so `t.describe()`
// under `[T: Tag]` finds `Tag`'s TOOL method even when the receiver type also
// has an inherent `describe`. The inherent method wins only where the RECEIVER
// names it (guide: "Inherent type methods win over trait tool methods" -- a
// call on the concrete type), never where the bound names the tool.

trait Tag {
    value(self): Int;
};

given Tag {
    describe(self): String = "tool:" + self.value().to_string();
};

type Num(x: Int);

given Num: Tag {
    value(self): Int = self.x;
};

given Num {
    describe(self): String = "inherent";
};

let show_tool[T: Tag](t: T): String = {
    return t.describe();
};

let main(): Int = {
    let n = Num(5);
    println(show_tool(n));
    println(n.describe());
    let obj: Tag = n;
    println(obj.describe());
    return 0;
};
