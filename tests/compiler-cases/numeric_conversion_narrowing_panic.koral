// EXPECT-ERROR: Panic: numeric conversion overflow
// An integer conversion is checked, not wrapping: a value that does not fit the
// target panics instead of silently taking the low bits. `300` would wrap to
// `44` in `UInt8`.

let main(): Void = {
    let big: Int = 300;
    let a: UInt8 = UInt8(big);
    println(a);
};
