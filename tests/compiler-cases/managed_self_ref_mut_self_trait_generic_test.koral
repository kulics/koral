// EXPECT-EXACT: 3

trait ManagedBump {
    bump_and_keep(self ref mut Self) ref mut Self
}

type Counter(mut value Int)

given Counter as ManagedBump {
    public bump_and_keep(self ref mut Self) ref mut Self = {
        self.value += 1
        return self
    }
}

let bump_generic[T ManagedBump](value ref mut T) ref mut T = value.bump_and_keep()

let main() Int = {
    let strong ref mut Counter = box(Counter(1))
    let alias ref mut Counter = bump_generic(strong)
    alias.value += 1
    println(strong.value.to_string())
    return 0
}