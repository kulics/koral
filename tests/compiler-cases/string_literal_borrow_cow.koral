// EXPECT: literal_len_ok
// EXPECT: literal_alias_immutable_ok
// EXPECT: literal_builder_ok
// EXPECT: pattern_literal_ok

let main() Void = {
    let s = "abc";
    assert(s.count() == 3(UInt), "literal len should be 3");
    println("literal_len_ok");

    let t = s;
    assert(s == "abc", "literal source remains immutable");
    assert(t == "abc", "alias has same value");
    println("literal_alias_immutable_ok");

    let mutable b = StringBuilder.new();
    b.push_string(s);
    b.push_byte('?');
    let built = b.to_string();
    assert(s == "abc", "builder append does not mutate source alias");
    assert(built == "abc?", "builder creates new appended string");
    println("literal_builder_ok");

    let msg = "hello";
    let tag = when msg in {
        "hello" then "hit",
        _ then "miss",
    };
    assert(tag == "hit", "string literal pattern should match");
    println("pattern_literal_ok");
};
