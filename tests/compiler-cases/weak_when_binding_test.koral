// EXPECT: PASS
// `?w` upgrades a weak reference to `Option[T]`. Match on `.Some(v)` /
// `.None()` with `when`. This replaces the old `?v` pattern.

type mutable Box(mutable value Int);

let main() Int = {
    let b = Box(42);
    let w ?Box = ?Box(b);

    // when on the upgrade result
    let r = when ?w in {
        .Some(v) then v.value,
        .None() then -1,
    };
    if r <> 42 then {
        eprintln("FAIL: when ?w expected 42, got \(r)");
        return 1;
    };

    // Some branch with computation
    let r2 = when ?w in {
        .Some(v) then v.value + 1,
        .None() then -2,
    };
    if r2 <> 43 then {
        eprintln("FAIL: when ?w expected 43, got \(r2)");
        return 2;
    };

    // dead handle falls to None
    let dead ?Box = ?Box(b);
    // (the referent is still alive here, so upgrade succeeds)
    let r3 = when ?dead in {
        .Some(_) then 1,
        .None() then 0,
    };
    if r3 <> 1 then {
        eprintln("FAIL: live handle upgrade expected Some, got \(r3)");
        return 3;
    };

    println("PASS");
    return 0;
};
