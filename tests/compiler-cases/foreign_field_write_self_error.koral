// EXPECT-ERROR: Cannot assign to immutable variable: v
// `self` on a foreign type is a value copy, like a plain parameter: no
// in-place writes. Mutate through a `*mutable T` parameter instead.

type foreign Box(v: Int32);

given Box {
    set(self): Void = {
        self.v = Int32(1);
    };
};

let main(): Int = 0;
