// EXPECT: float32 pattern ok

// A float literal takes the subject's width: `1.1` against `Float32` is the
// `Float32` nearest 1.1, so it matches the value `Float32(1.1)` holds.

let main() Int = {
    let y Float32 = 1.1;
    let n = when y in {
        1.1 then 1,
        _ then 0,
    };
    if n <> 1 then {
        eprintln("FAIL: Float32(1.1) must match the pattern 1.1");
        return 1;
    };
    if y <> 1.1 then {
        eprintln("FAIL: Float32(1.1) must equal 1.1");
        return 1;
    };
    println("float32 pattern ok");
    return 0;
};
