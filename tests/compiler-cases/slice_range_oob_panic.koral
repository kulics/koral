// EXPECT-ERROR: Panic: Range.resolve_span out of bounds: count 2
// 窗界：`s[a..<b]` 是 Range 表达式实参，越界按 Range 语义 panic；
// 派生窗界限正确见 slice_subwindow_bounds_ok。
let main(): Void = {
    let xs = List[UInt8].new();
    xs.push(1);
    xs.push(2);
    let s = xs.into_slice();
    let w = s[0..<5];
    let _ = w.count();
};
