// EXPECT-ERROR: Panic: AtomicCell: re-entrant access from inside update_and_get

// The update_and_get lambda runs under the cell's lock, and the lock is
// non-recursive: a lambda that touches the same cell would deadlock holding
// it. The mistake panics with a diagnostic instead of hanging (the Lazy
// re-entrancy discipline).

using "std/sync" { ... };

let main(): Void = {
    let cell = AtomicCell[Int].new(1);
    let _ = cell.update_and_get((v: Int): Int => v + cell.get());
};
