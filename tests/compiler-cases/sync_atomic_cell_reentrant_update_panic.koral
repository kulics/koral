// EXPECT-ERROR: Panic: AtomicCell.update_and_get: too many retries -- the updater must not modify the same cell

// `update_and_get` is optimistic: the updater runs with no lock held and its
// result is committed only when the cell is unchanged, so an updater that
// writes the cell it updates invalidates every attempt and the loop gives up
// with a diagnostic instead of spinning forever. (An updater that only READS
// the cell is fine -- see sync_atomic_cell_test.)

using "std/sync" { ... };

let main(): Void = {
    let cell = AtomicCell[Int].new(1);
    let _ = cell.update_and_get((v: Int): Int => cell.update_and_get((w: Int): Int => w + 1));
};
