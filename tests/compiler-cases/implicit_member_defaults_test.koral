// EXPECT: m: 800x600
// EXPECT: n: 5x600
// EXPECT: q: quit
//
// Implicit-member construction fills declared defaults exactly like the
// explicit `Type.Case(...)` spelling: a defaulted parameter that the call
// omits takes its own declared default, and a named argument may be given
// while the rest fill in. (Before this, the implicit path skipped argument
// planning entirely and a defaulted `.Case()` reached codegen one argument
// short per omitted field.)

type Msg {
    Resize(width: Int = 800, height: Int = 600),
    Quit(),
};

let main(): Int = {
    let m: Msg = .Resize();
    when m in {
        .Resize(width = w, height = h) then {
            print("m: ");
            print(w);
            print("x");
            println(h);
        },
        .Quit() then println("m: quit"),
    };

    // Partial named call: the omitted parameter fills from its default.
    let n: Msg = .Resize(width = 5);
    when n in {
        .Resize(width = w, height = h) then {
            print("n: ");
            print(w);
            print("x");
            println(h);
        },
        .Quit() then println("n: quit"),
    };

    // A zero-field case takes no arguments at all.
    let q: Msg = .Quit();
    when q in {
        .Resize(width = _, height = _) then println("q: resize"),
        .Quit() then println("q: quit"),
    };
    return 0;
};
