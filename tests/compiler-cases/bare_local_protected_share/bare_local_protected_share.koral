// EXPECT: bare protected share ok
// The other half of the anonymous package identity pin: entry and local
// modules are ONE package, so `protected` crosses between them exactly as it
// does inside a manifest package. Before the fix the entry sat in `root:user`
// while local modules were stamped into `std:std`, and this read was denied.
using "./shared.koral" { shared_value };

let main(): Int = {
    if shared_value == 42 then {
        println("bare protected share ok");
    };
    return 0;
};
