// EXPECT-ERROR: Type mismatch: expected *mutable Counter, got Counter

// This test verifies that passing a value to a function expecting *mutable
// produces a type mismatch error. Implicit managed-ref promotion is not
// allowed for ordinary parameters; callers must pass an explicit `&mutable`
// from a mutable lvalue instead.

type Counter(mutable value Int)

let increment(c *mutable Counter) Void = {
    c.value += 1
}

let main() Int = {
    let x = Counter(0)
    increment(x)
    return 0
}
