// EXPECT-ERROR: Type mismatch: expected *mut Counter, got Counter

// This test verifies that passing a value to a function expecting *mut
// produces a type mismatch error. Implicit managed-ref promotion is not
// allowed for ordinary parameters; callers must pass an explicit `&mut`
// from a mutable lvalue instead.

type Counter(mut value Int)

let increment(c *mut Counter) Void = {
    c.value += 1
}

let main() Int = {
    let x = Counter(0)
    increment(x)
    return 0
}
