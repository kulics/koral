// Test that semicolon-terminated final expressions still produce Void.
// The block { 1 + 2; } has type Void, not Int.
// EXPECT-ERROR: Expression statement has no effect

let main() Int = {
    // Old-style implicit block value — should fail
    let x Int = {
        let a = 1;
        a + 2;
    };
    return x;
};
