// EXPECT-ERROR: Invalid operation generic given on non-generic type
// Design guard: a generic given must target a generic type constructor applied
// to exactly its own type parameters.
//
//     given [T Any] Box[T] { ... }          // ok
//     given [T Any] Box[Int] { ... }        // error: specialization not supported
//     given [T Any] One { ... }             // error: `One` is not generic, `T` is unbound
//
// The bare-name form used to slip through in bootstrap, which only checked that
// the target type resolved -- `given[E Any] One as SomeTrait` compiled and ran
// even though `E` appears nowhere. Swift rejected it via
// `decomposeGenericGivenTypeNode`; bootstrap now applies the same shape rule.
//
// Trait-ENTITY givens (`given [T Any] Iterator[T] { ... }`, which add members to
// the trait itself) are a different shape and are validated on their own path,
// so they are deliberately not covered by this rule.

trait Boxed[V Any] {
    take(self) V;
};

type One(n Int);

given[E Any] One as Boxed[Int] {
    public take(self) Int = self.n;
};

let main() Int = {
    return 0;
};
