// EXPECT: PASS

let main() Int = {
    let strong_mut *mutable Int = box(42)
    let strong *Int = strong_mut

    let weak ?*Int = downgrade[Int](strong)
    let weak_mut ?*mutable Int = downgrade_mut[Int](strong_mut)

    let upgraded = upgrade[Int](weak).unwrap()
    let upgraded_mut = upgrade_mut[Int](weak_mut).unwrap()

    if *upgraded <> 42 then {
        eprintln("FAIL: upgrade[Int] returned \(*upgraded)")
        return 1
    }
    if *upgraded_mut <> 42 then {
        eprintln("FAIL: upgrade_mut[Int] returned \(*upgraded_mut)")
        return 1
    }

    println("PASS")
    return 0
}