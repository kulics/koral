// EXPECT-ERROR: Panic: List index out of bounds
// Out-of-range frozen subscript panics exactly like the mutable `List` one.

using "std" { ... };

let main(): Int = {
    let source = List[Int].new();
    source.push(1);
    let frozen = source.to_frozen_list();
    let x = frozen[5];
    return x;
};
