// EXPECT: range deref bounds ok

let main() Void = {
    let value = 5
    let p *unsafe Int = &unsafe value

    let to = ..*p
    assert(to.contains(5), "To should contain dereferenced bound")
    assert(not to.contains(6), "To should not contain above dereferenced bound")

    let open_closed = 1<..*p
    assert(not open_closed.contains(1), "OpenClosed should exclude left bound")
    assert(open_closed.contains(2), "OpenClosed should include interior values")
    assert(open_closed.contains(5), "OpenClosed should include dereferenced bound")
    assert(not open_closed.contains(6), "OpenClosed should not exceed dereferenced bound")

    println("range deref bounds ok")
}