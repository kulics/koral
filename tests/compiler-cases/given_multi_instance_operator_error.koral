// EXPECT-ERROR: Conflicting conformance: 'given Vec Add' already declared
// A type conforms to a trait once, whatever type arguments the trait carries
// -- the trait rule, applied to the operator traits too. `given Vec: Add[Int]`
// and `given Vec: Add[Vec]` are two instances of one trait on one type, so
// the second is a conflicting conformance exactly like a duplicate
// `given Point: T`.

type Vec(x: Int);

given Vec: Add[Int] {
    add(self, other: Int): Vec = Vec(self.x + other);
};

given Vec: Add[Vec] {
    add(self, other: Vec): Vec = Vec(self.x + other.x);
};

let main(): Int = {
    return 0;
};
