// EXPECT-ERROR: 'and then' cannot be mixed with logical 'and' / 'or' without parentheses
// A flow operator may not follow a logical chain without parentheses.

let main() Int = {
    let left Bool = true;
    let right = Option[Bool].Some(true);
    let ok = left or right and then as v in v == 1;
    let _ = ok;
    return 0;
};
