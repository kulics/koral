// EXPECT: list_slice_empty_ok
// EXPECT: list_slice_empty_siblings_ok
// EXPECT: list_push_list_empty_ok
// EXPECT: list_insert_list_at_empty_ok

// Empty spans still slice to empty containers under the slice-index rule:
// every range that normalizes to `[lo, lo)` -- `a..<a`, `a<..a`, `a<..<a+1`,
// and `a..a-1` -- names no elements. (`a<..<a` crosses instead and panics;
// see panic_resolve_span_open_cross_error.)

let main(): Void = {
    let mutable l = List[Int].new();
    for i in 0..<5 then {
        l.push(i);
    };

    assert(l.sublist(2..<2).count() == 0, "2..<2 empty");
    assert(l.sublist(2<..2).count() == 0, "2<..2 empty");
    assert(l.sublist(2<..<3).count() == 0, "2<..<3 empty");
    assert(l.sublist(1<..<2).count() == 0, "1<..<2 empty");
    assert(l.sublist(3..2).count() == 0, "3..2 empty");
    assert(l.count() == 5, "sublist leaves source untouched");
    println("list_slice_empty_ok");

    let mutable e = List[Int].new();
    assert(e.sublist(0..<0).count() == 0, "0..<0 empty on empty list");
    let neg_one = 0 - 1;
    assert(e.sublist(0..neg_one).count() == 0, "0..-1 empty on empty list");
    println("list_slice_empty_siblings_ok");

    // push_list with an empty span appends nothing.
    let mutable dst = List[Int].new();
    dst.push(7);
    dst.push_list(l, span = 2..<2);
    assert(dst.count() == 1, "push_list(2..<2) appends nothing");
    assert(dst[0] == 7, "push_list keeps existing elements");
    println("list_push_list_empty_ok");

    // insert_list_at with an empty span inserts nothing.
    let mutable mid = List[Int].new();
    mid.push(1);
    mid.push(3);
    mid.insert_list_at(1, l, span = 2<..<3);
    assert(mid.count() == 2, "insert_list_at(2<..<3) inserts nothing");
    assert(mid[0] == 1 and mid[1] == 3, "insert_list_at keeps order");
    println("list_insert_list_at_empty_ok");

    // A non-empty span still slices normally.
    let slice = l.sublist(1<..<4);
    assert(slice.count() == 2, "1<..<4 has two elements");
    assert(slice[0] == 2 and slice[1] == 3, "1<..<4 picks 2, 3");
};
