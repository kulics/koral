// EXPECT-ERROR: Type mismatch: expected integer type, got Float64

// A comparison value's kind must match the subject's: an integer bound does
// not order a float. Write `> 1.0`.

let main() Int = {
    let x = 1.5;
    let n = when x in {
        > 1 then 1,
        _ then 0,
    };
    return n;
};
