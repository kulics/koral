// EXPECT: helloworld
// EXPECT: xyz
// EXPECT: 42

// `+=` on a type that reaches `+` through the `Add` trait must dispatch through
// that trait. koralc used to build a raw `ArithmeticExpr` from the assignment
// target, which lowered to a C `+` on structs and failed to compile for String.

let main(): Int = {
    let a = "hello";
    let b = "world";
    println(a + b);

    let mutable d = "x";
    d += "y";
    d += "z";
    println(d);

    let mutable n = 1;
    n += 41;
    println(n.to_string());
    return 0;
};
