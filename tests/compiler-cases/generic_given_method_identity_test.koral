// EXPECT: Some(42)
// EXPECT: Some(ok)

type Holder[T Any](value T);

given[T Any] Holder[T] {
    public wrap(self) Option[T] = Option[T].Some(self.value);
};

let main() Int = {
    println(Holder[Int](42).wrap().to_string());
    println(Holder[String]("ok").wrap().to_string());
    return 0;
};
