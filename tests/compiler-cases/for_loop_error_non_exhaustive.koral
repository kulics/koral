// EXPECT-ERROR: For binding cannot fail; use 'when' to match
// Design guard: a literal pattern can fail, so it cannot be a loop binding.
// `for` takes the full match grammar but demands the result be irrefutable.

using "std";

let main() Int = {
    let mutable list = List[Int].new();
    list.push(1);

    for 42 in list then {
        println("matched");
    };
    return 0;
};
