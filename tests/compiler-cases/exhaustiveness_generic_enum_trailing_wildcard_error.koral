// EXPECT-ERROR: Unreachable pattern '_': already covered by previous patterns
// A generic enum fully covered by its case arms leaves nothing for the
// trailing `_`: the case map substitutes the instance's type arguments into
// the payload fields, so `.Some(v)` / `.None()` really do close `Opt[Int]`.

type Opt[T Any] {
    Some(v T),
    None(),
};

let f(o Opt[Int]) Int = when o in {
    .Some(v) then v,
    .None() then 0,
    _ then 1,
};

let main() Int = {
    return f(Opt.Some(1));
};
