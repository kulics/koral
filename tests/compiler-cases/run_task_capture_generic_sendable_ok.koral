// EXPECT: 1
// A `sendable`-bounded generic parameter IS known sendable at the boundary:
// run_task may capture it inside `f[T: sendable]` -- the mirror of
// run_task_capture_generic_param_error.koral (concurrency-design.md §跨界检查 (a)).

using "std/async" { ... };

let work[T: sendable](x: T, show: sendable (T) -> Void): Void = {
    let t = run_task(() => {
        show(x);
    });
    let _ = t.wait();
};

let main(): Void = {
    work(1, (v: Int): Void => {
        println(v);
    });
};
