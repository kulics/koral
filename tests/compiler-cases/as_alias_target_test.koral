// EXPECT: 7
// A type alias to a pointer type is a legal `as` target: the alias resolves
// to the pointer type and the cast is an ordinary pointer reinterpretation.

type MyPtr = *Int;

let main(): Int = {
    let p = alloc_memory[Int](1);
    init_memory(p, 7);
    let q = p as MyPtr;
    println(*q);
    dealloc_memory(q);
    return 0;
};
