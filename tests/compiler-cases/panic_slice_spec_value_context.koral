// EXPECT-ERROR: Panic: List.slice_spec out of bounds: length 1
// Pin the slice_spec cold helper's BODY (2026-11-13 batch): the helper must
// carry the message, not recurse into itself -- a scripted body rewrite once
// turned the helper into a call to its own name and nothing exercised the
// path. The value context rides along.
let main(): Int = {
    let mutable xs = List[Int].new();
    xs.push(1);
    let sub = xs.sublist(0..<99);
    return sub.count();
};
