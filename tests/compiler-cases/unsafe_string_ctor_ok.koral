// EXPECT: from_utf8_ptr_ok
// EXPECT: from_cstring_ok
// EXPECT: from_bytes_ok

public let main(): Void = {
    let bytes: List[UInt8] = [104, 105];
    let s = unsafe { String.from_utf8_ptr(bytes.borrow_ptr(), bytes.count()).unwrap() };
    if s == "hi" then {
        println("from_utf8_ptr_ok");
    };

    let cbuf: List[UInt8] = [104, 101, 108, 108, 111, 0];
    let c = unsafe { String.from_cstring_ptr(cbuf.borrow_ptr()).unwrap() };
    if c == "hello" then {
        println("from_cstring_ok");
    };

    // The safe wrapper absorbs the contract: no unsafe at the call site.
    let b = String.from_bytes(bytes).unwrap();
    if b == "hi" then {
        println("from_bytes_ok");
    };
};
