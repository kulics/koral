// EXPECT: 8
// EXPECT: 1
// Shifts dispatch through `ShiftLeft` / `ShiftRight` with the rhs typed by the
// trait's `R` -- here a plain `Int` count, the ergonomic shape for a bit set.

type Mask(bits: UInt8);

given Mask: ShiftLeft[Int] {
    public shift_left(self, other: Int): Mask = Mask(self.bits << UInt8(other));
};

given Mask: ShiftRight[Int] {
    public shift_right(self, other: Int): Mask = Mask(self.bits >> UInt8(other));
};

given Mask {
    public to_string(self): String = self.bits.to_string();
};

let main(): Int = {
    println((Mask(1) << 3).to_string());
    println((Mask(8) >> 3).to_string());
    return 0;
};
