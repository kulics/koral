// EXPECT: pod borrow ok

// `borrow_ptr` / `borrow_mut_ptr` stay available for plain-old-data element
// types, which is the FFI-compatible case.

type Raw(impl: Int);

given Raw as Pod {};

let main() Int = {
    let bytes = List[UInt8].new();
    bytes.push(65);
    bytes.push(66);
    let ptr = bytes.borrow_ptr();
    if ptr == null_ptr[UInt8]() then {
        eprintln("FAIL: null borrow_ptr");
        return 1;
    };
    let _ = bytes.borrow_mut_ptr();

    // User-declared POD types can opt in the same way.
    let raws = List[Raw].new();
    raws.push(Raw(impl: 1));
    let _ = raws.borrow_ptr();

    println("pod borrow ok");
    return 0;
};
