// EXPECT: cast-copy-unique: false

type Holder(value * Int)

let main() Int = {
    let mutable v = 1
    let r * Int = &v
    let a = Holder(r)
    let b Holder = a(Holder)

    assert(*b.value == 1, "copied holder value")
    print("cast-copy-unique: ")
    println(is_unique_mutable(&! r))
    return 0
}
