// `unsafe sendable` skips the field/payload check entirely (concurrency-design.md
// §unsafe 契约): raw pointers and unmarked nominal fields are the developer's promise.
// EXPECT: unsafe ok 7
type UnsafeWrap(p: *UInt8, n: Int);
type unsafe sendable Holder(w: UnsafeWrap, p: *UInt8);

let main(): Void = {
    let h = Holder(UnsafeWrap(null, 3), null);
    println("unsafe ok \(h.w.n + 4)");
};
