// EXPECT: lock_counter_ok

// Cross-thread hammering of a safe `sendable mutable` counter
// (concurrency-design.md §对象锁语义): every field access is individually
// race-free (the read and the write each take the field's protocol), but
// `hits = hits + 1` is TWO accesses -- concurrent increments lose updates BY
// DESIGN. This test pins that the hammering terminates race-free and bounded;
// the exact-count story lives in sync_atomic_cell_update_counter_test
// (`AtomicCell.update_and_get` is the atomic read-modify-write).

using "std/async" { ... };

type sendable mutable Counter(mutable hits: Int);

let main(): Void = {
    let c = Counter(0);
    let mutable threads = List[Thread].new();
    let mutable i = 0;
    while i < 8 then {
        let shared = c;
        threads.push(
            run_task(
                () => {
                    let mutable j = 0;
                    while j < 5000 then {
                        shared.hits = shared.hits + 1;
                        j = j + 1;
                    };
                },
            ),
        );
        i = i + 1;
    };
    for t in threads then {
        let _ = t.wait();
    };
    assert(c.hits >= 1, "counter made progress");
    assert(c.hits <= 40000, "no value past the naive sum");
    println("lock_counter_ok");
};
