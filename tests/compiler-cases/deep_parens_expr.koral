// EXPECT: parens ok 32
// EXPECT: done

// Deeply nested parentheses (32 here) exercised an exponential re-scan in
// koralc's type-shape scanner: `scan_type_shape_at` retried the same inner run
// through `scan_paren_type_suffix_at` after `scan_type_param_list_at`, costing
// Theta(2^depth) per nesting level (24 deep took ~6.6s). The scanner now
// decides from a single scan. The Swift reference parser was already linear.
//
// Negative control: reverting the single-scan fix makes this case exceed the
// runner's 60s timeout (32 deep is ~2^8 = 256x the 24-deep 6.6s).

let main(): Void = {
    let v = ((((((((((((((((((((((((((((((((7))))))))))))))))))))))))))))))));
    assert(v == 7, "paren value");
    println("parens ok 32");
    println("done");
};
