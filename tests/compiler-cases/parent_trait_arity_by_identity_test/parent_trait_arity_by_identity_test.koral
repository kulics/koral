using "parent_trait_arity_by_identity_test/alpha" { Tag };

// EXPECT: 5
// A parent's TYPE ARGUMENTS are checked against the parent the spelling
// actually denotes -- alpha's `Tag[T]` here -- never against whichever
// same-named trait registered last in the bare name index. Reading beta's
// zero-parameter `Tag` from the index rejected `Tag[Int]` with a spurious
// arity mismatch.

trait Child: Tag[Int] {
    c(self): Int;
};

type Kid(x: Int);

given Kid: Tag[Int] {
    v(self): Int = self.x;
};

given Kid: Child {
    c(self): Int = self.x;
};

let main(): Int = {
    let k = Kid(5);
    println(k.v().to_string());
    return 0;
};
