// `abs` follows the receiver's family for overflow. On a regular type
// `Int.MIN.abs()` panics (see integer_abs_min_panic); on a Wrapping type
// there IS a wrapping answer -- `-MIN` wraps back to `MIN` -- so it wraps.
// EXPECT: wrap_abs_min_ok
// EXPECT: wrap_abs_plain_ok

using "std/math" { ... };

let main(): Int = {
    // WrappingInt.MIN.abs() wraps back to MIN.
    let wmin = WrappingInt(Int.min_value());
    if wmin.abs() == wmin then {
        println("wrap_abs_min_ok");
    };

    // Same on the narrow widths, and the non-overflowing values agree with
    // the plain twin exactly.
    let w8min = WrappingInt8(-128);
    let ok8 = w8min.abs() == w8min;
    let ok_small = WrappingInt(-5).abs() == WrappingInt(5) and WrappingInt8(-5).abs() == WrappingInt8(
        5,
    ) and WrappingUInt(5).abs() == WrappingUInt(5) and WrappingInt(0).abs() == WrappingInt(
        0,
    );
    if ok8 and ok_small then {
        println("wrap_abs_plain_ok");
    };

    return 0;
};
