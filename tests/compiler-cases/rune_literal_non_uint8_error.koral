// EXPECT-ERROR: Type mismatch: expected UInt32, got Rune
// A rune literal is a byte exactly where a byte is wanted. Anywhere else it
// stays a `Rune`; `let x UInt32 = 'A'` is a type mismatch, not a narrowing the
// reader did not write.

public let main(): Int = {
    let x: UInt32 = 'A';
    return 0;
};
