// EXPECT-ERROR: Type mismatch: expected sendable () -> Void, got () -> Void
// The reverse widening is refused: a plain `() -> Void` value is not acceptable
// where `sendable () -> Void` is expected (concurrency-design.md §派生规则 5).
// (The display erases the flag on both sides; the refusal itself is the point.)
// `h` is a local: a module-level binding of the plain type would be refused by
// the global sendable check before this widening rule ever sees it.

let main(): Void = {
    let h: () -> Void = () => println("h");
    let g: sendable () -> Void = h;
    g();
};
