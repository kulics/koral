// EXPECT-ERROR: Panic: Range.resolve_span invalid range: start 2 > end 1
// `a<..<a` follows the half-open normalization like every other variant:
// `a<..<a` names `[a+1, a)`, which crosses, so the slice-index rule turns it
// into the invalid-range panic. The empty-span special case is gone -- for an
// empty span write `a..<a` or `a..a-1`.
let main(): Int = {
    let mutable xs = List[Int].new();
    xs.push(1);
    xs.push(2);
    let sub = xs.sublist(1<..<1);
    return sub.count();
};
