// List patterns take part in exhaustiveness by LENGTH. A pattern covers a
// length completely when every slot is irrefutable, so `[]` plus `[x, ...]`
// between them cover every list: length 0, and every length >= 1.
// EXPECT: list_exhaustive_ok
// EXPECT: list_exhaustive_nested_ok

using "std" { ... };

type Opt {
    Some(value List[Int]),
    None(),
};

let main() Int = {
    let xs List[Int] = [1, 2];

    // No `_` arm: `[]` covers length 0 and `[x, ...]` covers the rest.
    let s = when xs in {
        [] then "empty",
        [x, ...] then "nonempty",
    };
    if s == "nonempty" then {
        println("list_exhaustive_ok");
    };

    // The same rule works inside an enum payload.
    let o = Opt.Some(xs);
    let n = when o in {
        .Some([]) then 0,
        .Some([x, ...]) then 1,
        .None() then 2,
    };
    if n == 1 then {
        println("list_exhaustive_nested_ok");
    };

    return 0;
};
