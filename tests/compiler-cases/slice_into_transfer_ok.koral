// EXPECT: PASS
// into_slice 消费转移（slice-design §来源与转换）：整块转成可写切片，self 置空
// （掏空先于转移）；owner 消灭后窗口可逃逸、可长持。窗写走存新→释旧。
let take(xs: []mutable UInt8): Int = {
    if xs.count() > 0 then {
        xs[0] = 42;
    };
    return xs.count();
};

let main(): Int = {
    let xs = List[UInt8].new();
    xs.push(1);
    xs.push(2);
    let window = xs.into_slice();
    let n = take(window);
    if n != 2 then {
        println("FAIL count");
        return 1;
    };
    if window[0] != 42 then {
        println("FAIL write");
        return 1;
    };
    if xs.count() != 0 then {
        println("FAIL not gutted");
        return 1;
    };
    println("PASS");
    return 0;
};
