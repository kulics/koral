// A zero-capacity channel would make `while queue.count() >= capacity` always
// true and silently deadlock every sender. make_channel rejects it up front.
// EXPECT-ERROR: Panic: make_channel: capacity must be greater than zero

using "std/sync" { ... };

let main(): Void = {
    let ch = make_channel[Int](0);
    println("should_not_print");
};
