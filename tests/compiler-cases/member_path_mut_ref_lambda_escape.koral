// EXPECT: member escape first: 8
// EXPECT: member escape second: 9

public type Counter(mutable value Int);

let make_bump() Func() Int = {
    let mutable counter = Counter(7);
    let chosen *mutable Int = &mutable counter.value;
    return () -> {
        *chosen = *chosen + 1;
        return *chosen;
    };
};

let main() Int = {
    let bump = make_bump();
    println("member escape first: " + bump().to_string());
    println("member escape second: " + bump().to_string());
    return 0;
};