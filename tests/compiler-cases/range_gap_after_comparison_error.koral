// EXPECT-ERROR: Unexpected token: ..., expected: number, identifier, boolean literal, block expression, or collection literal

// `a < ...b` (a GAP between `<` and `...`) is not a range: the `<` is a
// comparison, and the `...b` that follows cannot be a comparison operand, so
// the program is rejected instead of silently compiling to a comparison
// against a range. A closed range hugs its operator: `a<..b` is OpenClosed.

let main(): Int = {
    let a = 1;
    let b = 2;
    if a < ...b then { };
    return 0;
};
