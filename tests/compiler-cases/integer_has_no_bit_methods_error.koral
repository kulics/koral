// The two abstractions do not mix: `Integer` is the mathematical integer
// (`abs` `pow` `gcd` `lcm` `ilog2` `ilog10`) and carries no bit methods.
// Generic code that wants the bit toolbox asks for `BinaryInteger`.
// EXPECT-ERROR: Member 'count_ones' not found in type 'T'

using "std/math" { ... };

let f[T: Integer](x: T): UInt = x.count_ones();

let main(): Int = 0;
