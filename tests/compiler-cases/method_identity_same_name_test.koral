// EXPECT: a:10
// EXPECT: b:bee

type A(v: Int);
type B(v: String);

given A {
    public tag(self): String = "a:" + self.v.to_string();
};

given B {
    public tag(self): String = "b:" + self.v;
};

let call_a(f: (A) -> String, value: A): String = f(value);
let call_b(f: (B) -> String, value: B): String = f(value);

let main(): Int = {
    println(call_a((x: A) => x.tag(), A(10)));
    println(call_b((x: B) => x.tag(), B("bee")));
    return 0;
};
