// EXPECT: 0
// EXPECT: 1
// EXPECT: static member value reference ok

type IntList = List[Int];

let main() Int = {
    let make_string = String.new;
    let s = make_string();
    println(s.count());

    let make_list = List[Int].new;
    let mutable xs = make_list();
    xs.push(1);
    println(xs.count());

    let make_alias_list = IntList.new;
    let mutable ys = make_alias_list();
    ys.push(1);
    println(ys.count());

    println("static member value reference ok");
    return 0;
};