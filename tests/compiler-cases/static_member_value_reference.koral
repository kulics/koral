// EXPECT: 0
// EXPECT: 1
// EXPECT: 1
// EXPECT: 9
// EXPECT: 1
// EXPECT: 7
// EXPECT: static member value reference ok

type Flag {
    On(),
    Off(),
}

type IntList = List[Int]
type MaybeInt = Option[Int]

let main() Int = {
    let make_string = String.new
    let s = make_string()
    println(s.count())

    let make_flag = Flag.On
    let flag = make_flag()
    when flag in {
        .On() then println(1),
        .Off() then println(0),
    }

    let make_list = List[Int].new
    let mutable xs = make_list()
    xs.push(1)
    println(xs.count())

    let make_some = Option[Int].Some
    let some_value = make_some(9)
    when some_value in {
        .Some(v) then println(v),
        .None() then println(0),
    }

    let make_alias_list = IntList.new
    let mutable ys = make_alias_list()
    ys.push(5)
    println(ys.count())

    let make_alias_some = MaybeInt.Some
    let alias_value = make_alias_some(7)
    when alias_value in {
        .Some(v) then println(v),
        .None() then println(0),
    }

    println("static member value reference ok")
    return 0
}