// EXPECT-ERROR: requires a wildcard or variable binding pattern

trait Problem {
    render(*self) Int
}

type ProbeIoError(value Int)

given ProbeIoError as Problem {

    render(*self) Int = self.value
}

let main() Int = {
    let err *Problem = box(ProbeIoError(7))
    let _ = when err in {
        io *ProbeIoError then io.render(),
    }
    return 0
}