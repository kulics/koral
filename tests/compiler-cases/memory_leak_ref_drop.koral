// EXPECT-ERROR: Expression statement has no effect
// Memory leak test: * drop correctness for all scope-creating syntax.
// Uses unique variable names per test to avoid codegen naming conflicts.

// ── Test 1: Block expression scope ────────────────────────────────────────

let test_block_scope() Void = {
    let mutable i1 = 0
    while i1 < 100000 then {
        let result1 = {
            let mutable v1 = i1
            let r1 * Int = &v1
            *r1 + 1
        }
        let _ = result1
        i1 += 1
    }
}

// ── Test 2: If/else expression scope ──────────────────────────────────────

let test_if_else_scope() Void = {
    let mutable i2 = 0
    while i2 < 100000 then {
        let result2 = if i2 % 2 == 0 then {
            let mutable v2a = i2 * 2
            let r2a * Int = &v2a
            *r2a
        } else {
            let mutable v2b = i2 * 3
            let r2b * Int = &v2b
            *r2b
        }
        let _ = result2
        i2 += 1
    }
}

// ── Test 3: Nested if expressions ─────────────────────────────────────────

let test_nested_if_scope() Void = {
    let mutable i3 = 0
    while i3 < 100000 then {
        let result3 = if i3 % 3 == 0 then {
            let mutable v3a = i3
            let r3a * Int = &v3a
            if *r3a > 50 then {
                let mutable v3b = *r3a * 2
                let r3b * Int = &v3b
                *r3b
            } else {
                *r3a
            }
        } else if i3 % 3 == 1 then {
            let mutable v3c = i3 + 100
            let r3c * Int = &v3c
            *r3c
        } else {
            let mutable v3d = i3 + 200
            let r3d * Int = &v3d
            *r3d
        }
        let _ = result3
        i3 += 1
    }
}

// ── Test 4: While loop with early break ───────────────────────────────────

let test_while_break_scope() Void = {
    let mutable i4 = 0
    while i4 < 100000 then {
        let mutable j4 = 0
        while j4 < 10 then {
            let mutable v4 = i4 + j4
            let r4 * Int = &v4
            if *r4 > 5 then {
                break
            }
            j4 += 1
        }
        i4 += 1
    }
}

// ── Test 5: Nested while loops ────────────────────────────────────────────

let test_nested_while_scope() Void = {
    let mutable i5 = 0
    while i5 < 1000 then {
        let mutable j5 = 0
        while j5 < 100 then {
            let mutable v5 = i5 * 100 + j5
            let r5 * Int = &v5
            j5 += 1
        }
        i5 += 1
    }
}

// ── Test 6: Ref in conditional assignment ─────────────────────────────────

let test_conditional_ref_scope() Void = {
    let mutable i6 = 0
    while i6 < 100000 then {
        let mutable v6 = i6
        let r6 * Int = &v6
        let result6 = if *r6 > 50000 then *r6 * 2 else *r6
        let _ = result6
        i6 += 1
    }
}

// ── Test 7: Ref passed to function ────────────────────────────────────────

let consume_ref_7(r7 * Int) Int = {
    return *r7
}

let test_ref_param_scope() Void = {
    let mutable i7 = 0
    while i7 < 100000 then {
        let mutable v7 = i7
        let r7 * Int = &v7
        let result7 = consume_ref_7(r7)
        let _ = result7
        i7 += 1
    }
}

// ── Test 8: Multiple refs in same scope ───────────────────────────────────

let test_multi_ref_scope() Void = {
    let mutable i8 = 0
    while i8 < 100000 then {
        let mutable v8a = i8
        let r8a * Int = &v8a
        let mutable v8b = i8 + 1
        let r8b * Int = &v8b
        let mutable v8c = i8 + 2
        let r8c * Int = &v8c
        let _ = *r8a + *r8b + *r8c
        i8 += 1
    }
}

// ── Test 9: Ref in loop with continue ────────────────────────────────────

let test_continue_scope() Void = {
    let mutable i9 = 0
    while i9 < 100000 then {
        let mutable v9 = i9
        let r9 * Int = &v9
        if *r9 % 3 == 0 then {
            i9 += 1
            continue
        }
        let _ = *r9
        i9 += 1
    }
}

// ── Test 10: Deeply nested scopes ─────────────────────────────────────────

let test_deep_nesting_scope() Void = {
    let mutable i10 = 0
    while i10 < 100000 then {
        let result10 = {
            let mutable v10a = i10
            let r10a * Int = &v10a
            {
                let mutable v10b = *r10a + 1
                let r10b * Int = &v10b
                {
                    let mutable v10c = *r10b + 2
                    let r10c * Int = &v10c
                    *r10c
                }
            }
        }
        let _ = result10
        i10 += 1
    }
}

// ── Test 11: Ref with arithmetic operations ───────────────────────────────

let test_arithmetic_ref_scope() Void = {
    let mutable i11 = 0
    while i11 < 100000 then {
        let mutable v11 = i11
        let r11 * Int = &v11
        let result11 = *r11 + *r11 * 2 - *r11 / 2
        let _ = result11
        i11 += 1
    }
}

// ── Test 12: Ref comparison ───────────────────────────────────────────────

let test_comparison_ref_scope() Void = {
    let mutable i12 = 0
    while i12 < 100000 then {
        let mutable v12a = i12
        let r12a * Int = &v12a
        let mutable v12b = i12 + 1
        let r12b * Int = &v12b
        let result12 = *r12a < *r12b
        let _ = result12
        i12 += 1
    }
}

// ── Test 13: Tree-like * nesting ────────────────────────────────────────

let test_tree_ref_scope() Void = {
    let mutable i13 = 0
    while i13 < 100000 then {
        let mutable inner13 = i13
        let inner_ref13 * Int = &inner13
        let mutable outer13 = *inner_ref13 * 2
        let outer_ref13 * Int = &outer13
        let _ = *outer_ref13
        i13 += 1
    }
}

// ── Test 14: Ref in boolean expressions ───────────────────────────────────

let test_bool_ref_scope() Void = {
    let mutable i14 = 0
    while i14 < 100000 then {
        let mutable v14a = i14
        let r14a * Int = &v14a
        let mutable v14b = i14 + 1
        let r14b * Int = &v14b
        let result14 = *r14a > 0 and *r14b > 0 or *r14a == 0
        let _ = result14
        i14 += 1
    }
}

// ── Test 15: Ref with negation ────────────────────────────────────────────

let test_negation_ref_scope() Void = {
    let mutable i15 = 0
    while i15 < 100000 then {
        let mutable v15 = i15
        let r15 * Int = &v15
        let result15 = -*r15
        let _ = result15
        i15 += 1
    }
}

// ── Main ──────────────────────────────────────────────────────────────────

let main() Void = {
    test_block_scope()
    test_if_else_scope()
    test_nested_if_scope()
    test_while_break_scope()
    test_nested_while_scope()
    test_conditional_ref_scope()
    test_ref_param_scope()
    test_multi_ref_scope()
    test_continue_scope()
    test_deep_nesting_scope()
    test_arithmetic_ref_scope()
    test_comparison_ref_scope()
    test_tree_ref_scope()
    test_bool_ref_scope()
    test_negation_ref_scope()
}
