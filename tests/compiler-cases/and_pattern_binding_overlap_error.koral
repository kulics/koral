// EXPECT-ERROR: And pattern cannot bind the same variable in both branches: x
// `and` runs both sides, so one name would end up with two different values.

type E {
    A(a Int),
    B(b Int),
};

let f(e E) Int = when e in {
    .A(x) and .B(x) then x,
    _ then 0,
};

let main() Int = {
    return f(E.A(1));
};
