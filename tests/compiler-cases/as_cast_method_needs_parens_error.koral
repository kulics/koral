// EXPECT-ERROR: syntax error
// A cast result takes parens before a method call: `(p as *Int).equals(...)`.

let main() Int = {
    let p = alloc_memory[Int](1);
    init_memory(p, 1);
    let q = alloc_memory[Int](1);
    init_memory(q, 1);
    let ok = p as *Int.equals(q as *Int);
    dealloc_memory(p);
    dealloc_memory(q);
    return 0;
};
