// EXPECT: 7
// A leading `Type(` opens a cast when the head names a numeric type, and an
// ordinary call otherwise. The two shapes this has to tell
// apart: `Int(n)` is a cast, while `helper(m)` and `f(*p)` are calls —
// a bare `*` starts a dereference argument, not a type.

let helper(x: Int): Int = x;

let main(): Int = {
    let n = 7;
    let m = Int(n);
    println(helper(m).to_string());
    return 0;
};
