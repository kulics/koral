// EXPECT-ERROR: Undefined variable: Some
// A capitalized name is no more exempt than any other: `Some` names nothing
// -- the era of first-class enum constructors is gone -- and must say so.
// It used to check clean here and then die as invalid C in the backend
// (`variable has incomplete type 'void'`), while the reference compiler
// correctly reported `Undefined variable: Some` and the differential was
// blind to the gap.

let main(): Void = {
    let z = Some(4);
    println("\(z)");
};
