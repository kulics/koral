// EXPECT-ERROR: Undefined type: internal_generic
//
// §3.3 access levels across the GENERIC template layer: `internal_generic` is
// internal to the root module. A generic call resolves its template through
// the same visibility rule as any other name -- invisible is undeclared, and
// the undeclared-name diagnostic for this spelling is the generic callee's
// "Undefined type", exactly what a typo'd template produces.
using "std" { ... };
using "access_level_cross_module_generic_error/child" { use_generic };

let internal_generic[T: Any](x: T): T = {
    return x;
};

public let main(): Int = {
    use_generic();
    return 0;
};
