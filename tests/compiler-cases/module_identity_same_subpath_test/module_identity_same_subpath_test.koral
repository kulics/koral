// EXPECT: one-marker
// EXPECT: two-marker
// EXPECT: marker-a:3
// EXPECT: marker-b:4

// Two dependencies whose modules sit at the same subpath (util/util.koral in
// both packages) do not collide: module identity is (source, entry position)
// and the sources differ (§5.3.1).

using "depone/util" { marker as marker_one, Marker as MarkerOne };
using "deptwo/util" { marker as marker_two, Marker as MarkerTwo };

let main() Int = {
    println(marker_one());
    println(marker_two());
    let a MarkerOne = MarkerOne(3);
    let b MarkerTwo = MarkerTwo(4);
    println("marker-a:" + a.v.to_string());
    println("marker-b:" + b.v.to_string());
    return 0;
};
