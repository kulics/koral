// EXPECT: inherent
// EXPECT: inherent
// Inherent methods win over trait TOOL methods -- in every declaration order.
// A tool (`given Tag { ... }`) is an ergonomic helper, not a requirement, so
// sharing a name with one is a coexistence: the inherent method owns the slot
// and `x.m()` calls it. (The tool stays reachable through the generic or
// qualified spellings; this pins the receiver form.)

trait Tag {
    value(self): Int;
};

given Tag {
    describe(self): String = "tool:" + self.value().to_string();
};

type Num(x: Int);

given Num: Tag {
    value(self): Int = self.x;
};

given Num {
    describe(self): String = "inherent";
};

type Num2(x: Int);

given Num2 {
    describe(self): String = "inherent";
};

given Num2: Tag {
    value(self): Int = self.x;
};

let main(): Int = {
    println(Num(1).describe());
    println(Num2(2).describe());
    return 0;
};
