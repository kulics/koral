// EXPECT: pow_exact_ok
// EXPECT: pow_boundary_ok
// The guarded square: the accumulator squares only while more exponent bits
// remain, so a power that fits its type no longer trips over the unused final
// square (Int8 2^4 used to panic on 16 * 16 after the result was complete).

using "std/math" { ... };

let main(): Int = {
    if Int8(2).pow(4) == Int8(16) and Int8(5).pow(3) == Int8(125) and Int8(
        2,
    ).pow(0) == Int8(1) and 3.pow(3) == 27 then {
        println("pow_exact_ok");
    };
    if Int(2).pow(32) == 4294967296 and Int(2).pow(10) == 1024 and Int(3).pow(
        3,
    ) == 27 then {
        println("pow_boundary_ok");
    };
    return 0;
};
