// EXPECT: root/leaf

trait ToSegment {
    to_segment(self): String;
};

given String: ToSegment {
    public to_segment(self): String = self;
};

type Pathish(value: String);

given Pathish {
    public join[T: ToSegment](self, other: T): Pathish = {
        return Pathish(self.value + "/" + other.to_segment());
    };
};

let main(): Int = {
    let joined = Pathish("root").join("leaf");
    println(joined.value);
    return 0;
};
