// EXPECT: root/leaf

trait IntoSegment {
    into_segment(self) String;
};

given String as IntoSegment {
    public into_segment(self) String = self;
};

type Pathish(value String);

given Pathish {
    public join[T IntoSegment](self, other T) Pathish = {
        return Pathish(self.value + "/" + other.into_segment());
    };
};

let main() Int = {
    let joined = Pathish("root").join("leaf");
    println(joined.value);
    return 0;
};
