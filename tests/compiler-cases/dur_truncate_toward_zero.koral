// EXPECT: trunc_ok
// EXPECT: trunc_positive_ok
// as_seconds/as_minutes/as_hours truncate toward zero: a negative duration
// with a positive nanosecond remainder rounds up (Duration(-2s, 500ms) is
// -1.5s and yields -1, not the floor -2).

let main(): Int = {
    let d1 = Duration.new(seconds = Int64(-2), nanoseconds = 500_000_000).unwrap();
    assert(d1.as_seconds() == Int64(-1), "-1.5s -> -1");
    assert(d1.as_minutes() == Int64(0), "-1.5s -> 0 min");
    assert(d1.as_hours() == Int64(0), "-1.5s -> 0 h");

    let d2 = Duration.new(seconds = Int64(-60), nanoseconds = 500_000_000).unwrap();
    assert(d2.as_seconds() == Int64(-59), "-59.5s -> -59");
    assert(d2.as_minutes() == Int64(0), "-59.5s -> 0 min");

    let d3 = Duration.new(seconds = Int64(-3600), nanoseconds = 500_000_000).unwrap();
    assert(d3.as_seconds() == Int64(-3599), "-3599.5s -> -3599");
    assert(d3.as_minutes() == Int64(-59), "-3599.5s -> -59 min");
    assert(d3.as_hours() == Int64(0), "-3599.5s -> 0 h");
    println("trunc_ok");

    let d4 = Duration.new(seconds = Int64(2), nanoseconds = 500_000_000).unwrap();
    assert(d4.as_seconds() == Int64(2), "2.5s -> 2");
    assert(d4.as_minutes() == Int64(0), "2.5s -> 0 min");
    let d5 = Duration.new(seconds = Int64(-90), nanoseconds = 0).unwrap();
    assert(d5.as_minutes() == Int64(-1), "-90s -> -1 min");
    assert(d5.as_seconds() == Int64(-90), "-90s -> -90");
    println("trunc_positive_ok");

    return 0;
};
