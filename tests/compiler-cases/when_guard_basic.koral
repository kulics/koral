// EXPECT: when guards ok

// Arm guards: `pat if cond then body`. The pattern's bindings are visible in
// the guard; a false guard falls through to the next arm.

type Option2 {
    Some(value Int),
    None2(),
};

let classify(o Option2) String = when o in {
    .Some(n) if n > 0 then "positive",
    .Some(n) if n < 0 then "negative",
    .Some(n) then "zero",
    .None2() then "none",
};

let main() Int = {
    if classify(.Some(5)) != "positive" then {
        eprintln("FAIL: guard true should take the body");
        return 1;
    };
    if classify(.Some(0 - 3)) != "negative" then {
        eprintln("FAIL: second guard after first guard fell through");
        return 1;
    };
    if classify(.Some(0)) != "zero" then {
        eprintln("FAIL: unguarded arm after guarded arms");
        return 1;
    };
    if classify(.None2()) != "none" then {
        eprintln("FAIL: no-binding arm");
        return 1;
    };
    println("when guards ok");
    return 0;
};
