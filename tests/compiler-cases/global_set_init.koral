// Test: global variable initialization with Set-derived snapshots (the set
// literal needs an explicit type, and a global must hold a sendable type, so
// the globals hold immutable `FrozenSet` snapshots).

private let frozen_tags(): FrozenSet[String] = {
    let source: Set[String] = ["go", "rust", "koral"];
    return source.to_frozen_set();
};
private let frozen_visited(): FrozenSet[Int] = {
    let source: Set[Int] = [1, 2, 3];
    return source.to_frozen_set();
};
private let frozen_visited_next(): FrozenSet[Int] = {
    let source: Set[Int] = [10, 20];
    return source.to_frozen_set();
};

private let tags: FrozenSet[String] = frozen_tags();
private let mutable visited: FrozenSet[Int] = frozen_visited();

public let main(): Void = {
    println(tags.count());
    println(visited.count());
    visited = frozen_visited_next();
    println(visited.count());
};
// EXPECT: 3
// EXPECT: 3
// EXPECT: 2
