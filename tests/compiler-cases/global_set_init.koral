// Test: global variable initialization with Set literal (needs explicit type)

private let tags Set[String] = ["go", "rust", "koral"]
private let mutable visited Set[Int] = [1, 2, 3]

public let main() Void = {
    println(tags.count())
    println(visited.count())
    visited = [10, 20]
    println(visited.count())
}
// EXPECT: 3
// EXPECT: 3
// EXPECT: 2
