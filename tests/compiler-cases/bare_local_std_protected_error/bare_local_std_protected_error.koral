// EXPECT-ERROR: Undefined variable: stdout_write_lock
// Pin the anonymous package identity of bare-file builds (2026-11-13 batch).
// A local module pulled in with `using "./…"` belongs to the same package as
// the entry -- the bare build's anonymous root -- NOT to the std package.
// Before this, bare builds installed std as the root owner: local modules
// were stamped `std:std` and could read std's `protected` members while the
// entry could not.
using "./reader.koral" { read_std_protected };

let main(): Int = {
    return read_std_protected();
};
