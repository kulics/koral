using "std" { ... };
// ============================================================================
// std.sync - channel (Message Passing)
// ============================================================================
// Provides: make_channel, SendChannel, RecvChannel
// Access via: using "std/sync" { ... };
// ============================================================================
// Design: Pure Koral implementation using Mutex + MutexCondvar + List.
// Bounded channel only — forces users to think about capacity (backpressure).
// Capacity 0 is the unbuffered rendezvous channel: a send completes only once
// a receiver has taken its value (per-sender tickets keep the hand-off exact
// under multiple producers).
// Multi-producer multi-consumer: both endpoints share one `type mutable`
// ChannelStorage, and each endpoint's Drop marks its side closed.
// ============================================================================

// ============================================================================
// channel internals — Implemented with Koral primitives, no additional FFI needed
// ============================================================================

// channel internal shared storage
/// Sendable contract: self-synchronized -- the storage mutex/condvars
/// guard the queue; the conditional rule gates the element type.
private type unsafe sendable mutable ChannelStorage[T: Any](
    mutex: Mutex,
    not_empty: MutexCondvar, // notify consumer: new message available
    not_full: MutexCondvar, // notify producer: space available (or hand-off done)
    mutable queue: Deque[T], // message queue
    capacity: Int, // buffer size; 0 = rendezvous
    mutable sent: Int, // values ever pushed (ticket counter)
    mutable received: Int, // values ever taken
    mutable waiting_receivers: Int, // receivers parked on not_empty
    mutable sender_closed: Bool, // all SendChannels have been dropped
    mutable receiver_closed: Bool, // all RecvChannels have been dropped
);

/// The sending half of a bounded channel; dropping it closes the channel for receivers.
public type unsafe sendable mutable SendChannel[T: Any](private channel: ChannelStorage[T]);

/// Implements `Drop`, closing the send side and waking waiting receivers.
given[T: Any] SendChannel[T]: Drop {
    drop(self): Void = {
        let channel = self.channel;
        channel.mutex.lock();
        defer channel.mutex.unlock();
        channel.sender_closed = true;
        channel.not_empty.notify_all();
    };
};

/// The receiving half of a bounded channel; dropping it closes the channel for senders.
public type unsafe sendable mutable RecvChannel[T: Any](private channel: ChannelStorage[T]);

/// Implements `Drop`, closing the receive side and waking waiting senders.
given[T: Any] RecvChannel[T]: Drop {
    drop(self): Void = {
        let channel = self.channel;
        channel.mutex.lock();
        defer channel.mutex.unlock();
        channel.receiver_closed = true;
        channel.not_full.notify_all();
    };
};

/// Sends values, blocking for space or returning without blocking.
given[T: Any] SendChannel[T] {
    /// 发送消息（阻塞，直到有空间或通道关闭）
    /// 容量为 0 的会合通道上，send 阻塞到某个接收方取走该消息才返回。
    public send(self, value: T): Result[Void] = {
        let channel = self.channel;
        channel.mutex.lock();
        defer channel.mutex.unlock();
        if channel.capacity == 0 then {
            // Rendezvous: push first, then wait until a receiver has taken
            // exactly this value (the ticket is its FIFO position).
            let ticket = channel.sent;
            channel.sent = channel.sent + 1;
            channel.queue.push_back(value);
            channel.not_empty.notify();
            while channel.received <= ticket and not channel.receiver_closed then {
                channel.not_full.wait();
            };
            if channel.received <= ticket then {
                // Closed before the hand-off: the value stays queued and is
                // freed with the channel storage.
                return Result[Void].Error("channel closed");
            };
            return Result[Void].Ok({});
        };
        while channel.queue.count() >= channel.capacity and not channel.receiver_closed then {
            channel.not_full.wait();
        };
        if channel.receiver_closed then {
            return Result[Void].Error("channel closed");
        };
        channel.sent = channel.sent + 1;
        channel.queue.push_back(value);
        channel.not_empty.notify();
        return Result[Void].Ok({});
    };

    /// 非阻塞发送
    public try_send(self, value: T): Result[Bool] = {
        let channel = self.channel;
        channel.mutex.lock();
        defer channel.mutex.unlock();
        if channel.receiver_closed then {
            return Result[Bool].Error("channel closed");
        };
        if channel.capacity == 0 then {
            // Rendezvous hand-off is only immediate when a parked receiver is
            // still unmatched by in-flight values.
            if channel.waiting_receivers <= channel.sent - channel.received then {
                return Result[Bool].Ok(false);
            };
            channel.sent = channel.sent + 1;
            channel.queue.push_back(value);
            channel.not_empty.notify();
            return Result[Bool].Ok(true);
        };
        if channel.queue.count() >= channel.capacity then {
            return Result[Bool].Ok(false);
        };
        channel.sent = channel.sent + 1;
        channel.queue.push_back(value);
        channel.not_empty.notify();
        return Result[Bool].Ok(true);
    };
};

/// Receives values, blocking for a message or returning without blocking.
given[T: Any] RecvChannel[T] {
    /// 接收消息（阻塞，直到有消息或通道关闭）
    public recv(self): Result[T] = {
        let channel = self.channel;
        channel.mutex.lock();
        defer channel.mutex.unlock();
        // A Deque keeps the take O(1): the queue is drained one message per
        // recv, and a List's front removal shifts the rest every time.
        let mutable value_opt = channel.queue.pop_front();
        while value_opt is .None() and not channel.sender_closed then {
            channel.waiting_receivers = channel.waiting_receivers + 1;
            channel.not_empty.wait();
            channel.waiting_receivers = channel.waiting_receivers - 1;
            value_opt = channel.queue.pop_front();
        };
        if value_opt is .Some(value) then {
            channel.received = channel.received + 1;
            if channel.capacity == 0 then {
                // Wake every parked sender: the satisfied ticket is not
                // necessarily the one an arbitrary single wake-up would pick.
                channel.not_full.notify_all();
            } else {
                channel.not_full.notify();
            };
            return Result[T].Ok(value);
        };
        return Result[T].Error("channel closed");
    };

    /// 非阻塞接收
    public try_recv(self): Result[Option[T]] = {
        let channel = self.channel;
        channel.mutex.lock();
        defer channel.mutex.unlock();
        let value_opt = channel.queue.pop_front();
        if value_opt is .Some(value) then {
            channel.received = channel.received + 1;
            if channel.capacity == 0 then {
                channel.not_full.notify_all();
            } else {
                channel.not_full.notify();
            };
            return Result[Option[T]].Ok(Option[T].Some(value));
        };
        if channel.sender_closed then {
            return Result[Option[T]].Error("channel closed");
        };
        return Result[Option[T]].Ok(Option[T].None());
    };
};

// ============================================================================
// Channel Factory
// ============================================================================

/// 类型安全的消息传递通道工厂。
/// 返回 (SendChannel, RecvChannel) 对，避免统一 Channel 类型带来的误用。
/// 通道是有界的：队列达到 `capacity` 时 send() 阻塞。
/// capacity 为 0 时是无缓冲的会合通道（rendezvous）：send() 阻塞到某个
/// 接收方取走该消息才返回，用于严格的交接与同步场景。
/// capacity 为负时 panic。
public let make_channel[T: Any](capacity: Int): Pair[SendChannel[T], RecvChannel[T]] = {
    if capacity < 0 then {
        panic("make_channel negative capacity");
    };
    let mu = Mutex.new();
    let not_empty = mu.condvar();
    let not_full = mu.condvar();
    let storage = ChannelStorage[T](
        mu,
        not_empty,
        not_full,
        Deque[T].new(),
        capacity,
        0,
        0,
        0,
        false,
        false,
    );
    let sender = SendChannel[T](storage);
    let receiver = RecvChannel[T](storage);
    return Pair[SendChannel[T], RecvChannel[T]](sender, receiver);
};
