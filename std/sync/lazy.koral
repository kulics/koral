using "std" { ... };
// ============================================================================
// std.sync - Lazy (Thread-Safe Lazy Initialization)
// ============================================================================
// Provides: [T]Lazy (thread-safe lazy initialization with cached result)
// Access via: using "std/sync" { ... };
// ============================================================================
// Design (concurrency-design.md §同步语义五级分层): L4 one-time
// initialization, pure Koral on AtomicInt + Mutex + MutexCondvar, in the same
// shape as the global initializer: the state machine decides who runs the
// initializer, and the initializer itself runs with NO lock held. A `get()`
// from inside the initializer can therefore never deadlock against this
// value's guard -- it either sees the cached result or is refused with a
// diagnostic. `init_owner` is ATOMIC: it names the initializing thread (the
// same-thread self-dependency verdict) and is read by other threads while the
// initializer runs. CROSS-THREAD CYCLES ARE NOT DETECTED: two Lazies whose
// initializers call each other from two threads simply deadlock; only the
// same-thread re-entry is diagnosed.
//
// `T` is `sendable` like `AtomicCell`'s: a `Lazy` exists to PUBLISH a value
// across threads (the lazy-global shape), the initializer is already
// `sendable () -> T`, and the value it publishes is read from any thread that
// calls `get`. A thread-local memo of a non-sendable value is not this type's
// job -- that is a plain `Option` next to the code that computes it.
// ============================================================================

let foreign __koral_thread_current_id(): UInt64;

/// Lazy value states: 0 = uninitialized, 1 = initializing, 2 = done.
private let lazy_state_uninitialized: Int = 0;
private let lazy_state_initializing: Int = 1;
private let lazy_state_done: Int = 2;

/// Thread-safe lazy value whose initializer runs at most once.
/// Sendable contract: self-synchronized -- the state machine runs the
/// initializer at most once; `get` from any thread is safe. `T` is `sendable`
/// (like `AtomicCell[T]`): the cached value is published to every thread that
/// calls `get`.
public type unsafe sendable mutable Lazy[T: sendable](
    private state: AtomicInt,
    private mutex: Mutex,
    private condvar: MutexCondvar,
    private func: sendable () -> T,
    private mutable value: Option[T],
    private init_owner: AtomicUInt,
);

/// Creates the lazy value and reads it once initialized.
given[T: sendable] Lazy[T] {
    /// Wrap `f` so it runs at most once, on the first `get`. The initializer
    /// runs with no lock held (it may call other lazy values, globals and
    /// locks) and runs at most once -- the `Lazy` name carries that shape.
    public new(f: sendable () -> T): Lazy[T] = {
        let mutex = Mutex.new();
        let condvar = mutex.condvar();
        return Lazy[T](
            AtomicInt.new(lazy_state_uninitialized),
            mutex,
            condvar,
            f,
            Option[T].None(),
            AtomicUInt.new(UInt(0)),
        );
    };

    /// Return the value, running and caching the initializer on first use.
    ///
    /// The initializer runs with no lock held, so it may call other lazy
    /// values, globals and locks without lock-ordering deadlocks. It must not
    /// call `get()` on the same `Lazy`: there is no value to return yet, and
    /// that mistake panics with a diagnostic instead of hanging. Other threads
    /// simply wait for the value to be published. CROSS-THREAD CYCLES ARE NOT
    /// DETECTED: two threads whose initializers each wait on the other's
    /// `Lazy` deadlock -- document your initialization order instead.
    public get(self): T = {
        if self.state.load() == lazy_state_done then {
            return self.value.unwrap();
        };
        if self.state.compare_exchange(expected = lazy_state_uninitialized, desired = lazy_state_initializing) then {
            self.init_owner.store(UInt(__koral_thread_current_id()));
            let result = self.func();
            self.value = Option[T].Some(result);
            self.state.store(lazy_state_done);
            self.mutex.lock();
            self.condvar.notify_all();
            self.mutex.unlock();
            return self.value.unwrap();
        };
        // Someone else claimed initialization (or has just finished).
        if self.state.load() == lazy_state_initializing
            and self.init_owner.load() == UInt(__koral_thread_current_id()) then {
            panic("Lazy.get: the initializer called get() on the same Lazy");
        };
        self.mutex.lock();
        while self.state.load() != lazy_state_done then {
            self.condvar.wait();
        };
        self.mutex.unlock();
        return self.value.unwrap();
    };

    /// Check whether the initializer has already run.
    public is_initialized(self): Bool = self.state.load() == lazy_state_done;
};
