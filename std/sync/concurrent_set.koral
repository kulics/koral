using "std" { ... };
// ============================================================================
// std.sync - ConcurrentSet (self-synchronized shared set)
// ============================================================================
// Design (concurrency-design.md §同步语义五级分层): L2 single steps only --
// every operation is one linearizable step under the container's own
// read/write lock; inside the lock the only user code that runs is the
// element's `hash` / `eq` (contract: pure functions). Destructors NEVER run
// inside the lock (五级推论 1): a removed member is extracted under the lock
// and released after the unlock, and `clear` swaps the whole table out and
// drops it unlocked. Storage is SELF-CONTAINED -- its own open-addressing
// table below, no dependency on `Set` / `hash_lookup` (完全解耦, 各自维护);
// frozen snapshots leave through the package-internal `build_frozen_set`.
// ============================================================================

/// A concurrent-set slot: tag word + inline member. struct+tag layout so the
/// member field is addressable by pointer; only Occupied slots carry an
/// initialized member, and the tag is the only word valid on Empty/Deleted
/// slots.
type ConcurrentSetSlot[T: Any](tag: UInt, key: T);

private let set_tag_ptr[T: Any](
    slot_ptr: *mutable ConcurrentSetSlot[T],
): *mutable UInt = slot_ptr as *mutable UInt;

private let set_set_tag[T: Any](
    slot_ptr: *mutable ConcurrentSetSlot[T],
    tag: UInt,
): Void = {
    let tag_ptr = set_tag_ptr(slot_ptr);
    *tag_ptr = tag;
};

/// The tombstone-aware linear probe over this family's own slots: return the
/// slot holding `key`, or the slot an insertion should use (the first
/// tombstone when one was seen, else the first empty slot). `capacity` is a
/// power of two (or 0 for a table with no slots).
// capacity 恒为 2 的幂，故 `& (capacity - 1)` 与 `% capacity` 等价，但省掉整数除法。
private let set_find_slot[T: Hash](
    slots: *mutable ConcurrentSetSlot[T],
    capacity: Int,
    key: T,
): Option[Int] = {
    if capacity == 0 then {
        return Option[Int].None();
    };
    let mask = capacity - 1;
    let h = concurrent_hash_mix(key.hash());
    let mutable idx = Int(h & UInt(mask));
    let mutable first_deleted = Option[Int].None();
    let mutable probes = 0;
    while probes < capacity then {
        let slot_tag = (slots + idx).tag;
        if slot_tag == UInt(0) then {
            when first_deleted in {
                .Some(_) then {
                    return first_deleted;
                },
                .None() then {
                    return Option[Int].Some(idx);
                },
            };
        } else if slot_tag == UInt(2) then {
            when first_deleted in {
                .None() then {
                    first_deleted = Option[Int].Some(idx);
                },
                _ then {},
            };
        } else {
            if (slots + idx).key == key then {
                return Option[Int].Some(idx);
            };
        };
        idx = (idx + 1) & mask;
        probes += 1;
    };
    return first_deleted;
};

/// A shared `sendable` set with atomic per-operation access. Sendable
/// contract: self-synchronized.
public type unsafe sendable mutable ConcurrentSet[T: Hash and sendable](
    private rw_lock: SharedMutex,
    private mutable slots: *mutable ConcurrentSetSlot[T],
    private mutable capacity: Int,
    private mutable size: Int,
    private mutable deleted: Int,
);

/// `Drop` for `ConcurrentSet[T]`: the last handle is gone, so the remaining
/// members die here -- outside every lock.
given[T: Hash and sendable] ConcurrentSet[T]: Drop {

    drop(self): Void = {
        for i in 0..<self.capacity then {
            if (self.slots + i).tag == UInt(1) then {
                deinit_memory(self.slots + i);
            };
        };
        dealloc_memory(self.slots);
    };
};

/// The linearizable operations of a `ConcurrentSet`.
given[T: Hash and sendable] ConcurrentSet[T] {

    /// Create an empty concurrent set.
    public new(): ConcurrentSet[T] =
        ConcurrentSet[T](SharedMutex.new(), null, 0, 0, 0);

    // Grow / rebuild the table. Tombstones carry no member here, so a rebuild
    // frees nothing and no destructor runs (the caller holds the exclusive
    // lock).
    private rehash(self): Void = {
        let old_capacity = self.capacity;
        let old_slots = self.slots;
        // 新容量只由存活条目决定：负载保持 ≤ 0.5（size * 2 < new_cap），空表
        // 首次分配 16 槽；tombstone 主导触发时借此缩回合适容量。
        let mutable new_cap = 16;
        while self.size * 2 >= new_cap then {
            new_cap = new_cap * 2;
        };
        let new_slots = alloc_memory[ConcurrentSetSlot[T]](UInt(new_cap));
        for i in 0..<new_cap then {
            set_set_tag(new_slots + i, UInt(0));
        };
        self.slots = new_slots;
        self.capacity = new_cap;
        self.size = 0;
        self.deleted = 0;
        for i in 0..<old_capacity then {
            if (old_slots + i).tag == UInt(1) then {
                let moved = take_memory(old_slots + i);
                let idx = when set_find_slot(new_slots, new_cap, moved.key) in {
                    .Some(j) then j,
                    .None() then { panic("ConcurrentSet rehash failed"); },
                };
                init_memory(new_slots + idx, moved);
                self.size = self.size + 1;
            };
        };
        dealloc_memory(old_slots);
    };

    // The growth trigger shared by the insert paths.
    private ensure_room(self): Void = {
        if self.size * 2 >= self.capacity or self.deleted * 2 > self.capacity then {
            self.rehash();
        };
    };

    /// The number of members.
    public count(self): Int = {
        self.rw_lock.lock_shared();
        let out = self.size;
        self.rw_lock.unlock_shared();
        return out;
    };

    /// Whether the set has no members.
    public is_empty(self): Bool = {
        self.rw_lock.lock_shared();
        let out = self.size == 0;
        self.rw_lock.unlock_shared();
        return out;
    };

    /// Whether `value` is a member.
    public contains(self, value: T): Bool = {
        self.rw_lock.lock_shared();
        let out = when set_find_slot(self.slots, self.capacity, value) in {
            .Some(idx) then (self.slots + idx).tag == UInt(1),
            .None() then false,
        };
        self.rw_lock.unlock_shared();
        return out;
    };

    /// Add `value` to the set. A discarded duplicate value dies at the
    /// caller's statement end, after the unlock.
    public insert(self, value: T): Void = {
        self.rw_lock.lock();
        self.ensure_room();
        let final_idx = when set_find_slot(self.slots, self.capacity, value) in {
            .Some(i) then i,
            .None() then { panic("ConcurrentSet insert failed"); },
        };
        let slot_ptr = self.slots + final_idx;
        if slot_ptr.tag != UInt(1) then {
            if slot_ptr.tag == UInt(2) then {
                self.deleted = self.deleted - 1;
            };
            self.size = self.size + 1;
            init_memory(slot_ptr, ConcurrentSetSlot[T](UInt(1), value));
        };
        self.rw_lock.unlock();
    };

    /// Add `value` to the set and report whether it was newly added. A
    /// discarded duplicate value dies at the caller's statement end, after
    /// the unlock.
    public try_insert(self, value: T): Bool = {
        self.rw_lock.lock();
        self.ensure_room();
        let final_idx = when set_find_slot(self.slots, self.capacity, value) in {
            .Some(i) then i,
            .None() then { panic("ConcurrentSet try_insert failed"); },
        };
        let slot_ptr = self.slots + final_idx;
        if slot_ptr.tag == UInt(1) then {
            self.rw_lock.unlock();
            return false;
        };
        if slot_ptr.tag == UInt(2) then {
            self.deleted = self.deleted - 1;
        };
        self.size = self.size + 1;
        init_memory(slot_ptr, ConcurrentSetSlot[T](UInt(1), value));
        self.rw_lock.unlock();
        return true;
    };

    /// Remove `value` from the set. The stored member is extracted under the
    /// lock and released after it.
    public remove(self, value: T): Void = {
        self.rw_lock.lock();
        let mutable dead_member = Option[ConcurrentSetSlot[T]].None();
        when set_find_slot(self.slots, self.capacity, value) in {
            .Some(idx) then {
                let slot_ptr = self.slots + idx;
                if slot_ptr.tag == UInt(1) then {
                    dead_member = Option[ConcurrentSetSlot[T]].Some(take_memory(slot_ptr));
                    set_set_tag(slot_ptr, UInt(2));
                    self.size = self.size - 1;
                    self.deleted = self.deleted + 1;
                };
            },
            .None() then {},
        };
        self.rw_lock.unlock();
    };

    /// Remove `value` from the set and report whether it was a member. The
    /// stored member is extracted under the lock and released after it, so a
    /// destructor that calls back sees a free lock.
    public try_remove(self, value: T): Bool = {
        self.rw_lock.lock();
        let mutable existed = false;
        let mutable dead_member = Option[ConcurrentSetSlot[T]].None();
        when set_find_slot(self.slots, self.capacity, value) in {
            .Some(idx) then {
                let slot_ptr = self.slots + idx;
                if slot_ptr.tag == UInt(1) then {
                    existed = true;
                    dead_member = Option[ConcurrentSetSlot[T]].Some(take_memory(slot_ptr));
                    set_set_tag(slot_ptr, UInt(2));
                    self.size = self.size - 1;
                    self.deleted = self.deleted + 1;
                };
            },
            .None() then {},
        };
        self.rw_lock.unlock();
        return existed;
    };

    /// Copy the members into an immutable `FrozenSet[T]` snapshot that can
    /// cross threads. The members are gathered under the shared lock; the
    /// snapshot is built (and the temporary array freed) after the unlock.
    public to_frozen_set(self): FrozenSet[T] = {
        self.rw_lock.lock_shared();
        let len = self.size;
        let keys = alloc_memory[T](UInt(len));
        let mutable j = 0;
        for i in 0..<self.capacity then {
            let slot_ptr = self.slots + i;
            if slot_ptr.tag == UInt(1) then {
                init_memory(keys + j, slot_ptr.key);
                j = j + 1;
            };
        };
        self.rw_lock.unlock_shared();
        return build_frozen_set(keys, len);
    };

    /// Remove every member. The members are released after the unlock -- the
    /// whole old table is dropped outside the lock.
    public clear(self): Void = {
        self.rw_lock.lock();
        let old_slots = self.slots;
        let old_capacity = self.capacity;
        self.slots = null;
        self.capacity = 0;
        self.size = 0;
        self.deleted = 0;
        self.rw_lock.unlock();
        for i in 0..<old_capacity then {
            if (old_slots + i).tag == UInt(1) then {
                deinit_memory(old_slots + i);
            };
        };
        dealloc_memory(old_slots);
    };
};
