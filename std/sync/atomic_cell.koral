using "std" { ... };
// ============================================================================
// std.sync - AtomicCell (Atomic Read-Modify-Write Cell)
// ============================================================================
// Provides: AtomicCell (one shared value with atomic get/set/swap/update_and_get/CAS)
// Access via: using "std/sync" { ... };
// ============================================================================
// Design (concurrency-design.md §同步语义五级分层): pure Koral on Mutex.
// `get` / `set` / `swap` / `compare_exchange` are L2 -- one linearizable step
// per operation; the cell's own mutex covers only the access itself, and the
// only user code that may run inside is `Eq` (a pure function, contract only).
// `update_and_get` is L3 -- an OPTIMISTIC combine: the snapshot/validation/commit
// steps hold the lock, the updater runs with NO lock held and may run more than
// once. Validation is by version; when it fails and the cell's LAST WRITER is
// the updater's own thread, the updater wrote the cell it updates and the loop
// panics instead of retrying forever. Normal contention retries with no
// attempt limit. Old values are always released after the unlock, so a
// destructor never runs inside the critical section.
// ============================================================================

/// One shared `sendable` value with atomic access: every operation is a
/// single linearizable step. `update_and_get` runs a combining lambda
/// optimistically (no lock across the lambda), which is where cross-thread
/// read-modify-write belongs now that `+=` is two non-atomic steps. Sendable
/// contract: self-synchronized.
public type unsafe sendable mutable AtomicCell[T: sendable](
    private mutex: Mutex,
    private mutable value: T,
    private mutable version: UInt64,
    private mutable last_writer: UInt64,
);

/// The cell's linearizable operations: construction, atomic read/write,
/// swap, and the combining `update_and_get`.
given[T: sendable] AtomicCell[T] {
    /// Create a cell holding `initial`.
    public new(initial: T): AtomicCell[T] =
        AtomicCell[T](Mutex.new(), initial, UInt64(0), UInt64(0));

    /// Atomically read the current value.
    public get(self): T = {
        self.mutex.lock();
        let current = self.value;
        self.mutex.unlock();
        return current;
    };

    /// Atomically replace the stored value. The old value is released after
    /// the unlock.
    public set(self, value: T): Void = {
        self.mutex.lock();
        let old = self.value;
        self.value = value;
        self.version = self.version + 1;
        self.last_writer = __koral_thread_current_id();
        self.mutex.unlock();
        let _ = old;
    };

    /// Atomically replace the stored value and return the previous one. The
    /// old value is released after the unlock.
    public swap(self, value: T): T = {
        self.mutex.lock();
        let old = self.value;
        self.value = value;
        self.version = self.version + 1;
        self.last_writer = __koral_thread_current_id();
        self.mutex.unlock();
        return old;
    };

    /// Atomically read-modify-write: apply `f` to the current value, store
    /// the result, and return the NEW value. The whole step is one
    /// linearizable operation -- this is the home of
    /// `counter.update_and_get(n => n + 1)`.
    ///
    /// Optimistic (the same shape as `ConcurrentDict.update_and_get`): `f`
    /// runs with NO lock held, against a snapshot, and may run MORE THAN ONCE
    /// -- the result is committed only when nobody wrote the cell in between,
    /// otherwise the snapshot is taken again and `f` runs again. `f` must not
    /// have side effects outside the cell. Reading the cell inside `f` is
    /// fine; writing the cell it updates invalidates every attempt, and when
    /// the cell's last writer is `f`'s own thread the loop panics with
    /// `AtomicCell.update_and_get: the updater wrote the same cell` instead of
    /// retrying forever. Normal contention retries with no attempt limit and
    /// no guarantee of finishing in a bounded number of steps. The old value
    /// is released after the unlock.
    ///
    /// `f` carries no `sendable` requirement on purpose: it is a transient
    /// combiner that runs and dies on the CALLER's thread (every retry too),
    /// is never stored in shared state, and its result is `T`, already
    /// sendable-constrained. Cross-thread sharing of the closure itself is
    /// caught at the four crossing points (spawn capture, shared field,
    /// global, channel), never here (concurrency-design.md §跨界检查).
    public update_and_get(self, f: (T) -> T): T = {
        while true then {
            self.mutex.lock();
            let old = self.value;
            let seen = self.version;
            self.mutex.unlock();
            let next = f(old);
            self.mutex.lock();
            let committed = self.version == seen;
            if committed then {
                let prev = self.value;
                self.value = next;
                self.version = seen + 1;
                self.last_writer = __koral_thread_current_id();
                self.mutex.unlock();
                let _ = prev;
                return next;
            };
            // Validation is version-based; the last-writer record attributes
            // the failed attempt: a write by `f`'s own thread since the
            // snapshot means `f` wrote the cell it updates.
            let updater_wrote = self.last_writer == __koral_thread_current_id();
            self.mutex.unlock();
            let _ = old;
            if updater_wrote then {
                panic("AtomicCell.update_and_get: the updater wrote the same cell");
            };
        };
        panic("AtomicCell.update_and_get: unreachable");
    };
};

/// Equality-gated operations: `compare_exchange` compares by `Eq` value
/// equality (not pointer identity).
given[T: Eq and sendable] AtomicCell[T] {
    /// Atomically replace the value with `desired` when it currently equals
    /// `expected`; report whether the exchange happened. Equality is `Eq`
    /// value equality, not pointer identity. The old value is released after
    /// the unlock.
    ///
    /// Contract (L2, concurrency-design.md §同步语义五级分层): the `Eq` runs
    /// inside the cell's lock -- that is within the single-step scope -- so
    /// `Eq` must be a pure function: no side effects, no locks, no callbacks.
    /// The contract is documented only, not checked at runtime.
    public compare_exchange(self, expected: T, desired: T): Bool = {
        self.mutex.lock();
        if self.value == expected then {
            let old = self.value;
            self.value = desired;
            self.version = self.version + 1;
            self.last_writer = __koral_thread_current_id();
            self.mutex.unlock();
            let _ = old;
            return true;
        };
        self.mutex.unlock();
        return false;
    };
};
