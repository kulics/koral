using "std" { ... };
// ============================================================================
// std.sync - AtomicCell (Atomic Read-Modify-Write Cell)
// ============================================================================
// Provides: AtomicCell (one shared value with atomic get/set/swap/update_and_get/CAS)
// Access via: using "std/sync" { ... };
// ============================================================================
// Design: pure Koral on Mutex, one linearizable step per operation. Reads and
// writes hold the cell's own mutex only for the access itself; `update_and_get`
// is OPTIMISTIC -- it snapshots under the lock, runs the updater with no lock
// held, then commits only if the cell is unchanged, otherwise it retries. The
// updater therefore cannot deadlock against the cell (it holds nothing) and
// the old value is always released after the unlock, so a destructor never
// runs inside the critical section.
// ============================================================================

/// Optimistic attempt ceiling for `update_and_get`: an updater that modifies
/// the cell it updates changes the version on every attempt and would retry
/// forever, so the loop gives up with a diagnostic instead of hanging.
private let atomic_update_max_attempts: Int = 100000;

/// One shared `sendable` value with atomic access: every operation is a
/// single linearizable step. `update_and_get` runs a combining lambda
/// optimistically (no lock across the lambda), which is where cross-thread
/// read-modify-write belongs now that `+=` is two non-atomic steps. Sendable
/// contract: self-synchronized.
public type unsafe sendable mutable AtomicCell[T: sendable](
    private mutex: Mutex,
    private mutable value: T,
    private mutable version: UInt64,
);

/// The cell's linearizable operations: construction, atomic read/write,
/// swap, and the combining `update_and_get`.
given[T: sendable] AtomicCell[T] {
    /// Create a cell holding `initial`.
    public new(initial: T): AtomicCell[T] =
        AtomicCell[T](Mutex.new(), initial, UInt64(0));

    /// Atomically read the current value.
    public get(self): T = {
        self.mutex.lock();
        let current = self.value;
        self.mutex.unlock();
        return current;
    };

    /// Atomically replace the stored value. The old value is released after
    /// the unlock.
    public set(self, value: T): Void = {
        self.mutex.lock();
        let old = self.value;
        self.value = value;
        self.version = self.version + 1;
        self.mutex.unlock();
        let _ = old;
    };

    /// Atomically replace the stored value and return the previous one. The
    /// old value is released after the unlock.
    public swap(self, value: T): T = {
        self.mutex.lock();
        let old = self.value;
        self.value = value;
        self.version = self.version + 1;
        self.mutex.unlock();
        return old;
    };

    /// Atomically read-modify-write: apply `f` to the current value, store
    /// the result, and return the NEW value. The whole step is one
    /// linearizable operation -- this is the home of
    /// `counter.update_and_get(n => n + 1)`.
    ///
    /// Optimistic: `f` runs with NO lock held, against a snapshot. The result
    /// is committed only when nobody else wrote in between; otherwise the
    /// snapshot is taken again and `f` runs again. `f` may therefore run more
    /// than once and must not have side effects outside the cell. `f` must not
    /// write the cell it updates -- every attempt would be invalidated and the
    /// loop would give up with a panic instead of spinning forever. Reading the
    /// cell inside `f` is fine.
    public update_and_get(self, f: (T) -> T): T = {
        let mutable attempts = 0;
        while true then {
            self.mutex.lock();
            let old = self.value;
            let seen = self.version;
            self.mutex.unlock();
            let next = f(old);
            self.mutex.lock();
            let committed = self.version == seen;
            if committed then {
                let prev = self.value;
                self.value = next;
                self.version = seen + 1;
                self.mutex.unlock();
                let _ = prev;
                return next;
            };
            self.mutex.unlock();
            let _ = old;
            attempts = attempts + 1;
            if attempts >= atomic_update_max_attempts then {
                panic("AtomicCell.update_and_get: too many retries -- the updater must not modify the same cell");
            };
        };
        panic("AtomicCell.update_and_get: unreachable");
    };
};

/// Equality-gated operations: `compare_exchange` compares by `Eq` value
/// equality (not pointer identity).
given[T: Eq and sendable] AtomicCell[T] {
    /// Atomically replace the value with `desired` when it currently equals
    /// `expected`; report whether the exchange happened. Equality is `Eq`
    /// value equality, not pointer identity. The old value is released after
    /// the unlock.
    public compare_exchange(self, expected: T, desired: T): Bool = {
        self.mutex.lock();
        if self.value == expected then {
            let old = self.value;
            self.value = desired;
            self.version = self.version + 1;
            self.mutex.unlock();
            let _ = old;
            return true;
        };
        self.mutex.unlock();
        return false;
    };
};
