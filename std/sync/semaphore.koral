using "std" { ... };
// ============================================================================
// std.sync - Semaphore (Counting Semaphore)
// ============================================================================
// Provides: Semaphore (counting semaphore for resource access control)
// Access via: using "std/sync" { ... };
// ============================================================================
// Design: Pure Koral implementation using Mutex + MutexCondvar.
// Controls the number of threads that can simultaneously access a shared
// resource. acquire() blocks until a permit is available, release() returns
// a permit and wakes one waiting thread.
// ============================================================================

/// Classic counting semaphore: `acquire` decrements the permit count (blocking
/// at zero) and `release` increments it unconditionally, exactly as in the
/// Dijkstra P/V discipline. The count is not capped, so releases may outnumber
/// acquires — that is a legitimate way to pre-load wake-ups for later waits.
public type unsafe sendable mutable Semaphore(
    private mutex: Mutex,
    private condvar: MutexCondvar,
    private mutable permits: Int,
);

/// Creates the semaphore and takes and returns permits.
given Semaphore {

    /// Create a semaphore with `permits` permits available. Panics when `permits` is negative.
    public new(permits: Int): Semaphore = {
        if permits < 0 then {
            panic("Semaphore new negative permits");
        };
        let mu = Mutex.new();
        let cv = mu.condvar();
        return Semaphore(mu, cv, permits);
    };

    /// Take a permit, blocking until one is available.
    public acquire(self): Void = {
        self.mutex.lock();
        defer self.mutex.unlock();
        while self.permits == 0 then {
            self.condvar.wait();
        };
        self.permits = self.permits - 1;
    };

    /// Take a permit only if one is immediately available.
    public try_acquire(self): Bool = {
        self.mutex.lock();
        defer self.mutex.unlock();
        if self.permits > 0 then {
            self.permits = self.permits - 1;
            return true;
        };
        return false;
    };

    /// Return a permit and wake one waiting thread.
    /// Unconditional: the permit count grows even past what `acquire` has taken,
    /// so `release` never fails and never panics.
    public release(self): Void = {
        self.mutex.lock();
        defer self.mutex.unlock();
        self.permits = self.permits + 1;
        self.condvar.notify();
    };
};
