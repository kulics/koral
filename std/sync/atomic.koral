using "std" { ... };
// ============================================================================
// std.sync - AtomicBool, AtomicInt, AtomicUInt (Atomic Operations)
// ============================================================================
// Provides: AtomicBool (atomic boolean), AtomicInt (atomic signed integer),
//           AtomicUInt (atomic unsigned integer)
// Access via: using "std/sync" { ... };
// ============================================================================
// Design: Three atomic types for lock-free concurrent programming.
// - AtomicBool: uses Int32 atomics underneath (0/1 for false/true)
// - AtomicInt: uses intptr_t atomics (platform-width signed integer)
// - AtomicUInt: uses uintptr_t atomics (platform-width unsigned integer)
// All operations use sequential consistency (seq_cst) memory ordering.
// ============================================================================

// ============================================================================
// FFI Declarations
// ============================================================================
let foreign __koral_atomic_load_i32(p: *Int32): Int32;
let foreign __koral_atomic_store_i32(p: *Int32, value: Int32): Void;
let foreign __koral_atomic_swap_i32(p: *Int32, value: Int32): Int32;
let foreign __koral_atomic_cas_i32(
    p: *Int32,
    expected: Int32,
    desired: Int32,
): Int32;

let foreign __koral_atomic_load_iptr(p: *Int): Int;
let foreign __koral_atomic_store_iptr(p: *Int, value: Int): Void;
let foreign __koral_atomic_swap_iptr(p: *Int, value: Int): Int;
let foreign __koral_atomic_cas_iptr(p: *Int, expected: Int, desired: Int): Int32;
let foreign __koral_atomic_fetch_add_iptr(p: *Int, delta: Int): Int;
let foreign __koral_atomic_fetch_sub_iptr(p: *Int, delta: Int): Int;

let foreign __koral_atomic_load_uptr(p: *UInt): UInt;
let foreign __koral_atomic_store_uptr(p: *UInt, value: UInt): Void;
let foreign __koral_atomic_swap_uptr(p: *UInt, value: UInt): UInt;
let foreign __koral_atomic_cas_uptr(p: *UInt, expected: UInt, desired: UInt): Int32;
let foreign __koral_atomic_fetch_add_uptr(p: *UInt, delta: UInt): UInt;
let foreign __koral_atomic_fetch_sub_uptr(p: *UInt, delta: UInt): UInt;

/// 原子布尔，用于标志位和开关
/// 所有操作使用顺序一致性内存序
public type mutable AtomicBool(private mutable value: Int32);

/// Creates the flag and provides lock-free atomic updates.
given AtomicBool {

    /// Create an atomic flag holding `value`.
    public new(value: Bool): AtomicBool = AtomicBool(if value then 1 else 0);

    /// Atomically read the current value.
    public load(self): Bool = __koral_atomic_load_i32(&self.value) != 0;

    /// Atomically set the stored value.
    public store(self, value: Bool): Void = {
        __koral_atomic_store_i32(&self.value, if value then 1 else 0);
    };

    /// Atomically replace the value and return the previous one.
    public swap(self, value: Bool): Bool =
        __koral_atomic_swap_i32(&self.value, if value then 1 else 0) != 0;

    /// Atomically store `desired` when the value equals `expected`, returning whether the swap happened.
    public compare_exchange(self, expected: Bool =, desired: Bool =): Bool = {
        return __koral_atomic_cas_i32(
            &self.value,
            if expected then 1 else 0,
            if desired then 1 else 0,
        ) == 1;
    };
};

/// Implements `ToString`, rendering the flag as `true` or `false`.
given AtomicBool: ToString {

    /// Return the current flag as `true` or `false`.
    public to_string(self): String = self.load().to_string();
};

/// 原子有符号整数（Int，平台相关宽度），支持无锁的原子读写和 CAS 操作
/// 所有操作使用顺序一致性内存序
public type mutable AtomicInt(private mutable value: Int);

/// Creates the counter and provides lock-free atomic updates and arithmetic.
given AtomicInt {

    /// Create an atomic integer holding `value`.
    public new(value: Int): AtomicInt = AtomicInt(value);

    /// Atomically read the current value.
    public load(self): Int = __koral_atomic_load_iptr(&self.value);

    /// Atomically set the stored value.
    public store(self, value: Int): Void = {
        __koral_atomic_store_iptr(&self.value, value);
    };

    /// Atomically replace the value and return the previous one.
    public swap(self, value: Int): Int = __koral_atomic_swap_iptr(&self.value, value);

    /// Atomically store `desired` when the value equals `expected`, returning whether the swap happened.
    public compare_exchange(self, expected: Int =, desired: Int =): Bool =
        __koral_atomic_cas_iptr(&self.value, expected, desired) == 1;

    /// Atomically add `delta` and return the previous value.
    public fetch_add(self, delta: Int): Int =
        __koral_atomic_fetch_add_iptr(&self.value, delta);

    /// Atomically subtract `delta` and return the previous value.
    public fetch_sub(self, delta: Int): Int =
        __koral_atomic_fetch_sub_iptr(&self.value, delta);
};

/// Implements `ToString`, rendering the current value in decimal.
given AtomicInt: ToString {

    /// Return the current value as a decimal string.
    public to_string(self): String = self.load().to_string();
};

/// 原子无符号整数（UInt，平台相关宽度），支持无锁的原子读写和 CAS 操作
/// 所有操作使用顺序一致性内存序
public type mutable AtomicUInt(private mutable value: UInt);

/// Creates the counter and provides lock-free atomic updates and arithmetic.
given AtomicUInt {

    /// Create an atomic integer holding `value`.
    public new(value: UInt): AtomicUInt = AtomicUInt(value);

    /// Atomically read the current value.
    public load(self): UInt = __koral_atomic_load_uptr(&self.value);

    /// Atomically set the stored value.
    public store(self, value: UInt): Void = {
        __koral_atomic_store_uptr(&self.value, value);
    };

    /// Atomically replace the value and return the previous one.
    public swap(self, value: UInt): UInt = __koral_atomic_swap_uptr(&self.value, value);

    /// Atomically store `desired` when the value equals `expected`, returning whether the swap happened.
    public compare_exchange(self, expected: UInt =, desired: UInt =): Bool =
        __koral_atomic_cas_uptr(&self.value, expected, desired) == 1;

    /// Atomically add `delta` and return the previous value.
    public fetch_add(self, delta: UInt): UInt =
        __koral_atomic_fetch_add_uptr(&self.value, delta);

    /// Atomically subtract `delta` and return the previous value.
    public fetch_sub(self, delta: UInt): UInt =
        __koral_atomic_fetch_sub_uptr(&self.value, delta);
};

/// Implements `ToString`, rendering the current value in decimal.
given AtomicUInt: ToString {

    /// Return the current value as a decimal string.
    public to_string(self): String = self.load().to_string();
};
