using "std" { ... };
// ============================================================================
// std.os - OpenMode, FileStorage, File Types
// ============================================================================
// Provides: OpenMode enum, FileStorage internal type, File type
// Access via: using "std/os" { ... };
// ============================================================================

using "std/io" { Reader, Writer, Seeker, SeekOrigin };

// ============================================================================
// FFI Declarations (forward declaration for drop semantics)
// ============================================================================

/// Close a file descriptor (POSIX close wrapper)
let foreign __koral_close(fd: Int32): Int32;

/// Read from a file descriptor (POSIX read wrapper, unbuffered)
let foreign __koral_read(fd: Int32, buf: *UInt8, count: UInt): Int64;

/// Write to a file descriptor (POSIX write wrapper, unbuffered)
let foreign __koral_write(fd: Int32, buf: *UInt8, count: UInt): Int64;

/// Sync file data to disk (POSIX fsync wrapper)
let foreign __koral_fsync(fd: Int32): Int32;

/// Seek within a file (POSIX lseek wrapper)
let foreign __koral_lseek(fd: Int32, offset: Int64, whence: Int32): Int64;

/// File locking (cross-platform flock/LockFileEx wrapper)
/// operation: 1=LOCK_SH, 2=LOCK_EX, 4=LOCK_NB (combinable), 8=LOCK_UN
let foreign __koral_flock(fd: Int32, operation: Int32): Int32;

/// Check if current errno is EWOULDBLOCK (cross-platform)
/// Returns non-zero if errno is EWOULDBLOCK
let foreign __koral_errno_is_wouldblock(): Int32;

// ============================================================================
// OpenMode Enum
// ============================================================================

/// File open mode enumeration
public type sendable OpenMode {
    Read(), // O_RDONLY — read-only
    Write(), // O_WRONLY | O_CREAT | O_TRUNC — write-only (overwrite/create)
    Create(), // O_WRONLY | O_CREAT | O_EXCL — create new file (fails if exists)
    Append(), // O_WRONLY | O_CREAT | O_APPEND — append
    ReadWrite(), // O_RDWR — read-write (file must exist)
};

// ============================================================================
// FileStorage Type (internal)
// ============================================================================

/// Internal file storage holding the file descriptor and path.
/// Responsible for closing the fd via drop when the last reference is released.
type unsafe sendable mutable FileStorage(fd: Int32, path: Path);

given FileStorage: Drop {

    /// Automatically close the file descriptor when FileStorage is dropped.
    /// Only closes when fd >= 0 (valid file descriptor).
    drop(self): Void = {
        if self.fd >= 0 then {
            __koral_close(self.fd);
        };
    };
};

// ============================================================================
// FFI Declarations for File metadata queries
// ============================================================================

/// Query file metadata via file descriptor (fstat wrapper)
let foreign __koral_fstat(fd: Int32, out: *KoralStatResult): Int32;

// ============================================================================
// Helpers
// ============================================================================

// ============================================================================
// File Type
// ============================================================================

/// File handle type — a shared handle over one OS file descriptor.
/// Internally holds a FileStorage, shared via reference counting.
/// The file descriptor is automatically closed when the last reference is released.
/// Unbuffered design: directly wraps the file descriptor (fd).
/// For buffered I/O, wrap with std.io BufReader/BufWriter.
/// Sendable contract: TRANSFER, not SHARE -- a `File` may cross threads by
/// handoff; concurrent use of one `File` must be externally synchronized (the
/// seek cursor is shared state).
public type unsafe sendable mutable File(storage: FileStorage);

/// Handle accessors, metadata queries, syncing, and whole-file advisory locking.
given File {

    /// Returns the underlying OS file descriptor.
    /// This is a low-level operation for interop with OS APIs and cross-module fd sharing.
    public fd(self): Int = Int(self.storage.fd);

    /// Get the file path (returns the normalized path from when the file was opened).
    /// Does not resolve symlinks or relative paths; use canonicalize_path for that.
    public path(self): Path = self.storage.path;

    /// Get file metadata by querying via the file descriptor (no path needed).
    public info(self): Result[FileInfo] = {
        let mutable stat_buf = KoralStatResult(0, 0, 0, 0, 0, 0, 0, 0, 0);
        let result = __koral_fstat(self.storage.fd, &stat_buf);
        if result != 0 then {
            return Result[FileInfo].Error(last_error_message());
        };
        let ft = when stat_buf.file_type in {
            0 then FileType.RegularFile(),
            1 then FileType.Directory(),
            2 then FileType.Symlink(),
            _ then FileType.Other(),
        };
        return Result[FileInfo].Ok(
            FileInfo(
                Int(stat_buf.size),
                ft,
                Permission.from_mode(stat_buf.permissions),
                Duration(stat_buf.modified_secs, stat_buf.modified_nanos),
                Duration(stat_buf.accessed_secs, stat_buf.accessed_nanos),
                Duration(stat_buf.created_secs, stat_buf.created_nanos),
            ),
        );
    };

    /// Sync file data to disk (fsync, ensures physical persistence).
    public sync(self): Result[Void] = {
        let result = __koral_fsync(self.storage.fd);
        if result != 0 then {
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };

    // ---- File locking operations ----
    // Based on flock(2) (Unix) / LockFileEx (Windows), whole-file advisory lock

    /// Acquire an exclusive lock (blocking, waits until acquired)
    public lock(self): Result[Void] = {
        let result = __koral_flock(self.storage.fd, 2); // LOCK_EX
        if result != 0 then {
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };

    /// Acquire a shared lock (blocking, waits until acquired)
    public lock_shared(self): Result[Void] = {
        let result = __koral_flock(self.storage.fd, 1); // LOCK_SH
        if result != 0 then {
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };

    /// Try to acquire an exclusive lock (non-blocking)
    /// Returns Ok(true) if acquired, Ok(false) if lock is held (EWOULDBLOCK), Error for system errors
    public try_lock(self): Result[Bool] = {
        let result = __koral_flock(self.storage.fd, 6); // LOCK_EX | LOCK_NB
        if result == 0 then {
            return Result[Bool].Ok(true);
        };
        if __koral_errno_is_wouldblock() != 0 then {
            return Result[Bool].Ok(false);
        };
        return Result[Bool].Error(last_error_message());
    };

    /// Try to acquire a shared lock (non-blocking)
    /// Returns Ok(true) if acquired, Ok(false) if lock is held (EWOULDBLOCK), Error for system errors
    public try_lock_shared(self): Result[Bool] = {
        let result = __koral_flock(self.storage.fd, 5); // LOCK_SH | LOCK_NB
        if result == 0 then {
            return Result[Bool].Ok(true);
        };
        if __koral_errno_is_wouldblock() != 0 then {
            return Result[Bool].Ok(false);
        };
        return Result[Bool].Error(last_error_message());
    };

    /// Release the lock
    public unlock(self): Result[Void] = {
        let result = __koral_flock(self.storage.fd, 8); // LOCK_UN
        if result != 0 then {
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };
};

/// Reader conformance reading directly from the file descriptor.
given File: Reader {

    /// Read bytes into the target list over the given span and return how many were read.
    /// Unbuffered: each call hits the file descriptor and errors surface immediately.
    public read(self, into: List[UInt8] =, span: Range[Int] =): Result[Int] = {
        let span = into.slice_spec(span);
        let start = span.start();
        let end = span.end();
        if end <= start then {
            return Result[Int].Ok(0);
        };
        let data_ptr = into.borrow_mut_ptr() + start;
        let n = __koral_read(self.storage.fd, data_ptr, UInt(span.len()));
        if n < 0 then {
            return Result[Int].Error(last_error_message());
        };
        return Result[Int].Ok(Int(n));
    };
};

/// Writer conformance writing directly to the file descriptor.
given File: Writer {

    /// Write bytes from the source list over the given span and return how many were written.
    /// Unbuffered: each call hits the file descriptor and errors surface immediately.
    public write(self, from: List[UInt8] =, span: Range[Int] =): Result[Int] = {
        let span = from.slice_spec(span);
        let start = span.start();
        let end = span.end();
        if end <= start then {
            return Result[Int].Ok(0);
        };
        let data_ptr = from.borrow_ptr() + start;
        let n = __koral_write(self.storage.fd, data_ptr, UInt(span.len()));
        if n < 0 then {
            return Result[Int].Error(last_error_message());
        };
        return Result[Int].Ok(Int(n));
    };

    /// flush is a no-op on unbuffered File (data is already in kernel buffer).
    public flush(self): Result[Void] = Result[Void].Ok({});
};

/// Seeker conformance repositioning the file offset.
given File: Seeker {

    /// Reposition the file offset from the given origin and return the new absolute offset.
    public seek(self, pos: SeekOrigin): Result[Int] = {
        let mutable offset: Int64 = 0;
        let mutable whence: Int32 = 0;
        when pos in {
            .Start(o) then {
                offset = Int64(o);
                whence = 0;
            },
            .Current(o) then {
                offset = Int64(o);
                whence = 1;
            },
            .End(o) then {
                offset = Int64(o);
                whence = 2;
            },
        };
        let new_pos = __koral_lseek(self.storage.fd, offset, whence);
        if new_pos < 0 then {
            return Result[Int].Error(last_error_message());
        };
        return Result[Int].Ok(Int(new_pos));
    };
};
