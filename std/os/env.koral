using "std" { ... };
// ============================================================================
// std.os - Environment Variable Operations
// ============================================================================
// 读族四象限（命名即转换策略）：
//   env / env_all        —— 文本严格族：非 UTF-8 值在单查里视同不可用
//                           （None），在全列里直接 panic（`std::env::vars`
//                           同款：名单叫 all 就要给全，不静默丢）；
//   env_raw / env_all_raw —— 字节保真族（raw = 零转换零解析）：值/条目原样
//                           进出，全列形是 NAME=VALUE 的 envp 原形条目。
// 写族：set_env / remove_env（String 形）。
// Provides: env, env_raw, set_env, remove_env, env_all, env_all_raw,
//           home_dir, temp_dir, current_dir, set_current_dir, hostname,
//           current_exe
// Access via: using "std/os" { ... };
// ============================================================================

// ============================================================================
// FFI Declarations
// ============================================================================

// Environment variable operations
let unsafe foreign __koral_getenv(name: *UInt8): *UInt8;
let unsafe foreign __koral_setenv(name: *UInt8, value: *UInt8): Int32;
let unsafe foreign __koral_unsetenv(name: *UInt8): Int32;
let unsafe foreign __koral_environ(): **UInt8;
let foreign __koral_environ_count(): UInt;

// Directory operations
let unsafe foreign __koral_getcwd(buf: *UInt8, size: UInt): *UInt8;
let unsafe foreign __koral_chdir(path: *UInt8): Int32;

// System info
let unsafe foreign __koral_hostname(buf: *UInt8, size: UInt): Int32;
let unsafe foreign __koral_current_exe(buf: *UInt8, size: UInt): Int32;

// ============================================================================
// Helpers
// ============================================================================

// ============================================================================
// Environment Variable Operations
// ============================================================================

/// Get environment variable by name (renamed from get_env).
/// 文本严格族：值不是合法 UTF-8 时视同不可用返回 `None`（与缺席混同）；
/// 要字节保真走 `env_raw`。
public let env(name: String): Option[String] = {
    let name_cs = when CString.from_string(name) in {
        .Ok(cs) then cs,
        .Error(_) then return .None(),
    };
    let value = unsafe { __koral_getenv(name_cs.borrow_ptr()) };
    if value == null then {
        return .None();
    };
    return when unsafe { String.from_cstring_ptr(value) } in {
        .Ok(v) then .Some(v),
        .Error(_) then .None(),
    };
};

/// Get the environment variable's value as raw bytes.
/// 字节保真族（raw = 零转换）：`CString` 不声称 UTF-8，值原样进出。
public let env_raw(name: String): Option[CString] = {
    let name_cs = when CString.from_string(name) in {
        .Ok(cs) then cs,
        .Error(_) then return .None(),
    };
    let value = unsafe { __koral_getenv(name_cs.borrow_ptr()) };
    if value == null then {
        return .None();
    };
    return Option[CString].Some(unsafe { CString.from_cstring_ptr_unchecked(value) });
};

/// Set environment variable (returns Result instead of Void)
public let set_env(name: String, value: String): Result[Void] = {
    let name_cs = CString.from_string(name) or return;
    let value_cs = CString.from_string(value) or return;
    let result = unsafe { __koral_setenv(name_cs.borrow_ptr(), value_cs.borrow_ptr()) };
    if result != 0 then {
        return .Error(last_error_message());
    };
    return .Ok({});
};

/// Remove (unset) an environment variable
public let remove_env(name: String): Result[Void] = {
    let name_cs = CString.from_string(name) or return;
    let result = unsafe { __koral_unsetenv(name_cs.borrow_ptr()) };
    if result != 0 then {
        return .Error(last_error_message());
    };
    return .Ok({});
};

/// List all environment entries as raw `NAME=VALUE` byte strings.
/// 字节保真族（raw = 零转换零解析）：条目是 envp 原形，连 `=` 都不拆——
/// 非 UTF-8 条目原样保留。`Command` 的子环境合并在字节层走这里。
public let env_all_raw(): FrozenList[CString] = {
    let mutable result: List[CString] = [];
    let envp = unsafe { __koral_environ() };
    if envp == null then {
        return result.into_frozen_list();
    };
    let count = Int(__koral_environ_count());
    for i in 0..<count then {
        let entry_ptr = unsafe { envp[i] };
        if entry_ptr != null then {
            result.push(unsafe { CString.from_cstring_ptr_unchecked(entry_ptr) });
        };
    };
    return result.into_frozen_list();
};

/// List all environment variables as key-value pairs.
/// 文本严格族：条目的键或值不是合法 UTF-8 时直接 panic（`std::env::vars`
/// 同款——名单叫 all 就要给全，不静默丢条目）；要保真走 `env_all_raw`。
public let env_all(): FrozenList[Pair[String, String]] = {
    let mutable result: List[Pair[String, String]] = [];
    let envp = unsafe { __koral_environ() };
    if envp == null then {
        return result.into_frozen_list();
    };
    let count = Int(__koral_environ_count());
    for i in 0..<count then {
        let entry_ptr = unsafe { envp[i] };
        if entry_ptr != null then {
            let entry = when unsafe { String.from_cstring_ptr(entry_ptr) } in {
                .Ok(e) then e,
                .Error(_) then {
                    // 报错带（lossy 的）名字段，不泄值。
                    let shown = unsafe { String.from_cstring_ptr_lossy(entry_ptr) };
                    let key = when shown.find("=") in {
                        .Some(idx) then shown.substring(0..<idx),
                        .None() then shown,
                    };
                    panic("env_all: environment entry is not valid UTF-8: " + key);
                },
            };
            when entry.find("=") in {
                .Some(idx) then {
                    let key = entry.substring(0..<idx);
                    let value = entry.substring((idx + 1)...);
                    result.push(Pair[String, String](key, value));
                },
                .None() then {},
            };
        };
    };
    return result.into_frozen_list();
};

private let home_dir_from_drive_path(): Option[Path] = when env("HOMEDRIVE") in {
    .Some(drive) then when env("HOMEPATH") in {
        .Some(path) then .Some((drive + path).to_path()),
        .None() then .None(),
    },
    .None() then .None(),
};

// ============================================================================
// Directory / Path Queries
// ============================================================================

/// Get home directory
public let home_dir(): Option[Path] = {
    when env("HOME") in {
        .Some(v) then {
            return .Some(v.to_path());
        },
        .None() then when env("USERPROFILE") in {
            .Some(v) then {
                return .Some(v.to_path());
            },
            .None() then {
                return home_dir_from_drive_path();
            },
        },
    };
};

/// Get temp directory
///
/// When no temp environment variable is set (stripped environments such as
/// `env -i`), the fallback is platform-specific: "/tmp" on POSIX and the
/// Windows directory's Temp folder on Windows.
public let temp_dir(): Path = {
    let fallback = if is_windows_host() then "C:/Windows/Temp" else "/tmp";
    return when env("TMPDIR") in {
        .Some(dir) then dir.to_path(),
        .None() then when env("TEMP") in {
            .Some(dir) then dir.to_path(),
            .None() then when env("TMP") in {
                .Some(dir) then dir.to_path(),
                .None() then fallback.to_path(),
            },
        },
    };
};

/// Get current working directory
///
/// Returned in the canonical `/` form; the OS reports the platform spelling.
public let current_dir(): Result[Path] = {
    let buf = unsafe { alloc_memory[UInt8](4096) };
    defer unsafe { dealloc_memory(buf) };
    let result = unsafe { __koral_getcwd(buf, 4096) };
    if result == null then {
        return .Error(last_error_message());
    };

    return when unsafe { String.from_cstring_ptr(buf) } in {
        .Ok(path) then .Ok(path.to_path().normalize()),
        .Error(e) then .Error(e),
    };
};

/// Change current working directory
public let set_current_dir[T: ToPath](path: T): Result[Void] = {
    let cs = CString.from_string(path.to_path().to_string()) or return;
    let result = unsafe { __koral_chdir(cs.borrow_ptr()) };
    if result != 0 then {
        return .Error(last_error_message());
    };
    return .Ok({});
};

// ============================================================================
// System Info
// ============================================================================

/// Get the system hostname
public let hostname(): Result[String] = {
    let buf = unsafe { alloc_memory[UInt8](256) };
    defer unsafe { dealloc_memory(buf) };
    let result = unsafe { __koral_hostname(buf, 256) };
    if result != 0 then {
        return .Error(last_error_message());
    };
    return when unsafe { String.from_cstring_ptr(buf) } in {
        .Ok(name) then .Ok(name),
        .Error(e) then .Error(e),
    };
};

/// Get the path of the current executable
///
/// Returned in the canonical `/` form.
public let current_exe(): Result[Path] = {
    let buf = unsafe { alloc_memory[UInt8](4096) };
    defer unsafe { dealloc_memory(buf) };
    let result = unsafe { __koral_current_exe(buf, 4096) };
    if result != 0 then {
        return .Error(last_error_message());
    };
    return when unsafe { String.from_cstring_ptr(buf) } in {
        .Ok(path) then .Ok(path.to_path().normalize()),
        .Error(e) then .Error(e),
    };
};
