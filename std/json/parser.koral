using "std" { ... };
// ============================================================================
// std.json - JSON Parser (Deserialization)
// ============================================================================
// Recursive descent parser for JSON (RFC 8259).
// Implements the Parseable trait for JsonValue.
// Internal JsonParser type is not public.
// ============================================================================

using "std/text" { Parseable };

// ============================================================================
// Internal Parser State
// ============================================================================
/// Parse a JSON integer token (the grammar scan already validated its
/// shape) into the exact case its magnitude fits -- `Int` up to 2^63-1,
/// `UInt` up to 2^64-1 -- or `None` past both, where the caller falls back
/// to `Float64`. Decimal digits accumulate exactly; the 20-digit ceiling
/// is settled by a lexicographic compare against the `UInt` maximum before
/// any arithmetic runs (same length strings of digits order numerically).
private let parse_json_integer_literal(literal: String): Option[JsonValue] = {
    let negative = literal.count() > UInt(0) and literal[UInt(0)] == '-';
    let digit_text = if negative then literal.substring(1...) else literal;
    let digit_count = digit_text.count();
    if digit_count > UInt(20) then {
        return Option[JsonValue].None();
    };
    if digit_count == UInt(20) and digit_text.compare("18446744073709551615") > 0 then {
        return Option[JsonValue].None();
    };
    let digits = digit_text.to_bytes();
    let mutable magnitude = UInt(0);
    for j in 0..<digits.count() then {
        magnitude = magnitude * UInt(10) + UInt(digits[j] - '0');
    };
    if negative then {
        // -2^63..-1 fit `Int`: the negation below 2^63 is ordinary
        // arithmetic, and the one value at 2^63 is `Int.min_value()` taken
        // whole (there is no positive `Int(magnitude)` to negate there).
        if magnitude <= UInt(9223372036854775807) then {
            return Option[JsonValue].Some(JsonValue.Int(0 - Int(magnitude)));
        };
        if magnitude == UInt(9223372036854775807) + UInt(1) then {
            return Option[JsonValue].Some(JsonValue.Int(Int.min_value()));
        };
        return Option[JsonValue].None();
    };
    if magnitude <= UInt(9223372036854775807) then {
        return Option[JsonValue].Some(JsonValue.Int(Int(magnitude)));
    };
    return Option[JsonValue].Some(JsonValue.UInt(magnitude));
};

type mutable JsonParser(input: String, mutable pos: UInt, len: UInt);

// ============================================================================
// JsonParser Helper Methods
// ============================================================================
given JsonParser {

    // --- Construction ---

    new(input: String): JsonParser = JsonParser(input, 0, input.count());

    // --- Error construction ---

    make_error(self, msg: String): Result[JsonValue] =
        Result[JsonValue].Error(JsonError(msg, self.pos));

    // --- Whitespace handling ---

    skip_whitespace(self): Void = {
        while self.pos < self.len then {
            let b = self.input[self.pos];
            if b == ' ' or b == '\t' or b == '\n' or b == '\r' then {
                self.pos += 1;
            } else {
                break;
            };
        };
    };

    // --- Byte-level access ---

    peek(self): Option[UInt8] = {
        return if self.pos < self.len then .Some(self.input[self.pos]) else .None();
    };

    advance(self): UInt8 = {
        let b = self.input[self.pos];
        self.pos += 1;
        return b;
    };

    expect_char(self, expected: UInt8): Result[JsonValue] = {
        if self.pos >= self.len then {
            return self.make_error("unexpected end of input");
        };
        let b = self.input[self.pos];
        if b == expected then {
            self.pos += 1;
            return .Ok(JsonValue.Null());
        };
        let mutable msg = StringBuilder.new();
        msg.push_string("expected '");
        msg.push_byte(expected);
        msg.push_string("', found '");
        msg.push_byte(b);
        msg.push_byte('\'');
        return self.make_error(msg.to_string());
    };

    // --- Literal parsing ---

    parse_null(self): Result[JsonValue] = {
        if self.pos + 4 > self.len then {
            return self.make_error("unexpected end of input");
        };
        if self.input[self.pos] == 'n' and self.input[self.pos + 1] == 'u' and self.input[
            self.pos + 2
        ] == 'l' and self.input[self.pos + 3] == 'l' then {
            self.pos += 4;
            return .Ok(JsonValue.Null());
        };
        return self.make_error("expected 'null'");
    };

    parse_true(self): Result[JsonValue] = {
        if self.pos + 4 > self.len then {
            return self.make_error("unexpected end of input");
        };
        if self.input[self.pos] == 't' and self.input[self.pos + 1] == 'r' and self.input[
            self.pos + 2
        ] == 'u' and self.input[self.pos + 3] == 'e' then {
            self.pos += 4;
            return .Ok(JsonValue.Bool(true));
        };
        return self.make_error("expected 'true'");
    };

    parse_false(self): Result[JsonValue] = {
        if self.pos + 5 > self.len then {
            return self.make_error("unexpected end of input");
        };
        if self.input[self.pos] == 'f' and self.input[self.pos + 1] == 'a' and self.input[
            self.pos + 2
        ] == 'l' and self.input[self.pos + 3] == 's' and self.input[self.pos + 4] == 'e' then {
            self.pos += 5;
            return .Ok(JsonValue.Bool(false));
        };
        return self.make_error("expected 'false'");
    };

    // --- String error construction ---

    make_string_error(self, msg: String): Result[String] =
        Result[String].Error(JsonError(msg, self.pos));

    // --- Hex digit parsing ---

    parse_hex4(self): Result[UInt] = {
        let mutable value: UInt = 0;
        for _ in 0..<4 then {
            if self.pos >= self.len then {
                return .Error(JsonError("invalid unicode escape", self.pos));
            };
            let b = self.input[self.pos];
            let digit = if b >= '0' and b <= '9' then {
                UInt((b - '0'))
            } else if b >= 'a' and b <= 'f' then {
                UInt((b - 'a')) + 10
            } else if b >= 'A' and b <= 'F' then {
                UInt((b - 'A')) + 10
            } else {
                return .Error(JsonError("invalid unicode escape", self.pos));
            };
            value = value * 16 + digit;
            self.pos += 1;
        };
        return .Ok(value);
    };

    // --- UTF-8 encoding helper ---

    encode_utf8(self, cp: UInt, result: StringBuilder): Void = {
        if cp < 128 then {
            result.push_byte(UInt8(cp));
        } else if cp < 2048 then {
            result.push_byte(UInt8((cp >> 6)) | UInt8(192));
            result.push_byte(UInt8((cp & 63)) | UInt8(128));
        } else if cp < 65536 then {
            result.push_byte(UInt8((cp >> 12)) | UInt8(224));
            result.push_byte(UInt8(((cp >> 6) & 63)) | UInt8(128));
            result.push_byte(UInt8((cp & 63)) | UInt8(128));
        } else {
            result.push_byte(UInt8((cp >> 18)) | UInt8(240));
            result.push_byte(UInt8(((cp >> 12) & 63)) | UInt8(128));
            result.push_byte(UInt8(((cp >> 6) & 63)) | UInt8(128));
            result.push_byte(UInt8((cp & 63)) | UInt8(128));
        };
    };

    // --- String parsing ---

    parse_string_raw(self): Result[String] = {
        // Expect opening quote
        if self.pos >= self.len then {
            return self.make_string_error("unexpected end of input");
        };
        if self.input[self.pos] != '"' then {
            let mutable msg = StringBuilder.new();
            msg.push_string("expected '\"', found '");
            msg.push_byte(self.input[self.pos]);
            msg.push_byte('\'');
            return self.make_string_error(msg.to_string());
        };
        self.pos += 1;

        let mutable result = StringBuilder.new();

        while self.pos < self.len then {
            let b = self.input[self.pos];

            // Closing quote
            if b == '"' then {
                self.pos += 1;
                return .Ok(result.to_string());
            };

            // Escape sequence
            if b == '\\' then {
                let escape_pos = self.pos;
                self.pos += 1;
                if self.pos >= self.len then {
                    return self.make_string_error("unexpected end of input");
                };
                let esc = self.input[self.pos];
                self.pos += 1;
                if esc == '"' then {
                    result.push_byte('"');
                } else if esc == '\\' then {
                    result.push_byte('\\');
                } else if esc == '/' then {
                    result.push_byte('/');
                } else if esc == 'b' then {
                    result.push_byte(UInt8(8));
                } else if esc == 'f' then {
                    result.push_byte(UInt8(12));
                } else if esc == 'n' then {
                    result.push_byte(UInt8(10));
                } else if esc == 'r' then {
                    result.push_byte(UInt8(13));
                } else if esc == 't' then {
                    result.push_byte(UInt8(9));
                } else if esc == 'u' then {
                    let hex_result = self.parse_hex4();
                    let cp = when hex_result in {
                        .Ok(v) then v,
                        .Error(e) then {
                            return .Error(e);
                        },
                    };
                    // Check for UTF-16 surrogate pair
                    if cp >= 55296 and cp <= 56319 then {
                        // High surrogate (0xD800-0xDBFF) — expect \uXXXX low surrogate
                        if self.pos + 1 >= self.len or self.input[self.pos] != '\\' or self.input[
                            self.pos + 1
                        ] != 'u' then {
                            self.pos = escape_pos;
                            return self.make_string_error("invalid unicode escape");
                        };
                        self.pos += 2;
                        let low_result = self.parse_hex4();
                        let low = when low_result in {
                            .Ok(v) then v,
                            .Error(e) then {
                                return .Error(e);
                            },
                        };
                        if low < 56320 or low > 57343 then {
                            // Not a valid low surrogate (0xDC00-0xDFFF)
                            self.pos = escape_pos;
                            return self.make_string_error("invalid unicode escape");
                        };
                        // Combine surrogate pair: (high - 0xD800) * 0x400 + (low - 0xDC00) + 0x10000
                        let combined = (cp - 55296) * 1024 + (low - 56320) + 65536;
                        self.encode_utf8(combined, result);
                    } else if cp >= 56320 and cp <= 57343 then {
                        // Lone low surrogate — invalid
                        self.pos = escape_pos;
                        return self.make_string_error("invalid unicode escape");
                    } else {
                        self.encode_utf8(cp, result);
                    };
                } else {
                    self.pos = escape_pos;
                    let mutable msg = StringBuilder.new();
                    msg.push_string("invalid escape sequence '\\");
                    msg.push_byte(esc);
                    msg.push_byte('\'');
                    return self.make_string_error(msg.to_string());
                };
            } else if b < UInt8(32) then {
                // Control characters are not allowed unescaped
                return self.make_string_error("unexpected character");
            } else {
                // Regular character — push directly
                result.push_byte(b);
                self.pos += 1;
            };
        };

        // Reached end of input without closing quote
        return self.make_string_error("unexpected end of input");
    };

    parse_string(self): Result[JsonValue] = {
        return .Ok(JsonValue.String(self.parse_string_raw() or return));
    };

    // --- Array parsing ---

    parse_array(self, depth: UInt): Result[JsonValue] = {
        // Expect opening '['
        if self.pos >= self.len or self.input[self.pos] != '[' then {
            return self.make_error("expected '['");
        };
        self.pos += 1;

        self.skip_whitespace();

        // Empty array
        if self.pos < self.len and self.input[self.pos] == ']' then {
            self.pos += 1;
            let empty: List[JsonValue] = [];
            return .Ok(JsonValue.Array(empty));
        };

        let mutable elements: List[JsonValue] = [];

        while true then {
            // Parse element
            let value = self.parse_value(depth + 1) or return;
            elements.push(value);

            self.skip_whitespace();

            if self.pos >= self.len then {
                return self.make_error("unexpected end of input");
            };

            let b = self.input[self.pos];
            if b == ',' then {
                self.pos += 1;
                self.skip_whitespace();
            } else if b == ']' then {
                self.pos += 1;
                break;
            } else {
                return self.make_error("expected ',' or ']'");
            };
        };

        return .Ok(JsonValue.Array(elements));
    };

    // --- Object parsing ---

    parse_object(self, depth: UInt): Result[JsonValue] = {
        // Expect opening '{'
        if self.pos >= self.len or self.input[self.pos] != '{' then {
            return self.make_error("expected '{'");
        };
        self.pos += 1;

        self.skip_whitespace();

        // Empty object
        if self.pos < self.len and self.input[self.pos] == '}' then {
            self.pos += 1;
            let empty: Dict[String, JsonValue] = [];
            return .Ok(JsonValue.Object(empty));
        };

        let mutable entries: Dict[String, JsonValue] = [];

        while true then {
            // Parse key (must be a string)
            let key = self.parse_string_raw() or return;

            self.skip_whitespace();

            // Expect ':'
            if self.pos >= self.len then {
                return self.make_error("unexpected end of input");
            };
            if self.input[self.pos] != ':' then {
                return self.make_error("expected ':'");
            };
            self.pos += 1;

            self.skip_whitespace();

            // Parse value
            let value = self.parse_value(depth + 1) or return;

            // Insert key-value pair (duplicate keys: later value overwrites)
            entries.insert(key, value);

            self.skip_whitespace();

            if self.pos >= self.len then {
                return self.make_error("unexpected end of input");
            };

            let b = self.input[self.pos];
            if b == ',' then {
                self.pos += 1;
                self.skip_whitespace();
            } else if b == '}' then {
                self.pos += 1;
                break;
            } else {
                return self.make_error("expected ',' or '}'");
            };
        };

        return .Ok(JsonValue.Object(entries));
    };

    // --- Number parsing ---

    parse_number(self): Result[JsonValue] = {
        let start = self.pos;
        let mutable is_integer = true;

        // Optional leading minus
        if self.pos < self.len and self.input[self.pos] == '-' then {
            self.pos += 1;
        };

        // Integer part (required)
        if self.pos >= self.len or self.input[self.pos] < '0' or self.input[self.pos] > '9' then {
            self.pos = start;
            return self.make_error("invalid number");
        };

        if self.input[self.pos] == '0' then {
            // Leading zero: only '0' is allowed, no '01', '02', etc.
            self.pos += 1;
        } else {
            // digit1-9 followed by *digit
            while self.pos < self.len and self.input[self.pos] >= '0' and self.input[
                self.pos
            ] <= '9' then {
                self.pos += 1;
            };
        };

        // Optional fractional part
        if self.pos < self.len and self.input[self.pos] == '.' then {
            is_integer = false;
            self.pos += 1;
            // Must have at least one digit after '.'
            if self.pos >= self.len or self.input[self.pos] < '0' or self.input[
                self.pos
            ] > '9' then {
                self.pos = start;
                return self.make_error("invalid number");
            };
            while self.pos < self.len and self.input[self.pos] >= '0' and self.input[
                self.pos
            ] <= '9' then {
                self.pos += 1;
            };
        };

        // Optional exponent part
        if self.pos < self.len and (self.input[self.pos] == 'e' or self.input[self.pos] == 'E') then {
            is_integer = false;
            self.pos += 1;
            if self.pos < self.len and (self.input[self.pos] == '+' or self.input[
                self.pos
            ] == '-') then {
                self.pos += 1;
            };
            // Must have at least one digit after 'e'/'E'
            if self.pos >= self.len or self.input[self.pos] < '0' or self.input[
                self.pos
            ] > '9' then {
                self.pos = start;
                return self.make_error("invalid number");
            };
            while self.pos < self.len and self.input[self.pos] >= '0' and self.input[
                self.pos
            ] <= '9' then {
                self.pos += 1;
            };
        };

        // The scan above validated the JSON number grammar. An integer
        // token is stored exactly -- a Float64 rounds everything past 2^53,
        // and JSON integers carry IDs that must survive a round trip --
        // falling back to `Float64` only past `UInt`. Everything else goes
        // to strtod: that is correctly rounded (so "0.3" parses to exactly
        // the 0.3 double and "-0.0" keeps its sign) and it clamps
        // out-of-range exponents to +/-inf or 0.0 instead of accumulating
        // them in checked integer arithmetic.
        let literal = self.input.substring(start..<self.pos);
        if is_integer then {
            when parse_json_integer_literal(literal) in {
                .Some(value) then return .Ok(value),
                .None() then {},
            };
        };
        return .Ok(JsonValue.Number(__koral_parse_float64(literal.data)));
    };

    // --- Top-level value dispatch ---

    parse_value(self, depth: UInt): Result[JsonValue] = {
        // `depth` counts enclosing arrays/objects; refuse to recurse past the
        // documented cap instead of overflowing the call stack.
        if depth > max_json_depth then {
            return self.make_error("maximum nesting depth exceeded");
        };
        self.skip_whitespace();
        when self.peek() in {
            .None() then {
                return self.make_error("unexpected end of input");
            },
            .Some(b) then {
                if b == 'n' then {
                    return self.parse_null();
                };
                if b == 't' then {
                    return self.parse_true();
                };
                if b == 'f' then {
                    return self.parse_false();
                };
                if b == '"' then {
                    return self.parse_string();
                };
                if b == '[' then {
                    return self.parse_array(depth);
                };
                if b == '{' then {
                    return self.parse_object(depth);
                };
                if b == '-' or (b >= '0' and b <= '9') then {
                    return self.parse_number();
                };
                let mutable msg = StringBuilder.new();
                msg.push_string("unexpected character '");
                msg.push_byte(b);
                msg.push_byte('\'');
                return self.make_error(msg.to_string());
            },
        };
    };
};

// ============================================================================
// JsonValue Parseable Implementation
// ============================================================================
/// Implements `Parseable`, parsing one JSON value from a string.
given JsonValue: Parseable {

    /// Parse `s` as one JSON value, failing with a `JsonError` giving the message and position of the first problem.
    public parse(s: String): Result[Self] = {
        let mutable parser = JsonParser.new(s);
        let value = parser.parse_value(0) or return;
        parser.skip_whitespace();
        if parser.pos < parser.len then {
            return .Error(JsonError("trailing characters after JSON value", parser.pos));
        };
        return .Ok(value);
    };
};
