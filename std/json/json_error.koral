using "std" { ... };
// ============================================================================
// std.json - JsonError Type
// ============================================================================
// JSON error type with position information.
// Implements the Error and ToString traits for use with Result.
// ============================================================================

/// JSON parse failure with the failure `detail` text and the `position` in
/// the input where parsing stopped. The payload field is named `detail`,
/// matching `IoError.Other(detail: String)`.
public type sendable JsonError(public detail: String, public position: Int);

/// Implements `Error`, reporting the message and its input position.
given JsonError: Error {

    /// Return the failure text, including the input position.
    public message(self): String = {
        let mutable result = StringBuilder.new();
        result.push_string("JSON error at position ");
        result.push_string(self.position.to_string());
        result.push_string(": ");
        result.push_string(self.detail);
        return result.to_string();
    };

    /// A plain failure wraps nothing.
    public source(self): Option[Error] = Option[Error].None();
};

/// Implements `ToString`, matching `message`.
given JsonError: ToString {

    /// Return the same text as `message`.
    public to_string(self): String = self.message();
};
