using "std" { ... };
// Float64's math methods (`trunc`, `is_inf`, `is_sign_negative`) are declared
// in std.math. This module formats numbers by calling them, so it depends on
// std.math's code -- and in a module graph derived from `using`, saying so is
// the only way that dependency exists. The manifest used to carry it as
// `requires`; that field is gone precisely so the two could not drift apart.
using "std/math" { ... };

// Correctly-rounded decimal <-> double conversion helpers from the C runtime.
// `__koral_format_float64` renders into a thread-local NUL-terminated buffer
// that the caller must copy out before the next call; `__koral_parse_float64`
// parses a NUL-terminated decimal literal (strtod).
let unsafe foreign __koral_format_float64(
    value: Float64,
    type_char: UInt8,
    precision: Int,
    alt_form: Bool,
): *UInt8;
let unsafe foreign __koral_parse_float64(cstr: *UInt8): Float64;

// ============================================================================
// std.json - JsonValue Type
// ============================================================================
// JSON value enum with six variants representing all JSON types.
// Provides type-checking, value extraction, and indexed access methods.
// ============================================================================

// ============================================================================
// JsonValue Type Definition
// ============================================================================
/// `JsonNumber` 的内部表示（不对外：构造走 `from_int` / `from_uint` /
/// `from_float`，读取走 `as_int` / `as_uint` / `as_float`）。三种形态是
/// 精度策略不是 API：整数保精确（JSON 的 ID 要活过 round trip，Float64
/// 过 2^53 就取整），浮点保最短往返打印。
private type sendable JsonNumberRep {
    IntRep(value: Int),
    UIntRep(value: UInt),
    FloatRep(value: Float64),
};

/// A JSON number as ONE opaque type. 构造走 `from_int` / `from_uint` /
/// `from_float`，读取走 `as_int` / `as_uint` / `as_float`；相等按数值
/// （`1` 与 `1.0` 相等，传递性见 `equals`），序列化保构造/解析形式。
public type sendable JsonNumber(private rep: JsonNumberRep);

/// Construction from the three numeric forms and extraction back out.
given JsonNumber {

    /// Build a number from an exact `Int`.
    public from_int(value: Int): JsonNumber = JsonNumber(JsonNumberRep.IntRep(value));

    /// Build a number from an exact `UInt`.
    public from_uint(value: UInt): JsonNumber = JsonNumber(JsonNumberRep.UIntRep(value));

    /// Build a number from a `Float64`.
    public from_float(value: Float64): JsonNumber = JsonNumber(JsonNumberRep.FloatRep(value));

    /// The exact `Int` value of an integer form (`UInt` converts when it
    /// fits). A float form is not an integer -- `None`（Option 访问器全函数）.
    public as_int(self): Option[Int] = when self.rep in {
        .IntRep(v) then Option[Int].Some(v),
        .UIntRep(v) then {
            if v <= UInt(Int.max_value()) then {
                Option[Int].Some(Int(v))
            } else {
                Option[Int].None()
            }
        },
        .FloatRep(_) then Option[Int].None(),
    };

    /// The exact `UInt` value of an integer form (`Int` converts when it is
    /// non-negative). A float form is not an integer -- `None`.
    public as_uint(self): Option[UInt] = when self.rep in {
        .UIntRep(v) then Option[UInt].Some(v),
        .IntRep(v) then {
            if v >= 0 then {
                Option[UInt].Some(UInt(v))
            } else {
                Option[UInt].None()
            }
        },
        .FloatRep(_) then Option[UInt].None(),
    };

    /// The value as `Float64` (an integer beyond 2^53 rounds -- read the
    /// integer form with `as_int` / `as_uint` for the exact value).
    public as_float(self): Float64 = when self.rep in {
        .IntRep(v) then Float64(v),
        .UIntRep(v) then Float64(v),
        .FloatRep(v) then v,
    };

    // 精确桥：只在 |n| <= 2^53 的安全整数域内做浮点-整数相等（该域内
    // Float64(n) 精确，`f == Float64(n)` 即数学相等）。
    private float_equals_int(f: Float64, n: Int): Bool = {
        if n > 9007199254740992 or n < 0 - 9007199254740992 then {
            return false;
        };
        return f == Float64(n);
    };

    private float_equals_uint(f: Float64, n: UInt): Bool = {
        if n > UInt(9007199254740992) then {
            return false;
        };
        return f == Float64(n);
    };
};

/// `Eq` for `JsonNumber`: numeric equality across forms (`1` equals `1.0`),
/// matching JSON's number semantics.
given JsonNumber: Eq {

    /// Compare numerically (`1` equals `1.0`). Cross-form comparisons
    /// bridge through the EXACTLY representable integer range (|n| <= 2^53):
    /// past it a Float64 rounds, and a rounded bridge breaks transitivity
    /// (2^53 and 2^53+1 would both equal the same float). 结果是等价关系。
    public equals(self, other: JsonNumber): Bool = when self.rep in {
        .IntRep(a) then when other.rep in {
            .IntRep(b) then a == b,
            .UIntRep(b) then a >= 0 and UInt(a) == b,
            .FloatRep(b) then JsonNumber.float_equals_int(b, a),
        },
        .UIntRep(a) then when other.rep in {
            .UIntRep(b) then a == b,
            .IntRep(b) then b >= 0 and UInt(b) == a,
            .FloatRep(b) then JsonNumber.float_equals_uint(b, a),
        },
        .FloatRep(a) then when other.rep in {
            .FloatRep(b) then a == b,
            .IntRep(b) then JsonNumber.float_equals_int(a, b),
            .UIntRep(b) then JsonNumber.float_equals_uint(a, b),
        },
    };
};

/// `ToString` for `JsonNumber`: the construction/parse form is preserved
/// (integer forms print exact decimals, floats the shortest round-trip).
given JsonNumber: ToString {

    /// Print the number in its original form.
    public to_string(self): String = when self.rep in {
        .IntRep(v) then v.to_string(),
        .UIntRep(v) then v.to_string(),
        .FloatRep(v) then format_json_number(v),
    };
};

/// A JSON value: `Null`, `Bool`, `Number`, `String`, `Array`, or `Object`.
/// `Number` holds a `JsonNumber`, `Array` a frozen list of values, and
/// `Object` a frozen string-keyed map. A value is construction-then-read-only
/// data that sits on the `Frozen` tree, so it is safe `sendable` and may cross
/// threads directly (e.g. through a `Channel[JsonValue]`); parsing and building
/// stay on the mutable side (`JsonParser` accumulates, then freezes at
/// construction).
public type sendable JsonValue {
    Null(),
    Bool(value: Bool),
    /// A JSON number (`JsonNumber` keeps exact integers exact).
    Number(value: JsonNumber),
    String(value: String),
    Array(elements: FrozenList[JsonValue]),
    Object(entries: FrozenDict[String, JsonValue]),
};

// ============================================================================
// JSON string/number formatting and pretty-print helpers
// ============================================================================
private let hex_char(nibble: UInt): UInt8 = {
    if nibble < 10 then {
        return UInt8(nibble) + '0';
    };
    return UInt8((nibble - 10)) + 'a';
};

let escape_json_string(s: String): String = {
    let mutable result = StringBuilder.with_capacity(s.count() + 2);
    result.push_byte('"');
    for i in 0..<s.count() then {
        let b = s[i];
        if b == '"' then {
            result.push_byte('\\');
            result.push_byte('"');
        } else if b == '\\' then {
            result.push_byte('\\');
            result.push_byte('\\');
        } else if b == '/' then {
            result.push_byte('\\');
            result.push_byte('/');
        } else if b == UInt8(8) then {
            result.push_byte('\\');
            result.push_byte('b');
        } else if b == UInt8(12) then {
            result.push_byte('\\');
            result.push_byte('f');
        } else if b == '\n' then {
            result.push_byte('\\');
            result.push_byte('n');
        } else if b == '\r' then {
            result.push_byte('\\');
            result.push_byte('r');
        } else if b == '\t' then {
            result.push_byte('\\');
            result.push_byte('t');
        } else if b < UInt8(32) then {
            result.push_byte('\\');
            result.push_byte('u');
            result.push_byte('0');
            result.push_byte('0');
            let hi = UInt((b >> 4));
            let lo = UInt((b & UInt8(0x0F)));
            result.push_byte(hex_char(hi));
            result.push_byte(hex_char(lo));
        } else {
            result.push_byte(b);
        };
    };
    result.push_byte('"');
    return result.to_string();
};

let format_json_number(f: Float64): String = {
    if f.is_nan() then {
        return "null";
    };
    if f.is_inf() then {
        return "null";
    };

    // Shortest round-trip decimal via trial precision: for each significant
    // digit count p, `%g` emits a compact JSON-compatible form ("42", "3.14",
    // "1e+30") whose re-parse can be compared bit-for-bit against `f`; the
    // first p that round-trips exists for every finite double (17 digits
    // always suffice), and the shortest such text is kept. This never converts
    // through `Int`, so magnitudes above 2^63 print fine.
    let mutable best = "";
    let mutable best_len = 0;
    let mutable found = false;
    let mutable p = 1;
    while p <= 17 then {
        let text = unsafe {
            String.from_cstring_unchecked(__koral_format_float64(f, 'g', p, false))
        };
        let parsed = unsafe { __koral_parse_float64(text.bytes.data) };
        if parsed.to_bits() == f.to_bits() then {
            if not found or text.count() < best_len then {
                best = text;
                best_len = text.count();
                found = true;
            };
        };
        p += 1;
    };
    if not found then {
        // Unreachable for finite doubles; keep a safe rendering anyway.
        best = unsafe {
            String.from_cstring_unchecked(__koral_format_float64(f, 'g', 17, false))
        };
    };
    if best.contains("inf") or best.contains("nan") then {
        return "null";
    };
    return best;
};

// Maximum nesting depth for recursive traversal (parsing, printing,
// comparison). Deeply nested input is rejected with a `JsonError`, and
// printing a programmatically built tree past the cap is a formatting error
// that panics with the same `maximum nesting depth exceeded` diagnostic --
// the parser's error, not a truncated document. Comparison past the cap
// reports unequal, so no traversal can overflow the call stack.
let max_json_depth: Int = 256;

private let make_indent(level: Int): String = {
    let mutable out = StringBuilder.new();
    for _ in 0..<level then {
        out.push_string("  ");
    };
    return out.to_string();
};

private let to_string_pretty_array(elements: FrozenList[JsonValue], level: Int): String = {
    let count = elements.count();
    if count == 0 then {
        return "[]";
    };

    let mutable result = StringBuilder.new();
    result.push_string("[\n");
    let child_indent = make_indent(level + 1);
    for i in 0..<count then {
        if i > 0 then {
            result.push_string(",\n");
        };
        result.push_string(child_indent);
        result.push_string(to_string_pretty_impl(elements[i], level + 1));
    };
    result.push_byte('\n');
    result.push_string(make_indent(level));
    result.push_byte(']');
    return result.to_string();
};

private let to_string_pretty_object(
    entries: FrozenDict[String, JsonValue],
    level: Int,
): String = {
    if entries.count() == 0 then {
        return "{}";
    };

    let mutable result = StringBuilder.new();
    result.push_string("{\n");
    let child_indent = make_indent(level + 1);
    let mutable first = true;
    for entry in entries then {
        if not first then {
            result.push_string(",\n");
        };
        first = false;
        result.push_string(child_indent);
        result.push_string(escape_json_string(entry.first));
        result.push_string(": ");
        result.push_string(to_string_pretty_impl(entry.second, level + 1));
    };
    result.push_byte('\n');
    result.push_string(make_indent(level));
    result.push_byte('}');
    return result.to_string();
};

private let to_string_pretty_impl(value: JsonValue, level: Int): String = {
    if level > max_json_depth then {
        panic("JSON error: maximum nesting depth exceeded");
    };
    return when value in {
        .Null() then "null",
        .Bool(v) then if v then "true" else "false",
        .Number(v) then v.to_string(),
        .String(v) then escape_json_string(v),
        .Array(elements) then to_string_pretty_array(elements, level),
        .Object(entries) then to_string_pretty_object(entries, level),
    };
};

// ============================================================================
// JsonValue Methods
// ============================================================================
/// Provides case tests, payload extraction, and indexed access for `JsonValue`.
given JsonValue {

    // --- Type checking methods ---

    /// Check whether this is `Null`.
    public is_null(self): Bool = self is .Null();

    /// Check whether this is a `Bool`.
    public is_bool(self): Bool = self is .Bool(_);

    /// Check whether this is a number (integer or not).
    public is_number(self): Bool = self is .Number(_);

    /// Check whether this is a `String`.
    public is_string(self): Bool = self is .String(_);

    /// Check whether this is an `Array`.
    public is_array(self): Bool = self is .Array(_);

    /// Check whether this is an `Object`.
    public is_object(self): Bool = self is .Object(_);

    // --- Value extraction methods ---

    /// Return the `Bool` payload, or `None` when this is not a `Bool`.
    public as_bool(self): Option[Bool] = when self in {
        .Bool(v) then Option[Bool].Some(v),
        _ then Option[Bool].None(),
    };

    /// Return the `JsonNumber` payload, or `None` when this is not a number.
    public as_json_number(self): Option[JsonNumber] = when self in {
        .Number(v) then Option[JsonNumber].Some(v),
        _ then Option[JsonNumber].None(),
    };

    /// Return the numeric payload as `Float64`, or `None` when this is not
    /// a number. An integer payload converts (and can round past 2^53 --
    /// read `as_json_number` and its `as_int` / `as_uint` for the exact value).
    public as_number(self): Option[Float64] = when self in {
        .Number(v) then Option[Float64].Some(v.as_float()),
        _ then Option[Float64].None(),
    };

    /// Return the exact `Int` value, or `None` when this is not an integer
    /// number (`JsonNumber.as_int` semantics: a float form is not an integer).
    public as_int(self): Option[Int] = when self in {
        .Number(v) then v.as_int(),
        _ then Option[Int].None(),
    };

    /// Return the exact `UInt` value, or `None` when this is not an integer
    /// number (`JsonNumber.as_uint` semantics).
    public as_uint(self): Option[UInt] = when self in {
        .Number(v) then v.as_uint(),
        _ then Option[UInt].None(),
    };

    /// Return the `String` payload, or `None` when this is not a `String`.
    public as_string(self): Option[String] = when self in {
        .String(v) then Option[String].Some(v),
        _ then Option[String].None(),
    };

    /// Return the `Array` elements, or `None` when this is not an `Array`.
    /// Zero-copy view: the snapshot handle is shared with the value.
    public as_array(self): Option[FrozenList[JsonValue]] = when self in {
        .Array(v) then Option[FrozenList[JsonValue]].Some(v),
        _ then Option[FrozenList[JsonValue]].None(),
    };

    /// Return the `Object` entries, or `None` when this is not an `Object`.
    /// Zero-copy view: the snapshot handle is shared with the value.
    public as_object(self): Option[FrozenDict[String, JsonValue]] = when self in {
        .Object(v) then Option[FrozenDict[String, JsonValue]].Some(v),
        _ then Option[FrozenDict[String, JsonValue]].None(),
    };

    // --- Indexed access methods ---

    /// Return the value stored under `key`, or `None` when this is not an `Object` or has no such key.
    public get_field(self, key: String): Option[JsonValue] = when self in {
        .Object(entries) then entries.get(key),
        _ then Option[JsonValue].None(),
    };

    /// Return the element at `index`, or `None` when this is not an `Array` or the index is out of range.
    public get_element(self, index: Int): Option[JsonValue] = when self in {
        .Array(elements) then elements.get(index),
        _ then Option[JsonValue].None(),
    };

    /// Format as JSON indented two spaces per level, with each array element and object entry on its own line.
    /// Panics with `JSON error: maximum nesting depth exceeded` past `max_json_depth`.
    public to_string_pretty(self): String = to_string_pretty_impl(self, 0);
};

// ============================================================================
// JsonValue Eq Implementation
// ============================================================================
/// Structural comparison with a depth budget: `depth` counts enclosing
/// containers, and values deeper than `max_json_depth` compare unequal
/// rather than recursing without bound.
private let equals_impl(left: JsonValue, right: JsonValue, depth: Int): Bool = {
    if depth > max_json_depth then {
        return false;
    };
    return when left in {
        .Null() then when right in {
            .Null() then true,
            _ then false,
        },
        .Bool(a) then when right in {
            .Bool(b) then a == b,
            _ then false,
        },
        .Number(a) then when right in {
            .Number(b) then a == b,
            _ then false,
        },
        .String(a) then when right in {
            .String(b) then a == b,
            _ then false,
        },
        .Array(a) then when right in {
            .Array(b) then {
                if a.count() != b.count() then {
                    return false;
                };
                for i in 0..<a.count() then {
                    if not equals_impl(a[i], b[i], depth + 1) then {
                        return false;
                    };
                };
                return true;
            },
            _ then false,
        },
        .Object(a) then when right in {
            .Object(b) then {
                if a.count() != b.count() then {
                    return false;
                };
                for entry in a then {
                    when b.get(entry.first) in {
                        .None() then {
                            return false;
                        },
                        .Some(bval) then {
                            if not equals_impl(entry.second, bval, depth + 1) then {
                                return false;
                            };
                        },
                    };
                };
                return true;
            },
            _ then false,
        },
    };
};

/// Implements `Eq`, comparing values structurally.
given JsonValue: Eq {

    /// Return whether both values hold the same case and equal payloads, comparing arrays and objects element by element.
    public equals(self, other: JsonValue): Bool = equals_impl(self, other, 0);
};
