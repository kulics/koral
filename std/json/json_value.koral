using "std" { ... };
// Float64's math methods (`trunc`, `is_inf`, `is_sign_negative`) are declared
// in std.math. This module formats numbers by calling them, so it depends on
// std.math's code -- and in a module graph derived from `using`, saying so is
// the only way that dependency exists. The manifest used to carry it as
// `requires`; that field is gone precisely so the two could not drift apart.
using "std/math" { ... };

// Correctly-rounded decimal <-> double conversion helpers from the C runtime.
// `__koral_format_float64` renders into a thread-local NUL-terminated buffer
// that the caller must copy out before the next call; `__koral_parse_float64`
// parses a NUL-terminated decimal literal (strtod).
let foreign __koral_format_float64(
    value: Float64,
    type_char: UInt8,
    precision: Int,
    alt_form: Bool,
): *UInt8;
let foreign __koral_parse_float64(cstr: *UInt8): Float64;

// ============================================================================
// std.json - JsonValue Type
// ============================================================================
// JSON value enum with six variants representing all JSON types.
// Provides type-checking, value extraction, and indexed access methods.
// ============================================================================

// ============================================================================
// JsonValue Type Definition
// ============================================================================
/// A JSON value: `Null`, `Bool`, `Number`, `String`, `Array`, or `Object`.
/// `Number` holds a `Float64`, `Array` a list of values, and `Object` a string-keyed map.
public type JsonValue {
    Null(),
    Bool(value: Bool),
    Number(value: Float64),
    String(value: String),
    Array(elements: List[JsonValue]),
    Object(entries: Dict[String, JsonValue]),
};

// ============================================================================
// JSON string/number formatting and pretty-print helpers
// ============================================================================
private let hex_char(nibble: UInt): UInt8 = {
    if nibble < 10 then {
        return UInt8(nibble) + '0';
    };
    return UInt8((nibble - 10)) + 'a';
};

let escape_json_string(s: String): String = {
    let mutable result = StringBuilder.with_capacity(s.count() + 2);
    result.push_byte('"');
    for i in 0..<s.count() then {
        let b = s[i];
        if b == '"' then {
            result.push_byte('\\');
            result.push_byte('"');
        } else if b == '\\' then {
            result.push_byte('\\');
            result.push_byte('\\');
        } else if b == '/' then {
            result.push_byte('\\');
            result.push_byte('/');
        } else if b == UInt8(8) then {
            result.push_byte('\\');
            result.push_byte('b');
        } else if b == UInt8(12) then {
            result.push_byte('\\');
            result.push_byte('f');
        } else if b == '\n' then {
            result.push_byte('\\');
            result.push_byte('n');
        } else if b == '\r' then {
            result.push_byte('\\');
            result.push_byte('r');
        } else if b == '\t' then {
            result.push_byte('\\');
            result.push_byte('t');
        } else if b < UInt8(32) then {
            result.push_byte('\\');
            result.push_byte('u');
            result.push_byte('0');
            result.push_byte('0');
            let hi = UInt((b >> 4));
            let lo = UInt((b & UInt8(0x0F)));
            result.push_byte(hex_char(hi));
            result.push_byte(hex_char(lo));
        } else {
            result.push_byte(b);
        };
    };
    result.push_byte('"');
    return result.to_string();
};

let format_json_number(f: Float64): String = {
    if f.is_nan() then {
        return "null";
    };
    if f.is_inf() then {
        return "null";
    };

    // Shortest round-trip decimal via trial precision: for each significant
    // digit count p, `%g` emits a compact JSON-compatible form ("42", "3.14",
    // "1e+30") whose re-parse can be compared bit-for-bit against `f`; the
    // first p that round-trips exists for every finite double (17 digits
    // always suffice), and the shortest such text is kept. This never converts
    // through `Int`, so magnitudes above 2^63 print fine.
    let mutable best = "";
    let mutable best_len: UInt = 0;
    let mutable found = false;
    let mutable p = 1;
    while p <= 17 then {
        let text = String.from_cstring_unchecked(
            __koral_format_float64(f, 'g', p, false),
        );
        let parsed = __koral_parse_float64(text.data);
        if parsed.to_bits() == f.to_bits() then {
            if not found or text.count() < best_len then {
                best = text;
                best_len = text.count();
                found = true;
            };
        };
        p += 1;
    };
    if not found then {
        // Unreachable for finite doubles; keep a safe rendering anyway.
        best = String.from_cstring_unchecked(__koral_format_float64(f, 'g', 17, false));
    };
    if best.contains("inf") or best.contains("nan") then {
        return "null";
    };
    return best;
};

// Maximum nesting depth for recursive traversal (parsing, printing,
// comparison). Deeply nested input is rejected with a `JsonError`, and
// programmatically built trees past the cap render as `null` (the same
// fallback non-finite numbers use) and compare unequal, so no traversal
// can overflow the call stack.
let max_json_depth: UInt = UInt(256);

private let make_indent(level: UInt): String = {
    let mutable out = StringBuilder.new();
    for _ in 0..<level then {
        out.push_string("  ");
    };
    return out.to_string();
};

private let to_string_pretty_array(elements: List[JsonValue], level: UInt): String = {
    let count = elements.count();
    if count == 0 then {
        return "[]";
    };

    let mutable result = StringBuilder.new();
    result.push_string("[\n");
    let child_indent = make_indent(level + 1);
    for i in 0..<count then {
        if i > 0 then {
            result.push_string(",\n");
        };
        result.push_string(child_indent);
        result.push_string(to_string_pretty_impl(elements[i], level + 1));
    };
    result.push_byte('\n');
    result.push_string(make_indent(level));
    result.push_byte(']');
    return result.to_string();
};

private let to_string_pretty_object(
    entries: Dict[String, JsonValue],
    level: UInt,
): String = {
    if entries.count() == 0 then {
        return "{}";
    };

    let mutable result = StringBuilder.new();
    result.push_string("{\n");
    let child_indent = make_indent(level + 1);
    let mutable first = true;
    for entry in entries then {
        if not first then {
            result.push_string(",\n");
        };
        first = false;
        result.push_string(child_indent);
        result.push_string(escape_json_string(entry.first));
        result.push_string(": ");
        result.push_string(to_string_pretty_impl(entry.second, level + 1));
    };
    result.push_byte('\n');
    result.push_string(make_indent(level));
    result.push_byte('}');
    return result.to_string();
};

private let to_string_pretty_impl(value: JsonValue, level: UInt): String = {
    if level > max_json_depth then {
        return "null";
    };
    return when value in {
        .Null() then "null",
        .Bool(v) then if v then "true" else "false",
        .Number(v) then format_json_number(v),
        .String(v) then escape_json_string(v),
        .Array(elements) then to_string_pretty_array(elements, level),
        .Object(entries) then to_string_pretty_object(entries, level),
    };
};

// ============================================================================
// JsonValue Methods
// ============================================================================
/// Provides case tests, payload extraction, and indexed access for `JsonValue`.
given JsonValue {

    // --- Type checking methods ---

    /// Check whether this is `Null`.
    public is_null(self): Bool = self is .Null();

    /// Check whether this is a `Bool`.
    public is_bool(self): Bool = self is .Bool(_);

    /// Check whether this is a `Number`.
    public is_number(self): Bool = self is .Number(_);

    /// Check whether this is a `String`.
    public is_string(self): Bool = self is .String(_);

    /// Check whether this is an `Array`.
    public is_array(self): Bool = self is .Array(_);

    /// Check whether this is an `Object`.
    public is_object(self): Bool = self is .Object(_);

    // --- Value extraction methods ---

    /// Return the `Bool` payload, or `None` when this is not a `Bool`.
    public as_bool(self): Option[Bool] = when self in {
        .Bool(v) then Option[Bool].Some(v),
        _ then Option[Bool].None(),
    };

    /// Return the `Number` payload, or `None` when this is not a `Number`.
    public as_number(self): Option[Float64] = when self in {
        .Number(v) then Option[Float64].Some(v),
        _ then Option[Float64].None(),
    };

    /// Return the `String` payload, or `None` when this is not a `String`.
    public as_string(self): Option[String] = when self in {
        .String(v) then Option[String].Some(v),
        _ then Option[String].None(),
    };

    /// Return the `Array` elements, or `None` when this is not an `Array`.
    public as_array(self): Option[List[JsonValue]] = when self in {
        .Array(v) then Option[List[JsonValue]].Some(v),
        _ then Option[List[JsonValue]].None(),
    };

    /// Return the `Object` entries, or `None` when this is not an `Object`.
    public as_object(self): Option[Dict[String, JsonValue]] = when self in {
        .Object(v) then Option[Dict[String, JsonValue]].Some(v),
        _ then Option[Dict[String, JsonValue]].None(),
    };

    // --- Indexed access methods ---

    /// Return the value stored under `key`, or `None` when this is not an `Object` or has no such key.
    public get_field(self, key: String): Option[JsonValue] = when self in {
        .Object(entries) then entries.get(key),
        _ then Option[JsonValue].None(),
    };

    /// Return the element at `index`, or `None` when this is not an `Array` or the index is out of range.
    public get_element(self, index: UInt): Option[JsonValue] = when self in {
        .Array(elements) then elements.get(index),
        _ then Option[JsonValue].None(),
    };

    /// Format as JSON indented two spaces per level, with each array element and object entry on its own line.
    public to_string_pretty(self): String = to_string_pretty_impl(self, 0);
};

// ============================================================================
// JsonValue Eq Implementation
// ============================================================================
/// Structural comparison with a depth budget: `depth` counts enclosing
/// containers, and values deeper than `max_json_depth` compare unequal
/// rather than recursing without bound.
private let equals_impl(left: JsonValue, right: JsonValue, depth: UInt): Bool = {
    if depth > max_json_depth then {
        return false;
    };
    return when left in {
        .Null() then when right in {
            .Null() then true,
            _ then false,
        },
        .Bool(a) then when right in {
            .Bool(b) then a == b,
            _ then false,
        },
        .Number(a) then when right in {
            .Number(b) then a == b,
            _ then false,
        },
        .String(a) then when right in {
            .String(b) then a == b,
            _ then false,
        },
        .Array(a) then when right in {
            .Array(b) then {
                if a.count() != b.count() then {
                    return false;
                };
                for i in 0..<a.count() then {
                    if not equals_impl(a[i], b[i], depth + 1) then {
                        return false;
                    };
                };
                return true;
            },
            _ then false,
        },
        .Object(a) then when right in {
            .Object(b) then {
                if a.count() != b.count() then {
                    return false;
                };
                for entry in a then {
                    when b.get(entry.first) in {
                        .None() then {
                            return false;
                        },
                        .Some(bval) then {
                            if not equals_impl(entry.second, bval, depth + 1) then {
                                return false;
                            };
                        },
                    };
                };
                return true;
            },
            _ then false,
        },
    };
};

/// Implements `Eq`, comparing values structurally.
given JsonValue: Eq {

    /// Return whether both values hold the same case and equal payloads, comparing arrays and objects element by element.
    public equals(self, other: JsonValue): Bool = equals_impl(self, other, 0);
};
