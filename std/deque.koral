// ============================================================================
// Koral Standard Library - Deque Type
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives, traits, option,
// and list are already available.
// ============================================================================

/// A growable double-ended queue of `T` in a ring buffer: pushes and pops at
/// both ends are O(1) amortized, and indexing is O(1).
public type mutable Deque[T: Any](
    mutable source: *mutable T,
    mutable len: Int,
    mutable cap: Int,
    mutable head: Int,
);

/// `Drop` for `Deque[T]`: frees every element and the ring buffer when the last handle dies.
given[T: Any] Deque[T]: Drop {

    drop(self): Void = {
        for i in 0..<self.len then {
            let index = (self.head + i) % self.cap;
            deinit_memory(self.source + index);
        };
        dealloc_memory(self.source);
    };
};

/// A one-shot cursor that walks a `Deque[T]` from front to back.
public type mutable DequeIterator[T: Any](source: Deque[T], mutable index: Int);

/// Construction, mutation, and query operations on `Deque[T]`.
given[T: Any] Deque[T] {

    /// Create an empty deque, with a small ring buffer allocated up front.
    public new(): Self = {
        let cap = 10;
        let source = alloc_memory[T](UInt(cap));
        return Deque[T](source, 0, cap, 0);
    };

    /// Create an empty deque with room for at least `capacity` elements before the next reallocation.
    public with_capacity(capacity: Int): Self = {
        if capacity < 0 then {
            panic("Deque with_capacity negative capacity");
        };
        let cap = if capacity < 1 then 1 else capacity;
        let source = alloc_memory[T](UInt(cap));
        return Deque[T](source, 0, cap, 0);
    };

    /// The number of elements in the deque.
    public count(self): Int = self.len;

    /// Grow capacity so the deque can hold `additional` more elements without reallocating.
    public reserve(self, additional: Int): Void = {
        if additional < 0 then {
            panic("Deque reserve negative additional");
        };
        self.ensure_capacity(self.len + additional);
    };

    /// Whether the deque has no elements.
    public is_empty(self): Bool = self.len == 0;

    private physical_index(self, logical_index: Int): Int =
        (self.head + logical_index) % self.cap;

    private ensure_capacity(self, min_capacity: Int): Void = {
        if min_capacity > self.cap then {
            self.grow_to(min_capacity);
        };
    };

    /// The growth body behind `ensure_capacity`, kept out of line on purpose --
    /// same shape and reason as `List.grow_to` (see std/list.koral).
    private grow_to(self, min_capacity: Int): Void = {
        let mutable new_cap = self.cap * 2;
        if new_cap < min_capacity then {
            new_cap = min_capacity;
        };
        let old_source = self.source;
        let old_len = self.len;
        let old_cap = self.cap;
        let old_head = self.head;
        let new_source = alloc_memory[T](UInt(new_cap));
        for i in 0..<old_len then {
            let old_index = (old_head + i) % old_cap;
            let moved = take_memory(old_source + old_index);
            init_memory(new_source + i, moved);
        };
        dealloc_memory(old_source);
        self.source = new_source;
        self.cap = new_cap;
        self.head = 0;
    };

    /// Append `value` at the back end (amortized O(1)), without consuming the caller's value.
    public push_back(self, value: T): Void = {
        let len = self.len;
        let next = len + 1;
        if next > self.cap then {
            self.grow_to(next);
        };
        let index = self.physical_index(len);
        init_memory(self.source + index, value);
        self.len = next;
    };

    /// Insert `value` at the front end (amortized O(1)), without consuming the caller's value.
    public push_front(self, value: T): Void = {
        let len = self.len;
        let next = len + 1;
        if next > self.cap then {
            self.grow_to(next);
        };
        self.head = (self.head + self.cap - 1) % self.cap;
        init_memory(self.source + self.head, value);
        self.len = next;
    };

    /// Remove and return the front element, or `None` when the deque is empty.
    public pop_front(self): Option[T] = {
        if self.len == 0 then {
            return Option[T].None();
        };
        let value = take_memory(self.source + self.head);
        self.head = (self.head + 1) % self.cap;
        self.len = self.len - 1;
        if self.len == 0 then {
            self.head = 0;
        };
        return Option[T].Some(value);
    };

    /// Remove and return the back element, or `None` when the deque is empty.
    public pop_back(self): Option[T] = {
        if self.len == 0 then {
            return Option[T].None();
        };
        let index = self.physical_index(self.len - 1);
        let value = take_memory(self.source + index);
        self.len = self.len - 1;
        if self.len == 0 then {
            self.head = 0;
        };
        return Option[T].Some(value);
    };

    /// The front element without removing it, or `None` when the deque is empty.
    public first(self): Option[T] = self.get(0);

    /// The back element without removing it, or `None` when the deque is empty.
    public last(self): Option[T] = {
        if self.len == 0 then {
            return Option[T].None();
        };
        return self.get(self.len - 1);
    };

    /// The element at logical index `index` (0 is the front), or `None` when out of range.
    public get(self, index: Int): Option[T] = {
        if index < 0 or index >= self.len then {
            return Option[T].None();
        };
        let physical = self.physical_index(index);
        return Option[T].Some(self.source[physical]);
    };

    private __index_get(self, key: Int): T = {
        if key < 0 or key >= self.len then {
            panic("Deque index out of bounds");
        };
        let physical = self.physical_index(key);
        return self.source[physical];
    };

    private __index_set(self, key: Int, value: T): Void = {
        if key < 0 or key >= self.len then {
            panic("Deque index out of bounds");
        };
        let physical = self.physical_index(key);
        self.source[physical] = value;
    };

    /// 内置下标 `dq[i]` 的内部操作：返回元素槽位指针。见 `List.__index_slot`。
    private __index_slot(self, key: Int): *mutable T = {
        if key < 0 or key >= self.len then {
            panic("Deque index out of bounds");
        };
        let physical = self.physical_index(key);
        return self.source + physical;
    };

    /// Remove every element, keeping the allocated ring buffer.
    public clear(self): Void = {
        for i in 0..<self.len then {
            let index = self.physical_index(i);
            deinit_memory(self.source + index);
        };
        self.len = 0;
        self.head = 0;
    };

    /// Reverses the order of elements in place. O(n).
    public reverse(self): Void = {
        if self.len <= 1 then {
            return;
        };
        let mutable left = 0;
        let mutable right = self.len - 1;
        while left < right then {
            let lp = self.physical_index(left);
            let rp = self.physical_index(right);
            let tmp = self.source[lp];
            self.source[lp] = self.source[rp];
            self.source[rp] = tmp;
            left += 1;
            right -= 1;
        };
    };

    /// Retains only elements satisfying the predicate, preserving order. O(n).
    public retain(self, predicate: (T) -> Bool): Void = {
        if self.len == 0 then {
            return;
        };
        let mutable write = 0;
        let mutable read = 0;
        while read < self.len then {
            let rp = self.physical_index(read);
            let v = self.source[rp];
            if predicate(v) then {
                let wp = self.physical_index(write);
                if write != read then {
                    let moved = take_memory(self.source + rp);
                    init_memory(self.source + wp, moved);
                };
                write += 1;
            } else {
                deinit_memory(self.source + rp);
            };
            read += 1;
        };
        self.len = write;
    };
};

/// `Clone` for `Deque[T]`: a new deque whose elements are copied one level.
given[T: Any] Deque[T]: Clone {

    /// Independent shallow copy: new deque identity, elements copied one level.
    public clone(self): Self = {
        let mutable result = Deque[T].with_capacity(self.len);
        for i in 0..<self.len then {
            result.push_back(self.source[self.physical_index(i)]);
        };
        return result;
    };
};

/// `Default` for `Deque[T]`: the empty deque.
given[T: Any] Deque[T]: Default {

    /// The empty deque.
    public default(): Self = Deque[T].new();
};

/// Membership tests on `Deque[T]` of `Eq` elements.
given[T: Eq] Deque[T] {

    /// Whether any element equals `value`. O(n).
    public contains(self, value: T): Bool = {
        for i in 0..<self.len then {
            let physical = self.physical_index(i);
            if self.source[physical] == value then {
                return true;
            };
        };
        return false;
    };
};

/// `Iterable` for `Deque[T]`: hands out a fresh `DequeIterator[T]` on every call.
given[T: Any] Deque[T]: Iterable[T, DequeIterator[T]] {

    /// A fresh cursor at the front of the deque; the deque itself is left untouched.
    public iterator(self): DequeIterator[T] = DequeIterator[T](self, 0);
};

/// `Iterator` for `DequeIterator[T]`: yields elements from front to back.
given[T: Any] DequeIterator[T]: Iterator[T] {

    /// Return the next element front to back, or `None` once the cursor is exhausted.
    public next(self): Option[T] = {
        if self.index >= self.source.len then {
            return Option[T].None();
        };
        let index = (self.source.head + self.index) % self.source.cap;
        let value = self.source.source[index];
        self.index += 1;
        return Option[T].Some(value);
    };
};
