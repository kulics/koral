// ============================================================================
// Koral Standard Library - Deque Type
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives, traits, option,
// and list are already available.
// ============================================================================

public type mutable Deque[T Any](module_private mutable source *unsafe mutable T, module_private mutable len UInt, module_private mutable cap UInt, module_private mutable head UInt);

given[T Any] Deque[T] as Drop {

    drop(self) Void = {
        for i in 0..<self.len then {
            let index = (self.head + i) % self.cap;
            deinit_memory(self.source + index);
        };
        dealloc_memory(self.source);
    };
};

public type mutable DequeIterator[T Any](module_private source Deque[T], module_private mutable index UInt);

given[T Any] Deque[T] {

    public new() Self = {
        let cap UInt = 10;
        let source = alloc_memory[T](cap);
        return Deque[T](source, 0, cap, 0);
    };

    public with_capacity(capacity UInt) Self = {
        let cap = if capacity < 1 then 1 else capacity;
        let source = alloc_memory[T](cap);
        return Deque[T](source, 0, cap, 0);
    };

    public count(self) UInt = self.len;

    public reserve(self, additional UInt) Void = {
        self.ensure_capacity(self.len + additional);
    };

    public is_empty(self) Bool = self.len == 0;

    file_private physical_index(self, logical_index UInt) UInt = (self.head + logical_index) % self.cap;

    file_private ensure_capacity(self, min_capacity UInt) Void = {
        if min_capacity > self.cap then {
            let mutable new_cap = self.cap * 2;
            if new_cap < min_capacity then {
                new_cap = min_capacity;
            };
            let old_source = self.source;
            let old_len = self.len;
            let old_cap = self.cap;
            let old_head = self.head;
            let new_source = alloc_memory[T](new_cap);
            for i in 0..<old_len then {
                let old_index = (old_head + i) % old_cap;
                init_memory(new_source + i, take_memory(old_source + old_index));
            };
            dealloc_memory(old_source);
            self.source = new_source;
            self.cap = new_cap;
            self.head = 0;
        };
    };

    public push_back(self, value T) Void = {
        self.ensure_capacity(self.len + 1);
        let index = self.physical_index(self.len);
        init_memory(self.source + index, value);
        self.len = self.len + 1;
    };

    public push_front(self, value T) Void = {
        self.ensure_capacity(self.len + 1);
        self.head = (self.head + self.cap - 1) % self.cap;
        init_memory(self.source + self.head, value);
        self.len = self.len + 1;
    };

    public pop_front(self) Option[T] = {
        if self.len == 0 then {
            return Option[T].None();
        };
        let value = take_memory(self.source + self.head);
        self.head = (self.head + 1) % self.cap;
        self.len = self.len - 1;
        if self.len == 0 then {
            self.head = 0;
        };
        return Option[T].Some(value);
    };

    public pop_back(self) Option[T] = {
        if self.len == 0 then {
            return Option[T].None();
        };
        let index = self.physical_index(self.len - 1);
        let value = take_memory(self.source + index);
        self.len = self.len - 1;
        if self.len == 0 then {
            self.head = 0;
        };
        return Option[T].Some(value);
    };

    public first(self) Option[T] = self.get(0);

    public last(self) Option[T] = {
        if self.len == 0 then {
            return Option[T].None();
        };
        return self.get(self.len - 1);
    };

    public get(self, index UInt) Option[T] = {
        if index >= self.len then {
            return Option[T].None();
        };
        let physical = self.physical_index(index);
        return Option[T].Some(self.source[physical]);
    };

    file_private __index_get(self, key UInt) T = {
        if key >= self.len then {
            panic("Deque index out of bounds");
        };
        let physical = self.physical_index(key);
        return self.source[physical];
    };

    file_private __index_set(self, key UInt, value T) Void = {
        if key >= self.len then {
            panic("Deque index out of bounds");
        };
        let physical = self.physical_index(key);
        self.source[physical] = value;
    };

    public clear(self) Void = {
        for i in 0..<self.len then {
            let index = self.physical_index(i);
            deinit_memory(self.source + index);
        };
        self.len = 0;
        self.head = 0;
    };

    // Reverses the order of elements in-place. O(n).
    public reverse(self) Void = {
        if self.len <= 1 then {
            return;
        };
        let mutable left UInt = 0;
        let mutable right = self.len - 1;
        while left < right then {
            let lp = self.physical_index(left);
            let rp = self.physical_index(right);
            let tmp = self.source[lp];
            self.source[lp] = self.source[rp];
            self.source[rp] = tmp;
            left += 1;
            right -= 1;
        };
    };

    // Retains only elements satisfying the predicate, preserving order. O(n).
    public retain(self, predicate Func(T) Bool) Void = {
        if self.len == 0 then {
            return;
        };
        let mutable write UInt = 0;
        let mutable read UInt = 0;
        while read < self.len then {
            let rp = self.physical_index(read);
            let v = self.source[rp];
            if predicate(v) then {
                let wp = self.physical_index(write);
                if write <> read then {
                    init_memory(self.source + wp, take_memory(self.source + rp));
                };
                write += 1;
            } else {
                deinit_memory(self.source + rp);
            };
            read += 1;
        };
        self.len = write;
    };
};

given[T Any] Deque[T] as Clone {

    // Independent shallow copy: new deque identity, elements copied one level.
    public clone(self) Self = {
        let mutable result = Deque[T].with_capacity(self.len);
        for i in 0..<self.len then {
            result.push_back(self.source[self.physical_index(i)]);
        };
        return result;
    };
};

given[T Any] Deque[T] as Default {

    public default() Self = Deque[T].new();
};

given[T Eq] Deque[T] {

    public contains(self, value T) Bool = {
        for i in 0..<self.len then {
            let physical = self.physical_index(i);
            if self.source[physical] == value then {
                return true;
            };
        };
        return false;
    };
};

given[T Any] Deque[T] as Iterable[T, DequeIterator[T]] {

    public iterator(self) DequeIterator[T] = DequeIterator[T](self, 0);
};

given[T Any] DequeIterator[T] as Iterator[T] {

    public next(self) Option[T] = {
        if self.index >= self.source.len then {
            return Option[T].None();
        };
        let index = (self.source.head + self.index) % self.source.cap;
        let value = self.source.source[index];
        self.index += 1;
        return Option[T].Some(value);
    };
};
