// ============================================================================
// Koral Standard Library - Primitive Types
// ============================================================================

// SECTION 1: Primitive Types
public type intrinsic Bool;
public type intrinsic Never;
public type intrinsic Int;
public type intrinsic Int8;
public type intrinsic Int16;
public type intrinsic Int32;
public type intrinsic Int64;
public type intrinsic UInt;
public type intrinsic UInt8;
public type intrinsic UInt16;
public type intrinsic UInt32;
public type intrinsic UInt64;
public type intrinsic WrappingInt;
public type intrinsic WrappingInt8;
public type intrinsic WrappingInt16;
public type intrinsic WrappingInt32;
public type intrinsic WrappingInt64;
public type intrinsic WrappingUInt;
public type intrinsic WrappingUInt8;
public type intrinsic WrappingUInt16;
public type intrinsic WrappingUInt32;
public type intrinsic WrappingUInt64;
public type intrinsic Float32;
public type intrinsic Float64;

// ============================================================================
// SECTION 2: Memory Management Primitives
// ============================================================================
// Allocates uninitialized memory for `capacity` number of elements.
public let intrinsic alloc_memory[T Any](capacity UInt) *mutable T;

// Deallocates the memory pointed to by `*`.
// PRECONDITION: The memory must be deinitialized.
public let intrinsic dealloc_memory[T Any](p *T) Void;

// Copies `count` elements from `source` to `dest`. Regions must NOT overlap.
public let intrinsic copy_memory[T Any](
    dest *mutable T,
    source *T,
    count UInt,
) Void;

// Moves `count` elements from `source` to `dest`. Regions may overlap.
public let intrinsic move_memory[T Any](
    dest *mutable T,
    source *T,
    count UInt,
) Void;

// ============================================================================
// SECTION 3: Pointer Operations
// ============================================================================

// Pointer operations (global functions)
public let intrinsic init_memory[T Any](p *mutable T, value T) Void;
public let intrinsic deinit_memory[T Any](p *mutable T) Void;
public let intrinsic take_memory[T Any](p *mutable T) T;
public let intrinsic null_ptr[T Any]() *mutable T;

// Thread spawn intrinsic: creates a new OS thread executing the given closure.
// stack_size of 0 means default stack size.
// Returns 0 on success, non-zero on failure.
// The closure is passed by value to the C runtime which invokes and releases it.
public let intrinsic spawn_thread(
    out_handle *mutable *mutable UInt8,
    out_tid *mutable UInt64,
    f () -> Void,
    stack_size UInt64,
) Int32;

// ============================================================================
// SECTION 5b: Weak References
// ============================================================================

// Weak references are created with the `?T(x)` construction, where `T` is the
// strong type and `x` is the managed object. The weak reference does not
// prevent the object from being deallocated. `T` must be declared as
// 'type mutable'.
//
// A weak reference is tested and unwrapped with the `is ?v` pattern:
//   if w is ?v then use(v)        // binds the strong reference to v
//   w is not ?v                   // true when the object is dead
//   while w is ?v then process(v) // loop while the object is alive
//   let port = if w is ?v then v else 8080;

// ============================================================================
// SECTION 6: Float Bit Manipulation (runtime)
// ============================================================================
let foreign __koral_float32_to_bits(value Float32) UInt32;
let foreign __koral_float32_from_bits(bits UInt32) Float32;
let foreign __koral_float64_to_bits(value Float64) UInt64;
let foreign __koral_float64_from_bits(bits UInt64) Float64;

given Float32 {
    public to_bits(self) UInt32 = __koral_float32_to_bits(self);
    public from_bits(bits UInt32) Float32 = __koral_float32_from_bits(bits);
};

given Float64 {
    public to_bits(self) UInt64 = __koral_float64_to_bits(self);
    public from_bits(bits UInt64) Float64 = __koral_float64_from_bits(bits);
};

given Float32 {
    public inf() Float32 = Float32.from_bits(2139095040);
    public nan() Float32 = Float32.from_bits(2143289344);
    public min_normal() Float32 = Float32.from_bits(8388608);
    public min_denormal() Float32 = Float32.from_bits(1);

    public is_nan(self) Bool = {
        let bits = self.to_bits();
        let exp = (bits >> 23) & 255;
        let mantissa = bits & 8388607;
        return exp == 255 and mantissa != 0;
    };

    public is_inf(self) Bool = {
        let bits = self.to_bits();
        let exp = (bits >> 23) & 255;
        let mantissa = bits & 8388607;
        return exp == 255 and mantissa == 0;
    };

    public is_normal(self) Bool = {
        let bits = self.to_bits();
        let exp = (bits >> 23) & 255;
        return exp > 0 and exp < 255;
    };
};

given Float64 {
    public inf() Float64 = Float64.from_bits(UInt64(2047) << 52);
    public nan() Float64 = Float64.from_bits((UInt64(2047) << 52) | (UInt64(1) << 51));
    public min_normal() Float64 = Float64.from_bits(UInt64(1) << 52);
    public min_denormal() Float64 = Float64.from_bits(1);

    public is_nan(self) Bool = {
        let bits = self.to_bits();
        let exp = (bits >> 52) & 2047;
        let mantissa = bits & 4503599627370495;
        return exp == 2047 and mantissa != 0;
    };

    public is_inf(self) Bool = {
        let bits = self.to_bits();
        let exp = (bits >> 52) & 2047;
        let mantissa = bits & 4503599627370495;
        return exp == 2047 and mantissa == 0;
    };

    public is_normal(self) Bool = {
        let bits = self.to_bits();
        let exp = (bits >> 52) & 2047;
        return exp > 0 and exp < 2047;
    };
};

// ============================================================================
// SECTION 9: Float Classification Functions (is_finite, is_sign_positive, is_sign_negative)
// ============================================================================
given Float64 {
    public is_finite(self) Bool = {
        let bits = self.to_bits();
        let exp = (bits >> 52) & 2047;
        return exp != 2047;
    };

    public is_sign_positive(self) Bool = {
        let bits = self.to_bits();
        return (bits >> 63) == 0;
    };

    public is_sign_negative(self) Bool = {
        let bits = self.to_bits();
        return (bits >> 63) != 0;
    };
};

given Float32 {
    public is_finite(self) Bool = {
        let bits = self.to_bits();
        let exp = (bits >> 23) & 255;
        return exp != 255;
    };

    public is_sign_positive(self) Bool = {
        let bits = self.to_bits();
        return (bits >> 31) == 0;
    };

    public is_sign_negative(self) Bool = {
        let bits = self.to_bits();
        return (bits >> 31) != 0;
    };
};

// ============================================================================
// SECTION 10: Integer Bit Manipulation Functions
// ============================================================================

// --- UInt (64-bit) ---
given UInt {
    public is_power_of_two(self) Bool = self != 0 and (self & (self - 1)) == 0;

    public next_power_of_two(self) Self = if self == 0 then 1
    else if self.is_power_of_two() then self
    else {
        let mutable n = self - 1;
        n = n | (n >> 1);
        n = n | (n >> 2);
        n = n | (n >> 4);
        n = n | (n >> 8);
        n = n | (n >> 16);
        n = n | (n >> 32);
        n + 1
    };
};

// --- UInt64 (64-bit) ---
given UInt64 {
    public is_power_of_two(self) Bool = self != 0 and (self & (self - 1)) == 0;

    public next_power_of_two(self) Self = if self == 0 then 1
    else if self.is_power_of_two() then self
    else {
        let mutable n = self - 1;
        n = n | (n >> 1);
        n = n | (n >> 2);
        n = n | (n >> 4);
        n = n | (n >> 8);
        n = n | (n >> 16);
        n = n | (n >> 32);
        n + 1
    };
};

// --- UInt32 (32-bit) ---
given UInt32 {
    public is_power_of_two(self) Bool = self != 0 and (self & (self - 1)) == 0;

    public next_power_of_two(self) Self = if self == 0 then 1
    else if self.is_power_of_two() then self
    else {
        let mutable n = self - 1;
        n = n | (n >> 1);
        n = n | (n >> 2);
        n = n | (n >> 4);
        n = n | (n >> 8);
        n = n | (n >> 16);
        n + 1
    };
};

// --- UInt16 (16-bit) ---
given UInt16 {
    public is_power_of_two(self) Bool = self != 0 and (self & (self - 1)) == 0;

    public next_power_of_two(self) Self = if self == 0 then 1
    else if self.is_power_of_two() then self
    else {
        let mutable n = self - 1;
        n = n | (n >> 1);
        n = n | (n >> 2);
        n = n | (n >> 4);
        n = n | (n >> 8);
        n + 1
    };
};

// --- UInt8 (8-bit) ---
given UInt8 {
    public is_ascii(self) Bool = self < 128;

    public is_ascii_alphabetic(self) Bool =
        (self >= 'A' and self <= 'Z') or (self >= 'a' and self <= 'z');

    public is_ascii_alphanumeric(self) Bool =
        self.is_ascii_alphabetic() or self.is_ascii_digit();

    public is_ascii_digit(self) Bool = self >= '0' and self <= '9';

    public is_ascii_hexdigit(self) Bool =
        self.is_ascii_digit() or (self >= 'a' and self <= 'f') or (self >= 'A' and self <= 'F');

    public is_ascii_whitespace(self) Bool =
        self == ' ' or self == '\t' or self == '\n' or self == '\v' or self == '\f' or self == '\r';

    public is_ascii_uppercase(self) Bool = self >= 'A' and self <= 'Z';

    public is_ascii_lowercase(self) Bool = self >= 'a' and self <= 'z';

    public to_ascii_lowercase(self) UInt8 = if self.is_ascii_uppercase() then self + 32
    else self;

    public to_ascii_uppercase(self) UInt8 = if self.is_ascii_lowercase() then self - 32
    else self;

    public equals_ascii_ignore_case(self, other UInt8) Bool =
        self.to_ascii_lowercase() == other.to_ascii_lowercase();

    public is_power_of_two(self) Bool = self != 0 and (self & (self - 1)) == 0;

    public next_power_of_two(self) Self = if self == 0 then 1
    else if self.is_power_of_two() then self
    else {
        let mutable n = self - 1;
        n = n | (n >> 1);
        n = n | (n >> 2);
        n = n | (n >> 4);
        n + 1
    };
};

