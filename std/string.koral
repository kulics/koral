// ============================================================================
// Koral Standard Library - String Type
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives, traits, and option are already available.
// ============================================================================

// ============================================================================
// String Storage and Type Definition
// ============================================================================

/// String is immutable value data with fixed storage length.
/// The contents are UTF-8 bytes, so `count` measures bytes and not runes.
public type String(protected data: *mutable UInt8, protected len: UInt);

/// Intrinsic: allocate a single-block String of byte length `len` whose bytes
/// are not yet written (only byte `[len]` is set to 0). The bytes live in the
/// same heap block as the object -- one allocation -- and `data` points at
/// them; the RC release frees the whole block, so `Drop` has nothing to free.
/// The caller must fill every byte before reading. Internal plumbing for the
/// constructors below and the compiler's interpolation lowering -- not a user
/// API; the runtime side is `__koral_string_alloc` (see std/koral_runtime.h
/// for the ABI note).
let intrinsic alloc_string(len: UInt): String;

/// Mutable builder for incremental string construction without relying on String alias mutation.
public type mutable StringBuilder(
    mutable data: *mutable UInt8,
    mutable len: UInt,
    mutable cap: UInt,
);

// String iterator types
/// Iterator over the whitespace-separated words of a string.
public type mutable StringSplitAsciiWhitespaceIterator(
    source: String,
    mutable index: UInt,
);

/// Iterator over the parts of a string separated by a fixed separator.
public type mutable StringSplitIterator(
    source: String,
    sep: String,
    mutable index: UInt,
);

/// Iterator over the lines of a string, split at `\n`.
public type mutable StringLinesIterator(source: String, mutable index: UInt);

/// Iterator over the raw UTF-8 bytes of a string.
public type mutable StringBytesIterator(source: String, mutable index: UInt);

/// `Drop` for `String`: nothing to free. The bytes live in the same heap block
/// as the object (`alloc_string`, see above), and the RC release frees the
/// whole block after the destructor runs. `Drop` is kept to pin the managed
/// layout -- a bare `type String` would be an unboxed {data, len} whose copies
/// double-free the shared buffer.
given String: Drop {
    /// Nothing to free here: the bytes live in the object's own heap block,
    /// which the RC release frees whole. See the note above.
    public drop(self): Void = {};
};

/// `Drop` for `StringBuilder`: frees the builder's buffer.
given StringBuilder: Drop {

    /// Release the buffer owned by the builder.
    public drop(self): Void = {
        dealloc_memory(self.data);
    };
};

/// Construction and incremental building of strings.
given StringBuilder {

    /// Create an empty builder with a small initial capacity.
    public new(): StringBuilder = StringBuilder.with_capacity(16);

    /// Create an empty builder with room for at least `capacity` bytes.
    public with_capacity(capacity: UInt): StringBuilder = {
        let cap = if capacity < 1 then 1 else capacity + 1;
        let data = alloc_memory[UInt8](cap);
        init_memory(data, 0);
        return StringBuilder(data, 0, cap);
    };

    /// The number of bytes pushed so far.
    public count(self): UInt = self.len;

    /// Whether nothing has been pushed yet.
    public is_empty(self): Bool = self.len == 0;

    private ensure_capacity(self, min_cap: UInt): Void = {
        if self.cap >= min_cap then {
            return;
        };
        self.grow_to(min_cap);
    };

    /// The growth body behind `ensure_capacity`, kept out of line on purpose --
    /// same shape and reason as `List.grow_to` (see std/list.koral).
    private grow_to(self, min_cap: UInt): Void = {
        let mutable new_cap = self.cap * 2;
        if new_cap < min_cap then {
            new_cap = min_cap;
        };
        let new_data = alloc_memory[UInt8](new_cap);
        copy_memory(new_data, self.data, self.len + 1);
        dealloc_memory(self.data);
        self.data = new_data;
        self.cap = new_cap;
    };

    /// Append one raw byte to the builder.
    /// The caller must keep the accumulated bytes valid UTF-8.
    public push_byte(self, value: UInt8): Void = {
        self.ensure_capacity(self.len + 2);
        init_memory(self.data + self.len, value);
        self.len = self.len + 1;
        self.data[self.len] = 0;
    };

    /// Append `other`, where `span` picks which slice to append, defaulting to
    /// all of it -- the same shape as `List.push_list` (std/list.koral) and `Reader.read`.
    public push_string(self, other: String, span: Range[UInt] = ...): Void = {
        let spec = other.slice_spec(span);
        let copy_len = spec.len();
        if copy_len == 0 then {
            return;
        };
        self.ensure_capacity(self.len + copy_len + 1);
        copy_memory(self.data + self.len, other.borrow_ptr() + spec.start(), copy_len);
        self.len = self.len + copy_len;
        self.data[self.len] = 0;
    };

    /// Encode `rune` in UTF-8 and append it, substituting the replacement
    /// character for an invalid rune.
    public push_rune(self, rune: Rune): Void = {
        let cp = rune.value;

        if not rune.is_valid() then {
            self.push_byte(UInt8(239));
            self.push_byte(UInt8(191));
            self.push_byte(UInt8(189));
            return;
        };

        if cp < UInt32(128) then {
            self.push_byte(UInt8(cp));
            return;
        };

        if cp < UInt32(2048) then {
            self.push_byte(UInt8((cp >> 6)) | UInt8(192));
            self.push_byte(UInt8((cp & UInt32(63))) | UInt8(128));
            return;
        };

        if cp < UInt32(65536) then {
            self.push_byte(UInt8((cp >> 12)) | UInt8(224));
            self.push_byte(UInt8(((cp >> 6) & UInt32(63))) | UInt8(128));
            self.push_byte(UInt8((cp & UInt32(63))) | UInt8(128));
            return;
        };

        self.push_byte(UInt8((cp >> 18)) | UInt8(240));
        self.push_byte(UInt8(((cp >> 12) & UInt32(63))) | UInt8(128));
        self.push_byte(UInt8(((cp >> 6) & UInt32(63))) | UInt8(128));
        self.push_byte(UInt8((cp & UInt32(63))) | UInt8(128));
    };

    /// Empty the builder, keeping its allocated capacity.
    public clear(self): Void = {
        self.len = 0;
        self.data[0] = 0;
    };

    /// Return a stable snapshot that does not alias future builder mutations.
    public to_string(self): String = String.from_utf8_ptr_unchecked(self.data, self.len);
};

// ============================================================================
// String Methods
// ============================================================================
/// Construction, inspection, searching, and transformation of `String` values.
given String {

    /// Unsafe constructor: copy `len` bytes without validating UTF-8.
    /// Behavior is undefined when those bytes are not valid UTF-8.
    public from_utf8_ptr_unchecked(bytes: *UInt8, len: UInt): String = {
        let s = alloc_string(len);
        copy_memory(s.data, bytes, len);
        return s;
    };

    // Validate UTF-8 byte sequence (strict)
    private validate_utf8(bytes: *UInt8, len: UInt): Bool = {
        let mutable i: UInt = 0;
        while i < len then {
            let b0 = bytes[i];
            // 1-ASCII(byte )
            if b0 < 128 then {
                i += 1;
                continue;
            };
            // Continuation byte as leading byte
            if b0 < 192 then {
                return false;
            };
            // 2-byte sequence
            if b0 < 224 then {
                if i + 1 >= len then {
                    return false;
                };
                let b1 = bytes[i + 1];
                if (b1 & 192) != 128 then {
                    return false;
                };
                let cp = ((UInt32(b0) & 31) << 6) | (UInt32(b1) & 63);
                if cp < 128 then {
                    return false;
                };
                i += 2;
                continue;
            };
            // 3-byte sequence
            if b0 < 240 then {
                if i + 2 >= len then {
                    return false;
                };
                let b1 = bytes[i + 1];
                let b2 = bytes[i + 2];
                if (b1 & 192) != 128 or (b2 & 192) != 128 then {
                    return false;
                };
                let cp = ((UInt32(b0) & 15) << 12) | ((UInt32(b1) & 63) << 6) | (UInt32(
                    b2,
                ) & 63);
                if cp < 2048 then {
                    return false;
                };
                if cp >= 55296 and cp <= 57343 then {
                    return false;
                };
                i += 3;
                continue;
            };
            // 4-byte sequence
            if b0 < 248 then {
                if i + 3 >= len then {
                    return false;
                };
                let b1 = bytes[i + 1];
                let b2 = bytes[i + 2];
                let b3 = bytes[i + 3];
                if (b1 & 192) != 128 or (b2 & 192) != 128 or (b3 & 192) != 128 then {
                    return false;
                };
                let cp = ((UInt32(b0) & 7) << 18) | ((UInt32(b1) & 63) << 12) | ((UInt32(
                    b2,
                ) & 63) << 6) | (UInt32(b3) & 63);
                if cp < 65536 or cp > 1114111 then {
                    return false;
                };
                i += 4;
                continue;
            };
            // Invalid leading byte (>= 248)
            return false;
        };
        return true;
    };

    /// Checked constructor: copy `len` bytes, validating UTF-8.
    /// Return an error when the bytes are not valid UTF-8.
    public from_utf8_ptr(bytes: *UInt8, len: UInt): Result[String] = {
        if not String.validate_utf8(bytes, len) then {
            return Result[String].Error("Invalid UTF-8");
        };
        return Result[String].Ok(String.from_utf8_ptr_unchecked(bytes, len));
    };

    /// Copy `bytes` into a string, returning an error when they are not valid UTF-8.
    public from_bytes(bytes: List[UInt8]): Result[String] =
        String.from_utf8_ptr(bytes.borrow_ptr(), bytes.count());

    /// Copy `bytes` into a string without validating UTF-8.
    /// Behavior is undefined when those bytes are not valid UTF-8.
    public from_bytes_unchecked(bytes: List[UInt8]): String =
        String.from_utf8_ptr_unchecked(bytes.borrow_ptr(), bytes.count());

    /// Build a string from a null-terminated C string, returning an error when
    /// it is not valid UTF-8.
    public from_cstring(cstr: *UInt8): Result[String] = {
        let mutable len: UInt = 0;
        while cstr[len] != UInt8(0) then {
            len += 1;
        };
        return String.from_utf8_ptr(cstr, len);
    };

    /// Build a string from a null-terminated C string without validating UTF-8.
    /// Behavior is undefined when the bytes are not valid UTF-8.
    public from_cstring_unchecked(cstr: *UInt8): String = {
        let mutable len: UInt = 0;
        while cstr[len] != UInt8(0) then {
            len += 1;
        };
        return String.from_utf8_ptr_unchecked(cstr, len);
    };

    /// Create an empty string.
    public new(): String = alloc_string(UInt(0));

    // Using comparison patterns for ASCII space check
    private is_ascii_space(b: UInt8): Bool = {
        if b == ' ' then {
            return true;
        };
        if b == '\t' then {
            return true;
        };
        if b == '\n' then {
            return true;
        };
        if b == '\v' then {
            return true;
        };
        if b == '\f' then {
            return true;
        };
        if b == '\r' then {
            return true;
        };
        return false;
    };

    private bounds_check_read(self, index: UInt): Void = {
        if index > self.len then {
            panic("String index out of bounds");
        };
    };

    /// The length of the string in UTF-8 bytes, not runes.
    public count(self): UInt = self.len;
    /// Whether the string is empty.
    public is_empty(self): Bool = self.len == 0;
    /// Borrow the internal null-terminated bytes; valid while the string lives.
    public borrow_ptr(self): *UInt8 = self.data;

    /// The writable byte tail of a just-`alloc_string`-ed value. Only std's
    /// constructors and the compiler's interpolation lowering fill through it
    /// -- writing into a published string breaks the immutability contract.
    protected mutable_bytes(self): *mutable UInt8 = self.data;

    /// Return the UTF-8 bytes as a new list.
    public to_bytes(self): List[UInt8] = {
        let len = self.len;
        let mutable bytes = make_bytes(len);
        if len == 0 then {
            return bytes;
        };
        copy_memory(bytes.borrow_mut_ptr(), self.data, len);
        return bytes;
    };

    /// Return the byte at `index`, or `None` when it is past the end.
    /// The index is a byte offset and need not be a rune boundary.
    public get(self, index: UInt): Option[UInt8] = {
        if index >= self.len then {
            return Option[UInt8].None();
        };
        return Option[UInt8].Some(self.data[index]);
    };

    private __index_get(self, key: UInt): UInt8 = {
        if key >= self.len then {
            panic("String index out of bounds");
        };
        return self.data[key];
    };

    /// Whether the string begins with `prefix`.
    public starts_with(self, prefix: String): Bool = {
        if prefix.len > self.len then {
            return false;
        };
        for i in 0..<prefix.len then {
            if self.data[i] != prefix.data[i] then {
                return false;
            };
        };
        return true;
    };

    /// Whether the string ends with `suffix`.
    public ends_with(self, suffix: String): Bool = {
        if suffix.len > self.len then {
            return false;
        };
        let offset = self.len - suffix.len;
        for i in 0..<suffix.len then {
            if self.data[offset + i] != suffix.data[i] then {
                return false;
            };
        };
        return true;
    };

    /// Return the byte index of the first occurrence of `pat`, or `None` when
    /// absent; an empty pattern never matches.
    public find(self, pat: String): Option[UInt] = self.find_from(0, pat);

    /// Return the byte index of the last occurrence of `pat`, or `None` when
    /// absent; an empty pattern never matches.
    public find_last(self, pat: String): Option[UInt] = {
        if pat.len == 0 then {
            return Option[UInt].None();
        };
        let mutable result = Option[UInt].None();
        let mutable start: UInt = 0;
        // Using while is pattern matching for iterator-like loop
        while self.find_from(start, pat) is .Some(idx) then {
            result = Option[UInt].Some(idx);
            start = idx + 1;
        };
        return result;
    };

    private make_substring(self, start: UInt, len: UInt): String = {
        if start + len > self.len then {
            panic("substring out of bounds");
        };
        let s = alloc_string(len);
        copy_memory(s.data, self.data + start, len);
        return s;
    };

    private is_utf8_continuation_byte(b: UInt8): Bool = (b & 192) == 128;

    /// Whether `byte_index` falls on a rune boundary: 0, the byte length, or the
    /// start of a UTF-8 sequence; `false` when the index is past the end.
    public is_rune_boundary(self, byte_index: UInt): Bool = {
        if byte_index > self.len then {
            return false;
        };
        if byte_index == 0 or byte_index == self.len then {
            return true;
        };
        return not String.is_utf8_continuation_byte(self.data[byte_index]);
    };

    private validate_substring_bounds(self, start: UInt, end: UInt): Void = {
        if start > end then {
            panic("substring invalid range");
        };
        if end > self.len then {
            panic("substring out of bounds");
        };
        if not self.is_rune_boundary(start) or not self.is_rune_boundary(end) then {
            panic("substring boundaries must be rune boundaries");
        };
    };

    /// Resolve `range` into the byte span it names, panicking when the range is
    /// invalid or out of bounds or lands off a rune boundary.
    public slice_spec(self, range: Range[UInt]): SliceSpec = {
        let len = self.len;
        let mutable start: UInt = 0;
        let mutable end: UInt = 0;

        when range in {
            .Closed(s, e) then {
                if s > e then {
                    panic("String.slice_spec invalid range");
                };
                if e >= len then {
                    panic("String.slice_spec out of bounds");
                };
                start = s;
                end = e + 1;
            },
            .ClosedOpen(s, e) then {
                if s > e then {
                    panic("String.slice_spec invalid range");
                };
                if e > len then {
                    panic("String.slice_spec out of bounds");
                };
                start = s;
                end = e;
            },
            .OpenClosed(s, e) then {
                if s > e then {
                    panic("String.slice_spec invalid range");
                };
                if s == UInt.max_value() or e >= len then {
                    panic("String.slice_spec out of bounds");
                };
                start = s + 1;
                end = e + 1;
            },
            .Open(s, e) then {
                if s > e then {
                    panic("String.slice_spec invalid range");
                };
                if s == UInt.max_value() or e > len then {
                    panic("String.slice_spec out of bounds");
                };
                // Open(s, s) names no bytes: the empty slice at s, exactly like
                // ClosedOpen(s, s). (start = s + 1 would push an empty spec
                // past the end when s == len.)
                if s == e then {
                    start = s;
                } else {
                    start = s + 1;
                };
                end = e;
            },
            .From(s) then {
                if s > len then {
                    panic("String.slice_spec out of bounds");
                };
                start = s;
                end = len;
            },
            .After(s) then {
                if s >= len then {
                    panic("String.slice_spec out of bounds");
                };
                start = s + 1;
                end = len;
            },
            .To(e) then {
                if e >= len then {
                    panic("String.slice_spec out of bounds");
                };
                start = 0;
                end = e + 1;
            },
            .Until(e) then {
                if e > len then {
                    panic("String.slice_spec out of bounds");
                };
                start = 0;
                end = e;
            },
            .Full() then {
                start = 0;
                end = len;
            },
        };

        self.validate_substring_bounds(start, end);
        return SliceSpec.new(offset = start, len = end - start);
    };

    /// Return the substring that `range` names.
    /// Panics when the range is invalid, out of bounds, or off a rune boundary.
    public substring(self, range: Range[UInt]): String = {
        let span = self.slice_spec(range);
        return self.make_substring(span.start(), span.len());
    };

    /// Return the string with leading ASCII whitespace removed.
    public trim_ascii_start(self): String = {
        let mutable i: UInt = 0;
        while i < self.len and String.is_ascii_space(self.data[i]) then {
            i += 1;
        };
        return self.make_substring(i, self.len - i);
    };

    /// Return the string with trailing ASCII whitespace removed.
    public trim_ascii_end(self): String = {
        let mutable end = self.len;
        while end > 0 and String.is_ascii_space(self.data[end - 1]) then {
            end -= 1;
        };
        return self.make_substring(0, end);
    };

    /// Return the string with leading and trailing ASCII whitespace removed.
    public trim_ascii(self): String = {
        let head = self.trim_ascii_start();
        return head.trim_ascii_end();
    };

    /// Whether every byte is ASCII (below 128).
    public is_ascii(self): Bool = {
        for i in 0..<self.len then {
            if self.data[i] >= 128 then {
                return false;
            };
        };
        return true;
    };

    /// Whether the string is empty or holds only ASCII whitespace.
    public is_ascii_whitespace(self): Bool = {
        for i in 0..<self.len then {
            if not String.is_ascii_space(self.data[i]) then {
                return false;
            };
        };
        return true;
    };

    // Using comparison patterns for case conversion
    private to_lower_byte(b: UInt8): UInt8 = if b is >= 65 and is <= 90 then b + 32
    else b;
    private to_upper_byte(b: UInt8): UInt8 = if b is >= 97 and is <= 122 then b - 32
    else b;

    /// Return a copy with ASCII letters lowercased; other bytes are unchanged.
    public to_ascii_lowercase(self): String = {
        let s = alloc_string(self.len);
        for i in 0..<self.len then {
            init_memory(s.data + i, String.to_lower_byte(self.data[i]));
        };
        return s;
    };

    /// Return a copy with ASCII letters uppercased; other bytes are unchanged.
    public to_ascii_uppercase(self): String = {
        let s = alloc_string(self.len);
        for i in 0..<self.len then {
            init_memory(s.data + i, String.to_upper_byte(self.data[i]));
        };
        return s;
    };

    /// Return a copy with each ASCII word titlecased: its first letter upper,
    /// the rest lower.
    public to_ascii_titlecase(self): String = {
        let s = alloc_string(self.len);
        let mutable in_word = false;
        for i in 0..<self.len then {
            let b = self.data[i];
            if String.is_ascii_space(b) then {
                in_word = false;
                init_memory(s.data + i, b);
            } else {
                if not in_word then {
                    in_word = true;
                    init_memory(s.data + i, String.to_upper_byte(b));
                } else {
                    init_memory(s.data + i, String.to_lower_byte(b));
                };
            };
        };
        return s;
    };

    /// Search from byte index `start` for the first occurrence of `pat`, returning
    /// its index or `None`; panics when `start` is past the end.
    public find_from(self, start: UInt, pat: String): Option[UInt] = {
        if pat.len == 0 then {
            return Option[UInt].None();
        };
        if start > self.len then {
            panic("find start out of bounds");
        };
        if pat.len > self.len then {
            return Option[UInt].None();
        };
        let mutable i = start;
        let max = self.len - pat.len;
        while i <= max then {
            let mutable j: UInt = 0;
            let mutable ok = true;
            while j < pat.len then {
                if self.data[i + j] != pat.data[j] then {
                    ok = false;
                    break;
                };
                j += 1;
            };
            if ok then {
                return Option[UInt].Some(i);
            };
            i += 1;
        };
        return Option[UInt].None();
    };

    /// Whether `pat` occurs anywhere in the string.
    public contains(self, pat: String): Bool = self.find_from(0, pat).is_some();

    /// Return the string repeated `times` times, or the empty string when `times` is 0.
    public repeat(self, times: UInt): String = {
        if times == 0 then {
            return String.new();
        };
        let total = self.len * times;
        let s = alloc_string(total);
        let mutable offset: UInt = 0;
        for _ in 0..<times then {
            copy_memory(s.data + offset, self.data, self.len);
            offset += self.len;
        };
        return s;
    };

    /// Replace only the first `n` occurrences of `pat` with `with`.
    /// If `n` is 0, return a copy of the string unchanged; panic on an empty `pat`.
    public replace_n(self, pat: String, n: UInt, with: String =): String = {
        if pat.len == 0 then {
            panic("replace empty pattern");
        };
        if n == 0 then {
            return self.make_substring(0, self.len);
        };
        let mutable result = StringBuilder.new();
        let mutable start: UInt = 0;
        let mutable count: UInt = 0;
        while count < n then {
            when self.find_from(start, pat) in {
                .Some(idx) then {
                    let prefix_len = idx - start;
                    if prefix_len > 0 then {
                        let slice = self.make_substring(start, prefix_len);
                        result.push_string(slice);
                    };
                    result.push_string(with);
                    start = idx + pat.len;
                    count += 1;
                },
                .None() then {
                    count = n; // break
                },
            };
        };
        if start < self.len then {
            let tail = self.make_substring(start, self.len - start);
            result.push_string(tail);
        };
        return result.to_string();
    };

    /// Split on the first occurrence of `sep`, returning (before, after).
    /// Return `None` when `sep` is not found.
    public split_once(self, sep: String): Option[Pair[String, String]] = {
        when self.find(sep) in {
            .Some(idx) then {
                let before = self.make_substring(0, idx);
                let after_start = idx + sep.len;
                let after = self.make_substring(after_start, self.len - after_start);
                return Option[Pair[String, String]].Some(Pair(before, after));
            },
            .None() then {
                return Option[Pair[String, String]].None();
            },
        };
    };

    /// Split on the last occurrence of `sep`, returning (before, after).
    /// Return `None` when `sep` is not found.
    public split_last_once(self, sep: String): Option[Pair[String, String]] = {
        when self.find_last(sep) in {
            .Some(idx) then {
                let before = self.make_substring(0, idx);
                let after_start = idx + sep.len;
                let after = self.make_substring(after_start, self.len - after_start);
                return Option[Pair[String, String]].Some(Pair(before, after));
            },
            .None() then {
                return Option[Pair[String, String]].None();
            },
        };
    };

    /// Replace every occurrence of `pat` with `with`, left to right without overlap.
    /// Panic on an empty `pat`; with no match, return the string unchanged.
    public replace_all(self, pat: String, with: String =): String = {
        if pat.len == 0 then {
            panic("replace empty pattern");
        };
        let mutable result = StringBuilder.new();
        let mutable start: UInt = 0;
        // Using while is pattern matching
        while self.find_from(start, pat) is .Some(idx) then {
            let prefix_len = idx - start;
            if prefix_len > 0 then {
                let slice = self.make_substring(start, prefix_len);
                result.push_string(slice);
            };
            result.push_string(with);
            start = idx + pat.len;
        };
        if start < self.len then {
            let tail = self.make_substring(start, self.len - start);
            result.push_string(tail);
        };
        return result.to_string();
    };

    /// Return an iterator over the words separated by runs of ASCII whitespace;
    /// leading and trailing whitespace produce no empty words.
    public split_ascii_whitespace(self): StringSplitAsciiWhitespaceIterator =
        StringSplitAsciiWhitespaceIterator(self, 0);

    /// Return an iterator over the parts between occurrences of `sep`.
    /// With no match the whole string is one part; an empty `sep` yields it once.
    public split(self, sep: String): StringSplitIterator = {
        return StringSplitIterator(self, sep, 0);
    };

    /// Return an iterator over the lines split at `\n`, without the newline.
    /// A trailing newline does not produce an extra empty line.
    public lines(self): StringLinesIterator = StringLinesIterator(self, 0);

    /// Return the string without `prefix`, or unchanged when there is no such prefix.
    public trim_prefix(self, prefix: String): String = if self.starts_with(prefix) then self.make_substring(
        prefix.len,
        self.len - prefix.len,
    ) else self;

    /// Return the string without `suffix`, or unchanged when there is no such suffix.
    public trim_suffix(self, suffix: String): String = {
        if self.ends_with(suffix) then {
            let remain = self.len - suffix.len;
            return self.make_substring(0, remain);
        } else {
            return self;
        };
    };

    /// Return the string without `prefix`, or `None` when there is no such prefix.
    public strip_prefix(self, prefix: String): Option[String] = {
        if self.starts_with(prefix) then {
            return Option[String].Some(
                self.make_substring(prefix.len, self.len - prefix.len),
            );
        };
        return Option[String].None();
    };

    /// Return the string without `suffix`, or `None` when there is no such suffix.
    public strip_suffix(self, suffix: String): Option[String] = {
        if self.ends_with(suffix) then {
            let remain = self.len - suffix.len;
            return Option[String].Some(self.make_substring(0, remain));
        };
        return Option[String].None();
    };

    /// Return an iterator over the raw UTF-8 bytes.
    public bytes(self): StringBytesIterator = StringBytesIterator(self, 0);

    /// Return an iterator over the runes (Unicode code points) decoded from UTF-8.
    public runes(self): StringRunesIterator = StringRunesIterator(self, 0);

    /// Convert the string to a `List` of runes for random access.
    public to_runes(self): List[Rune] = {
        let mutable list = List[Rune].new();
        for r in self.runes() then {
            list.push(r);
        };
        return list;
    };
};

/// `Default` for `String`: the empty string.
given String: Default {

    /// Create an empty string.
    public default(): Self = String.new();
};

/// `Eq` for `String`: equal when both hold the same UTF-8 bytes.
given String: Eq {

    /// Whether both strings hold the same UTF-8 bytes.
    public equals(self, other: String): Bool = {
        if self.len != other.len then {
            return false;
        };
        return compare_memory(self.borrow_ptr(), other.borrow_ptr(), self.len) == 0;
    };
};

/// `Ord` for `String`: byte-wise lexicographic order over the UTF-8 bytes.
given String: Ord {

    /// Compare byte-wise, returning -1, 0, or 1; a prefix sorts before its extension.
    public compare(self, other: String): Int = {
        let min = if self.len < other.len then self.len else other.len;
        let c = compare_memory(self.borrow_ptr(), other.borrow_ptr(), min);
        if c < 0 then {
            return 0 - 1;
        };
        if c > 0 then {
            return 1;
        };
        return if self.len < other.len then 0 - 1
        else if self.len > other.len then 1 else 0;
    };
};

/// `Hash` for `String`: hashes the UTF-8 bytes.
given String: Hash {

    /// Hash the UTF-8 bytes in order.
    public hash(self): UInt = {
        let mutable h: UInt = 2166136261;
        for i in 0..<self.len then {
            let b: UInt8 = self.data[i];
            h = h.combine_hash(UInt(b));
        };
        return h;
    };
};

// ============================================================================
// String Iterator Implementations - Using new pattern matching
// ============================================================================

// Iterator types provide next() method
/// `Iterator[String]` for `StringSplitAsciiWhitespaceIterator`: yields the
/// whitespace-separated words one at a time.
given StringSplitAsciiWhitespaceIterator: Iterator[String] {

    /// Advance the iterator and return the next word, or `None` when exhausted.
    public next(self): Option[String] = {
        let len = self.source.count();
        let mutable i = self.index;
        while i < len and String.is_ascii_space(self.source[i]) then {
            i += 1;
        };
        if i >= len then {
            return Option[String].None();
        };
        let start = i;
        while i < len and not String.is_ascii_space(self.source[i]) then {
            i += 1;
        };
        let part = self.source.make_substring(start, i - start);
        self.index = i;
        return Option[String].Some(part);
    };
};

/// `Iterator[String]` for `StringSplitIterator`: yields the parts between
/// separators one at a time.
given StringSplitIterator: Iterator[String] {

    /// Advance the iterator and return the next part, or `None` when exhausted.
    public next(self): Option[String] = {
        let len = self.source.count();
        if self.sep.count() == 0 then {
            if self.index == 0 then {
                self.index = len + 1;
                return Option[String].Some(self.source.make_substring(0, len));
            };
            return Option[String].None();
        };
        if self.index > len then {
            return Option[String].None();
        };
        when self.source.find_from(self.index, self.sep) in {
            .Some(i) then {
                let part = self.source.make_substring(self.index, i - self.index);
                self.index = i + self.sep.count();
                return Option[String].Some(part);
            },
            .None() then {
                let part = self.source.make_substring(self.index, len - self.index);
                self.index = len + 1;
                return Option[String].Some(part);
            },
        };
    };
};

/// `Iterator[String]` for `StringLinesIterator`: yields the lines one at a time.
given StringLinesIterator: Iterator[String] {

    /// Advance the iterator and return the next line, or `None` when exhausted.
    public next(self): Option[String] = {
        let len = self.source.count();
        if self.index > len then {
            return Option[String].None();
        };
        if self.index == len then {
            self.index = len + 1;
            return Option[String].None();
        };
        when self.source.find_from(self.index, "\n") in {
            .Some(i) then {
                let part = self.source.make_substring(self.index, i - self.index);
                self.index = i + 1;
                return Option[String].Some(part);
            },
            .None() then {
                let part = self.source.make_substring(self.index, len - self.index);
                self.index = len + 1;
                return Option[String].Some(part);
            },
        };
    };
};

// ============================================================================
// Rune Iterator Types
// ============================================================================

/// Iterator over the runes of a string, decoding UTF-8 as it goes.
public type mutable StringRunesIterator(source: String, mutable byte_index: UInt);

/// `Iterator[Rune]` for `StringRunesIterator`: yields the decoded runes one at a time.
given StringRunesIterator: Iterator[Rune] {

    /// Decode the next UTF-8 sequence and return it as a rune.
    /// An invalid sequence decodes to the replacement character.
    public next(self): Option[Rune] = {
        let len = self.source.count();
        if self.byte_index >= len then {
            return Option[Rune].None();
        };

        let b0 = self.source[self.byte_index];

        // 1-byte ASCII(sequence ): 0xxxxxxx
        if b0 < 128 then {
            self.byte_index = self.byte_index + 1;
            return Option[Rune].Some(Rune(UInt32(b0)));
        };

        // Invalid: continuation byte as first byte
        if b0 < 192 then {
            self.byte_index = self.byte_index + 1;
            return Option[Rune].Some(Rune.replacement_char());
        };

        // 2-byte sequence: 110xxxxx 10xxxxxx
        if b0 < 224 then {
            if self.byte_index + 1 >= len then {
                self.byte_index = self.byte_index + 1;
                return Option[Rune].Some(Rune.replacement_char());
            };
            let b1 = self.source[self.byte_index + 1];
            if (b1 & 192) != 128 then {
                self.byte_index = self.byte_index + 1;
                return Option[Rune].Some(Rune.replacement_char());
            };
            let cp = ((UInt32(b0) & 31) << 6) | (UInt32(b1) & 63);
            // Check for overlong encoding
            if cp < 128 then {
                self.byte_index = self.byte_index + 2;
                return Option[Rune].Some(Rune.replacement_char());
            };
            self.byte_index = self.byte_index + 2;
            return Option[Rune].Some(Rune(cp));
        };

        // 3-byte sequence: 1110xxxx 10xxxxxx 10xxxxxx
        if b0 < 240 then {
            if self.byte_index + 2 >= len then {
                self.byte_index = self.byte_index + 1;
                return Option[Rune].Some(Rune.replacement_char());
            };
            let b1 = self.source[self.byte_index + 1];
            let b2 = self.source[self.byte_index + 2];
            if (b1 & 192) != 128 or (b2 & 192) != 128 then {
                self.byte_index = self.byte_index + 1;
                return Option[Rune].Some(Rune.replacement_char());
            };
            let cp = ((UInt32(b0) & 15) << 12) | ((UInt32(b1) & 63) << 6) | (UInt32(b2) & 63);
            // Check for overlong encoding or surrogate
            if cp < 2048 or (cp >= 55296 and cp <= 57343) then {
                self.byte_index = self.byte_index + 3;
                return Option[Rune].Some(Rune.replacement_char());
            };
            self.byte_index = self.byte_index + 3;
            return Option[Rune].Some(Rune(cp));
        };

        // 4-byte sequence: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
        if b0 < 248 then {
            if self.byte_index + 3 >= len then {
                self.byte_index = self.byte_index + 1;
                return Option[Rune].Some(Rune.replacement_char());
            };
            let b1 = self.source[self.byte_index + 1];
            let b2 = self.source[self.byte_index + 2];
            let b3 = self.source[self.byte_index + 3];
            if (b1 & 192) != 128 or (b2 & 192) != 128 or (b3 & 192) != 128 then {
                self.byte_index = self.byte_index + 1;
                return Option[Rune].Some(Rune.replacement_char());
            };
            let cp = ((UInt32(b0) & 7) << 18) | ((UInt32(b1) & 63) << 12) | ((UInt32(b2) & 63) << 6) | (UInt32(
                b3,
            ) & 63);
            // Check for overlong encoding or out of range
            if cp < 65536 or cp > 1114111 then {
                self.byte_index = self.byte_index + 4;
                return Option[Rune].Some(Rune.replacement_char());
            };
            self.byte_index = self.byte_index + 4;
            return Option[Rune].Some(Rune(cp));
        };

        // Invalid first byte
        self.byte_index = self.byte_index + 1;
        return Option[Rune].Some(Rune.replacement_char());
    };
};

// ============================================================================
// String Bytes Iterator
// ============================================================================
/// `Iterator[UInt8]` for `StringBytesIterator`: yields the UTF-8 bytes one at a time.
given StringBytesIterator: Iterator[UInt8] {

    /// Advance the iterator and return the next byte, or `None` when exhausted.
    public next(self): Option[UInt8] = {
        if self.index >= self.source.count() then {
            return Option[UInt8].None();
        };
        let b = self.source.get(self.index).unwrap();
        self.index += 1;
        return Option[UInt8].Some(b);
    };
};
