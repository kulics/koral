using "std" { ... };
// ============================================================================
// std.rand - Trait Definitions
// ============================================================================
// RandomSource: core random number generator interface (stateful source)
// Randomizable: type conversion from random bits
// ============================================================================

// RandomSource trait — core random number generator interface.
// `generate` advances the source's own progression state without consuming the
// receiver. An implementor is a handle around shared mutable state, so it MUST
// be declared `type mutable` — declaring it `type` would claim the sharing is
// unobservable while every `generate` call is observable through it.
public trait RandomSource {
    generate(self) UInt64;
};

// Randomizable trait — defines how to produce a random value of Self
// from any RandomSource. The source stays a plain parameter: a `type mutable`
// source is passed as the shared handle it is, so call sites need no ceremony.
public trait Randomizable {
    random[R RandomSource](source R) Self;
};
