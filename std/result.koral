// ============================================================================
// Koral Standard Library - Result Type
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives, traits, and option are already available.
// ============================================================================

// ============================================================================
// Result Type Definition
// ============================================================================
/// The outcome of a fallible operation: `Ok` carrying a value or `Error` carrying a failure.
public type Result[T: Any] {
    Ok(value: T),
    Error(error: Error),
};

// ============================================================================
// Result Methods
// ============================================================================
/// Inspecting and extracting a `Result`.
given[T: Any] Result[T] {
    /// Return whether the result is `Ok`.
    public is_ok(self): Bool = when self in {
        .Ok(_) then true,
        .Error(_) then false,
    };
    /// Return whether the result is `Error`.
    public is_error(self): Bool = when self in {
        .Error(_) then true,
        .Ok(_) then false,
    };
    /// Return the `Ok` value; panics if the result is `Error`.
    public unwrap(self): T = when self in {
        .Ok(v) then v,
        .Error(_) then panic("Result.unwrap failed: value is Error"),
    };
    /// Return the `Ok` value; panics with `message` and the error text if the result is `Error`.
    public expect(self, message: String): T = when self in {
        .Ok(v) then v,
        .Error(e) then panic("Result.expect failed: " + message + ": " + e.message()),
    };
    /// Return the `Error`; panics if the result is `Ok`.
    public unwrap_error(self): Error = when self in {
        .Error(e) then e,
        .Ok(_) then panic("Result.unwrap_error failed: value is Ok"),
    };
    /// Return the `Ok` value, or `default` when the result is `Error`.
    public unwrap_or(self, default: T): T = self or else default;

    /// Transform the `Ok` value with `f`, leaving an `Error` unchanged.
    public map[U: Any](self, f: (T) -> U): Result[U] = self and then as v in f(v);
};
