// ============================================================================
// Koral Standard Library - Result Type
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives, traits, and option are already available.
// ============================================================================

// ============================================================================
// Result Type Definition
// ============================================================================
/// The outcome of a fallible operation: `Ok` carrying a value or `Error` carrying a failure.
public type sendable Result[T: Any] {
    Ok(value: T),
    Error(error: Error),
};

// ============================================================================
// Result Methods
// ============================================================================
/// Inspecting and extracting a `Result`.
given[T: Any] Result[T] {
    /// Return whether the result is `Ok`.
    public is_ok(self): Bool = when self in {
        .Ok(_) then true,
        .Error(_) then false,
    };
    /// Return whether the result is `Error`.
    public is_error(self): Bool = when self in {
        .Error(_) then true,
        .Ok(_) then false,
    };
    /// Return the `Ok` value; panics if the result is `Error`.
    public unwrap(self): T = when self in {
        .Ok(v) then v,
        .Error(_) then panic("Result.unwrap failed: value is Error"),
    };
    /// Return the `Ok` value; panics with `message` and the error text if the result is `Error`.
    public expect(self, message: String): T = when self in {
        .Ok(v) then v,
        .Error(e) then panic("Result.expect failed: " + message + ": " + e.message()),
    };
    /// Return the `Error`; panics if the result is `Ok`.
    public unwrap_error(self): Error = when self in {
        .Error(e) then e,
        .Ok(_) then panic("Result.unwrap_error failed: value is Ok"),
    };
    /// Return the `Ok` value, or `default` when the result is `Error`.
    public unwrap_or(self, default: T): T = self or else default;

    /// Transform the `Ok` value with `f`, leaving an `Error` unchanged.
    public map[U: Any](self, f: (T) -> U): Result[U] = self and then as v in f(v);

    /// Transform the `Error` with `f` (e.g. to wrap context), leaving `Ok`
    /// unchanged.
    public map_error(self, f: (Error) -> Error): Result[T] = when self in {
        .Ok(v) then Result[T].Ok(v),
        .Error(e) then Result[T].Error(f(e)),
    };

    /// The `Ok` value as an `Option`, discarding the error.
    public ok(self): Option[T] = when self in {
        .Ok(v) then Option[T].Some(v),
        .Error(_) then Option[T].None(),
    };

    /// The error as an `Option`, discarding the `Ok` value.
    public error(self): Option[Error] = when self in {
        .Ok(_) then Option[Error].None(),
        .Error(e) then Option[Error].Some(e),
    };

    /// Return the `Ok` value, or compute a default from the error.
    public unwrap_or_else(self, f: (Error) -> T): T = when self in {
        .Ok(v) then v,
        .Error(e) then f(e),
    };
};

/// `Eq` for `Result[T]`: `Ok` values compare with `==`, and `Ok` never equals
/// `Error`. The error side is an `Error` trait object with no comparability
/// source of its own, so two errors compare by `message()` text.
given[T: Eq] Result[T]: Eq {

    /// Compare payloads on `Ok`, message texts on `Error`.
    public equals(self, other: Result[T]): Bool = when self in {
        .Ok(a) then when other in {
            .Ok(b) then a == b,
            .Error(_) then false,
        },
        .Error(e1) then when other in {
            .Ok(_) then false,
            .Error(e2) then e1.message() == e2.message(),
        },
    };
};
