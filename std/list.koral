// ============================================================================
// Koral Standard Library - List Type
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives, traits, option, and string are already available.
// ============================================================================

// ============================================================================
// List Type Definition
// ============================================================================
public type mutable List[T Any](module_private mutable source *unsafe mutable T, module_private mutable len UInt, module_private mutable cap UInt);

given[T Any] List[T] as Drop {

    drop(self) Void = {
        for i in 0..<self.len then {
            deinit_memory(self.source + i);
        };
        dealloc_memory(self.source);
    };
};

public type mutable ListIterator[T Any](module_private source List[T], module_private mutable index UInt);

// ============================================================================
// List Methods
// ============================================================================
given[T Any] List[T] {

    public new() Self = {
        let cap UInt = 10;
        let source = alloc_memory[T](cap);
        return List[T](source, 0, cap);
    };

    public with_capacity(capacity UInt) Self = {
        let cap = if capacity < 1 then 1 else capacity;
        let source = alloc_memory[T](cap);
        return List[T](source, 0, cap);
    };

    public count(self) UInt = self.len;

    public reserve(self, additional UInt) Void = {
        self.ensure_capacity(self.len + additional);
    };

    file_private ensure_capacity(self, min_capacity UInt) Void = {
        if min_capacity > self.cap then {
            let mutable new_cap = self.cap * 2;
            if new_cap < min_capacity then {
                new_cap = min_capacity;
            };
            let new_source = alloc_memory[T](new_cap);
            let old_len = self.len;
            let old_source = self.source;
            move_memory(new_source, old_source, old_len);
            dealloc_memory(old_source);
            self.source = new_source;
            self.cap = new_cap;
        };
    };

    public push(self, value T) Void = {
        self.ensure_capacity(self.len + 1);
        init_memory(self.source + self.len, value);
        self.len = self.len + 1;
    };

    public push_list(self, other List[T]) Void = {
        self.push_sublist(other, ..);
    };

    public push_sublist(self, other List[T], range Range[UInt]) Void = {
        let span = other.slice_spec(range);
        let start = span.start();
        let end = span.end();
        if end <= start then {
            return;
        };
        self.ensure_capacity(self.len + (end - start));
        for i in start..<end then {
            let v = other.source[i];
            init_memory(self.source + self.len, v);
            self.len = self.len + 1;
        };
    };

    // Using if is pattern matching
    public pop(self) Option[T] = {
        if self.len == 0 then {
            return Option[T].None();
        };
        self.len = self.len - 1;
        let value = take_memory(self.source + self.len);
        return Option[T].Some(value);
    };

    public insert_list_at(self, index UInt, other List[T]) Void = {
        self.insert_sublist_at(index, other, ..);
    };

    public insert_sublist_at(self, index UInt, other List[T], range Range[UInt]) Void = {
        if index > self.len then {
            panic("List insert_sublist_at index out of bounds");
        };
        let span = other.slice_spec(range);
        let start = span.start();
        let end = span.end();
        let other_len = span.len();
        if other_len == 0 then {
            return;
        };
        self.ensure_capacity(self.len + other_len);
        // Shift elements to the right by other_len
        let mutable i = self.len;
        while i > index then {
            let src = self.source + (i - 1);
            let dst = self.source + (i - 1 + other_len);
            init_memory(dst, take_memory(src));
            i = i - 1;
        };
        // Copy other's elements into the gap
        for j in start..<end then {
            let v = other.source[j];
            init_memory(self.source + (index + (j - start)), v);
        };
        self.len = self.len + other_len;
    };

    public insert_at(self, index UInt, value T) Void = {
        if index > self.len then {
            panic("List insert_at index out of bounds");
        };
        self.ensure_capacity(self.len + 1);
        // Shift elements to the right
        let mutable i = self.len;
        while i > index then {
            let src = self.source + (i - 1);
            let dst = self.source + i;
            init_memory(dst, take_memory(src));
            i = i - 1;
        };
        init_memory(self.source + index, value);
        self.len = self.len + 1;
    };

    public remove_at(self, index UInt) Void = {
        let _ = self.take_at(index);
    };

    public take_at(self, index UInt) T = {
        if index >= self.len then {
            panic("List remove_at index out of bounds");
        };
        let value = take_memory(self.source + index);
        // Shift elements to the left
        let mutable i = index;
        while i < self.len - 1 then {
            let src = self.source + (i + 1);
            let dst = self.source + i;
            init_memory(dst, take_memory(src));
            i = i + 1;
        };
        self.len = self.len - 1;
        return value;
    };

    public get(self, index UInt) Option[T] = {
        if index >= self.len then {
            return Option[T].None();
        };
        return Option[T].Some(self.source[index]);
    };

    file_private __index_get(self, key UInt) T = {
        if key >= self.len then {
            panic("List index out of bounds");
        };
        return self.source[key];
    };

    file_private __index_set(self, key UInt, value T) Void = {
        if key >= self.len then {
            panic("List index out of bounds");
        };
        self.source[key] = value;
    };

    public first(self) Option[T] = self.get(0);

    public last(self) Option[T] = {
        if self.len == 0 then {
            return Option[T].None();
        };
        return self.get(self.len - 1);
    };

    public is_empty(self) Bool = self.len == 0;

    public clear(self) Void = {
        for i in 0..<self.len then {
            deinit_memory(self.source + i);
        };
        self.len = 0;
    };

    public fill(self, value T) Void = {
        if self.len == 0 then {
            return;
        };
        for i in 0..<self.len then {
            self.source[i] = value;
        };
    };

    public map[U Any](self, fn Func(T) U) List[U] = {
        let mutable result = List[U].with_capacity(self.len);
        for i in 0..<self.len then {
            result.push(fn(self.source[i]));
        };
        return result;
    };

    public reverse(self) Void = {
        if self.len <= 1 then {
            return;
        };
        let mutable left UInt = 0;
        let mutable right = self.len - 1;
        while left < right then {
            let l = self.source + left;
            let r = self.source + right;
            let tmp = *l;
            l[0] = r[0];
            r[0] = tmp;
            left += 1;
            right -= 1;
        };
    };

    file_private make_slice(self, start UInt, len UInt) List[T] = {
        if start + len > self.len then {
            panic("List slice out of bounds");
        };
        let mutable result = List[T].with_capacity(len);
        for i in 0..<len then {
            result.push(self.source[start + i]);
        };
        return result;
    };

    public slice_spec(self, range Range[UInt]) SliceSpec = {
        let len = self.len;
        let mutable start UInt = 0;
        let mutable end UInt = 0;

        when range in {
            .Closed(s, e) then {
                if s > e then {
                    panic("List.slice_spec invalid range");
                };
                if e >= len then {
                    panic("List.slice_spec out of bounds");
                };
                start = s;
                end = e + 1;
            },
            .ClosedOpen(s, e) then {
                if s > e then {
                    panic("List.slice_spec invalid range");
                };
                if e > len then {
                    panic("List.slice_spec out of bounds");
                };
                start = s;
                end = e;
            },
            .OpenClosed(s, e) then {
                if s > e then {
                    panic("List.slice_spec invalid range");
                };
                if s == UInt.max_value() or e >= len then {
                    panic("List.slice_spec out of bounds");
                };
                start = s + 1;
                end = e + 1;
            },
            .Open(s, e) then {
                if s >= e then {
                    panic("List.slice_spec invalid range");
                };
                if s == UInt.max_value() or e > len then {
                    panic("List.slice_spec out of bounds");
                };
                start = s + 1;
                end = e;
            },
            .From(s) then {
                if s > len then {
                    panic("List.slice_spec out of bounds");
                };
                start = s;
                end = len;
            },
            .After(s) then {
                if s >= len then {
                    panic("List.slice_spec out of bounds");
                };
                start = s + 1;
                end = len;
            },
            .To(e) then {
                if e >= len then {
                    panic("List.slice_spec out of bounds");
                };
                start = 0;
                end = e + 1;
            },
            .Until(e) then {
                if e > len then {
                    panic("List.slice_spec out of bounds");
                };
                start = 0;
                end = e;
            },
            .Full() then {
                start = 0;
                end = len;
            },
        };

        return SliceSpec.new(offset: start, len: end - start);
    };

    public sublist(self, range Range[UInt]) List[T] = {
        let span = self.slice_spec(range);
        return self.make_slice(span.start(), span.len());
    };

    // ============ 运算符 trait (Add) ============

    public enumerate(self) EnumerateIterator[T, ListIterator[T]] =
        EnumerateIterator[T, ListIterator[T]](ListIterator[T](self, 0), 0);

    // Retains only elements satisfying the predicate, preserving order. O(n).
    public retain(self, predicate Func(T) Bool) Void = {
        if self.len == 0 then {
            return;
        };
        let mutable write UInt = 0;
        let mutable read UInt = 0;
        while read < self.len then {
            let v = self.source[read];
            if predicate(v) then {
                if write <> read then {
                    init_memory(self.source + write, take_memory(self.source + read));
                };
                write += 1;
            } else {
                deinit_memory(self.source + read);
            };
            read += 1;
        };
        self.len = write;
    };

    // Sort in-place using a key extraction function
    // key extracts an ordering-comparable value from each element
    public sort_by[K Ord](self, key Func(T) K) Void = {
        if self.len <= 1 then {
            return;
        };
        self.merge_sort_by_key(key, 0, self.len);
    };

    // Binary search by key extraction. List must be sorted by the same key.
    // Returns (index, true) if found, (insertion_point, false) if not found.
    public binary_search_by[K Ord](self, key Func(T) K, target K) Pair[UInt, Bool] = {
        let mutable lo UInt = 0;
        let mutable hi = self.len;
        while lo < hi then {
            let mid = lo + (hi - lo) / 2;
            let k = key(self.source[mid]);
            if k == target then {
                return Pair[UInt, Bool](mid, true);
            } else if k < target then {
                lo = mid + 1;
            } else {
                hi = mid;
            };
        };
        return Pair[UInt, Bool](lo, false);
    };
};

given[T Pod] List[T] {

    // FFI bridge for plain-old-data element types only. Not a generic
    // "any T -> *unsafe T" escape hatch: `T` must be `Pod`.
    public borrow_ptr(self) *unsafe T = self.source;

    public borrow_mut_ptr(self) *unsafe mutable T = {
        return self.source;
    };
};

given[T Any] List[T] as Clone {

    // Independent shallow copy: new list identity, elements copied one level.
    public clone(self) Self = {
        let mutable result = List[T].with_capacity(self.len);
        for i in 0..<self.len then {
            result.push(self.source[i]);
        };
        return result;
    };
};

given[T Any] List[T] as Default {

    public default() Self = List[T].new();
};

given[T Eq] List[T] as Eq {

    public equals(self, other List[T]) Bool = {
        if self.len <> other.len then {
            return false;
        };
        for i in 0..<self.len then {
            if self.source[i] <> other.source[i] then {
                return false;
            };
        };
        return true;
    };
};

given[T Hash] List[T] as Hash {

    public hash(self) UInt = {
        let mutable h UInt = self.len.hash();
        for i in 0..<self.len then {
            h = h.combine_hash(self.source[i].hash());
        };
        return h;
    };
};

given[T Ord] List[T] as Ord {

    public compare(self, other List[T]) Int = {
        let self_len = self.len;
        let other_len = other.len;
        let limit = if self_len < other_len then self_len else other_len;

        let mutable idx UInt = 0;
        while idx < limit then {
            let ord = self.source[idx].compare(other.source[idx]);
            if ord <> 0 then {
                return ord;
            };
            idx += 1;
        };

        if self_len < other_len then {
            return -1;
        };
        if self_len > other_len then {
            return 1;
        };
        return 0;
    };
};

given[T Eq] List[T] {

    public contains(self, value T) Bool = {
        for i in 0..<self.len then {
            if self.source[i] == value then {
                return true;
            };
        };
        return false;
    };

    // Removes consecutive duplicate elements. Requires T: Eq. O(n).
    // For global dedup, sort first then call dedup.
    public dedup(self) Void = {
        if self.len <= 1 then {
            return;
        };
        let mutable write UInt = 1;
        let mutable read UInt = 1;
        while read < self.len then {
            let prev = self.source[write - 1];
            let curr = self.source[read];
            if curr <> prev then {
                if write <> read then {
                    init_memory(self.source + write, take_memory(self.source + read));
                };
                write += 1;
            } else {
                deinit_memory(self.source + read);
            };
            read += 1;
        };
        self.len = write;
    };
};

public let make_bytes(count UInt) List[UInt8] = {
    let mutable bytes = List[UInt8].with_capacity(count);
    if count == 0 then {
        return bytes;
    };
    let data = bytes.source;
    for i in 0..<count then {
        init_memory(data + i, 0(UInt8));
    };
    bytes.len = count;
    return bytes;
};

public let make_uninitialized_bytes(count UInt) List[UInt8] = {
    let mutable bytes = List[UInt8].with_capacity(count);
    bytes.len = count;
    return bytes;
};

// ============================================================================
// List Iterator - Using new pattern matching
// ============================================================================
given[T Any] ListIterator[T] as Iterator[T] {

    public next(self) Option[T] = {
        if self.index >= self.source.len then {
            return Option[T].None();
        };
        let value = self.source.source[self.index];
        self.index = self.index + 1;
        return Option[T].Some(value);
    };
};

given[T Any] List[T] as Iterable[T, ListIterator[T]] {

    public iterator(self) ListIterator[T] = ListIterator[T](self, 0);
};

// ============================================================================
// List Sorting - sort_by with key function
// ============================================================================
given[T Any] List[T] {

    // Merge sort implementation with key function
    file_private merge_sort_by_key[K Ord](self, key Func(T) K, start UInt, end UInt) Void = {
        let len = end - start;
        if len <= 1 then {
            return;
        };

        let mid = start + len / 2;
        self.merge_sort_by_key(key, start, mid);
        self.merge_sort_by_key(key, mid, end);
        self.merge_by_key(key, start, mid, end);
    };

    // Merge two sorted subarrays using key function
    file_private merge_by_key[K Ord](
        self,
        key Func(T) K,
        start UInt,
        mid UInt,
        end UInt,
    ) Void = {
        let left_len = mid - start;
        let mutable temp = List[T].with_capacity(left_len);

        // Copy left half to temp
        for i in 0..<left_len then {
            temp.push(self.source[start + i]);
        };

        let mutable left_idx UInt = 0;
        let mutable right_idx = mid;
        let mutable dest_idx = start;

        // Merge back
        while left_idx < left_len and right_idx < end then {
            let left_val = temp.source[left_idx];
            let right_val = self.source[right_idx];

            // Use <= to ensure stability (prefer left on equal)
            if key(left_val) <= key(right_val) then {
                self.source[dest_idx] = left_val;
                left_idx += 1;
            } else {
                self.source[dest_idx] = right_val;
                right_idx += 1;
            };
            dest_idx += 1;
        };

        // Copy remaining left elements
        while left_idx < left_len then {
            let value = temp.source[left_idx];
            self.source[dest_idx] = value;
            left_idx += 1;
            dest_idx += 1;
        };
    };
};

given[T Ord] List[T] {

    // Binary search on a sorted list.
    // Returns (index, true) if found, (insertion_point, false) if not found.
    public binary_search(self, target T) Pair[UInt, Bool] = {
        let mutable lo UInt = 0;
        let mutable hi = self.len;
        while lo < hi then {
            let mid = lo + (hi - lo) / 2;
            let v = self.source[mid];
            if v == target then {
                return Pair[UInt, Bool](mid, true);
            } else if v < target then {
                lo = mid + 1;
            } else {
                hi = mid;
            };
        };
        return Pair[UInt, Bool](lo, false);
    };

    // Sort in-place in ascending order using Ord trait
    public sort(self) Void = {
        if self.len <= 1 then {
            return;
        };
        self.merge_sort_comparable(0, self.len);
    };

    // Merge sort implementation using Ord
    file_private merge_sort_comparable(self, start UInt, end UInt) Void = {
        let len = end - start;
        if len <= 1 then {
            return;
        };

        let mid = start + len / 2;
        self.merge_sort_comparable(start, mid);
        self.merge_sort_comparable(mid, end);
        self.merge_comparable(start, mid, end);
    };

    // Merge two sorted subarrays using Ord
    file_private merge_comparable(self, start UInt, mid UInt, end UInt) Void = {
        let left_len = mid - start;
        let mutable temp = List[T].with_capacity(left_len);

        // Copy left half to temp
        for i in 0..<left_len then {
            temp.push(self.source[start + i]);
        };

        let mutable left_idx UInt = 0;
        let mutable right_idx = mid;
        let mutable dest_idx = start;

        // Merge back
        while left_idx < left_len and right_idx < end then {
            let left_val = temp.source[left_idx];
            let right_val = self.source[right_idx];

            // Use <= to ensure stability (prefer left on equal)
            if left_val <= right_val then {
                self.source[dest_idx] = left_val;
                left_idx += 1;
            } else {
                self.source[dest_idx] = right_val;
                right_idx += 1;
            };
            dest_idx += 1;
        };

        // Copy remaining left elements
        while left_idx < left_len then {
            let value = temp.source[left_idx];
            self.source[dest_idx] = value;
            left_idx += 1;
            dest_idx += 1;
        };
    };
};
