// ============================================================================
// Koral Standard Library - List Type
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives, traits, option, and string are already available.
// ============================================================================

// ============================================================================
// List Type Definition
// ============================================================================
/// A growable ordered sequence of `T` in one contiguous buffer. Elements are
/// stored by handle, so `type mutable` values stay shared with their source.
public type mutable List[T: Any](
    mutable source: *mutable T,
    mutable len: UInt,
    mutable cap: UInt,
);

/// `Drop` for `List[T]`: frees every element and the buffer when the last handle dies.
given[T: Any] List[T]: Drop {

    drop(self): Void = {
        for i in 0..<self.len then {
            deinit_memory(self.source + i);
        };
        dealloc_memory(self.source);
    };
};

/// A one-shot cursor that walks a `List[T]` from index 0 to the end.
public type mutable ListIterator[T: Any](source: List[T], mutable index: UInt);

// ============================================================================
// List Methods
// ============================================================================
/// Construction, mutation, and query operations on `List[T]`.
given[T: Any] List[T] {

    /// 空列表不分配缓冲区，首次 push 时再分配。
    /// 编译器里有大量建完就丢（或一直为空）的临时列表，例如每个 `Scope` 的
    /// `entry_list` / `local_entry_list`，为它们每次都付一次 alloc 不值得。
    public new(): Self = {
        return List[T](null, 0, 0);
    };

    /// Create an empty list with room for at least `capacity` elements before the next reallocation.
    public with_capacity(capacity: UInt): Self = {
        let cap = if capacity < 1 then 1 else capacity;
        let source = alloc_memory[T](cap);
        return List[T](source, 0, cap);
    };

    /// The number of elements in the list.
    public count(self): UInt = self.len;

    /// Grow capacity so the list can hold `additional` more elements without reallocating.
    public reserve(self, additional: UInt): Void = {
        self.ensure_capacity(self.len + additional);
    };

    private ensure_capacity(self, min_capacity: UInt): Void = {
        if min_capacity > self.cap then {
            self.grow_to(min_capacity);
        };
    };

    /// The growth body behind `ensure_capacity`, kept out of line on purpose:
    /// inlined, it fattens `push` past the C inliner's threshold and every
    /// element then pays a call (measured 11ms vs 2ms on 5M pushes).
    private grow_to(self, min_capacity: UInt): Void = {
        // 从 0 起步时先要一块够用的容量，避免 1,2,3… 逐个翻倍。
        let mutable new_cap = if self.cap == UInt(0) then UInt(8)
        else self.cap * UInt(2);
        if new_cap < min_capacity then {
            new_cap = min_capacity;
        };
        let new_source = alloc_memory[T](new_cap);
        let old_len = self.len;
        // 空列表的 source 是 null，不要交给 memmove。
        if old_len > UInt(0) then {
            move_memory(new_source, self.source, old_len);
        };
        dealloc_memory(self.source);
        self.source = new_source;
        self.cap = new_cap;
    };

    /// Append `value` at the end of the list (amortized O(1)), without consuming the caller's value.
    /// Every hot field is read before the growth call and re-read only in
    /// the growth path: an opaque call in the loop forces the C backend to
    /// reload whatever sits after it, per element. `len` flushes before
    /// `grow_to` because growth moves exactly `len` elements.
    public push(self, value: T): Void = {
        let mutable source = self.source;
        let mutable cap = self.cap;
        let len = self.len;
        let next = len + UInt(1);
        if next > cap then {
            self.len = len;
            self.grow_to(next);
            source = self.source;
            cap = self.cap;
        };
        init_memory(source + len, value);
        self.len = next;
    };

    /// Append the slice of `other` picked by `span`, defaulting to the whole list
    /// -- the same span shape as `Reader.read` / `Writer.write` in `std/io/traits.koral`.
    public push_list(self, other: List[T], span: Range[UInt] = ...): Void = {
        let spec = other.slice_spec(span);
        let start = spec.start();
        let end = spec.end();
        if end <= start then {
            return;
        };
        self.ensure_capacity(self.len + (end - start));
        // The same pre-load shape as `push`: the element store may alias
        // the list box, so `len` is carried locally and written back once.
        let source = self.source;
        let mutable len = self.len;
        for i in start..<end then {
            let v = other.source[i];
            init_memory(source + len, v);
            len = len + UInt(1);
        };
        self.len = len;
    };

    // Using if is pattern matching
    /// Remove and return the last element, or `None` when the list is empty.
    public pop(self): Option[T] = {
        if self.len == 0 then {
            return Option[T].None();
        };
        let len = self.len - UInt(1);
        self.len = len;
        let value = take_memory(self.source + len);
        return Option[T].Some(value);
    };

    /// Insert the slice of `other` picked by `span` (default: the whole list) at
    /// `index`, shifting later elements right. O(n). Panics when `index > count`; `other` may be `self`.
    public insert_list_at(self, index: UInt, other: List[T], span: Range[UInt] = ...): Void = {
        if index > self.len then {
            panic("List insert_list_at index out of bounds");
        };
        let spec = other.slice_spec(span);
        let start = spec.start();
        let end = spec.end();
        let other_len = spec.len();
        if other_len == 0 then {
            return;
        };
        // Snapshot `other` first: `other` may be `self`, and the shift below would
        // otherwise overwrite the elements still to be read. No identity test exists,
        // so the snapshot is unconditional.
        let mutable snap: List[T] = List[T].with_capacity(other_len);
        for j in start..<end then {
            snap.push(other.source[j]);
        };
        self.ensure_capacity(self.len + other_len);
        // Shift elements to the right by other_len
        let mutable i = self.len;
        while i > index then {
            let src = self.source + (i - 1);
            let dst = self.source + (i - 1 + other_len);
            let moved = take_memory(src);
            init_memory(dst, moved);
            i = i - 1;
        };
        // Fill the gap from the snapshot, in reverse so pop() hands ownership over cleanly.
        let mutable w = index + other_len;
        while w > index then {
            w = w - 1;
            let popped = snap.pop().unwrap();
            init_memory(self.source + w, popped);
        };
        self.len = self.len + other_len;
    };

    /// Insert `value` at `index` and shift later elements right. O(n).
    /// Panics when `index > count`; `index == count` appends.
    public insert_at(self, index: UInt, value: T): Void = {
        if index > self.len then {
            panic("List insert_at index out of bounds");
        };
        self.ensure_capacity(self.len + 1);
        // Shift elements to the right
        let mutable i = self.len;
        while i > index then {
            let src = self.source + (i - 1);
            let dst = self.source + i;
            let moved = take_memory(src);
            init_memory(dst, moved);
            i = i - 1;
        };
        init_memory(self.source + index, value);
        self.len = self.len + 1;
    };

    /// Remove and discard the element at `index`, shifting later elements left. O(n). Panics when out of range.
    public remove_at(self, index: UInt): Void = {
        if index >= self.len then {
            panic("List remove_at index out of bounds");
        };
        let _ = self.take_at(index);
    };

    /// Remove the element at `index` and return it, shifting later elements left. O(n). Panics when out of range.
    public take_at(self, index: UInt): T = {
        if index >= self.len then {
            panic("List take_at index out of bounds");
        };
        let value = take_memory(self.source + index);
        // Shift elements to the left
        let mutable i = index;
        while i < self.len - 1 then {
            let src = self.source + (i + 1);
            let dst = self.source + i;
            let moved = take_memory(src);
            init_memory(dst, moved);
            i = i + 1;
        };
        self.len = self.len - 1;
        return value;
    };

    /// The element at `index` without removing it, or `None` when out of range.
    /// The list keeps the element: `type mutable` values come back shared with it.
    public get(self, index: UInt): Option[T] = {
        if index >= self.len then {
            return Option[T].None();
        };
        return Option[T].Some(self.source[index]);
    };

    private __index_get(self, key: UInt): T = {
        if key >= self.len then {
            panic("List index out of bounds");
        };
        return self.source[key];
    };

    private __index_set(self, key: UInt, value: T): Void = {
        if key >= self.len then {
            panic("List index out of bounds");
        };
        self.source[key] = value;
    };

    /// 内置下标 `xs[i]` 的内部操作：返回元素槽位指针。读写直接作用于槽位
    /// （成员访问语义），不再把元素按值拷进拷出；retain/release 由槽位的
    /// 读写按既有规则处理。越界 panic 与 `__index_get` 一致。
    private __index_slot(self, key: UInt): *mutable T = {
        if key >= self.len then {
            panic("List index out of bounds");
        };
        return self.source + key;
    };

    /// The first element without removing it, or `None` when the list is empty.
    public first(self): Option[T] = self.get(0);

    /// The last element without removing it, or `None` when the list is empty.
    public last(self): Option[T] = {
        if self.len == 0 then {
            return Option[T].None();
        };
        return self.get(self.len - 1);
    };

    /// Whether the list has no elements.
    public is_empty(self): Bool = self.len == 0;

    /// Remove every element, keeping the allocated capacity.
    public clear(self): Void = {
        for i in 0..<self.len then {
            deinit_memory(self.source + i);
        };
        self.len = 0;
    };

    /// Overwrite every element with `value`. All slots hold the one value;
    /// `type mutable` values are shared into every slot, not cloned per element.
    public fill(self, value: T): Void = {
        if self.len == 0 then {
            return;
        };
        for i in 0..<self.len then {
            self.source[i] = value;
        };
    };

    /// Build a new list by applying `fn` to every element, in order.
    public map[U: Any](self, fn: (T) -> U): List[U] = {
        let mutable result = List[U].with_capacity(self.len);
        for i in 0..<self.len then {
            result.push(fn(self.source[i]));
        };
        return result;
    };

    /// Reverse the element order in place. O(n).
    public reverse(self): Void = {
        if self.len <= 1 then {
            return;
        };
        let mutable left: UInt = 0;
        let mutable right = self.len - 1;
        while left < right then {
            let l = self.source + left;
            let r = self.source + right;
            let tmp = *l;
            l[0] = r[0];
            r[0] = tmp;
            left += 1;
            right -= 1;
        };
    };

    private make_slice(self, start: UInt, len: UInt): List[T] = {
        if start + len > self.len then {
            panic("List slice out of bounds");
        };
        let mutable result = List[T].with_capacity(len);
        for i in 0..<len then {
            result.push(self.source[start + i]);
        };
        return result;
    };

    /// Resolve `range` against this list's length into a `SliceSpec` (start + length).
    /// Panics when the range is invalid or reaches past the end.
    public slice_spec(self, range: Range[UInt]): SliceSpec = {
        let len = self.len;
        let mutable start: UInt = 0;
        let mutable end: UInt = 0;

        when range in {
            .Closed(s, e) then {
                if s > e then {
                    panic("List.slice_spec invalid range");
                };
                if e >= len then {
                    panic("List.slice_spec out of bounds");
                };
                start = s;
                end = e + 1;
            },
            .ClosedOpen(s, e) then {
                if s > e then {
                    panic("List.slice_spec invalid range");
                };
                if e > len then {
                    panic("List.slice_spec out of bounds");
                };
                start = s;
                end = e;
            },
            .OpenClosed(s, e) then {
                if s > e then {
                    panic("List.slice_spec invalid range");
                };
                if s == UInt.max_value() or e >= len then {
                    panic("List.slice_spec out of bounds");
                };
                start = s + 1;
                end = e + 1;
            },
            .Open(s, e) then {
                if s > e then {
                    panic("List.slice_spec invalid range");
                };
                if s == UInt.max_value() or e > len then {
                    panic("List.slice_spec out of bounds");
                };
                // Open(s, s) names no elements: the empty slice at s, exactly
                // like ClosedOpen(s, s). (start = s + 1 would push an empty
                // spec past the end when s == len.)
                if s == e then {
                    start = s;
                } else {
                    start = s + 1;
                };
                end = e;
            },
            .From(s) then {
                if s > len then {
                    panic("List.slice_spec out of bounds");
                };
                start = s;
                end = len;
            },
            .After(s) then {
                if s >= len then {
                    panic("List.slice_spec out of bounds");
                };
                start = s + 1;
                end = len;
            },
            .To(e) then {
                if e >= len then {
                    panic("List.slice_spec out of bounds");
                };
                start = 0;
                end = e + 1;
            },
            .Until(e) then {
                if e > len then {
                    panic("List.slice_spec out of bounds");
                };
                start = 0;
                end = e;
            },
            .Full() then {
                start = 0;
                end = len;
            },
        };

        return SliceSpec.new(offset = start, len = end - start);
    };

    /// Return a new list holding the `range` slice of this one (elements shared
    /// one level); this list is left untouched. Panics on an invalid or out-of-bounds range.
    public sublist(self, range: Range[UInt]): List[T] = {
        let span = self.slice_spec(range);
        return self.make_slice(span.start(), span.len());
    };

    /// Concatenation: returns a new list, leaving both inputs usable.
    /// Deliberately not `Add` — arithmetic traits stay off heap-owning containers.
    public concat(self, other: List[T]): List[T] = {
        let mutable result = List[T].with_capacity(self.len + other.len);
        for v in self then {
            result.push(v);
        };
        for v in other then {
            result.push(v);
        };
        return result;
    };

    /// Retains only elements satisfying the predicate, preserving order. O(n).
    public retain(self, predicate: (T) -> Bool): Void = {
        if self.len == 0 then {
            return;
        };
        let mutable write: UInt = 0;
        let mutable read: UInt = 0;
        while read < self.len then {
            let v = self.source[read];
            if predicate(v) then {
                if write != read then {
                        let moved = take_memory(self.source + read);
                init_memory(self.source + write, moved);
                };
                write += 1;
            } else {
                deinit_memory(self.source + read);
            };
            read += 1;
        };
        self.len = write;
    };

    /// Sort in place by the `Ord` key `key` extracts from each element.
    /// Stable: elements with equal keys keep their relative order.
    public sort_by[K: Ord](self, key: (T) -> K): Void = {
        let len = self.len;
        if len <= 1 then {
            return;
        };
        // Short lists are one straight insertion sort: no scratch buffer, no recursion.
        if len <= 32 then {
            self.insertion_sort_by_key(key, 0, len);
            return;
        };
        // One scratch buffer for the whole sort, reused by every merge level.
        let buf = alloc_memory[T](len);
        self.merge_sort_by_key(key, buf, 0, len);
        dealloc_memory(buf);
    };

    /// Binary search by the key `key` extracts; the list must already be sorted by that key.
    /// Returns `(index, true)` when found, `(insertion_point, false)` otherwise. O(log n).
    public binary_search_by[K: Ord](self, key: (T) -> K, target: K): Pair[UInt, Bool] = {
        let mutable lo: UInt = 0;
        let mutable hi = self.len;
        while lo < hi then {
            let mid = lo + (hi - lo) / 2;
            let k = key(self.source[mid]);
            if k == target then {
                return Pair[UInt, Bool](mid, true);
            } else if k < target then {
                lo = mid + 1;
            } else {
                hi = mid;
            };
        };
        return Pair[UInt, Bool](lo, false);
    };
};

/// Raw-pointer accessors for `List[T]` of `foreign` elements (the FFI boundary).
given[T: foreign] List[T] {

    /// The element buffer as a raw `*T`, for `foreign` elements only -- the FFI
    /// bridge, not a generic escape hatch. Invalid after any reallocation or drop.
    public borrow_ptr(self): *T = self.source;

    /// The element buffer as a raw `*mutable T`, for `foreign` elements only -- the
    /// FFI bridge, not a generic escape hatch. Invalid after any reallocation or drop.
    public borrow_mut_ptr(self): *mutable T = {
        return self.source;
    };
};

/// `Clone` for `List[T]`: a new list whose elements are copied one level.
given[T: Any] List[T]: Clone {

    /// Independent shallow copy: new list identity, elements copied one level.
    public clone(self): Self = {
        let mutable result = List[T].with_capacity(self.len);
        for i in 0..<self.len then {
            result.push(self.source[i]);
        };
        return result;
    };
};

/// `Default` for `List[T]`: the empty list.
given[T: Any] List[T]: Default {

    /// The empty list.
    public default(): Self = List[T].new();
};

/// `Eq` for `List[T]`: element-wise equality in order.
given[T: Eq] List[T]: Eq {

    /// Whether `other` has the same length and pairwise-equal elements.
    public equals(self, other: List[T]): Bool = {
        if self.len != other.len then {
            return false;
        };
        for i in 0..<self.len then {
            if self.source[i] != other.source[i] then {
                return false;
            };
        };
        return true;
    };
};

/// `Hash` for `List[T]`: combines length and element hashes in order.
given[T: Hash] List[T]: Hash {

    /// A hash of the element sequence: length and elements combined in order.
    public hash(self): UInt = {
        let mutable h: UInt = self.len.hash();
        for i in 0..<self.len then {
            h = h.combine_hash(self.source[i].hash());
        };
        return h;
    };
};

/// `Ord` for `List[T]`: lexicographic comparison of elements, then length.
given[T: Ord] List[T]: Ord {

    /// Lexicographic three-way comparison (`-1`, `0`, or `1`); the shorter list
    /// is smaller when one is a prefix of the other.
    public compare(self, other: List[T]): Int = {
        let self_len = self.len;
        let other_len = other.len;
        let limit = if self_len < other_len then self_len else other_len;

        let mutable idx: UInt = 0;
        while idx < limit then {
            let ord = self.source[idx].compare(other.source[idx]);
            if ord != 0 then {
                return ord;
            };
            idx += 1;
        };

        if self_len < other_len then {
            return -1;
        };
        if self_len > other_len then {
            return 1;
        };
        return 0;
    };
};

/// Membership and duplicate-removal operations on `List[T]` of `Eq` elements.
given[T: Eq] List[T] {

    /// Whether any element equals `value`. O(n).
    public contains(self, value: T): Bool = {
        for i in 0..<self.len then {
            if self.source[i] == value then {
                return true;
            };
        };
        return false;
    };

    /// Removes consecutive duplicate elements. O(n).
    /// For global dedup, sort first then call dedup.
    public dedup(self): Void = {
        if self.len <= 1 then {
            return;
        };
        let mutable write: UInt = 1;
        let mutable read: UInt = 1;
        while read < self.len then {
            let prev = self.source[write - 1];
            let curr = self.source[read];
            if curr != prev then {
                if write != read then {
                        let moved = take_memory(self.source + read);
                init_memory(self.source + write, moved);
                };
                write += 1;
            } else {
                deinit_memory(self.source + read);
            };
            read += 1;
        };
        self.len = write;
    };
};

/// A `count`-byte list of zeros.
public let make_bytes(count: UInt): List[UInt8] = {
    let mutable bytes = List[UInt8].with_capacity(count);
    if count == 0 then {
        return bytes;
    };
    let data = bytes.source;
    for i in 0..<count then {
        init_memory(data + i, UInt8(0));
    };
    bytes.len = count;
    return bytes;
};

/// A `count`-byte list of uninitialized bytes, meant for buffers that are filled before being read.
public let make_uninitialized_bytes(count: UInt): List[UInt8] = {
    let mutable bytes = List[UInt8].with_capacity(count);
    bytes.len = count;
    return bytes;
};

// ============================================================================
// List Iterator - Using new pattern matching
// ============================================================================
/// `Iterator` for `ListIterator[T]`: yields list elements from index 0 upward.
given[T: Any] ListIterator[T]: Iterator[T] {

    /// Return the next element, or `None` once the cursor has walked the list.
    public next(self): Option[T] = {
        if self.index >= self.source.len then {
            return Option[T].None();
        };
        let value = self.source.source[self.index];
        self.index = self.index + 1;
        return Option[T].Some(value);
    };
};

/// `Iterable` for `List[T]`: hands out a fresh `ListIterator[T]` on every call.
given[T: Any] List[T]: Iterable[T, ListIterator[T]] {

    /// A fresh cursor from index 0; the list itself is left untouched.
    public iterator(self): ListIterator[T] = ListIterator[T](self, 0);
};

// ============================================================================
// List Sorting - sort_by with key function
// ============================================================================
/// Stable merge-sort helpers backing `sort_by` on `List[T]`.
given[T: Any] List[T] {

    // Straight insertion sort over [start, end) for short runs (stable):
    // elements slide right while the element before them is greater on the
    // key, so equal keys never move past each other. Every slot move is a
    // take/init pair -- the take leaves a vacancy that the init refills -- so
    // the run is RC-neutral except for the key reads. The cursor is a raw
    // pointer walk: pointer arithmetic is unchecked, so the hot loop pays no
    // per-step overflow-guard calls.
    private insertion_sort_by_key[K: Ord](self, key: (T) -> K, start: UInt, end: UInt): Void = {
        if end <= start then {
            return;
        };
        let source = self.source;
        let startp = source + start;
        let lastp = source + end;
        let mutable ip = startp + 1;
        while ip != lastp then {
            let key_val = take_memory(ip);
            let mutable hole = ip;
            while hole != startp and key((hole - 1)[0]) > key(key_val) then {
                let prev = hole - 1;
                let moved = take_memory(prev);
                init_memory(hole, moved);
                hole = prev;
            };
            init_memory(hole, key_val);
            ip = ip + 1;
        };
    };

    // Recursive merge sort over [start, end). `buf` is one scratch buffer of
    // `self.len` slots shared by every merge level; each merge vacates the
    // slots it uses before returning, so the reuse is safe.
    private merge_sort_by_key[K: Ord](self, key: (T) -> K, buf: *mutable T, start: UInt, end: UInt): Void = {
        let len = end - start;
        if len <= 32 then {
            self.insertion_sort_by_key(key, start, end);
            return;
        };

        let mid = start + len / 2;
        self.merge_sort_by_key(key, buf, start, mid);
        self.merge_sort_by_key(key, buf, mid, end);
        // Already in order: the left run's maximum key is <= the right run's
        // minimum key, so the merge would copy every element onto itself.
        let source = self.source;
        if key(source[mid - 1]) <= key(source[mid]) then {
            return;
        };
        self.merge_by_key(key, buf, start, mid, end);
    };

    // Merge the sorted runs [start, mid) and [mid, end), preferring the left
    // run on equal keys to stay stable. The left run moves wholesale into
    // `buf`; both runs then merge back into the source by move. RC ledger for
    // one merge: the bulk move is a bit move (no retain/release), and each
    // merged element is one take_memory (slot vacated, never dropped) followed
    // by one init_memory into a vacated slot. A dest slot is always vacant:
    // slots [start, mid) were emptied by the bulk move, and slots in
    // [mid, rp) were emptied by earlier right-run takes, while every write
    // lands before rp. The left remainder drains through the same take/init
    // pair; a right remainder is already in place. The cursors are raw
    // pointer walks: pointer arithmetic is unchecked, so the hot loop pays no
    // per-step overflow-guard calls.
    private merge_by_key[K: Ord](
        self,
        key: (T) -> K,
        buf: *mutable T,
        start: UInt,
        mid: UInt,
        end: UInt,
    ): Void = {
        let source = self.source;
        let left_end = buf + (mid - start);
        move_memory(buf, source + start, mid - start);

        let mutable lp = buf;
        let mutable rp = source + mid;
        let mutable dp = source + start;
        let right_end = source + end;

        while lp != left_end and rp != right_end then {
            // Use <= to ensure stability (prefer left on equal)
            if key(lp[0]) <= key(rp[0]) then {
                let moved = take_memory(lp);
                init_memory(dp, moved);
                lp = lp + 1;
            } else {
                let moved = take_memory(rp);
                init_memory(dp, moved);
                rp = rp + 1;
            };
            dp = dp + 1;
        };

        while lp != left_end then {
            let moved = take_memory(lp);
            init_memory(dp, moved);
            lp = lp + 1;
            dp = dp + 1;
        };
    };
};

/// Ordering operations on `List[T]` of `Ord` elements.
given[T: Ord] List[T] {

    /// Binary search on a sorted list. O(log n).
    /// Returns `(index, true)` if found, `(insertion_point, false)` if not found.
    public binary_search(self, target: T): Pair[UInt, Bool] = {
        let mutable lo: UInt = 0;
        let mutable hi = self.len;
        while lo < hi then {
            let mid = lo + (hi - lo) / 2;
            let v = self.source[mid];
            if v == target then {
                return Pair[UInt, Bool](mid, true);
            } else if v < target then {
                lo = mid + 1;
            } else {
                hi = mid;
            };
        };
        return Pair[UInt, Bool](lo, false);
    };

    /// Sort in place in ascending order using the `Ord` trait.
    /// Stable: equal elements keep their relative order.
    public sort(self): Void = {
        let len = self.len;
        if len <= 1 then {
            return;
        };
        // Short lists are one straight insertion sort: no scratch buffer, no recursion.
        if len <= 32 then {
            self.insertion_sort_comparable(0, len);
            return;
        };
        // One scratch buffer for the whole sort, reused by every merge level.
        let buf = alloc_memory[T](len);
        self.merge_sort_comparable(buf, 0, len);
        dealloc_memory(buf);
    };

    // Straight insertion sort over [start, end) for short runs (stable):
    // elements slide right while the element before them is greater, so equal
    // elements never move past each other. Every slot move is a take/init pair
    // -- the take leaves a vacancy that the init refills -- so the run is
    // RC-neutral except for the element reads. The cursor is a raw pointer
    // walk: pointer arithmetic is unchecked, so the hot loop pays no per-step
    // overflow-guard calls.
    private insertion_sort_comparable(self, start: UInt, end: UInt): Void = {
        if end <= start then {
            return;
        };
        let source = self.source;
        let startp = source + start;
        let lastp = source + end;
        let mutable ip = startp + 1;
        while ip != lastp then {
            let key_val = take_memory(ip);
            let mutable hole = ip;
            while hole != startp and (hole - 1)[0] > key_val then {
                let prev = hole - 1;
                let moved = take_memory(prev);
                init_memory(hole, moved);
                hole = prev;
            };
            init_memory(hole, key_val);
            ip = ip + 1;
        };
    };

    /// Sort in place in ascending order using the `Ord` trait.
    /// Unstable: equal elements may come out in any order. Pattern-defeating
    /// quicksort (pdqsort) -- median-of-3 / ninther pivots, insertion sort on
    /// small and nearly-sorted blocks, equal-key runs skipped by the
    /// partition, a deterministic scramble on degenerate shapes, heap sort
    /// as the last-resort arm: no scratch buffer, O(log n) stack, O(n log n)
    /// worst case.
    public sort_unstable(self): Void = {
        let len = self.len;
        if len <= 1 then {
            return;
        };
        // Recursion budget: 2 * floor(log2(len)).
        let mutable depth: UInt = 0;
        let mutable p: UInt = 1;
        while p < len then {
            p = p * 2;
            depth = depth + 1;
        };
        self.pdqsort_comparable(0, len, depth * 2);
    };

    /// Exchange two slots; RC-neutral (two takes, two inits). A self-swap is
    /// a no-op -- taking one slot twice would read its own vacancy.
    private swap_at(self, a: UInt, b: UInt): Void = {
        if a == b then {
            return;
        };
        let source = self.source;
        let pa = source + a;
        let pb = source + b;
        let ta = take_memory(pa);
        let tb = take_memory(pb);
        init_memory(pa, tb);
        init_memory(pb, ta);
    };

    /// The pdqsort loop over [start, end): partition, recurse into the
    /// smaller side and iterate on the larger -- the stack stays O(log n).
    /// `depth` is the remaining bad-partition budget before heap sort takes
    /// over the rest of the range.
    private pdqsort_comparable(self, start: UInt, end: UInt, depth: UInt): Void = {
        let mutable s = start;
        let mutable e = end;
        let mutable bad = depth;
        let mutable scramble = false;
        while e - s > 16 then {
            if bad == 0 then {
                self.heap_sort_comparable(s, e);
                return;
            };
            bad = bad - 1;

            // The previous partition was lopsided: scramble this range
            // BEFORE it is partitioned (scrambling a partitioned range
            // would mix elements across the region seams) so the shape
            // that defeated the last pivot cannot defeat this one.
            if scramble then {
                self.break_patterns(s, e);
                scramble = false;
            };

            // A nearly-sorted block finishes here: at most a handful of
            // out-of-order elements, settled by insertion.
            if self.partial_insertion_sort(s, e) then {
                return;
            };

            // Pivot value: median-of-3 on narrow blocks, the ninther on
            // wide ones. It rides in a local copy so the slots can move
            // under it.
            let n = e - s;
            let pivot_val = if n > 50 then {
                self.ninther_val(s, e)
            } else {
                self.median3_val(s, s + n / 2, e - 1)
            };

            let out = self.partition_le(s, e, pivot_val);
            let left_n = out - s;
            let right_n = e - out;

            // Everything landed on one side (every key equal to the pivot):
            // heap sort the block -- the recursion would not shrink.
            if left_n == UInt(0) or right_n == UInt(0) then {
                self.heap_sort_comparable(s, e);
                return;
            };

            // Recurse into the smaller side and iterate on the larger. A
            // lopsided split (under an eighth) burns an extra budget unit
            // and arms the scramble for the side we keep.
            scramble = left_n * 8 < n or right_n * 8 < n;
            if scramble and bad > 0 then {
                bad = bad - 1;
            };
            if left_n < right_n then {
                self.pdqsort_comparable(s, out, bad);
                s = out;
            } else {
                self.pdqsort_comparable(out, e, bad);
                e = out;
            };
        };
        self.insertion_sort_comparable(s, e);
    };

    /// Insert-sort the block, giving up once it is clearly not nearly
    /// sorted -- pdqsort's fast path. `true` = the block comes out sorted;
    /// `false` = it needs a real partition (the prefix is still valid).
    private partial_insertion_sort(self, start: UInt, end: UInt): Bool = {
        let source = self.source;
        let startp = source + start;
        let mutable moves: UInt = 0;
        let mutable ip = source + start + 1;
        let lastp = source + end;
        while ip != lastp then {
            if (ip - 1)[0] > ip[0] then {
                let key_val = take_memory(ip);
                let mutable hole = ip;
                while hole != startp and (hole - 1)[0] > key_val then {
                    let prev = hole - 1;
                    let moved = take_memory(prev);
                    init_memory(hole, moved);
                    hole = prev;
                    moves = moves + 1;
                };
                init_memory(hole, key_val);
                if moves > 8 then {
                    return false;
                };
            };
            ip = ip + 1;
        };
        return true;
    };

    /// Two-way partition of [s, e) around the pivot value: [s, out) <= the
    /// pivot, [out, e) > it. Hoare with skip runs -- a stretch already in
    /// partition order advances without swapping, so the predictor sees
    /// streaks and only inversions pay a swap.
    private partition_le(self, s: UInt, e: UInt, pivot_val: T): UInt = {
        let source = self.source;
        let mutable lo = s;
        let mutable hi = e - 1;
        while lo < hi then {
            while lo < hi and (source + lo)[0] <= pivot_val then {
                lo = lo + 1;
            };
            while lo < hi and (source + hi)[0] > pivot_val then {
                hi = hi - 1;
            };
            if lo < hi then {
                self.swap_at(lo, hi);
                lo = lo + 1;
                hi = hi - 1;
            };
        };
        if lo < e and (source + lo)[0] > pivot_val then {
            return lo;
        };
        return lo + 1;
    };

    /// The median of three slot values, moving nothing.
    private median3_val(self, a: UInt, b: UInt, c: UInt): T = {
        let source = self.source;
        let va = (source + a)[0];
        let vb = (source + b)[0];
        let vc = (source + c)[0];
        if va < vb then {
            if vb < vc then {
                return vb;
            };
            if va < vc then {
                return vc;
            };
            return va;
        };
        if va < vc then {
            return va;
        };
        if vb < vc then {
            return vc;
        };
        return vb;
    };

    /// The ninther: the median of three medians spread across a wide block.
    private ninther_val(self, s: UInt, e: UInt): T = {
        let n = e - s;
        let eighth = n / 8;
        let mid = s + n / 2;
        let m1 = self.median3_val(s, s + eighth, s + eighth * 2);
        let m2 = self.median3_val(mid - eighth, mid, mid + eighth);
        let m3 = self.median3_val(e - 1 - eighth * 2, e - 1 - eighth, e - 1);
        if m1 < m2 then {
            if m2 < m3 then {
                return m2;
            };
            if m1 < m3 then {
                return m3;
            };
            return m1;
        };
        if m1 < m3 then {
            return m1;
        };
        if m2 < m3 then {
            return m3;
        };
        return m2;
    };

    /// Scramble a few slots so adversary shapes (organ pipes, saw teeth)
    /// stop defeating the pivot choice. Deterministic and overflow-safe: the
    /// small-stride recurrence keeps every value below `n`.
    private break_patterns(self, s: UInt, e: UInt): Void = {
        let n = e - s;
        if n <= 16 then {
            return;
        };
        let modulus = n - 1;
        let mutable r = n % 97 + 13;
        let mutable k: UInt = 0;
        while k < 3 then {
            r = (r * 7 + 3) % modulus;
            self.swap_at(s + (k * 5 + 1), s + r);
            k = k + 1;
        };
    };

    /// In-place heap sort over [start, end): the O(n log n) worst-case arm.
    private heap_sort_comparable(self, start: UInt, end: UInt): Void = {
        let count = end - start;
        if count <= 1 then {
            return;
        };
        // Sift the range into a max-heap rooted at slot `start`.
        let mutable i = count / 2;
        while i > 0 then {
            i = i - 1;
            self.sift_down_comparable(start, i, count);
        };
        // Repeatedly move the max into the shrinking tail of the range.
        let mutable last = count - 1;
        while last > 0 then {
            self.swap_at(start, start + last);
            self.sift_down_comparable(start, 0, last);
            last = last - 1;
        };
    };

    /// Sift slot `start + root` down through the first `count` slots.
    private sift_down_comparable(self, start: UInt, root: UInt, count: UInt): Void = {
        let source = self.source;
        let mutable r = root;
        while true then {
            let left = r * 2 + 1;
            if left >= count then {
                return;
            };
            let right = left + 1;
            let mutable child = left;
            if right < count
                and (source + (start + left))[0] < (source + (start + right))[0]
            then {
                child = right;
            };
            if (source + (start + r))[0] >= (source + (start + child))[0] then {
                return;
            };
            self.swap_at(start + r, start + child);
            r = child;
        };
    };

    // Recursive merge sort over [start, end). `buf` is one scratch buffer of
    // `self.len` slots shared by every merge level; each merge vacates the
    // slots it uses before returning, so the reuse is safe.
    private merge_sort_comparable(self, buf: *mutable T, start: UInt, end: UInt): Void = {
        let len = end - start;
        if len <= 32 then {
            self.insertion_sort_comparable(start, end);
            return;
        };

        let mid = start + len / 2;
        self.merge_sort_comparable(buf, start, mid);
        self.merge_sort_comparable(buf, mid, end);
        // Already in order: the left run's maximum is <= the right run's
        // minimum, so the merge would copy every element onto itself.
        let source = self.source;
        if source[mid - 1] <= source[mid] then {
            return;
        };
        self.merge_comparable(buf, start, mid, end);
    };

    // Merge the sorted runs [start, mid) and [mid, end), preferring the left
    // run on equal elements to stay stable. The left run moves wholesale into
    // `buf`; both runs then merge back into the source by move. RC ledger for
    // one merge: the bulk move is a bit move (no retain/release), and each
    // merged element is one take_memory (slot vacated, never dropped) followed
    // by one init_memory into a vacated slot. A dest slot is always vacant:
    // slots [start, mid) were emptied by the bulk move, and slots in
    // [mid, rp) were emptied by earlier right-run takes, while every write
    // lands before rp. The left remainder drains through the same take/init
    // pair; a right remainder is already in place. The cursors are raw
    // pointer walks: pointer arithmetic is unchecked, so the hot loop pays no
    // per-step overflow-guard calls.
    private merge_comparable(self, buf: *mutable T, start: UInt, mid: UInt, end: UInt): Void = {
        let source = self.source;
        let left_end = buf + (mid - start);
        move_memory(buf, source + start, mid - start);

        let mutable lp = buf;
        let mutable rp = source + mid;
        let mutable dp = source + start;
        let right_end = source + end;

        while lp != left_end and rp != right_end then {
            // Use <= to ensure stability (prefer left on equal)
            if lp[0] <= rp[0] then {
                let moved = take_memory(lp);
                init_memory(dp, moved);
                lp = lp + 1;
            } else {
                let moved = take_memory(rp);
                init_memory(dp, moved);
                rp = rp + 1;
            };
            dp = dp + 1;
        };

        while lp != left_end then {
            let moved = take_memory(lp);
            init_memory(dp, moved);
            lp = lp + 1;
            dp = dp + 1;
        };
    };
};
