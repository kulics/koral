// ============================================================================
// Koral Standard Library - Iterator API
// ============================================================================
// Two roles, deliberately different:
//
//   Iterator  -- a CURSOR. One-shot, only advances. `next(self)` is the whole
//                protocol: there is nothing on it that pretends to observe and
//                then quietly steps. A cursor is `type mutable`, so a cursor
//                value names one shared position; handing one to `for` walks
//                it to the end. It gets no adapters and no terminals.
//   Iterable  -- something that can hand out a FRESH cursor on every call.
//
// Lazy pipelines enter through one door, `lazy()`, and stay on `LazyView`:
//
//   list.lazy().filter((x) => x > 0).map((x) => x * 2).count()
//
// Nothing lazy is spelled on the container itself. `dict.take(key)`,
// `string.find(pat)`, `list.first()` and friends stay the container's own
// method, and names like `map` / `filter` / `to_list` / `collect` on a
// container are kept free for a future eager api -- do not spend them here.
//
// A `LazyView[T, R]` holds a cursor FACTORY, not a source: `make () -> R`
// builds a fresh cursor whenever asked. Two type parameters, and the chain
// does not grow a third one per stage. Every terminal builds a cursor, walks
// it, and drops it, so asking twice gives the same answer and the source is
// never spent.
//
// A one-shot source (a file's lines, a socket) is a cursor and stays one. It
// has no `lazy()`. To run a pipeline over it, collect first (`into_list()`).
// ============================================================================

// Generic Iterator trait: a one-shot cursor. Nothing more.
public trait Iterator[T Any] {
    next(self) Option[T];
};

// Iterable trait - types that can produce a fresh iterator on every call
public trait Iterable[T Any, R Iterator[T]] {
    iterator(self) R;
};

// ============================================================================
// Cursors - one-shot, `type mutable`, implement Iterator
// ============================================================================

// FilterIterator - filters elements based on predicate
public type mutable FilterIterator[T Any, R Iterator[T]](
    iter R,
    predicate (T) -> Bool,
);

given[T Any, R Iterator[T]] FilterIterator[T, R] as Iterator[T] {

    public next(self) Option[T] = {
        while self.iter.next() is .Some(v) then {
            if self.predicate(v) then {
                return Option[T].Some(v);
            };
        };
        return Option[T].None();
    };
};

// MapIterator - transforms elements using mapper function
public type mutable MapIterator[T Any, U Any, R Iterator[T]](
    iter R,
    mapper (T) -> U,
);

given[T Any, U Any, R Iterator[T]] MapIterator[T, U, R] as Iterator[U] {

    public next(self) Option[U] = self.iter.next() and then as v in self.mapper(v);
};

// FilterMapIterator - filters and transforms in one operation
public type mutable FilterMapIterator[T Any, U Any, R Iterator[T]](
    iter R,
    mapper (T) -> Option[U],
);

given[T Any, U Any, R Iterator[T]] FilterMapIterator[T, U, R] as Iterator[U] {

    public next(self) Option[U] = {
        while self.iter.next() is .Some(v) then {
            when self.mapper(v) in {
                .Some(u) then {
                    return Option[U].Some(u);
                },
                .None() then {},
            };
        };
        return Option[U].None();
    };
};

// TakeIterator - takes first n elements
public type mutable TakeIterator[T Any, R Iterator[T]](
    iter R,
    mutable limit UInt,
);

given[T Any, R Iterator[T]] TakeIterator[T, R] as Iterator[T] {

    public next(self) Option[T] = {
        if self.limit == 0 then {
            return Option[T].None();
        };
        self.limit -= 1;
        return self.iter.next();
    };
};

// SkipIterator - skips first n elements
public type mutable SkipIterator[T Any, R Iterator[T]](
    iter R,
    mutable to_skip UInt,
);

given[T Any, R Iterator[T]] SkipIterator[T, R] as Iterator[T] {

    public next(self) Option[T] = {
        while self.to_skip > 0 then {
            self.iter.next() or else {
                return Option[T].None();
            };
            self.to_skip -= 1;
        };
        return self.iter.next();
    };
};

// StepIterator - takes every nth element
public type mutable StepIterator[T Any, R Iterator[T]](
    iter R,
    step_size UInt,
    mutable first Bool,
);

given[T Any, R Iterator[T]] StepIterator[T, R] as Iterator[T] {

    public next(self) Option[T] = {
        if self.first then {
            self.first = false;
            return self.iter.next();
        };
        // Skip step_size - 1 elements
        let mutable i UInt = 1;
        while i < self.step_size then {
            self.iter.next() or else {
                return Option[T].None();
            };
            i += 1;
        };
        return self.iter.next();
    };
};

// EnumerateIterator - pairs each element with its index
public type mutable EnumerateIterator[T Any, R Iterator[T]](
    iter R,
    mutable index UInt,
);

given[T Any, R Iterator[T]] EnumerateIterator[T, R] as Iterator[Pair[UInt, T]] {

    public next(self) Option[Pair[UInt, T]] = {
        return self.iter.next() and then as v in {
            let idx = self.index;
            self.index += 1;
            Pair[UInt, T](idx, v)
        };
    };
};

// InspectIterator - executes side effect without modifying elements
public type mutable InspectIterator[T Any, R Iterator[T]](
    iter R,
    action (T) -> Void,
);

given[T Any, R Iterator[T]] InspectIterator[T, R] as Iterator[T] {

    public next(self) Option[T] = {
        return self.iter.next() and then as v in {
            self.action(v);
            v
        };
    };
};

// IntersperseIterator - inserts separator between elements
public type mutable IntersperseIterator[T Any, R Iterator[T]](
    iter R,
    separator T,
    mutable next_is_separator Bool,
    mutable pending Option[T],
);

given[T Any, R Iterator[T]] IntersperseIterator[T, R] as Iterator[T] {

    public next(self) Option[T] = {
        // If we need to return separator
        if self.next_is_separator then {
            when self.pending in {
                .Some(_) then {
                    self.next_is_separator = false;
                    return Option[T].Some(self.separator);
                },
                .None() then {},
            };
        };
        // Return pending value
        when self.pending in {
            .Some(v) then {
                let value = v;
                self.pending = Option[T].None();
                // Prefetch next element
                when self.iter.next() in {
                    .Some(next_v) then {
                        self.pending = Option[T].Some(next_v);
                        self.next_is_separator = true;
                    },
                    .None() then {},
                };
                return Option[T].Some(value);
            },
            .None() then {
                // First call, get first element
                when self.iter.next() in {
                    .Some(v) then {
                        // Prefetch next
                        when self.iter.next() in {
                            .Some(next_v) then {
                                self.pending = Option[T].Some(next_v);
                                self.next_is_separator = true;
                            },
                            .None() then {},
                        };
                        return Option[T].Some(v);
                    },
                    .None() then {
                        return Option[T].None();
                    },
                };
            },
        };
    };
};

// TakeWhileIterator - takes elements while predicate is true
public type mutable TakeWhileIterator[T Any, R Iterator[T]](
    iter R,
    predicate (T) -> Bool,
    mutable done Bool,
);

given[T Any, R Iterator[T]] TakeWhileIterator[T, R] as Iterator[T] {

    public next(self) Option[T] = {
        if self.done then {
            return Option[T].None();
        };
        when self.iter.next() in {
            .Some(v) then {
                if self.predicate(v) then {
                    return Option[T].Some(v);
                } else {
                    self.done = true;
                    return Option[T].None();
                };
            },
            .None() then {
                return Option[T].None();
            },
        };
    };
};

// SkipWhileIterator - skips elements while predicate is true
public type mutable SkipWhileIterator[T Any, R Iterator[T]](
    iter R,
    predicate (T) -> Bool,
    mutable skipping Bool,
);

given[T Any, R Iterator[T]] SkipWhileIterator[T, R] as Iterator[T] {

    public next(self) Option[T] = {
        if not self.skipping then {
            return self.iter.next();
        };
        while self.iter.next() is .Some(v) then {
            if not self.predicate(v) then {
                self.skipping = false;
                return Option[T].Some(v);
            };
        };
        return Option[T].None();
    };
};

// ChainIterator - chains two iterators of the same element type
public type mutable ChainIterator[T Any, R1 Iterator[T], R2 Iterator[T]](
    head R1,
    tail R2,
    mutable use_tail Bool,
);

given[T Any, R1 Iterator[T], R2 Iterator[T]] ChainIterator[T, R1, R2] as Iterator[T] {

    public next(self) Option[T] = {
        if not self.use_tail then {
            when self.head.next() in {
                .Some(v) then {
                    return Option[T].Some(v);
                },
                .None() then {
                    self.use_tail = true;
                },
            };
        };
        return self.tail.next();
    };
};

// ZipIterator - zips two iterators into pairs
public type mutable ZipIterator[A Any, B Any, R1 Iterator[A], R2 Iterator[B]](
    left R1,
    right R2,
);

given[A Any, B Any, R1 Iterator[A], R2 Iterator[B]] ZipIterator[A, B, R1, R2] as Iterator[Pair[A, B]] {

    public next(self) Option[Pair[A, B]] = {
        return when self.left.next() in {
            .Some(a) then when self.right.next() in {
                .Some(b) then Option[Pair[A, B]].Some(Pair[A, B](a, b)),
                .None() then Option[Pair[A, B]].None(),
            },
            .None() then Option[Pair[A, B]].None(),
        };
    };
};

// FlatMapIterator - flattens nested iterators (fully lazy)
public type mutable FlatMapIterator[T Any, U Any, R Iterator[T], InnerR Iterator[U]](
    outer R,
    mapper (T) -> InnerR,
    mutable current_inner Option[InnerR],
);

given[T Any, U Any, R Iterator[T], InnerR Iterator[U]] FlatMapIterator[T, U, R, InnerR] as Iterator[U] {

    public next(self) Option[U] = {
        while true then {
            when self.current_inner in {
                .Some(inner) then {
                    when inner.next() in {
                        .Some(v) then {
                            return Option[U].Some(v);
                        },
                        .None() then {
                            self.current_inner = Option[InnerR].None();
                        },
                    };
                },
                .None() then {
                    when self.outer.next() in {
                        .None() then {
                            return Option[U].None();
                        },
                        .Some(outer_val) then {
                            self.current_inner = Option[InnerR].Some(
                                self.mapper(outer_val),
                            );
                        },
                    };
                },
            };
        };
        return Option[U].None();
    };
};

// ============================================================================
// LazyView - the public face of a lazy pipeline
// ============================================================================
// Enters through `lazy()` and never leaves: an adapter returns another
// `LazyView`, so a chain is written once and never repeats `.lazy()`.
//
// It holds a cursor FACTORY rather than a source. That keeps the signature
// two parameters wide (`T` and the cursor type `R`) no matter how long the
// chain gets, and it means no per-stage view type has to exist at all.

public type LazyView[T Any, R Iterator[T]](make () -> R);

given[T Any, R Iterator[T]] LazyView[T, R] as Iterable[T, R] {

    public iterator(self) R = (self.make)();
};

given[T Any, R Iterator[T]] LazyView[T, R] {

    // More specific than the `Iterable` extension: a LazyView is already a
    // pipeline, so `x.lazy().lazy()` is `x.lazy()` and not a nesting.
    public lazy(self) LazyView[T, R] = self;

    // ========================================================================
    // Adapters - each one wraps the cursor this view already builds
    // ========================================================================

    public filter(self, fn (T) -> Bool) LazyView[T, FilterIterator[T, R]] = {
        let base = self.make;
        return LazyView[T, FilterIterator[T, R]](() => FilterIterator[T, R](base(), fn));
    };

    public map[U Any](self, fn (T) -> U) LazyView[U, MapIterator[T, U, R]] = {
        let base = self.make;
        return LazyView[U, MapIterator[T, U, R]](() => MapIterator[T, U, R](base(), fn));
    };

    public filter_map[U Any](
        self,
        fn (T) -> Option[U],
    ) LazyView[U, FilterMapIterator[T, U, R]] = {
        let base = self.make;
        return LazyView[U, FilterMapIterator[T, U, R]](
            () => FilterMapIterator[T, U, R](base(), fn),
        );
    };

    public take(self, n UInt) LazyView[T, TakeIterator[T, R]] = {
        let base = self.make;
        return LazyView[T, TakeIterator[T, R]](() => TakeIterator[T, R](base(), n));
    };

    public skip(self, n UInt) LazyView[T, SkipIterator[T, R]] = {
        let base = self.make;
        return LazyView[T, SkipIterator[T, R]](() => SkipIterator[T, R](base(), n));
    };

    public step_by(self, n UInt) LazyView[T, StepIterator[T, R]] = {
        if n < 1 then {
            panic("step size must be at least 1");
        };
        let base = self.make;
        return LazyView[T, StepIterator[T, R]](
            () => StepIterator[T, R](base(), n, true),
        );
    };

    public enumerate(self) LazyView[Pair[UInt, T], EnumerateIterator[T, R]] = {
        let base = self.make;
        return LazyView[Pair[UInt, T], EnumerateIterator[T, R]](
            () => EnumerateIterator[T, R](base(), 0),
        );
    };

    public inspect(self, fn (T) -> Void) LazyView[T, InspectIterator[T, R]] = {
        let base = self.make;
        return LazyView[T, InspectIterator[T, R]](
            () => InspectIterator[T, R](base(), fn),
        );
    };

    public intersperse(self, v T) LazyView[T, IntersperseIterator[T, R]] = {
        let base = self.make;
        return LazyView[T, IntersperseIterator[T, R]](
            () => IntersperseIterator[T, R](base(), v, false, Option[T].None()),
        );
    };

    public take_while(self, fn (T) -> Bool) LazyView[T, TakeWhileIterator[T, R]] = {
        let base = self.make;
        return LazyView[T, TakeWhileIterator[T, R]](
            () => TakeWhileIterator[T, R](base(), fn, false),
        );
    };

    public skip_while(self, fn (T) -> Bool) LazyView[T, SkipWhileIterator[T, R]] = {
        let base = self.make;
        return LazyView[T, SkipWhileIterator[T, R]](
            () => SkipWhileIterator[T, R](base(), fn, true),
        );
    };

    public chain[R2 Iterator[T], S2 Iterable[T, R2]](
        self,
        other S2,
    ) LazyView[T, ChainIterator[T, R, R2]] = {
        let base = self.make;
        let src = other;
        return LazyView[T, ChainIterator[T, R, R2]](
            () => ChainIterator[T, R, R2](base(), src.iterator(), false),
        );
    };

    public zip[U Any, R2 Iterator[U], S2 Iterable[U, R2]](
        self,
        other S2,
    ) LazyView[Pair[T, U], ZipIterator[T, U, R, R2]] = {
        let base = self.make;
        let src = other;
        return LazyView[Pair[T, U], ZipIterator[T, U, R, R2]](
            () => ZipIterator[T, U, R, R2](base(), src.iterator()),
        );
    };

    public flat_map[U Any, InnerR Iterator[U], InnerS Iterable[U, InnerR]](
        self,
        fn (T) -> InnerS,
    ) LazyView[U, FlatMapIterator[T, U, R, InnerR]] = {
        let base = self.make;
        let mapper = fn;
        return LazyView[U, FlatMapIterator[T, U, R, InnerR]](
            () => FlatMapIterator[T, U, R, InnerR](
                base(),
                (item) => mapper(item).iterator(),
                Option[InnerR].None(),
            ),
        );
    };

    // ========================================================================
    // Terminals - each one on a fresh cursor, then throw the cursor away
    // ========================================================================

    // Fold - reduce with initial value
    public fold[U Any](self, initial U, fn (U, T) -> U) U = {
        let mutable acc = initial;
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            acc = fn(acc, v);
        };
        return acc;
    };

    // Reduce - reduce without initial value
    public reduce(self, fn (T, T) -> T) Option[T] = {
        let iter = self.iterator();
        when iter.next() in {
            .None() then {
                return Option[T].None();
            },
            .Some(first) then {
                let mutable acc = first;
                while iter.next() is .Some(v) then {
                    acc = fn(acc, v);
                };
                return Option[T].Some(acc);
            },
        };
    };

    // ToList - collect into List
    public into_list(self) List[T] = {
        let mutable result List[T] = [];
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            result.push(v);
        };
        return result;
    };

    // ForEach - execute side effect for each element
    public for_each(self, fn (T) -> Void) Void = {
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            fn(v);
        };
    };

    // Count - count elements
    public count(self) UInt = {
        let mutable n UInt = 0;
        let iter = self.iterator();
        while iter.next() is .Some(_) then {
            n += 1;
        };
        return n;
    };

    // First - get first element
    public first(self) Option[T] = {
        let iter = self.iterator();
        return iter.next();
    };

    // Last - get last element
    public last(self) Option[T] = {
        let mutable result = Option[T].None();
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            result = Option[T].Some(v);
        };
        return result;
    };

    // Nth - get element at index
    public nth(self, n UInt) Option[T] = {
        let iter = self.iterator();
        let mutable i UInt = 0;
        while iter.next() is .Some(v) then {
            if i == n then {
                return Option[T].Some(v);
            };
            i += 1;
        };
        return Option[T].None();
    };

    // Position - find index of first element matching predicate
    public position(self, fn (T) -> Bool) Option[UInt] = {
        let iter = self.iterator();
        let mutable i UInt = 0;
        while iter.next() is .Some(v) then {
            if fn(v) then {
                return Option[UInt].Some(i);
            };
            i += 1;
        };
        return Option[UInt].None();
    };

    // Find - find first element matching predicate
    public find(self, fn (T) -> Bool) Option[T] = {
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            if fn(v) then {
                return Option[T].Some(v);
            };
        };
        return Option[T].None();
    };

    // FindMap - find first element that maps to Some
    public find_map[U Any](self, fn (T) -> Option[U]) Option[U] = {
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            when fn(v) in {
                .Some(u) then {
                    return Option[U].Some(u);
                },
                .None() then {},
            };
        };
        return Option[U].None();
    };

    // Any - check if any element matches predicate
    public any(self, fn (T) -> Bool) Bool = {
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            if fn(v) then {
                return true;
            };
        };
        return false;
    };

    // All - check if all elements match predicate
    public all(self, fn (T) -> Bool) Bool = {
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            if not fn(v) then {
                return false;
            };
        };
        return true;
    };

    // IsEmpty - check if there is nothing to iterate
    //
    // Observational: it builds a cursor, looks at one element, and throws the
    // cursor away. The pipeline is untouched.
    public is_empty(self) Bool = {
        let iter = self.iterator();
        return iter.next().is_none();
    };

    // MaxBy - find element with maximum key
    public max_by[K Ord](self, fn (T) -> K) Option[T] = {
        let iter = self.iterator();
        when iter.next() in {
            .None() then {
                return Option[T].None();
            },
            .Some(first) then {
                let mutable result = first;
                let mutable result_key = fn(first);
                while iter.next() is .Some(v) then {
                    let key = fn(v);
                    if key > result_key then {
                        result = v;
                        result_key = key;
                    };
                };
                return Option[T].Some(result);
            },
        };
    };

    // MinBy - find element with minimum key
    public min_by[K Ord](self, fn (T) -> K) Option[T] = {
        let iter = self.iterator();
        when iter.next() in {
            .None() then {
                return Option[T].None();
            },
            .Some(first) then {
                let mutable result = first;
                let mutable result_key = fn(first);
                while iter.next() is .Some(v) then {
                    let key = fn(v);
                    if key < result_key then {
                        result = v;
                        result_key = key;
                    };
                };
                return Option[T].Some(result);
            },
        };
    };
};

// ============================================================================
// Terminals with Eq constraint
// ============================================================================
given[T Eq, R Iterator[T]] LazyView[T, R] {

    // Contains - check if a value appears
    public contains(self, value T) Bool = {
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            if v == value then {
                return true;
            };
        };
        return false;
    };
};

// ============================================================================
// Terminals with Ord constraint
// ============================================================================
given[T Ord, R Iterator[T]] LazyView[T, R] {

    // Max - find maximum element
    public max(self) Option[T] = {
        let iter = self.iterator();
        when iter.next() in {
            .None() then {
                return Option[T].None();
            },
            .Some(first) then {
                let mutable result = first;
                while iter.next() is .Some(v) then {
                    if v > result then {
                        result = v;
                    };
                };
                return Option[T].Some(result);
            },
        };
    };

    // Min - find minimum element
    public min(self) Option[T] = {
        let iter = self.iterator();
        when iter.next() in {
            .None() then {
                return Option[T].None();
            },
            .Some(first) then {
                let mutable result = first;
                while iter.next() is .Some(v) then {
                    if v < result then {
                        result = v;
                    };
                };
                return Option[T].Some(result);
            },
        };
    };
};

// ============================================================================
// Terminals with Hash constraint
// ============================================================================
given[T Hash, R Iterator[T]] LazyView[T, R] {

    // ToSet - collect into Set
    public into_set(self) Set[T] = {
        let mutable result = Set[T].new();
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            result.insert(v);
        };
        return result;
    };
};

// ============================================================================
// Numeric Aggregations
// ============================================================================
given[T Add[T] and Zero, R Iterator[T]] LazyView[T, R] {

    // Sum - sums elements using Zero.zero/Add.add
    public sum(self) T = {
        let mutable acc = T.zero();
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            acc = acc.add(v);
        };
        return acc;
    };
};

given[T Mul[T] and One, R Iterator[T]] LazyView[T, R] {

    // Product - multiplies elements using One.one/Mul.mul
    public product(self) T = {
        let mutable acc = T.one();
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            acc = acc.mul(v);
        };
        return acc;
    };
};

given[T Add[T] and Div[T] and Zero and One, R Iterator[T]] LazyView[T, R] {

    // Average - returns None for empty pipelines to avoid division by zero.
    public average(self) Option[T] = {
        let mutable acc = T.zero();
        let mutable count = 0;
        let mutable count_t = T.zero();
        let iter = self.iterator();
        while iter.next() is .Some(v) then {
            acc = acc.add(v);
            count += 1;
            count_t = count_t.add(T.one());
        };
        return if count == 0 then Option[T].None() else Option[T].Some(acc.div(count_t));
    };
};

// ============================================================================
// The one door in
// ============================================================================
given[T Any, R Iterator[T]] Iterable[T, R] {

    // Enter a lazy pipeline. Adapters and terminals live on `LazyView`, so
    // nothing lazy is spelled on the container -- `map`, `filter`, `to_list`
    // and friends stay free there for a future eager api.
    public lazy(self) LazyView[T, R] = {
        let src = self;
        return LazyView[T, R](() => src.iterator());
    };
};
