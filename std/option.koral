// ============================================================================
// Koral Standard Library - Option Type
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives and traits are already available.
// ============================================================================

// ============================================================================
// Option Type Definition
// ============================================================================
/// An optional value: either `Some` carrying a value or `None` carrying nothing.
public type sendable Option[T: Any] {
    None(),
    Some(value: T),
};

// ============================================================================
// Option Methods
// ============================================================================
/// Querying, extracting, and transforming an optional value.
given[T: Any] Option[T] {

    /// Return whether the option holds a value.
    public is_some(self): Bool = when self in {
        .Some(_) then true,
        .None() then false,
    };
    /// Return whether the option is empty.
    public is_none(self): Bool = when self in {
        .None() then true,
        .Some(_) then false,
    };
    /// Return the held value; panics if the option is `None`.
    public unwrap(self): T = when self in {
        .Some(v) then v,
        .None() then panic("Option.unwrap failed: value is None"),
    };
    /// Return the held value; panics with `message` if the option is `None`.
    public expect(self, message: String): T = when self in {
        .Some(v) then v,
        .None() then panic("Option.expect failed: " + message),
    };
    /// Return the held value, or `default` when the option is `None`.
    public unwrap_or(self, default: T): T = self or else default;

    /// Transform the held value with `f`: `Some(f(v))` for `Some(v)`, `None` for `None`.
    public map[U: Any](self, f: (T) -> U): Option[U] = self and then as v in f(v);

    /// Return `Some(value)` only when the predicate accepts `value`, otherwise `None`.
    public filter(self, predicate: (T) -> Bool): Option[T] = when self in {
        .None() then Option[T].None(),
        .Some(v) then if predicate(v) then .Some(v) else .None(),
    };
};

/// `Default` for `Option[T]`: the empty option.
given[T: Any] Option[T]: Default {

    /// Return the empty option, `None`.
    public default(): Self = Option[T].None();
};

/// `Eq` for `Option[T]`: `None` matches `None`, and `Some` values compare with `==`.
given[T: Eq] Option[T]: Eq {

    /// Return whether `self` and `other` are both `None` or hold equal values.
    public equals(self, other: Option[T]): Bool = when self in {
        .None() then other.is_none(),
        .Some(a) then when other in {
            .None() then false,
            .Some(b) then a == b,
        },
    };
};
