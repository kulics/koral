// Float32 FFI Declarations
// ============================================================================
let foreign __koral_f32_sqrt(x: Float32): Float32;
let foreign __koral_f32_cbrt(x: Float32): Float32;
let foreign __koral_f32_pow(x: Float32, y: Float32): Float32;
let foreign __koral_f32_hypot(x: Float32, y: Float32): Float32;
let foreign __koral_f32_exp(x: Float32): Float32;
let foreign __koral_f32_exp2(x: Float32): Float32;
let foreign __koral_f32_expm1(x: Float32): Float32;
let foreign __koral_f32_log(x: Float32): Float32;
let foreign __koral_f32_log2(x: Float32): Float32;
let foreign __koral_f32_log10(x: Float32): Float32;
let foreign __koral_f32_log1p(x: Float32): Float32;
let foreign __koral_f32_sin(x: Float32): Float32;
let foreign __koral_f32_cos(x: Float32): Float32;
let foreign __koral_f32_tan(x: Float32): Float32;
let foreign __koral_f32_asin(x: Float32): Float32;
let foreign __koral_f32_acos(x: Float32): Float32;
let foreign __koral_f32_atan(x: Float32): Float32;
let foreign __koral_f32_atan2(y: Float32, x: Float32): Float32;
let foreign __koral_f32_sinh(x: Float32): Float32;
let foreign __koral_f32_cosh(x: Float32): Float32;
let foreign __koral_f32_tanh(x: Float32): Float32;
let foreign __koral_f32_asinh(x: Float32): Float32;
let foreign __koral_f32_acosh(x: Float32): Float32;
let foreign __koral_f32_atanh(x: Float32): Float32;
let foreign __koral_f32_floor(x: Float32): Float32;
let foreign __koral_f32_ceil(x: Float32): Float32;
