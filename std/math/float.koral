let foreign __koral_f32_copysign(x: Float32, y: Float32): Float32;
let foreign __koral_f32_fmod(x: Float32, y: Float32): Float32;
let foreign __koral_f32_fma(x: Float32, y: Float32, z: Float32): Float32;
let foreign __koral_f32_erf(x: Float32): Float32;
