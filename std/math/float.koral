let foreign __koral_f32_lgamma(x: Float32): Float32;

/// `Numeric` for `Float64`: absolute value by clearing the sign bit.
given Float64: Numeric {

    abs(self): Self = __koral_f64_fabs(self);
};

/// `Default` for `Float64`: returns zero.
given Float64: Default {

    /// Return the default value of `Float64`, which is 0.0.
    public default(): Self = 0.0;
};

/// `FloatingPoint` for `Float64`: roots, powers, logarithms, and rounding in double precision.
given Float64: FloatingPoint {

    sqrt(x: Self): Self = __koral_f64_sqrt(x);
    cbrt(x: Self): Self = __koral_f64_cbrt(x);
    pow(self, exp: Self): Self = __koral_f64_pow(self, exp);
    powi(self, exp: Int): Self = {
        // The exponent magnitude is taken through `UInt` so that
        // `Int.min_value()` does not overflow on negation.
        let neg = exp < 0;
        let mutable e: UInt = if neg then UInt(0 - (exp + 1)) + 1 else UInt(exp);
        let mutable result = 1.0;
        let mutable b = self;
        while e > 0 then {
            if e % 2 == 1 then {
                result = result * b;
            };
            b = b * b;
            e = e / 2;
        };
        return if neg then 1.0 / result else result;
    };
    hypot(x: Self, y: Self): Self = __koral_f64_hypot(x, y);
    log(x: Self, base: Self =): Self = __koral_f64_log(x) / __koral_f64_log(base);

    ln(x: Self): Self = __koral_f64_log(x);
    log2(x: Self): Self = __koral_f64_log2(x);
    log10(x: Self): Self = __koral_f64_log10(x);

    floor(self): Self = __koral_f64_floor(self);
    ceil(self): Self = __koral_f64_ceil(self);
    round(self): Self = __koral_f64_round(self);
    trunc(self): Self = __koral_f64_trunc(self);
    signum(self): Self = if self.is_nan() then Float64.nan()
    else if self > 0.0 then 1.0 else if self < 0.0 then -1.0 else 0.0;
    fract(self): Self = self - __koral_f64_trunc(self);
    copysign(self, sign: Self): Self = __koral_f64_copysign(self, sign);
    fmod(self, y: Self): Self = __koral_f64_fmod(self, y);

    fma(x: Self, mul: Self, add: Self): Self = __koral_f64_fma(x, mul, add);
    to_radians(self): Self = self * (Float64.pi() / 180.0);
    to_degrees(self): Self = self * (180.0 / Float64.pi());

    pi(): Self = 3.14159265358979323846;
    e(): Self = 2.71828182845904523536;
    tau(): Self = 6.28318530717958647692;
    ln2(): Self = 0.693147180559945309417;
    ln10(): Self = 2.30258509299404568402;
    sqrt2(): Self = 1.41421356237309504880;
};

/// `FloatMath` for `Float64`: transcendental and special functions in double precision.
given Float64: FloatMath {

    exp(x: Self): Self = __koral_f64_exp(x);
    exp2(x: Self): Self = __koral_f64_exp2(x);
    exp_m1(x: Self): Self = __koral_f64_expm1(x);
    ln_1p(x: Self): Self = __koral_f64_log1p(x);
    sin(x: Self): Self = __koral_f64_sin(x);
    cos(x: Self): Self = __koral_f64_cos(x);
    tan(x: Self): Self = __koral_f64_tan(x);
    asin(x: Self): Self = __koral_f64_asin(x);
    acos(x: Self): Self = __koral_f64_acos(x);
    atan(x: Self): Self = __koral_f64_atan(x);
    atan2(y: Self, x: Self): Self = __koral_f64_atan2(y, x);
    sinh(x: Self): Self = __koral_f64_sinh(x);
    cosh(x: Self): Self = __koral_f64_cosh(x);
    tanh(x: Self): Self = __koral_f64_tanh(x);
    asinh(x: Self): Self = __koral_f64_asinh(x);
    acosh(x: Self): Self = __koral_f64_acosh(x);
    atanh(x: Self): Self = __koral_f64_atanh(x);
    erf(x: Self): Self = __koral_f64_erf(x);
    erfc(x: Self): Self = __koral_f64_erfc(x);
    gamma(x: Self): Self = __koral_f64_tgamma(x);
    log_gamma(x: Self): Self = __koral_f64_lgamma(x);
};

/// `Numeric` for `Float32`: absolute value by clearing the sign bit.
given Float32: Numeric {

    abs(self): Self = __koral_f32_fabs(self);
};

/// `Default` for `Float32`: returns zero.
given Float32: Default {

    /// Return the default value of `Float32`, which is 0.0.
    public default(): Self = Float32(0.0);
};

/// `FloatingPoint` for `Float32`: roots, powers, logarithms, and rounding in single precision.
given Float32: FloatingPoint {

    sqrt(x: Self): Self = __koral_f32_sqrt(x);
    cbrt(x: Self): Self = __koral_f32_cbrt(x);
    pow(self, exp: Self): Self = __koral_f32_pow(self, exp);
    powi(self, exp: Int): Self = {
        // The exponent magnitude is taken through `UInt` so that
        // `Int.min_value()` does not overflow on negation.
        let neg = exp < 0;
        let mutable e: UInt = if neg then UInt(0 - (exp + 1)) + 1 else UInt(exp);
        let mutable result: Float32 = 1.0;
        let mutable b = self;
        while e > 0 then {
            if e % 2 == 1 then {
                result = result * b;
            };
            b = b * b;
            e = e / 2;
        };
        return if neg then 1.0 / result else result;
    };
    hypot(x: Self, y: Self): Self = __koral_f32_hypot(x, y);
    log(x: Self, base: Self =): Self = __koral_f32_log(x) / __koral_f32_log(base);

    ln(x: Self): Self = __koral_f32_log(x);
    log2(x: Self): Self = __koral_f32_log2(x);
    log10(x: Self): Self = __koral_f32_log10(x);

    floor(self): Self = __koral_f32_floor(self);
    ceil(self): Self = __koral_f32_ceil(self);
    round(self): Self = __koral_f32_round(self);
    trunc(self): Self = __koral_f32_trunc(self);
    signum(self): Self = if self.is_nan() then Float32.nan()
    else if self > 0.0 then 1.0 else if self < 0.0 then -1.0 else 0.0;
    fract(self): Self = self - __koral_f32_trunc(self);
    copysign(self, sign: Self): Self = __koral_f32_copysign(self, sign);
    fmod(self, y: Self): Self = __koral_f32_fmod(self, y);

    fma(x: Self, mul: Self, add: Self): Self = __koral_f32_fma(x, mul, add);
    to_radians(self): Self = self * (Float32.pi() / 180.0);
    to_degrees(self): Self = self * (180.0 / Float32.pi());

    pi(): Self = 3.14159274;
    e(): Self = 2.71828175;
    tau(): Self = 6.28318548;
    ln2(): Self = 0.693147182;
    ln10(): Self = 2.30258512;
    sqrt2(): Self = 1.41421354;
};

/// `FloatMath` for `Float32`: transcendental and special functions in single precision.
given Float32: FloatMath {

    exp(x: Self): Self = __koral_f32_exp(x);
    exp2(x: Self): Self = __koral_f32_exp2(x);
    exp_m1(x: Self): Self = __koral_f32_expm1(x);
    ln_1p(x: Self): Self = __koral_f32_log1p(x);
    sin(x: Self): Self = __koral_f32_sin(x);
    cos(x: Self): Self = __koral_f32_cos(x);
    tan(x: Self): Self = __koral_f32_tan(x);
    asin(x: Self): Self = __koral_f32_asin(x);
    acos(x: Self): Self = __koral_f32_acos(x);
    atan(x: Self): Self = __koral_f32_atan(x);
    atan2(y: Self, x: Self): Self = __koral_f32_atan2(y, x);
    sinh(x: Self): Self = __koral_f32_sinh(x);
    cosh(x: Self): Self = __koral_f32_cosh(x);
    tanh(x: Self): Self = __koral_f32_tanh(x);
    asinh(x: Self): Self = __koral_f32_asinh(x);
    acosh(x: Self): Self = __koral_f32_acosh(x);
    atanh(x: Self): Self = __koral_f32_atanh(x);
    erf(x: Self): Self = __koral_f32_erf(x);
    erfc(x: Self): Self = __koral_f32_erfc(x);
    gamma(x: Self): Self = __koral_f32_tgamma(x);
    log_gamma(x: Self): Self = __koral_f32_lgamma(x);
};

// ============================================================================
// Binary Floating Point Generic Free Functions
// ============================================================================

// 幂与根
/// Return the non-negative square root of x, or NaN when x is negative.
public let sqrt[T: FloatingPoint](x: T): T = T.sqrt(x);
/// Return the cube root of x, which is defined for negative x.
public let cbrt[T: FloatingPoint](x: T): T = T.cbrt(x);
/// Return the hypotenuse sqrt(x * x + y * y), computed without intermediate overflow.
public let hypot[T: FloatingPoint](x: T, y: T): T = T.hypot(x, y);

// 指数与对数
/// Return e raised to the power x.
public let exp[T: FloatMath](x: T): T = T.exp(x);
/// Return 2 raised to the power x.
public let exp2[T: FloatMath](x: T): T = T.exp2(x);
/// Return e raised to the power x minus one, computed accurately near zero.
public let exp_m1[T: FloatMath](x: T): T = T.exp_m1(x);
/// Return the natural logarithm of x; zero yields negative infinity and negative x yields NaN.
public let ln[T: FloatingPoint](x: T): T = T.ln(x);
/// Return the base-2 logarithm of x; zero yields negative infinity and negative x yields NaN.
public let log2[T: FloatingPoint](x: T): T = T.log2(x);
/// Return the base-10 logarithm of x; zero yields negative infinity and negative x yields NaN.
public let log10[T: FloatingPoint](x: T): T = T.log10(x);
/// Return the natural logarithm of 1 + x, computed accurately near zero.
public let ln_1p[T: FloatMath](x: T): T = T.ln_1p(x);

// 三角函数
/// Return the sine of x, with x in radians.
public let sin[T: FloatMath](x: T): T = T.sin(x);
/// Return the cosine of x, with x in radians.
public let cos[T: FloatMath](x: T): T = T.cos(x);
/// Return the tangent of x, with x in radians.
public let tan[T: FloatMath](x: T): T = T.tan(x);
/// Return the arcsine of x in radians within [-pi/2, pi/2], or NaN outside [-1, 1].
public let asin[T: FloatMath](x: T): T = T.asin(x);
/// Return the arccosine of x in radians within [0, pi], or NaN outside [-1, 1].
public let acos[T: FloatMath](x: T): T = T.acos(x);
/// Return the arctangent of x in radians within (-pi/2, pi/2).
public let atan[T: FloatMath](x: T): T = T.atan(x);
/// Return the arctangent of y / x in radians within (-pi, pi], chosen by the signs of both arguments.
public let atan2[T: FloatMath](y: T, x: T): T = T.atan2(y, x);

// 双曲函数
/// Return the hyperbolic sine of x.
public let sinh[T: FloatMath](x: T): T = T.sinh(x);
/// Return the hyperbolic cosine of x.
public let cosh[T: FloatMath](x: T): T = T.cosh(x);
/// Return the hyperbolic tangent of x.
public let tanh[T: FloatMath](x: T): T = T.tanh(x);
/// Return the inverse hyperbolic sine of x.
public let asinh[T: FloatMath](x: T): T = T.asinh(x);
/// Return the inverse hyperbolic cosine of x, or NaN below 1.
public let acosh[T: FloatMath](x: T): T = T.acosh(x);
/// Return the inverse hyperbolic tangent of x, or NaN outside (-1, 1).
public let atanh[T: FloatMath](x: T): T = T.atanh(x);

// 取整与符号

// 融合乘加与线性插值
/// Return x * mul + add fused into a single rounding.
public let fma[T: FloatingPoint](x: T, mul: T, add: T): T = T.fma(x, mul, add);
/// Return the linear interpolation between a and b at t, computed as a + t * (b - a).
public let lerp[T: FloatingPoint](a: T, b: T, t: T): T = a.add(t.mul(b.sub(a)));

// 特殊函数
/// Return the error function of x.
public let erf[T: FloatMath](x: T): T = T.erf(x);
/// Return the complementary error function 1 - erf(x).
public let erfc[T: FloatMath](x: T): T = T.erfc(x);
/// Return the gamma function of x, or NaN at the non-positive integers.
public let gamma[T: FloatMath](x: T): T = T.gamma(x);
/// Return the natural logarithm of the absolute value of the gamma function of x.
public let log_gamma[T: FloatMath](x: T): T = T.log_gamma(x);

/// Return the logarithm of x in the given base, computed as ln(x) / ln(base).
/// The domain is x > 0 with a positive base different from 1.
public let log[T: FloatingPoint](x: T, base: T =): T = T.log(x, base = base);
