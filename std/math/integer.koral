    gcd(a Self, b Self) Self = {
        let x = if a < 0 then -a else a;
        let y = if b < 0 then -b else b;
        return gcd_nonneg(x, y, Int(0));
    };

    lcm(a Self, b Self) Self = {
        if a == 0 or b == 0 then {
            return 0;
        };
        let g = gcd_nonneg(if a < 0 then -a else a, if b < 0 then -b else b, Int(0));
        let result = (a / g) * b;
