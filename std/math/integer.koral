        let mutable count: UInt = 0;
        while (n & 1) == 0 then {
            count = count + 1;
            n = n >> 1;
        };
        count
    };

    public leading_ones(self): UInt = (~self).leading_zeros();

    public trailing_ones(self): UInt = (~self).trailing_zeros();

    public rotate_left(self, n: UInt): Self = {
        let bits: UInt = 64;
        let shift = n % bits;
        return (self << shift) | (self >> (bits - shift));
    };

    public rotate_right(self, n: UInt): Self = {
        let bits: UInt = 64;
        let shift = n % bits;
        return (self >> shift) | (self << (bits - shift));
    };

    public reverse_bits(self): Self = {
        let mutable n = self;
        let mutable result: UInt = 0;
        let mutable i: UInt = 0;
        while i < 64 then {
            result = (result << 1) | (n & 1);
            n = n >> 1;
            i = i + 1;
        };
        return result;
    };

    public swap_bytes(self): Self = {
        let b0 = (self & 255) << 56;
        let b1 = ((self >> 8) & 255) << 48;
        let b2 = ((self >> 16) & 255) << 40;
        let b3 = ((self >> 24) & 255) << 32;
        let b4 = ((self >> 32) & 255) << 24;
        let b5 = ((self >> 40) & 255) << 16;
        let b6 = ((self >> 48) & 255) << 8;
        let b7 = (self >> 56) & 255;
        let mutable result = b0 | b1;
        result = result | b2;
        result = result | b3;
        result = result | b4;
        result = result | b5;
        result = result | b6;
        result = result | b7;
        return result;
    };
};

// ============================================================================
// Wrapping Family - the same toolbox, the same text
// ============================================================================
// Identical method bodies to the regular twins above. Where a regular type
// panics on overflow these wrap instead -- not because the body says so, but
// because `+ - * / %` wrap on this family. Both toolboxes are shared across the
// families: `Numeric`/`Integer` (mathematical integer) and `BinaryInteger`
// (fixed-width binary word). The bit methods delegate to the same-width plain
// twin through a lossless retype; they are total functions, so the family the
// work happens in cannot be observed.

given WrappingInt8: Numeric {

    abs(self): Self = if self < 0 then -self else self;
};

given WrappingInt8: Integer {

    pow(self, exp: UInt): Self = pow_nonwrap(self, exp, 1);

    gcd(a: Self, b: Self): Self = {
        let x = if a < 0 then -a else a;
        let y = if b < 0 then -b else b;
        return gcd_nonneg(x, y, 0);
    };

    lcm(a: Self, b: Self): Self = {
        if a == 0 or b == 0 then {
            return 0;
        };
        let g = gcd_nonneg(if a < 0 then -a else a, if b < 0 then -b else b, 0);
        let result = (a / g) * b;
        return if result < 0 then -result else result;
    };

    ilog2(x: Self): UInt = {
        if x == 0 then panic("ilog2: argument is zero");
        let v = if x < 0 then -x else x;
        return ilog_nonneg(v, 0, 2, "ilog2: argument is zero");
    };

    ilog10(x: Self): UInt = {
        if x == 0 then panic("ilog10: argument is zero");
        let v = if x < 0 then -x else x;
        return ilog_nonneg(v, 0, 10, "ilog10: argument is zero");
    };
};

