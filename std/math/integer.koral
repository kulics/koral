    count_zeros(self): UInt = Int(self).count_zeros();

    leading_zeros(self): UInt = Int(self).leading_zeros();

    trailing_zeros(self): UInt = Int(self).trailing_zeros();

    leading_ones(self): UInt = Int(self).leading_ones();

    trailing_ones(self): UInt = Int(self).trailing_ones();

    rotate_left(self, n: UInt): Self = WrappingInt(Int(self).rotate_left(n));

    rotate_right(self, n: UInt): Self = WrappingInt(Int(self).rotate_right(n));

    reverse_bits(self): Self = WrappingInt(Int(self).reverse_bits());

    swap_bytes(self): Self = WrappingInt(Int(self).swap_bytes());
};
given WrappingUInt: Numeric {

    abs(self): Self = self;
};

given WrappingUInt: Integer {

    pow(self, exp: UInt): Self = pow_nonwrap(self, exp, 1);

    gcd(a: Self, b: Self): Self = gcd_nonneg(a, b, 0);

    lcm(a: Self, b: Self): Self = lcm_nonneg(a, b, 0);

    ilog2(x: Self): UInt = ilog_nonneg(x, 0, 2, "ilog2: argument is zero");

    ilog10(x: Self): UInt = ilog_nonneg(x, 0, 10, "ilog10: argument is zero");
};

given WrappingUInt: BinaryInteger {

    count_ones(self): UInt = UInt(self).count_ones();

    count_zeros(self): UInt = UInt(self).count_zeros();

    leading_zeros(self): UInt = UInt(self).leading_zeros();

    trailing_zeros(self): UInt = UInt(self).trailing_zeros();

    leading_ones(self): UInt = UInt(self).leading_ones();

    trailing_ones(self): UInt = UInt(self).trailing_ones();

    rotate_left(self, n: UInt): Self = WrappingUInt(UInt(self).rotate_left(n));

    rotate_right(self, n: UInt): Self = WrappingUInt(UInt(self).rotate_right(n));

    reverse_bits(self): Self = WrappingUInt(UInt(self).reverse_bits());

    swap_bytes(self): Self = WrappingUInt(UInt(self).swap_bytes());
};
// ============================================================================
// Integer Generic Free Functions
// ============================================================================
public let gcd[T: Integer](a: T, b: T): T = T.gcd(a, b);
public let lcm[T: Integer](a: T, b: T): T = T.lcm(a, b);
public let ilog2[T: Integer](x: T): UInt = T.ilog2(x);
public let ilog10[T: Integer](x: T): UInt = T.ilog10(x);
