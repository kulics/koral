/// `Numeric` for `Int`: absolute value, panicking at the minimum value.
given Int: Numeric {

    abs(self): Self = if self < 0 then -self else self;
};

/// `Integer` for `Int`: integer powers, gcd, lcm, and integer logarithms, panicking on overflow.
given Int: Integer {

    pow(self, exp: UInt): Self = pow_nonwrap(self, exp, 1);

    gcd(a: Self, b: Self): Self = {
        let x = if a < 0 then UInt(0 - (a + 1)) + 1 else UInt(a);
        let y = if b < 0 then UInt(0 - (b + 1)) + 1 else UInt(b);
        let g = gcd_nonneg(x, y, 0);
        let r = Int(g);
        if r < 0 then panic("gcd: result overflow");
        return r;
    };

    lcm(a: Self, b: Self): Self = {
        if a == 0 or b == 0 then {
            return 0;
        };
        let x = if a < 0 then UInt(0 - (a + 1)) + 1 else UInt(a);
        let y = if b < 0 then UInt(0 - (b + 1)) + 1 else UInt(b);
        let g = gcd_nonneg(x, y, 0);
        let r = Int((x / g) * y);
        if r < 0 then panic("lcm: result overflow");
        return r;
    };

    ilog2(x: Self): UInt = {
        if x == 0 then panic("ilog2: argument is zero");
        let v = if x < 0 then UInt(0 - (x + 1)) + 1 else UInt(x);
        return ilog_nonneg(v, 0, 2, "ilog2: argument is zero");
    };

    ilog10(x: Self): UInt = {
        if x == 0 then panic("ilog10: argument is zero");
        let v = if x < 0 then UInt(0 - (x + 1)) + 1 else UInt(x);
        return ilog_nonneg(v, 0, 10, "ilog10: argument is zero");
    };
};

