// ============================================================================
// Wrapping Family - the same toolbox, the same text
// ============================================================================
// Identical method bodies to the regular twins above. Where a regular type
// panics on overflow these wrap instead -- not because the body says so, but
// because `+ - * / %` wrap on this family. Both toolboxes are shared across the
// families: `Numeric`/`Integer` (mathematical integer) and `BinaryInteger`
// (fixed-width binary word). The bit methods delegate to the same-width plain
// twin through a lossless retype; they are total functions, so the family the
// work happens in cannot be observed.

/// `Numeric` for `WrappingInt8`: absolute value, wrapping at the minimum value.
given WrappingInt8: Numeric {

    abs(self): Self = if self < 0 then -self else self;
};

/// `Integer` for `WrappingInt8`: integer powers, gcd, lcm, and integer logarithms, wrapping on overflow.
given WrappingInt8: Integer {

    pow(self, exp: UInt): Self = pow_nonwrap(self, exp, 1);

    gcd(a: Self, b: Self): Self = {
        let x = if a < 0 then WrappingUInt8(0 - (a + 1)) + 1 else WrappingUInt8(a);
        let y = if b < 0 then WrappingUInt8(0 - (b + 1)) + 1 else WrappingUInt8(b);
        return WrappingInt8(gcd_nonneg(x, y, 0));
    };

    lcm(a: Self, b: Self): Self = {
        if a == 0 or b == 0 then {
            return 0;
        };
        let x = if a < 0 then WrappingUInt8(0 - (a + 1)) + 1 else WrappingUInt8(a);
        let y = if b < 0 then WrappingUInt8(0 - (b + 1)) + 1 else WrappingUInt8(b);
        let g = gcd_nonneg(x, y, 0);
        return WrappingInt8((x / g) * y);
    };

    ilog2(x: Self): UInt = {
        if x == 0 then panic("ilog2: argument is zero");
        let v = if x < 0 then WrappingUInt8(0 - (x + 1)) + 1 else WrappingUInt8(x);
        return ilog_nonneg(v, 0, 2, "ilog2: argument is zero");
    };

    ilog10(x: Self): UInt = {
        if x == 0 then panic("ilog10: argument is zero");
        let v = if x < 0 then WrappingUInt8(0 - (x + 1)) + 1 else WrappingUInt8(x);
        return ilog_nonneg(v, 0, 10, "ilog10: argument is zero");
    };
};

/// `BinaryInteger` for `WrappingInt8`: the same 8-bit toolbox as `Int8`.
given WrappingInt8: BinaryInteger {

    count_ones(self): UInt = Int8(self).count_ones();

    count_zeros(self): UInt = Int8(self).count_zeros();

    leading_zeros(self): UInt = Int8(self).leading_zeros();

    trailing_zeros(self): UInt = Int8(self).trailing_zeros();

    leading_ones(self): UInt = Int8(self).leading_ones();

    trailing_ones(self): UInt = Int8(self).trailing_ones();

    rotate_left(self, n: UInt): Self = WrappingInt8(Int8(self).rotate_left(n));

    rotate_right(self, n: UInt): Self = WrappingInt8(Int8(self).rotate_right(n));

    reverse_bits(self): Self = WrappingInt8(Int8(self).reverse_bits());

    swap_bytes(self): Self = WrappingInt8(Int8(self).swap_bytes());
};
