    wrapping_abs(self) Self = if self < 0 then self.wrapping_neg() else self;

    pow(self, exp UInt) Self = pow_nonwrap(self, exp, Int(1));

    wrapping_pow(self, exp UInt) Self = {
        let mutable result = 1;
        let mutable b = self;
        let mutable e = exp;
        while e > 0 then {
            if e % 2 == 1 then {
                result = result.wrapping_mul(b);
            };
            b = b.wrapping_mul(b);
            e = e / 2;
