given Int32: BinaryInteger {

    public count_ones(self): UInt = {
        let mutable n = self;
        let mutable count: UInt = 0;
        let mutable i: UInt = 0;
        while i < 32 then {
            count = count + UInt((n & 1));
            n = n >> 1;
            i = i + 1;
        };
        return count;
    };

    public count_zeros(self): UInt = 32 - self.count_ones();

    public leading_zeros(self): UInt = if self == 0 then 32
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        let mutable mask: Int32 = Int32((UInt32(1) << 31));
        while (n & mask) == 0 then {
            count = count + 1;
            mask = Int32((UInt32(mask) >> 1));
        };
        count
    };

    public trailing_zeros(self): UInt = if self == 0 then 32
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        while (n & 1) == 0 then {
            count = count + 1;
            n = n >> 1;
        };
        count
    };

    public leading_ones(self): UInt = (~self).leading_zeros();

    public trailing_ones(self): UInt = (~self).trailing_zeros();

    public rotate_left(self, n: UInt): Self = {
        let shift: UInt32 = UInt32((n % 32));
        let u = UInt32(self);
        return Int32(((u << shift) | (u >> (32 - shift))));
    };

    public rotate_right(self, n: UInt): Self = {
        let shift: UInt32 = UInt32((n % 32));
        let u = UInt32(self);
        return Int32(((u >> shift) | (u << (32 - shift))));
    };

    public reverse_bits(self): Self = {
        let mutable n = UInt32(self);
        let mutable result: UInt32 = 0;
        let mutable i: UInt = 0;
        while i < 32 then {
            result = (result << 1) | (n & 1);
            n = n >> 1;
            i = i + 1;
        };
        return Int32(result);
    };

    public swap_bytes(self): Self = {
        let u = UInt32(self);
        let b0 = (u & 255) << 24;
        let b1 = ((u >> 8) & 255) << 16;
        let b2 = ((u >> 16) & 255) << 8;
        let b3 = (u >> 24) & 255;
        let mutable result = b0 | b1;
        result = result | b2;
        result = result | b3;
        return Int32(result);
    };
};
