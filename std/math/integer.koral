    public rotate_left(self, n: UInt): Self = {
        let shift: UInt64 = UInt64((n % 64));
        let u = UInt64(self);
        return Int64(((u << shift) | (u >> (64 - shift))));
    };

    public rotate_right(self, n: UInt): Self = {
        let shift: UInt64 = UInt64((n % 64));
        let u = UInt64(self);
        return Int64(((u >> shift) | (u << (64 - shift))));
    };

    public reverse_bits(self): Self = {
        let mutable n = UInt64(self);
        let mutable result: UInt64 = 0;
        let mutable i: UInt = 0;
        while i < 64 then {
            result = (result << 1) | (n & 1);
            n = n >> 1;
            i = i + 1;
        };
        return Int64(result);
    };

    public swap_bytes(self): Self = {
        let u = UInt64(self);
        let b0 = (u & 255) << 56;
        let b1 = ((u >> 8) & 255) << 48;
        let b2 = ((u >> 16) & 255) << 40;
        let b3 = ((u >> 24) & 255) << 32;
        let b4 = ((u >> 32) & 255) << 24;
        let b5 = ((u >> 40) & 255) << 16;
        let b6 = ((u >> 48) & 255) << 8;
        let b7 = (u >> 56) & 255;
        let mutable result = b0 | b1;
        result = result | b2;
        result = result | b3;
        result = result | b4;
        result = result | b5;
        result = result | b6;
        result = result | b7;
        return Int64(result);
    };
};
