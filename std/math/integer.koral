using "std" { ... };
// ============================================================================
// std.math - Signed Integer Module
// ============================================================================
// Every method body below is written ONCE per width and pasted verbatim into
// the regular and `Wrapping` twins. The two families differ only in overflow
// policy, and the policy is not spelled here: it lives in `+ - * / %` and
// unary `-`, which are family-polymorphic. A regular `Int8.MIN.abs()` panics
// because negation overflows; a `WrappingInt8.MIN.abs()` wraps back to `MIN`
// because negation wraps. There is no second spelling of any method that
// carries the policy in its name.
// ============================================================================

// ============================================================================
// Shared Helpers
// ============================================================================

private let pow_nonwrap[T: Mul[T]](base: T, exp: UInt, one: T): T = {
    let mutable result = one;
    let mutable b = base;
    let mutable e = exp;
    while e > 0 then {
        if e % 2 == 1 then {
            result = result * b;
        };
        e = e / 2;
        if e > 0 then {
            b = b * b;
        };
    };
    return result;
};

private let gcd_nonneg[T: Rem[T] and Ord](a: T, b: T, zero: T): T = {
    let mutable x = a;
    let mutable y = b;
    while y != zero then {
        let t = y;
        y = x % y;
        x = t;
    };
    return x;
};

private let ilog_nonneg[T: Div[T] and Ord](x: T, zero: T, radix: T, name: String): UInt = {
    if x == zero then panic(name);
    let mutable result: UInt = 0;
    let mutable n = x;
    while n >= radix then {
        n = n / radix;
        result = result + 1;
    };
    return result;
};

private let lcm_nonneg[T: Div[T] and Mul[T] and Rem[T] and Ord](a: T, b: T, zero: T): T = if a == zero or b == zero then zero
else (a / gcd_nonneg(a, b, zero)) * b;

/// `Numeric` for `Int8`: absolute value, panicking at the minimum value.
given Int8: Numeric {

    abs(self): Self = if self < 0 then -self else self;
};

/// `Integer` for `Int8`: integer powers, gcd, lcm, and integer logarithms, panicking on overflow.
given Int8: Integer {

    pow(self, exp: UInt): Self = pow_nonwrap(self, exp, 1);

    gcd(a: Self, b: Self): Self = {
        let x = if a < 0 then UInt8(0 - (a + 1)) + 1 else UInt8(a);
        let y = if b < 0 then UInt8(0 - (b + 1)) + 1 else UInt8(b);
        let g = gcd_nonneg(x, y, 0);
        let r = Int8(g);
        if r < 0 then panic("gcd: result overflow");
        return r;
    };

    lcm(a: Self, b: Self): Self = {
        if a == 0 or b == 0 then {
            return 0;
        };
        let x = if a < 0 then UInt8(0 - (a + 1)) + 1 else UInt8(a);
        let y = if b < 0 then UInt8(0 - (b + 1)) + 1 else UInt8(b);
        let g = gcd_nonneg(x, y, 0);
        let r = Int8((x / g) * y);
        if r < 0 then panic("lcm: result overflow");
        return r;
    };

    ilog2(x: Self): UInt = {
        if x == 0 then panic("ilog2: argument is zero");
        let v = if x < 0 then UInt8(0 - (x + 1)) + 1 else UInt8(x);
        return ilog_nonneg(v, 0, 2, "ilog2: argument is zero");
    };

    ilog10(x: Self): UInt = {
        if x == 0 then panic("ilog10: argument is zero");
        let v = if x < 0 then UInt8(0 - (x + 1)) + 1 else UInt8(x);
        return ilog_nonneg(v, 0, 10, "ilog10: argument is zero");
    };
};

/// `BinaryInteger` for `Int8`: bit counting, rotation, and byte order over the 8-bit pattern.
given Int8: BinaryInteger {

    /// Return the number of one bits in the value.
    public count_ones(self): UInt = {
        let mutable n = self;
        let mutable count: UInt = 0;
        let mutable i: UInt = 0;
        while i < 8 then {
            count = count + UInt((n & 1));
            n = n >> 1;
            i = i + 1;
        };
        return count;
    };

    /// Return the number of zero bits in the value.
    public count_zeros(self): UInt = 8 - self.count_ones();

    /// Return the number of zero bits before the highest one bit, or 8 when the value is zero.
    public leading_zeros(self): UInt = if self == 0 then 8
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        let mutable mask: Int8 = Int8((UInt8(1) << 7));
        while (n & mask) == 0 then {
            count = count + 1;
            mask = Int8((UInt8(mask) >> 1));
        };
        count
    };

    /// Return the number of zero bits after the lowest one bit, or 8 when the value is zero.
    public trailing_zeros(self): UInt = if self == 0 then 8
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        while (n & 1) == 0 then {
            count = count + 1;
            n = n >> 1;
        };
        count
    };

    /// Return the number of one bits before the highest zero bit, or 8 when every bit is one.
    public leading_ones(self): UInt = (~self).leading_zeros();

    /// Return the number of one bits after the lowest zero bit, or 8 when every bit is one.
    public trailing_ones(self): UInt = (~self).trailing_zeros();

    /// Rotate the pattern left by n modulo 8, with bits shifted off the top re-entering at the bottom.
    public rotate_left(self, n: UInt): Self = {
        let shift: UInt8 = UInt8((n % 8));
        let u = UInt8(self);
        return Int8(((u << shift) | (u >> ((8 - shift) % 8))));
    };

    /// Rotate the pattern right by n modulo 8, with bits shifted off the bottom re-entering at the top.
    public rotate_right(self, n: UInt): Self = {
        let shift: UInt8 = UInt8((n % 8));
        let u = UInt8(self);
        return Int8(((u >> shift) | (u << ((8 - shift) % 8))));
    };

    /// Return the value with its bits in reverse order.
    public reverse_bits(self): Self = {
        let mutable n = UInt8(self);
        let mutable result: UInt8 = 0;
        let mutable i: UInt = 0;
        while i < 8 then {
            result = (result << 1) | (n & 1);
            n = n >> 1;
            i = i + 1;
        };
        return Int8(result);
    };

    /// Return the value unchanged, since a single byte has no byte order to swap.
    public swap_bytes(self): Self = self;
};
/// `Numeric` for `Int16`: absolute value, panicking at the minimum value.
given Int16: Numeric {

    abs(self): Self = if self < 0 then -self else self;
};

/// `Integer` for `Int16`: integer powers, gcd, lcm, and integer logarithms, panicking on overflow.
given Int16: Integer {

    pow(self, exp: UInt): Self = pow_nonwrap(self, exp, 1);

    gcd(a: Self, b: Self): Self = {
        let x = if a < 0 then UInt16(0 - (a + 1)) + 1 else UInt16(a);
        let y = if b < 0 then UInt16(0 - (b + 1)) + 1 else UInt16(b);
        let g = gcd_nonneg(x, y, 0);
        let r = Int16(g);
        if r < 0 then panic("gcd: result overflow");
        return r;
    };

    lcm(a: Self, b: Self): Self = {
        if a == 0 or b == 0 then {
            return 0;
        };
        let x = if a < 0 then UInt16(0 - (a + 1)) + 1 else UInt16(a);
        let y = if b < 0 then UInt16(0 - (b + 1)) + 1 else UInt16(b);
        let g = gcd_nonneg(x, y, 0);
        let r = Int16((x / g) * y);
        if r < 0 then panic("lcm: result overflow");
        return r;
    };

    ilog2(x: Self): UInt = {
        if x == 0 then panic("ilog2: argument is zero");
        let v = if x < 0 then UInt16(0 - (x + 1)) + 1 else UInt16(x);
        return ilog_nonneg(v, 0, 2, "ilog2: argument is zero");
    };

    ilog10(x: Self): UInt = {
        if x == 0 then panic("ilog10: argument is zero");
        let v = if x < 0 then UInt16(0 - (x + 1)) + 1 else UInt16(x);
        return ilog_nonneg(v, 0, 10, "ilog10: argument is zero");
    };
};

/// `BinaryInteger` for `Int16`: bit counting, rotation, and byte order over the 16-bit pattern.
given Int16: BinaryInteger {

    /// Return the number of one bits in the value.
    public count_ones(self): UInt = {
        let mutable n = self;
        let mutable count: UInt = 0;
        let mutable i: UInt = 0;
        while i < 16 then {
            count = count + UInt((n & 1));
            n = n >> 1;
            i = i + 1;
        };
        return count;
    };

    /// Return the number of zero bits in the value.
    public count_zeros(self): UInt = 16 - self.count_ones();

    /// Return the number of zero bits before the highest one bit, or 16 when the value is zero.
    public leading_zeros(self): UInt = if self == 0 then 16
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        let mutable mask: Int16 = Int16((UInt16(1) << 15));
        while (n & mask) == 0 then {
            count = count + 1;
            mask = Int16((UInt16(mask) >> 1));
        };
        count
    };

    /// Return the number of zero bits after the lowest one bit, or 16 when the value is zero.
    public trailing_zeros(self): UInt = if self == 0 then 16
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        while (n & 1) == 0 then {
            count = count + 1;
            n = n >> 1;
        };
        count
    };

    /// Return the number of one bits before the highest zero bit, or 16 when every bit is one.
    public leading_ones(self): UInt = (~self).leading_zeros();

    /// Return the number of one bits after the lowest zero bit, or 16 when every bit is one.
    public trailing_ones(self): UInt = (~self).trailing_zeros();

    /// Rotate the pattern left by n modulo 16, with bits shifted off the top re-entering at the bottom.
    public rotate_left(self, n: UInt): Self = {
        let shift: UInt16 = UInt16((n % 16));
        let u = UInt16(self);
        return Int16(((u << shift) | (u >> ((16 - shift) % 16))));
    };

    /// Rotate the pattern right by n modulo 16, with bits shifted off the bottom re-entering at the top.
    public rotate_right(self, n: UInt): Self = {
        let shift: UInt16 = UInt16((n % 16));
        let u = UInt16(self);
        return Int16(((u >> shift) | (u << ((16 - shift) % 16))));
    };

    /// Return the value with its bits in reverse order.
    public reverse_bits(self): Self = {
        let mutable n = UInt16(self);
        let mutable result: UInt16 = 0;
        let mutable i: UInt = 0;
        while i < 16 then {
            result = (result << 1) | (n & 1);
            n = n >> 1;
            i = i + 1;
        };
        return Int16(result);
    };

    /// Return the value with its two bytes swapped.
    public swap_bytes(self): Self = {
        let u = UInt16(self);
        let b0 = (u & 255) << 8;
        let b1 = (u >> 8) & 255;
        return Int16((b0 | b1));
    };
};
/// `Numeric` for `Int32`: absolute value, panicking at the minimum value.
given Int32: Numeric {

    abs(self): Self = if self < 0 then -self else self;
};

/// `Integer` for `Int32`: integer powers, gcd, lcm, and integer logarithms, panicking on overflow.
given Int32: Integer {

    pow(self, exp: UInt): Self = pow_nonwrap(self, exp, 1);

    gcd(a: Self, b: Self): Self = {
        let x = if a < 0 then UInt32(0 - (a + 1)) + 1 else UInt32(a);
        let y = if b < 0 then UInt32(0 - (b + 1)) + 1 else UInt32(b);
        let g = gcd_nonneg(x, y, 0);
        let r = Int32(g);
        if r < 0 then panic("gcd: result overflow");
        return r;
    };

    lcm(a: Self, b: Self): Self = {
        if a == 0 or b == 0 then {
            return 0;
        };
        let x = if a < 0 then UInt32(0 - (a + 1)) + 1 else UInt32(a);
        let y = if b < 0 then UInt32(0 - (b + 1)) + 1 else UInt32(b);
        let g = gcd_nonneg(x, y, 0);
        let r = Int32((x / g) * y);
        if r < 0 then panic("lcm: result overflow");
        return r;
    };

    ilog2(x: Self): UInt = {
        if x == 0 then panic("ilog2: argument is zero");
        let v = if x < 0 then UInt32(0 - (x + 1)) + 1 else UInt32(x);
        return ilog_nonneg(v, 0, 2, "ilog2: argument is zero");
    };

    ilog10(x: Self): UInt = {
        if x == 0 then panic("ilog10: argument is zero");
        let v = if x < 0 then UInt32(0 - (x + 1)) + 1 else UInt32(x);
        return ilog_nonneg(v, 0, 10, "ilog10: argument is zero");
    };
};

/// `BinaryInteger` for `Int32`: bit counting, rotation, and byte order over the 32-bit pattern.
given Int32: BinaryInteger {

    /// Return the number of one bits in the value.
    public count_ones(self): UInt = {
        let mutable n = self;
        let mutable count: UInt = 0;
        let mutable i: UInt = 0;
        while i < 32 then {
            count = count + UInt((n & 1));
            n = n >> 1;
            i = i + 1;
        };
        return count;
    };

    /// Return the number of zero bits in the value.
    public count_zeros(self): UInt = 32 - self.count_ones();

    /// Return the number of zero bits before the highest one bit, or 32 when the value is zero.
    public leading_zeros(self): UInt = if self == 0 then 32
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        let mutable mask: Int32 = Int32((UInt32(1) << 31));
        while (n & mask) == 0 then {
            count = count + 1;
            mask = Int32((UInt32(mask) >> 1));
        };
        count
    };

    /// Return the number of zero bits after the lowest one bit, or 32 when the value is zero.
    public trailing_zeros(self): UInt = if self == 0 then 32
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        while (n & 1) == 0 then {
            count = count + 1;
            n = n >> 1;
        };
        count
    };

    /// Return the number of one bits before the highest zero bit, or 32 when every bit is one.
    public leading_ones(self): UInt = (~self).leading_zeros();

    /// Return the number of one bits after the lowest zero bit, or 32 when every bit is one.
    public trailing_ones(self): UInt = (~self).trailing_zeros();

    /// Rotate the pattern left by n modulo 32, with bits shifted off the top re-entering at the bottom.
    public rotate_left(self, n: UInt): Self = {
        let shift: UInt32 = UInt32((n % 32));
        let u = UInt32(self);
        return Int32(((u << shift) | (u >> ((32 - shift) % 32))));
    };

    /// Rotate the pattern right by n modulo 32, with bits shifted off the bottom re-entering at the top.
    public rotate_right(self, n: UInt): Self = {
        let shift: UInt32 = UInt32((n % 32));
        let u = UInt32(self);
        return Int32(((u >> shift) | (u << ((32 - shift) % 32))));
    };

    /// Return the value with its bits in reverse order.
    public reverse_bits(self): Self = {
        let mutable n = UInt32(self);
        let mutable result: UInt32 = 0;
        let mutable i: UInt = 0;
        while i < 32 then {
            result = (result << 1) | (n & 1);
            n = n >> 1;
            i = i + 1;
        };
        return Int32(result);
    };

    /// Return the value with its four bytes in reverse order.
    public swap_bytes(self): Self = {
        let u = UInt32(self);
        let b0 = (u & 255) << 24;
        let b1 = ((u >> 8) & 255) << 16;
        let b2 = ((u >> 16) & 255) << 8;
        let b3 = (u >> 24) & 255;
        let mutable result = b0 | b1;
        result = result | b2;
        result = result | b3;
        return Int32(result);
    };
};
/// `Numeric` for `Int64`: absolute value, panicking at the minimum value.
given Int64: Numeric {

    abs(self): Self = if self < 0 then -self else self;
};

/// `Integer` for `Int64`: integer powers, gcd, lcm, and integer logarithms, panicking on overflow.
given Int64: Integer {

    pow(self, exp: UInt): Self = pow_nonwrap(self, exp, 1);

    gcd(a: Self, b: Self): Self = {
        let x = if a < 0 then UInt64(0 - (a + 1)) + 1 else UInt64(a);
        let y = if b < 0 then UInt64(0 - (b + 1)) + 1 else UInt64(b);
        let g = gcd_nonneg(x, y, 0);
        let r = Int64(g);
        if r < 0 then panic("gcd: result overflow");
        return r;
    };

    lcm(a: Self, b: Self): Self = {
        if a == 0 or b == 0 then {
            return 0;
        };
        let x = if a < 0 then UInt64(0 - (a + 1)) + 1 else UInt64(a);
        let y = if b < 0 then UInt64(0 - (b + 1)) + 1 else UInt64(b);
        let g = gcd_nonneg(x, y, 0);
        let r = Int64((x / g) * y);
        if r < 0 then panic("lcm: result overflow");
        return r;
    };

    ilog2(x: Self): UInt = {
        if x == 0 then panic("ilog2: argument is zero");
        let v = if x < 0 then UInt64(0 - (x + 1)) + 1 else UInt64(x);
        return ilog_nonneg(v, 0, 2, "ilog2: argument is zero");
    };

    ilog10(x: Self): UInt = {
        if x == 0 then panic("ilog10: argument is zero");
        let v = if x < 0 then UInt64(0 - (x + 1)) + 1 else UInt64(x);
        return ilog_nonneg(v, 0, 10, "ilog10: argument is zero");
    };
};

/// `BinaryInteger` for `Int64`: bit counting, rotation, and byte order over the 64-bit pattern.
given Int64: BinaryInteger {

    /// Return the number of one bits in the value.
    public count_ones(self): UInt = {
        let mutable n = self;
        let mutable count: UInt = 0;
        let mutable i: UInt = 0;
        while i < 64 then {
            count = count + UInt((n & 1));
            n = n >> 1;
            i = i + 1;
        };
        return count;
    };

    /// Return the number of zero bits in the value.
    public count_zeros(self): UInt = 64 - self.count_ones();

    /// Return the number of zero bits before the highest one bit, or 64 when the value is zero.
    public leading_zeros(self): UInt = if self == 0 then 64
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        let mutable mask: Int64 = Int64((UInt64(1) << 63));
        while (n & mask) == 0 then {
            count = count + 1;
            mask = Int64((UInt64(mask) >> 1));
        };
        count
    };

    /// Return the number of zero bits after the lowest one bit, or 64 when the value is zero.
    public trailing_zeros(self): UInt = if self == 0 then 64
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        while (n & 1) == 0 then {
            count = count + 1;
            n = n >> 1;
        };
        count
    };

    /// Return the number of one bits before the highest zero bit, or 64 when every bit is one.
    public leading_ones(self): UInt = (~self).leading_zeros();

    /// Return the number of one bits after the lowest zero bit, or 64 when every bit is one.
    public trailing_ones(self): UInt = (~self).trailing_zeros();

    /// Rotate the pattern left by n modulo 64, with bits shifted off the top re-entering at the bottom.
    public rotate_left(self, n: UInt): Self = {
        let shift: UInt64 = UInt64((n % 64));
        let u = UInt64(self);
        return Int64(((u << shift) | (u >> ((64 - shift) % 64))));
    };

    /// Rotate the pattern right by n modulo 64, with bits shifted off the bottom re-entering at the top.
    public rotate_right(self, n: UInt): Self = {
        let shift: UInt64 = UInt64((n % 64));
        let u = UInt64(self);
        return Int64(((u >> shift) | (u << ((64 - shift) % 64))));
    };

    /// Return the value with its bits in reverse order.
    public reverse_bits(self): Self = {
        let mutable n = UInt64(self);
        let mutable result: UInt64 = 0;
        let mutable i: UInt = 0;
        while i < 64 then {
            result = (result << 1) | (n & 1);
            n = n >> 1;
            i = i + 1;
        };
        return Int64(result);
    };

    /// Return the value with its eight bytes in reverse order.
    public swap_bytes(self): Self = {
        let u = UInt64(self);
        let b0 = (u & 255) << 56;
        let b1 = ((u >> 8) & 255) << 48;
        let b2 = ((u >> 16) & 255) << 40;
        let b3 = ((u >> 24) & 255) << 32;
        let b4 = ((u >> 32) & 255) << 24;
        let b5 = ((u >> 40) & 255) << 16;
        let b6 = ((u >> 48) & 255) << 8;
        let b7 = (u >> 56) & 255;
        let mutable result = b0 | b1;
        result = result | b2;
        result = result | b3;
        result = result | b4;
        result = result | b5;
        result = result | b6;
        result = result | b7;
        return Int64(result);
    };
};
/// `Numeric` for `UInt8`: absolute value, which is the value itself.
given UInt8: Numeric {

    abs(self): Self = self;
};

/// `Integer` for `UInt8`: integer powers, gcd, lcm, and integer logarithms, panicking on overflow.
given UInt8: Integer {

    pow(self, exp: UInt): Self = pow_nonwrap(self, exp, 1);

    gcd(a: Self, b: Self): Self = gcd_nonneg(a, b, 0);
    lcm(a: Self, b: Self): Self = lcm_nonneg(a, b, 0);

    ilog2(x: Self): UInt = ilog_nonneg(x, 0, 2, "ilog2: argument is zero");

    ilog10(x: Self): UInt = ilog_nonneg(x, 0, 10, "ilog10: argument is zero");
};

/// `BinaryInteger` for `UInt8`: bit counting, rotation, and byte order over the 8-bit pattern.
given UInt8: BinaryInteger {

    /// Return the number of one bits in the value.
    public count_ones(self): UInt = {
        let mutable n = self;
        let mutable count: UInt = 0;
        while n != 0 then {
            count = count + UInt((n & 1));
            n = n >> 1;
        };
        return count;
    };

    /// Return the number of zero bits in the value.
    public count_zeros(self): UInt = 8 - self.count_ones();

    /// Return the number of zero bits before the highest one bit, or 8 when the value is zero.
    public leading_zeros(self): UInt = if self == 0 then 8
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        let mutable mask: UInt8 = UInt8(1) << 7;
        while (n & mask) == 0 then {
            count = count + 1;
            mask = mask >> 1;
        };
        count
    };

    /// Return the number of zero bits after the lowest one bit, or 8 when the value is zero.
    public trailing_zeros(self): UInt = if self == 0 then 8
    else {
        let mutable n = self;
        let mutable count: UInt = 0;
        while (n & 1) == 0 then {
            count = count + 1;
            n = n >> 1;
        };
        count
    };

    /// Return the number of one bits before the highest zero bit, or 8 when every bit is one.
    public leading_ones(self): UInt = (~self).leading_zeros();

    /// Return the number of one bits after the lowest zero bit, or 8 when every bit is one.
    public trailing_ones(self): UInt = (~self).trailing_zeros();

    /// Rotate the pattern left by n modulo 8, with bits shifted off the top re-entering at the bottom.
    public rotate_left(self, n: UInt): Self = {
        let shift: UInt8 = UInt8((n % 8));
        return (self << shift) | (self >> ((8 - shift) % 8));
    };

    /// Rotate the pattern right by n modulo 8, with bits shifted off the bottom re-entering at the top.
    public rotate_right(self, n: UInt): Self = {
        let shift: UInt8 = UInt8((n % 8));
        return (self >> shift) | (self << ((8 - shift) % 8));
    };

    /// Return the value with its bits in reverse order.
    public reverse_bits(self): Self = {
        let mutable n = self;
        let mutable result: UInt8 = 0;
        let mutable i: UInt = 0;
        while i < 8 then {
            result = (result << 1) | (n & 1);
            n = n >> 1;
            i = i + 1;
        };
        return result;
    };

    /// Return the value unchanged, since a single byte has no byte order to swap.
    public swap_bytes(self): Self = self;
};
