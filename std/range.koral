    ) else Option[Self].Some(self + 1);

    /// Return `self - 1`, or `None` at `Int32.min_value()`.
    public pred(self): Option[Self] = if self == Int32.min_value() then Option[Self].None(
    ) else Option[Self].Some(self - 1);
};

/// `Step` for `Int64`: steps by one, yielding `None` at the type's bounds.
given Int64: Step {

    /// Return `self + 1`, or `None` at `Int64.max_value()`.
    public succ(self): Option[Self] = if self == Int64.max_value() then Option[Self].None(
    ) else Option[Self].Some(self + 1);

    /// Return `self - 1`, or `None` at `Int64.min_value()`.
    public pred(self): Option[Self] = if self == Int64.min_value() then Option[Self].None(
