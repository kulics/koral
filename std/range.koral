// ============================================================================
// Koral Standard Library - Range Type
// ============================================================================
// NOTE: This file is merged into core.koral, so all previous types are already available.
// ============================================================================

// ============================================================================
// Range Type Definition
// ============================================================================

/// An interval over an `Ord` type: bounded on both sides (`a..b`, `a..<b`,
/// `a<..b`, `a<..<b`), open-ended (`a...`, `a<...`, `...b`, `...<b`), or full (`...`).
public type Range[T: Ord] {
    // Bound ranges (4 kinds)
    Closed(start: T, end: T), // a..b   : start <= x <= end
    ClosedOpen(start: T, end: T), // a..<b  : start <= x < end
    OpenClosed(start: T, end: T), // a<..b  : start < x <= end
    Open(start: T, end: T), // a<..<b : start < x < end

    // From ranges (2 kinds)
    From(start: T), // a...   : start <= x <= max
    After(start: T), // a<...  : start < x <= max

    // To ranges (2 kinds)
    To(end: T), // ...b   : min <= x <= end
    Until(end: T), // ...<b  : min <= x < end

    // Full range (1 kind)
    Full(), // ...    : min <= x <= max
};

/// A slice descriptor: where a slice starts and how many elements it covers.
public type SliceSpec(private slice_offset: UInt, private slice_len: UInt);

/// Construction and accessors for `SliceSpec`.
given SliceSpec {

    /// Create a spec for the `len` elements starting at `offset`.
    public new(offset: UInt =, len: UInt =): SliceSpec = SliceSpec(offset, len);

    /// Return the slice's start offset.
    public start(self): UInt = self.slice_offset;

    /// Return the offset just past the slice's last element.
    public end(self): UInt = self.slice_offset + self.slice_len;

    /// Return the number of elements the slice covers.
    public len(self): UInt = self.slice_len;
};

/// Containment and emptiness checks for `Range` intervals.
given[T: Ord] Range[T] {

    /// Return whether `value` lies within the range, honoring each variant's
    /// bound style.
    public contains(self, value: T): Bool = when self in {
        .Closed(start, end) then start <= value and value <= end,
        .ClosedOpen(start, end) then start <= value and value < end,
        .OpenClosed(start, end) then start < value and value <= end,
        .Open(start, end) then start < value and value < end,
        .From(start) then start <= value,
        .After(start) then start < value,
        .To(end) then value <= end,
        .Until(end) then value < end,
        .Full() then true,
    };

    /// Return whether the range contains no values; the open-ended and full
    /// forms never do, while a bounded form is empty once its bounds cross.
    public is_empty(self): Bool = when self in {
        .Closed(start, end) then start > end,
        .ClosedOpen(start, end) then start >= end,
        .OpenClosed(start, end) then start >= end,
        .Open(start, end) then start >= end,
        .From(_) then false,
        .After(_) then false,
        .To(_) then false,
        .Until(_) then false,
        .Full() then false,
    };
};

// ============================================================================
// Step Trait
// ============================================================================

/// Types whose values step one at a time, enabling range iteration.
public trait Step: Bounded {
    /// Return the next value after `self`, or `None` at the type's maximum.
    succ(self): Option[Self];
    /// Return the value before `self`, or `None` at the type's minimum.
    pred(self): Option[Self];
};

/// `Step` for `Int`: steps by one, yielding `None` at the type's bounds.
given Int: Step {

    /// Return `self + 1`, or `None` at `Int.max_value()`.
    public succ(self): Option[Self] = if self == Int.max_value() then Option[Self].None()
    else Option[Self].Some(self + 1);

    /// Return `self - 1`, or `None` at `Int.min_value()`.
    public pred(self): Option[Self] = if self == Int.min_value() then Option[Self].None()
    else Option[Self].Some(self - 1);
};

/// `Step` for `Int8`: steps by one, yielding `None` at the type's bounds.
given Int8: Step {

    /// Return `self + 1`, or `None` at `Int8.max_value()`.
    public succ(self): Option[Self] = if self == Int8.max_value() then Option[Self].None(
    ) else Option[Self].Some(self + 1);

    /// Return `self - 1`, or `None` at `Int8.min_value()`.
    public pred(self): Option[Self] = if self == Int8.min_value() then Option[Self].None(
    ) else Option[Self].Some(self - 1);
};

/// `Step` for `Int16`: steps by one, yielding `None` at the type's bounds.
given Int16: Step {

    /// Return `self + 1`, or `None` at `Int16.max_value()`.
    public succ(self): Option[Self] = if self == Int16.max_value() then Option[Self].None(
    ) else Option[Self].Some(self + 1);

    /// Return `self - 1`, or `None` at `Int16.min_value()`.
    public pred(self): Option[Self] = if self == Int16.min_value() then Option[Self].None(
    ) else Option[Self].Some(self - 1);
};

