// ============================================================================
// Koral Standard Library - Rune Type
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives, traits, and option are already available.
// ============================================================================

// ============================================================================
// Rune Type - Unicode Code Point
// ============================================================================

/// A Unicode code point from U+0000 to U+10FFFF, possibly invalid when built
/// with `from_uint32_unchecked`.
public type Rune(value: UInt32);

/// Constructors and character classification for runes.
given Rune {

    /// Return the Unicode replacement character U+FFFD.
    public replacement_char(): Rune = Rune(65533);

    /// Create a rune from a code point; `Error` for a surrogate (U+D800..U+DFFF)
    /// or a value above U+10FFFF.
    public from_uint32(value: UInt32): Result[Rune] = {
        if value > 1114111 or (value >= 55296 and value <= 57343) then {
            return Result[Rune].Error("Rune.from_uint32: invalid Unicode scalar value");
        };
        return Result[Rune].Ok(Rune(value));
    };

    /// Create a rune from a code point with no validity check.
    public from_uint32_unchecked(value: UInt32): Rune = Rune(value);

    /// Return the code point as a `UInt32`.
    public to_uint32(self): UInt32 = self.value;

    /// Return whether the rune is ASCII (U+0000..U+007F).
    public is_ascii(self): Bool = self.value < 128;

    /// Return whether the rune is an ASCII digit (0-9).
    public is_ascii_digit(self): Bool = {
        let cp = self.value;
        return cp >= 48 and cp <= 57; // '0' to '9'
    };

    /// Return whether the rune is an ASCII hexadecimal digit (0-9, A-F, a-f).
    public is_ascii_hexdigit(self): Bool = {
        let cp = self.value;
        return self.is_ascii_digit() or (cp >= 65 and cp <= 70) or (cp >= 97 and cp <= 102); // 0-9, A-F, a-f
    };

    /// Return whether the rune is ASCII whitespace: space, tab, LF, CR, form
    /// feed, or vertical tab.
    public is_ascii_whitespace(self): Bool = {
        let cp = self.value;
        return cp == 32 or cp == 9 or cp == 10 or cp == 13 or cp == 12 or cp == 11; // Space, Tab, LF, CR, Form feed, Vertical tab
    };

    /// Return whether the rune is an ASCII letter (A-Z, a-z).
    public is_ascii_alphabetic(self): Bool = {
        let cp = self.value;
        return (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122); // A-Z, a-z
    };

    /// Return whether the rune is an ASCII letter or digit.
    public is_ascii_alphanumeric(self): Bool =
        self.is_ascii_alphabetic() or self.is_ascii_digit();

    /// Return whether the rune is an ASCII uppercase letter (A-Z).
    public is_ascii_uppercase(self): Bool = {
        let cp = self.value;
        return cp >= 65 and cp <= 90;
    };

    /// Return whether the rune is an ASCII lowercase letter (a-z).
    public is_ascii_lowercase(self): Bool = {
        let cp = self.value;
        return cp >= 97 and cp <= 122;
    };

    /// Convert an ASCII uppercase letter to lowercase; any other rune is
    /// returned unchanged.
    public to_ascii_lowercase(self): Rune = {
        let cp = self.value;
        if cp >= 65 and cp <= 90 then {
            return Rune(cp + 32);
        };
        return self;
    };

    /// Convert an ASCII lowercase letter to uppercase; any other rune is
    /// returned unchanged.
    public to_ascii_uppercase(self): Rune = {
        let cp = self.value;
        if cp >= 97 and cp <= 122 then {
            return Rune(cp - 32);
        };
        return self;
    };

    /// Return whether the code point is a valid Unicode scalar value: at most
    /// U+10FFFF and not a surrogate.
    public is_valid(self): Bool = {
        let cp = self.value;
        // Valid range: 0x0000-0x10FFFF, excluding surrogates 0xD800-0xDFFF
        return cp <= 1114111 and (cp < 55296 or cp > 57343);
    };

    /// Return the number of UTF-8 bytes this rune encodes to; an invalid rune
    /// reports 3, the length of its replacement encoding.
    public byte_count(self): UInt = {
        let cp = self.value;
        if not self.is_valid() then {
            return 3;
        }; // Replacement char length
        return if cp < 128 then UInt(1)
        else if cp < 2048 then UInt(2) else if cp < 65536 then UInt(3) else UInt(4);
    };

    // Lightweight subset used internally for identifier classification.
    // This is intentionally not a full Unicode-letter implementation and is not part of the public API.
    private is_identifier_letter_subset(self): Bool = {
        let cp = self.value;
        // ASCII letters
        if (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122) then {
            return true;
        };
        // Latin Extended-A, Extended-B, and more (0x00C0-0x024F)
        if cp >= 192 and cp <= 591 then {
            return true;
        };
        // CJK Unified Ideographs (0x4E00-0x9FFF)
        if cp >= 19968 and cp <= 40959 then {
            return true;
        };
        // CJK Extension A (0x3400-0x4DBF)
        if cp >= 13312 and cp <= 19903 then {
            return true;
        };
        // Hiragana (0x3040-0x309F)
        if cp >= 12352 and cp <= 12447 then {
            return true;
        };
        // Katakana (0x30A0-0x30FF)
        if cp >= 12448 and cp <= 12543 then {
            return true;
        };
        // Hangul Syllables (0xAC00-0xD7AF)
        if cp >= 44032 and cp <= 55215 then {
            return true;
        };
        // Greek (0x0370-0x03FF)
        if cp >= 880 and cp <= 1023 then {
            return true;
        };
        // Cyrillic (0x0400-0x04FF)
        if cp >= 1024 and cp <= 1279 then {
            return true;
        };
        return false;
    };

    /// Return whether the rune is a line break: LF, CR, NEL, line separator,
    /// or paragraph separator.
    public is_newline(self): Bool = {
        let cp = self.value;
        return cp == 10 or cp == 13 or cp == 133 or cp == 8232 or cp == 8233; // LF, CR, NEL, Line Separator, Paragraph Separator
    };

    /// Return whether the runes are equal after folding ASCII case.
    public equals_ascii_ignore_case(self, other: Rune): Bool =
        self.to_ascii_lowercase().value == other.to_ascii_lowercase().value;

    /// Return whether the rune may begin an identifier under Koral's current
    /// lightweight identifier rules.
    public is_identifier_start(self): Bool = {
        let cp = self.value;
        // Underscore
        if cp == 95 then {
            return true;
        };
        // Lightweight identifier letter subset
        return self.is_identifier_letter_subset();
    };

    /// Return whether the rune may continue an identifier under Koral's current
    /// lightweight identifier rules.
    public is_identifier_continue(self): Bool = {
        let cp = self.value;
        // Underscore
        if cp == 95 then {
            return true;
        };
        // Lightweight identifier letter subset or ASCII digit
        return self.is_identifier_letter_subset() or self.is_ascii_digit();
    };
};

/// `Eq` for `Rune`: compares code points.
given Rune: Eq {

    /// Return whether `self` and `other` have the same code point.
    public equals(self, other: Rune): Bool = self.value == other.value;
};

/// `Ord` for `Rune`: orders runes by code point.
given Rune: Ord {

    /// Compare code points, returning -1, 0, or 1 for less, equal, or greater.
    public compare(self, other: Rune): Int = if self.value < other.value then 0 - 1
    else if self.value > other.value then 1 else 0;
};

/// `ToString` for `Rune`: encodes the code point as UTF-8 text.
given Rune: ToString {

    /// Encode the rune as a UTF-8 string; an invalid rune encodes as the
    /// replacement character.
    public to_string(self): String = {
        let cp = self.value;

        if not self.is_valid() then {
            let s = alloc_string(3);
            init_memory(s.data + 0, 239);
            init_memory(s.data + 1, 191);
            init_memory(s.data + 2, 189);
            return s;
        };

        if cp < 128 then {
            let s = alloc_string(1);
            init_memory(s.data + 0, UInt8(cp));
            return s;
        };

        if cp < 2048 then {
            let s = alloc_string(2);
            init_memory(s.data + 0, UInt8((cp >> 6)) | 192);
            init_memory(s.data + 1, UInt8((cp & 63)) | 128);
            return s;
        };

        if cp < 65536 then {
            let s = alloc_string(3);
            init_memory(s.data + 0, UInt8((cp >> 12)) | 224);
            init_memory(s.data + 1, UInt8(((cp >> 6) & 63)) | 128);
            init_memory(s.data + 2, UInt8((cp & 63)) | 128);
            return s;
        };

        let s = alloc_string(4);
        init_memory(s.data + 0, UInt8((cp >> 18)) | 240);
        init_memory(s.data + 1, UInt8(((cp >> 12) & 63)) | 128);
        init_memory(s.data + 2, UInt8(((cp >> 6) & 63)) | 128);
        init_memory(s.data + 3, UInt8((cp & 63)) | 128);
        return s;
    };
};
