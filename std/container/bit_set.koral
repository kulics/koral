using "std" { ... };
// ============================================================================
// std.container.BitSet
// ============================================================================

/// A set of non-negative integers below a fixed universe `size`, stored one
/// bit per member: two orders of magnitude denser than a `Set[UInt]`. The
/// universe is fixed at construction, which keeps `complement` well defined
/// (the flip lives inside `[0, size)`). Reads outside the universe answer
/// `false`; writes outside it are bounds errors, like indexing.
///
/// `type mutable` working state: thread-local, like every mutable container.
public type mutable BitSet(
    mutable words: List[UInt64],
    mutable size: UInt,
    mutable live: UInt,
);

/// A one-shot cursor that walks a `BitSet`'s members in ascending order.
public type mutable BitSetIterator(source: BitSet, mutable next_bit: UInt);

/// Constructors and core operations for `BitSet`.
given BitSet {

    /// Create an empty bit set over the universe `[0, size)`.
    public new(size: UInt): BitSet = {
        let mutable words = List[UInt64].new();
        let word_count = (size + UInt(63)) / UInt(64);
        let mutable w = UInt(0);
        while w < word_count then {
            words.push(UInt64(0));
            w = w + UInt(1);
        };
        return BitSet(words, size, UInt(0));
    };

    /// The number of members in the set.
    public count(self): UInt = self.live;

    /// Whether the set has no members.
    public is_empty(self): Bool = self.live == UInt(0);

    /// Whether `value` is a member; values outside the universe answer `false`.
    public contains(self, value: UInt): Bool = {
        if value >= self.size then {
            return false;
        };
        let word = self.words.get(value / UInt(64)) or else UInt64(0);
        return (word & BitSet.bit_mask(value)) != UInt64(0);
    };

    /// Add `value` to the set. Panics when `value` is outside the universe.
    public insert(self, value: UInt): Void = {
        if value >= self.size then {
            panic("BitSet insert index out of bounds");
        };
        let index = value / UInt(64);
        let mask = BitSet.bit_mask(value);
        let word = self.words.get(index) or else UInt64(0);
        if (word & mask) == UInt64(0) then {
            self.words[index] = word | mask;
            self.live = self.live + UInt(1);
        };
    };

    /// Add `value` to the set and report whether it was newly added. Panics
    /// when `value` is outside the universe.
    public try_insert(self, value: UInt): Bool = {
        if value >= self.size then {
            panic("BitSet try_insert index out of bounds");
        };
        let index = value / UInt(64);
        let mask = BitSet.bit_mask(value);
        let word = self.words.get(index) or else UInt64(0);
        if (word & mask) == UInt64(0) then {
            self.words[index] = word | mask;
            self.live = self.live + UInt(1);
            return true;
        };
        return false;
    };

    /// Remove `value` from the set. Panics when `value` is outside the
    /// universe; removing a non-member is a no-op.
    public remove(self, value: UInt): Void = {
        if value >= self.size then {
            panic("BitSet remove index out of bounds");
        };
        let index = value / UInt(64);
        let mask = BitSet.bit_mask(value);
        let word = self.words.get(index) or else UInt64(0);
        if (word & mask) != UInt64(0) then {
            self.words[index] = word & (BitSet.bit_not(mask));
            self.live = self.live - UInt(1);
        };
    };

    /// Remove `value` from the set and report whether it was a member. Panics
    /// when `value` is outside the universe.
    public try_remove(self, value: UInt): Bool = {
        if value >= self.size then {
            panic("BitSet try_remove index out of bounds");
        };
        let index = value / UInt(64);
        let mask = BitSet.bit_mask(value);
        let word = self.words.get(index) or else UInt64(0);
        if (word & mask) != UInt64(0) then {
            self.words[index] = word & (BitSet.bit_not(mask));
            self.live = self.live - UInt(1);
            return true;
        };
        return false;
    };

    /// Remove every member, keeping the universe.
    public clear(self): Void = {
        let mutable i = UInt(0);
        while i < self.words.count() then {
            self.words[i] = UInt64(0);
            i = i + UInt(1);
        };
        self.live = UInt(0);
    };


    /// The members of both sets. Both sets must share the universe size.
    public union(self, other: BitSet): BitSet = {
        BitSet.check_same_size(self, other);
        let mutable out = BitSet.new(self.size);
        let mutable i = UInt(0);
        while i < self.words.count() then {
            let merged = (self.words.get(i) or else UInt64(0))
                | (other.words.get(i) or else UInt64(0));
            out.words[i] = merged;
            out.live = out.live + BitSet.popcount(merged);
            i = i + UInt(1);
        };
        return out;
    };

    /// The members of both sets at once. Both sets must share the universe
    /// size.
    public intersection(self, other: BitSet): BitSet = {
        BitSet.check_same_size(self, other);
        let mutable out = BitSet.new(self.size);
        let mutable i = UInt(0);
        while i < self.words.count() then {
            let merged = (self.words.get(i) or else UInt64(0))
                & (other.words.get(i) or else UInt64(0));
            out.words[i] = merged;
            out.live = out.live + BitSet.popcount(merged);
            i = i + UInt(1);
        };
        return out;
    };

    /// The members of `self` that are not in `other`. Both sets must share
    /// the universe size.
    public difference(self, other: BitSet): BitSet = {
        BitSet.check_same_size(self, other);
        let mutable out = BitSet.new(self.size);
        let mutable i = UInt(0);
        while i < self.words.count() then {
            let merged = (self.words.get(i) or else UInt64(0))
                & BitSet.bit_not(other.words.get(i) or else UInt64(0));
            out.words[i] = merged;
            out.live = out.live + BitSet.popcount(merged);
            i = i + UInt(1);
        };
        return out;
    };

    /// The members in exactly one of the sets. Both sets must share the
    /// universe size.
    public symmetric_difference(self, other: BitSet): BitSet = {
        BitSet.check_same_size(self, other);
        let mutable out = BitSet.new(self.size);
        let mutable i = UInt(0);
        while i < self.words.count() then {
            let merged = (self.words.get(i) or else UInt64(0))
                ^ (other.words.get(i) or else UInt64(0));
            out.words[i] = merged;
            out.live = out.live + BitSet.popcount(merged);
            i = i + UInt(1);
        };
        return out;
    };

    /// The universe members that are not in the set.
    public complement(self): BitSet = {
        let mutable out = BitSet.new(self.size);
        let mutable i = UInt(0);
        while i < self.words.count() then {
            let flipped = BitSet.bit_not(self.words.get(i) or else UInt64(0));
            out.words[i] = flipped;
            i = i + UInt(1);
        };
        out.live = self.size - self.live;
        // Bits at and above the universe are zero in every member word.
        if self.size % UInt(64) != UInt(0) then {
            let last = out.words.count() - UInt(1);
            let tail = self.size % UInt(64);
            let keep = (UInt64(1) << UInt64(tail)) - UInt64(1);
            out.words[last] = (out.words.get(last) or else UInt64(0)) & keep;
        };
        return out;
    };

    /// Whether every member of `self` is a member of `other`. Sets over
    /// different universes answer `false`.
    public is_subset_of(self, other: BitSet): Bool = {
        if self.size != other.size then {
            return false;
        };
        let mutable i = UInt(0);
        while i < self.words.count() then {
            let mine = self.words.get(i) or else UInt64(0);
            let theirs = other.words.get(i) or else UInt64(0);
            if (mine & BitSet.bit_not(theirs)) != UInt64(0) then {
                return false;
            };
            i = i + UInt(1);
        };
        return true;
    };

    /// Whether every member of `other` is a member of `self`.
    public is_superset_of(self, other: BitSet): Bool = other.is_subset_of(self);

    /// Whether both sets hold the same members over the same universe.
    public equals(self, other: BitSet): Bool = {
        if self.size != other.size then {
            return false;
        };
        let mutable i = UInt(0);
        while i < self.words.count() then {
            if (self.words.get(i) or else UInt64(0))
                != (other.words.get(i) or else UInt64(0)) then {
                return false;
            };
            i = i + UInt(1);
        };
        return true;
    };

    /// An independent copy over the same universe.
    public clone(self): BitSet = {
        let mutable out = BitSet.new(self.size);
        let mutable i = UInt(0);
        while i < self.words.count() then {
            out.words[i] = self.words.get(i) or else UInt64(0);
            i = i + UInt(1);
        };
        out.live = self.live;
        return out;
    };

    /// The bit mask selecting `value` inside its word.
    private bit_mask(value: UInt): UInt64 = UInt64(1) << UInt64(value % UInt(64));

    /// The complement of a single word's mask.
    private bit_not(bits: UInt64): UInt64 = ~bits;

    /// The number of set bits in a word (Kernighan's count).
    private popcount(bits: UInt64): UInt = {
        let mutable word = bits;
        let mutable n = UInt(0);
        while word != UInt64(0) then {
            word = word & (word - UInt64(1));
            n = n + UInt(1);
        };
        return n;
    };

    /// Both operands of an algebra operation must share the universe size.
    private check_same_size(a: BitSet, b: BitSet): Void = {
        if a.size != b.size then {
            panic("BitSet universe size mismatch");
        };
    };
};

/// `Iterator` for `BitSetIterator`: yields members in ascending order.
given BitSetIterator: Iterator[UInt] {

    /// Yield the next member, or `None` after the largest one.
    public next(self): Option[UInt] = {
        let mutable bit = self.next_bit;
        while bit < self.source.size then {
            self.next_bit = bit + UInt(1);
            if self.source.contains(bit) then {
                return Option[UInt].Some(bit);
            };
            bit = bit + UInt(1);
        };
        return Option[UInt].None();
    };
};

/// `Iterable` for `BitSet`: a fresh ascending cursor over the members.
given BitSet: Iterable[UInt, BitSetIterator] {

    /// A fresh cursor over the members in ascending order; the set is
    /// untouched.
    public iterator(self): BitSetIterator = BitSetIterator(self, UInt(0));
};
