using std { .. };
// ============================================================================
// std.Container.Stack
// ============================================================================

public type mutable Stack[T Any](module_private mutable list List[T]);

public type mutable StackIterator[T Any](module_private mutable list List[T], module_private mutable remaining UInt);

given[T Any] Stack[T] {

    public new() Self = Stack[T](List[T].new());

    public with_capacity(capacity UInt) Self = Stack[T](List[T].with_capacity(capacity));

    public count(self) UInt = self.list.count();

    public is_empty(self) Bool = self.list.is_empty();

    public clear(self) Void = {
        self.list.clear();
    };

    public push(self, value T) Void = {
        self.list.push(value);
    };

    public pop(self) Option[T] = self.list.pop();

    public peek(self) Option[T] = self.list.last();
};

given[T Any] Stack[T] as Default {

    public default() Self = Stack[T].new();
};

given[T Any] Stack[T] as Iterable[T, StackIterator[T]] {

    public iterator(self) StackIterator[T] = StackIterator[T](self.list, self.list.count());
};

given[T Any] StackIterator[T] as Iterator[T] {

    public next(self) Option[T] = {
        if self.remaining == 0 then {
            return Option[T].None();
        };
        self.remaining = self.remaining - 1;
        return self.list.get(self.remaining);
    };
};
