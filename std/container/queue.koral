using std { .. }
// ============================================================================
// std.Container.Queue
// ============================================================================

public type Queue[T Any](protected mutable deque Deque[T])

public type QueueIterator[T Any](protected mutable iter DequeIterator[T])

given[T Deref] Queue[T] {

    public new() Self = Queue[T](Deque[T].new())

    public with_capacity(capacity UInt) Self = Queue[T](Deque[T].with_capacity(capacity))

    public count(*self) UInt = self.deque.count()

    public is_empty(*self) Bool = self.deque.is_empty()

    public clear(*mutable self) Void = {
        self.deque.clear()
    }

    public push(*mutable self, value T) Void = {
        self.deque.push_back(value)
    }

    public pop(*mutable self) Option[T] = self.deque.pop_front()

    public peek(*self) Option[T] = self.deque.first()
}

given[T Deref] Queue[T] as Default {

    public default() Self = Queue[T].new()
}

given[T Deref] Queue[T] as Iterable[T, QueueIterator[T]] {

    public iterator(*self) QueueIterator[T] = QueueIterator[T](self.deque.iterator())
}

given[T Deref] QueueIterator[T] as Iterator[T] {

    public next(*mutable self) Option[T] = self.iter.next()
}
