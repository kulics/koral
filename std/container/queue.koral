using std { .. };
// ============================================================================
// std.Container.Queue
// ============================================================================

public type mutable Queue[T Any](module_private mutable deque Deque[T]);

public type mutable QueueIterator[T Any](module_private mutable iter DequeIterator[T]);

given[T Any] Queue[T] {

    public new() Self = Queue[T](Deque[T].new());

    public with_capacity(capacity UInt) Self = Queue[T](Deque[T].with_capacity(capacity));

    public count(self) UInt = self.deque.count();

    public is_empty(self) Bool = self.deque.is_empty();

    public clear(self) Void = {
        self.deque.clear();
    };

    public push(self, value T) Void = {
        self.deque.push_back(value);
    };

    public pop(self) Option[T] = self.deque.pop_front();

    public peek(self) Option[T] = self.deque.first();
};

given[T Any] Queue[T] as Default {

    public default() Self = Queue[T].new();
};

given[T Any] Queue[T] as Iterable[T, QueueIterator[T]] {

    public iterator(self) QueueIterator[T] = QueueIterator[T](self.deque.iterator());
};

given[T Any] QueueIterator[T] as Iterator[T] {

    public next(self) Option[T] = self.iter.next();
};
