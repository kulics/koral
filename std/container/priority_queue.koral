using "std" { ... };
// ============================================================================
// std.Container.PriorityQueue (Max-Heap)
// ============================================================================

/// A max-heap priority queue: the greatest value is always at the top.
/// Iteration visits values in internal heap order, not sorted order.
public type mutable PriorityQueue[T: Ord](mutable values: List[T]);

/// Iterator over a priority queue's values in internal heap order.
public type mutable PriorityQueueIterator[T: Ord](mutable iter: ListIterator[T]);

/// Constructors and core heap operations for `PriorityQueue`.
given[T: Ord] PriorityQueue[T] {

    /// Create an empty priority queue.
    public new(): Self = PriorityQueue[T](List[T].new());

    /// Create an empty priority queue with room for `capacity` values before resizing.
    public with_capacity(capacity: Int): Self = {
        if capacity < 0 then {
            panic("PriorityQueue with_capacity negative capacity");
        };
        return PriorityQueue[T](List[T].with_capacity(capacity));
    };

    /// Return the number of values in the queue.
    public count(self): Int = self.values.count();

    /// Return `true` if the queue holds no values.
    public is_empty(self): Bool = self.values.is_empty();

    /// Remove all values from the queue.
    public clear(self): Void = {
        self.values.clear();
    };

    private swap_indices(self, a: Int, b: Int): Void = {
        let left = self.values[a];
        let right = self.values[b];
        self.values[a] = right;
        self.values[b] = left;
    };

    private sift_up(self, index: Int): Void = {
        let mutable current = index;
        while current > 0 then {
            let parent = (current - 1) / 2;
            let parent_value = self.values[parent];
            let current_value = self.values[current];
            if parent_value >= current_value then {
                return;
            };
            self.values[parent] = current_value;
            self.values[current] = parent_value;
            current = parent;
        };
    };

    private sift_down(self, index: Int): Void = {
        let count = self.values.count();
        let mutable parent = index;
        while parent < count then {
            let left = parent * 2 + 1;
            if left >= count then {
                return;
            };
            let right = left + 1;
            let mutable candidate = left;
            if right < count and self.values[right] > self.values[left] then {
                candidate = right;
            };
            if self.values[parent] >= self.values[candidate] then {
                return;
            };
            self.swap_indices(parent, candidate);
            parent = candidate;
        };
    };

    /// Insert a value, restoring the max-heap order.
    public push(self, value: T): Void = {
        self.values.push(value);
        self.sift_up(self.values.count() - 1);
    };

    /// Remove and return the greatest value, or `None` if the queue is empty.
    public pop(self): Option[T] = {
        if self.values.is_empty() then {
            return Option[T].None();
        };
        if self.values.count() == 1 then {
            return self.values.pop();
        };

        let top = self.values[0];
        when self.values.pop() in {
            .Some(last) then {
                self.values[0] = last;
                self.sift_down(0);
                return Option[T].Some(top);
            },
            .None() then {
                return Option[T].Some(top);
            },
        };
    };

    /// Return the greatest value without removing it, or `None` if the queue is empty.
    public peek(self): Option[T] = self.values.first();
};

/// Iterable conformance: visit values in internal heap order.
given[T: Ord] PriorityQueue[T]: Iterable[T, PriorityQueueIterator[T]] {

    /// Create an iterator over the queue's values in heap order.
    public iterator(self): PriorityQueueIterator[T] = PriorityQueueIterator[T](
        self.values.iterator(),
    );
};

/// Iterator conformance for `PriorityQueueIterator`, yielding heap-ordered values.
given[T: Ord] PriorityQueueIterator[T]: Iterator[T] {

    /// Return the next value in heap order, or `None` when exhausted.
    public next(self): Option[T] = self.iter.next();
};
