using "std";
// ============================================================================
// std.net - TcpSocket Type
// ============================================================================
// Provides: TcpSocket
// Access via: using Std.Net
// ============================================================================

using "std/io" { Reader, Writer };

// ============================================================================
// TcpSocket Type
// ============================================================================

/// TCP socket type.
/// Holds a socket file descriptor. Automatically closed on drop.
/// Implements Reader and Writer traits for use with BufReader/BufWriter.
public type TcpSocket(module_private fd Int64);

given TcpSocket as Drop {

    /// Automatically close the socket when TcpSocket is dropped.
    drop(self) Void = {
        if self.fd >= 0 then {
            __koral_socket_close(self.fd);
        };
    };
};

// ============================================================================
// TcpSocket Methods
// ============================================================================
given TcpSocket {

    /// Returns the underlying OS socket file descriptor.
    public fd(self) Int = Int(self.fd);

    /// Connect to a socket address.
    /// Flow: create socket → connect
    /// On any failure, closes the fd and returns Error.
    public connect[T IntoSocketAddr](addr T) Result[TcpSocket] = {
        let addr = when addr.into_socket_addr() in {
            .Ok(value) then value,
            .Error(_) then {
                return Result[TcpSocket].Error("invalid socket address");
            },
        };
        // Determine address family from SocketAddr
        let domain Int32 = if addr.is_ipv4() then __koral_const_AF_INET()
        else __koral_const_AF_INET6();
        let sock_type Int32 = __koral_const_SOCK_STREAM();
        let protocol Int32 = 0;

        // Create socket
        let fd = __koral_socket_create(domain, sock_type, protocol);
        if fd < 0 then {
            return Result[TcpSocket].Error(last_error_message());
        };

        // Connect to address
        let addr_bytes = addr.to_sockaddr_bytes();
        let addr_len = UInt32(addr_bytes.count());
        let connect_result = __koral_socket_connect(fd, addr_bytes.borrow_ptr(), addr_len);
        if connect_result <> 0 then {
            __koral_socket_close(fd);
            return Result[TcpSocket].Error(last_error_message());
        };

        return Result[TcpSocket].Ok(TcpSocket(fd));
    };

    // ========================================================================
    // Address query methods
    // ========================================================================

    /// Get the local address of this socket.
    public local_addr(self) Result[SocketAddr] = {
        let addr_buf = alloc_memory[UInt8](128);
        defer dealloc_memory(addr_buf);
        for i in UInt(0)..<UInt(128) then {
            init_memory(addr_buf + i, UInt8(0));
        };
        let mutable addr_len UInt32 = UInt32(128);

        let result = __koral_socket_getsockname(self.fd, addr_buf, &addr_len);
        if result <> 0 then {
            return Result[SocketAddr].Error(last_error_message());
        };

        let actual_len = UInt(addr_len);
        let mutable addr_list = List[UInt8].with_capacity(actual_len);
        for j in 0..<actual_len then {
            addr_list.push(addr_buf[j]);
        };

        return SocketAddr.from_sockaddr_bytes(addr_list);
    };

    /// Get the peer address of this socket.
    public peer_addr(self) Result[SocketAddr] = {
        let addr_buf = alloc_memory[UInt8](128);
        defer dealloc_memory(addr_buf);
        for i in UInt(0)..<UInt(128) then {
            init_memory(addr_buf + i, UInt8(0));
        };
        let mutable addr_len UInt32 = UInt32(128);

        let result = __koral_socket_getpeername(self.fd, addr_buf, &addr_len);
        if result <> 0 then {
            return Result[SocketAddr].Error(last_error_message());
        };

        let actual_len = UInt(addr_len);
        let mutable addr_list = List[UInt8].with_capacity(actual_len);
        for j in 0..<actual_len then {
            addr_list.push(addr_buf[j]);
        };

        return SocketAddr.from_sockaddr_bytes(addr_list);
    };

    // ========================================================================
    // Shutdown
    // ========================================================================

    /// Shutdown the connection.
    /// Shutdown.Read() = 0, Shutdown.Write() = 1, Shutdown.Both() = 2
    public shutdown(self, how Shutdown) Result[Void] = {
        let how_int Int32 = when how in {
            .Read() then Int32(0),
            .Write() then Int32(1),
            .Both() then Int32(2),
        };
        let result = __koral_socket_shutdown(self.fd, how_int);
        if result <> 0 then {
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };

    // ========================================================================
    // TCP_NODELAY option
    // ========================================================================

    /// Set TCP_NODELAY option (disable Nagle's algorithm).
    /// level=6 (IPPROTO_TCP), optname=1 (TCP_NODELAY)
    public set_nodelay(self, nodelay Bool) Result[Void] = {
        let opt_buf = alloc_memory[UInt8](4);
        defer dealloc_memory(opt_buf);
        let value UInt8 = if nodelay then UInt8(1) else UInt8(0);
        init_memory(opt_buf + 0, value);
        init_memory(opt_buf + 1, UInt8(0));
        init_memory(opt_buf + 2, UInt8(0));
        init_memory(opt_buf + 3, UInt8(0));
        let result = __koral_socket_setsockopt(
            self.fd,
            __koral_const_IPPROTO_TCP(),
            __koral_const_TCP_NODELAY(),
            opt_buf,
            UInt32(4),
        );
        if result <> 0 then {
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };

    /// Get TCP_NODELAY option.
    /// level=6 (IPPROTO_TCP), optname=1 (TCP_NODELAY)
    public nodelay(self) Result[Bool] = {
        let opt_buf = alloc_memory[UInt8](4);
        defer dealloc_memory(opt_buf);
        init_memory(opt_buf + 0, UInt8(0));
        init_memory(opt_buf + 1, UInt8(0));
        init_memory(opt_buf + 2, UInt8(0));
        init_memory(opt_buf + 3, UInt8(0));
        let mutable opt_len UInt32 = UInt32(4);
        let result = __koral_socket_getsockopt(
            self.fd,
            __koral_const_IPPROTO_TCP(),
            __koral_const_TCP_NODELAY(),
            opt_buf,
            &opt_len,
        );
        if result <> 0 then {
            return Result[Bool].Error(last_error_message());
        };
        let value = *opt_buf;
        return Result[Bool].Ok(value <> UInt8(0));
    };

    // ========================================================================
    // Timeout options (SO_RCVTIMEO / SO_SNDTIMEO)
    // ========================================================================

    /// Set read timeout. None clears the timeout.
    /// SO_RCVTIMEO: level=1 (SOL_SOCKET), optname=20 (Linux)
    /// struct timeval: tv_sec (8 bytes, Int64) + tv_usec (8 bytes, Int64) = 16 bytes
    public set_read_timeout(self, timeout Option[Duration]) Result[Void] = {
        let tv_buf = alloc_memory[UInt8](16);
        defer dealloc_memory(tv_buf);
        when timeout in {
            .None() then {
                // Zero timeval clears the timeout
                for i in UInt(0)..<UInt(16) then {
                    init_memory(tv_buf + i, UInt8(0));
                };
            },
            .Some(duration) then {
                TcpSocket.duration_to_timeval(duration, tv_buf);
            },
        };
        let result = __koral_socket_setsockopt(
            self.fd,
            __koral_const_SOL_SOCKET(),
            __koral_const_SO_RCVTIMEO(),
            tv_buf,
            UInt32(16),
        );
        if result <> 0 then {
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };

    /// Set write timeout. None clears the timeout.
    /// SO_SNDTIMEO: level=1 (SOL_SOCKET), optname=21 (Linux)
    public set_write_timeout(self, timeout Option[Duration]) Result[Void] = {
        let tv_buf = alloc_memory[UInt8](16);
        defer dealloc_memory(tv_buf);
        when timeout in {
            .None() then {
                for i in UInt(0)..<UInt(16) then {
                    init_memory(tv_buf + i, UInt8(0));
                };
            },
            .Some(duration) then {
                TcpSocket.duration_to_timeval(duration, tv_buf);
            },
        };
        let result = __koral_socket_setsockopt(
            self.fd,
            __koral_const_SOL_SOCKET(),
            __koral_const_SO_SNDTIMEO(),
            tv_buf,
            UInt32(16),
        );
        if result <> 0 then {
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };

    /// Get read timeout. Returns None if no timeout is set.
    /// SO_RCVTIMEO: level=1 (SOL_SOCKET), optname=20 (Linux)
    public read_timeout(self) Result[Option[Duration]] = {
        let tv_buf = alloc_memory[UInt8](16);
        defer dealloc_memory(tv_buf);
        for i in UInt(0)..<UInt(16) then {
            init_memory(tv_buf + i, UInt8(0));
        };
        let mutable opt_len UInt32 = UInt32(16);
        let result = __koral_socket_getsockopt(
            self.fd,
            __koral_const_SOL_SOCKET(),
            __koral_const_SO_RCVTIMEO(),
            tv_buf,
            &opt_len,
        );
        if result <> 0 then {
            return Result[Option[Duration]].Error(last_error_message());
        };
        let duration_opt = TcpSocket.timeval_to_duration(tv_buf);
        return Result[Option[Duration]].Ok(duration_opt);
    };

    /// Get write timeout. Returns None if no timeout is set.
    /// SO_SNDTIMEO: level=1 (SOL_SOCKET), optname=21 (Linux)
    public write_timeout(self) Result[Option[Duration]] = {
        let tv_buf = alloc_memory[UInt8](16);
        defer dealloc_memory(tv_buf);
        for i in UInt(0)..<UInt(16) then {
            init_memory(tv_buf + i, UInt8(0));
        };
        let mutable opt_len UInt32 = UInt32(16);
        let result = __koral_socket_getsockopt(
            self.fd,
            __koral_const_SOL_SOCKET(),
            __koral_const_SO_SNDTIMEO(),
            tv_buf,
            &opt_len,
        );
        if result <> 0 then {
            return Result[Option[Duration]].Error(last_error_message());
        };
        let duration_opt = TcpSocket.timeval_to_duration(tv_buf);
        return Result[Option[Duration]].Ok(duration_opt);
    };

    // ========================================================================
    // Private helpers for timeval conversion
    // ========================================================================

    /// Convert a Duration to a struct timeval (16 bytes) in a raw buffer.
    /// timeval layout: tv_sec (Int64, 8 bytes LE) + tv_usec (Int64, 8 bytes LE)
    file_private duration_to_timeval(duration Duration, buf *mutable UInt8) Void = {
        let secs = duration.secs;
        let usec = duration.nanos / 1000;

        // Write tv_sec as little-endian Int64 (bytes 0..7)
        init_memory(buf + 0, UInt8((secs & 255)));
        init_memory(buf + 1, UInt8(((secs >> 8) & 255)));
        init_memory(buf + 2, UInt8(((secs >> 16) & 255)));
        init_memory(buf + 3, UInt8(((secs >> 24) & 255)));
        init_memory(buf + 4, UInt8(((secs >> 32) & 255)));
        init_memory(buf + 5, UInt8(((secs >> 40) & 255)));
        init_memory(buf + 6, UInt8(((secs >> 48) & 255)));
        init_memory(buf + 7, UInt8(((secs >> 56) & 255)));

        // Write tv_usec as little-endian Int64 (bytes 8..15)
        init_memory(buf + 8, UInt8((usec & 255)));
        init_memory(buf + 9, UInt8(((usec >> 8) & 255)));
        init_memory(buf + 10, UInt8(((usec >> 16) & 255)));
        init_memory(buf + 11, UInt8(((usec >> 24) & 255)));
        init_memory(buf + 12, UInt8(((usec >> 32) & 255)));
        init_memory(buf + 13, UInt8(((usec >> 40) & 255)));
        init_memory(buf + 14, UInt8(((usec >> 48) & 255)));
        init_memory(buf + 15, UInt8(((usec >> 56) & 255)));
    };

    /// Convert a struct timeval (16 bytes) from a raw buffer to a [Duration]Option.
    /// Returns None if both tv_sec and tv_usec are zero (no timeout set).
    file_private timeval_to_duration(buf *UInt8) Option[Duration] = {
        // Read tv_sec as little-endian Int64 (bytes 0..7)
        let secs = (Int64(UInt(buf[0])) + (Int64(UInt(buf[1])) << 8) + (Int64(
            UInt(buf[2]),
        ) << 16) + (Int64(UInt(buf[3])) << 24) + (Int64(UInt(buf[4])) << 32) + (Int64(
            UInt(buf[5]),
        ) << 40) + (Int64(UInt(buf[6])) << 48) + (Int64(UInt(buf[7])) << 56));

        // Read tv_usec as little-endian Int64 (bytes 8..15)
        let usec = (Int64(UInt(buf[8])) + (Int64(UInt(buf[9])) << 8) + (Int64(
            UInt(buf[10]),
        ) << 16) + (Int64(UInt(buf[11])) << 24) + (Int64(UInt(buf[12])) << 32) + (Int64(
            UInt(buf[13]),
        ) << 40) + (Int64(UInt(buf[14])) << 48) + (Int64(UInt(buf[15])) << 56));

        // Zero timeval means no timeout
        if secs == 0 and usec == 0 then {
            return Option[Duration].None();
        };

        let nanos = usec * 1000;
        return Option[Duration].Some(Duration(secs, nanos));
    };
};

given TcpSocket as Reader {

    /// Reader trait: read bytes into into[range].
    /// Returns Ok(0) on EOF (peer closed connection).
    public read(self, into: List[UInt8], span: Range[UInt]) Result[UInt] = {
        let span = into.slice_spec(span);
        let start = span.start();
        let end = span.end();
        if end <= start then {
            return Result[UInt].Ok(0);
        };
        let data_ptr = into.borrow_mut_ptr() + start;
        let n = __koral_socket_recv(self.fd, data_ptr, UInt64(span.len()), Int32(0));
        if n < 0 then {
            return Result[UInt].Error(last_error_message());
        };
        return Result[UInt].Ok(UInt(n));
    };
};

given TcpSocket as Writer {

    /// Writer trait: write bytes from from[range] into the connection.
    public write(self, from: List[UInt8], span: Range[UInt]) Result[UInt] = {
        let span = from.slice_spec(span);
        let start = span.start();
        let end = span.end();
        if end <= start then {
            return Result[UInt].Ok(0);
        };
        let data_ptr = from.borrow_ptr() + start;
        let n = __koral_socket_send(self.fd, data_ptr, UInt64(span.len()), Int32(0));
        if n < 0 then {
            return Result[UInt].Error(last_error_message());
        };
        return Result[UInt].Ok(UInt(n));
    };

    /// Writer trait: flush. TCP has no user-space buffer, so this is a no-op.
    public flush(self) Result[Void] = Result[Void].Ok({});
};
