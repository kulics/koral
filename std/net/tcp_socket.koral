using "std" { ... };
// ============================================================================
// std.net - TcpSocket Type
// ============================================================================
// Provides: TcpSocket
// Access via: using "std/net" { ... };
// ============================================================================

using "std/io" { Reader, Writer };

// ============================================================================
// TcpSocket Type
// ============================================================================

/// TCP socket type.
/// Holds a socket file descriptor. Automatically closed on drop.
/// Implements Reader and Writer traits for use with BufReader/BufWriter.
/// Sendable contract: handoff to a worker thread is idiomatic; concurrent use
/// of one socket is the caller's framing responsibility.
public type unsafe sendable mutable TcpSocket(sock_fd: Int64);

/// Drop conformance: closes the socket when the connection is dropped.
given TcpSocket: Drop {

    /// Automatically close the socket when TcpSocket is dropped.
    drop(self): Void = {
        if self.sock_fd >= 0 then {
            __koral_socket_close(self.sock_fd);
        };
    };
};

// ============================================================================
// TcpSocket Methods
// ============================================================================
/// Connect to a remote address, query the connection's addresses, and manage shutdown and socket options.
given TcpSocket {

    /// Returns the underlying OS socket file descriptor.
    public fd(self): Int = Int(self.sock_fd);

    /// Connect to a socket address.
    /// Flow: create socket → connect
    /// On any failure, closes the fd and returns Error.
    public connect[T: IntoSocketAddr](addr: T): Result[TcpSocket] = {
        let addr = when addr.into_socket_addr() in {
            .Ok(value) then value,
            .Error(_) then {
                return Result[TcpSocket].Error("invalid socket address");
            },
        };
        // Determine address family from SocketAddr
        let domain: Int32 = if addr.is_ipv4() then __koral_const_AF_INET()
        else __koral_const_AF_INET6();
        let sock_type: Int32 = __koral_const_SOCK_STREAM();
        let protocol: Int32 = 0;

        // Create socket
        let fd = __koral_socket_create(domain, sock_type, protocol);
        if fd < 0 then {
            return Result[TcpSocket].Error(last_error_message());
        };

        // Connect to address
        let addr_bytes = addr.to_sockaddr_bytes();
        let addr_len = UInt32(addr_bytes.count());
        let connect_result = __koral_socket_connect(fd, addr_bytes.borrow_ptr(), addr_len);
        if connect_result != 0 then {
            __koral_socket_close(fd);
            return Result[TcpSocket].Error(last_error_message());
        };

        return Result[TcpSocket].Ok(TcpSocket(fd));
    };

    // ========================================================================
    // Address query methods
    // ========================================================================

    /// Get the local address of this socket.
    public local_addr(self): Result[SocketAddr] = {
        let addr_buf = alloc_memory[UInt8](128);
        defer dealloc_memory(addr_buf);
        for i in 0..<128 then {
            init_memory(addr_buf + i, UInt8(0));
        };
        let mutable addr_len: UInt32 = UInt32(128);

        let result = __koral_socket_getsockname(self.sock_fd, addr_buf, &addr_len);
        if result != 0 then {
            return Result[SocketAddr].Error(last_error_message());
        };

        let actual_len = Int(addr_len);
        let mutable addr_list = List[UInt8].with_capacity(actual_len);
        for j in 0..<actual_len then {
            addr_list.push(addr_buf[j]);
        };

        return SocketAddr.from_sockaddr_bytes(addr_list);
    };

    /// Get the peer address of this socket.
    public peer_addr(self): Result[SocketAddr] = {
        let addr_buf = alloc_memory[UInt8](128);
        defer dealloc_memory(addr_buf);
        for i in 0..<128 then {
            init_memory(addr_buf + i, UInt8(0));
        };
        let mutable addr_len: UInt32 = UInt32(128);

        let result = __koral_socket_getpeername(self.sock_fd, addr_buf, &addr_len);
        if result != 0 then {
            return Result[SocketAddr].Error(last_error_message());
        };

        let actual_len = Int(addr_len);
        let mutable addr_list = List[UInt8].with_capacity(actual_len);
        for j in 0..<actual_len then {
            addr_list.push(addr_buf[j]);
        };

        return SocketAddr.from_sockaddr_bytes(addr_list);
    };

    // ========================================================================
    // Shutdown
    // ========================================================================

    /// Shutdown the connection.
    /// Shutdown.Read() = 0, Shutdown.Write() = 1, Shutdown.Both() = 2
    /// Shutting down a socket that is not connected is not an error: ENOTCONN
    /// (WSAENOTCONN on Windows) is reported as success on every platform.
    public shutdown(self, how: Shutdown): Result[Void] = {
        let how_int: Int32 = when how in {
            .Read() then Int32(0),
            .Write() then Int32(1),
            .Both() then Int32(2),
        };
        let result = __koral_socket_shutdown(self.sock_fd, how_int);
        if result != 0 then {
            if is_not_connected_error(socket_error_code()) then {
                return Result[Void].Ok({});
            };
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };

    // ========================================================================
    // TCP_NODELAY option
    // ========================================================================

    /// Set TCP_NODELAY option (disable Nagle's algorithm).
    /// level=6 (IPPROTO_TCP), optname=1 (TCP_NODELAY)
    public set_nodelay(self, nodelay: Bool): Result[Void] = {
        let opt_buf = alloc_memory[UInt8](4);
        defer dealloc_memory(opt_buf);
        let value: UInt8 = if nodelay then UInt8(1) else UInt8(0);
        init_memory(opt_buf + 0, value);
        init_memory(opt_buf + 1, UInt8(0));
        init_memory(opt_buf + 2, UInt8(0));
        init_memory(opt_buf + 3, UInt8(0));
        let result = __koral_socket_setsockopt(
            self.sock_fd,
            __koral_const_IPPROTO_TCP(),
            __koral_const_TCP_NODELAY(),
            opt_buf,
            UInt32(4),
        );
        if result != 0 then {
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };

    /// Get TCP_NODELAY option.
    /// level=6 (IPPROTO_TCP), optname=1 (TCP_NODELAY)
    public nodelay(self): Result[Bool] = {
        let opt_buf = alloc_memory[UInt8](4);
        defer dealloc_memory(opt_buf);
        init_memory(opt_buf + 0, UInt8(0));
        init_memory(opt_buf + 1, UInt8(0));
        init_memory(opt_buf + 2, UInt8(0));
        init_memory(opt_buf + 3, UInt8(0));
        let mutable opt_len: UInt32 = UInt32(4);
        let result = __koral_socket_getsockopt(
            self.sock_fd,
            __koral_const_IPPROTO_TCP(),
            __koral_const_TCP_NODELAY(),
            opt_buf,
            &opt_len,
        );
        if result != 0 then {
            return Result[Bool].Error(last_error_message());
        };
        let value = *opt_buf;
        return Result[Bool].Ok(value != UInt8(0));
    };

    // ========================================================================
    // Timeout options (SO_RCVTIMEO / SO_SNDTIMEO)
    // ========================================================================

    /// Set read timeout. None clears the timeout.
    /// SO_RCVTIMEO: level=1 (SOL_SOCKET), optname=20.
    /// The value encoding is platform-specific: a DWORD of milliseconds on
    /// Windows, a struct timeval (8 bytes on 32-bit, 16 bytes on 64-bit) elsewhere.
    public set_read_timeout(self, timeout: Option[Duration]): Result[Void] = {
        let opt_len = timeout_option_len(self.sock_fd);
        let tv_buf = alloc_memory[UInt8](16);
        defer dealloc_memory(tv_buf);
        encode_timeout_option(timeout, tv_buf, opt_len);
        let result = __koral_socket_setsockopt(
            self.sock_fd,
            __koral_const_SOL_SOCKET(),
            __koral_const_SO_RCVTIMEO(),
            tv_buf,
            opt_len,
        );
        if result != 0 then {
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };

    /// Set write timeout. None clears the timeout.
    /// SO_SNDTIMEO: level=1 (SOL_SOCKET), optname=21.
    /// The value encoding is platform-specific: a DWORD of milliseconds on
    /// Windows, a struct timeval (8 bytes on 32-bit, 16 bytes on 64-bit) elsewhere.
    public set_write_timeout(self, timeout: Option[Duration]): Result[Void] = {
        let opt_len = timeout_option_len(self.sock_fd);
        let tv_buf = alloc_memory[UInt8](16);
        defer dealloc_memory(tv_buf);
        encode_timeout_option(timeout, tv_buf, opt_len);
        let result = __koral_socket_setsockopt(
            self.sock_fd,
            __koral_const_SOL_SOCKET(),
            __koral_const_SO_SNDTIMEO(),
            tv_buf,
            opt_len,
        );
        if result != 0 then {
            return Result[Void].Error(last_error_message());
        };
        return Result[Void].Ok({});
    };

    /// Get read timeout. Returns None if no timeout is set.
    /// SO_RCVTIMEO: level=1 (SOL_SOCKET), optname=20.
    public read_timeout(self): Result[Option[Duration]] = {
        let opt_len = timeout_option_len(self.sock_fd);
        let tv_buf = alloc_memory[UInt8](16);
        defer dealloc_memory(tv_buf);
        for i in 0..<16 then {
            init_memory(tv_buf + i, UInt8(0));
        };
        let mutable len = opt_len;
        let result = __koral_socket_getsockopt(
            self.sock_fd,
            __koral_const_SOL_SOCKET(),
            __koral_const_SO_RCVTIMEO(),
            tv_buf,
            &len,
        );
        if result != 0 then {
            return Result[Option[Duration]].Error(last_error_message());
        };
        return Result[Option[Duration]].Ok(decode_timeout_option(tv_buf, len));
    };

    /// Get write timeout. Returns None if no timeout is set.
    /// SO_SNDTIMEO: level=1 (SOL_SOCKET), optname=21.
    public write_timeout(self): Result[Option[Duration]] = {
        let opt_len = timeout_option_len(self.sock_fd);
        let tv_buf = alloc_memory[UInt8](16);
        defer dealloc_memory(tv_buf);
        for i in 0..<16 then {
            init_memory(tv_buf + i, UInt8(0));
        };
        let mutable len = opt_len;
        let result = __koral_socket_getsockopt(
            self.sock_fd,
            __koral_const_SOL_SOCKET(),
            __koral_const_SO_SNDTIMEO(),
            tv_buf,
            &len,
        );
        if result != 0 then {
            return Result[Option[Duration]].Error(last_error_message());
        };
        return Result[Option[Duration]].Ok(decode_timeout_option(tv_buf, len));
    };
};

/// Reader conformance: reads incoming bytes, reporting Ok(0) once the peer closes the connection.
given TcpSocket: Reader {

    /// Reader trait: read bytes into into[range].
    /// Returns Ok(0) on EOF (peer closed connection).
    public read(self, into: List[UInt8] =, span: Range[Int] =): Result[Int] = {
        let span = into.slice_spec(span);
        let start = span.start();
        let end = span.end();
        if end <= start then {
            return Result[Int].Ok(0);
        };
        let data_ptr = into.borrow_mut_ptr() + start;
        let n = __koral_socket_recv(self.sock_fd, data_ptr, UInt64(span.len()), Int32(0));
        if n < 0 then {
            return Result[Int].Error(last_error_message());
        };
        return Result[Int].Ok(Int(n));
    };
};

/// Writer conformance: sends bytes to the connected peer.
given TcpSocket: Writer {

    /// Writer trait: write bytes from from[range] into the connection.
    public write(self, from: List[UInt8] =, span: Range[Int] =): Result[Int] = {
        let span = from.slice_spec(span);
        let start = span.start();
        let end = span.end();
        if end <= start then {
            return Result[Int].Ok(0);
        };
        let data_ptr = from.borrow_ptr() + start;
        let n = __koral_socket_send(self.sock_fd, data_ptr, UInt64(span.len()), Int32(0));
        if n < 0 then {
            return Result[Int].Error(last_error_message());
        };
        return Result[Int].Ok(Int(n));
    };

    /// Writer trait: flush. TCP has no user-space buffer, so this is a no-op.
    public flush(self): Result[Void] = Result[Void].Ok({});
};
