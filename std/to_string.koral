/// `ToString` for `UInt`: decimal text.
given UInt: ToString {

    /// Return the decimal representation.
    public to_string(self): String = {
        if self == 0 then {
            return "0";
        };

        let mutable n = self;
        let buf = alloc_memory[UInt8](21);
        let mutable pos: UInt = 20;
        init_memory(buf + pos, 0);
        while n > 0 then {
            pos -= 1;
            init_memory(buf + pos, UInt8((n % 10)) + '0');
            n = n / 10;
        };

        let len = 20 - pos;
        if pos > 0 then {
            move_memory(buf, buf + pos, len + 1);
        };
        return String(buf, len);
    };
};

/// `ToString` for `UInt8`: decimal text.
given UInt8: ToString {

    /// Return the decimal representation.
    public to_string(self): String = UInt(self).to_string();
};

/// `ToString` for `UInt16`: decimal text.
