/// `ToString` for `Float32`: decimal with six fractional digits, or `NaN`, `Inf`, `-Inf`.
given Float32: ToString {

    /// Return the value as decimal text with six fractional digits, or as
    /// `NaN`, `Inf`, or `-Inf`.
    public to_string(self): String = {
        let bits = self.to_bits();
        let exp = (bits >> 23) & 255;
        let mantissa = bits & 8388607;
        if exp == 255 then {
            if mantissa != 0 then {
                return "NaN";
            };
            if (bits >> 31) == 1 then {
                return "-Inf";
            };
            return "Inf";
        };

        let is_negative = (bits >> 31) == 1;
        let mutable f = if is_negative then 0.0 - Float64(self) else Float64(self);

        let int_part = Int(f);
        let frac_part = f - Float64(int_part);

        let mutable result = StringBuilder.new();
        if is_negative then {
            result.push_byte('-');
        };

        result.push_string(int_part.to_string());
        result.push_byte('.');

        let mutable frac = frac_part;
        for _ in Int(0)..<Int(6) then {
            frac = frac * 10.0;
            let d = Int(frac);
            result.push_byte(UInt8(d) + '0');
            frac = frac - Float64(d);
        };

        return result.to_string();
    };
};

/// `ToString` for `Float64`: decimal with six fractional digits, or `NaN`, `Inf`, `-Inf`.
given Float64: ToString {

    /// Return the value as decimal text with six fractional digits, or as
    /// `NaN`, `Inf`, or `-Inf`.
    public to_string(self): String = {
        let bits = self.to_bits();
        let exp = (bits >> 52) & 2047;
        let mantissa = bits & 4503599627370495;
        if exp == 2047 then {
            if mantissa != 0 then {
                return "NaN";
            };
            if (bits >> 63) == 1 then {
                return "-Inf";
            };
            return "Inf";
        };

        let is_negative = (bits >> 63) == 1;
        let mutable f = if is_negative then 0.0 - self else self;

        let int_part = Int(f);
        let frac_part = f - Float64(int_part);

        let mutable result = StringBuilder.new();
        if is_negative then {
            result.push_byte('-');
        };

        result.push_string(int_part.to_string());
        result.push_byte('.');

        let mutable frac = frac_part;
        for _ in Int(0)..<Int(6) then {
            frac = frac * 10.0;
            let d = Int(frac);
            result.push_byte(UInt8(d) + '0');
            frac = frac - Float64(d);
        };

        return result.to_string();
    };
};

// ============================================================================
// Collection and Option ToString Implementations
// ============================================================================
/// `ToString` for `Pair`: renders `(first, second)`.
given[T: ToString, U: ToString] Pair[T, U]: ToString {

    /// Return the pair as `(a, b)`, with both components rendered.
    public to_string(self): String = {
        let mutable result = StringBuilder.new();
        result.push_string("(");
        result.push_string(self.first.to_string());
        result.push_string(", ");
        result.push_string(self.second.to_string());
        result.push_string(")");
        return result.to_string();
    };
};

/// `ToString` for `Option`: renders `Some(value)` or `None`.
given[T: ToString] Option[T]: ToString {

    /// Return `Some(...)` with the value rendered, or the text `None`.
    public to_string(self): String = when self in {
        .Some(v) then {
            let mutable result = StringBuilder.new();
            result.push_string("Some(");
            result.push_string(v.to_string());
            result.push_string(")");
            result.to_string()
        },
        .None() then "None",
    };
};

/// `ToString` for `List`: renders `[a, b, c]`.
given[T: ToString] List[T]: ToString {

    /// Return the list as `[a, b, c]`, or `[]` when empty.
    public to_string(self): String = {
        let mutable result = StringBuilder.new();
        result.push_string("[");
        for i in 0..<self.count() then {
            if i > 0 then {
                result.push_string(", ");
            };
            result.push_string(self[i].to_string());
        };
        result.push_string("]");
        return result.to_string();
    };
};

/// Joining the items of a lazy view into one string.
given[T: ToString, R: Iterator[T]] LazyView[T, R] {

    /// Return the items' display text joined by the given separator, or the
    /// empty string when there are no items.
    public join_to_string(self, seperator: String): String = {
        let mutable result = StringBuilder.new();
        let mutable first = true;
        let iter = self.iterator();
        while iter.next() is .Some(item) then {
            if not first then {
                result.push_string(seperator);
            };
            result.push_string(item.to_string());
            first = false;
        };
        return result.to_string();
    };
};

/// Joining the items of a list into one string.
given[T: ToString] List[T] {

    /// Return the items' display text joined by the given separator, or the
    /// empty string when the list is empty.
    public join_to_string(self, seperator: String): String = {
        let mutable result = StringBuilder.new();
        let mutable first = true;
        for item in self then {
            if not first then {
                result.push_string(seperator);
            };
            result.push_string(item.to_string());
            first = false;
        };
        return result.to_string();
    };
};

/// `ToString` for `Dict`: renders `[key: value, ...]`.
given[K: ToString and Hash, V: ToString] Dict[K, V]: ToString {

    /// Return the dict as `[k: v, ...]`, or `[]` when empty.
    public to_string(self): String = {
        let mutable result = StringBuilder.new();
        result.push_string("[");
        let mutable first = true;
        for entry in self then {
            if not first then {
                result.push_string(", ");
            };
            first = false;
            result.push_string(entry.first.to_string());
            result.push_string(": ");
            result.push_string(entry.second.to_string());
        };
        result.push_string("]");
        return result.to_string();
    };
};

/// `ToString` for `Set`: renders `[a, b, ...]`.
given[T: ToString and Hash] Set[T]: ToString {

    /// Return the set as `[a, b, ...]`, or `[]` when empty.
    public to_string(self): String = {
        let mutable result = StringBuilder.new();
        result.push_string("[");
        let mutable first = true;
        for v in self then {
            if not first then {
                result.push_string(", ");
            };
            first = false;
            result.push_string(v.to_string());
        };
        result.push_string("]");
        return result.to_string();
    };
};

// ============================================================================
// Time ToString Implementations
// ============================================================================
/// `ToString` for `Duration`: compact text such as `0s`, `150ms`, `1.5s`, or `1h2m3s`.
given Duration: ToString {

    /// Return the duration as compact text: `0s`, a sub-second unit below one
    /// second, or `h`/`m`/`s` with a trimmed fractional second.
    public to_string(self): String = {
        if self.secs == 0 and self.nanos == 0 then {
            return "0s";
        };
        let total_ns = self.as_nanoseconds();
        let is_neg = total_ns < 0;
        let abs_ns = if is_neg then 0 - total_ns else total_ns;
        let mutable secs = abs_ns / 1_000_000_000;
        let nanos = abs_ns % 1_000_000_000;
        let mutable result = StringBuilder.new();

        if is_neg then {
            result.push_string("-");
        };

        // Sub-second durations: show as ms, us, or ns
        if secs == 0 then {
            if nanos % 1_000_000 == 0 then {
                result.push_string((nanos / 1_000_000).to_string());
                result.push_string("ms");
            } else if nanos % 1_000 == 0 then {
                result.push_string((nanos / 1_000).to_string());
                result.push_string("us");
            } else {
                result.push_string(nanos.to_string());
                result.push_string("ns");
            };
            return result.to_string();
        };

        // >= 1 second: use h/m/s with fractional seconds for sub-second part
        if secs >= 3600 then {
            result.push_string((secs / 3600).to_string());
            result.push_string("h");
            secs = secs % 3600;
        };

        if secs >= 60 then {
            result.push_string((secs / 60).to_string());
            result.push_string("m");
            secs = secs % 60;
        };

        // Seconds with optional fractional part
        if nanos > 0 then {
            result.push_string(secs.to_string());
            result.push_string(".");
            // Format nanos as 9-digit fractional, trim trailing zeros
            let nanos_str = nanos.to_string();
            let nanos_len = nanos_str.count();
            let mutable frac_builder = StringBuilder.new();
            let mutable i = nanos_len;
            while i < 9 then {
                frac_builder.push_byte('0');
                i += 1;
            };
            frac_builder.push_string(nanos_str);
            let mutable frac = frac_builder.to_string();
            // Trim trailing zeros
            let mutable end = frac.count();
            while end > 0 and frac[end - 1] == '0' then {
                end -= 1;
            };
            let frac_trimmed = frac.substring(0..<end);
            result.push_string(frac_trimmed);
            result.push_string("s");
        } else {
            result.push_string(secs.to_string());
            result.push_string("s");
        };

        return result.to_string();
    };
};
