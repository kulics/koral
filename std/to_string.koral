// ============================================================================
// Koral Standard Library - ToString Trait and Implementations
// ============================================================================
// NOTE: This file is merged into core.koral.
// ============================================================================

/// Types that can render themselves as a `String`.
public trait ToString {
    /// Return the display form of this value.
    to_string(self): String;
};

/// `ToString` for `String`: the string itself.
given String: ToString {

    /// Return the string unchanged.
    public to_string(self): String = self;
};

// ============================================================================
// Primitive ToString Implementations
// ============================================================================
/// `ToString` for `Bool`: the text `true` or `false`.
given Bool: ToString {

    /// Return `true` or `false`.
    public to_string(self): String = if self then "true" else "false";
};

/// `ToString` for `Int`: decimal text, with a leading `-` for negative values.
given Int: ToString {

    /// Return the decimal representation, with a leading `-` when negative.
    public to_string(self): String = {
        if self == 0 then {
            return "0";
        };

        // `Int.min_value()` has no positive counterpart in `Int`, so the
        // magnitude is taken through `UInt` -- `0 - n` overflows exactly there.
        let is_negative = self < 0;
        let mutable n: UInt = if is_negative then UInt(0 - (self + 1)) + 1
        else UInt(self);

        let buf = alloc_memory[UInt8](21);
        let mutable pos: UInt = 20;
        init_memory(buf + pos, 0);
        while n > 0 then {
            pos -= 1;
            init_memory(buf + pos, UInt8(n % 10) + 48);
            n = n / 10;
        };

        if is_negative then {
            pos -= 1;
            init_memory(buf + pos, '-');
        };

        let len = 20 - pos;
        if pos > 0 then {
            move_memory(buf, buf + pos, len + 1);
        };
        return String(buf, len);
    };
};

/// `ToString` for `Int8`: decimal text, with a leading `-` for negative values.
given Int8: ToString {

    /// Return the decimal representation, with a leading `-` when negative.
    public to_string(self): String = Int(self).to_string();
};

/// `ToString` for `Int16`: decimal text, with a leading `-` for negative values.
given Int16: ToString {

    /// Return the decimal representation, with a leading `-` when negative.
    public to_string(self): String = Int(self).to_string();
};

