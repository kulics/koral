// ============================================================================
// Koral Standard Library - ToString Trait and Implementations
// ============================================================================
// NOTE: This file is merged into core.koral.
// ============================================================================

public trait ToString {
    to_string(self) String;
};

given String as ToString {

    public to_string(self) String = self;
};

// ============================================================================
// Primitive ToString Implementations
// ============================================================================
given Bool as ToString {

    public to_string(self) String = if self then "true" else "false";
};

given Int as ToString {

    public to_string(self) String = {
        if self == 0 then {
            return "0";
        };

        let mutable n = self;
        let is_negative = n < 0;
        if is_negative then {
            n = 0 - n;
        };

        let buf = alloc_memory[UInt8](21);
        let mutable pos UInt = 20;
        init_memory(buf + pos, 0);
        while n > 0 then {
            pos -= 1;
            init_memory(buf + pos, (n % 10)(UInt8) + '0');
            n = n / 10;
        };

        if is_negative then {
            pos -= 1;
            init_memory(buf + pos, '-');
        };

        let len = 20 - pos;
        if pos > 0 then {
            move_memory(buf, buf + pos, len + 1);
        };
        return String(buf, len);
    };
};

given Int8 as ToString {

    public to_string(self) String = self(Int).to_string();
};

given Int16 as ToString {

    public to_string(self) String = self(Int).to_string();
};

given Int32 as ToString {

    public to_string(self) String = self(Int).to_string();
};

given Int64 as ToString {

    public to_string(self) String = self(Int).to_string();
};

given UInt as ToString {

    public to_string(self) String = {
        if self == 0 then {
            return "0";
        };

        let mutable n = self;
        let buf = alloc_memory[UInt8](21);
        let mutable pos UInt = 20;
        init_memory(buf + pos, 0);
        while n > 0 then {
            pos -= 1;
            init_memory(buf + pos, (n % 10)(UInt8) + '0');
            n = n / 10;
        };

        let len = 20 - pos;
        if pos > 0 then {
            move_memory(buf, buf + pos, len + 1);
        };
        return String(buf, len);
    };
};

given UInt8 as ToString {

    public to_string(self) String = self(UInt).to_string();
};

given UInt16 as ToString {

    public to_string(self) String = self(UInt).to_string();
};

given UInt32 as ToString {

    public to_string(self) String = self(UInt).to_string();
};

given UInt64 as ToString {

    public to_string(self) String = self(UInt).to_string();
};

given Float32 as ToString {

    public to_string(self) String = {
        let bits = self.to_bits();
        let exp = (bits >> 23) & 255;
        let mantissa = bits & 8388607;
        if exp == 255 then {
            if mantissa <> 0 then {
                return "NaN";
            };
            if (bits >> 31) == 1 then {
                return "-Inf";
            };
            return "Inf";
        };

        let is_negative = (bits >> 31) == 1;
        let mutable f = if is_negative then 0.0 - self(Float64) else self(Float64);

        let int_part = f(Int);
        let frac_part = f - int_part(Float64);

        let mutable result = StringBuilder.new();
        if is_negative then {
            result.push_byte('-');
        };

        result.push_string(int_part.to_string());
        result.push_byte('.');

        let mutable frac = frac_part;
        for _ in 0(Int)..<6(Int) then {
            frac = frac * 10.0;
            let d = frac(Int);
            result.push_byte(d(UInt8) + '0');
            frac = frac - d(Float64);
        };

        return result.to_string();
    };
};

given Float64 as ToString {

    public to_string(self) String = {
        let bits = self.to_bits();
        let exp = (bits >> 52) & 2047;
        let mantissa = bits & 4503599627370495;
        if exp == 2047 then {
            if mantissa <> 0 then {
                return "NaN";
            };
            if (bits >> 63) == 1 then {
                return "-Inf";
            };
            return "Inf";
        };

        let is_negative = (bits >> 63) == 1;
        let mutable f = if is_negative then 0.0 - self else self;

        let int_part = f(Int);
        let frac_part = f - int_part(Float64);

        let mutable result = StringBuilder.new();
        if is_negative then {
            result.push_byte('-');
        };

        result.push_string(int_part.to_string());
        result.push_byte('.');

        let mutable frac = frac_part;
        for _ in 0(Int)..<6(Int) then {
            frac = frac * 10.0;
            let d = frac(Int);
            result.push_byte(d(UInt8) + '0');
            frac = frac - d(Float64);
        };

        return result.to_string();
    };
};

// ============================================================================
// Collection and Option ToString Implementations
// ============================================================================
given[T ToString, U ToString] Pair[T, U] as ToString {

    public to_string(self) String = {
        let mutable result = StringBuilder.new();
        result.push_string("(");
        result.push_string(self.first.to_string());
        result.push_string(", ");
        result.push_string(self.second.to_string());
        result.push_string(")");
        return result.to_string();
    };
};

given[T ToString] Option[T] as ToString {

    public to_string(self) String = when self in {
        .Some(v) then {
            let mutable result = StringBuilder.new();
            result.push_string("Some(");
            result.push_string(v.to_string());
            result.push_string(")");
            yield result.to_string();
        },
        .None() then "None",
    };
};

given[T ToString] List[T] as ToString {

    public to_string(self) String = {
        let mutable result = StringBuilder.new();
        result.push_string("[");
        for i in 0..<self.count() then {
            if i > 0 then {
                result.push_string(", ");
            };
            result.push_string(self[i].to_string());
        };
        result.push_string("]");
        return result.to_string();
    };
};

given[T ToString] Iterator[T] {

    public join_to_string(self, seperator String) String = {
        let mutable result = StringBuilder.new();
        let mutable first = true;
        let mutable iter = self;
        while iter.next() is .Some(item) then {
            if not first then {
                result.push_string(seperator);
            };
            result.push_string(item.to_string());
            first = false;
        };
        return result.to_string();
    };
};

given[T ToString] List[T] {

    public join_to_string(self, seperator String) String = {
        let mutable result = StringBuilder.new();
        let mutable first = true;
        for item in self then {
            if not first then {
                result.push_string(seperator);
            };
            result.push_string(item.to_string());
            first = false;
        };
        return result.to_string();
    };
};

given[K ToString and Hash, V ToString] Dict[K, V] as ToString {

    public to_string(self) String = {
        let mutable result = StringBuilder.new();
        result.push_string("[");
        let mutable first = true;
        for entry in self then {
            if not first then {
                result.push_string(", ");
            };
            first = false;
            result.push_string(entry.first.to_string());
            result.push_string(": ");
            result.push_string(entry.second.to_string());
        };
        result.push_string("]");
        return result.to_string();
    };
};

given[T ToString and Hash] Set[T] as ToString {

    public to_string(self) String = {
        let mutable result = StringBuilder.new();
        result.push_string("[");
        let mutable first = true;
        for v in self then {
            if not first then {
                result.push_string(", ");
            };
            first = false;
            result.push_string(v.to_string());
        };
        result.push_string("]");
        return result.to_string();
    };
};

// ============================================================================
// Time ToString Implementations
// ============================================================================
given Duration as ToString {

    public to_string(self) String = {
        if self.secs == 0 and self.nanos == 0 then {
            return "0s";
        };
        let total_ns = self.as_nanoseconds();
        let is_neg = total_ns < 0;
        let abs_ns = if is_neg then 0 - total_ns else total_ns;
        let mutable secs = abs_ns / 1_000_000_000;
        let nanos = abs_ns % 1_000_000_000;
        let mutable result = StringBuilder.new();

        if is_neg then {
            result.push_string("-");
        };

        // Sub-second durations: show as ms, us, or ns
        if secs == 0 then {
            if nanos % 1_000_000 == 0 then {
                result.push_string((nanos / 1_000_000).to_string());
                result.push_string("ms");
            } else if nanos % 1_000 == 0 then {
                result.push_string((nanos / 1_000).to_string());
                result.push_string("us");
            } else {
                result.push_string(nanos.to_string());
                result.push_string("ns");
            };
            return result.to_string();
        };

        // >= 1 second: use h/m/s with fractional seconds for sub-second part
        if secs >= 3600 then {
            result.push_string((secs / 3600).to_string());
            result.push_string("h");
            secs = secs % 3600;
        };

        if secs >= 60 then {
            result.push_string((secs / 60).to_string());
            result.push_string("m");
            secs = secs % 60;
        };

        // Seconds with optional fractional part
        if nanos > 0 then {
            result.push_string(secs.to_string());
            result.push_string(".");
            // Format nanos as 9-digit fractional, trim trailing zeros
            let nanos_str = nanos.to_string();
            let nanos_len = nanos_str.count();
            let mutable frac_builder = StringBuilder.new();
            let mutable i = nanos_len;
            while i < 9 then {
                frac_builder.push_byte('0');
                i += 1;
            };
            frac_builder.push_string(nanos_str);
            let mutable frac = frac_builder.to_string();
            // Trim trailing zeros
            let mutable end = frac.count();
            while end > 0 and frac[end - 1] == '0' then {
                end -= 1;
            };
            let frac_trimmed = frac.substring(0..<end);
            result.push_string(frac_trimmed);
            result.push_string("s");
        } else {
            result.push_string(secs.to_string());
            result.push_string("s");
        };

        return result.to_string();
    };
};
