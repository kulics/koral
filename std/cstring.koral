// ============================================================================
// Koral Standard Library - CString (NUL-terminated C interop string)
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives, traits, and string
// are already available.
// ============================================================================

/// A NUL-terminated byte string for handing text to C APIs that take `char*`.
///
/// `String` promises no trailing NUL (its window may end anywhere in its
/// block), so crossing into C copies the content bytes into a fresh block
/// whose byte `[count()]` is 0. Rust `CString` shaped: the type is built only
/// from a `String` (one constructor, checked for interior NUL bytes), and it
/// converts back to `String` without a copy (`to_string` shares the block as
/// a window). The content is valid UTF-8 whenever it came from a `String`.
///
/// Implementation limit: like `String`, at most 2^31-1 content bytes.
///
/// `sendable` (safe): `Bytes` carries the construction-then-immutable promise
/// and the atomic RC for the shared block, `len` is a scalar -- so values
/// cross threads freely.
public type sendable CString(protected bytes: Block[UInt8], protected len: Int);

/// Construction from `String`, and the NUL-terminated accessors C needs.
given CString {

    /// Copy `value` into a NUL-terminated block. Returns an error when the
    /// string contains an interior NUL byte -- C would truncate there.
    public from_string(value: String): Result[CString] = unsafe {
        let len = value.count();
        let data = value.borrow_ptr();
        let mutable i = 0;
        while i < len then {
            if data[i] == UInt8(0) then {
                return Result[CString].Error(
                    "nul byte found in string at position \(i)",
                );
            };
            i += 1;
        };
        let s = alloc_bytes(UInt(len));
        if len > 0 then {
            copy_memory(s.elements(), data, UInt(len));
        };
        return Result[CString].Ok(CString(s, len));
    };

    /// Copy `value` into a NUL-terminated block without the interior-NUL
    /// check. Behavior is undefined when the string contains one (C sees a
    /// truncated value).
    /// 调用契约（`let unsafe`）：担保 `value` 无内嵌 NUL 字节。
    public unsafe from_string_unchecked(value: String): CString = unsafe {
        let len = value.count();
        let s = alloc_bytes(UInt(len));
        if len > 0 then {
            copy_memory(s.elements(), value.borrow_ptr(), UInt(len));
        };
        return CString(s, len);
    };

    /// Copy the NUL-terminated bytes at `cstr` into a fresh block. 字节保真：
    /// 内容可以是任意字节（`CString` 不声称 UTF-8）——C 字节串原样进、原样
    /// 出，不过 `String` 世界（那边恒合法 UTF-8）。`String` 侧指针构造器的
    /// 对称面。
    /// 调用契约（`let unsafe`）：担保 `cstr` 指向 NUL 结尾的可读字节串。
    public unsafe from_cstring_ptr_unchecked(cstr: *UInt8): CString = unsafe {
        let mutable len = 0;
        while cstr[len] != UInt8(0) then {
            len += 1;
        };
        let s = alloc_bytes(UInt(len));
        if len > 0 then {
            copy_memory(s.elements(), cstr, UInt(len));
        };
        return CString(s, len);
    };

    /// The content length in bytes, without the trailing NUL.
    public count(self): Int = self.len;
    /// Whether there are no content bytes (the block still holds the NUL).
    public is_empty(self): Bool = self.len == 0;

    /// Borrow the NUL-terminated bytes; `count() + 1` bytes are readable from
    /// the returned pointer and byte `[count()]` is 0. Valid while the value
    /// lives. This is the pointer to hand to C `char*` parameters.
    public borrow_ptr(self): *UInt8 = self.bytes.elements();

    /// 只读切片窗口（slice-design）：`[]UInt8`，零拷贝（写死块）。
    public as_slice(self): []UInt8 = {
        return Slice[UInt8](self.bytes, 0, self.len);
    };
};

/// `ToString` for `CString`: the content as a `String`, without a copy -- the
/// result is a window on this block (the NUL is not part of the content). Use
/// `clone` on the result to detach it from this block.
given CString: ToString {
    /// The content as a `String`, without a copy -- the result is a window on
    /// this block (the NUL is not part of the content).
    public to_string(self): String = String(self.bytes, UInt32(0), UInt32(self.len));
};
