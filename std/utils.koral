// ============================================================================
// Koral Standard Library - Utility Functions
// ============================================================================
// NOTE: This file is merged into core.koral, so all previous types are already available.
// ============================================================================

// ============================================================================
// Generic Utility Functions
// ============================================================================

/// A generic tuple-like pair holding a `first` and a `second` value.
public type Pair[T: Any, U: Any](public first: T, public second: U);

/// `Eq` for `Pair`: equal when both components are equal.
given[T: Eq, U: Eq] Pair[T, U]: Eq {

    /// Whether both components of the two pairs are equal.
    public equals(self, other: Pair[T, U]): Bool =
        self.first == other.first and self.second == other.second;
};

/// `Hash` for `Pair`: combines the hashes of both components.
given[T: Hash, U: Hash] Pair[T, U]: Hash {

    /// Hash both components and combine the results.
    public hash(self): UInt = self.first.hash().combine_hash(self.second.hash());
};

/// `Ord` for `Pair`: lexicographic, comparing `first` and then `second`.
given[T: Ord, U: Ord] Pair[T, U]: Ord {

    /// Compare `first`, then `second`, returning the first nonzero result.
    public compare(self, other: Pair[T, U]): Int = {
        let c = self.first.compare(other.first);
        if c != 0 then {
            return c;
        };
        return self.second.compare(other.second);
    };
};

/// Return the larger of `a` and `b`.
public let max[T: Ord](a: T, b: T): T = if a > b then a else b;
/// Return the smaller of `a` and `b`.
public let min[T: Ord](a: T, b: T): T = if a < b then a else b;

// ============================================================================
// Cell - shared mutable state
// ============================================================================
/// Closure capture is copy-only, so a `let mutable` local cannot be captured.
/// To carry mutable state into a closure, hold it in a `Cell` (a shared
/// `type mutable` object) and capture the cell.
public type mutable Cell[T: Any](public mutable value: T);

/// Reading and writing the value held by a `Cell`.
given[T: Any] Cell[T] {

    /// Return the current value.
    public get(self): T = self.value;

    /// Replace the held value.
    public set(self, value: T): Void = {
        self.value = value;
    };
};

/// Orderable values: the tool methods every `Ord` implementation inherits.
given Ord {

    /// Clamps self into the inclusive range [min, max].
    public clamp(self, min: Self =, max: Self =): Self = if self < min then min
    else if self > max then max else self;
};

// ============================================================================
// Runtime / Process FFI (migrated from std/io.koral)
// ============================================================================

type foreign CFile {};

let foreign fwrite(buf: *UInt8, size: UInt, count: UInt, file: *CFile): UInt;
let foreign fflush(file: *CFile): Void;
// libc's fgetc returns a 32-bit `int` (0..255, or EOF = -1); declaring the
// result `Int32` keeps the sign when the call crosses the FFI boundary.
let foreign fgetc(file: *CFile): Int32;
let foreign __koral_stdin(): *CFile;
let foreign __koral_stdout(): *CFile;
let foreign __koral_stderr(): *CFile;

/// Terminate the process with the given exit code.
public let foreign exit(code: Int): Never;
/// Terminate the process immediately.
public let foreign abort(): Never;

private let foreign __koral_set_args(argc: Int32, argv: **UInt8): Void;
private let foreign __koral_argc(): Int32;
private let foreign __koral_argv(): **UInt8;

let foreign __koral_errno_ptr(): *Int32;
let foreign __koral_strerror(errnum: Int32): *UInt8;

/// Get the last OS error (errno) as a human-readable String.
public let last_error_message(): String = {
    let err = *__koral_errno_ptr();
    let msg = __koral_strerror(err);
    return String.from_cstring_unchecked(msg);
};

/// Return the command-line arguments, starting with the program name.
public let args(): List[String] = {
    let mutable result: List[String] = [];
    let count = UInt(__koral_argc());
    for i in 0..<count then {
        let arg_ptr = __koral_argv()[i];
        result.push(String.from_cstring_unchecked(arg_ptr));
    };
    return result;
};

// ============================================================================
// Panic and Assertion
// ============================================================================

/// Print `Panic: ` and the message to standard error, then abort the process.
public let panic(message: String): Never = {
    let prefix = "Panic: ";
    fwrite(prefix.data, 1, prefix.len, __koral_stderr());
    fwrite(message.data, 1, message.len, __koral_stderr());
    let newline = "\n";
    fwrite(newline.data, 1, newline.len, __koral_stderr());
    fflush(__koral_stderr());
    abort();
};

/// Panic with `message` when `condition` is false.
public let assert(condition: Bool, message: String): Void = {
    if not condition then {
        panic(message);
    };
};

// ============================================================================
// Standard IO Functions
// ============================================================================

/// Write `value`'s text to standard output without a newline, then flush.
public let print[T: ToString](value: T): Void = {
    let s = value.to_string();
    fwrite(s.data, 1, s.len, __koral_stdout());
    fflush(__koral_stdout());
};

/// Write `value`'s text and a newline to standard output, then flush.
public let println[T: ToString](value: T): Void = {
    let s = value.to_string();
    fwrite(s.data, 1, s.len, __koral_stdout());
    let newline = "\n";
    fwrite(newline.data, 1, newline.len, __koral_stdout());
    fflush(__koral_stdout());
};

/// Write `value`'s text to standard error without a newline, then flush.
public let eprint[T: ToString](value: T): Void = {
    let s = value.to_string();
    fwrite(s.data, 1, s.len, __koral_stderr());
    fflush(__koral_stderr());
};

/// Write `value`'s text and a newline to standard error, then flush.
public let eprintln[T: ToString](value: T): Void = {
    let s = value.to_string();
    fwrite(s.data, 1, s.len, __koral_stderr());
    let newline = "\n";
    fwrite(newline.data, 1, newline.len, __koral_stderr());
    fflush(__koral_stderr());
};

/// Read one line from standard input without its line ending, returning `None`
/// at end of input; an empty line yields an empty string. The line ending is
/// `\n` or `\r\n` (a single trailing `\r` is dropped); any other `\r` is
/// content and kept.
public let scanln(): Option[String] = {
    let mutable result = StringBuilder.new();

    while true then {
        let ch = fgetc(__koral_stdin());

        // End of file: fgetc returns -1, which depending on how the FFI
        // boundary widens the 32-bit result can also surface as 0xFFFFFFFF.
        // Real byte values are always 0..255.
        if ch < 0 or ch > 255 then {
            if result.is_empty() then {
                return Option[String].None();
            };
            break;
        };

        if ch == 10 then {
            break;
        };

        result.push_byte(UInt8(ch));
    };

    let line = result.to_string();
    let len = line.count();
    if len > 0 and line[len - 1] == '\r' then {
        return Option[String].Some(line.substring(0..<(len - 1)));
    };
    return Option[String].Some(line);
};
