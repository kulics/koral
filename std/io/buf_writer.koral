using "std" { ... };
// ============================================================================
// std.io - BufWriter Type
// ============================================================================
// Generic buffered writer that wraps any Writer with an internal byte list.
// Uses compile-time static dispatch (generics, not trait objects).
// Write strategy: data goes into internal list; auto-flush when list is full.
// ============================================================================

/// Buffered writer that wraps any `Writer`, flushing its internal buffer when full.
public type mutable BufWriter[W: Writer](
    private inner: W,
    private mutable buf: List[UInt8],
    private cap: Int,
);

/// Creates `BufWriter` values and provides byte, string, line, and rune writes.
given[W: Writer] BufWriter[W] {

    // --- Static constructors ---

    /// Wrap `w` in a writer with a 4096-byte buffer.
    public new(w: W): BufWriter[W] =
        BufWriter[W](w, List[UInt8].with_capacity(4096), 4096);

    /// Wrap `w` in a writer with a `cap`-byte buffer, panicking when `cap` is zero or negative.
    public with_capacity(cap: Int, w: W): BufWriter[W] = {
        if cap < 0 then {
            panic("BufWriter with_capacity negative capacity");
        };
        if cap == 0 then {
            panic("BufWriter.with_capacity: zero capacity");
        };
        return BufWriter[W](w, List[UInt8].with_capacity(cap), cap);
    };

    // --- Instance methods ---

    /// Buffer one byte, flushing to the inner writer first when the buffer is full.
    public write_byte(self, b: UInt8): Result[Void] = {
        if self.buf.count() >= self.cap then {
            let flush_result = self.flush();
            when flush_result in {
                .Ok(_) then {},
                .Error(e) then {
                    return Result[Void].Error(e);
                },
            };
        };
        self.buf.push(b);
        return Result[Void].Ok({});
    };

    /// Buffer the UTF-8 bytes of `s`.
    public write_string(self, s: String): Result[Void] = {
        let bytes = s.to_bytes();
        let result = self.write(from = bytes, span = ...);
        when result in {
            .Ok(_) then {
                return Result[Void].Ok({});
            },
            .Error(e) then {
                return Result[Void].Error(e);
            },
        };
    };

    /// Buffer the UTF-8 bytes of `s` followed by a newline.
    public write_line(self, s: String): Result[Void] = {
        let result = self.write_string(s);
        when result in {
            .Ok(_) then {
                return self.write_byte(10);
            },
            .Error(e) then {
                return Result[Void].Error(e);
            },
        };
    };

    /// Buffer `r` as its UTF-8 encoding.
    public write_rune(self, r: Rune): Result[Void] = {
        let cp = r.to_uint32();
        // 1-byte ASCII
        if cp < 128 then {
            let wr = self.write_byte(UInt8(cp));
            when wr in {
                .Ok(_) then {
                    return Result[Void].Ok({});
                },
                .Error(e) then {
                    return Result[Void].Error(e);
                },
            };
        };
        // 2-byte
        if cp < 2048 then {
            let r1 = self.write_byte(UInt8((cp >> 6)) | 192);
            when r1 in {
                .Ok(_) then {},
                .Error(e) then {
                    return Result[Void].Error(e);
                },
            };
            let r2 = self.write_byte(UInt8((cp & 63)) | 128);
            when r2 in {
                .Ok(_) then {
                    return Result[Void].Ok({});
                },
                .Error(e) then {
                    return Result[Void].Error(e);
                },
            };
        };
        // 3-byte
        if cp < 65536 then {
            let r1 = self.write_byte(UInt8((cp >> 12)) | 224);
            when r1 in {
                .Ok(_) then {},
                .Error(e) then {
                    return Result[Void].Error(e);
                },
            };
            let r2 = self.write_byte(UInt8(((cp >> 6) & 63)) | 128);
            when r2 in {
                .Ok(_) then {},
                .Error(e) then {
                    return Result[Void].Error(e);
                },
            };
            let r3 = self.write_byte(UInt8((cp & 63)) | 128);
            when r3 in {
                .Ok(_) then {
                    return Result[Void].Ok({});
                },
                .Error(e) then {
                    return Result[Void].Error(e);
                },
            };
        };
        // 4-byte
        let r1 = self.write_byte(UInt8((cp >> 18)) | 240);
        when r1 in {
            .Ok(_) then {},
            .Error(e) then {
                return Result[Void].Error(e);
            },
        };
        let r2 = self.write_byte(UInt8(((cp >> 12) & 63)) | 128);
        when r2 in {
            .Ok(_) then {},
            .Error(e) then {
                return Result[Void].Error(e);
            },
        };
        let r3 = self.write_byte(UInt8(((cp >> 6) & 63)) | 128);
        when r3 in {
            .Ok(_) then {},
            .Error(e) then {
                return Result[Void].Error(e);
            },
        };
        let r4 = self.write_byte(UInt8((cp & 63)) | 128);
        when r4 in {
            .Ok(_) then {
                return Result[Void].Ok({});
            },
            .Error(e) then {
                return Result[Void].Error(e);
            },
        };
    };
};

/// Implements `Writer` through the internal buffer.
given[W: Writer] BufWriter[W]: Writer {

    /// Writes data from `from[span]` into the internal buffer, auto-flushing when full, and returns the count written.
    public write(self, from: List[UInt8] =, span: Range[Int] =): Result[Int] = {
        let span = from.slice_spec(span);
        let start = span.start();
        let end = span.end();
        let available = span.len();
        if available == 0 then {
            return Result[Int].Ok(0);
        };

        let remaining_cap = self.cap - self.buf.count();
        if available <= remaining_cap then {
            self.buf.push_list(from, span = start..<end);
            return Result[Int].Ok(available);
        };

        if self.buf.count() > 0 then {
            when self.flush() in {
                .Ok(_) then {},
                .Error(e) then {
                    return Result[Int].Error(e);
                },
            };
        };

        let new_remaining = self.cap - self.buf.count();
        if available <= new_remaining then {
            self.buf.push_list(from, span = start..<end);
            return Result[Int].Ok(available);
        };

        let direct_result = self.inner.write_all(from = from, span = start..<end);
        when direct_result in {
            .Ok(_) then {
                return Result[Int].Ok(available);
            },
            .Error(e) then {
                return Result[Int].Error(e);
            },
        };
    };

    /// Flushes internal buffer to inner writer. On partial failure, preserves remaining bytes.
    public flush(self): Result[Void] = {
        let total = self.buf.count();
        if total == 0 then {
            return Result[Void].Ok({});
        };

        let mutable start = 0;
        let mutable outcome: Result[Void] = Result[Void].Ok({});
        while start < total then {
            when self.inner.write(from = self.buf, span = start..<total) in {
                .Ok(n) then {
                    if n == 0 then {
                        outcome = Result[Void].Error(IoError.WriteZero());
                        break;
                    };
                    start += n;
                },
                .Error(e) then {
                    outcome = Result[Void].Error(e);
                    break;
                },
            };
        };

        // Preserve the not-yet-written suffix on every exit path (including
        // WriteZero), and empty the buffer once everything has been written.
        if start > 0 then {
            let remain = self.buf.sublist(start..<total);
            self.buf.clear();
            self.buf.push_list(remain);
        };
        return outcome;
    };
};

/// A dropped `BufWriter` flushes: buffered bytes land in the inner writer.
/// A flush failure at drop time is silent data loss with no caller left to
/// see it, so it panics with the cause instead of dropping the bytes.
given[W: Writer] BufWriter[W]: Drop {

    /// Flush the remaining buffer.
    drop(self): Void = {
        when self.flush() in {
            .Ok(_) then {},
            .Error(e) then {
                panic("BufWriter dropped with unflushed data: \(e.message())");
            },
        };
    };
};

/// Implements `Seeker`, flushing before moving the inner writer's cursor.
given[W: Writer and Seeker] BufWriter[W]: Seeker {

    /// Flush the internal buffer, then move the inner writer to `pos`.
    public seek(self, pos: SeekOrigin): Result[Int] = {
        when self.flush() in {
            .Ok(_) then {},
            .Error(e) then {
                return Result[Int].Error(e);
            },
        };
        return self.inner.seek(pos);
    };
};
