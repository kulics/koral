using "std" { ... };
// ============================================================================
// std.io - ByteBuffer Type
// ============================================================================
// In-memory file stream using raw byte buffer + single cursor.
// Implements Reader / Writer / Seeker behavior for byte I/O.
// ============================================================================

/// In-memory byte stream with a single cursor, supporting `Reader`, `Writer`, and `Seeker`.
public type mutable ByteBuffer(
    mutable data: *mutable UInt8,
    mutable len: UInt,
    mutable cap: UInt,
    mutable cursor: UInt,
);

/// Implements `Drop`, freeing the buffer's heap allocation.
given ByteBuffer: Drop {

    drop(self): Void = {
        dealloc_memory(self.data);
    };
};

/// Creates `ByteBuffer` values that are empty, pre-sized, or copied from a string or byte list.
given ByteBuffer {

    /// Create an empty byte buffer.
    public new(): ByteBuffer = {
        let data = alloc_memory[UInt8](1);
        return ByteBuffer(data, 0, 1, 0);
    };

    /// Create an empty byte buffer with room for at least `cap` bytes.
    public with_capacity(cap: UInt): ByteBuffer = {
        let actual_cap = if cap < 1 then UInt(1) else cap;
        let data = alloc_memory[UInt8](actual_cap);
        return ByteBuffer(data, 0, actual_cap, 0);
    };

    /// Create a byte buffer holding the UTF-8 bytes of `s`.
    public from_string(s: String): ByteBuffer = {
        return ByteBuffer.from_bytes(s.to_bytes());
    };

    /// Create a byte buffer holding a copy of `bytes`.
    public from_bytes(bytes: List[UInt8]): ByteBuffer = {
        let len = bytes.count();
        let cap = if len < 1 then UInt(1) else len;
        let data = alloc_memory[UInt8](cap);
        if len > 0 then {
            copy_memory(data, bytes.borrow_ptr(), len);
        };
        return ByteBuffer(data, len, cap, 0);
    };

    private ensure_capacity(self, min_capacity: UInt): Void = {
        if min_capacity <= self.cap then {
            return;
        };
        let mutable new_cap = self.cap * 2;
        if new_cap < min_capacity then {
            new_cap = min_capacity;
        };
        let new_data = alloc_memory[UInt8](new_cap);
        if self.len > 0 then {
            copy_memory(new_data, self.data, self.len);
        };
        dealloc_memory(self.data);
        self.data = new_data;
        self.cap = new_cap;
    };
};

/// Implements `Reader`, reading from the buffer's cursor.
given ByteBuffer: Reader {

    /// Read bytes at the cursor into `into[span]`, returning the count read and stopping at the end of the buffer.
    public read(self, into: List[UInt8] =, span: Range[UInt] =): Result[UInt] = {
        let span = into.slice_spec(span);
        let start = span.start();
        let end = span.end();
        if end <= start then {
            return Result[UInt].Ok(0);
        };

        let available = self.len - self.cursor;
        if available == 0 then {
            return Result[UInt].Ok(0);
        };

        let want = span.len();
        let n = if available < want then available else want;
        let dst_ptr = into.borrow_mut_ptr() + start;
        let src_ptr = self.data + self.cursor;
        copy_memory(dst_ptr, src_ptr, n);
        self.cursor += n;
        return Result[UInt].Ok(n);
    };
};

/// Implements `Writer`, writing at the buffer's cursor and growing the buffer as needed.
given ByteBuffer: Writer {

    /// Write bytes from `from[span]` at the cursor, returning the count written and growing the buffer past its end.
    public write(self, from: List[UInt8] =, span: Range[UInt] =): Result[UInt] = {
        let span = from.slice_spec(span);
        let start = span.start();
        let end = span.end();
        if end <= start then {
            return Result[UInt].Ok(0);
        };

        let n = span.len();
        let write_start = self.cursor;
        let write_end = write_start + n;
        let new_len = if write_end > self.len then write_end else self.len;
        self.ensure_capacity(new_len);
        copy_memory(self.data + write_start, from.borrow_ptr() + start, n);
        self.len = new_len;
        self.cursor = write_end;
        return Result[UInt].Ok(n);
    };

    /// Flush is a no-op here, since writes already land in the buffer.
    public flush(self): Result[Void] = Result[Void].Ok({});
};

/// Implements `Seeker`, moving the cursor within the buffer.
given ByteBuffer: Seeker {

    /// Move the cursor to `pos` and return its offset, failing for targets outside the buffer.
    /// Out-of-range targets — including offsets that overflow `Int64` arithmetic — fail
    /// with `Result.Error` and never panic.
    public seek(self, pos: SeekOrigin): Result[UInt64] = {
        let len64 = UInt64(self.len);
        let mutable target: UInt64 = 0;
        when pos in {
            .Start(offset) then {
                target = offset;
            },
            .Current(offset) then {
                let base = UInt64(self.cursor);
                if offset < 0 then {
                    let mag = UInt64(-(offset + 1)) + 1;
                    if mag > base then {
                        return Result[UInt64].Error(
                            IoError.Other("invalid seek to negative or out-of-range offset"),
                        );
                    };
                    target = base - mag;
                } else {
                    let add = UInt64(offset);
                    if add > len64 - base then {
                        return Result[UInt64].Error(
                            IoError.Other("invalid seek to negative or out-of-range offset"),
                        );
                    };
                    target = base + add;
                };
            },
            .End(offset) then {
                if offset < 0 then {
                    let mag = UInt64(-(offset + 1)) + 1;
                    if mag > len64 then {
                        return Result[UInt64].Error(
                            IoError.Other("invalid seek to negative or out-of-range offset"),
                        );
                    };
                    target = len64 - mag;
                } else {
                    let add = UInt64(offset);
                    if add > 0 then {
                        return Result[UInt64].Error(
                            IoError.Other("invalid seek to negative or out-of-range offset"),
                        );
                    };
                    target = len64;
                };
            },
        };

        if target > len64 then {
            return Result[UInt64].Error(
                IoError.Other("invalid seek to negative or out-of-range offset"),
            );
        };

        self.cursor = UInt(target);
        return Result[UInt64].Ok(target);
    };
};
