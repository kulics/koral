using "std" { ... };
// ============================================================================
// std.io - SeekOrigin Enum
// ============================================================================
// Seek origin enum for use with the Seeker trait.
// Specifies the reference point and offset for seek operations.
// ============================================================================

/// The reference point and offset for a seek: from the start, the current position, or the end, where `Current` and `End` offsets may be negative.
public type sendable SeekOrigin {
    Start(offset: Int),
    End(offset: Int),
    Current(offset: Int),
};
