using std { .. }
// ============================================================================
// std.io - IO Traits
// ============================================================================
// Core IO trait definitions: Reader, Writer, Seeker, ReadWriter.
// Reader/Writer use UInt8 list + range as the canonical bytes API.
// ============================================================================

public trait Reader {
    read(*self, into *mutable List[UInt8], range Range[UInt]) Result[UInt]
}

public trait Writer {
    write(*self, from List[UInt8], range Range[UInt]) Result[UInt]
    flush(*self) Result[Void]
}

public trait Seeker {
    seek(*self, pos SeekOrigin) Result[UInt64]
}
