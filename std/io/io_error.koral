using "std" { ... };
// ============================================================================
// std.io - IoError Type
// ============================================================================
// Unified IO error type for all IO operations.
// Implements the Error trait for use with Result.
// ============================================================================

/// IO failure: `InvalidUtf8` for bad UTF-8, `WriteZero` for an empty write, or `Other` with a detail message.
public type IoError {
    InvalidUtf8(),
    WriteZero(),
    Other(detail: String),
};

/// Implements `Error`, giving each case a human-readable message.
given IoError: Error {

    /// Return the human-readable description of this failure.
    public message(self): String = when self in {
        .InvalidUtf8() then "invalid UTF-8 sequence",
        .WriteZero() then "write returned zero bytes",
        .Other(s) then s,
    };
};
