// ============================================================================
// Koral Standard Library - Dict Type
// ============================================================================
// NOTE: This file is merged into core.koral, so all previous types are already available.
// ============================================================================

// ============================================================================
// Dict Type Definition
// ============================================================================
// DictBucket uses a struct+tag layout (not enum) so that key/value fields are
// directly addressable by pointer — enabling */*subscript helpers.
// Only Occupied buckets have initialized key/value. Empty and Deleted buckets
// have raw (uninitialized) key/value memory; only the tag is valid.
module_private type DictBucket[K Hash, V Any](
    tag UInt,
    key K,
    value V,
);

// Bucket tag constants (inlined as 0(UInt), 1(UInt), 2(UInt))

file_private let bucket_tag_ptr[K Hash, V Any](bucket_ptr *unsafe mutable DictBucket[K, V]) *unsafe mutable UInt =
    bucket_ptr(UInt)(*unsafe mutable UInt);

file_private let bucket_set_tag[K Hash, V Any](bucket_ptr *unsafe mutable DictBucket[K, V], tag UInt) Void = {
    let tag_ptr = bucket_tag_ptr(bucket_ptr);
    *tag_ptr = tag;
};

public type mutable Dict[K Hash, V Any](module_private mutable buckets *unsafe mutable DictBucket[K, V], module_private mutable size UInt, module_private mutable capacity UInt);

given[K Hash, V Any] Dict[K, V] as Drop {

    drop(self) Void = {
        for i in 0..<self.capacity then {
            if (self.buckets + i).tag == 1(UInt) then {
                deinit_memory(self.buckets + i);
            };
        };
        dealloc_memory(self.buckets);
    };
};

public type mutable DictIterator[K Hash, V Any](module_private source Dict[K, V], module_private mutable index UInt);

// ============================================================================
// Dict Methods
// ============================================================================
given[K Hash, V Any] Dict[K, V] {

    public new() Self = {
        let capacity UInt = 16;
        let buckets = alloc_memory[DictBucket[K, V]](capacity);
        for i in 0..<capacity then {
            bucket_set_tag(buckets + i, 0(UInt));
        };
        return Dict[K, V](buckets, 0, capacity);
    };

    public with_capacity(capacity UInt) Self = {
        // Hash tables need extra space for efficiency (load factor ~0.5)
        let cap = if capacity < 4 then 4 else capacity * 2;
        let buckets = alloc_memory[DictBucket[K, V]](cap);
        for i in 0..<cap then {
            bucket_set_tag(buckets + i, 0(UInt));
        };
        return Dict[K, V](buckets, 0, cap);
    };

    public count(self) UInt = self.size;

    // Using when for bucket handling
    file_private find_slot(self, key K) Option[UInt] = {
        let h = key.hash();
        let mutable idx = h % self.capacity;
        let mutable first_deleted = Option[UInt].None();
        let mutable probes UInt = 0;
        while probes < self.capacity then {
            let bucket_tag = (self.buckets + idx).tag;
            if bucket_tag == 0(UInt) then {
                when first_deleted in {
                    .Some(_) then {
                        return first_deleted;
                    },
                    .None() then {
                        return Option[UInt].Some(idx);
                    },
                };
            } else if bucket_tag == 2(UInt) then {
                when first_deleted in {
                    .None() then {
                        first_deleted = Option[UInt].Some(idx);
                    },
                    _ then {},
                };
            } else {
                // Occupied
                if (self.buckets + idx).key == key then {
                    return Option[UInt].Some(idx);
                };
            };
            idx = (idx + 1) % self.capacity;
            probes += 1;
        };
        return first_deleted;
    };

    file_private rehash(self) Void = {
        let old_cap = self.capacity;
        let old_buckets = self.buckets;
        let new_cap = old_cap * 2(UInt);
        let new_buckets = alloc_memory[DictBucket[K, V]](new_cap);
        for i in 0..<new_cap then {
            bucket_set_tag(new_buckets + i, 0(UInt));
        };
        self.buckets = new_buckets;
        self.capacity = new_cap;
        self.size = 0;
        for i in 0..<old_cap then {
            let old_tag = (old_buckets + i).tag;
            if old_tag == 1(UInt) then {
                let moved = take_memory(old_buckets + i);
                self.insert_internal(moved.key, moved.value);
            } else if old_tag == 2(UInt) then {
                // Drop the key/value that were stored in this deleted bucket
                deinit_memory(old_buckets + i);
            };
        };
        dealloc_memory(old_buckets);
    };

    // Internal insert used by rehash - doesn't return old value
    file_private insert_internal(self, key K, value V) Void = {
        when self.find_slot(key) in {
            .None() then {
                panic("Dict insert failed");
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                let was_occupied = bucket_ptr.tag == 1(UInt);
                if was_occupied then {
                    deinit_memory(bucket_ptr);
                };
                init_memory(bucket_ptr, DictBucket[K, V](1(UInt), key, value));
                if not was_occupied then {
                    self.size = self.size + 1;
                };
            },
        };
    };

    public insert(self, key K, value V) Void = {
        if self.size * 2 >= self.capacity then {
            self.rehash();
        };
        when self.find_slot(key) in {
            .None() then {
                panic("Dict insert failed");
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                let was_occupied = bucket_ptr.tag == 1(UInt);
                if was_occupied then {
                    deinit_memory(bucket_ptr);
                };
                init_memory(bucket_ptr, DictBucket[K, V](1(UInt), key, value));
                if not was_occupied then {
                    self.size = self.size + 1;
                };
            },
        };
    };

    public try_insert(self, key K, value V) Bool = {
        if self.size * 2 >= self.capacity then {
            self.rehash();
        };
        when self.find_slot(key) in {
            .None() then {
                panic("Dict try_insert failed");
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                if bucket_ptr.tag == 1(UInt) then {
                    return false;
                } else {
                    init_memory(bucket_ptr, DictBucket[K, V](1(UInt), key, value));
                    self.size = self.size + 1;
                    return true;
                };
            },
        };
    };

    public insert_dict(self, other Dict[K, V]) Void = {
        for entry in other then {
            self.insert(entry.first, entry.second);
        };
    };

    public get(self, key K) Option[V] = {
        when self.find_slot(key) in {
            .None() then {
                return Option[V].None();
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                if bucket_ptr.tag == 1(UInt) then {
                    return Option[V].Some(bucket_ptr.value);
                } else {
                    return Option[V].None();
                };
            },
        };
    };

    public get_or_insert(self, key K, value V) V = {
        when self.get(key) in {
            .Some(v) then {
                return v;
            },
            .None() then {
                self.insert(key, value);
                return value;
            },
        };
    };

    public contains_key(self, key K) Bool = when self.get(key) in {
        .Some(_) then true,
        .None() then false,
    };

    public remove(self, key K) Void = {
        let _ = self.take(key);
    };

    public try_remove(self, key K) Bool = when self.take(key) in {
        .Some(_) then true,
        .None() then false,
    };

    public take(self, key K) Option[V] = {
        when self.find_slot(key) in {
            .None() then {
                return Option[V].None();
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                if bucket_ptr.tag == 1(UInt) then {
                    let v = bucket_ptr.value;
                    deinit_memory(bucket_ptr);
                    bucket_set_tag(bucket_ptr, 2(UInt));
                    self.size = self.size - 1;
                    return Option[V].Some(v);
                } else {
                    return Option[V].None();
                };
            },
        };
    };

    public is_empty(self) Bool = self.size == 0;

    public clear(self) Void = {
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == 1(UInt) then {
                deinit_memory(bucket_ptr);
            };
            bucket_set_tag(bucket_ptr, 0(UInt));
        };
        self.size = 0;
    };

    // Retains only entries satisfying the predicate. O(n).
    public retain(self, predicate Func(K, V) Bool) Void = {
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == 1(UInt) then {
                if not predicate(bucket_ptr.key, bucket_ptr.value) then {
                    deinit_memory(bucket_ptr);
                    bucket_set_tag(bucket_ptr, 2(UInt));
                    self.size = self.size - 1;
                };
            };
        };
    };

    // Builtin subscript helpers for d[key] syntax
    file_private __index_get(self, key K) V = {
        when self.get(key) in {
            .Some(v) then { return v;},
            .None() then { panic("Dict key not found");},
        };
    };

    file_private __index_set(self, key K, value V) Void = {
        when self.get(key) in {
            .None() then { panic("Dict key not found");},
            .Some(_) then {},
        };
        let final_idx = when self.find_slot(key) in {
            .None() then { panic("Dict key not found");},
            .Some(i) then i,
        };
        let bucket_ptr = self.buckets + final_idx;
        deinit_memory(bucket_ptr);
        init_memory(bucket_ptr, DictBucket[K, V](1(UInt), key, value));
    };

};

given[K Hash, V Any] Dict[K, V] as Clone {

    // Independent shallow copy: new dict identity, keys/values copied one level.
    public clone(self) Self = {
        let mutable result = Dict[K, V].with_capacity(self.size);
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == 1(UInt) then {
                result.insert(bucket_ptr.key, bucket_ptr.value);
            };
        };
        return result;
    };
};

given[K Hash, V Any] Dict[K, V] as Default {

    public default() Self = Dict[K, V].new();
};

// ============================================================================
// Dict Iterator
// ============================================================================
given[K Hash, V Any] DictIterator[K, V] as Iterator[Pair[K, V]] {

    public next(self) Option[Pair[K, V]] = {
        while self.index < self.source.capacity then {
            let bucket_ptr = self.source.buckets + self.index;
            self.index = self.index + 1;
            if bucket_ptr.tag == 1(UInt) then {
                return Option[Pair[K, V]].Some(Pair[K, V](bucket_ptr.key, bucket_ptr.value));
            };
        };
        return Option[Pair[K, V]].None();
    };
};

// ============================================================================
// Dict Keys and Values Types with Iterators
// ============================================================================

// DictKeysIterator - iterates over keys only
public type mutable DictKeysIterator[K Hash, V Any](
    module_private source Dict[K, V],
    module_private mutable index UInt,
);

given[K Hash, V Any] DictKeysIterator[K, V] as Iterator[K] {

    public next(self) Option[K] = {
        while self.index < self.source.capacity then {
            let bucket_ptr = self.source.buckets + self.index;
            self.index = self.index + 1;
            if bucket_ptr.tag == 1(UInt) then {
                return Option[K].Some(bucket_ptr.key);
            };
        };
        return Option[K].None();
    };
};

// DictValuesIterator - iterates over values only
public type mutable DictValuesIterator[K Hash, V Any](
    module_private source Dict[K, V],
    module_private mutable index UInt,
);

given[K Hash, V Any] DictValuesIterator[K, V] as Iterator[V] {

    public next(self) Option[V] = {
        while self.index < self.source.capacity then {
            let bucket_ptr = self.source.buckets + self.index;
            self.index = self.index + 1;
            if bucket_ptr.tag == 1(UInt) then {
                return Option[V].Some(bucket_ptr.value);
            };
        };
        return Option[V].None();
    };
};

// Add keys() and values() methods to Dict
given[K Hash, V Any] Dict[K, V] {

    public keys(self) DictKeysIterator[K, V] = DictKeysIterator[K, V](self, 0);
    public values(self) DictValuesIterator[K, V] = DictValuesIterator[K, V](self, 0);
};

given[K Hash, V Any] Dict[K, V] as Iterable[Pair[K, V], DictIterator[K, V]] {

    public iterator(self) DictIterator[K, V] = DictIterator[K, V](self, 0);
};

given[T Any] List[T] {

    public group_by[K Hash](self, key Func(T) K) Dict[K, List[T]] = {
        let mutable groups = Dict[K, List[T]].new();
        for i in 0..<self.count() then {
            let value = self[i];
            let k = key(value);

            when groups.get(k) in {
                .Some(existing) then {
                    let mutable bucket = existing;
                    bucket.push(value);
                    groups.insert(k, bucket);
                },
                .None() then {
                    let mutable bucket = List[T].new();
                    bucket.push(value);
                    groups.insert(k, bucket);
                },
            };
        };

        return groups;
    };
};
