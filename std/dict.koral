// ============================================================================
// Koral Standard Library - Dict Type
// ============================================================================
// NOTE: This file is merged into core.koral, so all previous types are already available.
// ============================================================================

// ============================================================================
// Dict Type Definition
// ============================================================================
// `Dict` stores its entries in `HashBucket` buckets from std/hash_lookup.koral
// (the shared probing/lookup module): a struct+tag layout whose key/value
// fields are directly addressable by pointer — enabling */*subscript helpers.
// Only Occupied buckets have initialized key/value. Empty and Deleted buckets
// have raw (uninitialized) key/value memory; only the tag is valid.

/// A hash map from `Hash` keys to values; iteration order is unspecified.
/// `deleted` counts tombstone (Deleted-tagged) buckets so the table can detect
/// when they dominate and rebuild; it is not part of the public API surface.
public type mutable Dict[K: Hash, V: Any](
    mutable buckets: *mutable HashBucket[K, V],
    mutable size: UInt,
    mutable capacity: UInt,
    mutable deleted: UInt,
);

/// `Drop` for `Dict[K, V]`: releases the bucket array.
given[K: Hash, V: Any] Dict[K, V]: Drop {

    drop(self): Void = {
        for i in 0..<self.capacity then {
            if (self.buckets + i).tag == UInt(1) then {
                deinit_memory(self.buckets + i);
            };
        };
        dealloc_memory(self.buckets);
    };
};

/// Iterator over a `Dict`'s key/value pairs, in unspecified order.
public type mutable DictIterator[K: Hash, V: Any](
    source: Dict[K, V],
    mutable index: UInt,
);

// ============================================================================
// Dict Methods
// ============================================================================
/// Building, querying, and mutating a dictionary.
given[K: Hash, V: Any] Dict[K, V] {

    /// 空表不分配桶数组，首次 insert（走 rehash）时再分配。
    /// 编译器里每个 `Scope` 都带一张 `Dict[String, Type]`，大量是空的或只有一两项，
    /// 为它们每次付 16 桶 alloc + 16 次清零不值得。
    public new(): Self = {
        return Dict[K, V](null, 0, 0, 0);
    };

    /// Create an empty dict with its buckets allocated up front, sized for about
    /// `capacity` entries.
    public with_capacity(capacity: UInt): Self = {
        // Hash tables need extra space for efficiency (load factor ~0.5).
        // 桶数规约成 2 的幂，这样 find_slot 能用掩码代替取模（取模是整数除法）。
        let requested: UInt = if capacity < UInt(4) then UInt(4) else capacity * UInt(2);
        let mutable cap: UInt = UInt(4);
        while cap < requested then {
            cap = cap * UInt(2);
        };
        let buckets = alloc_memory[HashBucket[K, V]](cap);
        for i in 0..<cap then {
            bucket_set_tag(buckets + i, UInt(0));
        };
        return Dict[K, V](buckets, 0, cap, 0);
    };

    /// Return the number of entries in the dict.
    public count(self): UInt = self.size;

    // The shared probe from std/hash_lookup.koral (the one probing algorithm
    // this container shares with Set/FrozenDict/FrozenSet).
    private find_slot(self, key: K): Option[UInt] =
        find_hash_slot(self.buckets, self.capacity, key);

    private rehash(self): Void = {
        let old_cap = self.capacity;
        let old_buckets = self.buckets;
        // 新容量只由存活条目决定（tombstone 不带进新表）：
        // 负载保持 ≤ 0.5（size * 2 < new_cap），空表首次分配 16 桶；
        // tombstone 主导触发时借此缩回合适容量（hashbrown 的 rebuild 规则）。
        let mutable new_cap = UInt(16);
        while self.size * 2 >= new_cap then {
            new_cap = new_cap * UInt(2);
        };
        let new_buckets = alloc_memory[HashBucket[K, V]](new_cap);
        for i in 0..<new_cap then {
            bucket_set_tag(new_buckets + i, UInt(0));
        };
        self.buckets = new_buckets;
        self.capacity = new_cap;
        self.size = 0;
        self.deleted = 0;
        for i in 0..<old_cap then {
            let old_tag = (old_buckets + i).tag;
            if old_tag == UInt(1) then {
                let moved = take_memory(old_buckets + i);
                self.insert_internal(moved.key, moved.value);
            } else if old_tag == UInt(2) then {
                // 已删除桶的 key/value 在 take 标记删除前已由 deinit_memory
                // 释放；槽里的陈旧位绝不能再 drop 一次（双释放）。
            };
        };
        dealloc_memory(old_buckets);
    };

    // Internal insert used by rehash - doesn't return old value
    private insert_internal(self, key: K, value: V): Void = {
        when self.find_slot(key) in {
            .None() then {
                panic("Dict insert failed");
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                let was_occupied = bucket_ptr.tag == UInt(1);
                if was_occupied then {
                    deinit_memory(bucket_ptr);
                };
                init_memory(bucket_ptr, HashBucket[K, V](UInt(1), key, value));
                if not was_occupied then {
                    self.size = self.size + 1;
                };
            },
        };
    };

    /// Store `value` under `key`, replacing any entry already stored there.
    public insert(self, key: K, value: V): Void = {
        // 两个触发条件：存活负载满了要扩容；tombstone 过半要重建（缩回
        // 合适容量并清掉陈旧槽），否则删插交替会把表填满 Deleted 标签，
        // 每次查找退化成全表探测且永不再 rehash。
        if self.size * 2 >= self.capacity or self.deleted * 2 > self.capacity then {
            self.rehash();
        };
        when self.find_slot(key) in {
            .None() then {
                panic("Dict insert failed");
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                let old_tag = bucket_ptr.tag;
                let was_occupied = old_tag == UInt(1);
                if was_occupied then {
                    deinit_memory(bucket_ptr);
                };
                init_memory(bucket_ptr, HashBucket[K, V](UInt(1), key, value));
                if old_tag == UInt(2) then {
                    // 复用了一个 tombstone 槽：陈旧桶少一个。
                    self.deleted = self.deleted - 1;
                };
                if not was_occupied then {
                    self.size = self.size + 1;
                };
            },
        };
    };

    /// Store `value` under `key` only if the key is absent; return whether it
    /// was inserted.
    public try_insert(self, key: K, value: V): Bool = {
        if self.size * 2 >= self.capacity or self.deleted * 2 > self.capacity then {
            self.rehash();
        };
        when self.find_slot(key) in {
            .None() then {
                panic("Dict try_insert failed");
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                if bucket_ptr.tag == UInt(1) then {
                    return false;
                } else {
                    if bucket_ptr.tag == UInt(2) then {
                        // 复用了一个 tombstone 槽：陈旧桶少一个。
                        self.deleted = self.deleted - 1;
                    };
                    init_memory(bucket_ptr, HashBucket[K, V](UInt(1), key, value));
                    self.size = self.size + 1;
                    return true;
                };
            },
        };
    };

    /// Insert every entry of `other`, overwriting values whose keys already exist.
    public insert_dict(self, other: Dict[K, V]): Void = {
        for entry in other then {
            self.insert(entry.first, entry.second);
        };
    };

    /// Return the value stored under `key`, or `None` if the key is absent.
    public get(self, key: K): Option[V] = {
        when self.find_slot(key) in {
            .None() then {
                return Option[V].None();
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                if bucket_ptr.tag == UInt(1) then {
                    return Option[V].Some(bucket_ptr.value);
                } else {
                    return Option[V].None();
                };
            },
        };
    };

    /// Return the value stored under `key`, or insert and return `value` when
    /// the key is absent.
    public get_or_insert(self, key: K, value: V): V = {
        when self.get(key) in {
            .Some(v) then {
                return v;
            },
            .None() then {
                self.insert(key, value);
                return value;
            },
        };
    };

    /// Return whether `key` has a stored value.
    public contains_key(self, key: K): Bool = when self.get(key) in {
        .Some(_) then true,
        .None() then false,
    };

    /// Remove `key`'s entry if present, discarding its value.
    public remove(self, key: K): Void = {
        let _ = self.take(key);
    };

    /// Remove `key`'s entry if present; return whether one was removed.
    public try_remove(self, key: K): Bool = when self.take(key) in {
        .Some(_) then true,
        .None() then false,
    };

    /// Remove `key`'s entry and return its value, or `None` if the key is absent.
    public take(self, key: K): Option[V] = {
        when self.find_slot(key) in {
            .None() then {
                return Option[V].None();
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                if bucket_ptr.tag == UInt(1) then {
                    let v = bucket_ptr.value;
                    deinit_memory(bucket_ptr);
                    bucket_set_tag(bucket_ptr, UInt(2));
                    self.size = self.size - 1;
                    self.deleted = self.deleted + 1;
                    return Option[V].Some(v);
                } else {
                    return Option[V].None();
                };
            },
        };
    };

    /// Return whether the dict has no entries.
    public is_empty(self): Bool = self.size == 0;

    /// Remove every entry from the dict.
    public clear(self): Void = {
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == UInt(1) then {
                deinit_memory(bucket_ptr);
            };
            bucket_set_tag(bucket_ptr, UInt(0));
        };
        self.size = 0;
        self.deleted = 0;
    };

    /// Keep only the entries whose key and value satisfy `predicate`; O(n) time.
    public retain(self, predicate: (K, V) -> Bool): Void = {
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == UInt(1) then {
                if not predicate(bucket_ptr.key, bucket_ptr.value) then {
                    deinit_memory(bucket_ptr);
                    bucket_set_tag(bucket_ptr, UInt(2));
                    self.size = self.size - 1;
                    self.deleted = self.deleted + 1;
                };
            };
        };
    };

    // Builtin subscript helpers for d[key] syntax
    private __index_get(self, key: K): V = {
        when self.get(key) in {
            .Some(v) then {
                return v;
            },
            .None() then {
                panic("Dict key not found");
            },
        };
    };

    private __index_set(self, key: K, value: V): Void = {
        when self.get(key) in {
            .None() then {
                panic("Dict key not found");
            },
            .Some(_) then {},
        };
        let final_idx = when self.find_slot(key) in {
            .None() then {
                panic("Dict key not found");
            },
            .Some(i) then i,
        };
        let bucket_ptr = self.buckets + final_idx;
        deinit_memory(bucket_ptr);
        init_memory(bucket_ptr, HashBucket[K, V](UInt(1), key, value));
    };

    /// 内置下标 `d[key]` 的内部操作：返回桶内 value 字段的槽位指针。读写
    /// 直接作用于槽位；缺失键 panic 与 `__index_get` 一致。
    private __index_slot(self, key: K): *mutable V = {
        let final_idx = when self.find_slot(key) in {
            .None() then {
                panic("Dict key not found");
            },
            .Some(i) then i,
        };
        let bucket_ptr = self.buckets + final_idx;
        return (&bucket_ptr.value) as *mutable V;
    };
};

/// `Clone` for `Dict[K, V]`: an independent shallow copy.
given[K: Hash, V: Any] Dict[K, V]: Clone {

    /// Copy the dict into a fresh identity, copying keys and values one level.
    public clone(self): Self = {
        let mutable result = Dict[K, V].with_capacity(self.size);
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == UInt(1) then {
                result.insert(bucket_ptr.key, bucket_ptr.value);
            };
        };
        return result;
    };
};

/// `Default` for `Dict[K, V]`: an empty dict.
given[K: Hash, V: Any] Dict[K, V]: Default {

    /// Return an empty dict.
    public default(): Self = Dict[K, V].new();
};

// ============================================================================
// Dict Iterator
// ============================================================================
/// `Iterator` for `DictIterator[K, V]`: yields key/value pairs in unspecified order.
given[K: Hash, V: Any] DictIterator[K, V]: Iterator[Pair[K, V]] {

    /// Yield the next key/value pair, or `None` after the last entry.
    public next(self): Option[Pair[K, V]] = {
        while self.index < self.source.capacity then {
            let bucket_ptr = self.source.buckets + self.index;
            self.index = self.index + 1;
            if bucket_ptr.tag == UInt(1) then {
                return Option[Pair[K, V]].Some(
                    Pair[K, V](bucket_ptr.key, bucket_ptr.value),
                );
            };
        };
        return Option[Pair[K, V]].None();
    };
};

// ============================================================================
// Dict Keys and Values Types with Iterators
// ============================================================================

/// Iterator over just the keys of a `Dict`, in unspecified order.
public type mutable DictKeysIterator[K: Hash, V: Any](
    source: Dict[K, V],
    mutable index: UInt,
);

/// `Iterator` for `DictKeysIterator[K, V]`: yields the keys in unspecified order.
given[K: Hash, V: Any] DictKeysIterator[K, V]: Iterator[K] {

    /// Yield the next key, or `None` after the last entry.
    public next(self): Option[K] = {
        while self.index < self.source.capacity then {
            let bucket_ptr = self.source.buckets + self.index;
            self.index = self.index + 1;
            if bucket_ptr.tag == UInt(1) then {
                return Option[K].Some(bucket_ptr.key);
            };
        };
        return Option[K].None();
    };
};

/// Iterator over just the values of a `Dict`, in unspecified order.
public type mutable DictValuesIterator[K: Hash, V: Any](
    source: Dict[K, V],
    mutable index: UInt,
);

/// `Iterator` for `DictValuesIterator[K, V]`: yields the values in unspecified order.
given[K: Hash, V: Any] DictValuesIterator[K, V]: Iterator[V] {

    /// Yield the next value, or `None` after the last entry.
    public next(self): Option[V] = {
        while self.index < self.source.capacity then {
            let bucket_ptr = self.source.buckets + self.index;
            self.index = self.index + 1;
            if bucket_ptr.tag == UInt(1) then {
                return Option[V].Some(bucket_ptr.value);
            };
        };
        return Option[V].None();
    };
};

/// Key-only and value-only iterator constructors.
given[K: Hash, V: Any] Dict[K, V] {

    /// Return an iterator over the dict's keys, in unspecified order.
    public keys(self): DictKeysIterator[K, V] = DictKeysIterator[K, V](self, 0);
    /// Return an iterator over the dict's values, in unspecified order.
    public values(self): DictValuesIterator[K, V] = DictValuesIterator[K, V](self, 0);
};

/// `Iterable` for `Dict[K, V]`: iterates key/value pairs in unspecified order.
given[K: Hash, V: Any] Dict[K, V]: Iterable[Pair[K, V], DictIterator[K, V]] {

    /// Return an iterator over the dict's key/value pairs.
    public iterator(self): DictIterator[K, V] = DictIterator[K, V](self, 0);
};

/// Grouping a list into a dictionary.
given[T: Any] List[T] {

    /// Group the elements by `key`, keeping each group's elements in encounter
    /// order.
    public group_by[K: Hash](self, key: (T) -> K): Dict[K, List[T]] = {
        let mutable groups = Dict[K, List[T]].new();
        for i in 0..<self.count() then {
            let value = self[i];
            let k = key(value);

            when groups.get(k) in {
                .Some(existing) then {
                    // `existing` is the shared handle already stored in `groups`;
                    // push into it in place rather than handing the same handle back.
                    let mutable bucket = existing;
                    bucket.push(value);
                },
                .None() then {
                    let mutable bucket = List[T].new();
                    bucket.push(value);
                    groups.insert(k, bucket);
                },
            };
        };

        return groups;
    };
};

// ============================================================================
// FrozenDict - immutable snapshot for cross-thread transfer
// ============================================================================
/// An immutable key/value snapshot that may cross threads. Built by
/// `Dict.to_frozen_dict`, which bulk-copies straight into this storage (no
/// intermediate container), or by a dict literal targeting the type. The
/// snapshot is never mutated afterwards (the construction-then-immutable
/// promise backing `unsafe sendable`); the conditional rule still applies to
/// `K` and `V`.
///
/// Storage is standalone — it does not embed `Dict`: a hash table of
/// `HashBucket[K, V]` in the mutable `Dict` layout (compacted without
/// tombstones when copied, or taken over verbatim by `Dict.into_frozen_dict`).
/// Probing is the shared algorithm from std/hash_lookup.koral. The `mutable`
/// form is where the owned buffer's destructor lives; the snapshot is
/// immutable after construction.
public type unsafe sendable mutable FrozenDict[K: Hash, V: Any](
    protected buckets: *mutable HashBucket[K, V],
    protected len: UInt,
    protected capacity: UInt,
);

/// `Drop` for `FrozenDict[K, V]`: releases the live buckets and the table.
given[K: Hash, V: Any] FrozenDict[K, V]: Drop {

    drop(self): Void = {
        for i in 0..<self.capacity then {
            if (self.buckets + i).tag == UInt(1) then {
                deinit_memory(self.buckets + i);
            };
        };
        dealloc_memory(self.buckets);
    };
};

/// A one-shot cursor that walks a `FrozenDict[K, V]`'s table.
public type mutable FrozenDictIterator[K: Hash, V: Any](
    source: FrozenDict[K, V],
    mutable index: UInt,
);

/// Read-only access over a `FrozenDict[K, V]`.
given[K: Hash, V: Any] FrozenDict[K, V] {

    /// The number of entries in the snapshot.
    public count(self): UInt = self.len;

    /// Whether the snapshot has no entries.
    public is_empty(self): Bool = self.len == 0;

    /// The value stored under `key`, or `None` when absent.
    public get(self, key: K): Option[V] = {
        when find_hash_slot(self.buckets, self.capacity, key) in {
            .None() then {
                return Option[V].None();
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                if bucket_ptr.tag == UInt(1) then {
                    return Option[V].Some(bucket_ptr.value);
                } else {
                    return Option[V].None();
                };
            },
        };
    };

    /// Whether `key` has an entry in the snapshot.
    public contains_key(self, key: K): Bool = when self.get(key) in {
        .Some(_) then true,
        .None() then false,
    };

    /// Copy the snapshot back out as a fresh mutable `Dict[K, V]`.
    public to_dict(self): Dict[K, V] = {
        let mutable out = Dict[K, V].new();
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == UInt(1) then {
                out.insert(bucket_ptr.key, bucket_ptr.value);
            };
        };
        return out;
    };

    // Builtin subscript helper for `d[key]` syntax. Read-only: there is no
    // `__index_slot`, so a frozen subscript can never be a write target.
    // Missing-key panic matches the mutable `Dict` subscript exactly.
    private __index_get(self, key: K): V = {
        when self.get(key) in {
            .Some(v) then {
                return v;
            },
            .None() then {
                panic("Dict key not found");
            },
        };
    };
};

/// `Iterator` for `FrozenDictIterator[K, V]`: yields entries in table order
/// (the same order `to_frozen_dict`/`into_frozen` leave them in).
given[K: Hash, V: Any] FrozenDictIterator[K, V]: Iterator[Pair[K, V]] {

    /// Yield the next key/value pair, or `None` after the last entry.
    public next(self): Option[Pair[K, V]] = {
        let mutable i = self.index;
        while i < self.source.capacity then {
            let bucket_ptr = self.source.buckets + i;
            i = i + UInt(1);
            self.index = i;
            if bucket_ptr.tag == UInt(1) then {
                return Option[Pair[K, V]].Some(Pair[K, V](
                    bucket_ptr.key,
                    bucket_ptr.value,
                ));
            };
        };
        return Option[Pair[K, V]].None();
    };
};

/// `Iterable` for `FrozenDict[K, V]`: a fresh read cursor over the snapshot.
given[K: Hash, V: Any] FrozenDict[K, V]: Iterable[Pair[K, V], FrozenDictIterator[K, V]] {

    /// A fresh cursor over the snapshot's entries; the snapshot is untouched.
    public iterator(self): FrozenDictIterator[K, V] = FrozenDictIterator[K, V](self, 0);
};

/// Snapshot conversions from the mutable side.
given[K: Hash, V: Any] Dict[K, V] {

    /// Copy the dict into an immutable `FrozenDict[K, V]` snapshot that can
    /// cross threads. The receiver stays usable; the snapshot bulk-copies into
    /// its own compacted table + entry array of shared key/value handles.
    public to_frozen_dict(self): FrozenDict[K, V] = {
        let len = self.size;
        // 负载保持 ≤ 0.5（len * 2 < capacity），空快照不分配桶数组。
        let mutable capacity: UInt = UInt(0);
        if len > UInt(0) then {
            capacity = UInt(4);
            while len * UInt(2) >= capacity then {
                capacity = capacity * UInt(2);
            };
        };
        let buckets = alloc_memory[HashBucket[K, V]](capacity);
        for i in 0..<capacity then {
            bucket_set_tag(buckets + i, UInt(0));
        };
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == UInt(1) then {
                when find_hash_slot(buckets, capacity, bucket_ptr.key) in {
                    .Some(slot) then {
                        init_memory(
                            buckets + slot,
                            HashBucket[K, V](
                                UInt(1),
                                bucket_ptr.key,
                                bucket_ptr.value,
                            ),
                        );
                    },
                    .None() then {
                        panic("FrozenDict build failed");
                    },
                };
            };
        };
        return FrozenDict[K, V](buckets, len, capacity);
    };

    /// Transfer the whole bucket table into a `FrozenDict[K, V]` in O(1): the
    /// entries' ownership travels with the table -- nothing is copied,
    /// nothing is retained, and tombstones ride along (they are skipped by
    /// lookups and iteration). The dict is left empty and reusable. Where
    /// `to_frozen_dict` copies a compacted snapshot out, `into_frozen_*` hands
    /// the storage over; the entries die when the frozen snapshot dies.
    public into_frozen_dict(self): FrozenDict[K, V] = {
        let buckets = self.buckets;
        let len = self.size;
        let capacity = self.capacity;
        self.buckets = null;
        self.size = UInt(0);
        self.capacity = UInt(0);
        self.deleted = UInt(0);
        return FrozenDict[K, V](buckets, len, capacity);
    };
};
