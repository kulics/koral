using std { .. };
// ============================================================================
// std.async - Thread Handle
// ============================================================================
// Provides: ThreadStorage (internal), Thread (handle)
// Access via: using Std.Async
// ============================================================================

// ============================================================================
// FFI Declarations
// ============================================================================
foreign let __koral_thread_join(handle *unsafe UInt8) Int32;
foreign let __koral_thread_detach(handle *unsafe UInt8) Void;

public type mutable Thread(module_private handle *unsafe UInt8, module_private thread_id UInt64, module_private thread_name Option[String], module_private mutable waited Bool, module_private mutable detached Bool);

given Thread as Drop {

    drop(self) Void = {
        if not self.waited and not self.detached then {
            __koral_thread_detach(self.handle);
        };
    };
};

given Thread {

    /// Block until the thread finishes.
    /// Returns Error if already waited or detached.
    public wait(self) Result[Void] = {
        if self.waited then {
            return Result[Void].Error("thread already waited");
        };
        if self.detached then {
            return Result[Void].Error("thread already detached");
        };
        let result = __koral_thread_join(self.handle);
        self.waited = true;
        if result <> 0 then {
            return Result[Void].Error("failed to wait thread");
        };
        return Result[Void].Ok({});
    };

    /// Detach the thread (thread continues running, resources reclaimed by OS on exit).
    public detach(self) Void = {
        if self.waited or self.detached then {
            return;
        };
        __koral_thread_detach(self.handle);
        self.detached = true;
    };

    /// Get the thread ID.
    public id(self) UInt64 = self.thread_id;

    /// Get the thread name.
    public name(self) Option[String] = self.thread_name;
};
