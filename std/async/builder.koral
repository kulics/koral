using "std" { ... };
// ============================================================================
// std.async - Task Builder
// ============================================================================
// Provides: TaskStorage (internal), Task (builder)
// Access via: using "std/async" { ... };
// ============================================================================

// ============================================================================
// Task — Thread builder
// ============================================================================

/// Thread builder, configures thread parameters then creates thread via spawn().
/// Analogous to Command builder -> Process handle pattern.
/// Sendable contract: TRANSFER, not SHARE — builder discipline: configure from
/// one thread, then spawn(); a Task handle is handed off, not shared.
public type unsafe sendable mutable Task(
    private func: sendable () -> Void,
    private mutable name: Option[String],
    private mutable stack_size: Option[Int],
);

/// Build a task from a closure, configure its thread name and stack size, and spawn it.
given Task {
    /// Create a Task builder, binding the closure to execute.
    public new(f: sendable () -> Void): Task = Task(f, Option[String].None(), Option[Int].None());

    /// Set the thread name (chainable).
    public set_name(self, name: String): Task = {
        self.name = Option[String].Some(name);
        return self;
    };

    /// Set the thread stack size in bytes (chainable). Panics when `size` is
    /// negative. Requests below the platform floor (64KB) clamp up to it.
    /// Leaving it unset gives the unified default (8MB) on every platform --
    /// not the platform's own idea of a default (macOS pthreads 512KB, Linux
    /// 8MB, Windows 1MB). A stack overflow on any thread reports
    /// `Panic: stack overflow` and aborts.
    public set_stack_size(self, size: Int): Task = {
        if size < 0 then {
            panic("Task.set_stack_size: negative size");
        };
        self.stack_size = Option[Int].Some(size);
        return self;
    };

    /// Create a thread and return a Thread handle.
    /// Panics on failure.
    public spawn(self): Thread = {
        let user_func = self.func;

        let mutable handle: *UInt8 = null;
        let mutable tid: UInt64 = 0;

        let stack_size_value: UInt64 = when self.stack_size in {
            .Some(size) then UInt64(size),
            .None() then 0,
        };

        let result = spawn_thread(
            &mutable handle,
            &mutable tid,
            user_func,
            stack_size_value,
        );

        if result != 0 then {
            panic("Task.spawn: failed to create thread");
        };
        return make_thread(handle, tid, self.name);
    };
};
