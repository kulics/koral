using std { .. };
// ============================================================================
// std.async - Task Builder
// ============================================================================
// Provides: TaskStorage (internal), Task (builder)
// Access via: using Std.Async
// ============================================================================

// ============================================================================
// Task — Thread builder
// ============================================================================

/// Thread builder, configures thread parameters then creates thread via spawn().
/// Analogous to Command builder -> Process handle pattern.
public type mutable Task(file_private func Func() Void, file_private mutable name Option[String], file_private mutable stack_size Option[UInt]);

given Task {
    /// Create a Task builder, binding the closure to execute.
    public new(f Func() Void) Task =
        Task(f, Option[String].None(), Option[UInt].None());

    /// Set the thread name (chainable).
    public set_name(self, name String) Task = {
        self.name = Option[String].Some(name);
        return self;
    };

    /// Set the thread stack size (chainable).
    public set_stack_size(self, size UInt) Task = {
        self.stack_size = Option[UInt].Some(size);
        return self;
    };

    /// Create a thread and return a Thread handle.
    /// Panics on failure.
    public spawn(self) Thread = {
        let user_func = self.func;

        let mutable handle *unsafe UInt8 = null_ptr[UInt8]();
        let mutable tid UInt64 = 0;

        let stack_size_value UInt64 = when self.stack_size in {
            .Some(size) then size(UInt64),
            .None() then 0,
        };

        let result = spawn_thread(&unsafe mutable handle, &unsafe mutable tid, user_func, stack_size_value);

        if result <> 0 then {
            panic("Task.spawn: failed to create thread");
        };
        return Thread(handle, tid, self.name, false, false);
    };
};
