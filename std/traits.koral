// ============================================================================
// Koral Standard Library - Traits
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives are already available.
// ============================================================================

// ============================================================================
// Core Traits
// ============================================================================
public trait Hash Eq {
    hash(self) UInt;
};

given Hash {

    /// Combines self hash with another hash value.
    public combine_hash(self, value UInt) UInt = {
        let magic UInt = 2654435769;// 0x9e3779b9
        let seed = self.hash();
        return seed ^ value.wrapping_add(magic).wrapping_add(seed << 6).wrapping_add(seed >> 2);
    };
};

public trait Error {
    message(self) String;
};

public trait Drop {
    drop(self) Void;
};

public trait Default {
    default() Self;
};

/// Explicit independent copy for shared (`type mutable`) objects.
/// Semantics are shallow: the receiver's backing storage is duplicated and
/// elements are copied one level, so nested shared objects stay shared.
public trait Clone {
    clone(self) Self;
};

/// Plain-old-data: no managed runtime state, so a raw pointer to a value of
/// this type is FFI-safe. `borrow_ptr` / `borrow_mut_ptr` are restricted to
/// these types so they cannot be used as a generic
/// "any Koral type -> *unsafe T" bridge.
public trait Pod {};

given String as Error {

    public message(self) String = self;
};

// ============================================================================
// Primitive Hash Implementations
// ============================================================================
given Bool as Hash {

    public hash(self) UInt = if self then 1 else 0;
};

given Bool as Default {

    public default() Self = false;
};

given UInt as Hash {

    public hash(self) UInt = self;
};

given UInt as Default {

    public default() Self = 0(UInt);
};

given UInt8 as Hash {

    public hash(self) UInt = self(UInt);
};

given UInt8 as Default {

    public default() Self = 0(UInt8);
};

given UInt16 as Hash {

    public hash(self) UInt = self(UInt);
};

given UInt16 as Default {

    public default() Self = 0(UInt16);
};

given UInt32 as Hash {

    public hash(self) UInt = self(UInt);
};

given UInt32 as Default {

    public default() Self = 0(UInt32);
};

given UInt64 as Hash {

    public hash(self) UInt = {
        let v UInt64 = self;
        let lo UInt = v(UInt);
        let hi UInt = (v / 4294967296)(UInt);
        return lo.combine_hash(hi);
    };
};

given UInt64 as Default {

    public default() Self = 0(UInt64);
};

given Int as Hash {

    public hash(self) UInt = self(UInt);
};

given Int as Default {

    public default() Self = 0;
};

given Int8 as Hash {

    public hash(self) UInt = self(UInt);
};

given Int8 as Default {

    public default() Self = 0(Int8);
};

given Int16 as Hash {

    public hash(self) UInt = self(UInt);
};

given Int16 as Default {

    public default() Self = 0(Int16);
};

given Int32 as Hash {

    public hash(self) UInt = self(UInt);
};

given Int32 as Default {

    public default() Self = 0(Int32);
};

given Int64 as Hash {

    public hash(self) UInt = {
        let v UInt64 = self(UInt64);
        let lo UInt = v(UInt);
        let hi UInt = (v / 4294967296)(UInt);
        return 0(UInt).combine_hash(lo).combine_hash(hi);
    };
};

given Int64 as Default {

    public default() Self = 0(Int64);
};

given[T Any] *unsafe T as Eq {

    public equals(self, other *unsafe T) Bool = self == other;
};

given[T Any] *unsafe T as Hash {

    public hash(self) UInt = self(UInt);
};

given[T Any] *unsafe mutable T as Eq {

    public equals(self, other *unsafe mutable T) Bool = self(*unsafe T).equals(other(*unsafe T));
};

given[T Any] *unsafe mutable T as Hash {

    public hash(self) UInt = self(*unsafe T).hash();
};

// ============================================================================
// Pod Implementations
// ============================================================================
given Bool as Pod {};
given Int as Pod {};
given Int8 as Pod {};
given Int16 as Pod {};
given Int32 as Pod {};
given Int64 as Pod {};
given UInt as Pod {};
given UInt8 as Pod {};
given UInt16 as Pod {};
given UInt32 as Pod {};
given UInt64 as Pod {};
given Float32 as Pod {};
given Float64 as Pod {};
given[T Any] *unsafe T as Pod {};
given[T Any] *unsafe mutable T as Pod {};
