// ============================================================================
// Koral Standard Library - Traits
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives are already available.
// ============================================================================

// ============================================================================
// Core Traits
// ============================================================================
public trait Hash Eq {
    hash(self) UInt
}

given Hash {

    /// Combines self hash with another hash value.
    public combine_hash(self, value UInt) UInt = {
        let magic UInt = 2654435769 // 0x9e3779b9
        let seed = self.hash()
        return seed ^ value.wrapping_add(magic).wrapping_add(seed << 6).wrapping_add(seed >> 2)
    }
}

public trait Error {
    message(*self) String
}

public trait Drop {
    drop(source unsafe * mutable Self) Void
}

given String as Error {

    public message(*self) String = self
}

// ============================================================================
// Primitive Hash Implementations
// ============================================================================
given Bool as Hash {

    public hash(self) UInt = if self then 1 else 0
}

given UInt as Hash {

    public hash(self) UInt = self
}

given UInt8 as Hash {

    public hash(self) UInt = self(UInt)
}

given UInt16 as Hash {

    public hash(self) UInt = self(UInt)
}

given UInt32 as Hash {

    public hash(self) UInt = self(UInt)
}

given UInt64 as Hash {

    public hash(self) UInt = {
        let v UInt64 = self
        let lo UInt = v(UInt)
        let hi UInt = (v / 4294967296)(UInt)
        return lo.combine_hash(hi)
    }
}

given Int as Hash {

    public hash(self) UInt = self(UInt)
}

given Int8 as Hash {

    public hash(self) UInt = self(UInt)
}

given Int16 as Hash {

    public hash(self) UInt = self(UInt)
}

given Int32 as Hash {

    public hash(self) UInt = self(UInt)
}

given Int64 as Hash {

    public hash(self) UInt = {
        let v UInt64 = self(UInt64)
        let lo UInt = v(UInt)
        let hi UInt = (v / 4294967296)(UInt)
        return 0(UInt).combine_hash(lo).combine_hash(hi)
    }
}

given[T Any] unsafe * T as Eq {

    public equals(self, other unsafe * T) Bool = self == other
}

given[T Any] unsafe * T as Hash {

    public hash(self) UInt = self(UInt)
}

given[T Any] unsafe * mutable T as Eq {

    public equals(self, other unsafe * mutable T) Bool = self(unsafe * T).equals(other(unsafe * T))
}

given[T Any] unsafe * mutable T as Hash {

    public hash(self) UInt = self(unsafe * T).hash()
}

given[T Eq and Deref] * T as Eq {

    public equals(self, other * T) Bool = (*self).equals(*other)
}

given[T Eq and Deref] *mutable T as Eq {

    public equals(self, other *mutable T) Bool = (*self).equals(*other)
}

given[T Hash and Deref] * T as Hash {

    public hash(self) UInt = (*self).hash()
}

given[T Hash and Deref] *mutable T as Hash {

    public hash(self) UInt = (*self).hash()
}

given[T Ord and Deref] * T as Ord {

    public compare(self, other * T) Int = (*self).compare(*other)
}

given[T Ord and Deref] *mutable T as Ord {

    public compare(self, other *mutable T) Int = (*self).compare(*other)
}

given[T ToString and Deref] * T as ToString {

    public to_string(*self) String = (*self).to_string()
}

given[T ToString and Deref] *mutable T as ToString {

    public to_string(*self) String = (*self).to_string()
}
