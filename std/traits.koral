/// `Hash` for `WrappingInt32`: matches the plain `Int32` twin.
given WrappingInt32: Hash {

    /// Return the two's-complement bit pattern as a `UInt`, matching the plain
    /// `Int32` twin's hash.
    public hash(self): UInt = UInt(WrappingUInt(self));
