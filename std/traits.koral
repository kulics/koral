// ============================================================================
// Koral Standard Library - Traits
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives are already available.
// ============================================================================

// ============================================================================
// Core Traits
// ============================================================================
public trait Hash Eq {
    hash(self) UInt;
};

given Hash {

    /// Combines self hash with another hash value.
    public combine_hash(self, value UInt) UInt = {
        let magic UInt = 2654435769; // 0x9e3779b9
        let seed = self.hash();
        let combined = WrappingUInt(value) + WrappingUInt(magic) + WrappingUInt(seed << 6) + WrappingUInt(
            seed >> 2,
        );
        return seed ^ UInt(combined);
    };
};

public trait Error {
    message(self) String;
};

public trait Drop {
    drop(self) Void;
};

public trait Default {
    default() Self;
};

/// Explicit independent copy for shared (`type mutable`) objects.
/// Semantics are shallow: the receiver's backing storage is duplicated and
/// elements are copied one level, so nested shared objects stay shared.
/// See `docs/design/type-semantics.md`.
public trait Clone {
    clone(self) Self;
};

given String as Error {

    public message(self) String = self;
};

// ============================================================================
// Primitive Hash Implementations
// ============================================================================
given Bool as Hash {

    public hash(self) UInt = if self then 1 else 0;
};

given Bool as Default {

    public default() Self = false;
};

given UInt as Hash {

    public hash(self) UInt = self;
};

given UInt as Default {

    public default() Self = UInt(0);
};

given UInt8 as Hash {

    public hash(self) UInt = UInt(self);
};

given UInt8 as Default {

    public default() Self = UInt8(0);
};

given UInt16 as Hash {

    public hash(self) UInt = UInt(self);
};

given UInt16 as Default {

    public default() Self = UInt16(0);
};

given UInt32 as Hash {

    public hash(self) UInt = UInt(self);
};

given UInt32 as Default {

    public default() Self = UInt32(0);
};

given UInt64 as Hash {

    public hash(self) UInt = {
        let v UInt64 = self;
        let lo UInt = UInt(v);
        let hi UInt = UInt((v / 4294967296));
        return lo.combine_hash(hi);
    };
};

given UInt64 as Default {

    public default() Self = UInt64(0);
};

given Int as Hash {

    public hash(self) UInt = UInt(self);
};

given Int as Default {

    public default() Self = 0;
};

given Int8 as Hash {

    // Hash the BIT PATTERN, not the number: `WrappingUInt(self)` sign-extends
    // the two's-complement representation instead of being rejected by the
    // checked `Type(x)` conversion, and the same-width `UInt(...)` retypes it.
    public hash(self) UInt = UInt(WrappingUInt(self));
};

given Int8 as Default {

    public default() Self = Int8(0);
};

given Int16 as Hash {

    public hash(self) UInt = UInt(WrappingUInt(self));
};

given Int16 as Default {

    public default() Self = Int16(0);
};

given Int32 as Hash {

    public hash(self) UInt = UInt(WrappingUInt(self));
};

given Int32 as Default {

    public default() Self = Int32(0);
};

given Int64 as Hash {

    public hash(self) UInt = {
        let v UInt64 = UInt64(self);
        let lo UInt = UInt(v);
        let hi UInt = UInt((v / 4294967296));
        return UInt(0).combine_hash(lo).combine_hash(hi);
    };
};

given Int64 as Default {

    public default() Self = Int64(0);
};

// ============================================================================
// Wrapping Hash, Default, and Clone Implementations
// ============================================================================
// Hash delegates to the plain counterpart of the same width after a lossless
// same-width retype, so a Wrapping value and its plain twin hash alike.

given WrappingUInt as Hash {

    public hash(self) UInt = UInt(self);
};

given WrappingUInt as Default {

    public default() Self = WrappingUInt(0);
};

given WrappingUInt as Clone {

    public clone(self) Self = self;
};

given WrappingUInt8 as Hash {

    public hash(self) UInt = UInt(self);
};

given WrappingUInt8 as Default {

    public default() Self = WrappingUInt8(0);
};

given WrappingUInt8 as Clone {

    public clone(self) Self = self;
};

given WrappingUInt16 as Hash {

    public hash(self) UInt = UInt(self);
};

given WrappingUInt16 as Default {

    public default() Self = WrappingUInt16(0);
};

given WrappingUInt16 as Clone {

    public clone(self) Self = self;
};

given WrappingUInt32 as Hash {

    public hash(self) UInt = UInt(self);
};

given WrappingUInt32 as Default {

    public default() Self = WrappingUInt32(0);
};

given WrappingUInt32 as Clone {

    public clone(self) Self = self;
};

given WrappingUInt64 as Hash {

    public hash(self) UInt = {
        let v UInt64 = UInt64(self);
        let lo UInt = UInt(v);
        let hi UInt = UInt((v / 4294967296));
        return lo.combine_hash(hi);
    };
};

given WrappingUInt64 as Default {

    public default() Self = WrappingUInt64(0);
};

given WrappingUInt64 as Clone {

    public clone(self) Self = self;
};

given WrappingInt as Hash {

    public hash(self) UInt = UInt(self);
};

given WrappingInt as Default {

    public default() Self = 0;
};

given WrappingInt as Clone {

    public clone(self) Self = self;
};

given WrappingInt8 as Hash {

    // Same bit-pattern reading as plain `Int8`: `WrappingUInt(self)`
    // sign-extends the two's-complement representation, and the same-width
    // `UInt(...)` retypes it.
    public hash(self) UInt = UInt(WrappingUInt(self));
};

given WrappingInt8 as Default {

    public default() Self = WrappingInt8(0);
};

given WrappingInt8 as Clone {

    public clone(self) Self = self;
};

given WrappingInt16 as Hash {

    public hash(self) UInt = UInt(WrappingUInt(self));
};

given WrappingInt16 as Default {

    public default() Self = WrappingInt16(0);
};

given WrappingInt16 as Clone {

    public clone(self) Self = self;
};

given WrappingInt32 as Hash {

    public hash(self) UInt = UInt(WrappingUInt(self));
};

given WrappingInt32 as Default {

    public default() Self = WrappingInt32(0);
};

given WrappingInt32 as Clone {

    public clone(self) Self = self;
};

given WrappingInt64 as Hash {

    public hash(self) UInt = {
        let v UInt64 = UInt64(self);
        let lo UInt = UInt(v);
        let hi UInt = UInt((v / 4294967296));
        return UInt(0).combine_hash(lo).combine_hash(hi);
    };
};

given WrappingInt64 as Default {

    public default() Self = WrappingInt64(0);
};

given WrappingInt64 as Clone {

    public clone(self) Self = self;
};

given[T Any] *T as Eq {

    public equals(self, other *T) Bool = self == other;
};

given[T Any] *T as Hash {

    public hash(self) UInt = self as UInt;
};

given[T Any] *mutable T as Eq {

    public equals(self, other *mutable T) Bool = (self as *T).equals(other as *T);
};

given[T Any] *mutable T as Hash {

    public hash(self) UInt = (self as *T).hash();
};
