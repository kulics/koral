// ---------------------------------------------------------------------------
// given Float64 Parseable
// ---------------------------------------------------------------------------

/// Parseable conformance: parse `Float64` from decimal text.
given Float64: Parseable {

    /// Parse a floating-point number from `s`, trimming surrounding whitespace.
    /// Accepts `NaN`, `inf`, decimals, and exponents like `1e10`; errors on malformed input.
    /// The value is correctly rounded by the C runtime; exponents outside the
    /// `Float64` range come back as ±inf/0.0 instead of panicking.
    public parse(s: String): Result[Self] = {
        let trimmed = s.trim_ascii();
        if trimmed.is_empty() then {
            return Result[Float64].Error("empty string");
        };

        let len = trimmed.count();

        // Optional sign
        let is_negative = trimmed[0] == '-';
        let has_sign = is_negative or trimmed[0] == '+';
        let mutable i: UInt = 0;
        if has_sign then {
            i = 1;
        };

        // Special values: an optional sign followed by `inf`/`infinity`/`nan`
        // in any case (Python float() semantics).
        if ascii_iequals_rest(trimmed, i, "inf") or ascii_iequals_rest(
            trimmed,
            i,
            "infinity",
        ) then {
            return Result[Float64].Ok(
                if is_negative then 0.0 - Float64.inf() else Float64.inf(),
            );
        };
        if ascii_iequals_rest(trimmed, i, "nan") then {
            let nan_value = Float64.nan();
            return Result[Float64].Ok(
                if is_negative then Float64.from_bits(
                    nan_value.to_bits() | (UInt64(1) << 63),
                ) else nan_value,
            );
        };

        // Syntax validation scan: digits, one dot, optional exponent digits.
        let mutable has_int = false;
        while i < len and trimmed[i] >= '0' and trimmed[i] <= '9' then {
            has_int = true;
            i += 1;
        };

        let mutable has_frac = false;
        if i < len and trimmed[i] == '.' then {
            i += 1;
            while i < len and trimmed[i] >= '0' and trimmed[i] <= '9' then {
                has_frac = true;
                i += 1;
            };
        };

        if not has_int and not has_frac then {
            return Result[Float64].Error("no digits found");
        };

        if i < len and (trimmed[i] == 'e' or trimmed[i] == 'E') then {
            i += 1;
            if i < len and (trimmed[i] == '+' or trimmed[i] == '-') then {
                i += 1;
            };
            let mutable has_exp = false;
            while i < len and trimmed[i] >= '0' and trimmed[i] <= '9' then {
                has_exp = true;
                i += 1;
            };
            if not has_exp then {
                return Result[Float64].Error("invalid exponent");
            };
        };

        if i < len then {
            return Result[Float64].Error("trailing characters");
        };

        // The scan accepted the whole literal, so `trimmed` is exactly a valid
        // numeric literal (sign included); strtod supplies the correct rounding
        // and preserves the sign of -0.0.
        return Result[Float64].Ok(__koral_parse_float64(trimmed.bytes.data));
    };
};

// ---------------------------------------------------------------------------
// given Float32 Parseable
// ---------------------------------------------------------------------------

/// Parseable conformance: parse `Float32` by widening through `Float64`.
given Float32: Parseable {

    /// Parse a floating-point number via `Float64.parse` and narrow it to `Float32`.
    public parse(s: String): Result[Self] = when Float64.parse(s) in {
        .Ok(f) then Result[Float32].Ok(Float32(f)),
        .Error(e) then Result[Float32].Error(e),
    };
};

// ---------------------------------------------------------------------------
// given Rune Parseable
// ---------------------------------------------------------------------------

/// Parseable conformance: parse a `Rune` from a single-character string.
given Rune: Parseable {

    /// Parse a string containing exactly one Unicode scalar value into a `Rune`.
    /// Returns `Result.Error` if the string is empty or contains more than one code point.
    public parse(s: String): Result[Self] = {
        let runes = s.to_runes();
        let len = runes.count();
        if len == 0 then {
            return Result[Rune].Error("empty string");
        };
        if len > 1 then {
            return Result[Rune].Error("expected exactly one character");
        };
        return Result[Rune].Ok(runes[0]);
    };
};
