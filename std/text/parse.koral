using "std" { ... };
// ============================================================================
// std.text - Parse Implementation
// ============================================================================
// Provides string-to-number parsing for all numeric types.
// Signed integers: Int, Int8, Int16, Int32, Int64
// Unsigned integers: UInt, UInt8, UInt16, UInt32, UInt64 (task 4.2)
// Floating point: Float32, Float64 (task 5.1)
//
// All parse functions return Result — never panic on any input.
// ============================================================================

// Correctly-rounded decimal -> double (strtod); the argument must be a
// NUL-terminated Koral String's bytes.
let foreign __koral_parse_float64(cstr: *UInt8): Float64;

// ---------------------------------------------------------------------------
// Helper functions
// ---------------------------------------------------------------------------

// Check whether a character is a valid digit for the given radix (2..36).
private let is_digit_for_radix(ch: UInt8, radix: UInt): Bool = if radix <= 10 then ch >= '0' and ch < '0' + UInt8(
    radix,
)
else (ch >= '0' and ch <= '9') or (ch >= 'a' and ch < 'a' + UInt8((radix - 10))) or (ch >= 'A' and ch < 'A' + UInt8(
    (radix - 10),
));

// Convert a digit character to its numeric value.
private let digit_value(ch: UInt8, radix: UInt): UInt = if ch >= '0' and ch <= '9' then UInt(
    (ch - '0'),
)
else if ch >= 'a' and ch <= 'z' then UInt((ch - 'a')) + 10
else if ch >= 'A' and ch <= 'Z' then UInt((ch - 'A')) + 10 else panic("invalid digit");

// Compare `s[start..]` against `word`, ignoring ASCII case.
private let ascii_iequals_rest(s: String, start: UInt, word: String): Bool = {
    let remaining = s.count() - start;
    if remaining != word.count() then {
        return false;
    };
    let mutable i: UInt = 0;
    while i < remaining then {
        let a = s[start + i];
        let b = word[i];
        if a != b then {
            let al = if a >= 'A' and a <= 'Z' then a + 32 else a;
            let bl = if b >= 'A' and b <= 'Z' then b + 32 else b;
            if al != bl then {
                return false;
            };
        };
        i += 1;
    };
    return true;
};

// ---------------------------------------------------------------------------
// given Int Parseable, Int RadixParseable
// ---------------------------------------------------------------------------

/// Parseable conformance: parse `Int` from decimal text.
given Int: Parseable {

    /// Parse a decimal integer from `s`, trimming surrounding whitespace.
    /// Accepts `+`/`-` signs and `_` separators; errors on empty, malformed, or overflowing input.
    public parse(s: String): Result[Self] = Int.parse_radix(s, 10);
};

/// RadixParseable conformance: parse `Int` from text in radix 2..36.
given Int: RadixParseable {

    /// Parse `s` as an integer in `radix` (2..36); never panics, errors on bad input.
    /// Accepts a sign, `_` separators, and `0x`/`0o`/`0b` prefixes for the matching radix.
    public parse_radix(s: String, radix: UInt): Result[Self] = {
        if radix < 2 or radix > 36 then {
            return Result[Int].Error("radix must be in range 2..36");
        };

        let trimmed = s.trim_ascii();
        if trimmed.is_empty() then {
            return Result[Int].Error("empty string");
        };

        let mutable i: UInt = 0;
        let len = trimmed.count();

        // Check sign
        let is_negative = trimmed[0] == '-';
        let has_sign = is_negative or trimmed[0] == '+';
        if has_sign then {
            i += 1;
        };

        // Skip optional radix prefix; `prefix_end` marks the position just
        // after a consumed prefix so a separator there is accepted.
        let mutable prefix_end: UInt = UInt.max_value();
        if i + 1 < len then {
            let c0 = trimmed[i];
            let c1 = trimmed[i + 1];
            if c0 == '0' then {
                if radix == 2 and (c1 == 'b' or c1 == 'B') then {
                    prefix_end = i + 2;
                    i += 2;
                } else if radix == 8 and (c1 == 'o' or c1 == 'O') then {
                    prefix_end = i + 2;
                    i += 2;
                } else if radix == 16 and (c1 == 'x' or c1 == 'X') then {
                    prefix_end = i + 2;
                    i += 2;
                };
            };
        };

        if i >= len then {
            return Result[Int].Error("no digits found");
        };

        // Parse digits, accumulating the magnitude in `UInt` so that the
        // magnitude of `Int.min_value()` (2^63) is representable; the signed
        // range check happens after the sign is known.
        let base = radix;
        let magnitude_limit = if is_negative then UInt(Int.max_value()) + 1 else UInt(
            Int.max_value(),
        );
        let mutable result: UInt = 0;
        let mutable has_digit = false;

        while i < len then {
            let ch = trimmed[i];

            if ch == '_' then {
                // A separator must follow a digit or the radix prefix, and
                // must precede a digit.
                let prev_ok = (i > 0 and is_digit_for_radix(trimmed[i - 1], radix))
                    or i == prefix_end;
                if not prev_ok or i + 1 >= len or not is_digit_for_radix(
                    trimmed[i + 1],
                    radix,
                ) then {
                    return Result[Int].Error("unexpected underscore");
                };
                i += 1;
                continue;
            };

            if not is_digit_for_radix(ch, radix) then {
                return Result[Int].Error("invalid character");
            };

            let d = digit_value(ch, radix);

            if result > (magnitude_limit - d) / base then {
                return Result[Int].Error("overflow");
            };

            result = result * base + d;
            has_digit = true;
            i += 1;
        };

        if not has_digit then {
            return Result[Int].Error("no digits found");
        };

        if is_negative then {
            // 2^63 has no positive `Int` counterpart; map it straight to the
            // minimum, otherwise negate the magnitude.
            if result == UInt(Int.max_value()) + 1 then {
                return Result[Int].Ok(Int.min_value());
            };
            return Result[Int].Ok(0 - Int(result));
        };
        return Result[Int].Ok(Int(result));
    };
};

// ---------------------------------------------------------------------------
// given Int8 Parseable, Int8 RadixParseable
// ---------------------------------------------------------------------------

/// Parseable conformance: parse `Int8` from decimal text.
given Int8: Parseable {

    /// Parse a decimal `Int8` from `s`, returning `Result.Error` on overflow or bad input.
    public parse(s: String): Result[Self] = Int8.parse_radix(s, 10);
};

/// RadixParseable conformance: parse `Int8` from text in radix 2..36.
given Int8: RadixParseable {

    /// Parse `s` in radix 2..36, returning `Result.Error` on overflow beyond `Int8`'s range.
    public parse_radix(s: String, radix: UInt): Result[Self] = when Int.parse_radix(
        s,
        radix,
    ) in {
        .Ok(n) where n < Int(Int8.min_value()) or n > Int(Int8.max_value()) then Result[Int8].Error(
            "overflow",
        ),
        .Ok(n) then Result[Int8].Ok(Int8(n)),
        .Error(e) then Result[Int8].Error(e),
    };
};

