// ---------------------------------------------------------------------------
// given UInt Parseable, UInt RadixParseable
// ---------------------------------------------------------------------------

/// Parseable conformance: parse `UInt` from decimal text.
given UInt: Parseable {

    /// Parse a decimal unsigned integer from `s`, trimming surrounding whitespace.
    /// Rejects negative values; errors on empty, malformed, or overflowing input.
    public parse(s: String): Result[Self] = UInt.parse_radix(s, 10);
};

/// RadixParseable conformance: parse `UInt` from text in radix 2..36.
given UInt: RadixParseable {

    /// Parse `s` as an unsigned integer in `radix` (2..36); never panics, errors on bad input.
    /// Rejects a leading `-`; accepts `+`, `_` separators, and `0x`/`0o`/`0b` prefixes.
    public parse_radix(s: String, radix: UInt): Result[Self] = {
        if radix < 2 or radix > 36 then {
            return Result[UInt].Error("radix must be in range 2..36");
        };

        let trimmed = s.trim_ascii();
        if trimmed.is_empty() then {
            return Result[UInt].Error("empty string");
        };

        let mutable i: UInt = 0;
        let len = trimmed.count();

        // Unsigned types reject negative sign
        if trimmed[0] == '-' then {
            return Result[UInt].Error("negative value for unsigned type");
        };
        if trimmed[0] == '+' then {
            i += 1;
        };

        // Skip optional radix prefix; `prefix_end` marks the position just
        // after a consumed prefix so a separator there is accepted.
        let mutable prefix_end: UInt = UInt.max_value();
        if i + 1 < len then {
            let c0 = trimmed[i];
            let c1 = trimmed[i + 1];
            if c0 == '0' then {
                if radix == 2 and (c1 == 'b' or c1 == 'B') then {
                    prefix_end = i + 2;
                    i += 2;
                } else if radix == 8 and (c1 == 'o' or c1 == 'O') then {
                    prefix_end = i + 2;
                    i += 2;
                } else if radix == 16 and (c1 == 'x' or c1 == 'X') then {
                    prefix_end = i + 2;
                    i += 2;
                };
            };
        };

        if i >= len then {
            return Result[UInt].Error("no digits found");
        };

        let base = radix;
        let mutable result: UInt = 0;
        let mutable has_digit = false;

        while i < len then {
            let ch = trimmed[i];
            if ch == '_' then {
                // A separator must follow a digit or the radix prefix, and
                // must precede a digit.
                let prev_ok = (i > 0 and is_digit_for_radix(trimmed[i - 1], radix))
                    or i == prefix_end;
                if not prev_ok or i + 1 >= len or not is_digit_for_radix(
                    trimmed[i + 1],
                    radix,
                ) then {
                    return Result[UInt].Error("unexpected underscore");
                };
                i += 1;
                continue;
            };
            if not is_digit_for_radix(ch, radix) then {
                return Result[UInt].Error("invalid character");
            };
            let d = digit_value(ch, radix);
            if result > (UInt.max_value() - d) / base then {
                return Result[UInt].Error("overflow");
            };
            result = result * base + d;
            has_digit = true;
            i += 1;
        };

        if not has_digit then {
            return Result[UInt].Error("no digits found");
        };

        return Result[UInt].Ok(result);
    };
};

