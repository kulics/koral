using "std" { ... };
// ============================================================================
// std.text - Core Operations
// ============================================================================

// ============================================================================
// Regex — Compilation
// ============================================================================

/// Compile patterns into `Regex` values.
given Regex {

    /// Compile `pattern` with default flags into a `Regex`.
    /// Returns `Result.Error` with the engine's message if the pattern is invalid.
    public compile(pattern: String): Result[Regex] =
        Regex.compile_with_flags(pattern, RegexFlag.none());

    /// Compile `pattern` with `flags` applied, returning `Result.Error` on an invalid pattern.
    public compile_with_flags(pattern: String, flags: RegexFlag): Result[Regex] = {
        let ignore_case = flags.has(RegexFlag.ignore_case());
        let multiline = flags.has(RegexFlag.multiline());
        return when re_compile(pattern, ignore_case, multiline) in {
            .Ok(prog) then Result[Regex].Ok(Regex(prog, pattern, prog.ngroups)),
            .Error(e) then Result[Regex].Error(e),
        };
    };
};

// ============================================================================
// Regex — Matching & Searching
// ============================================================================

/// Match testing and first-match search without capture detail.
given Regex {

    /// Test whether the pattern matches anywhere in `text`, capturing no groups.
    public matches(self, text: String): Bool = {
        return when re_run(self.prog, text, 0, false) in {
            .Some(_) then true,
            .None() then false,
        };
    };

    /// Return the first match in `text`, recording only the whole match's span.
    /// Returns `None` when the pattern does not match.
    public find(self, text: String): Option[Match] = Regex.find_at(self, text, 0);

    // 从指定偏移开始查找（内部方法，仅 $0）
    find_at(self, text: String, offset: UInt): Option[Match] = {
        return when re_run(self.prog, text, offset, false) in {
            .Some(m) then Option[Match].Some(
                Match(text, UInt(m.slots[0]), UInt(m.slots[1])),
            ),
            .None() then Option[Match].None(),
        };
    };
};

// ============================================================================
// Regex — Captures & Collection Methods
// ============================================================================

/// Capture-group search plus match and capture iterators.
given Regex {

    /// Iterate over every non-overlapping match in `text`, without capture groups.
    public find_all(self, text: String): MatchIterator = MatchIterator(self, text, 0);

    /// Return the first match in `text` with all of its capture groups.
    /// Returns `None` when the pattern does not match.
    public captures(self, text: String): Option[Captures] =
        Regex.captures_at(self, text, 0);

    // 从指定偏移开始查找并捕获所有 group（内部方法）
    captures_at(self, text: String, offset: UInt): Option[Captures] = {
        return when re_run(self.prog, text, offset, true) in {
            .Some(m) then {
                let group_slots = self.groups + 1;
                let start_list = List[Int32].with_capacity(group_slots);
                let end_list = List[Int32].with_capacity(group_slots);
                for i in 0..<group_slots then {
                    start_list.push(m.slots[i * 2]);
                    end_list.push(m.slots[i * 2 + 1]);
                };
                Option[Captures].Some(Captures(text, start_list, end_list))
            },
            .None() then Option[Captures].None(),
        };
    };

    /// Iterate over every non-overlapping match in `text`, each with its capture groups.
    public captures_all(self, text: String): CapturesIterator =
        CapturesIterator(self, text, 0);
};

// ============================================================================
// Regex — Replace
// ============================================================================

/// Substitution of the first match or of every match.
given Regex {

    /// Replace the first match in `text` with `with`, returning `text` unchanged if there is none.
    /// In `with`, `$0`..`$9` expand to capture groups and `$$` produces a literal `$`.
    public replace(self, text: String, with: String =): String = {
        when self.captures(text) in {
            .None() then {
                return text;
            },
            .Some(c) then {
                let mutable result = StringBuilder.new();
                if c.start() > 0 then {
                    result.push_string(text.substring(0..<c.start()));
                };
                result.push_string(Regex.expand_replacement(with, c));
                if c.end() < text.count() then {
                    result.push_string(text.substring(c.end()...));
                };
                return result.to_string();
            },
        };
    };

    /// Replace every match in `text` with `with`, expanding `$0`..`$9` and `$$` as in `replace`.
    public replace_all(self, text: String, with: String =): String = {
        let mutable result = StringBuilder.new();
        let mutable offset: UInt = 0;
        let text_len = text.count();
        let mutable had_match = false;

        while offset <= text_len then {
            when Regex.captures_at(self, text, offset) in {
                .Some(c) then {
                    had_match = true;
                    if c.start() > offset then {
                        result.push_string(text.substring(offset..<c.start()));
                    };
                    result.push_string(Regex.expand_replacement(with, c));
                    if c.end() == offset then {
                        if offset < text_len then {
                            result.push_byte(text[offset]);
                        };
                        offset += 1;
                    } else {
                        offset = c.end();
                    };
                },
                .None() then {
                    if offset < text_len then {
                        result.push_string(text.substring(offset...));
                    };
                    break;
                },
            };
        };

        return if not had_match then text else result.to_string();
    };

    // 展开替换字符串中的 $0..$9 反向引用
    expand_replacement(replacement: String, c: Captures): String = {
        let mutable result = StringBuilder.new();
        let mutable i: UInt = 0;
        let len = replacement.count();

        while i < len then {
            let ch = replacement[i];
            if ch == '$' and i + 1 < len then {
                let next = replacement[i + 1];
                if next >= '0' and next <= '9' then {
                    let group_idx = UInt((next - '0'));
                    when c.group(group_idx) in {
                        .Some(g) then result.push_string(g),
                        .None() then {}, // 未匹配的组替换为空
                    };
                    i += 2;
                    continue;
                };
                if next == '$' then {
                    result.push_byte('$'); // $$ 转义为字面 $
                    i += 2;
                    continue;
                };
            };
            result.push_byte(ch);
            i += 1;
        };

        return result.to_string();
    };
};

// ============================================================================
// Regex — Split
// ============================================================================

/// Splitting text around matches.
given Regex {

    /// Split `text` around every match, yielding the pieces between matches and the trailing tail.
    public split(self, text: String): RegexSplitIterator =
        RegexSplitIterator(self, text, 0, false);
};
