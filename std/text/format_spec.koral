using "std" { ... };
// ============================================================================
// std.text - Format Spec Parser
// ============================================================================
// Parses Python-style format specification mini-language:
//   [[fill]align][sign][#][0][width][grouping_option][.precision][type]
//
// FormatSpec and parse_format_spec are private to the convert module.
// ============================================================================

// Internal format spec parsed result (module-internal type).
type mutable FormatSpec(
    mutable fill: Rune,
    mutable align: UInt8,
    mutable sign: UInt8,
    mutable fill_explicit: Bool,
    mutable align_explicit: Bool,
    mutable sign_explicit: Bool,
    mutable alt_form: Bool,
    mutable zero_pad: Bool,
    mutable width: UInt,
    mutable grouping: UInt8,
    mutable precision: Int,
    mutable type_char: UInt8,
);

// Parse a format spec string into a FormatSpec.
// Invalid format strings (extra characters after type) will panic.
let parse_format_spec(spec: String): FormatSpec = {
    let mutable result = FormatSpec(
        Rune.from_uint32_unchecked(32),
        '>',
        '-',
        false,
        false,
        false,
        false,
        false,
        0,
        0,
        -1,
        0,
    );
    let len = spec.count();
    if len == 0 then {
        return result;
    };

    let mutable i: UInt = 0;

    // Parse [[fill]align]: the fill is one whole rune (possibly multi-byte),
    // taken only when an align character follows it.
    let fill_bytes = utf8_sequence_len(spec[i]);
    if fill_bytes + 1 <= len and is_align_char(spec[i + fill_bytes]) then {
        result.fill = spec.to_runes()[0];
        result.fill_explicit = true;
        result.align = spec[i + fill_bytes];
        result.align_explicit = true;
        i = i + fill_bytes + 1;
    } else if is_align_char(spec[i]) then {
        result.align = spec[i];
        result.align_explicit = true;
        i += 1;
    };

    // Parse [sign]
    if i < len and (spec[i] == '+' or spec[i] == '-' or spec[i] == ' ') then {
        result.sign = spec[i];
        result.sign_explicit = true;
        i += 1;
    };

    // Parse [#]
    if i < len and spec[i] == '#' then {
        result.alt_form = true;
        i += 1;
    };

    // Parse [0]
    if i < len and spec[i] == '0' then {
        result.zero_pad = true;
        i += 1;
    };

    // Parse [width]
    while i < len and spec[i] >= '0' and spec[i] <= '9' then {
        result.width = result.width * 10 + UInt((spec[i] - '0'));
        i += 1;
    };

    // Parse [grouping_option]
    if i < len and (spec[i] == ',' or spec[i] == '_') then {
        result.grouping = spec[i];
        i += 1;
    };

    // Parse [.precision]
    if i < len and spec[i] == '.' then {
        i += 1;
        result.precision = 0;
        let mutable has_precision_digit = false;
        while i < len and spec[i] >= '0' and spec[i] <= '9' then {
            result.precision = result.precision * 10 + Int((spec[i] - '0'));
            has_precision_digit = true;
            i += 1;
        };
        if not has_precision_digit then {
            panic("invalid format spec: missing precision digits after '.'");
        };
    };

    // Parse [type]
    if i < len then {
        result.type_char = spec[i];
        i += 1;
    };

    // Remaining characters = invalid
    if i < len then {
        panic("invalid format spec: unexpected characters after type");
    };

    return result;
};

let is_align_char(ch: UInt8): Bool = ch == '<' or ch == '>' or ch == '^' or ch == '=';

// Byte length of the UTF-8 sequence a lead byte starts; stray continuation or
// invalid lead bytes count as one byte so parsing stays in step with decoding.
private let utf8_sequence_len(lead: UInt8): UInt = if lead < 128 then 1
else if lead < 192 then 1 else if lead < 224 then 2 else if lead < 240 then 3 else 4;
