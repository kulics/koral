using "std" { ... };
// ============================================================================
// std.text - Regular expression engine (pure Koral)
// ============================================================================
//
// The pattern compiles to a small instruction program and a Pike-VM
// simulates every thread of that program in lockstep, one input byte at a
// time. Nothing recurses at match time and there is no backtracking stack:
// a `*` over a long input is one loop iteration per byte, not one call
// frame per repetition, so matching is linear in the text length and
// cannot exhaust the stack. Thread priority order reproduces the
// leftmost-first, greedy semantics a backtracking search would give -- the
// match found is exactly the one backtracking would have returned, without
// its worst-case exponential blowup.
//
// Semantics (the single definition for every platform):
//   * byte-oriented matching and byte offsets, UTF-8 opaque;
//   * alternation, concatenation, groups `( )`, classes `[...]` with
//     ranges and negation, `.` (any byte but `\n`), anchors `^` / `$`,
//     quantifiers `*` `+` `?` `{n}` `{n,}` `{n,m}` -- all greedy;
//   * escapes `\d \D \w \W \s \S` plus literal escapes;
//   * `^`/`$` anchor to text ends unless the multiline flag is set.
// There are no backreferences and no lookaround: neither existed here
// before, and the Pike-VM class of engines does not grow them.

// ----------------------------------------------------------------------------
// Bytecode
// ----------------------------------------------------------------------------

/// One matcher instruction. `Class` holds a 256-bit set as 32 bytes; the
/// fixed array is a value, so reading an instruction copies plain bytes --
/// no reference counting in the step loop.
type ReInst {
    /// Match one byte. `ci` folds ASCII case; `ch` is stored lowercase.
    Byte(ch: UInt8, ci: Bool),
    /// Match one byte against a 256-bit class (negation folded at compile).
    Class(bits: [32]UInt8),
    /// Try `x` first (higher priority), then `y`.
    Split(x: UInt, y: UInt),
    /// Jump to `x`.
    Jump(x: UInt),
    /// Record the current position in capture slot `slot`.
    Save(slot: UInt),
    /// Assert the start of the text, or of a line in multiline mode.
    Bol(multiline: Bool),
    /// Assert the end of the text, or of a line in multiline mode.
    Eol(multiline: Bool),
    /// Accept.
    Match(),
};

// ----------------------------------------------------------------------------
// Byte class construction
// ----------------------------------------------------------------------------

type mutable ClassBuilder(mutable bits: [32]UInt8);

given ClassBuilder {

    new(): ClassBuilder = {
        let mutable bits: [32]UInt8 = [];
        return ClassBuilder(bits);
    };

    set_byte(self, ch: UInt8): Void = {
        let i = UInt(ch);
        self.bits[i >> 3] = self.bits[i >> 3] | (UInt8(1) << UInt8(i & 7));
    };

    set_range(self, lo: UInt, hi: UInt): Void = {
        let mutable b = lo;
        while b <= hi then {
            self.set_byte(UInt8(b));
            b += 1;
        };
    };

    set_ascii_letters_ci(self): Void = {
        self.set_range(65, 90);
        self.set_range(97, 122);
    };

    invert(self): Void = {
        for i in UInt(0)..<UInt(32) then {
            self.bits[i] = ~self.bits[i];
        };
    };

    build(self): ReInst = ReInst.Class(self.bits);
};

/// `[0-9]`
let re_class_digit(): ReInst = {
    let b = ClassBuilder.new();
    b.set_range(48, 57);
    return b.build();
};

/// `[a-zA-Z0-9_]`
let re_class_word(): ReInst = {
    let b = ClassBuilder.new();
    b.set_range(48, 57);
    b.set_range(65, 90);
    b.set_byte(95);
    b.set_range(97, 122);
    return b.build();
};

/// `[ \t\n\r\f\v]`
let re_class_space(): ReInst = {
    let b = ClassBuilder.new();
    b.set_range(9, 13);
    b.set_byte(32);
    return b.build();
};

/// Any byte except `\n`.
let re_class_dot(): ReInst = {
    let b = ClassBuilder.new();
    b.set_range(0, 255);
    b.invert();
    b.set_byte(10);
    b.invert();
    return b.build();
};

let re_lower_byte(b: UInt8): UInt8 = {
    return if b >= 'A' and b <= 'Z' then b + 32 else b;
};

// ----------------------------------------------------------------------------
// Assembly: segments with segment-relative pcs, relocated when appended
// ----------------------------------------------------------------------------

let re_relocate(inst: ReInst, base: UInt): ReInst = {
    return when inst in {
        .Jump(x) then .Jump(x + base),
        .Split(x, y) then .Split(x + base, y + base),
        _ then inst,
    };
};

/// Append `seg` to `dst`, rebasing the segment-relative `Jump`/`Split` pcs
/// so they stay absolute within the growing program.
let re_append(dst: List[ReInst], seg: List[ReInst]): Void = {
    let base = dst.count();
    for inst in seg then {
        dst.push(re_relocate(inst, base));
    };
};

/// `<atom>*` -- greedy: `split body / done; body; jmp split; done`.
let re_wrap_star(atom: List[ReInst]): List[ReInst] = {
    let out = List[ReInst].new();
    out.push(ReInst.Split(1, atom.count() + 2));
    re_append(out, atom);
    out.push(ReInst.Jump(0));
    return out;
};

/// `<atom>+` -- greedy: `body; split body / done`.
let re_wrap_plus(atom: List[ReInst]): List[ReInst] = {
    let out = List[ReInst].new();
    re_append(out, atom);
    out.push(ReInst.Split(0, atom.count() + 1));
    return out;
};

/// `<atom>?` -- greedy: `split body / done; body`.
let re_wrap_question(atom: List[ReInst]): List[ReInst] = {
    let out = List[ReInst].new();
    out.push(ReInst.Split(1, atom.count() + 1));
    re_append(out, atom);
    return out;
};

// ----------------------------------------------------------------------------
// Parser
// ----------------------------------------------------------------------------

type mutable ReParser(
    pat: String,
    ignore_case: Bool,
    multiline: Bool,
    mutable pos: UInt,
    mutable ngroups: UInt,
    mutable error: String,
);

given ReParser {

    fail(self, msg: String): Bool = {
        if self.error.is_empty() then {
            self.error = msg;
        };
        return false;
    };

    at_end(self): Bool = self.pos >= self.pat.count();

    peek(self): UInt8 = self.pat[self.pos];

    /// One alternation level: `concat ( '|' concat )*`.
    parse_alt(self, out: List[ReInst]): Bool = {
        let branches = List[List[ReInst]].new();
        let first = List[ReInst].new();
        if not self.parse_concat(first) then {
            return false;
        };
        branches.push(first);
        while not self.at_end() and self.peek() == '|' then {
            self.pos += 1;
            let branch = List[ReInst].new();
            if not self.parse_concat(branch) then {
                return false;
            };
            branches.push(branch);
        };
        if branches.count() == 1 then {
            re_append(out, branches[0]);
            return true;
        };
        // split b0 / next; b0; jmp end; split b1 / next; b1; jmp end; ...
        let mutable jmps = List[UInt].new();
        for i in 0..<branches.count() then {
            if i + 1 < branches.count() then {
                let split_at = out.count();
                out.push(ReInst.Split(split_at + 1, 0));
                re_append(out, branches[i]);
                jmps.push(out.count());
                out.push(ReInst.Jump(0));
                out[split_at] = ReInst.Split(split_at + 1, out.count());
            } else {
                re_append(out, branches[i]);
            };
        };
        let end = out.count();
        for j in jmps then {
            out[j] = ReInst.Jump(end);
        };
        return true;
    };

    /// One concatenation: quantified atoms until `|`, `)` or end.
    parse_concat(self, out: List[ReInst]): Bool = {
        while not self.at_end() and self.peek() != '|' and self.peek() != ')' then {
            if not self.parse_quantified(out) then {
                return false;
            };
        };
        return true;
    };

    /// An atom with an optional greedy quantifier.
    parse_quantified(self, out: List[ReInst]): Bool = {
        let atom = List[ReInst].new();
        if not self.parse_atom(atom) then {
            return false;
        };
        if self.at_end() then {
            re_append(out, atom);
            return true;
        };
        let c = self.peek();
        if c == '*' then {
            self.pos += 1;
            re_append(out, re_wrap_star(atom));
            return true;
        };
        if c == '+' then {
            self.pos += 1;
            re_append(out, re_wrap_plus(atom));
            return true;
        };
        if c == '?' then {
            self.pos += 1;
            re_append(out, re_wrap_question(atom));
            return true;
        };
        if c == '{' then {
            return self.parse_bounded(out, atom);
        };
        re_append(out, atom);
        return true;
    };

    /// `{n}`, `{n,}`, `{n,m}` over `atom`, greedy.
    parse_bounded(self, out: List[ReInst], atom: List[ReInst]): Bool = {
        self.pos += 1;
        let mutable n: UInt = 0;
        let mutable n_digits = false;
        while not self.at_end() and self.peek() >= '0' and self.peek() <= '9' then {
            n = n * 10 + UInt(self.peek() - '0');
            n_digits = true;
            self.pos += 1;
        };
        let mutable m: UInt = n;
        let mutable unbounded = false;
        if not self.at_end() and self.peek() == ',' then {
            self.pos += 1;
            if not self.at_end() and self.peek() != '}' then {
                m = 0;
                while not self.at_end() and self.peek() >= '0' and self.peek() <= '9' then {
                    m = m * 10 + UInt(self.peek() - '0');
                    self.pos += 1;
                };
            } else {
                unbounded = true;
            };
        };
        if self.at_end() or self.peek() != '}' then {
            return self.fail("Invalid {n,m} quantifier");
        };
        self.pos += 1;
        if not n_digits then {
            return self.fail("Invalid {n,m} quantifier");
        };
        if not unbounded and m < n then {
            return self.fail("Invalid {n,m} quantifier");
        };
        if n > 4096 or m > 4096 then {
            return self.fail("Pattern too large");
        };
        if unbounded then {
            for _ in 0..<n then {
                re_append(out, atom);
            };
            re_append(out, re_wrap_star(atom));
        } else {
            for _ in 0..<n then {
                re_append(out, atom);
            };
            for _ in n..<m then {
                re_append(out, re_wrap_question(atom));
            };
        };
        return true;
    };

    /// One atom: group, class, dot, anchor, escape or literal byte.
    parse_atom(self, out: List[ReInst]): Bool = {
        if self.at_end() then {
            return self.fail("Unexpected end of pattern");
        };
        let c = self.peek();
        if c == '(' then {
            self.pos += 1;
            if self.ngroups >= 65535 then {
                return self.fail("Too many capture groups (at most 65535)");
            };
            self.ngroups += 1;
            let g = self.ngroups;
            out.push(ReInst.Save(g * 2));
            if not self.parse_alt(out) then {
                return false;
            };
            if self.at_end() or self.peek() != ')' then {
                return self.fail("Unmatched (");
            };
            self.pos += 1;
            out.push(ReInst.Save(g * 2 + 1));
            return true;
        };
        if c == '[' then {
            return self.parse_class(out);
        };
        if c == '.' then {
            self.pos += 1;
            out.push(re_class_dot());
            return true;
        };
        if c == '^' then {
            self.pos += 1;
            out.push(ReInst.Bol(self.multiline));
            return true;
        };
        if c == '$' then {
            self.pos += 1;
            out.push(ReInst.Eol(self.multiline));
            return true;
        };
        if c == '\\' then {
            return self.parse_escape(out);
        };
        if c == '*' or c == '+' or c == '?' or c == '{' then {
            return self.fail("Invalid preceding regular expression");
        };
        self.pos += 1;
        out.push(ReInst.Byte(re_lower_byte(c), self.ignore_case));
        return true;
    };

    /// `\d \D \w \W \s \S` and literal escapes.
    parse_escape(self, out: List[ReInst]): Bool = {
        self.pos += 1;
        if self.at_end() then {
            return self.fail("Trailing backslash");
        };
        let c = self.peek();
        self.pos += 1;
        if c == 'd' then {
            out.push(re_class_digit());
            return true;
        };
        if c == 'D' then {
            let b = ClassBuilder.new();
            b.set_range(48, 57);
            b.invert();
            out.push(b.build());
            return true;
        };
        if c == 'w' then {
            out.push(re_class_word());
            return true;
        };
        if c == 'W' then {
            let b = ClassBuilder.new();
            b.set_range(48, 57);
            b.set_range(65, 90);
            b.set_byte(95);
            b.set_range(97, 122);
            b.invert();
            out.push(b.build());
            return true;
        };
        if c == 's' then {
            out.push(re_class_space());
            return true;
        };
        if c == 'S' then {
            let b = ClassBuilder.new();
            b.set_range(9, 13);
            b.set_byte(32);
            b.invert();
            out.push(b.build());
            return true;
        };
        if c == 'n' then {
            out.push(ReInst.Byte(10, false));
            return true;
        };
        if c == 't' then {
            out.push(ReInst.Byte(9, false));
            return true;
        };
        if c == 'r' then {
            out.push(ReInst.Byte(13, false));
            return true;
        };
        out.push(ReInst.Byte(re_lower_byte(c), self.ignore_case));
        return true;
    };

    /// `[...]` with ranges, negation, and literal `]` / `-` in the first slot.
    parse_class(self, out: List[ReInst]): Bool = {
        self.pos += 1;
        let b = ClassBuilder.new();
        let mutable negated = false;
        if not self.at_end() and self.peek() == '^' then {
            negated = true;
            self.pos += 1;
        };
        let mutable first = true;
        let mutable closed = false;
        while not self.at_end() then {
            let c = self.peek();
            if c == ']' and not first then {
                self.pos += 1;
                closed = true;
                break;
            };
            first = false;
            self.pos += 1;
            let mutable lo = c;
            if c == '\\' then {
                if self.at_end() then {
                    return self.fail("Trailing backslash");
                };
                let e = self.peek();
                self.pos += 1;
                if e == 'd' then {
                    b.set_range(48, 57);
                    continue;
                };
                if e == 'w' then {
                    b.set_range(48, 57);
                    b.set_range(65, 90);
                    b.set_byte(95);
                    b.set_range(97, 122);
                    continue;
                };
                if e == 's' then {
                    b.set_range(9, 13);
                    b.set_byte(32);
                    continue;
                };
                if e == 'n' then {
                    lo = 10;
                } else if e == 't' then {
                    lo = 9;
                } else if e == 'r' then {
                    lo = 13;
                } else {
                    lo = e;
                };
            };
            // Range: `lo-hi` when a `-` and a follower come next.
            if not self.at_end() and self.peek() == '-' and self.pos + 1 < self.pat.count(
            ) and self.pat[self.pos + 1] != ']' then {
                self.pos += 1;
                let mut_hi = self.peek();
                self.pos += 1;
                let mutable hi = mut_hi;
                if hi == '\\' then {
                    if self.at_end() then {
                        return self.fail("Trailing backslash");
                    };
                    let e = self.peek();
                    self.pos += 1;
                    hi = if e == 'n' then 10
                    else if e == 't' then 9 else if e == 'r' then 13 else e;
                };
                if self.ignore_case and lo >= 'A' and lo <= 'Z' and hi >= 'A' and hi <= 'Z' then {
                    b.set_range(UInt(lo) + 32, UInt(hi) + 32);
                };
                if UInt(lo) > UInt(hi) then {
                    return self.fail("Invalid character range");
                };
                b.set_range(UInt(lo), UInt(hi));
            } else {
                if self.ignore_case and lo >= 'A' and lo <= 'Z' then {
                    b.set_byte(lo + 32);
                };
                if self.ignore_case and lo >= 'a' and lo <= 'z' then {
                    b.set_byte(lo - 32);
                };
                b.set_byte(lo);
            };
        };
        if not closed then {
            return self.fail("Unterminated [");
        };
        if negated then {
            b.invert();
        };
        out.push(b.build());
        return true;
    };
};

// ----------------------------------------------------------------------------
// Compilation
// ----------------------------------------------------------------------------

/// Scratch-owned capture storage. A row is one thread's whole capture-slot
/// state -- `width` `Int32`s (`2 * groups + 2`) -- identified by its index in
/// the pool; seeds and threads carry the index (two words of transport)
/// instead of a row VALUE.
///
/// Rows are lazily allocated, one block each, and recycled through the free
/// stack: memory is proportional to the live rows a run actually touches, so
/// a many-group pattern pays for its threads and not for a pre-sized worst
/// case (a flat pre-sized arena would be rows x width -- quadratic in the
/// group count before the first match).
///
/// Lifetimes are explicit because rows outlive positions: a thread without an
/// intervening `Save` keeps one row across many input bytes, so nothing is
/// ever reclaimed by position. A thread's row is ITS OWN copy -- taken at
/// spawn, returned at death -- and a `Save` copies-on-write into a temp row
/// (`take_temp` / `end_call`): the seed's row may be shared with sibling
/// branches or belong to the thread being consumed, and neither may see the
/// write. Since every thread copies its row out at spawn, no live thread
/// references a temp when the call ends.
///
/// Row 0 is the permanent all-unset row threads start from; `take` hands out
/// recycled rows and grows the pool on first touch.
type mutable ReRowPool(
    rows: List[*mutable Int32],
    mutable free_buf: *mutable UInt,
    mutable free_len: UInt,
    mutable free_cap: UInt,
    temp_buf: *mutable UInt,
    mutable temp_len: UInt,
    temp_cap: UInt,
    width: UInt,
);

given ReRowPool {
    /// Address of row `i` -- a raw-pointer table walk, no bounds check: the
    /// step loop's Save/spawn paths hit this per byte.
    at(self, i: UInt): *mutable Int32 = {
        let base = self.rows.borrow_ptr();
        return base[i];
    };

    /// Copy row `src` into row `dst` -- the copy-on-write half of a `Save`
    /// and the copy every spawn takes. This width-sized copy is the ONLY row
    /// copy in the step loop; everything else passes row indices.
    copy_row(self, src: UInt, dst: UInt): Void = {
        let sp = self.at(src);
        let dp = self.at(dst);
        let mutable i = UInt(0);
        while i < self.width then {
            dp[i] = sp[i];
            i += UInt(1);
        };
    };

    /// Load a row into the match result: an inline value copy for patterns
    /// that fit the inline slots (zero allocations -- the common case), one
    /// packed heap block beyond.
    load_row(self, i: UInt): ReSlots = {
        let src = self.at(i);
        if self.width <= UInt(34) then {
            let mutable slots: [34]Int32 = [];
            let mutable k = UInt(0);
            while k < self.width then {
                slots[k] = src[k];
                k += UInt(1);
            };
            return ReSlots(slots, "");
        };
        return ReSlots(
            re_blank_slots(),
            String.from_utf8_ptr_unchecked(src as *UInt8, self.width * UInt(4)),
        );
    };

    /// A row for a thread: recycled from the free stack, or a fresh block on
    /// first touch. The spawn fills it with `copy_row` immediately. The free
    /// stack is a raw array -- this runs per spawn in the step loop.
    take(self): UInt = {
        if self.free_len == UInt(0) then {
            self.rows.push(alloc_memory[Int32](self.width));
            return self.rows.count() - UInt(1);
        };
        self.free_len = self.free_len - UInt(1);
        return self.free_buf[self.free_len];
    };

    /// Return a row to the pool -- a thread's death.
    give(self, i: UInt): Void = {
        if self.free_len == self.free_cap then {
            let new_cap = self.free_cap * UInt(2) + UInt(8);
            let grown = alloc_memory[UInt](new_cap);
            copy_memory(grown, self.free_buf, self.free_len);
            dealloc_memory(self.free_buf);
            self.free_buf = grown;
            self.free_cap = new_cap;
        };
        self.free_buf[self.free_len] = i;
        self.free_len = self.free_len + UInt(1);
    };

    /// A row for a `Save`'s copy-on-write. The thread that survives this call
    /// has copied the row out at spawn, so `end_call` returns every temp
    /// unconditionally. The temp stack is a raw bump -- this runs per `Save`.
    take_temp(self): UInt = {
        if self.temp_len >= self.temp_cap then {
            panic("regex: capture row pool exhausted");
        };
        let i = self.take();
        self.temp_buf[self.temp_len] = i;
        self.temp_len = self.temp_len + UInt(1);
        return i;
    };

    /// Return every temp taken during the closure call to the free stack.
    end_call(self): Void = {
        let mutable k = UInt(0);
        while k < self.temp_len then {
            self.give(self.temp_buf[k]);
            k += UInt(1);
        };
        self.temp_len = UInt(0);
    };
};

given ReRowPool: Drop {
    /// Release every row block and the two stacks owned by the pool.
    drop(self): Void = {
        let mutable k = UInt(0);
        while k < self.rows.count() then {
            dealloc_memory(self.rows[k]);
            k += UInt(1);
        };
        dealloc_memory(self.free_buf);
        dealloc_memory(self.temp_buf);
    };
};

/// Per-regex match scratch. A run allocates nothing: the marks sets, the
/// capture template, the closure worklist, the two thread lists and the two
/// capture-row arenas are reused across runs. Marks reset with generations
/// (bumped per list build, never re-zeroed); `in_use` guards nesting -- a
/// `matches` call inside a `find_all` loop over the same regex falls back to
/// a fresh scratch (which drops, and frees its arenas, at scope exit).
type mutable ReScratch(
    mutable in_use: Bool,
    mutable gen: Int32,
    cm: List[Int32],
    nm: List[Int32],
    pool: ReRowPool,
    work: List[ReSeed],
    clist: List[ReThread],
    nlist: List[ReThread],
    bmarks: *mutable Int32,
    mutable bcur: *mutable UInt32,
    mutable bcur_len: UInt,
    mutable bnext: *mutable UInt32,
    mutable bnext_len: UInt,
    bstack: *mutable UInt32,
    mutable bstack_len: UInt,
    bstarts: List[UInt],
    banchors: List[UInt],
    mutable bgen: Int32,
    alt_buf: *mutable UInt32,
    undo_buf: *mutable UInt32,
);

given ReScratch: Drop {
    /// Release the backward-scan buffers owned by the scratch.
    drop(self): Void = {
        dealloc_memory(self.bmarks);
        dealloc_memory(self.bcur);
        dealloc_memory(self.bnext);
        dealloc_memory(self.bstack);
        dealloc_memory(self.alt_buf);
        dealloc_memory(self.undo_buf);
    };
};

let re_new_scratch(inst_count: UInt, width: UInt): ReScratch = {
    let cm = List[Int32].with_capacity(inst_count);
    let nm = List[Int32].with_capacity(inst_count);
    for _ in 0..<inst_count then cm.push(0);
    for _ in 0..<inst_count then nm.push(0);
    // Row 0 is the permanent all-unset row; thread and temp rows are
    // allocated on first touch and recycled through the pool's free stack,
    // so the pool's memory follows the live rows a run actually uses.
    let rows = List[*mutable Int32].new();
    rows.push(alloc_memory[Int32](width));
    let blankp = rows[UInt(0)];
    let mutable bi = UInt(0);
    while bi < width then {
        blankp[bi] = Int32(0) - Int32(1);
        bi += UInt(1);
    };
    let free_cap = inst_count * UInt(2) + UInt(16);
    let temp_cap = inst_count + UInt(8);
    let pool = ReRowPool(
        rows,
        alloc_memory[UInt](free_cap),
        UInt(0),
        free_cap,
        alloc_memory[UInt](temp_cap),
        UInt(0),
        temp_cap,
        width,
    );
    // Backward-scan buffers: the marks set, the two frontiers (at most one
    // entry per program counter) and the closure stack (at most every
    // epsilon edge in one position).
    let bmarks = alloc_memory[Int32](inst_count);
    let mutable zi = UInt(0);
    while zi < inst_count then {
        bmarks[zi] = Int32(0);
        zi += UInt(1);
    };
    return ReScratch(
        false,
        2,
        cm,
        nm,
        pool,
        List[ReSeed].with_capacity(inst_count * UInt(4) + UInt(16)),
        List[ReThread].with_capacity(inst_count + UInt(8)),
        List[ReThread].with_capacity(inst_count + UInt(8)),
        bmarks,
        alloc_memory[UInt32](inst_count),
        UInt(0),
        alloc_memory[UInt32](inst_count),
        UInt(0),
        alloc_memory[UInt32](inst_count * UInt(4) + UInt(8)),
        UInt(0),
        List[UInt].new(),
        List[UInt].new(),
        Int32(2),
        alloc_memory[UInt32](UInt(3) * (re_bt_budget() + UInt(2))),
        alloc_memory[UInt32](UInt(2) * (re_bt_budget() + UInt(2))),
    );
};

/// A literal byte every match must contain: its instruction, and the reverse
/// epsilon edges the backward scan walks. Present only when the byte's
/// instruction DOMINATES Match -- every path through the program consumes
/// it -- and no instruction on any path to it can consume the same byte.
/// That second property is what makes feasible starts strictly increase with
/// the byte's occurrences in the text (a prefix match can contain the byte
/// only as its LAST byte), so a leftmost search can stop at the first viable
/// candidate. Patterns without such a byte keep the plain unanchored scan.
type mutable ReReq(
    byte: UInt8,
    ci: Bool,
    pc: UInt,
    eps_from: *mutable UInt32,
    eps_off: *mutable UInt32,
);

given ReReq: Drop {
    /// Release the scan buffers owned by the scan data.
    drop(self): Void = {
        dealloc_memory(self.eps_from);
        dealloc_memory(self.eps_off);
    };
};

/// The program in flat arrays -- the step loop's dispatch reads a tag byte
/// and scalar operands instead of materializing a `ReInst` variant per
/// thread step. `op` values: 0 consume (Byte and Class both reduce to a
/// bitmap test), 1 Split, 2 Jump, 3 Save, 4 Bol, 5 Eol, 6 Match. `aux1`
/// holds x / slot / the multiline flag; `aux2` holds y. `match_bits` is the
/// per-instruction byte set (32 bytes each), zero for non-consumers.
type mutable ReCode(
    op: *mutable UInt8,
    aux1: *mutable UInt32,
    aux2: *mutable UInt32,
    match_bits: *mutable UInt8,
    count: UInt,
);

given ReCode: Drop {
    /// Release the flat program buffers.
    drop(self): Void = {
        dealloc_memory(self.op);
        dealloc_memory(self.aux1);
        dealloc_memory(self.aux2);
        dealloc_memory(self.match_bits);
    };
};

/// Mirror the instruction list into flat arrays. Parsing and analysis keep
/// the variant form; the step loop never touches it again.
let re_build_code(insts: List[ReInst]): ReCode = {
    let n = insts.count();
    let op = alloc_memory[UInt8](n);
    let aux1 = alloc_memory[UInt32](n);
    let aux2 = alloc_memory[UInt32](n);
    let match_bits = alloc_memory[UInt8](n * UInt(32));
    let mutable zi = UInt(0);
    while zi < n * UInt(32) then {
        match_bits[zi] = UInt8(0);
        zi += UInt(1);
    };
    for pc in UInt(0)..<n then {
        let base = pc * UInt(32);
        aux1[pc] = UInt32(0);
        aux2[pc] = UInt32(0);
        when insts[pc] in {
            .Byte(ch, ci) then {
                op[pc] = UInt8(0);
                let i = UInt(ch);
                match_bits[base + (i >> 3)] = match_bits[base + (i >> 3)] | (UInt8(1) << UInt8(i & 7));
                if ci and ch >= 'a' and ch <= 'z' then {
                    let up = UInt(ch - 32);
                    match_bits[base + (up >> 3)] = match_bits[base + (up >> 3)] | (UInt8(1) << UInt8(up & 7));
                };
            },
            .Class(bits) then {
                op[pc] = UInt8(0);
                for k in UInt(0)..<UInt(32) then {
                    match_bits[base + k] = bits[k];
                };
            },
            .Split(x, y) then {
                op[pc] = UInt8(1);
                aux1[pc] = UInt32(x);
                aux2[pc] = UInt32(y);
            },
            .Jump(x) then {
                op[pc] = UInt8(2);
                aux1[pc] = UInt32(x);
            },
            .Save(slot) then {
                op[pc] = UInt8(3);
                aux1[pc] = UInt32(slot);
            },
            .Bol(multiline) then {
                op[pc] = UInt8(4);
                aux1[pc] = if multiline then UInt32(1) else UInt32(0);
            },
            .Eol(multiline) then {
                op[pc] = UInt8(5);
                aux1[pc] = if multiline then UInt32(1) else UInt32(0);
            },
            .Match() then {
                op[pc] = UInt8(6);
            },
        };
    };
    // Quantifier fusion: the `atom*` and `atom+` wrappers expand to a
    // Split/Consume/Jump loop -- two steps and a thread fork per byte at
    // match time. Where the loop's consumer is a single byte or class
    // instruction, one Run instruction takes over the Split's slot (star
    // semantics -- the plus shape keeps its mandatory first atom): the
    // greedy scan is one compare per byte, and the boundary alternatives
    // are the run's exit at every shorter end. The expanded instructions
    // stay in place and keep their bytes: the analysis and the backward
    // prefilter walk the expanded graph, where a loop step is one byte --
    // exactly what their model assumes.
    let mutable pc2 = UInt(0);
    while pc2 < n then {
        let mutable loop_consumer = UInt(0);
        let mutable run_pc = UInt(0);
        let mutable exit_pc = UInt(0);
        let mutable star = false;
        when insts[pc2] in {
            .Split(x, y) then {
                // star: split at s, consume at s+1, jump(s) at s+2, exit s+3.
                if x == pc2 + UInt(1) and y == pc2 + UInt(3) and pc2 + UInt(3) <= n then {
                    when insts[pc2 + UInt(2)] in {
                        .Jump(t) then {
                            if t == pc2 then {
                                when insts[pc2 + UInt(1)] in {
                                    .Byte(_, _) or .Class(_) then {
                                        run_pc = pc2;
                                        loop_consumer = pc2 + UInt(1);
                                        exit_pc = y;
                                        star = true;
                                    },
                                    _ then {},
                                };
                            };
                        },
                        _ then {},
                    };
                };
            },
            .Byte(_, _) or .Class(_) then {
                // plus: consume at s, split(s, s+2) at s+1. The mandatory
                // first consume stays; the Split becomes the run.
                if pc2 + UInt(2) <= n then {
                    when insts[pc2 + UInt(1)] in {
                        .Split(x, y) then {
                            if x == pc2 and y == pc2 + UInt(2) then {
                                run_pc = pc2 + UInt(1);
                                loop_consumer = pc2;
                                exit_pc = y;
                                star = true;
                            };
                        },
                        _ then {},
                    };
                };
            },
            _ then {},
        };
        if star then {
            // The run reads its byte set through `aux2` -- the loop
            // consumer's pc. It must NOT copy the bytes onto its own pc:
            // the backward prefilter models every instruction as a
            // one-byte consumer and would read a fused run as a spurious
            // one-byte step at the Split's slot.
            op[run_pc] = UInt8(7);
            aux1[run_pc] = UInt32(exit_pc);
            aux2[run_pc] = UInt32(loop_consumer);
        };
        pc2 += UInt(1);
    };
    return ReCode(op, aux1, aux2, match_bits, n);
};

/// Does instruction `u`'s byte set (the precomputed bitmap) cover `b`?
let re_bits_match(match_bits: *mutable UInt8, u: UInt, b: UInt8): Bool = {
    let base = u * UInt(32);
    let i = UInt(b);
    return ((match_bits[base + (i >> 3)] >> UInt8(i & 7)) & 1) == 1;
};

/// A compiled program: instructions plus the number of capture groups, the
/// start-byte analysis used to skip hopeless search positions, the required
/// literal byte (when there is one) and the match scratch shared by every
/// run of this regex.
type ReProgram(
    insts: List[ReInst],
    ngroups: UInt,
    start_any: Bool,
    start_bits: [32]UInt8,
    code: ReCode,
    req: Option[ReReq],
    scratch: ReScratch,
);

/// The bytes a match can start with, or the fact that any position can
/// (empty-matching patterns like `a*`). Computed from the program's
/// epsilon closure at pc 0; assertions are treated as pass-through, so the
/// set may over-approximate -- safe for a skip test.
let re_analyze_start(insts: List[ReInst], ngroups: UInt): ReProgram = {
    let mutable start_any = false;
    let mutable bits: [32]UInt8 = [];
    let mutable marks = List[Int32].new();
    for _ in 0..<insts.count() then marks.push(0);
    let mutable work = List[UInt].new();
    work.push(0);
    while not work.is_empty() then {
        let pc = work.take_at(work.count() - 1);
        if marks[pc] == 1 then {
            continue;
        };
        marks[pc] = 1;
        when insts[pc] in {
            .Jump(x) then work.push(x),
            .Split(x, y) then {
                work.push(y);
                work.push(x);
            },
            .Save(_) then work.push(pc + 1),
            .Bol(_) then work.push(pc + 1),
            .Eol(_) then work.push(pc + 1),
            .Match() then {
                start_any = true;
            },
            .Byte(ch, ci) then {
                let i = UInt(ch);
                bits[i >> 3] = bits[i >> 3] | (UInt8(1) << UInt8(i & 7));
                if ci and ch >= 'a' and ch <= 'z' then {
                    let u = UInt(ch - 32);
                    bits[u >> 3] = bits[u >> 3] | (UInt8(1) << UInt8(u & 7));
                };
            },
            .Class(bs) then {
                for k in UInt(0)..<UInt(32) then {
                    bits[k] = bits[k] | bs[k];
                };
            },
        };
    };
    let code = re_build_code(insts);
    return ReProgram(
        insts,
        ngroups,
        start_any,
        bits,
        code,
        re_analyze_required(insts, code.match_bits),
        re_new_scratch(insts.count(), ngroups * UInt(2) + UInt(2)),
    );
};

// ----------------------------------------------------------------------------
// Required-literal analysis
// ----------------------------------------------------------------------------

/// Pick a literal byte that dominates Match -- deleting its instruction
/// disconnects Match from pc 0, so every match contains the byte -- and for
/// which the property of `ReReq` holds. Punctuation beats alnum (the rarest
/// in ordinary text); among equals the earliest instruction wins.
let re_analyze_required(
    insts: List[ReInst],
    match_bits: *mutable UInt8,
): Option[ReReq] = {
    let n = insts.count();
    let mutable candidates = List[UInt].new();
    for pc in UInt(0)..<n then {
        when insts[pc] in {
            .Byte(_, _) then {
                let mutable marks = List[Bool].new();
                for _ in 0..<n then marks.push(false);
                let mutable work = List[UInt].new();
                work.push(UInt(0));
                let mutable reaches = false;
                while not work.is_empty() then {
                    let cur = work.take_at(work.count() - 1);
                    if cur == pc or marks[cur] then {
                        continue;
                    };
                    marks[cur] = true;
                    when insts[cur] in {
                        .Jump(x) then work.push(x),
                        .Split(x, y) then {
                            work.push(y);
                            work.push(x);
                        },
                        .Match() then { reaches = true; },
                        _ then work.push(cur + UInt(1)),
                    };
                };
                if not reaches then {
                    candidates.push(pc);
                };
            },
            _ then {},
        };
    };
    // Preference: non-alnum first, then program order.
    let mutable ordered = List[UInt].new();
    for pass in UInt(0)..<UInt(2) then {
        for pc in candidates then {
            when insts[pc] in {
                .Byte(ch, _) then {
                    let alnum = (ch >= 'a' and ch <= 'z')
                        or (ch >= 'A' and ch <= 'Z')
                        or (ch >= '0' and ch <= '9');
                    if (pass == UInt(0) and not alnum)
                        or (pass == UInt(1) and alnum) then {
                        ordered.push(pc);
                    };
                },
                _ then {},
            };
        };
    };
    for pc in ordered then {
        when re_build_required(insts, pc, match_bits) in {
            .Some(req) then {
                return Option[ReReq].Some(req);
            },
            .None() then {},
        };
    };
    return Option[ReReq].None();
};

/// Build the reverse epsilon edges for `req_pc` and check the safety
/// property: no instruction on any path TO the required byte consumes that
/// byte (so a prefix match can contain the byte only as its LAST byte --
/// the property that makes feasible starts strictly increase with the byte's
/// occurrences). Returns None when the property fails.
let re_build_required(
    insts: List[ReInst],
    req_pc: UInt,
    match_bits: *mutable UInt8,
): Option[ReReq] = {
    let n = insts.count();
    let mutable req_byte = UInt8(0);
    let mutable req_ci = false;
    when insts[req_pc] in {
        .Byte(ch, ci) then {
            req_byte = ch;
            req_ci = ci;
        },
        _ then {
            return Option[ReReq].None();
        },
    };
    // Reverse epsilon edges in CSR form: a Jump/Split source and a
    // Save/Bol/Eol at u (whose edge goes to u + 1) point back at their
    // targets. Flat arrays keep the backward scan's closure free of
    // container traffic.
    let eps_off = alloc_memory[UInt32](n + UInt(1));
    let mutable oi = UInt(0);
    while oi < n + UInt(1) then {
        eps_off[oi] = UInt32(0);
        oi += UInt(1);
    };
    for u in UInt(0)..<n then {
        when insts[u] in {
            .Jump(x) then {
                eps_off[x + UInt(1)] = eps_off[x + UInt(1)] + UInt32(1);
            },
            .Split(x, y) then {
                eps_off[x + UInt(1)] = eps_off[x + UInt(1)] + UInt32(1);
                eps_off[y + UInt(1)] = eps_off[y + UInt(1)] + UInt32(1);
            },
            .Save(_) then {
                eps_off[u + UInt(2)] = eps_off[u + UInt(2)] + UInt32(1);
            },
            .Bol(_) then {
                eps_off[u + UInt(2)] = eps_off[u + UInt(2)] + UInt32(1);
            },
            .Eol(_) then {
                eps_off[u + UInt(2)] = eps_off[u + UInt(2)] + UInt32(1);
            },
            _ then {},
        };
    };
    for k in UInt(0)..<n then {
        eps_off[k + UInt(1)] = eps_off[k + UInt(1)] + eps_off[k];
    };
    let eps_from = alloc_memory[UInt32](UInt(eps_off[n]));
    let mutable fill = alloc_memory[UInt32](n);
    let mutable fi = UInt(0);
    while fi < n then {
        fill[fi] = UInt32(0);
        fi += UInt(1);
    };
    for u in UInt(0)..<n then {
        when insts[u] in {
            .Jump(x) then {
                eps_from[UInt(eps_off[x]) + UInt(fill[x])] = UInt32(u);
                fill[x] = fill[x] + UInt32(1);
            },
            .Split(x, y) then {
                eps_from[UInt(eps_off[x]) + UInt(fill[x])] = UInt32(u);
                fill[x] = fill[x] + UInt32(1);
                eps_from[UInt(eps_off[y]) + UInt(fill[y])] = UInt32(u);
                fill[y] = fill[y] + UInt32(1);
            },
            .Save(_) then {
                let v = u + UInt(1);
                eps_from[UInt(eps_off[v]) + UInt(fill[v])] = UInt32(u);
                fill[v] = fill[v] + UInt32(1);
            },
            .Bol(_) then {
                let v = u + UInt(1);
                eps_from[UInt(eps_off[v]) + UInt(fill[v])] = UInt32(u);
                fill[v] = fill[v] + UInt32(1);
            },
            .Eol(_) then {
                let v = u + UInt(1);
                eps_from[UInt(eps_off[v]) + UInt(fill[v])] = UInt32(u);
                fill[v] = fill[v] + UInt32(1);
            },
            _ then {},
        };
    };
    dealloc_memory(fill);
    // Every instruction that can reach req_pc -- the prefix territory.
    let mutable reach = List[Bool].new();
    for _ in 0..<n then reach.push(false);
    let mutable work = List[UInt].new();
    work.push(req_pc);
    reach[req_pc] = true;
    while not work.is_empty() then {
        let cur = work.take_at(work.count() - 1);
        if cur > UInt(0) then {
            let u = cur - UInt(1);
            when insts[u] in {
                .Byte(_, _) or .Class(_) then {
                    if not reach[u] then {
                        reach[u] = true;
                        work.push(u);
                    };
                },
                _ then {},
            };
        };
        let es = UInt(eps_off[cur]);
        let ee = UInt(eps_off[cur + UInt(1)]);
        let mutable ek = es;
        while ek < ee then {
            let u = UInt(eps_from[ek]);
            ek += UInt(1);
            if not reach[u] then {
                reach[u] = true;
                work.push(u);
            };
        };
    };
    // The property: no reachable consumer of any byte the required
    // instruction matches, other than the instruction itself. A
    // case-insensitive instruction matches the upper-case twin too, and a
    // prefix that could consume EITHER byte could hide one mid-match --
    // which would let feasible starts interleave across occurrences and
    // break the leftmost early stop.
    for u in UInt(0)..<n then {
        if u != req_pc and reach[u] then {
            if re_bits_match(match_bits, u, req_byte) then {
                return Option[ReReq].None();
            };
            if req_ci and req_byte >= 'a' and req_byte <= 'z' then {
                if re_bits_match(match_bits, u, req_byte - UInt8(32)) then {
                    return Option[ReReq].None();
                };
            };
        };
    };
    // The backward scan's closure is dispatch-free: a prefix assertion would
    // need its meaning evaluated per position, so patterns with one on the
    // path to the byte keep the plain scan.
    for u in UInt(0)..<n then {
        if reach[u] then {
            when insts[u] in {
                .Bol(_) or .Eol(_) then {
                    return Option[ReReq].None();
                },
                _ then {},
            };
        };
    };
    return Option[ReReq].Some(ReReq(req_byte, req_ci, req_pc, eps_from, eps_off));
};

/// Compile `pattern` to a program: `save 0; body; save 1; match`.
let re_compile(pattern: String, ignore_case: Bool, multiline: Bool): Result[ReProgram] = {
    let parser = ReParser(pattern, ignore_case, multiline, 0, 0, "");
    let body = List[ReInst].new();
    if not parser.parse_alt(body) then {
        return Result[ReProgram].Error(parser.error);
    };
    if parser.pos < pattern.count() then {
        return Result[ReProgram].Error("Unmatched )");
    };
    if body.count() > 4096 then {
        return Result[ReProgram].Error("Pattern too large");
    };
    let insts = List[ReInst].new();
    insts.push(ReInst.Save(0));
    re_append(insts, body);
    insts.push(ReInst.Save(1));
    insts.push(ReInst.Match());
    return Result[ReProgram].Ok(re_analyze_start(insts, parser.ngroups));
};

// ----------------------------------------------------------------------------
// Matching: the Pike-VM
// ----------------------------------------------------------------------------

/// A thread's capture slots live in a pool row (see `ReRowPool`) and the
/// thread value carries only the row's index: pushing, popping and iterating
/// threads moves two words. The whole match occupies slots 0 and 1; capture
/// group `k` (1-based) occupies slots `2k` and `2k + 1`; a slot of `0 - 1`
/// means "did not take part in this match". A row carries the pattern's
/// groups; up to 65535 capture groups are accepted at compile.
type ReThread(pc: UInt, row: UInt);

/// A pending epsilon-closure step: same transport as a thread.
type ReSeed(pc: UInt, row: UInt);

/// One match's capture slots -- the hybrid result shape: an inline value
/// copy (zero allocations) while the pattern fits the inline slots (up to
/// 16 capture groups, the common case), one packed heap block beyond (the
/// mainstream per-match shape, Go's `[]int`). Either way exactly one
/// construction step at the winning match.
type ReSlots(slots: [34]Int32, spill: String);

given ReSlots {
    /// One slot from either storage shape. The inline slots land in a local
    /// first -- indexing the member array in place would take `&self.slots`
    /// and disqualify the borrowed-self convention (see `Captures.slot_at`).
    slot(self, index: UInt): Int32 = {
        if self.spill.count() > UInt(0) then {
            let p = self.spill.borrow_ptr() as *Int32;
            return p[index];
        };
        let s = self.slots;
        return s[index];
    };
};

/// All-`-1` capture slots: the inline half of a result whose pattern fit,
/// and the placeholder half of a spilled one.
let re_blank_slots(): [34]Int32 = {
    let unset = Int32(0) - Int32(1);
    let mutable a: [34]Int32 = [];
    for i in UInt(0)..<UInt(34) then {
        a[i] = unset;
    };
    return a;
};

/// Search `text` from `offset` for the leftmost-first match. Returns the
/// flat capture-slot list of the winning thread: `[s0, e0, s1, e1, ...]`,
/// with `0 - 1` for slots that did not take part. With `track_groups` off
/// only slots 0 and 1 (the whole match) are followed -- `matches`/`find`
/// never pay for group bookkeeping.
let re_run(
    prog: ReProgram,
    text: String,
    offset: UInt,
    track_groups: Bool,
): Option[ReSlots] = {
    // With a required literal byte the search goes through the prefilter:
    // enumerate feasible starts at the byte's occurrences and run the
    // machine anchored at each, leftmost first.
    if prog.req is .Some(_) then {
        return re_run_filtered(prog, text, offset, track_groups);
    };
    return re_run_scan(prog, text, offset, track_groups, Option[List[UInt]].None());
};

/// The Pike-VM itself. With `anchors` set (increasing), a start thread is
/// injected only at those positions -- the candidate-start match attempts --
/// and the run resolves as soon as one matches or all are spent. With
/// `anchors` unset, every viable position injects and the machine returns
/// the leftmost-first match.
let re_run_scan(
    prog: ReProgram,
    text: String,
    offset: UInt,
    track_groups: Bool,
    anchors: Option[List[UInt]],
): Option[ReSlots] = {
    let insts = prog.insts;
    let code = prog.code;
    let text_len = text.count();
    let bp = text.borrow_ptr();

    // Reuse the regex's scratch; a nested run (same regex re-entered from a
    // callback) falls back to a fresh one and stays correct.
    let shared = prog.scratch;
    let reuse = not shared.in_use;
    let scratch = if reuse
        then shared
        else re_new_scratch(insts.count(), prog.ngroups * UInt(2) + UInt(2));
    // Each thread list is built against its own marks set: a program counter
    // may appear at most once per list, and the first thread to reach it
    // (highest priority) keeps the slot. The sets travel with the lists when
    // they swap -- a thread carried into the next position still owns its
    // program counter against a fresh start's closure. Fresh generations per
    // build make every entry from a previous run invisible.
    let mutable cg: Int32 = 1;
    let mutable ng: Int32 = 0;
    let mutable gtop: Int32 = 0;
    if reuse then {
        scratch.in_use = true;
        if scratch.gen > 1000000000 then {
            // Generations are about to wrap: re-zero the sets once.
            scratch.cm.clear();
            scratch.nm.clear();
            for _ in 0..<insts.count() then scratch.cm.push(0);
            for _ in 0..<insts.count() then scratch.nm.push(0);
            scratch.gen = 2;
        };
        cg = scratch.gen;
        ng = scratch.gen + 1;
        gtop = ng;
    };
    // Marks are walked through raw pointers (the wrap refill above is the
    // last list operation on them). The worklist and thread lists stay
    // lists: their elements are two words now, so push/pop is cheap and
    // `re_new_scratch` reserved room for every bound the marks enforce.
    let mutable cmp = scratch.cm.borrow_mut_ptr();
    let mutable nmp = scratch.nm.borrow_mut_ptr();
    let work = scratch.work;
    let mutable clist = scratch.clist;
    let mutable nlist = scratch.nlist;
    let pool = scratch.pool;
    clist.clear();
    nlist.clear();
    let mutable best_caps = ReSlots(re_blank_slots(), "");
    let mutable matched = false;

    let mutable anchor_i = UInt(0);
    let mutable pos = offset;
    while pos <= text_len then {
        if not matched then {
            // Only start a thread where a match could actually begin.
            let mutable inject = false;
            when anchors in {
                .Some(list) then {
                    if anchor_i < list.count() and list[anchor_i] == pos then {
                        inject = true;
                        anchor_i += UInt(1);
                    };
                },
                .None() then {
                    if prog.start_any then {
                        inject = true;
                    } else if pos < text_len then {
                        let i = UInt(bp[pos]);
                        inject = ((prog.start_bits[i >> 3] >> UInt8(i & 7)) & 1) == 1;
                    };
                },
            };
            if inject then {
                re_add(
                    code,
                    cmp,
                    cg,
                    bp,
                    text_len,
                    pos,
                    clist,
                    UInt(0),
                    UInt(0),
                    track_groups,
                    pool,
                    work,
                );
            };
        };

        // Scan this position's threads in priority order. The first Match
        // thread wins its slot; everything after it is lower priority and
        // dies. Threads before it survive to the next byte and may still
        // produce a higher-priority match later -- that one overwrites.
        ng += 1;
        if ng > gtop then {
            gtop = ng;
        };
        let mutable cut = false;
        for t in clist then {
            if cut then {
                // Lower priority than the match: the thread dies here.
                pool.give(t.row);
            } else {
                let opc = code.op[t.pc];
                if opc == UInt8(6) then {
                    best_caps = pool.load_row(t.row);
                    matched = true;
                    cut = true;
                } else if opc == UInt8(0) and pos < text_len then {
                    if re_bits_match(code.match_bits, t.pc, bp[pos]) then {
                        re_add(
                            code,
                            nmp,
                            ng,
                            bp,
                            text_len,
                            pos + 1,
                            nlist,
                            t.pc + 1,
                            t.row,
                            track_groups,
                            pool,
                            work,
                        );
                    };
                } else if opc == UInt8(7) and pos < text_len then {
                    // The run consumes one byte and stays; its closure
                    // re-forks the exit at the next boundary.
                    if re_bits_match(code.match_bits, UInt(code.aux2[t.pc]), bp[pos]) then {
                        re_add(
                            code,
                            nmp,
                            ng,
                            bp,
                            text_len,
                            pos + 1,
                            nlist,
                            t.pc,
                            t.row,
                            track_groups,
                            pool,
                            work,
                        );
                    };
                } else {};
                // Every consumed thread's row returns to the pool here --
                // after its closure call, which copies what survives.
                pool.give(t.row);
            };
        };

        let tmp = clist;
        clist = nlist;
        nlist = tmp;
        nlist.clear();
        let tmpm = cmp;
        cmp = nmp;
        nmp = tmpm;
        let tmpg = cg;
        cg = ng;
        ng = tmpg;

        pos += 1;
        let drained = when anchors in {
            .Some(list) then matched or anchor_i >= list.count(),
            .None() then matched,
        };
        if drained and clist.is_empty() then {
            break;
        };
    };
    // Threads spawned by the last position were never consumed; their rows
    // return to the pool here.
    for t in clist then {
        pool.give(t.row);
    };
    if reuse then {
        scratch.in_use = false;
        scratch.gen = gtop + 2;
    };
    if not matched then {
        return Option[ReSlots].None();
    };
    return Option[ReSlots].Some(best_caps);
};

// ----------------------------------------------------------------------------
// Backtracking fast path
// ----------------------------------------------------------------------------

/// The step budget for one anchored backtracking attempt. A pattern whose
/// exploration would exceed it -- ambiguous stars over long runs, empty
/// loops -- falls back to the Pike-VM, which is always correct: the budget
/// only picks the engine, never the answer. The scratch's alt/undo buffers
/// are sized from it (at most one alternative and one capture write per
/// step).
let re_bt_budget(): UInt = UInt(4000);

/// The three outcomes of one anchored backtracking attempt. `Budget` means
/// UNKNOWN, never "no match": a search that ran out of budget has not
/// proven the start dead, and the caller must not skip past it to a later
/// start -- that would break leftmost-first.
type ReBt {
    /// A match, with its capture slots.
    Found(slots: ReSlots),
    /// The start is provably dead: the whole search tree fit the budget.
    Missing(),
    /// The budget ran out before the search concluded.
    Budget(),
};

/// Backtracking matcher for one anchored start: the classic greedy,
/// first-alternative-first exploration -- exactly the match the Pike-VM's
/// thread priority preserves, with one path at a time instead of a thread
/// per branch. Captures undo on backtrack.
let re_backtrack(
    prog: ReProgram,
    bp: *UInt8,
    text_len: UInt,
    start: UInt,
    track_groups: Bool,
    pool: ReRowPool,
): ReBt = {
    let code = prog.code;
    let scratch = prog.scratch;
    let alt = scratch.alt_buf;
    let undo = scratch.undo_buf;
    let row = pool.take_temp();
    pool.copy_row(UInt(0), row);
    let caps = pool.at(row);
    let mutable alt_len = UInt(0);
    let mutable undo_len = UInt(0);
    let mutable pc = UInt(0);
    let mutable pos = start;
    let mutable budget = re_bt_budget();

    while true then {
        if budget == UInt(0) then {
            pool.end_call();
            return ReBt.Budget();
        };
        budget = budget - UInt(1);
        let mutable failed = false;
        let opc = code.op[pc];
        if opc == UInt8(0) then {
            if pos < text_len and re_bits_match(code.match_bits, pc, bp[pos]) then {
                pos = pos + UInt(1);
                pc = pc + UInt(1);
            } else {
                failed = true;
            };
        } else if opc == UInt8(1) then {
            // Split: `x` first (the higher-priority branch), `y` later.
            let f = alt_len * UInt(3);
            alt[f] = UInt32(code.aux2[pc]);
            alt[f + UInt(1)] = UInt32(pos);
            alt[f + UInt(2)] = UInt32(undo_len);
            alt_len = alt_len + UInt(1);
            pc = UInt(code.aux1[pc]);
        } else if opc == UInt8(2) then {
            pc = UInt(code.aux1[pc]);
        } else if opc == UInt8(3) then {
            let slot = UInt(code.aux1[pc]);
            if track_groups or slot < UInt(2) then {
                let u = undo_len * UInt(2);
                undo[u] = UInt32(slot);
                undo[u + UInt(1)] = UInt32(caps[slot]);
                undo_len = undo_len + UInt(1);
                caps[slot] = Int32(pos);
            };
            pc = pc + UInt(1);
        } else if opc == UInt8(7) then {
            // A fused greedy run: consume as many matching bytes as
            // possible, then continue at the exit. The alternatives are the
            // exit at every shorter end -- pushed short-to-long so the LIFO
            // pops the next-shortest first -- bounded by the budget, whose
            // overrun hands the whole search to the Pike-VM.
            let exit_pc = UInt(code.aux1[pc]);
            let bits_pc = UInt(code.aux2[pc]);
            let start = pos;
            while pos < text_len and re_bits_match(code.match_bits, bits_pc, bp[pos]) then {
                pos = pos + UInt(1);
            };
            let limit = start;
            if UInt(alt_len) + (pos - limit) > re_bt_budget() then {
                pool.end_call();
                return ReBt.Budget();
            };
            let mutable k = limit;
            while k < pos then {
                let f = alt_len * UInt(3);
                alt[f] = UInt32(exit_pc);
                alt[f + UInt(1)] = UInt32(k);
                alt[f + UInt(2)] = UInt32(undo_len);
                alt_len = alt_len + UInt(1);
                k = k + UInt(1);
            };
            pc = exit_pc;
        } else if opc == UInt8(4) then {
            let multiline = code.aux1[pc] == UInt32(1);
            if pos == UInt(0) or (multiline and pos > UInt(0) and bp[pos - UInt(1)] == '\n') then {
                pc = pc + UInt(1);
            } else {
                failed = true;
            };
        } else if opc == UInt8(5) then {
            let multiline = code.aux1[pc] == UInt32(1);
            if pos == text_len or (multiline and pos < text_len and bp[pos] == '\n') then {
                pc = pc + UInt(1);
            } else {
                failed = true;
            };
        } else {
            let out = pool.load_row(row);
            pool.end_call();
            return ReBt.Found(out);
        };
        if failed then {
            if alt_len == UInt(0) then {
                pool.end_call();
                return ReBt.Missing();
            };
            alt_len = alt_len - UInt(1);
            let f = alt_len * UInt(3);
            pc = UInt(alt[f]);
            pos = UInt(alt[f + UInt(1)]);
            let mark = UInt(alt[f + UInt(2)]);
            while undo_len > mark then {
                undo_len = undo_len - UInt(1);
                let u = undo_len * UInt(2);
                caps[UInt(undo[u])] = Int32(undo[u + UInt(1)]);
            };
        };
    };
    // Unreachable: the loop returns from every exit. Present for the
    // checker, which does not treat `while true` as non-terminating.
    return ReBt.Budget();
};

// ----------------------------------------------------------------------------
// Required-literal prefilter
// ----------------------------------------------------------------------------

/// Feasible match starts for one required-byte occurrence at `q`: the
/// positions `p` where text[p..=q] matches the program up to and including
/// the required byte's instruction. A backward subset construction walks
/// positions left until the frontier empties; `G(i)` is the set of program
/// counters that can finish the prefix starting at `i`, and `i` is a start
/// exactly when pc 0 is among them. Returned starts DECREASE (the walk runs
/// right to left); the caller wants leftmost first, so it iterates the list
/// backwards.
let re_backward_starts(
    prog: ReProgram,
    req: ReReq,
    bp: *UInt8,
    q: UInt,
    text_len: UInt,
): List[UInt] = {
    let insts = prog.insts;
    let n = insts.count();
    let scratch = prog.scratch;
    let bmarks = scratch.bmarks;
    let mutable bgen = scratch.bgen + Int32(1);
    if bgen > Int32(1000000000) then {
        // Generations are about to wrap: re-zero the set once.
        let mutable zi = UInt(0);
        while zi < n then {
            bmarks[zi] = Int32(0);
            zi += UInt(1);
        };
        bgen = Int32(1);
    };
    scratch.bgen = bgen;
    let mutable bcur = scratch.bcur;
    let mutable bnext = scratch.bnext;
    let bstack = scratch.bstack;
    scratch.bcur_len = UInt(0);
    let starts = scratch.bstarts;
    starts.clear();
    let mutable i = q;

    while true then {
        // Seed the frontier for position `i`: at `q` the required byte has
        // consumed text[q]; earlier, every consumer of text[i] whose
        // successor can finish.
        scratch.bstack_len = UInt(0);
        if i == q then {
            bstack[0] = UInt32(req.pc);
            scratch.bstack_len = UInt(1);
        } else {
            let cur_len = scratch.bcur_len;
            let mutable ci = UInt(0);
            while ci < cur_len then {
                let pc = UInt(bcur[ci]);
                ci += UInt(1);
                if pc > UInt(0) then {
                    let u = pc - UInt(1);
                    if re_bits_match(prog.code.match_bits, u, bp[i]) then {
                        let t = scratch.bstack_len;
                        bstack[t] = UInt32(u);
                        scratch.bstack_len = t + UInt(1);
                    };
                };
            };
        };
        scratch.bnext_len = UInt(0);
        while scratch.bstack_len > UInt(0) then {
            let t = scratch.bstack_len - UInt(1);
            scratch.bstack_len = t;
            let u = UInt(bstack[t]);
            if bmarks[u] == bgen then {
                continue;
            };
            bmarks[u] = bgen;
            // No assertion can be on the path (the analysis refuses those
            // patterns), so every popped instruction simply joins the
            // frontier and walks its reverse epsilon edges.
            let nt = scratch.bnext_len;
            bnext[nt] = UInt32(u);
            scratch.bnext_len = nt + UInt(1);
            let es = UInt(req.eps_off[u]);
            let ee = UInt(req.eps_off[u + UInt(1)]);
            let mutable ek = es;
            while ek < ee then {
                let st = scratch.bstack_len;
                bstack[st] = req.eps_from[ek];
                scratch.bstack_len = st + UInt(1);
                ek += UInt(1);
            };
        };
        // pc 0 in the frontier means a match can start exactly at `i`.
        if bmarks[UInt(0)] == bgen then {
            starts.push(i);
        };
        if scratch.bnext_len == UInt(0) or i == UInt(0) then {
            break;
        };
        // The next position's frontier is this one's; the buffers trade
        // places so the marks stay one generation per position.
        let tmp = bcur;
        bcur = bnext;
        bnext = tmp;
        scratch.bcur = bcur;
        scratch.bnext = bnext;
        let tmp_len = scratch.bcur_len;
        scratch.bcur_len = scratch.bnext_len;
        scratch.bnext_len = tmp_len;
        i -= UInt(1);
        bgen += Int32(1);
        if bgen > Int32(1000000000) then {
            let mutable zi = UInt(0);
            while zi < n then {
                bmarks[zi] = Int32(0);
                zi += UInt(1);
            };
            bgen = Int32(1);
        };
        scratch.bgen = bgen;
    };
    return starts;
};

/// The next position at or after `from` whose byte the required
/// instruction would consume. Kept as a tight loop so the C compiler can
/// vectorize the scan -- the per-occurrence work lives in the caller.
let re_find_occurrence(req: ReReq, bp: *UInt8, text_len: UInt, from: UInt): UInt = {
    let mutable q = from;
    while q < text_len then {
        let b = bp[q];
        if b == req.byte or (req.ci and re_lower_byte(b) == req.byte) then {
            return q;
        };
        q += UInt(1);
    };
    return text_len;
};

/// The prefilter path: enumerate feasible starts at the required byte's
/// occurrences and run the anchored machine at each, leftmost first.
/// Candidates strictly increase across occurrences (see `ReReq`), so the
/// first match found IS the leftmost match -- the scan stops there.
let re_run_filtered(
    prog: ReProgram,
    text: String,
    offset: UInt,
    track_groups: Bool,
): Option[ReSlots] = {
    let req = when prog.req in {
        .Some(r) then r,
        .None() then {
            return re_run_scan(prog, text, offset, track_groups, Option[List[UInt]].None());
        },
    };
    let bp = text.borrow_ptr();
    let text_len = text.count();
    let scratch = prog.scratch;
    let pool = scratch.pool;
    let mutable q = re_find_occurrence(req, bp, text_len, offset);
    while q < text_len then {
        {
            let starts = re_backward_starts(prog, req, bp, q, text_len);
            // The walk produced the starts decreasing; the machine takes
            // them increasing (leftmost first). One run per occurrence, its
            // anchor set every start at or past `offset` -- candidates
            // before that belong to matches the caller has moved past.
            let anchors = scratch.banchors;
            anchors.clear();
            let mutable k = starts.count();
            while k > UInt(0) then {
                k -= UInt(1);
                if starts[k] >= offset then {
                    anchors.push(starts[k]);
                };
            };
            if not anchors.is_empty() then {
                // The backtracking fast path first: one greedy path per
                // start, an order of magnitude fewer ops than threading the
                // whole frontier. A proven-dead start moves on; a budget
                // overrun hands the whole anchor set to the Pike-VM below,
                // which answers leftmost-first correctly at any cost.
                let mutable unknown = false;
                let mutable ka = UInt(0);
                while (not unknown) and ka < anchors.count() then {
                    let p = anchors[ka];
                    ka = ka + UInt(1);
                    when re_backtrack(prog, bp, text_len, p, track_groups, pool) in {
                        .Found(slots) then {
                            return Option[ReSlots].Some(slots);
                        },
                        .Missing() then {},
                        .Budget() then {
                            unknown = true;
                        },
                    };
                };
                if unknown then {
                    when re_run_scan(
                        prog,
                        text,
                        offset,
                        track_groups,
                        Option[List[UInt]].Some(anchors),
                    ) in {
                        .Some(slots) then {
                            return Option[ReSlots].Some(slots);
                        },
                        .None() then {},
                    };
                };
            };
        };
        q = re_find_occurrence(req, bp, text_len, q + UInt(1));
    };
    return Option[ReSlots].None();
};

/// Epsilon closure from `(pc, row)`, in priority order, adding the consuming
/// and `Match` threads it reaches to `list`. The marks make the closure a
/// traversal, not a loop: a zero-width cycle (`()*`) visits each program
/// counter once and stops instead of spinning. Seeds share row indices; a
/// `Save` copies-on-write into a call-scoped temp and a surviving thread
/// takes its own copy at spawn, so nothing this call writes is visible to a
/// sibling branch or to the consumed thread's row.
let re_add(
    code: ReCode,
    marks: *mutable Int32,
    generation: Int32,
    bp: *UInt8,
    text_len: UInt,
    pos: UInt,
    list: List[ReThread],
    pc0: UInt,
    row0: UInt,
    track_groups: Bool,
    pool: ReRowPool,
    work: List[ReSeed],
): Void = {
    work.clear();
    work.push(ReSeed(pc0, row0));
    while not work.is_empty() then {
        let seed = work.take_at(work.count() - 1);
        if marks[seed.pc] == generation then {
            continue;
        };
        marks[seed.pc] = generation;
        let opc = code.op[seed.pc];
        if opc == UInt8(2) then {
            work.push(ReSeed(UInt(code.aux1[seed.pc]), seed.row));
        } else if opc == UInt8(1) then {
            // Pushed in reverse: the stack pops `x` first.
            work.push(ReSeed(UInt(code.aux2[seed.pc]), seed.row));
            work.push(ReSeed(UInt(code.aux1[seed.pc]), seed.row));
        } else if opc == UInt8(7) then {
            // A fused run forks in the closure exactly like its Split did:
            // the run's own continuation consumes at this pc (greedy, higher
            // priority) and the exit branch walks to its consumers. The run
            // thread outlives this call, so it takes its own row copy --
            // sharing the seed's row would alias the consumed thread's,
            // which is recycled the moment this call returns.
            let row = pool.take();
            pool.copy_row(seed.row, row);
            list.push(ReThread(seed.pc, row));
            work.push(ReSeed(UInt(code.aux1[seed.pc]), seed.row));
        } else if opc == UInt8(3) then {
            let slot = UInt(code.aux1[seed.pc]);
            if track_groups or slot < 2 then {
                // Copy-on-write into a call-scoped temp: the seed's row
                // may be shared with sibling branches or belong to the
                // thread being consumed, neither of which this write may
                // disturb. `end_call` reclaims the temp.
                let row = pool.take_temp();
                pool.copy_row(seed.row, row);
                pool.at(row)[slot] = Int32(pos);
                work.push(ReSeed(seed.pc + 1, row));
            } else {
                work.push(ReSeed(seed.pc + 1, seed.row));
            };
        } else if opc == UInt8(4) then {
            let multiline = code.aux1[seed.pc] == UInt32(1);
            if pos == 0 or (multiline and pos > 0 and bp[pos - UInt(1)] == '\n') then {
                work.push(ReSeed(seed.pc + 1, seed.row));
            };
        } else if opc == UInt8(5) then {
            let multiline = code.aux1[seed.pc] == UInt32(1);
            if pos == text_len or (multiline and pos < text_len and bp[pos] == '\n') then {
                work.push(ReSeed(seed.pc + 1, seed.row));
            };
        } else {
            // A consumer or the Match: a live thread. It outlives this
            // call, so it takes its own copy of the row -- no live thread
            // ever references a call-scoped temp.
            let row = pool.take();
            pool.copy_row(seed.row, row);
            list.push(ReThread(seed.pc, row));
        };
    };
    pool.end_call();
};
