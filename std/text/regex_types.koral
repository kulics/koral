using "std" { ... };
// ============================================================================
// std.text - Type Definitions
// ============================================================================

/// Bit flags that control how a regex is compiled and matched.
public type sendable RegexFlag(value: UInt);

/// Flag constructors and bitwise combinators for `RegexFlag`.
given RegexFlag {

    /// The empty flag set: default, case-sensitive, whole-text matching.
    public none(): RegexFlag = RegexFlag(0);

    /// Match letters case-insensitively.
    public ignore_case(): RegexFlag = RegexFlag(1);

    /// Make `^` and `$` match line starts and ends, not just the text's ends.
    public multiline(): RegexFlag = RegexFlag(2);

    /// Combine two flag sets with bitwise OR.
    public combine(self, other: RegexFlag): RegexFlag = RegexFlag(
        self.value | other.value,
    );

    /// Return `true` if every flag in `flag` is set on this value.
    public has(self, flag: RegexFlag): Bool = (self.value & flag.value) == flag.value;
};

/// A compiled regular expression, ready to match text.
public type Regex(prog: ReProgram, pat: String, groups: Int);

/// Accessors for the compiled pattern's source and capture-group count.
given Regex {

    /// Return the original pattern string.
    public pattern(self): String = self.pat;

    /// Return the number of capturing groups in the pattern.
    public group_count(self): Int = self.groups;
};

/// A match result that records only the whole match's span, with no capture groups.
public type sendable Match(
    source: String, // 原始文本
    match_start: Int, // 匹配起始位置（字节偏移）
    match_end: Int, // 匹配结束位置（字节偏移，不含）
);

/// Accessors for the matched text and its byte offsets.
given Match {

    /// Return the substring matched by the pattern.
    public text(self): String = self.source.substring(self.match_start..<self.match_end);

    /// Return the byte offset where the match starts.
    public start(self): Int = self.match_start;

    /// Return the byte offset just past the match's end.
    public end(self): Int = self.match_end;
};

/// A match result that also records the span of every capture group. The
/// slots are an inline value -- zero allocations -- while the pattern fits
/// (up to 16 capture groups, the common case), and one packed heap block
/// beyond, the mainstream per-match shape (Go hands back a `[]int`). Either
/// way a pattern may declare up to 65535 groups.
///
/// `sendable`: every field is sendable value data (inline `Int32` slots and
/// `String` spans), so a `Captures` crosses threads by copy.
public type sendable Captures(
    source: String, // 原始文本
    slots: [34]Int32, // 内联捕获槽 [s0, e0, s1, e1, ...]（-1 = 未匹配）
    spill: String, // 超出内联容量时的小端 Int32 打包块
    groups: Int, // 模式中的捕获组数
);

/// Accessors for the overall match and its capturing groups.
given Captures {

    /// One slot from either storage shape: the inline value while the
    /// pattern fit it, the packed block beyond. The dispatch reads the
    /// storage itself, so it can never disagree with how the result was
    /// built. The inline slots land in a local first: indexing the member
    /// array in place would take `&self.slots`, and a self-rooted reference
    /// disqualifies the borrowed-self convention for the whole accessor
    /// family (the local copy is dead-except-one-load, which clang folds
    /// back to the load).
    private slot_at(self, index: Int): Int32 = {
        if self.spill.count() > 0 then {
            let p = self.spill.borrow_ptr() as *Int32;
            return p[index];
        };
        let s = self.slots;
        return s[index];
    };

    /// Return the substring matched by the whole pattern.
    public text(self): String = {
        return self.source.substring(
            Int(self.slot_at(0))..<Int(self.slot_at(1)),
        );
    };

    /// Return the byte offset where the overall match starts.
    public start(self): Int = Int(self.slot_at(0));

    /// Return the byte offset just past the overall match's end.
    public end(self): Int = Int(self.slot_at(1));

    /// Return the number of capture slots, counting the whole match as group 0.
    public group_count(self): Int = self.groups + 1;

    /// Return group `index`'s text, where group 0 is the whole match.
    /// `None` when the index is out of range or the group did not take part in the match.
    public group(self, index: Int): Option[String] = {
        if index < 0 or index > self.groups then {
            return Option[String].None();
        };
        let s = self.slot_at(index * 2);
        let e = self.slot_at(index * 2 + 1);
        if s < 0 or e < 0 then {
            return Option[String].None();
        };
        return Option[String].Some(self.source.substring(Int(s)..<Int(e)));
    };

    /// Return the byte offset where group `index` starts, or `None` if unavailable.
    public group_start(self, index: Int): Option[Int] = {
        if index < 0 or index > self.groups then {
            return Option[Int].None();
        };
        let s = self.slot_at(index * 2);
        if s < 0 then {
            return Option[Int].None();
        };
        return Option[Int].Some(Int(s));
    };

    /// Return the byte offset just past group `index`'s end, or `None` if unavailable.
    public group_end(self, index: Int): Option[Int] = {
        if index < 0 or index > self.groups then {
            return Option[Int].None();
        };
        let e = self.slot_at(index * 2 + 1);
        if e < 0 then {
            return Option[Int].None();
        };
        return Option[Int].Some(Int(e));
    };
};

/// Iterator over the successive non-overlapping matches of a regex.
public type mutable MatchIterator(regex: Regex, text: String, mutable offset: Int);

/// Iterator over successive matches, each with its capture groups.
public type mutable CapturesIterator(regex: Regex, text: String, mutable offset: Int);

/// Iterator over the text pieces between a regex's matches.
public type mutable RegexSplitIterator(
    regex: Regex,
    text: String,
    mutable offset: Int,
    mutable done: Bool,
);

// Regex iterable views -- the re-iterable sources `find_all`, `captures_all`
// and `split` hand back. A view describes a walk over `text`, not a position:
// every `iterator()` starts a fresh cursor, so `for`, repeat terminals and
// `lazy()` pipelines all work off the same view.

/// Iterable view over the successive non-overlapping matches of a regex.
public type MatchView(regex: Regex, text: String);

/// Iterable view over successive matches, each with its capture groups.
public type CapturesView(regex: Regex, text: String);

/// Iterable view over the text pieces between a regex's matches.
public type RegexSplitView(regex: Regex, text: String);

/// `Iterable` for `MatchView`: a fresh matches cursor per call.
given MatchView: Iterable[Match, MatchIterator] {

    /// Build a fresh cursor over the matches; the view itself is untouched.
    public iterator(self): MatchIterator = MatchIterator(self.regex, self.text, 0);
};

/// `Iterable` for `CapturesView`: a fresh captures cursor per call.
given CapturesView: Iterable[Captures, CapturesIterator] {

    /// Build a fresh cursor over the capture sets; the view itself is untouched.
    public iterator(self): CapturesIterator =
        CapturesIterator(self.regex, self.text, 0);
};

/// `Iterable` for `RegexSplitView`: a fresh pieces cursor per call.
given RegexSplitView: Iterable[String, RegexSplitIterator] {

    /// Build a fresh cursor over the pieces; the view itself is untouched.
    public iterator(self): RegexSplitIterator =
        RegexSplitIterator(self.regex, self.text, 0, false);
};

// ============================================================================
// MatchIterator — Iterator implementation
// ============================================================================

/// Iterator conformance for `MatchIterator`, yielding matches one after another.
given MatchIterator: Iterator[Match] {

    /// Return the next match, resuming after the previous one, or `None` when exhausted.
    public next(self): Option[Match] = {
        if self.offset > self.text.count() then {
            return Option[Match].None();
        };
        when Regex.find_at(self.regex, self.text, self.offset) in {
            .Some(m) then {
                if m.end() == self.offset then {
                    self.offset += 1;
                } else {
                    self.offset = m.end();
                };
                return Option[Match].Some(m);
            },
            .None() then {
                self.offset = self.text.count() + 1;
                return Option[Match].None();
            },
        };
    };
};

// ============================================================================
// CapturesIterator — Iterator implementation
// ============================================================================

/// Iterator conformance for `CapturesIterator`, yielding one capture set at a time.
given CapturesIterator: Iterator[Captures] {

    /// Return the next match's captures, resuming after the previous one, or `None`.
    public next(self): Option[Captures] = {
        if self.offset > self.text.count() then {
            return Option[Captures].None();
        };
        when Regex.captures_at(self.regex, self.text, self.offset) in {
            .Some(c) then {
                if c.end() == self.offset then {
                    self.offset += 1;
                } else {
                    self.offset = c.end();
                };
                return Option[Captures].Some(c);
            },
            .None() then {
                self.offset = self.text.count() + 1;
                return Option[Captures].None();
            },
        };
    };
};

// ============================================================================
// RegexSplitIterator — Iterator implementation
// ============================================================================

/// Iterator conformance for `RegexSplitIterator`, yielding the pieces in order.
given RegexSplitIterator: Iterator[String] {

    /// Return the next piece between matches, or `None` once the text is consumed.
    public next(self): Option[String] = {
        if self.done then {
            return Option[String].None();
        };

        let text_len = self.text.count();
        if self.offset > text_len then {
            self.done = true;
            return Option[String].None();
        };

        when Regex.find_at(self.regex, self.text, self.offset) in {
            .Some(m) then {
                let part = self.text.substring(self.offset..<m.start());

                // 避免零长度匹配导致无限循环
                if m.end() == self.offset then {
                    if self.offset < text_len then {
                        let mutable part_builder = StringBuilder.new();
                        part_builder.push_string(part);
                        part_builder.push_byte(self.text[self.offset]);
                        self.offset += 1;
                        return Option[String].Some(part_builder.to_string());
                    };
                    self.offset += 1;
                } else {
                    self.offset = m.end();
                };

                return Option[String].Some(part);
            },
            .None() then {
                let tail = self.text.substring(self.offset...);
                self.offset = text_len + 1;
                self.done = true;
                return Option[String].Some(tail);
            },
        };
    };
};
