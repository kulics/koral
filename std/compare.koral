/// `Bounded` for `Int16`: the full signed 16-bit range.
given Int16: Bounded {

    /// Returns the maximum value, 32767.
    public max_value(): Self = Int16(((~UInt16(0)) >> 1));
    /// Returns the minimum value, -32768.
    public min_value(): Self = ~Int16.max_value();
};

