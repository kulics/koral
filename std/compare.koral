};

/// `Eq` for `UInt32`: compares by value.
given UInt32: Eq {

    /// Returns whether `self` and `other` are equal.
    public equals(self, other: UInt32): Bool = self == other;
};

/// `Ord` for `UInt32`: orders by numeric value.
given UInt32: Ord {

    /// Returns -1, 0, or 1 as `self` is less than, equal to, or greater than `other`.
    public compare(self, other: UInt32): Int = if self < other then -1
    else if self > other then 1 else 0;
};

/// `Bounded` for `UInt32`: the full unsigned 32-bit range.
given UInt32: Bounded {

    /// Returns the maximum value, 4294967295.
    public max_value(): Self = ~UInt32(0);
    /// Returns the minimum value, 0.
    public min_value(): Self = 0;
};

/// `Eq` for `UInt64`: compares by value.
given UInt64: Eq {

    /// Returns whether `self` and `other` are equal.
    public equals(self, other: UInt64): Bool = self == other;
};

/// `Ord` for `UInt64`: orders by numeric value.
given UInt64: Ord {

    /// Returns -1, 0, or 1 as `self` is less than, equal to, or greater than `other`.
    public compare(self, other: UInt64): Int = if self < other then -1
    else if self > other then 1 else 0;
};

/// `Bounded` for `UInt64`: the full unsigned 64-bit range.
given UInt64: Bounded {

    /// Returns the maximum value, 2^64 - 1.
    public max_value(): Self = ~UInt64(0);
    /// Returns the minimum value, 0.
    public min_value(): Self = 0;
};

/// `Eq` for `Float32`: IEEE equality where NaN is not equal to itself.
given Float32: Eq {

    /// Returns whether `self` and `other` are equal.
    public equals(self, other: Float32): Bool = self == other;
};

/// `Ord` for `Float32`: orders by value, with NaN comparing as equal to every value.
given Float32: Ord {

    /// Returns -1, 0, or 1 as `self` is less than, equal to, or greater than `other`.
    public compare(self, other: Float32): Int = if self < other then -1
    else if self > other then 1 else 0;
};

/// `Bounded` for `Float32`: the finite extremes.
given Float32: Bounded {

    /// Returns the largest finite value.
    public max_value(): Self = Float32.from_bits(2139095039);
    /// Returns the most negative finite value.
    public min_value(): Self = Float32.from_bits(4286578687);
};

/// `Eq` for `Float64`: IEEE equality where NaN is not equal to itself.
given Float64: Eq {

    /// Returns whether `self` and `other` are equal.
    public equals(self, other: Float64): Bool = self == other;
};

/// `Ord` for `Float64`: orders by value, with NaN comparing as equal to every value.
given Float64: Ord {

    /// Returns -1, 0, or 1 as `self` is less than, equal to, or greater than `other`.
    public compare(self, other: Float64): Int = if self < other then -1
    else if self > other then 1 else 0;
};

/// `Bounded` for `Float64`: the finite extremes.
given Float64: Bounded {

    /// Returns the largest finite value.
    public max_value(): Self = {
        let exp_bits: UInt64 = UInt64(2046) << 52;
        let mantissa_bits: UInt64 = (UInt64(1) << 52) - 1;
        return Float64.from_bits(exp_bits | mantissa_bits);
    };

    /// Returns the most negative finite value.
    public min_value(): Self = {
        let sign_bit: UInt64 = UInt64(1) << 63;
        let exp_bits: UInt64 = UInt64(2046) << 52;
        let mantissa_bits: UInt64 = (UInt64(1) << 52) - 1;
        return Float64.from_bits(sign_bit | exp_bits | mantissa_bits);
    };
};

// ============================================================================
// Wrapping Comparison Implementations
// ============================================================================
// Order and equality delegate to the built-in operators, which compare by the
// value -- the same reading as the plain counterpart of the same width after
// a lossless same-width retype.

/// `Eq` for `WrappingInt`: compares by value.
given WrappingInt: Eq {

    /// Returns whether `self` and `other` are equal.
    public equals(self, other: WrappingInt): Bool = self == other;
};

/// `Ord` for `WrappingInt`: orders by numeric value.
given WrappingInt: Ord {

    /// Returns -1, 0, or 1 as `self` is less than, equal to, or greater than `other`.
    public compare(self, other: WrappingInt): Int = if self < other then -1
    else if self > other then 1 else 0;
};

/// `Eq` for `WrappingInt8`: compares by value.
given WrappingInt8: Eq {

    /// Returns whether `self` and `other` are equal.
    public equals(self, other: WrappingInt8): Bool = self == other;
};

