};

given WrappingUInt: Eq {

    public equals(self, other: WrappingUInt): Bool = self == other;
};

given WrappingUInt: Ord {

    public compare(self, other: WrappingUInt): Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingUInt8: Eq {

    public equals(self, other: WrappingUInt8): Bool = self == other;
};

given WrappingUInt8: Ord {

    public compare(self, other: WrappingUInt8): Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingUInt16: Eq {

    public equals(self, other: WrappingUInt16): Bool = self == other;
};

given WrappingUInt16: Ord {

    public compare(self, other: WrappingUInt16): Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingUInt32: Eq {

    public equals(self, other: WrappingUInt32): Bool = self == other;
};

given WrappingUInt32: Ord {

    public compare(self, other: WrappingUInt32): Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingUInt64: Eq {

