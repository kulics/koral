// ============================================================================
// Koral Standard Library - Compare Traits
// ============================================================================
// NOTE: This file is merged into core.koral, so primitives are already available.
// ============================================================================

// ============================================================================
// Core Comparison Traits
// ============================================================================
public trait Eq {
    equals(self, other Self) Bool;
};

public trait Ord Eq {
    compare(self, other Self) Int;
};

// Bounded trait for types that have minimum and maximum values
public trait Bounded Ord {
    max_value() Self;
    min_value() Self;
};

given Bool as Eq {

    public equals(self, other Bool) Bool = self == other;
};

given Bool as Ord {

    public compare(self, other Bool) Int = if self == other then 0
    else if self then 1 else -1;
};

given Int as Eq {

    public equals(self, other Int) Bool = self == other;
};

given Int as Ord {

    public compare(self, other Int) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given Int as Bounded {

    public max_value() Self = Int(((~UInt(0)) >> 1));
    public min_value() Self = ~Int.max_value();
};

given Int8 as Eq {

    public equals(self, other Int8) Bool = self == other;
};

given Int8 as Ord {

    public compare(self, other Int8) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given Int8 as Bounded {

    public max_value() Self = Int8(((~UInt8(0)) >> 1));
    public min_value() Self = ~Int8.max_value();
};

given Int16 as Eq {

    public equals(self, other Int16) Bool = self == other;
};

given Int16 as Ord {

    public compare(self, other Int16) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given Int16 as Bounded {

    public max_value() Self = Int16(((~UInt16(0)) >> 1));
    public min_value() Self = ~Int16.max_value();
};

given Int32 as Eq {

    public equals(self, other Int32) Bool = self == other;
};

given Int32 as Ord {

    public compare(self, other Int32) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given Int32 as Bounded {

    public max_value() Self = Int32(((~UInt32(0)) >> 1));
    public min_value() Self = ~Int32.max_value();
};

given Int64 as Eq {

    public equals(self, other Int64) Bool = self == other;
};

given Int64 as Ord {

    public compare(self, other Int64) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given Int64 as Bounded {

    public max_value() Self = Int64(((~UInt64(0)) >> 1));
    public min_value() Self = ~Int64.max_value();
};

given UInt as Eq {

    public equals(self, other UInt) Bool = self == other;
};

given UInt as Ord {

    public compare(self, other UInt) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given UInt as Bounded {

    public max_value() Self = ~UInt(0);
    public min_value() Self = 0;
};

given UInt8 as Eq {

    public equals(self, other UInt8) Bool = self == other;
};

given UInt8 as Ord {

    public compare(self, other UInt8) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given UInt8 as Bounded {

    public max_value() Self = ~UInt8(0);
    public min_value() Self = 0;
};

given UInt16 as Eq {

    public equals(self, other UInt16) Bool = self == other;
};

given UInt16 as Ord {

    public compare(self, other UInt16) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given UInt16 as Bounded {

    public max_value() Self = ~UInt16(0);
    public min_value() Self = 0;
};

given UInt32 as Eq {

    public equals(self, other UInt32) Bool = self == other;
};

given UInt32 as Ord {

    public compare(self, other UInt32) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given UInt32 as Bounded {

    public max_value() Self = ~UInt32(0);
    public min_value() Self = 0;
};

given UInt64 as Eq {

    public equals(self, other UInt64) Bool = self == other;
};

given UInt64 as Ord {

    public compare(self, other UInt64) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given UInt64 as Bounded {

    public max_value() Self = ~UInt64(0);
    public min_value() Self = 0;
};

given Float32 as Eq {

    public equals(self, other Float32) Bool = self == other;
};

given Float32 as Ord {

    public compare(self, other Float32) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given Float32 as Bounded {

    public max_value() Self = Float32.from_bits(2139095039);
    public min_value() Self = Float32.from_bits(4286578687);
};

given Float64 as Eq {

    public equals(self, other Float64) Bool = self == other;
};

given Float64 as Ord {

    public compare(self, other Float64) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given Float64 as Bounded {

    public max_value() Self = {
        let exp_bits UInt64 = UInt64(2046) << 52;
        let mantissa_bits UInt64 = (UInt64(1) << 52) - 1;
        return Float64.from_bits(exp_bits | mantissa_bits);
    };

    public min_value() Self = {
        let sign_bit UInt64 = UInt64(1) << 63;
        let exp_bits UInt64 = UInt64(2046) << 52;
        let mantissa_bits UInt64 = (UInt64(1) << 52) - 1;
        return Float64.from_bits(sign_bit | exp_bits | mantissa_bits);
    };
};

// ============================================================================
// Wrapping Comparison Implementations
// ============================================================================
// Order and equality delegate to the built-in operators, which compare by the
// value -- the same reading as the plain counterpart of the same width after
// a lossless same-width retype.

given WrappingInt as Eq {

    public equals(self, other WrappingInt) Bool = self == other;
};

given WrappingInt as Ord {

    public compare(self, other WrappingInt) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingInt8 as Eq {

    public equals(self, other WrappingInt8) Bool = self == other;
};

given WrappingInt8 as Ord {

    public compare(self, other WrappingInt8) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingInt16 as Eq {

    public equals(self, other WrappingInt16) Bool = self == other;
};

given WrappingInt16 as Ord {

    public compare(self, other WrappingInt16) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingInt32 as Eq {

    public equals(self, other WrappingInt32) Bool = self == other;
};

given WrappingInt32 as Ord {

    public compare(self, other WrappingInt32) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingInt64 as Eq {

    public equals(self, other WrappingInt64) Bool = self == other;
};

given WrappingInt64 as Ord {

    public compare(self, other WrappingInt64) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingUInt as Eq {

    public equals(self, other WrappingUInt) Bool = self == other;
};

given WrappingUInt as Ord {

    public compare(self, other WrappingUInt) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingUInt8 as Eq {

    public equals(self, other WrappingUInt8) Bool = self == other;
};

given WrappingUInt8 as Ord {

    public compare(self, other WrappingUInt8) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingUInt16 as Eq {

    public equals(self, other WrappingUInt16) Bool = self == other;
};

given WrappingUInt16 as Ord {

    public compare(self, other WrappingUInt16) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingUInt32 as Eq {

    public equals(self, other WrappingUInt32) Bool = self == other;
};

given WrappingUInt32 as Ord {

    public compare(self, other WrappingUInt32) Int = if self < other then -1
    else if self > other then 1 else 0;
};

given WrappingUInt64 as Eq {

    public equals(self, other WrappingUInt64) Bool = self == other;
};

given WrappingUInt64 as Ord {

    public compare(self, other WrappingUInt64) Int = if self < other then -1
    else if self > other then 1 else 0;
};
