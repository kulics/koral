    public min_value(): Self = 0;
};

given UInt64: Eq {

    public equals(self, other: UInt64): Bool = self == other;
};

given UInt64: Ord {

    public compare(self, other: UInt64): Int = if self < other then -1
    else if self > other then 1 else 0;
