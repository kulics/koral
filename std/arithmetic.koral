// ============================================================================
// Koral Standard Library - Arithmetic Traits and Implementations
// ============================================================================
// NOTE: This file is merged into core.koral.
// ============================================================================

public trait Zero {
    zero(): Self;
};

public trait One {
    one(): Self;
};

public trait Add[R: Any] {
    add(self, other: R): Self;
};

public trait Sub[R: Any] {
    sub(self, other: R): Self;
};

public trait Neg {
    neg(self): Self;
};

public trait Mul[R: Any] {
    mul(self, other: R): Self;
};

public trait Div[R: Any] {
    div(self, other: R): Self;
};

public trait Rem[R: Any] {
    rem(self, other: R): Self;
};

// ============================================================================
// Primitive Explicit Algebraic Conformances
// ============================================================================
given Int: Zero {

    public zero(): Int = 0;
};
given Int: One {

    public one(): Int = 1;
};
given Int: Add[Int] {

    public add(self, other: Int): Int = self + other;
};
given Int: Sub[Int] {

    public sub(self, other: Int): Int = self - other;
};
given Int: Neg {

    public neg(self): Int = -self;
};
given Int: Mul[Int] {

    public mul(self, other: Int): Int = self * other;
};
given Int: Div[Int] {

    public div(self, other: Int): Int = self / other;
};
given Int: Rem[Int] {

    public rem(self, other: Int): Int = self % other;
};

