// ============================================================================
// Top-level std arithmetic implementations
// ============================================================================
given String: Add[String] {

    public add(self, other: String): String = {
        if self.is_empty() then {
            return other;
        };
        if other.is_empty() then {
            return self;
        };
        let left_len = self.count();
        let right_len = other.count();
        let total_len = left_len + right_len;
        let data = alloc_memory[UInt8](total_len + 1);
        copy_memory(data, self.borrow_ptr(), left_len);
        copy_memory(data + left_len, other.borrow_ptr(), right_len);
        init_memory(data + total_len, 0);
        let result = String.from_utf8_ptr_unchecked(data, total_len);
        dealloc_memory(data);
        return result;
    };
};

given Duration: Zero {

    public zero(): Duration = Duration(0, 0);
};

given Duration: Add[Duration] {

    public add(self, other: Duration): Duration = {
        let total_nanos = self.nanos + other.nanos;
        let extra_secs = total_nanos / 1_000_000_000;
        let final_nanos = total_nanos % 1_000_000_000;
        return Duration(self.secs + other.secs + extra_secs, final_nanos);
    };
};

given Duration: Sub[Duration] {

    public sub(self, other: Duration): Duration = {
        let mutable total_nanos = self.nanos - other.nanos;
        let mutable secs_diff = self.secs - other.secs;
        if total_nanos < 0 then {
            secs_diff = secs_diff - 1;
            total_nanos = total_nanos + 1_000_000_000;
        };
        return Duration(secs_diff, total_nanos);
    };
};

given Duration: Neg {

    public neg(self): Duration = Duration.zero() - self;
};

given Duration: Mul[Int] {

    public mul(self, k: Int): Duration = {
        let total_nanos = self.as_nanoseconds() * Int64(k);
        let secs = total_nanos / 1_000_000_000;
        let nanos = total_nanos % 1_000_000_000;
        return Duration(secs, nanos);
    };
};

given Duration: Div[Int] {

    public div(self, k: Int): Duration = {
        let total_nanos = self.as_nanoseconds() / Int64(k);
        let secs = total_nanos / 1_000_000_000;
        let nanos = total_nanos % 1_000_000_000;
        return Duration(secs, nanos);
    };
};

// ============================================================================
// Wrapping family algebraic conformances
// ============================================================================
// The operators are family-polymorphic; these conformances are what lets
// `Numeric` / `Integer` name this family in their bounds. Bodies are the
// same delegation the regular family uses.
// ============================================================================

given WrappingInt8: Add[WrappingInt8] {

    public add(self, other: WrappingInt8): WrappingInt8 = self + other;
};
given WrappingInt8: Sub[WrappingInt8] {

    public sub(self, other: WrappingInt8): WrappingInt8 = self - other;
};
given WrappingInt8: Mul[WrappingInt8] {

    public mul(self, other: WrappingInt8): WrappingInt8 = self * other;
};
given WrappingInt8: Div[WrappingInt8] {

    public div(self, other: WrappingInt8): WrappingInt8 = self / other;
};
given WrappingInt8: Rem[WrappingInt8] {

    public rem(self, other: WrappingInt8): WrappingInt8 = self % other;
};

