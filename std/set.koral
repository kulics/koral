// ============================================================================
// Koral Standard Library - Set Type
// ============================================================================
// NOTE: This file is merged into core.koral, so all previous types are already available.
// ============================================================================

// ============================================================================
// Set Type Definition
// ============================================================================
// `Set` stores its elements in `HashBucket` buckets from std/hash_lookup.koral
// (the shared probing/lookup module). The bucket payload is unused for the
// mutable set; only tag and key are meaningful. Only Occupied buckets have
// initialized key memory; Empty and Deleted buckets have raw (uninitialized)
// key memory; only the tag is valid.

/// A hash set of `Hash` values; iteration order is unspecified.
/// `deleted` counts tombstone (Deleted-tagged) buckets so the table can detect
/// when they dominate and rebuild; it is not part of the public API surface.
public type mutable Set[T: Hash](
    mutable buckets: *mutable HashBucket[T, UInt],
    mutable size: Int,
    mutable capacity: Int,
    mutable deleted: Int,
);

/// `Drop` for `Set[T]`: releases the bucket array.
given[T: Hash] Set[T]: Drop {

    drop(self): Void = {
        for i in 0..<self.capacity then {
            if (self.buckets + i).tag == UInt(1) then {
                deinit_memory(self.buckets + i);
            };
        };
        dealloc_memory(self.buckets);
    };
};

/// Iterator over a `Set`'s elements, in unspecified order.
public type mutable SetIterator[T: Hash](source: Set[T], mutable index: Int);

// ============================================================================
// Set Methods
// ============================================================================
/// Building, querying, and mutating a set.
given[T: Hash] Set[T] {

    /// 空集合不分配桶数组，首次 insert（走 rehash）时再分配。
    public new(): Self = {
        return Set[T](null, 0, 0, 0);
    };

    /// Create an empty set with its buckets allocated up front, sized for about
    /// `capacity` elements.
    public with_capacity(capacity: Int): Self = {
        if capacity < 0 then {
            panic("Set with_capacity negative capacity");
        };
        // Hash tables need extra space for efficiency (load factor ~0.5).
        // 桶数规约成 2 的幂，这样 find_slot 能用掩码代替取模（取模是整数除法）。
        let requested = if capacity < 4 then 4 else capacity * 2;
        let mutable cap = 4;
        while cap < requested then {
            cap = cap * 2;
        };
        let buckets = alloc_memory[HashBucket[T, UInt]](UInt(cap));
        for i in 0..<cap then {
            bucket_set_tag(buckets + i, UInt(0));
        };
        return Set[T](buckets, 0, cap, 0);
    };

    /// Return the number of elements in the set.
    public count(self): Int = self.size;

    // The shared probe from std/hash_lookup.koral (the one probing algorithm
    // this container shares with Dict/FrozenDict/FrozenSet).
    private find_slot(self, value: T): Option[Int] =
        find_hash_slot(self.buckets, self.capacity, value);

    private rehash(self): Void = {
        let old_cap = self.capacity;
        let old_buckets = self.buckets;
        // 新容量只由存活条目决定（tombstone 不带进新表）：
        // 负载保持 ≤ 0.5（size * 2 < new_cap），空集合首次分配 16 桶；
        // tombstone 主导触发时借此缩回合适容量（hashbrown 的 rebuild 规则）。
        let mutable new_cap = 16;
        while self.size * 2 >= new_cap then {
            new_cap = new_cap * 2;
        };
        let new_buckets = alloc_memory[HashBucket[T, UInt]](UInt(new_cap));
        for i in 0..<new_cap then {
            bucket_set_tag(new_buckets + i, UInt(0));
        };
        self.buckets = new_buckets;
        self.capacity = new_cap;
        self.size = 0;
        // 陈旧桶不带入新表；先清零再回插，回插走 public insert 的
        // 触发检查也不会递归 rehash（新容量 > 2 * 存活数）。
        self.deleted = 0;
        for i in 0..<old_cap then {
            let old_tag = (old_buckets + i).tag;
            if old_tag == UInt(1) then {
                let moved = take_memory(old_buckets + i);
                self.insert(moved.key);
            } else if old_tag == UInt(2) then {
                // 已删除桶的 key 在 take 标记删除前已由 deinit_memory
                // 释放；槽里的陈旧位绝不能再 drop 一次（双释放）。
            };
        };
        dealloc_memory(old_buckets);
    };

    /// Add `value` to the set if it is not already present.
    public insert(self, value: T): Void = {
        let _ = self.try_insert(value);
    };

    /// Add `value` only if it is absent; return whether it was added.
    public try_insert(self, value: T): Bool = {
        // 两个触发条件：存活负载满了要扩容；tombstone 过半要重建（缩回
        // 合适容量并清掉陈旧槽），否则删插交替会把表填满 Deleted 标签，
        // 每次查找退化成全表探测且永不再 rehash。
        if self.size * 2 >= self.capacity or self.deleted * 2 > self.capacity then {
            self.rehash();
        };
        when self.find_slot(value) in {
            .None() then {
                panic("Set insert failed");
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                let old_tag = bucket_ptr.tag;
                if old_tag == UInt(1) then {
                    return false;
                };
                init_memory(bucket_ptr, HashBucket[T, UInt](UInt(1), value, UInt(0)));
                if old_tag == UInt(2) then {
                    // 复用了一个 tombstone 槽：陈旧桶少一个。
                    self.deleted = self.deleted - 1;
                };
                self.size = self.size + 1;
                return true;
            },
        };
    };

    /// Add every element of `other` to the set.
    public insert_set(self, other: Set[T]): Void = {
        for v in other then {
            self.insert(v);
        };
    };

    /// Return whether `value` is in the set.
    public contains(self, value: T): Bool = {
        when self.find_slot(value) in {
            .None() then {
                return false;
            },
            .Some(idx) then {
                return (self.buckets + idx).tag == UInt(1);
            },
        };
    };

    /// Remove `value` from the set if present, ignoring whether it was there.
    public remove(self, value: T): Void = {
        let _ = self.try_remove(value);
    };

    /// Remove `value` if present; return whether it was removed.
    public try_remove(self, value: T): Bool = {
        when self.find_slot(value) in {
            .None() then {
                return false;
            },
            .Some(idx) then {
                let bucket_ptr = self.buckets + idx;
                if bucket_ptr.tag == UInt(1) then {
                    deinit_memory(bucket_ptr);
                    bucket_set_tag(bucket_ptr, UInt(2));
                    self.size = self.size - 1;
                    self.deleted = self.deleted + 1;
                    return true;
                } else {
                    return false;
                };
            },
        };
    };

    /// Return whether the set has no elements.
    public is_empty(self): Bool = self.size == 0;

    /// Return whether every element of `self` is also in `other`.
    public is_subset_of(self, other: Set[T]): Bool = {
        for v in self then {
            if not other.contains(v) then {
                return false;
            };
        };
        return true;
    };

    /// Return whether `self` contains every element of `other`.
    public is_superset_of(self, other: Set[T]): Bool = other.is_subset_of(self);

    /// Remove every element from the set.
    public clear(self): Void = {
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == UInt(1) then {
                deinit_memory(bucket_ptr);
            };
            bucket_set_tag(bucket_ptr, UInt(0));
        };
        self.size = 0;
        self.deleted = 0;
    };

    /// Keep only the elements that satisfy `predicate`; O(n) time.
    public retain(self, predicate: (T) -> Bool): Void = {
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == UInt(1) then {
                if not predicate(bucket_ptr.key) then {
                    deinit_memory(bucket_ptr);
                    bucket_set_tag(bucket_ptr, UInt(2));
                    self.size = self.size - 1;
                    self.deleted = self.deleted + 1;
                };
            };
        };
    };

    // Using while is pattern matching for iterator loops
    /// Return a new set holding the elements of `self` or `other`.
    public union(self, other: Set[T]): Set[T] = {
        let mutable result = Set[T].new();
        for v in self then {
            result.insert(v);
        };
        for v in other then {
            result.insert(v);
        };
        return result;
    };

    /// Return a new set holding the elements present in both `self` and `other`.
    public intersection(self, other: Set[T]): Set[T] = {
        let mutable result = Set[T].new();
        for v in self then {
            if other.contains(v) then {
                result.insert(v);
            };
        };
        return result;
    };

    /// Return a new set holding the elements of `self` that are not in `other`.
    public difference(self, other: Set[T]): Set[T] = {
        let mutable result = Set[T].new();
        for v in self then {
            if not other.contains(v) then {
                result.insert(v);
            };
        };
        return result;
    };

    /// Return a new set holding the elements in exactly one of `self` and `other`.
    public symmetric_difference(self, other: Set[T]): Set[T] = {
        let mutable result = Set[T].new();
        for v in self then {
            if not other.contains(v) then {
                result.insert(v);
            };
        };
        for v in other then {
            if not self.contains(v) then {
                result.insert(v);
            };
        };

        return result;
    };
};

/// `Clone` for `Set[T]`: an independent shallow copy.
given[T: Hash] Set[T]: Clone {

    /// Copy the set into a fresh identity, copying elements one level.
    public clone(self): Self = {
        let mutable result = Set[T].with_capacity(self.size);
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == UInt(1) then {
                result.insert(bucket_ptr.key);
            };
        };
        return result;
    };
};

/// `Default` for `Set[T]`: an empty set.
given[T: Hash] Set[T]: Default {

    /// Return an empty set.
    public default(): Self = Set[T].new();
};

/// `Iterable` for `Set[T]`: iterates elements in unspecified order.
given[T: Hash] Set[T]: Iterable[T, SetIterator[T]] {

    /// Return an iterator over the set's elements.
    public iterator(self): SetIterator[T] = SetIterator[T](self, 0);
};

// ============================================================================
// Set Iterator
// ============================================================================
/// `Iterator` for `SetIterator[T]`: yields elements in unspecified order.
given[T: Hash] SetIterator[T]: Iterator[T] {

    /// Yield the next element, or `None` after the last one.
    public next(self): Option[T] = {
        while self.index < self.source.capacity then {
            let bucket_ptr = self.source.buckets + self.index;
            self.index = self.index + 1;
            if bucket_ptr.tag == UInt(1) then {
                return Option[T].Some(bucket_ptr.key);
            };
        };
        return Option[T].None();
    };
};

// ============================================================================
// FrozenSet - immutable snapshot for cross-thread transfer
// ============================================================================
/// An immutable element snapshot that may cross threads. Built by
/// `Set.to_frozen_set`, which bulk-copies straight into this storage (no
/// intermediate container), or by a set literal targeting the type. The
/// snapshot is never mutated afterwards (the construction-then-immutable
/// promise backing `unsafe sendable`); the conditional rule still applies to
/// `T`.
///
/// Storage is standalone — it does not embed `Set`: a hash table of
/// `HashBucket[T, UInt]` in the mutable `Set` layout (compacted without
/// tombstones when copied, or taken over verbatim by `Set.into_frozen_set`).
/// Probing is the shared algorithm from std/hash_lookup.koral. The `mutable`
/// form is where the owned buffer's destructor lives; the snapshot is
/// immutable after construction.
public type unsafe sendable mutable FrozenSet[T: Hash](
    protected buckets: *mutable HashBucket[T, UInt],
    protected len: Int,
    protected capacity: Int,
);

/// `Drop` for `FrozenSet[T]`: releases the live buckets and the table.
given[T: Hash] FrozenSet[T]: Drop {

    drop(self): Void = {
        for i in 0..<self.capacity then {
            if (self.buckets + i).tag == UInt(1) then {
                deinit_memory(self.buckets + i);
            };
        };
        dealloc_memory(self.buckets);
    };
};

/// A one-shot cursor that walks a `FrozenSet[T]`'s table.
public type mutable FrozenSetIterator[T: Hash](
    source: FrozenSet[T],
    mutable index: Int,
);

/// Read-only access over a `FrozenSet[T]`.
given[T: Hash] FrozenSet[T] {

    /// The number of elements in the snapshot.
    public count(self): Int = self.len;

    /// Whether the snapshot has no elements.
    public is_empty(self): Bool = self.len == 0;

    /// Whether `value` is in the snapshot.
    public contains(self, value: T): Bool = {
        when find_hash_slot(self.buckets, self.capacity, value) in {
            .None() then {
                return false;
            },
            .Some(idx) then {
                return (self.buckets + idx).tag == UInt(1);
            },
        };
    };

    /// Copy the snapshot back out as a fresh mutable `Set[T]`.
    public to_set(self): Set[T] = {
        let mutable out = Set[T].new();
        for e in self then {
            out.insert(e);
        };
        return out;
    };
};

/// `Iterator` for `FrozenSetIterator[T]`: yields the live elements in table
/// order (the same order `to_frozen_set`/`into_frozen` leave them in).
given[T: Hash] FrozenSetIterator[T]: Iterator[T] {

    /// Yield the next element, or `None` after the last one.
    public next(self): Option[T] = {
        let mutable i = self.index;
        while i < self.source.capacity then {
            let bucket_ptr = self.source.buckets + i;
            i = i + 1;
            self.index = i;
            if bucket_ptr.tag == UInt(1) then {
                return Option[T].Some(bucket_ptr.key);
            };
        };
        return Option[T].None();
    };
};

/// `Iterable` for `FrozenSet[T]`: a fresh read cursor over the snapshot.
given[T: Hash] FrozenSet[T]: Iterable[T, FrozenSetIterator[T]] {

    /// A fresh cursor over the snapshot's elements; the snapshot is untouched.
    public iterator(self): FrozenSetIterator[T] = FrozenSetIterator[T](self, 0);
};

/// Snapshot conversions from the mutable side.
given[T: Hash] Set[T] {

    /// Copy the set into an immutable `FrozenSet[T]` snapshot that can cross
    /// threads. The receiver stays usable; the snapshot bulk-copies into its
    /// own compacted table + entry array of shared element handles.
    public to_frozen_set(self): FrozenSet[T] = {
        let len = self.size;
        // 负载保持 ≤ 0.5（len * 2 < capacity），空快照不分配桶数组。
        let mutable capacity = 0;
        if len > 0 then {
            capacity = 4;
            while len * 2 >= capacity then {
                capacity = capacity * 2;
            };
        };
        let buckets = alloc_memory[HashBucket[T, UInt]](UInt(capacity));
        for i in 0..<capacity then {
            bucket_set_tag(buckets + i, UInt(0));
        };
        for i in 0..<self.capacity then {
            let bucket_ptr = self.buckets + i;
            if bucket_ptr.tag == UInt(1) then {
                when find_hash_slot(buckets, capacity, bucket_ptr.key) in {
                    .Some(slot) then {
                        init_memory(
                            buckets + slot,
                            HashBucket[T, UInt](UInt(1), bucket_ptr.key, UInt(0)),
                        );
                    },
                    .None() then {
                        panic("FrozenSet build failed");
                    },
                };
            };
        };
        return FrozenSet[T](buckets, len, capacity);
    };

    /// Transfer the whole bucket table into a `FrozenSet[T]` in O(1): the
    /// elements' ownership travels with the table -- nothing is copied,
    /// nothing is retained, and tombstones ride along (they are skipped by
    /// lookups and iteration). The set is left empty and reusable. Where
    /// `to_frozen_set` copies a compacted snapshot out, `into_frozen_*` hands
    /// the storage over; the elements die when the frozen snapshot dies.
    public into_frozen_set(self): FrozenSet[T] = {
        let buckets = self.buckets;
        let len = self.size;
        let capacity = self.capacity;
        self.buckets = null;
        self.size = 0;
        self.capacity = 0;
        self.deleted = 0;
        return FrozenSet[T](buckets, len, capacity);
    };
};

// ============================================================================
// Package-internal snapshot construction
// ============================================================================
/// Build a `FrozenSet[T]` from `len` initialized elements held in the `keys`
/// array. Package-internal construction entry for std builders outside this
/// module (the concurrent containers in `std/sync` keep their own storage and
/// freeze through here); not part of the public surface. Takes ownership of
/// the array: each element is MOVED into the snapshot and the array is freed.
/// With `len == 0` the array may be `null`.
protected let build_frozen_set[T: Hash](
    keys: *mutable T,
    len: Int,
): FrozenSet[T] = {
    // 负载保持 ≤ 0.5（len * 2 < capacity），空快照不分配桶数组。
    let mutable capacity = 0;
    if len > 0 then {
        capacity = 4;
        while len * 2 >= capacity then {
            capacity = capacity * 2;
        };
    };
    let buckets = alloc_memory[HashBucket[T, UInt]](UInt(capacity));
    for i in 0..<capacity then {
        bucket_set_tag(buckets + i, UInt(0));
    };
    for i in 0..<len then {
        let key = take_memory(keys + i);
        when find_hash_slot(buckets, capacity, key) in {
            .Some(slot) then {
                init_memory(
                    buckets + slot,
                    HashBucket[T, UInt](UInt(1), key, UInt(0)),
                );
            },
            .None() then {
                panic("FrozenSet build failed");
            },
        };
    };
    dealloc_memory(keys);
    return FrozenSet[T](buckets, len, capacity);
};
