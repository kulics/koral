using "std" { ... };
using "std/sync" { Mutex };
// ============================================================================
// std.proc - Process Handle
// ============================================================================
// Provides: ProcessStorage (internal), Process (child process handle)
// Access via: using "std/proc" { ... };
// ============================================================================

// ============================================================================
// FFI Declarations
// ============================================================================

/// Foreign type representing the raw spawn result from C runtime.
type foreign KoralProcess(
    pid: UInt32,
    stdin_fd: Int32,
    stdout_fd: Int32,
    stderr_fd: Int32,
);

/// Wait for child process to exit (simplified, used in drop to prevent zombies).
let foreign __koral_waitpid(pid: UInt32): Int32;

/// Wait for child process with full exit information.
/// Returns 0 on success, non-zero on failure.
let foreign __koral_waitpid_full(
    pid: UInt32,
    exit_code: *Int32,
    signal_num: *Int32,
    out_maxrss_bytes: *UInt64,
): Int32;

/// Non-blocking check if child process has exited.
/// Returns >0 if exited, 0 if still running, <0 on error.
let foreign __koral_try_waitpid(
    pid: UInt32,
    exit_code: *Int32,
    signal_num: *Int32,
    out_maxrss_bytes: *UInt64,
): Int32;

/// Concurrently read all data from stdout and stderr pipes (uses poll/select internally).
/// Allocates memory for output buffers (caller must free with dealloc_memory).
let foreign __koral_read_all_pipes(
    stdout_fd: Int32,
    stderr_fd: Int32,
    out_stdout: *mutable *mutable UInt8,
    out_stdout_len: *mutable UInt64,
    out_stderr: *mutable *mutable UInt8,
    out_stderr_len: *mutable UInt64,
): Int32;

/// Yield the current thread's time slice (used while another thread reaps).
let foreign __koral_thread_yield(): Void;

/// Get pointer to errno value.
/// Reuse errno helpers from std.os to avoid cross-module symbol ambiguity.

// ============================================================================
// Helpers
// ============================================================================

// ============================================================================
// ProcessStorage (internal)
// ============================================================================

/// Internal storage for child process state.
/// Holds the PID, pipe file descriptors (-1 means no pipe), wait claim state,
/// and the recorded exit status (raw_status is valid once waited is true).
/// Every check-then-act on these fields runs under the internal mutex, so
/// concurrent wait/try_wait/pipe takes can never double-reap or double-close.
type unsafe sendable mutable ProcessStorage(
    pid: UInt32,
    mutable stdin_fd: Int32,
    mutable stdout_fd: Int32,
    mutable stderr_fd: Int32,
    mutable waited: Bool,
    mutable peak_rss_bytes: UInt64,
    mutable waiting: Bool,
    mutable raw_status: Int,
    private mutex: Mutex,
);

/// Internal constructor used by Command.spawn().
let make_process_storage(
    pid: UInt32,
    stdin_fd: Int32,
    stdout_fd: Int32,
    stderr_fd: Int32,
): ProcessStorage = ProcessStorage(
    pid,
    stdin_fd,
    stdout_fd,
    stderr_fd,
    false,
    0,
    false,
    0,
    Mutex.new(),
);

given ProcessStorage: Drop {

    /// On drop: close any un-taken pipe fds, then auto-wait to prevent zombie processes.
    drop(self): Void = {
        self.mutex.lock();
        if self.stdin_fd >= 0 then {
            __koral_pipe_close(self.stdin_fd);
        };
        if self.stdout_fd >= 0 then {
            __koral_pipe_close(self.stdout_fd);
        };
        if self.stderr_fd >= 0 then {
            __koral_pipe_close(self.stderr_fd);
        };
        if not self.waited then {
            __koral_waitpid(self.pid);
        };
        self.mutex.unlock();
    };
};

// ============================================================================
// Process — Child process handle
// ============================================================================

/// Child process handle providing wait, pipe access, and lifecycle management.
/// Sendable contract: CROSS-THREAD SHARED — `wait`/`kill` from another thread is
/// idiomatic (a watchdog reaps while the spawner continues). The handle
/// synchronizes its own state: wait/try_wait/pipe takes are safe to call
/// concurrently; wait is idempotent (every caller observes the same exit
/// status, exactly one reap) and pipe takes are single-shot.
public type unsafe sendable mutable Process(mutable storage: ProcessStorage);

/// Wait for the child to exit, capture its output, and take ownership of its pipes.
given Process {

    /// Get the child process PID.
    public pid(self): UInt32 = self.storage.pid;

    /// Peak resident set size (RSS) of the child process in bytes, as reported
    /// by the kernel after the process was reaped. 0 means not captured.
    public peak_rss_bytes(self): UInt64 = self.storage.peak_rss_bytes;

    /// Reconstruct the recorded exit status. Call with the storage lock held.
    private stored_status(self): ExitStatus = if self.storage.raw_status < 0 then {
        ExitStatus.from_signal(0 - self.storage.raw_status)
    } else {
        ExitStatus.from_code(self.storage.raw_status)
    };

    /// Block until the child process exits, returning its exit status.
    /// Idempotent and thread-safe: any number of threads may call wait()
    /// concurrently; exactly one of them reaps the child and every caller
    /// observes the same exit status. The reap itself runs outside the lock.
    public wait(self): Result[ExitStatus] = {
        let mutable finished = false;
        let mutable outcome = Result[ExitStatus].Error("failed to wait process");
        while not finished then {
            self.storage.mutex.lock();
            if self.storage.waited then {
                let status = self.stored_status();
                self.storage.mutex.unlock();
                outcome = Result[ExitStatus].Ok(status);
                finished = true;
            } else {
                if not self.storage.waiting then {
                    // Claim the wait: this caller alone reaps the child.
                    self.storage.waiting = true;
                    self.storage.mutex.unlock();
                    // waitpid may block for the child's life: run it outside
                    // the lock so other queries are not stalled behind it.
                    let mutable exit_code: Int32 = 0;
                    let mutable signal_num: Int32 = 0;
                    let mutable maxrss: UInt64 = 0;
                    let result = __koral_waitpid_full(
                        self.storage.pid,
                        &exit_code,
                        &signal_num,
                        &maxrss,
                    );
                    self.storage.mutex.lock();
                    self.storage.waiting = false;
                    if result != 0 then {
                        self.storage.mutex.unlock();
                        // Failed reap releases the claim: the call stays retryable.
                        outcome = Result[ExitStatus].Error(last_error_message());
                    } else {
                        self.storage.peak_rss_bytes = maxrss;
                        self.storage.raw_status = if signal_num > 0 then {
                            0 - Int(signal_num)
                        } else {
                            Int(exit_code)
                        };
                        self.storage.waited = true;
                        let status = self.stored_status();
                        self.storage.mutex.unlock();
                        outcome = Result[ExitStatus].Ok(status);
                    };
                    finished = true;
                } else {
                    // Another wait() is reaping: block until it publishes the
                    // outcome, then loop to report the same result.
                    self.storage.mutex.unlock();
                    __koral_thread_yield();
                };
            };
        };
        return outcome;
    };

    /// Wait for the child process to exit and capture all stdout/stderr output.
    /// Uses __koral_read_all_pipes for concurrent reading to avoid pipe deadlock.
    /// The pipe fds are claimed single-shot: a concurrent take_*_pipe() wins or
    /// loses the claim atomically, so no fd is ever closed twice.
    public wait_output(self): Result[CommandOutput] = {
        // Claim the pipe fds under the lock; displaced fds are closed after
        // the lock is released.
        self.storage.mutex.lock();
        let stdin_fd = self.storage.stdin_fd;
        self.storage.stdin_fd = -1;
        let stdout_fd = self.storage.stdout_fd;
        self.storage.stdout_fd = -1;
        let stderr_fd = self.storage.stderr_fd;
        self.storage.stderr_fd = -1;
        self.storage.mutex.unlock();

        // Close un-taken stdin to send EOF to child
        if stdin_fd >= 0 then {
            __koral_pipe_close(stdin_fd);
        };

        // Read both pipes concurrently via C runtime (uses poll/select internally)
        let mutable out_stdout: *mutable UInt8 = null;
        let mutable out_stdout_len = 0;
        let mutable out_stderr: *mutable UInt8 = null;
        let mutable out_stderr_len = 0;

        defer {
            if stdout_fd >= 0 then {
                __koral_pipe_close(stdout_fd);
            };
            if stderr_fd >= 0 then {
                __koral_pipe_close(stderr_fd);
            };
        };
        defer {
            if out_stdout != null then {
                dealloc_memory(out_stdout);
            };
            if out_stderr != null then {
                dealloc_memory(out_stderr);
            };
        };

        let read_result = __koral_read_all_pipes(
            stdout_fd,
            stderr_fd,
            &mutable out_stdout,
            (&mutable out_stdout_len) as *mutable UInt64,
            &mutable out_stderr,
            (&mutable out_stderr_len) as *mutable UInt64,
        );

        if read_result != 0 then {
            return Result[CommandOutput].Error(last_error_message());
        };

        let stdout_content = if out_stdout_len > 0 then {
            let s = String.from_utf8_ptr_unchecked(out_stdout, out_stdout_len);
            out_stdout = null;
            s
        } else {
            out_stdout = null;
            String.new()
        };
        let stderr_content = if out_stderr_len > 0 then {
            let s = String.from_utf8_ptr_unchecked(out_stderr, out_stderr_len);
            out_stderr = null;
            s
        } else {
            out_stderr = null;
            String.new()
        };

        return when self.wait() in {
            .Ok(status) then Result[CommandOutput].Ok(
                CommandOutput(status, stdout_content, stderr_content),
            ),
            .Error(e) then Result[CommandOutput].Error(e),
        };
    };

    /// Non-blocking check if the child process has exited.
    /// Returns Ok(Some(status)) if exited, Ok(None) if still running, Error on system error.
    /// While another thread's wait() is reaping, returns Ok(None); poll again
    /// for the recorded status. Once the child is reaped, repeat calls return
    /// the recorded status.
    public try_wait(self): Result[Option[ExitStatus]] = {
        self.storage.mutex.lock();
        if self.storage.waited then {
            let status = self.stored_status();
            self.storage.mutex.unlock();
            return Result[Option[ExitStatus]].Ok(Option[ExitStatus].Some(status));
        };
        if self.storage.waiting then {
            self.storage.mutex.unlock();
            return Result[Option[ExitStatus]].Ok(Option[ExitStatus].None());
        };
        let mutable exit_code: Int32 = 0;
        let mutable signal_num: Int32 = 0;
        let mutable maxrss: UInt64 = 0;
        let result = __koral_try_waitpid(
            self.storage.pid,
            &exit_code,
            &signal_num,
            &maxrss,
        );
        if result < 0 then {
            self.storage.mutex.unlock();
            return Result[Option[ExitStatus]].Error(last_error_message());
        };
        if result == 0 then {
            self.storage.mutex.unlock();
            return Result[Option[ExitStatus]].Ok(Option[ExitStatus].None());
        };
        self.storage.peak_rss_bytes = maxrss;
        self.storage.raw_status = if signal_num > 0 then {
            0 - Int(signal_num)
        } else {
            Int(exit_code)
        };
        self.storage.waited = true;
        let status = self.stored_status();
        self.storage.mutex.unlock();
        return Result[Option[ExitStatus]].Ok(Option[ExitStatus].Some(status));
    };

    /// Take ownership of the stdin pipe (only Some when configured as Piped).
    /// Subsequent calls return None (ownership already transferred).
    public take_stdin_pipe(self): Option[StdinPipe] = {
        self.storage.mutex.lock();
        let fd = self.storage.stdin_fd;
        self.storage.stdin_fd = -1;
        self.storage.mutex.unlock();
        if fd < 0 then {
            return Option[StdinPipe].None();
        };
        return Option[StdinPipe].Some(StdinPipe(PipeStorage(fd)));
    };

    /// Take ownership of the stdout pipe (only Some when configured as Piped).
    /// Subsequent calls return None (ownership already transferred).
    public take_stdout_pipe(self): Option[StdoutPipe] = {
        self.storage.mutex.lock();
        let fd = self.storage.stdout_fd;
        self.storage.stdout_fd = -1;
        self.storage.mutex.unlock();
        if fd < 0 then {
            return Option[StdoutPipe].None();
        };
        return Option[StdoutPipe].Some(StdoutPipe(PipeStorage(fd)));
    };

    /// Take ownership of the stderr pipe (only Some when configured as Piped).
    /// Subsequent calls return None (ownership already transferred).
    public take_stderr_pipe(self): Option[StderrPipe] = {
        self.storage.mutex.lock();
        let fd = self.storage.stderr_fd;
        self.storage.stderr_fd = -1;
        self.storage.mutex.unlock();
        if fd < 0 then {
            return Option[StderrPipe].None();
        };
        return Option[StderrPipe].Some(StderrPipe(PipeStorage(fd)));
    };
};
