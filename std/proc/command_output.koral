using "std" { ... };
// ============================================================================
// std.proc - Command Output
// ============================================================================
// Provides: CommandOutput type (synchronous execution result)
// Access via: using "std/proc" { ... };
// ============================================================================

/// Synchronous command execution result containing exit status and captured output.
public type sendable CommandOutput(
    public status: ExitStatus,
    public stdout: String,
    public stderr: String,
);

/// Convenience queries over the exit status and captured output.
given CommandOutput {

    /// Whether the command succeeded (exit code is 0).
    public is_success(self): Bool = self.status.is_success();

    /// Get exit code (convenience method delegating to status).
    public code(self): Option[Int] = self.status.code();
};

/// String conformance: renders the exit status together with the captured stdout and stderr.
given CommandOutput: ToString {

    /// Convert to diagnostic text of the form CommandOutput(status, stdout="...", stderr="...").
    public to_string(self): String = {
        let mutable s = StringBuilder.new();
        s.push_string("CommandOutput(");
        s.push_string(self.status.to_string());
        s.push_string(", stdout=\"");
        s.push_string(self.stdout);
        s.push_string("\", stderr=\"");
        s.push_string(self.stderr);
        s.push_string("\")");
        return s.to_string();
    };
};
