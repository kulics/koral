using std { .. }
// ============================================================================
// std.proc - Process Utility Functions
// ============================================================================
// Provides: current_pid, send_process_signal, kill_process, is_process_alive,
//           run_command, run_command_output
// Access via: using std::proc { .. }
// NOTE: exit, abort, args stay in std, NOT migrated here.
// ============================================================================

// ============================================================================
// FFI Declarations
// ============================================================================

/// Get the current process PID.
private foreign let __koral_getpid() UInt32

/// Send a signal to a process. Returns 0 on success, non-zero on failure.
private foreign let __koral_send_signal(pid UInt32, signal Int32) Int32

/// Check if a process is alive. Returns 1 if alive, 0 if not.
private foreign let __koral_is_alive(pid UInt32) Int32

/// Get the working set size (resident memory) of a process in bytes. Returns -1 on error.
private foreign let __koral_process_working_set_bytes(pid UInt32) Int64
private foreign let __koral_process_tree_working_set_bytes(pid UInt32) Int64

/// Get pointer to errno value.
/// Reuse errno helpers from std.os to avoid cross-module symbol ambiguity.

// ============================================================================
// Helpers
// ============================================================================

// ============================================================================
// Process Utility Functions
// ============================================================================

/// Get the current process PID.
public let current_pid() UInt32 = __koral_getpid()

/// Send a signal to the process with the given PID (Unix).
/// On Windows, SIGTERM/SIGKILL calls TerminateProcess; other signals return an error.
public let send_process_signal(signal Int, to: UInt32) Result[Void] = {
    let result = __koral_send_signal(to, signal(Int32))
    if result <> 0 then {
        return Result[Void].Error(box(last_error_message()))
    }
    return Result[Void].Ok({})
}

/// Force-kill the process with the given PID (equivalent to send_process_signal(signal: SIGKILL=9, to: pid)).
public let kill_process(pid UInt32) Result[Void] = send_process_signal(9, to: pid)

/// Check whether the process with the given PID is still alive.
public let is_process_alive(pid UInt32) Bool = __koral_is_alive(pid) <> 0

/// Get the working set size (resident memory) of a process in bytes.
/// Returns 0 if the process is not found or an error occurs.
public let process_working_set_bytes(pid UInt32) UInt64 = {
    let result = __koral_process_working_set_bytes(pid)
    return if result < 0 then 0(UInt64) else result(UInt64)
}

/// Get the total working set size of a process and all its child processes.
/// This tracks the entire process tree, not just the root process.
/// Returns 0 if the process is not found or an error occurs.
public let process_tree_working_set_bytes(pid UInt32) UInt64 = {
    let result = __koral_process_tree_working_set_bytes(pid)
    return if result < 0 then 0(UInt64) else result(UInt64)
}

/// Convenience: synchronously execute a command and return only the exit status.
/// Internally uses Command.new(program).args(args).run().
public let run_command(program String, args List[String]) Result[ExitStatus] = {
    return Command.new(program).args(args).run()
}

/// Convenience: synchronously execute a command and capture stdout/stderr.
/// Internally uses Command.new(program).args(args).run_output().
public let run_command_output(program String, args List[String]) Result[CommandOutput] = {
    return Command.new(program).args(args).run_output()
}
