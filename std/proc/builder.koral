using "std" { ... };
// ============================================================================
// std.proc - Command Builder
// ============================================================================
// Provides: EnvAction (internal), CommandStorage (internal), Command (builder)
// Access via: using "std/proc" { ... };
// ============================================================================

using "std/os" { Path, IntoPath, all_env };

// ============================================================================
// FFI Declarations
// ============================================================================

/// Create a child process via Unix(posix_spawn ) / CreateProcess (Windows).
///
/// `envc < 0` means the child inherits the current environment (`envp` is
/// ignored); `envc >= 0` means `envp` carries the child's COMPLETE environment
/// (an `envc` of 0 is an explicitly empty environment). A bare `program` name
/// is resolved through the child's PATH either way.
let foreign __koral_spawn(
    program: *UInt8,
    argv: **UInt8,
    argc: Int32,
    envp: **UInt8,
    envc: Int32,
    cwd: *UInt8,
    stdin_mode: Int32,
    stdout_mode: Int32,
    stderr_mode: Int32,
    stdin_fd: Int32,
    stdout_fd: Int32,
    stderr_fd: Int32,
    out: *KoralProcess,
): Int32;

/// Get pointer to errno value.
/// Reuse errno helpers from std.os to avoid cross-module symbol ambiguity.

// ============================================================================
// Helpers
// ============================================================================

/// IoRedirect enum to integer (FFI encoding): 0=inherit, 1=piped, 2=null, 3=fd.
private let stdio_to_int(s: IoRedirect): Int32 = when s in {
    .Inherit() then Int32(0),
    .Piped() then Int32(1),
    .Null() then Int32(2),
    .File(_) then Int32(3),
    .StdoutPipe(_) then Int32(3),
    .StderrPipe(_) then Int32(3),
};

/// Extract the file descriptor from an IoRedirect (mode=3 variants).
/// Returns -1 for non-fd variants (Inherit, Piped, Null).
private let stdio_to_fd(s: IoRedirect): Int32 = when s in {
    .File(f) then Int32(f.fd()),
    .StdoutPipe(p) then Int32(p.fd()),
    .StderrPipe(p) then Int32(p.fd()),
    .Inherit() then Int32(0) - 1,
    .Piped() then Int32(0) - 1,
    .Null() then Int32(0) - 1,
};

/// Convert a list of strings to an array of UInt8 pointers for FFI.
private let argv_to_ptrs(argv: List[String]): **UInt8 = {
    let count = argv.count();
    let ptrs = alloc_memory[*UInt8](UInt(count));
    for i in 0..<count then {
        init_memory(ptrs + i, argv[i].borrow_ptr());
    };
    return ptrs;
};

/// Extract the name part of a "KEY=VALUE" environment entry.
private let env_entry_name(entry: String): String = when entry.find("=") in {
    .Some(idx) then entry.substring(0..<idx),
    .None() then entry,
};

/// Drop every entry named `name` from `entries`, in place.
private let env_entries_remove(entries: List[String], name: String): Void = {
    let mutable i = 0;
    while i < entries.count() then {
        if env_entry_name(entries[i]) == name then {
            entries.remove_at(i);
        } else {
            i += 1;
        };
    };
};

/// Build the child's complete environment by applying the env actions to a
/// copy of the current environment:
///   Set    — set or override the named variable (last Set wins)
///   Remove — omit the named variable
///   Clear  — empty the inherited environment (later actions build on the
///            empty base)
/// Returns the merged "KEY=VALUE" block to pass as the whole child environment.
private let build_env_strings(actions: List[EnvAction]): List[String] = {
    let mutable result: List[String] = [];
    for pair in all_env() then {
        result.push("\(pair.first)=\(pair.second)");
    };
    for action in actions then {
        when action in {
            .Set(name, value) then {
                env_entries_remove(result, name);
                result.push("\(name)=\(value)");
            },
            .Remove(name) then {
                env_entries_remove(result, name);
            },
            .Clear() then {
                result.clear();
            },
        };
    };
    return result;
};

/// Convert env strings list to pointer array for FFI.
private let env_strs_to_ptrs(strs: List[String]): **UInt8 = {
    let count = strs.count();
    if count == 0 then {
        return null;
    };
    let ptrs = alloc_memory[*UInt8](UInt(count));
    for i in 0..<count then {
        init_memory(ptrs + i, strs[i].borrow_ptr());
    };
    return ptrs;
};

// ============================================================================
// EnvAction (internal)
// ============================================================================

/// Environment variable action for deferred application during spawn.
type EnvAction {
    /// Set or override an environment variable.
    Set(name: String, value: String),
    /// Remove a specific environment variable.
    Remove(name: String),
    /// Clear all inherited environment variables.
    Clear(),
};

// ============================================================================
// CommandStorage (internal)
// ============================================================================

/// Internal storage for the Command builder.
private type mutable CommandStorage(
    program: String,
    mutable arguments: List[String],
    mutable env_actions: List[EnvAction],
    mutable work_dir: Option[Path],
    mutable stdin_cfg: IoRedirect,
    mutable stdout_cfg: IoRedirect,
    mutable stderr_cfg: IoRedirect,
);

// ============================================================================
// Command — Builder type
// ============================================================================

/// Command builder for configuring and launching child processes.
/// Provides a fluent API for setting program, arguments, environment variables,
/// working directory, and I/O redirection before spawning.
public type mutable Command(private mutable storage: CommandStorage);

/// Configure arguments, environment, working directory, and I/O redirection, then spawn or run the child.
given Command {

    /// Create a new command builder for the specified program.
    public new(program: String): Command = Command(
        CommandStorage(
            program,
            [],
            [],
            .None(),
            IoRedirect.Inherit(),
            IoRedirect.Inherit(),
            IoRedirect.Inherit(),
        ),
    );

    /// Add a single argument (chainable).
    public arg(self, value: String): Command = {
        self.storage.arguments.push(value);
        return self;
    };

    /// Add multiple arguments at once (chainable).
    public args(self, values: List[String]): Command = {
        for v in values then {
            self.storage.arguments.push(v);
        };
        return self;
    };

    /// Set an environment variable (chainable).
    public set_env(self, name: String, value: String): Command = {
        self.storage.env_actions.push(EnvAction.Set(name, value));
        return self;
    };

    /// Clear all inherited environment variables (chainable).
    public clear_env(self): Command = {
        self.storage.env_actions.push(EnvAction.Clear());
        return self;
    };

    /// Remove a specific environment variable (chainable).
    public remove_env(self, name: String): Command = {
        self.storage.env_actions.push(EnvAction.Remove(name));
        return self;
    };

    /// Set the child process working directory (chainable).
    public set_current_dir[T: IntoPath](self, path: T): Command = {
        self.storage.work_dir = Option[Path].Some(path.into_path());
        return self;
    };

    /// Configure stdin redirection (chainable).
    public set_stdin(self, cfg: IoRedirect): Command = {
        self.storage.stdin_cfg = cfg;
        return self;
    };

    /// Configure stdout redirection (chainable).
    public set_stdout(self, cfg: IoRedirect): Command = {
        self.storage.stdout_cfg = cfg;
        return self;
    };

    /// Configure stderr redirection (chainable).
    public set_stderr(self, cfg: IoRedirect): Command = {
        self.storage.stderr_cfg = cfg;
        return self;
    };

    /// Asynchronously spawn a child process, returning a Process handle.
    public spawn(self): Result[Process] = {
        // Build argv array (program + arguments)
        let mutable argv = [self.storage.program];
        for a in self.storage.arguments then {
            argv.push(a);
        };

        // Encode stdio config: 0=inherit, 1=piped, 2=null
        let stdin_mode = stdio_to_int(self.storage.stdin_cfg);
        let stdout_mode = stdio_to_int(self.storage.stdout_cfg);
        let stderr_mode = stdio_to_int(self.storage.stderr_cfg);

        // Build the child environment: no actions means "inherit"; otherwise
        // the actions merge into a copy of the current environment and the
        // merged block is the child's complete environment.
        let has_env_actions = not self.storage.env_actions.is_empty();
        let env_strs = if has_env_actions then build_env_strings(self.storage.env_actions) else List[String].new();
        // envc < 0 tells the runtime "inherit"; >= 0 is the complete block.
        let envc = if has_env_actions then Int32(env_strs.count()) else Int32(0) - 1;
        let stdin_fd = stdio_to_fd(self.storage.stdin_cfg);
        let stdout_fd = stdio_to_fd(self.storage.stdout_cfg);
        let stderr_fd = stdio_to_fd(self.storage.stderr_cfg);

        // Working directory (empty string means inherit)
        let cwd = when self.storage.work_dir in {
            .Some(d) then d.to_string(),
            .None() then String.new(),
        };

        // Pointer arrays are spawn-time scratch. The strings they borrow live
        // in argv/env_strs and stay alive until after the call returns.
        let argv_ptrs = argv_to_ptrs(argv);
        let env_ptrs = env_strs_to_ptrs(env_strs);

        // Call FFI to create child process
        let mutable proc = KoralProcess(0, -1, -1, -1);
        let result = __koral_spawn(
            self.storage.program.borrow_ptr(),
            argv_ptrs,
            Int32(argv.count()),
            env_ptrs,
            envc,
            cwd.borrow_ptr(),
            stdin_mode,
            stdout_mode,
            stderr_mode,
            stdin_fd,
            stdout_fd,
            stderr_fd,
            &proc,
        );

        // Free the per-spawn pointer arrays on every path out of here.
        dealloc_memory(argv_ptrs);
        if env_ptrs != null then {
            dealloc_memory(env_ptrs);
        };

        if result != 0 then {
            return .Error(last_error_message());
        };

        return .Ok(
            Process(
                ProcessStorage(
                    proc.pid,
                    proc.stdin_fd,
                    proc.stdout_fd,
                    proc.stderr_fd,
                    false,
                    0,
                ),
            ),
        );
    };

    /// Synchronously execute the command and wait for completion.
    /// Returns only the exit status (does not capture output).
    ///
    /// Piped stdin is rejected up front: run() neither writes nor closes the
    /// pipe, so the child would wait for input forever. Use spawn() together
    /// with take_stdin_pipe() when the child should read a stdin feed.
    public run(self): Result[ExitStatus] = {
        if self.storage.stdin_cfg is .Piped() then {
            return Result[ExitStatus].Error(
                "run() does not support Piped stdin; use spawn() and take_stdin_pipe()",
            );
        };
        return when self.spawn() in {
            .Ok(child) then child.wait(),
            .Error(e) then Result[ExitStatus].Error(e),
        };
    };

    /// Synchronously execute the command, capture stdout/stderr, and wait for completion.
    /// Forces stdout/stderr to Piped mode to capture output.
    public run_output(self): Result[CommandOutput] = {
        // Force stdout/stderr to Piped to capture output
        self.storage.stdout_cfg = IoRedirect.Piped();
        self.storage.stderr_cfg = IoRedirect.Piped();

        return when self.spawn() in {
            .Ok(child) then child.wait_output(),
            .Error(e) then Result[CommandOutput].Error(e),
        };
    };
};
