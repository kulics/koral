using "std" { ... };
// ============================================================================
// std.proc - I/O Redirect Configuration
// ============================================================================
// Provides: IoRedirect enum (Inherit, Piped, Null, File, StdoutPipe, StderrPipe)
// Access via: using "std/proc" { ... };
// ============================================================================

using "std/os" { File };

/// I/O redirection configuration for child process stdin/stdout/stderr.
///
/// Variants:
///   Inherit   — Inherit the parent process's corresponding file descriptor (default).
///   Piped     — Create a pipe connecting parent and child processes.
///   Null      — Redirect to /dev/null (Unix) or NUL (Windows).
///   File      — Redirect to/from an already-opened File (owns the File; closed on drop).
///   StdoutPipe — Use another child process's stdout pipe as input (for process chaining).
///   StderrPipe — Use another child process's stderr pipe as input (for process chaining).
public type sendable IoRedirect {
    /// Inherit the parent process's corresponding file descriptor (default behavior).
    Inherit(),
    /// Create a pipe connecting parent and child processes.
    Piped(),
    /// Redirect to /dev/null (Unix) or NUL (Windows).
    Null(),
    /// Redirect to/from an already-opened file.
    File(file: File),
    /// Use another child process's stdout pipe (typically for stdin chaining: cmd1 | cmd2).
    StdoutPipe(pipe: StdoutPipe),
    /// Use another child process's stderr pipe (typically for stdin chaining).
    StderrPipe(pipe: StderrPipe),
    /// Feed `data` to the child's stdin from memory（库内边读边写：管道写端
    /// 由库内后台任务泵入，避免大输入堵死管道缓冲；数据冻结成
    /// `FrozenList`——跨任务捕获要 sendable）。
    Bytes(data: FrozenList[UInt8]),
    /// Send this stream to the SAME pipe as stdout（stderr 用：两条流共管道，
    /// 输出按到达序合流）。
    ToStdout(),
};

/// String conformance: names the redirection mode, including the target file descriptor when there is one.
given IoRedirect: ToString {

    /// Convert to "inherit", "piped", "null", or a descriptor form such as "file:fd=3".
    public to_string(self): String = when self in {
        .Inherit() then "inherit",
        .Piped() then "piped",
        .Null() then "null",
        .File(f) then "file:fd=" + f.fd().to_string(),
        .StdoutPipe(p) then "stdout-pipe:fd=" + p.fd().to_string(),
        .StderrPipe(p) then "stderr-pipe:fd=" + p.fd().to_string(),
        .Bytes(b) then "bytes:len=" + b.count().to_string(),
        .ToStdout() then "to-stdout",
    };
};
